                            },
                            {
                                "target_lang_word": "night",
                                "target_lang_sense_clarification": "an evening event, e.g. game night"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8417b3c4-eb87-3113-966e-18dc7aed9c73",
                    "sense_definition": "w czasie wieczoru",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziś <w>wieczór</w> idziemy razem do kina na nowy film.",
                            "target_lang_translations": {
                                "en": "<w>Tonight</w> we are going to the cinema together to see a new movie."
                            }
                        },
                        {
                            "text": "Wpadnij do nas dziś <w>wieczór</w> na kolację.",
                            "target_lang_translations": {
