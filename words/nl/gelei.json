    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1bbe516-15fa-3880-b5c7-af21438ad044",
                    "sense_definition": "Een geleiachtige massa van gelatine of een soortgelijke substantie, vaak gebruikt in voedsel of cosmetica.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gelei_substantie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kok maakte een heerlijke <w>gelei</w> van rode bessen voor het dessert.",
                            "target_lang_translations": {
                                "en": "The chef made a delicious redcurrant <w>jelly</w> for dessert."
                            }
                        },
                        {
                            "text": "Zij smeerde een dunne laag <w>gelei</w> op haar beschuitje.",
                            "target_lang_translations": {
                                "en": "She spread a thin layer of <w>jelly</w> on her rusk."
                            }
                        }
                    ],
                    "synonyms": [
                        "lil"
                    ],
                    "common_phrases": [
                        "zoete gelei",
                        "gelei van vruchten"
                    ],
                    "target_lang_definitions": {
                        "en": "A jelly-like mass of gelatin or a similar substance, often used in food or cosmetics."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jelly",
                                "target_lang_sense_clarification": "food spread or gelatinous substance"
                            },
                            {
                                "target_lang_word": "gel",
                                "target_lang_sense_clarification": "cosmetic or semi-solid substance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d36da8d-a316-32ac-8b9f-6c2dcc4b3baa",
                    "sense_definition": "Ingedikt vleesnat of vruchtensap dat na afkoeling stijf is geworden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gelei_substantie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het afgekoelde vleesnat vormde een dikke <w>gelei</w> bovenop de bouillon.",
                            "target_lang_translations": {
                                "en": "The cooled meat juices formed a thick <w>jelly</w> on top of the broth."
                            }
                        },
                        {
                            "text": "Zij gebruikt natuurlijk vruchtensap om een stevige <w>gelei</w> te maken.",
                            "target_lang_translations": {
                                "en": "She uses natural fruit juice to make a firm <w>jelly</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ingedikte gelei"
                    ],
                    "target_lang_definitions": {
                        "en": "Thickened meat juices or fruit juice that has solidified after cooling."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "aspic",
                                "target_lang_sense_clarification": "savory meat jelly"
                            },
                            {
                                "target_lang_word": "jelly",
                                "target_lang_sense_clarification": "solidified fruit juice or meat stock"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8849beb3-573f-3cfe-b136-4a122bb65b79",
                    "sense_definition": "Een informele of verkorte vorm van het woord <w>geleide</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude teksten kom je soms de vorm <w>gelei</w> tegen in plaats van geleide.",
                            "target_lang_translations": {
                                "en": "In old texts, you sometimes come across the form <w>escort</w> instead of 'geleide'."
                            }
                        },
                        {
                            "text": "De gids bood zijn <w>gelei</w> aan tijdens de gevaarlijke tocht.",
                            "target_lang_translations": {
                                "en": "The guide offered his <w>escort</w> during the dangerous journey."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Verkorte vorm van geleide"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An informal or shortened form of the word 'geleide' (escort, guidance)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "escort",
                                "target_lang_sense_clarification": "archaic/informal term for guidance or company"
                            },
                            {
                                "target_lang_word": "guidance",
                                "target_lang_sense_clarification": "act of guiding or accompanying"
                            }
                        ]
                    }
                }
            ]
        }
    ]
