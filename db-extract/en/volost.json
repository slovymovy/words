                        "translation_id": "57ac7fb5-e5d6-433a-b3f2-5c8924b072ad",
                        "source_entry_id": "e6b51fd3-5366-3e72-bca4-106cc6d0c2cf",
                        "source_sense_id": "904cd78c-3ab1-300c-a6e8-51d67547126c",
