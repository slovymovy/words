{
    "word_family": [
        "официальный",
        "официальность",
        "официоз",
        "официозный"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "4f2ce850-1cb0-3e25-9fff-f49a708d21f3",
                    "sense_definition": "От имени правительства, администрации или должностных лиц; публично и с подтверждением полномочий.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Компания <официально> объявила о запуске нового продукта на рынке.",
                            "target_lang_translations": {
                                "en": "The company <officially> announced the launch of a new product on the market.",
                                "zh": "公司<正式>宣布了新产品上市的消息。"
                            }
                        },
                        {
                            "text": "Мы пока не женаты <официально>, но уже давно живём вместе.",
                            "target_lang_translations": {
                                "en": "We aren't <officially> married yet, but we've been living together for a long time.",
                                "zh": "我们虽然还没有<正式>结婚，但已经住在一起很久了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "формально"
                    ],
                    "antonyms": [
                        "неофициально"
                    ],
                    "common_phrases": [
                        "официально заявить",
                        "официально подтвердить",
                        "официально работать",
                        "официально признать"
                    ],
                    "target_lang_definitions": {
                        "en": "On behalf of the government or administration; publicly and with authority.",
                        "zh": "代表政府、行政部门或相关负责人；公开且经过授权。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "officially",
                                "target_lang_sense_clarification": "publicly or with authority"
                            },
                            {
                                "target_lang_word": "formally",
                                "target_lang_sense_clarification": "in a formal manner"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正式地",
                                "target_lang_sense_clarification": "以公开或授权的方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f259bd66-b867-3460-b511-92c8d8d55f3c",
                    "sense_definition": "С соблюдением установленных правил, норм и формальностей.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protocol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На торжественный приём гостей просили одеться <официально>.",
                            "target_lang_translations": {
                                "en": "Guests were asked to dress <formally> for the gala reception.",
                                "zh": "受邀参加庆典的客人们被要求<正式>着装。"
                            }
                        },
                        {
                            "text": "Все документы были оформлены <официально> и подписаны юристом.",
                            "target_lang_translations": {
                                "en": "All documents were drawn up <officially> and signed by a lawyer.",
                                "zh": "所有文件都已<正式>办理并由律师签字。"
                            }
                        }
                    ],
                    "synonyms": [
                        "формально"
                    ],
                    "antonyms": [
                        "неофициально"
                    ],
                    "common_phrases": [
                        "выглядеть официально",
                        "одеться официально",
                        "оформлено официально"
                    ],
                    "target_lang_definitions": {
                        "en": "Observing established rules, norms, and formalities.",
                        "zh": "遵守既定的规则、规范和程序。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "formally",
                                "target_lang_sense_clarification": "regarding dress code or etiquette"
                            },
                            {
                                "target_lang_word": "officially",
                                "target_lang_sense_clarification": "according to regulations"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正式地",
                                "target_lang_sense_clarification": "符合规定或礼仪"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "546cb321-976b-3779-8a69-02efff783fd2",
                    "sense_definition": "Сдержанно, сухо, строго по-деловому; без проявления личных чувств.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Директор поздоровался с нами очень сухо и <официально>.",
                            "target_lang_translations": {
                                "en": "The director greeted us very dryly and <formally>.",
                                "zh": "经理跟我们打招呼时显得非常冷淡且<拘谨>。"
                            }
                        },
                        {
                            "text": "Она ответила <официально>, стараясь скрыть своё волнение.",
                            "target_lang_translations": {
                                "en": "She replied <formally>, trying to hide her nervousness.",
                                "zh": "她<严肃地>回答道，试图掩饰自己的紧张。"
                            }
                        }
                    ],
                    "synonyms": [
                        "сухо",
                        "сдержанно",
                        "холодно"
                    ],
                    "antonyms": [
                        "неофициально"
                    ],
                    "common_phrases": [
                        "говорить официально",
                        "звучать официально",
                        "держаться официально"
                    ],
                    "target_lang_definitions": {
                        "en": "Restrained, dry, strictly business-like; without showing personal feelings.",
                        "zh": "克制、冷淡、公事公办；不流露个人情感。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "formally",
                                "target_lang_sense_clarification": "tone or behavior"
                            },
                            {
                                "target_lang_word": "stiffly",
                                "target_lang_sense_clarification": "rigid or unfriendly manner"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "严肃地",
                                "target_lang_sense_clarification": "指态度或语气"
                            },
                            {
                                "target_lang_word": "拘谨地",
                                "target_lang_sense_clarification": "指行为举止"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f8b6c848-5445-34fa-bed6-7f4dbeeda879",
                    "sense_definition": "Краткая форма среднего рода прилагательного <w>официальный</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это приглашение слишком <официально> для встречи старых друзей.",
                            "target_lang_translations": {
                                "en": "This invitation is too <formal> for a meeting of old friends.",
                                "zh": "对于老友聚会来说，这份邀请显得太<正式>了。"
                            }
                        },
                        {
                            "text": "Ваше заявление <официально> и будет рассмотрено в установленном порядке.",
                            "target_lang_translations": {
                                "en": "Your statement is <official> and will be reviewed in due course.",
                                "zh": "您的申请是<正式>的，将按规定程序进行审理。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short neuter form of the adjective 'official'.",
                        "zh": "形容词“正式的”的中性短尾形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "official",
                                "target_lang_sense_clarification": "authorized or confirmed"
                            },
                            {
                                "target_lang_word": "formal",
                                "target_lang_sense_clarification": "ceremonial or strict"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正式",
                                "target_lang_sense_clarification": "指性质或状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}