                    },
                    {
                        "translation_id": "c7fca1e0-7e69-4c12-801d-ae481291ac93",
                        "source_entry_id": "dfbe6aa2-9d49-3b20-bdfc-dfeb117f5100",
                        "source_sense_id": "c66d525e-8345-3987-9ddf-e9ac2d63fc4c",
