                        "examples": [
                            {
                                "example_id": "da15d355-4ef1-4312-8f0f-bf7e517a62dd",
                                "sense_id": "fdf481e1-ac30-3f97-90cb-c11c6dbb7f8c",
                                "text": "Volgens de Nederlandse Vereniging van Banken gaat hennepteelt vaak samen met hypotheekfraude, zoals het onderverhuren van een pand. Als de politie dat constateert, wordt dat doorgegeven aan de hypotheekverstrekker."
                            },
                            {
                                "example_id": "6cc830eb-f050-4ccd-8551-0b770a66918e",
                                "sense_id": "fdf481e1-ac30-3f97-90cb-c11c6dbb7f8c",
                                "text": "Huizing is de tweede VVDér die dit jaar uit de Tweede Kamer stapt. In juli kondigde Johan Houwers zijn vertrek aan, nadat hij in verband was gebracht met hypotheekfraude."
                            },
                            {
                                "example_id": "69fdcadb-95de-499b-a10e-c573b3c66c39",
                                "sense_id": "fdf481e1-ac30-3f97-90cb-c11c6dbb7f8c",
                                "text": "Hypotheekfraude wordt meestal gepleegd door loonstroken, jaaropgaven of werkgeversverklaringen te vervalsen en te gebruiken bij de aanvraag van een hypotheek. Door de vervalsing wordt een beter (financieel) beeld geschetst om zo toch een hypotheek te krijgen bij een financiële instelling. Het vervalsen en gebruiken van deze documenten is een vorm van fraude: hypotheekfraude."
                            }
                        ]
                    }
