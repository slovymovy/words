                                "target_senses": [
                                    {
                                        "sense_id": "81709146-aeeb-363b-8a6e-9d5cad4f5216",
                                        "entry_id": "108cebd4-632f-35a2-baed-d943a04b73c7",
                                        "glosses": [
                                            "čin ve prospěch ostatních, obnášející velkou míru osobní statečnosti; projev / skutek hrdiny"
                                        ],
                                        "tags": [],
