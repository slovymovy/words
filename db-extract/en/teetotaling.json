                        "examples": [
                            {
                                "example_id": "90e8738a-7a03-4d64-acfa-395db57d2258",
                                "sense_id": "ac5dd7ff-aa01-3552-9f3b-b7aa70fa3beb",
                                "text": "Most were some variation of the girl-whistling, boyish, movie kind, but a few were serious, teetotalling and religious."
                            },
                            {
                                "example_id": "be6f21e6-3a56-4224-a5df-d54759377ddb",
                                "sense_id": "ac5dd7ff-aa01-3552-9f3b-b7aa70fa3beb",
                                "text": "Their teetotalling, absolutist frame of mind, along with its associated attitudes, simply closed off the option to drink."
                            },
                            {
                                "example_id": "e4c067da-b7fb-4c1e-b159-432b0bdf9e7a",
                                "sense_id": "ac5dd7ff-aa01-3552-9f3b-b7aa70fa3beb",
                                "text": "Insull was English, from an earnest, teetotalling family of modest means. He had learned shorthand and was advancing nicely in a London firm of auctioneers ..."
                            },
                            {
                                "example_id": "bbcf656b-b734-4271-a591-dcdfe2cf5d04",
                                "sense_id": "ac5dd7ff-aa01-3552-9f3b-b7aa70fa3beb",
                                "text": "The name of this spacious restaurant and lounge is an ironic reference [to] the teetotaling Andrew J. Volstead, the Minnesota congressman who sponsored the act enforcing Prohibition in 1919."
                            }
                        ]
                    }
