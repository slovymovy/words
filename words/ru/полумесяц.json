{
    "word_family": [
        "месяц",
        "месячный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "18798c71-9155-30d9-94ab-c510518cb3d1",
                    "sense_definition": "Неполный освещённый диск Луны; лунный серп",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "astronomy_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На тёмном ночном небе ярко сиял тонкий <w>полумесяц</w>.",
                            "target_lang_translations": {
                                "en": "A slender <w>crescent moon</w> shone brightly in the dark night sky."
                            }
                        },
                        {
                            "text": "Сквозь лёгкие облака временами проглядывал бледный <w>полумесяц</w>.",
                            "target_lang_translations": {
                                "en": "A pale <w>crescent moon</w> peeked through the light clouds from time to time."
                            }
                        }
                    ],
                    "synonyms": [
                        "месяц"
                    ],
                    "common_phrases": [
                        "тонкий полумесяц",
                        "яркий полумесяц"
                    ],
                    "target_lang_definitions": {
                        "en": "the curved sickle shape of the waxing or waning moon"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crescent moon",
                                "target_lang_sense_clarification": "lunar phase"
                            },
                            {
                                "target_lang_word": "crescent",
                                "target_lang_sense_clarification": "the Moon in sickle shape"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd8e427a-bf11-3dee-88c1-9e38e40fabe3",
                    "sense_definition": "Предмет, фигура или изображение в виде лунного серпа",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "astronomy_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Кулинар аккуратно защипнул края теста, придавая пирожку форму <w>полумесяца</w>.",
                            "target_lang_translations": {
                                "en": "The cook carefully pinched the edges of the dough, giving the pastry the shape of a <w>crescent</w>."
                            }
                        },
                        {
                            "text": "Серебряный <w>полумесяц</w> на цепочке был любимым украшением девушки.",
                            "target_lang_translations": {
                                "en": "A silver <w>crescent</w> on a chain was the young woman's favorite piece of jewelry."
                            }
                        }
                    ],
                    "common_phrases": [
                        "в форме полумесяца",
                        "золотой полумесяц"
                    ],
                    "target_lang_definitions": {
                        "en": "an object, figure, or symbol shaped like a crescent"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crescent",
                                "target_lang_sense_clarification": "crescent-shaped figure, ornament, or symbol"
                            },
                            {
                                "target_lang_word": "half-moon",
                                "target_lang_sense_clarification": "crescent or semicircular shape"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}