        "fr-extract.jsonl": [
            {
                "entry_id": "3d52af09-586b-331c-9f50-38dce1c30cca",
                "word": "jacobite",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8c51c76a-d787-446c-859b-7eac3c22cc36",
                        "entry_id": "3d52af09-586b-331c-9f50-38dce1c30cca",
                        "tags": [
                            "plural"
                        ],
                        "form": "jacobites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4141ee7e-d2d8-3dc6-a42f-ccd127108a1a",
                        "entry_id": "3d52af09-586b-331c-9f50-38dce1c30cca",
                        "glosses": [
                            "Relatif aux jacobites et au jacobitisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b19e22d8-ce4b-4e2b-b85c-fcc261efd8f2",
                                "sense_id": "4141ee7e-d2d8-3dc6-a42f-ccd127108a1a",
                                "text": "Les régions où les idées jacobites rencontrèrent le plus de soutien furent l'Irlande et l'Écosse."
                            },
                            {
                                "example_id": "1756600e-2a9e-4329-a1e1-85319c8c6021",
                                "sense_id": "4141ee7e-d2d8-3dc6-a42f-ccd127108a1a",
                                "text": "Sa capitale, fidèle à la dynastie jacobite, tint tête au redoutable Cromwell, subit un siège mémorable, puis, abattue par la famine et les maladies, noyée dans le sang des exécutions, finit par succomber."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d7158ad-ebe3-3c83-85a6-c72865db4537",
                        "entry_id": "3d52af09-586b-331c-9f50-38dce1c30cca",
                        "glosses": [
                            "Relatif à l’Église syriaque orthodoxe d'Antioche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "914463ed-c193-4994-88c5-47a9850bf024",
                                "sense_id": "1d7158ad-ebe3-3c83-85a6-c72865db4537",
                                "text": "Ce Pontifical syriaque donne successivement le rite de l'ordination d'un lecteur, d'un sous-diacre, du diacre, de l'archidiacre, des prêtres, des archiprêtres-visitateurs et des évêques. Le texte des divers rites est enrichi d'une enluminure. C'est un des rituels les plus importants de la liturgie jacobite. Le manuscrit a été exécuté en écriture sertô par deux copistes de la province de Syrie. Il provient des collections de l’abbé et diplomate Eusèbe Renaudot (1646-1720), célèbre orientaliste, qui le légua à la Bibliothèque de Saint-Germain-des-Prés d'où il passa à la Bibliothèque nationale à l’époque révolutionnaire. (Gallica BNF)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6de21486-c62e-4ef0-a91e-89d162996d4b",
                        "source_entry_id": "3d52af09-586b-331c-9f50-38dce1c30cca",
                        "source_sense_id": "4141ee7e-d2d8-3dc6-a42f-ccd127108a1a",
                        "target_lang_word": "Jacobite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jacobite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a21fece-7d86-3b64-ad8d-ebe4afe30ff6",
                                        "entry_id": "9d756320-9031-34a5-b3b3-07fedb8400ef",
                                        "glosses": [
                                            "A supporter of the restoration of the Stuart kings to the thrones of England and Scotland in the late 17th century."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2290893-9fb3-4488-bf39-f016dd1fbb66",
                                                "sense_id": "5a21fece-7d86-3b64-ad8d-ebe4afe30ff6",
                                                "text": "Among the Jacobites the dismay was great"
                                            },
                                            {
                                                "example_id": "11ee40fc-4b23-42f2-b22e-1f4279a1db9f",
                                                "sense_id": "5a21fece-7d86-3b64-ad8d-ebe4afe30ff6",
                                                "text": "In the later 1690s Rewse became a successful thief-taker, reaping large rewards for the capture of Jacobite conspirators, clippers, and coiners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdfcb095-aa08-305b-af0d-1748be2b052e",
                                        "entry_id": "9d756320-9031-34a5-b3b3-07fedb8400ef",
                                        "glosses": [
                                            "A member of the Syriac Orthodox Church, or historically any miaphysite or monophysite."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c7b8516-9157-3f35-b695-bd8d61f8f74c",
                                        "entry_id": "9d756320-9031-34a5-b3b3-07fedb8400ef",
                                        "glosses": [
                                            "A follower of Henry Jacob, a 16th–17th-century Puritan theologian; an early Congregationalist."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "033ab86c-8d9e-4bdc-80c8-34ea8fe91da8",
                                                "sense_id": "6c7b8516-9157-3f35-b695-bd8d61f8f74c",
                                                "text": "Dawson rightly points […] especially to the semi-separatist Henry Jacob (1563–1624), who in 1616 had founded in Southwark what is regarded as the first Congregational Church in England. These “Jacobites,” as they were called, organized around a group of ordained Anglicans who had fallen out with the established church because of its corruptions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
