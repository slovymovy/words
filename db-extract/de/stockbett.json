                        "source_sense_id": "c0a5aa32-2aeb-3764-a2aa-136b858f6371",
                        "source_sense_description": "Möbel mit übereinander angebrachten Betten",
                        "target_lang_word": "lits superposés",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lits superposés",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "806426f8-e32e-3bfc-9124-d0d979a69ed9",
                                        "entry_id": "1da58ae3-1adf-3a4d-b666-fe26577248c8",
                                        "glosses": [
                                            "Empilement de plusieurs lits (généralement deux) s’emboîtant l’un dans l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eb02da7-c554-4ae5-8a14-d5e498643054",
                                                "sense_id": "806426f8-e32e-3bfc-9124-d0d979a69ed9",
                                                "text": "Elles étaient dans leur chambres, des lits superposés, mais toutes les deux dans le même, celui du bas."
                                            },
                                            {
                                                "example_id": "0148d88f-f3a0-4004-b07d-2d7fc5f0e42e",
                                                "sense_id": "806426f8-e32e-3bfc-9124-d0d979a69ed9",
                                                "text": "Georges avait installé des lits superposés et un bureau repliable qu’il avait lui-même confectionné et qui permettait à Lisbeth, assise sur le lit du bas, de faire ses devoirs."
                                            },
                                            {
                                                "example_id": "f4ae6303-579e-4562-a78d-b5beffacf903",
                                                "sense_id": "806426f8-e32e-3bfc-9124-d0d979a69ed9",
                                                "text": "C'était un grand dortoir occupé par deux séries de lits superposés, des placards et des secrétaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
