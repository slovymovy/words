                        ]
                    },
                    {
                        "translation_id": "e1f88bc0-dc5a-4273-89ab-4cba512c4735",
                        "source_entry_id": "62e8ecd2-7752-3f41-93e7-098de0991dee",
                        "source_sense_id": "53c6f1b5-77a2-3dde-8778-b04a4076e56a",
                        "source_sense_description": "een beknopte beschrijving van een inhoud",
                        "target_lang_word": "recap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9486f4cd-f0d5-31df-aa07-0aa3d83b0c1f",
                                        "entry_id": "db978263-d924-3069-888e-53ce8c7169da",
                                        "glosses": [
                                            "To seal (something) again with a cap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20479b03-3916-4e15-b7d9-dcae4ed8f4d7",
                                                "sense_id": "9486f4cd-f0d5-31df-aa07-0aa3d83b0c1f",
                                                "text": "They're planning to recap those oil wells permanently."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a489d486-9172-3315-b676-f0289b4d0ea1",
                                        "entry_id": "db978263-d924-3069-888e-53ce8c7169da",
                                        "glosses": [
                                            "To replace the worn tread on a tire by gluing on a new outer portion."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f6289d7-44ce-412c-a203-85c31d668a3d",
                                                "sense_id": "a489d486-9172-3315-b676-f0289b4d0ea1",
                                                "text": "They buy a lot of camelback because they recap a lot of truck tires for trailer fleets."
                                            },
                                            {
                                                "example_id": "ce469d2c-706d-4107-bfb5-350f31e788f8",
                                                "sense_id": "a489d486-9172-3315-b676-f0289b4d0ea1",
                                                "text": "In 1942 almost 86,000,000 pounds of camelback—a 25-percent increase over 1941—were made available for recapping purposes, and the output of this product is continually increasing. Dealer establishments are as busy as beehives. They have about 90 percent of the recapping equipment. In the testimony before you yesterday one of the proponents of this bill admitted that independent dealers had 88 percent of all the recapping machinery there is in the United States. We estimate that it is probably about that figure, although we thought it was a little higher, probably 90 percent. In addition to recapping tires for the general public, they also are doing this work on Government-owned tires, including the military, with the result that the independent dealer has retreaded hundreds and hundreds of thousands of tires, at a substantial profit, during said period."
                                            },
                                            {
                                                "example_id": "d9107560-7985-4e86-92e1-0bf077f69fce",
                                                "sense_id": "a489d486-9172-3315-b676-f0289b4d0ea1",
                                                "text": "Are recapped tires safe? This is obviously the thing to know before you consider buying recaps."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "recap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f89bc9cd-e2bc-3ad2-bf07-a6bee74997d0",
                                        "entry_id": "9c691941-0f5e-3c11-83d3-b5fb76f39d32",
                                        "glosses": [
                                            "A tire that has had new tread glued on."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a77c077-7c0f-4642-9245-f568ae11eaa8",
                                                "sense_id": "f89bc9cd-e2bc-3ad2-bf07-a6bee74997d0",
                                                "text": "He refused to buy recaps because he didn't trust them not to come apart on the highway."
                                            },
                                            {
                                                "example_id": "9a7ee1ca-fb0e-4642-ae4c-648a435cab95",
                                                "sense_id": "f89bc9cd-e2bc-3ad2-bf07-a6bee74997d0",
                                                "text": "As she did so, Stacy noted that the tire had been a recap—a tire created by gluing a new outer portion of tread onto the worn inner core of old tires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "recap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "111310fd-3607-31a1-860e-a574f6ae71cc",
                                        "entry_id": "c2008e27-264e-328f-aa9f-d0a6857fd629",
                                        "glosses": [
                                            "A recapitulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd714859-af97-48c4-9e24-9fa0150af46f",
                                                "sense_id": "111310fd-3607-31a1-860e-a574f6ae71cc",
                                                "text": "Before we begin with today's agenda, Alice will give us a recap of recent decisions."
                                            },
                                            {
                                                "example_id": "0fcbc74c-fcd5-4ae7-88b0-c00b6806fab7",
                                                "sense_id": "111310fd-3607-31a1-860e-a574f6ae71cc",
                                                "text": "With that in mind, here is an attempt to provide an overview of what's happening where, as well as a recap on some of the major announcements that have taken place in the past few months."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "recap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48baff84-2f7d-33e7-9568-e9aca5a8bea8",
                                        "entry_id": "a3edfb3f-b613-3b5a-a012-706d8aaa0b34",
                                        "glosses": [
                                            "To recapitulate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e55d2930-079f-46f3-9393-9379c55be432",
                                                "sense_id": "48baff84-2f7d-33e7-9568-e9aca5a8bea8",
                                                "text": "Near-synonyms: review; overview"
                                            },
                                            {
                                                "example_id": "e0060233-1d15-4832-a3dd-a64130f5eb1e",
                                                "sense_id": "48baff84-2f7d-33e7-9568-e9aca5a8bea8",
                                                "text": "Before we begin with today's agenda, Alice, would you please recap the decisions that were made last week?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "recap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb9793cf-1e8d-365c-98bf-dd82a47c9f8b",
                                        "entry_id": "c80bc3e9-4430-3653-a45b-a1f12012699f",
                                        "glosses": [
                                            "A leveraged recapitalization accomplished by increasing the debt to equity ratio."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3236c87b-b205-416b-8d61-0c12f57998e8",
                                                "sense_id": "fb9793cf-1e8d-365c-98bf-dd82a47c9f8b",
                                                "text": "A survey of private equity firms found that most firms are comfortable with a debt/equity ratio of 4:1 following a dividend recap."
                                            }
                                        ]
