{
    "word_family": [
        "fertility",
        "fertilize",
        "fertilizer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "758d0b4a-18d8-3c70-818f-341949a4cc4d",
                    "sense_definition": "Of land or soil, capable of producing abundant crops or vegetation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "productive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fertile</w> soil in the valley allows farmers to grow many different vegetables.",
                            "target_lang_translations": {
                                "zh": "山谷里<w>肥沃</w>的土壤让农民们能够种植各种各样的蔬菜。"
                            }
                        },
                        {
                            "text": "Ancient civilizations often settled near rivers because the land was very <w>fertile</w>.",
                            "target_lang_translations": {
                                "zh": "古代文明通常在河流附近定居，因为那里的土地非常<w>肥沃</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fruitful",
                        "productive"
                    ],
                    "antonyms": [
                        "barren",
                        "infertile"
                    ],
                    "common_phrases": [
                        "fertile soil",
                        "fertile land"
                    ],
                    "target_lang_definitions": {
                        "zh": "指土地或土壤，能够生长出茂盛的农作物或植被。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "肥沃",
                                "target_lang_sense_clarification": "形容土地适合耕种，养分充足。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fbf2777-f211-39e9-b0d8-7d45d8d6f628",
                    "sense_definition": "Capable of reproducing or bearing offspring.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "productive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most women at the age of fifty are not <w>fertile</w>.",
                            "target_lang_translations": {
                                "zh": "大多数五十岁的女性已不再<w>有生育能力</w>。"
                            }
                        },
                        {
                            "text": "The doctor explained that the couple was having trouble conceiving because one partner was not <w>fertile</w>.",
                            "target_lang_translations": {
                                "zh": "医生解释说，这对夫妇难以受孕是因为其中一方<w>没有生育能力</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prolific"
                    ],
                    "antonyms": [
                        "sterile",
                        "infertile"
                    ],
                    "target_lang_definitions": {
                        "zh": "指生物具有生育或繁衍后代的能力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "有生育能力的",
                                "target_lang_sense_clarification": "指生物学上具备繁衍后代的功能。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d8edec4-d7c0-389f-adb8-0527ccaefe4f",
                    "sense_definition": "Characterized by an active and creative imagination.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "productive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author had a <w>fertile</w> imagination that produced many unique stories.",
                            "target_lang_translations": {
                                "zh": "这位作者有着<w>丰富</w>的想象力，创作出了许多独特的故事。"
                            }
                        },
                        {
                            "text": "His <w>fertile</w> mind was always coming up with new inventions.",
                            "target_lang_translations": {
                                "zh": "他那<w>活跃</w>的头脑总能想出新的发明。"
                            }
                        }
                    ],
                    "synonyms": [
                        "productive"
                    ],
                    "common_phrases": [
                        "fertile imagination"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容人的想象力丰富，富有创造力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "丰富的",
                                "target_lang_sense_clarification": "形容想象力或思维活跃。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49ff2c66-d68d-3e93-99c9-2134961a94ad",
                    "sense_definition": "Capable of developing into a living organism after fertilization.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "productive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biologist checked the eggs to see if they were <w>fertile</w>.",
                            "target_lang_translations": {
                                "zh": "生物学家检查了这些蛋，看看它们是否是<w>受精</w>的。"
                            }
                        },
                        {
                            "text": "Only <w>fertile</w> eggs will hatch into chicks.",
                            "target_lang_translations": {
                                "zh": "只有<w>受精</w>的蛋才能孵化出小鸡。"
                            }
                        }
                    ],
                    "antonyms": [
                        "infertile"
                    ],
                    "common_phrases": [
                        "fertile egg"
                    ],
                    "target_lang_definitions": {
                        "zh": "指卵或种子在受精后能够发育成生命体。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "受精的",
                                "target_lang_sense_clarification": "指卵子已受精，具备孵化条件。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "109d77b7-00e5-3ad4-b6e7-0e75c473617f",
                    "sense_definition": "Able to be converted into fissile material through nuclear irradiation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "productive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are two basic <w>fertile</w> materials: uranium-238 and thorium-232.",
                            "target_lang_translations": {
                                "zh": "有两种基本的<w>增殖性</w>材料：铀-238和钍-232。"
                            }
                        },
                        {
                            "text": "Scientists study <w>fertile</w> isotopes to improve nuclear fuel efficiency.",
                            "target_lang_translations": {
                                "zh": "科学家研究<w>增殖性</w>同位素以提高核燃料效率。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fertile material"
                    ],
                    "target_lang_definitions": {
                        "zh": "指能够通过核辐射转化为裂变材料的物质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "增殖性",
                                "target_lang_sense_clarification": "核物理术语，指可转化为核燃料的物质。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bd9de716-4508-3583-b23e-9e013517181d",
                    "sense_definition": "A city and township in Iowa.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to move to <w>Fertile</w> for a quieter life.",
                            "target_lang_translations": {
                                "zh": "他们决定搬到<w>弗蒂尔</w>去过更安静的生活。"
                            }
                        },
                        {
                            "text": "The small town of <w>Fertile</w> is located in northern Iowa.",
                            "target_lang_translations": {
                                "zh": "<w>弗蒂尔</w>小镇位于爱荷华州北部。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "位于美国爱荷华州的一个城市和乡镇。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "弗蒂尔",
                                "target_lang_sense_clarification": "地名音译。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d09f5027-631c-334f-b58e-02945eed7ce6",
                    "sense_definition": "A city in Minnesota.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We drove through <w>Fertile</w> on our way to the lake.",
                            "target_lang_translations": {
                                "zh": "我们在去湖边的路上开车经过了<w>弗蒂尔</w>。"
                            }
                        },
                        {
                            "text": "The community of <w>Fertile</w> is known for its local festivals.",
                            "target_lang_translations": {
                                "zh": "<w>弗蒂尔</w>社区以其当地的节日而闻名。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "位于美国明尼苏达州的一个城市。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "弗蒂尔",
                                "target_lang_sense_clarification": "地名音译。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}