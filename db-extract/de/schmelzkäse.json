                "senses": [
                    {
                        "sense_id": "fc8afaf5-0887-3682-8ef7-5ec90b1f2d1b",
                        "entry_id": "e09a589a-6898-35cb-bfed-61eec05da4c7",
                        "glosses": [
                            "durch Schmelzen von Käse unter Zugabe weiterer Ingredienzien gewonnener Käse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "095ba7c4-1490-4bd2-86be-68ce9a2810f5",
                                "sense_id": "fc8afaf5-0887-3682-8ef7-5ec90b1f2d1b",
                                "text": "„Jetzt kamen auch Josianne und Angel hinzu, sie hatten beide dick mit Schmelzkäse beschmierte Baguettescheiben in den Händen.“"
                            },
                            {
                                "example_id": "d663fb2e-4732-4bef-9317-921fa7b61721",
                                "sense_id": "fc8afaf5-0887-3682-8ef7-5ec90b1f2d1b",
                                "text": "„Ich will noch nicht die einzige Salami anbrechen, weil sie mir inmitten der Büchsenwurst, dem Dosenfisch und dem Schmelzkäse wie ein Heiligtum vorkommt, das ich nicht verschwenden darf.“"
                            }
                        ],
