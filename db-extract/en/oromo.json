                        "source_sense_id": "25e6571c-c30c-331d-afc9-3b3c2ab362bc",
                        "source_sense_description": "A member of a people of eastern Africa, Ethiopia and northern Kenya",
                        "target_lang_word": "Oromo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oromo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "876b3a78-a596-399d-8c41-f113d3b4dfef",
                                        "entry_id": "05c1b2e7-9592-34e3-a68b-aec882eecffa",
                                        "glosses": [
                                            "Peuple de la Corne de l’Afrique, principalement en Éthiopie, mais aussi au Kenya, en Somalie ou à Djibouti."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45df2d91-f757-4b4d-8b6c-936e66027f1c",
                                                "sense_id": "876b3a78-a596-399d-8c41-f113d3b4dfef",
                                                "text": "Les Oromos, plus de 20 millions d’individus, constituent le premier peuple d’une Éthiopie évaluée à 55 millions d’habitants."
                                            },
                                            {
                                                "example_id": "d468e41f-fa15-4725-ae7a-f5452e413562",
                                                "sense_id": "876b3a78-a596-399d-8c41-f113d3b4dfef",
                                                "text": "Les Oromo musulmans affirment ainsi que leur ancêtre éponyme était le fils d’un certain Omer, originaire de Ghellad en Arabie, qui traversa le Golfe arabique, rejoignit Berbera sur les côtes de la Somalie septentrionale et s’installa en Afrique."
                                            },
                                            {
                                                "example_id": "b548f58a-73ed-472e-8b24-4557ce860828",
                                                "sense_id": "876b3a78-a596-399d-8c41-f113d3b4dfef",
                                                "text": "Il y a les Oromos, premier groupe ethnique du pays (35-40 % de la population) auquel appartient le premier ministre, mais dont les dirigeants régionaux sont en ce moment alliés avec les Tigréens dans leur campagne militaire contre le gouvernement fédéral."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
