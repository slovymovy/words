                        "glosses": [
                            "groot bedrijf dat woningen, bedrijfspanden en andere gebouwen maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "145d9138-5dfd-463b-b5d9-ca0e42074deb",
                                "sense_id": "da5678ff-8fcb-394d-8427-296ed06986e0",
                                "text": "Shijiazhuang, dat nu 10 miljoen inwoners telt, moet groeien naar een megametropool met 15 miljoen inwoners, naar een chemisch en farmaceutisch wereldcentrum, waar niet alleen iedereen goed werk heeft en een mooi appartement bewoont, maar ook „gelukkig” is, zo blijkt uit de folders van de bouwmaatschappijen."
                            },
                            {
                                "example_id": "81fc85bc-93cc-4aaf-8049-51e546905aef",
                                "sense_id": "da5678ff-8fcb-394d-8427-296ed06986e0",
                                "text": "Vader was aannemer en opzichter bij een bouwmaatschappij, moeder was schoonmaakster."
                            }
                        ]
                    }
                ],
