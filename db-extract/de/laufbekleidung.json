                "senses": [
                    {
                        "sense_id": "7d39aa2a-047a-325a-a7ec-aad52b605459",
                        "entry_id": "ffcff25a-2e49-3e50-afd7-e5f36efed65c",
                        "glosses": [
                            "Sportbekleidung, die speziell fürs Laufen gedacht ist"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "33df0117-8b64-440a-bbfb-cd749cca70c2",
                                "sense_id": "7d39aa2a-047a-325a-a7ec-aad52b605459",
                                "text": "„Das Unternehmen bietet eine Bandbreite an Produkten an, darunter auch Laufbekleidung und Funktionswäsche in allen möglichen Varianten.“"
                            },
                            {
                                "example_id": "02c5c8be-6cff-4d09-a59b-eca63267371a",
                                "sense_id": "7d39aa2a-047a-325a-a7ec-aad52b605459",
                                "text": "„Nachhaltige Laufbekleidung ist aus Materialien hergestellt, die entweder wiederverwertet, recycelt oder nachwachsend sind.“"
                            },
                            {
                                "example_id": "012780b9-2417-475d-b3f9-5f5993a008a0",
                                "sense_id": "7d39aa2a-047a-325a-a7ec-aad52b605459",
                                "text": "„Wirf einen Blick auf unsere Laufbekleidung und Accessoires für Mädchen, die zu unseren Mädchenschuhen passen, damit dein Kind für jeden Lauf die richtige Ausrüstung hat.“"
                            },
                            {
                                "example_id": "f6e2e4fa-bf9f-45c1-87c5-bac01145bf98",
                                "sense_id": "7d39aa2a-047a-325a-a7ec-aad52b605459",
                                "text": "„Laufbekleidung wird heutzutage nicht mehr nur für sportliche Aktivitäten verwendet, sondern auch als modisches Statement getragen.“"
                            },
                            {
                                "example_id": "093e1a94-c2a9-4870-80cd-841e2d4cc74b",
                                "sense_id": "7d39aa2a-047a-325a-a7ec-aad52b605459",
                                "text": "„Die beiden Gründerinnen waren enttäuscht von der eher durchschnittlichen und unmodischen Laufbekleidung, die auf dem Markt zu finden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
