{
    "word_family": [
        "facilitate",
        "facilitation",
        "facilitative",
        "facility"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6afcf952-d861-3b99-8cb1-ae2610ffd2bf",
                    "sense_definition": "A person who helps a group work together more effectively or reach agreement without taking a side in the discussion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "facilitator_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workshop <w>facilitator</w> encouraged everyone to share their thoughts openly.",
                            "target_lang_translations": {
                                "ru": "<w>Фасилитатор</w> семинара призвал всех открыто делиться своими мыслями."
                            }
                        },
                        {
                            "text": "She acted as a neutral <w>facilitator</w> during the heated contract negotiations.",
                            "target_lang_translations": {
                                "ru": "Она выступала в качестве нейтрального <w>посредника</w> во время напряжённых переговоров по контракту."
                            }
                        }
                    ],
                    "synonyms": [
                        "mediator",
                        "moderator"
                    ],
                    "common_phrases": [
                        "discussion facilitator",
                        "meeting facilitator",
                        "workshop facilitator"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который помогает группе работать более эффективно или достичь согласия, не занимая ничьей стороны в обсуждении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фасилитатор",
                                "target_lang_sense_clarification": "ведущий групповой работы или дискуссии"
                            },
                            {
                                "target_lang_word": "посредник",
                                "target_lang_sense_clarification": "нейтральное лицо в переговорах"
                            },
                            {
                                "target_lang_word": "модератор",
                                "target_lang_sense_clarification": "руководитель обсуждения или встречи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac67c684-d75e-3d97-bf4c-e80120e411ee",
                    "sense_definition": "Something that makes a process, action, or outcome easier or more likely to occur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "facilitator_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern technology has proven to be a powerful <w>facilitator</w> of global communication.",
                            "target_lang_translations": {
                                "ru": "Современные технологии оказались мощным <w>катализатором</w> глобальной коммуникации."
                            }
                        },
                        {
                            "text": "Trust within a team serves as an essential <w>facilitator</w> of successful collaboration.",
                            "target_lang_translations": {
                                "ru": "Доверие внутри команды служит важнейшим <w>фактором, способствующим</w> успешному сотрудничеству."
                            }
                        }
                    ],
                    "synonyms": [
                        "catalyst",
                        "enabler"
                    ],
                    "antonyms": [
                        "hindrance",
                        "obstacle"
                    ],
                    "common_phrases": [
                        "key facilitator"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фактор, условие или средство, облегчающее какой-либо процесс или способствующее достижению результата."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "катализатор",
                                "target_lang_sense_clarification": "фактор, ускоряющий или облегчающий процесс"
                            },
                            {
                                "target_lang_word": "фактор, способствующий чему-либо",
                                "target_lang_sense_clarification": "условие, стимулирующее развитие событий"
                            },
                            {
                                "target_lang_word": "движущая сила",
                                "target_lang_sense_clarification": "то, что продвигает или упрощает процесс"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}