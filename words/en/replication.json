                        {
                            "text": "Database <w>replication</w> helps improve the fault tolerance of our servers.",
                            "target_lang_translations": {
                                "ru": "<w>Репликация</w> баз данных помогает повысить отказоустойчивость наших серверов."
                            }
                        }
