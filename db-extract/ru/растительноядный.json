                ],
                "senses": [
                    {
                        "sense_id": "6d9e2627-39aa-3d65-8cdf-d9f1573cd604",
                        "entry_id": "dad062fa-4e64-3615-9213-386f15cdae49",
                        "glosses": [
                            "питающийся растениями, продуктами растительного происхождения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d85b9212-87ba-472e-ac96-22d088d79b93",
                                "sense_id": "6d9e2627-39aa-3d65-8cdf-d9f1573cd604",
                                "text": "Вот так и получилось, что человеческий организм совмещает два типа звериного питания: растительноядный и плотоядный; но растительноядность — склонность первичная, более устойчивая; плотоядность — вторичная."
                            },
                            {
                                "example_id": "b53ef993-3a68-4a89-b745-90ce15b94889",
                                "sense_id": "6d9e2627-39aa-3d65-8cdf-d9f1573cd604",
                                "text": "Согласно базе данных «СПАРК-Интерфакс» ОАО «Специализированный рыборазводный завод растительноядных рыб» зарегистрировано в республике Адыгея в 2004 году, занимается воспроизводством рыбы и водных биоресурсов, а также выловом рыбы и её реализацией."
                            }
                        ]
                    }
