                            {
                                "target_lang_word": "наслаждаться",
                                "target_lang_sense_clarification": "отдыхом, свежим воздухом"
                            },
                            {
                                "target_lang_word": "вкушать",
                                "target_lang_sense_clarification": "книжн., покой или отдых"
                            },
                            {
                                "target_lang_word": "дышать",
                                "target_lang_sense_clarification": "свежим воздухом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebc04628-392d-3699-beb1-029e241519e1",
                    "sense_definition": "zaskakiwać kogoś śmiałym, niespodziewanym zachowaniem lub pytaniem, stawiając go w trudnej sytuacji",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zaskakiwanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziennikarz często <w>zażywa</w> polityków trudnymi pytaniami podczas wywiadów na żywo.",
                            "target_lang_translations": {
                                "ru": "Журналист часто <w>ставит в тупик</w> политиков трудными вопросами во время прямых эфиров."
                            }
                        },
                        {
                            "text": "Swoją nagłą szczerością potrafił <w>zażywać</w> nawet najbardziej doświadczonych rozmówców.",
                            "target_lang_translations": {
                                "ru": "Своей внезапной искренностью он умел <w>обескураживать</w> даже самых опытных собеседников."
                            }
                        }
                    ],
                    "common_phrases": [
