                "senses": [
                    {
                        "sense_id": "c8b675bd-a124-37c2-94f4-10c2d51688ee",
                        "entry_id": "b34d2177-7026-30cf-bda3-bbb7c406aa8d",
                        "glosses": [
                            "La Bibliothèque nationale."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "312ee2ca-9770-4cee-b75c-d169e2aa0093",
                                "sense_id": "c8b675bd-a124-37c2-94f4-10c2d51688ee",
                                "text": "Je suivais à la Sorbonne et à l’École normale tous les cours d’agrégation, et, selon les horaires, j’allais étudier à Sainte-Geneviève, à Victor-Cousin, ou à la Nationale."
                            }
                        ]
                    }
                ],
