                "senses": [
                    {
                        "sense_id": "a5f2e5da-e734-340d-8ae8-aa704c6654ca",
                        "entry_id": "cd54192f-443e-338a-a96f-c9243d6c03ca",
                        "glosses": [
                            "\\\"70\\\", het getal tussen negenenzestig en eenenzeventig, zeven maal tien"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2e6b0461-c07e-3118-8b6a-25c5235f100e",
                        "entry_id": "cd54192f-443e-338a-a96f-c9243d6c03ca",
                        "glosses": [
                            "\\\"70\\\", het getal tussen negenenzestig en eenenzeventig, zeven maal tien",
                            "om een hoeveelheid aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8be4f3ed-f311-47f8-be16-38a5883dd2f1",
                                "sense_id": "2e6b0461-c07e-3118-8b6a-25c5235f100e",
                                "text": "In De Gids van Smit vindt Nella onder de 'B' een bloemist die Hendrickson heet, een man wiens overgrootvader zo'n zeventig jaar geleden een fortuin verdiende aan de tulpengekte."
                            },
                            {
                                "example_id": "085a2656-2d50-442a-b0c4-1945e41e1b3a",
                                "sense_id": "2e6b0461-c07e-3118-8b6a-25c5235f100e",
                                "text": "De totale kosten bedragen zeventig euro en zevenendertig cent."
                            }
                        ]
                    },
                    {
                        "sense_id": "96a8a851-6748-3b80-b1dd-7c01659e0870",
                        "entry_id": "cd54192f-443e-338a-a96f-c9243d6c03ca",
                        "glosses": [
                            "\\\"70\\\", het getal tussen negenenzestig en eenenzeventig, zeven maal tien",
                            "om een plaats in een volgorde aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ee42ff7-5a15-4b20-8596-2e6f08fe9d36",
                                "sense_id": "96a8a851-6748-3b80-b1dd-7c01659e0870",
                                "text": "De vorige avond had Candida ons een album laten zien met door de tijd vergeelde foto's van die oude villa's met suggestieve namen, die in de jaren zestig en zeventig waren afgebroken."
                            },
                            {
                                "example_id": "5444d981-9c49-4bc6-91b1-1d06c5eef8a2",
                                "sense_id": "96a8a851-6748-3b80-b1dd-7c01659e0870",
                                "text": "Het juiste antwoord op opgave zeventig is \"42\"."
                            },
                            {
                                "example_id": "6ad7bbbb-538c-4229-b8e8-530e8afafe8c",
                                "sense_id": "96a8a851-6748-3b80-b1dd-7c01659e0870",
                                "text": "‘Zwerftochten’ werd dat genoemd, een filosofie binnen de bergsport die ontstond in de jaren zeventig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97d3cf80-563d-441f-a876-5b588bc07b70",
                        "source_entry_id": "cd54192f-443e-338a-a96f-c9243d6c03ca",
                        "source_sense_id": "a5f2e5da-e734-340d-8ae8-aa704c6654ca",
                        "source_sense_description": "het getal 70",
                        "target_lang_word": "siebzig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "siebzig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b3361f8-8886-311b-bc6a-93c35d227ea4",
                                        "entry_id": "832dc207-77c8-30bc-a5a0-01fbbdda0ae7",
                                        "glosses": [
                                            "sieben mal zehn, die Kardinalzahl zwischen 69 und 71"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c66d96d5-8501-4906-ab58-c340cefebc58",
                                                "sense_id": "2b3361f8-8886-311b-bc6a-93c35d227ea4",
                                                "text": "Das sind siebzig Stück."
                                            },
                                            {
                                                "example_id": "5ff5bc53-948c-462a-877a-4730db5cceba",
                                                "sense_id": "2b3361f8-8886-311b-bc6a-93c35d227ea4",
                                                "text": "Es waren aber ihrer siebzig."
                                            },
                                            {
                                                "example_id": "137699bf-aee3-4e5f-b7c5-0a1c4c5585a1",
                                                "sense_id": "2b3361f8-8886-311b-bc6a-93c35d227ea4",
                                                "text": "Mit siebzig ist man definitiv alt."
                                            },
                                            {
                                                "example_id": "b1fc0556-ca95-403b-acc1-5c321c5571c4",
                                                "sense_id": "2b3361f8-8886-311b-bc6a-93c35d227ea4",
                                                "text": "Er schlich mit siebzig über die Autobahn."
                                            },
                                            {
                                                "example_id": "82e485af-6a9d-4df5-807a-e5ba16d4e3eb",
                                                "sense_id": "2b3361f8-8886-311b-bc6a-93c35d227ea4",
                                                "text": "„Und alle leiblichen Nachkommen Jakobs zusammen waren siebzig an Zahl.“"
                                            },
                                            {
                                                "example_id": "96f505f3-19e7-4a53-8b96-675ed2d5665f",
                                                "sense_id": "2b3361f8-8886-311b-bc6a-93c35d227ea4",
                                                "text": "„So viel Würde, Geduld und Ernst, wie er in seinem Gesicht zeigte, haben wir einmal für die Abzeichen der Ehrlichkeit gehalten; damit ist er auf seine siebzig Jahre gekommen.“"
                                            },
                                            {
                                                "example_id": "210d7e5c-2fba-4e7a-8d04-761943638afb",
                                                "sense_id": "2b3361f8-8886-311b-bc6a-93c35d227ea4",
                                                "text": "„So mit siebzig war der Fahrer auf einer kurvigen Straße im Odenwald unterwegs, den rechts kommenden Schatten hat er gerade noch wahrgenommen, dann hat es auch schon gekracht. Siebzig ist nicht schnell, sollte man meinen. Siebzig ist schnell, wenn man mit einem 80-Kilo-Brocken kollidiert.“"
                                            },
                                            {
                                                "example_id": "ef5170f6-40c3-457f-a125-9b416ddbb27d",
                                                "sense_id": "2b3361f8-8886-311b-bc6a-93c35d227ea4",
                                                "text": "„Mein Gott, wie sich diese Frau mit ihren siebzig Jahren verändert hatte.“"
                                            },
                                            {
                                                "example_id": "44df38fe-75bb-4eea-b679-8f7cd843160c",
                                                "sense_id": "2b3361f8-8886-311b-bc6a-93c35d227ea4",
                                                "text": "„Radprofis, die gerade mit siebzig Sachen über den Zielstrich gerauscht sind, sausen die Straße weiter entlang zu ihren Teambussen.“"
                                            },
                                            {
                                                "example_id": "d7034086-5e2d-481a-a710-a67462e3bb96",
                                                "sense_id": "2b3361f8-8886-311b-bc6a-93c35d227ea4",
                                                "text": "„Von den hundert Leuten im Dorf waren fast alle über fünfzig und sahen aus wie über siebzig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
