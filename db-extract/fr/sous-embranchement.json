                                                "sense_id": "b5312fcc-fb67-3fae-aedb-e6981d862502",
                                                "text": "They're putting in a new subdivision out past Black Ranch Road."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9232ed8-141a-3d49-a499-f2b448ae44a5",
                                        "entry_id": "ee4714c6-d77f-3072-b9a7-8693b15028b5",
                                        "glosses": [
                                            "A gated community located within a barangay."
                                        ],
                                        "tags": [
