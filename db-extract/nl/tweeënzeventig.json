                        "examples": [
                            {
                                "example_id": "720f1da2-e32a-411d-bdc0-87ab51ea5115",
                                "sense_id": "0634a733-fc18-3650-9c69-6514729a7e52",
                                "text": "Het is weer de tweeënzeventig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "ef9d9e53-d907-4c58-a6a5-bcbd243f5497",
                                "sense_id": "0634a733-fc18-3650-9c69-6514729a7e52",
                                "text": "Haar drieënzeventigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de tweeënzeventig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "a988a542-8032-3efb-92b6-8849c6bd508b",
                        "entry_id": "6ef8a17a-a33d-34ba-95d0-f8bab44e4a69",
                        "glosses": [
                            "groep van 72 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22be5fae-e8fe-490c-b0d5-141b3be0506d",
                                "sense_id": "a988a542-8032-3efb-92b6-8849c6bd508b",
                                "text": "De tweeënzeventig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
