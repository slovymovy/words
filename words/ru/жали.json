                {
                    "sense_id": "c97b594e-8175-332c-87bf-c6479cdc5a27",
                    "sense_definition": "Множественное число прошедшего времени несовершенного вида глагола <w>жать</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatical_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Они <w>жали</w> рожь в поле весь день.",
                            "target_lang_translations": {
                                "de": "Sie <w>ernteten</w> den ganzen Tag Roggen auf dem Feld."
                            }
                        },
                        {
                            "text": "Люди <w>жали</w> руки друг другу при встрече.",
                            "target_lang_translations": {
                                "de": "Die Leute <w>drückten</w> sich bei der Begrüßung die Hände."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Грамматическая форма глагола"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Pluralform der Vergangenheitsform (Präteritum) des unvollendeten Verbs 'жать' (ernten oder drücken/pressen)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ernteten",
                                "target_lang_sense_clarification": "im Sinne von Getreide einbringen"
                            },
                            {
                                "target_lang_word": "drückten",
                                "target_lang_sense_clarification": "im Sinne von physischem Druck ausüben oder Hände schütteln"
                            }
                        ]
                    }
                }
            ]
        },
        {
