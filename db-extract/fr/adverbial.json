                                                "example_id": "5635b2e6-e3aa-4837-9083-03300f378dab",
                                                "sense_id": "ad916c82-26a6-3475-9ac6-0155b95d414f",
                                                "text": "Ortsangaben in Sätzen erscheinen als adverbiale Bestimmung des Ortes."
                                            },
                                            {
                                                "example_id": "e15221ad-dd4c-4d03-888a-6b7abb6726eb",
                                                "sense_id": "ad916c82-26a6-3475-9ac6-0155b95d414f",
                                                "text": "Adjektivische Satzglieder können ebenso wie adverbiale Satzglieder in der grammatischen Funktion einer adverbialen Bestimmung verwendet werden."
                                            },
                                            {
                                                "example_id": "a292cc0c-d8bc-4f03-b285-adde7c1641a4",
                                                "sense_id": "ad916c82-26a6-3475-9ac6-0155b95d414f",
                                                "text": "„Man kann die Adjektive prädikativ, adverbial und attributiv verwenden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
