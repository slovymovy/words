                "translations": [
                    {
                        "translation_id": "83eca509-3941-4dcc-b520-f95b15f62187",
                        "source_entry_id": "61c83e21-8ace-3576-9a01-2b39a39015c6",
                        "target_lang_word": "show off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "show off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acc292ed-d02c-32f9-9f43-805f00d6c57a",
                                        "entry_id": "d5a5bf0a-9ba4-32d6-81b5-55fdc3cd7fc9",
                                        "glosses": [
                                            "To exhibit the best attributes of something."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bebcf29d-27a9-4bf3-8811-04d61f4ba81b",
                                                "sense_id": "acc292ed-d02c-32f9-9f43-805f00d6c57a",
                                                "text": "Grocery stores show off their produce by placing the most attractive specimens in front."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3800fdc-b0f5-3aed-9124-d8de27db0c29",
                                        "entry_id": "d5a5bf0a-9ba4-32d6-81b5-55fdc3cd7fc9",
                                        "glosses": [
                                            "To attract attention to for the purpose of bragging or personal exhibitionism; to demonstrate a skill, talent or property for the purpose of bragging or personal exhibitionism."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64fbb374-2db8-40da-a20a-1b91d153533d",
                                                "sense_id": "e3800fdc-b0f5-3aed-9124-d8de27db0c29",
                                                "text": "She loves to show off her driving prowess."
                                            },
                                            {
                                                "example_id": "fe3a1bc2-c4b5-4172-b715-e470511eb755",
                                                "sense_id": "e3800fdc-b0f5-3aed-9124-d8de27db0c29",
                                                "text": "She loves to show off when she gets behind the wheel of a car."
                                            },
                                            {
                                                "example_id": "354df866-4f1a-4552-afbe-74acebaf7689",
                                                "sense_id": "e3800fdc-b0f5-3aed-9124-d8de27db0c29",
                                                "text": "“Listen, my Oscar,” she said, resuming at once her tender voice, “you have a propensity to talk, and to tell all you know, and all that you don’t know; and you do it to show off, with the foolish vanity of a mere lad.[…]”"
                                            },
                                            {
                                                "example_id": "925a5b52-f307-4ff6-a820-38c606b2acf1",
                                                "sense_id": "e3800fdc-b0f5-3aed-9124-d8de27db0c29",
                                                "text": "If you've just acquired a Google Glass headset for £1,000, don't show it off at the movies. UK cinemas are to ban the headsets over fears that the gadgets can be used to make pirate copies of Hollywood blockbusters."
                                            },
                                            {
                                                "example_id": "8e8b0df0-e8ec-41a4-bba2-385f63000fcc",
                                                "sense_id": "e3800fdc-b0f5-3aed-9124-d8de27db0c29",
                                                "text": "She told the press that the group had been for an evening out and that the driver has been showing off by driving fast."
                                            }
                                        ]
                                    }
                                ]
                            },
