                        "cross_references": [
                            {
                                "target_word": "jéjunum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14a84341-39e9-3447-a419-8cb8cc3b027a",
                                        "entry_id": "c7886c6b-8421-3fb9-b30f-391527c2855f",
                                        "glosses": [
                                            "Partie centrale de l’intestin grêle entre le duodénum et l’iléon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3690c959-a533-4396-a58c-27294c2d3289",
                                                "sense_id": "14a84341-39e9-3447-a419-8cb8cc3b027a",
                                                "text": "Le jéjunum, ainsi appelé parce qu’à l’examen cadavérique on ne trouve dans sa cavité que peu ou point de matières alimentaires, se compose de la moitié de l’intestin grêle qui fait suite au duodénum."
                                            },
                                            {
                                                "example_id": "511705b9-d9b8-46bc-9edd-77b5435f20f3",
                                                "sense_id": "14a84341-39e9-3447-a419-8cb8cc3b027a",
                                                "text": "Mais je me sens une boule sur le jéjunum qui m’oppresse au point que je voudrais m’acheter une robe neuve, une belle robe comme celle de Mme Baoghal, une robe française."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbab8b74-50c5-4b4e-9f27-9c9f983b84a7",
                        "source_entry_id": "aac2bdf5-19c7-3012-a626-f0d014330d87",
                        "source_sense_id": "b7623980-6d44-3117-bb7b-69e7adc46245",
