                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6951d8f2-7d91-4e42-8e1a-e6660a550403",
                                "sense_id": "693e5145-f5b9-3c01-b494-c61812927aab",
                                "text": "Selbst erfahrene Entertainer können vor einem Fernsehauftritt noch Lampenfieber bekommen."
                            },
                            {
                                "example_id": "672000e0-120d-46f1-974a-1e893094f8ab",
                                "sense_id": "693e5145-f5b9-3c01-b494-c61812927aab",
                                "text": "„Ein leichtes Zittern in Hamanns Stimme verrät das Lampenfieber vor dem ersten Auftritt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3976e0f9-e016-318b-aeaa-ddfdb0df4f4e",
                        "entry_id": "0443eb25-e6ff-36e4-8c61-928df03beceb",
                        "glosses": [
                            "die Anspannung oder gar Panik eines Menschen kurz vor einem Auftritt vor (meist vielen) Personen"
                        ],
                        "tags": [
                            "im übertragenen Sinne"
                        ],
                        "examples": [
                            {
                                "example_id": "b053b884-7982-4a70-99b8-7633425b8f55",
                                "sense_id": "3976e0f9-e016-318b-aeaa-ddfdb0df4f4e",
                                "text": "Die Braut hatte Lampenfieber und zögerte einige Minuten lang, die Kirche zu betreten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eed8fc44-8d24-47a0-850b-10e80027b864",
                        "source_entry_id": "0443eb25-e6ff-36e4-8c61-928df03beceb",
                        "source_sense_id": "693e5145-f5b9-3c01-b494-c61812927aab",
                        "source_sense_description": "die Anspannung eines darstellenden Künstlers kurz vor einem Bühnenauftritt",
                        "target_lang_word": "stage fright",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stage fright",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df7d681f-38ca-3963-bb27-692423397aac",
                                        "entry_id": "bd1b662c-778a-3b85-a40c-612670754d8e",
                                        "glosses": [
                                            "A state of nervousness about performing some action in front of a group of people, on or off of a stage; nerves; a lack of self-assurance before an audience."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c143add-a5ce-414f-a0fc-8b66c88c0301",
                                                "sense_id": "df7d681f-38ca-3963-bb27-692423397aac",
                                                "text": "I did some guest-speaking at the middle school last year, and I experienced some stage fright before and during my first presentation."
                                            },
                                            {
                                                "example_id": "9e6a5b4a-9bf0-40b7-b4e3-26ad7a8cfd5b",
                                                "sense_id": "df7d681f-38ca-3963-bb27-692423397aac",
                                                "text": "I got stage fright while doing a dance show for my school last year."
                                            },
                                            {
                                                "example_id": "d81690a9-deec-4bdb-b2d0-6ff0d9231384",
                                                "sense_id": "df7d681f-38ca-3963-bb27-692423397aac",
                                                "text": "It is a very good training, and ofttimes will cure one of camera-fright, which is the silent sister to stage-fright."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2b039fc-1e22-3cf2-9cd8-33f7345235b5",
                                        "entry_id": "bd1b662c-778a-3b85-a40c-612670754d8e",
                                        "glosses": [
                                            "Synonym of paruresis."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e149c1b-7571-4a46-bfb3-f72137c31e7c",
                        "source_entry_id": "0443eb25-e6ff-36e4-8c61-928df03beceb",
                        "source_sense_id": "693e5145-f5b9-3c01-b494-c61812927aab",
