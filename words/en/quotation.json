{
    "word_family": [
        "quote",
        "quotable",
        "misquote",
        "misquotation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "babee3a8-80c1-31b9-8083-5d7862657b8b",
                    "sense_definition": "A fragment of a human expression that is repeated by somebody else, for example from literature or a famous speech.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "literary_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker opened his presentation with a famous <w>quotation</w> from Martin Luther King Jr.",
                            "target_lang_translations": {
                                "ru": "Оратор открыл свою презентацию известной <w>цитатой</w> Мартина Лютера Кинга-младшего."
                            }
                        },
                        {
                            "text": "I am looking for a short <w>quotation</w> to include in my graduation speech.",
                            "target_lang_translations": {
                                "ru": "Я ищу короткую <w>цитату</w>, чтобы включить её в свою выпускную речь."
                            }
                        }
                    ],
                    "synonyms": [
                        "quote#Noun",
                        "quote",
                        "citation"
                    ],
                    "common_phrases": [
                        "famous quotation",
                        "short quotation",
                        "direct quotation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фрагмент высказывания, который повторяется кем-то другим, например, из литературы или известной речи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цитата",
                                "target_lang_sense_clarification": "дословная выдержка из текста или речи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e352dcf-4467-3656-a58c-da4dd50d16f0",
                    "sense_definition": "A formal statement setting out the estimated cost for a particular job or service.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "price_estimation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to get a <w>quotation</w> for the roof repairs before we sign the contract.",
                            "target_lang_translations": {
                                "ru": "Нам нужно получить <w>смету</w> на ремонт крыши, прежде чем мы подпишем контракт."
                            }
                        },
                        {
                            "text": "The builder provided a written <w>quotation</w> that was much higher than we expected.",
                            "target_lang_translations": {
                                "ru": "Строитель предоставил письменное <w>ценовое предложение</w>, которое оказалось намного выше, чем мы ожидали."
                            }
                        }
                    ],
                    "synonyms": [
                        "quote#Noun",
                        "quote"
                    ],
                    "common_phrases": [
                        "written quotation",
                        "get a quotation",
                        "request a quotation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in business contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный документ или заявление с указанием оценочной стоимости конкретной работы или услуги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смета",
                                "target_lang_sense_clarification": "предварительный расчет затрат"
                            },
                            {
                                "target_lang_word": "ценовое предложение",
                                "target_lang_sense_clarification": "официальное предложение цены"
                            },
                            {
                                "target_lang_word": "расценка",
                                "target_lang_sense_clarification": "установленная стоимость услуги или работы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbc8ecfc-0200-3b24-a5e2-c0ca17a6c5e7",
                    "sense_definition": "The act of repeating or citing someone else's words or a piece of text.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "literary_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author's constant <w>quotation</w> of ancient texts makes the book difficult to read.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>цитирование</w> автором древних текстов делает книгу трудной для чтения."
                            }
                        },
                        {
                            "text": "The lawyer used the <w>quotation</w> of previous cases to support his argument.",
                            "target_lang_translations": {
                                "ru": "Адвокат использовал <w>ссылки</w> на предыдущие дела для подтверждения своего аргумента."
                            }
                        }
                    ],
                    "synonyms": [
                        "citation"
                    ],
                    "common_phrases": [
                        "endless quotation",
                        "act of quotation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по повторению или цитированию чьих-либо слов или фрагмента текста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цитирование",
                                "target_lang_sense_clarification": "процесс приведения чужих слов"
                            },
                            {
                                "target_lang_word": "ссылка",
                                "target_lang_sense_clarification": "упоминание источника или текста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a140412c-f9d8-3c96-a22f-92e1c0ee8c6b",
                    "sense_definition": "The act of setting or stating a price for a security or commodity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "price_estimation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stock market <w>quotation</w> of the company's shares dropped significantly this morning.",
                            "target_lang_translations": {
                                "ru": "Биржевая <w>котировка</w> акций компании сегодня утром значительно упала."
                            }
                        },
                        {
                            "text": "Accurate <w>quotation</w> of prices is essential for maintaining a fair trading environment.",
                            "target_lang_translations": {
                                "ru": "Точное <w>установление цен</w> необходимо для поддержания честной торговой среды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "market quotation",
                        "price quotation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "financial or technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по установлению или объявлению цены на ценную бумагу или товар."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "котировка",
                                "target_lang_sense_clarification": "рыночная цена ценных бумаг или валюты"
                            },
                            {
                                "target_lang_word": "расценивание",
                                "target_lang_sense_clarification": "процесс определения стоимости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}