                ],
                "senses": [
                    {
                        "sense_id": "e1e7c233-c6b6-3f8b-85da-eb8bc5763638",
                        "entry_id": "03b392a6-c3ac-3c20-9f6f-ee286037df9f",
                        "glosses": [
                            "посещение магазинов с целью покупки вещей или продуктов, часто сопровождаемое попутными развлечениями"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4e3d98e-bbab-47ce-87d1-41c62236a47c",
                                "sense_id": "e1e7c233-c6b6-3f8b-85da-eb8bc5763638",
                                "text": "Очень редко что-нибудь покупаю. Не сказал бы, что это для меня ― удовольствие. Есть такое западное понятие ― шопинг. Оно как раз и означает: получать удовольствие от того, что ты ходишь по магазинам и что-то покупаешь."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b0f4a8e-ccb5-4087-b509-c84c62b36345",
                        "source_entry_id": "03b392a6-c3ac-3c20-9f6f-ee286037df9f",
                        "source_sense_id": "e1e7c233-c6b6-3f8b-85da-eb8bc5763638",
                        "target_lang_word": "shopping",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shopping",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41597a41-dd28-3a63-af9e-50655471108a",
                                        "entry_id": "c6afd802-e6d0-33b5-8eff-e083c6aa8da9",
