                                                "text": "Die Vorexplosion treibt den Brennstoff aus der Vorkammer in den Zylinder."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "623ed797-b2f5-3cac-a4da-873468e22636",
                                        "entry_id": "0f4a4242-6926-3779-8cf4-ffb4df7d8a59",
