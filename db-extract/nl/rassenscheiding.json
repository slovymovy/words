                "senses": [
                    {
                        "sense_id": "85f5f839-2472-365c-bcdb-22c9622016b4",
                        "entry_id": "5c8d3e4f-90c5-3fdb-a7f0-ad2beb755416",
                        "glosses": [
                            "het mensen van een verschillende etnische afkomst niet laten samenleven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba560adb-b180-4b88-aafd-bcb562bcef72",
                                "sense_id": "85f5f839-2472-365c-bcdb-22c9622016b4",
                                "text": "Het hoofd van de politie maakt zich er kwaad over. \"Ik ben een zwarte man in Chicago. Ik ken de rassenscheiding en de wanhoop die daaruit voortkomt. Ik vraag me daarom af waarom juist een Afro-Amerikaanse man die haat gebruikt om zich zo te profileren. Ik zou willen dat nabestaanden van slachtoffers van wapengeweld zoveel aandacht zouden krijgen.\""
                            },
                            {
                                "example_id": "40c86516-313e-4d52-a410-57c5756aaae7",
                                "sense_id": "85f5f839-2472-365c-bcdb-22c9622016b4",
                                "text": "Domino en zijn band hadden zelf veel last van de rassenscheiding in Amerika. Ze werden regelmatig geweigerd in hotels vanwege hun huidskleur en moesten dan op kilometers afstand van de plek waar ze zouden optreden een 'zwart' hotel nemen. Pas in 1964 werd de rassenscheiding in de VS met de ondertekening van de Civil Rights Act afgeschaft."
                            }
                        ]
                    }
