                                "example_id": "552ac0e5-d378-459c-ab4f-74885585490a",
                                "sense_id": "0db16c64-9299-3257-bd69-5139af94ae46",
                                "text": "The vengefulness of the king was legendary."
                            },
                            {
                                "example_id": "3a170bce-862d-4a5b-914a-5696e5171a1a",
                                "sense_id": "0db16c64-9299-3257-bd69-5139af94ae46",
                                "text": "To this day his reason has never recovered from that shock; a wild nightmare of vengefulness has possessed him ever since, and he has almost bankrupted his native ingenuities in inventing pains and miseries and humiliations and heartbreaks wherewith to embitter the brief lives of Adam's descendants."
                            }
                        ]
                    }
