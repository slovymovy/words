                        "examples": [
                            {
                                "example_id": "bbd43406-4954-4220-83cd-ac957966ba4b",
                                "sense_id": "cf816040-28a4-381f-b309-2d46f9e28e52",
                                "text": "In de singleplayer-campagne van de game gaan fans naar The Frontier als een karabinier van de Militia die Pilot wil worden."
                            },
                            {
                                "example_id": "e65b449c-7757-4343-99f9-0519bdd8f290",
                                "sense_id": "cf816040-28a4-381f-b309-2d46f9e28e52",
                                "text": "De karabinier was een cavaleriesoldaat, bewapend met een kort geweer, de karabijn. Hij was daardoor wendbaar en snel."
                            },
                            {
                                "example_id": "1b36f2b9-110a-40e0-ad6e-c4b4c6923590",
                                "sense_id": "cf816040-28a4-381f-b309-2d46f9e28e52",
                                "text": "Rond 10 uur werd de kist van koningin Fabiola de kathedraal binnengedragen door de karabiniers-grenadiers uit Leopoldsburg. De voltallige koninklijke familie, gekleed in zwarte en grijze rouwkledij, begeleidde de kist."
                            }
                        ]
