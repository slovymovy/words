                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51c69ed0-780d-4903-a347-e556500b4054",
                                                "sense_id": "ab0f6da6-c3de-3b60-b8db-fe2b90eade0f",
                                                "text": "Wpuszczam je w kałamarz z grubościennego szkła, osiemnastowieczny bakarat bez atramentu"
                                            }
                                        ],
