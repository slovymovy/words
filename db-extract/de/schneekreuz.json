                ],
                "senses": [
                    {
                        "sense_id": "0d79c32b-2dc8-3880-9f7a-f3c6bab3212b",
                        "entry_id": "8742722c-8aea-307a-a99f-ac0238b20085",
                        "glosses": [
                            "Bestandteil eines Regenmessers, um auch Schneefall korrekt zu messen"
                        ],
                        "tags": [
                            "Messtechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "88562d0c-d9eb-4273-a5d9-b18105e5980f",
                                "sense_id": "0d79c32b-2dc8-3880-9f7a-f3c6bab3212b",
                                "text": "„Messungen der Schneemenge werden mit Hilfe üblicher Regenmesser durchgeführt, bei denen zum Schutz gegen Verwehungen Schneekreuze angebracht sind.“"
                            },
                            {
                                "example_id": "9a130e20-589c-42e7-b793-bd3508dd98b0",
                                "sense_id": "0d79c32b-2dc8-3880-9f7a-f3c6bab3212b",
                                "text": "„In windexponierten Gegenden ist ein Windschutz, und zwar ein in das Auffanggefäß eingelegtes Blechkreuz (Schneekreuz) oder ein Schutzring, wie er beim Totalisator allgemein verwendet wird, vorzusehen.“"
                            },
                            {
                                "example_id": "138f18ca-d444-4f66-a82f-a1adb8c41478",
                                "sense_id": "0d79c32b-2dc8-3880-9f7a-f3c6bab3212b",
                                "text": "„Für Schneemessung wird daher in das Auffanggefäß ein Schneekreuz eingesetzt, welches das Herauswehen des Schnees verhindern soll.“"
                            },
                            {
                                "example_id": "78eab946-29ec-4cde-aadc-191019f874f7",
                                "sense_id": "0d79c32b-2dc8-3880-9f7a-f3c6bab3212b",
                                "text": "„Dazu kann ich sagen, daß 1933 bei der Niederschlagsmessung auf der Zugspitze das Schneekreuz eingeführt wurde. Seither sind die Niederschlagsmengen, die gemessen werden, reichlicher.“"
                            },
                            {
                                "example_id": "f636d9b6-fb76-4e4b-8b88-14be186a6caf",
                                "sense_id": "0d79c32b-2dc8-3880-9f7a-f3c6bab3212b",
                                "text": "„Die Erfassung der Niederschlagsdaten erfolgte mit je einem Pluviograph (200 cm²) mit Tagesumlauf und einem Regenmesser mit Schneekreuz nach HELLMANN.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
