                    {
                        "translation_id": "f1d745d7-4681-4771-b271-0c6d9ecf4c59",
                        "source_entry_id": "e7c74629-675d-3e0e-ae26-64f632a76106",
                        "source_sense_id": "fcd81ecb-52ca-380b-96de-a7ea1cee60b9",
