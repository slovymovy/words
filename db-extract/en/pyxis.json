        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9fc04627-8612-3caf-9cb5-6e9e02ddfb1d",
                "word": "Pyxis",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "27fded10-21b0-32f1-bbc8-be86c1de196f",
                        "entry_id": "9fc04627-8612-3caf-9cb5-6e9e02ddfb1d",
                        "glosses": [
                            "A spring constellation of the southern sky, said to resemble the compass of a ship. It is associated with the larger Argo Navis, although it was never officially part of that constellation."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9ceb2f8-fe06-409c-afb2-1f3ff77d973c",
                        "source_entry_id": "9fc04627-8612-3caf-9cb5-6e9e02ddfb1d",
                        "source_sense_id": "27fded10-21b0-32f1-bbc8-be86c1de196f",
                        "source_sense_description": "constellation",
                        "target_lang_word": "Boussole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Boussole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b942714f-b1a3-38a1-93a0-166e4a8f1d45",
                                        "entry_id": "a38d3e6b-eafa-3525-9c4d-02b412f4a041",
                                        "glosses": [
                                            "Constellation du ciel austral, bordée par l’Hydre, la Poupe, les Voiles et la Machine pneumatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "962cbc73-77dc-443e-859c-ec72f95013a7",
                                                "sense_id": "b942714f-b1a3-38a1-93a0-166e4a8f1d45",
                                                "text": "Voici donc ces nouvelles constellations suivant l’ordre des ascensions droites, & telles que M. de la Caille les rapporte dans les Mémoires de 1752 […] VII. La Boussole ou le Compas de Mer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d94c2ccc-2a79-4f11-a4eb-360d60760c2e",
