                                    {
                                        "sense_id": "2a3e18eb-0b9b-30cc-ac0d-224eb008ea35",
                                        "entry_id": "30adeb50-b3bc-334b-8b16-d2df5d0f1672",
                                        "glosses": [
                                            "The state of being frank; candour; honesty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f642955-fdc9-4b01-8267-fc3b4ffc71c0",
                                                "sense_id": "2a3e18eb-0b9b-30cc-ac0d-224eb008ea35",
                                                "text": "With disarming frankness, he admitted his mistakes."
                                            },
                                            {
                                                "example_id": "ce1507e6-a953-4ff6-a9bf-ccd9b358bf54",
                                                "sense_id": "2a3e18eb-0b9b-30cc-ac0d-224eb008ea35",
                                                "text": "complete frankness"
                                            },
                                            {
                                                "example_id": "0e809ae2-f632-4a7d-b628-7c42061e1168",
                                                "sense_id": "2a3e18eb-0b9b-30cc-ac0d-224eb008ea35",
                                                "text": "speak with frankness"
                                            },
                                            {
                                                "example_id": "51b06cec-370b-43c6-822c-74245df689a1",
                                                "sense_id": "2a3e18eb-0b9b-30cc-ac0d-224eb008ea35",
                                                "text": "a moment of frankness"
                                            },
                                            {
                                                "example_id": "27fd663f-4b27-4751-b127-c53b27bc12b4",
                                                "sense_id": "2a3e18eb-0b9b-30cc-ac0d-224eb008ea35",
                                                "text": "She appreciated his frankness about the situation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2d69ea5-aeb5-41ee-ad64-7121c1213f77",
                        "source_entry_id": "b25eac40-c483-393b-b0bb-2a669ce154e5",
                        "source_sense_id": "95c2f295-30eb-3113-b853-8991f7e86088",
                        "target_lang_word": "sincérité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sincérité",
