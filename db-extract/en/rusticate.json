                                        "entry_id": "a1ea8e7c-a04a-3126-8855-e8b7032a8e27",
                                        "glosses": [
                                            "jemanden aus der Matrikel (dem Verzeichnis der Studierenden einer Hochschule) streichen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "890c48a1-d522-4466-9b28-81951a07e21b",
                                                "sense_id": "94f92dc9-994c-32c4-a636-840f43865933",
                                                "text": "Fällt er in der Prüfung ein drittes Mal durch, wird er exmatrikuliert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b2780b4e-a754-3b46-9b2a-d57eedb8f900",
                                        "entry_id": "a1ea8e7c-a04a-3126-8855-e8b7032a8e27",
                                        "glosses": [
                                            "sich als Student bei einer Universität, Hochschule oder Akademie abmelden"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b80ab775-4e15-4e19-9c0a-8181988f7b28",
                                                "sense_id": "b2780b4e-a754-3b46-9b2a-d57eedb8f900",
                                                "text": "Präsident Nikolaus Risch versichert, es gebe für die Studenten keine Verpflichtungen, nur eine kleine Einschränkung: Erstsemester müssten den Computer zurückgeben, wenn sie sich vor dem 15. November 2009 exmatrikulierten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "654ec147-5ffa-48c1-ad39-f8ebb5583bba",
                        "source_entry_id": "c0ba179a-c615-311c-8bfd-4da8aa7beeb8",
                        "source_sense_description": "suspend or expel from a college or university",
                        "target_lang_word": "zwangsexmatrikulieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zwangsexmatrikulieren",
