{
    "word_family": [
        "chaos"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "97a64840-612c-3e53-8f8b-8906bfb905f6",
                    "sense_definition": "Zonder enige orde of structuur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wanorde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kamer van mijn broer is altijd erg <w>chaotisch</w>.",
                            "target_lang_translations": {
                                "zh": "我弟弟的房间总是非常<w>杂乱</w>。"
                            }
                        },
                        {
                            "text": "Het verkeer in de stad was vanmorgen erg <w>chaotisch</w> door de regen.",
                            "target_lang_translations": {
                                "zh": "因为下雨，今天早上城里的交通非常<w>混乱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ongeordend",
                        "rommelig",
                        "wanordelijk",
                        "warrig"
                    ],
                    "common_phrases": [
                        "chaotische situatie",
                        "chaotisch verloop"
                    ],
                    "target_lang_definitions": {
                        "zh": "缺乏任何秩序或结构。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "混乱",
                                "target_lang_sense_clarification": "形容事物缺乏条理、杂乱无章。"
                            },
                            {
                                "target_lang_word": "杂乱",
                                "target_lang_sense_clarification": "形容物品摆放或状态凌乱。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ac00b1d-4bd6-3e68-841b-d94793a585a4",
                    "sense_definition": "Gekenmerkt door verwarring of gebrek aan overzicht.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wanorde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vergadering verliep nogal <w>chaotisch</w> omdat niemand naar elkaar luisterde.",
                            "target_lang_translations": {
                                "zh": "会议进行得相当<w>混乱</w>，因为没有人听别人说话。"
                            }
                        },
                        {
                            "text": "Na het ongeluk ontstond er een <w>chaotische</w> toestand op de weg.",
                            "target_lang_translations": {
                                "zh": "事故发生后，道路上出现了<w>混乱</w>的局面。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ordeloos",
                        "turbulent",
                        "warrig",
                        "ongeregeld",
                        "onsystematisch"
                    ],
                    "common_phrases": [
                        "chaotische toestand"
                    ],
                    "target_lang_definitions": {
                        "zh": "以混乱、困惑或缺乏条理为特征。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "混乱",
                                "target_lang_sense_clarification": "形容局面或情况失去控制。"
                            },
                            {
                                "target_lang_word": "无序",
                                "target_lang_sense_clarification": "形容缺乏系统性或组织性。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}