                    {
                        "sense_id": "2af37954-bee6-39d9-87ed-48d6794a264b",
                        "entry_id": "1a8d8430-c304-3449-9b7f-53b393b6570b",
                        "glosses": [
                            "een handeling die uitgevoerd wordt als men in een gevaarlijke/moeilijke situatie is terecht gekomen maar die niet de definitieve oplossing van het probleem is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a7b620b-b29c-49db-84f6-debd9a162434",
                                "sense_id": "2af37954-bee6-39d9-87ed-48d6794a264b",
                                "text": "Groen lanceerde daarrond een tijdje geleden een petitie om het stadsbestuur op te roepen zowel structurele maatregelen te nemen om de luchtkwaliteit in Antwerpen te verbeteren, als noodmaatregelen te nemen op dagen met veel fijn stof en vervuiling."
                            },
                            {
                                "example_id": "5927df55-45dc-493b-bd42-275bb381a912",
                                "sense_id": "2af37954-bee6-39d9-87ed-48d6794a264b",
                                "text": "De aangekondigde maatregelen zijn niet per se in strijd met de cao maar gelden wel als noodmaatregelen, zegt Van Doesburg. ,,Voor het vierde jaar op rij worden trucs toegepast die fors in het nadeel van de piloten uitvallen.\" Volgens de VNV-woordvoerder staan er genoeg piloten te trappelen om de cockpit in te mogen maar is het aannemen van nieuwe piloten niet goedkoop - vermoedelijk de reden waarom KLM daar zo lang mogelijk mee wacht."
                            }
                        ]
                    }
