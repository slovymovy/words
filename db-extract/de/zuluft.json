                ],
                "senses": [
                    {
                        "sense_id": "3a24b4fb-5848-3d5e-85a8-dcce31060a12",
                        "entry_id": "e0f1bf18-93d6-3aa4-9f61-4f8e01cc8acf",
                        "glosses": [
                            "aufbereitete Luft, die einem Raum zugeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e958fff-b2c3-4e7d-945b-e920b0b2c371",
                                "sense_id": "3a24b4fb-5848-3d5e-85a8-dcce31060a12",
                                "text": "Eine Lüftungsanlage saugt Außenluft an, bereitet diese auf und führt diese als aufbereitete Zuluft in die Räume des Gebäudes."
                            },
                            {
                                "example_id": "285a0a65-71f3-454f-9757-93e4bb262b91",
                                "sense_id": "3a24b4fb-5848-3d5e-85a8-dcce31060a12",
                                "text": "„Der Hygienezustand von Raumlufttechnischen Anlagen muss in regelmäßigen Zeitabständen überprüft werden, um eine einwandfreie, hygienische Qualität der Zuluft sicherzustellen.“"
                            },
                            {
                                "example_id": "abb3bb8f-8df4-4909-add8-242aafc56822",
                                "sense_id": "3a24b4fb-5848-3d5e-85a8-dcce31060a12",
                                "text": "„Je nachdem wie die Zuluft in den Raum geführt wird, kann man verschiedene Raumströmungen erreichen.“"
                            },
                            {
                                "example_id": "cd260e1a-5758-40f9-bb73-b60c90b55d25",
                                "sense_id": "3a24b4fb-5848-3d5e-85a8-dcce31060a12",
                                "text": "„Für Wärmetauscher ist bei Außentemperaturen unter -20°C, keine zusätzliche Erwärmung der Zuluft erforderlich, die für Wärmeenergie auch bei harten Frösten genutzt wird.“"
                            },
                            {
                                "example_id": "f85f70f8-0daa-4e29-898a-e2e58f5b720b",
                                "sense_id": "3a24b4fb-5848-3d5e-85a8-dcce31060a12",
                                "text": "„Bei einer zentralen Lüftungsanlage mit Wärmerückgewinnung wird die in der Abluft enthaltene Wärme über einen Wärmetauscher an die Zuluft abgegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
