    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0eb2a101-9edd-33d6-b817-6ad57f134f7b",
                "word": "Ladin",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6a897b8e-3b14-3343-b9cb-a92b1df42792",
                        "entry_id": "0eb2a101-9edd-33d6-b817-6ad57f134f7b",
                        "glosses": [
                            "A Rhaeto-Romance language (or dialect continuum), spoken primarily in the Italian portion of Tyrol and the Dolomite Mountains in Northern Italy."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89fc58f7-6a02-4498-8f55-b12484ad52eb",
                        "source_entry_id": "0eb2a101-9edd-33d6-b817-6ad57f134f7b",
                        "source_sense_id": "6a897b8e-3b14-3343-b9cb-a92b1df42792",
                        "source_sense_description": "the Romance language",
                        "target_lang_word": "ladin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ladin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f66cc013-ebf5-3d9e-a62b-73eea72d9f87",
                                        "entry_id": "061fa769-e336-3659-97ee-65a29e193c97",
                                        "glosses": [
                                            "Relatif à la langue ladine, à ses locuteurs ou aux régions où elle est parlée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b0e3a30-fd58-4da6-b90d-8fc007c37572",
                                                "sense_id": "f66cc013-ebf5-3d9e-a62b-73eea72d9f87",
                                                "text": "Dictionnaire ladin, grammaire, littérature ladine."
                                            },
                                            {
                                                "example_id": "fe04f571-4883-4e6e-973f-c001d36447b1",
                                                "sense_id": "f66cc013-ebf5-3d9e-a62b-73eea72d9f87",
                                                "text": "C’est avec 71,44 % des votes que les trois municipalités ladines d’Anpezo (Cortina d’Ampezzo), Fodom (Livinallongo) et Col (Colle Santa Lucia) ont clairement dit « oui » à la réunification des vallées ladines pour intégrer le Sud-Tyrol."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ladin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85b5195b-3b2b-3f61-9d03-04e403688add",
                                        "entry_id": "6381454e-2d17-3b51-a1ab-233ff969a7f0",
                                        "glosses": [
                                            "Groupe de langues romanes proches du romanche et du frioulan parlées dans les Dolomites, pour l’essentiel dans le Frioul, le Trentin-Haut-Adige et en Vénétie. Il s’agit de l’une des langues les plus rares d’Europe. Il en existe deux variétés : le ladin du Val Badia (lld-bad) et le ladin du Val Gardena (lld-grd)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be0576d1-1d2c-4f19-87a9-3f3fd19be1d5",
                                                "sense_id": "85b5195b-3b2b-3f61-9d03-04e403688add",
                                                "text": "Le ladin actuel comprend cinq dialectes : le maréo ou badiot, le gherdëina, le fascian, l’anpezan et le fodom ; il existe une langue écrite standard, le ladin standard ou ladin dolomitan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a1d72a7-9d52-3a0a-891b-2e099366e60f",
                                        "entry_id": "6381454e-2d17-3b51-a1ab-233ff969a7f0",
                                        "glosses": [
                                            "Dialectes romanches parlés en Engadine, dans le canton des Grisons, en Suisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9100244-21f1-4c16-bf36-720e6a3abe11",
                                                "sense_id": "5a1d72a7-9d52-3a0a-891b-2e099366e60f",
                                                "text": "Le ladin regroupe le dialecte romanche de Haute-Engadine, aussi appelé le puter et celui de Basse-Engadine, le vallader."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26ec41ad-9ba3-4dc5-8dcc-98b1ef3c0f4b",
                        "source_entry_id": "0eb2a101-9edd-33d6-b817-6ad57f134f7b",
                        "source_sense_id": "6a897b8e-3b14-3343-b9cb-a92b1df42792",
                        "source_sense_description": "the Romance language",
                        "target_lang_word": "Ladinisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ladinisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8867262-aa0a-3493-9eb0-a3cb826d9974",
                                        "entry_id": "351359a0-e0ab-3d95-bead-79ba8355cac0",
                                        "glosses": [
                                            "rätoromanische Sprache, die in Südtirol, im Trentino und in Venetien im Norden Italiens gesprochen wird, die mit dem Bündnerromanisch und Friaulisch verwandt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09ff4580-0cb1-48eb-9986-d94d5343c020",
                                                "sense_id": "c8867262-aa0a-3493-9eb0-a3cb826d9974",
                                                "text": "„Die Abgrenzung des Ladinischen zu Dialekten des Italienischen ist nicht unumstritten und scheint in manchen Fällen eher politisch als linguistisch bedingt zu sein.“"
                                            },
                                            {
                                                "example_id": "189375c0-3875-4eef-968d-e837bfbd2cc8",
                                                "sense_id": "c8867262-aa0a-3493-9eb0-a3cb826d9974",
                                                "text": "„1989 wurde Ladinisch neben Italienisch und Deutsch auch als Amtssprache in der schriftlichen und mündlichen Kommunikation eingeführt.“"
                                            },
                                            {
                                                "example_id": "bfefbc04-5249-45aa-be76-1e3eec97ff87",
                                                "sense_id": "c8867262-aa0a-3493-9eb0-a3cb826d9974",
                                                "text": "„Rund die Hälfte möchte schon, daß Ladinisch gefördert wird (…), gesteht aber zu, daß andere Dinge Vorrang haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
