                                                "sense_id": "668320a9-e278-3be4-bdff-847b7266abf9",
                                                "text": "Он не договорил, залпом выпил разведенный спирт и крякнул страшно…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b2eb621-cfe2-3066-abae-fe67cb37cb70",
                                        "entry_id": "38cba85e-a629-3f43-be49-930bc7bf21ab",
                                        "glosses": [
                                            "разг. состоящий в разводе со своим бывшим супругом или со своей бывшей супругой"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c6c8605-84e3-3529-af38-7375074b75c3",
                                        "entry_id": "38cba85e-a629-3f43-be49-930bc7bf21ab",
                                        "glosses": [
                                            "субстантивир., разг. тот, кто расторг свой брак, кто находится в разводе с кем-либо"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "разведённый",
                                "target_lang_code": "ru",
                                "target_senses": [
