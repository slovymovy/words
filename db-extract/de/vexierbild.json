                "senses": [
                    {
                        "sense_id": "68c4bf0c-aaab-3600-bda1-c5ff30d3c7f0",
                        "entry_id": "ac16c2ea-905b-3096-a809-5b99da2393a6",
                        "glosses": [
                            "Bild, das außer der offenkundigen Abbildung noch eine weitere, mehr oder weniger schwer zu entdeckende verborgene Abbildung enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f2fd491-8fbb-4ef9-ac41-04c9ed71fc14",
                                "sense_id": "68c4bf0c-aaab-3600-bda1-c5ff30d3c7f0",
                                "text": "Vexierbilder zeigen mehrere, für gewöhnlich zwei, unterschiedliche Bilder in einem."
                            },
                            {
                                "example_id": "d6689832-8865-434d-b083-9cb4ec0981b5",
                                "sense_id": "68c4bf0c-aaab-3600-bda1-c5ff30d3c7f0",
                                "text": "„Wie in einem Vexierbild hatten die Wörter ihre herabsetzende Wirkung, ihre verletzende Kraft verloren.“"
                            },
                            {
                                "example_id": "3d1684a8-847c-44f8-beb1-5f45a072c170",
                                "sense_id": "68c4bf0c-aaab-3600-bda1-c5ff30d3c7f0",
                                "text": "„Denn daß ihn, wohin er sich wandte, Vexierbilder seines eigenen Selbst narrten, spürte er wohl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
