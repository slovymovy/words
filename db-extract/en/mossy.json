                    {
                        "translation_id": "ca86733d-174b-4b9b-ae11-d8325d5c4806",
                        "source_entry_id": "4cd3198d-f83e-3f34-a793-1d81e60dc063",
                        "source_sense_id": "c3981288-bc67-346d-bcdc-97eb038f74c6",
                        "source_sense_description": "covered in or overgrown with moss",
                        "target_lang_word": "moussu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moussu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce77e9f3-ad2c-3245-a19d-805fb3214d42",
                                        "entry_id": "1fd6a14e-8be2-3fdc-8ef1-3fc9072b95c6",
                                        "glosses": [
                                            "Qui est couvert de mousse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d5b23c3-e25b-4ad9-8010-0acb0753abb0",
                                                "sense_id": "ce77e9f3-ad2c-3245-a19d-805fb3214d42",
                                                "text": "Là, des blocs moussus jonchent le sol et des colonnes brisées sont étendues comme des mortes ; les colombes se posent sur les tuiles du faîte et les rebords usés des corniches ; dans un angle, le croissant de la lune veille au ciel."
                                            },
                                            {
                                                "example_id": "a7f96419-7c5b-4128-829e-7a2400295002",
                                                "sense_id": "ce77e9f3-ad2c-3245-a19d-805fb3214d42",
                                                "text": "Ici, les rouges rayons du soleil lançaient une lumière éparse et décolorée, qui ruisselait sur les branches brisées et les troncs moussus des arbres."
                                            },
                                            {
                                                "example_id": "17f1d873-15a4-4478-bf10-9d478767b0a9",
                                                "sense_id": "ce77e9f3-ad2c-3245-a19d-805fb3214d42",
                                                "text": "Le char à bancs disparaissait derrière une belle roche moussue et couronnée de charmes difformes dont les troncs gris et vigoureux tranchaient sur la verdure d’un champ de blé."
                                            },
                                            {
                                                "example_id": "dde7e964-647f-48a0-8828-2c585941e950",
                                                "sense_id": "ce77e9f3-ad2c-3245-a19d-805fb3214d42",
                                                "text": "Agenouillées, elles fleurissent de nouvelles fleurs son piédestal moussu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89d07db0-d569-33b7-b5c6-c7ee5846942e",
                                        "entry_id": "1fd6a14e-8be2-3fdc-8ef1-3fc9072b95c6",
                                        "glosses": [
                                            "Rose moussue : rose dont le calice et la tige sont garnis d’une sorte de mousse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
