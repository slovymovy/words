                        "source_sense_id": "4b8a3841-9ba5-3277-bb54-6432a0b32072",
                        "source_sense_description": "umgangssprachlich, Handel: Baumarkt",
                        "target_lang_word": "Baumarkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baumarkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74be020d-aef9-37f0-9952-430870a01186",
                                        "entry_id": "95c3c605-c94a-3796-aa93-6773addad066",
                                        "glosses": [
                                            "großes Einzelhandelsgeschäft, in dem es in erster Linie Baustoffe und Werkzeug zu kaufen gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc95ff63-033d-481e-b0ce-dab76626e883",
                                                "sense_id": "74be020d-aef9-37f0-9952-430870a01186",
                                                "text": "Gestern Abend musste ich noch wegen zwei Schrauben zum Baumarkt fahren."
                                            },
                                            {
                                                "example_id": "778ea057-b924-44d8-b123-6272955351db",
                                                "sense_id": "74be020d-aef9-37f0-9952-430870a01186",
                                                "text": "„Die Verladerampe des Baumarktes hatte man für den Empfang nächtlicher Lieferungen offen stehen lassen.“"
                                            },
                                            {
                                                "example_id": "2ef231bf-044f-4c0b-aa97-c49c6b4729ca",
                                                "sense_id": "74be020d-aef9-37f0-9952-430870a01186",
                                                "text": "„Sie stromerten durch die Baumärkte auf der Suche nach Bambusrohren und geeigneten Hanfseilen.“"
                                            },
                                            {
                                                "example_id": "984c0d58-bf00-4501-9433-68da189340ea",
                                                "sense_id": "74be020d-aef9-37f0-9952-430870a01186",
                                                "text": "„Hier gibt es den nördlichsten Zeltplatz und den nördlichsten Baumarkt sowie den zweitnördlichsten Baumarkt und natürlich auch zwei Supermärkte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
