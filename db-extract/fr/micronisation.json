                        "glosses": [
                            "Réduction en particules microscopiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30f936f8-f7d3-4e3b-b83f-e4b05fc31c2f",
                                "sense_id": "f4e1144c-330d-3245-9920-83b762bac8e8",
                                "text": "À condition d’une application correcte, le procédé d’homogénéisation peut être utilisé tant pour la ré-émulsification que pour la micronisation."
                            },
                            {
                                "example_id": "0e60b0ee-07d5-4ddf-a0f4-5fc65985736e",
                                "sense_id": "f4e1144c-330d-3245-9920-83b762bac8e8",
                                "text": "Le traitement par « micronisation » des protéines, c'est-à-dire chauffage modéré et agitation intense, conduit à l’obtention de petites particules de 0,1 à 0,2 μm, donnant l’impression en bouche de crémeux et d’onctuosité qui est normalement associée aux matières grasses."
                            }
                        ]
                    }
