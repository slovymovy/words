                "senses": [
                    {
                        "sense_id": "80bd11c6-3891-3519-98e9-1b1beecfdf7b",
                        "entry_id": "9af2f329-45b8-3448-b708-8c3fd6bf4f8f",
                        "glosses": [
                            "russification"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b93190f7-7dd5-4197-ba0a-57f0cc2802fa",
                                "sense_id": "80bd11c6-3891-3519-98e9-1b1beecfdf7b",
                                "text": "— Госпожа́ Энгельга́рдова, — сказа́л дво́рник.\n— Энгельга́рдт? — переспроси́л Мо́шкин. Дво́рник повтори́л:\n— Энгельга́рдова. Мо́шкин усмехну́лся:\n— Русифика́ция?",
                                "translation": "\"Miss Engelgardova,\" answered the porter.\n\"Engelgargt?\" queried Moshkin.\nThe porter repeated:\n\"Engelgardova.\"\nMoshkin laughed.\n\"Russification?\"",
                                "english": "\"Miss Engelgardova,\" answered the porter.\n\"Engelgargt?\" queried Moshkin.\nThe porter repeated:\n\"Engelgardova.\"\nMoshkin laughed.\n\"Russification?\""
                            },
                            {
                                "example_id": "71598963-aff8-4ced-9064-795c1278a743",
                                "sense_id": "80bd11c6-3891-3519-98e9-1b1beecfdf7b",
                                "text": "ПАСЕ призна́ла геноци́дом наси́льственное перемеще́ние и русифика́цию украи́нских дете́й.",
                                "translation": "PACE has recognized the forced displacement and russification of Ukrainian children as genocide.",
                                "english": "PACE has recognized the forced displacement and russification of Ukrainian children as genocide."
                            }
                        ]
                    }
