                    }
                ],
                "senses": [
                    {
                        "sense_id": "a0a99d4b-e86c-3d41-995e-f7da46091874",
                        "entry_id": "65c5e052-d315-3b8f-a020-a9b50f9298c4",
                        "glosses": [
                            "The state of being narrow."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "96fb5a6d-3520-4817-85fe-3c1dc512ec10",
                                "sense_id": "a0a99d4b-e86c-3d41-995e-f7da46091874",
                                "text": "presently, then, I felt the stiff insertion between the yielding, divided lips of the wound, now open for life; where the narrowness no longer put me to intolerable pain, and afforded my lover no more difficulty than what heighten'd his pleasure, in the strict embrace of that tender, warm sheath, round the instrument it was so delicately adjusted to",
                                "translation": "Fanny Hill",
                                "english": "Fanny Hill"
                            },
                            {
                                "example_id": "d7b5ca3f-39e4-48fb-840a-3a363c0fa494",
                                "sense_id": "a0a99d4b-e86c-3d41-995e-f7da46091874",
                                "text": "“You will understand me when I say that it was a deadly life for a girl brought up as I had been. The narrowness, the deadly monotony of it, almost drove me mad.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "2e7e1cdc-d671-3a71-ab1e-2602538f8576",
                        "entry_id": "65c5e052-d315-3b8f-a020-a9b50f9298c4",
                        "glosses": [
                            "A constriction; a narrow passage or place; an instance or aspect of being narrow, or having a limited scope or extent."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f4c476a-e7c0-459b-bd36-dd4125fd2882",
                        "source_entry_id": "65c5e052-d315-3b8f-a020-a9b50f9298c4",
                        "source_sense_description": "state of being narrow",
                        "target_lang_word": "étroitesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étroitesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cc45673-4a22-3019-82a3-c98c74acda95",
                                        "entry_id": "9e986aa5-3b02-3446-ac27-a1a10d68b51f",
                                        "glosses": [
                                            "Qualité de ce qui est étroit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2740be50-2166-4af9-b217-751a123c3f01",
                                                "sense_id": "3cc45673-4a22-3019-82a3-c98c74acda95",
                                                "text": "[…] ou bien, les marées sont nulles spécialement sur ce point du littoral américain, et peut-être pour les mêmes raisons qui les rendent insensibles dans certaines mers resserrées, la Méditerranée entre autres, où le rapprochement des continents riverains et l'étroitesse des pertuis ne donnent pas un accès suffisant aux eaux de l'Atlantique."
                                            },
                                            {
                                                "example_id": "10efa428-a4a7-424c-91df-423abdca4c48",
                                                "sense_id": "3cc45673-4a22-3019-82a3-c98c74acda95",
                                                "text": "On aurait pu croire que le rabbinat du Nord-Est dénué de toute culture générale, détenait le monopole de l'étroitesse d'esprit."
                                            },
                                            {
                                                "example_id": "b3feab22-f1d5-46d4-a112-8cfc28071f7d",
                                                "sense_id": "3cc45673-4a22-3019-82a3-c98c74acda95",
                                                "text": "Dans le quartier étudié dans le centre d'Aix-en-Provence, la circulation est rendue compliquée par le sens obligatoire de la rocade et l’étroitesse des rues ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "776d314e-281c-43ef-9352-67c2982eadc8",
