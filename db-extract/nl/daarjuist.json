                                                "sense_id": "47bc5451-a258-3845-8c8a-34b0fa07fdf0",
                                                "text": "I was talking to my friend on the phone just now."
                                            },
                                            {
                                                "example_id": "bbfcb665-913e-45df-a67a-c946fc8ed3f2",
                                                "sense_id": "47bc5451-a258-3845-8c8a-34b0fa07fdf0",
