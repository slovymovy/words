                        "glosses": [
                            "de kleur van de resten van verbrand materiaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32c5a6d9-9112-450c-b493-597f6abf92fc",
                                "sense_id": "43d25e50-dcee-32d0-b760-46189ea603f4",
                                "text": "Tussen de veertig gouaches zitten bijna geen abstrakte werken, die de kijker niet met een onontkoombare, dreigende werkelijkheid confronteren. Asgrijs, groen en vaal bruin beheersen zijn wereld. Toch kan het nieuwe werk van Anton Voorzanger (1918), geboren te Haarlem, maar al sinds lange tijd in Oosterwolde wonend, onmogelijk als somber of depressief aangemerkt worden."
                            }
                        ]
