                        "cross_references": [
                            {
                                "target_word": "krok",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "3de52b20-0cfd-3511-9185-105b872be62e",
                                        "entry_id": "e4ecc13e-dcf7-36ba-9cbe-b1e552805f5e",
                                        "glosses": [
                                            "przestawienie nogi, by wykonać ruch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "893de8fa-cfd1-409f-9651-687615461ec1",
                                                "sense_id": "3de52b20-0cfd-3511-9185-105b872be62e",
                                                "text": "Zrobiła krok w stronę drzwi od łazienki, ale natychmiast zachwiała się i upadła na podłogę."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "32cc75e8-5662-364d-b802-f2f2b053c988",
                                        "entry_id": "e4ecc13e-dcf7-36ba-9cbe-b1e552805f5e",
                                        "glosses": [
                                            "sposób poruszania się przez kroki (1.1), chód"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb3bdd28-587c-473a-9ca8-f8abc20371c7",
                                                "sense_id": "32cc75e8-5662-364d-b802-f2f2b053c988",
                                                "text": "Ściemniało się już, więc musieliśmy przyspieszyć kroku, jeżeli chcieliśmy zdążyć na czas."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "4e65067e-1231-34ab-b6e3-644b4f02a764",
                                        "entry_id": "e4ecc13e-dcf7-36ba-9cbe-b1e552805f5e",
                                        "glosses": [
                                            "sposób ułożenia nóg w tańcu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d71b0a-ae8f-455a-bc19-ad241c8e40e6",
                                                "sense_id": "4e65067e-1231-34ab-b6e3-644b4f02a764",
                                                "text": "Nie znam kroków, żeby z tobą zatańczyć."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "dca67b30-ac18-3958-84ba-67db4b1b4b3c",
                                        "entry_id": "e4ecc13e-dcf7-36ba-9cbe-b1e552805f5e",
                                        "glosses": [
                                            "postęp w jakiejś dziedzinie"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12ac78d7-c11f-4933-a69b-7e64e78c5891",
                                                "sense_id": "dca67b30-ac18-3958-84ba-67db4b1b4b3c",
                                                "text": "Odkrycie szczepionki było wielkim krokiem w rozwoju medycyny."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "f02831a2-5b26-350e-b66d-2905306ca8cb",
                                        "entry_id": "e4ecc13e-dcf7-36ba-9cbe-b1e552805f5e",
                                        "glosses": [
                                            "działanie w określonym celu"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c0c9b8e-7196-4081-98e0-462c17dabd22",
                                                "sense_id": "f02831a2-5b26-350e-b66d-2905306ca8cb",
                                                "text": "Poczyniono odpowiednie kroki w celu ujęcia sprawcy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    },
                                    {
                                        "sense_id": "f5ec601e-8779-3243-ba12-f6e81bf08711",
                                        "entry_id": "e4ecc13e-dcf7-36ba-9cbe-b1e552805f5e",
                                        "glosses": [
                                            "niewielki dystans,"
                                        ],
                                        "tags": [
                                            "also",
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f512f05-93c0-4696-bdb1-a8e63e2b1866",
                                                "sense_id": "f5ec601e-8779-3243-ba12-f6e81bf08711",
                                                "text": "Nasza cukiernia znajduje się o krok od fabryki mebli."
                                            },
                                            {
                                                "example_id": "16966c0b-53c0-4104-a5e6-6d0c44164810",
                                                "sense_id": "f5ec601e-8779-3243-ba12-f6e81bf08711",
                                                "text": "Po przejęciu tego fortu jesteśmy już o krok od zwycięstwa."
                                            }
                                        ],
                                        "sense_index_json": "\"1.6\""
                                    },
                                    {
                                        "sense_id": "b9a06009-c749-39c6-a0c7-4687acc23650",
                                        "entry_id": "e4ecc13e-dcf7-36ba-9cbe-b1e552805f5e",
                                        "glosses": [
                                            "etap, faza"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ccbee65-04b3-42e6-bc33-656d8e4180f0",
                                                "sense_id": "b9a06009-c749-39c6-a0c7-4687acc23650",
                                                "text": "Następnym krokiem na drodze do kariery było podpisanie kontraktu z wytwórnią płytową."
                                            }
                                        ],
                                        "sense_index_json": "\"1.7\""
                                    },
                                    {
                                        "sense_id": "c4cd5f76-b353-36fd-a9af-41bfe0735043",
                                        "entry_id": "e4ecc13e-dcf7-36ba-9cbe-b1e552805f5e",
                                        "glosses": [
                                            "część spodni między nogawkami"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60b1f5b6-f494-48e8-a9ab-3b1751e5ef39",
                                                "sense_id": "c4cd5f76-b353-36fd-a9af-41bfe0735043",
                                                "text": "Spodnie rozdarły mu się w kroku."
                                            }
                                        ],
                                        "sense_index_json": "\"1.8\""
                                    },
                                    {
                                        "sense_id": "c3593d3c-68a7-33e9-b963-87b7cc2696a4",
