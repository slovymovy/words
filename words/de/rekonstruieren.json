                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Ermittler versuchten tagelang, den genauen Tathergang anhand der Spuren zu <w>rekonstruieren</w>."
                        },
                        {
                            "text": "Mithilfe alter Briefe und Tagebücher konnten die Historiker das Leben der Familie lückenlos <w>rekonstruieren</w>."
                        }
