                ],
                "senses": [
                    {
                        "sense_id": "77546343-9e3f-36bc-97ce-7e40580cc0e1",
                        "entry_id": "e9ec027c-7f3b-335d-b4ca-a86bf6d64b3e",
                        "glosses": [
                            "Mannschaft oder Sportler mit der größten Anzahl von gewonnen Meisterschaften eines Landes beziehungsweise Wettbewerbs"
                        ],
                        "tags": [
                            "meist einer höchsten nationalen Liga einer Sportart"
                        ],
                        "examples": [
                            {
                                "example_id": "4a3ba14e-3ee1-4b32-b538-3e9f38f6f5af",
                                "sense_id": "77546343-9e3f-36bc-97ce-7e40580cc0e1",
                                "text": "„Der Rekordmeister gewann drei Tage nach der sensationellen Niederlage beim Drittligisten 1. FC Saarbrücken den Klassiker beim Erzrivalen nach einer überzeugenden Vorstellung mit 4:0 (2:0) und bleibt Spitzenreiter Bayer Leverkusen bei zwei Punkten Rückstand auf den Fersen.“"
                            },
                            {
                                "example_id": "14af400b-241b-4cc8-ad4d-43c6a37b4e9b",
                                "sense_id": "77546343-9e3f-36bc-97ce-7e40580cc0e1",
                                "text": "„Rechnet man aber alle türkischen Meisterschaften seit der ersten Austragung 1924, dann ist Fenerbahce Rekordmeister der Türkei, […].“"
                            },
                            {
                                "example_id": "b23ae5bb-8490-44b7-b24f-60f23eac1fd1",
                                "sense_id": "77546343-9e3f-36bc-97ce-7e40580cc0e1",
                                "text": "„54 Mal wurden die Rangers schottischer Fußballmeister – das ist der sagenhafte europäische Rekord. Doch dabei handelt es sich nicht um eine so genannte einsame Bestmarke, denn mit 53 Titeln folgt schon der nordirische Rekordmeister Linfield FC.“"
                            },
                            {
                                "example_id": "b371f06e-b493-4706-8cee-00233e0b112c",
                                "sense_id": "77546343-9e3f-36bc-97ce-7e40580cc0e1",
                                "text": "„›Die Zebras – ein Jahrhundert Handball‹ lautet der Titel der Ausstellung, die aus diesem Anlass am Sonntag im Kieler Stadtmuseum eröffnet wird – und Fans des deutschen Rekordmeisters können ihr eine ganz persönliche Note verleihen.“"
                            },
                            {
                                "example_id": "6fae694b-c51b-446f-b7cf-ff1c6a2a2346",
                                "sense_id": "77546343-9e3f-36bc-97ce-7e40580cc0e1",
                                "text": "„Tritt der Rekordmeister in einem auswärtigen Stadion an, treibt dies die jeweilige Heimmannschaft zu Höchstleistungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
