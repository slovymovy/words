    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ee73063b-8505-3e7a-b49e-8d7b61c59538",
                "word": "empyrée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cf69fc63-08b0-3957-8c94-7c02a7f82e8e",
                        "entry_id": "ee73063b-8505-3e7a-b49e-8d7b61c59538",
                        "glosses": [
                            "the empyrean, highest part of the sky, that the ancients considered as the stay of the deities."
                        ],
                        "tags": [
                            "literary",
                            "masculine",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e33e348e-7c7a-40cb-be9b-c614fad90f84",
                                "sense_id": "cf69fc63-08b0-3957-8c94-7c02a7f82e8e",
                                "text": "Enfants, dans vos yeux éclatants\nJe crois voir l’empyrée éclore :\nVous riez comme le printemps\nEt vous pleurez comme l’aurore.",
                                "translation": "Children, in your bright eyes\nI think I see the empyrean bloom:\nYou laugh like the spring\nAnd you cry like the dawn.",
                                "english": "Children, in your bright eyes\nI think I see the empyrean bloom:\nYou laugh like the spring\nAnd you cry like the dawn."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
