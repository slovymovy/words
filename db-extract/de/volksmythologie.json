                        "sense_id": "31b57ed6-b428-3df9-8d50-3f0392d1a68d",
                        "entry_id": "f29aa64a-2909-372c-a463-0ecf3a808e41",
                        "glosses": [
                            "die Gesamtheit der Mythen eines bestimmten Volkes oder einer Volksgruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be319351-4d27-4ed5-9ced-1c6043c54a25",
                                "sense_id": "31b57ed6-b428-3df9-8d50-3f0392d1a68d",
                                "text": "„Der Massenmörder Fritz Haarmann erschien seinen Mitmenschen als so gruselig, dass er als Schreckgestalt in die Volksmythologie eingegangen ist und in Wachsfigurenkabinetten ausgestellt wird.“"
                            },
                            {
                                "example_id": "e62c630d-84e4-456a-af39-3339ed86455f",
                                "sense_id": "31b57ed6-b428-3df9-8d50-3f0392d1a68d",
                                "text": "„Er wittert in der Einstellung der Verschwörer Respekt für Generäle als Vaterfiguren der modernen ‚Volksmythologie Deutschlands‘.“"
                            }
                        ],
