                                    {
                                        "sense_id": "aa9e2187-8cd6-36e4-bcd2-4df417f77a71",
                                        "entry_id": "c8dc2979-d1b5-34fa-b1f6-f9108ed3dfe8",
                                        "glosses": [
                                            "Straße, die zu einem bestimmten Ort führt"
                                        ],
                                        "tags": [
