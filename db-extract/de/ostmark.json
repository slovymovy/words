                "senses": [
                    {
                        "sense_id": "2686bff4-e7bb-350b-b0cd-b0f6d2481d40",
                        "entry_id": "b732348d-2048-3b78-8697-22d05722ae6c",
                        "glosses": [
                            "Währung der DDR, im Unterschied zur Währung der Bundesrepublik Deutschland und Westberlins"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "949c9ad8-6507-44b1-9719-426bdaac5c51",
                                "sense_id": "2686bff4-e7bb-350b-b0cd-b0f6d2481d40",
                                "text": "„Streng genommen, nach den Devisen-Gesetzen der DDR, ist die Ostmark gar nichts wert.“"
                            },
                            {
                                "example_id": "da2cf002-5cae-4ab0-81e7-d558a4355739",
                                "sense_id": "2686bff4-e7bb-350b-b0cd-b0f6d2481d40",
                                "text": "„Sie hatten befürchtet, dass ihr Verlag nicht überleben würde, hatte er doch die Jahre zuvor nur von den unterschiedlichen Währungen in Ost und West gelebt, hatte mit Ostmark die Bücher produziert, um sie für Westmark zu verkaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
