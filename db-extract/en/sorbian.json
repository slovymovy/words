                    {
                        "translation_id": "44066663-acb7-4047-b426-28ff4d4d44d6",
                        "source_entry_id": "422a1b4a-dec2-35d6-b0ae-20a3fa2465f3",
                        "source_sense_id": "599e5b3a-fe21-3e02-a34b-462e649f7e7a",
