                ],
                "senses": [
                    {
                        "sense_id": "f471dcf7-ca55-369e-9f55-2e5d4b3eec3c",
                        "entry_id": "ad8e5f6d-4edd-3e89-89f2-de4b8aac8ad0",
                        "glosses": [
                            "rodzaj obwarzanka o charakterystycznym kształcie zbliżonym do ósemki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de6e0881-0ee5-4d21-840e-90f12a370bda",
                                "sense_id": "f471dcf7-ca55-369e-9f55-2e5d4b3eec3c",
                                "text": "– Precle, świeże precle – wołał Żyd, przegięty cały do tyłu, aby łatwiej było dźwigać olbrzymi kosz wypełniony preclami i najeżony prętami, na których również nawleczone były rumiane, jakby świeżo lakierowane „bajgiełe”"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ee1a29fb-4ad7-3519-bce2-e20da8ee43d2",
                        "entry_id": "ad8e5f6d-4edd-3e89-89f2-de4b8aac8ad0",
                        "glosses": [
                            "artykuł tematyczny, pisany do tzw. katalogu „presell page”, którego zadaniem jest sztuczne podbijanie rankingu jakiejś strony internetowej w wynikach wyszukiwarek"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8f513db-b161-4deb-bb54-ea967a584596",
                        "source_entry_id": "ad8e5f6d-4edd-3e89-89f2-de4b8aac8ad0",
                        "source_sense_id": "f471dcf7-ca55-369e-9f55-2e5d4b3eec3c",
                        "target_lang_word": "pretzel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pretzel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4f4a267-8a91-3c9e-8339-24efe4dc6073",
                                        "entry_id": "806d0b16-31b9-3cbd-8053-2e82bc943f74",
                                        "glosses": [
                                            "A toasted bread or cracker usually in the shape of a loose knot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43f45000-49f9-47ac-9a58-f74b9939862c",
                                                "sense_id": "d4f4a267-8a91-3c9e-8339-24efe4dc6073",
                                                "text": "When I was young, the best Philadelphia could do in the way of combining music and eating—or principally drinking—was at the Mäennerchor Garden at Ninth and Green, where a pretzel might be had with a glass of beer, or a sherry cobbler"
                                            },
                                            {
                                                "example_id": "c92b426e-2851-457e-b2d6-8b7b2364bfd3",
                                                "sense_id": "d4f4a267-8a91-3c9e-8339-24efe4dc6073",
                                                "text": "Outside, the little birds on the telegraph wires looked in at the moving picture and smiled at one another. Some even wept. Then they flew down into the street and simply raved over a stale pretzel, ten days dead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c59975f-5afa-3d13-8136-51e98732867f",
                                        "entry_id": "806d0b16-31b9-3cbd-8053-2e82bc943f74",
                                        "glosses": [
                                            "Anything that is knotted, twisted, or tangled."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b862102b-c4ab-409f-afdc-e6c296c046bc",
                                                "sense_id": "1c59975f-5afa-3d13-8136-51e98732867f",
                                                "text": "he drew himself up into a regular pretzel of a boy"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pretzel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7187d2d1-120f-3634-9cdf-f3f1b2cb06eb",
                                        "entry_id": "05bbbcf3-cd40-3552-a228-9eb5472d1c96",
                                        "glosses": [
                                            "To bend, twist, or contort."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "947b162d-2bd0-4e81-8056-7ca0179ea7fe",
                                                "sense_id": "7187d2d1-120f-3634-9cdf-f3f1b2cb06eb",
                                                "text": "They discovered a snake pretzelled into knots."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf118ad8-7969-499d-bd33-f50e7714df40",
                        "source_entry_id": "ad8e5f6d-4edd-3e89-89f2-de4b8aac8ad0",
                        "source_sense_id": "f471dcf7-ca55-369e-9f55-2e5d4b3eec3c",
                        "target_lang_word": "Brezel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brezel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81e544c4-f350-388b-9d98-f3c49e800f9a",
                                        "entry_id": "20c99f0a-b83b-3bea-9280-b02366485381",
                                        "glosses": [
                                            "größeres mit Salz beziehungsweise Zucker bestreutes Laugen- oder Zuckergebäck, dessen Form dem Buchstaben B ähnelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69f7be8e-df74-45e4-8312-420509f929c4",
                                                "sense_id": "81e544c4-f350-388b-9d98-f3c49e800f9a",
                                                "text": "Das alte Zunftzeichen der Bäcker ist die Brezel."
                                            },
                                            {
                                                "example_id": "b69f9f13-aaec-4703-b90d-6592fbcb574c",
                                                "sense_id": "81e544c4-f350-388b-9d98-f3c49e800f9a",
                                                "text": "„Das Wort Brezel heißt überall auf der Welt gleich: Brezel oder Pretzel – das begreifen wir in diesem Augenblick.“"
                                            },
                                            {
                                                "example_id": "0d4bcda7-d5a7-4481-8244-c6413603d491",
                                                "sense_id": "81e544c4-f350-388b-9d98-f3c49e800f9a",
                                                "text": "„Die Prinz-Heinrich-Mütze, die der Gast aufbehält, und die Brezeln weisen ihn als Deutschen aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3cd09bad-c0aa-344b-bc68-801f939a0153",
                                        "entry_id": "20c99f0a-b83b-3bea-9280-b02366485381",
                                        "glosses": [
                                            "Knabbergebäck, das in seiner Form einer Brezel [1] nachempfunden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d1af0b6-0ab3-4bf7-8b37-8ee9245e3ad2",
                                                "sense_id": "3cd09bad-c0aa-344b-bc68-801f939a0153",
                                                "text": "Zum Bier gibts Salzstangen, Chips und Brezel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "91538c52-0c02-3521-8f82-7c335df4e11e",
                                        "entry_id": "20c99f0a-b83b-3bea-9280-b02366485381",
                                        "glosses": [
                                            "Art Waffel, dünnes, knuspriges, im Waffeleisen hergestelltes süßes oder salziges, auch mit Kümmel gewürztes Gebäck"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15908b2b-3b6c-4732-945f-fd879f126188",
                                                "sense_id": "91538c52-0c02-3521-8f82-7c335df4e11e",
                                                "text": "„Ob süss oder pikant, ob Taler oder Cornet: Mit dem Brezelieisen «Knusper-Träumli» werden alle Brezeli-Träume wahr!“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69f8ac2b-de38-4ca0-a15c-d571d800d092",
                        "source_entry_id": "ad8e5f6d-4edd-3e89-89f2-de4b8aac8ad0",
