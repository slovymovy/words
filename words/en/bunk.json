                            {
                                "target_lang_word": "双层床",
                                "target_lang_sense_clarification": "指上下铺的床"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a58ce5f8-cd77-388b-bd2c-ee0012a1c26a",
                    "sense_definition": "Nonsense or foolish talk; something that is not true or is ridiculous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's explanation for the missing funds was total <w>bunk</w>.",
                            "target_lang_translations": {
                                "ru": "Объяснение политика по поводу пропавших средств было полной <w>чушью</w>.",
                                "zh": "那位政客对资金去向的解释完全是<w>胡说</w>。"
                            }
                        },
                        {
                            "text": "Don't listen to him; everything he says about the incident is pure <w>bunk</w>.",
                            "target_lang_translations": {
                                "ru": "Не слушай его; всё, что он говорит об инциденте — чистая <w>брехня</w>.",
                                "zh": "别听他的；他关于那件事所说的一切全是<w>废话</w>。"
                            }
