                        "entry_id": "ed7b3dc1-8d6a-38ee-86ed-84d1237bd6ed",
                        "glosses": [
                            "A species of bellflower with roots and leaves formerly used in salads, Campanula rapunculus."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8f7a84a2-4687-4486-a161-ad85fda076b0",
                                "sense_id": "34262025-d8e9-32b1-9bc4-9fda4eb227be",
                                "text": "Rampion grown in the cottage garden made the children of the house quarrelsome; breathing deeply into a handful of mint refreshed your senses, but aconite could cause your death."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6afd0e5-8447-317b-8d28-1349ee669292",
                        "entry_id": "ed7b3dc1-8d6a-38ee-86ed-84d1237bd6ed",
                        "glosses": [
                            "Any of several flowering plants of the genus Phyteuma, within the family Campanulaceae."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
