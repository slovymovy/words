                                                "sense_id": "c832a22a-0c0c-35e5-8403-8333264ff162",
                                                "text": "W Jerozolimie zaś znajduje się Sadzawka Owcza, nazwana po hebrajsku Betesda, zaopatrzona w pięć krużganków"
                                            },
                                            {
                                                "example_id": "c0b68137-23dd-48f9-bc86-89860f12bc55",
                                                "sense_id": "c832a22a-0c0c-35e5-8403-8333264ff162",
                                                "text": "Te widokówki kupiliśmy po zwiedzeniu Betesdy."
                                            }
                                        ],
