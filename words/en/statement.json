                },
                {
                    "sense_id": "066c45ff-ee18-3f88-95cb-37bb1264a235",
                    "sense_definition": "A single instruction in a computer program.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer forgot to include a semicolon at the end of the <w>statement</w>.",
                            "target_lang_translations": {
                                "ru": "Программист забыл поставить точку с запятой в конце <w>оператора</w>.",
                                "tr": "Programcı, <w>deyim</w> sonuna noktalı virgül koymayı unuttu."
                            }
                        },
                        {
                            "text": "A return <w>statement</w> is used to end the execution of a function.",
                            "target_lang_translations": {
                                "ru": "<w>Оператор</w> return используется для завершения выполнения функции.",
                                "tr": "Bir fonksiyonun çalışmasını sonlandırmak için bir return <w>komutu</w> kullanılır."
                            }
                        }
                    ],
                    "common_phrases": [
                        "return statement",
                        "if statement",
                        "print statement"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единичная инструкция в компьютерной программе.",
                        "tr": "Bir bilgisayar programındaki tek bir talimat."
