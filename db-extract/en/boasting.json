                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "efbc1879-65a8-32d8-995d-727dd627465c",
                        "entry_id": "bb90ea27-ad2e-3184-810b-07fbecac3c35",
                        "glosses": [
                            "An individual boast or bout of boasting."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb5a0827-024f-4dcd-904a-e9bc0610191c",
                                "sense_id": "efbc1879-65a8-32d8-995d-727dd627465c",
                                "text": "Solomon says, \"Pride goes before destruction, and a haughty spirit before a fall.\" Some, as soon as their vain boastings were uttered, were made monuments of divine justice."
                            },
                            {
                                "example_id": "c44d3927-ae3b-452e-9908-e950643c2a88",
                                "sense_id": "efbc1879-65a8-32d8-995d-727dd627465c",
                                "text": "After that there were boastings in Hereot! Then did the warriors brag before their stainless queen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afc98743-17ea-4c51-908b-b481cfd7eb2b",
                        "source_entry_id": "bb90ea27-ad2e-3184-810b-07fbecac3c35",
                        "source_sense_description": "the making of boasts",
                        "target_lang_word": "Prahlen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "573077f8-1de7-4bf3-b4c5-2958102ce037",
                        "source_entry_id": "bb90ea27-ad2e-3184-810b-07fbecac3c35",
                        "source_sense_description": "the making of boasts",
                        "target_lang_word": "Prahlerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prahlerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc3bd626-4881-3d94-98d7-83f029bb7b3d",
                                        "entry_id": "dc6eb28c-c5a0-3f99-a7a2-6f743537e0d2",
                                        "glosses": [
                                            "übertriebene Betonung/Hervorhebung von etwas, mit dem sich der Sprecher selbst lobt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d8833d2-791e-4c1c-8b93-b8bea2eb9990",
                                                "sense_id": "bc3bd626-4881-3d94-98d7-83f029bb7b3d",
                                                "text": "„Das war keine Prahlerei, sondern eher Untertreibung.“."
                                            },
                                            {
                                                "example_id": "b01944cc-a642-4e9a-beff-4e9a2ffaf5c2",
                                                "sense_id": "bc3bd626-4881-3d94-98d7-83f029bb7b3d",
                                                "text": "„Man hatte bald genug, übergenug von diesem Querulanten und seiner Prahlerei, er sei schließlich schon ein Wunderkind gewesen.“"
                                            },
                                            {
                                                "example_id": "05110552-ab50-4d1f-8ea3-04a7d92c3fde",
                                                "sense_id": "bc3bd626-4881-3d94-98d7-83f029bb7b3d",
                                                "text": "„Nationen bestehen aus einzelnen Menschen, und nicht jeder ist bereit, der Prahlerei und Rüpelei seiner Regierung Beifall zu spenden.“"
                                            },
                                            {
                                                "example_id": "680cc527-e4b8-44c5-bef1-e0d4cfa0442a",
                                                "sense_id": "bc3bd626-4881-3d94-98d7-83f029bb7b3d",
                                                "text": "„Der Ausdruck des jungen Mannes der Indianerin gegenüber hatte jene hier ziemlich alberne Prahlerei angenommen, der sich jedoch auch der sonst vernünftige Brite so gerne und nie mehr als dann überläßt, wenn es sein Vorteil zu erheischen scheint, Fremden eine recht große Idee von seinem Lande und so gelegentlich von sich selbst beizubringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4a0a46d-6db8-4d14-9df3-35a560af59d0",
                        "source_entry_id": "bb90ea27-ad2e-3184-810b-07fbecac3c35",
                        "source_sense_description": "the making of boasts",
                        "target_lang_word": "Angeben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angeben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "166a9ed8-c1a6-3b03-8300-3625eb2d077b",
                                        "entry_id": "92e383d6-e5cc-322f-a496-80d65ae83b2c",
                                        "glosses": [
                                            "prahlende Handlung, protziges Gehabe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bbed886-6e7c-46a5-8738-ac8c6a3d1a63",
                                                "sense_id": "166a9ed8-c1a6-3b03-8300-3625eb2d077b",
                                                "text": "„Zu Beginn löste Dunnigan einen Drogenhinterhalt am Johnston Square, dann folgte Pellegrini mit einem Totschlag auf der Alameda Avenue Street, bei dem ein Idiot beim Angeben mit seiner neuen Halbautomatik einen Vierzehnjährigen getötet hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0eaf503-6ebb-4b06-8a7a-7860aa9afda6",
                        "source_entry_id": "bb90ea27-ad2e-3184-810b-07fbecac3c35",
                        "source_sense_description": "the making of boasts",
                        "target_lang_word": "Angabe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angabe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6fb0f8a-fbeb-39df-9869-daa85f146a97",
                                        "entry_id": "56a50f06-0c3b-3e8e-9f0d-7e5a04b86558",
                                        "glosses": [
                                            "Aussage, Behauptung, Deklaration, Information"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "673e465f-6c41-46a1-85e5-ced12e14aa83",
                                                "sense_id": "b6fb0f8a-fbeb-39df-9869-daa85f146a97",
                                                "text": "Wir konnten seine Angaben überprüfen und bestätigen."
                                            },
                                            {
                                                "example_id": "2e15db4b-b9d8-466d-be7c-198b6cefe795",
                                                "sense_id": "b6fb0f8a-fbeb-39df-9869-daa85f146a97",
                                                "text": "„Bei den Luftangriffen der US-geführten Koalition gegen die Dschihadistengruppe Islamischer Staat (IS) in Syrien sind nach Angaben von Aktivisten schon mehr als 550 Menschen getötet worden.“"
                                            },
                                            {
                                                "example_id": "0bf8c222-a499-4be0-82f3-fcbd4e10338b",
                                                "sense_id": "b6fb0f8a-fbeb-39df-9869-daa85f146a97",
                                                "text": "„In der Europäischen Union sind zurzeit ca. 300 Zusatzstoffe zugelassen, die im Klartext auf der Packung aufgeführt oder durch Angabe der E-Nummern kenntlich gemacht werden müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35bfaea1-fe51-3430-a12e-4c284732c95e",
                                        "entry_id": "56a50f06-0c3b-3e8e-9f0d-7e5a04b86558",
                                        "glosses": [
                                            "Vorgabe, mehr oder besser zu sein, als man tatsächlich ist"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cc86bfd-59d9-4702-a5aa-07303b4f1471",
                                                "sense_id": "35bfaea1-fe51-3430-a12e-4c284732c95e",
                                                "text": "Alles nur Angabe!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "84ca5f71-8b83-3cdf-8c2f-a2b699dc40de",
                                        "entry_id": "56a50f06-0c3b-3e8e-9f0d-7e5a04b86558",
                                        "glosses": [
                                            "Wort oder Wortgruppe, die man in einem Satz weglassen kann, ohne dass er deshalb grammatisch falsch wird"
                                        ],
                                        "tags": [
                                            "Dependenzgrammatik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c5c9def-1b26-4cfb-b3ac-f611002c17c6",
                                                "sense_id": "84ca5f71-8b83-3cdf-8c2f-a2b699dc40de",
                                                "text": "In dem Satz „Das Haus meines Vaters ist alt“ ist „meines Vaters“ eine Angabe."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c0a3ea37-eb5a-3879-9be2-8ad6712e565c",
                                        "entry_id": "56a50f06-0c3b-3e8e-9f0d-7e5a04b86558",
                                        "glosses": [
                                            "der erste Schlag, der den Ball ins Spiel bringt"
                                        ],
                                        "tags": [
                                            "Ballspiel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9c06715-abb7-4916-910f-51ca8bdf8209",
                                                "sense_id": "c0a3ea37-eb5a-3879-9be2-8ad6712e565c",
                                                "text": "Dreimal konnte der Spieler schon bei der Angabe punkten."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e48f60b0-93ef-3097-9d68-f66d85ecea64",
                                        "entry_id": "56a50f06-0c3b-3e8e-9f0d-7e5a04b86558",
                                        "glosses": [
                                            "Anzahlung"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efab4277-b420-407b-ba24-a37bc6bb7671",
                                                "sense_id": "e48f60b0-93ef-3097-9d68-f66d85ecea64",
                                                "text": "„Im vorliegenden Fall sei die Klägerin nicht im Leistungsverzug gewesen, weil sie eine Angabe geleistet hatte, die höher als der Preis der bereitliegenden Bäume war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
