                                        "sense_id": "766bf438-f3a4-33b8-916b-1be20e71a349",
                                        "entry_id": "b6539eb6-c44d-35a8-bb0f-f42fbd0aa5fd",
                                        "glosses": [
                                            "antike Stadt, die im Nordosten des Peloponnes liegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a5e66c3-34c0-46c6-a881-380e91e2a2be",
                                                "sense_id": "766bf438-f3a4-33b8-916b-1be20e71a349",
                                                "text": "„Von Paris aus hatte er bei den griechischen Behörden eine Erlaubnis für größere Ausgrabungen in Mykene erwirken wollen.“"
                                            },
                                            {
                                                "example_id": "32af27b6-39a6-4877-ae66-eec590a259da",
                                                "sense_id": "766bf438-f3a4-33b8-916b-1be20e71a349",
                                                "text": "„In Mykene haben Schliemanns Methoden jedoch zu herausragenden Funden geführt.“"
                                            },
                                            {
                                                "example_id": "65c0200e-4d09-4df5-bcd3-a8cc22e7762d",
                                                "sense_id": "766bf438-f3a4-33b8-916b-1be20e71a349",
                                                "text": "„Mykene selbst war in dieser Zeit dem Untergang geweiht, die Infrastruktur zusammengebrochen und ein starker Bevölkerungsschwund war zu verzeichnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
