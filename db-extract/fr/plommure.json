                "senses": [
                    {
                        "sense_id": "cf02f363-3c0f-39d1-a5f4-cc232cb07196",
                        "entry_id": "09934bb1-8ddc-3b77-86fb-5f372711bd7f",
                        "glosses": [
                            "Glaçure vitrifiable et translucide à base d’oxyde de plomb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d38dce7-e293-4a42-a106-b5c9087b4453",
                                "sense_id": "cf02f363-3c0f-39d1-a5f4-cc232cb07196",
                                "text": "Les ouvriers nomment cette préparation de la plommure, parce qu’elle est à base de plomb. C’est ainsi que sont vernies et ornées ces assiettes chargées de coqs et de fleurs aux couleurs criardes qui garnissent encore les potières (dressoirs) de la Picardie et du Bray."
                            },
                            {
                                "example_id": "9f2df217-c4a0-4bbb-8c40-bb7de2cbb8e1",
                                "sense_id": "cf02f363-3c0f-39d1-a5f4-cc232cb07196",
                                "text": "Au-dessous de ces deux tapisseries se font admirer les pièces de Savignies, en argile légère, revêtue d’une couverte ou plommure et diversement colorée : leur effet décoratif est très grand, malgré leur aspect rude."
                            }
                        ]
                    },
                    {
                        "sense_id": "c63ceafb-0902-3b72-b5f3-bcbfcf84e297",
                        "entry_id": "09934bb1-8ddc-3b77-86fb-5f372711bd7f",
                        "glosses": [
                            "Poterie vernissée"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f2cc488-6dc6-4b90-a251-d7c70554b0bb",
                                "sense_id": "c63ceafb-0902-3b72-b5f3-bcbfcf84e297",
                                "text": "Ils comprennent actuellement deux fabriques de poterie simple , et trois de poterie vernissée , appelée plommure."
                            },
                            {
                                "example_id": "487cc620-b820-4524-a55e-0fd7b55b492e",
                                "sense_id": "c63ceafb-0902-3b72-b5f3-bcbfcf84e297",
                                "text": "Bien des dressoirs et crédences ont pu s’enorgueillir de porter une «plommure» du Beauvaissis ou une faïence venue d’Italie ou de Lyon."
                            },
                            {
                                "example_id": "118ac71c-38e2-4330-9c3b-3d31c10452ab",
                                "sense_id": "c63ceafb-0902-3b72-b5f3-bcbfcf84e297",
                                "text": "Des nombreuses fabriques de poterie vernissée, dite plommure ou plombure, qui fonctionnaient jadis a Savignies, il n’en existe plus qu’une ou deux dont les produits communs sont destinés aux usages domestiques."
                            }
                        ]
                    }
