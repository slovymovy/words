                        "sense_id": "8997951d-1284-34d8-82ec-c423da624070",
                        "entry_id": "f281032b-5237-38e5-8833-764285097805",
                        "glosses": [
                            "Repas indien ou pakistanais dont la composition diffère d’une région à l’autre, composé de plats servis généralement dans un ou plusieurs thalis."
                        ],
                        "tags": [],
                        "examples": [
                            {
