                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Dreigend</w> met een groot mes liep de overvaller op de kassier af.",
                            "target_lang_translations": {
                                "en": "<w>Threatening</w> with a large knife, the robber walked toward the cashier."
                            }
