                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tachymeter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea2e768e-cd6b-3406-bc0a-823a564c3e9e",
                                        "entry_id": "5cab95a2-389e-3ace-9bf6-66fadf013951",
                                        "glosses": [
                                            "Gerät zum Messen von Winkeln und Strecken in einem Gelände"
                                        ],
                                        "tags": [
                                            "Geodäsie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a055836-0509-47ce-80ad-e61da63af3c7",
                                                "sense_id": "ea2e768e-cd6b-3406-bc0a-823a564c3e9e",
                                                "text": "„Das Tachymeter misst horizontale Richtungen, Vertikalwinkel und die schräge Distanz zwischen Instrument und anvisiertem Zielpunkt.“"
                                            },
                                            {
                                                "example_id": "423cb068-ce81-407d-b37e-bc045487e18f",
                                                "sense_id": "ea2e768e-cd6b-3406-bc0a-823a564c3e9e",
                                                "text": "„Tachymeter sind im Prinzip Theodolite, jedoch zusätzlich ausgestattet mit einer eingebauten Distanzmesseinheit.“"
                                            },
                                            {
                                                "example_id": "c04a89f4-3237-40a2-8db1-c4fe943c7ec5",
                                                "sense_id": "ea2e768e-cd6b-3406-bc0a-823a564c3e9e",
                                                "text": "„Der nächste große Schritt war getan, als das erste koaxiale Tachymeter entwickelt wurde.“"
                                            },
                                            {
                                                "example_id": "a81c91c9-483b-43b1-ad2e-1f4c4a57815b",
                                                "sense_id": "ea2e768e-cd6b-3406-bc0a-823a564c3e9e",
                                                "text": "„Man wird also bestrebt sein, mit dem Tachymeter Linienzüge längs der Bauteilkanten anzuzielen und einzumessen.“"
                                            },
                                            {
                                                "example_id": "0e957d44-51cd-4b95-96fa-c3c0289c5609",
                                                "sense_id": "ea2e768e-cd6b-3406-bc0a-823a564c3e9e",
                                                "text": "„Der Tachymeter als Weiterentwicklung des Theodolits kann neben Winkeln auch Strecken messen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
