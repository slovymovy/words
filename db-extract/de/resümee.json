                                            {
                                                "example_id": "dcb1f419-5346-472f-b658-f31fa8e21cfc",
                                                "sense_id": "0bc63bd7-9d53-3537-97b3-9128a497364d",
                                                "text": "Réviser son histoire dans un résumé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "résumé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c91c26e-7517-39f5-95a5-a3bd75753817",
                                        "entry_id": "ebfb7f50-9e2e-3f0a-bde4-9b81eeef4719",
                                        "glosses": [
                                            "Participe passé masculin singulier de résumer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3921a08a-1a0d-4890-94fc-6eb6f6235e05",
                                                "sense_id": "5c91c26e-7517-39f5-95a5-a3bd75753817",
                                                "text": "J’ai résumé les refus de Lucien par son invective hautaine de mari fidèle et d’honnête homme : « Garde l’Europe, j’ai ma femme ! » et pour le reste j’ai théâtrifié la scène de mon mieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01fb9c99-c6e1-4f67-af38-99fad19317e7",
                        "source_entry_id": "958418a4-db8b-3477-baa1-7dd7daebf498",
                        "source_sense_id": "436c616a-3694-34db-af83-6979d0583154",
                        "source_sense_description": "zusammenfassender Überblick",
                        "target_lang_word": "要約",
                        "target_lang_code": "ja",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "要約",
                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "174c3042-9a5c-3ff9-813d-2c47505867ab",
                                        "entry_id": "07c8e585-b3de-3777-afac-64bd7a01a3bf",
                                        "glosses": [
                                            "話や文章の要点を短く纏めること。または、そのようにまとめられたもの。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42a6f961-9fc3-4e65-ac25-4adb61840089",
                                                "sense_id": "174c3042-9a5c-3ff9-813d-2c47505867ab",
                                                "text": "『文学サークル』第九号に、『勤労者文学』の発展をめざして行われた徳永直と小田切秀雄の討論の要約がのせられている。アンケート用として整理されたものである。"
                                            },
                                            {
                                                "example_id": "2fcee3f0-9674-4f76-ae21-76f8ec2f6088",
                                                "sense_id": "174c3042-9a5c-3ff9-813d-2c47505867ab",
                                                "text": "世界のどこかに詳しい解説があるのなら、この機能で、読者をそっちに導けばよい。本人の直接証言や一次資料が公開されているのなら、要約や引用は避けてリンクする。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbe4bd99-76f0-3b04-9b74-cd2c2d2f7ea5",
                                        "entry_id": "07c8e585-b3de-3777-afac-64bd7a01a3bf",
                                        "glosses": [
                                            "条件。"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e856c7ce-552a-4a16-9991-ab85de842653",
                                                "sense_id": "bbe4bd99-76f0-3b04-9b74-cd2c2d2f7ea5",
                                                "text": "「お玉とはどうして相識になって、どんな場合にそれを聞いたか」と問うかも知れない。しかしこれに対する答も、前に云った通り、物語の範囲外にある。只僕にお玉の情人になる要約の備わっていぬことは論を須たぬから、読者は無用の臆測をせぬが好い。"
                                            },
                                            {
                                                "example_id": "e40d356d-295e-4e10-9d98-6784e7f024da",
                                                "sense_id": "bbe4bd99-76f0-3b04-9b74-cd2c2d2f7ea5",
                                                "text": "この点で、日本の探偵小説は、ほとんど最近にようやく勃興の機運を示してきたにもかかわらず、かなりフェーヴォラブル〔好意的〕な要約の下に生ぶ声を上げたものと言うべきであろう。"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "要約",
                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "04f8cbd6-7d9e-381e-80e9-b414a03b7b27",
                                        "entry_id": "e3513d49-ede3-3a9f-9705-34243fd01ce2",
                                        "glosses": [
                                            "話や文章の要点を短く纏める。"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38ffe7dc-100b-43d4-a32e-755149f5ce74",
                                                "sense_id": "04f8cbd6-7d9e-381e-80e9-b414a03b7b27",
                                                "text": "僕等は小説を読むと、すぐその筋だとかテエーマーだとか思想だとかを、要約したがりますね。ひどいのになると、この小説は何主義だろうかと、きめる事を先決問題にする莫迦が居るよ。"
                                            },
                                            {
                                                "example_id": "aee3c809-55a1-46b9-a785-f11e51c1e5bd",
                                                "sense_id": "04f8cbd6-7d9e-381e-80e9-b414a03b7b27",
                                                "text": "先生に関しては約半世紀の追想があり、既に蕪稿も千枚近く書いて来た。その結論をここに今二枚に要約するのは相当にむつかしい。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79ea9140-6daf-4988-8823-57234c0d6cbf",
                        "source_entry_id": "958418a4-db8b-3477-baa1-7dd7daebf498",
                        "source_sense_id": "436c616a-3694-34db-af83-6979d0583154",
                        "source_sense_description": "zusammenfassender Überblick",
                        "target_lang_word": "резюме",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "резюме",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9c4cc764-ee2e-3b1e-bdc1-9124cb74aba6",
                                        "entry_id": "48bc30fa-69b6-3cdd-82b0-64603ca4b35c",
                                        "glosses": [
                                            "краткий вывод из вышеизложенного"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bddb92a3-03fc-4444-a577-287ba2068643",
                                                "sense_id": "9c4cc764-ee2e-3b1e-bdc1-9124cb74aba6",
                                                "text": "После последнего слова обвиняемых и переговоров сторон о форме постановки вопросов, продолжавшихся еще довольно долго, вопросы были поставлены, и председатель начал свое резюме."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7241f9eb-3e0b-38ed-a331-aedbadbb732f",
                                        "entry_id": "48bc30fa-69b6-3cdd-82b0-64603ca4b35c",
                                        "glosses": [
                                            "краткий автобиографический документ, содержащий информацию о навыках, опыте работы, образовании и т. п. соискателя на какую-либо должность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc072304-2065-4542-835d-8061d9b9149e",
                                                "sense_id": "7241f9eb-3e0b-38ed-a331-aedbadbb732f",
                                                "text": "В полдень я, надев покровительственную улыбку, прошел мимо опешившей на мгновенье секретарши, толкнул дверь ногой и оказался в просторном кабинете перед тремя джентльменами, просматривающими чьи-то резюме."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
