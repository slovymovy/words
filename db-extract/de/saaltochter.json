                        "sense_id": "4b547cfe-4648-3bca-9ae1-81eaecbb79a2",
                        "entry_id": "9ee587f6-fe73-3a2d-9881-07684574837d",
                        "glosses": [
                            "Kellnerin, Serviererin, weibliche Servierkraft in Restaurants und Hotels"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "0d5d61dc-f42a-4bf0-a77e-91294a21c6ab",
                                "sense_id": "4b547cfe-4648-3bca-9ae1-81eaecbb79a2",
                                "text": "„Man wird Saaltochter, wenn man sich zur Serviererin ausbilden lässt.“"
                            },
                            {
                                "example_id": "224e9a59-ee1d-4f53-91b8-e6942bedc8b1",
                                "sense_id": "4b547cfe-4648-3bca-9ae1-81eaecbb79a2",
                                "text": "„Mit besonderem Interesse musterte Sophie aber die bedienenden Saaltöchter.“"
                            },
                            {
                                "example_id": "440bbe90-a5fe-4c86-b1e0-d67add11c215",
                                "sense_id": "4b547cfe-4648-3bca-9ae1-81eaecbb79a2",
                                "text": "„Fast allein, denn Freud erwähnt die Anwesenheit einer jungen Schankmagd, der Kellnerin, der Saaltochter, die man sich meist üppig und drall wie in Brüderles Dirndl-Fantasie vorstellen kann, und an der begehen die frustrierten Männer ihre zotigen Ausfälle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
