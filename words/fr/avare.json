            "senses": [
                {
                    "sense_id": "138864a5-fbf4-3c8f-8fc4-c62937d86a26",
                    "sense_definition": "Personne qui restreint excessivement ses dépenses et cherche à accumuler les richesses.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet <w>avare</w> préfère vivre dans l'inconfort plutôt que de dépenser un seul centime."
                        },
                        {
                            "text": "Dans sa comédie célèbre, Molière met en scène un vieil <w>avare</w> ridicule et tyrannique."
