                                        "sense_id": "f5f4a0c5-b005-3367-b6b8-22864fbaa7bb",
                                        "entry_id": "64543b1e-ec18-3b20-9cd2-693b4f59d90c",
                                        "glosses": [
                                            "Sammelbezeichnung für Kenntnisse, welche die örtlichen Begebenheiten betreffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e147a22c-81a4-4306-81dc-f340465c52d4",
                                                "sense_id": "f5f4a0c5-b005-3367-b6b8-22864fbaa7bb",
                                                "text": "In Heimatkunde war ich immer gut."
                                            },
                                            {
                                                "example_id": "c40d06a9-11c5-46d6-98b3-650f9da827cf",
                                                "sense_id": "f5f4a0c5-b005-3367-b6b8-22864fbaa7bb",
                                                "text": "„In Heimatkunde ging uns Frau Katzer mit dem Rheinischen Schiefergebirge auf den Keks.“"
                                            }
                                        ],
