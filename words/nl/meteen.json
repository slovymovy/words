                {
                    "sense_id": "f055bc14-618a-3fbe-918a-83bbfb1d5204",
                    "sense_definition": "Zonder te wachten of uitstel; op dit ogenblik.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De volgende ochtend viel <w>meteen</w> op hoe stil het buiten was.",
                            "target_lang_translations": {
                                "en": "The next morning it was <w>immediately</w> noticeable how quiet it was outside.",
                                "ru": "На следующее утро <w>сразу</w> стало заметно, как тихо было на улице.",
                                "pl": "Następnego ranka <w>od razu</w> dało się zauważyć, jak cicho było na zewnątrz.",
                                "de": "Am nächsten Morgen fiel <w>sofort</w> auf, wie still es draußen war.",
                                "fr": "Le lendemain matin, on a <w>immédiatement</w> remarqué à quel point il faisait calme dehors.",
                                "it": "La mattina seguente si è notato <w>subito</w> quanto fosse silenzioso fuori.",
                                "cs": "Příští ráno bylo <w>hned</w> nápadné, jaký byl venku klid.",
                                "tr": "Ertesi sabah dışarının ne kadar sessiz olduğu <w>hemen</w> fark edildi.",
                                "es": "A la mañana siguiente <w>inmediatamente</w> se notó lo silencioso que estaba afuera.",
                                "zh": "第二天早上，我<w>立刻</w>注意到外面是多么安静。"
                            }
                        },
                        {
                            "text": "Ik beloof je dat ik de afwas <w>meteen</w> zal doen.",
                            "target_lang_translations": {
                                "en": "I promise you that I will do the dishes <w>right away</w>.",
                                "ru": "Я обещаю тебе, что помою посуду <w>сразу</w>.",
                                "pl": "Obiecuję ci, że <w>zaraz</w> pozmywam naczynia.",
                                "de": "Ich verspreche dir, dass ich den Abwasch <w>sofort</w> erledigen werde.",
                                "fr": "Je te promets que je ferai la vaisselle <w>tout de suite</w>.",
                                "it": "Ti prometto che laverò i piatti <w>subito</w>.",
                                "cs": "Slibuji ti, že to nádobí <w>hned</w> umyji.",
                                "tr": "Sana bulaşıkları <w>hemen</w> yıkayacağıma söz veriyorum.",
                                "es": "Te prometo que haré los platos <w>ahora mismo</w>.",
                                "zh": "我向你保证，我会<w>马上</w>去洗碗。"
                            }
                        }
                    ],
                    "synonyms": [
                        "direct",
                        "onmiddellijk",
                        "op stel en sprong",
                        "gelijk"
