                "senses": [
                    {
                        "sense_id": "19872fc0-d323-375e-aabd-6ed7cb9e7a6a",
                        "entry_id": "7e433b3d-a9da-32f7-9dbe-b659b24a4d81",
                        "glosses": [
                            "Eingriff in ein Geschehnis, um etwas zu bewirken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "374fcfea-37df-405a-bd13-fc54659ea1ab",
                                "sense_id": "19872fc0-d323-375e-aabd-6ed7cb9e7a6a",
                                "text": "„Die ebenso unverhohlene wie unverschämte Einflussnahme des autoritären Staatschefs der Türkei zeigt schon Wirkung.“"
                            },
                            {
                                "example_id": "4706d050-642a-4d32-8318-5786a754a615",
                                "sense_id": "19872fc0-d323-375e-aabd-6ed7cb9e7a6a",
                                "text": "„Der Vorwurf, das Deutsche Historische Museum habe eine Ausstellung auf politische Einflussnahme des Kulturministeriums zensiert, schlägt hohe Wellen.“"
                            },
                            {
                                "example_id": "dda32e09-7766-433f-8dae-ec5384549edc",
                                "sense_id": "19872fc0-d323-375e-aabd-6ed7cb9e7a6a",
                                "text": "„Amerikas Spionageabwehr rechnet mit Versuchen ausländischer Einflussnahme auf die Präsidentenwahl in wenigen Monaten.“"
                            },
                            {
                                "example_id": "42dbb8e6-5400-4758-b2f4-4ee6ce4867b2",
                                "sense_id": "19872fc0-d323-375e-aabd-6ed7cb9e7a6a",
                                "text": "„Weil sich aber militärische Gewalt und imperiale Macht mit asymmetrischen Einflussnahmen auf das kulturelle und religiöse Selbst- und Weltverständnis verflechten, sind es vor allem die Pathologien der nachkolonialen Weltlage, denen Mishima nachgeht.“"
                            },
                            {
                                "example_id": "f3178d6a-af27-4857-9c90-dd698c91cd54",
                                "sense_id": "19872fc0-d323-375e-aabd-6ed7cb9e7a6a",
                                "text": "„Es gibt erst wenige Personen in der Schweiz, die Versuche der chinesischen Einflussnahme an Universitäten offenlegen und kritisieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cffae2b5-3850-4653-be13-99a00273cceb",
