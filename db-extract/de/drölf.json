        "de-extract.jsonl": [
            {
                "entry_id": "538403bb-8187-3234-91a4-04436d8ab73e",
                "word": "drölf",
                "pos": "num",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "703f053c-cb16-3f25-b521-163c7c46c796",
                        "entry_id": "538403bb-8187-3234-91a4-04436d8ab73e",
                        "glosses": [
                            "die Zahl 13"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "3d8e8f35-f34e-4bfe-b582-beb83feab36e",
                                "sense_id": "703f053c-cb16-3f25-b521-163c7c46c796",
                                "text": "„Eine meiner Patientinnen zählte in ihrer kindlichen Logik nach der zwölf folgendermaßen weiter: elf, zwölf, drölf. Dann kam sie nicht weiter, denn die Zahl vier für die 14 konnte sie nicht mehr in ihr System einordnen.“"
                            },
                            {
                                "example_id": "e5afbd78-22ad-4dfe-a6b2-5021a0ca2bfd",
                                "sense_id": "703f053c-cb16-3f25-b521-163c7c46c796",
                                "text": "„‚Jawohl‘, sage ich. ‚Eins, zwei, drei – elf, zwölf, drölf! Von jetzt ab sage ich auch drölf.‘“"
                            },
                            {
                                "example_id": "252cbf75-3704-4e2e-8220-c70f0b6e36cd",
                                "sense_id": "703f053c-cb16-3f25-b521-163c7c46c796",
                                "text": "„Was wir dort nicht finden konnten, das war natürlich, daß der Name der Summe von 7 und 5 zwölf heiße; und wenn dreizehn drölf hieße, dann wäre das sonst analytische oder tautologische Urteil: 3 und 10 ist dreizehn, auch ein ‚synthetisches‘ Urteil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8892d516-8b4c-3c29-a1fa-f19f162876ce",
                        "entry_id": "538403bb-8187-3234-91a4-04436d8ab73e",
                        "glosses": [
                            "fiktive ganze Zahl"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "f9525336-3640-4b20-99c5-0808e9a07354",
                                "sense_id": "8892d516-8b4c-3c29-a1fa-f19f162876ce",
                                "text": "„Ich erwähnte ja bereits ein bis drölf mal, dass ich ganz schön knapp bei Kasse bin, obwohl mein Mann und ich arbeiten.“"
                            },
                            {
                                "example_id": "96de4143-4dfe-47fd-9f4d-9ce8d2666d0a",
                                "sense_id": "8892d516-8b4c-3c29-a1fa-f19f162876ce",
                                "text": "„Gut, ich hätte dieses Vorwort auch gleich ‚Kapitel drölf‘ nennen oder hätte es mit irgendwelchen lateinischen Vokabeln überschreiben können, um dieses ‚Vorwort‘ zu übergehen, aber dies hätte wieder unendliche Erklärungen und seitenlange Legitimationen nach sich gezogen, und genau diesen Umstand will ich dem Leser hier und jetzt ersparen!“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68734919-42ae-4056-89e1-bce4560e7c0c",
                        "source_entry_id": "538403bb-8187-3234-91a4-04436d8ab73e",
                        "source_sense_id": "8892d516-8b4c-3c29-a1fa-f19f162876ce",
                        "source_sense_description": "scherzhaft: fiktive ganze Zahl",
                        "target_lang_word": "umpteen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "umpteen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e33f26c-ace4-305c-8180-879a29708f25",
                                        "entry_id": "0b3af68d-70b6-30d0-b663-79fa9e0172e9",
                                        "glosses": [
                                            "Relatively large but unspecified in number."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "079d2ac7-f1e4-4f27-81bd-f698f413e875",
                                                "sense_id": "0e33f26c-ace4-305c-8180-879a29708f25",
                                                "text": "She's taking umpteen friends with her to the party."
                                            },
                                            {
                                                "example_id": "967e4e30-c2ee-4335-987a-89f54cde7cc4",
                                                "sense_id": "0e33f26c-ace4-305c-8180-879a29708f25",
                                                "text": "We still claim a population of over 300,000 based on the new city directory, and that chief of the census who threw out umpteen thousand names on us this spring can’t put his name on our slipboard any more."
                                            },
                                            {
                                                "example_id": "8ac36da1-7772-4fd9-8c2f-62090b342883",
                                                "sense_id": "0e33f26c-ace4-305c-8180-879a29708f25",
                                                "text": "Does it continue to make sense to have umpteen definitions of the practice of law, umpteen UPL prohibitions, umpteen UPL investigation and prosecution procedures, and umpteen UPL sanctions? The current crazy quilt of regulation in this area makes it difficult for anyone to know (including lawyers) what is and is not permitted in a particular jurisdiction."
                                            },
                                            {
                                                "example_id": "a78519e5-0700-4de8-81d5-4bb4e44e54b9",
                                                "sense_id": "0e33f26c-ace4-305c-8180-879a29708f25",
                                                "text": "He tries, \"The few, the proud, the umpteen,\" and Shane says, \"Umpteen? Pray tell me, good sir, who is this umpteen of which you speak?\" and Joseph says, \"Umpteen Dumpteen sat on a wall,\" and they both break up laughing.\n \"It's like a bunch, isn't it? 'Umpteen'?\" This from Sean Lanham, whose small round skull has inspired Coach Dale to name him Peahead."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
