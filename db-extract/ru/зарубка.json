                                                "example_id": "fa2fa0f8-c33e-4266-804f-787483942df2",
                                                "sense_id": "45ffaa7f-0c5f-38c4-a2fc-3a7ce74ea6ac",
                                                "text": "The notches in that tribe's warrior axe handles stand for killed enemies."
                                            }
