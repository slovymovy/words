{
    "word_family": [
        "empower",
        "empowerment",
        "disempowerment",
        "power"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "514b69b9-f0a7-30d1-a650-841b206efa60",
                    "sense_definition": "To remove morale or self-confidence from a person or group, making them feel unable to act or succeed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychological impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A powerful head can sometimes <w>disempower</w> the teaching staff, and create among them a sort of passivity that is close to inertia.",
                            "target_lang_translations": {
                                "ru": "Властный руководитель иногда может <w>лишить уверенности</w> преподавательский состав, создав среди них своего рода пассивность, близкую к инерции."
                            }
                        },
                        {
                            "text": "Constant criticism from a manager can <w>disempower</w> employees and lead to a lack of initiative in the workplace.",
                            "target_lang_translations": {
                                "ru": "Постоянная критика со стороны менеджера может <w>деморализовать</w> сотрудников и привести к отсутствию инициативы на рабочем месте."
                            }
                        }
                    ],
                    "synonyms": [
                        "dishearten",
                        "dispirit",
                        "demoralize",
                        "demotivate",
                        "enervate"
                    ],
                    "antonyms": [
                        "empower",
                        "hearten",
                        "inspire",
                        "motivate"
                    ],
                    "common_phrases": [
                        "disempower the staff",
                        "disempower the individual"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишать человека или группу уверенности в себе или морального духа, заставляя их чувствовать себя неспособными действовать или добиваться успеха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лишать уверенности",
                                "target_lang_sense_clarification": "в своих силах"
                            },
                            {
                                "target_lang_word": "деморализовать",
                                "target_lang_sense_clarification": "подавлять волю к действию"
                            },
                            {
                                "target_lang_word": "обескураживать",
                                "target_lang_sense_clarification": "заставлять опустить руки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f33a1806-bca2-330a-b669-01e3af4fa295",
                    "sense_definition": "To strip a person or organization of their official authority, legal power, or status.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "authority and status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reformation <w>disempowered</w> the established church and thus roiled the aristocracy.",
                            "target_lang_translations": {
                                "ru": "Реформация <w>лишила власти</w> официальную церковь и тем самым привела в смятение аристократию."
                            }
                        },
                        {
                            "text": "New legislation was introduced to <w>disempower</w> local councils and centralize control within the national government.",
                            "target_lang_translations": {
                                "ru": "Было введено новое законодательство, чтобы <w>лишить полномочий</w> местные советы и централизовать управление в руках национального правительства."
                            }
                        }
                    ],
                    "antonyms": [
                        "empower",
                        "establish",
                        "install"
                    ],
                    "common_phrases": [
                        "disempower the church",
                        "disempower the minority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишать человека или организацию официальных полномочий, законной власти или статуса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лишать полномочий",
                                "target_lang_sense_clarification": "официальных прав"
                            },
                            {
                                "target_lang_word": "лишать власти",
                                "target_lang_sense_clarification": "политической или административной"
                            },
                            {
                                "target_lang_word": "ограничивать в правах",
                                "target_lang_sense_clarification": "урезать юридическую силу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}