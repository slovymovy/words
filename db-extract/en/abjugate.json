                ],
                "translations": [
                    {
                        "translation_id": "51bcab85-2e60-4fdd-af78-69607650dbe0",
                        "source_entry_id": "9cc1407a-ef76-3af5-9007-38774783e668",
                        "source_sense_id": "ac5d7cba-6657-3662-a68d-cd04dd60f039",
                        "source_sense_description": "ein Zuggeschirr von einem Zugtier abnehmen",
                        "target_lang_word": "ausspannen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ausspannen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5f33c4d-3b49-3043-ac21-3ab39108fe92",
                                        "entry_id": "5b63bf8d-1c0e-39d7-a922-986bdbd0b6d9",
                                        "glosses": [
                                            "Zugtiere vom gezogenen Fahrzeug trennen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92bacf74-3b31-4637-b931-32f65f6327fc",
                                                "sense_id": "f5f33c4d-3b49-3043-ac21-3ab39108fe92",
                                                "text": "„Der Knecht mußte ein Pferd ausspannen, obwohl er mißmutig in seinen Bart brummte und nur widerwillig dem Befehl seiner Herrin gehorchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "922c08f6-f874-386f-9aa2-76c3ce1e3e7c",
                                        "entry_id": "5b63bf8d-1c0e-39d7-a922-986bdbd0b6d9",
                                        "glosses": [
                                            "sich eine Zeit der Ruhe gönnen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96fae1fa-4c42-46b8-8df3-99f087e359b6",
                                                "sense_id": "922c08f6-f874-386f-9aa2-76c3ce1e3e7c",
                                                "text": "„Eigentlich wollen Sie doch einfach auch mal nur die Seele baumeln lassen, sich erholen und ausspannen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e40787a1-8493-3a1b-bb55-fc7ecb3cef2f",
                                        "entry_id": "5b63bf8d-1c0e-39d7-a922-986bdbd0b6d9",
                                        "glosses": [
                                            "den Partner wegnehmen, abspenstig machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb5ecb18-1b7b-467e-b94d-d8976160e865",
                                                "sense_id": "e40787a1-8493-3a1b-bb55-fc7ecb3cef2f",
                                                "text": "„Welche Frau von den beiden Portraitaufnahmen würde eher den eigenen Partner ausspannen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7072b35b-6bb5-325d-b952-c406e9675f58",
                                        "entry_id": "5b63bf8d-1c0e-39d7-a922-986bdbd0b6d9",
                                        "glosses": [
                                            "Extremitäten ausstrecken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "884244c4-1951-409f-8c54-1ff5537a3507",
                                                "sense_id": "7072b35b-6bb5-325d-b952-c406e9675f58",
                                                "text": "Indem er, z. B. die Finger der rechten Hand ausspannt, um die Diskanttöne anzuschlagen, welche dazu gehören, so fällt die linke Hand von selbst auf die damit übereinstimmenden Töne des Basses hin."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
