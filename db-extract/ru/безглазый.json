                                        "examples": [
                                            {
                                                "example_id": "7b06c6b6-9462-4bad-a45a-141f32e118b9",
                                                "sense_id": "913e8ac0-a586-3587-af2b-f0ee49b0da23",
                                                "text": "Huge eyeless crabs roam the ocean floor around hydrothermal vents."
                                            },
                                            {
                                                "example_id": "775e8cfa-d544-4abb-a9d8-bbbeaefd0392",
                                                "sense_id": "913e8ac0-a586-3587-af2b-f0ee49b0da23",
                                                "text": "I held out my hand, and the horrible, soft-spoken, eyeless creature gripped it in a moment like a vise. I was so much startled that I struggled to withdraw; but the blind man pulled me close up to him with a single action of his arm."
                                            }
                                        ]
