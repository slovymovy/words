                                    {
                                        "sense_id": "2185dbb5-f738-3914-be1d-c4094a81ca40",
                                        "entry_id": "f57ffc54-e0c9-31b7-8f27-92f12832121a",
                                        "glosses": [
                                            "Utter; thorough; eminent."
                                        ],
                                        "tags": [
