        "ru-extract.jsonl": [
            {
                "entry_id": "f0ab816a-5fab-35f6-86f7-d5be3213cd9a",
                "word": "Пим",
                "pos": "noun",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "91e56b23-9360-3d10-a7bc-cecdc1f0ed8a",
                        "entry_id": "f0ab816a-5fab-35f6-86f7-d5be3213cd9a",
                        "glosses": [
                            "река в России"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a61e1a64-981a-4843-a443-f98bb3dd1d08",
                                "sense_id": "91e56b23-9360-3d10-a7bc-cecdc1f0ed8a",
                                "text": "Пим — одна из многочисленных рек, протекающих по территории России."
                            }
                        ]
                    },
                    {
                        "sense_id": "5efdae25-2d3f-3888-966e-bde82da8be0d",
                        "entry_id": "f0ab816a-5fab-35f6-86f7-d5be3213cd9a",
                        "glosses": [
                            "мужское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0403665a-c619-4613-8392-bd64aad3a1bf",
                                "sense_id": "5efdae25-2d3f-3888-966e-bde82da8be0d",
                                "text": "Но вскоре позвонил Пим, уже лет двадцать ― все молодой и все многообещающий ― художник-абстракционист, достигший главных успехов как виртуоз-прилипала."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c41b7f3-ec0c-36c2-8ed8-01f86803a86c",
                        "entry_id": "f0ab816a-5fab-35f6-86f7-d5be3213cd9a",
                        "glosses": [
                            "фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5e081c8-815f-4d5d-92bc-bfb799d98bc8",
                                "sense_id": "2c41b7f3-ec0c-36c2-8ed8-01f86803a86c",
                                "text": "Переписываю большую часть страницы: Пим, Роланд. Родился в Лунди, Массачусетс, 1922."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
