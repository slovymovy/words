                        "exprimer sa gratitude"
                    ]
                },
                {
                    "sense_id": "249b1d26-552d-3879-9959-a6755e56e86f",
                    "sense_definition": "Formuler sa pensée par la parole ou par écrit, se faire comprendre.",
