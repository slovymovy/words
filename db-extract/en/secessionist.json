                                                "example_id": "495e6f9a-5f44-4e87-9569-d102c6dba255",
                                                "sense_id": "b40d6f59-8b0b-36fd-993a-21fe1b0bfab6",
                                                "text": "La Chine prendra les \"mesures nécessaires\" si les sécessionnistes de Taïwan se risquent à l'indépendance."
                                            }
                                        ]
                                    }
                                ]
                            }
