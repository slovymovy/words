                "senses": [
                    {
                        "sense_id": "7bc96b45-3b47-3245-9eb6-5af3b32b7053",
                        "entry_id": "648cc3fb-567d-3f6e-b8af-a309f93279b2",
                        "glosses": [
                            "hintere Extremität eines (männlichen) Huhnes zum menschlichen Verzehr (auch in genussfertigem Zustand)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d256e911-fee3-406f-bce3-ab698677289e",
                                "sense_id": "7bc96b45-3b47-3245-9eb6-5af3b32b7053",
                                "text": "„Wenn Sie mir das nächste Mal vierhaxerte Hendel liefern, verspreche ich Ihnen, daß ein jeder hier im Saal sein Bügerl kriegt.“"
                            },
                            {
                                "example_id": "76a4206f-bc3d-4049-9ae1-53bafcf57382",
                                "sense_id": "7bc96b45-3b47-3245-9eb6-5af3b32b7053",
                                "text": "„Die Bügerln schmeckten nicht schlecht, wenn auch etwas anders als die üblichen Bügerln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
