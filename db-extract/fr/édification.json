                                    {
                                        "sense_id": "3d09942a-a943-38e8-ba52-0dcc3b5a808e",
                                        "entry_id": "dbd3a4df-9400-3e46-b451-8e5b4e1841ee",
                                        "glosses": [
                                            "The act of edifying, or the state of being edified or improved; a building process, especially morally, emotionally, or spiritually."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee20ed16-f105-495f-b0c0-d08e18481c9c",
                                                "sense_id": "3d09942a-a943-38e8-ba52-0dcc3b5a808e",
                                                "text": "Let euery one of vs please his neighbour for his good to edification."
                                            },
                                            {
                                                "example_id": "6d84801a-a709-4e8e-b7a2-7acef5556a47",
                                                "sense_id": "3d09942a-a943-38e8-ba52-0dcc3b5a808e",
                                                "text": "Caterina Pachetti had been a very pretty women, which she remembered more to her own edification than to that of her friends."
                                            },
                                            {
                                                "example_id": "8ef13547-9f48-4c47-aa1a-c8a42d4d3b9b",
                                                "sense_id": "3d09942a-a943-38e8-ba52-0dcc3b5a808e",
                                                "text": "It seems clear that he took great delight in his commonly perceived role as “the No 1 celebrity scientist”; huge audiences would attend his public lectures, perhaps not always just for scientific edification."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa84c864-3402-36b3-9c18-81b7a9c6940b",
                                        "entry_id": "dbd3a4df-9400-3e46-b451-8e5b4e1841ee",
                                        "glosses": [
                                            "A building or edifice."
