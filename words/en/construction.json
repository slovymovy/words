{
    "word_family": [
        "construct",
        "constructive",
        "constructor",
        "reconstruct",
        "deconstruct",
        "misconstruction"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "73c29d22-eb58-35fa-b88a-01db4709233b",
                    "sense_definition": "The industry or trade of building houses, roads, and other structures.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "building_industry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has worked in <w>construction</w> all his life, starting as a simple laborer.",
                            "target_lang_translations": {
                                "ru": "Он всю жизнь проработал в <w>строительстве</w>, начав простым разнорабочим."
                            }
                        },
                        {
                            "text": "The local <w>construction</w> industry is booming because many people are moving to the city.",
                            "target_lang_translations": {
                                "ru": "Местная <w>строительная</w> отрасль процветает, потому что многие люди переезжают в город."
                            }
                        }
                    ],
                    "common_phrases": [
                        "construction industry",
                        "construction worker",
                        "work in construction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отрасль промышленности или сфера деятельности, связанная с возведением домов, дорог и других сооружений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "строительство",
                                "target_lang_sense_clarification": "отрасль экономики"
                            },
                            {
                                "target_lang_word": "стройиндустрия",
                                "target_lang_sense_clarification": "строительная промышленность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1ca1a98-8bc1-3692-b010-5507a7c57b30",
                    "sense_definition": "The process or act of building or putting something together.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "building_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>construction</w> of the new bridge will take at least three years to complete.",
                            "target_lang_translations": {
                                "ru": "<w>Строительство</w> нового моста займет не менее трех лет."
                            }
                        },
                        {
                            "text": "Road <w>construction</w> is underway on the main highway, so expect some traffic delays.",
                            "target_lang_translations": {
                                "ru": "На главном шоссе ведутся дорожные <w>работы</w>, поэтому ожидайте задержек в движении."
                            }
                        }
                    ],
                    "synonyms": [
                        "building"
                    ],
                    "antonyms": [
                        "destruction"
                    ],
                    "common_phrases": [
                        "under construction",
                        "road construction",
                        "construction site"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или действие по возведению или сборке чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "строительство",
                                "target_lang_sense_clarification": "процесс возведения"
                            },
                            {
                                "target_lang_word": "сооружение",
                                "target_lang_sense_clarification": "действие по созданию объекта"
                            },
                            {
                                "target_lang_word": "построение",
                                "target_lang_sense_clarification": "процесс организации или создания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7bab559-84f5-3b42-ad63-ef0cd6da36b6",
                    "sense_definition": "A physical structure, such as a building or a model, that has been built.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The office was a modern <w>construction</w> of steel and glass located in the city center.",
                            "target_lang_translations": {
                                "ru": "Офис представлял собой современное <w>сооружение</w> из стали и стекла, расположенное в центре города."
                            }
                        },
                        {
                            "text": "The engineer marvelled at his <w>construction</w> after the final beam was placed.",
                            "target_lang_translations": {
                                "ru": "Инженер восхищался своей <w>конструкцией</w> после того, как была установлена последняя балка."
                            }
                        }
                    ],
                    "synonyms": [
                        "building"
                    ],
                    "common_phrases": [
                        "steel construction",
                        "massive construction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физический объект, такой как здание или модель, который был построен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сооружение",
                                "target_lang_sense_clarification": "построенный объект"
                            },
                            {
                                "target_lang_word": "конструкция",
                                "target_lang_sense_clarification": "сложный технический объект"
                            },
                            {
                                "target_lang_word": "строение",
                                "target_lang_sense_clarification": "здание или постройка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33463c40-bf5e-3acf-aee6-a25b5599efce",
                    "sense_definition": "The specific way or manner in which something is built or put together.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "building_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The device is of simple <w>construction</w>, making it very easy to repair at home.",
                            "target_lang_translations": {
                                "ru": "Устройство имеет простую <w>конструкцию</w>, что позволяет легко ремонтировать его дома."
                            }
                        },
                        {
                            "text": "The sturdy <w>construction</w> of the old house helped it survive the heavy storm.",
                            "target_lang_translations": {
                                "ru": "Прочная <w>постройка</w> старого дома помогла ему пережить сильный шторм."
                            }
                        }
                    ],
                    "common_phrases": [
                        "simple construction",
                        "sturdy construction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный способ или манера, в которой что-либо построено или собрано."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конструкция",
                                "target_lang_sense_clarification": "устройство, способ сборки"
                            },
                            {
                                "target_lang_word": "строение",
                                "target_lang_sense_clarification": "структура, внутреннее устройство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05e0e99a-6668-3eb7-992d-9bcf63a6e2e4",
                    "sense_definition": "The arrangement of words to form a meaningful phrase or sentence in a language.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher explained that this particular grammatical <w>construction</w> is rarely used in spoken English.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил, что эта конкретная грамматическая <w>конструкция</w> редко используется в разговорном английском."
                            }
                        },
                        {
                            "text": "Using a passive <w>construction</w> can sometimes make your writing sound more formal.",
                            "target_lang_translations": {
                                "ru": "Использование пассивного <w>оборота</w> иногда может придать вашему письму более официальный тон."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grammatical construction",
                        "passive construction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположение слов для формирования осмысленной фразы или предложения в языке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конструкция",
                                "target_lang_sense_clarification": "грамматическая структура"
                            },
                            {
                                "target_lang_word": "оборот",
                                "target_lang_sense_clarification": "речевое выражение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "951075a9-c493-3d2c-abc6-0ae5599e64c9",
                    "sense_definition": "The way in which a statement, action, or event is interpreted or understood.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interpretation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was careful with his words so that no one could put a false <w>construction</w> on his motives.",
                            "target_lang_translations": {
                                "ru": "Он был осторожен в словах, чтобы никто не мог дать ложное <w>толкование</w> его мотивам."
                            }
                        },
                        {
                            "text": "The lawyer argued that the court should put a liberal <w>construction</w> on the existing law.",
                            "target_lang_translations": {
                                "ru": "Адвокат утверждал, что суд должен дать расширительную <w>трактовку</w> существующему закону."
                            }
                        }
                    ],
                    "synonyms": [
                        "construal"
                    ],
                    "common_phrases": [
                        "put a construction on",
                        "strict construction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ, которым понимается или интерпретируется утверждение, действие или событие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толкование",
                                "target_lang_sense_clarification": "интерпретация смысла"
                            },
                            {
                                "target_lang_word": "интерпретация",
                                "target_lang_sense_clarification": "понимание значения"
                            },
                            {
                                "target_lang_word": "трактовка",
                                "target_lang_sense_clarification": "вариант объяснения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}