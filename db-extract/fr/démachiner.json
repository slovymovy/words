                "senses": [
                    {
                        "sense_id": "ea021e48-28b2-3977-979e-3cf383873f6c",
                        "entry_id": "2eb143d6-96fd-397a-8dad-89f1ae4610a2",
                        "glosses": [
                            "Faire perdre sa qualité de machine à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b729f06f-a032-4621-86e2-775c0af3e3e6",
                                "sense_id": "ea021e48-28b2-3977-979e-3cf383873f6c",
                                "text": "Il fallait la « démachiner » tout en respectant la machine, donner une impression non d’improvisation, mais de liberté."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c871bd8-07e8-3adf-8299-d5e7a59a394e",
                        "entry_id": "2eb143d6-96fd-397a-8dad-89f1ae4610a2",
                        "glosses": [
                            "Verbe pantonymique utilisé pour désigner une action inverse ou négative qu’on ne veut pas ou qu’on ne sait pas nommer plus précisément, ou quand le contexte permet de préciser le sens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03560d5e-27c9-4bfb-a5e0-30a2a87ff320",
                                "sense_id": "2c871bd8-07e8-3adf-8299-d5e7a59a394e",
                                "text": "Mais non il faut des poutres de fer, disait le gardien, six cents quintaux c’est lourd à soulever et puis elle est très fragile embaumée comme ça on ne peut pas la démachiner comme on veut."
                            },
                            {
                                "example_id": "0453ce64-2c89-4710-b92c-bccf29bcd725",
                                "sense_id": "2c871bd8-07e8-3adf-8299-d5e7a59a394e",
                                "text": "Tu as le bouton de ton gilet qui se démachine."
                            }
                        ]
                    }
