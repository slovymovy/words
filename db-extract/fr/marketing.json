            {
                "entry_id": "9227291d-c66d-3d72-9fe9-2e5f81859b3d",
                "word": "marketing",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "76be15df-44c5-4f7c-a361-b35835c04a02",
                        "entry_id": "9227291d-c66d-3d72-9fe9-2e5f81859b3d",
