                    }
                ],
                "senses": [
                    {
                        "sense_id": "da47a4d5-33a8-35b5-8388-d98af5d940d8",
                        "entry_id": "db436b86-280e-3798-a553-8d4e4cb85937",
                        "glosses": [
                            "дыханием вытолкнуть из лёгких, изо рта (воздух)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9e3974c-7e6f-4dbc-ad10-df83bf1ed118",
                                "sense_id": "da47a4d5-33a8-35b5-8388-d98af5d940d8",
                                "text": "Затем я выдохнул холодный утренний воздух и принялся выполнять комплекс упражнений утренней гимнастики."
                            },
                            {
                                "example_id": "84bb0961-b35e-4cf4-8888-5a5c538aa302",
                                "sense_id": "da47a4d5-33a8-35b5-8388-d98af5d940d8",
                                "text": "Мне часто виделось, как он глотнул воздуха, а выдохнуть не может 〈…〉 он чего-то испугался сильно ― ни выдохнуть, ни заплакать."
                            }
                        ]
                    },
                    {
                        "sense_id": "93ff1b09-dd54-3ea0-aec9-25039d02b1eb",
                        "entry_id": "db436b86-280e-3798-a553-8d4e4cb85937",
                        "glosses": [
                            "быстро, не переводя дыхания, произнести, проговорить что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acce3472-0c87-4c77-966d-ccf0d44accb9",
                                "sense_id": "93ff1b09-dd54-3ea0-aec9-25039d02b1eb",
                                "text": "Старуха ревниво прислушивалась, потом подняла глаза в потолочный угол, выдохнула скорбный полушепот: ― Ох, светы мои батюшки!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3532bddb-2139-4a13-9a31-75844e7b5b1b",
                        "source_entry_id": "db436b86-280e-3798-a553-8d4e4cb85937",
                        "target_lang_word": "breathe out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
