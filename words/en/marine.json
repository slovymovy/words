                        "zh": [
                            {
                                "target_lang_word": "海军陆战队员",
                                "target_lang_sense_clarification": "该兵种的士兵"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7747c0f-c2e3-375f-92e8-562ffea5bf2f",
                    "sense_definition": "a painting or photograph depicting a scene at sea",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gallery is hosting an exhibition dedicated to 19th-century Dutch <w>marines</w>.",
                            "target_lang_translations": {
                                "ru": "В галерее проходит выставка, посвященная голландским <w>маринам</w> XIX века.",
                                "zh": "画廊正在举办一场专门展示19世纪荷兰<w>海景画</w>的展览。"
                            }
                        },
                        {
                            "text": "He preferred painting a <w>marine</w> over a landscape because he loved the movement of waves.",
                            "target_lang_translations": {
                                "ru": "Он предпочитал писать <w>морские пейзажи</w>, а не ландшафты, потому что любил движение волн.",
                                "zh": "他更喜欢画<w>海景</w>而不是风景，因为他热爱波浪的律动。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in art history"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "картина или фотография, изображающая морской пейзаж",
                        "zh": "描绘海上场景的绘画或摄影作品"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "марина",
                                "target_lang_sense_clarification": "жанр живописи или отдельное произведение"
                            },
                            {
                                "target_lang_word": "морской пейзаж",
                                "target_lang_sense_clarification": "описание сюжета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "海景画",
                                "target_lang_sense_clarification": "艺术作品类型"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc0ecd42-e026-392c-b691-bd2785a3bdf2",
                    "sense_definition": "to adapt or modify equipment for use in a saltwater or sea environment",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical-adaptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic had to <w>marine</w> the truck engine before installing it in the boat.",
                            "target_lang_translations": {
                                "ru": "Механику пришлось <w>адаптировать для моря</w> двигатель грузовика перед его установкой на лодку.",
                                "zh": "机械师在将卡车发动机安装到船上之前，必须对其<w>进行船用改装</w>。"
                            }
                        },
                        {
                            "text": "They are currently <w>marining</w> the electrical components to prevent corrosion from the salt air.",
                            "target_lang_translations": {
                                "ru": "В настоящее время они проводят <w>маринизацию</w> электрических компонентов для предотвращения коррозии от соленого воздуха.",
                                "zh": "他们目前正在对电气元件<w>进行船用改装</w>，以防止盐雾腐蚀。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage in engineering"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "адаптировать или модифицировать оборудование для использования в соленой воде или морской среде",
                        "zh": "为在盐水或海洋环境中使用而改装或调整设备"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маринизировать",
                                "target_lang_sense_clarification": "технический термин для адаптации к морю"
                            },
                            {
                                "target_lang_word": "адаптировать для моря",
                                "target_lang_sense_clarification": "общее описание процесса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进行船用改装",
                                "target_lang_sense_clarification": "技术性调整"
                            }
                        ]
                    }
                }
            ]
        }
    ]
