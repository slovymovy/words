                    "sense_id": "251c2430-0030-3ccc-a82f-a1f9592e7d9e",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>smikkelen</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "smikkelen_vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>smikkel</w> altijd met veel plezier van de verse taart van mijn oma.",
