                                    },
                                    {
                                        "sense_id": "6df4cb74-29d6-3bae-99be-a6ad6182735d",
                                        "entry_id": "0fedc95d-3556-30c9-83dd-6e21692c7e3d",
                                        "glosses": [
                                            "A foolish woman."
                                        ],
                                        "tags": [
                                            "UK",
                                            "derogatory",
                                            "mildly",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50be0987-a4c6-4c98-a270-0a4e53c88e5c",
                                                "sense_id": "6df4cb74-29d6-3bae-99be-a6ad6182735d",
                                                "text": "You silly moo! What did you do that for?"
                                            },
                                            {
                                                "example_id": "ac7050b3-3a77-484a-9bac-a0338afdd0b1",
                                                "sense_id": "6df4cb74-29d6-3bae-99be-a6ad6182735d",
                                                "text": "'Aurora House does not expel,' said the sanctimonious moo, 'but you will be medicated, if your behaviour warrants it, for your own protection.'"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "moo",
                                "target_lang_code": "en",
                                "target_senses": [
