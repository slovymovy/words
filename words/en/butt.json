                {
                    "sense_id": "14a09d10-3b80-3623-9f53-cdf8d0a3e710",
                    "sense_definition": "The upper part of a pork shoulder used as a cut of meat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are going to slow-cook a pork <w>butt</w> for the barbecue party.",
                            "target_lang_translations": {
                                "ru": "Мы собираемся медленно запечь свиную <w>лопатку</w> для барбекю-вечеринки.",
                                "es": "Vamos a cocinar a fuego lento una <w>aguja</w> de cerdo para la barbacoa.",
                                "zh": "我们打算为烧烤派对慢炖一块<w>猪肩肉</w>。"
                            }
                        },
                        {
                            "text": "The recipe calls for a boneless <w>butt</w> to make the pulled pork.",
                            "target_lang_translations": {
                                "ru": "В рецепте требуется <w>лопатка</w> без кости для приготовления рваной свинины.",
                                "es": "La receta requiere una <w>paleta</w> deshuesada para hacer el cerdo desmenuzado.",
                                "zh": "做手撕猪肉的食谱需要一块去骨的<w>猪肩肉</w>。"
                            }
