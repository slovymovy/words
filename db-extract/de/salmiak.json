                "senses": [
                    {
                        "sense_id": "a72bf750-bccb-3177-b3f0-9cad56b42a60",
                        "entry_id": "93c046a8-d0d8-368d-8cc3-df5bad07cc74",
                        "glosses": [
                            "Ammoniumsalz der Salzsäure"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad3c048a-d654-42d9-8067-2d47aedee966",
                                "sense_id": "a72bf750-bccb-3177-b3f0-9cad56b42a60",
                                "text": "Salmiak ist in höheren Dosen gesundheitsschädlich."
                            },
                            {
                                "example_id": "cdda67ce-bcb9-4f00-8eb8-d808a27e63b6",
                                "sense_id": "a72bf750-bccb-3177-b3f0-9cad56b42a60",
                                "text": "„Salmiak oder Ammoniumchlorid (NH₄Cl), wie die korrekte chemische Bezeichnung lautet, ist ein unverzichtbarer typischer Bestandteil von Lakritzwaren, insbesondere von Produkten, die bevorzugt von Erwachsenen geschätzt und verzehrt werden.“"
                            },
                            {
                                "example_id": "f99b5d83-381d-42d7-914d-97cf9f5ac10b",
                                "sense_id": "a72bf750-bccb-3177-b3f0-9cad56b42a60",
                                "text": "„Der Gestank von Salmiak, der früher auf dem Gang gelegen hat, ist verschwunden, dafür riecht es […] ziviler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
