                                        "sense_id": "314a1713-936f-3ea8-a5f8-7fb2ac240bda",
                                        "entry_id": "300c46e7-1e26-3d11-9b6c-deeb4a127ac2",
                                        "glosses": [
                                            "Sorte de menottes qui entravent les pouces. → voir poucettes"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02edc1b4-ab51-4885-8e46-eea043acbb59",
                                                "sense_id": "314a1713-936f-3ea8-a5f8-7fb2ac240bda",
                                                "text": "J’en ai si bien le droit, que je mets les poucettes à ceux qui ne me répondent pas, et que je les fais mener à la prison de la ville."
                                            },
                                            {
                                                "example_id": "73272759-7146-4fe6-998b-4517b7b163e5",
                                                "sense_id": "314a1713-936f-3ea8-a5f8-7fb2ac240bda",
                                                "text": "Il songeait, d’autre part, […] à se débarrasser de ses deux encombrants gardes du corps qui le tenaient chacun par un bras après lui avoir mis les poucettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51fa1be6-eebc-325a-a83e-28301f00f061",
                                        "entry_id": "300c46e7-1e26-3d11-9b6c-deeb4a127ac2",
                                        "glosses": [
                                            "Appareil de torture destiné à écraser les pouces. → voir poucettes"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
