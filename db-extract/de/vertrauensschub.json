                "senses": [
                    {
                        "sense_id": "c1b2f391-ba94-315c-be18-b2d428364966",
                        "entry_id": "0ee2130d-5ec0-343c-92ca-e701b1ed3660",
                        "glosses": [
                            "(durch einen Impuls ausgelöster) Anstieg des Vertrauens (beziehungsweise des Selbstvertrauens) oder dieser Impuls"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fe7ff11-e9e4-45de-9595-9c3938533629",
                                "sense_id": "c1b2f391-ba94-315c-be18-b2d428364966",
                                "text": "„Erlebe das Fotoshooting als einen Vertrauensschub für Dich selbst.“"
                            },
                            {
                                "example_id": "4a8fa217-a718-4b77-b19f-b4e2e2c9e277",
                                "sense_id": "c1b2f391-ba94-315c-be18-b2d428364966",
                                "text": "„Der Bericht zeigt ein insgesamt robustes Wachstum der Nutzeranlagen, was ein potenzieller Vertrauensschub für Investoren und Nutzer sein könnte.“"
                            },
                            {
                                "example_id": "d4b4c9b0-4a68-4479-936d-85c4e3daf683",
                                "sense_id": "c1b2f391-ba94-315c-be18-b2d428364966",
                                "text": "„Die Regulierung des Marktes durch das MiCA-Gesetz wird mit großer Wahrscheinlichkeit einen Vertrauensschub mit sich bringen und viele institutionelle Anleger können Kryptowährungen dann stärker in ihre Aktivitäten einbinden.“"
                            },
                            {
                                "example_id": "6410072d-6c28-4702-8d8c-b2980ee013b9",
                                "sense_id": "c1b2f391-ba94-315c-be18-b2d428364966",
                                "text": "„Nähen ist ein enormer Vertrauensschub, denn es braucht Planung, Vorbereitung, Konzentration, Geduld und Ausdauer, um ein Projekt zu beginnen und bis zur Fertigstellung zu begleiten.“"
                            },
                            {
                                "example_id": "9c1f0647-67ad-4cfa-94ab-1541472ddafa",
                                "sense_id": "c1b2f391-ba94-315c-be18-b2d428364966",
                                "text": "„Dieses Produkt hat mir definitiv einen enormen Vertrauensschub in meinem täglichen Leben gegeben und ich bin wirklich dankbar dafür.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
