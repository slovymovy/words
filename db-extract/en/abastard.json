                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d94841b9-217b-4b31-bff4-6d3fddadddca",
                                                "sense_id": "64a8af1c-e669-3bdf-b15c-55434862762e",
                                                "text": "Lautes Geschrei in einem sakralen Gebäude entwürdigt einen heiligen Ort."
                                            },
                                            {
                                                "example_id": "05b12af1-af84-48d2-8a8b-c80fd3199620",
                                                "sense_id": "64a8af1c-e669-3bdf-b15c-55434862762e",
                                                "text": "Ein Gesetz, das Quoten bei der Stellenbesetzung festlegt, entwürdigt das Individuum."
                                            },
                                            {
                                                "example_id": "2eaede08-36f7-465d-b2a2-5e04b5cb8075",
                                                "sense_id": "64a8af1c-e669-3bdf-b15c-55434862762e",
                                                "text": "Es war eine entwürdigende Prozedur, als sie sich vor dem Personal ausziehen und untersuchen lassen musste."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
