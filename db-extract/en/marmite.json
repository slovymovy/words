    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ca16afa7-f5b2-3365-bf3d-0841268652b1",
                "word": "Marmite",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "aa049560-0a6c-406c-8d34-56ac878212bf",
                        "entry_id": "ca16afa7-f5b2-3365-bf3d-0841268652b1",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more Marmite"
                    },
                    {
                        "form_id": "ddcda6ba-1e8a-45d8-a664-b5581c0f875a",
                        "entry_id": "ca16afa7-f5b2-3365-bf3d-0841268652b1",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most Marmite"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bfa78a1e-35f1-38b7-9b4a-a36ae1266d5c",
                        "entry_id": "ca16afa7-f5b2-3365-bf3d-0841268652b1",
                        "glosses": [
                            "Divisive, such that one either loves or hates it; polarizing."
                        ],
                        "tags": [
                            "UK",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "63aec50a-d13b-4aee-af9b-b8f3b37c906b",
                                "sense_id": "bfa78a1e-35f1-38b7-9b4a-a36ae1266d5c",
                                "text": "But that 10% gap between fans and detractors leaves room for an interesting concept: is there something more Marmite than Marmite?"
                            },
                            {
                                "example_id": "fa4993ee-3498-4bc1-b4cf-fe4ccee2157d",
                                "sense_id": "bfa78a1e-35f1-38b7-9b4a-a36ae1266d5c",
                                "text": "'Hangry', fittingly, is very Marmite. For some it is newfangled and unpalatable, but for others it is an essential description of everyday life."
                            },
                            {
                                "example_id": "abb43103-68e7-4590-b8dd-79622701e069",
                                "sense_id": "bfa78a1e-35f1-38b7-9b4a-a36ae1266d5c",
                                "text": "London is perhaps the ultimate Marmite city. One second you're head over heels in love with it; the next you're searching 'Manchester' on Rightmove. But what are the most Marmite things IN London? These six things, we reckon."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "671d51cb-779f-3b86-b4da-0f3074675430",
                "word": "marmite",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9a18d2b5-7b51-3485-b315-cba2dde4b6f0",
                        "entry_id": "671d51cb-779f-3b86-b4da-0f3074675430",
                        "glosses": [
                            "Alternative letter-case form of Marmite."
                        ],
                        "tags": [
                            "alt-of",
                            "proscribed"
                        ],
                        "examples": [
                            {
                                "example_id": "d2e74a85-8ab3-43e8-9561-5dc14744556e",
                                "sense_id": "9a18d2b5-7b51-3485-b315-cba2dde4b6f0",
                                "text": "Required: […] One tablespoonful of nutril or one small teaspoonful of marmite."
                            },
                            {
                                "example_id": "f99311ad-ad29-4b86-a7a4-1bddc6a5b1e0",
                                "sense_id": "9a18d2b5-7b51-3485-b315-cba2dde4b6f0",
                                "text": "Stir a spoonful of marmite into some brown gravy, and pour over the potatoes, etc."
                            },
                            {
                                "example_id": "342fe406-1e20-4f96-8715-f26b85ffec9f",
                                "sense_id": "9a18d2b5-7b51-3485-b315-cba2dde4b6f0",
                                "text": "A teaspoonful of marmite, a dessertspoonful of a good brand of cod-liver oil, and two glasses of water between meals, would make the diet complete."
                            },
                            {
                                "example_id": "e8005a4a-2af2-43a4-95ca-10c22d5f80f6",
                                "sense_id": "9a18d2b5-7b51-3485-b315-cba2dde4b6f0",
                                "text": "A spoonful of marmite added to soups and gravies after they are cooked improves their flavour."
                            },
                            {
                                "example_id": "0004cb41-f431-4340-bfdb-8419c3659461",
                                "sense_id": "9a18d2b5-7b51-3485-b315-cba2dde4b6f0",
                                "text": "The treatment of this particular form of anæmia lies in giving vitamin B, a suitable preparation being a teaspoonful of marmite three times a day, together with desiccated gastric mucosa."
                            },
                            {
                                "example_id": "83464895-888e-4476-84f5-8b63435b07b4",
                                "sense_id": "9a18d2b5-7b51-3485-b315-cba2dde4b6f0",
                                "text": "I crawled up and retrieved it and, wiping it clean on some leaves, looked at the label. “Marmite,” it read. / “You have beriberi,” he shouted. / “I know,” I replied from the mud. / “Take a spoonful of that a day,” he advised. / “Will it do any good?” / “Might,” he replied, and, returning firmly inside the palisade of the headquarters camp, indicated that the subject was closed. I crawled back to our camp, where I found the guards very cross that I had eluded them. I took a spoonful of marmite and, exhausted, fell asleep."
                            },
                            {
                                "example_id": "c4578878-0a12-463a-8b68-70f0118ca828",
                                "sense_id": "9a18d2b5-7b51-3485-b315-cba2dde4b6f0",
                                "text": "Only a strong man can cut through the rind, but the inside, firm and juicy, we slice with onion, potato, carrot, parsnip – whatever there is – simmer till tender, then put through the liquidizer, bring to the consistency of cream with stock or milk, add nutmeg or mace as well as pepper and salt; if no stock, I add a spoonful of marmite, and always top of milk or a little cream."
                            },
                            {
                                "example_id": "97d94126-f27f-4fe6-8248-34bd996063ed",
                                "sense_id": "9a18d2b5-7b51-3485-b315-cba2dde4b6f0",
                                "text": "Finely grated cheddar cheese used 50/50 with bread paste, plus a spoonful of marmite, makes a fabulous tangy bait; it can be fozen^([sic]) and used at any time. Alternatively, try sausage-meat, again used 50/50 with bread paste, with additives like marmite, bovril or a crushed oxo cube kneaded in."
                            },
                            {
                                "example_id": "82b4f34b-93cf-425a-b855-c1832678ee98",
                                "sense_id": "9a18d2b5-7b51-3485-b315-cba2dde4b6f0",
                                "text": "1 pint stock - made by adding a generous spoon of marmite to boiling water"
                            },
                            {
                                "example_id": "65a1a654-9ace-4a12-9d40-ce5acddc6028",
                                "sense_id": "9a18d2b5-7b51-3485-b315-cba2dde4b6f0",
                                "text": "The night is a spoonful of marmite being spread over the planets."
                            },
                            {
                                "example_id": "245e43df-9b91-4d00-8c3d-607898ec1626",
                                "sense_id": "9a18d2b5-7b51-3485-b315-cba2dde4b6f0",
                                "text": "More informally: vegemite and marmite share some property."
                            }
                        ]
                    }
                ],
