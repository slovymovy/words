                        "examples": [
                            {
                                "example_id": "b71e077c-7e5b-4585-95d9-b3cfda74bd40",
                                "sense_id": "f36c5e76-8b56-367b-aaa2-801530ab3fb2",
                                "text": "Chemiereus Bayer en ook overheden weten de zorgen bij mensen maar niet weg te nemen. Het is dan ook de vraag wat er met Roundup gaat gebeuren."
                            },
                            {
                                "example_id": "47128ad3-2a53-4122-9257-a427a20c0a5f",
                                "sense_id": "f36c5e76-8b56-367b-aaa2-801530ab3fb2",
                                "text": "Vanmiddag vergaderen de aandeelhouders van chemiereus AkzoNobel. Ze bespreken ongetwijfeld het overnamebod van het Amerikaanse bedrijf PPG. Dat bedrijf verhoogde gisteren het bod met 2 miljard naar bijna 27 miljard euro. Analisten beschouwen dat als onweerstaanbaar. Als de aandeelhouders ingaan op het bod, dan komt het Nederlandse bedrijf in Amerikaanse handen."
                            }
                        ]
