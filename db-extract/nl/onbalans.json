                ],
                "senses": [
                    {
                        "sense_id": "f89c56d9-a4b8-330b-a964-151b4df3cc0a",
                        "entry_id": "4d7e2d44-3c62-3e5d-bc1a-4c161142834a",
                        "glosses": [
                            "uit het evenwicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5720723-836f-493b-bc48-96f00814799a",
                                "sense_id": "f89c56d9-a4b8-330b-a964-151b4df3cc0a",
                                "text": ",,In sommige regio’s liggen vraag en aanbod op de arbeidsmarkt verder uit elkaar. Die onbalans uit zich in het tragere herstel van de arbeidsdeelname onder lager en middelbaar opgeleiden. Het legt daarmee een zwakte van de arbeidsmarkt bloot”, besluit Geijer."
                            },
                            {
                                "example_id": "cd218f32-d9ff-4285-953d-af35fbb8815c",
                                "sense_id": "f89c56d9-a4b8-330b-a964-151b4df3cc0a",
                                "text": "In ‘The Garden of Earthly Worries’ presenteert Libeskind vier abstracte beelden die de elementen ozon, distikstofmonoxide (lachgas), methaan en koolstofdioxide symboliseren. Volgens de kunstenaar zijn deze gassen schadelijke bijproducten van menselijk handelen. Ze dragen bij aan de onbalans in de natuur, leidend tot onomkeerbare klimaatveranderingen met desastreuze gevolgen voor mens en natuur."
                            },
                            {
                                "example_id": "0426ce4b-cf73-4166-8232-8381f546bca9",
                                "sense_id": "f89c56d9-a4b8-330b-a964-151b4df3cc0a",
                                "text": "Het slachtoffer was vanuit een hoogwerker bezig met het onderhoud van bomen op Het Stift. Op een gegeven moment wilde de groenmedewerker zich met de hoogwerker verplaatsen. Tijdens het rijden is de hoogwerker met een voorwiel in een gat van een oude put terechtgekomen. Daardoor raakte de hoogwerker in onbalans en werd het slachtoffer uit de bak geslingerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "c57e61b9-a6da-3dc8-8d4e-c4187c501330",
                        "entry_id": "4d7e2d44-3c62-3e5d-bc1a-4c161142834a",
                        "glosses": [
                            "ongelijkheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40abc1c5-b2ab-4552-92f9-8ee8dc696e79",
                                "sense_id": "c57e61b9-a6da-3dc8-8d4e-c4187c501330",
                                "text": "Het Oncode Institute - een virtueel instituut waarbinnen excellente Nederlandse kankeronderzoekers samenwerken - wil iets doen aan die onbalans met het zogenoemde Female Junior Investigator-programma."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "513e68fc-6231-4ae2-bc5a-110693a35fd4",
                        "source_entry_id": "4d7e2d44-3c62-3e5d-bc1a-4c161142834a",
                        "source_sense_id": "f89c56d9-a4b8-330b-a964-151b4df3cc0a",
                        "source_sense_description": "uit het evenwicht",
                        "target_lang_word": "unbalance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbalance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60ea2cc6-393d-3d6c-a088-74d51e9e2b47",
                                        "entry_id": "ea31637d-6143-3efc-bd62-2a8d9ac39d6d",
                                        "glosses": [
                                            "To cause to be out of balance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "282853c9-012a-45ef-9df6-8c313e9eca86",
                                                "sense_id": "60ea2cc6-393d-3d6c-a088-74d51e9e2b47",
                                                "text": "If you put that weight on the edge of the tray, it will unbalance it and dump all of the dishes on the floor."
                                            },
                                            {
                                                "example_id": "5ee4be66-2f44-4b9c-bd6b-b28e75a3dff1",
                                                "sense_id": "60ea2cc6-393d-3d6c-a088-74d51e9e2b47",
                                                "text": "Or, finally, might our awful situation prey upon and unbalance our minds? A group of insane folk upon a dead world!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c5ce508-118d-4505-b3bb-915220474965",
                        "source_entry_id": "4d7e2d44-3c62-3e5d-bc1a-4c161142834a",
                        "source_sense_id": "f89c56d9-a4b8-330b-a964-151b4df3cc0a",
                        "source_sense_description": "uit het evenwicht",
