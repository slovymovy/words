                        "examples": [
                            {
                                "example_id": "64c903d3-e4fd-4e60-b521-6632844e5685",
                                "sense_id": "3fd5e9e1-c207-3211-93ae-7fb45169f8c4",
                                "text": "Vanmiddag heeft de NS dat bevestigd. De controle werd gedaan door NS-medewerkers in burgerkleding, waarmee de NS poogt zwartrijden tegen te gaan."
                            },
                            {
                                "example_id": "bb200b04-0ae0-480b-bd8a-d0a9fdfc7e25",
                                "sense_id": "3fd5e9e1-c207-3211-93ae-7fb45169f8c4",
                                "text": "Het Russische persbureau RIA Novosti meldt dat de advocaat is aangehouden door de geheime dienst. \"Omdat het vaak mensen in burgerkleding zijn, weet je niet waar ze bij horen. Maar de kans is inderdaad groot dat het om de geheime dienst gaat\", zegt Godfroid."
                            },
                            {
                                "example_id": "b68e17a4-eb90-4ef3-ab37-b2d5620ca32a",
                                "sense_id": "3fd5e9e1-c207-3211-93ae-7fb45169f8c4",
                                "text": "Berlijn, 1945. Een Britse contraspionage-unit spot een verdachte man in burgerkleding. Ze houden hem staande. Hun vermoeden blijkt gegrond, want in de jaszak van de man vinden ze een zeven pagina’s testament. Van niemand minder dan Adolf Hitler."
                            }
                        ]
                    }
