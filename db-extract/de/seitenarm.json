                ],
                "senses": [
                    {
                        "sense_id": "111872eb-1f24-3be0-9bc3-b7e601441b25",
                        "entry_id": "aabbdf4e-67af-3f34-96dd-ae357e2d5cb8",
                        "glosses": [
                            "Abzweigung/seitliche Fortsetzung eines fließenden Gewässers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c9ce3f5-a8db-4775-b557-439da4749097",
                                "sense_id": "111872eb-1f24-3be0-9bc3-b7e601441b25",
                                "text": "„Sein Becken mit Hunderten Nebenflüssen und Seitenarmen misst rund 3,5 Millionen Quadratkilometer – ein Gebiet größer als Indien.“"
                            },
                            {
                                "example_id": "c99483fa-5dac-4f26-8b5a-1ffea64ef50d",
                                "sense_id": "111872eb-1f24-3be0-9bc3-b7e601441b25",
                                "text": "„Einmal im Jahr flutet die Woge die Ebenen, füllt Seen und tote Seitenarme, lässt staubige Weiden blühen und das Fährgeschäft florieren.“"
                            },
                            {
                                "example_id": "a4c66300-dc81-402d-912d-ecd4653cd2f2",
                                "sense_id": "111872eb-1f24-3be0-9bc3-b7e601441b25",
                                "text": "„An manchen Tagen bekamst du das Land so gut hin, dass du zwischen den Holzstapeln hindurch auf die Lichtung und die Anhöhe gelangtest und die Hügel jenseits des Seitenarms des Sees sehen konntest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9dea8ed7-8605-35f0-8323-dcb4bfd5a188",
                        "entry_id": "aabbdf4e-67af-3f34-96dd-ae357e2d5cb8",
                        "glosses": [
                            "zusätzliche Abzweigung an der Schnur einer Angel zur Befestigung einer weiteren Schnur mit Haken"
                        ],
                        "tags": [
                            "Angelsport",
                            "Fischerei"
                        ],
                        "examples": [
                            {
                                "example_id": "819af793-eb17-45bd-8fe1-fc6c361994f3",
                                "sense_id": "9dea8ed7-8605-35f0-8323-dcb4bfd5a188",
                                "text": "„Am Comersee kennt man diese Seitenarme nicht sondern sich auf andere Weise […].“"
                            },
                            {
                                "example_id": "5852013a-e200-4a8b-8717-66e98abb4a24",
                                "sense_id": "9dea8ed7-8605-35f0-8323-dcb4bfd5a188",
                                "text": "„Je länger der Seitenarm, desto mehr Spielraum hat der Fisch beim Anbiss.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
