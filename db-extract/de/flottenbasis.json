                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eece40ae-297b-45dd-8cd7-617dabc36523",
                                "sense_id": "e2489e04-c5d1-38b7-8922-9f4c62180ac5",
                                "text": "„Die geschützte Bucht war bestens als Flottenbasis geeignet und die liebliche Landschaft mit ihren fruchtbaren, waldbedeckten Hügeln und den Bergen im Norden einladend.“"
                            },
                            {
                                "example_id": "d943d595-accd-4973-98da-8c7f92eb3f4c",
                                "sense_id": "e2489e04-c5d1-38b7-8922-9f4c62180ac5",
                                "text": "„Wir stritten, worüber man sich damals stritt, ob den Deutschen die Landung in England gelingen werde, ob der Russenpakt von Dauer sei, ob Vichy den Deutschen Dakar als Flottenbasis abgebe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
