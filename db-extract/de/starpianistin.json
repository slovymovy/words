                "senses": [
                    {
                        "sense_id": "d9f0e4f0-e64b-3b2f-862f-d93681c3193e",
                        "entry_id": "c4b2be02-469b-3cda-9458-602b9ab28e04",
                        "glosses": [
                            "wegen ihrer Arbeit berühmte und bekannte Pianistin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7c4c992-2b45-4ffe-b151-f9b8d58c6711",
                                "sense_id": "d9f0e4f0-e64b-3b2f-862f-d93681c3193e",
                                "text": "„Die chinesische Starpianistin Yuja Wang spielte trotz kleiner Schwächung nach einer Krankheit souverän – und stylish ambitioniert.“"
                            },
                            {
                                "example_id": "b6613c3e-2254-464c-a3ce-ec82317e65a0",
                                "sense_id": "d9f0e4f0-e64b-3b2f-862f-d93681c3193e",
                                "text": "„Wer den Namen Hélène Grimaud hört, denkt an Wölfe und an eine französische Starpianistin, die als Kind ratlos machte, weil sie ihre Energie kaum drosseln konnte.“"
                            },
                            {
                                "example_id": "bbe53bb7-2317-4e8b-82d5-89ff050419b8",
                                "sense_id": "d9f0e4f0-e64b-3b2f-862f-d93681c3193e",
                                "text": "„Sie war ein Wunderkind, das schon im Alter von neun Jahren mit Beethoven-Stücken auf Tournee ging. Nun ist die Starpianistin Mihaela Ursuleasa tot in ihrer Wiener Wohnung aufgefunden worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
