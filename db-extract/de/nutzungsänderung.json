                "senses": [
                    {
                        "sense_id": "b48c7587-d680-347a-9bbe-f630ede0464d",
                        "entry_id": "2288c76a-2e79-371a-86e5-7d29ff5d4e00",
                        "glosses": [
                            "Vorgang, Maßnahme, etwas (ein Gebäude) umzunutzen, für einen anderen Zweck zu verwenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "498508ad-a9ff-4101-adf3-b89a78fd0e87",
                                "sense_id": "b48c7587-d680-347a-9bbe-f630ede0464d",
                                "text": "„Sie beantragte, eine entsprechende Nutzungsänderung des Wintergartens als Ausstellungs- und Verkaufsraum zu genehmigen.“"
                            },
                            {
                                "example_id": "cd89ad02-9533-42c0-99e5-4a653962a6fe",
                                "sense_id": "b48c7587-d680-347a-9bbe-f630ede0464d",
                                "text": "„Nutzungsänderungen bei Friedhofsflächen sind aber nur langfristig und unter Beachtung kultureller und ethischer Aspekte möglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
