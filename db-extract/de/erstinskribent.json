                "senses": [
                    {
                        "sense_id": "36ab87db-01a2-3957-b041-fc6f12828753",
                        "entry_id": "4fd737a0-31e5-3709-91ee-70bf0f76c56e",
                        "glosses": [
                            "sich erstmals an einer Hochschule Einschreibender"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fce67d0b-0f61-4c0b-8e9a-d1a8de83ed30",
                                "sense_id": "36ab87db-01a2-3957-b041-fc6f12828753",
                                "text": "„‚Von den Erstinskribenten überstehen also 50 Prozent das erste Jahr. Und die bleiben uns‘, resümiert [Vizerektor Adalbert Prechtl].“"
                            },
                            {
                                "example_id": "df207fd0-0f4a-4ea7-9cdd-327dd072bb72",
                                "sense_id": "36ab87db-01a2-3957-b041-fc6f12828753",
                                "text": "„Heuer haben wieder die klassischen Ingenieurdisziplinen Bauingenieurwesen (bisher 217 Erstinskribenten) und Maschinenbau (406 in zwei verschiedenen Zweigen) die Nase vorn, gefolgt von dem noch jungen Studium Biomedical Engineering.“"
                            },
                            {
                                "example_id": "57f0f941-f34f-4a75-b00c-9c53a3cd78ef",
                                "sense_id": "36ab87db-01a2-3957-b041-fc6f12828753",
                                "text": "„In Zukunft ist mit einem weiteren Rückgang der Zahl der Erstinskribent/inn/en zu rechnen, da die Studienrichtung Betriebswirtschaft ab dem Wintersemester 1991/ 92 auch an der sozial- und wirtschaftswissenschaftlichen Fakultät der Universität Wien angeboten wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
