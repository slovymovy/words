                    {
                        "translation_id": "9dd95b4a-0354-4035-b57e-1e45f68aaddb",
                        "source_entry_id": "4ea5b384-95fe-32b9-a147-fe54c19a13c2",
                        "source_sense_description": "swift witty retort",
                        "target_lang_word": "repliek",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repliek",
