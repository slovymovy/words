                "senses": [
                    {
                        "sense_id": "a3ca4b8f-1579-32f0-9a6c-c007c4d0c734",
                        "entry_id": "28fc00e5-4473-3f10-9c0d-d9e9e93164ac",
                        "glosses": [
                            "durchdachter Plan, der in einem Krieg zur Täuschung/Überraschung des Gegners dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f458adcf-1342-4714-a3c1-e44734db5e24",
                                "sense_id": "a3ca4b8f-1579-32f0-9a6c-c007c4d0c734",
                                "text": "„Cortez rückte auch am Vorabend des Neujahrstages in Tezcuco ein, aber bald sah er, daß die angebotene Unterwerfung der Stadtbewohner nur eine Kriegslist gewesen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af3e1f8b-e40c-4420-a262-4650bad4db00",
                        "source_entry_id": "28fc00e5-4473-3f10-9c0d-d9e9e93164ac",
                        "source_sense_id": "a3ca4b8f-1579-32f0-9a6c-c007c4d0c734",
                        "source_sense_description": "durchdachter Plan, der in einem Krieg zur Täuschung des Gegners dient",
                        "target_lang_word": "stratagem",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stratagem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "529c3b85-aca5-3787-bf61-d20357ae379b",
                                        "entry_id": "c7be0b5d-9ad0-32e3-8ce8-0bf779e3634d",
                                        "glosses": [
                                            "A tactic or artifice designed to gain the upper hand, especially one involving underhanded dealings or deception."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de7825d9-7ae7-472b-beda-cda531d7e58f",
                                                "sense_id": "529c3b85-aca5-3787-bf61-d20357ae379b",
                                                "text": "Near-synonyms: ploy, ruse"
                                            },
                                            {
                                                "example_id": "cbaa8b57-de38-4f4f-84fb-79155fbc9e8a",
                                                "sense_id": "529c3b85-aca5-3787-bf61-d20357ae379b",
                                                "text": "Tis pollicie and ſtratageme muſt doo / That you affect, and ſo muſt you reſolue, / That vvhat you cannot as you vvould atchiue, / You muſt perforce accompliſh as you may: […]"
                                            },
                                            {
                                                "example_id": "e6d24837-aa52-4a2b-b988-5f2a9d48881b",
                                                "sense_id": "529c3b85-aca5-3787-bf61-d20357ae379b",
                                                "text": "She will not yet be permitted to return to the Manor House: it is too convenient for 'treasons, stratagems,' &c.; and it is as well not to be put in the way of temptation: but she will be allowed perfect liberty in London."
                                            },
                                            {
                                                "example_id": "dfb69589-6e32-4bad-8ebb-82d65ee94c1d",
                                                "sense_id": "529c3b85-aca5-3787-bf61-d20357ae379b",
                                                "text": "While Collins does include a love triangle, a coming-of-age story, and other YA-friendly elements in the mix, they serve as a Trojan horse to smuggle readers into a hopeless world where love becomes a stratagem and growing up is a matter of basic survival."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a56c9d8-d421-3bb5-ad23-e5ae8056daf1",
                                        "entry_id": "c7be0b5d-9ad0-32e3-8ce8-0bf779e3634d",
                                        "glosses": [
                                            "Specifically, such a tactic or artifice in military operation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "352df56c-923f-44ad-84f8-dc53263c2e6c",
                                                "sense_id": "0a56c9d8-d421-3bb5-ad23-e5ae8056daf1",
                                                "text": "His fiery eies are fixt vpon the earth.\nAs if he now deuiſ’d some Stratageme:\nOr meant to pierce Auernus darkſome vauts.\nTo pull the triple headed dog from hell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca2ec81c-8af5-3703-91d3-e76d289059ff",
                                        "entry_id": "c7be0b5d-9ad0-32e3-8ce8-0bf779e3634d",
                                        "glosses": [
                                            "Military deception or artifice."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7dfb6acc-860a-3cae-9b5f-4304071d2e69",
                                        "entry_id": "c7be0b5d-9ad0-32e3-8ce8-0bf779e3634d",
                                        "glosses": [
                                            "Cunning and artifice in general."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f607cb0f-8ec5-3e35-bb26-5f3f88d7fa61",
                                        "entry_id": "c7be0b5d-9ad0-32e3-8ce8-0bf779e3634d",
                                        "glosses": [
                                            "A violent deed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
