                    "frequency": "Low",
                    "semantic_group_id": "architektur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die alten hölzernen <w>Schwellen</w> der Bahnstrecke müssen bald durch moderne Betonteile ersetzt werden."
