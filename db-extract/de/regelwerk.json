                        "form": "das Regelwerk"
                    },
                    {
                        "form_id": "89d793fc-2e9e-4173-8651-4a876197561d",
                        "entry_id": "c5f82cc5-488c-3ff4-b070-e80f8d938df7",
                        "tags": [
                            "accusative",
