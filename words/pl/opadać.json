{
    "word_family": [
        "opad",
        "opaść",
        "opadły"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "156c1d12-c94b-3d18-be92-835788d0182b",
                    "sense_definition": "tracić wysokość, osuwać się z góry na dół pod wpływem własnego ciężaru lub grawitacji",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ruch w dół",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jesienią kolorowe liście powoli <w>opadają</w> ze starych drzew w parku.",
                            "target_lang_translations": {
                                "ru": "Осенью разноцветные листья медленно <w>опадают</w> со старых деревьев в парке."
                            }
                        },
                        {
                            "text": "Gęsty pył powoli <w>opadał</w> na ziemię po wyburzeniu budynku.",
                            "target_lang_translations": {
                                "ru": "Густая пыль медленно <w>оседала</w> на землю после сноса здания."
                            }
                        }
                    ],
                    "synonyms": [
                        "spadać"
                    ],
                    "antonyms": [
                        "unosić się",
                        "wznosić się"
                    ],
                    "common_phrases": [
                        "liście opadają",
                        "opadać na dno",
                        "opadać na ziemię"
                    ],
                    "target_lang_definitions": {
                        "ru": "терять высоту, опускаться сверху вниз под собственным весом или гравитацией"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "падать",
                                "target_lang_sense_clarification": "о листьях, снеге, предметах"
                            },
                            {
                                "target_lang_word": "опадать",
                                "target_lang_sense_clarification": "о листьях, лепестках"
                            },
                            {
                                "target_lang_word": "оседать",
                                "target_lang_sense_clarification": "о пыли, тумане, осадке"
                            },
                            {
                                "target_lang_word": "опускаться",
                                "target_lang_sense_clarification": "медленно снижаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4541d87e-5ba2-39c3-b943-1945544463df",
                    "sense_definition": "tracić na sile lub natężeniu, powoli zanikać (o emocjach, zjawiskach atmosferycznych, napięciu)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zmniejszanie natężenia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kiedy pierwsze emocje wreszcie <w>opadły</w>, mogliśmy spokojnie porozmawiać o problemie.",
                            "target_lang_translations": {
                                "ru": "Когда первые эмоции наконец <w>улеглись</w>, мы смогли спокойно обсудить проблему."
                            }
                        },
                        {
                            "text": "Wiatr przestał wiać i burza stopniowo <w>opadała</w> pod wieczór.",
                            "target_lang_translations": {
                                "ru": "Ветер перестал дуть, и буря к вечеру постепенно <w>стихала</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ustępować",
                        "zmniejszać się"
                    ],
                    "antonyms": [
                        "narastać",
                        "rosnąć"
                    ],
                    "common_phrases": [
                        "emocje opadają",
                        "kurz opada"
                    ],
                    "target_lang_definitions": {
                        "ru": "терять силу или интенсивность, постепенно утихать (об эмоциях, буре, напряжении)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утихать",
                                "target_lang_sense_clarification": "о буре, ветре, эмоциях"
                            },
                            {
                                "target_lang_word": "спадать",
                                "target_lang_sense_clarification": "о напряжении, жаре, эмоциях"
                            },
                            {
                                "target_lang_word": "остывать",
                                "target_lang_sense_clarification": "о пыле, чувствах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af6c925c-2a5d-310c-a953-5fbe35e0fd23",
                    "sense_definition": "o terenie, drodze, stoku: obniżać się, prowadzić łagodnie w dół",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "układ przestrzenny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wąska ścieżka leśna łagodnie <w>opada</w> w stronę malowniczego jeziora.",
                            "target_lang_translations": {
                                "ru": "Узкая лесная тропинка полого <w>спускается</w> к живописному озеру."
                            }
                        },
                        {
                            "text": "Strome zbocze wzgórza nagle <w>opadało</w> ku głębokiej dolinie.",
                            "target_lang_translations": {
                                "ru": "Крутой склон холма резко <w>обрывался</w> вниз к глубокой долине."
                            }
                        }
                    ],
                    "synonyms": [
                        "schodzić"
                    ],
                    "antonyms": [
                        "wznosić się"
                    ],
                    "common_phrases": [
                        "łagodnie opadać",
                        "zbocze opada"
                    ],
                    "target_lang_definitions": {
                        "ru": "о местности, дороге, склоне: понижаться, полого спускаться вниз"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спускаться",
                                "target_lang_sense_clarification": "о дороге, склоне"
                            },
                            {
                                "target_lang_word": "понижаться",
                                "target_lang_sense_clarification": "о рельефе, уровне земли"
                            },
                            {
                                "target_lang_word": "идти под уклон",
                                "target_lang_sense_clarification": "о местности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf8a66e1-c20e-3d5f-bccf-17c7b84ffa0d",
                    "sense_definition": "zwisać swobodnie lub przekrzywiać się w dół",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "układ przestrzenny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Długie, jasne włosy swobodnie <w>opadały</w> jej na szczupłe ramiona.",
                            "target_lang_translations": {
                                "ru": "Длинные светлые волосы свободно <w>ниспадали</w> ей на худые плечи."
                            }
                        },
                        {
                            "text": "Ciężka tkanina zasłony miękko <w>opada</w> aż do samej podłogi.",
                            "target_lang_translations": {
                                "ru": "Тяжёлая ткань шторы мягко <w>спускается</w> до самого пола."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwieszać się",
                        "spływać"
                    ],
                    "common_phrases": [
                        "włosy opadają",
                        "opadać na ramiona"
                    ],
                    "target_lang_definitions": {
                        "ru": "свободно свисать или ниспадать вниз"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ниспадать",
                                "target_lang_sense_clarification": "о волосах, ткани, складках"
                            },
                            {
                                "target_lang_word": "падать",
                                "target_lang_sense_clarification": "свободно свисать на плечи, вниз"
                            },
                            {
                                "target_lang_word": "спускаться",
                                "target_lang_sense_clarification": "о складках ткани, шторах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65eee9d3-cc3b-3f92-95c6-fc06bab32ae2",
                    "sense_definition": "usiąść ciężko lub bezsilnie z powodu zmęczenia bądź osłabienia",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ruch w dół",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zmęczony po całym dniu pracy turysta bez sił <w>opadał</w> na drewnianą ławkę.",
                            "target_lang_translations": {
                                "ru": "Уставший после целого дня пути турист без сил <w>опускался</w> на деревянную скамейку."
                            }
                        },
                        {
                            "text": "Starszy pan bezwładnie <w>opada</w> na miękki fotel w salonie.",
                            "target_lang_translations": {
                                "ru": "Пожилой господин бессильно <w>опускается</w> в мягкое кресло в гостиной."
                            }
                        }
                    ],
                    "common_phrases": [
                        "opadać na fotel",
                        "opadać z sił"
                    ],
                    "target_lang_definitions": {
                        "ru": "тяжело или бессильно опускаться, садиться от усталости или слабости"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опускаться",
                                "target_lang_sense_clarification": "бессильно садиться"
                            },
                            {
                                "target_lang_word": "падать",
                                "target_lang_sense_clarification": "в изнеможении валиться на стул, кровать"
                            },
                            {
                                "target_lang_word": "валиться",
                                "target_lang_sense_clarification": "от усталости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}