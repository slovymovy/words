                "senses": [
                    {
                        "sense_id": "0a6df6da-85bf-3b92-ab94-2f0d3eace1dd",
                        "entry_id": "14718fca-8c95-3288-b1f3-3f06acff2429",
                        "glosses": [
                            "To dress or style hair."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e0984ed-695d-4157-8b81-54db33a0eb26",
                                "sense_id": "0a6df6da-85bf-3b92-ab94-2f0d3eace1dd",
                                "text": "\"Monsieur,\" Francina told Mrs. Sill with the utmost tact, \"is not licensed to hairdress or manicure pets. His professional aides are limited to slightly higher mammals — er — people. I am terribly sorry, madam.\""
                            },
                            {
                                "example_id": "8d0863de-a60b-491b-a140-55a9c545781f",
                                "sense_id": "0a6df6da-85bf-3b92-ab94-2f0d3eace1dd",
                                "text": "I can tell you that in three cities in New Mexico there were enough hairdressers trained to hairdress in 16 States the size of New Mexico."
                            },
                            {
                                "example_id": "77dfbe9b-8f48-4f6a-b5db-f7da1ccbb0fb",
                                "sense_id": "0a6df6da-85bf-3b92-ab94-2f0d3eace1dd",
                                "text": "I worked any hours I could at other things to reduce the number of hours I had to hairdress."
                            }
                        ]
                    }
                ],
