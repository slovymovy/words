        "fr-extract.jsonl": [
            {
                "entry_id": "8eb7e63b-81fa-31e0-93b8-b3406df70f84",
                "word": "anaphrodisiaque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ec892e1a-b9af-465e-9b8f-cf961b1a3d9f",
                        "entry_id": "8eb7e63b-81fa-31e0-93b8-b3406df70f84",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "anaphrodisiaques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9732a47b-ccb4-3175-bff5-9b12b98ae3bf",
                        "entry_id": "8eb7e63b-81fa-31e0-93b8-b3406df70f84",
                        "glosses": [
                            "Qui amortit les désirs sexuels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccd4fc00-c07e-4ec0-b16a-9105fb33997a",
                                "sense_id": "9732a47b-ccb4-3175-bff5-9b12b98ae3bf",
                                "text": "Le houblon est une plante anaphrodisiaque."
                            },
                            {
                                "example_id": "dafb94af-6444-4b7c-ab5e-23b6870fe515",
                                "sense_id": "9732a47b-ccb4-3175-bff5-9b12b98ae3bf",
                                "text": "Il faudra éviter la laitue, la bière, le vin, l’alcool et le tabac en trop grande quantité, l’odeur de camphre et surtout le café noir, qui sont anaphrodisiaques, c’est à dire qui ont pour effet d’éteindre, partiellement au moins, les désirs amoureux."
                            },
                            {
                                "example_id": "9b191fb8-9b47-4716-9076-73967354b037",
                                "sense_id": "9732a47b-ccb4-3175-bff5-9b12b98ae3bf",
                                "text": "Mais, comme on n’a même pas pris la peine d’arroser chacune d’elles d’une manière spécifique – ils emploient des arrosoirs automatiques – il tombe sous le sens que la seule et même vertu d’une infusion aphrodisiaque et d’une infusion anaphrodisiaque, par exemple, est d’enrichir les mercantis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e444a930-8b8c-4f97-91a0-6639e3b065ef",
                        "source_entry_id": "8eb7e63b-81fa-31e0-93b8-b3406df70f84",
                        "source_sense_id": "9732a47b-ccb4-3175-bff5-9b12b98ae3bf",
                        "target_lang_word": "anaphrodisiac",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anaphrodisiac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19802a66-fd6d-3919-8ca3-36bef19003b5",
                                        "entry_id": "b4cb4831-8448-38fb-949b-07724d17b937",
                                        "glosses": [
                                            "Antaphrodisiac (capable of reducing the sex drive)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0d6b3fe-3bde-493f-815c-014c186cbbfe",
                                                "sense_id": "19802a66-fd6d-3919-8ca3-36bef19003b5",
                                                "text": "Tobacco and the plant valerian are also considered to be anaphrodisiac in their effects, diminishing sexual inclination."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anaphrodisiac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5fb9174-ce9a-326e-b941-db3062469fa3",
                                        "entry_id": "9d4b4c94-2a34-3294-adf2-be7f549300b9",
                                        "glosses": [
                                            "An antaphrodisiac (substance which reduces the sex drive)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd701fe0-3a29-4930-bb38-72e94b162814",
                                                "sense_id": "e5fb9174-ce9a-326e-b941-db3062469fa3",
                                                "text": "Among this group are the solanacei alkaloids, that have a decided anti-sexual tendency. Such plants and similar anaphrodisiacs were often used, especially in the Middle Ages, to promote asceticism and, in the case of monks, to diminish fleshly desires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
