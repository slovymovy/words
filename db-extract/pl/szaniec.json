                "senses": [
                    {
                        "sense_id": "8fd977c1-6b2b-350c-8973-e277736d789b",
                        "entry_id": "fd07787d-2846-3e60-94f6-90e2605a57ac",
                        "glosses": [
                            "ziemna fortyfikacja polowa składająca się z wału i rowu"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d9f74f1d-1ffa-37d6-8f15-d68f8d7edf36",
                        "entry_id": "fd07787d-2846-3e60-94f6-90e2605a57ac",
                        "glosses": [
                            "coś będącego osłoną lub oparciem dla kogoś lub czegoś"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6a604ed-0656-4f08-800d-1def440323b5",
                        "source_entry_id": "fd07787d-2846-3e60-94f6-90e2605a57ac",
                        "source_sense_id": "8fd977c1-6b2b-350c-8973-e277736d789b",
                        "target_lang_word": "Schanze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schanze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93e6b9dc-4c8b-3599-81b4-4a000c940b1c",
                                        "entry_id": "c900d67a-9d03-30b9-a5aa-1f6f37cc1eab",
                                        "glosses": [
                                            "Verteidigungsanlage, die im Wesentlichen aus einem Erdwall besteht und allein steht oder eine andere Anlage schützt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ad56fd3-9bec-4e8e-b31d-90ee229412c8",
                                                "sense_id": "93e6b9dc-4c8b-3599-81b4-4a000c940b1c",
                                                "text": "„Nach ihrem Grundriss unterscheidet man offene oder geschlossene Schanzen[.]“"
                                            },
                                            {
                                                "example_id": "195a0dfa-8125-41b1-813e-79c5fdaf2d65",
                                                "sense_id": "93e6b9dc-4c8b-3599-81b4-4a000c940b1c",
                                                "text": "In der Schanze gibt es zwei Reihen von Schiessscharten und ein gotisches Portal der Ausfallpforte, wodurch der Ringgraben hinter dem Paradieshaus zugänglich war."
                                            },
                                            {
                                                "example_id": "15a451d6-bdfa-44cc-9d20-549068e2daa1",
                                                "sense_id": "93e6b9dc-4c8b-3599-81b4-4a000c940b1c",
                                                "text": "„Die Toten von den Schanzen gehörten in Gräber; zweckmäßig wird es sein, sie in die Schützengräben zu werfen, damit auch die noch zu etwas nütze waren.“"
                                            },
                                            {
                                                "example_id": "a17aeaed-d0c2-4166-9c56-23296f69142c",
                                                "sense_id": "93e6b9dc-4c8b-3599-81b4-4a000c940b1c",
                                                "text": "„Am 24. war um die Schanze von Schewardino gekämpft worden.“"
                                            },
                                            {
                                                "example_id": "9931892d-3d01-4a41-98d1-cc14c3f7d22b",
                                                "sense_id": "93e6b9dc-4c8b-3599-81b4-4a000c940b1c",
                                                "text": "„Die Schanzen stammen allesamt aus der La-Tène-Zeit, aus den letzten Jahrhunderten vor Christus also.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "80cbbb4f-5323-3f5e-b94f-979ee7174214",
                                        "entry_id": "c900d67a-9d03-30b9-a5aa-1f6f37cc1eab",
                                        "glosses": [
                                            "eine geneigte Plattform, die den Austrittswinkel von etwas Beschleunigtem verändert, das sich hinüberbewegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c92b59f-77a9-40b5-852e-326f37c690da",
                                                "sense_id": "80cbbb4f-5323-3f5e-b94f-979ee7174214",
                                                "text": "Die Monstertrucks fahren über eine Schanze und landen auf Schrottautos."
                                            },
                                            {
                                                "example_id": "04522ac4-977d-4145-b4ae-ddb911081109",
                                                "sense_id": "80cbbb4f-5323-3f5e-b94f-979ee7174214",
                                                "text": "Der Skiklub beschloss, eine neue größere Schanze zu bauen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7428f026-da73-3dea-ba3f-ab8b55e1089d",
                                        "entry_id": "c900d67a-9d03-30b9-a5aa-1f6f37cc1eab",
                                        "glosses": [
                                            "das Fallen von Würfeln"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6763d99a-6e02-4053-8fab-c779955597e3",
                                                "sense_id": "7428f026-da73-3dea-ba3f-ab8b55e1089d",
                                                "text": "„bey solchen leuten ehren vol,",
                                                "translation": "ein groschen auff die schantze setzn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfeea77c-adf0-43a6-ad26-b61ae1411dfc",
                        "source_entry_id": "fd07787d-2846-3e60-94f6-90e2605a57ac",
                        "source_sense_id": "8fd977c1-6b2b-350c-8973-e277736d789b",
                        "target_lang_word": "шанец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шанец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1ba9b9f5-2fed-3b3c-afd4-f9a7d3374941",
                                        "entry_id": "a9a2bf0e-3013-3877-aada-9ad8db341dfc",
                                        "glosses": [
                                            "воен. · общее название временных полевых укреплений, земляной окоп"
                                        ],
                                        "tags": [
                                            "в Российском государстве XVII–XIX вв."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4d0e03b-c640-422e-8436-a64fb2db1d74",
                                                "sense_id": "1ba9b9f5-2fed-3b3c-afd4-f9a7d3374941",
                                                "text": "Повторю ещё раз: ещё можно было предвидеть и рассчитать, что сила нового ружья за закрытым шанцем превышает вдвое и даже втрое усилие атакующего."
                                            },
                                            {
                                                "example_id": "fa18e3b0-cc40-4161-9d42-2e4507fab37a",
                                                "sense_id": "1ba9b9f5-2fed-3b3c-afd4-f9a7d3374941",
                                                "text": "Царь сам нарядился в иноземное военное платье и вздумал пройти всю военную службу, начиная с малых чинов, сам учился всяким приёмам военного искусства, и, при необыкновенной своей восприимчивости, скоро приобретал навык владеть огнестрельным оружием, устраивать понтоны, мины, копать шанцы и пр."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
