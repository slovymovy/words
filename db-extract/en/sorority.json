                    {
                        "translation_id": "8b00ab3d-53d8-4fc5-bac9-eb8530028d7d",
                        "source_entry_id": "b9ddddef-d5df-36e5-8917-ff71e6bc537e",
                        "source_sense_description": "social organization of female students at a college or university",
                        "target_lang_word": "sororité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sororité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62004fae-c00f-3827-bb24-be644d24d6b0",
                                        "entry_id": "4d934870-9e3b-3ff7-af2c-6d6d194e8f6a",
                                        "glosses": [
                                            "Organisme, association, à caractère religieux, entre femmes voulant vivre de façon sororale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f99882b-2d9f-422a-89c0-bd29b993ab8a",
                                                "sense_id": "62004fae-c00f-3827-bb24-be644d24d6b0",
                                                "text": "Dune a mis en scène la plus puissante et la plus agaçante sororité de l’histoire de la littérature : l’ordre du Bene Gesserit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4b00a85-ce16-3c21-8deb-8138e0bc6fe5",
                                        "entry_id": "4d934870-9e3b-3ff7-af2c-6d6d194e8f6a",
                                        "glosses": [
                                            "Organisation semi-secrète d’étudiantes américaines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2366926c-e3e1-4505-b678-b7a3bdc5dfc3",
                                                "sense_id": "f4b00a85-ce16-3c21-8deb-8138e0bc6fe5",
                                                "text": "Pour rien au monde je n’aurais raté le septième match de la série de championnat de la Ligue américaine 2003 entre les Yankees et les Red Sox, mais il y avait en même temps une réception à la sororité de ma copine et je devais obligatoirement y assister."
                                            },
                                            {
                                                "example_id": "b6702670-2fc5-4b24-bade-4d937436cb80",
                                                "sense_id": "f4b00a85-ce16-3c21-8deb-8138e0bc6fe5",
                                                "text": "— Et je raconterai à mes camarades de sororité que j'ai couché avec un college boy blanc, et elles ne me croiront pas"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41d3658e-6aa4-326e-b28a-136179f8b500",
                                        "entry_id": "4d934870-9e3b-3ff7-af2c-6d6d194e8f6a",
                                        "glosses": [
                                            "Solidarité entre femmes, fondée sur la conscience de partager une condition commune et visant à lutter contre les systèmes d’oppression comme le patriarcat."
                                        ],
                                        "tags": [
                                            "Études féministes",
                                            "Luttes sociales"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbc941d3-0ba4-47c4-8ed7-a082eb3eade8",
                                                "sense_id": "41d3658e-6aa4-326e-b28a-136179f8b500",
                                                "text": "Elle s’est construite et élevée dans un milieu pauvre et un pays raciste. Elle prêche la force des femmes et leur sororité."
                                            },
                                            {
                                                "example_id": "d362f53c-0dcd-4a7b-a9f5-f908004c8668",
                                                "sense_id": "41d3658e-6aa4-326e-b28a-136179f8b500",
                                                "text": "Ce que la minisérie du studio Louise Média réussit le mieux, c’est à éclipser un Dom Juan, finalement juste pathétique dans son déni et sa jalousie mal placée, pour mettre en lumière la sororité qui naît entre ses victimes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcee45c4-c7ae-37ed-86d3-83deeba22f3e",
                                        "entry_id": "4d934870-9e3b-3ff7-af2c-6d6d194e8f6a",
                                        "glosses": [
                                            "Lien affectif ou amical entre femmes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dc8e85b-57d5-464d-ab87-5955af1e73f5",
                                                "sense_id": "bcee45c4-c7ae-37ed-86d3-83deeba22f3e",
                                                "text": "Entre l’amitié féminine, la sororité ou encore le féminisme, Léa Volène nous propose différents aspects des femmes, mais aussi leurs forces et leurs fragilités."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
