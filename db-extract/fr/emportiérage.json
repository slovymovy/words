                                    {
                                        "sense_id": "0d589fa7-44e1-3c40-83d5-dc81bb3121e7",
                                        "entry_id": "7e61bba0-77c4-341b-ab86-597c67981f47",
                                        "glosses": [
                                            "The event of a cyclist crashing into a newly opened car door."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca20baf4-a1f1-4a55-b04c-520b17e1cd69",
                                                "sense_id": "0d589fa7-44e1-3c40-83d5-dc81bb3121e7",
                                                "text": "In the state of Victoria, Australia, cycle campaigners are trying to raise awareness among drivers, as well as stiffer penalties, about dooring after the death of a cyclist in 2010. Fines for dooring start at $122 (£81)."
                                            }
