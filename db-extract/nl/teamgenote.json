                        "examples": [
                            {
                                "example_id": "3f4a07ee-f71f-430a-ae00-90edf32c0a55",
                                "sense_id": "16145120-cdf2-3fbb-988b-58c63047373b",
                                "text": "Het ernstige ongeval van haar teamgenote kreeg Shanne Braspennincx, die naderhand verrassend goud veroverde op keirin, van dichtbij mee. \"Het was heel a-relaxed om dat te zien, maar de knop moest om\", zei de olympisch kampioene."
                            },
                            {
                                "example_id": "d4475702-6fae-4acc-bd39-4c37b6b1fcad",
                                "sense_id": "16145120-cdf2-3fbb-988b-58c63047373b",
                                "text": "\"Ik kan niet naar nog een Olympische Spelen kijken zonder dit publiekelijk te zeggen\", aldus Chytlook-Sifsof. De coach zou in 2014 ook seksueel getinte opmerkingen hebben gemaakt naar haar en een teamgenote, toen ze 17 jaar oud was."
                            }
                        ]
