                "translations": [
                    {
                        "translation_id": "ad1f6771-7b58-4152-9c0e-4ef58bb24b0c",
                        "source_entry_id": "88da40ef-e23d-3f06-829f-f16252031e4e",
                        "source_sense_id": "0b9e5e8b-1542-312d-a7f8-3e50cc28f3a6",
                        "target_lang_word": "Redeschwall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Redeschwall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4892caf1-41f5-3bfe-a255-8a3486229a38",
                                        "entry_id": "1832ef57-6092-398c-843b-8213fdf76953",
                                        "glosses": [
                                            "ununterbrochener, wortreicher Redefluss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cdf87c3-2741-4686-a29b-ffd21e3e4061",
                                                "sense_id": "4892caf1-41f5-3bfe-a255-8a3486229a38",
                                                "text": "„Beim Tee unterbrach Carpenter seinen Redeschwall, so daß ihm John endlich die Frage stellen konnte, die ihm die ganze Zeit auf der Zunge lag: wann er denn abzureisen gedenke.“"
                                            },
                                            {
                                                "example_id": "9631fe73-6be3-40cc-9cb8-a2421cef8e03",
                                                "sense_id": "4892caf1-41f5-3bfe-a255-8a3486229a38",
                                                "text": "„Er wachte mit einem Redeschwall auf, stürzte sich sofort in haarspalterische Debatten, immer über das Schicksal der Welt, ihre biochemische Natur, ihre astrophysikalische Beschaffenheit, ihre politisch-wirtschaftlichen Aspekte.“"
                                            },
                                            {
                                                "example_id": "e38336d9-f0bc-4392-8adc-45b947230207",
                                                "sense_id": "4892caf1-41f5-3bfe-a255-8a3486229a38",
                                                "text": "„Ihr Fremdenführer, dessen Redeschwall im Verkehrslärm unterging, fuchtelte wild mit den Armen und deutete auf das gegenüberliegende Gebäude.“"
                                            },
                                            {
                                                "example_id": "f49ecc07-f4b0-4f5e-9034-39abe518365b",
                                                "sense_id": "4892caf1-41f5-3bfe-a255-8a3486229a38",
                                                "text": "„Sein Redeschwall sprudelte nur so.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7690560c-5643-46d1-aabe-2420724aec20",
                        "source_entry_id": "88da40ef-e23d-3f06-829f-f16252031e4e",
                        "source_sense_id": "0b9e5e8b-1542-312d-a7f8-3e50cc28f3a6",
                        "target_lang_word": "Wortschwall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wortschwall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3bddeeb6-3ea0-3423-a130-1537a5d87d78",
                                        "entry_id": "f45a2ab9-ebd6-3303-94de-ec7817b8a7c3",
                                        "glosses": [
                                            "ununterbrochener, wortreicher Redefluss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "441cbeef-912c-4dfc-98ca-e664e954c86f",
                                                "sense_id": "3bddeeb6-3ea0-3423-a130-1537a5d87d78",
                                                "text": "„Er sprach viel und schnell, und dieser Wortschwall stand in auffälligem Gegensatz zu der Aura der Tüchtigkeit, die sein Reich charakterisierte.“"
                                            },
                                            {
                                                "example_id": "b3e41175-b79a-410c-af5d-442c4da642eb",
                                                "sense_id": "3bddeeb6-3ea0-3423-a130-1537a5d87d78",
                                                "text": "„Schon in den ersten Minuten wurde mir klar, dass es eine ganze Weile dauern würde, bis ich aus diesem Wortschwall etwas Verständliches herausfiltern könnte.“"
                                            },
                                            {
                                                "example_id": "7cc3a979-7743-44bc-a403-5d87ea4803ad",
                                                "sense_id": "3bddeeb6-3ea0-3423-a130-1537a5d87d78",
                                                "text": "„Ich höre ihren Diskussionen zu, ich denke an Lauenstein, an den Wortschwall, an die Tatenlosigkeit, an die Feigheit.“"
                                            },
                                            {
                                                "example_id": "126e0501-67be-4b5a-9ef6-785710620a7f",
                                                "sense_id": "3bddeeb6-3ea0-3423-a130-1537a5d87d78",
                                                "text": "„Eine häßliche, aber aufgeweckte Frau hatte bei mir vorgesprochen und mich mit einem echt italienischen Wortschwall gebeten, ich möge mich beim Magistrat dafür einsetzen, daß man der Truppe, der sie angehöre, die Spielerlaubnis erteile.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
