                ],
                "senses": [
                    {
                        "sense_id": "043e4b36-b94d-34ac-8536-5fdd9f2095db",
                        "entry_id": "43177369-46d0-3716-b295-eb5290234923",
                        "glosses": [
                            "Signer une œuvre, un écrit avec une ou plusieurs autres personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bb03ba7-117a-4547-8a69-e1f46f5bdfe8",
                                "sense_id": "043e4b36-b94d-34ac-8536-5fdd9f2095db",
                                "text": "Les individus ont conscience, par exemple, que la marque Kickers n’intervient pas dans la conception de la voiture Twingo même si elle co-signe une série limitée."
                            },
                            {
                                "example_id": "0f4bbc6c-4ad9-480b-8323-fd03fef29621",
                                "sense_id": "043e4b36-b94d-34ac-8536-5fdd9f2095db",
                                "text": "Dennis Ritchie avait participé à la rédaction de ce livre et l’a co-signé, notamment pour les exemples avec Unix et les annexes."
                            },
                            {
                                "example_id": "d99dfc73-06d9-4d20-abcc-4c5d18f9e77f",
                                "sense_id": "043e4b36-b94d-34ac-8536-5fdd9f2095db",
                                "text": "Lors de l'examen du projet de loi d’orientation sur l'énergie, les députés ont voté en première lecture un amendement du rapporteur Serge Poignant (UMP), co-signé par Patrick Ollier (UMP), affirmant que la procédure actuelle de délivrance des permis est “lourde et est perçue comme entravante”."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c9829b7-a475-4026-9b8e-6c272ebbe003",
                        "source_entry_id": "43177369-46d0-3716-b295-eb5290234923",
                        "source_sense_id": "043e4b36-b94d-34ac-8536-5fdd9f2095db",
                        "target_lang_word": "cosign",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cosign",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ab49b77-2415-3ce8-a7de-41c83b5ac701",
                                        "entry_id": "c4a79ee0-9f58-3769-b4ff-4fd90acbc612",
                                        "glosses": [
                                            "To sign a document jointly with another person, sometimes as an endorsement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4d649c5-3814-33ec-a5d3-033f53137c88",
                                        "entry_id": "c4a79ee0-9f58-3769-b4ff-4fd90acbc612",
                                        "glosses": [
                                            "To agree with or endorse."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6866a6eb-4109-422c-ad11-31e8d4512844",
                                                "sense_id": "e4d649c5-3814-33ec-a5d3-033f53137c88",
                                                "text": "[Ilhan] Omar was left twisting in the wind earlier this year after facing spurious charges of antisemitism, a display of Democratic cowardice co-signed by Chelsea Clinton, Chuck Schumer, and most every other Democrat with a congressional leadership position."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cosign",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1b61d63-30c5-3ce4-9b7b-68f2030272a4",
                                        "entry_id": "d7e7e1fc-0b02-31ef-b4f5-cbc3979fb71a",
                                        "glosses": [
                                            "The promotion of one musical artist (usually less successful) by another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "727cbf3a-bf45-4e33-8402-d67df4880eaa",
                                                "sense_id": "d1b61d63-30c5-3ce4-9b7b-68f2030272a4",
                                                "text": "Also, you can't base your entire career on cosigns and big features. At some point, your music has to stand on its own."
                                            },
                                            {
                                                "example_id": "4ba9d570-1574-43f2-9ccb-52bdd408ec9d",
                                                "sense_id": "d1b61d63-30c5-3ce4-9b7b-68f2030272a4",
                                                "text": "Big pump, don't stunt when it's showtime / Kinda funny how I didn't need a cosign"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55e90eee-04f2-4382-a7e6-0916702d153c",
