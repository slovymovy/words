{
    "word_family": [
        "astonish",
        "astonishing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "91100edc-68d3-350a-8e2e-14eb140258c6",
                    "sense_definition": "The feeling or experience of being very surprised.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students watched in <w>astonishment</w> as the teacher performed a strange experiment.",
                            "target_lang_translations": {
                                "pl": "Uczniowie patrzyli ze <w>zdumieniem</w>, gdy nauczyciel przeprowadzał dziwny eksperyment."
                            }
                        },
                        {
                            "text": "To my great <w>astonishment</w>, the team won the championship game.",
                            "target_lang_translations": {
                                "pl": "Ku mojemu wielkiemu <w>zdumieniu</w>, drużyna wygrała mecz mistrzowski."
                            }
                        }
                    ],
                    "synonyms": [
                        "amazement",
                        "wonder",
                        "wonderment"
                    ],
                    "common_phrases": [
                        "in astonishment",
                        "great astonishment"
                    ],
                    "target_lang_definitions": {
                        "pl": "Uczucie lub doświadczenie bycia bardzo zaskoczonym."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zdumienie",
                                "target_lang_sense_clarification": "stan głębokiego zaskoczenia"
                            },
                            {
                                "target_lang_word": "zdziwienie",
                                "target_lang_sense_clarification": "stan bycia zaskoczonym czymś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0e9abba-75b9-3334-b27e-d2dd0d649e36",
                    "sense_definition": "Something that causes great surprise.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician had many <w>astonishments</w> prepared for the audience during the show.",
                            "target_lang_translations": {
                                "pl": "Magik przygotował dla publiczności wiele <w>niespodzianek</w> podczas występu."
                            }
                        },
                        {
                            "text": "Finding an old friend at the party was one of the evening's pleasant <w>astonishments</w>.",
                            "target_lang_translations": {
                                "pl": "Spotkanie starego przyjaciela na przyjęciu było jedną z miłych <w>niespodzianek</w> wieczoru."
                            }
                        }
                    ],
                    "synonyms": [
                        "marvel",
                        "stunner"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in informal contexts to describe surprising events or objects."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Coś, co wywołuje wielkie zaskoczenie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dziw",
                                "target_lang_sense_clarification": "rzecz dziwna lub niezwykłe zjawisko"
                            },
                            {
                                "target_lang_word": "niespodzianka",
                                "target_lang_sense_clarification": "coś zaskakującego"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61fa4d64-9e22-3c79-a0a1-16f738813eb8",
                    "sense_definition": "A state of being confused or losing one's composure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stood in silent <w>astonishment</w> after hearing the unexpected news.",
                            "target_lang_translations": {
                                "pl": "Stała w milczącym <w>osłupieniu</w> po usłyszeniu nieoczekiwanych wieści."
                            }
                        },
                        {
                            "text": "The sudden change in plans left the team in a state of total <w>astonishment</w>.",
                            "target_lang_translations": {
                                "pl": "Nagła zmiana planów wprawiła zespół w stan całkowitego <w>osłupienia</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "consternation",
                        "dismay"
                    ],
                    "target_lang_definitions": {
                        "pl": "Stan bycia zdezorientowanym lub utrata opanowania."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "osłupienie",
                                "target_lang_sense_clarification": "stan paraliżującego zaskoczenia"
                            },
                            {
                                "target_lang_word": "konsternacja",
                                "target_lang_sense_clarification": "stan zmieszania i niepewności"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "029d4bb3-2a6d-392f-9852-d0e6252765e8",
                    "sense_definition": "A state of mental confusion or inability to think clearly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex legal document left the reader in a state of complete <w>astonishment</w>.",
                            "target_lang_translations": {
                                "pl": "Złożony dokument prawny wprawił czytelnika w stan całkowitego <w>oszołomienia</w>."
                            }
                        },
                        {
                            "text": "He was struck by a sudden <w>astonishment</w> that prevented him from making a decision.",
                            "target_lang_translations": {
                                "pl": "Doznał nagłego <w>oszołomienia</w>, które uniemożliwiło mu podjęcie decyzji."
                            }
                        }
                    ],
                    "synonyms": [
                        "stupefaction",
                        "stupor"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts to describe a dazed or stunned mental state."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Stan umysłowego zamętu lub niezdolności do jasnego myślenia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "oszołomienie",
                                "target_lang_sense_clarification": "stan bycia oszołomionym lub zdezorientowanym"
                            },
                            {
                                "target_lang_word": "odrętwienie",
                                "target_lang_sense_clarification": "stan braku reakcji lub jasnego myślenia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1abe68e9-85c1-3cd2-8b50-574e6fed3ee3",
                    "sense_definition": "A loss of physical sensation or ability to move a body part.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient reported a strange <w>astonishment</w> in his legs after the long hike.",
                            "target_lang_translations": {
                                "pl": "Pacjent zgłosił dziwną <w>drętwotę</w> w nogach po długiej wędrówce."
                            }
                        },
                        {
                            "text": "The cold weather caused a temporary <w>astonishment</w> in her fingers.",
                            "target_lang_translations": {
                                "pl": "Zimna pogoda spowodowała chwilową <w>drętwotę</w> w jej palcach."
                            }
                        }
                    ],
                    "synonyms": [
                        "paralysis",
                        "numbness"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to a medical or physical state of numbness, rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Utrata czucia fizycznego lub zdolności poruszania częścią ciała."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "drętwota",
                                "target_lang_sense_clarification": "stan braku czucia w ciele"
                            },
                            {
                                "target_lang_word": "paraliż",
                                "target_lang_sense_clarification": "utrata zdolności ruchu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}