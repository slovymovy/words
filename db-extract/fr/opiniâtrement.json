                                "target_senses": [
                                    {
                                        "sense_id": "c3289a91-ee60-3784-bea3-ebe7a69a5614",
                                        "entry_id": "33ce1d8d-aeaf-3e51-bae8-a24902133401",
                                        "glosses": [
                                            "In a relentless manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85f7dc58-96c2-4a37-b7c5-5d4e1a7c4678",
                                                "sense_id": "c3289a91-ee60-3784-bea3-ebe7a69a5614",
                                                "text": "sprightliness and vivacity which time has relentlessly taken from his person"
                                            },
                                            {
                                                "example_id": "89dcaa86-f75e-44d1-b801-13ed6bf02959",
                                                "sense_id": "c3289a91-ee60-3784-bea3-ebe7a69a5614",
                                                "text": "The leadership team must believe in it and pursue it relentlessly, along with the leader herself."
                                            }
                                        ]
