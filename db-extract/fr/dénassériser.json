                "senses": [
                    {
                        "sense_id": "8c4c4b08-c4b5-3e97-b083-50a2398f0a2c",
                        "entry_id": "145e59a4-835c-3664-8712-7469b4f547be",
                        "glosses": [
                            "Faire sortir d’un système nassérien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adf0c4d9-9061-4795-bc7f-40273191763b",
                                "sense_id": "8c4c4b08-c4b5-3e97-b083-50a2398f0a2c",
                                "text": "Sadate relâcha ceux qui étaient encore en prison et accorda même quelque soutien aux Frères dans le cadre de son programme visant à « dénassériser » l’Égypte et à la libérer du contrôle réel des Soviétiques."
                            },
                            {
                                "example_id": "1d027d93-e795-4c9d-becc-d3a6f8cbb2fd",
                                "sense_id": "8c4c4b08-c4b5-3e97-b083-50a2398f0a2c",
                                "text": "On a beau ranger les portraits du premier raïs et dénassériser à tour de bras, la question du nassérisme n’est pas réglée."
                            },
                            {
                                "example_id": "1273c353-47dd-4f0b-ab00-8c638849f24c",
                                "sense_id": "8c4c4b08-c4b5-3e97-b083-50a2398f0a2c",
                                "text": "Sadate pense que la droite intégriste l’aidera à « dénassériser » l’Égypte en s’opposant aux nasséro-marxistes qui peuplent encore les allées du pouvoir."
                            }
                        ]
                    }
                ],
