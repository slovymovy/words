        "fr-extract.jsonl": [
            {
                "entry_id": "3ae6d17c-076a-3f5e-9e97-ab99d84adee1",
                "word": "immixtion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c050c3b5-1b61-4a05-9922-a133676b86af",
                        "entry_id": "3ae6d17c-076a-3f5e-9e97-ab99d84adee1",
                        "tags": [
                            "plural"
                        ],
                        "form": "immixtions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "20710cbe-190b-3545-bccd-a3771a8c4938",
                        "entry_id": "3ae6d17c-076a-3f5e-9e97-ab99d84adee1",
                        "glosses": [
                            "Action de s’immiscer dans les affaires d’autrui."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86199da4-4e7b-4e8c-b19a-ed431fd9ba0d",
                                "sense_id": "20710cbe-190b-3545-bccd-a3771a8c4938",
                                "text": "Il critique surtout la protection que les seigneurs accordent aux préteurs juifs […]. Plus d’un seigneur protesta contre cette immixtion du pape dans ses affaires intérieures."
                            },
                            {
                                "example_id": "42be7d86-1727-43c0-85c7-05d731037c4a",
                                "sense_id": "20710cbe-190b-3545-bccd-a3771a8c4938",
                                "text": "Le fait est significatif, il démontre le désir américain d’immixtion dans la politique africaine."
                            },
                            {
                                "example_id": "b958512f-a1ac-4e74-86ec-1fc071c8f905",
                                "sense_id": "20710cbe-190b-3545-bccd-a3771a8c4938",
                                "text": "Si je n'étais pas déjà allé surprendre ces dames, c'est que, pour en avoir été victime, je répugne toujours aux surveillances, aux immixtions dans les affaires et les libertés d'autrui, même quand il s'agit de mes proches."
                            },
                            {
                                "example_id": "2d8fd691-b9ee-4a93-9060-ba93e2a8ac04",
                                "sense_id": "20710cbe-190b-3545-bccd-a3771a8c4938",
                                "text": "À Paris, autour de moi, chacun se jugeait victime du sort, offensé par ses semblables, jamais reconnu à sa juste valeur, lésé par la vie et abandonné aux mauvais vents par un État dont on exigeait le secours intégral tout en combattant la moindre immixtion."
                            }
                        ]
                    },
                    {
                        "sense_id": "80c85470-94bf-37f0-a185-571762c09ad0",
                        "entry_id": "3ae6d17c-076a-3f5e-9e97-ab99d84adee1",
                        "glosses": [
                            "Action de s’immiscer dans une succession."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f24716c-a330-4bf1-88c8-427aeb9d5025",
                                "sense_id": "80c85470-94bf-37f0-a185-571762c09ad0",
                                "text": "Les actes conservatoires n’emportent point immixtion."
                            }
                        ]
                    },
                    {
                        "sense_id": "68f2ab5e-d96b-3d4d-808b-d39911cfccf1",
                        "entry_id": "3ae6d17c-076a-3f5e-9e97-ab99d84adee1",
                        "glosses": [
                            "Action d’un événement extérieur."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "01ab2aa9-8e11-4bf9-98b9-0bd79410cd11",
                                "sense_id": "68f2ab5e-d96b-3d4d-808b-d39911cfccf1",
                                "text": "Depuis prenant pour motif l’immixtion d’un événement dans le cercle familial ou public pour ausculter ses déflagrations intimes, Laurent Mauvignier n’a cessé de perfectionner son art romanesque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b7f256d-3824-4107-aba0-e3c43bf8dc2e",
                        "source_entry_id": "3ae6d17c-076a-3f5e-9e97-ab99d84adee1",
                        "target_lang_word": "Einmischung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einmischung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f17b9fb0-a283-3f46-bf36-921672df82bb",
                                        "entry_id": "0d681713-9480-3ef9-b3cb-1e2b0090e4d1",
                                        "glosses": [
                                            "eine ungefragte, ungebetene Beteiligung an etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c3392a1-dd5f-40f4-8b81-e4d2a3efef4a",
                                                "sense_id": "f17b9fb0-a283-3f46-bf36-921672df82bb",
                                                "text": "„Diese Einmischung brachte mich in wahrhaft teuflische Wut. Ich entwand mich ihrem Griff und schlug die Axt tief in ihren Schädel ein. Sie brach lautlos zusammen.“"
                                            },
                                            {
                                                "example_id": "705ef0ce-3202-46d2-ba0f-f34de98d0b45",
                                                "sense_id": "f17b9fb0-a283-3f46-bf36-921672df82bb",
                                                "text": "„Die Regierung in Teheran hat hinreichend deutlich gemacht: Jede Einwirkung gilt ihr als Einmischung, jede Intervention als Beweis, daß Bonn nur den eigenen Agenten rauspauken will.“"
                                            },
                                            {
                                                "example_id": "19625164-7406-4cd1-8aa2-d567278f3334",
                                                "sense_id": "f17b9fb0-a283-3f46-bf36-921672df82bb",
                                                "text": "Noch einmal: \"Nicht-Einmischung\" lieferte das spanische Volk auf Gedeih und Verderb an Franco aus und schützte Hitler in der taktilsten Phase seiner Kriegsvorbereitung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d2ecfcd-a552-4395-aa75-696f99f64780",
                        "source_entry_id": "3ae6d17c-076a-3f5e-9e97-ab99d84adee1",
                        "target_lang_word": "interference",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interference",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4404eae4-22bd-3961-b111-7f1ad52a84de",
                                        "entry_id": "5fe2bb20-6384-33ab-a10b-c953cef34160",
                                        "glosses": [
                                            "The act of interfering with something, or something that interferes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc19d40b-70c6-434f-a3f6-7665283e69ad",
                                                "sense_id": "4404eae4-22bd-3961-b111-7f1ad52a84de",
                                                "text": "Somewhat impeded by constant political interference of one sort or another, British Railways are nevertheless pressing ahead with a mammoth modernisation programme; [...]"
                                            },
                                            {
                                                "example_id": "b3587948-ba86-4d7f-8b94-7d629778fa08",
                                                "sense_id": "4404eae4-22bd-3961-b111-7f1ad52a84de",
                                                "text": "\"With magic in limited use and hidden, it was possible to enhance the various magic resistances of humans, and to keep certain forms of magic from being possible. If magic enters common usage, this interference becomes infeasible.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc6229ea-bdba-3dfc-abbd-157987dd3f64",
                                        "entry_id": "5fe2bb20-6384-33ab-a10b-c953cef34160",
                                        "glosses": [
                                            "The illegal obstruction of an opponent in some ball games."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c26131f-7a85-4f12-91b8-2081af68cf79",
                                                "sense_id": "fc6229ea-bdba-3dfc-abbd-157987dd3f64",
                                                "text": "They were glued to the TV, as the referee called out a fifteen yard penalty for interference."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c21258f3-e13b-3324-bfa0-bf4f2803741e",
                                        "entry_id": "5fe2bb20-6384-33ab-a10b-c953cef34160",
                                        "glosses": [
                                            "An effect caused by the superposition of two systems of waves."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aefcb26a-f4c1-36a7-8392-4cbd9869e24d",
                                        "entry_id": "5fe2bb20-6384-33ab-a10b-c953cef34160",
                                        "glosses": [
                                            "A distortion on a broadcast signal due to atmospheric or other effects."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c244279-c558-4600-92a4-eb00db38ba4a",
                                                "sense_id": "aefcb26a-f4c1-36a7-8392-4cbd9869e24d",
                                                "text": "They wanted to watch the game on TV, but there was too much interference to even make out the score on the tiny screen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a664085-cdb3-3175-b563-555020d48417",
