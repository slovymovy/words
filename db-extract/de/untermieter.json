                    {
                        "translation_id": "fb39cce4-9eeb-448c-a8e2-daf2ae0f2c2c",
                        "source_entry_id": "c046ccc6-5c5a-30d9-8ef1-7a99ccdb47e4",
                        "source_sense_id": "87364657-32c4-3b2c-a12d-65d6fed4c9dd",
                        "source_sense_description": "Person, die sich in Räumlichkeiten eines Mieters einmietet",
                        "target_lang_word": "roomer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roomer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d6b656a-3d01-3959-b320-6b0644ca177a",
                                        "entry_id": "e094942f-65f4-3612-8060-252048082e2e",
                                        "glosses": [
                                            "A person who rents a room."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e8217f-d884-495f-ac94-6dbefccad1b5",
                                                "sense_id": "2d6b656a-3d01-3959-b320-6b0644ca177a",
                                                "text": "Many years ago, while rummaging through cartons in our basement, I found a tattered, coverless copy of James Baldwin's Giovanni's Room. It had probably been left behind by one of the roomers with whom we shared our house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5680d657-b964-3c85-a2c7-ec49cc275e6b",
                                        "entry_id": "e094942f-65f4-3612-8060-252048082e2e",
                                        "glosses": [
                                            "A residence having the specified number of rooms."
                                        ],
                                        "tags": [
                                            "in-compounds"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9989b28b-9a82-4ea2-9384-08b659b91024",
                                                "sense_id": "5680d657-b964-3c85-a2c7-ec49cc275e6b",
                                                "text": "Rents were to be $60 a month for a two-room flat, $90 for a three-roomer and $120 for a four-roomer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "roomer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e22c96f5-b63e-3a38-9aa5-65fe6f44c507",
                                        "entry_id": "2c276d4c-344e-3643-b7d4-f519178d416f",
                                        "glosses": [
                                            "At a greater distance; farther off."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad69d831-9ac3-421f-91ad-af2f06418c94",
                                                "sense_id": "e22c96f5-b63e-3a38-9aa5-65fe6f44c507",
                                                "text": "The Captaine in a Shippe of warre, is a iollie fellowe, and thinketh himselfe a lyttle God, because hee speaketh prowdlie to the Souldiors, and maketh them quayle at the shaking of his lockes: […] If any be vnrulie, hee casteth him ouerboorde, or if any be fearefull, hee bindes him to the Maste: if hée crie aloofe, the Helmes man dares not goe roomer: and if hée bidde shoote, the gunner dares not but giue fyre."
                                            },
                                            {
                                                "example_id": "c04da60a-29cf-46b5-8f6e-7261b355acd4",
                                                "sense_id": "e22c96f5-b63e-3a38-9aa5-65fe6f44c507",
                                                "text": "1607, John Harington (translator), Orlando Furioso by Ludovico Ariosto, London: John Norton and Simon Waterson, Book 41, stanza 17, p. 343,\nYet did the master by all meanes assay,\nTo steare out roomer, or to keepe aloofe,\nOr at the least to strike sailes if they may,\nAs in such danger was for their behoofe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
