                                                "sense_id": "5a9b06e9-4bb1-3da8-b908-2330b4928380",
                                                "text": "Dieses Taxi hat Funk."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2c3accfe-976e-377f-92ff-5ebebfa4d804",
