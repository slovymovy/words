                                "target_senses": [
                                    {
                                        "sense_id": "d48cd59f-e597-328b-922f-0c9d92524c34",
                                        "entry_id": "dd427fdb-337f-3f9d-a9f7-6d67312edb51",
                                        "glosses": [
                                            "To take drugs (especially heroin) on an occasional basis, rather than as an addict."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b199919e-f990-4b43-9409-20df3a2bebbd",
                                                "sense_id": "d48cd59f-e597-328b-922f-0c9d92524c34",
                                                "text": "I chippy around but haven't been hooked in a year now."
                                            },
                                            {
                                                "example_id": "d212d70d-7e09-4151-9761-16258e9cc979",
                                                "sense_id": "d48cd59f-e597-328b-922f-0c9d92524c34",
                                                "text": "The heroin user in the United States typically \"chippies\" for some time before becoming a regular user."
                                            },
                                            {
                                                "example_id": "4208f998-93ca-4a3e-80ce-89509e177275",
                                                "sense_id": "d48cd59f-e597-328b-922f-0c9d92524c34",
                                                "text": "For the most part, the players who are \"chippying\" with heroin think that they have their heroin use under control […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "576bd9e7-c900-4148-a57c-c94b98149fca",
