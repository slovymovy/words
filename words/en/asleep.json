                {
                    "sense_id": "7e8d9321-ee37-39e7-bdd0-d8cbaddaf3d1",
                    "sense_definition": "Not paying attention; inattentive to what is happening.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guard was <w>asleep</w> at the wheel and missed the incident.",
                            "target_lang_translations": {
                                "ru": "Охранник <w>спал на посту</w> и пропустил инцидент.",
                                "pl": "Ochroniarz <w>zaspał</w> i przegapił incydent.",
                                "nl": "De beveiligingsbeambte was <w>niet alert</w> en miste het incident.",
                                "de": "Der Sicherheitsbeamte war <w>unaufmerksam</w> und hat den Vorfall verpasst.",
                                "fr": "Le gardien de sécurité était <w>endormi</w> au volant et a manqué l'incident.",
                                "it": "La guardia di sicurezza si è <w>addormentata</w> al volante e si è persa l'incidente.",
                                "cs": "Mariňák u ostrahy <w>nedával pozor</w> a incident propásl.",
                                "tr": "Güvenlik görevlisi <w>görev başında uyuyordu</w> ve olayı kaçırdı.",
                                "es": "El guardia de seguridad estaba <w>dormido</w> al volante y se perdió el incidente.",
                                "zh": "保安当时<w>疏忽</w>职守，错过了这次事故。",
                                "ja": "警備員は<w>不注意</w>で、その事件を見逃してしまいました。",
                                "pt": "O segurança estava <w>desatento</w> no posto e não deu pelo incidente."
                            }
                        },
                        {
                            "text": "You must have been <w>asleep</w> to miss such an obvious mistake.",
                            "target_lang_translations": {
                                "ru": "Ты, должно быть, <w>спал</w>, раз пропустил такую очевидную ошибку.",
                                "pl": "Musiałeś być <w>nieuważny</w>, żeby przegapić tak oczywisty błąd.",
                                "nl": "Je moet wel <w>onoplettend</w> zijn geweest om zo'n duidelijke fout te missen.",
                                "de": "Du musst wohl <w>geschlafen</w> haben, um einen so offensichtlichen Fehler zu übersehen.",
                                "fr": "Tu devais être <w>endormi</w> pour rater une erreur aussi évidente.",
                                "it": "Devi essere stato proprio <w>disattento</w> per farti sfuggire un errore così ovvio.",
                                "cs": "Musel jsi být <w>nepozorný</w>, když jsi přehlédl tak zjevnou chybu.",
                                "tr": "Böylesine bariz bir hatayı kaçırmak için <w>ayakta uyuyor</w> olmalıydın.",
                                "es": "Debes haber estado <w>dormido</w> para pasar por alto un error tan obvio.",
                                "zh": "你一定是<w>走神</w>了，才会错过这么明显的错误。",
                                "ja": "こんなに明らかな間違いを見逃すとは、よほど<w>不注意だった</w>のでしょう。",
                                "pt": "Deves ter estado <w>distraído</w> para deixares passar um erro tão óbvio."
                            }
                        }
                    ],
                    "common_phrases": [
                        "asleep at the wheel",
                        "asleep on the job"
                    ],
                    "target_lang_definitions": {
                        "ru": "Невнимательный; не следящий за происходящим.",
                        "pl": "Nieuważny; nie zwracający uwagi na to, co się dzieje.",
                        "nl": "Niet oplettend; onoplettend voor wat er gebeurt.",
                        "de": "Unaufmerksam; nicht darauf achtend, was um einen herum geschieht.",
                        "fr": "Qui ne fait pas attention ; inattentif à ce qui se passe.",
                        "it": "Che non presta attenzione; disattento a ciò che sta accadendo.",
                        "cs": "Nedávající pozor; nepozorný k tomu, co se děje.",
                        "tr": "Dikkat etmeyen; olup bitene karşı ilgisiz veya dalgın.",
                        "es": "No prestar atención; desatento a lo que está sucediendo.",
                        "zh": "不注意；对正在发生的事情缺乏警觉。",
                        "ja": "周りで起きていることに注意を向けず、気づいていないこと。",
                        "pt": "Que não presta atenção ao que se passa à sua volta; desatento."
                    },
