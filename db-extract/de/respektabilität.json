                "senses": [
                    {
                        "sense_id": "8f92bfa6-395b-3947-8ab1-bc363157ac63",
                        "entry_id": "a29d247b-8d5e-3914-9044-7b636a6b2da0",
                        "glosses": [
                            "Eigenschaft, so zu sein, dass man Achtung/Ehrerbietung (Respekt) verdient/bekommt; dass man durch sein (respektables) Verhalten respektiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bc05499-6e69-49ad-819c-482a6e49cadc",
                                "sense_id": "8f92bfa6-395b-3947-8ab1-bc363157ac63",
                                "text": "„Schließlich drückt sich auch die Respektabilität der Nation wesentlich aus über die Respektabilität der Frauen, wobei sich deren Ehrbarkeit wiederum im Umgang mit ihrem Körper und ihrer Sexualität manifestiert.“"
                            },
                            {
                                "example_id": "0e692ce4-deb5-4033-946e-a8a53f11b5dd",
                                "sense_id": "8f92bfa6-395b-3947-8ab1-bc363157ac63",
                                "text": "„Dem Äußern nach war er ein Muster von Respektabilität. Ich glaube nicht, daß es jemals in solcher Stellung einen respektabler aussehenden Mann gegeben hat.“"
                            },
                            {
                                "example_id": "0524cab4-6563-4653-a5da-f60efc40e040",
                                "sense_id": "8f92bfa6-395b-3947-8ab1-bc363157ac63",
                                "text": "„Soziologisch ist unter Respektabilität »anerkannter Status« (Vester nach Gardemin 2006) zu verstehen: Respektabel ist, wer zu den »anständigen Leuten« zählt, den Ehrbaren, auf die »man« nicht herabsieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
