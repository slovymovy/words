                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f909d4e-44b7-4173-ae73-c88ff04b2793",
                        "source_entry_id": "dfeb8169-890b-3022-8fb4-3f7c4b24084c",
                        "source_sense_id": "4b25a831-27fa-3ae7-908d-1352aec2b48c",
                        "target_lang_word": "saprophage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saprophage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef86cd3c-6d73-36fc-9075-1fe122e20310",
                                        "entry_id": "50042c75-8693-3a0e-9b5f-4bf6d15d2317",
                                        "glosses": [
                                            "Qui se nourrit de matière en décomposition."
                                        ],
                                        "tags": [
                                            "Physiologie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6dab59b-14a4-447a-bd20-e4663b56e151",
                                                "sense_id": "ef86cd3c-6d73-36fc-9075-1fe122e20310",
                                                "text": "La macro-faune comprend des animaux coprophages (comme le bousier), nécrophages (comme le vautour, le marabout à sac, le chacal, la hyène) et saprophages (du grec sapros : pourri, en décomposition), comme les lombrics, qu’Aristote appelait « les intestins de la terre »."
                                            },
                                            {
                                                "example_id": "ab1929fb-6fe5-4715-ace1-da00bbd8248d",
                                                "sense_id": "ef86cd3c-6d73-36fc-9075-1fe122e20310",
                                                "text": "Nous sommes redevables du miel aux abeilles, de la soie aux chenilles de Bombyx mori, aux insectes pollinisateurs de la fécondation des fleurs — et donc de la production de fruits, de légumes, de plantes de grandes cultures (à l’exception des céréales) et de fourrages pour les animaux (luzerne, trèfle) — et à nombre d’autres espèces de la destruction de leurs comparses ravageurs des récoltes (destruction des pucerons par les coccinelles, par exemple) et de la décomposition des déchets organiques (insectes coprophages et saprophages)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "saprophage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67027a4c-1b94-3038-8465-bddcac446d0b",
                                        "entry_id": "a5b4260f-f0b3-33bc-be4a-43f235a1d691",
                                        "glosses": [
                                            "Organisme qui se nourrit de matière en décomposition."
                                        ],
                                        "tags": [
                                            "Physiologie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbba4842-f7d0-4b06-9d89-b88a6b7caf75",
                                                "sense_id": "67027a4c-1b94-3038-8465-bddcac446d0b",
                                                "text": "Chaque micro-organisme et chaque organisme jouent un rôle : les saprophages ou détritivores mangent des débris végétaux et animaux, les nécrophages mangent des cadavres, les coprophages consomment des excréments et les carnivores, des animaux vivants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edd40686-f752-4be2-9c83-70912a28a343",
                        "source_entry_id": "dfeb8169-890b-3022-8fb4-3f7c4b24084c",
                        "source_sense_id": "4b25a831-27fa-3ae7-908d-1352aec2b48c",
                        "target_lang_word": "détritivore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détritivore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f20e6edc-4b4e-3a31-bb5c-7aa5c1cdbf88",
                                        "entry_id": "25cf2abf-5c63-3d09-ac91-5a33f181f6de",
                                        "glosses": [
                                            "Se dit d’organismes vivants qui ont un régime essentiellement constitué de déchets organiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d399cb-b069-4c55-ad81-0e2965631eb0",
                                                "sense_id": "f20e6edc-4b4e-3a31-bb5c-7aa5c1cdbf88",
                                                "text": "Les anthrènes sont détritivores alors que les cloportes sont détritiphages."
                                            },
                                            {
                                                "example_id": "c48c5275-74ad-4a54-b48d-935034e6969c",
                                                "sense_id": "f20e6edc-4b4e-3a31-bb5c-7aa5c1cdbf88",
                                                "text": "De loin, la plupart de la production primaire est consommée par les détritivores (arthropodes). Le résultat est que le flux énergétique dans les déserts passe, dans une très grande mesure, à travers la composante détritivore de l’écosystème."
                                            },
                                            {
                                                "example_id": "584dbecf-0ea5-4f38-8ccf-70e415bdae2b",
                                                "sense_id": "f20e6edc-4b4e-3a31-bb5c-7aa5c1cdbf88",
                                                "text": "Les données sur l’efficacité globale de la communauté détritivore du premier compartiment sont assez rares. D’une manière générale, on admet que 40% de la litière sont mangés par la macrofaune."
                                            },
                                            {
                                                "example_id": "3e4fd75e-a557-4131-957b-1847e98324f1",
                                                "sense_id": "f20e6edc-4b4e-3a31-bb5c-7aa5c1cdbf88",
                                                "text": "Quatre acteurs clés interviennent dans ces processus : les litières végétales (feuilles, plantes et racines mortes), les microorganismes libres, dits « saprotrophes », c’est-à-dire qui dépendent exclusivement de la matière organique morte pour leur nutrition, les champignons mycorhiziens, qui vivent en symbiose avec les racines de plantes, et les animaux détritivores du sol (vers de terre, cloportes, collemboles, millepattes), qui se nourrissent des déchets végétaux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "détritivore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09042017-1d0a-34c2-b52f-616a424d097e",
                                        "entry_id": "93a6e782-07a3-353a-905d-0b058f2f58ea",
                                        "glosses": [
                                            "Organisme vivant qui a un régime essentiellement constitué de déchets organiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8e1ad13-5cee-4f66-84ed-38579a64c15e",
                                                "sense_id": "09042017-1d0a-34c2-b52f-616a424d097e",
                                                "text": "De loin, la plupart de la production primaire est consommée par les détritivores (arthropodes). Le résultat est que le flux énergétique dans les déserts passe, dans une très grande mesure, à travers la composante détritivore de l’écosystème."
                                            },
                                            {
                                                "example_id": "5b719791-1ddd-451d-815c-e988bce775a8",
                                                "sense_id": "09042017-1d0a-34c2-b52f-616a424d097e",
                                                "text": "Les organismes liés à la chaîne des détritivores sont extrêmement variés, de tailles et de durées de vie très différentes. Ils appartiennent à divers groupes fonctionnels : saprophages, xylophages, coprophages (macro et mésofaune principalement). saprophytes (champignons), et un grand nombre de bactéries minéralisatrices ou à fonction plus spécialisée."
                                            },
                                            {
                                                "example_id": "f8dda5b8-4110-431e-885c-eb52199bebab",
                                                "sense_id": "09042017-1d0a-34c2-b52f-616a424d097e",
                                                "text": "La biodiversité des détritivores, tels que les millepattes et les cloportes, contribuent également de manière importante à la fragmentation des feuilles mortes et à sa décomposition. Ainsi, l’augmentation des populations de détritivores dans les agroécosystèmes peut par conséquent améliorer le recyclage des nutriments et la croissance des plantes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90739d27-db84-49bb-a1f8-8f6df8718e96",
                        "source_entry_id": "dfeb8169-890b-3022-8fb4-3f7c4b24084c",
                        "source_sense_id": "4b25a831-27fa-3ae7-908d-1352aec2b48c",
                        "target_lang_word": "détritiphage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détritiphage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6f16d83-051f-3afd-a1d5-912ff242fca6",
                                        "entry_id": "934fd20b-034d-3978-a9d0-b1235cc9980c",
                                        "glosses": [
                                            "Détritivore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df7b3e07-9bf0-4d92-951f-ae1076b94d3a",
                                                "sense_id": "d6f16d83-051f-3afd-a1d5-912ff242fca6",
                                                "text": "Les dermestes sont des petits coléoptères détritiphages."
                                            },
                                            {
                                                "example_id": "1cb78840-b5c1-473e-855a-8fb59170ae6d",
                                                "sense_id": "d6f16d83-051f-3afd-a1d5-912ff242fca6",
                                                "text": "Toutes les espèces, liées généralement au cocotier mais aussi au palmier à huile, sont détritiphages et ne consomment donc que des matières végétales mortes (stipe-feuille)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "détritiphage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01e1729d-bd67-3cc7-a73d-310e3c437c08",
                                        "entry_id": "1f11c179-b9f0-3f2e-b239-18221d3f0d70",
                                        "glosses": [
                                            "Détritivore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "654f7a1f-98e0-493e-8e33-fe40202e45a1",
                                                "sense_id": "01e1729d-bd67-3cc7-a73d-310e3c437c08",
                                                "text": "Une bonne partie de cette matière organique inerte se minéralise ou est absorbée par les détritiphages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
