                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb397bf3-b1ca-446e-a26f-b352eae6462b",
                                                "sense_id": "27b830f7-9009-3fc7-bafe-a5ddaa9c4450",
                                                "text": "S řadou lékařů, tehdy ještě převážně Egypťanů, jsme se seznámili při našich expedicích."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99e12286-bfbe-3771-a08c-f6103bae1273",
