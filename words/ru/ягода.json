{
    "word_family": [
        "ягодка",
        "ягодник",
        "ягодный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1639642c-aa33-3440-9b53-acd13b745bc9",
                    "sense_definition": "Маленький сочный плод кустарников, полукустарников или травянистых растений.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом мы ходим в лес <w>собирать</w> <w>ягоды</w>.",
                            "target_lang_translations": {
                                "de": "Im Sommer gehen wir in den Wald, um <w>Beeren</w> zu <w>sammeln</w>."
                            }
                        },
                        {
                            "text": "На столе стояла большая тарелка, на которой лежала <w>Спелая</w> <w>ягода</w>.",
                            "target_lang_translations": {
                                "de": "Auf dem Tisch stand ein großer Teller, auf dem eine <w>reife</w> <w>Beere</w> lag."
                            }
                        }
                    ],
                    "common_phrases": [
                        "собирать ягоды",
                        "спелая ягода",
                        "лесная ягода"
                    ],
                    "target_lang_definitions": {
                        "de": "Kleine, saftige Frucht von Sträuchern, Halbsträuchern oder krautigen Pflanzen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Beere",
                                "target_lang_sense_clarification": "kleine saftige Frucht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed19b08e-34d0-3de0-a730-305949733e7f",
                    "sense_definition": "Многосемянный плод с сочным мякотным околоплодником.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "С ботанической точки зрения томат представляет собой сочную <w>ягоду</w>.",
                            "target_lang_translations": {
                                "de": "Aus botanischer Sicht ist die Tomate eine saftige <w>Beere</w>."
                            }
                        },
                        {
                            "text": "Каждая <w>ягода</w> винограда содержит несколько небольших косточек.",
                            "target_lang_translations": {
                                "de": "Jede Wein<w>beere</w> enthält einige kleine Kerne."
                            }
                        }
                    ],
                    "common_phrases": [
                        "сочная ягода"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "научный или ботанический контекст"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Vielsamige Schließfrucht mit saftigem Fruchtfleisch im botanischen Sinne."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Beere",
                                "target_lang_sense_clarification": "botanischer Begriff"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c5cf311-b1a7-3a16-b6b5-4ece603e946c",
                    "sense_definition": "Привлекательный, заманчивый или красивый объект, человек.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В сорок пять баба — снова <w>ягода</w> опять.",
                            "target_lang_translations": {
                                "de": "Mit fünfundvierzig ist eine Frau wieder ein richtiges <w>Prachtstück</w>."
                            }
                        },
                        {
                            "text": "Этот новый автомобиль — настоящая <w>ягода</w> для коллекционера.",
                            "target_lang_translations": {
                                "de": "Dieses neue Auto ist ein echtes <w>Sahnestück</w> für jeden Sammler."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "переносное значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Attraktives, verlockendes oder schönes Objekt bzw. Person (übertragen)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Prachtstück",
                                "target_lang_sense_clarification": "übertragen für etwas sehr Schönes oder Verlockendes"
                            },
                            {
                                "target_lang_word": "Sahnestück",
                                "target_lang_sense_clarification": "übertragen für etwas besonders Attraktives"
                            }
                        ]
                    }
                }
            ]
        },
        {
