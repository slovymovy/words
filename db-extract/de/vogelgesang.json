                ],
                "senses": [
                    {
                        "sense_id": "c9011f81-1235-38ec-a48e-35fcfad62f72",
                        "entry_id": "c0745b06-b692-3e7a-9be2-a3fa631d79f9",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "302145b6-c9fa-4ef7-8ded-13d9efb4fab0",
                                "sense_id": "c9011f81-1235-38ec-a48e-35fcfad62f72",
                                "text": "Frau Vogelgesang ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d00bde35-1bf0-4910-9a01-5ae3fa79db3f",
                                "sense_id": "c9011f81-1235-38ec-a48e-35fcfad62f72",
                                "text": "Herr Vogelgesang wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9238d083-5a7f-48a8-81e5-8d8b78b0ea20",
                                "sense_id": "c9011f81-1235-38ec-a48e-35fcfad62f72",
                                "text": "Die Vogelgesangs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9aa069c4-44fa-4bbe-a7cd-c3b09a2cdbf4",
                                "sense_id": "c9011f81-1235-38ec-a48e-35fcfad62f72",
                                "text": "Der Vogelgesang trägt nie die Schals, die die Vogelgesang ihm strickt."
                            },
                            {
                                "example_id": "1f9f0f04-f7bc-4bee-88c6-eb0a66f7073a",
                                "sense_id": "c9011f81-1235-38ec-a48e-35fcfad62f72",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Vogelgesang kommt, geht der Herr Voglgsangs.“"
                            },
                            {
                                "example_id": "022c70e9-7b0b-43dc-a94a-49998616d32e",
                                "sense_id": "c9011f81-1235-38ec-a48e-35fcfad62f72",
                                "text": "Vogelgesang kommt und geht."
                            },
                            {
                                "example_id": "64db160c-80a1-41fa-b4f9-336625c6871d",
                                "sense_id": "c9011f81-1235-38ec-a48e-35fcfad62f72",
                                "text": "Vogelgesangs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
