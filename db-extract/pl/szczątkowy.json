                    },
                    {
                        "sense_id": "872def56-e4ea-3464-b62f-a3e22fbdd475",
                        "entry_id": "051ae8a1-9da8-39e0-acaf-346e994446fd",
                        "glosses": [
                            "pozostały jako szczątek czegoś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c19a049-561a-4526-ad1e-38c370b299bd",
                                "sense_id": "872def56-e4ea-3464-b62f-a3e22fbdd475",
                                "text": "Narządem szczątkowym są np. skrzydła u strusia."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2056d0e-b9fd-407f-9c63-a21a4ad7d557",
                        "source_entry_id": "051ae8a1-9da8-39e0-acaf-346e994446fd",
                        "source_sense_id": "872def56-e4ea-3464-b62f-a3e22fbdd475",
                        "target_lang_word": "residual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "residual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9ee953a-a3bb-34a5-bc3c-464f4be2b2df",
                                        "entry_id": "313714ea-6724-30b6-93fd-5eb97da42de4",
                                        "glosses": [
                                            "Of, relating to, or remaining as a residue; left over."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11228b66-2777-4763-a378-aef52d16d0e7",
                                                "sense_id": "e9ee953a-a3bb-34a5-bc3c-464f4be2b2df",
                                                "text": "Yet certain films leave a residual memory—such as Psycho: many people still feel uneasy showering in a motel bathroom."
                                            },
                                            {
                                                "example_id": "a75b0bdc-5735-4275-b974-4e055f9bb6d7",
                                                "sense_id": "e9ee953a-a3bb-34a5-bc3c-464f4be2b2df",
                                                "text": "Abolitionists argued that race had no place in a free and democratic society as a dividing line. Economic and social policies and practices, they argued, should be race-neutral and egalitarian. Yet despite these racially egalitarian values, much abolitionist rhetoric exhibited a strong residual commitment to racialist thinking and a palpable devotion to white supremacy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "residual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fa5ec4a-be7f-300e-852b-df01d419b443",
                                        "entry_id": "657c3292-f1ee-3ab2-a60f-aaa5192dea4e",
                                        "glosses": [
                                            "A remainder left over at the end of some process."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2b4b456-175b-3738-b8e2-3e757fb09f7f",
                                        "entry_id": "657c3292-f1ee-3ab2-a60f-aaa5192dea4e",
                                        "glosses": [
                                            "Payments made to performers, writers and directors when a recorded broadcast is repeated."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b4f37a3-0b3b-4d49-aa5d-2cea5ac8ae3d",
                                                "sense_id": "e2b4b456-175b-3738-b8e2-3e757fb09f7f",
                                                "text": "The tentative deal announced this week by the Writers Guild of America includes many industry-specific aspects, such as the size of writers’ rooms and improved residuals for streaming."
                                            },
                                            {
                                                "example_id": "504d053a-3b35-4431-be07-01bdd7d7f45c",
                                                "sense_id": "e2b4b456-175b-3738-b8e2-3e757fb09f7f",
                                                "text": "Because, despite his very small role as shark victim Alex Kintner when he was 12, Voorhees is still being paid residuals – royalties – 50 years later. Every time Jaws is on TV, he earns money. […] “It pays to die,” is how he put it in a recent interview with Syfy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1a64b7a-b285-3b4e-836a-7d5cf892fd04",
                                        "entry_id": "657c3292-f1ee-3ab2-a60f-aaa5192dea4e",
                                        "glosses": [
                                            "The difference between the observed value and the estimated value of the quantity of interest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1014bca8-c7a1-385c-8874-ed1453df2d0c",
                                        "entry_id": "657c3292-f1ee-3ab2-a60f-aaa5192dea4e",
                                        "glosses": [
                                            "A spiritual presence left behind in a place as a result of a person's death or some other significant event."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "050be94f-f624-4403-a272-27b436f449df",
                        "source_entry_id": "051ae8a1-9da8-39e0-acaf-346e994446fd",
                        "source_sense_id": "872def56-e4ea-3464-b62f-a3e22fbdd475",
                        "target_lang_word": "vestigial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vestigial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85330bcf-f9f5-3964-8248-0dace4da6cdd",
                                        "entry_id": "1872f7a8-50c9-3b0d-90b6-a5ed3b307c34",
                                        "glosses": [
                                            "Of or pertaining to a vestige or remnant; like a trace from the past."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28ead0ba-9a4c-3efe-80bd-1243f76f8583",
                                        "entry_id": "1872f7a8-50c9-3b0d-90b6-a5ed3b307c34",
                                        "glosses": [
                                            "Not fully developed in mature animals."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b977df64-edd9-3fdf-9681-be9f300ad1aa",
                                        "entry_id": "1872f7a8-50c9-3b0d-90b6-a5ed3b307c34",
                                        "glosses": [
                                            "Of a vestigial structure; that has lost all or most of its original function in the course of evolution."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24a8c639-2676-4616-8eac-0997ef5191bc",
                                                "sense_id": "b977df64-edd9-3fdf-9681-be9f300ad1aa",
                                                "text": "Remnants of the vascular supply of lost organs may be present in the tissues of the receptacle when all external evidence of the organs has disappeared. Only rarely does the vascular supply of a vestigial organ disappear while external remnants are still present."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vestigial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "994648ab-f8a5-3a10-b878-71ae7f3a66cc",
                                        "entry_id": "9a0beb6a-4c6d-39e5-9a13-49dc89b7feeb",
                                        "glosses": [
                                            "A small, degenerate, or imperfectly developed part or organ which has been more fully developed in some past generation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
