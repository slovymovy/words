                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperréalisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa1a8daa-dbed-3582-9d72-3180b91d44c4",
                                        "entry_id": "b890cf2a-aa50-33b1-b3df-3f354cb31658",
                                        "glosses": [
                                            "Mouvement artistique d’origine américaine, caractérisé par une représentation figurative ultraréaliste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08686b87-a3ef-48d3-aba8-e33448cab516",
                                                "sense_id": "aa1a8daa-dbed-3582-9d72-3180b91d44c4",
                                                "text": "L’hyperréalisme consiste en la reproduction à l’identique d’une photographie en peinture, tellement réaliste que le spectateur vient à se demander si la nature de l'œuvre artistique est une peinture ou une photographie."
                                            },
                                            {
                                                "example_id": "9ff12f54-a9fe-4155-8dbf-9b4a89fdf658",
                                                "sense_id": "aa1a8daa-dbed-3582-9d72-3180b91d44c4",
                                                "text": "Le terme hyperréalisme est une version française du mot photorealism accrédité aux États-Unis par le marchand Louis K. Meisel et du mot superrealism proposé par le peintre Malcom Morley."
                                            }
                                        ]
                                    }
                                ]
                            }
