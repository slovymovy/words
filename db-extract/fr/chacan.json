        "fr-extract.jsonl": [
            {
                "entry_id": "1f0cc4f6-873b-36e6-a0f6-906c9ea4428a",
                "word": "chacan",
                "pos": "pron",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1d4aa77c-f89a-3ea8-960f-1efdfc16f796",
                        "entry_id": "1f0cc4f6-873b-36e6-a0f6-906c9ea4428a",
                        "glosses": [
                            "Chaque personne de genre non-binaire ou inconnu d’un ensemble dont il est question."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "3655e7fc-9125-459c-a272-a3864d5eb3ba",
                                "sense_id": "1d4aa77c-f89a-3ea8-960f-1efdfc16f796",
                                "text": "À chacan de voir jusqu’où iel porte l’anarchisme"
                            },
                            {
                                "example_id": "f5fede7f-a051-4074-afb1-90a18ad5cc9a",
                                "sense_id": "1d4aa77c-f89a-3ea8-960f-1efdfc16f796",
                                "text": "Si d’un point de vue individuel chacan fait ce qu’iel veut et il est tout à fait légitime de chercher à se protéger soi-même selon ses propres termes, la généralisation de cette idée comme un outil de libération ne marche pas sur de nombreux plans."
                            },
                            {
                                "example_id": "ec6390ac-adc8-4187-b281-e7350311d802",
                                "sense_id": "1d4aa77c-f89a-3ea8-960f-1efdfc16f796",
                                "text": "Chacan peut prendre soin à sa manière, qu’elle est la vôtre ?"
                            },
                            {
                                "example_id": "9b1f5b50-a186-41d9-bb50-d6068b7997e7",
                                "sense_id": "1d4aa77c-f89a-3ea8-960f-1efdfc16f796",
                                "text": "Ce n’est pas au voisin, au médecin, à l’association Tartempion, au policier, au juge de décider qui chacun·e (chacan) est, ce qu’iel (al) ressent, ce qu’iel (al) exprime pour vivre au mieux."
                            }
                        ]
                    },
                    {
                        "sense_id": "1fbb4cb7-b802-35b1-ba43-c29a4d929483",
                        "entry_id": "1f0cc4f6-873b-36e6-a0f6-906c9ea4428a",
                        "glosses": [
                            "Toute personne qui que ce soit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0087933-ef6c-4ca6-9289-d65f64e244e3",
                                "sense_id": "1fbb4cb7-b802-35b1-ba43-c29a4d929483",
                                "text": "À chacan ses règles !"
                            },
                            {
                                "example_id": "76f94296-52ce-4b58-8e29-ddc174a7f7df",
                                "sense_id": "1fbb4cb7-b802-35b1-ba43-c29a4d929483",
                                "text": "À ce titre, chacan est capable de choisir le pronom avec lequel al souhaiterait être défini."
                            },
                            {
                                "example_id": "7eacad80-8185-4873-afda-ed7d57160434",
                                "sense_id": "1fbb4cb7-b802-35b1-ba43-c29a4d929483",
                                "text": "Cela dit, au delà de ces questions de définition, \"trans\" et \"non-binaire\" correspondent aussi à des identités, que chacan est libre de revendiquer, d’utiliser pour soi, ou non."
                            }
                        ]
                    }
                ],
