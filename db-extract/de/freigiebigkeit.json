                                    {
                                        "sense_id": "4e2ffbb1-cc5d-3db7-8baa-d24b13578184",
                                        "entry_id": "d0f6a1bd-27b8-374b-bb9c-4914c53ec1ca",
                                        "glosses": [
                                            "Disposition à être généreux, générosité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ddf9f36-7d5a-4c1e-b278-a8b201bcabf3",
                                                "sense_id": "4e2ffbb1-cc5d-3db7-8baa-d24b13578184",
                                                "text": "Profiter de la largesse de quelqu’un."
                                            },
                                            {
                                                "example_id": "47823470-44ce-4bea-8730-c23691617d4d",
                                                "sense_id": "4e2ffbb1-cc5d-3db7-8baa-d24b13578184",
                                                "text": "Il a montré dans cette occasion beaucoup de largesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae5902e1-2347-3f61-a6ef-fe4f3fe7e869",
                                        "entry_id": "d0f6a1bd-27b8-374b-bb9c-4914c53ec1ca",
                                        "glosses": [
                                            "Ce qu’on donne généreusement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a250f53-6049-48e0-8c4b-c3bff82ca293",
                                                "sense_id": "ae5902e1-2347-3f61-a6ef-fe4f3fe7e869",
                                                "text": "Faire de grandes largesses."
                                            },
                                            {
                                                "example_id": "ce6416aa-dcf3-426b-a3f9-238e1e4868aa",
                                                "sense_id": "ae5902e1-2347-3f61-a6ef-fe4f3fe7e869",
                                                "text": "Hélas pour ces cachottiers, « Le Canard » a pu fourrer son bec dans le document et constater l’ampleur des largesses concédées aux sociétés d’autoroutes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
