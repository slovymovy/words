                    },
                    {
                        "sense_id": "4072bfa6-f2f2-39ee-8991-2a923662862b",
                        "entry_id": "594668c4-4692-3bcb-86f6-423533af263f",
                        "glosses": [
                            "A female given name transferred from the surname."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f014cf5-bdb6-422a-8e2e-bc92b4c03214",
                                "sense_id": "4072bfa6-f2f2-39ee-8991-2a923662862b",
                                "text": "\"That's her real name, you know. I mean, a lot of girls working the topless joints, they take exotic, sexy names...well, Tiffany Carter, for example...but that was the name Tracy was born with.\""
                            },
                            {
                                "example_id": "cad0577a-2d4d-41fa-ac47-bdd58a409284",
                                "sense_id": "4072bfa6-f2f2-39ee-8991-2a923662862b",
                                "text": "Tiffany Henyard’s tumultuous tenure as mayor of south suburban Dolton is coming to an end, and voters were very clear about ousting her."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "355a50cf-6e71-4f49-8765-b9d48281ff10",
                        "source_entry_id": "594668c4-4692-3bcb-86f6-423533af263f",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Tiphaine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tiphaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "263a5105-e744-390a-967e-7fbc8ee1d1e9",
                                        "entry_id": "b4add997-77e5-3532-bf86-d5f34d95b7a3",
                                        "glosses": [
                                            "Prénom (rarement) masculin ou (majoritairement) féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "380fe1b8-ce26-4790-8987-87c75facf1c6",
                                                "sense_id": "263a5105-e744-390a-967e-7fbc8ee1d1e9",
                                                "text": "Chuis avec Tiphaine, c’est ma meuf, tu vois, putain de ta race, j’l’ai dans l’bide, c plus fort que moi, j’la kiffe trop, elle est trop mortelle."
                                            },
                                            {
                                                "example_id": "8f3506d1-bfe9-492a-9ce8-fbf922619ef3",
                                                "sense_id": "263a5105-e744-390a-967e-7fbc8ee1d1e9",
                                                "text": "Le duo Tiphaine Daviot (Léa) et Manon Azem (Manon) a été une évidence quand nous avons fait les essais ensemble."
                                            },
                                            {
                                                "example_id": "9db6561b-6517-4b0f-9d0d-59ec7389e157",
                                                "sense_id": "263a5105-e744-390a-967e-7fbc8ee1d1e9",
                                                "text": "À 17 h 30, le concert de Tiphaine Escarguel, à la harpe celtique, et de Riuxan Liu, au violon, conclura le pardon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
