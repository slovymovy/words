                        "entry_id": "6d593e8c-36b5-3b41-9d23-b6334c4b89c6",
                        "glosses": [
                            "a male given name, Boris, equivalent to English Boris"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c775582-6ed2-46b5-8456-db10006f2a22",
                                "sense_id": "073fcacd-0658-30cd-8a27-d43aef430e6a",
                                "text": "Бори́с осторо́жно улыбну́лся так, что его́ улы́бка могла́ быть отнесена́ к насме́шке и́ли к одобре́нию шу́тки, смотря́ по тому́, как она́ бу́дет принята́.",
                                "translation": "Boris smiled circumspectly, so that it might be taken as ironical or appreciative according to the way the joke was received.",
                                "english": "Boris smiled circumspectly, so that it might be taken as ironical or appreciative according to the way the joke was received."
                            }
                        ]
                    }
