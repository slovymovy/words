                "forms": [
                    {
                        "form_id": "ff7a7d33-94f4-4d68-8096-0530164eb900",
                        "entry_id": "fa1ba1ae-1ae4-3730-b56d-e4878969838b",
                        "tags": [
                            "plural"
                        ],
                        "form": "hippomobiles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a115eaa8-d9a9-3230-99fa-8bf1cf58e853",
                        "entry_id": "fa1ba1ae-1ae4-3730-b56d-e4878969838b",
                        "glosses": [
                            "Véhicule tracté par des chevaux."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "8ba62d6b-c60f-4b3d-9ba1-967475af3705",
                                "sense_id": "a115eaa8-d9a9-3230-99fa-8bf1cf58e853",
                                "text": "[Une voiture électrique] est beaucoup moins encombrante, car elle n’occupe sur la chaussée qu’un peu plus de la moitié de la longueur nécessaire à une hippomobile."
                            },
                            {
                                "example_id": "6c7a76dc-29ea-4d91-bdaa-1278c3426c65",
                                "sense_id": "a115eaa8-d9a9-3230-99fa-8bf1cf58e853",
                                "text": "Comparées aux hippomobiles et aux automobiles à vapeur ou à essence de pétrole, les accumobiles présentent des avantages, des qualités équivalentes et des inconvénients que nous avons le devoir de faire impartialement ressortir."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
