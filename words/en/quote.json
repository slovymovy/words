                                "target_lang_word": "报价单",
                                "target_lang_sense_clarification": "书面的价格建议"
                            },
                            {
                                "target_lang_word": "估价",
                                "target_lang_sense_clarification": "预估的费用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54d52400-c170-3954-b66d-6a600e176498",
                    "sense_definition": "A price set and offered for a financial security or commodity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "commercial_price",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest <w>quote</w> for the company's stock showed a slight increase.",
                            "target_lang_translations": {
                                "ru": "Последняя <w>котировка</w> акций компании показала небольшой рост.",
                                "tr": "Şirket hissesi için son <w>piyasa fiyatı</w> hafif bir artış gösterdi.",
                                "zh": "该公司股票的最新<w>报价</w>显示有小幅上涨。"
                            }
                        },
                        {
                            "text": "Traders watched the screen for the newest oil <w>quotes</w>.",
                            "target_lang_translations": {
                                "ru": "Трейдеры следили за экраном в ожидании новейших <w>котировок</w> нефти.",
                                "tr": "Tüccarlar en yeni petrol <w>fiyatlarını</w> görmek için ekranı izledi.",
                                "zh": "交易员们盯着屏幕查看最新的石油<w>行情</w>。"
                            }
                        }
                    ],
