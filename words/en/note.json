    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f737588-38df-3971-8ac1-16a895e52b64",
                    "sense_definition": "A short letter or a brief record written down to assist the memory.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "writing_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I left a <w>note</w> on the fridge to remind him about dinner.",
                            "target_lang_translations": {
                                "ru": "Я оставил <w>записку</w> на холодильнике, чтобы напомнить ему об ужине.",
                                "zh": "我在冰箱上留了一张<w>便条</w>，提醒他吃晚饭。"
                            }
                        },
                        {
                            "text": "She wrote a quick <w>note</w> to thank them for the gift.",
                            "target_lang_translations": {
                                "ru": "Она написала короткую <w>записку</w>, чтобы поблагодарить их за подарок.",
                                "zh": "她写了一张简短的<w>便条</w>感谢他们的礼物。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "leave a note",
                        "write a note",
                        "thank-you note",
                        "sticky note"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое письмо или запись, сделанная для памяти.",
                        "zh": "简短的信件或为辅助记忆而写下的记录。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "записка",
                                "target_lang_sense_clarification": "короткое сообщение"
                            },
                            {
                                "target_lang_word": "заметка",
                                "target_lang_sense_clarification": "краткая запись"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "便条",
                                "target_lang_sense_clarification": "简短的留言"
                            },
                            {
                                "target_lang_word": "笔记",
                                "target_lang_sense_clarification": "记录下来的要点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c71c6298-a9d0-30a3-8ea1-b4e56f4cd624",
                    "sense_definition": "A piece of paper money.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He paid for the coffee with a ten-pound <w>note</w>.",
                            "target_lang_translations": {
                                "ru": "Он заплатил за кофе десятифунтовой <w>банкнотой</w>.",
                                "zh": "他用一张十英镑的<w>纸币</w>付了咖啡钱。"
                            }
                        },
                        {
                            "text": "I do not have any coins, only a large <w>note</w>.",
                            "target_lang_translations": {
                                "ru": "У меня нет монет, только крупная <w>купюра</w>.",
                                "zh": "我没有硬币，只有一张大面额<w>钞票</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bill"
                    ],
                    "common_phrases": [
                        "ten-pound note",
                        "bank note"
                    ],
                    "traits": [
