                                    {
                                        "sense_id": "9885a9a4-aec9-3dfa-baec-f155f0a4ba90",
                                        "entry_id": "3088ac88-462e-3a83-a605-677ed6ce7911",
                                        "glosses": [
                                            "przyrząd do ustalania tempa utworu muzycznego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7de3444f-e29f-46a0-a6b1-2828d071586e",
                                                "sense_id": "9885a9a4-aec9-3dfa-baec-f155f0a4ba90",
                                                "text": "Często wydaje mi się, że metronom zaczyna przyspieszać w częściach utworu, których nie umiem."
                                            },
                                            {
                                                "example_id": "6ba1c218-91df-4efc-83c6-f001890bbeae",
                                                "sense_id": "9885a9a4-aec9-3dfa-baec-f155f0a4ba90",
                                                "text": "Oprócz klasycznych metronomów z wahadłem produkowane są także elektroniczne. Pierwsze z nich trzeba od czasu do czasu nakręcać, do drugich potrzeba tylko baterii."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bf1ae66-7091-4d4c-a0a5-82c80a420861",
                        "source_entry_id": "7ec8d223-95c8-3d4e-82eb-79e2a8876b73",
