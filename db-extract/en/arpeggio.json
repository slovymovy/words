                "senses": [
                    {
                        "sense_id": "ac4d00fa-1ab1-3f17-a4e8-9ecf93fb9b7d",
                        "entry_id": "50080332-9562-3d7f-a0b4-6b77b55322c5",
                        "glosses": [
                            "The notes of a chord played individually instead of simultaneously, usually moving from lowest to highest."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa14e95d-d114-4d24-ab12-8428da9c4c67",
                                "sense_id": "ac4d00fa-1ab1-3f17-a4e8-9ecf93fb9b7d",
                                "text": "He struck the opening chords of the passage; but this time Irene's voice was silent. Victor stopped in the middle of an arpeggio."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24dfeeba-363e-44e3-b34b-9261580e3466",
                        "source_entry_id": "50080332-9562-3d7f-a0b4-6b77b55322c5",
                        "source_sense_id": "ac4d00fa-1ab1-3f17-a4e8-9ecf93fb9b7d",
                        "source_sense_description": "notes of a chord played individually",
                        "target_lang_word": "arpège",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arpège",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10c05cb5-51d8-37ee-8c8e-792967005268",
                                        "entry_id": "841d9c44-4406-3638-b87e-05a0f8231eb5",
                                        "glosses": [
                                            "Accord dont on fait entendre successivement les notes, au lieu de les frapper toutes à la fois comme dans l’accord plaqué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e26099a-df3e-499b-84bc-0d24a776c043",
                                                "sense_id": "10c05cb5-51d8-37ee-8c8e-792967005268",
                                                "text": "Le diable musique, ce démon qui secoue un trousseau étincelant de strettes, de trilles et d’arpèges, se fut emparé du pauvre sourd."
                                            },
                                            {
                                                "example_id": "c6788477-e893-4066-9122-b6a948bfd6d2",
                                                "sense_id": "10c05cb5-51d8-37ee-8c8e-792967005268",
                                                "text": "Monk appuie souvent ses solos sur des arpèges, c’est-à-dire sur des notes constitutives d’accords, égrenés l’une à la suite de l’autre, et non sur les fameuses gammes et phrases bebop qui font maintenant irruption dans l’improvisation."
                                            },
                                            {
                                                "example_id": "07b14c67-f797-4232-977c-317b36542e6f",
                                                "sense_id": "10c05cb5-51d8-37ee-8c8e-792967005268",
                                                "text": "Jamais on n’attrapera Monk à faire ces arpèges en guimauve dont les pianistes sont si friands, qui se finissent à l’extrémité du clavier, et qui les transforment momentanément en harpistes."
                                            },
                                            {
                                                "example_id": "e0b9cf57-9957-455b-a8d5-b694a64f949e",
                                                "sense_id": "10c05cb5-51d8-37ee-8c8e-792967005268",
                                                "text": "Un chat qui parcourt un clavier exécute couramment un arpège correct, et s’il s’assoit, il a beaucoup de chances pour frapper un accord parfait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36582834-1f36-3a62-b314-c507d698143d",
                                        "entry_id": "841d9c44-4406-3638-b87e-05a0f8231eb5",
                                        "glosses": [
                                            "Suite musicale de sons arrangés."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f603ea49-0411-42b5-8cd1-4969fe7a3a35",
                                                "sense_id": "36582834-1f36-3a62-b314-c507d698143d",
                                                "text": "Nous voulions l’arpège. Le chant. Le gazouillis des mots."
                                            }
                                        ]
                                    }
                                ]
                            },
