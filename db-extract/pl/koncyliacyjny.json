                        "sense_id": "14b0da37-9e99-3124-8fc0-03c7a00641fe",
                        "entry_id": "eae684e4-e873-3439-a957-a6f283e693d7",
                        "glosses": [
                            "odnoszący się do koncyliacji, skłonny do koncyliacji"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "c29d7191-28fa-4a41-91bf-8a203d3edd78",
                                "sense_id": "14b0da37-9e99-3124-8fc0-03c7a00641fe",
                                "text": "Oznaczało to akceptację, z niewielkimi korektami, propozycji reform przedstawianych przez najsilniejsze państwa członkowskie w celu kreacji wizerunku partnera koncyliacyjnego oraz dbającego o interes wspólnotowy."
                            },
                            {
                                "example_id": "8af85240-8670-4a1f-a0cf-985edf03901e",
                                "sense_id": "14b0da37-9e99-3124-8fc0-03c7a00641fe",
                                "text": "Ciekawe też, jaką reakcję wywoła nowy, koncyliacyjny wizerunek prezesa PiS."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
