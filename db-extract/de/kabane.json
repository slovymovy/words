                                "example_id": "1f56d13f-60a8-41af-8f48-5c99ed957dde",
                                "sense_id": "3b8b56e5-f48a-3a73-8cb8-23f5c12e9fe2",
                                "text": "„Im Gänsehäufel beträgt die Wartezeit für eine eigene Kabane derzeit übrigens sechs Jahre.“"
                            },
