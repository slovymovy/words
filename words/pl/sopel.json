{
    "word_family": [
        "sopelek",
        "soplowy",
        "sopelkowaty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "45dec8cc-15f4-3eb3-b33d-bd4dde6905bd",
                    "sense_definition": "podłużny, zwężający się ku dołowi kawałek lodu zwisający z dachu, gałęzi lub innej krawędzi",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zjawiska_atmosferyczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z krawędzi dachu zwisały długie, ostre <w>sople</w>, które mogły spaść na chodnik.",
                            "target_lang_translations": {
                                "ru": "С края крыши свисали длинные острые <w>сосульки</w>, которые могли упасть на тротуар."
                            }
                        },
                        {
                            "text": "Dzieci z radością strącały patykami przezroczyste <w>sople</w> lodu z pobliskich gałęzi.",
                            "target_lang_translations": {
                                "ru": "Дети с радостью сбивали палками прозрачные ледяные <w>сосульки</w> с соседних веток."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sopel lodu",
                        "zwisający sopel"
                    ],
                    "target_lang_definitions": {
                        "ru": "удлинённый, сужающийся книзу кусок льда, свисающий с крыши, ветки или другого края"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сосулька",
                                "target_lang_sense_clarification": "кусок льда удлинённой формы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36a96e44-9b25-390c-b940-52e9a2ef75e5",
                    "sense_definition": "odmiana rzodkwi białej o wydłużonym, ostro zakończonym kształcie",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rosliny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wiosną kupiłem na targu chrupki <w>sopel</w>, który idealnie pasował do świeżej sałatki.",
                            "target_lang_translations": {
                                "ru": "Весной я купил на рынке хрустящий <w>дайкон</w>, который идеально подошёл для свежего салата."
                            }
                        },
                        {
                            "text": "Biały <w>sopel</w> jest popularnym warzywem korzeniowym w wielu tradycyjnych potrawach.",
                            "target_lang_translations": {
                                "ru": "Белая <w>редька-сосулька</w> является популярным корнеплодом во многих традиционных блюдах."
                            }
                        }
                    ],
                    "synonyms": [
                        "rzodkiew japońska",
                        "daikon"
                    ],
                    "common_phrases": [
                        "biały sopel"
                    ],
                    "target_lang_definitions": {
                        "ru": "сорт белой редьки или дайкона вытянутой, заострённой формы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дайкон",
                                "target_lang_sense_clarification": "белая удлинённая редька"
                            },
                            {
                                "target_lang_word": "белая редька",
                                "target_lang_sense_clarification": "овощ сорта удлинённой формы"
                            },
                            {
                                "target_lang_word": "сосулька",
                                "target_lang_sense_clarification": "название сорта белой редьки или редиса"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "cbb67099-59e8-3abc-9da7-982a65470756",
                    "sense_definition": "polskie nazwisko męskie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nazwiska",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Sopel</w> otworzył nowy warsztat samochodowy tuż przy głównej ulicy.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Сопель</w> открыл новую автомастерскую прямо у главной улицы."
                            }
                        },
                        {
                            "text": "Wczoraj spotkałem pana <w>Sopla</w>, który opowiadał o swoich dawnych podróżach.",
                            "target_lang_translations": {
                                "ru": "Вчера я встретил господина <w>Сопеля</w>, который рассказывал о своих былых путешествиях."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko męskie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская мужская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сопель",
                                "target_lang_sense_clarification": "мужская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d59765a5-c2c6-3a7e-9791-e0a5a3a71482",
                    "sense_definition": "polskie nazwisko żeńskie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nazwiska",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani <w>Sopel</w> została wybrana na przewodniczącą lokalnego komitetu mieszkańców.",
                            "target_lang_translations": {
                                "ru": "Госпожа <w>Сопель</w> была избрана председателем местного комитета жителей."
                            }
                        },
                        {
                            "text": "Rozmawiałem wczoraj z doktor <w>Sopel</w> o wynikach moich ostatnich badań.",
                            "target_lang_translations": {
                                "ru": "Вчера я говорил с доктором <w>Сопель</w> о результатах моих последних анализов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko żeńskie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская женская фамилия"
                    },
                    "translations": {
