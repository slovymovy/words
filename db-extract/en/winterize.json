                        "glosses": [
                            "To prepare (something) for winter weather."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "564c5685-6851-487c-92f2-5e427210533f",
                                "sense_id": "5dbc54e8-3bf3-3a04-97c5-e2f21558c979",
                                "text": "Temperatures are expected to plummet over the weekend, and aside from grabbing a coat, experts say there’s some things you should do to winterize your home."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f6e690c-375c-31c8-98d2-57e317659cb9",
                        "entry_id": "9a7b9a2d-b2ef-3b75-bfce-ce62dfa5714a",
                        "glosses": [
                            "To remove the saturated fats from (a vegetable oil) by cooling and filtering it, so that it does not become cloudy in the winter."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
