                        "examples": [
                            {
                                "example_id": "a91222f2-2541-4bfa-8557-a65c97ee0e95",
                                "sense_id": "981ca6d1-0d59-320a-8875-7f77a5b8b6d0",
                                "text": "„Sie tunkten dicke Brotscheiben mit einer großzügig aufgetragenen Schicht salziger Butter in die Suppe.“"
                            },
                            {
                                "example_id": "de89e7fa-4cd8-4fd7-9c92-f06aef083896",
                                "sense_id": "981ca6d1-0d59-320a-8875-7f77a5b8b6d0",
                                "text": "„Der Gefreite schneidet die dicke Brotscheibe in kleine Häppchen mit dem Taschenmesser, das er vorher an seiner Hose abwischt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
