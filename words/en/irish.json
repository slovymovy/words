                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend <w>Irish</w> is coming to visit next week.",
                            "target_lang_translations": {
                                "ru": "Моя подруга <w>Айриш</w> приедет в гости на следующей неделе.",
                                "zh": "我的朋友<w>艾里什</w>下周要来拜访。"
                            }
                        },
                        {
                            "text": "<w>Irish</w> was very happy to receive the award.",
                            "target_lang_translations": {
                                "ru": "<w>Айриш</w> была очень рада получить награду.",
                                "zh": "<w>艾里什</w>很高兴能获得这个奖项。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly Philippines"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя, используемое преимущественно на Филиппинах.",
                        "zh": "主要在菲律宾使用的女性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Айриш",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "艾里什",
                                "target_lang_sense_clarification": "女性名字"
                            }
                        ]
                    }
                }
            ]
        },
        {
