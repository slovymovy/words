                    {
                        "sense_id": "3e520313-49c5-3721-8f1c-c9604ea06414",
                        "entry_id": "b2acdd25-3f7b-35d4-a264-2c8d94e91ae5",
                        "glosses": [
                            "rdzenny mieszkaniec północnej Afryki i Sahary pochodzenia chamito-semickiego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b768de3-4955-42ef-beec-a905b234120a",
                                "sense_id": "3e520313-49c5-3721-8f1c-c9604ea06414",
                                "text": "Berberowie stanowią w większości odrębny typ somatyczny w ramach rasy białej, nazywany w nauce berberyjskim"
                            },
                            {
                                "example_id": "8166eeda-24bb-4760-89e7-43f3ed37d91e",
                                "sense_id": "3e520313-49c5-3721-8f1c-c9604ea06414",
                                "text": "Sam na pytanie, kim jestem, Berberem czy Arabem odpowiadam: Jestem Algierczykiem"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
