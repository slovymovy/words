                "senses": [
                    {
                        "sense_id": "1de4cf79-3696-33b5-aa45-05e76227e11a",
                        "entry_id": "e2b919ba-0727-3d64-912c-3e2a64d66b19",
                        "glosses": [
                            "trwający osiem dni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e62449f0-e1cb-4537-bf46-dfc6e22598c1",
                                "sense_id": "1de4cf79-3696-33b5-aa45-05e76227e11a",
                                "text": "Młodzież pojedzie na ośmiodniowy obóz do Okuninki w województwie lubelskim"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
