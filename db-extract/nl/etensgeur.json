                        "examples": [
                            {
                                "example_id": "3d20d756-e103-4aa5-a5e6-67a57536d2ae",
                                "sense_id": "f4dc3194-2932-3317-aab0-4bd819466d40",
                                "text": "De weg vragen naar het restaurant is in De Ankerplaats niet nodig. Pianomuziek klinkt vanaf de eerste verdieping door in de centrale hal. Boven aan de trap hangt een heerlijke etensgeur."
                            },
                            {
                                "example_id": "dd8e9142-36b3-41d5-8b07-cfb9f77ae8a6",
                                "sense_id": "f4dc3194-2932-3317-aab0-4bd819466d40",
                                "text": "Hoewel het afvalprobleem de laatste jaren alleen maar lijkt te zijn toegenomen, speelt het al lang. Martine: “Er is altijd een groep mensen geweest die alleen op zichzelf is gefocust. Mensen die een sigaret of milkshakebeker gewoon weggooien zonder over de gevolgen na te denken. Een milkshakebeker heeft bijvoorbeeld een etensgeur die veel dieren aantrekt. Die proberen het eten eruit te halen, maar hebben vervolgens een grote kans dat ze stikken in het plastic.”"
                            }
                        ]
