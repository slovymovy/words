                "senses": [
                    {
                        "sense_id": "238290cd-59d2-3fec-ad01-d7b0fb8c1e78",
                        "entry_id": "e6a36e25-3097-3054-8908-31552f73c24e",
                        "glosses": [
                            "Räumung einer Wohnung, einschließlich der dazugehörigen Nebenräume wie Keller und Dachboden vom Hausrat des Wohnungsinhabers, die damit verbunden ist, dass der Wohnungsinhaber danach keinen eigenen Haushalt mehr führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "332dd5e7-57f2-4f10-b564-a0905b9f5409",
                                "sense_id": "238290cd-59d2-3fec-ad01-d7b0fb8c1e78",
                                "text": "„Bei einer Haushaltsauflösung habe das Bild dann den Besitzer gewechselt.“"
                            },
                            {
                                "example_id": "1df5679f-5b01-4f4d-a9dc-94acdaaf73fd",
                                "sense_id": "238290cd-59d2-3fec-ad01-d7b0fb8c1e78",
                                "text": "„Wer bei einem Umzug oder einer Haushaltsauflösung noch D-Mark findet, kann diese bei der Bundesbank in Euro tauschen.“"
                            },
                            {
                                "example_id": "ce81d237-da6a-408a-ae9f-ce565f2a08c5",
                                "sense_id": "238290cd-59d2-3fec-ad01-d7b0fb8c1e78",
                                "text": "„Dort restaurierte ich die alten Handschriften, Manuskripte und Karten, die ich im Internet oder auf meinen Jagden durch Altbestände, Haushaltsauflösungen, Antiquariate und Nachlässe ausfindig machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
