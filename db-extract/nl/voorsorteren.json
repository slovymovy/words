        "nl-extract.jsonl": [
            {
                "entry_id": "850998f0-c3e4-3912-b107-db29e3df11a1",
                "word": "voorsorteren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0c592d1d-bfbc-34bc-832d-32b93ea02a6d",
                        "entry_id": "850998f0-c3e4-3912-b107-db29e3df11a1",
                        "glosses": [
                            "het kiezen van een bepaalde rijstrook, ook wel vak genoemd, voordat een voertuig op een kruispunt of verkeersknooppunt van richting verandert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f83d0b33-402b-4726-8845-3b7148676064",
                                "sense_id": "0c592d1d-bfbc-34bc-832d-32b93ea02a6d",
                                "text": "De gehele rijbaan moest vanwege de werkzaamheden worden opengebroken. Op het nieuwe kruispunt Hazewinkelweg – Jufferbeek Zuid is een nieuwe middengeleider aangebracht. Hierdoor kan het verkeer richting het nieuwe bedrijventerrein nu voorsorteren. De nieuwe kruising fungeert tegelijkertijd als nieuwe ingang naar het gemeentelijke gronddepot."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c8d2a74-3bf9-3288-819d-6dd88bbf56a6",
                        "entry_id": "850998f0-c3e4-3912-b107-db29e3df11a1",
                        "glosses": [
                            "al bij aanvang van een proces al een voorlopige sortering maken"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f381cde1-0c42-36d9-b20a-9a905c7b125f",
                        "entry_id": "850998f0-c3e4-3912-b107-db29e3df11a1",
                        "glosses": [
                            "alvast maatregelen nemen als voorbereiding op een toekomstige beslissing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c1b12d7-2a89-4ee4-9b37-19637b376f10",
                                "sense_id": "f381cde1-0c42-36d9-b20a-9a905c7b125f",
                                "text": "Afgelopen voorjaar bereikte de KSE100 index in Pakistan een all-time-high. De aandelenmarkt had de wind in de rug door aankopen van lokale beleggers die voorsorteerden op de promotie van Frontier (FM) naar Emerging Market (EM) status. Met deze upgrade, die in juni effectief werd, zou het land in de belangstelling komen van een grotere groep beleggers."
                            },
                            {
                                "example_id": "6abe16c2-8efc-46a6-8fbc-994caa495fd6",
                                "sense_id": "f381cde1-0c42-36d9-b20a-9a905c7b125f",
                                "text": "De Maar stelde vast dat de obligatiemarkten al voorsorteren op een hoger renteniveau op langere termijn. \"Maar je ziet dat de aandelenmarkten er nog onvoldoende mee hebben gedaan.\""
                            }
                        ]
                    }
                ],
