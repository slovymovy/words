                ],
                "senses": [
                    {
                        "sense_id": "9c0470d0-5740-3d76-a9ed-9c2eb8f69aaf",
                        "entry_id": "0a580407-06c8-3fad-a5f2-b750558e089f",
                        "glosses": [
                            "Donner un caractère biphasé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cfd6f2b-64d0-491e-8f3f-b09da1ac4a4e",
                                "sense_id": "9c0470d0-5740-3d76-a9ed-9c2eb8f69aaf",
                                "text": "On a cherché à biphaser les courants alternatifs simples, soit afin d'utiliser pour la distribution de la force les installations d'éclairage par courant monophasé, soit à cause de la simplicité que présenteraient les installations mixtes de distribution de lumière et de force, au moyen de courants monophasés."
                            },
                            {
                                "example_id": "7d654b80-cf1f-42fc-a972-28811f0e6519",
                                "sense_id": "9c0470d0-5740-3d76-a9ed-9c2eb8f69aaf",
                                "text": "Nos dirigeants croient vraiment au père Noël et se trompent de cible pour nous biphaser sur le monde."
                            },
                            {
                                "example_id": "a2049557-4bbc-4622-915d-7f2fc0127c47",
                                "sense_id": "9c0470d0-5740-3d76-a9ed-9c2eb8f69aaf",
                                "text": "J'insiste sur le fait de laisser la préparation prendre avant de passer à la meringue, sinon la chaleur du four fait biphaser."
                            },
                            {
                                "example_id": "bd46d623-806a-448a-86e2-ace04875252f",
                                "sense_id": "9c0470d0-5740-3d76-a9ed-9c2eb8f69aaf",
                                "text": "Les fond de teints liquides peuvent se biphaser (dans ce cas il suffit de secouer), et sécher selon l’environnement où ils sont entreposés (chaleur, humidité) et si le contenant n’est pas suffisamment hermétique, ils peuvent se garder 18 mois environ voir 2 ans."
                            }
                        ]
                    }
