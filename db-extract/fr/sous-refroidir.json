                ],
                "senses": [
                    {
                        "sense_id": "5367fd01-b4c7-32c5-99ee-3f3fe86d5d3c",
                        "entry_id": "31abd37c-7ca9-3c66-a8f5-4bb2c5966a78",
                        "glosses": [
                            "Refroidir excessivement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b30c8373-3e31-49aa-91a4-a4435f66ea48",
                                "sense_id": "5367fd01-b4c7-32c5-99ee-3f3fe86d5d3c",
                                "text": "Il ne faut pas sous-refroidir le bâtiment, pour ne pas créer d'inconfort lors de l'arrivée des occupants, le matin."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a22c1ca-f916-312c-beeb-31c0ec25f409",
                        "entry_id": "31abd37c-7ca9-3c66-a8f5-4bb2c5966a78",
                        "glosses": [
                            "Refroidir par un sous-refroidissement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82fa3d48-d21f-4375-937f-04a25ab715ae",
                                "sense_id": "9a22c1ca-f916-312c-beeb-31c0ec25f409",
                                "text": "Un échangeur liquide-vapeur permet de sous-refroidir le liquide avant la détente et de surchauffer les vapeurs à la sortie de Févaporateur."
                            },
                            {
                                "example_id": "380e1a2d-75a4-4178-8427-65e482e32a20",
                                "sense_id": "9a22c1ca-f916-312c-beeb-31c0ec25f409",
                                "text": "Comme cela est bien connu, pour sous-refroidir le frigorigène, il doit être à l'état complètement liquide."
                            },
                            {
                                "example_id": "c535edd7-238a-4231-98af-ecab687d05d2",
                                "sense_id": "9a22c1ca-f916-312c-beeb-31c0ec25f409",
                                "text": "Dispositif selon l'une des revendications précédentes, en outre avec un accumulateur vertical (51 à 60), pour stocker les pièces d'assemblage à sous-refroidir."
                            }
                        ]
                    }
