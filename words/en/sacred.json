{
    "word_family": [
        "sacredly",
        "sacredness",
        "sacral",
        "sacrament",
        "sacrifice",
        "sacrilege",
        "sacristy",
        "consecrate",
        "desecrate"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3bfdb8df-e8f4-3581-b861-a8708beb8783",
                    "sense_definition": "Connected with God or a god, or dedicated to a religious purpose and so deserving veneration.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monks gathered at the <w>sacred</w> site to perform their daily prayers.",
                            "target_lang_translations": {
                                "ru": "Монахи собрались в <w>священном</w> месте, чтобы совершить свои ежедневные молитвы."
                            }
                        },
                        {
                            "text": "Cows are considered a <w>sacred</w> animal in some cultures and are treated with great respect.",
                            "target_lang_translations": {
                                "ru": "В некоторых культурах коровы считаются <w>священными</w> животными, и к ним относятся с большим уважением."
                            }
                        }
                    ],
                    "synonyms": [
                        "holy",
                        "hallowed",
                        "consecrated",
                        "divine"
                    ],
                    "antonyms": [
                        "unholy",
                        "profane"
                    ],
                    "common_phrases": [
                        "sacred site",
                        "sacred ground",
                        "sacred text"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с Богом или божеством, посвященный религиозным целям и заслуживающий почитания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "священный",
                                "target_lang_sense_clarification": "обладающий святостью"
                            },
                            {
                                "target_lang_word": "святой",
                                "target_lang_sense_clarification": "относящийся к божественному"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34d8d1aa-72e0-3c22-8459-2d847e507db9",
                    "sense_definition": "Relating to religion or religious ceremonies rather than to secular life.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The choir performed a beautiful program of <w>sacred</w> music in the cathedral.",
                            "target_lang_translations": {
                                "ru": "Хор исполнил прекрасную программу <w>духовной</w> музыки в соборе."
                            }
                        },
                        {
                            "text": "The library contains a vast collection of <w>sacred</w> song books from the Middle Ages.",
                            "target_lang_translations": {
                                "ru": "В библиотеке хранится обширная коллекция книг <w>религиозных</w> песнопений эпохи Средневековья."
                            }
                        }
                    ],
                    "synonyms": [
                        "godly",
                        "divine"
                    ],
                    "antonyms": [
                        "profane"
                    ],
                    "common_phrases": [
                        "sacred music",
                        "sacred song"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к религии или религиозным обрядам, а не к светской жизни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "духовный",
                                "target_lang_sense_clarification": "о музыке или литературе"
                            },
                            {
                                "target_lang_word": "религиозный",
                                "target_lang_sense_clarification": "связанный с культом"
                            },
                            {
                                "target_lang_word": "священный",
                                "target_lang_sense_clarification": "относящийся к обрядам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a69dec5-02a5-3181-b8fb-9392389388f1",
                    "sense_definition": "Regarded with such great respect and reverence that it must not be changed or violated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inviolable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For many people, the right to free speech is a <w>sacred</w> duty that must be protected.",
                            "target_lang_translations": {
                                "ru": "Для многих людей право на свободу слова — это <w>священный</w> долг, который необходимо защищать."
                            }
                        },
                        {
                            "text": "The confidentiality between a doctor and a patient is considered a <w>sacred</w> trust.",
                            "target_lang_translations": {
                                "ru": "Конфиденциальность между врачом и пациентом считается вопросом <w>святого</w> доверия."
                            }
                        }
                    ],
                    "synonyms": [
                        "inviolable",
                        "sacrosanct"
                    ],
                    "common_phrases": [
                        "sacred duty",
                        "sacred trust"
                    ],
                    "target_lang_definitions": {
                        "ru": "Почитаемый с таким глубоким уважением, что он не должен изменяться или нарушаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "священный",
                                "target_lang_sense_clarification": "неприкосновенный"
                            },
                            {
                                "target_lang_word": "незыблемый",
                                "target_lang_sense_clarification": "не подлежащий изменению"
                            },
                            {
                                "target_lang_word": "святой",
                                "target_lang_sense_clarification": "о долге или праве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9078b896-32b9-3c81-9834-2556bf3cb805",
                    "sense_definition": "Solemnly devoted to evil, a curse, or destruction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cursed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient ruins were whispered to be <w>sacred</w> to destruction and dark spirits.",
                            "target_lang_translations": {
                                "ru": "Шептались, что древние руины были <w>обречены</w> на разрушение и власть темных духов."
                            }
                        },
                        {
                            "text": "In the old poem, the villain was described as a <w>sacred</w> and devoted soul to vengeance.",
                            "target_lang_translations": {
                                "ru": "В старинной поэме злодей описывался как душа, <w>проклятая</w> и преданная мести."
                            }
                        }
                    ],
                    "antonyms": [
                        "cursed",
                        "damned"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a negative sense of being accursed"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Торжественно обреченный на зло, проклятие или уничтожение (архаичное значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проклятый",
                                "target_lang_sense_clarification": "обреченный на гибель"
                            },
                            {
                                "target_lang_word": "посвященный",
                                "target_lang_sense_clarification": "отданный во власть зла"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "074e0edd-8375-3c4f-9155-8b60b858faf5",
                    "sense_definition": "Simple past and past participle of <w>sacre</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king was <w>sacred</w> at the altar in a ceremony that lasted several hours.",
                            "target_lang_translations": {
                                "ru": "Король был <w>освящен</w> у алтаря во время церемонии, длившейся несколько часов."
                            }
                        },
                        {
                            "text": "Having been <w>sacred</w> by the bishop, the new priest began his ministry.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>посвященным</w> епископом, новый священник начал свое служение."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "The verb 'sacre' is rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от устаревшего глагола 'sacre' (освящать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освященный",
                                "target_lang_sense_clarification": "прошедший обряд освящения"
                            },
                            {
                                "target_lang_word": "посвященный",
                                "target_lang_sense_clarification": "в сан или духовное звание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}