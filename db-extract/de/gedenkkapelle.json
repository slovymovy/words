                "senses": [
                    {
                        "sense_id": "73c0a73e-7153-3c46-9899-2263fbccc7f5",
                        "entry_id": "2b47a531-0353-3097-b41e-bf4e0008974a",
                        "glosses": [
                            "im kirchlichen Baustil gestaltete, kleine Kapelle, die für Andachten zum Gedenken an jemanden oder etwas erbaut wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2399303d-a5c9-4496-9d9f-1ff6d927cdfa",
                                "sense_id": "73c0a73e-7153-3c46-9899-2263fbccc7f5",
                                "text": "„Zu Fuß erreichen Sie die Gedenkkapelle bequem vom Ortszentrum von Peiting über den Grottenweg der Mariengrotte – dort rechts ab zur Vertriebenenenkapelle oder Sie fahren mit dem Auto zum Parkplatz am Schützenhaus am Sonnenbichl.“"
                            },
                            {
                                "example_id": "fc7ce1c1-89fd-4ab8-8c73-408436777377",
                                "sense_id": "73c0a73e-7153-3c46-9899-2263fbccc7f5",
                                "text": "„Im September 2000 wurde in unmittelbarer Nähe zum Gräberfeld eine Gedenkkapelle eingeweiht.“"
                            },
                            {
                                "example_id": "c8b9afaa-25ad-4b38-afab-4b3928b7babe",
                                "sense_id": "73c0a73e-7153-3c46-9899-2263fbccc7f5",
                                "text": "„Zentrum dieser Gedenkkapelle ist das Grab von Dompropst Bernhard Lichtenberg.“"
                            },
                            {
                                "example_id": "6e55ce78-14f4-4102-bad3-2da8ff03a9d7",
                                "sense_id": "73c0a73e-7153-3c46-9899-2263fbccc7f5",
                                "text": "„Gerade auch durch die Gedenkkapelle von Antwerpens Meister P.P. Rubens gehört die St. Jakobskirche zum Pflichtprogramm für jeden Touristen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
