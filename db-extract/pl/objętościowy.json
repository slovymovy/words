                        "translation_id": "4500e7e4-9cff-40f2-ba10-c57f198c8fd5",
                        "source_entry_id": "634c28cf-8735-3712-8859-2c7852beb264",
                        "source_sense_id": "9d9c5317-ec96-3b11-acf1-83feedb9ef0c",
                        "target_lang_word": "volume",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volume",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46a5d9b4-0aca-39f4-8b78-b898e0885b85",
                                        "entry_id": "8f18d5d1-c102-38db-a5a5-498b47bc40d3",
                                        "glosses": [
                                            "A three-dimensional measure of space that comprises a length, a width and a height. It is measured in units of cubic centimeters in metric, cubic inches or cubic feet in English measurement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "860e1317-f6aa-4b80-b9eb-455334cce805",
                                                "sense_id": "46a5d9b4-0aca-39f4-8b78-b898e0885b85",
                                                "text": "The room is 9×12×8, so its volume is 864 cubic feet."
                                            },
                                            {
                                                "example_id": "89eab937-d2be-4fc4-82c8-771013a6bbee",
                                                "sense_id": "46a5d9b4-0aca-39f4-8b78-b898e0885b85",
                                                "text": "The proper products can improve your hair's volume."
                                            },
                                            {
                                                "example_id": "91996536-5018-4216-b671-dfab40f1a52f",
                                                "sense_id": "46a5d9b4-0aca-39f4-8b78-b898e0885b85",
                                                "text": "Volatiles of kecap manis and its raw materials were extracted using Likens-Nickerson apparatus with diethyl ether as the extraction solvent. The extracts were then dried with anhydrous sodium sulfate, concentrated using a rotary evaporator followed by flushing using nitrogen until the volume was about 0.5 ml."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83f72c7e-c095-3d69-9dd7-909f9c9302bb",
                                        "entry_id": "8f18d5d1-c102-38db-a5a5-498b47bc40d3",
                                        "glosses": [
                                            "Strength of sound; loudness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1a8712b-9b31-4b24-becf-2024eb56ab62",
                                                "sense_id": "83f72c7e-c095-3d69-9dd7-909f9c9302bb",
                                                "text": "Please turn down the volume on the stereo."
                                            },
                                            {
                                                "example_id": "46c0b979-586e-482b-a605-1869baae7f0d",
                                                "sense_id": "83f72c7e-c095-3d69-9dd7-909f9c9302bb",
                                                "text": "Volume can be measured in decibels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0b8149a-6840-3b39-b0d5-90d8a664740f",
                                        "entry_id": "8f18d5d1-c102-38db-a5a5-498b47bc40d3",
                                        "glosses": [
                                            "The issues of a periodical over a period of one year."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f10a4d41-536c-4796-99ca-258eadb80b88",
                                                "sense_id": "f0b8149a-6840-3b39-b0d5-90d8a664740f",
                                                "text": "I looked at this week's copy of the magazine. It was volume 23, issue 45."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92b8ba8f-ae9e-3747-ae81-4d9df82ce8f3",
                                        "entry_id": "8f18d5d1-c102-38db-a5a5-498b47bc40d3",
                                        "glosses": [
                                            "A bound book."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67612c20-7c50-4909-84ae-882b43149a49",
                                                "sense_id": "92b8ba8f-ae9e-3747-ae81-4d9df82ce8f3",
                                                "text": "However, with the dainty volume my quondam friend sprang into fame. At the same time he cast off the chrysalis of a commonplace existence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8d5334c-7f67-3796-8a1c-c1a94fcb0526",
                                        "entry_id": "8f18d5d1-c102-38db-a5a5-498b47bc40d3",
                                        "glosses": [
                                            "A single book of a publication issued in multi-book format, such as an encyclopedia."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cefc361f-c611-49a4-a8f0-708b762a6c94",
                                                "sense_id": "b8d5334c-7f67-3796-8a1c-c1a94fcb0526",
                                                "text": "The letter \"G\" was found in volume 4."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e79f085-50a6-30b2-a279-dc944a765975",
                                        "entry_id": "8f18d5d1-c102-38db-a5a5-498b47bc40d3",
                                        "glosses": [
                                            "A great amount (of meaning) about something."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34fa679d-7e4c-4c39-a623-396ad66f6463",
                                                "sense_id": "6e79f085-50a6-30b2-a279-dc944a765975",
                                                "text": "Ayesha wheeled round, and, pointing to the girl Ustane, said one word, and one only, but it was quite enough, for the tone in which it was said meant volumes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e647e3c-7a2c-3944-b0aa-b2b8eaddb2a9",
                                        "entry_id": "8f18d5d1-c102-38db-a5a5-498b47bc40d3",
                                        "glosses": [
                                            "A roll or scroll, which was the form of ancient books."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
