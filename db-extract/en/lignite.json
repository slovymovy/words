                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2aa05d3d-8fd3-41bf-8db3-b6e3ffcf30e0",
                                                "sense_id": "a9f3ca84-55e0-38a4-a4d3-27e69cc2641f",
