                        "examples": [
                            {
                                "example_id": "75b53f63-3c4a-4301-8acd-8ac9bb59edc6",
                                "sense_id": "26edfbc8-76a1-321a-a8dd-8bd446df4ea9",
                                "text": "Chronologiquement, l’étude des religions de la Chine devrait commencer par le taôisme et le confucianisme."
                            },
                            {
                                "example_id": "b4781905-ff5e-405e-9b1e-75c86090c2f9",
                                "sense_id": "26edfbc8-76a1-321a-a8dd-8bd446df4ea9",
                                "text": "Lorsque l’on passe en revue ces quatre éléments, on peut voir que là sont représentées les quatre écoles d’enseignement oriental : le confucianisme pour les deux premiers, le taôisme et le shintoïsme pour le troisième, le bouddhisme et le taôisme pour le quatrième."
                            }
                        ]
