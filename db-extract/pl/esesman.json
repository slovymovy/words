                "senses": [
                    {
                        "sense_id": "707f4df6-eb45-31ff-9ddf-e6f04cc18618",
                        "entry_id": "f22a0765-c950-3c65-be51-d85b5ef96a9e",
                        "glosses": [
                            "członek SS, paramilitarnej elitarnej formacji hitlerowskich Niemiec"
                        ],
                        "tags": [
                            "colloquial"
                        ],
