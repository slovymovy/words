                "senses": [
                    {
                        "sense_id": "0799bcae-78cd-3cf4-8f71-997f148cbe13",
                        "entry_id": "f27a9371-e3dd-37a1-bb37-a25aa4602a21",
                        "glosses": [
                            "Stipendium für (zukünftige) Sportler, Studenten, die Hochschulsport betreiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "037e4a0d-9304-457c-b818-8ec16a665b04",
                                "sense_id": "0799bcae-78cd-3cf4-8f71-997f148cbe13",
                                "text": "„Auf dem College hatte er Eishockey gespielt und sogar Aussichten auf den Platz in einem NHL-Team gehabt. Aber dann lief sein Sportstipendium aus, außerdem musste er sich eingestehen, dass ihm der Killerinstinkt eines Profiathleten fehlte.“"
                            },
                            {
                                "example_id": "c807fe26-f5dc-42ff-997f-d01c163ef7cf",
                                "sense_id": "0799bcae-78cd-3cf4-8f71-997f148cbe13",
                                "text": "„Schon während seiner Grundschulzeit wurden dem Jungen äußerst großzügige Sportstipendien angeboten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
