                                    {
                                        "sense_id": "31ea8af8-c8ca-3db0-bb2e-8aacab03e140",
                                        "entry_id": "9547d056-5bda-3cd9-932c-aa7c779b592c",
                                        "glosses": [
                                            "Os long, mince et pointu qui se trouve dans la chair de certains poissons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e836ce3-8ba1-477a-9662-943ef2420441",
                                                "sense_id": "31ea8af8-c8ca-3db0-bb2e-8aacab03e140",
                                                "text": "Faites une pâte à koulibiac, puis garnissez l’intérieur de tranches de saumon épluché et débarrassé des arêtes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cd38a08-42f6-375e-95ee-c6e7752574bb",
                                        "entry_id": "9547d056-5bda-3cd9-932c-aa7c779b592c",
                                        "glosses": [
                                            "Squelette entier du poisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9409dc1f-95e1-4e6c-aeac-ca4f617ea060",
                                                "sense_id": "4cd38a08-42f6-375e-95ee-c6e7752574bb",
                                                "text": "L’arête d’une sole."
                                            },
                                            {
                                                "example_id": "297e2431-add2-45ec-9892-312071b96126",
                                                "sense_id": "4cd38a08-42f6-375e-95ee-c6e7752574bb",
                                                "text": "L’arête d’une carpe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e66f2020-3726-3581-92db-3580a93661f3",
                                        "entry_id": "9547d056-5bda-3cd9-932c-aa7c779b592c",
                                        "glosses": [
                                            "Barbes qui accompagnent l’épi de certaines graminées, telles que l’orge, le seigle, etc., et en général tout filet sec, grêle et plus ou moins raide qui ressemble aux barbes des graminées. Fil raide attaché au sommet ou sur le dos d’un organe d’une plante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d3680a7-bf63-481e-9fce-64ff5c9866df",
                                                "sense_id": "e66f2020-3726-3581-92db-3580a93661f3",
                                                "text": "Avoine cultivée, A. sativa, L. à fleurs en panicule ; à calices renfermant deux semences lisses, dont une à arête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de4c7a41-518f-3d5c-8c8d-03b9128a1fa8",
                                        "entry_id": "9547d056-5bda-3cd9-932c-aa7c779b592c",
                                        "glosses": [
                                            "Angle saillant formé par la rencontre et la jonction de deux surfaces d’une pierre, d’une pièce de bois ou de toute autre matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8128548-130e-4d84-8f96-c6592340381d",
                                                "sense_id": "de4c7a41-518f-3d5c-8c8d-03b9128a1fa8",
                                                "text": "Chaque nervure, chaque arête sculptée, le moindre trait s’argenta."
                                            },
                                            {
                                                "example_id": "de7f9e6e-40d1-4231-88c1-06eca32b54d1",
                                                "sense_id": "de4c7a41-518f-3d5c-8c8d-03b9128a1fa8",
                                                "text": "La façade était peinte en blanc et les arêtes de la corniche se rehaussaient d’un filet rouge qui en accentuait le profil."
                                            },
                                            {
                                                "example_id": "7d1d8def-3a8c-43c4-978a-f4fa41871eb0",
                                                "sense_id": "de4c7a41-518f-3d5c-8c8d-03b9128a1fa8",
                                                "text": "Cette tablette de marbre a les arêtes écornées."
                                            },
                                            {
                                                "example_id": "f4c21858-2cf9-460d-809d-c8fcae8faccb",
                                                "sense_id": "de4c7a41-518f-3d5c-8c8d-03b9128a1fa8",
                                                "text": "Cette pièce de bois, cette poutre, cette solive est taillée à vive arête"
                                            },
                                            {
                                                "example_id": "d78dde64-12ca-4397-8c2f-e81942be5904",
                                                "sense_id": "de4c7a41-518f-3d5c-8c8d-03b9128a1fa8",
                                                "text": "L’arête d’une voûte"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8891d88d-3f60-3a5d-936a-7e219cdd96ce",
                                        "entry_id": "9547d056-5bda-3cd9-932c-aa7c779b592c",
                                        "glosses": [
                                            "Ligne formée par la réunion de deux surfaces inclinées l’une sur l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c1e0823-c5f6-4907-911b-0be1f76d8924",
                                                "sense_id": "8891d88d-3f60-3a5d-936a-7e219cdd96ce",
                                                "text": "Les arêtes d’une pyramide, d’un cristal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "212a20d8-a7ed-364d-9e67-8bc9779b8f60",
                                        "entry_id": "9547d056-5bda-3cd9-932c-aa7c779b592c",
                                        "glosses": [
                                            "Ligne courbe ou brisée qui sépare les deux versants d’une chaîne de montagnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84b83176-a5cc-4337-a72a-2518f7eaa7cf",
                                                "sense_id": "212a20d8-a7ed-364d-9e67-8bc9779b8f60",
                                                "text": "Nous passions de ce premier affluent dans un autre, jusqu’à ce qu’enfin arrivés en face de la grande arête qui sépare la vallée de l’Ipek de celle de la Porezka, il nous fallut gravir péniblement un sentier presque perpendiculaire, en nous retenant à la crinière des chevaux haletants."
                                            },
                                            {
                                                "example_id": "154229dc-4af5-45fc-a266-8f4737df0021",
                                                "sense_id": "212a20d8-a7ed-364d-9e67-8bc9779b8f60",
                                                "text": "La frontière est passée, c’est l’Apennin qui commence. Un soleil gai luit sur les arêtes vives des cimes; la poitrine aspire un air sain; […]."
                                            },
                                            {
                                                "example_id": "b79d7c47-d1d5-4525-aa7a-d1be8609e939",
                                                "sense_id": "212a20d8-a7ed-364d-9e67-8bc9779b8f60",
                                                "text": "Réserveront-ils un coup d'éclat en tentant une ascension par le versant nord ou bien par la fameuse Magic Line, sur l'arête sud-ouest en hiver ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15914c26-65dc-3563-ad4b-93c4275c9a46",
                                        "entry_id": "9547d056-5bda-3cd9-932c-aa7c779b592c",
                                        "glosses": [
                                            "Arc d’un graphe non orienté."
                                        ],
                                        "tags": [
                                            "Théorie des graphes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ad6afde-0756-3797-a929-e3db2a21bbdd",
                                        "entry_id": "9547d056-5bda-3cd9-932c-aa7c779b592c",
                                        "glosses": [
                                            "Dans un arbre binaire, représentation d’un lien, sous forme de droite, entre deux sommets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "361aad07-4345-4941-a22a-70eaca161dda",
                                                "sense_id": "9ad6afde-0756-3797-a929-e3db2a21bbdd",
                                                "text": "Introduisons un peu de terminologie mathématique : les segments de l’arbre sont appelés « arêtes » et leurs extrémités « sommets »."
                                            }
                                        ]
                                    }
                                ]
                            }
