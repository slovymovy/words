                ],
                "senses": [
                    {
                        "sense_id": "67c33479-3b64-31b1-ae25-2bdc7fa0d08b",
                        "entry_id": "2a6253b8-e71e-3f2b-ada5-270078f9a546",
                        "glosses": [
                            "вдоволь, много полакомиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b233f76-68c5-499a-b6bd-a47431be09f6",
                                "sense_id": "67c33479-3b64-31b1-ae25-2bdc7fa0d08b",
                                "text": "Софронку к бабёнке перекупке на берег послали, два фунта грецких орехов Софронка принёс; шесть оплеух, все кулаком, Бешену Горлу достались, остальными орехами Спирька вдоволь налакомился."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d17f6ceb-0e85-4c08-b89b-7f742da78df3",
                        "source_entry_id": "2a6253b8-e71e-3f2b-ada5-270078f9a546",
                        "source_sense_id": "67c33479-3b64-31b1-ae25-2bdc7fa0d08b",
                        "target_lang_word": "enjoy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enjoy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f544266-36d5-306f-bc94-c93112f14356",
                                        "entry_id": "c8be425d-8720-32b8-99d3-95927c3cce45",
                                        "glosses": [
                                            "To receive pleasure or satisfaction from something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cedaec7-4743-4330-addc-4bde752d999c",
                                                "sense_id": "9f544266-36d5-306f-bc94-c93112f14356",
                                                "text": "Enjoy your holidays! I very much enjoy dancing."
                                            },
                                            {
                                                "example_id": "33106a7f-383c-4c2a-8c98-8be95289c867",
                                                "sense_id": "9f544266-36d5-306f-bc94-c93112f14356",
                                                "text": "And we shall sit at endless feast,\n⁠Enjoying each the other’s good;\n⁠What vaster dream can hit the mood\nOf Love on earth?"
                                            },
                                            {
                                                "example_id": "dbd58704-6705-466d-8759-2fb337f833a5",
                                                "sense_id": "9f544266-36d5-306f-bc94-c93112f14356",
                                                "text": "Energy has seldom been found where we need it when we want it. Ancient nomads, wishing to ward off the evening chill and enjoy a meal around a campfire, had to collect wood and then spend time and effort coaxing the heat of friction out from between sticks to kindle a flame. With more settled people, animals were harnessed to capstans or caged in treadmills to turn grist into meal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35033b3f-f200-3a0f-bea3-b641f9374295",
                                        "entry_id": "c8be425d-8720-32b8-99d3-95927c3cce45",
                                        "glosses": [
                                            "To have the use or benefit of something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bb5c7c9-31b9-4628-ae01-bf0acf0bc73e",
                                                "sense_id": "35033b3f-f200-3a0f-bea3-b641f9374295",
                                                "text": "I plan to go travelling while I still enjoy good health."
                                            },
                                            {
                                                "example_id": "c86a976a-e00c-44a1-a1d3-0ae40991c405",
                                                "sense_id": "35033b3f-f200-3a0f-bea3-b641f9374295",
                                                "text": "that the children of Israel may enjoy every man the inheritance of his fathers"
                                            },
                                            {
                                                "example_id": "233fc356-c08f-43fa-8369-fb62a19a0683",
                                                "sense_id": "35033b3f-f200-3a0f-bea3-b641f9374295",
                                                "text": "Night and day were the same in this prison room, but Tommy's wrist-watch, which enjoyed a certain degree of accuracy, informed him that it was nine o'clock in the evening."
                                            },
                                            {
                                                "example_id": "219fe352-02bb-4c2e-b169-6369abd99f55",
                                                "sense_id": "35033b3f-f200-3a0f-bea3-b641f9374295",
                                                "text": "This account fails to provide any basis for doubting that animals of subhuman species enjoy the freedom it defines."
                                            },
                                            {
                                                "example_id": "2c25db1b-3c00-45ae-8cda-eefa1f6a73b0",
                                                "sense_id": "35033b3f-f200-3a0f-bea3-b641f9374295",
                                                "text": "The Indo-Arabic system was introduced into Europe in 1000 CE, but due to resistance from several quarters, centuries elapsed before it finally enjoyed widespread use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dff19b2-496a-3860-b7d9-ae5e3eb38afb",
                                        "entry_id": "c8be425d-8720-32b8-99d3-95927c3cce45",
                                        "glosses": [
                                            "To be satisfied or receive pleasure."
                                        ],
                                        "tags": [
                                            "India",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "656492bc-761d-47ea-9446-4db919e81d99",
                                                "sense_id": "6dff19b2-496a-3860-b7d9-ae5e3eb38afb",
                                                "text": "I enjoyed a lot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3142086a-de38-315e-9c38-0c806d2c4202",
                                        "entry_id": "c8be425d-8720-32b8-99d3-95927c3cce45",
                                        "glosses": [
                                            "To have sexual intercourse with."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe48a540-6af8-4a55-acb8-59c3b2da5961",
                                                "sense_id": "3142086a-de38-315e-9c38-0c806d2c4202",
                                                "text": "Never did thy Beautie[…]so enflame my sense With ardor to enjoy thee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
