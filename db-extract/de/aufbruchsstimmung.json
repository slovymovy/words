                            {
                                "example_id": "bd9f9c63-f178-41c2-a68a-e5271f3359fa",
                                "sense_id": "76986a0c-0efd-3d67-8e73-c47274fa1481",
                                "text": "„Noch vor wenigen Tagen wäre er in dieser Aufbruchsstimmung aufgegangen, hätte sich mitreißen lassen.“"
                            },
                            {
                                "example_id": "1e1098ac-66fa-4111-a501-de9379eaf3ac",
                                "sense_id": "76986a0c-0efd-3d67-8e73-c47274fa1481",
                                "text": "„Es setzte eine wirtschaftliche Aufbruchsstimmung ein, vor allem auch weil internationale Kreditinstitutionen neue Gelder gewährten.“"
                            }
                        ],
