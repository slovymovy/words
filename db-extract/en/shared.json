                                            {
                                                "example_id": "f5036fbc-62fe-4651-8af1-f58e8def9f93",
                                                "sense_id": "357a9a68-5066-34a3-90a2-d35ab464ae91",
                                                "text": "Deze informatie was nog betrouwbaarder dan de soms wat verouderde opmerkingen in Guthook en gezamenlijk gaven ze voldoende informatie om met enigszins gerust hart de uitgedroogde woestijn in te trekken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cfc7ab8-c94b-32db-9232-002323c7be0b",
                                        "entry_id": "a26a9d75-3596-30e0-9973-496fa39811ce",
                                        "glosses": [
                                            "van allen, door allen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba2e1b3b-0d57-45ef-8603-e51048483e96",
                                                "sense_id": "5cfc7ab8-c94b-32db-9232-002323c7be0b",
                                                "text": "Nog vreemder was dat de Sovjet-Unie en de Verenigde Staten nu gezamenlijk de drie landen die Egypte hadden aangevallen bevolen om op te houden en naar huis te gaan."
                                            }
                                        ]
                                    }
                                ]
