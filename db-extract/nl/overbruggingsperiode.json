                        "examples": [
                            {
                                "example_id": "540bda16-d406-4a21-a3eb-34977bd900a7",
                                "sense_id": "c7cd3bc5-c65e-3448-8415-34809cb0e80e",
                                "text": "Hij zou er niet eindeloos mee kunnen doorgaan, maar ze waren voor hem een prettige overbruggingsperiode."
                            },
                            {
                                "example_id": "e4701c55-6c93-4a26-9d72-cb068ac78310",
                                "sense_id": "c7cd3bc5-c65e-3448-8415-34809cb0e80e",
                                "text": "Maar ook een kortstondige terugkeer in de toekomst als trainer sluit hij niet helemaal uit. \"Als ik al ergens zou tekenen, zou het niet langer zijn dan een jaar.\" Pastoor doelt dan bijvoorbeeld op een club tijdelijk uit de brand helpen als er een trainer vertrokken is en er voor een overbruggingsperiode iemand nodig is."
                            }
                        ]
