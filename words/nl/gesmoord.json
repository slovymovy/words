                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "braised",
                                "target_lang_sense_clarification": "cooked slowly in liquid"
                            },
                            {
                                "target_lang_word": "stewed",
                                "target_lang_sense_clarification": "cooked slowly in a closed pot"
                            },
                            {
                                "target_lang_word": "smothered",
                                "target_lang_sense_clarification": "cooked in a covered pan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73d7f60a-2089-360a-9021-5c9aa648e17d",
                    "sense_definition": "zacht of onduidelijk gemaakt doordat het geluid wordt tegengehouden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik hoorde een <w>gesmoorde</w> lach vanuit de kamer ernaast.",
                            "target_lang_translations": {
                                "en": "I heard a <w>stifled</w> laugh from the room next door."
                            }
                        },
                        {
                            "text": "Haar schreeuw werd <w>gesmoord</w> door het dikke beddegoed.",
                            "target_lang_translations": {
                                "en": "Her scream was <w>muffled</w> by the thick bedding."
                            }
                        }
                    ],
                    "synonyms": [
                        "gedempt"
                    ],
                    "common_phrases": [
                        "gesmoorde lach",
                        "gesmoorde kreet"
                    ],
                    "target_lang_definitions": {
                        "en": "made soft or unclear because the sound is being blocked or muffled"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "muffled",
                                "target_lang_sense_clarification": "deadened or softened sound"
                            },
                            {
                                "target_lang_word": "stifled",
                                "target_lang_sense_clarification": "suppressed sound, like a laugh or cry"
                            },
                            {
                                "target_lang_word": "subdued",
                                "target_lang_sense_clarification": "quiet and low in volume"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a354283-6e3f-3894-a6d7-ce0393256ef4",
                    "sense_definition": "met kracht tegengehouden of voortijdig beëindigd om verdere escalatie te voorkomen",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "onderdrukking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De opstand werd in de kiem <w>gesmoord</w> door de politie.",
                            "target_lang_translations": {
                                "en": "The uprising was <w>nipped in the bud</w> by the police."
                            }
                        },
                        {
                            "text": "Elke poging tot discussie werd direct door de voorzitter <w>gesmoord</w>.",
                            "target_lang_translations": {
                                "en": "Every attempt at discussion was immediately <w>quashed</w> by the chairman."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderdrukt"
                    ],
                    "common_phrases": [
                        "in de kiem gesmoord"
                    ],
                    "target_lang_definitions": {
                        "en": "forcibly held back or prematurely ended to prevent further escalation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nipped in the bud",
                                "target_lang_sense_clarification": "stopped at an early stage"
                            },
                            {
                                "target_lang_word": "quashed",
                                "target_lang_sense_clarification": "suppressed or put an end to"
                            },
                            {
                                "target_lang_word": "stifled",
                                "target_lang_sense_clarification": "prevented from developing"
                            }
                        ]
                    }
                }
            ]
        },
