                ],
                "senses": [
                    {
                        "sense_id": "8d47665a-821f-3250-9853-68f5c4a6e616",
                        "entry_id": "7fd67896-7f27-37ac-b063-78bd6b45b6d0",
                        "glosses": [
                            "Consoler, soulager."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d2f6b96f-8c78-4fd8-b161-df469948fc02",
                                "sense_id": "8d47665a-821f-3250-9853-68f5c4a6e616",
                                "text": "Quand Cupidon, qui me vit pâle et triste, Me dit : ami, pourquoi te soucier ? Lors m’envoya, pour me solacier, Tout son cortége et celui de sa mère"
                            },
                            {
                                "example_id": "e9b8bfe7-751b-46a7-9d32-7be13dc72b5e",
                                "sense_id": "8d47665a-821f-3250-9853-68f5c4a6e616",
                                "text": "M. de Blacas était devenu soucieux et triste; moi, pauvre homme, je le solaciais."
                            }
                        ]
                    },
                    {
                        "sense_id": "87338e34-1c1b-37fa-9289-f1edfce0704b",
                        "entry_id": "7fd67896-7f27-37ac-b063-78bd6b45b6d0",
                        "glosses": [
                            "Se divertir."
                        ],
                        "tags": [
                            "obsolete",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "136e3555-91fc-419e-9005-e4167b2f4a4f",
                                "sense_id": "87338e34-1c1b-37fa-9289-f1edfce0704b",
                                "text": "Plein de courroux et vide de pécune,\n Léger d’argent et chargé de rancune,\n Il va trouver le manant qui riait\n Avec sa femme et se solaciait."
                            },
                            {
                                "example_id": "3e496a69-fee8-44e0-850b-030f549a0693",
                                "sense_id": "87338e34-1c1b-37fa-9289-f1edfce0704b",
                                "text": "Ne venez pas, après vous être solacié à Paris tout à votre aise, me dire ici que vous êtes pressé de partir"
                            }
                        ]
                    },
                    {
                        "sense_id": "294ad92f-77ae-31ab-9abb-e489fbda8079",
                        "entry_id": "7fd67896-7f27-37ac-b063-78bd6b45b6d0",
                        "glosses": [
                            "agrémenter."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f8f8b5ac-06ed-488a-b964-134d77424585",
                                "sense_id": "294ad92f-77ae-31ab-9abb-e489fbda8079",
                                "text": "il chante pour solacier ses veilles, mais les heures s'envolent et les astres se couchent, et le flambeau ne brille pas"
                            }
                        ]
                    }
                ],
