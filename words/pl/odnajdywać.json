            "senses": [
                {
                    "sense_id": "8a8ff0c0-c630-3e2d-b0b3-b3eb00c9568a",
                    "sense_definition": "znajdować coś, co zostało zgubione, ukryte lub zapomniane",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "finding_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Detektyw regularnie <w>odnajduje</w> zaginione dokumenty w starym archiwum.",
                            "target_lang_translations": {
                                "en": "The detective regularly <w>finds</w> missing documents in the old archive."
                            }
                        },
                        {
                            "text": "W trakcie remontu często <w>odnajdywaliśmy</w> przedmioty należące do dawnych właścicieli.",
                            "target_lang_translations": {
                                "en": "During the renovation, we often <w>found</w> items belonging to the former owners."
                            }
                        }
                    ],
                    "synonyms": [
