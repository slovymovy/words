                                            {
                                                "example_id": "8d5eae31-e7b5-4210-983a-5fd69f25681c",
                                                "sense_id": "6551e9ce-c1c5-3e4a-bc9d-52277bb34b90",
                                                "text": "VN-vluchtelingenorganisatie UNHCR noemde de berichten over honderden slachtoffers inaccuraat. Volgens de UNHCR kan geen enkele overheidsinstantie duidelijkheid geven over het vermoedelijke overlijden van naar schatting vierhonderd mensen."
                                            },
                                            {
                                                "example_id": "58ee45ec-36d6-4671-aa19-d926d2f63163",
                                                "sense_id": "6551e9ce-c1c5-3e4a-bc9d-52277bb34b90",
                                                "text": "Bader reageerde met een verklaring dat het bericht „verrassend en inaccuraat” was. Maar hij ontkende niet de koper te zijn. Het net geopende Louvre Abu Dhabi meldde het schilderij te gaan exposeren."
                                            }
