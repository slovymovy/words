                    "sense_definition": "De reservering van een reis, hotelkamer, ticket of evenement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reservering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb gisteren een <w>boeking</w> gemaakt voor een hotel in Parijs.",
                            "target_lang_translations": {
