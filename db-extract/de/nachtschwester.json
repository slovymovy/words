                "senses": [
                    {
                        "sense_id": "9e2e30ba-e9ce-371c-a7f3-928a4423927d",
                        "entry_id": "a29d690e-3952-3b6e-b9a5-fa11a77a982a",
                        "glosses": [
                            "Krankenschwester, die Nachtdienst hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "656f546b-c3f2-4562-a1c8-292e029f7419",
                                "sense_id": "9e2e30ba-e9ce-371c-a7f3-928a4423927d",
                                "text": "„Die sagt, was sie von der Nachtschwester gehört hat und bei dem Gespräch vorhin aufgeschnappt hat.“"
                            },
                            {
                                "example_id": "911b83d3-212d-4e6f-a412-fdec1feebf1f",
                                "sense_id": "9e2e30ba-e9ce-371c-a7f3-928a4423927d",
                                "text": "„Als die Nachtschwester spät in der Nacht dort ihre Runde drehte, kam sie aus dem Staunen gar nicht mehr heraus.“"
                            },
                            {
                                "example_id": "73c1720c-b91e-421f-ae37-aff21f88ad24",
                                "sense_id": "9e2e30ba-e9ce-371c-a7f3-928a4423927d",
                                "text": "„Auch die Nachtschwester sollte sich hüten: Abnehmen hat noch niemandem geschadet.“"
                            },
                            {
                                "example_id": "71bc7b43-d375-48df-a7d8-25afaf859093",
                                "sense_id": "9e2e30ba-e9ce-371c-a7f3-928a4423927d",
                                "text": "„Im Korridor traf er die Nachtschwester.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
