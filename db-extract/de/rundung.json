                ],
                "senses": [
                    {
                        "sense_id": "23c7de60-5650-3eb7-ac06-e2fb4ece1437",
                        "entry_id": "4c978690-d16c-3cf7-9a14-4ca7fb9b6f78",
                        "glosses": [
                            "gekrümmte Fläche oder Linie"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "731d75e1-dfeb-48d5-8979-600d4a87aec4",
                                "sense_id": "23c7de60-5650-3eb7-ac06-e2fb4ece1437",
                                "text": "„Januar 2009 in engen, high-waisted Jeans, die ihre Rundungen zur Geltung brachten, wurde sie als zu dick bezeichnet.“"
                            },
                            {
                                "example_id": "627805c9-723d-48f6-9119-edde01e7db79",
                                "sense_id": "23c7de60-5650-3eb7-ac06-e2fb4ece1437",
                                "text": "„Der Konsul seufzte und stützte seine Hand auf die Rundung seines Bäuchleins.“"
                            },
                            {
                                "example_id": "f17d85bd-7f1d-4b66-b363-d4c0f0539869",
                                "sense_id": "23c7de60-5650-3eb7-ac06-e2fb4ece1437",
                                "text": "„Von der Decke, dort wo die Rundungen des Gewölbes an ihrem höchsten Punkt einander berührten und die Statik der Konstruktion vollendeten, hing ein schwerer, gußeiserner Leuchter, der ein diffuses, schummriges Licht verbreitete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "041b1de9-df0a-3045-a81e-aac162f1e183",
                        "entry_id": "4c978690-d16c-3cf7-9a14-4ca7fb9b6f78",
                        "glosses": [
                            "Ersetzung eines ohne Lippenrundung gesprochenen Vokals durch einen, der mit Lippenrundung gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57f8269c-33bd-4517-b50e-99cec7858b4a",
                                "sense_id": "041b1de9-df0a-3045-a81e-aac162f1e183",
                                "text": "„Unter Rundung versteht man die Neigung, die Vokale e, i, unter Rundung der Lippen zu sprechen, so daß ö, ü, eu zustande kommt.“"
                            },
                            {
                                "example_id": "3cfb41e4-d4e1-45e3-8c2d-d3f6af32659d",
                                "sense_id": "041b1de9-df0a-3045-a81e-aac162f1e183",
                                "text": "„Für die Vokalartikulation kann man beobachten, daß die Vokale aller Sprachen, die heute auf der Welt gesprochen werden, in den Koordinaten von Zungenstellung, Rundung, Nasalierung und Quantität beschrieben werden können.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ee92b87d-2ece-3cf6-90aa-26c25db7db4e",
                        "entry_id": "4c978690-d16c-3cf7-9a14-4ca7fb9b6f78",
                        "glosses": [
                            "Beseitigung der letzten Stellen einer Zahl, Ersetzung/Vereinfachung einer genaueren durch eine weniger genaue Zahl"
                        ],
                        "tags": [
                            "Arithmetik"
                        ],
                        "examples": [
                            {
                                "example_id": "06c5142d-4911-47c7-9775-7ec0b608b290",
                                "sense_id": "ee92b87d-2ece-3cf6-90aa-26c25db7db4e",
                                "text": "„Die Tabelle zeigt, dass bereits wenige der insgesamt 777.531 abgegebenen gültigen Stimmen genügten, um durch mathematische Rundung die Mandatsverschiebung auszulösen. Dies ist ein selten vorkommender Fall.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
