                "senses": [
                    {
                        "sense_id": "19c5a821-e7e3-3753-a20e-c633c7ae8799",
                        "entry_id": "bac39a50-b505-3e8b-acb8-d26caca14d2b",
                        "glosses": [
                            "Abweichung von der gültigen Lehre"
                        ],
                        "tags": [
                            "meist Christentum, abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "b24d4193-faef-4579-851d-9e3d1abe43e2",
                                "sense_id": "19c5a821-e7e3-3753-a20e-c633c7ae8799",
                                "text": "„Diesem Verein war es auferlegt, die Ketzerei, mit welchen Mitteln auch immer, zu zerschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "870ac862-9e68-326b-a4b2-63f5c64d0bfd",
                        "entry_id": "bac39a50-b505-3e8b-acb8-d26caca14d2b",
                        "glosses": [
                            "unerhörte Abweichung von der gemeingültigen Meinung"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "32d9618d-862e-4099-aa8c-5f918980b248",
                                "sense_id": "870ac862-9e68-326b-a4b2-63f5c64d0bfd",
                                "text": "„Unser eigentliches Vergehen und Verbrechen ist unsere Ketzerei gegen das Dogma.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e068afea-7c72-4d6f-a4cc-7569cda5c212",
                        "source_entry_id": "bac39a50-b505-3e8b-acb8-d26caca14d2b",
                        "source_sense_id": "19c5a821-e7e3-3753-a20e-c633c7ae8799",
                        "source_sense_description": "Religion, meist Christentum, abwertend: Abweichung von der gültigen Lehre",
                        "target_lang_word": "heresy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heresy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78d56f18-a394-33f3-a087-f12f5e972681",
                                        "entry_id": "925529c6-d269-3e94-b891-08481fe3d5b9",
                                        "glosses": [
                                            "A doctrine held by a member of a religion at variance or conflict with established religious beliefs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d32e8e0-6261-45a7-8ddb-8e06258c26d2",
                                                "sense_id": "78d56f18-a394-33f3-a087-f12f5e972681",
                                                "text": "Heresy meant deliberate departure from the accepted doctrines of the church. It was intellectual and spiritual dissent and concerned the beliefs of Christianity, not the morals of its adherents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08cc1a1a-1ef0-34b8-92f0-d85fee1074da",
                                        "entry_id": "925529c6-d269-3e94-b891-08481fe3d5b9",
                                        "glosses": [
                                            "A controversial or unorthodox opinion held by a member of a group, as in politics, philosophy or science."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd0c8493-dce5-41ba-9ffa-15262ff96648",
                                                "sense_id": "08cc1a1a-1ef0-34b8-92f0-d85fee1074da",
                                                "text": "I'm going to declare a heresy for you. All science, if you go back into its roots, saying: 'Why do I believe this?' 'Well, I believe this because of these tests and this proof.' 'Well, why do I believe this?' 'Why did I set up this test?' 'Why did I believe that proof?' All science goes back to something that we believe because we believe it. We believe it because we believe it, and we have no proof for it. It's like a religion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
