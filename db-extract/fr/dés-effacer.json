                        "tags": [],
                        "examples": [
                            {
                                "example_id": "718e028a-0c90-424a-86eb-08782354fc9c",
                                "sense_id": "53e65f33-9c02-3ee8-8741-2665de315b2e",
                                "text": "Un des thèmes sera « Dés-effacer les féministes racisées »."
                            },
                            {
                                "example_id": "857cb623-d6fa-4ee6-a10d-7b081507c979",
                                "sense_id": "53e65f33-9c02-3ee8-8741-2665de315b2e",
                                "text": "Note : vous pouvez dés-effacer les pages en restaurant une révision à partir de la PageArchive, qui n’est en aucun cas affectée par l’EffacementPage."
                            },
                            {
                                "example_id": "34ba966b-cce2-463c-a214-95345e884be2",
                                "sense_id": "53e65f33-9c02-3ee8-8741-2665de315b2e",
                                "text": "Cette intervention « dés-efface » un éventail de groupes et de personnes féministes racisées à Paris, par exemple les Nanas Beurs, le MODEFEN (Mouvement des femmes noires), le travail de Dalila Kadri, ou le Groupe du 6 Novembre."
                            },
                            {
                                "example_id": "5f17887e-4334-472b-9f64-51e45d6f81bb",
                                "sense_id": "53e65f33-9c02-3ee8-8741-2665de315b2e",
                                "text": "Si jamais il n'y pas eu d’autres photos mises sur la carte, ça peut se dés-effacer, si y a eu pb de transfert."
                            }
                        ]
