                "senses": [
                    {
                        "sense_id": "7a3a4286-e0bf-3c41-905e-bd87ca1858a6",
                        "entry_id": "83175c15-d931-3fc9-b8a3-6b1215301c21",
                        "glosses": [
                            "an Hängen abrutschende Massen aus Schlamm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1929c3c3-6608-4269-9127-4288536f0535",
                                "sense_id": "7a3a4286-e0bf-3c41-905e-bd87ca1858a6",
                                "text": "„Sie sagt: ›Im ganzen Land hat es zehntausend Tote gegeben, die meisten in Tegucigalpa, wegen der Schlammlawinen und der fünfzehn Meter hohen Flutwelle, in der viele ertrunken sind.‹“"
                            },
                            {
                                "example_id": "225dbf31-6d8f-46f2-ac36-a9821827efd0",
                                "sense_id": "7a3a4286-e0bf-3c41-905e-bd87ca1858a6",
                                "text": "„Ich stellte allerdings fest, dass es sich nicht um Asche, sondern eher um die Ablagerungen eines pyroklastischen Stromes handelte, der wie ein Erdrutsch oder eine Schlammlawine über den Vulkanhang geflossen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
