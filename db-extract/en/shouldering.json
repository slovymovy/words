                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "acc2a0f6-bc8d-34ec-8791-423628012537",
                        "entry_id": "ccaf97dc-e446-3b3c-9c3b-771a44994c00",
                        "glosses": [
                            "A flanged portion of something, similar to a lip but occurring on the side rather than the rim."
                        ],
                        "tags": [],
                        "examples": [
