    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "201a6a67-24a5-3e02-ad33-91dbe63174eb",
                "word": "goldbrick",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "23f4d012-ad6b-4127-ac7d-45013b04c40b",
                        "entry_id": "201a6a67-24a5-3e02-ad33-91dbe63174eb",
                        "tags": [
                            "plural"
                        ],
                        "form": "goldbricks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d7464fb-75c4-3594-8d1e-646567ffb084",
                        "entry_id": "201a6a67-24a5-3e02-ad33-91dbe63174eb",
                        "glosses": [
                            "Something fraudulent or nonexistent offered for sale; a swindle or con."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "582dc1dc-ef4a-4d29-96c1-a42ae646aad2",
                                "sense_id": "7d7464fb-75c4-3594-8d1e-646567ffb084",
                                "text": "Experience is the biggest gold brick in the world. All older people have it for sale."
                            },
                            {
                                "example_id": "4cb23b04-0c44-46c3-a7e5-e649c610e731",
                                "sense_id": "7d7464fb-75c4-3594-8d1e-646567ffb084",
                                "text": "These, as a rule, were not adverse to buying a goldbrick as long as they knew that there was a chance for them to dump it on somebody else afterwards with some profit."
                            },
                            {
                                "example_id": "5867cbdb-b3eb-40a3-b0a7-0ece2c8eb572",
                                "sense_id": "7d7464fb-75c4-3594-8d1e-646567ffb084",
                                "text": "To-day, American attitude toward Europe is comparable to that of the country greenhorn who, having bought a goldbrick on Broadway, now fills the air not merely with the denunciation of the sharpers who tricked his credulity — […]"
                            },
                            {
                                "example_id": "0d750478-3e25-4d17-a4f0-e316f341053e",
                                "sense_id": "7d7464fb-75c4-3594-8d1e-646567ffb084",
                                "text": "The average farmer may be less of a victim than some other people by reason of his isolation, conservatism, and hard earned money, but he, too, has too often bought a goldbrick that did not materialize."
                            },
                            {
                                "example_id": "1ea6c7be-708a-4569-af6a-d4e315c1cb2b",
                                "sense_id": "7d7464fb-75c4-3594-8d1e-646567ffb084",
                                "text": "[…] that if he bought a goldbrick from Podhoretz for $25,000, he ought to pay me more than the $5,000 a volume that had been agreed on for the pure gold […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "a778da36-93d4-3324-af79-92725f3c8ba2",
                        "entry_id": "201a6a67-24a5-3e02-ad33-91dbe63174eb",
                        "glosses": [
                            "A shirker or malingerer."
                        ],
                        "tags": [
                            "US",
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e81dd3df-7590-4011-9a42-67b5a6aca116",
                                "sense_id": "a778da36-93d4-3324-af79-92725f3c8ba2",
                                "text": "Mac, there’s not a confounded thing wrong with you. You are an excellent physical specimen and in good health. You’re nothing but a goldbrick. Now, get your butt out of here and don’t ever come back again unless you’re really sick or need an immunization."
                            },
                            {
                                "example_id": "5fc13503-0b45-47ff-9115-c2e37f7e2de1",
                                "sense_id": "a778da36-93d4-3324-af79-92725f3c8ba2",
                                "text": "Tell me that I’ve been a louse and loafer\nYou won’t get a fight here, no ma’am\nSay I’m a goldbrick, a goof-off, no good\nBut that couldn’t be all that I am"
                            }
                        ]
                    },
                    {
                        "sense_id": "55c5e281-37fb-387b-9227-28afd43b0d28",
                        "entry_id": "201a6a67-24a5-3e02-ad33-91dbe63174eb",
                        "glosses": [
                            "A swindler."
                        ],
                        "tags": [
                            "US",
                            "dated",
                            "slang"
                        ],
                        "examples": []
                    }
