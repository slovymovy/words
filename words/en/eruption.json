{
    "word_family": [
        "erupt",
        "eruptive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "980994dc-b0fa-34ce-af44-9461bc18d5f4",
                    "sense_definition": "A violent ejection, such as the spurting out of lava from a volcano.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geological_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>eruption</w> of the volcano destroyed the nearby village.",
                            "target_lang_translations": {
                                "ru": "<w>Извержение</w> вулкана разрушило близлежащую деревню."
                            }
                        },
                        {
                            "text": "Scientists are monitoring the mountain for signs of a volcanic <w>eruption</w>.",
                            "target_lang_translations": {
                                "ru": "Учёные следят за горой в ожидании признаков вулканического <w>извержения</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "outburst",
                        "explosion"
                    ],
                    "common_phrases": [
                        "volcanic eruption"
                    ],
                    "target_lang_definitions": {
                        "ru": "Насильственный выброс, например, извержение лавы из вулкана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извержение",
                                "target_lang_sense_clarification": "геологическое событие, выброс магмы или пепла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ecad923-a8c0-37e7-a2d9-6f97338f971c",
                    "sense_definition": "A sudden release of pressure or tension.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sudden_release",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was an <w>eruption</w> of joy at the final whistle.",
                            "target_lang_translations": {
                                "ru": "После финального свистка раздался <w>взрыв</w> радости."
                            }
                        },
                        {
                            "text": "The crowd's <w>eruption</w> of applause followed the singer's performance.",
                            "target_lang_translations": {
                                "ru": "После выступления певца последовал <w>взрыв</w> аплодисментов толпы."
                            }
                        }
                    ],
                    "synonyms": [
                        "outburst",
                        "explosion"
                    ],
                    "common_phrases": [
                        "eruption of joy",
                        "eruption of applause"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное высвобождение давления или напряжения, часто эмоциональное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взрыв",
                                "target_lang_sense_clarification": "переносное значение: бурное проявление чувств или эмоций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daba1365-18e6-3968-b76f-48f52a98aedd",
                    "sense_definition": "An infection of the skin resulting in a rash or blemishing.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient developed a skin <w>eruption</w> after using the new cream.",
                            "target_lang_translations": {
                                "ru": "У пациента появилась кожная <w>сыпь</w> после использования нового крема."
                            }
                        },
                        {
                            "text": "A painful <w>eruption</w> appeared on her arm after the allergic reaction.",
                            "target_lang_translations": {
                                "ru": "После аллергической реакции на её руке появилась болезненная <w>сыпь</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "rash",
                        "breakout"
                    ],
                    "common_phrases": [
                        "skin eruption"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кожное заболевание, проявляющееся в виде сыпи или пятен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сыпь",
                                "target_lang_sense_clarification": "мелкие пятнышки или прыщики на коже"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "beb94563-d9e0-3217-973b-ff06ad14de8f",
                    "sense_definition": "An utterance, especially a sudden one; an ejaculation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sudden_release",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden <w>eruption</w> of anger surprised everyone in the room.",
                            "target_lang_translations": {
                                "ru": "Его внезапный <w>взрыв</w> гнева удивил всех в комнате."
                            }
                        },
                        {
                            "text": "She made a sharp <w>eruption</w> of protest during the meeting.",
                            "target_lang_translations": {
                                "ru": "Она резко <w>выразила</w> протест во время собрания."
                            }
                        }
                    ],
                    "synonyms": [
                        "outburst",
                        "exclamation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное высказывание или выкрик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взрыв",
                                "target_lang_sense_clarification": "внезапное проявление эмоций в речи"
                            },
                            {
                                "target_lang_word": "выпад",
                                "target_lang_sense_clarification": "резкое, критическое замечание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}