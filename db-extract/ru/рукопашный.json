                "senses": [
                    {
                        "sense_id": "d435c242-9e11-30ca-895b-a0912aa288a6",
                        "entry_id": "b742c705-505c-3c9d-b7b5-3ee8c57fc31e",
                        "glosses": [
                            "осуществляемый без оружия или с использованием холодного оружия (о бое, схватке)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7102017-9e5b-4444-a9b6-095c6c5c51b2",
                                "sense_id": "d435c242-9e11-30ca-895b-a0912aa288a6",
                                "text": "Рукопашный бой завязался — солдаты уже были на валу — разбойники начали уступать .."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5cf71fc-d72a-3f45-86f0-6ded344b13bc",
                        "entry_id": "b742c705-505c-3c9d-b7b5-3ee8c57fc31e",
                        "glosses": [
                            "субстантивир. то же, что рукопашный бой; бой, осуществляемый без оружия или с использованием холодного оружия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e75e170-69f9-4577-a521-3fe5791f5db4",
                                "sense_id": "d5cf71fc-d72a-3f45-86f0-6ded344b13bc",
                                "text": "— У тебя шинель в крови: неужели ты дрался в рукопашном? — спросил его Калугин."
                            }
                        ]
                    }
                ],
