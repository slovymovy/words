                            {
                                "example_id": "42e7b5d1-c83f-4504-8668-9da4c93ef9b8",
                                "sense_id": "50f1e50c-7806-3b18-81eb-d2d1078cb4c9",
                                "text": "Un sans-rien s’emparait alors du journal, le regardait parfois mais pas souvent, puis s’en servait pour envelopper sa boureille."
                            },
                            {
                                "example_id": "76b7ebcf-de68-4c74-87d3-98074df7650e",
                                "sense_id": "50f1e50c-7806-3b18-81eb-d2d1078cb4c9",
                                "text": "Les malades, les exclus, les perdus, les pécheurs, les sans-rien, ceux qui ne comptent pas, même à leurs propres yeux."
                            },
                            {
                                "example_id": "d14a4675-b6d2-4511-8f1e-54a9cb3624eb",
                                "sense_id": "50f1e50c-7806-3b18-81eb-d2d1078cb4c9",
                                "text": "L’abbé Pierre est mort, «les sans-rien orphelins»"
                            }
                        ]
