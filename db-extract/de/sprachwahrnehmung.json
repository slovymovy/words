                "senses": [
                    {
                        "sense_id": "beae5096-ab0d-39af-bbf3-e1607e5e2e7e",
                        "entry_id": "8fb19d6f-ed50-3617-a145-ed8808476432",
                        "glosses": [
                            "Wahrnehmung sprachlicher Äußerungen mit Hörsinn, Gesichtssinn oder Tastsinn und Erkennung der darin enthaltenen sprachlichen Einheiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31e4d0f9-aeba-4a5e-8716-ae02bb4c7717",
                                "sense_id": "beae5096-ab0d-39af-bbf3-e1607e5e2e7e",
                                "text": "Sprachwahrnehmung meint meist das Wahrnehmen und Erkennen der Formen sprachlicher Einheiten in Äußerungen."
                            },
                            {
                                "example_id": "4dc0ad66-18c6-43fe-bef7-ef4f9f23903a",
                                "sense_id": "beae5096-ab0d-39af-bbf3-e1607e5e2e7e",
                                "text": "Die Sprachwahrnehmung ist Voraussetzung für das Sprachverstehen."
                            },
                            {
                                "example_id": "ab981748-fdb8-48f5-8b0a-7d9eff0570ae",
                                "sense_id": "beae5096-ab0d-39af-bbf3-e1607e5e2e7e",
                                "text": "Lewandowski charakterisiert Sprachrezeption als einheitlichen Prozess von „Spracherkennung, Sprachwahrnehmung und Sprachverstehen.“"
                            },
                            {
                                "example_id": "87164c92-0ec2-464f-aca3-b4ec0fcd6599",
                                "sense_id": "beae5096-ab0d-39af-bbf3-e1607e5e2e7e",
                                "text": "„Gemäß der sogenannten Motor-Theorie der Sprachwahrnehmung (…) erfolgt die Wahrnehmung über die Rückmeldung der Anweisung an die Artikulationsorgane des Hörers, in Stellung zu gehen, das heißt der einlaufende Reiz löst im Hörer selbst die Tendenz zur Artikulation aus und wird so identifiziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
