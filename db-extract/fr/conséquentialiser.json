                "senses": [
                    {
                        "sense_id": "bc2ab22b-c8ef-3dea-89ec-88dc745bb749",
                        "entry_id": "68b6f686-b39f-3cce-be78-f1d85c62eb96",
                        "glosses": [
                            "Donner un caractère conséquentiel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c90c3d6-fece-40ef-99c4-32854c3fd205",
                                "sense_id": "bc2ab22b-c8ef-3dea-89ec-88dc745bb749",
                                "text": "Si l’on adopte cette seconde définition, il existe donc alors une façon de « conséquentialiser » l’anti-conséquentialisme, du moment que l’on adopte une définition suffisamment large de la notion de conséquence (Brown 2004 : 16sqq)."
                            },
                            {
                                "example_id": "b678f143-2f03-409b-92ec-e3305b6ce557",
                                "sense_id": "bc2ab22b-c8ef-3dea-89ec-88dc745bb749",
                                "text": "Aucun de ces trois moments ne suffit à lui seul, et aucun ne conséquentialise l’autre ; aucun n’est naturel et instinctif."
                            }
                        ]
                    }
