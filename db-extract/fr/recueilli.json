                                "target_senses": [
                                    {
                                        "sense_id": "0f4a0b5c-0c7c-3746-a5ad-91d88c24890e",
                                        "entry_id": "530f0c39-f516-3e9b-ab16-a57c9efe456d",
                                        "glosses": [
                                            "Gathered together."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14745cd7-74d8-43a5-b7b6-ff30aec7520d",
                                                "sense_id": "0f4a0b5c-0c7c-3746-a5ad-91d88c24890e",
                                                "text": "the collected works of Charles Dickens"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec2fdd31-3d3d-3051-88c0-df2ba5182b3a",
                                        "entry_id": "530f0c39-f516-3e9b-ab16-a57c9efe456d",
                                        "glosses": [
                                            "Cool‐headed, emotionally stable, in focus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00e1a2e5-b0ca-414c-b94c-9f63ac3c43fa",
                                                "sense_id": "ec2fdd31-3d3d-3051-88c0-df2ba5182b3a",
                                                "text": "He stayed collected throughout the ordeal."
                                            },
                                            {
                                                "example_id": "2c590ec2-099a-42d2-8edd-b326be3d6971",
                                                "sense_id": "ec2fdd31-3d3d-3051-88c0-df2ba5182b3a",
                                                "text": "In an instant Francesca would become perfectly collected—every past event would stand out singularly clear, and she would turn, take one look at Guido, and then breathe again."
                                            },
                                            {
                                                "example_id": "d372e29b-8a27-4fb4-b67e-3d26a4ab3a01",
                                                "sense_id": "ec2fdd31-3d3d-3051-88c0-df2ba5182b3a",
                                                "text": "There is no man here so young—and we have some very young members—but he must have observed, must have known from the impulses of his own mind and his own feelings, that, when in a state of high excitement, a man's judgment is not so accurate, not so effectual, not to be relied upon to such an extent, as when he is cool, calm and collected. That is an axiom in morals, in the history of human life, about which I suppose there will be no question. Are we now in that condition?"
                                            },
                                            {
                                                "example_id": "1f42d375-bf42-4ad4-90fb-62bcee827fe8",
                                                "sense_id": "ec2fdd31-3d3d-3051-88c0-df2ba5182b3a",
                                                "text": "He became very cool and collected all at once."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "collected",
                                "target_lang_code": "en",
