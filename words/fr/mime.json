                        "cours de mime"
                    ]
                },
                {
                    "sense_id": "6b84c05d-b794-3c52-aaea-ef48240bc4f8",
                    "sense_definition": "Comédien ou artiste qui s'exprime par le geste et le jeu corporel, sans recourir à la parole.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "theatre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>mime</w> amuse les passants au coin de la rue piétonne."
                        },
                        {
                            "text": "Ce célèbre <w>mime</w> réussit à émouvoir le public sans dire un mot."
                        }
                    ],
                    "common_phrases": [
