    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d5c53cb3-5fa3-38c0-b3cf-5726feb4567e",
                "word": "VHS",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dcc9ac60-5f10-4d2e-8933-72fb8690c157",
                        "entry_id": "d5c53cb3-5fa3-38c0-b3cf-5726feb4567e",
                        "tags": [
                            "plural"
                        ],
                        "form": "VHSes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "000d6527-c1c0-3749-86f8-873cfaba4d76",
                        "entry_id": "d5c53cb3-5fa3-38c0-b3cf-5726feb4567e",
                        "glosses": [
                            "A type of videotape originally developed by the Japanese company JVC."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "96da2177-6c5f-4a3f-b61b-1c7d12956c92",
                                "sense_id": "000d6527-c1c0-3749-86f8-873cfaba4d76",
                                "text": "The curt take on VHS is that it is a dead format, a quaint and sham way to watch a movie. Regardless, to date, there are quantities of VHS titles not available on DVD, and that may never be."
                            },
                            {
                                "example_id": "97ffa3bd-77b4-4203-83d9-10dc1e15d1b6",
                                "sense_id": "000d6527-c1c0-3749-86f8-873cfaba4d76",
                                "text": "There is, it turns out, much demand for these old VHS tapes, price tags notwithstanding, and despite post-2006 advancements in technology."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a41b6e28-e572-4c6f-945f-e0dc1c086817",
                        "source_entry_id": "d5c53cb3-5fa3-38c0-b3cf-5726feb4567e",
                        "source_sense_id": "000d6527-c1c0-3749-86f8-873cfaba4d76",
                        "source_sense_description": "videotape developed by JVC",
                        "target_lang_word": "VHS",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "VHS",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3ea74ea-b6c7-3e8e-9d6e-ca9cbc301316",
                                        "entry_id": "7df05192-34de-355d-ae93-17711b9779b6",
                                        "glosses": [
                                            "Caméra à la norme VHS."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50f880f6-0355-49be-bd4d-87911dd543e4",
                                                "sense_id": "b3ea74ea-b6c7-3e8e-9d6e-ca9cbc301316",
                                                "text": "« Tout un courant s’est développé depuis quinze-vingt ans, la “technostalgie”, une manière d’innover à partir des technologies du passé », explique l’experte, citant les walkmans Bluetooth, les applications qui permettent de filmer à la manière d’une VHS et autre machine à écrire USB."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "VHS",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46a4b068-4629-3f35-9bc6-b78a30232073",
                                        "entry_id": "13f7c475-a04f-3dce-98de-4817f6dafc5a",
                                        "glosses": [
                                            "Norme d’enregistrement de signaux vidéo sur bande magnétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f83ce57-84f9-4ea5-b2da-f16d311f9f26",
                                                "sense_id": "46a4b068-4629-3f35-9bc6-b78a30232073",
                                                "text": "De ces virées estivales témoignent toute une série de films super huit que j’ai récupérés, transférés sur VHS, où l’on voit Lucile et ses frères et sœurs sur la plage, cheveux délavés par le soleil et maillots d’époque, réunis dans l’eau autour d’un bateau gonflable ou allongés en rang d’oignon sur le sable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "VHS",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd13852c-d50a-3d5b-a013-49ea3aa93ddf",
                                        "entry_id": "79728491-e824-3f29-ac7e-6dc434c9fd07",
                                        "glosses": [
                                            "Les vidéocassettes de bandes magnétiques qui répondent à la norme VHS."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef16e3f4-99b0-4189-a828-5325aad30c80",
                                                "sense_id": "bd13852c-d50a-3d5b-a013-49ea3aa93ddf",
                                                "text": "Aux murs, des étagères de VHS, quelques photos de Baywatch et un poster de Bruce Lee, très détendu pour une fois."
                                            },
                                            {
                                                "example_id": "411b98fd-9387-45a7-9650-3ce5bfa9ef4d",
                                                "sense_id": "bd13852c-d50a-3d5b-a013-49ea3aa93ddf",
                                                "text": "Julia enregistre sur VHS les films de Fritz Lang, Josef von Sternberg, Orson Welles, Elia Kazan, John Huston, Arthur Penn, qui passent au « Ciné-Club » d’Antenne 2."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89fd101d-8a36-4101-8f53-28c42ccf3e68",
                        "source_entry_id": "d5c53cb3-5fa3-38c0-b3cf-5726feb4567e",
                        "source_sense_id": "000d6527-c1c0-3749-86f8-873cfaba4d76",
