{
    "word_family": [
        "incense"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b94bd1ad-8f6e-349e-9487-8a90f7148a73",
                    "sense_definition": "Extremely angry; enraged.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The customers were <w>incensed</w> by the sudden increase in prices.",
                            "target_lang_translations": {
                                "ru": "Клиенты были <w>разъярены</w> внезапным повышением цен.",
                                "nl": "De klanten waren <w>woedend</w> door de plotselinge prijsstijging.",
                                "es": "Los clientes estaban <w>indignados</w> por el repentino aumento de precios."
                            }
                        },
                        {
                            "text": "She became <w>incensed</w> at the way she had been treated by the staff.",
                            "target_lang_translations": {
                                "ru": "Она была <w>взбешена</w> тем, как с ней обошёлся персонал.",
                                "nl": "Ze werd <w>razend</w> om de manier waarop ze door het personeel was behandeld.",
                                "es": "Ella se puso <w>furiosa</w> por la forma en que la había tratado el personal."
                            }
                        }
                    ],
                    "synonyms": [
                        "enraged",
                        "infuriated",
                        "furious",
                        "irate",
                        "livid"
                    ],
                    "antonyms": [
                        "calm",
                        "pleased",
                        "delighted"
                    ],
                    "common_phrases": [
                        "incensed by",
                        "incensed at",
                        "become incensed",
                        "absolutely incensed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно сердитый; в состоянии ярости.",
                        "nl": "Extreem boos; woedend.",
                        "es": "Extremadamente enfadado; furioso o indignado."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разъярённый",
                                "target_lang_sense_clarification": "охваченный яростью"
                            },
                            {
                                "target_lang_word": "взбешённый",
                                "target_lang_sense_clarification": "крайне раздражённый, доведённый до бешенства"
                            },
                            {
                                "target_lang_word": "рассерженный",
                                "target_lang_sense_clarification": "испытывающий гнев"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "woedend",
                                "target_lang_sense_clarification": "zeer boos"
                            },
                            {
                                "target_lang_word": "razend",
                                "target_lang_sense_clarification": "in een staat van woede"
                            },
                            {
                                "target_lang_word": "verontwaardigd",
                                "target_lang_sense_clarification": "boos vanwege onrecht"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "indignado",
                                "target_lang_sense_clarification": "muy molesto por una injusticia"
                            },
                            {
                                "target_lang_word": "furioso",
                                "target_lang_sense_clarification": "lleno de ira o furia"
                            },
                            {
                                "target_lang_word": "enfurecido",
                                "target_lang_sense_clarification": "que ha montado en cólera"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6536a982-f1db-304f-b644-9c404b70cf23",
                    "sense_definition": "Depicted with fire issuing from the mouth and ears.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family coat of arms features a lion <w>incensed</w> to symbolize ferocity.",
                            "target_lang_translations": {
                                "ru": "На фамильном гербе изображён лев, <w>извергающий пламя</w>, что символизирует свирепость.",
                                "nl": "Het familiewapen toont een <w>vuurspuwende</w> leeuw om wreedheid te symboliseren.",
                                "es": "El escudo familiar muestra a un león <w>que echa fuego</w> para simbolizar la ferocidad."
                            }
                        },
                        {
                            "text": "In the design, the panther is <w>incensed</w> proper with flames visible.",
                            "target_lang_translations": {
                                "ru": "В этом дизайне пантера изображена <w>с пламенем</w> естественного цвета.",
                                "nl": "In het ontwerp is de panter <w>vuurspuwend</w> afgebeeld met zichtbare vlammen.",
                                "es": "En el diseño, la pantera está representada <w>echando fuego</w> al natural, con llamas visibles."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изображённый с огнём, вырывающимся из пасти и ушей (в геральдике).",
                        "nl": "Afgebeeld met vuur dat uit de mond en oren komt (heraldiek).",
                        "es": "En heráldica, representado arrojando fuego por la boca y las orejas."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извергающий пламя",
                                "target_lang_sense_clarification": "геральдический термин"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "vuurspuwend",
                                "target_lang_sense_clarification": "heraldieke term voor een dier met vlammen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "que echa fuego",
                                "target_lang_sense_clarification": "en heráldica, emitiendo llamas"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4a99dfd-1966-3e87-a2ac-ae975cf0654b",
                    "sense_definition": "Simple past and past participle of <w>incense</w>.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His rude comments <w>incensed</w> the entire audience.",
                            "target_lang_translations": {
                                "ru": "Его грубые комментарии <w>разгневали</w> всю аудиторию.",
                                "nl": "Zijn onbeschofte opmerkingen hebben het hele publiek <w>woedend gemaakt</w>.",
                                "es": "Sus comentarios groseros <w>indignaron</w> a todo el público."
                            }
                        },
                        {
                            "text": "The unfair decision <w>incensed</w> the local community.",
                            "target_lang_translations": {
                                "ru": "Несправедливое решение <w>взбесило</w> местное сообщество.",
                                "nl": "Het oneerlijke besluit heeft de lokale gemeenschap <w>verbolgen</w>.",
                                "es": "La injusta decisión <w>enfureció</w> a la comunidad local."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола incense (разгневать).",
                        "nl": "Verleden tijd en voltooid deelwoord van 'incense' (woedend maken).",
                        "es": "Pasado simple y participio pasado del verbo 'incense' (enfurecer o indignar)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгневал",
                                "target_lang_sense_clarification": "привёл в состояние гнева"
                            },
                            {
                                "target_lang_word": "взбесил",
                                "target_lang_sense_clarification": "сильно разозлил"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "woedend gemaakt",
                                "target_lang_sense_clarification": "iemand tot woede drijven"
                            },
                            {
                                "target_lang_word": "verbolgen",
                                "target_lang_sense_clarification": "zeer boos gemaakt"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "enfureció",
                                "target_lang_sense_clarification": "pasado de enfurecer"
                            },
                            {
                                "target_lang_word": "indignó",
                                "target_lang_sense_clarification": "pasado de indignar"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}