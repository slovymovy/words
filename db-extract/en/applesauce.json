                    {
                        "translation_id": "2681c43e-0874-41d3-ab84-eab40bd8618a",
                        "source_entry_id": "387af96d-5f21-3c07-a2d2-9fe0af82fe1b",
                        "source_sense_id": "1a7b9db3-d837-38b8-9720-52a97415e8ae",
                        "source_sense_description": "Apfelmus",
                        "target_lang_word": "Apfelmus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apfelmus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9752b24c-ab19-30df-a798-a77ed30b0f68",
                                        "entry_id": "abe4c0eb-1eac-3899-bc81-d6e540656845",
                                        "glosses": [
                                            "Mus, Brei aus gekochten und zerdrückten oder pürierten Apfelstücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3cfe1bf-00bf-4b41-b1d1-c6c2b2b56d40",
                                                "sense_id": "9752b24c-ab19-30df-a798-a77ed30b0f68",
                                                "text": "Viele Kinder essen gerne Kartoffelpuffer mit Apfelmus."
                                            },
                                            {
                                                "example_id": "63269dc9-f030-4393-a3da-f447ab4d0d30",
                                                "sense_id": "9752b24c-ab19-30df-a798-a77ed30b0f68",
                                                "text": "„Hinter der Theke im Café stand jetzt ein Mann, der frischen Apfelkuchen mit einem großen Messer in Stücke schnitt: das braune Gitterwerk aus Teig über dem grünen Apfelmus war frisch und der Mann drückte das Messer vorsichtig in den Kuchen, um das Gitterwerk nicht zu zerstören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d79a4efa-a77f-4d86-be76-1bec0c0bb393",
                        "source_entry_id": "387af96d-5f21-3c07-a2d2-9fe0af82fe1b",
                        "source_sense_id": "108c35c8-bf25-3d5d-9437-2bf96ca4e7e4",
                        "source_sense_description": "umgangssprachlich: etwas, das keinen Sinn ergibt; Nonsens, Quatsch mit Soße, Unsinn",
                        "target_lang_word": "Nonsens",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nonsens",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "011ac257-9d87-31fe-adab-9aadeeb293be",
                                        "entry_id": "ee1ec8e2-4ede-38df-b9de-2e0aa0f57e2e",
                                        "glosses": [
                                            "etwas Sinnloses; Quatsch"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16b526c9-8afe-483b-8b6f-b8bdf512d632",
                                                "sense_id": "011ac257-9d87-31fe-adab-9aadeeb293be",
                                                "text": "Der Nonsens, den Sie von sich geben, ist nicht mehr auszuhalten."
                                            },
                                            {
                                                "example_id": "74d564e0-3949-4144-b070-ad35a59aea56",
                                                "sense_id": "011ac257-9d87-31fe-adab-9aadeeb293be",
                                                "text": "Es ist Nonsens, das Ziel weiter zu verfolgen."
                                            },
                                            {
                                                "example_id": "868eb810-b82c-4ea8-9e2e-3abc3fbeb00b",
                                                "sense_id": "011ac257-9d87-31fe-adab-9aadeeb293be",
                                                "text": "„Das ist Sprech-Musik […] Der Verwaltungsgerichtshof spricht von ‚prävalierender Rechtswidrigkeit‘. Soll heißen: Die Bescheide der Erst- und Berufungsbehörde sind totaler Nonsens, hirnrissig, ein Armutszeugnis.“"
                                            },
                                            {
                                                "example_id": "f6b5eedb-002a-438a-b28d-7c5158386db1",
                                                "sense_id": "011ac257-9d87-31fe-adab-9aadeeb293be",
                                                "text": "„Erst zu Hause, wenn ich auf dem Bett liegend noch einmal in Gedanken die politischen Neuigkeiten analysierte, kam ich zu dem Schluß, daß Zyskinds Beweisführungen Nonsens waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e871a49b-1ed4-446e-b089-12938bbccfca",
                        "source_entry_id": "387af96d-5f21-3c07-a2d2-9fe0af82fe1b",
                        "source_sense_id": "108c35c8-bf25-3d5d-9437-2bf96ca4e7e4",
                        "source_sense_description": "umgangssprachlich: etwas, das keinen Sinn ergibt; Nonsens, Quatsch mit Soße, Unsinn",
                        "target_lang_word": "Unsinn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unsinn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d3c72e9-a9d8-3af3-bd11-a546ba4f1e62",
                                        "entry_id": "c7fd412d-3bc1-32ba-b355-5ed77d61f42a",
                                        "glosses": [
                                            "etwas, das keinen Sinn hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3b38575-a2a1-4aa8-9012-764310c3db97",
                                                "sense_id": "4d3c72e9-a9d8-3af3-bd11-a546ba4f1e62",
                                                "text": "Was für einen Unsinn sie da wieder von sich gibt!"
                                            },
                                            {
                                                "example_id": "a33bdd3f-4f15-4456-bd76-2ab697fef490",
                                                "sense_id": "4d3c72e9-a9d8-3af3-bd11-a546ba4f1e62",
                                                "text": "Du glaubst wohl auch jeden Unsinn, oder?"
                                            },
                                            {
                                                "example_id": "62ff04c3-ca96-4796-a160-a4df147944a5",
                                                "sense_id": "4d3c72e9-a9d8-3af3-bd11-a546ba4f1e62",
                                                "text": "Das ist doch Unsinn! Nun geh mal wieder nach Hause und sprich mit deinen Eltern."
                                            },
                                            {
                                                "example_id": "5d591364-6683-4169-89a5-471488dc96f7",
                                                "sense_id": "4d3c72e9-a9d8-3af3-bd11-a546ba4f1e62",
                                                "text": "Unsinn! So geht das nicht, schau mal hier, wie man das macht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "01214789-3ffc-3b2b-9382-b77d04afdbea",
                                        "entry_id": "c7fd412d-3bc1-32ba-b355-5ed77d61f42a",
