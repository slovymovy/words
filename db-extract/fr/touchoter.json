                "senses": [
                    {
                        "sense_id": "e3e960fb-a1e3-38ac-971a-e8679cc02336",
                        "entry_id": "49d1a20d-32a2-36d5-a618-5cd3d35dbfd4",
                        "glosses": [
                            "Toucher un peu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4986c18d-f36a-4b75-ba64-01cf3e6f875a",
                                "sense_id": "e3e960fb-a1e3-38ac-971a-e8679cc02336",
                                "text": "Intelligente, vive et sans cesse rafalée d’une pensée à une autre, elle était éveillée à tout sauf à l'amour et au cinoche ; on pouvait lui parler vraiment, l’écouter avec plaisir, l’embrasser, la touchoter et la toucher en profondeur en lui parlant de tout et de rien."
                            },
                            {
                                "example_id": "1b62f1bc-ecd3-4680-aea3-5ce5c67e2ca4",
                                "sense_id": "e3e960fb-a1e3-38ac-971a-e8679cc02336",
                                "text": "La difficulté pour ces acteurs qui, à une exception près, n’avaient jamais touchoté de la puppet ?"
                            }
                        ]
                    }
