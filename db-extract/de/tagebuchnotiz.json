                "senses": [
                    {
                        "sense_id": "5c39da06-276f-3a90-bbf7-e032179d2bb0",
                        "entry_id": "932456aa-c615-398c-a0c8-dd3b27ce53dd",
                        "glosses": [
                            "Notiz in einem Tagebuch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bd6023c-6440-4a8b-a323-a851cdb4a440",
                                "sense_id": "5c39da06-276f-3a90-bbf7-e032179d2bb0",
                                "text": "Manchmal lese ich meine alten Tagebuchnotizen und amüsiere mich köstlich dabei."
                            },
                            {
                                "example_id": "4633cfd9-5d6c-45ab-b76a-058cf1d8b106",
                                "sense_id": "5c39da06-276f-3a90-bbf7-e032179d2bb0",
                                "text": "„Darauf deuten nicht nur die bereits angeführten Tagebuchnotizen hin.“"
                            },
                            {
                                "example_id": "3fd60bc0-5f4e-46b1-b3bf-cb294f8f91ec",
                                "sense_id": "5c39da06-276f-3a90-bbf7-e032179d2bb0",
                                "text": "„Es will mir nicht in den Kopf, keiner dieser fraglos klugen Forscher habe dieses Erlebnis nicht irgendwo vermerkt, in einer unscheinbaren Tagebuchnotiz vielleicht oder in einem Brief an Freunde oder Verwandte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
