                    },
                    {
                        "form_id": "67a45db1-f7bb-4b93-8293-eb169e64a3bf",
                        "entry_id": "b44a9fcf-52dc-3ddf-83bf-21de2089e52a",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind alleingehend"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1e5a7b7-8e21-3c9d-bfb3-ddd37a2dac60",
                        "entry_id": "b44a9fcf-52dc-3ddf-83bf-21de2089e52a",
                        "glosses": [
                            "sich irgendwohin ohne Geleit hinbewegend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12c541d2-cf36-417b-b6b4-009a2c298dcc",
                                "sense_id": "a1e5a7b7-8e21-3c9d-bfb3-ddd37a2dac60",
                                "text": "„Zu allen Stunden des Tages und in allen Straßen Wiens wurden alleingehende Mädchen, die oft nur ausgegangen waren, um sich in Ehren ihren Lebensunterhalt zu verdienen, verhaftet und ins Gefängnis geschleppt.“"
                            },
                            {
                                "example_id": "9da56aa5-99fc-44e4-ba61-b3307c2b2cce",
                                "sense_id": "a1e5a7b7-8e21-3c9d-bfb3-ddd37a2dac60",
                                "text": "„Er hatte den jungen Hilfslehrer Johansen erkannt, der seiner Gewohnheit gemäß hier zwischen den Hügeln nach alleingehenden Mädchen umherschnüffelte.“"
                            },
                            {
                                "example_id": "ca8383c4-27fb-45af-b8ea-bcd96ec2faca",
                                "sense_id": "a1e5a7b7-8e21-3c9d-bfb3-ddd37a2dac60",
                                "text": "„Auf solchem Weg schreitend, der ziemlich weit nach Norden bis an die Grenze der Güter Ekenwart und Helgerslund führte, trafen die beiden eines Morgens in einem Gehölz unvorhergesehen mit einer alleingehenden Dame zusammen. “"
                            },
                            {
                                "example_id": "f80dc9c4-e9e0-4537-9f84-269b0372649e",
                                "sense_id": "a1e5a7b7-8e21-3c9d-bfb3-ddd37a2dac60",
                                "text": "„Der Fremde, der solch eine alleingehende Dame anspricht, riskiert, den Regenschirm ins Gesicht zu bekommen, und ist er nicht still, so kann er auch noch die Fäuste der zu Hilfe eilenden Passanten schmecken.“"
                            },
