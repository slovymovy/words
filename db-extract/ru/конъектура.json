                    {
                        "translation_id": "672ca111-89f5-43ec-b8c5-e6b822c0af15",
                        "source_entry_id": "d7c17480-7145-3df9-ace1-5aaa2f3c250f",
                        "source_sense_description": "восстановление испорченного или не поддающегося прочтению текста",
                        "target_lang_word": "conjecture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjecture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc9cc497-77a0-3513-8b84-dc08d1a040f3",
                                        "entry_id": "590668fb-1a2f-376b-8442-441a71a8d5ab",
                                        "glosses": [
                                            "A statement or an idea which is unproven, but is thought to be true; a guess."
                                        ],
                                        "tags": [
                                            "countable",
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be137276-80d4-46a8-b22b-cb2ae26db75a",
                                                "sense_id": "fc9cc497-77a0-3513-8b84-dc08d1a040f3",
                                                "text": "I explained it, but it is pure conjecture whether he understood, or not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1469caef-a895-3d8a-b775-7808bac00f22",
                                        "entry_id": "590668fb-1a2f-376b-8442-441a71a8d5ab",
                                        "glosses": [
                                            "A supposition based upon incomplete evidence; a hypothesis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce1f7950-92a9-481d-8caf-fb4193b92fad",
                                                "sense_id": "1469caef-a895-3d8a-b775-7808bac00f22",
                                                "text": "The physicist used his conjecture about subatomic particles to design an experiment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "873f8c72-0eb9-3a0a-83b5-b6e1aab46179",
                                        "entry_id": "590668fb-1a2f-376b-8442-441a71a8d5ab",
                                        "glosses": [
                                            "A statement likely to be true based on available evidence, but which has not been formally proven."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d9c4696-ee44-3d08-9661-f29011cefb24",
                                        "entry_id": "590668fb-1a2f-376b-8442-441a71a8d5ab",
                                        "glosses": [
                                            "Interpretation of signs and omens."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "conjecture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fe09d39-7a5c-3999-811c-a3db8af78424",
                                        "entry_id": "920e05f8-0d84-383b-a809-32c47e8e42be",
                                        "glosses": [
                                            "To guess; to venture an unproven idea."
                                        ],
                                        "tags": [
                                            "formal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98358705-b531-4bbd-baf0-548c8e57c155",
                                                "sense_id": "6fe09d39-7a5c-3999-811c-a3db8af78424",
                                                "text": "I do not know if it is true; I am simply conjecturing here."
                                            },
                                            {
                                                "example_id": "29b9d4f2-c57c-4e36-92ed-d273e83c6a35",
                                                "sense_id": "6fe09d39-7a5c-3999-811c-a3db8af78424",
                                                "text": "What could have been done by such a machine downhill can only be conjectured, for the maximum speed was restricted rigidly to 80 m.p.h."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56cdbfd5-8eea-33bd-ae7a-fe16c96cec05",
                                        "entry_id": "920e05f8-0d84-383b-a809-32c47e8e42be",
                                        "glosses": [
                                            "To infer on slight evidence; to guess at."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cb155a3-cf42-4cf1-8faa-0d530281e2ca",
                                                "sense_id": "56cdbfd5-8eea-33bd-ae7a-fe16c96cec05",
                                                "text": "February 22, 1685, Robert South, All Contingences under the Direction of God's Providence (sermon preached at Westminster Abbey)"
                                            },
                                            {
                                                "example_id": "2e712e52-822f-487e-acde-2f14f676b37e",
                                                "sense_id": "56cdbfd5-8eea-33bd-ae7a-fe16c96cec05",
                                                "text": "\"Most likely he who is the shorter of the two;—no! he goes in the first, and is, of course, the eldest; but we have no time for conjecturing now.\"\nHuman reason can then, at the best, but conjecture what will be."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
