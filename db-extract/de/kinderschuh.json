                        ],
                        "form": "den Kinderschuh"
                    },
                    {
                        "form_id": "2e5a996c-33ad-4639-a631-c76de1526dee",
                        "entry_id": "6c0fcc42-d420-3ab7-ae53-4a585c8f6c7c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kinderschuhe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d6eba2a-a57e-30dc-b320-498c0b6ed44c",
                        "entry_id": "6c0fcc42-d420-3ab7-ae53-4a585c8f6c7c",
                        "glosses": [
                            "speziell für Kinder vorgesehener, angefertigter Schuh"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2442c7f8-1e79-47cb-9c23-62b85eefeb26",
                                "sense_id": "8d6eba2a-a57e-30dc-b320-498c0b6ed44c",
                                "text": "Das Geschäft mit Kinderschuhen läuft gut, denn kaum sind sie gekauft, sind die Kinder schon wieder herausgewachsen."
                            },
                            {
                                "example_id": "4b90e657-dcbd-446f-a127-6557d697fb4d",
                                "sense_id": "8d6eba2a-a57e-30dc-b320-498c0b6ed44c",
                                "text": "„Niemand wußte, wievielen Menschen das Haus zum Grab geworden ist. Raupenschlepper konnten zunächst nur das Gröbste wegräumen. Das Fernsehen zeigte einen Kinderschuh neben dem Schutt.“"
                            },
                            {
                                "example_id": "24cc3014-f3bb-42a4-ba92-9402d6bdeb88",
                                "sense_id": "8d6eba2a-a57e-30dc-b320-498c0b6ed44c",
                                "text": "„Unter der Beute waren zum Beispiel viele Babyjacken oder -hemden und Kinderschuhe.“"
                            },
                            {
                                "example_id": "c67a22a6-44c5-48e7-9aa1-5b05e6d9ae6f",
                                "sense_id": "8d6eba2a-a57e-30dc-b320-498c0b6ed44c",
                                "text": "„Aber länger als zwei Wochen sollten so teure Kinderschuhe, immerhin für 130 Mark, schon halten, meint die Kundin.“"
                            },
                            {
                                "example_id": "604fcbb7-72cc-41a0-8175-9a7fa99389d0",
                                "sense_id": "8d6eba2a-a57e-30dc-b320-498c0b6ed44c",
                                "text": "„Dabei trafen sie etliche Kinder und Jugendliche an, die einräumten, immer wieder zwischen den Gräbern gespielt zu haben. So war auf einem liegenden Grabstein auch ein Abdruck eines Kinderschuhs gefunden worden.“"
                            },
                            {
                                "example_id": "eb184eae-c1cf-4de6-999f-7686beb5588d",
                                "sense_id": "8d6eba2a-a57e-30dc-b320-498c0b6ed44c",
                                "text": "„Orthopäden der Universitätsklinik Münster schlagen Alarm: Bei jedem zweiten Kinderschuh ist eine falsche Größenangabe aufgedruckt, manche sind sogar vier Nummern kleiner als vom Hersteller angegeben.“"
                            },
                            {
                                "example_id": "5610fcb3-a06c-40d7-b745-f3bddfc01a62",
                                "sense_id": "8d6eba2a-a57e-30dc-b320-498c0b6ed44c",
                                "text": "„Inbrünstig erinnert sie sich am Anfang an die erste Nacht mit Juan, von Neugier geplagt will sie von der Freundin Details vom Verlauf der Schwangerschaft erfahren, wie eine erfahrene Frau ermahnt sie die Schwangere zur vorsichtigen Bewegung, und gedankenverloren umarmt sie in einer stummen Szene den Karton mit den Kinderschuhen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
