{
    "word_family": [
        "oplichter",
        "oplichterij"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "06a7ec78-3c1e-3f5a-b3b1-f343648a9454",
                    "sense_definition": "door middel van bedrog geld of goederen afhandig maken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bedriegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De criminelen probeerden oudere mensen via een telefoontje <w>op</w> te <w>lichten</w>.",
                            "target_lang_translations": {
                                "en": "The criminals tried <w>to scam</w> elderly people over the phone."
                            }
                        },
                        {
                            "text": "Hij ontdekte te laat dat een betrouwbaar lijkende verkoper hem had <w>opgelicht</w>.",
                            "target_lang_translations": {
                                "en": "He discovered too late that a seemingly trustworthy seller had <w>swindled</w> him."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedriegen",
                        "belazeren"
                    ],
                    "common_phrases": [
                        "mensen oplichten",
                        "iemand oplichten"
                    ],
                    "target_lang_definitions": {
                        "en": "to obtain money or goods from someone by deceit or fraud"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to scam",
                                "target_lang_sense_clarification": "to defraud someone of money or property"
                            },
                            {
                                "target_lang_word": "to swindle",
                                "target_lang_sense_clarification": "to cheat someone out of money through deception"
                            },
                            {
                                "target_lang_word": "to rip off",
                                "target_lang_sense_clarification": "informal, to cheat someone financially"
                            },
                            {
                                "target_lang_word": "to defraud",
                                "target_lang_sense_clarification": "formal, to obtain money or property illegitimately"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f39c556-0c81-3857-9036-41e893bc220a",
                    "sense_definition": "plotseling helder worden of licht gaan uitstralen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "licht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het scherm van zijn mobiele telefoon <w>lichtte</w> plotseling <w>op</w> in het donker.",
                            "target_lang_translations": {
                                "en": "His mobile phone screen suddenly <w>lit up</w> in the dark."
                            }
                        },
                        {
                            "text": "Tijdens het hevige onweer <w>lichtte</w> de hele hemel fel <w>op</w> door de bliksem.",
                            "target_lang_translations": {
                                "en": "During the severe thunderstorm, the entire sky <w>lit up</w> brightly with lightning."
                            }
                        }
                    ],
                    "synonyms": [
                        "opflikkeren",
                        "opgloeien"
                    ],
                    "antonyms": [
                        "doven"
                    ],
                    "common_phrases": [
                        "in het donker oplichten",
                        "fel oplichten"
                    ],
                    "target_lang_definitions": {
                        "en": "to suddenly become bright or start emitting light"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to light up",
                                "target_lang_sense_clarification": "to suddenly become illuminated or bright"
                            },
                            {
                                "target_lang_word": "to illuminate",
                                "target_lang_sense_clarification": "to flash or shine with light"
                            },
                            {
                                "target_lang_word": "to glow",
                                "target_lang_sense_clarification": "to emit light, shine in the dark"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "268be882-9cdc-3aa4-bc88-6cefb64b2c6e",
                    "sense_definition": "een vrolijke, levendige of stralende uitdrukking krijgen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "licht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Haar ogen <w>lichtten</w> meteen <w>op</w> toen ze haar oude vriend zag binnenkomen.",
                            "target_lang_translations": {
                                "en": "Her eyes immediately <w>lit up</w> when she saw her old friend walk in."
                            }
                        },
                        {
                            "text": "Zijn hele gezicht <w>licht</w> altijd <w>op</w> als hij over zijn passie praat.",
                            "target_lang_translations": {
                                "en": "His whole face always <w>brightens</w> when he talks about his passion."
                            }
                        }
                    ],
                    "synonyms": [
                        "stralen"
                    ],
                    "common_phrases": [
                        "ogen lichten op",
                        "gezicht licht op"
                    ],
                    "target_lang_definitions": {
                        "en": "to take on a joyful, lively, or radiant expression"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to light up",
                                "target_lang_sense_clarification": "of a face or eyes, becoming visibly happy or excited"
                            },
                            {
                                "target_lang_word": "to brighten",
                                "target_lang_sense_clarification": "of expression, becoming cheerful"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f2f485b-1d18-368b-93bc-ba684cd1f806",
                    "sense_definition": "iets een klein stukje van de grond of ondergrond optillen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tillen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>lichtte</w> het zware vloerkleed voorzichtig <w>op</w> om de sleutel eronder te pakken.",
                            "target_lang_translations": {
                                "en": "She carefully <w>lifted</w> the heavy rug <w>up slightly</w> to grab the key underneath."
                            }
                        },
                        {
                            "text": "Je moet het deksel een klein beetje <w>oplichten</w> zodat de stoom kan ontsnappen.",
                            "target_lang_translations": {
                                "en": "You need to <w>lift</w> the lid a little bit so that the steam can escape."
                            }
                        }
                    ],
                    "synonyms": [
                        "opheffen",
                        "optillen"
                    ],
                    "antonyms": [
                        "neerleggen"
                    ],
                    "common_phrases": [
                        "een deksel oplichten",
                        "het kleed oplichten"
                    ],
                    "target_lang_definitions": {
                        "en": "to lift something slightly off the floor or a surface"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to lift up slightly",
                                "target_lang_sense_clarification": "to raise something a little bit from a surface"
                            },
                            {
                                "target_lang_word": "to raise slightly",
                                "target_lang_sense_clarification": "to lever or ease something upwards a small amount"
                            },
                            {
                                "target_lang_word": "to pry up",
                                "target_lang_sense_clarification": "to lift slightly at an edge"
                            }
                        ]
                    }
                }
            ]
        }
    ]
