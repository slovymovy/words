        "fr-extract.jsonl": [
            {
                "entry_id": "011d3376-5f81-3115-8e8b-c0e4066d3bb4",
                "word": "Amaryllis",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2c515cdb-04e1-39d7-ac57-a1d80a8197b2",
                        "entry_id": "011d3376-5f81-3115-8e8b-c0e4066d3bb4",
                        "glosses": [
                            "Bergère de l’Antiquité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3a25b2e-f9ee-4474-b7c0-a8e36cc031e9",
                                "sense_id": "2c515cdb-04e1-39d7-ac57-a1d80a8197b2",
                                "text": "Amaryllis s’étendit toute languissante sur la mousse, et du bout de sa branche de saule toucha la main du plus jeune homme."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "efe7aba9-e276-398c-8879-d1837d2f6d71",
                "word": "Amaryllis",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1783babc-bc21-34ac-95f0-49eafe41e0ab",
                        "entry_id": "efe7aba9-e276-398c-8879-d1837d2f6d71",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a6b23b7-0bbe-48c5-acf7-a14bbb88bf85",
                                "sense_id": "1783babc-bc21-34ac-95f0-49eafe41e0ab",
                                "text": "À l’inverse, des milliers de parents cherchent toujours une place subventionnée pour leurs enfants, même s’ils paient leurs impôts comme tout le monde. Un sentiment d’iniquité les habite. C’est le cas d’Amaryllis Pâquet, qui a inscrit sa fille Violette, 14 mois, sur les listes d’attente avant sa naissance."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "29f27a31-31be-324a-91d0-73a8a685bdd2",
                "word": "amaryllis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0621c7d1-a418-3688-ab72-35372acfb95e",
                        "entry_id": "29f27a31-31be-324a-91d0-73a8a685bdd2",
                        "glosses": [
                            "Plante d’ornement du genre Amaryllis , de la famille des Amaryllidacées (Amaryllidaceae)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2edb91a5-5dc6-4fef-81d3-4396197698bf",
                                "sense_id": "0621c7d1-a418-3688-ab72-35372acfb95e",
                                "text": "Le pays n’avait pas changé. Il était toujours fertile et riche en amaryllis, violettes arborescentes, fluschies, daturas et cactus à fleurs d’or."
                            },
                            {
                                "example_id": "b5e53729-3831-4a15-852e-892e3117807f",
                                "sense_id": "0621c7d1-a418-3688-ab72-35372acfb95e",
                                "text": "Il ne faut pas confondre lʼamaryllis avec lʼhippeastrum qui est une plante dʼintérieur et fleurit au printemps."
                            },
                            {
                                "example_id": "1e7f9a75-cc54-438b-9263-fc49e9f6a831",
                                "sense_id": "0621c7d1-a418-3688-ab72-35372acfb95e",
                                "text": "À chaque escale à Amsterdam, je filais au marché aux fleurs du Singel ou chez un vieil horticulteur de Schoorl pour lui rapporter des oignons de jonquilles, de jacinthes, de muscaris, d’amaryllis."
                            }
                        ]
                    }
                ],
