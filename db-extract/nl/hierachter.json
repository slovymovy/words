                    },
                    {
                        "translation_id": "1d4c2687-dd64-49e0-a4db-e9dd1ba371bb",
                        "source_entry_id": "bed83086-553a-36f1-acc1-68ddc379be7e",
                        "source_sense_id": "9f9a96be-ac51-3f07-bf38-9ee3837028e6",
                        "source_sense_description": "vervangt achter dit, achter deze",
                        "target_lang_word": "derrière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "derrière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf628f6a-5489-3023-be69-dfa6b43c4026",
                                        "entry_id": "3da48632-8b93-3e12-b6a9-473972020408",
                                        "glosses": [
                                            "En arrière ou du côté opposé à la face."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cabaf00-3ab9-412c-a982-afeed65888f4",
                                                "sense_id": "cf628f6a-5489-3023-be69-dfa6b43c4026",
                                                "text": "Je l’ai laissé bien loin derrière."
                                            },
                                            {
                                                "example_id": "742018b9-402d-432a-970a-e83557cd1450",
                                                "sense_id": "cf628f6a-5489-3023-be69-dfa6b43c4026",
                                                "text": "Regarder derrière."
                                            },
                                            {
                                                "example_id": "1c4e6460-10f1-4469-ab03-c7f4c79e9fbb",
                                                "sense_id": "cf628f6a-5489-3023-be69-dfa6b43c4026",
                                                "text": "Qu’importe que cela soit devant ou derrière ?"
                                            },
                                            {
                                                "example_id": "4f8c809a-8679-4795-832e-bcc543fd1180",
                                                "sense_id": "cf628f6a-5489-3023-be69-dfa6b43c4026",
                                                "text": "Il fauchait les touffes d’échaudures qui poussaient dans la pâture de derrière."
                                            },
                                            {
                                                "example_id": "03714fdd-7b3d-46ca-b523-191dd3559894",
                                                "sense_id": "cf628f6a-5489-3023-be69-dfa6b43c4026",
                                                "text": "Regarde derrière cette colline."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "derrière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2824e81e-15fa-3f06-9f41-b796a6ff6798",
                                        "entry_id": "db964c6f-a827-3be6-9560-b24070d27175",
                                        "glosses": [
                                            "Du côté opposé à la face d’une personne ou d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9601b39f-7568-4718-b221-52a8a7410554",
                                                "sense_id": "2824e81e-15fa-3f06-9f41-b796a6ff6798",
                                                "text": "Sous une toilette criarde, ton corps mouvant laisse derrière lui flotter un sillage embaumé."
                                            },
                                            {
                                                "example_id": "6cad9b3c-faeb-45f4-84a1-60b68844946b",
                                                "sense_id": "2824e81e-15fa-3f06-9f41-b796a6ff6798",
                                                "text": "Ruisselant de sueur, Jimmy tourna la clef dans la serrure, ouvrit la porte, fit entrer Jim et la referma derrière lui."
                                            },
                                            {
                                                "example_id": "d569d184-3605-4390-87eb-3e23e259217c",
                                                "sense_id": "2824e81e-15fa-3f06-9f41-b796a6ff6798",
                                                "text": "S’embusquant alors derrière un massif, le fusil au poing, il attendait, des heures et des heures, qu’un chat vînt à passer."
                                            },
                                            {
                                                "example_id": "ae669f84-687c-4c25-ad65-b93ae89bfea7",
                                                "sense_id": "2824e81e-15fa-3f06-9f41-b796a6ff6798",
                                                "text": "Vers le soir, nous commençons à distinguer des formes vagues qui se dessinent derrière le voile de brume, […]."
                                            },
                                            {
                                                "example_id": "e236ca16-a25a-463f-9285-d6a27b7f4151",
                                                "sense_id": "2824e81e-15fa-3f06-9f41-b796a6ff6798",
                                                "text": "Les sièges derrière eux étaient occupés par un vieux couple qui transportait une grosse poule rousse."
                                            },
                                            {
                                                "example_id": "990785ca-a9b0-4889-b25e-52ffef630ddd",
                                                "sense_id": "2824e81e-15fa-3f06-9f41-b796a6ff6798",
                                                "text": "On ne sait pas ce qu’il a derrière la tête : Se dit pour une pensée, une pensée que l’on tient secrète."
                                            },
                                            {
                                                "example_id": "f8ab13bd-6166-41cb-bed6-2c5085e68eef",
                                                "sense_id": "2824e81e-15fa-3f06-9f41-b796a6ff6798",
                                                "text": "Il ne faut pas regarder derrière soi : Il faut continuer quand on a bien commencé, quand une fois on s’est engagé dans une carrière."
                                            },
                                            {
                                                "example_id": "0ff0b087-94d6-42de-a802-07c03838d465",
                                                "sense_id": "2824e81e-15fa-3f06-9f41-b796a6ff6798",
                                                "text": "Laisser quelqu’un bien loin derrière : Le surpasser, avoir beaucoup d’avantage sur lui."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "derrière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99756110-9869-341a-991e-a8547ce0823e",
                                        "entry_id": "090e95d4-a509-3e04-8a3d-440213e9df1b",
                                        "glosses": [
                                            "Se dit du côté opposé au devant, de la partie postérieure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99a9ceab-c620-46cf-a121-9ea013670fe0",
                                                "sense_id": "99756110-9869-341a-991e-a8547ce0823e",
                                                "text": "Ils guignaient depuis longtemps, pour leur nouvelle installation, […] une petite boutique, en forme de hangar, avec une vitrine d’une seule glace et une unique pièce sur le derrière."
                                            },
                                            {
                                                "example_id": "626f524e-0820-4f68-9c7c-78245ea5b3f6",
                                                "sense_id": "99756110-9869-341a-991e-a8547ce0823e",
                                                "text": "Le derrière de la tête."
                                            },
                                            {
                                                "example_id": "2a402b99-7836-4a1f-bf90-4b5e3702d052",
                                                "sense_id": "99756110-9869-341a-991e-a8547ce0823e",
                                                "text": "Porte de derrière."
                                            },
                                            {
                                                "example_id": "1ae84833-b87c-47a6-8827-d3d605d09e73",
                                                "sense_id": "99756110-9869-341a-991e-a8547ce0823e",
                                                "text": "Seulement il faut que M. le vicomte sache que l’établissement a deux portes : la principale, devant laquelle je suis resté, et une autre sur les derrières du jardin."
                                            },
                                            {
                                                "example_id": "9c437a85-497a-435f-a9f4-e60ff935e559",
                                                "sense_id": "99756110-9869-341a-991e-a8547ce0823e",
                                                "text": "Il sortit par les derrières, comme la rusée l’avait fait entrer, puis il se rechaussa pour franchir l’allée de cailloux , la porte du jardinet et les herbes du bord de l’eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70117354-3625-3b95-a708-66c4e251d3cc",
                                        "entry_id": "090e95d4-a509-3e04-8a3d-440213e9df1b",
                                        "glosses": [
                                            "Les fesses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65818392-7dd6-4488-835d-bf42f9fa4df4",
                                                "sense_id": "70117354-3625-3b95-a708-66c4e251d3cc",
                                                "text": "Ils [les élèves externes] ne comprenaient pas toujours notre langage, dont la virile grossièreté les dépassait. Le leur était d’une correction désolante : ils allaient jusqu’à dire « Un coup de pied au derrière ! »"
                                            },
                                            {
                                                "example_id": "086b06b8-6223-4c05-a3b8-b5318c5f79e0",
                                                "sense_id": "70117354-3625-3b95-a708-66c4e251d3cc",
                                                "text": "Alphonse Allais : Oui, Monsieur, j’ai bien reçu votre lettre. Je l’ai même parcourue d’un derrière distrait."
                                            },
                                            {
                                                "example_id": "6bec983f-30f2-4d69-bc3e-088a7d816025",
                                                "sense_id": "70117354-3625-3b95-a708-66c4e251d3cc",
                                                "text": "Le père Noël empoigna le Loup, le cala sous son bras et lui donna une fessée si forte que les vibrations des claques sur le derrière du loup faisaient tomber la neige des arbres. Le Loup criait, pleurait, se débattait en gigotant, mais je vous jure qu’il n’avait plus froid !"
                                            },
                                            {
                                                "example_id": "f8daf69d-2b09-466f-b176-371e4ff553fb",
                                                "sense_id": "70117354-3625-3b95-a708-66c4e251d3cc",
                                                "text": "« Qu’est-ce qui est noir et blanc et rouge sur le derrière ?\n— J’donne ma langue au chat.\n— Un zèbre qui a des irritations à cause de ses couches. »"
                                            },
                                            {
                                                "example_id": "2aadfb69-ffba-4f95-ba58-0dc12c9eb545",
                                                "sense_id": "70117354-3625-3b95-a708-66c4e251d3cc",
                                                "text": "Se dessina au fil de son imagination une galerie de fesses à la blancheur douteuse, de trous de balle hémorroïdaires, de derches de fiotes, de popotins pratiques, de croupes rétives, de derrières voluptueux, de raies au parfum de crevettes avariées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50a51c06-d76e-3061-971d-960ca9d6688d",
                                        "entry_id": "090e95d4-a509-3e04-8a3d-440213e9df1b",
                                        "glosses": [
                                            "Derniers corps d’une armée en marche ou en bataille et du côté auquel l’armée tourne le dos, ou du pays qu’elle laisse derrière elle."
                                        ],
                                        "tags": [
                                            "dated",
                                            "plural"
                                        ],
                                        "note": "On dit aujourd’hui arrières",
                                        "examples": [
                                            {
                                                "example_id": "5c1a1646-73fb-43a1-83e5-421bc259fa50",
                                                "sense_id": "50a51c06-d76e-3061-971d-960ca9d6688d",
                                                "text": "À part les nombreux varioleux, dont le déplacement était impossible, les malades et les blessés avaient été évacués au loin sur les derrières."
                                            },
                                            {
                                                "example_id": "6a070ff4-f6d7-4a2c-a3b2-00c07d99d03a",
                                                "sense_id": "50a51c06-d76e-3061-971d-960ca9d6688d",
                                                "text": "A l'exception de quelques traînards, ses troupes se trouvaient déjà entre Chaumont-Porcien et Seraincourt, quand une canonnade éclatant sur ses derrières vient annoncer l'arrivée des Allemands devant la première de ces localités."
                                            },
                                            {
                                                "example_id": "a63b77f2-9711-4edf-a430-4810ae144a81",
                                                "sense_id": "50a51c06-d76e-3061-971d-960ca9d6688d",
                                                "text": "Gestas, dans la rue, n’avait qu’une idée en tête, qui était de rentrer dans l’église par une porte latérale afin de surprendre, s’il était possible, le suisse sur ses derrières et de mettre la main sur un petit vicaire qui consentît à l’entendre en confession."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2efd738-c9d1-4158-af33-83542d1f7919",
                        "source_entry_id": "bed83086-553a-36f1-acc1-68ddc379be7e",
                        "source_sense_id": "9f9a96be-ac51-3f07-bf38-9ee3837028e6",
                        "source_sense_description": "vervangt achter dit, achter deze",
                        "target_lang_word": "par derrière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "par derrière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc735de5-ce74-3c9d-addb-935d9c479c42",
                                        "entry_id": "db34b04e-4c26-3fbd-be0e-16ee8ad91d6e",
                                        "glosses": [
                                            "Par la partie postérieure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b26680b4-2cfa-4866-91d1-b3257d51ff99",
                                                "sense_id": "fc735de5-ce74-3c9d-addb-935d9c479c42",
                                                "text": "L’infortuné n’avait pas eu le temps de presser ce bouton. Déjà ses assaillants le frappaient, sauvagement, par derrière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
