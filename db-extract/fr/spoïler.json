                "senses": [
                    {
                        "sense_id": "892b962d-a9d2-3040-bf15-d4e22e4d324d",
                        "entry_id": "f9bd4546-3911-3a84-8f47-2fd1bc476d07",
                        "glosses": [
                            "Variante orthographique de spoiler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97011425-efcd-488d-8551-19c6c66c20b5",
                                "sense_id": "892b962d-a9d2-3040-bf15-d4e22e4d324d",
                                "text": "[…], Parfois, il manque des ne et des accords du participe, mais je ne veux pas vous spoïler : j'explique pourquoi par quelques paragraphes dans le corps de ce livre."
                            },
                            {
                                "example_id": "d78e6998-23ab-4d4e-91ca-e54c6394580c",
                                "sense_id": "892b962d-a9d2-3040-bf15-d4e22e4d324d",
                                "text": "Si les bandes-annonces sont bien celle de l’époque, alors la mode de spoïler tout le film dans la ba date pas de la dernière pluie…"
                            },
                            {
                                "example_id": "605b3c87-75f5-482f-b318-16e6c1a025ea",
                                "sense_id": "892b962d-a9d2-3040-bf15-d4e22e4d324d",
                                "text": "Je n’entrerai pas dans les détails de l’intrigue, car je risquerais de spoïler, et ce serait bien dommage, car ce 4è tome est riche en surprises."
                            }
                        ]
                    }
                ],
