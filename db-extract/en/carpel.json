                                        "entry_id": "a451d93c-ec4e-3eeb-83e6-b2946e8e917b",
                                        "glosses": [
                                            "Organe floral femelle constituant l’unité du gynécée, généralement formé d’un ovaire, d’un style et d’un stigmate."
                                        ],
                                        "tags": [
                                            "Anatomie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "218263a2-88b4-4e86-8a04-a74d6151dc43",
                                                "sense_id": "1d500fd7-e129-3057-8015-490eec8db5c6",
                                                "text": "Les étamines, très allongées, sont au nombre de quatre, tout comme les carpelles qui forment au centre le pistil."
                                            },
                                            {
                                                "example_id": "a51e7bd2-7577-4938-8515-0d2d1cf71647",
                                                "sense_id": "1d500fd7-e129-3057-8015-490eec8db5c6",
                                                "text": "Dès que commence à mûrir la graine, la tige s’incurve, semble fléchir sous le poids des carpelles."
                                            },
                                            {
                                                "example_id": "1668a2e7-2e85-4692-a716-cd10d4018824",
                                                "sense_id": "1d500fd7-e129-3057-8015-490eec8db5c6",
                                                "text": "Ce poids témoigne de la densité de la pulpe contenue dans les carpelles, ses enveloppes que nous appelons quartiers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
