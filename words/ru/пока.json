                {
                    "sense_id": "1ec775c7-da94-3f15-86a8-71aa5053220c",
                    "sense_definition": "Неформальное прощание; слово, которое говорят, когда расстаются с кем-то.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "farewell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне уже пора идти, <w>пока</w>!",
                            "target_lang_translations": {
                                "en": "I have to go now, <w>bye</w>!",
                                "tr": "Artık gitmem lazım, <w>görüşürüz</w>!",
                                "zh": "我该走了，<w>再见</w>！",
                                "nl": "Ik moet nu gaan, <w>doei</w>!",
                                "pl": "Muszę już iść, <w>cześć</w>!",
                                "de": "Ich muss jetzt los, <w>tschüss</w>!",
                                "fr": "Je dois y aller, <w>salut</w> !",
                                "it": "Devo andare, <w>ciao</w>!",
                                "cs": "Už musím jít, <w>ahoj</w>!",
                                "es": "Ya me tengo que ir, ¡<w>adiós</w>!"
                            }
                        },
                        {
                            "text": "Ну всё, <w>пока</w>, увидимся завтра в школе.",
                            "target_lang_translations": {
                                "en": "Alright, <w>bye</w>, see you tomorrow at school.",
                                "tr": "Tamam, <w>görüşürüz</w>, yarın okulda görüşürüz.",
                                "zh": "好了，<w>再见</w>，明天学校见。",
                                "nl": "Nou, <w>doei</w>, tot morgen op school.",
                                "pl": "Dobra, <w>na razie</w>, widzimy się jutro w szkole.",
                                "de": "Alles klar, <w>tschüss</w>, wir sehen uns morgen in der Schule.",
                                "fr": "Bon, <w>salut</w>, on se voit demain à l'école.",
                                "it": "Bene, <w>ciao</w>, ci vediamo domani a scuola.",
                                "cs": "Tak jo, <w>zatím</w>, uvidíme se zítra ve škole.",
                                "es": "Bueno, <w>adiós</w>, nos vemos mañana en la escuela."
                            }
                        }
                    ],
                    "synonyms": [
                        "до свидания",
                        "бывай",
                        "увидимся"
                    ],
                    "antonyms": [
                        "привет",
                        "здравствуй"
                    ],
                    "common_phrases": [
                        "ну пока",
                        "всё пока",
                        "ладно пока"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "используется в неофициальной обстановке"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Informal farewell; a word said when parting with someone.",
                        "tr": "Gayriresmi veda; birinden ayrılırken söylenen söz.",
                        "zh": "非正式的告别用语，用于与人分别时。",
                        "nl": "Informeel afscheid; een woord dat wordt gezegd wanneer men afscheid neemt van iemand.",
                        "pl": "Nieformalne pożegnanie; słowo używane przy rozstaniu z kimś.",
