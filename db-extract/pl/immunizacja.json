                        "cross_references": [
                            {
                                "target_word": "immunisation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41e94e0b-b0bc-3569-bb9b-7501a37d98e6",
                                        "entry_id": "1efc8985-ca95-377b-88ad-8fbca9fcfb52",
                                        "glosses": [
                                            "Alternative spelling of immunization."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76b09371-86a0-425e-b373-0088ee642d53",
                                                "sense_id": "41e94e0b-b0bc-3569-bb9b-7501a37d98e6",
                                                "text": "The larger the number of immunised people in the community the less easy is the spread of disease from one person to another. […] For the purpose of creating ‘herd immunity’, as this process is sometimes called, it is necessary to achieve 80 per cent immunisation of the community."
                                            },
                                            {
                                                "example_id": "0496d6ed-e9fc-42bf-bcc8-8a532d28f96c",
                                                "sense_id": "41e94e0b-b0bc-3569-bb9b-7501a37d98e6",
                                                "text": "All babies born in the UK will receive the hepatitis B jab as part of their routine immunisations from the autumn in an effort to drive down viral infections that cause cirrhosis and liver cancer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0c3158a-bcf7-3f16-8bc9-6f226982e4f5",
                                        "entry_id": "1efc8985-ca95-377b-88ad-8fbca9fcfb52",
                                        "glosses": [
                                            "The process of immunising signalling and traction power supplies so they don't interfere with each other."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3da1abf-da41-4e26-9d69-2309be31a6be",
                                                "sense_id": "d0c3158a-bcf7-3f16-8bc9-6f226982e4f5",
                                                "text": "\"Secondly, we have to find more cost-effective ways of electrifying. And we've had a real breakthrough in the last couple of years in terms of bridge clearances and immunisation, meaning we've been able to take hundreds of millions of pounds off the cost of electrification."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0eb1f01-a98f-45b1-9c20-5980ad5e6079",
                        "source_entry_id": "029c5321-4258-378f-8f55-72f9061e6d66",
                        "source_sense_id": "aa5b9622-abfc-3089-a6b3-6a5f49764d6d",
                        "target_lang_word": "immunization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immunization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b895e9d5-7a13-3230-9c64-ad9e15210c1a",
                                        "entry_id": "54855298-c79c-3852-9001-a175f481e733",
                                        "glosses": [
                                            "The process by which a person is safely exposed in a controlled manner to a material that is designed to prime their immune system against that material."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f874522-9605-43e2-81a9-c1cdcffd5bc9",
                                                "sense_id": "b895e9d5-7a13-3230-9c64-ad9e15210c1a",
                                                "text": "Near-synonym: vaccination (broadly synonymous)"
                                            },
                                            {
                                                "example_id": "dc9be733-ab8b-46a3-b0b0-b5361b9d72fd",
                                                "sense_id": "b895e9d5-7a13-3230-9c64-ad9e15210c1a",
                                                "text": "Immunization against influenza is important for all child-care workers."
                                            },
                                            {
                                                "example_id": "b323030e-ec4d-4b1e-9d5c-188e24c24da7",
                                                "sense_id": "b895e9d5-7a13-3230-9c64-ad9e15210c1a",
                                                "text": "It will do little for the future of immunization to prepare excellent vaccines, test them to a fare-thee-well for safety and efficacy, and then not insure that they are adequately used."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8827afbd-cd52-31dc-912e-58f33dae9480",
                                        "entry_id": "54855298-c79c-3852-9001-a175f481e733",
                                        "glosses": [
                                            "One such exposure."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b23b088-916e-495a-91eb-b15a5df372ce",
                                                "sense_id": "8827afbd-cd52-31dc-912e-58f33dae9480",
                                                "text": "The first immunization a baby gets is against HBV."
                                            },
                                            {
                                                "example_id": "750e9563-72dc-45b6-8ae2-804f2b54fa9d",
                                                "sense_id": "8827afbd-cd52-31dc-912e-58f33dae9480",
                                                "text": "Our results are consistent with those obtained by other groups screening camelid-derived libraries, where an impressive diversity in the Nb nucleotide sequence, specificity and neutralizing capacity was found, especially after successive immunizations to promote the development of superimmunity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57794179-a3f8-37b4-b70b-f0fc934a727a",
                                        "entry_id": "54855298-c79c-3852-9001-a175f481e733",
                                        "glosses": [
                                            "The process by which any organism's body develops immunity against a pathogen."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15c039ef-9cee-4cdd-ab4b-734335ae90fc",
                                                "sense_id": "57794179-a3f8-37b4-b70b-f0fc934a727a",
                                                "text": "Immunization via previous infection is not unusual among infectious diseases, but the degree and duration of such immunization varies by disease and depends on other factors as well (such as immunocapability and dietary sufficiency)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
