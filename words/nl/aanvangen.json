                },
                {
                    "sense_id": "6cdc6880-152a-3022-8cdb-c75b5c17f157",
                    "sense_definition": "Actief beginnen met het uitvoeren van een taak of werkzaamheid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beginnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben de werkzaamheden aan het spoor meteen <w>aangevangen</w>.",
                            "target_lang_translations": {
                                "en": "We <w>commenced</w> the work on the railway immediately."
                            }
                        },
                        {
                            "text": "Zodra de zon opkwam, <w>vingen</w> de boeren hun werk op het land <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "As soon as the sun rose, the farmers <w>started</w> their work on the land."
                            }
