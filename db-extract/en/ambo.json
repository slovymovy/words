                        "glosses": [
                            "An ambulance."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "40959faf-3eb7-416c-aca3-204a962a75c3",
                                "sense_id": "b402da93-f515-36d9-ae58-544ecd56ac5c",
                                "text": "Rawls: I don't want the fuckin' reporters seeing any ambos. Shit."
                            }
                        ]
