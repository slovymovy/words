                        "examples": [
                            {
                                "example_id": "e58f1047-4cd5-40d9-850c-c839e8666cd9",
                                "sense_id": "0de80f5c-65dd-36b8-9982-1a97e92b5cf5",
                                "text": "The Taxis of the Athenian service, like the Lochus of the Lacedæmonian, was analogous to our battalion, and the rank of the Taxiarch, its commander, as of the Lochage, was nearly that of our colonel."
                            },
                            {
                                "example_id": "730ed74c-d4be-46a9-a794-8f35f4116d00",
                                "sense_id": "0de80f5c-65dd-36b8-9982-1a97e92b5cf5",
                                "text": "In recognition of his services in the education of the women of Athens, he was buried with the honors of a taxiarch, by special orders […]"
