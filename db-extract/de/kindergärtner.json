                "senses": [
                    {
                        "sense_id": "d18cb5fe-e497-36e9-ad11-9a50eec88d83",
                        "entry_id": "9e1aab08-3184-33da-a000-69a84bafa145",
                        "glosses": [
                            "Person, die Kindergartenkinder betreut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a87037c-6156-4d1e-a527-c7038a2240cc",
                                "sense_id": "d18cb5fe-e497-36e9-ad11-9a50eec88d83",
                                "text": "Heute passen zwei Kindergärtner draußen auf die Kinder auf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2dca5c28-a555-45d9-a2d4-83924e1e9e3c",
                        "source_entry_id": "9e1aab08-3184-33da-a000-69a84bafa145",
                        "source_sense_id": "d18cb5fe-e497-36e9-ad11-9a50eec88d83",
                        "source_sense_description": "Person, die Kindergartenkinder betreut",
                        "target_lang_word": "kindergartner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kindergartner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78a7bd9f-c44c-3785-8f8a-88d5caf5bca7",
                                        "entry_id": "11bd5505-12e4-364d-a2a3-08765abd68e9",
                                        "glosses": [
                                            "A child who attends a kindergarten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c37748b-b396-4862-ad5b-1f9e1e314917",
                                                "sense_id": "78a7bd9f-c44c-3785-8f8a-88d5caf5bca7",
                                                "text": "I partnered the older kids with my kindergartners and let everyone get a taste of teaching or learning from someone different."
                                            },
                                            {
                                                "example_id": "d86529c6-d43e-4742-91a5-11b83d4cbdf2",
                                                "sense_id": "78a7bd9f-c44c-3785-8f8a-88d5caf5bca7",
                                                "text": "All 50 states have had school immunization requirements since the beginning of the 1980s, with incoming kindergartners needing shots to protect against diseases including measles, polio and tetanus. No states require a Covid-19 vaccine for schoolchildren."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kindergartner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                        "entry_id": "4088fb6b-025f-3afb-a891-27d0f73065d8",
                                        "glosses": [
                                            "A person who teaches at a kindergarten."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cb6578c-f73f-4f18-8266-2dbee4a58a79",
                                                "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                                "text": "But the heart is generally larger than the creed, as was once strikingly evidenced to me by Louisa Frankenberg, a dear, devout old German kindergartner, who had learned the art of kindergartning [...]"
                                            },
                                            {
                                                "example_id": "58e55518-e92f-4461-b872-7c0e2524c35d",
                                                "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                                "text": "[Jean-Jacques] Rousseau rightly insists that man’s education begins at his birth, and that what is acquired unconsciously far exceeds, in amount and importance, what is acquired consciously and through instruction.¹ […] ¹ This is a truth to which kindergærtners ought to give serious heed."
                                            },
                                            {
                                                "example_id": "86886290-7a47-48ff-8f5e-58b1eb80113b",
                                                "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                                "text": "I am a kindergartner, teaching in the Harrington School, New Bedford, Mass., and am a reader of the “Kindergarten Primary Magazine.”"
                                            },
                                            {
                                                "example_id": "948d7aa5-a130-4026-a46f-0788edb7f45c",
                                                "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                                "text": "The book that laid the groundwork for this new ideology was written by a German kindergartner who had emigrated to America in the late 1860s."
                                            },
                                            {
                                                "example_id": "a5d1004c-cb4f-4d3e-829e-fb62cfb676b9",
                                                "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                                "text": "She went to New York City in 1872 to train under German kindergartner Maria Kraus-Boelte[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "159d863e-f216-41dc-99b3-8137655b6866",
                        "source_entry_id": "9e1aab08-3184-33da-a000-69a84bafa145",
