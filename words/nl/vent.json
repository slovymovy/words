                    "sense_id": "c60a5c41-51b1-33f9-93d4-0ed67111e236",
                    "sense_definition": "een informele term voor een man of kerel",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "personen",
                    "name_type": "no",
