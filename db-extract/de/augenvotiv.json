                        "sense_id": "8e400249-142e-32ab-b54d-5298616f2054",
                        "entry_id": "616c8a6e-3228-3c21-8517-73ca951bec25",
                        "glosses": [
                            "die Augen betreffende Votivgabe durch eine Votanten"
