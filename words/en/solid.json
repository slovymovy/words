                    "sense_definition": "A substance that is not a liquid or a gas.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "matter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemistry experiment involved mixing two <w>solids</w> to create a gas.",
                            "target_lang_translations": {
                                "ru": "Химический эксперимент включал смешивание двух <w>твёрдых веществ</w> для получения газа."
                            }
