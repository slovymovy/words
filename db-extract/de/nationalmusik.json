                "senses": [
                    {
                        "sense_id": "aa188404-9596-32eb-81d5-0a7c8ea0c81d",
                        "entry_id": "8687028c-94fa-30b1-ac28-342d47dc2c58",
                        "glosses": [
                            "Musikwerke, die einen außerordentlichen Bezug zur Geschichte und Kultur derjenigen Nation aufweisen, der der Komponist des betreffenden Werkes angehört. Ein Großteil der Nationalmusik wurde im 19. Jahrhundert komponiert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36c2baac-ab1c-4df6-8b7b-228aba4ce2db",
                                "sense_id": "aa188404-9596-32eb-81d5-0a7c8ea0c81d",
                                "text": "„Nationalmusik muß nicht ausschließlich eine nationale Bedeutung haben. … Auch im 19. Jahrhundert sollte Nationalmusik keine Einengung bedeuten,sondern war Ausdruck des Wunsches, sich mit eigener Stimme an einer universalen Musik zu beteiligen.“"
                            },
                            {
                                "example_id": "2f0df29e-9374-48d3-bbdd-b51be70b18eb",
                                "sense_id": "aa188404-9596-32eb-81d5-0a7c8ea0c81d",
                                "text": "Das bekannteste Stück der Nationalmusik ist wohl „Die Moldau“ des tschechischen Komponisten Bedřich Smetana."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
