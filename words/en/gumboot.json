{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e248854c-1765-34c5-9acd-ddfee557eb2b",
                    "sense_definition": "A waterproof rubber boot, typically worn in wet or muddy conditions.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "footwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He put on a pair of <w>gumboots</w> before heading out into the muddy garden.",
                            "target_lang_translations": {
                                "ru": "Он надел пару <w>резиновых сапог</w>, прежде чем выйти в раскисший от грязи сад."
                            }
                        },
                        {
                            "text": "Make sure your <w>gumboot</w> has no holes, or your foot will get wet.",
                            "target_lang_translations": {
                                "ru": "Убедись, что твой <w>резиновый сапог</w> без дырок, иначе нога промокнет."
                            }
                        }
                    ],
                    "synonyms": [
                        "Wellington boot"
                    ],
                    "common_phrases": [
                        "pair of gumboots"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in Australia, New Zealand, and South Africa"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Водонепроницаемый резиновый сапог, который обычно носят в сырую или грязную погоду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резиновый сапог",
                                "target_lang_sense_clarification": "обувь для сырой погоды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72339aff-99ab-3d36-a98b-56b2cae6050d",
                    "sense_definition": "A style of South African dance music and performance originally developed by miners wearing rubber boots.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "culture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cultural festival featured an energetic performance of South African <w>gumboot</w>.",
                            "target_lang_translations": {
                                "ru": "На фестивале культур было представлено энергичное исполнение южноафриканского танца <w>гамбут</w>."
                            }
                        },
                        {
                            "text": "Miners originally created <w>gumboot</w> rhythms to communicate secretly in the dark tunnels.",
                            "target_lang_translations": {
                                "ru": "Шахтёры изначально придумали ритмы <w>гамбута</w>, чтобы тайно общаться в тёмных туннелях."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "South Africa"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стиль южноафриканского танца и музыки, изначально созданный шахтёрами в резиновых сапогах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гамбут",
                                "target_lang_sense_clarification": "стиль танца"
                            },
                            {
                                "target_lang_word": "танец в резиновых сапогах",
                                "target_lang_sense_clarification": "традиционный южноафриканский танец"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2515201d-7b40-34fe-8bfa-e150b521c194",
                    "sense_definition": "Generic or low-quality black tea.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food_drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He offered me a cup of strong <w>gumboot</w> before we started working.",
                            "target_lang_translations": {
                                "ru": "Он предложил мне чашку крепкого <w>дешёвого чая</w> перед тем, как мы приступили к работе."
                            }
                        },
                        {
                            "text": "All they had at the campsite was cheap <w>gumboot</w> tea.",
                            "target_lang_translations": {
                                "ru": "Всё, что у них было в кемпинге, — это дешёвый <w>крепкий чёрный</w> чай."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gumboot tea"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "New Zealand and Australian slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Простой, крепкий или низкосортный чёрный чай (сленг в Австралии и Новой Зеландии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крепкий дешёвый чай",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "простой чёрный чай",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfb20af9-57f9-3ea2-8507-cba2867aa0de",
                    "sense_definition": "A large marine mollusc, specifically the gumboot chiton.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "zoology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "While exploring the tide pools along the coast, they found a giant <w>gumboot</w> clinging to the rocks.",
                            "target_lang_translations": {
                                "ru": "Исследуя приливные заводи вдоль побережья, они обнаружили гигантского <w>хитона</w>, прикрепившегося к скалам."
                            }
                        },
                        {
                            "text": "The <w>gumboot</w> is known as the largest species of chiton in the world.",
                            "target_lang_translations": {
                                "ru": "<w>Хитон Стеллера</w> известен как самый крупный вид панцирных моллюсков в мире."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common name for gumboot chiton"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный морской моллюск, вид панцирного моллюска (Cryptochiton stelleri)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хитон Стеллера",
                                "target_lang_sense_clarification": "вид моллюска"
                            },
                            {
                                "target_lang_word": "гигантский хитон",
                                "target_lang_sense_clarification": "морской моллюск"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}