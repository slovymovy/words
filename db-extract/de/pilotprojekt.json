                "senses": [
                    {
                        "sense_id": "26df06d4-0193-32df-84a0-a07f015a6a67",
                        "entry_id": "51d57480-3a14-3714-bb4f-49e05500a15c",
                        "glosses": [
                            "das Leit- beziehungsweise Versuchsprojekt für zukünftige Projekte, in welchem meist neuartige Verfahren getestet werden"
                        ],
                        "tags": [
                            "Projektmanagement"
                        ],
                        "examples": [
                            {
                                "example_id": "1d4580f4-5556-4462-b3d3-03accc1e63ed",
                                "sense_id": "26df06d4-0193-32df-84a0-a07f015a6a67",
                                "text": "Jedes Projekt will ein Pilotprojekt sein, ein Lotse (englisch pilot) für andere Projekte."
                            },
                            {
                                "example_id": "988bb50d-8efe-4139-ad22-2092c06d95ba",
                                "sense_id": "26df06d4-0193-32df-84a0-a07f015a6a67",
                                "text": "Das Pilotprojekt soll in Zusammenarbeit mit dem Landeskriminalamt Nordrhein-Westfalen in Angriff genommen werden."
                            },
                            {
                                "example_id": "de400e7e-c046-4b32-b1ec-c1dc704675b3",
                                "sense_id": "26df06d4-0193-32df-84a0-a07f015a6a67",
                                "text": "Zurzeit laufen noch Pilotprojekte in den Bundesländern Niedersachsen, Nordrhein-Westfalen und Baden-Württemberg, die noch zu Ende geführt werden sollen."
                            },
                            {
                                "example_id": "277b1688-d72f-4796-8939-d8ca13c2f486",
                                "sense_id": "26df06d4-0193-32df-84a0-a07f015a6a67",
                                "text": "„Grundlegend hierfür sind Erkenntnisse, die während der Durchführung eines einjährigen Pilotprojektes zur Förderung unbegleiteter minderjähriger Flüchtlinge von Februar 2016 bis Ende Januar 2017 gewonnen wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
