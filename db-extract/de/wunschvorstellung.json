                                "target_senses": [
                                    {
                                        "sense_id": "58e165cc-5af9-3af1-b589-0c10b6dc83b0",
                                        "entry_id": "7e8bf486-dc41-3f9f-8f22-de82a0e29fd7",
                                        "glosses": [
                                            "een droom waarvan je hoopt dat ze ooit werkelijkheid wordt, maar waarvan je weet dat het waarschijnlijk nooit zal gebeuren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffe576d5-d6f2-4188-a2c4-259b5c85cfec",
                                                "sense_id": "58e165cc-5af9-3af1-b589-0c10b6dc83b0",
                                                "text": "Voorman Lodewijk Asscher van de PvdA begaat een historische blunder door niet deel te nemen aan de kabinetsformatie. Het is een wensdroom van de PvdA om net als 4 jaar geleden te komen tot brede volkspartij. Maar de realiteit is dat door een versplinterd politiek landschap deze droom nooit werkelijkheid zal worden."
                                            },
                                            {
                                                "example_id": "2c1faa88-4f36-4feb-bb23-309a83ccde99",
                                                "sense_id": "58e165cc-5af9-3af1-b589-0c10b6dc83b0",
                                                "text": "„Europa lijdt aan een onrealistische wensdroom over een maakbare samenleving”, veronderstelt een van hen."
                                            }
                                        ]
                                    }
                                ]
                            }
