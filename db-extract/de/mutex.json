                "senses": [
                    {
                        "sense_id": "9f99aacb-942f-3f66-8703-fd4d6f979164",
                        "entry_id": "f99b180e-ae48-38bb-9a83-2e1ac2fff070",
                        "glosses": [
                            "Verfahren, die verhindern, dass nebenläufige Prozesse bzw. Threads gleichzeitig auf Daten zugreifen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3a8bca5-8490-4e86-a466-dcb8a9cdd336",
                                "sense_id": "9f99aacb-942f-3f66-8703-fd4d6f979164",
                                "text": "Wenn ein Thread einen Mutex freigibt, den er nicht besitzt, wird im Thread eine ApplicationException ausgelöst."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ba54830-b8e6-4ecd-a2f1-89dc96a79bf6",
                        "source_entry_id": "f99b180e-ae48-38bb-9a83-2e1ac2fff070",
                        "source_sense_id": "9f99aacb-942f-3f66-8703-fd4d6f979164",
                        "target_lang_word": "mutex",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutex",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abf713dd-1a13-3b6d-a707-219b58bec8e6",
                                        "entry_id": "1fabea5b-a1e8-3e96-99e3-12fb7ea5d775",
                                        "glosses": [
                                            "An object in a program that serves as a lock, used to negotiate mutual exclusion among threads."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a967b62e-dce7-4826-a3af-2e83f1034cfb",
                                                "sense_id": "abf713dd-1a13-3b6d-a707-219b58bec8e6",
                                                "text": "The ability to set a maximum waiting time provides another reason why in some circumstances, you might prefer to use a mutex rather than a lock statement."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mutex",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "508cd52b-c49e-3045-a2ef-a1b26b2b2e33",
                                        "entry_id": "808d9ba4-8b07-3d14-bd3b-b8c9bfa66fc6",
                                        "glosses": [
                                            "To apply a mutex to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f2a94a1-b04a-4974-9c7b-20688944ba71",
                                                "sense_id": "508cd52b-c49e-3045-a2ef-a1b26b2b2e33",
                                                "text": "Or you can have a single pipe that is mutexed so each thread can only write to the pipe exclusively. Alternatively, you can have each thread put the finished fd in a globally mutexed list."
                                            }
                                        ]
                                    }
                                ]
                            }
