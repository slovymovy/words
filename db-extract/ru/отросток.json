                    {
                        "sense_id": "125e901f-ac09-35ae-a6bf-590338db810a",
                        "entry_id": "b8c4fa40-b73e-30fa-a821-41bdd467d26a",
                        "glosses": [
                            "узкая, удлинённая часть чего-либо, отходящая в сторону"
                        ],
                        "tags": [],
