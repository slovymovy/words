                    {
                        "translation_id": "f825db55-57b0-4c25-9dc8-d3101e1d9c99",
                        "source_entry_id": "9760676f-358b-374a-b3a9-abcfae130a03",
                        "source_sense_id": "60375279-f72f-3543-a7e8-966fcb5d3db9",
                        "source_sense_description": "ein Kind, das an einem Sonntag geboren ist",
                        "target_lang_word": "Zondagskind",
