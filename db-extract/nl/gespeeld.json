                    {
                        "sense_id": "35c39016-d68f-3b00-91e3-73b4a8c11428",
                        "entry_id": "ba843baa-8437-36af-bb5b-6f4d123df5bd",
                        "glosses": [
                            "van een toneel- of muziekstuk dat het is voltooid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee337f47-483b-427e-a2c5-407f3fd024a6",
                                "sense_id": "35c39016-d68f-3b00-91e3-73b4a8c11428",
                                "text": "De musici zwaaien naar de man en verlaten zijn kamer. Groot: „Deze meneer probeerde zijn ene hand bij de andere te krijgen. Misschien wilde hij voor ons klappen.” Een verpleegkundige begint even later een gesprekje met de patiënt over de gespeelde muziek."
                            }
                        ]
