                            },
                            {
                                "target_lang_word": "бешеный",
                                "target_lang_sense_clarification": "о скорости или интенсивности"
                            },
                            {
                                "target_lang_word": "свирепый",
                                "target_lang_sense_clarification": "о ветре или шторме"
                            }
                        ]
