                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed a rare <w>unite</w> from the seventeenth century.",
                            "target_lang_translations": {
                                "ru": "В музее был выставлен редкий <w>юнайт</w> семнадцатого века.",
                                "zh": "博物馆展出了一枚十七世纪罕见的<w>联合金币</w>。",
                                "es": "El museo exhibió una rara <w>unite</w> del siglo XVII."
