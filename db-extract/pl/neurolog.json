                        "entry_id": "9e366d99-1ca4-3332-b291-0ed6c846f820",
                        "glosses": [
                            "lekarz specjalista zajmujący się profilaktyką, rozpoznawaniem i leczeniem chorób układu nerwowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b08375d3-af56-4d6f-ae95-2aaa5b9726f5",
                                "sense_id": "ab0d6ca8-f86b-3100-a9da-0d6cd3091510",
                                "text": "Jeśli masz jakieś tiki, koniecznie musisz iść z wizytą do neurologa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "457a815a-dc45-4a64-a79e-a4c547969c2e",
                        "source_entry_id": "9e366d99-1ca4-3332-b291-0ed6c846f820",
