                                ]
                            },
                            {
                                "target_word": "突然",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "318b0830-5be5-3f57-99dd-3d99067eee7c",
                                        "entry_id": "abcb04d4-3fc2-33ff-89dc-88888d877125",
                                        "glosses": [
                                            "忽然；猝然"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed685afc-bb33-43c5-9e67-2277f09c98a9",
                                                "sense_id": "318b0830-5be5-3f57-99dd-3d99067eee7c",
                                                "text": "突然哭起來"
                                            },
                                            {
                                                "example_id": "1b8274c0-bbc4-49e1-86c9-f0a41db2614b",
                                                "sense_id": "318b0830-5be5-3f57-99dd-3d99067eee7c",
                                                "text": "突然哭起来"
                                            },
                                            {
                                                "example_id": "864c6bc7-cfbb-49d0-8ee2-faf3307a1463",
                                                "sense_id": "318b0830-5be5-3f57-99dd-3d99067eee7c",
                                                "text": "今天我突然就抑鬱了。"
                                            },
                                            {
                                                "example_id": "175752ce-0b5c-4d8f-85a8-342ebba7a151",
                                                "sense_id": "318b0830-5be5-3f57-99dd-3d99067eee7c",
                                                "text": "今天我突然就抑郁了。"
                                            },
                                            {
                                                "example_id": "609a8ad8-6fcb-4364-b72a-91fe7a1c707b",
                                                "sense_id": "318b0830-5be5-3f57-99dd-3d99067eee7c",
                                                "text": "他突然就轉身走開了。"
                                            },
                                            {
                                                "example_id": "54e61497-e5cc-4105-ac46-ab6de08b2220",
                                                "sense_id": "318b0830-5be5-3f57-99dd-3d99067eee7c",
                                                "text": "他突然就转身走开了。"
                                            },
                                            {
                                                "example_id": "85a149f4-d47b-4762-8f05-7cfe4ff57a9d",
                                                "sense_id": "318b0830-5be5-3f57-99dd-3d99067eee7c",
                                                "text": "我突然發現我們好像上了他的當。"
                                            },
                                            {
                                                "example_id": "2ebb22e0-d084-4571-b703-f1da55b3238a",
                                                "sense_id": "318b0830-5be5-3f57-99dd-3d99067eee7c",
                                                "text": "我突然发现我们好像上了他的当。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba290261-1723-44e6-9d39-3271cc2679a9",
