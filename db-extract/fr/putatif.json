                ],
                "senses": [
                    {
                        "sense_id": "1211596f-a148-3c36-acbb-a8b0a6e33315",
                        "entry_id": "e284a5ff-b0a3-3704-a1db-68470ba717c1",
                        "glosses": [
                            "Qui est présumé être, à tort ou à raison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbd0c2c5-926f-48f9-adf9-f3d4c5909878",
                                "sense_id": "1211596f-a148-3c36-acbb-a8b0a6e33315",
                                "text": "Père putatif, celui qui est réputé légalement comme le père d'un enfant."
                            },
                            {
                                "example_id": "c37e4a10-9cb5-47e3-94d4-c8f346ea2ac3",
                                "sense_id": "1211596f-a148-3c36-acbb-a8b0a6e33315",
                                "text": "Mariage putatif, mariage nul que les époux ont contracté de bonne foi."
                            },
                            {
                                "example_id": "ce7e1509-635a-4dd2-bdb8-e1673e11349a",
                                "sense_id": "1211596f-a148-3c36-acbb-a8b0a6e33315",
                                "text": "L’occasion pour le président sortant de délivrer à son successeur putatif quelques conseils sous forme d’avertissements."
                            },
                            {
                                "example_id": "eccc09eb-4b34-4429-a1fc-b005d5fbac3f",
                                "sense_id": "1211596f-a148-3c36-acbb-a8b0a6e33315",
                                "text": "Elle se trouvait apparentée à ma mère à la fois du côté de mon grand-père Maxime, car son père était son plus jeune frère Louis & du côté d’Irma, dont la soeur Blanche était devenue la belle-mère de sa mère Jeannine, donc sa grandmère putative, après le décès de la première épouse de son grand-père André Lepic."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a47841aa-0e6e-4e18-b96c-65d3cfaa24cf",
                        "source_entry_id": "e284a5ff-b0a3-3704-a1db-68470ba717c1",
                        "source_sense_id": "1211596f-a148-3c36-acbb-a8b0a6e33315",
                        "target_lang_word": "putativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "putativ",
