                    {
                        "sense_id": "fbeb794d-a3a6-38e6-9180-67cfa0cfbafa",
                        "entry_id": "ddd2750a-b36f-328d-abe5-97b6fba933fe",
                        "glosses": [
                            "разг. чрезмерно подсинить"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5d43acab-52fb-3d3d-9c1f-206bda1bf3f5",
                        "entry_id": "ddd2750a-b36f-328d-abe5-97b6fba933fe",
                        "glosses": [
                            "рег. покрыть синяками"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56bebcad-7093-4f33-95b0-9349a5d12754",
                                "sense_id": "5d43acab-52fb-3d3d-9c1f-206bda1bf3f5",
                                "text": "…топочут они за ней из дымящегося серным запахом подземелья и топочут, чтобы её настичь, огалтело захохотать в лицо, тело дарами кулаков засинить."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23e98f10-7f8d-4354-abe4-3b5932836302",
                        "source_entry_id": "ddd2750a-b36f-328d-abe5-97b6fba933fe",
                        "target_lang_word": "bläuen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bläuen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5353cf1-26b7-3740-a2de-fb1f2e0b6ae5",
                                        "entry_id": "581d1b86-f7f3-3c53-b845-c36d81441207",
                                        "glosses": [
                                            "blau färben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97626357-7042-4801-ac55-d7672ab9b5ad",
                                                "sense_id": "d5353cf1-26b7-3740-a2de-fb1f2e0b6ae5",
                                                "text": "Metallhydroxyde, deren wässerige Lösungen Lackmus bläuen, nennt man Basen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9aace74d-0e55-3286-9f1b-3bc4746d1a48",
                                        "entry_id": "581d1b86-f7f3-3c53-b845-c36d81441207",
                                        "glosses": [
                                            "vergilbte Wäsche mit einem Aufhellungsmittel (Waschblau) behandeln, um sie weiß erscheinen zu lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64bc8a30-a97f-4a27-b30f-65f80ede0faf",
                                                "sense_id": "9aace74d-0e55-3286-9f1b-3bc4746d1a48",
                                                "text": "Früher mussten Wäscherinnen die Wäsche kochen, rühren, scheuern, stampfen, schlagen, schrubben, reiben, auswringen, anschließend bleichen, bläuen und stärken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fd86b642-3a8d-35cc-bf18-b8cbb7ec3392",
                                        "entry_id": "581d1b86-f7f3-3c53-b845-c36d81441207",
                                        "glosses": [
                                            "Metalle durch thermische oder chemische Verfahren mit einer dünnen, bläulich schimmernden Schutzschicht überziehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24267210-9887-4806-9fc5-47b550a9897c",
                                                "sense_id": "fd86b642-3a8d-35cc-bf18-b8cbb7ec3392",
                                                "text": "„Hier dient das Anlassen dazu, dem Stahl die Glashärte zu nehmen und ihn nicht nur zu bläuen, sondern ein kleines bisschen elastischer zu machen.“"
                                            },
                                            {
                                                "example_id": "be1d1f78-84e4-4ce4-9145-941a0a20b26e",
                                                "sense_id": "fd86b642-3a8d-35cc-bf18-b8cbb7ec3392",
                                                "text": "„Auch Buntmetalle, wie Messing Bronze, Kupfer oder Aluminium werden gerne geschwärzt, gefärbt, gebläut oder brüniert.“"
                                            },
                                            {
                                                "example_id": "e749b172-5109-4948-8a93-9e8194d6fd01",
                                                "sense_id": "fd86b642-3a8d-35cc-bf18-b8cbb7ec3392",
                                                "text": "„Der erfahrene Schmied zeigte auch das Bläuen von Beschlägen vor sowie das Schwarzbrennen von Eisen mit Leinöl.“"
                                            },
                                            {
                                                "example_id": "4e13d5ce-5390-496e-93cc-536474203045",
                                                "sense_id": "fd86b642-3a8d-35cc-bf18-b8cbb7ec3392",
                                                "text": "„Diejenigen Uhrenteile die zu bläuen sind, werden auf einem speziellen Blech so lange erhitzt, bis der gewünschte Farbton entsteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "bläuen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3617ac60-badb-3bca-85bc-c6562f32b83b",
                                        "entry_id": "679e1cb1-d7fe-3f0e-a2cb-3fc10c1b10f4",
                                        "glosses": [
                                            "mit Schlägen traktieren, (grün und blau) schlagen, prügeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4255f79-6747-4e7b-bc20-0d8fbcc9c875",
                                                "sense_id": "3617ac60-badb-3bca-85bc-c6562f32b83b",
                                                "text": "„Des alten Mannes Zorn war einigermaßen dadurch besänftigt, daß er mir den Kopf tüchtig gebläut und ich mir den Schmerz des Fußverrenkens zugezogen hatte, und so brachte er mich nicht gleich auf der Stelle um.“ (1846)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
