                                "target_senses": [
                                    {
                                        "sense_id": "71063693-9284-3fe3-a1d4-9f36ca2e737c",
                                        "entry_id": "8f54783b-96b8-3c0d-9259-fdbb21a00de6",
                                        "glosses": [
                                            "устар. тюрьма для содержания заключённых под стражу до суда"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38ed6425-4c6c-4485-b485-32ea92ace8a3",
                                                "sense_id": "71063693-9284-3fe3-a1d4-9f36ca2e737c",
                                                "text": "Она была в отчаянии: муж её сидел шестой месяц в остроге, и до неё дошёл слух, что его скоро накажут."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adf703b7-c796-374a-a2e3-14cba4fca39c",
                                        "entry_id": "8f54783b-96b8-3c0d-9259-fdbb21a00de6",
                                        "glosses": [
                                            "истор. деревянное укрепление в виде стены из заострённых и вкопанных вплотную столбов в пограничной полосе древнерусских княжеств"
                                        ],
                                        "tags": [
                                            "на Руси с XII в."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1424bbc-6dc0-4879-a446-5c7480a88efa",
                                                "sense_id": "adf703b7-c796-374a-a2e3-14cba4fca39c",
                                                "text": "Благодаря повторению стенами острога ландшафта холмистой местности, крепость практически сливалась с нею."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31a6a1bb-6c25-32a5-baa0-f099abb8a6d9",
                                        "entry_id": "8f54783b-96b8-3c0d-9259-fdbb21a00de6",
                                        "glosses": [
                                            "устар. город, селение, являвшиеся укреплёнными пунктами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0bdf9ba-4229-426c-8f0b-b6f3d5fa3ef3",
                                                "sense_id": "31a6a1bb-6c25-32a5-baa0-f099abb8a6d9",
                                                "text": "Ниже Качуги братских селений нет, а есть около Верхоленска, бывшего острога ― города, построенного на правом берегу Лены, где и ныне есть мещан 200 человек, но без ратуши."
                                            }
                                        ]
                                    }
                                ]
