                        "entry_id": "1ec67862-0be2-3f68-97c8-077886de7da9",
                        "glosses": [
                            "Consommer soi-même ses propres muscles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4d5438a-2a71-4b25-aa00-30636f930b96",
                                "sense_id": "418bd7bf-4c86-39e6-b106-9f93ac127f2a",
                                "text": "Tu es fou, je n'en consomme pas, je ne veux pas autocannibaliser mon propre coeur après m'être transformé en femme :p"
                            },
                            {
                                "example_id": "1ed31866-ffa8-43cd-8f5c-ca40b3ab505e",
                                "sense_id": "418bd7bf-4c86-39e6-b106-9f93ac127f2a",
                                "text": "Certaines tumeurs sécrètent des cytokines qui font que la tumeur va autocannibaliser l'organisme."
                            },
                            {
                                "example_id": "fd58963a-d0aa-4896-9fd7-be1810805223",
                                "sense_id": "418bd7bf-4c86-39e6-b106-9f93ac127f2a",
                                "text": "Si, pendant son trajet, le bécasseau maubèche venait à manquer de graisse pour faire son trajet, il peut s'autocannibaliser en volant."
                            }
                        ]
                    }
