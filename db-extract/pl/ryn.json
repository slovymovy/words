                    {
                        "sense_id": "65ff0f3a-e35d-3e7a-b40c-2c2419e5e0fb",
                        "entry_id": "d6a794b7-636b-3469-aaea-8f9441177a49",
                        "glosses": [
                            "miasto w Polsce, w województwie warmińsko-mazurskim"
