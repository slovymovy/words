    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f39219f0-420b-3584-bc06-6120c2aedfc6",
                    "sense_definition": "Considered to be better or more important than it really is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many critics thought the award-winning movie was vastly <w>overrated</w>.",
                            "target_lang_translations": {
                                "ru": "Многие критики посчитали, что фильм, получивший награду, был крайне <w>переоценён</w>."
                            }
                        },
                        {
                            "text": "In my opinion, that famous restaurant is completely <w>overrated</w>.",
                            "target_lang_translations": {
                                "ru": "По моему мнению, этот знаменитый ресторан совершенно <w>переоценён</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "overvalued",
                        "hyped"
                    ],
                    "antonyms": [
                        "underrated"
                    ],
                    "common_phrases": [
                        "vastly overrated",
                        "completely overrated",
                        "highly overrated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Считающийся лучше или важнее, чем есть на самом деле"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переоценённый",
                                "target_lang_sense_clarification": "получивший неоправданно высокую оценку или популярность"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4f9c1602-dd0d-3211-9cb5-2f82ef356dba",
                    "sense_definition": "Simple past and past participle of <w>overrate</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach admitted that he had <w>overrated</w> the opposing team's defense.",
                            "target_lang_translations": {
