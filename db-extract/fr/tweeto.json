                    {
                        "sense_id": "814562dc-b6df-33e1-99bd-2e5f3fbea678",
                        "entry_id": "7bb6a362-c0eb-34b4-8211-52e62a4cb6b3",
                        "glosses": [
                            "Utilisateur actif de Twitter."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "dc3fd1ed-04e5-436d-b31a-f9b6885814a9",
                                "sense_id": "814562dc-b6df-33e1-99bd-2e5f3fbea678",
                                "text": "Isabelle Balkany a porté plainte contre un utilisateur de Twitter, l'accusant d'enfreindre son droit à l'image et d'usurper son identité. Le tweeto en question est auditionné ce jeudi 12 décembre 2013 au commissariat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "552722c6-ff29-4f7d-bf20-8a027aaaffe4",
                        "source_entry_id": "7bb6a362-c0eb-34b4-8211-52e62a4cb6b3",
                        "source_sense_id": "814562dc-b6df-33e1-99bd-2e5f3fbea678",
                        "target_lang_word": "tweep",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tweep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56801a6b-a447-3015-860d-6e431e142f07",
                                        "entry_id": "c2e8eff2-699a-37a0-9e20-d753ca6d75f4",
                                        "glosses": [
                                            "A chirp or beep."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27533ba4-2c64-4fab-b6c9-529685081990",
                                                "sense_id": "56801a6b-a447-3015-860d-6e431e142f07",
                                                "text": "The readers are Star Trek cast members, and the sound is enhanced with authentic, Enterprise-sounding beeps and tweeps."
                                            },
                                            {
                                                "example_id": "500d6898-f219-4172-b322-de8607818012",
                                                "sense_id": "56801a6b-a447-3015-860d-6e431e142f07",
                                                "text": "Many of the neighboring birds had already begun their preliminary chirps, sending out those quirky little twits and tweeps that announce their presence […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tweep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a048eeb-1dfb-3a84-859b-4ec145be496f",
                                        "entry_id": "e5c8cf2a-44bf-39dd-9178-a9d840e0a9c3",
                                        "glosses": [
                                            "To chirp or beep."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51bea47a-3830-44fc-979e-4350735d488a",
                                                "sense_id": "1a048eeb-1dfb-3a84-859b-4ec145be496f",
                                                "text": "A bird tweeped and twittered on a thistle by the side of the trail."
                                            },
                                            {
                                                "example_id": "528486cb-c08d-4735-a887-8e11cd0afc51",
                                                "sense_id": "1a048eeb-1dfb-3a84-859b-4ec145be496f",
                                                "text": "No ubiquitous telephones, no fax machines or computers burping and tweeping and chirping their electronic chirps."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tweep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47326fdf-3862-323e-b55d-b74a1fc3a028",
                                        "entry_id": "d1feb8f7-ff21-36f6-8deb-4c68d96ffa77",
                                        "glosses": [
                                            "To kill; to assassinate."
                                        ],
                                        "tags": [
                                            "US",
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "664c6be6-e2b6-4030-a45c-628789d0b2dc",
                                                "sense_id": "47326fdf-3862-323e-b55d-b74a1fc3a028",
                                                "text": "Robert Maheu, tough, astute, dynamic, was the perfect professional to implement the CIA scheme to tweep Fidel Castro."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tweep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4d511c0-2b0f-3853-bac1-42efe255b7b6",
                                        "entry_id": "de34fcfc-0f1d-32bf-936c-e63cdd61ac7d",
                                        "glosses": [
                                            "A user of the Twitter microblogging service."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edf3c792-69a4-432e-9be8-2d239c189851",
                                                "sense_id": "c4d511c0-2b0f-3853-bac1-42efe255b7b6",
                                                "text": "As astute tweeps will observe, I myself only follow one other person, the one thou callest \"Justin Bieber\"; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9d15b7c-8e8b-333b-8c9f-09c54ebf04a4",
                                        "entry_id": "de34fcfc-0f1d-32bf-936c-e63cdd61ac7d",
                                        "glosses": [
                                            "A Twitter employee."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3a452d1-152c-4f7e-afd9-cf4bed3f9846",
                                                "sense_id": "d9d15b7c-8e8b-333b-8c9f-09c54ebf04a4",
                                                "text": "“I recognize this is a crazy moment where Tweeps are losing access and the layoff is in progress,” she wrote on Slack, adding a broken heart emoji and a link to a video conferencing room, according to messages viewed by The Times."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e189277d-c66b-48c9-8fb3-510d5ba93139",
                        "source_entry_id": "7bb6a362-c0eb-34b4-8211-52e62a4cb6b3",
                        "source_sense_id": "814562dc-b6df-33e1-99bd-2e5f3fbea678",
