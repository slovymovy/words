                                                "sense_id": "7ac56906-661e-3100-819e-0d81694db841",
                                                "text": "„Dort habe es schöne Gartenlokale gegeben, in denen man als Wanderer seinen eigenen Kaffee habe kochen können.“"
                                            },
                                            {
                                                "example_id": "63f3d420-be37-49eb-adfe-adfdbe8c63a8",
                                                "sense_id": "7ac56906-661e-3100-819e-0d81694db841",
                                                "text": "„Immer wieder öffnen sich dem Wanderer neue und reizvolle Blicke.“"
                                            },
                                            {
                                                "example_id": "9d15a421-5beb-486a-9b4b-a8383a9bafb3",
                                                "sense_id": "7ac56906-661e-3100-819e-0d81694db841",
                                                "text": "„Im Angesicht der Natur hält der Wanderer am Rhein ähnlich inne wie der Betrachter eines mittelalterlichen Gemäldes im Musée Napoléon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
