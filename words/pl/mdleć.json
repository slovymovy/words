{
    "word_family": [
        "mdłość",
        "mdły",
        "omdlenie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5cbf2da1-ae0f-34c1-a4f6-8b0b4b64c2cd",
                    "sense_definition": "tracić przytomność, najczęściej na skutek braku tlenu w mózgu",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "utrata przytomności",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na widok krwi zawsze <w>mdleję</w>.",
                            "target_lang_translations": {
                                "ru": "При виде крови я всегда <w>падаю в обморок</w>."
                            }
                        },
                        {
                            "text": "Z powodu silnego upału w kościele jedna z kobiet nagle <w>mdleje</w>.",
                            "target_lang_translations": {
                                "ru": "Из-за сильной жары в церкви одна из женщин внезапно <w>падает в обморок</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tracić przytomność"
                    ],
                    "common_phrases": [
                        "nagle mdleć"
                    ],
                    "target_lang_definitions": {
                        "ru": "терять сознание, чаще всего из-за недостатка кислорода в мозге"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "падать в обморок",
                                "target_lang_sense_clarification": "наиболее распространенный и нейтральный способ сказать о потере сознания"
                            },
                            {
                                "target_lang_word": "обмирать",
                                "target_lang_sense_clarification": "устаревший или книжный вариант потери сознания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "297379da-52a6-3c7b-aa7f-98ca43c996bf",
                    "sense_definition": "tracić siłę, słabnąć, drętwieć",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "osłabienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po długim marszu w pełnym słońcu żołnierzom <w>mdlały</w> nogi z wycieńczenia.",
                            "target_lang_translations": {
                                "ru": "После долгого марша на палящем солнце у солдат от изнеможения <w>немели</w> ноги."
                            }
                        },
                        {
                            "text": "Z każdym kolejnym kilometrem wspinaczki moje ręce <w>mdleją</w> coraz bardziej.",
                            "target_lang_translations": {
                                "ru": "С каждым следующим километром подъема мои руки <w>немеют</w> всё сильнее."
                            }
                        }
                    ],
                    "synonyms": [
                        "słabnąć",
                        "drętwieć"
                    ],
                    "antonyms": [
                        "krzepnąć"
                    ],
                    "common_phrases": [
                        "ręce mdleją",
                        "nogi mdleją"
                    ],
                    "target_lang_definitions": {
                        "ru": "терять чувствительность, неметь, слабеть"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неметь",
                                "target_lang_sense_clarification": "о потере чувствительности в конечностях (например, от долгого сидения или усталости)"
                            },
                            {
                                "target_lang_word": "слабеть",
                                "target_lang_sense_clarification": "о постепенной потере физических сил"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}