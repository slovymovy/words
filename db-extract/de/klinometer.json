                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inclinomètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fcd018b3-5914-398b-a6a5-ea3c404e6273",
                                        "entry_id": "f933f926-f445-3284-accc-37f67208dfa8",
                                        "glosses": [
                                            "Synonyme de clinomètre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd3884ef-ee49-4b6f-9ba3-1aefb19d732e",
                                                "sense_id": "fcd018b3-5914-398b-a6a5-ea3c404e6273",
                                                "text": "Un inclinomètre donne l'angle de la ligne de visée avec le plan horizontal."
                                            },
                                            {
                                                "example_id": "174558ef-29b9-45f8-b8c9-acc5a25ce31c",
                                                "sense_id": "fcd018b3-5914-398b-a6a5-ea3c404e6273",
                                                "text": "Tout aussi folklorique, les relevés des inclinomètres — appareils servant à mesurer la stabilité d’un ouvrage — ont été falsifiés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "004580f7-5db8-38cc-98f1-00200802b003",
                                        "entry_id": "f933f926-f445-3284-accc-37f67208dfa8",
                                        "glosses": [
                                            "Boussole permettant d’évaluer l’inclinaison magnétique, on parle aussi de boussole d’inclinaison."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
