                "senses": [
                    {
                        "sense_id": "4f8fc8d9-17f4-32b2-b131-5af462b3b51a",
                        "entry_id": "d1a7c547-2a4e-318a-b5fb-e7ee49526d1a",
                        "glosses": [
                            "zellbasierte immunmodulierende Therapie zur Behandlung verschiedener immunologischer Erkrankungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1c85da8-cc2d-48ed-80cf-63fbea17b16f",
                                "sense_id": "4f8fc8d9-17f4-32b2-b131-5af462b3b51a",
                                "text": "„Die Behandlung mit der Photopherese erfolgt in mehreren Zyklen, dabei besteht ein Zyklus meist aus zwei aufeinanderfolgenden Photopherese-Behandlungen.“"
                            },
                            {
                                "example_id": "b8b6ef44-0b72-476b-97c6-f4fac2c8a723",
                                "sense_id": "4f8fc8d9-17f4-32b2-b131-5af462b3b51a",
                                "text": "„Während der letzten Jahre haben verschiedene Arbeitsgruppen das kutane T-Zell-Lymphom erfolgreich mit der Photopherese behandelt.“"
                            },
                            {
                                "example_id": "cf36c2a1-ee2c-4381-8eab-41226a898ac7",
                                "sense_id": "4f8fc8d9-17f4-32b2-b131-5af462b3b51a",
                                "text": "„Die Photopherese besteht aus einer Photochemotherapie, der durch Leukapherese gewonnenen Blutbestandteile. Obwohl der Wirkmechanismus der Photopherese noch nicht vollständig aufgeklärt ist, werden neben einer Apoptoseinduktion heute weitere immunologische Wirkungen durch Veränderungen der Zytokinexpression diskutiert“."
                            },
                            {
                                "example_id": "51f95f33-3418-49cb-b8b4-e03b26a29be8",
                                "sense_id": "4f8fc8d9-17f4-32b2-b131-5af462b3b51a",
                                "text": "„Die extrakorporelle Photopherese (= ECP oder extrakorporelle Photochemotherapie) wurde Anfang der 80er Jahre in den USA entwickelt.“"
                            },
                            {
                                "example_id": "6383bd55-26d9-4506-bf0d-24ce8b20181b",
                                "sense_id": "4f8fc8d9-17f4-32b2-b131-5af462b3b51a",
                                "text": "„In einem aktuellen Fallbericht im New England Journal of Medicine wählten die Autoren um Prof. Zeiser einen anderen Ansatz und behandelten einen 29-jährigen Patienten mit unter Kortison, Anti-TNF und Cyclosporin A nicht kontrollierter Immunenteritis mit einer extrakorporalen Photoph[e]rese (ECP).“"
                            },
                            {
                                "example_id": "83681aaa-2bc7-42f7-94e5-13a912be07c1",
                                "sense_id": "4f8fc8d9-17f4-32b2-b131-5af462b3b51a",
                                "text": "„Bei der extrakorporalen Photoph[e]rese (ECP) werden über Apherese Leukozyten aus dem Blut eines Patienten konzentriert, mit dem Photosensitizer 8-Methoxy-Psoralen versetzt und anschließend mit UV-Licht bestrahlt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
