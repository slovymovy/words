                "senses": [
                    {
                        "sense_id": "d431dba1-2096-3722-8f06-1aff8d1349e1",
                        "entry_id": "470878b5-287a-3e74-9835-6b87425a8066",
                        "glosses": [
                            "Faire perdre son caractère charlatanesque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25e74a14-4ba7-4ef8-b147-12c3a902783d",
                                "sense_id": "d431dba1-2096-3722-8f06-1aff8d1349e1",
                                "text": "Pourvu que mes pauvres écoliers en profitent, et que je leur puisse décharlataner la médecine, je serai content."
                            },
                            {
                                "example_id": "c3b31fbf-3ef8-4dd6-a312-ed1a0c8e34e6",
                                "sense_id": "d431dba1-2096-3722-8f06-1aff8d1349e1",
                                "text": "Les malades affluèrent dans son établissement : il avait, selon l’expression de l’un de ses confrères, « décharlatané » l’orthopédie."
                            }
                        ]
                    }
