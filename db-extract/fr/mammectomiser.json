                "senses": [
                    {
                        "sense_id": "ef19599d-00a6-3a48-89ff-ba93fa63a6ae",
                        "entry_id": "ad817c84-460c-33d0-b8fb-6dcef5a17d90",
                        "glosses": [
                            "Pratiquer une mammectomie sur (quelqu’un)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44aee600-31a3-47a8-a73a-73620cdf77fe",
                                "sense_id": "ef19599d-00a6-3a48-89ff-ba93fa63a6ae",
                                "text": "Et je ne vous parle pas si vous vous faites mammectomiser les deux seins et qu'il faut deux prothèses."
                            },
                            {
                                "example_id": "626b3e8f-e761-4a17-bd31-97b1bed3216d",
                                "sense_id": "ef19599d-00a6-3a48-89ff-ba93fa63a6ae",
                                "text": "Afro est affreux, certes réservé à un public adulte, mais démembrer, énucléer ou mammectomiser n'a jamais été aussi classe."
                            },
                            {
                                "example_id": "939ebff9-506b-40a6-8068-21b7ebab1987",
                                "sense_id": "ef19599d-00a6-3a48-89ff-ba93fa63a6ae",
                                "text": "Certains grincheux diront toujours que l'on peut se détourner des traitements abusifs et réducteurs de l'information et de la vie. Nous en convenons, mais du bout des lèvres : mammectomiser les Mères Info gâcherait le lait."
                            }
                        ]
                    }
