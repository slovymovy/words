                    {
                        "sense_id": "c00f69e2-a9e1-3a08-803f-7d3c9b088814",
                        "entry_id": "cc11f00d-2b07-39f1-a22b-bacbdbe8ea50",
                        "glosses": [
                            "Lysimachia L., rodzaj roślin z rodziny pierwiosnkowatych o wzniesionych lub płożących się łodygach i wyrastających pojedynczo w kącikach liści żółtych kwiatach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6ea8746-3611-47af-ad61-9eb5df6dee7c",
                                "sense_id": "c00f69e2-a9e1-3a08-803f-7d3c9b088814",
                                "text": "Tojeść równie dobrze czuje się na stanowiskach słonecznych, jak i ocienionych, tworząc w zależności od odmiany zwarty, szmaragdowozielony lub cytrynowożółty kobierzec."
                            }
                        ],
