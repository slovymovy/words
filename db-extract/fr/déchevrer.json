                "senses": [
                    {
                        "sense_id": "fa640f36-d59f-3c65-b304-0c0f2e956efb",
                        "entry_id": "8b22a5ca-5e3f-3a80-bb32-7a79151c7e6b",
                        "glosses": [
                            "Faire tomber la chèvre, dans un moulin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a34e2dd5-1efb-462e-8c88-e78e8e8a26b0",
                                "sense_id": "fa640f36-d59f-3c65-b304-0c0f2e956efb",
                                "text": "Le meunier \"n’avait plus qu’à\" tourner la roue du cabestan après avoir déchevré la queue pour orienter son moulin."
                            },
                            {
                                "example_id": "6cc59585-d734-49eb-b5b0-9dea25fbe968",
                                "sense_id": "fa640f36-d59f-3c65-b304-0c0f2e956efb",
                                "text": "Préalablement le meunier doit déchevrer la queue, c’est-à-dire, au moyen d’un bâton de chèvre, faire tomber le support en X qui la maintient calée à son extrémité."
                            },
                            {
                                "example_id": "e3a64685-3d34-40a8-8894-db938c845b05",
                                "sense_id": "fa640f36-d59f-3c65-b304-0c0f2e956efb",
                                "text": "Quand le meunier veut « pousser son moulin au vent », il déchèvre la queue, se place sur le travers, cale ses épaules contre les épars et pousse de toute sa force."
                            }
                        ]
                    }
