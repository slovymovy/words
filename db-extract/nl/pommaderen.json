                ],
                "senses": [
                    {
                        "sense_id": "44072581-240f-3412-bb81-567dbd52f839",
                        "entry_id": "2242cce5-eaa0-3be9-a1ef-8164f406c024",
                        "glosses": [
                            "het aanbrengen van een vettige substantie, de pommade, op het haar om het op zijn plaats te houden"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e478685e-b217-45b7-83b2-3d1a546f0c98",
                                "sense_id": "44072581-240f-3412-bb81-567dbd52f839",
                                "text": "Hij pommadeerde zijn haar om er een imposante vetkuif van te maken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce18e4d8-b86f-4648-854b-a460b3fd27dc",
                        "source_entry_id": "2242cce5-eaa0-3be9-a1ef-8164f406c024",
                        "source_sense_id": "44072581-240f-3412-bb81-567dbd52f839",
                        "target_lang_word": "pommader",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pommader",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "066c2d1c-6eef-32ce-805a-b6cf3c8afce1",
                                        "entry_id": "e36626fd-51ae-31aa-8e6f-872dcd93f6ef",
                                        "glosses": [
                                            "Enduire de pommade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2a4199d-860c-4874-86fe-e7a9a0081c11",
                                                "sense_id": "066c2d1c-6eef-32ce-805a-b6cf3c8afce1",
                                                "text": "Pommader une perruque, des cheveux."
                                            },
                                            {
                                                "example_id": "20300ad3-bd52-42bc-ae05-df704d86d514",
                                                "sense_id": "066c2d1c-6eef-32ce-805a-b6cf3c8afce1",
                                                "text": "Chez les Bushmen, de même que chez le Hottentot, [la toison] s'éparpille sur le crâne par petites houppes de la grosseur d'un pois, laissant entre elles un espace entièrement chauve. Ces touffes minuscules sont naturellement noires, mais l'action du soleil, jointe à la terre ocreuse dont on les pommade, les amène au brun rouge."
                                            },
                                            {
                                                "example_id": "aca3d267-2040-4c3a-882b-1adf124cfa7b",
                                                "sense_id": "066c2d1c-6eef-32ce-805a-b6cf3c8afce1",
                                                "text": "Une plombe à me pommader et m’hirsuter."
                                            },
                                            {
                                                "example_id": "5f072e0b-8112-4216-981d-bb9f16355726",
                                                "sense_id": "066c2d1c-6eef-32ce-805a-b6cf3c8afce1",
                                                "text": "Car la mode, c’est aussi les millions de tonnes de crèmes, poudres, laits, lotions, maquillages, démaquillants, prémaquillants, produits à se peindre, à se bronzer, à ôter la peinture, à s’oindre, à s’enduire, à se désenduire, à se pommader, à se friser, à s’onduler, à se défriser, à nourrir les cheveux, les laver, les traiter, les dépelliculer, les blondir, les faire briller, les remplir de reflets, les décolorer, les recolorer, les soigner, les faire respirer, les faire pousser, repousser, ôter les duvets superflus, maigrir, mincir, grandir, développer les seins, gommer les hanches, affiner la taille, avaler l’estomac, fondre les kilos en trop, exalter le buste, renforcer les appas défaillants…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
