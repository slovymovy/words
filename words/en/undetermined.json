                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new evidence <w>undetermined</w> the previous findings.",
                            "target_lang_translations": {
