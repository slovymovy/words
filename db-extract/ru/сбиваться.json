                "senses": [
                    {
                        "sense_id": "26e34189-163e-36f8-86ce-69ae3d39d4b4",
                        "entry_id": "528cd6d2-07e4-3999-9292-377036f78b7a",
                        "glosses": [
                            "passive of сбива́ть (sbivátʹ)"
                        ],
                        "tags": [
                            "form-of",
                            "passive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c050fea1-629d-3acf-9921-d1e8c51d712b",
                        "entry_id": "528cd6d2-07e4-3999-9292-377036f78b7a",
                        "glosses": [
                            "to flounder, to fluff, to get lost (also figuratively)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bb9bd98-1758-4c75-8951-d3c9a7f9481a",
                                "sense_id": "c050fea1-629d-3acf-9921-d1e8c51d712b",
                                "text": "Она́ постоя́нно сбива́ется и забыва́ет, что хоте́ла сказа́ть.",
                                "translation": "She constantly gets lost and forgets what she wanted to say.",
                                "english": "She constantly gets lost and forgets what she wanted to say."
                            },
                            {
                                "example_id": "f9e8c591-78bd-4b5d-935d-dd74c8c7574d",
                                "sense_id": "c050fea1-629d-3acf-9921-d1e8c51d712b",
                                "text": "Следователя насторожило, что старуха на этом месте начала сбиваться и путать.",
                                "translation": "The investigator was alerted by the fact that the old women started to flounder and get confused at this point.",
                                "english": "The investigator was alerted by the fact that the old women started to flounder and get confused at this point."
                            }
                        ]
                    },
                    {
                        "sense_id": "9454c3e6-3b98-3bb6-aff4-08211c8b1638",
                        "entry_id": "528cd6d2-07e4-3999-9292-377036f78b7a",
                        "glosses": [
                            "to be errant, to stray"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "98af411e-4667-389f-94e8-e744c67a8bea",
                        "entry_id": "528cd6d2-07e4-3999-9292-377036f78b7a",
                        "glosses": [
                            "to go astray"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e39cc908-af16-4700-9f5f-5402b5d62029",
                                "sense_id": "98af411e-4667-389f-94e8-e744c67a8bea",
                                "text": "сбива́ться с пути́",
                                "translation": "to go astray",
                                "english": "to go astray"
                            }
                        ]
                    },
                    {
                        "sense_id": "26b8d0ac-7c78-3cfe-9850-3aa4c2af0d73",
                        "entry_id": "528cd6d2-07e4-3999-9292-377036f78b7a",
                        "glosses": [
                            "to assemble"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c74a8c1-5f92-417a-b829-348b320b69ee",
                                "sense_id": "26b8d0ac-7c78-3cfe-9850-3aa4c2af0d73",
                                "text": "В регио́нах с больши́м коли́чеством пи́щи ры́бы мо́гут сбива́ться в больши́е ста́и.",
                                "translation": "In regions with a large amount of food, fish can stray into large flocks.",
                                "english": "In regions with a large amount of food, fish can stray into large flocks."
                            },
                            {
                                "example_id": "73558304-90d1-4131-b172-28761c094cc5",
                                "sense_id": "26b8d0ac-7c78-3cfe-9850-3aa4c2af0d73",
                                "text": "В ту осень, уже с сентября, хулиганьё начало по-волчьи сбиваться в ночные стаи.",
                                "translation": "That autumn, since September already, hooligans began like wolves gathering into big packs.",
                                "english": "That autumn, since September already, hooligans began like wolves gathering into big packs."
                            }
                        ]
                    },
                    {
                        "sense_id": "3cd10c66-a521-3228-8f84-b6de5e1c13d4",
                        "entry_id": "528cd6d2-07e4-3999-9292-377036f78b7a",
                        "glosses": [
                            "to felt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56a4b0e2-7ba4-4db2-9d3f-0dbfb5dd7da7",
                                "sense_id": "3cd10c66-a521-3228-8f84-b6de5e1c13d4",
                                "text": "сбива́ться в во́йлок",
                                "translation": "to felt",
                                "english": "to felt"
                            }
                        ]
                    }
