                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8dc4581-8704-3951-a2ec-be8862c7803b",
                        "entry_id": "b7ae9a81-f19d-3c0c-a5e5-1d1957acaa03",
                        "glosses": [
                            "auf die vermehrte Ausscheidung von Kalzium über den Urin bezogen"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "2b93f6d5-2fe3-4241-9a46-8dd4f83d579a",
                                "sense_id": "d8dc4581-8704-3951-a2ec-be8862c7803b",
                                "text": "„Es sind ausschließlich Patienten, die im Rahmen laufender Kontrolluntersuchungen hyperkalziurisch und eindeutig hyperkalziurische Werte hatten.“"
                            },
                            {
                                "example_id": "b76beb09-be9b-4c47-94d4-54ad5bbc42e5",
                                "sense_id": "d8dc4581-8704-3951-a2ec-be8862c7803b",
                                "text": "„Mutationen im Gen für den CLC-5-Chloridkanal führen zum Dent-Syndrom (hyperkalziurische Nephrolithiasis), das X-chromosomal-rezessiv vererbt wird […].“"
                            },
                            {
                                "example_id": "afdd2f53-9f70-4b69-bfa4-0ce0de4c71e4",
                                "sense_id": "d8dc4581-8704-3951-a2ec-be8862c7803b",
                                "text": "„Zwischen gesunden Kontrollpersonen und hyperkalziurischen Patienten oder Steinpatienten insgesamt zeigte sich kein signifikanter Unterschied in der Urinübersättigung für Kalziumoxalat, Brushit und Hydroxylapatit.“"
                            },
                            {
                                "example_id": "5feabfd8-a7c1-4003-977d-1b692c6bb7e1",
                                "sense_id": "d8dc4581-8704-3951-a2ec-be8862c7803b",
                                "text": "„Bei etabliertem Insulinmangel konkurriert somit der hypokalziurische Effekt der Insulopenie mit dem hyperkalziurischen Effekt einer osmotischen Diurese durch hohe glomeruläre Beladung mit Glukose [3].“"
                            },
                            {
                                "example_id": "62b615ca-63c6-4c81-9551-e94343bc5cd7",
                                "sense_id": "d8dc4581-8704-3951-a2ec-be8862c7803b",
                                "text": "„Bei Patienten mit Niereninsuffizienz wie bei hyperkalziurischen Patienten ist sie nur unter enger Überwachung und bei strenger Indikationsstellung gerechtfertigt. Arzneimittelinteraktionen.“"
                            },
                            {
                                "example_id": "b9a7313d-e3dc-48c9-b143-f30abf59e25e",
                                "sense_id": "d8dc4581-8704-3951-a2ec-be8862c7803b",
                                "text": "„Sie wirken spezifisch an den Vitamin-D-Rezeptoren, allerdings bei deutlich verminderter hyperkalzämischer und hyperkalziurischer Wirkung.“"
                            }
                        ],
