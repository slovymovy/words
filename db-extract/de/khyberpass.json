                    {
                        "sense_id": "76af6bae-9c1d-3d68-ba33-7b078f5ce48a",
                        "entry_id": "b541d54d-8cb8-38d3-8d3e-82abd32c1981",
                        "glosses": [
                            "Bergpass zwischen Pakistan und Afghanistan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3ba1361-3fc5-4e05-977d-df08a9a2d126",
                                "sense_id": "76af6bae-9c1d-3d68-ba33-7b078f5ce48a",
                                "text": "„So besiegelten die Hephthaliten oder «weißen Hunnen», die über den Khyberpass in das Industal einfielen, das Ende des Guptareiches.“"
                            },
                            {
                                "example_id": "b05d4531-33d9-4cc6-b55c-c97ed73c023a",
                                "sense_id": "76af6bae-9c1d-3d68-ba33-7b078f5ce48a",
                                "text": "„›Allah il allah - und Mohammed ist sein Prophet! Dennoch fühle ich, dass hier das Böse schläft - ich werde nie mehr das Rauschen des Windes auf dem Khyberpass hören.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5513a92a-9af5-43c3-b10a-13678ec7b716",
