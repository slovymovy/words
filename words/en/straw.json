                                "target_lang_word": "соломина",
                                "target_lang_sense_clarification": "стебель"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "saman çöpü",
                                "target_lang_sense_clarification": "tek bir sap"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一根稻草",
                                "target_lang_sense_clarification": "单根茎秆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9136769a-b637-3f7a-b11d-fe9fef058641",
                    "sense_definition": "A pale, yellowish-beige colour.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist chose a soft <w>straw</w> for the background of the painting.",
                            "target_lang_translations": {
                                "ru": "Художник выбрал мягкий <w>соломенный цвет</w> для фона картины.",
                                "tr": "Sanatçı, tablonun arka planı için yumuşak bir <w>saman</w> rengi seçti.",
                                "zh": "艺术家为画作背景选择了一种柔和的<w>稻草色</w>。"
                            }
                        },
                        {
                            "text": "Her dress was a light <w>straw</w> that matched the summer fields.",
                            "target_lang_translations": {
                                "ru": "Её платье было светло-<w>соломенного цвета</w>, под стать летним полям.",
                                "tr": "Elbisesi, yaz tarlalarıyla uyumlu açık bir <w>saman</w> rengindeydi.",
                                "zh": "她的裙子是浅<w>稻草色</w>的，与夏日的田野相映成趣。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бледно-желтый, бежевый цвет.",
                        "tr": "Soluk sarı, bej rengi.",
                        "zh": "一种淡黄色或米黄色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соломенный цвет",
                                "target_lang_sense_clarification": "оттенок"
                            }
