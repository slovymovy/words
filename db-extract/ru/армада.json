                    },
                    {
                        "sense_id": "ad674cf5-915b-3c9c-9612-83a79baf99b4",
                        "entry_id": "fc57d4d8-41cb-3062-b030-7a00a8047911",
                        "glosses": [
                            "перен. большое количество, большая масса кого-, чего-либо"
