                "senses": [
                    {
                        "sense_id": "24527991-3ed9-3493-b828-47906aa81285",
                        "entry_id": "8229eb14-eee9-37a4-b11b-4baff3ff2ef2",
                        "glosses": [
                            "Antrag an das Parlament auf eine Entschließung, durch die es die Regierung anregt, im Rahmen eines Gesetzgebungsprozesses, etwas Bestimmtes beim Vollzug des Gesetzes zu tun"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de13eb6d-6c8a-40d0-9ab9-c8ab85887c45",
                                "sense_id": "24527991-3ed9-3493-b828-47906aa81285",
                                "text": "Die Grünen brachten Ende Mai drei Entschließungsanträge zur Verbesserung der Praktika Situation ein."
                            },
                            {
                                "example_id": "b7d38968-8ab5-449b-bd83-75d2f6fbfa16",
                                "sense_id": "24527991-3ed9-3493-b828-47906aa81285",
                                "text": "Der […] Abgeordnete Leopold Mayerhofer brachte […] einen Entschließungsantrag in das Parlament ein, in dem er „die chemische Kastration von Sexualstraftätern auch ohne deren Zustimmung“ forderte."
                            },
                            {
                                "example_id": "d0665bbd-ac14-4dcb-b5d5-2e37ceb4ad85",
                                "sense_id": "24527991-3ed9-3493-b828-47906aa81285",
                                "text": "Einen von der FDP-Fraktion eingebrachten Entschließungsantrag, der darauf abzielte, den Einsatz dem Bundestag als Beschlussantrag vorzulegen, lehnte die Bundesregierung damals jedoch ab."
                            },
                            {
                                "example_id": "50cd2c15-52da-4a2e-a52d-76c487f3d2ea",
                                "sense_id": "24527991-3ed9-3493-b828-47906aa81285",
                                "text": "In dem angenommenen Entschließungsantrag heißt es, der 440 Milliarden Euro starke EFSF-Fonds solle mittels sogenannter Hebel effektiver gemacht werden."
                            },
                            {
                                "example_id": "fbf61304-bd86-45e9-afb1-7a011731f1bc",
                                "sense_id": "24527991-3ed9-3493-b828-47906aa81285",
                                "text": "Der Entschließungsantrag würde einen Eingriff in die Gewaltenteilung bedeuten, wenn die Exekutive an ihn gebunden wäre."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
