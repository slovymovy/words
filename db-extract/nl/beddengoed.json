                                        "glosses": [
                                            "Stoff, mit dem Decke, Matratze und Kopfpolster im Bett überzogen werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf24fd0c-f17e-4d2d-b765-030248e75587",
                                                "sense_id": "9674543b-0acf-3f20-8b49-d85af19d53f1",
                                                "text": "Aber gut - ich ließ ihn weiter schlafen, eilte zu meinem Termin und nahm mir fest vor das Bettzeug zu wechseln - und zwar noch heute."
                                            },
                                            {
                                                "example_id": "4d49cdee-1914-4c88-b85e-57d707b716fd",
                                                "sense_id": "9674543b-0acf-3f20-8b49-d85af19d53f1",
                                                "text": "Dann kommen noch die Kleinigkeiten: \"Das Bettzeug braucht man gar nicht einpacken, weil es ohnehin nicht auf die Kingsize-Betten passt.\""
                                            },
                                            {
                                                "example_id": "cb2ed3f2-0613-4730-b631-3c7e9238058a",
                                                "sense_id": "9674543b-0acf-3f20-8b49-d85af19d53f1",
                                                "text": "„Ganze Wagenzüge bewegten sich landeinwärts – gefüllt mit Bettzeug, Hausgerät und Vorräten.“"
                                            },
                                            {
                                                "example_id": "57fbd742-b607-416d-99ea-8543dc9c3504",
                                                "sense_id": "9674543b-0acf-3f20-8b49-d85af19d53f1",
                                                "text": "„Ich legte mein eigenes Bettzeug auf die Schlafstelle, klopfte die Schubladen der Kommode aus und legte die wenigen Habseligkeiten, die ich mitnehmen wollte, hinein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
