        "fr-extract.jsonl": [
            {
                "entry_id": "4a0acdb8-a30a-3a90-a086-e2632580d45a",
                "word": "syndical",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1a628801-18d4-41ed-90a5-d2ca642c66f2",
