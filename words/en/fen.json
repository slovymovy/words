{
    "word_family": [
        "fenland",
        "fenny"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d3ba139-07a8-3224-ab96-7743bb9f79e3",
                    "sense_definition": "A low-lying wetland area fed by groundwater and runoff, containing peat and typically less acidic than a bog.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wetland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rare plants and birds thrive in this alkaline <w>fen</w> because of the mineral-rich water.",
                            "target_lang_translations": {
                                "zh": "得益于富含矿物质的水源，稀有植物和鸟类在这片碱性<w>沼泽</w>中繁衍生息。"
                            }
                        },
                        {
                            "text": "Bogs are typically acidic peatlands, whereas a <w>fen</w> usually maintains higher nutrient levels.",
                            "target_lang_translations": {
                                "zh": "酸沼通常是酸性的泥炭地，而<w>低位沼泽</w>通常能维持较高的养分水平。"
                            }
                        }
                    ],
                    "synonyms": [
                        "marsh",
                        "swamp",
                        "bog",
                        "mire"
                    ],
                    "target_lang_definitions": {
                        "zh": "由地下水或地表径流补给的低洼湿地，富含泥炭，酸性通常低于酸沼（bog）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "沼泽",
                                "target_lang_sense_clarification": "泛指湿地、低洼沼泽"
                            },
                            {
                                "target_lang_word": "低位沼泽",
                                "target_lang_sense_clarification": "生态学专业术语，指地下水补给的富营养或中营养沼泽"
                            },
                            {
                                "target_lang_word": "草本沼泽",
                                "target_lang_sense_clarification": "以草本植物为主的泥炭湿地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b436c5d-7e9f-39b1-9d44-7e04ecfe6708",
                    "sense_definition": "Any swamp, marsh, or mire, often viewed as dark or unpleasant.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "wetland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cold mist rose across the gloomy <w>fen</w> as twilight began to fall.",
                            "target_lang_translations": {
                                "zh": "暮色降临时，阴森的<w>沼泽</w>上泛起了阵阵寒雾。"
                            }
                        },
                        {
                            "text": "The travellers were warned not to wander into the dark <w>fen</w> after sunset.",
                            "target_lang_translations": {
                                "zh": "旅行者们受到警告，日落后不要误入那片黑暗的<w>泥潭</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "swamp",
                        "morass",
                        "quagmire"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in literary or archaic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（文学或古旧用法）阴暗、荒凉或险恶的沼泽、泥潭。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "沼泽",
                                "target_lang_sense_clarification": "阴暗潮湿的水泽"
                            },
                            {
                                "target_lang_word": "泥潭",
                                "target_lang_sense_clarification": "深陷危险的泥沼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afa85356-1d0a-3093-874f-4a20dffc5807",
                    "sense_definition": "A unit of currency in China, equal to one hundredth of a yuan.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "currency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old postage stamp cost only a few <w>fen</w> when it was first issued.",
                            "target_lang_translations": {
                                "zh": "这张旧邮票刚发行时只要几<w>分</w>钱。"
                            }
                        },
                        {
                            "text": "One yuan is traditionally divided into ten jiao or one hundred <w>fen</w>.",
                            "target_lang_translations": {
                                "zh": "一元传统上分为十角，或一百<w>分</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "中国货币单位“分”，等于百分之一元。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "分",
                                "target_lang_sense_clarification": "人民币等货币单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78438ceb-1f5c-3dd6-b0d6-b784d7dd96df",
                    "sense_definition": "Plural form of fan used playfully by enthusiasts of science fiction, fantasy, and related media.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fandom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Longtime science fiction <w>fen</w> gathered at the annual convention to trade old magazines.",
                            "target_lang_translations": {
                                "zh": "资深科幻<w>粉丝们</w>聚集在年会上交换旧杂志。"
                            }
                        },
                        {
                            "text": "The message board was created specifically for anime <w>fen</w> to discuss classic series.",
                            "target_lang_translations": {
                                "zh": "该论坛是专门为动漫<w>迷友们</w>讨论经典系列而创建的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used within science fiction and fantasy fandom"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（科幻或奇幻同好圈俚语）fan（粉丝）的戏谑性复数形式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "粉丝们",
                                "target_lang_sense_clarification": "科幻或奇幻爱好者群体"
                            },
                            {
                                "target_lang_word": "迷友们",
                                "target_lang_sense_clarification": "同好交流圈中的爱好者群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e0233a0-bae2-3d7c-bf9c-beeed27021a4",
                    "sense_definition": "A fennec fox.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The photograph showed a tiny <w>fen</w> with enormously oversized ears resting on the sand.",
                            "target_lang_translations": {
                                "zh": "照片上是一只长着一对超大耳朵的小<w>耳廓狐</w>趴在沙地上。"
                            }
                        },
                        {
                            "text": "She drew a cute cartoon of a little <w>fen</w> curled up asleep.",
                            "target_lang_translations": {
                                "zh": "她画了一幅可爱的卡通画，画中一只小<w>耳廓狐</w>蜷缩着睡着了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal or subcultural abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "耳廓狐（fennec fox）的简称或昵称。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "耳廓狐",
                                "target_lang_sense_clarification": "体型小且耳朵特大的沙漠狐狸"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80c1e072-cc4a-3dda-8d45-b6407ab13860",
                    "sense_definition": "A type of mould or mildew that affects hop plants.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Damp summer weather encouraged the growth of destructive <w>fen</w> across the hop fields.",
                            "target_lang_translations": {
                                "zh": "潮湿的夏季天气助长了破坏性<w>白粉病</w>在啤酒花园里的蔓延。"
                            }
                        },
                        {
                            "text": "Farmers inspected the hop bines carefully to prevent the spread of <w>fen</w> before harvest.",
                            "target_lang_translations": {
                                "zh": "农户们仔细检查啤酒花藤蔓，以防在收获前暴发<w>霉菌病</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mildew",
                        "mould"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical agricultural usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（旧时农业）侵害啤酒花植株的霉菌病或白粉病。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "白粉病",
                                "target_lang_sense_clarification": "啤酒花等作物的真菌病害"
                            },
                            {
                                "target_lang_word": "霉菌病",
                                "target_lang_sense_clarification": "啤酒花霉病"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "88d10ad6-0016-3553-8b7e-f20c49017217",
                    "sense_definition": "An exclamation called out in children's games to claim immunity, call a truce, or prevent an opponent from making a move.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He shouted '<w>fen</w>!' just before his opponent could tag his marble.",
                            "target_lang_translations": {
                                "zh": "就在对手击中他的弹珠前一秒，他大喊了一声“<w>停</w>！”"
                            }
                        },
                        {
                            "text": "Whenever a dispute arose during the match, the boy would call '<w>fen</w>' to stop play.",
                            "target_lang_translations": {
                                "zh": "每当比赛中发生争议时，那个男孩就会喊“<w>暂停</w>”以停止游戏。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "traditional children's slang or dialect"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（儿童游戏方言）喊停、要求豁免或暂停比赛时的呼喊声。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "暂停",
                                "target_lang_sense_clarification": "游戏中断口号"
                            },
                            {
                                "target_lang_word": "停",
                                "target_lang_sense_clarification": "叫停喊声"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}