{
    "word_family": [
        "previous"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a136d3b2-c04f-3bdf-a5ef-08f7f31498c8",
                    "sense_definition": "At an earlier time or before the present moment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist discovered a <w>previously</w> unknown species of bird in the rainforest.",
                            "target_lang_translations": {
                                "ru": "Ученый обнаружил в тропическом лесу <w>ранее</w> неизвестный вид птиц."
                            }
                        },
                        {
                            "text": "She had <w>previously</w> mentioned that she wanted to travel to Japan next year.",
                            "target_lang_translations": {
                                "ru": "Она <w>раньше</w> упоминала, что хочет поехать в Японию в следующем году."
                            }
                        }
                    ],
                    "synonyms": [
                        "before",
                        "earlier",
                        "formerly",
                        "already"
                    ],
                    "antonyms": [
                        "later",
                        "afterward",
                        "subsequently"
                    ],
                    "common_phrases": [
                        "previously "
                    ],
                    "target_lang_definitions": {
                        "ru": "В более раннее время или до настоящего момента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ранее",
                                "target_lang_sense_clarification": "до какого-либо момента"
                            },
                            {
                                "target_lang_word": "раньше",
                                "target_lang_sense_clarification": "в прежнее время"
                            },
                            {
                                "target_lang_word": "прежде",
                                "target_lang_sense_clarification": "некоторое время назад"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "562735d6-4213-3951-ba55-7534a8b772c4",
                    "sense_definition": "Before a specific event or action occurs; in advance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>previously</w> arrange an appointment before visiting the consultant.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>предварительно</w> договориться о встрече перед посещением консультанта."
                            }
                        },
                        {
                            "text": "The terms of the contract were <w>previously</w> agreed upon by both parties.",
                            "target_lang_translations": {
                                "ru": "Условия контракта были <w>ранее</w> согласованы обеими сторонами."
                            }
                        }
                    ],
                    "synonyms": [
                        "beforehand",
                        "ahead"
                    ],
                    "common_phrases": [
                        "previously agreed"
                    ],
                    "target_lang_definitions": {
                        "ru": "До того, как произойдет определенное событие или действие; заранее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предварительно",
                                "target_lang_sense_clarification": "заранее"
                            },
                            {
                                "target_lang_word": "заранее",
                                "target_lang_sense_clarification": "заблаговременно"
                            },
                            {
                                "target_lang_word": "ранее",
                                "target_lang_sense_clarification": "до определенного срока"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "535bdfc8-99dc-3bc0-b2f2-bc757e94f1eb",
                    "sense_definition": "Used to introduce a summary of what happened in earlier episodes of a television series.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Previously</w> on the show, the main character discovered a hidden secret about his family.",
                            "target_lang_translations": {
                                "ru": "<w>В предыдущих сериях</w>: главный герой узнал тайну своей семьи."
                            }
                        },
                        {
                            "text": "The narrator said <w>previously</w> on Lost to remind viewers of the plot.",
                            "target_lang_translations": {
                                "ru": "Диктор сказал «<w>ранее</w> в сериале Остаться в живых», чтобы напомнить зрителям сюжет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "previously on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для введения краткого обзора того, что произошло в предыдущих сериях телесериала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в предыдущих сериях",
                                "target_lang_sense_clarification": "краткое содержание"
                            },
                            {
                                "target_lang_word": "ранее",
                                "target_lang_sense_clarification": "в контексте сериала"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}