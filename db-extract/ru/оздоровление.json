                "translations": [
                    {
                        "translation_id": "b4054c3c-f3ca-4edb-8745-11cb715f2983",
                        "source_entry_id": "6a172517-d02f-34f5-a067-caaf5a3f1974",
                        "target_lang_word": "Gesundung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesundung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a3ce1af-634d-3ed3-bcf6-78d0b64e817e",
                                        "entry_id": "599e2b61-3c29-3121-9e87-581853f464e6",
                                        "glosses": [
                                            "Weg zum Wiedererreichen des Zustandes, gesund zu sein"
                                        ],
                                        "tags": [
                                            "Allgemeinbefinden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f11cac1-2964-4765-b15f-d4e1a935b55d",
                                                "sense_id": "7a3ce1af-634d-3ed3-bcf6-78d0b64e817e",
                                                "text": "Ein kranker Organismus sehnt sich nach Ruhe, Zeit und Kraft zur Gesundung."
                                            },
                                            {
                                                "example_id": "12ff9fb0-ca4b-48b3-9a4f-9cc50e9b9704",
                                                "sense_id": "7a3ce1af-634d-3ed3-bcf6-78d0b64e817e",
                                                "text": "Die große Frage zu Corona ist: Ist man nach Erkrankung und Gesundung immun?"
                                            },
                                            {
                                                "example_id": "1e8e7628-2174-4c43-889a-95ca6ef86105",
                                                "sense_id": "7a3ce1af-634d-3ed3-bcf6-78d0b64e817e",
                                                "text": "„Sie bat mich, ihrem Geliebten auszurichten, ihr Vater spreche wieder mit ihr, und sie hoffe, daß er nach seiner Gesundung eine neue Magd einstellen werde.“"
                                            },
                                            {
                                                "example_id": "a73b1a8f-1baf-4fdc-92ab-2018e15e1fa1",
                                                "sense_id": "7a3ce1af-634d-3ed3-bcf6-78d0b64e817e",
                                                "text": "„«Meine geehrten Zuhörer», so faßt Thomas Mann zusammen, «man spricht und berät heute viel über eine zu erhoffende seelische Gesundung Europas. Was aber ist denn das, seelische Gesundung?“«"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0abc7f7d-0fb1-3343-a394-063cf1ef130f",
                                        "entry_id": "599e2b61-3c29-3121-9e87-581853f464e6",
                                        "glosses": [
                                            "Verbesserung eines Zustandes (auch durch Rückentwicklung) hin zu einer als positiv und stabil erachteten Ausprägung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f164269-957a-4d03-8e3d-8532c8c51f2b",
                                                "sense_id": "0abc7f7d-0fb1-3343-a394-063cf1ef130f",
                                                "text": "„«Meine geehrten Zuhörer», so faßt Thomas Mann zusammen, «man spricht und berät heute viel über eine zu erhoffende seelische Gesundung Europas. Was aber ist denn das, seelische Gesundung?“«"
                                            },
                                            {
                                                "example_id": "fb45eb27-431f-4280-ae60-850ceeccadae",
                                                "sense_id": "0abc7f7d-0fb1-3343-a394-063cf1ef130f",
                                                "text": "Von einer Gesundung kann noch keine Rede sein, wir geben nach wie vor mehr aus, als wir einnehmen, aber eben nicht so viel mehr, wie noch in den letzten Monaten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
