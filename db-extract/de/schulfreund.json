                "senses": [
                    {
                        "sense_id": "650285a0-116c-343f-8d88-0ebbbae9e258",
                        "entry_id": "d86b656d-7833-39fa-b0e6-6b558e5a069a",
                        "glosses": [
                            "Mitschüler, zu dem während der Schulzeit eine freundschaftliche Beziehung begründet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "598f8525-0b4c-4264-b495-38bc7516e5f4",
                                "sense_id": "650285a0-116c-343f-8d88-0ebbbae9e258",
                                "text": "„Selbst da fand ich noch zwei Schulfreunde, die sich an unsere gemeinsame Zeit erinnerten, ich mich aber nicht mehr an sie.“"
                            },
                            {
                                "example_id": "9529fe38-7add-4b89-9304-f0f0e339b92f",
                                "sense_id": "650285a0-116c-343f-8d88-0ebbbae9e258",
                                "text": "„Zwei Schulfreunde treffen sich.“"
                            },
                            {
                                "example_id": "f67f64b6-8149-42f8-ac10-b5cb368d523b",
                                "sense_id": "650285a0-116c-343f-8d88-0ebbbae9e258",
                                "text": "„Mit seinem Schulfreund Gottlieb Harms floh er dreimal von zu Hause und musste dreimal kapitulieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
