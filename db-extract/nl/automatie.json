                                        "sense_id": "0859605c-9549-3717-9b8e-693fbbd82dab",
                                        "entry_id": "0663db8e-0aea-3169-960d-612beef3af69",
                                        "glosses": [
                                            "The power of initiating vital processes from within the cell, organ, or organism, independent of external stimulus."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7cc68fd-1178-3450-91da-09e4bbc6613e",
                                        "entry_id": "0663db8e-0aea-3169-960d-612beef3af69",
                                        "glosses": [
                                            "The doctrine that animals are automata, operating according to mechanical laws."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bebf2b71-bcb1-3d71-9ff5-984ee91b00b5",
                                        "entry_id": "0663db8e-0aea-3169-960d-612beef3af69",
                                        "glosses": [
                                            "A surrealist painting technique whereby one attempts to move the brush, pen etc. without conscious control over it."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e2a2056-5eb7-41ab-a441-40c63350b49e",
                                                "sense_id": "bebf2b71-bcb1-3d71-9ff5-984ee91b00b5",
                                                "text": "Overcoming the gravity of representation and the figurative, automatism and acquired reflexes, she mixes brute force and translucid emotions to paint an ontological, disquieting, enigmatic human figure free from artifice, universal in its expression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5374538-06f0-390c-8bc1-1559778377e6",
                                        "entry_id": "0663db8e-0aea-3169-960d-612beef3af69",
                                        "glosses": [
                                            "An action performed subconsciously, without any apparent direction from the mind; a thought which appears spontaneously in one's consciousness."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3ac5e44-2771-4934-bf45-1c340258aece",
                                                "sense_id": "a5374538-06f0-390c-8bc1-1559778377e6",
                                                "text": "[G]eneralising this phenomenon, Mr. Myers has given the name of automatism, sensory or motor, emotional or intellectual, to this whole sphere of effects, due to 'uprushes' into the ordinary consciousness of energies originating in the subliminal parts of the mind. The simplest instance of an automatism is the phenomenon of post-hypnotic suggestion, so-called."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
