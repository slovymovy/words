                "senses": [
                    {
                        "sense_id": "3a24b373-3f8b-3d86-897c-45d7aeecf0b5",
                        "entry_id": "31c2b952-4943-3639-99d5-6e63becb0a1b",
                        "glosses": [
                            "разг. тот, кто любит смотреть на кого-либо из праздного любопытства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b4b744c-6c3d-4b04-99af-0e3a75fadf71",
                                "sense_id": "3a24b373-3f8b-3d86-897c-45d7aeecf0b5",
                                "text": "К окошку стягивались любопытные. Почтовая девица стала звать на помощь свою начальницу. Жека забрал конверт, растолкал ротозеев и снова пошёл к справочному агрегату."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b22ccab-b7d9-32a3-b9cb-8fa728b58157",
                        "entry_id": "31c2b952-4943-3639-99d5-6e63becb0a1b",
                        "glosses": [
                            "разг. рассеянный, невнимательный человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0c7c36b-feeb-4ffa-9b35-32d810fe5344",
                                "sense_id": "9b22ccab-b7d9-32a3-b9cb-8fa728b58157",
                                "text": "— Это потому, — строго продолжала Калугина, — что те или иные товары не запланировали такие ротозеи, как вы!"
                            }
                        ]
                    }
