                                        "entry_id": "5ddb7de0-bb6f-3104-9858-331ed80f8857",
                                        "glosses": [
                                            "A condition characterized by unequal size of the pupils of the eye."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ece755f1-f19d-4fb3-95e2-73e5ab0e8815",
                                                "sense_id": "54b418c6-6092-336c-91b1-c1f16dcedb4f",
                                                "text": "Anisocoria is the occurrence of unequal or asymmetric pupils. Very slight differences are common and of no significance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94618d33-88f4-4633-a87a-04b7c2e446dd",
