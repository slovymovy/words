{
    "word_family": [
        "процессуальный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c79464ef-80da-33e7-9c6e-ee8c853a8ccd",
                    "sense_definition": "Ход, развитие какого-либо явления, последовательная смена состояний или стадий.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учебный <w>процесс</w> в университете организован очень эффективно.",
                            "target_lang_translations": {
                                "en": "The educational <w>process</w> at the university is organized very effectively.",
                                "zh": "大学的教学<w>过程</w>组织得非常高效。"
                            }
                        },
                        {
                            "text": "Мы находимся в <w>процессе</w> поиска нового сотрудника.",
                            "target_lang_translations": {
                                "en": "We are in the <w>process</w> of searching for a new employee.",
                                "zh": "我们正处于寻找新员工的<w>过程</w>中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ход",
                        "развитие",
                        "течение"
                    ],
                    "antonyms": [
                        "застой",
                        "остановка"
                    ],
                    "common_phrases": [
                        "в процессе",
                        "учебный процесс",
                        "творческий процесс",
                        "рабочий процесс",
                        "мирный процесс"
                    ],
                    "target_lang_definitions": {
                        "en": "The course or development of a phenomenon; a sequential change of states or stages.",
                        "zh": "事物发展、演变或进行的过程，指一系列连续的阶段或状态。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "process",
                                "target_lang_sense_clarification": "series of actions or events"
                            },
                            {
                                "target_lang_word": "course",
                                "target_lang_sense_clarification": "progression or flow"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "过程",
                                "target_lang_sense_clarification": "事物发展所经过的程序或阶段"
                            },
                            {
                                "target_lang_word": "进程",
                                "target_lang_sense_clarification": "事物发展变化的过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb2b85b5-3577-3999-9876-c379796e1146",
                    "sense_definition": "Порядок разбирательства судебных и административных дел, а также само такое дело.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Громкий судебный <w>процесс</w> привлёк внимание всех журналистов города.",
                            "target_lang_translations": {
                                "en": "The high-profile <w>trial</w> attracted the attention of all the city's journalists.",
                                "zh": "那场轰动一时的<w>诉讼</w>吸引了全城记者的关注。"
                            }
                        },
                        {
                            "text": "Адвокат надеется выиграть этот сложный <w>процесс</w>.",
                            "target_lang_translations": {
                                "en": "The lawyer hopes to win this complex <w>lawsuit</w>.",
                                "zh": "律师希望赢得这场复杂的<w>诉讼</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "суд",
                        "разбирательство",
                        "дело"
                    ],
                    "common_phrases": [
                        "судебный процесс",
                        "уголовный процесс",
                        "гражданский процесс",
                        "выиграть процесс"
                    ],
                    "target_lang_definitions": {
                        "en": "The order of handling judicial and administrative cases, or the legal case itself.",
                        "zh": "司法或行政案件的审理程序，或指具体的诉讼案件。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trial",
                                "target_lang_sense_clarification": "legal examination in court"
                            },
                            {
                                "target_lang_word": "lawsuit",
                                "target_lang_sense_clarification": "civil legal case"
                            },
                            {
                                "target_lang_word": "proceedings",
                                "target_lang_sense_clarification": "legal action"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诉讼",
                                "target_lang_sense_clarification": "法律上的审理程序"
                            },
                            {
                                "target_lang_word": "审判",
                                "target_lang_sense_clarification": "法院对案件的审理和判决"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68b992af-e96f-39f6-a04f-a3edbb5a42d8",
                    "sense_definition": "Активное развитие болезни, воспаление или патологическое изменение в организме.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач обнаружил у пациента скрытый воспалительный <w>процесс</w>.",
                            "target_lang_translations": {
                                "en": "The doctor discovered a hidden inflammatory <w>process</w> in the patient.",
                                "zh": "医生在病人身上发现了隐蔽的炎症<w>过程</w>。"
                            }
                        },
                        {
                            "text": "Если не лечить этот <w>процесс</w> вовремя, могут возникнуть осложнения.",
                            "target_lang_translations": {
                                "en": "If this <w>process</w> is not treated on time, complications may arise.",
                                "zh": "如果不及时治疗这种病理<w>过程</w>，可能会引发并发症。"
                            }
                        }
                    ],
                    "synonyms": [
                        "воспаление",
                        "заболевание"
                    ],
                    "antonyms": [
                        "выздоровление",
                        "ремиссия"
                    ],
                    "common_phrases": [
                        "воспалительный процесс",
                        "хронический процесс",
                        "процесс в лёгких"
                    ],
                    "target_lang_definitions": {
                        "en": "Active development of a disease, inflammation, or pathological change in the body.",
                        "zh": "指机体内疾病的发生、发展或病理性的变化。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "process",
                                "target_lang_sense_clarification": "pathological development"
                            },
                            {
                                "target_lang_word": "condition",
                                "target_lang_sense_clarification": "medical state"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "病变",
                                "target_lang_sense_clarification": "机体发生的病理性变化"
                            },
                            {
                                "target_lang_word": "过程",
                                "target_lang_sense_clarification": "医学上指疾病发展的动态变化"
                            }
                        ]
                    }
                }
            ]
        }
    ]
