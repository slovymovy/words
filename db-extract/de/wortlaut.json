                ],
                "senses": [
                    {
                        "sense_id": "979a4a1c-e357-3172-a186-08326d2c2759",
                        "entry_id": "8255d799-96c7-3ce5-8972-f2d60d971aec",
                        "glosses": [
                            "wortwörtliche Form, in der etwas geäußert wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59a2e74e-25cb-4bff-b64d-be6eec14c482",
                                "sense_id": "979a4a1c-e357-3172-a186-08326d2c2759",
                                "text": "„Wenn einer vor der Klasse etwas ausdrucksvoll vorlas oder vortrug und alle anderen aufmerksam zuhörten, dann war das Rollenschema der Ansprache und Verkündigung bereits durch den Wortlaut fixiert.“"
                            },
                            {
                                "example_id": "42cc3fb7-1fbe-4b1d-a4e1-9d6784002b49",
                                "sense_id": "979a4a1c-e357-3172-a186-08326d2c2759",
                                "text": "„Auch empfand er das Bedürfnis, manchmal Dinge in Ruhe für sich zu überlegen und wenn ihm der genaue Wortlaut nicht mehr geläufig war, sozusagen nachzuschlagen und sich seiner zu vergewissern.“"
                            },
                            {
                                "example_id": "32a92913-6b3f-488c-9ba1-51c1be1519e2",
                                "sense_id": "979a4a1c-e357-3172-a186-08326d2c2759",
                                "text": "„Hatte ich das nicht unmittelbar danach im Wortlaut aufgeschrieben?“"
                            },
                            {
                                "example_id": "b29a34f0-b2d9-41ed-8001-7522a15cd209",
                                "sense_id": "979a4a1c-e357-3172-a186-08326d2c2759",
                                "text": "„Sie spendeten zum Beispiel dem Brief der Cambridger Sternwarte, den sie im vollen Wortlaut abdruckten, das höchste Lob.“"
                            },
                            {
                                "example_id": "941c4bd2-b490-4b5d-8267-9b1a3491f79c",
                                "sense_id": "979a4a1c-e357-3172-a186-08326d2c2759",
                                "text": "„Niko fing an, den Wortlaut zu verlesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d03a646-217e-49a7-a00f-7a9d12176363",
