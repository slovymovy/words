                "senses": [
                    {
                        "sense_id": "7ccf80ca-b73c-336f-a4f5-6f60e90edd5b",
                        "entry_id": "4928b256-3891-3c4e-89aa-3997ab0e0a6a",
                        "glosses": [
                            "Bier oder bierhaltiges Getränk, das durch Einwohner und Touristen auf dem Weg zur oder von der Arbeit, zu einer Feier oder zwischen Aufenthaltsorten konsumiert wird"
                        ],
                        "tags": [
                            "colloquial",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "d1e7fb7d-ddd9-41fe-a20a-0453575766e9",
                                "sense_id": "7ccf80ca-b73c-336f-a4f5-6f60e90edd5b",
                                "text": "„Dafür, und weil sie sich schon gut kannten, gab's vom Wirt aber für jeden ein Wegebier auf die Hand.“"
                            },
                            {
                                "example_id": "8b3954be-16f6-463b-a2e8-353e96002ac0",
                                "sense_id": "7ccf80ca-b73c-336f-a4f5-6f60e90edd5b",
                                "text": "„Teenies, die die Schule glücklich los sind, lassen die Flaschen mit Wegebier und Cola unbeschwert untereinander kreisen und umarmen sich reihum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
