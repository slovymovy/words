                "senses": [
                    {
                        "sense_id": "2c543615-df42-3b99-b3e3-487fa92ea5c9",
                        "entry_id": "fa62f27d-1d95-3eb5-a911-cb9f7933b037",
                        "glosses": [
                            "toestel om een afbeelding op een scherm te projecteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1768323-d115-4b5f-afb7-c0cb71bc71ae",
                                "sense_id": "2c543615-df42-3b99-b3e3-487fa92ea5c9",
                                "text": "Om de Rotterdammers een handje te helpen, is een projector naast de vuilnisbakken geplaatst. Die projecteert beelden van een levensgrote rat bij de container. De projectie van het knaagdier wordt afgewisseld met de tekst: \"Voorkom ratten.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "ac106b3f-a476-31a9-87f1-867f36974d18",
                        "entry_id": "fa62f27d-1d95-3eb5-a911-cb9f7933b037",
                        "glosses": [
                            "de lijn waarmee men een punt of een lijn op een andere lijn of een vlak projecteert"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7472ccb2-2243-49ca-b7ec-d496fab64db7",
                        "source_entry_id": "fa62f27d-1d95-3eb5-a911-cb9f7933b037",
                        "source_sense_description": "toestel om een afbeelding op een scherm te projecteren",
                        "target_lang_word": "Projektor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Projektor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0eb1a2b-4384-3b43-8cf6-99572a25c16c",
                                        "entry_id": "edbbe0e3-f643-34e5-aa83-f5a5e6d82d21",
                                        "glosses": [
                                            "Gerät zum Wiedergeben von Bildern auf einer Fläche, insbesondere auf einer Bildwand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07fefd47-51a7-470f-8154-77f64bf7a8d1",
                                                "sense_id": "b0eb1a2b-4384-3b43-8cf6-99572a25c16c",
                                                "text": "Er präsentierte die Bilder für sein Referat mit einem Projektor."
                                            },
                                            {
                                                "example_id": "0f7eccfa-1491-4d0d-b71d-2fbb12e74581",
                                                "sense_id": "b0eb1a2b-4384-3b43-8cf6-99572a25c16c",
                                                "text": "„Der ließ darauf die Leinwand und die automatischen Jalousien vor der Fensterfront herunter und schaltete den Projektor ein.“"
                                            },
                                            {
                                                "example_id": "6d786e1a-7faf-41d4-b16e-97cd2f9eb232",
                                                "sense_id": "b0eb1a2b-4384-3b43-8cf6-99572a25c16c",
                                                "text": "„Die Veranda war verdunkelt, und der Projektor warf Filmbilder auf eine Leinwand, die ein bißchen schief an einem Ständer hing.“"
                                            },
                                            {
                                                "example_id": "c042454b-cf35-4174-8c39-0b3807bc9268",
                                                "sense_id": "b0eb1a2b-4384-3b43-8cf6-99572a25c16c",
                                                "text": "„Henri hält sie hoch wie Münzen, bevor er sie in den Projektor steckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75622daf-bf15-4ebe-a1d6-efa9f4c6439d",
                        "source_entry_id": "fa62f27d-1d95-3eb5-a911-cb9f7933b037",
                        "source_sense_description": "toestel om een afbeelding op een scherm te projecteren",
                        "target_lang_word": "projector",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "projector",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0671eb48-58d8-3190-a846-cdec451f1c68",
                                        "entry_id": "53163ea1-f1ec-3ca3-8d5d-ea615bd0bd46",
                                        "glosses": [
                                            "Someone who devises or suggests a project; a proposer or planner of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c75b1f3-653d-4099-a05f-e6928945aba6",
                                                "sense_id": "0671eb48-58d8-3190-a846-cdec451f1c68",
                                                "text": "So far is it from the kenne of theſe wretched projectors of ours that beſcraull their Pamflets every day with new formes of government for our Church."
                                            },
                                            {
                                                "example_id": "d60094a0-4693-45c5-883a-f61be857f542",
                                                "sense_id": "0671eb48-58d8-3190-a846-cdec451f1c68",
                                                "text": "[A]s the Doctor neither did this, nor yet sent him an answer, the projector wrote a second letter […]."
                                            },
                                            {
                                                "example_id": "f1f54323-df95-44f7-95cf-053960c9ed17",
                                                "sense_id": "0671eb48-58d8-3190-a846-cdec451f1c68",
                                                "text": "[…] either the work of the winter storms, or perhaps the victims of some extensive but desultory scheme of denudation, which the projector had not capital or perseverance to carry into full effect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b092993-e534-3336-931d-565ffa10ffb2",
                                        "entry_id": "53163ea1-f1ec-3ca3-8d5d-ea615bd0bd46",
                                        "glosses": [
                                            "An optical device that projects a beam of light, especially one used to project an image (or moving images) onto a screen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "887a1d56-9078-3577-aed7-4dd986919744",
                                        "entry_id": "53163ea1-f1ec-3ca3-8d5d-ea615bd0bd46",
                                        "glosses": [
                                            "That which projects or launches something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83fa86bf-3c15-4063-a109-88f11204c020",
                                                "sense_id": "887a1d56-9078-3577-aed7-4dd986919744",
                                                "text": "a depth charge projector"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af0c78f2-3fa5-34f3-b6f7-fc79b1716337",
                                        "entry_id": "53163ea1-f1ec-3ca3-8d5d-ea615bd0bd46",
                                        "glosses": [
                                            "One who projects, or ascribes his/her own feelings to others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e0a8f18-e3c3-4aad-899f-dd28daa6c75c",
                                                "sense_id": "af0c78f2-3fa5-34f3-b6f7-fc79b1716337",
                                                "text": "Projectors attempt to get rid of unwanted feelings, only it does not work; they still experience the unwanted feelings […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43e7ae89-1eee-33e7-b971-bd2da7b5439f",
                                        "entry_id": "53163ea1-f1ec-3ca3-8d5d-ea615bd0bd46",
                                        "glosses": [
                                            "An operator that forms a projection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a251a22-1434-44a3-8612-83704ac5cbd8",
                        "source_entry_id": "fa62f27d-1d95-3eb5-a911-cb9f7933b037",
                        "source_sense_description": "toestel om een afbeelding op een scherm te projecteren",
                        "target_lang_word": "projecteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "projecteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce6f2595-3d25-324e-b1b3-b8c182d13176",
                                        "entry_id": "a5d5087b-d520-39a2-8166-d0bca0bb5aba",
                                        "glosses": [
                                            "Appareil qui projette un faisceau de rayons lumineux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc11a2d1-287d-46de-ade0-e9962f434506",
                                                "sense_id": "ce6f2595-3d25-324e-b1b3-b8c182d13176",
                                                "text": "[…]; des hommes mûrs pleuraient à la vue du drapeau étoilé soutenu par tout le corps de ballet noyé sous les clartés des projecteurs."
                                            },
                                            {
                                                "example_id": "bec7e8b4-75dd-4b71-8817-19dc366ea72d",
                                                "sense_id": "ce6f2595-3d25-324e-b1b3-b8c182d13176",
                                                "text": "[…] ; si l'on admet que la pénombre qui baigne le cornemusiste dépend du projecteur, comment expliquer la forte lumière qui est dardée sur le violoniste ? Pourquoi ne reçoit-il pas les ombres portées de ses voisins ?"
                                            },
                                            {
                                                "example_id": "38be46fc-76e3-42e5-90da-3f61e073d6d0",
                                                "sense_id": "ce6f2595-3d25-324e-b1b3-b8c182d13176",
                                                "text": "Pour le tango, la salle était plongée dans l'obscurité, et deux petits projecteurs dirigeaient leurs faisceaux sur la boule à facettes qui tournait lentement."
                                            },
                                            {
                                                "example_id": "618c4983-3372-41cf-ae7a-17334f336d90",
                                                "sense_id": "ce6f2595-3d25-324e-b1b3-b8c182d13176",
                                                "text": "Le bateau s'enfonce dans l'obscurité. Le projecteur fixé au-dessus du chalut éclaire les eaux vertes et écumantes qu'accompagne le cortège des mouettes."
                                            },
                                            {
                                                "example_id": "4fcebff8-40e8-4bc9-81fa-b80c6a8b8b58",
                                                "sense_id": "ce6f2595-3d25-324e-b1b3-b8c182d13176",
                                                "text": "Depuis plus d'une semaine, la zone est infestée de flics et d'agents en civil. La nuit, elle entend l'hélicoptère passer en vrombissant, voit le pinceau du projecteur éclabousser les collines de mesquites, de chênes et de roches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a22512d-a24f-37fe-a030-ef18d8e55f40",
                                        "entry_id": "a5d5087b-d520-39a2-8166-d0bca0bb5aba",
                                        "glosses": [
                                            "Appareil destiné à agrandir et à projeter sur un écran l'image d'une diapositive."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4bb98112-cc5f-3f36-815b-8ca547ead0fc",
                                        "entry_id": "a5d5087b-d520-39a2-8166-d0bca0bb5aba",
                                        "glosses": [
                                            "Personne qui conçoit des projets."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "380c7a2f-5837-48b8-bc68-eb8205dea0fe",
                                                "sense_id": "4bb98112-cc5f-3f36-815b-8ca547ead0fc",
                                                "text": "Nous voyons apparaître aussitôt une profession nouvelle, celle d'inventeur (uit vinder) de projets, ou, plus brièvement, de “projecteurs”, en vue de donner un cadre juridique et économique à une compagnie..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
