                                        "glosses": [
                                            "Qui dérange."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d644b67a-cef2-47de-9eb0-0feda120c86e",
                                                "sense_id": "025fc886-05fd-3dac-abcb-56d752b28769",
                                                "text": "Pour ces derniers, l’art contemporain présente un autre avantage : son caractère dérangeant."
                                            },
                                            {
                                                "example_id": "a2154638-9849-434b-b2d9-32d7b3b4e6bb",
                                                "sense_id": "025fc886-05fd-3dac-abcb-56d752b28769",
                                                "text": "Ce serait un autre cas de censure de la parole dérangeante, qui sort des normes édictées par le politiquement correct.\n Ces gens, qui défendent la présence de Trump sur Twitter, utilisent un raccourci tout aussi dérangeant : la parole de Trump, en marge des événements du Capitole, n’est pas une parole tolérable ou démocratique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dérangeant",
                                "target_lang_code": "fr",
                                "target_senses": [
