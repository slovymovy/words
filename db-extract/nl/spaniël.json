                "senses": [
                    {
                        "sense_id": "69433963-a682-3159-83bc-8603f9f2e39e",
                        "entry_id": "4b73ba67-c30b-3aec-b54b-a498aec5b6fd",
                        "glosses": [
                            "kleine hond, behorend tot een ras met lange haren en hangende oren, oorspronkelijk gefokt om te assisteren bij de jacht op gevogelte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b807bfa-3e1a-470f-abfa-058383e962ca",
                                "sense_id": "69433963-a682-3159-83bc-8603f9f2e39e",
                                "text": "Zuid-Koreanen wier hond of kat last heeft van een loopneus, koorts of andere coronagerelateerde klachten, kunnen hun dieren voortaan gratis laten testen op het coronavirus. (…) De eerste patiënt was een 8-jarige spaniël met koorts - de uitslag van de test van dit dier wordt later op woensdag bekend."
                            },
                            {
                                "example_id": "4d98552d-a431-495e-b46c-ee9958b1d78e",
                                "sense_id": "69433963-a682-3159-83bc-8603f9f2e39e",
                                "text": "Honden zijn niet toegestaan op het plein. (…) Toch brengt een meisje op een dag haar kleine spaniël mee."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abb03faf-e3a2-4c72-bff1-85bc445f31a5",
                        "source_entry_id": "4b73ba67-c30b-3aec-b54b-a498aec5b6fd",
