                    "frequency": "Low",
                    "semantic_group_id": "hidden_intent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The research project had <w>ulterior</w> goals that were not mentioned in the initial proposal.",
                            "target_lang_translations": {
                                "nl": "Het onderzoeksproject had <w>onderliggende</w> doelen die niet in het oorspronkelijke voorstel werden genoemd."
                            }
                        },
                        {
                            "text": "Beyond the simple facts, there are <w>ulterior</w> questions that require deeper investigation.",
