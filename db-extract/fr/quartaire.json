                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aa2aed9-1d8a-491b-9eb1-ac9f9dc2fc08",
                                "sense_id": "68dcb656-6007-3624-a239-bc8436dc0c4b",
                                "text": "Période, construction quartaire."
                            },
                            {
                                "example_id": "b9d57053-5cb5-44e4-9dda-f8477160e674",
                                "sense_id": "68dcb656-6007-3624-a239-bc8436dc0c4b",
                                "text": "L'ogival quartaire se distingue dans les ornements par une plus grande élégance, une plus grande finesse : ce sont des festons, des dentelles, des panneaux chargés d'arabesques."
                            },
                            {
                                "example_id": "c2d9b56d-e0ea-4d4d-a523-9f8b8322ba11",
                                "sense_id": "68dcb656-6007-3624-a239-bc8436dc0c4b",
                                "text": "La troisième section de la période ogivale a été divisée par M. de Caumont en style tertiaire, comprenant l'architecture flamboyante proprement dite, et en style quartaire dont le commencement est assigné à l'année 1450."
                            }
                        ]
