                "senses": [
                    {
                        "sense_id": "76c48f19-4231-3457-93b8-083403d23465",
                        "entry_id": "2654bc69-6ed8-3d72-9f27-f34dba88dc38",
                        "glosses": [
                            "Donner un caractère polynomial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d16b47c3-6e60-4b8e-a6ed-d85a29e53293",
                                "sense_id": "76c48f19-4231-3457-93b8-083403d23465",
                                "text": "D’une part, la traduction ou l’immersion arithmétique de la logique nous a donné l’ancrage nécessaire pour «polynomialiser» connecteurs et quantificateurs."
                            },
                            {
                                "example_id": "73a45641-f313-4e62-9b41-be062dcc2190",
                                "sense_id": "76c48f19-4231-3457-93b8-083403d23465",
                                "text": "La première chose à faire, totalement indépendante du polynôme f ci-dessus, est de “polynomialiser” en 5 indéterminées chaque action transitive de S5."
                            },
                            {
                                "example_id": "12d931bb-924a-4292-9f93-c8ba76b67b4e",
                                "sense_id": "76c48f19-4231-3457-93b8-083403d23465",
                                "text": "C'est cela qui permet de \"polynomialiser le binz'."
                            }
                        ]
                    }
