                "senses": [
                    {
                        "sense_id": "ff4dfba5-e1a9-3f57-a722-9a324a82df5f",
                        "entry_id": "8f61fdd1-9d25-34ad-aec6-d4ac1a21f704",
                        "glosses": [
                            "Wortwechsel, bei dem einer den andern im Schimpfen zu übertreffen sucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4664ba2-d5f1-4a4c-9a88-defc2354020a",
                                "sense_id": "ff4dfba5-e1a9-3f57-a722-9a324a82df5f",
                                "text": "„Schimpfduelle in Form von ritualisierten Schmähreden haben eine bestimmte Funktion.“"
                            },
                            {
                                "example_id": "a4180721-0fec-4597-95c5-0470bf8f7888",
                                "sense_id": "ff4dfba5-e1a9-3f57-a722-9a324a82df5f",
                                "text": "„Die Lachmuskeln werden besonders erfreut durch laute, sprachlich kreative Schimpfduelle, deren Gemeinheiten die beiden Darsteller immer mehr aufschaukeln und sie zu Höchstform auflaufen lassen. “"
                            },
                            {
                                "example_id": "25e7c387-0c0a-48d1-bd7f-86e88140dc22",
                                "sense_id": "ff4dfba5-e1a9-3f57-a722-9a324a82df5f",
                                "text": "„Dort liefern sich Abgeordnete Schimpfduelle, bei denen außer den gegenseitigen Aversionen kaum mehr erkenntlich ist, worum es überhaupt geht.“"
                            },
                            {
                                "example_id": "01ca009b-9fb8-489f-b4f5-628aa64e2386",
                                "sense_id": "ff4dfba5-e1a9-3f57-a722-9a324a82df5f",
                                "text": "„Wieder ein Eklat um Berlusconi: Diesmal rastete der 74-Jährige in einer TV Show aus und lieferte sich ein Schimpfduell mit dem Moderator.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
