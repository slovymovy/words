                                "example_id": "6343f029-cad8-45f2-8df0-bb79dec05a52",
                                "sense_id": "d11b1067-20a8-319b-9be4-d30f328de0a9",
                                "text": "Powodem ileusa u człowieka może być też bezoar."
                            }
