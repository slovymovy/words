{
    "word_family": [
        "postural"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "782ddbde-ffd7-3cc7-8283-1fc8a20ebe15",
                    "sense_definition": "The way a person holds and positions their body.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Good <w>posture</w> is important for preventing back pain while sitting at a desk.",
                            "target_lang_translations": {
                                "ru": "Хорошая <w>осанка</w> важна для предотвращения болей в спине во время сидения за столом."
                            }
                        },
                        {
                            "text": "She maintained a relaxed <w>posture</w> while waiting for the interview to begin.",
                            "target_lang_translations": {
                                "ru": "Она сохраняла расслабленную <w>позу</w>, ожидая начала собеседования."
                            }
                        }
                    ],
                    "synonyms": [
                        "stance",
                        "carriage"
                    ],
                    "common_phrases": [
                        "good posture",
                        "bad posture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привычное положение тела человека, манера держать фигуру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оса́нка",
                                "target_lang_sense_clarification": "Относится к привычному вертикальному положению тела."
                            },
                            {
                                "target_lang_word": "по́за",
                                "target_lang_sense_clarification": "Относится к конкретному положению тела в данный момент."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17b5dfb5-28eb-33a0-89be-333054511140",
                    "sense_definition": "The physical position or arrangement of someone or something relative to others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers moved into a defensive <w>posture</w> to protect the perimeter.",
                            "target_lang_translations": {
                                "ru": "Солдаты заняли оборонительную <w>позицию</w>, чтобы защитить периметр."
                            }
                        },
                        {
                            "text": "The equipment was arranged in a specific <w>posture</w> to maximize efficiency.",
                            "target_lang_translations": {
                                "ru": "Оборудование было расставлено в определенном <w>порядке</w> для максимальной эффективности."
                            }
                        }
                    ],
                    "synonyms": [
                        "position",
                        "arrangement"
                    ],
                    "common_phrases": [
                        "defensive posture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое расположение или расстановка кого-либо или чего-либо относительно других объектов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пози́ция",
                                "target_lang_sense_clarification": "Общее расположение или местоположение."
                            },
                            {
                                "target_lang_word": "расположе́ние",
                                "target_lang_sense_clarification": "Порядок или схема размещения объектов."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cab84282-c09d-3a51-ac6b-8edf84faf0a1",
                    "sense_definition": "A particular attitude or approach taken towards an issue or person.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government adopted a firm <w>posture</w> regarding the new trade regulations.",
                            "target_lang_translations": {
                                "ru": "Правительство заняло твердую <w>позицию</w> в отношении новых торговых правил."
                            }
                        },
                        {
                            "text": "His aggressive <w>posture</w> during the debate made it difficult to reach a compromise.",
                            "target_lang_translations": {
                                "ru": "Его агрессивный <w>настрой</w> во время дебатов затруднил достижение компромисса."
                            }
                        }
                    ],
                    "synonyms": [
                        "stance",
                        "attitude"
                    ],
                    "common_phrases": [
                        "firm posture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенное отношение или подход к какому-либо вопросу или человеку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пози́ция",
                                "target_lang_sense_clarification": "Точка зрения или подход к проблеме."
                            },
                            {
                                "target_lang_word": "отноше́ние",
                                "target_lang_sense_clarification": "Взгляд или подход к ситуации."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed3c4031-b913-316b-90e9-3a4a659f0f60",
                    "sense_definition": "A specific situation or state of affairs.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company had to adapt to the new <w>posture</w> of the global market.",
                            "target_lang_translations": {
                                "ru": "Компании пришлось адаптироваться к новой <w>ситуации</w> на мировом рынке."
                            }
                        },
                        {
                            "text": "The current <w>posture</w> of the negotiations suggests a long delay.",
                            "target_lang_translations": {
                                "ru": "Текущее <w>положение</w> дел на переговорах предполагает долгую задержку."
                            }
                        }
                    ],
                    "synonyms": [
                        "situation",
                        "condition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная ситуация или состояние дел."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ситуа́ция",
                                "target_lang_sense_clarification": "Общее положение дел."
                            },
                            {
                                "target_lang_word": "положе́ние",
                                "target_lang_sense_clarification": "Текущее состояние дел или обстоятельств."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d10424d3-24b5-3dcb-b23e-5151b84373a7",
                    "sense_definition": "To hold one's body in a specific way to attract attention or appear impressive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the whole party <w>posturing</w> to impress the guests.",
                            "target_lang_translations": {
                                "ru": "Он весь вечер <w>рисовался</w>, чтобы произвести впечатление на гостей."
                            }
                        },
                        {
                            "text": "Stop <w>posturing</w> and just act like yourself.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>позёрствовать</w> и просто будь собой."
                            }
                        }
                    ],
                    "synonyms": [
                        "pose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать определенную позу, чтобы привлечь внимание или казаться значительнее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рисоваться",
                                "target_lang_sense_clarification": "Вести себя неестественно, чтобы произвести впечатление."
                            },
                            {
                                "target_lang_word": "принимать позу",
                                "target_lang_sense_clarification": "Демонстративно менять положение тела."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2bc29fe-3098-35ff-ab1a-db20a9607814",
                    "sense_definition": "To pretend to have an opinion or conviction for effect.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politicians are just <w>posturing</w> for the media instead of solving problems.",
                            "target_lang_translations": {
                                "ru": "Политики просто <w>играют на публику</w> перед СМИ, вместо того чтобы решать проблемы."
                            }
                        },
                        {
                            "text": "It is clear that their public outrage is merely political <w>posturing</w>.",
                            "target_lang_translations": {
                                "ru": "Ясно, что их публичное возмущение — это лишь политическое <w>позёрство</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pretend",
                        "feign"
                    ],
                    "common_phrases": [
                        "political posturing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Притворяться, что имеешь определенное мнение или убеждение ради эффекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лицеме́рить",
                                "target_lang_sense_clarification": "Притворяться, скрывая истинные намерения."
                            },
                            {
                                "target_lang_word": "заниматься позёрством",
                                "target_lang_sense_clarification": "Демонстративное, неискреннее поведение."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84a95f36-3109-3786-947f-85296e45b6c1",
                    "sense_definition": "To place someone or something in a specific position.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist <w>postured</w> the mannequin to look like a dancer.",
                            "target_lang_translations": {
                                "ru": "Художник <w>придал</w> манекену <w>позу</w> танцора."
                            }
                        },
                        {
                            "text": "She carefully <w>postured</w> the model for the photograph.",
                            "target_lang_translations": {
                                "ru": "Она тщательно <w>расположила</w> модель для фотографии."
                            }
                        }
                    ],
                    "synonyms": [
                        "pose",
                        "position"
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать кому-либо или чему-либо определенное положение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "располага́ть",
                                "target_lang_sense_clarification": "Размещать в пространстве."
                            },
                            {
                                "target_lang_word": "придава́ть по́зу",
                                "target_lang_sense_clarification": "Устанавливать в определенное положение."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}