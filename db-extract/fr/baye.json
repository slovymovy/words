            {
                "entry_id": "3f1f63d2-1fd4-3f2f-b9af-a83b525878ca",
                "word": "baye",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9b7dfadb-32e4-3020-9ccb-f751733899d7",
                        "entry_id": "3f1f63d2-1fd4-3f2f-b9af-a83b525878ca",
                        "glosses": [
                            "Autre orthographe de baille (au sens de mer, eau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e16eb397-eab2-461d-9cdf-1abf4e065c95",
                                "sense_id": "9b7dfadb-32e4-3020-9ccb-f751733899d7",
                                "text": "Toute une époque, après t’avais le droit d’aller à la baye, c’était comme ça qu’on apprenait…"
                            },
                            {
                                "example_id": "6561ee33-252d-43a0-9861-e77e05ccdd32",
                                "sense_id": "9b7dfadb-32e4-3020-9ccb-f751733899d7",
                                "text": "Moi, les meufs, c'est des pages qui se tournent l’une après l’autre. J’irais me foutre à la baye pour aucune d’entre elles, ça non !"
                            },
                            {
                                "example_id": "4078730c-b841-4a6d-a4fe-556a19b82b83",
                                "sense_id": "9b7dfadb-32e4-3020-9ccb-f751733899d7",
                                "text": "3 sentiers pédagogiques (côté étang de Vaux) et quantité d’activités nautiques pour « se mettre à la Baye » de mars à octobre (base nautique Activital ; 03-86-38-97-39 ; activital.net ) : voile, canoë-kayak, planche à voile, et même du stand-up paddle."
                            }
                        ]
                    }
                ],
