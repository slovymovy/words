                    {
                        "form_id": "43391133-28c3-4da8-baf4-fa948e9b6b12",
                        "entry_id": "8431bd4c-710d-30f0-923a-b39805e131ba",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Schwarzmarkt"
                    },
                    {
                        "form_id": "891f828e-d2d0-4f7a-a14c-8340690923ba",
                        "entry_id": "8431bd4c-710d-30f0-923a-b39805e131ba",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schwarzmärkte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "728e1f08-b40f-31a5-89c2-451e1dcfec4a",
                        "entry_id": "8431bd4c-710d-30f0-923a-b39805e131ba",
                        "glosses": [
                            "illegaler Markt, auf welchem knappe, vom Staat preislich fixierte oder durch Umgehung von Steuern und Ähnlichem teilweise erheblich vergünstigte Waren gehandelt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "528aaa61-1fc7-4d2d-9157-7e4d7a3af7ff",
                                "sense_id": "728e1f08-b40f-31a5-89c2-451e1dcfec4a",
                                "text": "Er wurde beschuldigt, seine Kleider vom Schwarzmarkt zu beziehen."
                            },
                            {
                                "example_id": "292cd862-933f-46ed-877d-e97c0c1d861d",
                                "sense_id": "728e1f08-b40f-31a5-89c2-451e1dcfec4a",
                                "text": "„Auf dem Schwarzmarkt für Lebensmittel wollten die Straßenverkäufer verständlicherweise nicht vor der Kamera posieren.“"
                            },
                            {
                                "example_id": "5ca8603b-e512-4b2f-b74c-236541612fe9",
                                "sense_id": "728e1f08-b40f-31a5-89c2-451e1dcfec4a",
                                "text": "„Vor allem die Vertriebenen sahen sich, kaum in den einzelnen Besatzungszonen Deutschlands angekommen, mit einer Vielzahl neuer Probleme konfrontiert: Wohnraum, Hausrat, Kleidung, Wäsche mussten beschafft werden, meist auf dem Schwarzmarkt.“"
                            },
                            {
                                "example_id": "1e80f7bf-8472-4263-a6cb-b6d72d4abfe0",
                                "sense_id": "728e1f08-b40f-31a5-89c2-451e1dcfec4a",
                                "text": "„Da sind zunächst die Soldaten und Offiziere, die sich mit Gebrauchsgegenständen eindecken, die sie später auf dem sowjetischen Schwarzmarkt tauschen oder zu Geld machen wollen.“"
                            },
                            {
                                "example_id": "3afe0c24-f24a-4ae3-8fe9-de56cb1dd520",
                                "sense_id": "728e1f08-b40f-31a5-89c2-451e1dcfec4a",
                                "text": "„Zwar waren die Behörden verpflichtet, die beschlagnahmten Vorräte zu bezahlen; zugrunde gelegt wurden dafür jedoch die amtlich festgelegten Höchstpreise - wesentlich weniger, als auf dem Schwarzmarkt zu erzielen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee9a8d46-1e9e-4b9f-9c84-b492235f6def",
                        "source_entry_id": "8431bd4c-710d-30f0-923a-b39805e131ba",
                        "source_sense_id": "728e1f08-b40f-31a5-89c2-451e1dcfec4a",
                        "target_lang_word": "black market",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "black market",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d007a19-950e-328e-b55a-5489f42a0495",
                                        "entry_id": "dd431adc-b18e-304e-83a1-0c19ca1649d9",
                                        "glosses": [
                                            "Trade that is in violation of restrictions, rationing, or price controls."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c43510cd-a207-4be0-86f0-d453339fb810",
                                                "sense_id": "3d007a19-950e-328e-b55a-5489f42a0495",
                                                "text": "Peace and order will not be tolerated. Start saving your cash for the black market, folks, you're gonna need it."
                                            },
                                            {
                                                "example_id": "1d4372f5-878f-494d-9203-050fd58d024e",
                                                "sense_id": "3d007a19-950e-328e-b55a-5489f42a0495",
                                                "text": "In District 12, a dirt-poor coal-mining community that looks like a Dorothea Lange photograph, Katniss Everdeen (Jennifer Lawrence) quietly rebels against the system by hunting game in a forbidden area with her friend Gale (Liam Hemsworth) and trading it on the black market."
                                            },
                                            {
                                                "example_id": "59bb1493-b4bb-43a0-aee6-b1c218558779",
                                                "sense_id": "3d007a19-950e-328e-b55a-5489f42a0495",
                                                "text": "Increasing numbers of people are turning to a growing black market for food to supplement their diets as prices rocket, experts have said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "510dae27-8dd6-3094-8e73-c21b89049225",
                                        "entry_id": "dd431adc-b18e-304e-83a1-0c19ca1649d9",
                                        "glosses": [
                                            "The people who engage in such trade, or that sector of the economy."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61fb8441-8f18-4a10-9e1b-3d158cfb37a3",
                                                "sense_id": "510dae27-8dd6-3094-8e73-c21b89049225",
                                                "text": "associational black market"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f917beec-6481-4284-b672-f4bb2956805c",
                        "source_entry_id": "8431bd4c-710d-30f0-923a-b39805e131ba",
                        "source_sense_id": "728e1f08-b40f-31a5-89c2-451e1dcfec4a",
                        "target_lang_word": "marché noir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marché noir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b67f486-3dba-32bd-b0a9-06460cc88770",
                                        "entry_id": "a1da520c-bb46-34db-b67c-604f476a17e6",
                                        "glosses": [
                                            "Marché non officiel, dans le cas de ventes réglementées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e640b36f-59aa-42c5-9b8d-b4b8881b9a83",
                                                "sense_id": "0b67f486-3dba-32bd-b0a9-06460cc88770",
                                                "text": "Paris m’a paru atroce, vautré dans l’occupation, le marché noir, adapté, bouffi de mauvais graisse, toute honte bue…"
                                            },
                                            {
                                                "example_id": "76568917-1e1c-4690-a65f-d850d80b2f1f",
                                                "sense_id": "0b67f486-3dba-32bd-b0a9-06460cc88770",
                                                "text": "Dès les premiers jours de septembre, c’était à coups de cinquante sens le verre de sucre calciné dilué à l’eau et mis dans des bidons de fer qu’avait commencé le marché noir sous le pont de la voie ferrée à Sannomiya."
                                            },
                                            {
                                                "example_id": "932056a2-d866-43b5-b473-d9ed6de5c289",
                                                "sense_id": "0b67f486-3dba-32bd-b0a9-06460cc88770",
                                                "text": "Catholique ardente, Madame Lemonnier allait régulièrement à la messe prier la Sainte Vierge de l’aider dans ses petits trafics, marché noir à la petite semaine, trocs, échanges de services."
                                            },
                                            {
                                                "example_id": "f77d8306-83b3-45f1-ae75-b636f3883d3a",
                                                "sense_id": "0b67f486-3dba-32bd-b0a9-06460cc88770",
                                                "text": "— À mon avis, la cybermonnaie s'est transformée en une gigantesque opération d'infiltration pour permettre aux autorités de recueillir des renseignements sur le marché noir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
