        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bbf28b54-b4de-3fce-88dc-30d327f387df",
                    "sense_definition": "The mouth, often used in a rude or informal way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mouth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry man shouted at his friend to shut his <w>maw</w>.",
                            "target_lang_translations": {
                                "de": "Der wütende Mann schrie seinen Freund an, er solle sein <w>Maul</w> halten."
                            }
                        },
                        {
                            "text": "She fumbled with her bag and produced a handkerchief from its little <w>maw</w>.",
                            "target_lang_translations": {
                                "de": "Sie kramte in ihrer Tasche und holte ein Taschentuch aus deren kleinem <w>Schlund</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "trap",
                        "yap"
                    ],
                    "common_phrases": [
                        "shut your maw"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in a derogatory or informal manner."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Der Mund, oft abwertend oder umgangssprachlich verwendet."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Maul",
                                "target_lang_sense_clarification": "Umgangssprachlich für Mund, oft abwertend."
                            },
                            {
                                "target_lang_word": "Fresse",
                                "target_lang_sense_clarification": "Sehr derb, beleidigend für Mund."
                            }
                        ]
