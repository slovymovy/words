                                        "entry_id": "4f58ebc5-d0a4-33cc-8b72-ed187a1d7207",
                                        "glosses": [
                                            "Cuisson des œufs, bouillis dans leur coquille, où le jaune reste liquide tandis que le blanc est solide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "043def7b-4ca3-4b56-accb-2f7d3e052db9",
                                                "sense_id": "fe001872-f2ae-3dd1-9ccf-8af2ad56fc1e",
                                                "text": "Son Excellence le général Kokodryoff ne peut recevoir en ce moment. Il trempe sa mouillette dans son œuf à la coque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
