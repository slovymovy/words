                },
                {
                    "sense_id": "a941a0fa-6759-383f-ae7f-281edbea2876",
                    "sense_definition": "Naïveté excessive conduisant à croire trop facilement autrui.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "naivete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par pure <w>simplicité</w>, elle a fait confiance à un démarcheur malintentionné."
