                            {
                                "target_word": "молодец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "873618ed-100b-3795-8395-80867e7ada26",
                                        "entry_id": "9a53f29b-8198-32bc-9114-4f37ef8537a1",
                                        "glosses": [
                                            "разг. употребляется при выражении похвалы, одобрения по отношению к человеку, обладающему какими-либо положительными качествами, делающему что-либо отлично, умело, ловко"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fd18a1c-27a5-4133-9ca5-2b67c9a0b52b",
                                                "sense_id": "873618ed-100b-3795-8395-80867e7ada26",
                                                "text": "Он немедленно тормозит. Реакция хорошая, молоде́ц."
                                            },
                                            {
                                                "example_id": "61745002-047d-4923-86b3-61d99e77daeb",
                                                "sense_id": "873618ed-100b-3795-8395-80867e7ada26",
                                                "text": "— А молодцы́ наши девчонки, правда? — сказал Командор."
                                            },
                                            {
                                                "example_id": "04b200fd-ea7c-4e90-ba22-08cf60ab603f",
                                                "sense_id": "873618ed-100b-3795-8395-80867e7ada26",
                                                "text": "— Вот и молоде́ц, вот и умница, — приговаривал старик."
                                            }
                                        ]
                                    }
                                ]
                            }
