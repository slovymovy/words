                {
                    "sense_id": "18709705-eb98-333d-9218-d957a4b630fd",
                    "sense_definition": "Совокупность сведений, фактов или цифр, служащих основанием для выводов и решений.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эти <данные> были получены в ходе научного эксперимента.",
                            "target_lang_translations": {
                                "en": "These <w>data</w> were obtained during a scientific experiment.",
                                "zh": "这些<w>数据</w>是在科学实验过程中获得的。"
                            }
                        },
                        {
                            "text": "Нам нужны точные <данные> для завершения годового отчёта.",
                            "target_lang_translations": {
                                "en": "We need accurate <w>data</w> to complete the annual report.",
                                "zh": "我们需要准确的<w>数据</w>来完成年度报告。"
                            }
                        }
                    ],
                    "synonyms": [
                        "информация",
                        "сведения"
                    ],
                    "common_phrases": [
                        "сбор данных",
                        "анализ данных",
                        "полученные данные"
                    ],
                    "target_lang_definitions": {
                        "en": "A collection of information, facts, or figures serving as a basis for conclusions and decisions.",
                        "zh": "作为结论和决策依据的一组信息、事实或数字。"
                    },
