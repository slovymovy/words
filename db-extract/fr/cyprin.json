                        "glosses": [
                            "Qui ressemble à la carpe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33f47003-6675-4f68-aaf5-e9bd788c76ad",
                                "sense_id": "9ce9e134-c2fb-3904-8988-bd6e82409268",
                                "text": "Puis, nous pêcherons des poissons cyprins et nous ramasserons des cailloux polis comme des agates !"
