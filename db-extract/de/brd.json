                        "sense_id": "c06d37b5-bbf3-3f64-98fe-fa5e10a0f7d6",
                        "entry_id": "459c2c86-4eda-3533-981d-aa3020162e7d",
                        "glosses": [
                            "Bundesrepublik Deutschland (ab 1990, als vereinigtes Deutschland)"
                        ],
                        "tags": [
                            "nicht amtlich"
                        ],
                        "examples": [
                            {
                                "example_id": "f1a13851-324f-4782-afa7-296b4d455d1b",
                                "sense_id": "c06d37b5-bbf3-3f64-98fe-fa5e10a0f7d6",
                                "text": "Die BRD ist ein europäischer Staat."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f9a75240-dab7-3c17-acf3-9419ed831aa7",
                        "entry_id": "459c2c86-4eda-3533-981d-aa3020162e7d",
                        "glosses": [
                            "Bundesrepublik Deutschland (1949–1990, als Westdeutschland)"
                        ],
                        "tags": [
                            "nicht amtlich"
                        ],
                        "examples": [
                            {
                                "example_id": "e16a8a48-965f-46fb-a775-6026b3b889c6",
                                "sense_id": "f9a75240-dab7-3c17-acf3-9419ed831aa7",
                                "text": "Die Beziehungen zwischen der BRD und der DDR waren fast immer schlecht."
                            },
                            {
                                "example_id": "917b0bd0-1e4c-42cc-8624-8db873d35ec9",
                                "sense_id": "f9a75240-dab7-3c17-acf3-9419ed831aa7",
                                "text": "„Die in der BRD stationierten GIs brachten den New-Orleans-Sound nach München.“"
                            },
                            {
                                "example_id": "9bb3a620-bbc2-47ad-9974-aeccb3cea897",
                                "sense_id": "f9a75240-dab7-3c17-acf3-9419ed831aa7",
                                "text": "„Erst später konnte unser Präsident sich eingestehen, dass der Einigungsprozess zwischen DDR und BRD nicht mehr aufgehalten werden konnte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
