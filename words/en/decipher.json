{
    "word_family": [
        "decipherable",
        "decipherment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4b7f752-1e66-337d-b317-504bc3619128",
                    "sense_definition": "To convert a code or cipher into plain text",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "understanding_hidden_meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intelligence agency worked all night to <w>decipher</w> the secret message.",
                            "target_lang_translations": {
                                "ru": "Спецслужба работала всю ночь, чтобы <w>расшифровать</w> секретное сообщение."
                            }
                        },
                        {
                            "text": "It took several hours for the computer to <w>decipher</w> the encrypted file.",
                            "target_lang_translations": {
                                "ru": "Компьютеру потребовалось несколько часов, чтобы <w>расшифровать</w> зашифрованный файл."
                            }
                        }
                    ],
                    "synonyms": [
                        "decode",
                        "decrypt"
                    ],
                    "antonyms": [
                        "encode",
                        "encrypt"
                    ],
                    "common_phrases": [
                        "decipher a code",
                        "decipher a message"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переводить зашифрованный текст или код в обычный, понятный вид"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расшифровывать",
                                "target_lang_sense_clarification": "код или шифр (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "расшифровать",
                                "target_lang_sense_clarification": "код или шифр (совершенный вид)"
                            },
                            {
                                "target_lang_word": "декодировать",
                                "target_lang_sense_clarification": "переводить из кода в понятный вид"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a30fcf5e-a5a3-3f07-a32f-15285da372e0",
                    "sense_definition": "To read text that is difficult to understand because it is messy or unclear",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "understanding_hidden_meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could barely <w>decipher</w> the doctor's messy handwriting on the prescription.",
                            "target_lang_translations": {
                                "ru": "Я едва мог <w>разобрать</w> небрежный почерк врача на рецепте."
                            }
                        },
                        {
                            "text": "The old map was so faded that it was nearly impossible to <w>decipher</w> the names of the towns.",
                            "target_lang_translations": {
                                "ru": "Старая карта настолько выцвела, что было почти невозможно <w>разобрать</w> названия городов."
                            }
                        }
                    ],
                    "synonyms": [
                        "make out"
                    ],
                    "common_phrases": [
                        "decipher handwriting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочитывать текст, который трудно разобрать из-за неразборчивого почерка или стёртости"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбирать",
                                "target_lang_sense_clarification": "неразборчивый почерк или надпись (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "разобрать",
                                "target_lang_sense_clarification": "неразборчивый почерк или надпись (совершенный вид)"
                            },
                            {
                                "target_lang_word": "расшифровывать",
                                "target_lang_sense_clarification": "неразборчивые записи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e8947fb-a268-3f10-b781-fecf2aee9258",
                    "sense_definition": "To understand or interpret a complex or confusing situation",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "understanding_hidden_meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was difficult to <w>decipher</w> his true intentions during the meeting.",
                            "target_lang_translations": {
                                "ru": "Во время встречи было трудно <w>понять</w> его истинные намерения."
                            }
                        },
                        {
                            "text": "Experts are still trying to <w>decipher</w> the meaning behind the recent economic changes.",
                            "target_lang_translations": {
                                "ru": "Эксперты всё ещё пытаются <w>истолковать</w> смысл недавних экономических изменений."
                            }
                        }
                    ],
                    "synonyms": [
                        "interpret"
                    ],
                    "target_lang_definitions": {
                        "ru": "Понимать или истолковывать сложную, запутанную ситуацию либо скрытый смысл"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истолковывать",
                                "target_lang_sense_clarification": "понимать смысл или подтекст"
                            },
                            {
                                "target_lang_word": "расшифровывать",
                                "target_lang_sense_clarification": "разгадывать скрытый смысл"
                            },
                            {
                                "target_lang_word": "понимать",
                                "target_lang_sense_clarification": "уяснять сложную ситуацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "578a8077-bd38-33ec-9f4a-6bd6e5d3d04e",
                    "sense_definition": "To find a solution to a difficult problem",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "understanding_hidden_meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists hope to <w>decipher</w> the mystery of how the virus spreads.",
                            "target_lang_translations": {
                                "ru": "Учёные надеются <w>разгадать</w> тайну того, как распространяется вирус."
                            }
                        },
                        {
                            "text": "We need more data before we can <w>decipher</w> the cause of this technical failure.",
                            "target_lang_translations": {
                                "ru": "Нам нужно больше данных, прежде чем мы сможем <w>раскрыть</w> причину этого технического сбоя."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находить разгадку сложной проблемы или тайны"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгадывать",
                                "target_lang_sense_clarification": "тайну или загадку (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "разгадать",
                                "target_lang_sense_clarification": "тайну или загадку (совершенный вид)"
                            },
                            {
                                "target_lang_word": "раскрывать",
                                "target_lang_sense_clarification": "причину или тайну"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "27efc348-eb7a-32db-aed0-4e18fb254a82",
                    "sense_definition": "The act of deciphering or decoding something",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "understanding_hidden_meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>decipher</w> of the ancient scroll provided new insights into the civilization.",
                            "target_lang_translations": {
                                "ru": "<w>Расшифровка</w> древнего свитка позволила по-новому взглянуть на эту цивилизацию."
                            }
                        },
                        {
                            "text": "His <w>decipher</w> of the complex code was considered a major breakthrough.",
                            "target_lang_translations": {
                                "ru": "Его <w>дешифровка</w> сложного кода считалась крупным прорывом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This noun usage is rare and often considered archaic or formal."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по расшифровке, разгадыванию или прочтению чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дешифровка",
                                "target_lang_sense_clarification": "процесс расшифровки"
                            },
                            {
                                "target_lang_word": "расшифровка",
                                "target_lang_sense_clarification": "процесс или результат прочтения скрытого текста"
                            }
                        ]
                    }
                }
            ]
        }
    ]
