                    {
                        "translation_id": "a683e19a-728a-454a-8ca8-d8d11f3f5450",
                        "source_entry_id": "c6f56204-2eb6-30f6-84f4-cc7d67484c4b",
                        "source_sense_id": "6e1c7dc9-1db5-34bf-8ea2-739c3667cf3d",
