                            },
                            {
                                "target_lang_word": "uninhibited",
                                "target_lang_sense_clarification": "free and spontaneous, having no inhibitions"
                            },
                            {
                                "target_lang_word": "wild",
                                "target_lang_sense_clarification": "unrestrained, uninhibited, or passionate"
                            }
                        ]
