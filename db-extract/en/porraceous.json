                        "sense_id": "9a8d6466-81e4-3565-85a6-8e11f8d1490a",
                        "entry_id": "239b1729-14d0-322f-b850-5bc005eb6f1d",
                        "glosses": [
                            "Resembling the leek in colour; greenish."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccc70d1c-da49-4c14-8454-308cf76de919",
                                "sense_id": "9a8d6466-81e4-3565-85a6-8e11f8d1490a",
                                "text": "If the lesser Intestines be wounded, he will be troubled with poraceous Vomiting, and what he eats or drinks will pass out of his Wound in less than half an hour[.]"
                            },
                            {
                                "example_id": "079ace49-1799-4edb-aff8-097011d07082",
                                "sense_id": "9a8d6466-81e4-3565-85a6-8e11f8d1490a",
                                "text": "During the night she vomited porraceous matter."
                            },
                            {
                                "example_id": "5ae0f61c-4d55-4264-8577-b8572fe36176",
                                "sense_id": "9a8d6466-81e4-3565-85a6-8e11f8d1490a",
                                "text": "[B]ut [I] had to say that the \"foliage\" was \"emerald\" or indeed (I discovered this in a Victorian book of verse by a gentleman called Bradford) that the \"verdure\" was \"porraceous\"."
                            },
                            {
                                "example_id": "c64886ed-3544-41e8-9a6a-8cff3f04dc55",
                                "sense_id": "9a8d6466-81e4-3565-85a6-8e11f8d1490a",
                                "text": "My pignoration, see, is this smaragd, of porraceous hue. Bless my tripudiation, stellify my verses."
                            }
                        ]
                    }
                ],
