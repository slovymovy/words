                "senses": [
                    {
                        "sense_id": "e86e2bd4-e23f-34a3-b83d-ceba3dac9cfa",
                        "entry_id": "16ef4c30-69e5-303b-8756-eec7a47d77fd",
                        "glosses": [
                            "Musiker in einer großen Musikgruppe, die Musikinstrumente spielen und gemeinsam Musik machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7039d888-642d-4158-b475-6cb8664ed2d0",
                                "sense_id": "e86e2bd4-e23f-34a3-b83d-ceba3dac9cfa",
                                "text": "Die Staatskapelle spielt oftmals erhebende Musik auf Festlichkeit, Festakten, Konzerten oder in Verbindung mit anderen Vereinen werden Konzertabende veranstaltet."
                            },
                            {
                                "example_id": "7b5564a8-1369-4305-92af-53806ae62b91",
                                "sense_id": "e86e2bd4-e23f-34a3-b83d-ceba3dac9cfa",
                                "text": "„Die Staatskapelle Berlin gehört mit ihrer seit dem 16. Jahrhundert bestehenden Tradition zu den ältesten Orchestern der Welt.“"
                            },
                            {
                                "example_id": "90f46cf6-d9d2-49e5-a42c-354d755df69a",
                                "sense_id": "e86e2bd4-e23f-34a3-b83d-ceba3dac9cfa",
                                "text": "„Einer der ältesten Orchesterklangkörper der Welt kann im Jahr 2013 auf sein 450-jähriges Bestehen zurückblicken: die Mecklenburgische Staatskapelle Schwerin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
