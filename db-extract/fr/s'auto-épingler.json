                "senses": [
                    {
                        "sense_id": "61f542ec-952e-3331-9b9f-1b0e60c8b1ea",
                        "entry_id": "1c20f948-26e8-374d-91f7-8c18758f79a1",
                        "glosses": [
                            "S’épingler soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dfc8704-de71-4b26-9a73-b00eba9a4fc4",
                                "sense_id": "61f542ec-952e-3331-9b9f-1b0e60c8b1ea",
                                "text": "Sans nul doute pressée de démontrer aux internautes ses « terrifiantes » capacités d'investigation, la Haute Autorité est parvenue avec brio à s'auto-épingler comme un dangereux pirate sans foi ni loi, au terme d'une enquête « complexe et minutieuse » ; à moins qu'elle ne se soit tout simplement décidée à combattre le mal par le mal."
                            },
                            {
                                "example_id": "6cf08ef3-ec7a-44fa-9998-2df254216b2c",
                                "sense_id": "61f542ec-952e-3331-9b9f-1b0e60c8b1ea",
                                "text": "je décide de m'auto-épingler, pour avoir la certitude qu'il y a assez de tissu"
                            },
                            {
                                "example_id": "c4614f29-9a5c-4e96-aafc-39c2acb37a76",
                                "sense_id": "61f542ec-952e-3331-9b9f-1b0e60c8b1ea",
                                "text": "Collection d'image sacro-sainte, chapelet, bagues multicolores, elle s'auto-épingle dans un bonheur puant et abstrait..."
                            }
                        ]
                    }
