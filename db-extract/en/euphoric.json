                    {
                        "sense_id": "6f1fb706-7c0e-30eb-b14c-10f17fe27b86",
                        "entry_id": "c0866a89-c490-3d95-9e56-d2647ae45f5b",
                        "glosses": [
                            "狂喜的、亢奮的、異常亢奮的"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbc457ad-bcb2-47dd-9eea-e80f3a8834fa",
                                "sense_id": "6f1fb706-7c0e-30eb-b14c-10f17fe27b86",
                                "text": "In this moment, I am euphoric.",
                                "translation": "此時此刻，我亢奮到了極點。"
                            }
                        ]
                    },
                    {
                        "sense_id": "58dd72c9-0c5b-3fe7-a346-e90bf4021b50",
                        "entry_id": "c0866a89-c490-3d95-9e56-d2647ae45f5b",
                        "glosses": [
                            "能振作精神的"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "799452e9-1106-4c86-8be7-75aa27609a3b",
                                "sense_id": "58dd72c9-0c5b-3fe7-a346-e90bf4021b50",
                                "text": "Heroin is the most euphoric drug in use today.",
                                "translation": "海洛因目前在投入使用的藥品中最能振作精神。"
                            },
                            {
                                "example_id": "f2a3c74d-0e28-46af-8ad8-86e115d00ed0",
                                "sense_id": "58dd72c9-0c5b-3fe7-a346-e90bf4021b50",
                                "text": "Lin gathered herself, took a moment to rehearse the words in her mind, contacted the L.A. number, and delivered her euphoric news to her agent in person",
                                "translation": "琳集中了精神，花時間在腦海中反覆重複了語言，聯絡了洛杉磯的號碼，將振奮人心的消息親口講給了她的經紀人聽。"
                            }
                        ]
                    }
                ],
