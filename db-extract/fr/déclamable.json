                        "examples": [
                            {
                                "example_id": "1780defb-7519-4abb-958a-18220529d6fe",
                                "sense_id": "45bd1f57-a7a1-39aa-ae3a-2373a59c338f",
                                "text": "Un auteur anonyme de Catalogne composa une pièce en vers et en prose, « déclamable, chantable et dansable», qu’il intitula « Lo ball d’en Serralongua »."
                            },
                            {
                                "example_id": "0c877b33-c2af-4c7b-9eaa-1ab58f11c7eb",
                                "sense_id": "45bd1f57-a7a1-39aa-ae3a-2373a59c338f",
                                "text": "Quatre ou cinq ans plus tard, je compris que ce n’était ni dicible, ni déclamable, ni récitable. Ce texte « anormal » et intemporel ne se jouait point."
                            },
                            {
                                "example_id": "a7a3367f-9ab7-4756-b8a5-8c900414c136",
                                "sense_id": "45bd1f57-a7a1-39aa-ae3a-2373a59c338f",
                                "text": "C’est la réplique la plus difficile du théâtre de Molière et peut-être la plus difficile tout court. Ces cinq mots d’Agnès à Arnolphe (L’école des femmes, Acte III) sont déclamables sur des milliers de tons différents !"
                            }
                        ]
                    }
