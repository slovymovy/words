{
    "word_family": [
        "endow",
        "endowment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "929dccef-6761-3e35-99d4-22db95d8af3c",
                    "sense_definition": "Provided or furnished with a particular quality, ability, or asset.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>endowed</w> with a natural talent for music.",
                            "target_lang_translations": {
                                "nl": "Zij is <w>bedeeld met</w> een natuurlijk muzikaal talent."
                            }
                        },
                        {
                            "text": "The region is <w>endowed</w> with rich natural resources.",
                            "target_lang_translations": {
                                "nl": "De regio is <w>voorzien van</w> rijke natuurlijke hulpbronnen."
                            }
                        }
                    ],
                    "synonyms": [
                        "gifted",
                        "blessed",
                        "equipped"
                    ],
                    "common_phrases": [
                        "endowed with"
                    ],
                    "target_lang_definitions": {
                        "nl": "Voorzien van een bepaalde kwaliteit, talent of bezit."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "begaafd",
                                "target_lang_sense_clarification": "met betrekking tot talenten of vaardigheden"
                            },
                            {
                                "target_lang_word": "voorzien van",
                                "target_lang_sense_clarification": "algemene term voor het bezitten van eigenschappen of middelen"
                            },
                            {
                                "target_lang_word": "bedeeld met",
                                "target_lang_sense_clarification": "vaak gebruikt in de context van natuurlijke gaven of rijkdom"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57f11f6e-ca5e-3f6d-8394-e71581ea5c19",
                    "sense_definition": "Financially supported by a permanent fund or endowment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university created an <w>endowed</w> chair for the new professor.",
                            "target_lang_translations": {
                                "nl": "De universiteit creëerde een <w>gefinancierde</w> leerstoel voor de nieuwe professor."
                            }
                        },
                        {
                            "text": "Many private schools rely on <w>endowed</w> scholarships to support students.",
                            "target_lang_translations": {
                                "nl": "Veel privéscholen vertrouwen op <w>uit een fonds gefinancierde</w> beurzen om studenten te ondersteunen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "endowed chair",
                        "endowed scholarship"
                    ],
                    "target_lang_definitions": {
                        "nl": "Financieel ondersteund door een permanent fonds of schenking."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gefinancierd door een fonds",
                                "target_lang_sense_clarification": "met betrekking tot structurele financiële steun"
                            },
                            {
                                "target_lang_word": "met een eigen kapitaal",
                                "target_lang_sense_clarification": "verwijzend naar een leerstoel of beurs die uit een fonds wordt betaald"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e30d0d82-1575-3a61-ac72-a1560682324d",
                    "sense_definition": "Having large genitals.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor is known for being physically <w>endowed</w>.",
                            "target_lang_translations": {
                                "nl": "De acteur staat bekend om het feit dat hij <w>goed bedeeld</w> is."
                            }
                        },
                        {
                            "text": "He was described as being well <w>endowed</w> in the report.",
                            "target_lang_translations": {
                                "nl": "Hij werd in het rapport omschreven als <w>goed bedeeld</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used as a euphemism."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Gezegend met grote geslachtsdelen (eufemisme)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "goed bedeeld",
                                "target_lang_sense_clarification": "eufemistische uitdrukking voor fysieke lichaamsbouw"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "617b4b3b-7296-3f45-8714-4d7e1c0a919d",
                    "sense_definition": "Past tense and past participle of <w>endow</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philanthropist <w>endowed</w> the hospital with a large donation.",
                            "target_lang_translations": {
                                "nl": "De filantroop <w>schonk</w> het ziekenhuis een grote donatie."
                            }
                        },
                        {
                            "text": "The foundation has <w>endowed</w> several research projects this year.",
                            "target_lang_translations": {
                                "nl": "De stichting heeft dit jaar verschillende onderzoeksprojecten <w>gefinancierd</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb endow."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van 'schenken' of 'financieren'."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geschonken",
                                "target_lang_sense_clarification": "het geven van een kapitaal of donatie"
                            },
                            {
                                "target_lang_word": "gefinancierd",
                                "target_lang_sense_clarification": "het structureel ondersteunen van een project"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}