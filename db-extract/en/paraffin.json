                                        "glosses": [
                                            "хим. воскоподобное вещество, смесь предельных углеводородов (алканов) состава от С₁₈Н₃₈ до С₃₅Н₇₂"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
