                                "sense_id": "1f78af0f-7b93-3c54-a2b7-85a21d95857e",
                                "text": "Aristocrate de naissance, il haïssait par instinct quatre-vingt-treize: mais, philosophe par tempérament et libéral par éducation, il exécrait la tyrannie d'une haine inoffensive et déclamatoire."
                            },
                            {
                                "example_id": "6e8ca1dc-b787-4318-9b6c-e0c00399a329",
                                "sense_id": "1f78af0f-7b93-3c54-a2b7-85a21d95857e",
                                "text": "Le Drame de quatre-vingt-treize."
                            },
                            {
                                "example_id": "c853887f-1302-4e83-96e2-251240b59f9d",
                                "sense_id": "1f78af0f-7b93-3c54-a2b7-85a21d95857e",
                                "text": "Elle a eu son bac en quatre-vingt-treize."
                            }
