                    {
                        "translation_id": "3a3f89d8-56d7-4cae-944e-b8dca080f6a9",
                        "source_entry_id": "7a4263ed-e560-3470-bef0-70f63005b165",
                        "source_sense_description": "To crouch, squat or lie down",
                        "target_lang_word": "hocken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hocken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ec5fcbe-94a4-39e6-9c52-175902879923",
                                        "entry_id": "2a4f9c69-92d7-3211-99ab-fd2cbac49110",
                                        "glosses": [
                                            "mit stark angewinkelten Knien aufrecht sitzen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d242ff46-4f64-4fc6-96a1-508789c18a71",
                                                "sense_id": "3ec5fcbe-94a4-39e6-9c52-175902879923",
                                                "text": "\"»Alles Gerade lügt, murmelte verächtlich der Zwerg. Alle Wahrheit ist krumm, die Zeit selber ist ein Kreis.«",
                                                "translation": "»Du Geist der Schwere! sprach ich zürnend, mache dir es nicht zu leicht! Oder ich lasse dich hocken, wo du hockst, Lahmfuss, - und ich trug dich hoch! …\""
                                            },
                                            {
                                                "example_id": "4248f70d-9da4-4561-965a-904c0a2343c3",
                                                "sense_id": "3ec5fcbe-94a4-39e6-9c52-175902879923",
                                                "text": "„Der Besuch unter Tage ist begehrt – jeden Tag fahren zwei Besuchergruppen ein –, doch auf Dauer muss es anstrengend sein, im Streb zu hocken: arg für den Rücken und die Knie, dazu die Düsterkeit, der Lärm.“"
                                            },
                                            {
                                                "example_id": "c0834fea-61b8-4797-a622-fd41806fba1f",
                                                "sense_id": "3ec5fcbe-94a4-39e6-9c52-175902879923",
                                                "text": "„Während man jedoch beim Segelfliegen in einem kleinen Cockpit hockt, beim Gleitschirmfliegen in einem Sitz schaukelt, hängt der Drachenflieger unter der Tragfläche, Kopf voraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ef6d4a35-1f96-3394-a74a-fe0cba64028b",
                                        "entry_id": "2a4f9c69-92d7-3211-99ab-fd2cbac49110",
                                        "glosses": [
                                            "sich setzen"
                                        ],
                                        "tags": [
                                            "South-German",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57834e51-c00a-4519-8306-1c56b87f578c",
                                                "sense_id": "ef6d4a35-1f96-3394-a74a-fe0cba64028b",
                                                "text": "„Während man jedoch beim Segelfliegen in einem kleinen Cockpit hockt, beim Gleitschirmfliegen in einem Sitz schaukelt, hängt der Drachenflieger unter der Tragfläche, Kopf voraus.“"
                                            },
                                            {
                                                "example_id": "e1a9a103-0251-47c2-9bc1-33c34c6ca39d",
                                                "sense_id": "ef6d4a35-1f96-3394-a74a-fe0cba64028b",
                                                "text": "Du kannst dich ruhig auf den Schemel hocken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b536d5b6-f7af-3655-8d4e-ee389d57cd99",
                                        "entry_id": "2a4f9c69-92d7-3211-99ab-fd2cbac49110",
                                        "glosses": [
                                            "längere Zeit immer nur an ein und demselben Ort bleiben"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "South-German",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03e22e45-64de-4f2a-942c-671c2c020e90",
                                                "sense_id": "b536d5b6-f7af-3655-8d4e-ee389d57cd99",
                                                "text": "Er hockt stundenlang vor dem Fernseher."
                                            },
                                            {
                                                "example_id": "be4900bb-fe22-4068-badf-1933698b3817",
                                                "sense_id": "b536d5b6-f7af-3655-8d4e-ee389d57cd99",
                                                "text": "Meine Mutter erzählte, wie sie [im Krieg] im Keller hocken mussten und froren, während die Bomben detonierten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9008e6f3-8905-4e93-89a4-71b03fb9bdac",
                        "source_entry_id": "7a4263ed-e560-3470-bef0-70f63005b165",
