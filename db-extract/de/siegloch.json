                "senses": [
                    {
                        "sense_id": "c538bfac-9cd4-3224-8b60-123449128dbb",
                        "entry_id": "eff6458d-bbda-3caa-9451-d8567cc442a8",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd31ccc2-64d2-4597-90d3-629f7500ee50",
                                "sense_id": "c538bfac-9cd4-3224-8b60-123449128dbb",
                                "text": "Der Siegloch trägt nie die Schals, die die Siegloch ihm strickt."
                            },
                            {
                                "example_id": "26aec113-59bf-451b-831e-b242cb983beb",
                                "sense_id": "c538bfac-9cd4-3224-8b60-123449128dbb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Siegloch kommt, geht der Herr Siegloch.“"
                            },
                            {
                                "example_id": "c7e352ed-c0b1-493a-8ab2-b247fb61112f",
                                "sense_id": "c538bfac-9cd4-3224-8b60-123449128dbb",
                                "text": "Siegloch kommt und geht."
                            },
                            {
                                "example_id": "8d4b9d57-fb0b-45a4-81dc-3e11c3d355ff",
                                "sense_id": "c538bfac-9cd4-3224-8b60-123449128dbb",
                                "text": "Sieglochs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "dafd415c-867a-4bf3-9a7e-5ae3090bf372",
                                "sense_id": "c538bfac-9cd4-3224-8b60-123449128dbb",
                                "text": "Die Sieglochs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9472eacb-da3a-46cd-9327-9b2e3d4b0c68",
                                "sense_id": "c538bfac-9cd4-3224-8b60-123449128dbb",
                                "text": "Frau Siegloch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "522c3f27-8afd-4eb9-8a2b-9755c3af5a32",
                                "sense_id": "c538bfac-9cd4-3224-8b60-123449128dbb",
                                "text": "Herr Siegloch wollte uns kein Interview geben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
