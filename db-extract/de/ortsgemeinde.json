                "senses": [
                    {
                        "sense_id": "599ce3fd-d0a4-37f3-9cb8-6346b5a8db7e",
                        "entry_id": "944c2015-e5d0-30d9-9ce8-d9eb73ce58ff",
                        "glosses": [
                            "Bezeichnung für verschiedene Formen von Verwaltungseinheiten auf lokaler Ebene"
                        ],
                        "tags": [
                            "Kommunalpolitik"
                        ],
                        "examples": [
                            {
                                "example_id": "9abccb3e-f961-4ee6-b7d1-8b3ac5bf0e39",
                                "sense_id": "599ce3fd-d0a4-37f3-9cb8-6346b5a8db7e",
                                "text": "„Als Ortsgemeinde wird in Rheinland-Pfalz eine rechtlich eigenständige Gemeinde mit oder ohne Stadtrecht bezeichnet, die einer Verbandsgemeinde als Verwaltungseinheit angehört.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d8e484ea-90a2-3942-b9b1-7b31c42abb5e",
                        "entry_id": "944c2015-e5d0-30d9-9ce8-d9eb73ce58ff",
                        "glosses": [
                            "die Kirchengemeinde vor Ort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4924b8c-5de3-4686-b120-4068497ee104",
                                "sense_id": "d8e484ea-90a2-3942-b9b1-7b31c42abb5e",
                                "text": "„Eine Ortsgemeinde ist eine Gruppe von Christen, die sich regelmäßig im Namen Jesu versammelt, um sich gegenseitig durch Predigt und Gnadenmittel (Taufe und Abendmahl) die Zugehörigkeit zu Jesus Christus und seinem Reich nach außen hin sichtbar zu bestätigen und zu beaufsichtigen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
