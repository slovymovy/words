{
    "word": "whee",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d2878c3c-1492-3dda-9310-c5d4b1c2cdf8",
                "word": "whee",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bdbdc0e3-34a0-3b8f-8360-00f008c26272",
                        "entry_id": "d2878c3c-1492-3dda-9310-c5d4b1c2cdf8",
                        "glosses": [
                            "An expression of pleasure or enjoyment, mostly from rapid physical motion."
                        ],
                        "tags": [
                            "childish"
                        ],
                        "examples": [
                            {
                                "example_id": "994be368-35a9-44c6-b04a-e97ac35a59cc",
                                "sense_id": "bdbdc0e3-34a0-3b8f-8360-00f008c26272",
                                "text": "Up came the revs again, slam the door shut, kick the stick off the throttle and up through the gears, down the others side! Whee! Made it again!"
                            },
                            {
                                "example_id": "8e8030f9-b57c-42a4-9590-5a651803f49a",
                                "sense_id": "bdbdc0e3-34a0-3b8f-8360-00f008c26272",
                                "text": "She twisted the rubber band extra tight. Sure enough, the tractor spun off much faster. Whee! She really liked to see it go fast on the living room floor."
                            },
                            {
                                "example_id": "55a99014-9333-413c-add0-e4319ac82cda",
                                "sense_id": "bdbdc0e3-34a0-3b8f-8360-00f008c26272",
                                "text": "It'll be a secret! Whee!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4ecbba7-2b69-483c-a29d-bf0f8eb8fad2",
                        "source_entry_id": "d2878c3c-1492-3dda-9310-c5d4b1c2cdf8",
                        "source_sense_id": "bdbdc0e3-34a0-3b8f-8360-00f008c26272",
                        "source_sense_description": "expression of pleasure or enjoyment",
                        "target_lang_word": "ouais",
                        "target_lang_code": "fr",
                        "note": "with the i repeated as often as desired",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b0b7906-2543-3ba0-9560-00327f3976c4",
                                        "entry_id": "23d4e6af-b86a-3037-9c66-f7fc3e5c79f4",
                                        "glosses": [
                                            "Oui ; marque une réponse affirmative."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b48739ea-dfea-4881-a300-c0bc80c77130",
                                                "sense_id": "5b0b7906-2543-3ba0-9560-00327f3976c4",
                                                "text": "— T’as eu ton bac alors ?\n — Ouais, tranquille."
                                            },
                                            {
                                                "example_id": "af8d7518-1b11-4d43-9a10-914cc71ec0dd",
                                                "sense_id": "5b0b7906-2543-3ba0-9560-00327f3976c4",
                                                "text": "Ouais, pas si mal, se dit-il, campé debout tout en regardant le résultat, les mains sur les hanches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98a602a1-a028-38c8-bc8e-b25fba541e51",
                                        "entry_id": "23d4e6af-b86a-3037-9c66-f7fc3e5c79f4",
                                        "glosses": [
                                            "Marque l’assentiment."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a877e49-d387-4543-aeb4-6ec376634877",
                                                "sense_id": "98a602a1-a028-38c8-bc8e-b25fba541e51",
                                                "text": "— Je trouve Frédérique trop superficielle des fois.\n— Ouais, t’as vu ? C’est ce que j’ai remarqué aussi."
                                            },
                                            {
                                                "example_id": "5518b507-040a-4062-9cdb-a8ed3874b673",
                                                "sense_id": "98a602a1-a028-38c8-bc8e-b25fba541e51",
                                                "text": "Ouais, cet homme-là fait bien le fier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e9e2c60-ed1b-3123-a680-0acadc0450bd",
                                        "entry_id": "23d4e6af-b86a-3037-9c66-f7fc3e5c79f4",
                                        "glosses": [
                                            "Marque la surprise."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7684bde-26d1-42bf-aed5-9bb03b949833",
                                                "sense_id": "6e9e2c60-ed1b-3123-a680-0acadc0450bd",
                                                "text": "– Ouais ! dit Louis XIII, que signifie cette mascarade?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47579156-b0ab-38c9-bf3d-bc2b80feff5f",
                                        "entry_id": "23d4e6af-b86a-3037-9c66-f7fc3e5c79f4",
                                        "glosses": [
                                            "Marque la joie."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1153ac2e-6139-48f3-9d2c-66197bcafa60",
                                                "sense_id": "47579156-b0ab-38c9-bf3d-bc2b80feff5f",
                                                "text": "Ouais, on a gagné !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dccd1380-5698-3cbe-a2c9-3ec7edfdfa41",
                                        "entry_id": "23d4e6af-b86a-3037-9c66-f7fc3e5c79f4",
                                        "glosses": [
                                            "Marque la réception d’un propos."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cfc3478-501b-4276-861a-237dc215cdfd",
                                                "sense_id": "dccd1380-5698-3cbe-a2c9-3ec7edfdfa41",
                                                "text": "Bilan\n On apprenait hier que le Canada cherche maintenant à s’approvisionner en vaccins en puisant dans les livraisons prévues pour les pays en voie de développement. Ouais..."
                                            },
                                            {
                                                "example_id": "c2a164b2-e8d4-4703-91e0-b44bf6749354",
                                                "sense_id": "dccd1380-5698-3cbe-a2c9-3ec7edfdfa41",
                                                "text": "— Tu veux venir avec nous au bois ?\n— Ouais… un autre jour peut-être."
                                            },
                                            {
                                                "example_id": "b0cc29d6-c4e3-49a3-a2a1-fba0353f14dc",
                                                "sense_id": "dccd1380-5698-3cbe-a2c9-3ec7edfdfa41",
                                                "text": "— T’en as pensé quoi du film ?\n— Hmmm… Ouais, pas vraiment convaincu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
