                                                "sense_id": "6f8cfb58-0f76-3673-8d03-1cb4f8b530b5",
                                                "text": "il generale si fermò a parlare con familiarità attorniato dalle reclute"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41d9a5a7-3e8b-3770-ad0f-f98570badc5a",
