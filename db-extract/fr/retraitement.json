                                    {
                                        "sense_id": "ab1f6aa8-0386-3708-9e7f-2096656845c8",
                                        "entry_id": "69798df5-155a-3d33-b905-3c7db2474445",
                                        "glosses": [
                                            "The process of extracting useful or valuable materials from used nuclear fuel, mainly focusing on the recovery of fissile and fertile material for use in fresh nuclear reactor fuel, or, in some cases, the manufacture of nuclear weapons."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21ab9075-8030-4163-9fb6-a9fcb178c115",
                                                "sense_id": "ab1f6aa8-0386-3708-9e7f-2096656845c8",
                                                "text": "For 75 years, it has fulfilled a wide range of roles: producing weapons-grade plutonium for early atomic weapons in the aftermath of the Second World War; the world's first commercial nuclear power station supplying electricity to the National Grid; reprocessing and storage of nuclear fuel; and the processing of lower grades of radioactive waste for off-site storage."
                                            }
                                        ]
