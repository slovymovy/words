                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2853568-e6d0-43b3-9211-e6d7bf885bae",
                                                "sense_id": "d727f412-04f6-36c6-a456-ea2afeddac04",
                                                "text": "The excavation took 16 months of 24-hour working to complete and required the sinking of a 65ft shaft, from where workers carved out the passageway and lined it with reinforced steel and sprayed concrete."
                                            },
                                            {
                                                "example_id": "22bfb1bf-f4dc-4dbd-8a9f-4b79cf838088",
                                                "sense_id": "d727f412-04f6-36c6-a456-ea2afeddac04",
                                                "text": "I witnessed the sinking of my ship from the shore."
                                            },
                                            {
                                                "example_id": "311048ef-5d05-48de-8f30-86999f3a4c51",
                                                "sense_id": "d727f412-04f6-36c6-a456-ea2afeddac04",
                                                "text": "We must endeavour to realize a succession of gradual sinkings or depressions into deep water, alternating with gradual emergings into shallows, and eventually a gradual continued lifting of the whole district[…]"
                                            }
                                        ]
                                    }
