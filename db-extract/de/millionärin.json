                            {
                                "example_id": "2e2176f9-2ec4-40d5-bc54-2e4f8cc62c66",
                                "sense_id": "0ae897e3-1c5d-360b-b167-8a6d30bd458b",
                                "text": "Frau Schubert ist durch ihren gewerbsmäßigen Erfolg eine Millionärin geworden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c83f1d8-fa99-43f1-bb34-51a4db5d5634",
                        "source_entry_id": "836e4a13-8e5f-3823-9eea-5722f46fabd4",
