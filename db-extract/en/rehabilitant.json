                ],
                "senses": [
                    {
                        "sense_id": "fc48d077-f10a-37f0-a440-b1ddd34afba7",
                        "entry_id": "472e2836-5255-3759-b839-6419ec938bf0",
                        "glosses": [
                            "One who is being or has been rehabilitated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "593a9cf8-c7fa-4ed1-a6a5-14ba6422de33",
                                "sense_id": "fc48d077-f10a-37f0-a440-b1ddd34afba7",
                                "text": "The rehabilitator and the rehabilitant assess each other."
                            },
                            {
                                "example_id": "08aebdf0-be4a-43d7-aafe-368627eaf0ca",
                                "sense_id": "fc48d077-f10a-37f0-a440-b1ddd34afba7",
                                "text": "This does happen for some; for example, peer counseling experience gained as an advanced rehabilitant working with more recently admitted clients/patients has been a stepping stone toward professional training for a number of people."
                            },
                            {
                                "example_id": "99f54ab2-1a90-47a3-8c72-b734aa6d041c",
                                "sense_id": "fc48d077-f10a-37f0-a440-b1ddd34afba7",
                                "text": "Considering rehabilitant variants that are modifications of provisional wild innovations, geographic prevalence was wider in wild orangutans for 7 entries, roughly equal for 16 entries, and wider in rehabilitants for 20 entries."
                            },
                            {
                                "example_id": "3994ef2f-73f2-4201-aba2-cf28652d790e",
                                "sense_id": "fc48d077-f10a-37f0-a440-b1ddd34afba7",
                                "text": "Rijksen (1978) observed a rehabilitant aggressively Jabbing with a long stick at a caged clouded leopard (Neofelis nebulosa)."
                            }
                        ]
                    }
                ],
