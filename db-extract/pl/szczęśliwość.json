                                    {
                                        "sense_id": "0d2a064b-7bd6-31ff-a61b-effac7714cee",
                                        "entry_id": "e324cf39-4ff4-3872-a39c-0def634a6fae",
                                        "glosses": [
                                            "sich positiv auswirkender Zufall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c98c12de-50d1-4c25-852e-5c69ff5a5919",
                                                "sense_id": "0d2a064b-7bd6-31ff-a61b-effac7714cee",
                                                "text": "„Wenn mein Glück aussetzt, bin ich verloren.“ (Bert Brecht)"
                                            },
                                            {
                                                "example_id": "d2d90aac-b793-4241-958f-be7d72cd2a39",
                                                "sense_id": "0d2a064b-7bd6-31ff-a61b-effac7714cee",
                                                "text": "Ich habe Glück in der Lotterie gehabt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4ed18db3-6d52-3710-91cf-946e0f7be5c3",
                                        "entry_id": "e324cf39-4ff4-3872-a39c-0def634a6fae",
                                        "glosses": [
                                            "das personifizierte [1] Glück"
                                        ],
                                        "tags": [
                                            "hypostatisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2786a32-03d8-4a12-b755-2b802ee4a137",
                                                "sense_id": "4ed18db3-6d52-3710-91cf-946e0f7be5c3",
                                                "text": "Hier winkt das Glück."
                                            },
                                            {
                                                "example_id": "014d2dfc-2a90-4856-a483-301c9cedd691",
                                                "sense_id": "4ed18db3-6d52-3710-91cf-946e0f7be5c3",
                                                "text": "Das Glück ist ihm gewogen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1ec67056-b471-3391-aae7-caa981ee9863",
                                        "entry_id": "e324cf39-4ff4-3872-a39c-0def634a6fae",
                                        "glosses": [
                                            "Zustand der (relativen oder vollkommenen) Zufriedenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e35bc36f-8c97-4efd-9fcb-3e47e038e945",
                                                "sense_id": "1ec67056-b471-3391-aae7-caa981ee9863",
                                                "text": "Ein Fräulein ist eine Frau, der zum Glück (oder zum Glück?) der Mann fehlt."
                                            },
                                            {
                                                "example_id": "d3359234-06a6-43d4-810d-76755ef638c7",
                                                "sense_id": "1ec67056-b471-3391-aae7-caa981ee9863",
                                                "text": "Letztendlich hat sie doch noch ihr Glück gefunden."
                                            },
                                            {
                                                "example_id": "3a7bb68a-af08-412d-804c-9331992c7f8a",
                                                "sense_id": "1ec67056-b471-3391-aae7-caa981ee9863",
                                                "text": "„Glück ist die innere Anpassung an die äußeren Umstände, welcher Art sie auch sein mögen.“"
                                            },
                                            {
                                                "example_id": "74e05bc9-d521-4f28-a8ed-deeb116d0b7a",
                                                "sense_id": "1ec67056-b471-3391-aae7-caa981ee9863",
                                                "text": "Thomas ist ein rechter Hans im Glück."
                                            },
                                            {
                                                "example_id": "de708047-688f-4ca1-a412-73c042aeb8a1",
                                                "sense_id": "1ec67056-b471-3391-aae7-caa981ee9863",
                                                "text": "„Extrembergsteiger Reinhold Messner (67) ist jahrzehntelang auf der Suche nach dem Glück gewesen.“"
                                            },
                                            {
                                                "example_id": "891067be-b504-4ee1-a7b9-772bb6c1de38",
                                                "sense_id": "1ec67056-b471-3391-aae7-caa981ee9863",
                                                "text": "„Glück wurde einmal als Abwesenheit von Unruhe definiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
