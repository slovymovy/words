                "senses": [
                    {
                        "sense_id": "1e61b5e3-256a-364d-a411-fdffb84811cb",
                        "entry_id": "d52da57e-3fad-3939-8718-429cc600593f",
                        "glosses": [
                            "mexikanischer Bundesstaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "003ff01e-c9e6-4e5b-a177-ee9125b013bf",
                                "sense_id": "1e61b5e3-256a-364d-a411-fdffb84811cb",
                                "text": "„Die Region der südlichen Golfküste im heutigen Tabasco und Veracruz hatte zwar bereits ab 1500 bis ca. 400 v.Chr. die Blüte der olmekischen Kultur erlebt, aber auch im Tal von Mexiko finden sich ab 1500 v.Chr Besiedlungsspuren, die auf die Sesshaftwerdung nach Jahrtausenden der Jäger- und Sammlerkulturen hindeuten.“"
                            },
                            {
                                "example_id": "8a01dcfe-51b5-473c-8618-7d03c0323fa9",
                                "sense_id": "1e61b5e3-256a-364d-a411-fdffb84811cb",
                                "text": "„Alberto Sánchez Hinojosa, ›El Tony‹, einer der Statthalter des Golf-Kartells nach der Verhaftung von Osiel Cárdenas Guillén, wurde zwei Monate später im südmexikanischen Bundesstaat Tabasco verhaftet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
