                        "source_sense_id": "db546ae4-0c12-3743-bfb8-bb8725eea4c9",
                        "target_lang_word": "seducer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seducer",
