                        "entry_id": "c1f466a0-ed37-339d-aaf5-644d03a00f12",
                        "glosses": [
                            "Absence de plaisir lors des relations sexuelles"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5180096-79a6-4620-984a-7e54be4a3e9c",
                                "sense_id": "bcbb7966-f32a-37f1-9195-384cc735693b",
                                "text": "La frigidité sexuelle est un symptôme névrotique qui se rencontre souvent."
                            }
                        ]
                    },
                    {
                        "sense_id": "600f8c3c-3efe-3511-a17e-ce39264d167c",
                        "entry_id": "c1f466a0-ed37-339d-aaf5-644d03a00f12",
                        "glosses": [
                            "État de ce qui est froid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff9a34e6-3759-4b5a-85a7-6f8a2ae10147",
                                "sense_id": "600f8c3c-3efe-3511-a17e-ce39264d167c",
                                "text": "La frigidité d’un cadavre."
                            },
                            {
                                "example_id": "6379591a-bc77-4fd3-bbfa-dca874879691",
                                "sense_id": "600f8c3c-3efe-3511-a17e-ce39264d167c",
                                "text": "La frigidité du marbre."
                            },
                            {
                                "example_id": "627ebf7a-77aa-4a5e-86b6-27ef56534499",
                                "sense_id": "600f8c3c-3efe-3511-a17e-ce39264d167c",
                                "text": "Elle désirait s’aimer elle-même : mais l’image des miroirs avait une frigidité calme et lointaine, et l’image des étangs était morne et pâle, et l’image des rivières fuyait en tremblant."
                            }
                        ]
                    }
