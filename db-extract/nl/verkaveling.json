                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "456d70c6-c610-3e2c-8449-eb4666730ec2",
                                        "entry_id": "64fd0a91-e90e-3aa5-b78d-fd36412f67b6",
                                        "glosses": [
                                            "A package wrapped for shipment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd7fb226-048c-4f33-8dff-513100d33cf4",
                                                "sense_id": "456d70c6-c610-3e2c-8449-eb4666730ec2",
                                                "text": "I saw a brown paper parcel on my doorstep."
                                            },
                                            {
                                                "example_id": "1bd79ca1-733a-4b28-8e6c-014be3ef2c49",
                                                "sense_id": "456d70c6-c610-3e2c-8449-eb4666730ec2",
                                                "text": "At twilight in the summer[…]the mice come out. They[…]eat the luncheon crumbs. Mr. Checkly, for instance, always brought his dinner in a paper parcel in his coat-tail pocket, and ate it when so disposed, sprinkling crumbs lavishly[…]on the floor."
                                            },
                                            {
                                                "example_id": "ae13f2c0-8296-4144-8d3a-a72506418670",
                                                "sense_id": "456d70c6-c610-3e2c-8449-eb4666730ec2",
                                                "text": "“H'm !” he said, “so, so—it is a tragedy in a prologue and three acts. I am going down this afternoon to see the curtain fall for the third time on what […] will prove a good burlesque ; but it all began dramatically enough. It was last Saturday […] that two boys, playing in the little spinney just outside Wembley Park Station, came across three large parcels done up in American cloth. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b13e0e9-1a4b-3fe7-97a0-0f47d3dd3631",
                                        "entry_id": "64fd0a91-e90e-3aa5-b78d-fd36412f67b6",
                                        "glosses": [
                                            "An individual consignment of cargo for shipment, regardless of size and form."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "283725c6-4616-3eaf-bc27-b7f310058158",
                                        "entry_id": "64fd0a91-e90e-3aa5-b78d-fd36412f67b6",
                                        "glosses": [
                                            "An individual item appearing on an invoice or receipt (only in the phrase bill of parcels)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5934bdde-28d8-379c-b21b-f2075e12ebf5",
                                        "entry_id": "64fd0a91-e90e-3aa5-b78d-fd36412f67b6",
                                        "glosses": [
                                            "A division of land bought and sold as a unit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45cc5f55-e32a-4e0b-883d-d658de3fdd8f",
                                                "sense_id": "5934bdde-28d8-379c-b21b-f2075e12ebf5",
                                                "text": "I own a small parcel of land between the refinery and the fish cannery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceea62f4-9568-312f-9b60-e5f5a231b69e",
                                        "entry_id": "64fd0a91-e90e-3aa5-b78d-fd36412f67b6",
                                        "glosses": [
                                            "A group of birds."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7fccdd9-fc90-3b9b-b32d-3392c6c4309e",
                                        "entry_id": "64fd0a91-e90e-3aa5-b78d-fd36412f67b6",
                                        "glosses": [
                                            "An indiscriminate or indefinite number, measure, or quantity; a collection; a group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "929eb517-138f-49bd-99c5-70601a5d877a",
                                                "sense_id": "b7fccdd9-fc90-3b9b-b32d-3392c6c4309e",
                                                "text": "[…] this youthful parcel / Of noble bachelors stand at my bestowing,"
                                            },
                                            {
                                                "example_id": "ab353a04-2115-410c-927f-32806b821361",
                                                "sense_id": "b7fccdd9-fc90-3b9b-b32d-3392c6c4309e",
                                                "text": "[…] instead of sitting (as she ought to have done) by her good father and mother, she must needs run up into the gallery, and sit with a parcel of giddy creatures of her own age […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cb23be0-1341-3dc4-b053-0ee00d788f6b",
                                        "entry_id": "64fd0a91-e90e-3aa5-b78d-fd36412f67b6",
                                        "glosses": [
                                            "A small amount of food that has been wrapped up, for example a pastry."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2da74a52-3842-33e3-9608-8c7bb517104f",
                                        "entry_id": "64fd0a91-e90e-3aa5-b78d-fd36412f67b6",
                                        "glosses": [
                                            "A portion of anything taken separately; a fragment of a whole; a part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da5bb2d9-81a2-4e56-8a00-4c4dbeca2bed",
                                                "sense_id": "2da74a52-3842-33e3-9608-8c7bb517104f",
                                                "text": "A certain piece of land is part and parcel of another piece."
                                            },
                                            {
                                                "example_id": "5b94a740-4049-4377-a6ca-32cfcc793acd",
                                                "sense_id": "2da74a52-3842-33e3-9608-8c7bb517104f",
                                                "text": "The same Experiments succeed on two Parcels of the White of an Egg […]"
                                            },
                                            {
                                                "example_id": "a4922737-50df-44a3-93ff-7361ad3e7040",
                                                "sense_id": "2da74a52-3842-33e3-9608-8c7bb517104f",
                                                "text": "1881, John Addington Symonds, The Renaissance in Italy, Volume 5, Part I, New York: Henry Holt, Chapter 1, p. 2,\nThe parcels of the nation adopted different forms of self-government, sought divers foreign alliances."
                                            },
                                            {
                                                "example_id": "485f4682-bdf2-493a-8299-b6ea50844610",
                                                "sense_id": "2da74a52-3842-33e3-9608-8c7bb517104f",
                                                "text": "I don't think we are sitting pretty / So far away from our fair city / But I love you more than any parcel of earth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parcel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d2f59f4-0a16-3269-a17b-a0a03391e67d",
                                        "entry_id": "d5518387-290a-3ca6-93a0-6c673f8aae74",
                                        "glosses": [
                                            "To wrap something up into the form of a package."
