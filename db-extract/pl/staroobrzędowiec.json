                "senses": [
                    {
                        "sense_id": "6854d5e2-42ef-3172-8113-e516af2b2f09",
                        "entry_id": "2e35f2e3-fbb2-3178-9629-de03de98120c",
                        "glosses": [
                            "członek odłamu cerkwi prawosławnej nieuznającego siedemnastowiecznej reformy liturgicznej patriarchy Nikona"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a851d22-e9f9-46cf-ac9c-97cc42f6334c",
                                "sense_id": "6854d5e2-42ef-3172-8113-e516af2b2f09",
                                "text": "Zgodnie z kalendarzem juliańskim prawosławni, grekokatolicy, staroobrzędowcy oraz Ormianie świętują dziś Boże Narodzenie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfe96310-dc31-44ae-a70d-8605b031ba3a",
                        "source_entry_id": "2e35f2e3-fbb2-3178-9629-de03de98120c",
                        "source_sense_id": "6854d5e2-42ef-3172-8113-e516af2b2f09",
                        "target_lang_word": "Old Believer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Old Believer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb52cbc9-61b8-3f21-9449-1cd094e0949f",
                                        "entry_id": "727f8776-d4d5-39e0-bb76-c0db6862cf64",
                                        "glosses": [
                                            "Any of those who separated from the official Russian Orthodox Church after 1666 as a protest against the church reforms introduced by Patriarch Nikon between 1652 and 1666. They continue liturgical and ritual practices which predate the reforms."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e39f066-c9f0-4f62-9996-00ea9484156f",
                        "source_entry_id": "2e35f2e3-fbb2-3178-9629-de03de98120c",
                        "source_sense_id": "6854d5e2-42ef-3172-8113-e516af2b2f09",
                        "target_lang_word": "vieux-croyant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vieux-croyant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10ad647d-4dfb-375e-9947-f04f7ac09109",
                                        "entry_id": "144394c6-ef0a-3e80-91f8-8f145527e183",
                                        "glosses": [
                                            "Relatif au raskol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c13ad02-7900-462d-984d-a8baa6d83ab9",
                                                "sense_id": "10ad647d-4dfb-375e-9947-f04f7ac09109",
                                                "text": "Les orthodoxes vieux-croyants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vieux-croyant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f87b709f-fb87-341d-b6ed-6554c7db1f2f",
                                        "entry_id": "f4bb9a8e-0145-3aa8-8f4b-03cdb16d8b92",
                                        "glosses": [
                                            "Raskolnik."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78f89955-2bdd-4033-9b78-b8163ed80a9f",
                                                "sense_id": "f87b709f-fb87-341d-b6ed-6554c7db1f2f",
                                                "text": "Longtemps isolés, les descendants des vieux-croyants ont perpétué leurs traditions : la barbe longue, une foi intense et un dialecte ancien. En Roumanie, on les nomme les Lipovènes. Dans le delta, ils sont plus de 20 000, concentrés dans cinq villages."
                                            },
                                            {
                                                "example_id": "07aa5e37-d5a3-45dc-8f76-e233ebbf0e05",
                                                "sense_id": "f87b709f-fb87-341d-b6ed-6554c7db1f2f",
                                                "text": "En Russie, les vieux-croyants sont de retour."
                                            },
                                            {
                                                "example_id": "6e31e6e7-0904-4310-9b2d-8dc3d7c2bb29",
                                                "sense_id": "f87b709f-fb87-341d-b6ed-6554c7db1f2f",
                                                "text": "Le faste du sanctuaire de Swieta Lipka contraste avec la sobriété du monastère des Vieux-Croyants russes de Wojnowo, plus au sud. Posé au bord d’un petit lac romantique, ce monastère fut au XIX siècle le refuge d’immigrés moscovites fuyant les persécutions du pouvoir impérial. Refusant les réformes de l’Église orthodoxe et souhaitant garder les anciens rites, ces vieux-croyants reçurent l’autorisation du roi de Prusse pour s’installer dans la région."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b78a8a71-0ad4-404b-a8fc-b3d5755231f9",
                        "source_entry_id": "2e35f2e3-fbb2-3178-9629-de03de98120c",
                        "source_sense_id": "6854d5e2-42ef-3172-8113-e516af2b2f09",
                        "target_lang_word": "viejo creyente",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bcee066b-1fd9-47c6-9dd0-cfe55a57ee47",
                        "source_entry_id": "2e35f2e3-fbb2-3178-9629-de03de98120c",
                        "source_sense_id": "6854d5e2-42ef-3172-8113-e516af2b2f09",
                        "target_lang_word": "Altgläubiger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altgläubiger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01c7d223-8959-3d23-bf31-445f05b0af2b",
                                        "entry_id": "cf0a6ecf-0914-3f6c-a8b0-9f57ca473bfc",
                                        "glosses": [
                                            "Anhänger einer christlichen Glaubensrichtung in Russland, die nicht mehr zur Russisch-Orthodoxen Kirche gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d9b4346-73b9-43c3-8311-2442fb7c31d4",
                                                "sense_id": "01c7d223-8959-3d23-bf31-445f05b0af2b",
                                                "text": "„Wir hatten in unserm Zuchthause auch andere Altgläubige, zum größten Teil Sibirier. Es waren geistig hochentwickelte, schlaue Bauern, außerordentlich bibelkundig, am Buchstaben zäh festhaltend und in ihrer Art tüchtige Dialektiker; hochmütige, eingebildete, listige und im höchsten Grade intolerante Menschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77a3bf65-6f36-4cb1-9e2a-33bddc6374b9",
                        "source_entry_id": "2e35f2e3-fbb2-3178-9629-de03de98120c",
                        "source_sense_id": "6854d5e2-42ef-3172-8113-e516af2b2f09",
                        "target_lang_word": "Raskolnik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a531b7f0-2404-4649-8237-a8f05d555ce0",
                        "source_entry_id": "2e35f2e3-fbb2-3178-9629-de03de98120c",
                        "source_sense_id": "6854d5e2-42ef-3172-8113-e516af2b2f09",
                        "target_lang_word": "старообря́дец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "старообря́дец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5b85258b-4222-3f1f-8aa9-5af1a382262b",
                                        "entry_id": "582fe201-50fc-3863-ba66-8d1fd8c61c82",
                                        "glosses": [
                                            "истор., религ. человек, придерживающийся старообрядчества, то есть православных норм и обрядов, существовавших на Руси до церковного раскола XVII века."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ad02838-4a1e-4b52-96f9-35f63ded01e3",
                                                "sense_id": "5b85258b-4222-3f1f-8aa9-5af1a382262b",
                                                "text": "Славянофилы эти наши, народники всякие ― старообрядцы всё!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
