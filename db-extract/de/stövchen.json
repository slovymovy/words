                "senses": [
                    {
                        "sense_id": "d60a12a5-dcf1-313f-838e-eb74ec30d1e8",
                        "entry_id": "7984c5f8-0969-3bef-be18-0567a5074b54",
                        "glosses": [
                            "Untersatz mit einem Teelicht, auf dem man eine Kanne warmhalten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f40edde-76ec-4967-b261-99d0ebc0bd3d",
                                "sense_id": "d60a12a5-dcf1-313f-838e-eb74ec30d1e8",
                                "text": "Ostfriesischer Tee in einer Kanne auf dem Stövchen, Kandiszucker zum Süßen und Sahne im Kännchen, so sieht eine gemütliche Teepause aus."
                            },
                            {
                                "example_id": "c5353dac-2448-4cc8-bcb9-dfd4e434fda3",
                                "sense_id": "d60a12a5-dcf1-313f-838e-eb74ec30d1e8",
                                "text": "Das teuerste Exponat ist eine \"Mokkastation\" inklusive Tablett, Kanne, Tassen und Stövchen für rund 11.300 Euro."
                            },
                            {
                                "example_id": "983a99f0-9e6c-46fe-9608-eb98812b8b7e",
                                "sense_id": "d60a12a5-dcf1-313f-838e-eb74ec30d1e8",
                                "text": "Für das Fondue mit Schokolade im kleinen Töpfchen reicht auch eine Variante mit Teelicht, ähnlich einem Stövchen für Tee."
                            },
                            {
                                "example_id": "6b9f665b-b1fb-47e8-8f32-85cfae8a10d4",
                                "sense_id": "d60a12a5-dcf1-313f-838e-eb74ec30d1e8",
                                "text": "„Wenn man das Deckenlicht ausmachte, leuchtete das Rote im Stövchen noch heller.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11e6a456-1e5c-4d10-99d8-a30ab1bc8641",
