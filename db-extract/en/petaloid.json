                        "examples": [
                            {
                                "example_id": "00f2a82b-fc5d-4a91-a7e1-dd1c096b6535",
                                "sense_id": "4b5150d3-d6bf-3473-b920-064deea82b89",
                                "text": "From whence he concludes, that no apetalous can be a perfect Flower, since the only Fence of a Flower consists in its being petaloid."
                            },
                            {
                                "example_id": "08698eb5-7b38-41f0-912c-8d4f6fc0bbca",
                                "sense_id": "4b5150d3-d6bf-3473-b920-064deea82b89",
                                "text": "A peach tree, flowering in July for the second time in Kew Gardens, had double flowers, all of which were proliferated, and many of the outermost carpels were petaloid in part."
                            },
                            {
                                "example_id": "3e26b4c7-8b84-4de0-a221-58c210ee5c0e",
                                "sense_id": "4b5150d3-d6bf-3473-b920-064deea82b89",
                                "text": "On a single bush of Warai-gishi one usually can find some few normal single flowers, flowers with flaglike appendages to the otherwise normal anthers, petaloid filaments with traces of anther left, and completely transformed stamens."
                            }
                        ]
                    }
