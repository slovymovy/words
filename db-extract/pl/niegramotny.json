                "senses": [
                    {
                        "sense_id": "e7d717d1-4e40-3c99-8a1d-8e1f37d397c0",
                        "entry_id": "7a8a297b-3750-3796-a1e2-20ef04c4ec55",
                        "glosses": [
                            "nieumiejący czytać i pisać"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "06833e85-9bee-452d-bfcf-a790f2f2d8a0",
                                "sense_id": "e7d717d1-4e40-3c99-8a1d-8e1f37d397c0",
                                "text": "– Nie jestem dotknięty – przepraszam za takie określenie – łaską wiary, żeby uwierzyć, że ponad 200 tys. niegramotnych i nierozgarniętych polskich wyborców poszło i nieświadomie oddało głos nieważny. Jest to dla mnie naprawdę bardzo dziwna sytuacja"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1721d29f-3691-3389-94ff-14de5e854729",
                        "entry_id": "7a8a297b-3750-3796-a1e2-20ef04c4ec55",
                        "glosses": [
                            "mało rozgarnięty, o niskim stopniu inteligencji"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
