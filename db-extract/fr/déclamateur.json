                    {
                        "sense_id": "ca870bfe-7c04-3a11-a585-ae66fe3adf97",
                        "entry_id": "2ce5ed70-5e7f-3db0-a307-a1993d78fe99",
                        "glosses": [
                            "Rhéteur qui faisait des exercices d’éloquence dans les écoles."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "afbfdaec-c30c-3396-8809-96c02cec1c41",
                        "entry_id": "2ce5ed70-5e7f-3db0-a307-a1993d78fe99",
                        "glosses": [
                            "Celui qui déclame des vers, un discours, etc."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "98fcf6b2-a329-434c-8b8a-a87940808a03",
                                "sense_id": "afbfdaec-c30c-3396-8809-96c02cec1c41",
                                "text": "— Au sommet de la colline, sur une petite place, où un chanteur déclamateur récite avec force gestes des vers de Saadi, l’adorable poète persan, je m’abandonne à la contemplation de la capitale transcaucasienne."
                            },
                            {
                                "example_id": "08387d5a-4e38-49d8-a47e-a450b2060639",
                                "sense_id": "afbfdaec-c30c-3396-8809-96c02cec1c41",
                                "text": "— Le programme sera artistique et littéraire. J’ai obtenu le concours des musiciens, des chanteurs, des déclamateurs, en un mot de tous les types de la ville qui croient avoir du talent. Pauvres gens !"
                            }
                        ]
                    },
                    {
                        "sense_id": "d8fa1019-c817-3ad0-a59f-caf6b031b9a1",
                        "entry_id": "2ce5ed70-5e7f-3db0-a307-a1993d78fe99",
                        "glosses": [
                            "Orateur ou écrivain emphatique, outré dans ses expressions."
                        ],
                        "tags": [
                            "Plus ordinairement"
                        ],
                        "examples": [
                            {
                                "example_id": "9b836962-3bee-4212-9bb9-68edce0446c5",
                                "sense_id": "d8fa1019-c817-3ad0-a59f-caf6b031b9a1",
                                "text": "Laissons cette phrase aux déclamateurs : elle peut choquer la vérité ; l’urbanité la défend, et elle marque peu de charité."
                            }
                        ]
                    }
                ],
