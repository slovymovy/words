                "senses": [
                    {
                        "sense_id": "66f99270-3757-3e6b-9795-fc6680b40739",
                        "entry_id": "4a50649a-09ad-3ac9-b259-a86a9ab4b811",
                        "glosses": [
                            "Vorrichtung, die überprüft, ob ein Gleisabschnitt oder eine Weiche frei von Fahrzeugen ist"
                        ],
                        "tags": [
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "cd17582f-b147-45d2-bbda-9850a63222ea",
                                "sense_id": "66f99270-3757-3e6b-9795-fc6680b40739",
                                "text": "„Am S-Bahnhof Praterstern haben Kupferdiebe in der Nacht auf Dienstag Kabel gestohlen. Eine Gleisfreimeldeanlage wurde beschädigt, 28 Züge fielen bis 7.00 Uhr aus.“"
                            },
                            {
                                "example_id": "7bb4c132-9746-48ce-9848-a85c7e3653f1",
                                "sense_id": "66f99270-3757-3e6b-9795-fc6680b40739",
                                "text": "„Wenn bei gestörter Gleisfreimeldeanlage das Freisein des Fahrwegs nicht durch Augenschein festgestellt werden kann oder wenn der Einfahrweg in einem Stumpfgleis oder besetzten Gleis endet, muß die Sicherheit durch betriebliche Anweisungen oder technische Einrichtungen gewährleistet sein.“"
                            },
                            {
                                "example_id": "45197f9d-2407-4c09-8d79-bd420fdb03ad",
                                "sense_id": "66f99270-3757-3e6b-9795-fc6680b40739",
                                "text": "„Alle Bahnhöfe verfügen über elektrisch fernbediente Weichen, Lichtsignale und eine Gleisfreimeldeanlage.“"
                            },
                            {
                                "example_id": "3197ac9e-9aa0-48d0-a506-3e1b8f5ada6f",
                                "sense_id": "66f99270-3757-3e6b-9795-fc6680b40739",
                                "text": "„Die Gleisfreimeldeanlage, die sicherstelle, dass sich pro Streckenabschnitt nur ein Zug befindet, sei ausgefallen.“"
                            },
                            {
                                "example_id": "44cdba7e-1782-496c-a727-1a3f9f61cd8c",
                                "sense_id": "66f99270-3757-3e6b-9795-fc6680b40739",
                                "text": "„Die GKB verfügt zudem über betriebliche Sicherungseinrichtungen, wie eine flächendeckende Punktförmige Zugbeeinflussung (PZB) und eine durchgängige Gleisfreimeldeanlage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
