                                        "sense_id": "56f36a8e-bfa8-38cb-8d8a-01e064d63a80",
                                        "entry_id": "8abf9583-09c1-323b-86a7-f6444163029b",
                                        "glosses": [
                                            "Celui qui lèche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8763d050-6fc6-40af-800d-252182cf254c",
                                                "sense_id": "56f36a8e-bfa8-38cb-8d8a-01e064d63a80",
                                                "text": "Un lécheur de plats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95f8956e-c66d-39a7-a0f7-b1293463850c",
                                        "entry_id": "8abf9583-09c1-323b-86a7-f6444163029b",
                                        "glosses": [
                                            "Qui aime embrasser."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0d2d7a8-069f-4719-9250-3cbea74bf8d1",
                                                "sense_id": "95f8956e-c66d-39a7-a0f7-b1293463850c",
                                                "text": "C’est un vrai lécheur, il n’arrête pas de me bisouiller !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a6dc24a-52ad-3400-b6e3-d1454d06806c",
                                        "entry_id": "8abf9583-09c1-323b-86a7-f6444163029b",
                                        "glosses": [
                                            "Personne servile envers ses supérieurs ou qui flatte ceux qui ont du pouvoir."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72d7f8c6-f8a9-4f82-a1b5-3166f30959fc",
                                                "sense_id": "3a6dc24a-52ad-3400-b6e3-d1454d06806c",
                                                "text": "Je n’aime pas les lécheurs, excuse-moi mais je préfère te le dire en face."
                                            },
                                            {
                                                "example_id": "8eab6190-2e94-4939-ae78-1ee40e39bb9c",
                                                "sense_id": "3a6dc24a-52ad-3400-b6e3-d1454d06806c",
                                                "text": "On le savait rampant, lécheur, avide d’attentions de la part des gradés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "645fb3d5-57cd-3c4d-80ca-6fe282093579",
                                        "entry_id": "8abf9583-09c1-323b-86a7-f6444163029b",
                                        "glosses": [
                                            "Artiste peintre dont la peinture est léchée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec4e408c-9667-4f09-b929-ebaf69315aae",
                                                "sense_id": "645fb3d5-57cd-3c4d-80ca-6fe282093579",
                                                "text": "Tout ceci nous paraît dépasser un peu les bornes de la fougue et de l’entrain ; les artistes les plus emportés sont des lécheurs en comparaison."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lécheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f92a6c82-abb9-37df-a291-f74c85978793",
                                        "entry_id": "7edcd93e-7734-314c-89bc-6dd51e0c00c8",
                                        "glosses": [
                                            "Qui lèche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d867521d-9c11-4736-92f4-850b8e2558fe",
                                                "sense_id": "f92a6c82-abb9-37df-a291-f74c85978793",
                                                "text": "Son épouse, est toujours la même ; marmotter une litanie, et caresser une chatte mignonne et lécheresse ou un épagneul, voilà sa vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
