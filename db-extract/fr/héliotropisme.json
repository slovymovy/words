        "fr-extract.jsonl": [
            {
                "entry_id": "c5c2fe26-77de-3f6f-b673-a2600ba651f7",
                "word": "héliotropisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8fd63c59-539c-4beb-9df5-008638ee8bda",
                        "entry_id": "c5c2fe26-77de-3f6f-b673-a2600ba651f7",
                        "tags": [
                            "plural"
                        ],
                        "form": "héliotropismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "596f1939-5717-32e6-92eb-31e354703651",
                        "entry_id": "c5c2fe26-77de-3f6f-b673-a2600ba651f7",
                        "glosses": [
                            "Attraction vers le soleil d’une plante ou d’une partie de cette plante, afin de favoriser l’apport de lumière à ses parties aériennes."
                        ],
                        "tags": [
                            "Morphologie végétale",
                            "Physiologie végétale"
                        ],
                        "examples": [
                            {
                                "example_id": "6691173a-0e32-4558-94dd-81953db6a5f6",
                                "sense_id": "596f1939-5717-32e6-92eb-31e354703651",
                                "text": "Pour préciser les effets de cet héliotropisme, Stacey Harmer et ses collègues ont effectué plusieurs expériences. Ils ont attaché certains tournesols à des tuteurs, pour empêcher leur mouvement, et en ont retourné d’autres au crépuscule, de manière à ce qu’ils soient orientés vers l’ouest à l’aube."
                            }
                        ]
                    },
                    {
                        "sense_id": "259e8223-4540-3bdc-ad6c-de7ef8d42775",
                        "entry_id": "c5c2fe26-77de-3f6f-b673-a2600ba651f7",
                        "glosses": [
                            "Phénomène d’attirance des populations d’un pays vers une région plus ensoleillée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b517c409-b6d6-4fac-920b-67ae213f7c00",
                                "sense_id": "259e8223-4540-3bdc-ad6c-de7ef8d42775",
                                "text": "L’héliotropisme et surtout le vieillissement deviennent, dans ce cas, une cause de migration, d’autant plus que, l’âge venant, certains pays offrent des résidences médicalisées où la main d’œuvre est meilleur marché que chez soi, comme dans le sud du Portugal, par exemple."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73308f99-5a56-443b-a9d9-e3053ff6968c",
                        "source_entry_id": "c5c2fe26-77de-3f6f-b673-a2600ba651f7",
                        "source_sense_description": "Botanique",
                        "target_lang_word": "heliotropism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heliotropism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1d04169-9c58-304d-9558-726a4c073b84",
                                        "entry_id": "0c615dbb-6ac9-3004-a221-becf6a01f438",
                                        "glosses": [
                                            "The property of some plants of turning under the influence of light; either positively (towards the light) or negatively (away from the light)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53abe5a6-9c69-49ee-9b8a-c6683acef2c5",
                                                "sense_id": "d1d04169-9c58-304d-9558-726a4c073b84",
                                                "text": "As soon as the faintest ray of light reaches a seedling, heliotropism will guide it through any crack in the soil, or through an entangled mass of overlying vegetation; […]"
                                            },
                                            {
                                                "example_id": "673b9b3f-e4e2-48b3-8627-b8f9a776991f",
                                                "sense_id": "d1d04169-9c58-304d-9558-726a4c073b84",
                                                "text": "A field of young sunflowers will slowly rotate from east to west during the course of a sunny day, each leaf seeking out as much sunlight as possible as the sun moves across the sky through an adaptation called heliotropism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
