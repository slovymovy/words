                                                "text": "„Er fegt meine Jacke vom benachbarten Stuhl, setzt sich hin und nimmt sofort die Armlehne in Beschlag.“"
                                            },
                                            {
                                                "example_id": "dbd41bfc-8ef1-44ee-abb4-37a853698c8a",
                                                "sense_id": "2f821057-317a-358d-9b3e-49a0e7c9c22a",
                                                "text": "„Seine Frau kam um die Sitzgruppe herum und setzte sich zu ihrem Mann auf die Armlehne seines Sessels.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
