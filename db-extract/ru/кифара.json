                                        "entry_id": "2a527e49-1204-3529-ba5d-4e1d5b1dc7d2",
                                        "glosses": [
                                            "ein großes sieben- (7. Jhdt v. Chr.) später auch elf- bis zwölf-saitiges (5.Jhdt. v. Chr.) Instrument aus der klassischen, griechischen Antike"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d45e18fc-12b3-46a1-9975-15fdfa978f9d",
                                                "sense_id": "b4b3c2cc-f516-3098-8041-c172c335c335",
                                                "text": "Die Lyra ist gewissermaßen eine Kleinausgabe der Kithara."
                                            },
                                            {
                                                "example_id": "309699f2-e998-4552-a749-2aa6c2b3d20d",
                                                "sense_id": "b4b3c2cc-f516-3098-8041-c172c335c335",
                                                "text": "„Niemand sonst konnte die Saiten der Kithara so wundervoll spielen, dass es fast zärtlich klang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
