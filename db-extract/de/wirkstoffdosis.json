                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7987c41-a299-408f-8f3e-5cbd4039ca01",
                                "sense_id": "ec5a6c75-06d6-3def-9bd4-9000569c1c00",
                                "text": "„Teilen von sehr kleinen Tabletten sollte vermieden werden, da hier durch das Absplittern die Wirkstoffdosis zu stark verringert werden kann.“"
                            },
                            {
                                "example_id": "dfad45bb-6786-45de-a913-9b2327f651fb",
                                "sense_id": "ec5a6c75-06d6-3def-9bd4-9000569c1c00",
                                "text": "„In der Praxis hängt die Kontrolle der Asthmabeschwerden davon ab, ob Patienten/-innen ihren Inhalator richtig bedienen und die Bereitstellung der Wirkstoffdosis und das Einatmen richtig koordinieren können.“"
                            },
                            {
                                "example_id": "be2892dd-2048-4a01-b231-bd34a2624c72",
                                "sense_id": "ec5a6c75-06d6-3def-9bd4-9000569c1c00",
                                "text": "„Nächste Testphase: Erste Gruppe hat Wirkstoffdosen mit Corona-Impfstoff bekommen.“"
                            }
                        ],
