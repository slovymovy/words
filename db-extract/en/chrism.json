                    {
                        "translation_id": "e51bee3c-7495-4b8f-a260-b7761fd7e943",
                        "source_entry_id": "b03112ad-dc6d-302d-8ddb-83ce7a0df7e6",
                        "source_sense_id": "6a54f609-9564-38d2-87d0-3c7a26ceb4a2",
                        "source_sense_description": "mixture of oil and balm",
                        "target_lang_word": "chrême",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chrême",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "716c9677-c73e-3e10-83fc-6c58d12498c5",
                                        "entry_id": "0bd4a8d9-1f86-3a8b-bcda-a72828faf902",
                                        "glosses": [
                                            "Huile sacrée, mêlée de baume et servant aux onctions qu’on fait dans l’administration de certains sacrements et dans quelques autres cérémonies de l’Église."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0803806-5860-488f-bff9-b7987bee41a4",
                                                "sense_id": "716c9677-c73e-3e10-83fc-6c58d12498c5",
                                                "text": "C’est moi qui vous ai engendrés en Jésus-Christ par son Evangile : naissance, au reste, qui ne devient parfaite que par le baptême et par le chrême (la confirmation) donnée par le ministère de l’évêque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "289667d2-1d92-4ad0-b6dc-890d83eb39f2",
                        "source_entry_id": "b03112ad-dc6d-302d-8ddb-83ce7a0df7e6",
                        "source_sense_id": "6a54f609-9564-38d2-87d0-3c7a26ceb4a2",
                        "source_sense_description": "mixture of oil and balm",
                        "target_lang_word": "Chrisam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chrisam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4adf256-83fc-394b-803d-f04c440ec23d",
                                        "entry_id": "23b556cb-81c9-3afa-8df3-1b7bfb5e8c5b",
                                        "glosses": [
                                            "wertvolles gesegnetes Öl für Salbungen, das unter anderem bei der Firmung, Taufe und der Priesterweihe benutzt wird"
                                        ],
                                        "tags": [
                                            "Katholische Kirche",
                                            "Orthodoxe Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2dd8593-fee4-4570-93d8-55bd16a781fa",
                                                "sense_id": "f4adf256-83fc-394b-803d-f04c440ec23d",
                                                "text": "„Bei der Feier der Taufe erfolgt unmittelbar im Anschluss an den eigentlichen Taufakt die Salbung mit Chrisam.“"
                                            },
                                            {
                                                "example_id": "c247db03-da49-468f-bde3-9821f753716f",
                                                "sense_id": "f4adf256-83fc-394b-803d-f04c440ec23d",
                                                "text": "„Gemäß Ordo Romanus XI, somit im Frühmittelalter, dürfen die Gläubigen noch mit Chrisam vermischtes Taufwasser mit nach Hause nehmen.“"
                                            },
                                            {
                                                "example_id": "8f084a56-880f-4d8d-bef3-cc69ff6c759b",
                                                "sense_id": "f4adf256-83fc-394b-803d-f04c440ec23d",
                                                "text": "„Die erforderliche Handlung besteht in einer Salbung mit Chrisam unter Auflegung der Hand zusammen mit einer gültigen Formel.“"
                                            },
                                            {
                                                "example_id": "53015fcc-9819-46d1-b09f-bcd105be4379",
                                                "sense_id": "f4adf256-83fc-394b-803d-f04c440ec23d",
                                                "text": "„Allein die Bischöfe aber sollen die 831 Getauften an der Stirn mit dem Chrisam bezeichnen, da die Salbung mit diesem nur von Bischöfen gespendet werden darf.“"
                                            },
                                            {
                                                "example_id": "ab7ff713-d590-4234-9a19-d4cf26776891",
                                                "sense_id": "f4adf256-83fc-394b-803d-f04c440ec23d",
                                                "text": "„Viel weniger Aufmerksamkeit widmete man der Salbung mit Chrisam, die ein Zeichen besonderer Berufung ist, wie etwa im Alten Testament der Propheten und Könige.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fea34022-88f3-4f90-b4de-5c3ce8973df3",
                        "source_entry_id": "b03112ad-dc6d-302d-8ddb-83ce7a0df7e6",
