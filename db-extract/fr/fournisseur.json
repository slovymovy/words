        "fr-extract.jsonl": [
            {
                "entry_id": "d7909a79-6e94-3343-9a17-2f82f18c3c98",
                "word": "fournisseur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "426b0e93-363a-4fed-aae3-6320d8ba4971",
                        "entry_id": "d7909a79-6e94-3343-9a17-2f82f18c3c98",
                        "tags": [
                            "plural"
                        ],
                        "form": "fournisseurs"
                    },
                    {
                        "form_id": "40abc798-487e-400b-8e53-033de4132f2b",
                        "entry_id": "d7909a79-6e94-3343-9a17-2f82f18c3c98",
                        "tags": [
                            "feminine"
                        ],
                        "form": "fournisseuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8cb98b7-910f-3f05-b16e-63a98e516148",
                        "entry_id": "d7909a79-6e94-3343-9a17-2f82f18c3c98",
                        "glosses": [
                            "Celui, entreprise ou particulier, qui entreprend de faire la fourniture de marchandises, de denrées ou celui chez qui on se les procure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e93ea839-fe26-458e-8a2d-32feb99a17b4",
                                "sense_id": "a8cb98b7-910f-3f05-b16e-63a98e516148",
                                "text": "Un riche propriétaire, M. Roudier, au visage grassouillet et insinuant, y discourait des heures entières, avec la passion d’un orléaniste que la chute de Louis-Philippe avait dérangé dans ses calculs. C’était un bonnetier de Paris retiré à Plassans, ancien fournisseur de la cour, qui avait fait de son fils un magistrat, comptant sur les Orléans pour pousser ce garçon aux plus hautes dignités."
                            },
                            {
                                "example_id": "fc42e1b7-c8cc-4850-96f1-01910bc0626a",
                                "sense_id": "a8cb98b7-910f-3f05-b16e-63a98e516148",
                                "text": "Je le crois bien, dit Henri, quand on est comme vous le fournisseur de toutes les têtes couronnées de France et de l’étranger."
                            },
                            {
                                "example_id": "5eb9243d-ed70-4905-8d4f-eb9b391e5e25",
                                "sense_id": "a8cb98b7-910f-3f05-b16e-63a98e516148",
                                "text": "Le soir, chacun se récria sur la qualité de ces grosses dattes entourées de sirop. Mounira elle-même les déclara plus exquises que celles des grands fournisseurs."
                            },
                            {
                                "example_id": "96b53b45-a140-4bc3-9476-fb8e9411fe76",
                                "sense_id": "a8cb98b7-910f-3f05-b16e-63a98e516148",
                                "text": "— Un crétin chimiquement pur… je me demande où tu vas le chercher ?\n— Quai des Orfèvres. Je suis fidèle à mes fournisseurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "71a078d4-cfce-3b1c-b595-8e0ae7a81f7c",
                        "entry_id": "d7909a79-6e94-3343-9a17-2f82f18c3c98",
                        "glosses": [
                            "Celui qui fournit et qui monte des sabres, des épées."
                        ],
                        "tags": [
                            "dated",
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cad390c-2bf7-43b6-b148-bb49cb22fc1f",
                        "source_entry_id": "d7909a79-6e94-3343-9a17-2f82f18c3c98",
                        "target_lang_word": "Lieferant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lieferant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2531bebf-5b71-3de4-be6d-6c7db3167d37",
                                        "entry_id": "2c6ab452-4a54-3976-82dc-16ca23026823",
                                        "glosses": [
                                            "Organisation, die eine Ware für jemanden besorgt oder herstellt und gegebenenfalls auch ausliefern lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbce2ba1-6e0b-47b7-b43a-bba1920033c2",
                                                "sense_id": "2531bebf-5b71-3de4-be6d-6c7db3167d37",
                                                "text": "China ist ein wichtiger Lieferant für seltene Erden."
                                            },
                                            {
                                                "example_id": "d30adf47-3cc0-40de-8577-6e6b70bfa435",
                                                "sense_id": "2531bebf-5b71-3de4-be6d-6c7db3167d37",
                                                "text": "Seit April haben die Lieferanten kein Geld mehr gesehen."
                                            },
                                            {
                                                "example_id": "01fff177-dae6-4adf-93cb-dbdb9b58bc7a",
                                                "sense_id": "2531bebf-5b71-3de4-be6d-6c7db3167d37",
                                                "text": "Die Zahl der potentiellen Lieferanten ist nicht so hoch, wie wir uns es erhofften."
                                            },
                                            {
                                                "example_id": "89ecee8a-d09d-47d5-8588-96c646671727",
                                                "sense_id": "2531bebf-5b71-3de4-be6d-6c7db3167d37",
                                                "text": "Die Ersatzteile bezieht unsere Firma überwiegend von ausländischen Lieferanten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "997aa000-6f1d-3896-b630-5fe6a64fd258",
                                        "entry_id": "2c6ab452-4a54-3976-82dc-16ca23026823",
                                        "glosses": [
                                            "Person, welche Waren ausliefert beziehungsweise zustellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9179e7b-2983-473d-9613-dd7463657598",
                                                "sense_id": "997aa000-6f1d-3896-b630-5fe6a64fd258",
                                                "text": "Lieferanten bitte durch den Nebeneingang!"
                                            },
                                            {
                                                "example_id": "73253618-5fcb-4fcc-a217-252acd40e538",
                                                "sense_id": "997aa000-6f1d-3896-b630-5fe6a64fd258",
                                                "text": "Der Lieferant wartet draußen, er möchte gerne noch eine Unterschrift auf der Kopie."
                                            },
                                            {
                                                "example_id": "4f15c2f8-824f-4d9b-8f3e-ae66e4ab5190",
                                                "sense_id": "997aa000-6f1d-3896-b630-5fe6a64fd258",
                                                "text": "„Unten stand ein Schlitten neben dem Eingang für Lieferanten und Dienstboten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec7819a4-2913-4f24-9182-4dc55c56ef97",
                        "source_entry_id": "d7909a79-6e94-3343-9a17-2f82f18c3c98",
                        "target_lang_word": "Zulieferer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zulieferer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c831cdd-c5b4-3980-84e4-6115ec65bd07",
                                        "entry_id": "04359e84-d21c-3bd9-bcb2-d6f65d25d72a",
                                        "glosses": [
                                            "Betrieb (oder auch Person), der anderen Betrieben Vorprodukte zur Weiterverarbeitung liefert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "527f5fbb-e2b6-4359-a701-a1feb2fcfd97",
                                                "sense_id": "1c831cdd-c5b4-3980-84e4-6115ec65bd07",
                                                "text": "Autofirmen erhalten viele Bauteile für die Endmontage ihrer Fahrzeuge von Zulieferern."
                                            },
                                            {
                                                "example_id": "19f6cd18-1723-430e-a665-01092c9c010e",
                                                "sense_id": "1c831cdd-c5b4-3980-84e4-6115ec65bd07",
                                                "text": "„Von der schweren Automobilkrise betroffen sind vor allem Sachsen und Thüringen, wo in den vergangenen Jahren eine umfangreiche Automobilindustrie einschließlich vieler Zulieferer entstanden ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "261d4680-d71a-4f75-a8e2-e6b67bc6946c",
                        "source_entry_id": "d7909a79-6e94-3343-9a17-2f82f18c3c98",
                        "target_lang_word": "supplier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supplier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5f56d3a-d87b-385d-8d8e-ff4511aabead",
                                        "entry_id": "0ca8105c-1b84-3e88-b29c-bf2ac0e20dc9",
                                        "glosses": [
                                            "One who supplies; a provider."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "440f323d-6d68-401e-92ae-80aceb40c911",
                                                "sense_id": "e5f56d3a-d87b-385d-8d8e-ff4511aabead",
                                                "text": "A farmer could place an order for a new tractor part by text message and pay for it by mobile money-transfer. A supplier many miles away would then take the part to the local matternet station for airborne dispatch via drone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1138d01b-0139-3bdc-aeb4-3ce49beb6bc7",
                                        "entry_id": "0ca8105c-1b84-3e88-b29c-bf2ac0e20dc9",
                                        "glosses": [
                                            "Someone who assists (sets up) a goal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea4c8a3f-3323-4190-8532-d63cddeb86c3",
                                                "sense_id": "1138d01b-0139-3bdc-aeb4-3ce49beb6bc7",
                                                "text": "Regular supplier Barton played in another teasing corner, which was headed on towards goal by the impressive Ameobi and flicked in by expert poacher Nolan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5c835e1-4b13-4dd7-9354-3be5266de62f",
                        "source_entry_id": "d7909a79-6e94-3343-9a17-2f82f18c3c98",
                        "target_lang_word": "provider",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "provider",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                        "entry_id": "3837f502-8bb0-3b27-ad24-5fbdb9d223fc",
                                        "glosses": [
                                            "One who, or that which, provides a service, commodity, or the means for subsistence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9590e751-3c32-4dd2-98cd-60ed31ae9d69",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "In view of this, it is clear why internet service providers (ISPs) are inclined to play a backbench role when it comes to combating file sharing."
                                            },
                                            {
                                                "example_id": "39a52648-d6d9-4a32-a159-54b067de78d8",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "Using BLE, a merchant or other provider can define more targeted \"micro-locations\" to trigger an alert, in some cases requiring that you be in the presence of an iBeacon in order to validate a Passbook entry."
                                            },
                                            {
                                                "example_id": "c47927e8-660e-4c92-943a-a7431b57ca84",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "Even if policy shifts resources away from hard investment and back into social spending, the \"Floridization\" of Chinese demographics will intensify the shortage of healthcare provision over the next decade, worsening the frayed contract between patients, providers, and the government."
                                            },
                                            {
                                                "example_id": "d7205103-73a7-4e4f-bf15-2fcfb087dd4e",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "A part of the nervousness at Chelsea involves whether any more sponsors will follow the telecommunications and internet service provider Three in withdrawing support, at least temporarily."
                                            },
                                            {
                                                "example_id": "c15f9fbb-fd47-449e-9a7a-c12e7642c0b4",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "Both switching costs and network effects tend to lead to enshittification because platform providers see early adopters as an investment in future profits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
