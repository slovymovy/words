        "fr-extract.jsonl": [
            {
                "entry_id": "055caf32-e16a-3696-bfc0-f283f105ffe3",
                "word": "ressentéisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "86faf798-9cd3-37a0-93e2-298411389cf8",
                        "entry_id": "055caf32-e16a-3696-bfc0-f283f105ffe3",
                        "glosses": [
                            "État dans lequel les travailleurs continuent à occuper leurs emplois tout en étant désengagés émotionnellement et en ressentant une déconnexion de leur travail. Cela se caractérise par un manque de motivation, une fatigue accrue et une perte d'intérêt pour les tâches professionnelles."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "80081f5d-22c9-445a-afb2-b564269626e5",
                                "sense_id": "86faf798-9cd3-37a0-93e2-298411389cf8",
                                "text": "Malgré son assiduité au bureau, sa productivité a chuté ces derniers mois en raison d'un fort ressentéisme. Il se sent complètement déconnecté de son travail, sans motivation ni satisfaction."
                            },
                            {
                                "example_id": "d1cfef5a-c5e5-4b9c-9425-ba3de0804d96",
                                "sense_id": "86faf798-9cd3-37a0-93e2-298411389cf8",
                                "text": "Les signes de ressentéisme sont de plus en plus visibles dans l'entreprise : les employés semblent présents physiquement, mais ils sont mentalement absents, ce qui se traduit par une baisse de productivité et une ambiance morose au bureau."
                            },
                            {
                                "example_id": "987f278c-9f1e-4276-9fc7-91cde8186ee3",
                                "sense_id": "86faf798-9cd3-37a0-93e2-298411389cf8",
                                "text": "Bullshit job, burn-out, management algorithmique, ressentéisme, ubérisation, etc."
                            }
                        ]
                    }
                ],
