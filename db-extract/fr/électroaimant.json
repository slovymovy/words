                    {
                        "sense_id": "a824c186-e04b-3d03-b396-7095229d4e4c",
                        "entry_id": "d72bd949-603c-3bac-9e96-c8eb54b31a1e",
                        "glosses": [
                            "Organe électrotechnique produisant un champ magnétique lorsqu’il est alimenté en électricité."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "8acf7c91-3959-499d-b224-a4226f1a64d4",
                                "sense_id": "a824c186-e04b-3d03-b396-7095229d4e4c",
                                "text": "Le circuit comprend un manipulateur, une pile et un électroaimant."
                            },
                            {
                                "example_id": "6e294d87-5a93-48a5-aa04-5d10b16beadc",
                                "sense_id": "a824c186-e04b-3d03-b396-7095229d4e4c",
                                "text": "Nous sommes auprès du gigantesque anneau du synchrophasotron de l’Institut unifié des recherches nucléaires à Doubno. L’électroaimant de ce géant, qui occupe un immense édifice cylindrique rappelant un cirque, pèse 36.000 tonnes."
                            },
                            {
                                "example_id": "6603a359-0e11-4a8d-a13c-cb9b00546f6d",
                                "sense_id": "a824c186-e04b-3d03-b396-7095229d4e4c",
                                "text": "Des aimants supraconducteurs remplacent les essieux et des électroaimants sont placés sur les voies."
                            }
                        ]
                    }
                ],
