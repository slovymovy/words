                "senses": [
                    {
                        "sense_id": "6e02cf9b-0f75-3038-a73d-34c7d9957d93",
                        "entry_id": "43ce883e-0bbb-38e1-a82e-6af18382f5d3",
                        "glosses": [
                            "süße Milchspeise, in der Reis enthalten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f023266-1334-44b9-aac0-c06a35a6e552",
                                "sense_id": "6e02cf9b-0f75-3038-a73d-34c7d9957d93",
                                "text": "„Die Luft war schwer von Feuchtigkeit, sodass die Krähe, obwohl sie den ganzen Tag flog, ohne anzuhalten, nicht einmal Durst bekam. Die Nacht verbrachte sie an einer Grenzstation zwischen Indien und Pakistan, wo sie sich an einem Tontopf mit Reispudding labte, den die Soldaten zum Abkühlen in einem Korb an eine Wäscheleine gehängt hatten.“"
                            },
                            {
                                "example_id": "a7cd946e-8b02-407f-ab65-5125b764ebc9",
                                "sense_id": "6e02cf9b-0f75-3038-a73d-34c7d9957d93",
                                "text": "„Er hatte sich vier kleine Fläschchen Jameson besorgt, ein paar Äpfel und Birnen und dazu einen großen Plastikbecher kalten Reispudding.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
