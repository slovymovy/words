                ],
                "senses": [
                    {
                        "sense_id": "da23c4fa-7e6c-3992-9189-c69c34adcbd1",
                        "entry_id": "6cb38f06-1a93-306c-9582-8833d581c9af",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9654d14-0b00-4471-a6eb-1dbf868cf720",
                                "sense_id": "da23c4fa-7e6c-3992-9189-c69c34adcbd1",
                                "text": "Die Hillebrands fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "ff8587b5-2067-4205-a15d-aa7772c8aab4",
                                "sense_id": "da23c4fa-7e6c-3992-9189-c69c34adcbd1",
                                "text": "Frau Hillebrand ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4b10ba3a-09f8-4e26-ac59-65f80a3b38cc",
                                "sense_id": "da23c4fa-7e6c-3992-9189-c69c34adcbd1",
                                "text": "Herr Hillebrand wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0f512842-7091-4aa1-aa2f-243887261373",
                                "sense_id": "da23c4fa-7e6c-3992-9189-c69c34adcbd1",
                                "text": "Der Hillebrand trägt nie die Pullover, die die Hillebrand ihm strickt."
                            },
                            {
                                "example_id": "c9e5334f-051b-4200-8537-728ed6a3aa67",
                                "sense_id": "da23c4fa-7e6c-3992-9189-c69c34adcbd1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hillebrand kommt, geht der Herr Hillebrand.“"
                            },
                            {
                                "example_id": "06634bbf-e50c-4cb5-8087-37c5e192ba54",
                                "sense_id": "da23c4fa-7e6c-3992-9189-c69c34adcbd1",
                                "text": "Hillebrand kommt und geht."
                            },
                            {
                                "example_id": "654ea4b0-0e52-4003-91e8-dd8174eb0bfb",
                                "sense_id": "da23c4fa-7e6c-3992-9189-c69c34adcbd1",
                                "text": "Hillebrands kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
