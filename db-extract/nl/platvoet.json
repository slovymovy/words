                        "translation_id": "fe34130d-0357-46b0-a0ca-d1c2f94a6ef3",
                        "source_entry_id": "52d9f0cf-aaf6-333a-8006-e6083c15c123",
                        "target_lang_word": "pied plat",
                        "target_lang_code": "fr",
