                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cffaa518-ea81-39a9-b5f7-938e30c2a477",
                                        "entry_id": "6d40a72d-e5f1-3e5b-843b-40e67ebf634a",
                                        "glosses": [
                                            "Any material on the page other than the body text and pictures of articles; for example, headlines, datelines and dinkuses, lines and symbols (though in earlier use, only non-text elements of page design, such as lines and symbols)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28f85453-c078-4c8b-b986-67ac03ce48a4",
                                                "sense_id": "cffaa518-ea81-39a9-b5f7-938e30c2a477",
                                                "text": "It read: “This article was amended on 3 January 2023. The original furniture said the fireworks display was on Christmas Eve.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee599e7c-0533-3e4b-a1db-26bfc6d8b8d8",
                                        "entry_id": "6d40a72d-e5f1-3e5b-843b-40e67ebf634a",
                                        "glosses": [
                                            "A type of mixture organ stop."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
