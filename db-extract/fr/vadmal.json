                        "glosses": [
                            "Tissu de laine, traditionnel des pays scandinaves."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "165b08ce-cee3-4594-afac-5f03f4b704ad",
                                "sense_id": "2f3a4834-389e-3f6f-91c1-60e2b2fc8775",
                                "text": "L’habillement des Islandais, ou du commun de la nation, est assez semblable à celui de nos matelots. Il consiste, pendant l’été, en une veste et une culotte de toile; et pendant l’hiver, l’une et l’autre sont de vadmal."
                            },
                            {
                                "example_id": "27fad83e-a3ff-4d63-8d0c-963d96048dff",
                                "sense_id": "2f3a4834-389e-3f6f-91c1-60e2b2fc8775",
                                "text": "On peut se procurer à Reykjavik la tente en usage chez les Islandais : elle est faite de l’étoffe du pays appelée vadmal, et se fixe sur deux montants d’un mètre de haut. Cette tente peut abriter trois personnes."
                            }
                        ]
                    }
