            "senses": [
                {
                    "sense_id": "84fb5b80-31d4-37e9-88d1-96364ad0adc8",
                    "sense_definition": "Rendre dur ou solide.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "solidification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le froid intense a <w>durci</w> le sol du jardin en quelques heures.",
                            "target_lang_translations": {
                                "en": "The intense cold <w>hardened</w> the garden soil in a few hours.",
                                "ru": "Сильный мороз за несколько часов <w>сковал</w> землю в саду.",
                                "de": "Die starke Kälte hat den Gartenboden in wenigen Stunden <w>verhärtet</w>.",
                                "es": "El frío intenso <w>endureció</w> el suelo del jardín en unas pocas horas.",
                                "zh": "严寒在几个小时内就把花园里的土地<w>冻硬</w>了。"
                            }
                        },
                        {
                            "text": "Le forgeron plonge la lame rougie dans l'eau froide pour la <w>durcir</w>.",
                            "target_lang_translations": {
                                "en": "The blacksmith plunges the red-hot blade into cold water to <w>harden</w> it.",
                                "ru": "Кузнец опускает раскалённый клинок в холодную воду, чтобы его <w>закалить</w>.",
                                "de": "Der Schmied taucht die glühende Klinge in kaltes Wasser, um sie zu <w>härten</w>.",
                                "es": "El herrero sumerge la hoja al rojo vivo en agua fría para <w>endurecerla</w>.",
                                "zh": "铁匠把烧红的刀刃浸入冷水中<w>淬火</w>，使其变硬。"
                            }
                        }
                    ],
                    "synonyms": [
                        "solidifier"
                    ],
                    "antonyms": [
                        "ramollir"
                    ],
                    "common_phrases": [
                        "durcir la pâte",
                        "durcir le métal"
                    ],
                    "target_lang_definitions": {
                        "en": "To make something hard or solid.",
                        "ru": "Делать что-либо твёрдым или прочным.",
                        "de": "Etwas hart oder fest machen.",
                        "es": "Hacer que algo sea duro o sólido.",
                        "zh": "使某物变硬或变得坚固。"
                    },
                    "translations": {
