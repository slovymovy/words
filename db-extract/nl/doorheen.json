                                        "examples": [
                                            {
                                                "example_id": "98241345-2013-4491-aa74-b026e64da3b6",
                                                "sense_id": "a2975b61-b241-3516-8eec-cecae14d42ae",
                                                "text": "Смотреть сквозь дверную щель."
                                            },
                                            {
                                                "example_id": "695fa1e9-e5a8-4aa1-a07f-93987235b701",
                                                "sense_id": "a2975b61-b241-3516-8eec-cecae14d42ae",
                                                "text": "Сквозь волнистые туманы пробирается луна."
                                            },
                                            {
                                                "example_id": "bb7fb832-d1b8-4b16-8497-d98463f9a967",
                                                "sense_id": "a2975b61-b241-3516-8eec-cecae14d42ae",
                                                "text": "Продрался сквозь густую толпу народа."
                                            },
                                            {
                                                "example_id": "72b4eefd-77a1-4ce2-8e76-482f5aff400e",
                                                "sense_id": "a2975b61-b241-3516-8eec-cecae14d42ae",
                                                "text": "Порой сквозь тучи выглянет луна."
                                            },
                                            {
                                                "example_id": "beb0cc68-caa5-4d1a-9d5e-cb23092695ff",
                                                "sense_id": "a2975b61-b241-3516-8eec-cecae14d42ae",
                                                "text": "Мне бы жить и жить, сквозь годы мчась."
                                            },
                                            {
                                                "example_id": "d0c6ec88-6aec-4805-88a8-0d13acbb1dd6",
                                                "sense_id": "a2975b61-b241-3516-8eec-cecae14d42ae",
                                                "text": "И долго, будто сквозь тумана, она глядела им вослед."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f4f5f94-b66b-3e37-a6fd-76c7ed1c0659",
                                        "entry_id": "dc07343b-320b-317c-9f5e-951a21df2d5b",
                                        "glosses": [
                                            "обозначает действие или состояние, которое подавляется другим действием или состоянием или сопровождает его"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ba059d0-e6e3-4f3d-829a-310578c3e9ff",
                                                "sense_id": "7f4f5f94-b66b-3e37-a6fd-76c7ed1c0659",
                                                "text": "Проговорить что-л. сквозь кашель."
                                            },
                                            {
                                                "example_id": "50922970-7dc3-402c-bd0c-c53d56b260c1",
                                                "sense_id": "7f4f5f94-b66b-3e37-a6fd-76c7ed1c0659",
