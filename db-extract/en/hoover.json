                            "third-person"
                        ],
                        "form": "Hoovers"
                    },
                    {
                        "form_id": "c1546fb4-9572-4a97-b2d5-f6dc0d3df3bb",
                        "entry_id": "4d51d14f-e541-3793-b57c-0665e58051d9",
                        "tags": [
                            "participle",
                            "present"
                        ],
                        "form": "Hoovering"
                    },
                    {
                        "form_id": "4d14f0bf-386e-4e0e-a530-16f0fcf444a2",
                        "entry_id": "4d51d14f-e541-3793-b57c-0665e58051d9",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "Hoovered"
                    },
                    {
                        "form_id": "ba7076ce-0265-420b-acbe-98da86bcfa3e",
                        "entry_id": "4d51d14f-e541-3793-b57c-0665e58051d9",
                        "tags": [
                            "past"
                        ],
                        "form": "Hoovered"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1d3b07c1-e1dc-3121-a3f0-4f7102064aba",
                        "entry_id": "4d51d14f-e541-3793-b57c-0665e58051d9",
                        "glosses": [
                            "Alternative letter-case form of hoover."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "ec32ace8-9174-443a-af4b-d04c161eede9",
                                "sense_id": "1d3b07c1-e1dc-3121-a3f0-4f7102064aba",
                                "text": "I helped Mum tidy up and watched while she Hoovered the carpet."
                            },
                            {
                                "example_id": "c03c3113-224b-4a3f-bf9a-8e984fc4bb23",
                                "sense_id": "1d3b07c1-e1dc-3121-a3f0-4f7102064aba",
                                "text": "After another hour, I had Hoovered the carpet and emptied the dustbin, and we all sat down to watch vintage home movies."
                            },
                            {
                                "example_id": "fd511f38-7c8b-4936-8ad6-984c19596819",
                                "sense_id": "1d3b07c1-e1dc-3121-a3f0-4f7102064aba",
                                "text": "He was left with a pounding headache and a mouth that tasted as if it had Hoovered the carpet."
                            },
                            {
                                "example_id": "d9a4724f-eb7f-413c-97b1-a5e8d5a3f9f3",
                                "sense_id": "1d3b07c1-e1dc-3121-a3f0-4f7102064aba",
                                "text": "I’d also picked up all the clothes and junk from my bedroom floor, and—for the first time ever—“Hoovered” the carpet without being asked."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b0b3b782-ff8b-3e64-81c5-9ecfe358d6f2",
                "word": "hoover",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a9ecab13-e024-494e-83ec-9767bdd94796",
                        "entry_id": "b0b3b782-ff8b-3e64-81c5-9ecfe358d6f2",
                        "tags": [
                            "present",
                            "singular",
