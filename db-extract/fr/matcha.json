                                        "glosses": [
                                            "Japanse groene thee die tot poeder is vermalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fd04ff7-a6ed-4ebf-90c8-87646621893a",
                                                "sense_id": "b51bc546-d9a6-343b-a5c7-4535b8b59960",
                                                "text": "In het pastelkleurige interieur van de eerste matchabar van Nederland, in de Albert Cuypstraat in Amsterdam, roert de barista – of hoe noem je zo iemand in een theebar? – een beetje heet water in een kommetje met een bamboe kloppertje door een groen poeder. Het is matcha, poeder van groene thee. Als het een egaal prutje is, gaat er warme melk bij, en tapiocaparels, glibberige balletjes van cassavezetmeel. Niet alleen de bubble milk tea, ook alle patisserie wordt hier met matcha gemaakt."
                                            }
                                        ]
