                                "target_senses": [
                                    {
                                        "sense_id": "6c006475-a0ae-395e-8039-fe4590a85164",
                                        "entry_id": "dabbcaaf-3e91-3b8f-b0d9-4be7fe428ba0",
                                        "glosses": [
                                            "w kalendarzu chrześcijańskim dzień poprzedzający ważniejsze święto, zwłaszcza Boże Narodzenie, często połączony z postem i uroczystym oczekiwaniem"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "62d2c10d-b86e-3ee3-a458-c64312033b7d",
                                        "entry_id": "dabbcaaf-3e91-3b8f-b0d9-4be7fe428ba0",
                                        "glosses": [
                                            "dzień poprzedzający inny dzień, zwykle jakieś święto lub ważne wydarzenie"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc5b3b5d-1097-4525-b51a-cc5698edf23e",
                                                "sense_id": "62d2c10d-b86e-3ee3-a458-c64312033b7d",
                                                "text": "Była to wigilia Bożego Narodzenia. Z ulicy dochodził gwar ludzki i brzęczenie dzwonków przy sankach"
                                            },
                                            {
                                                "example_id": "68181007-fb78-4284-b132-537184b92114",
                                                "sense_id": "62d2c10d-b86e-3ee3-a458-c64312033b7d",
                                                "text": "Tymczasem przyszła wigilia Trzech Króli…Wieczór był mroźny, pogodny"
                                            },
                                            {
                                                "example_id": "5705ea57-74e3-4985-a84d-36a8abcc46ad",
                                                "sense_id": "62d2c10d-b86e-3ee3-a458-c64312033b7d",
                                                "text": "Wigilię zwaną przez Izraelitów wieczorem obchodzono przed każdą uroczystością jako jej początek"
                                            },
                                            {
                                                "example_id": "9474aae9-26fa-4c52-8f30-f109503471c7",
                                                "sense_id": "62d2c10d-b86e-3ee3-a458-c64312033b7d",
                                                "text": "Były to obrzędy mające na celu wypędzenie czarownic, gdyż wierzono, że w wigilię Zielonych Świątek są one bardzo aktywne"
                                            },
                                            {
                                                "example_id": "72a6207b-f5f8-49d8-b776-a86d3cb0480b",
                                                "sense_id": "62d2c10d-b86e-3ee3-a458-c64312033b7d",
                                                "text": "Na Kurpiach, Podlasiu, Warmii i Mazurach wypiekano w wigilię Nowego Roku lub w święto Trzech Króli figurki zwierząt"
                                            },
                                            {
                                                "example_id": "a921b6da-3751-486e-8eed-b5e6fa625cdb",
                                                "sense_id": "62d2c10d-b86e-3ee3-a458-c64312033b7d",
                                                "text": "W wigilię własnego ślubu miał poważny wypadek samochodowy, z którego udało mu się wyjść bez szwanku."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "6ce41289-55e9-33e3-a31c-8ca4080c1f3b",
                                        "entry_id": "dabbcaaf-3e91-3b8f-b0d9-4be7fe428ba0",
                                        "glosses": [
                                            "tradycyjna, uroczysta wieczerza w wigilię (1.1) Bożego Narodzenia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f876193-7e2b-44fb-958d-ea21d0363100",
                                                "sense_id": "6ce41289-55e9-33e3-a31c-8ca4080c1f3b",
                                                "text": "Jedliśmy wigilię, kiedy zadzwonił wujek z życzeniami."
                                            },
                                            {
                                                "example_id": "7d6dfb82-fb15-4739-bb3e-7dfcb49ad61d",
                                                "sense_id": "6ce41289-55e9-33e3-a31c-8ca4080c1f3b",
                                                "text": "W Wigilię (czyli 24 grudnia) jesteśmy zaproszeni na wigilię do rodziców"
                                            },
                                            {
                                                "example_id": "e9777d7c-75f1-4e64-bc10-915e6a9bc215",
                                                "sense_id": "6ce41289-55e9-33e3-a31c-8ca4080c1f3b",
                                                "text": "Przychodzili tam różni znajomi, witali się, zamieniali po kilka słów obojętnych i odchodzili; on siedział wciąż, bo miał jakąś ukrytą na dnie serca nadzieję, że może go który zaprosi do siebie na wigilię – ale nikt nie prosił"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "cc0813d6-1404-3ba5-a1ab-2eab7b582307",
                                        "entry_id": "dabbcaaf-3e91-3b8f-b0d9-4be7fe428ba0",
                                        "glosses": [
                                            "w starożytnym Rzymie: część nocy równa trzem godzinom"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fa01a6e-7f3e-49b8-9650-e1e8d74b1b99",
                                                "sense_id": "cc0813d6-1404-3ba5-a1ab-2eab7b582307",
                                                "text": "Rzymianie dzielili noc na cztery wigilie, tzw. straże."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "09647950-811d-3d3b-85a3-a855b23c9fbb",
                                        "entry_id": "dabbcaaf-3e91-3b8f-b0d9-4be7fe428ba0",
                                        "glosses": [
                                            "lm wigilie: modlitwa za zmarłych; nabożeństwo żałobne"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9465c48c-4b03-44f2-ab11-8fcb5e57b147",
                                                "sense_id": "09647950-811d-3d3b-85a3-a855b23c9fbb",
                                                "text": "Po odśpiewaniu wigilii i dość długiem nabożeństwie, ukazały się we drzwiach poprzedzone krzyżem białe komże księży, za którymi wyniesiono trumnę"
                                            },
                                            {
                                                "example_id": "ec9e4b57-0143-424e-8d71-f00a8a37eee0",
                                                "sense_id": "09647950-811d-3d3b-85a3-a855b23c9fbb",
                                                "text": "Baba przyjmowała dziecię, baba obmywała starca, gdy umarł, kładła go w trumnie i śpiewała nad nim wigilie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    }
                                ]
                            }
                        ]
                    },
