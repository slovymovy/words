                        "form": "bijections"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba4c1843-ea4e-334d-a921-572e2fc3cc73",
                        "entry_id": "df3ee80d-f715-3bf3-8dc5-773427b3dd8a",
                        "glosses": [
                            "Application à la fois surjective et injective."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2816ab86-23bd-43d3-b450-c39020eead27",
                                "sense_id": "ba4c1843-ea4e-334d-a921-572e2fc3cc73",
                                "text": "Une bijection est une application d'un ensemble sur un autre qui s'applique exactement une fois sur chacun des éléments du deuxième ensemble."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e45b44f5-3b2a-4d23-a75c-b39f3ecc3f4a",
                        "source_entry_id": "df3ee80d-f715-3bf3-8dc5-773427b3dd8a",
                        "source_sense_id": "ba4c1843-ea4e-334d-a921-572e2fc3cc73",
                        "target_lang_word": "Bijektion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "963f21cd-f6a3-4371-a646-58240e362daf",
                        "source_entry_id": "df3ee80d-f715-3bf3-8dc5-773427b3dd8a",
                        "source_sense_id": "ba4c1843-ea4e-334d-a921-572e2fc3cc73",
                        "target_lang_word": "one-to-one correspondence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e6c9eaa1-acf3-4630-8e3b-ca7f95781d12",
                        "source_entry_id": "df3ee80d-f715-3bf3-8dc5-773427b3dd8a",
                        "source_sense_id": "ba4c1843-ea4e-334d-a921-572e2fc3cc73",
                        "target_lang_word": "bijection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bijection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acc70e86-3175-30b5-bed4-6e01bec74b4c",
                                        "entry_id": "19609f95-24b1-37e8-a9db-2f9fb7f52014",
                                        "glosses": [
                                            "A one-to-one correspondence, a function which is both a surjection and an injection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a81cb10e-d410-429e-91a1-d2bde4f4de0f",
                                                "sense_id": "acc70e86-3175-30b5-bed4-6e01bec74b4c",
                                                "text": "The present text has defined a set to be finite if and only if there exists a bijection onto a natural number, and infinite if and only if there does not exist any such bijection."
                                            },
                                            {
                                                "example_id": "0d9f8643-741f-4e4f-b2df-d59a1d200b79",
                                                "sense_id": "acc70e86-3175-30b5-bed4-6e01bec74b4c",
                                                "text": "Note in particular that a function is a bijection if and only if it's both an injection and a surjection."
                                            },
                                            {
                                                "example_id": "6b703637-a084-467b-9ad3-cda661f5c1db",
                                                "sense_id": "acc70e86-3175-30b5-bed4-6e01bec74b4c",
                                                "text": "The basic idea is that two sets A and B have the same cardinality if there is a bijection from A to B. Since the domain and range of the bijection is not relevant here, we often refer to a bijection from A to B as a bijection between the sets, or a one-to-one correspondence between the elements of the sets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
