                        ]
                    },
                    {
                        "translation_id": "e0e1db1b-3f3e-4b77-911a-d7291f8b7f97",
                        "source_entry_id": "4b218454-5cb4-3d30-8613-5de07c741383",
                        "source_sense_id": "2c54216a-92a4-3658-b8ed-0c4070b16304",
                        "source_sense_description": "United Republic of Tanzania",
                        "target_lang_word": "Tanzanie",
                        "target_lang_code": "fr",
