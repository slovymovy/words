                "senses": [
                    {
                        "sense_id": "0d55cb23-27ac-31bf-935c-f4edc647bddf",
                        "entry_id": "53c7656a-b59a-30bd-9877-33ee12527b62",
                        "glosses": [
                            "Liste aller getätigten Suchanfragen mit einer Suchmaschine"
