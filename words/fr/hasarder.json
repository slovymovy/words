{
    "word_family": [
        "hasard",
        "hasardeux",
        "hasardeusement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "82ed2c59-9079-3d68-99fb-92485bd84174",
                    "sense_definition": "Mettre en danger, exposer à un risque ou à la chance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "risquer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sauveteur a dû <w>hasarder</w> sa vie pour secourir les deux enfants emportés par le courant marin."
                        },
                        {
                            "text": "Il refuse d'<w>hasarder</w> toutes ses économies dans une affaire aussi douteuse."
                        }
                    ],
                    "synonyms": [
                        "risquer",
                        "exposer",
                        "compromettre",
                        "aventurer"
                    ],
                    "antonyms": [
                        "épargner",
                        "protéger",
                        "préserver"
                    ],
                    "common_phrases": [
                        "hasarder sa vie",
                        "hasarder son argent"
                    ]
                },
                {
                    "sense_id": "464b861a-e919-3831-b13e-f9cffb7f6a59",
                    "sense_definition": "Avancer ou proposer avec timidité ou précaution, pour observer la réaction d'autrui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "proposer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant le débat silencieux, un collègue <w>hasarda</w> une hypothèse originale que tout le monde approuva."
                        },
                        {
                            "text": "Elle <w>hasarde</w> un timide sourire dans l'espoir de détendre l'atmosphère pesante de la pièce."
                        }
                    ],
                    "synonyms": [
                        "avancer",
                        "suggérer",
                        "émettre",
                        "glisser"
                    ],
                    "antonyms": [
                        "taire",
                        "taire"
                    ],
                    "common_phrases": [
                        "hasarder une hypothèse",
                        "hasarder une remarque",
                        "hasarder une explication"
                    ]
                },
                {
                    "sense_id": "57f08375-acec-3025-b406-ec8265b7f675",
                    "sense_definition": "Prendre le risque d'aller quelque part ou d'entreprendre une action incertaine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Personne n'osait se <w>hasarder</w> dehors pendant cette tempête de neige sans équipement adapté."
                        },
                        {
                            "text": "Après un long silence, le jeune étudiant se <w>hasarda</w> enfin à poser sa question au professeur."
                        }
                    ],
                    "synonyms": [
                        "s'aventurer",
                        "oser"
                    ],
                    "antonyms": [
                        "s'abstenir",
                        "renoncer"
                    ],
                    "common_phrases": [
                        "se hasarder dehors",
                        "se hasarder à parler"
                    ]
                }
            ]
        }
    ]
}