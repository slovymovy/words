        "fr-extract.jsonl": [
            {
                "entry_id": "451f0ed1-0b23-3106-82b8-5043e593e3cb",
                "word": "be-bop",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "baf3ba27-76f5-308a-8158-668b7dda8745",
                        "entry_id": "451f0ed1-0b23-3106-82b8-5043e593e3cb",
                        "glosses": [
                            "Style de jazz qui est né et a prospéré dans les années 1940 et 1950."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02811c36-c970-49dd-bda7-1154d994b0db",
                                "sense_id": "baf3ba27-76f5-308a-8158-668b7dda8745",
                                "text": "En 1975, les vagues de choc du be-bop étaient suffisamment lointaines pour pouvoir revenir sous une forme bénigne et inoffensive, et pour la première fois, le be-bop devint à la mode, un peu de la même façon que Picasso, considéré comme un iconoclaste en 1935, devint en 1970 le grand classique du XXᵉ siècle."
                            },
                            {
                                "example_id": "26081696-77b7-4171-939a-df1b4ef247bc",
                                "sense_id": "baf3ba27-76f5-308a-8158-668b7dda8745",
                                "text": "— Chef de file du mouvement zazou, Charles Trenet n’adhérera pas pour autant à la révolution be-bop qui déferle à la Libération."
                            }
                        ]
                    },
                    {
                        "sense_id": "782a7268-c37e-3a94-80b9-89731cdb104e",
                        "entry_id": "451f0ed1-0b23-3106-82b8-5043e593e3cb",
                        "glosses": [
                            "Danse de jazz en couple née dans les caves de Saint-Germain-des-Prés à Paris après la Libération entre 1945/46."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c372a69-f123-4e4e-9e7f-96ac53aa2db9",
                                "sense_id": "782a7268-c37e-3a94-80b9-89731cdb104e",
                                "text": "– Vous connaissez le be-bop ? me demande Christian.\nLe be-bop ? Non ! Mais je dis oui, et tant pis pour moi, parce que je suis trompée tout le temps, […] et je n’arrêtais pas de cogner ses pieds avec les miens."
                            },
                            {
                                "example_id": "a263880b-f5a1-455e-bc72-a1bd55196ae1",
                                "sense_id": "782a7268-c37e-3a94-80b9-89731cdb104e",
                                "text": "D’abord il vous faut un béret grenat\nDes souliers plats\nEt des cols bas\nPour être be-bop"
                            },
                            {
                                "example_id": "6918ac92-a964-4115-a28e-c67daeea8a36",
                                "sense_id": "782a7268-c37e-3a94-80b9-89731cdb104e",
                                "text": "Ici, M’sieurs Dames\nÀ Saint-Germain-des-Prés\nTout l’ monde danse le vrai be-bop\nUne, deux, trois, hop !\nOn se télescope\nÇa devient un match de catch […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0bff576b-85b3-41c0-8e13-b6444e3e9d86",
                        "source_entry_id": "451f0ed1-0b23-3106-82b8-5043e593e3cb",
                        "source_sense_description": "Style musical",
                        "target_lang_word": "bebop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bebop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a2e4e07-bec3-3688-9816-795671325003",
                                        "entry_id": "257e8f69-0d9e-31f8-af33-bd0690d0768e",
                                        "glosses": [
                                            "An early form of modern jazz played by small groups and featuring driving rhythms and complex, often dissonant harmonies."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bebop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c40658ff-2e30-3cbe-9cb8-979d557ba4ae",
                                        "entry_id": "2c9f5bae-14e0-338b-b83b-fb96fc660d8c",
                                        "glosses": [
                                            "To participate in bebop jazz, such as by dancing in a way associated with the genre."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "150f80bc-6780-4a79-be32-53f704e8777e",
                                                "sense_id": "c40658ff-2e30-3cbe-9cb8-979d557ba4ae",
                                                "text": "Six months into their career, the Clash already showed themselves the equal of any rock band that had come before them, simply by assaulting the last frontier of rock mythology: the notion that the rock audience, like some sort of bebopping proletariat, was a receptacle of goodness and hope, and that rock 'n' roll offered redemption."
                                            },
                                            {
                                                "example_id": "532114cd-188d-40f4-9e34-222ee6bd4351",
                                                "sense_id": "c40658ff-2e30-3cbe-9cb8-979d557ba4ae",
                                                "text": "“The studios think we are having a horrible time out here,” said Richard Potter, a screenwriter who made “Strike Dancing,” a YouTube video showing pickets bebopping in formation to “Play That Funky Music.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38a8c521-8dd7-30e7-a7e5-6306f3f6c692",
                                        "entry_id": "2c9f5bae-14e0-338b-b83b-fb96fc660d8c",
                                        "glosses": [
                                            "To walk in an easygoing, carefree manner."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e50d5241-4458-48ec-ad85-ab4221964df9",
                                                "sense_id": "38a8c521-8dd7-30e7-a7e5-6306f3f6c692",
                                                "text": "Typically one could spot Chet bebopping down the sidewalk in an Amish hat, or hunched over a cafeteria table discussing Calvinism or the Vietnam war."
                                            },
                                            {
                                                "example_id": "4bdfbe1c-7b39-45ce-ab0d-28f450f1177d",
                                                "sense_id": "38a8c521-8dd7-30e7-a7e5-6306f3f6c692",
                                                "text": "I can't even say it was the people who board and casually whack off the top of your head with their slung-over-the-shoulder carry-ons as they obliviously bebop down the aisle to locate their seats."
                                            },
                                            {
                                                "example_id": "f0dc4efe-d3b3-4e42-9ed3-83c9a2e4ba49",
                                                "sense_id": "38a8c521-8dd7-30e7-a7e5-6306f3f6c692",
                                                "text": "Summer bebopped over, holding a cup of spiked punch in each hand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
