        "fr-extract.jsonl": [
            {
                "entry_id": "b9382e4a-5328-335f-8c42-3437e3d7c848",
                "word": "helvétique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7525d417-692e-406c-9769-2f096ef28273",
                        "entry_id": "b9382e4a-5328-335f-8c42-3437e3d7c848",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "helvétiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c7d0418-155c-3c32-a8bf-bec4fd2775fc",
                        "entry_id": "b9382e4a-5328-335f-8c42-3437e3d7c848",
                        "glosses": [
                            "Suisse."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "63606938-a9f7-4695-b5ac-e9b410ac1805",
                                "sense_id": "5c7d0418-155c-3c32-a8bf-bec4fd2775fc",
                                "text": "On nous transmet de Genève quelques renseignemens qui viennent d’être publiés sur la force militaire de la république helvétique; …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a248bbc-7229-441e-b608-f9366eaadd93",
                        "source_entry_id": "b9382e4a-5328-335f-8c42-3437e3d7c848",
                        "source_sense_id": "5c7d0418-155c-3c32-a8bf-bec4fd2775fc",
                        "target_lang_word": "helvetisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "helvetisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f0157c6-5f43-37da-ab28-215173567bb5",
                                        "entry_id": "7617553e-eb93-3038-a92f-b35a52b213cf",
                                        "glosses": [
                                            "die Helvetische Republik, einen von Napoleon 1798 geschaffenen und 1803 wieder aufgelösten Vasallenstaat, betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f784165-b3f9-4c20-b1b4-242cf4e9a86e",
                                                "sense_id": "2f0157c6-5f43-37da-ab28-215173567bb5",
                                                "text": "„Mit der von Peter Ochs entworfenen, vom französischen Direktorium abgeänderten helvetischen Verfassung begann in der Schweiz die Entwicklung zum modernen, nur durch den Willen der Bürger legitimierten Verfassungs- und Verwaltungsstaat, der die Förderung des Gemeinwohls bezweckte.“"
                                            },
                                            {
                                                "example_id": "ed858b25-aaa9-4f2a-89c7-2dd213583268",
                                                "sense_id": "2f0157c6-5f43-37da-ab28-215173567bb5",
                                                "text": "„Der Kanton St. Gallen wurde 1803 auf Antrag des helvetischen Abgeordneten Karl Müller-Friedberg von Napoleon Bonaparte geschaffen.“"
                                            },
                                            {
                                                "example_id": "61b43c05-c4f3-47a6-a62d-9867ff9f1ec4",
                                                "sense_id": "2f0157c6-5f43-37da-ab28-215173567bb5",
                                                "text": "„Selbst die Stadt Zürich stellte sich gegen die Helvetische Regierung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c1aba731-6b80-32ed-833c-5fd8687273a6",
                                        "entry_id": "7617553e-eb93-3038-a92f-b35a52b213cf",
                                        "glosses": [
                                            "die Schweiz betreffend, zur Schweiz gehörend, aus ihr kommend"
                                        ],
                                        "tags": [
                                            "im schweizerischen Sprachgebrauch manchmal gehoben",
                                            "meist aber selbstironisch beziehungsweise abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "492d3cd3-7512-42b4-9dff-e509ae285caa",
                                                "sense_id": "c1aba731-6b80-32ed-833c-5fd8687273a6",
                                                "text": "„Diese Ziele zu erreichen ist nur über einen helvetischen Kompromiss […] möglich.“"
                                            },
                                            {
                                                "example_id": "8740ba14-ab52-46f0-a7f0-2934508bb831",
                                                "sense_id": "c1aba731-6b80-32ed-833c-5fd8687273a6",
                                                "text": "„Zu den helvetischen Konstanten des Verdrängens gehören die Berichte über Separatismen, die sich angeblich regen.“"
                                            },
                                            {
                                                "example_id": "6d945242-f97a-4179-bbcb-924dd45591d2",
                                                "sense_id": "c1aba731-6b80-32ed-833c-5fd8687273a6",
                                                "text": "„Gegen das helvetische Malaise. Eine neue Bundesverfassung soll die Ordnung des föderalen Gemeinwesens zeitgemäss klären. Von der 1967 eröffneten Konsultation erhoffen sich die Initiatoren zugleich Abhilfe gegen die Staatsverdrossenheit.“"
                                            },
                                            {
                                                "example_id": "237f182c-ca69-4ed6-ab31-cde1cd578f49",
                                                "sense_id": "c1aba731-6b80-32ed-833c-5fd8687273a6",
                                                "text": "„Der Untergang der Credit Suisse und das internationale Entsetzen über die Neutralitätspolitik nagen am Stolz der Eidgenossen. Gibt es so etwas wie eine helvetische Krankheit?“"
                                            },
                                            {
                                                "example_id": "63da1624-c871-40af-807e-3e511ed4d640",
                                                "sense_id": "c1aba731-6b80-32ed-833c-5fd8687273a6",
                                                "text": "„Auf all die Krisen reagiert das Land jedoch mit helvetischer Unbekümmerheit.“"
                                            },
                                            {
                                                "example_id": "76e36f6d-2238-488d-8589-4f0a0b0a6a2d",
                                                "sense_id": "c1aba731-6b80-32ed-833c-5fd8687273a6",
                                                "text": "historisch: „Helvetisches Bekenntnis“, Übersetzung von mittellateinisch Confessio Helvetica, zwei reformierte Glaubensbekenntnisse aus dem 16. Jahrhundert"
                                            },
                                            {
                                                "example_id": "ef6061e8-5cbc-47a8-abc4-05397d2d475b",
                                                "sense_id": "c1aba731-6b80-32ed-833c-5fd8687273a6",
                                                "text": "historisch: „Helvetische Gesellschaft“, Name einer von 1761 bis 1848 bestehenden Vereinigung aufklärerisch und überkantonal-eidgenössisch gesinnter Personen"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
