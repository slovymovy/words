                "senses": [
                    {
                        "sense_id": "9f27e7e1-e11f-3089-b884-8d61549ea280",
                        "entry_id": "e2cc3698-dd0c-3246-9f81-ad5ad3432664",
                        "glosses": [
                            "Braten aus einem Stück Rindfleisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f8d20ef-25fb-495a-8f95-6554ab958646",
                                "sense_id": "9f27e7e1-e11f-3089-b884-8d61549ea280",
                                "text": "„Bjarni kümmerte sich um den Rinderbraten, das war seine Expertise.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e47643c-9bf3-49cc-942f-b96c69e74249",
                        "source_entry_id": "e2cc3698-dd0c-3246-9f81-ad5ad3432664",
                        "source_sense_id": "9f27e7e1-e11f-3089-b884-8d61549ea280",
                        "source_sense_description": "Gastronomie: Braten aus einem Stück Rindfleisch",
                        "target_lang_word": "roast beef",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roast beef",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34bdc689-6777-3d27-bc9b-32fb078c56f3",
                                        "entry_id": "be1f166d-f4a0-3b22-854c-91094249f546",
                                        "glosses": [
                                            "Beef cooked by roasting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "250d20ee-e523-34de-95aa-236def89cdc8",
                                        "entry_id": "be1f166d-f4a0-3b22-854c-91094249f546",
                                        "glosses": [
                                            "A cut of beef that has been roasted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2f1364b-f5ee-4cac-b18d-4e1bb0113b08",
                                                "sense_id": "250d20ee-e523-34de-95aa-236def89cdc8",
                                                "text": "I tell the waiter, 'We'll have two roast beefs, one well-done, the other medium rare.'"
                                            },
                                            {
                                                "example_id": "44125caf-b3c3-44e5-a185-d8ef9205fc33",
                                                "sense_id": "250d20ee-e523-34de-95aa-236def89cdc8",
                                                "text": "But the cars & trucks held cartons of roast chickens, slabs of cheeses, loaves of bread, racks of hotdogs, case upon case of soft drinks, cases of bottled sparkling water, pies, cakes, roast beefs & baked hams."
                                            },
                                            {
                                                "example_id": "6834e778-0850-44ac-b456-25655c15c2b2",
                                                "sense_id": "250d20ee-e523-34de-95aa-236def89cdc8",
                                                "text": "No delicate little tidbits at these parties; there are buckets of shrimps and oysters, roast beefs and hams and tables of sweets with smiling corporate heads and their lobbyists to greet the guests."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ad08824-f2c3-3bc4-989c-9146fe28468a",
                                        "entry_id": "be1f166d-f4a0-3b22-854c-91094249f546",
                                        "glosses": [
                                            "A cut of beef intended for roasting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4d87134-e8a4-4433-aa9f-44490380c96f",
                                                "sense_id": "7ad08824-f2c3-3bc4-989c-9146fe28468a",
                                                "text": "Two or three times a week I had to deliver fifteen- or twenty-pound roast beefs to delis around the Bronx so that they could cook them and slice them up for sandwiches."
                                            },
                                            {
                                                "example_id": "e3d751b6-8730-4030-8aa8-bd43cafe8450",
                                                "sense_id": "7ad08824-f2c3-3bc4-989c-9146fe28468a",
                                                "text": "We had a freezer up until maybe two years ago. We used to pack a lot of roast beefs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95df960f-1a23-3ab6-8a28-e04262474b39",
                                        "entry_id": "be1f166d-f4a0-3b22-854c-91094249f546",
                                        "glosses": [
                                            "A portion of roasted beef."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e4c38e4-ca16-4e5b-8428-60aeb615a427",
                                                "sense_id": "95df960f-1a23-3ab6-8a28-e04262474b39",
                                                "text": "Because there, in the middle of the table, among the roast beefs on rolls,[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0d00fbb-e22d-436d-bfae-994ffcf6033c",
                        "source_entry_id": "e2cc3698-dd0c-3246-9f81-ad5ad3432664",
