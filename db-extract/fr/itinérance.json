                        "examples": [
                            {
                                "example_id": "55b22173-1c9e-4753-9ca6-819b43aa0ef7",
                                "sense_id": "0f15dc94-c45c-38f5-b67c-98471d69c59d",
                                "text": "Le coût élevé de l’itinérance mobile est une question qui préoccupe aussi les pays en développement.",
                                "translation": "The increased costs of roaming are an issue that also concerns developing countries.",
                                "english": "The increased costs of roaming are an issue that also concerns developing countries."
                            }
                        ]
                    },
                    {
                        "sense_id": "101838bf-4a1b-3923-a24d-cba44cc02750",
                        "entry_id": "0ec863f5-4a8a-3a6e-a8d4-e5892b4cdd0d",
                        "glosses": [
                            "homelessness"
                        ],
                        "tags": [
