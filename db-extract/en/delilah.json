                    {
                        "sense_id": "9a0a7e68-2c04-383a-b38d-6de78626ea88",
                        "entry_id": "7ee222d9-b5f3-367d-b059-79813cc1eea7",
                        "glosses": [
                            "The mistress of Samson who betrayed him to the Philistines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8775e55e-c4b1-4512-809e-3de662f2fdd3",
                                "sense_id": "9a0a7e68-2c04-383a-b38d-6de78626ea88",
                                "text": "And Delilah said to Samson, Tell me, I pray thee, wherein thy great strength lieth, and wherewith thou mightest be bound to afflict thee."
                            }
                        ]
                    },
                    {
                        "sense_id": "21034391-a2d1-3b7d-9669-c84681c407fe",
                        "entry_id": "7ee222d9-b5f3-367d-b059-79813cc1eea7",
                        "glosses": [
                            "A female given name from Hebrew of Biblical origin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cd4832b-a305-405c-9546-783a846ba20a",
                                "sense_id": "21034391-a2d1-3b7d-9669-c84681c407fe",
                                "text": "\"Leila!\" she said enigmatically. \"Have you seen her?\" / \"I went to her flat last week with Dad—he likes her.\" / \"Delilah is her real name, you know. All men like her. And Captain Fort is her lover.\""
                            }
                        ]
                    }
                ],
