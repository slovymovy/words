                ],
                "senses": [
                    {
                        "sense_id": "741830be-8928-3bc6-af77-87a5958611f4",
                        "entry_id": "115fa8a8-f31c-3f5f-a856-3c9f3c9c8d05",
                        "glosses": [
                            "Diebstahl eines oder mehrerer Kunstwerke (beispielsweise Gemälde, Skulpturen)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3e1c768a-0da1-3f44-9528-751e30e422ec",
                        "entry_id": "115fa8a8-f31c-3f5f-a856-3c9f3c9c8d05",
                        "glosses": [
                            "aus Sammlungen oder Museen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3f56dcb-6521-48ad-8f3c-5d5d02d51c3d",
                                "sense_id": "3e1c768a-0da1-3f44-9528-751e30e422ec",
                                "text": "Bei vielen Kunstrauben vermutet die Öffentlichkeit Versicherungsbetrug."
                            },
                            {
                                "example_id": "a8117b6e-fd8c-423a-a7a4-accb1e46b8bd",
                                "sense_id": "3e1c768a-0da1-3f44-9528-751e30e422ec",
                                "text": "„Der Kunstraub sorgte auch deshalb für Schlagzeilen, weil der maskierte Dieb nachts ungehindert durch das Museumsfenster eingestiegen war.“"
                            },
                            {
                                "example_id": "d508b56a-5e46-4d02-a3bd-b10e0bc1fb43",
                                "sense_id": "3e1c768a-0da1-3f44-9528-751e30e422ec",
                                "text": "„Dieser Kunstraub sorgte im Sommer 1979 für Schlagzeilen: Über das Pfingstwochenende waren ein Gemälde und ein Aquarell des Künstlers Emil Nolde aus verschlossenen Büros des Norddeutschen Rundfunks verschwunden.“"
                            },
                            {
                                "example_id": "61b96e09-d872-4cc9-953a-31b3d957f7d3",
                                "sense_id": "3e1c768a-0da1-3f44-9528-751e30e422ec",
                                "text": "„[Eberhard] Göpel selber war für die Nationalsozialisten am Kunstraub in ganz Europa beteiligt. Dabei ging es um die Beschaffung von Bildern für ein geplantes \"Führermuseum\".“"
                            },
                            {
                                "example_id": "c466149d-33b7-413d-8627-3fbb139a2a0f",
                                "sense_id": "3e1c768a-0da1-3f44-9528-751e30e422ec",
                                "text": "„Aus einem katalanischen Museum wurden Kunstwerke in ein Museum in Aragonien gebracht. Die [katalanischen] Separatisten sehen darin einen Kunstraub des spanischen Staates.“"
                            },
                            {
                                "example_id": "1f08e5d5-c680-48d0-b336-ae106bd26519",
                                "sense_id": "3e1c768a-0da1-3f44-9528-751e30e422ec",
                                "text": "„Als wohl grösster Kunstraub Europas gilt der Überfall auf die Stiftung Sammlung E.G. Bührle im Zürcher Seefeld. 2008 erbeuteten drei vermummte Männer unter Einsatz einer Faustfeuerwaffe am helllichten Tag jeweils ein Werk von Cézanne, van Gogh, Monet und Degas.“ [Anmerkung: 'grösster' ist Schweizer Rechtschreibung]"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "c9bcf776-2a28-389d-a599-1832cab6f5d2",
                        "entry_id": "115fa8a8-f31c-3f5f-a856-3c9f3c9c8d05",
                        "glosses": [
                            "bei Plünderungen bei Ausgrabungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "876f9ef4-03e0-411c-808d-323c44f2028b",
                                "sense_id": "c9bcf776-2a28-389d-a599-1832cab6f5d2",
                                "text": "„Denn dieser Ort [Naga/Sudan] ist völlig unberührt gewesen, als wir dort 1995 die Grabungen begonnen haben. […] Es hat auch keine Grabungen im 19. und im frühen 20. Jahrhundert gegeben. Und es gab dort keinen Kunstraub. Wir fanden dort alles so vor, wie es in der Antike liegen geblieben war.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    }
