                "senses": [
                    {
                        "sense_id": "5aed1858-5d94-385a-b206-c5d66e79c163",
                        "entry_id": "73cca935-5dfe-3f4b-a335-03d1e31f568f",
                        "glosses": [
                            "stuk papier waarmee men kan aantonen dat men ergens naar binnen mag gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d074c54-3570-4bb2-8cf5-241cdc46d19f",
                                "sense_id": "5aed1858-5d94-385a-b206-c5d66e79c163",
                                "text": "Net als de organisatie moet ook de bezoeker diep in de buidel tasten: 26 euro voor een passe-partout. Daarbij moet de kunstminnaar zich ook nog eens haasten, want het toegangsbiljet is slechts één dag geldig."
                            },
                            {
                                "example_id": "92612a5a-5ecd-4eb0-9419-9959fff71ce8",
                                "sense_id": "5aed1858-5d94-385a-b206-c5d66e79c163",
                                "text": "Het combi-ticket ‘B-Dagtrip’ (dat een treinticket combineert met een toegangsbiljet tot een evenement) heet voortaan ‘Discovery Combi’. De benaming ‘Diabolotoeslag’ voor een treinrit naar Brussels Airport wordt gewijzigd naar ‘Supplement Brussels Airport’."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e8e3c69-8432-3a59-9f42-995d8754294e",
                        "entry_id": "73cca935-5dfe-3f4b-a335-03d1e31f568f",
                        "glosses": [
                            "iets dat zorgt dat je iets kunt krijgen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "72cfcbf6-b170-4ccc-9a50-72b0255032d9",
                                "sense_id": "9e8e3c69-8432-3a59-9f42-995d8754294e",
                                "text": "Maar zij leek de witte studentenpet op te vatten als de afsluiting van al dat studeren en de start van een hogere positie in de samenleving, en daarmee het toegangsbiljet tot een goede betrekking."
                            }
                        ]
                    }
