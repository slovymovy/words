                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "537a0c4e-db20-4cca-87ef-4cad2a7cd782",
                                                "sense_id": "8f48e1a6-fef2-36cf-bcb2-87425a9e6404",
                                                "text": "Lucienne. — Mais c’est très ingénieux.\nPontagnac. — Oh ! Non, c’est génial, voilà tout !"
                                            },
                                            {
                                                "example_id": "3285adba-d950-40c3-a4e2-3aac5f2960a1",
