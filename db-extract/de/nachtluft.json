                    {
                        "form_id": "791e12dd-d59b-47b5-8a6e-d936f7404898",
                        "entry_id": "12f25e40-bde1-3bf5-a74b-d048b26175fe",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Nachtluft"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "95fcfa4f-bd67-3760-bfa5-19eae0571d43",
                        "entry_id": "12f25e40-bde1-3bf5-a74b-d048b26175fe",
                        "glosses": [
                            "frische, abgasarme Luft, die sich nachts einstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cefd647-9f02-463e-8a42-38809f681a37",
                                "sense_id": "95fcfa4f-bd67-3760-bfa5-19eae0571d43",
                                "text": "„Wir schieden als gute Freunde, und ich machte in der noch lauen Nachtluft einen kleinen Spaziergang durch das verschlafene Städtchen.“"
                            },
                            {
                                "example_id": "a05fdca0-5dcb-4c42-9f2f-66a55e2fb6d4",
                                "sense_id": "95fcfa4f-bd67-3760-bfa5-19eae0571d43",
                                "text": "„Sie hatten die Autos noch nicht erreicht, als ein Schuss durch die klare Nachtluft hallte.“"
                            },
                            {
                                "example_id": "76884ecc-a26c-4873-8b4c-53bf76f1cd19",
                                "sense_id": "95fcfa4f-bd67-3760-bfa5-19eae0571d43",
                                "text": "„Dort setzte ich mich auf einen Stuhl und atmete die Nachtluft ein.“"
                            },
                            {
                                "example_id": "fd23d4d9-0c5f-4fa2-a832-52bfaf53c51b",
                                "sense_id": "95fcfa4f-bd67-3760-bfa5-19eae0571d43",
                                "text": "„Natascha steckte den Kopf in die feuchte Nachtluft hinaus, und die Gräfin sah, wie ihr schmächtiger Hals vom Schluchzen erschüttert wurde und gegen den Fensterrahmen zuckte.“"
                            },
                            {
                                "example_id": "ecf50229-fb83-4b0d-9f3f-6310084aabb8",
                                "sense_id": "95fcfa4f-bd67-3760-bfa5-19eae0571d43",
                                "text": "„Tief atmete er die frische Nachtluft ein und konzentrierte Sinne und Verstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
