                                                "sense_id": "01e653f9-5ed7-3a24-a084-f48b36131e19",
                                                "text": "Der Mann war sehr ungehalten bezüglich der Verhaltensweise des Verkäufers und hat ihm das entsprechend zum Ausdruck gebracht."
                                            },
                                            {
                                                "example_id": "86472ef4-ea89-41e9-90e6-d943bfc98860",
                                                "sense_id": "01e653f9-5ed7-3a24-a084-f48b36131e19",
                                                "text": "„Wenn es eine offizielle Liste gäbe, wer auf Call-Center- Anrufe am ungehaltensten reagiert, dann stünde Sachsen-Anhalt auf Platz 2 und schlecht gelaunte Berliner wären auf Platz 1.“"
                                            },
                                            {
                                                "example_id": "dd990be0-38d6-4ace-a80f-d937ab30d572",
                                                "sense_id": "01e653f9-5ed7-3a24-a084-f48b36131e19",
                                                "text": "„Der Berufungswerber wurde von Major K auf dieses ungewöhnliche Anhaltemanöver angesprochen und der Berufungswerber war über die Anhaltung sichtlich nicht erfreut und eher ungehalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb4572df-f1a2-34a6-a375-bce464c96439",
                                        "entry_id": "1c8b3701-0023-3254-aaea-8d0f0f6a119a",
                                        "glosses": [
                                            "nicht gehalten, nicht vorgetragen"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b0a4dd7-46df-481a-b2ae-a2b1b1de0857",
                                                "sense_id": "bb4572df-f1a2-34a6-a375-bce464c96439",
                                                "text": "„Allerdings hatte er im Moment andere Sorgen, schließlich musste er seine ungehaltene Rede geistig gerade noch einmal umschreiben.“"
                                            },
                                            {
                                                "example_id": "bdcfb979-7540-4b11-8ba1-82c3ce4ac03e",
                                                "sense_id": "bb4572df-f1a2-34a6-a375-bce464c96439",
                                                "text": "„Silke Göttsch hat sein ungehaltenes Referat gemeinsam mit Candy Sauer hier ediert […].“"
                                            },
                                            {
                                                "example_id": "073458e3-0c12-4312-a07d-f3eeb4858363",
                                                "sense_id": "bb4572df-f1a2-34a6-a375-bce464c96439",
                                                "text": "„Prompt kehrte er wieder um, die ZEIT druckte seine «ungehaltene Rede». Ein kleines, stolzes Vermächtnis hatte Schmidt vortragen wollen, konstruktiv, pädagogisch, aber nicht ohne Spitzen.“"
                                            },
                                            {
                                                "example_id": "ddf57906-9a78-497a-9272-48af4a27c37d",
                                                "sense_id": "bb4572df-f1a2-34a6-a375-bce464c96439",
                                                "text": "„Papst Benedikt XVI. hatte in seiner aufgrund der Proteste einer Gruppe von Professoren nicht gehaltenen, keineswegs aber ungehaltenen Rede zur Eröffnung des akademischen Jahres an der römischen Universität »Sapienza« (Januar 2008) keine Gelegenheit zu sagen, was er wollte […].“"
                                            },
                                            {
                                                "example_id": "ef732640-4304-412b-966b-57ed7018a854",
                                                "sense_id": "bb4572df-f1a2-34a6-a375-bce464c96439",
                                                "text": "„Den Inhalt Ihrer ungehaltenen Rede dürfen Sie jetzt nicht vortragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
