                            {
                                "example_id": "a22195a7-e3fd-4031-95fd-8cb44f2fcc69",
                                "sense_id": "5702c676-41d0-3908-995b-d34c2fccb16b",
                                "text": "Przytoczę tutaj jego słowa nie dlatego, iżbym sądził, że podziela on wymieniony tu przeze mnie (niepełny zapewne) katalog skarg i zażaleń opozycjonistów wobec Okrągłego Stołu"
                            },
                            {
                                "example_id": "9c426071-cfe7-4896-991c-d871a99a2574",
                                "sense_id": "5702c676-41d0-3908-995b-d34c2fccb16b",
                                "text": "Akces do nurtu takich guru mody jak wymienieni Japończycy bardzo nobilituje Eko-Look"
                            }
                        ],
