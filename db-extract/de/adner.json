                ],
                "senses": [
                    {
                        "sense_id": "27e8509f-deb4-3206-bbbe-d8a1bed998c4",
                        "entry_id": "d0071c1a-dfaa-30a4-bd8f-1c6fccf2c2f7",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91e3b1b1-9883-4ae0-b630-8f138bf7a778",
                                "sense_id": "27e8509f-deb4-3206-bbbe-d8a1bed998c4",
                                "text": "Frau Adner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8c2e48e6-f74d-454b-b003-65cbf89acf3c",
                                "sense_id": "27e8509f-deb4-3206-bbbe-d8a1bed998c4",
                                "text": "Herr Adner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cd89431d-75fc-4219-af1d-e8ada3f4fe47",
                                "sense_id": "27e8509f-deb4-3206-bbbe-d8a1bed998c4",
                                "text": "Die Adners fahren heute ins Sauerland."
                            },
                            {
                                "example_id": "2415ef85-108e-4a7a-acd5-b9c13ed1d5fa",
                                "sense_id": "27e8509f-deb4-3206-bbbe-d8a1bed998c4",
                                "text": "Der Adner trägt nie die Schals, die die Adner ihm strickt."
                            },
                            {
                                "example_id": "ead11490-ea6a-47e6-825d-7b0d3dd3e645",
                                "sense_id": "27e8509f-deb4-3206-bbbe-d8a1bed998c4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Adner kommt, geht der Herr Adner.“"
                            },
                            {
                                "example_id": "088b4c75-3c8a-4bd8-906f-04be2c70fb82",
                                "sense_id": "27e8509f-deb4-3206-bbbe-d8a1bed998c4",
                                "text": "Adner kommt und geht."
                            },
                            {
                                "example_id": "54f7229d-b907-403f-a335-4fbfc28bba38",
                                "sense_id": "27e8509f-deb4-3206-bbbe-d8a1bed998c4",
                                "text": "Adners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
