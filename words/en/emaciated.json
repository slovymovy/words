                {
                    "sense_id": "72617f67-22a0-3c58-9585-daad769f71cb",
                    "sense_definition": "Abnormally thin and weak, especially because of illness or a lack of food.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>emaciated</w> prisoners were weak and suffering from severe malnutrition.",
                            "target_lang_translations": {
                                "es": "Los prisioneros <w>demacrados</w> estaban débiles y sufrían de desnutrición severa."
                            }
                        },
                        {
                            "text": "After months wandering in the desert, the survivors were completely <w>emaciated</w>.",
                            "target_lang_translations": {
                                "es": "Tras meses vagando por el desierto, los supervivientes estaban completamente <w>demacrados</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "skeletal",
                        "gaunt",
                        "wasted",
                        "haggard",
                        "scraggy"
                    ],
                    "antonyms": [
                        "plump",
                        "chubby",
                        "stout",
                        "obese"
                    ],
                    "common_phrases": [
                        "emaciated figure",
                        "emaciated body",
                        "looking emaciated"
                    ],
                    "target_lang_definitions": {
