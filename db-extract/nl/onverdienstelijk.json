                        "sense_id": "74b84200-c843-3ac4-89f3-2cc1a4838e2f",
                        "entry_id": "848de993-f757-303c-93ad-dbf18c547866",
                        "glosses": [
                            "niet goed of geweldig"
                        ],
                        "tags": [],
