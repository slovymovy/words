                                        "entry_id": "633f2cc5-9d4b-3526-bb00-20f46a915c31",
                                        "glosses": [
                                            "Pertaining to Tibet, the Tibetan people, culture, or language."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2061d7f3-ad72-4cdd-ac7a-d94adf0420fb",
                                                "sense_id": "ee061421-64a3-3266-bd8d-82589a53d766",
                                                "text": "A fantastic legend was told about the first Gyalwai Odzer. This legend, believed to be authentic, had no fixed origin in time because the nomads of the region, the Tibetan province Tsinghai, could not, not even vaguely, indicate a date. The legend, however, was clear enough, so well known that it was no longer discussed, for everybody had been told the tale during childhood. It had become a dogma, to be believed passively without even trying to ascertain its probability or validity."
                                            },
                                            {
                                                "example_id": "fb67c128-12ec-47c5-bdfe-98177fe92225",
                                                "sense_id": "ee061421-64a3-3266-bd8d-82589a53d766",
                                                "text": "After many years, Buddhism touched every aspect of Tibetan life, including how to treat the earth and plants and animals."
                                            }
                                        ]
                                    }
