                                "target_senses": [
                                    {
                                        "sense_id": "937d812d-4f0e-3b05-9bde-592ac0e197b9",
                                        "entry_id": "1d7a0d4c-c3b7-3f30-a0bd-b0d7ce36dc56",
                                        "glosses": [
                                            "Hauptstadt von Katar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fe1614b-dfb6-4813-9ffc-a50408622ff9",
                                                "sense_id": "937d812d-4f0e-3b05-9bde-592ac0e197b9",
                                                "text": "„Wie in vielen größeren Städten am Persischen Golf wird auch die Skyline Dohas zunehmend von meist solitären Hochhäusern dominiert, z.T. mit markanten arabischen Stilzitaten.“"
                                            },
                                            {
                                                "example_id": "ba1304cd-e0c2-4a3e-bc9f-44e75998adff",
                                                "sense_id": "937d812d-4f0e-3b05-9bde-592ac0e197b9",
                                                "text": "„Al-Wadschba, eine Festung im Südwesten Dohas, wurde 1882 von ar-Rayyan gebaut und war im folgenden Jahr Schauplatz der Schlacht, in welcher das Volk Katars unter Führung der Briten an der Seite der Alliierten Scheich Qasim das Osmanische Reich bekämpfte und den Grundstein zu seiner Unabhängigkeit legte.“"
                                            },
                                            {
                                                "example_id": "36965792-c4cd-420e-a187-046a5ca9f5a3",
                                                "sense_id": "937d812d-4f0e-3b05-9bde-592ac0e197b9",
                                                "text": "„Auslöser der Unruhen sind die unter der Ägide der UN in Doha (Qatar) laufenden Friedensverhandlungen zwischen der sudanesischen Regierung und den wichtigsten Aufständischen-Fraktionen in Darfur. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
