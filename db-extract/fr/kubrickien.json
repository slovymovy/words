                                "target_senses": [
                                    {
                                        "sense_id": "911e6b83-bebc-350d-b6ae-752b7ad90a25",
                                        "entry_id": "33a8d1c1-49df-3da7-8d83-ac26e5c968ea",
                                        "glosses": [
                                            "Of or pertaining to Stanley Kubrick (1928–1999), influential American film director, writer, producer, and photographer, noted for his technical perfectionism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "345244bd-5634-3b89-83b0-01d6ad084ecc",
                                        "entry_id": "33a8d1c1-49df-3da7-8d83-ac26e5c968ea",
                                        "glosses": [
                                            "Characterized by meticulous perfectionism, mastery of the technical aspects of film-making, and atmospheric visual style in films across a range of genres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da8d7168-f19f-4186-a9b7-b9423d7ea82e",
                                                "sense_id": "345244bd-5634-3b89-83b0-01d6ad084ecc",
                                                "text": "There are some nice gags and sprightly Kubrickian touches, and one genuinely shocking scene when Evelyn fat-shames her daughter – an authentically upsetting moment of family dysfunction that seems to come from another film, one in a parallel universe."
                                            },
                                            {
                                                "example_id": "30df695a-d702-498f-a283-2699340ce27a",
                                                "sense_id": "345244bd-5634-3b89-83b0-01d6ad084ecc",
                                                "text": "Even directors with more formal aesthetics—the Kubrickian perfectionist David Fincher and the interpersonal realist Noah Baumbach—did not make rote, familiar-feeling movies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
