                {
                    "sense_id": "d0259c3e-2a4f-3ab3-9307-142c44653c31",
                    "sense_definition": "A prolonged, high-pitched cry of pain, grief, or distress.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "crying_lamenting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The distant <w>wailing</w> of a siren disturbed the quiet night.",
                            "target_lang_translations": {
                                "nl": "Het verre <w>geloei</w> van een sirene verstoorde de rustige nacht."
                            }
                        },
                        {
                            "text": "We could hear the sorrowful <w>wailing</w> of the mourners inside the chapel.",
                            "target_lang_translations": {
                                "nl": "We konden het droevige <w>gejammer</w> van de rouwenden in de kapel horen."
                            }
                        }
                    ],
                    "synonyms": [
                        "lamentation",
                        "howling",
                        "weeping"
                    ],
                    "antonyms": [
                        "cheering",
                        "laughter"
                    ],
                    "common_phrases": [
                        "wailing and gnashing of teeth"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een langdurige, hoge kreet van pijn, verdriet of nood; luid gejammer."
                    },
