    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "76c4f61b-fcf0-3604-a57d-3defe04b69c4",
                    "sense_definition": "Participe présent de <w>revenir</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>revenant</w> du travail, il a acheté du pain frais à la boulangerie."
                        },
                        {
                            "text": "Elle marchait lentement dans la rue en <w>revenant</w> sur ses pas pour retrouver ses clés."
                        }
                    ],
                    "common_phrases": [
                        "en revenant de",
                        "revenant sur ses pas"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "44f7bfe4-8858-3d04-887c-364b78908a52",
                    "sense_definition": "Esprit d'un mort que l'on suppose revenir de l'au-delà pour hanter les vivants.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants aiment se raconter des histoires de <w>revenants</w> pour se faire peur le soir."
                        },
                        {
                            "text": "Le vieux château médiéval semblait habité par un <w>revenant</w> qui apparaissait la nuit."
                        }
                    ],
                    "synonyms": [
                        "fantôme"
                    ],
                    "common_phrases": [
                        "histoire de revenants",
                        "peur des revenants"
                    ]
                },
                {
                    "sense_id": "1834aeea-5850-36b8-94a5-be5b1689a657",
                    "sense_definition": "Personne que l'on n'avait pas revue depuis très longtemps au point de la croire disparue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après dix ans sans donner de nouvelles, mon cousin a été accueilli comme un <w>revenant</w>."
                        },
                        {
                            "text": "Tiens, voilà un <w>revenant</w>, nous pensions tous que tu avais définitivement quitté la région !"
                        }
                    ],
                    "common_phrases": [
                        "voilà un revenant"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "06108dfb-cd0c-3b76-9940-760d16155fb1",
                    "sense_definition": "Survivant ou rescapé qui revient après avoir traversé une épreuve particulièrement tragique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après l'enfer des combats, ce <w>revenant</w> a consacré le reste de sa vie à témoigner."
                        },
                        {
                            "text": "Les rares <w>revenants</w> de cette guerre dévastatrice avaient du mal à réintégrer une existence normale."
                        }
                    ]
                },
                {
                    "sense_id": "dbb93e73-57f5-34eb-bc14-16c8da20e762",
                    "sense_definition": "Personne qui rentre dans son pays après s'être engagée dans les rangs d'une organisation terroriste à l'étranger.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les services de sécurité surveillent de près chaque <w>revenant</w> de retour de ces zones de conflit."
                        },
                        {
                            "text": "La justice a mis en place un protocole strict pour juger les <w>revenants</w> dès leur retour."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9d2c78e2-f040-3d97-8d39-ca29a912fbb6",
                    "sense_definition": "Qui revient ou qui a tendance à réapparaître.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette pensée <w>revenante</w> l'obsédait sans cesse et l'empêchait de trouver le sommeil la nuit."
                        },
                        {
                            "text": "Un souvenir <w>revenant</w> venait troubler sa mémoire chaque fois qu'il passait devant cette maison."
                        }
                    ]
                }
            ]
        }
    ]
}