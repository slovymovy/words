{
    "word_family": [
        "redresser"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "702abe88-f3aa-3eb7-aa6a-1203ea60e034",
                    "sense_definition": "To set right an unfair situation or wrong; to remedy or compensate for an injury or injustice.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "remedy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government promised to <w>redress</w> the economic imbalance between different regions."
                        },
                        {
                            "text": "The new law was introduced to <w>redress</w> historic grievances suffered by the minority population."
                        }
                    ],
                    "synonyms": [
                        "remedy",
                        "rectify",
                        "correct"
                    ],
                    "common_phrases": [
                        "redress the balance",
                        "redress grievances",
                        "redress an injustice"
                    ]
                },
                {
                    "sense_id": "62806a71-abba-381f-aef6-d0e981782468",
                    "sense_definition": "To provide relief or compensation to someone who has been wronged or mistreated.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "remedy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tribunal sought to <w>redress</w> the victims who had suffered unlawful discrimination."
                        },
                        {
                            "text": "No amount of financial assistance could fully <w>redress</w> the families for their suffering."
                        }
                    ],
                    "synonyms": [
                        "compensate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "now largely literary or formal when applied directly to a person"
                        }
                    ]
                },
                {
                    "sense_id": "1d3e0b7e-6e77-3d93-82aa-ef5f9eecfc59",
                    "sense_definition": "To put clothes on again, or to apply a new dressing to a wound.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing_dressing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse cleaned the cut and carefully <w>redressed</w> the wound with fresh gauze."
                        },
                        {
                            "text": "She had to undress and then <w>redress</w> the toddler after he spilled his drink."
                        }
                    ],
                    "common_phrases": [
                        "redress a wound"
                    ]
                },
                {
                    "sense_id": "46d508d8-135a-3fcb-b237-effa773b6e14",
                    "sense_definition": "To alter or redecorate an existing set, especially in theater or film, so it can represent a different location.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scenography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew quickly <w>redressed</w> the courtroom set to serve as an old library."
                        },
                        {
                            "text": "To save production costs, the crew opted to <w>redress</w> the standing set."
                        }
                    ],
                    "common_phrases": [
                        "redress a set"
                    ]
                },
                {
                    "sense_id": "4f15f951-4f16-301a-a753-c5e7c81874a9",
                    "sense_definition": "To put back in order, revise, or reorder.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took several weeks to <w>redress</w> the draft before submitting it for publication."
                        },
                        {
                            "text": "She labored in the garden to <w>redress</w> what had overgrown during winter."
                        }
                    ],
                    "synonyms": [
                        "revise"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ]
                },
                {
                    "sense_id": "7b065e0f-6ff0-3276-8dd5-392346c2443b",
                    "sense_definition": "To put upright again; to restore to a standing position.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight struggled to <w>redress</w> himself after falling from his horse."
                        },
                        {
                            "text": "With great effort, the soldiers managed to <w>redress</w> their fallen banner."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": ""
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24e7feef-dc7b-38a3-babf-fb845c233ead",
                    "sense_definition": "Compensation, remedy, or relief given for a wrong, injury, or grievance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "remedy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Citizens have the constitutional right to petition the government for a <w>redress</w> of grievances."
                        },
                        {
                            "text": "The injured workers sought legal <w>redress</w> through the civil courts."
                        }
                    ],
                    "synonyms": [
                        "reparation",
                        "compensation",
                        "remedy"
                    ],
                    "common_phrases": [
                        "legal redress",
                        "redress of grievances",
                        "seek redress"
                    ]
                },
                {
                    "sense_id": "59fdf377-1e64-31ac-be2d-6b93a57cbab6",
                    "sense_definition": "The possibility, right, or means of obtaining a legal remedy or setting right a wrong.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "remedy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Consumers often discover that there is no effective <w>redress</w> available against rogue traders."
                        },
                        {
                            "text": "Without proper documentation, you may have little <w>redress</w> under current regulations."
                        }
                    ],
                    "common_phrases": [
                        "have no redress",
                        "right of redress"
                    ]
                },
                {
                    "sense_id": "7df2ef50-658d-3dfe-9f5b-64febb7c86af",
                    "sense_definition": "A redecoration or refurbishment of an existing set for a stage, television, or film production.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scenography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cozy coffee shop was actually a clever <w>redress</w> of the courtroom set."
                        },
                        {
                            "text": "With limited budget, the designer executed an impressive <w>redress</w> of the old stage."
                        }
                    ],
                    "common_phrases": [
                        "set redress"
                    ]
                },
                {
                    "sense_id": "35b6d68b-4cb9-3881-b6c3-8c9f626b06e8",
                    "sense_definition": "The general act of putting right, correcting, or reforming something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "remedy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monarch promised prompt attention to the <w>redress</w> of these ancient abuses."
                        },
                        {
                            "text": "The committee demanded the full <w>redress</w> of all administrative errors."
                        }
                    ],
                    "synonyms": [
                        "reformation",
                        "correction"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "b4c5971f-c01a-3f20-9d18-3e96a2d3c658",
                    "sense_definition": "A person or thing that provides relief or remedy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "remedy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She viewed the court as the only remaining <w>redress</w> against corporate tyranny."
                        },
                        {
                            "text": "He served as a trusted <w>redress</w> to the oppressed townsfolk."
                        }
                    ],
                    "synonyms": [
                        "redresser"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ]
                }
            ]
        }
    ]
