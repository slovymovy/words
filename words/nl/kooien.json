                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>kooi</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vogels in deze grote <w>kooien</w> krijgen elke ochtend vers water.",
                            "target_lang_translations": {
                                "fr": "Les oiseaux dans ces grandes <w>cages</w> reçoivent de l'eau fraîche chaque matin."
                            }
                        },
                        {
                            "text": "In de dierentuin zijn alle <w>kooien</w> ruim opgezet voor de dieren.",
                            "target_lang_translations": {
                                "fr": "Au zoo, toutes les <w>cages</w> sont spacieuses pour les animaux."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "forme plurielle du nom « cage »"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "cages",
                                "target_lang_sense_clarification": "pluriel de cage"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "037d5b87-3fa6-3296-8960-86616fa6a285",
                    "sense_definition": "dieren in een kooi opsluiten of onderbrengen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verzorger besloot de zieke vogels tijdelijk te <w>kooien</w> voor onderzoek.",
                            "target_lang_translations": {
                                "fr": "Le soigneur a décidé d'<w>encager</w> temporairement les oiseaux malades pour un examen."
                            }
                        },
                        {
                            "text": "Het is zielig om zulke grote roofdieren jarenlang te <w>kooien</w>.",
                            "target_lang_translations": {
                                "fr": "C'est triste de <w>mettre en cage</w> de si grands prédateurs pendant des années."
                            }
                        }
                    ],
                    "synonyms": [
                        "opsluiten"
                    ],
                    "antonyms": [
                        "vrijlaten"
                    ],
                    "target_lang_definitions": {
