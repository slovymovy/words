                    {
                        "sense_id": "af15c047-6d24-3e4c-91b7-bbf958828926",
                        "entry_id": "d8d2d8e0-49cb-341d-808c-40ecb6b4c861",
                        "glosses": [
                            "The repetition of the same word or words at the end of successive phrases, clauses or sentences."
                        ],
                        "tags": [
                            "countable",
                            "rhetoric",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4014cd21-bf6d-4eb3-9a18-64eec60915ef",
                                "sense_id": "af15c047-6d24-3e4c-91b7-bbf958828926",
                                "text": "Epistrophe many sentences will close\nWith the same word, in verse as well as prose."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6025f8e-3ca3-30f0-bf05-fa07a74dad85",
                        "entry_id": "d8d2d8e0-49cb-341d-808c-40ecb6b4c861",
                        "glosses": [
                            "An arrangement of chlorophyll grains on the outer surface of plant cells, as opposed to apostrophe (an arrangement at right angles to the surface)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a74dadff-a5ef-4ef0-a04b-aa18b3d36c6b",
                                "sense_id": "c6025f8e-3ca3-30f0-bf05-fa07a74dad85",
                                "text": "As is well known, chloroplast in the epistrophe position presents an oval or more or less circular form; in the apostrophe position a flattened and lenticular form."
                            }
                        ]
                    }
                ],
