{
    "word_family": [
        "observe",
        "observation",
        "observance",
        "observer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4ce4fdb7-da92-3ece-b43c-96466a7cced7",
                    "sense_definition": "Alert and paying close attention; watchful.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attentive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>observant</w> child noticed the small bird hiding in the bushes.",
                            "target_lang_translations": {
                                "ru": "<w>Наблюдательный</w> ребенок заметил маленькую птичку, прячущуюся в кустах.",
                                "zh": "那个<w>善于观察的</w>孩子注意到了躲在灌木丛里的小鸟。"
                            }
                        },
                        {
                            "text": "Being <w>observant</w> helps you learn more about the world around you.",
                            "target_lang_translations": {
                                "ru": "Быть <w>наблюдательным</w> помогает узнавать больше об окружающем мире.",
                                "zh": "保持<w>细心</w>有助于你更多地了解周围的世界。"
                            }
                        }
                    ],
                    "antonyms": [
                        "inobservant",
                        "nonobservant",
                        "unobservant",
                        "unobserving"
                    ],
                    "common_phrases": [
                        "highly observant",
                        "very observant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бдительный и внимательный; умеющий замечать детали.",
                        "zh": "警觉且非常注意细节；善于观察的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наблюдательный",
                                "target_lang_sense_clarification": "способный замечать детали и мелочи"
                            },
                            {
                                "target_lang_word": "внимательный",
                                "target_lang_sense_clarification": "сосредоточенный и чуткий к окружающему"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "善于观察的",
                                "target_lang_sense_clarification": "指人能够敏锐地察觉周围的事物"
                            },
                            {
                                "target_lang_word": "细心",
                                "target_lang_sense_clarification": "指做事或观察时非常仔细"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a419a0d6-16e6-3603-83ff-5ff92068d64f",
                    "sense_definition": "Diligently attentive in following a law, custom, duty, or principle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attentive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was always <w>observant</w> of the rules during the competition.",
                            "target_lang_translations": {
                                "ru": "Он всегда <w>соблюдал</w> правила во время соревнований.",
                                "zh": "他在比赛期间总是<w>遵守</w>规则。"
                            }
                        },
                        {
                            "text": "The citizens remained <w>observant</w> of the new safety regulations.",
                            "target_lang_translations": {
                                "ru": "Граждане продолжали <w>соблюдать</w> новые правила безопасности.",
                                "zh": "市民们依然<w>严守</w>新的安全条例。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "observant of rules",
                        "observant of customs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добросовестно соблюдающий законы, обычаи, обязанности или принципы.",
                        "zh": "勤勉地遵守法律、习俗、职责或原则。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исполнительный",
                                "target_lang_sense_clarification": "старательно выполняющий правила или поручения"
                            },
                            {
                                "target_lang_word": "соблюдающий",
                                "target_lang_sense_clarification": "придерживающийся установленных норм или правил"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "遵守",
                                "target_lang_sense_clarification": "指严格按照规定或规则行事"
                            },
                            {
                                "target_lang_word": "严守",
                                "target_lang_sense_clarification": "指严格地保持或执行某项准则"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "293d08be-8e74-3d60-8287-692531d754a5",
                    "sense_definition": "Practicing a religion regularly and strictly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is an <w>observant</w> Jew who attends synagogue every week.",
                            "target_lang_translations": {
                                "ru": "Она — <w>соблюдающая</w> иудейка, которая каждую неделю посещает синагогу.",
                                "zh": "她是一位<w>虔诚的</w>犹太教徒，每周都去犹太会堂。"
                            }
                        },
                        {
                            "text": "Many <w>observant</w> families celebrate the holiday with traditional meals.",
                            "target_lang_translations": {
                                "ru": "Многие <w>религиозные</w> семьи отмечают праздник традиционными блюдами.",
                                "zh": "许多<w>守教规的</w>家庭会用传统餐点来庆祝节日。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Регулярно и строго соблюдающий религиозные обряды.",
                        "zh": "定期且严格地践行宗教仪式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верующий",
                                "target_lang_sense_clarification": "религиозный человек"
                            },
                            {
                                "target_lang_word": "соблюдающий",
                                "target_lang_sense_clarification": "строго следующий религиозным предписаниям"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虔诚的",
                                "target_lang_sense_clarification": "指对宗教信仰非常忠诚和认真"
                            },
                            {
                                "target_lang_word": "守教规的",
                                "target_lang_sense_clarification": "指严格遵循宗教戒律的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ce3261a-ccf3-3697-889f-24c795e44d22",
                    "sense_definition": "A member of a Franciscan order that strictly follows the rules of St. Francis.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Observants</w> lived a life of poverty and prayer.",
                            "target_lang_translations": {
                                "ru": "<w>Обсерванты</w> жили в бедности и молитвах.",
                                "zh": "<w>严规派修士</w>过着贫穷和祈祷的生活。"
                            }
                        },
                        {
                            "text": "Historical records describe the daily life of an <w>Observant</w> in the monastery.",
                            "target_lang_translations": {
                                "ru": "Исторические записи описывают повседневную жизнь <w>обсерванта</w> в монастыре.",
                                "zh": "历史记录描述了修道院里一名<w>严规派修士</w>的日常生活。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Observantine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Член францисканского ордена, строго следующий правилам святого Франциска.",
                        "zh": "方济各会中严格遵守圣方济各会规的成员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обсервант",
                                "target_lang_sense_clarification": "монах-францисканец строгого устава"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "严规派修士",
                                "target_lang_sense_clarification": "指方济各会中实行严格会规的派别"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}