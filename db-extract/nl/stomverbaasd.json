                            {
                                "example_id": "caced3e1-99da-4352-bf3d-fd91d57adf41",
                                "sense_id": "d2b62fde-b33f-3bb9-bf60-7cf485d29ccd",
                                "text": "De stomverbaasde speler protesteerde niet eens toen hij een rode kaart kreeg."
