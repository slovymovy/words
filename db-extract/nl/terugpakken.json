        "nl-extract.jsonl": [
            {
                "entry_id": "7ca2fab8-f964-3f30-b970-33da5bf3b7a5",
                "word": "terugpakken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "949c2592-0478-3138-a111-63596bed1b38",
                        "entry_id": "7ca2fab8-f964-3f30-b970-33da5bf3b7a5",
                        "glosses": [
                            "afpakken wat je eerst gegeven hebt of van je is afgenomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12454177-1baa-491e-8540-2a316377471f",
                                "sense_id": "949c2592-0478-3138-a111-63596bed1b38",
                                "text": "Criminele winsten terugpakken van veroordeelden is ingewikkeld. Ontnemingszaken duren lang en er blijft soms weinig over."
                            }
                        ]
                    },
                    {
                        "sense_id": "923e6179-256b-3d47-b583-01b5dd3f8aec",
                        "entry_id": "7ca2fab8-f964-3f30-b970-33da5bf3b7a5",
                        "glosses": [
                            "wraak nemen als je iets kwaads is overkomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "023d644f-e2b9-4def-aa57-bc670dc0df04",
                                "sense_id": "923e6179-256b-3d47-b583-01b5dd3f8aec",
                                "text": "„Als je ziet dat de koopkracht van ouderen tot 30 procent is achtergebleven bij werkenden, als je ziet dat pensioenen niet geïndexeerd zijn, als je ziet dat mensen met een groot AOW-gat zijn komen te zitten, nou dan wordt het tijd dat we ‘ze’ terugpakken.”"
                            },
                            {
                                "example_id": "801fd3b3-e269-4ac1-8196-aae085282cb1",
                                "sense_id": "923e6179-256b-3d47-b583-01b5dd3f8aec",
                                "text": "Als je nog een keer zo vervelend doet zal ik je terugpakken."
                            }
                        ]
                    }
                ],
