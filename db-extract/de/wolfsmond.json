                                "example_id": "0f7f0a5f-9544-42ab-87cc-9bcc63cf436e",
                                "sense_id": "bfdbdfa5-2d8e-3f51-87b4-7a73148d63c4",
                                "text": "„Am Montag ist der erste Vollmond des Jahres. Dieser wird traditionell Wolfsmond genannt.“"
                            },
                            {
                                "example_id": "d457d1bd-023c-477b-ab78-043feaade482",
                                "sense_id": "bfdbdfa5-2d8e-3f51-87b4-7a73148d63c4",
                                "text": "Am Montag, den 13. Jänner 2025, wird der erste Vollmond des Jahres, auch bekannt als Wolfsmond, den Nachthimmel in ein magisches Licht tauchen."
                            }
                        ],
