                {
                    "sense_id": "93936d52-61f3-384c-989c-9b4f434b3a3c",
                    "sense_definition": "De strijd verliezen van een tegenstander of niet tegen iets opgewassen zijn.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de finale moest de jonge speler het <w>afleggen</w> tegen de ervaren kampioen.",
                            "target_lang_translations": {
                                "ru": "В финале молодому игроку пришлось <w>уступить</w> опытному чемпиону.",
                                "en": "During the final, the young player <w>lost</w> to the experienced champion.",
                                "fr": "Pendant la finale, le jeune joueur a dû <w>s'incliner</w> face au champion expérimenté."
                            }
                        },
                        {
                            "text": "In de discussie moest hij het uiteindelijk <w>afleggen</w> tegen haar sterke argumenten.",
                            "target_lang_translations": {
                                "ru": "В споре ему в конце концов пришлось <w>уступить</w> перед ее сильными аргументами.",
                                "en": "In the discussion, he eventually had to <w>yield</w> to her strong arguments.",
                                "fr": "Dans la discussion, il a finalement dû <w>céder</w> face à ses arguments solides."
                            }
