                                                "sense_id": "745497a2-a8d9-3835-b035-48f8f5cbcb07",
                                                "text": "Der Arzt verschrieb ihm ein Antibiotikum."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7c4de1a8-1dea-3639-b709-89b29281df03",
