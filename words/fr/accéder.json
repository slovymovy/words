            "pos": "verb",
            "senses": [
                {
                    "sense_id": "38f92611-9721-3a54-b9b6-421ff4edf6e1",
                    "sense_definition": "Parvenir à un lieu, pouvoir y entrer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les visiteurs peuvent <w>accéder</w> au musée par l'entrée principale."
                        },
                        {
                            "text": "Ce sentier permet d'<w>accéder</w> facilement au sommet de la colline."
                        }
                    ],
                    "common_phrases": [
                        "accéder au bâtiment",
                        "accéder au sommet"
                    ]
                },
                {
                    "sense_id": "32e360ce-bb78-36dc-904c-339af48ba1c9",
                    "sense_definition": "Consulter des données ou utiliser un service numérique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous devez entrer un mot de passe pour <w>accéder</w> à votre compte."
                        },
                        {
                            "text": "L'application permet d'<w>accéder</w> rapidement aux données de l'entreprise."
                        }
                    ],
                    "common_phrases": [
                        "accéder aux données",
                        "accéder à Internet"
                    ]
                },
                {
                    "sense_id": "e01a7e9d-483c-3422-aa93-6566e1e72001",
                    "sense_definition": "Parvenir à un état, une fonction importante ou un statut social.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "statut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs années d'efforts, il a réussi à <w>accéder</w> au pouvoir."
                        },
                        {
                            "text": "De nombreuses familles souhaitent <w>accéder</w> à la propriété dans cette ville."
                        }
                    ],
                    "common_phrases": [
                        "accéder au pouvoir",
                        "accéder à la propriété"
                    ]
                },
                {
                    "sense_id": "2262ab73-aff2-33fc-9cbf-d978239548ed",
                    "sense_definition": "Accepter une proposition ou donner son accord à une demande.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction a refusé d'<w>accéder</w> à la demande formulée par les salariés."
                        },
                        {
                            "text": "Le juge a décidé d'<w>accéder</w> à la requête déposée par l'avocat."
                        }
                    ],
                    "synonyms": [
                        "consentir"
                    ],
                    "common_phrases": [
                        "accéder à une demande",
                        "accéder à une requête"
                    ]
                },
                {
                    "sense_id": "f8c0c5f9-38f7-3a16-a853-b8a9a469a9c1",
                    "sense_definition": "Adhérer formellement à un traité ou une convention internationale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "diplomatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs nouveaux pays ont décidé d'<w>accéder</w> à ce traité de paix."
                        },
                        {
                            "text": "Le parlement a voté pour <w>accéder</w> à cette convention internationale."
                        }
                    ],
                    "common_phrases": [
                        "accéder à un traité",
                        "accéder à une convention"
                    ]
                }
            ]
        }
    ]
