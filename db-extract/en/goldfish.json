                ],
                "senses": [
                    {
                        "sense_id": "b9a8ee8e-1d06-3afa-be62-05c507497678",
                        "entry_id": "ec378cb6-767a-35e0-85f6-cf07a5411730",
                        "glosses": [
                            "A type of small fish, Carassius auratus, typically orange-colored."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0bf9f20-266e-4365-aafe-bb15b802411a",
                                "sense_id": "b9a8ee8e-1d06-3afa-be62-05c507497678",
                                "text": "For the children's fair we'll have a few games they can play, so that each child \"wins\" a goldfish as a prize."
                            },
                            {
                                "example_id": "94946dbb-5b30-496b-8332-3d2f100ee044",
                                "sense_id": "b9a8ee8e-1d06-3afa-be62-05c507497678",
                                "text": "However, unless you have a nonshedding, nonlicking breed, there's no such thing as a truly hypoallergenic dog. How about a nice goldfish instead?"
                            }
                        ]
                    },
                    {
                        "sense_id": "3bcf3273-2192-3d4c-858a-0607de85b7d2",
                        "entry_id": "ec378cb6-767a-35e0-85f6-cf07a5411730",
                        "glosses": [
                            "A person with an unreliable memory."
                        ],
                        "tags": [
                            "figuratively",
                            "informal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "265a461c-1cfe-393b-8add-3dcc6140c1d5",
                        "entry_id": "ec378cb6-767a-35e0-85f6-cf07a5411730",
                        "glosses": [
                            "Nonstandard form of Goldfish (“a small orange saltine-like cracker shaped in the form of a fish”)."
                        ],
                        "tags": [
                            "alt-of",
                            "nonstandard"
                        ],
                        "examples": [
                            {
                                "example_id": "f33bb649-c378-46ce-a3fc-c2410aa9e8b7",
                                "sense_id": "265a461c-1cfe-393b-8add-3dcc6140c1d5",
                                "text": "Tomato soup is not complete without a toasted cheese sandwich and goldfishes. Not the new kind with the smiley faces though."
                            },
                            {
                                "example_id": "5b8de704-d413-4aee-b6c4-1d85fe099f30",
                                "sense_id": "265a461c-1cfe-393b-8add-3dcc6140c1d5",
                                "text": "The only solids he will eat are the Gerber Puffs, Cheerios, maybe some goldfish, and oyster crackers."
                            },
                            {
                                "example_id": "afe9a51c-5889-4fe7-9771-edd26dcdd407",
                                "sense_id": "265a461c-1cfe-393b-8add-3dcc6140c1d5",
                                "text": "I’ve seen people let their kid drink from their drink and then drink from it themselves. That’s pushing the limits. That kid for sure just backwashed lime disease into your drink. Not to mention all the little chunks of animal crackers and goldfishes."
                            }
                        ]
                    }
                ],
