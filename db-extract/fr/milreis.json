                        "glosses": [
                            "Ancienne monnaie de compte du Portugal et du Brésil."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "40b40f62-9a25-47ea-9586-fd06a8fbfe0e",
                                "sense_id": "8c86e3fb-b3b4-3ee1-b646-e69b13f87e60",
                                "text": "Le train part à quatre heures du soir, pour Belem. Les jours ordinaires, cela coûte un milreis deux cents. Aujourd'hui, dimanche de carnaval, paraît-il, le prix est de deux milreis neuf cents."
                            },
                            {
                                "example_id": "0ca1393a-a679-410f-af09-c8efcecaf4e7",
                                "sense_id": "8c86e3fb-b3b4-3ee1-b646-e69b13f87e60",
                                "text": "C’était une valise d’une taille respectable. Elle était bourrée de billets de banque. Des liasses de cent billets de mille milreis soit d’un conto tout neufs, paraphées, timbrées, cachetées comme elles le sont quand elles sortent de la caisse de l’État."
                            }
                        ]
                    }
