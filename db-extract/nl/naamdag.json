                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55614974-d84d-4e12-890f-6633ff3b86b8",
                                "sense_id": "08b97eaa-1076-3644-b645-fd0464f4857a",
                                "text": "Buiten Limburg wordt in het Nederlands taalgebied iemands naamdag zelden gevierd."
                            },
                            {
                                "example_id": "350feeb0-f420-4426-a040-768672e8d7eb",
                                "sense_id": "08b97eaa-1076-3644-b645-fd0464f4857a",
                                "text": "Meester Valentijn viert zijn naamdag op 14 februari"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ade2ca5-d28a-474b-a956-8bd2499fb82c",
                        "source_entry_id": "26a8d8ac-42cd-3fca-a7e0-1ea0e7ccb01d",
                        "source_sense_id": "08b97eaa-1076-3644-b645-fd0464f4857a",
                        "source_sense_description": "een dag waarop een heilige wordt herdacht",
                        "target_lang_word": "Namenstag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Namenstag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f7bd650-4556-361e-adb3-6ac2e2f17d02",
                                        "entry_id": "1a515110-e012-344a-8a2f-abda1ba81906",
                                        "glosses": [
                                            "Gedenktag für den Namenspatron"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ae4309c-c46a-4ffc-b804-fb609cf0f095",
                                                "sense_id": "5f7bd650-4556-361e-adb3-6ac2e2f17d02",
                                                "text": "Das Feiern des Namenstages hat in manchen Gegenden den Geburtstag zeitweilig verdrängt."
                                            },
                                            {
                                                "example_id": "b7c3544e-fc59-4117-b109-1397d067ac1c",
                                                "sense_id": "5f7bd650-4556-361e-adb3-6ac2e2f17d02",
                                                "text": "„Manche Leute feiern hier sogar ihren Geburtstag oder Namenstag.“"
                                            },
                                            {
                                                "example_id": "e1c50f45-0225-4593-9563-e52a7c231f46",
                                                "sense_id": "5f7bd650-4556-361e-adb3-6ac2e2f17d02",
                                                "text": "„Neben dem Geburtstag wurde und wird von katholischen Namensträgern oft der Namenstag besonders begangen.“"
                                            },
                                            {
                                                "example_id": "e3d16a73-ceb5-4541-81da-f2f432046b04",
                                                "sense_id": "5f7bd650-4556-361e-adb3-6ac2e2f17d02",
                                                "text": "„Bei Rostows wurde ein doppelter Namenstag gefeiert, da die Mutter und die jüngste Tochter beide Natalja hiessen.“"
                                            },
                                            {
                                                "example_id": "9fa25cbc-36c8-4502-a56b-8a1025c2a378",
                                                "sense_id": "5f7bd650-4556-361e-adb3-6ac2e2f17d02",
                                                "text": "„Als er hörte, daß ich bei Don Gennaro wohnte, besuchte er ihn, um ihm zu seinem Namenstag zu gratulieren, der am Tag nach dem Eintritt der Nonne bei den Klarissinnen gefeiert wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35f9d80b-aef8-4261-8944-1362579cab72",
                        "source_entry_id": "26a8d8ac-42cd-3fca-a7e0-1ea0e7ccb01d",
