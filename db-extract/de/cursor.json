                                        "examples": [
                                            {
                                                "example_id": "82abc5d6-28e0-4289-99c5-fa87296ad34d",
                                                "sense_id": "23a06c90-685e-3483-ad25-0954a811fb1a",
                                                "text": "The only other problem is that there's a nagging tendency for the highlight to overrun when cursoring through file lists."
