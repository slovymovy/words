                    {
                        "translation_id": "c3aebe98-2f5f-4bb3-90b1-556c18af0a6e",
                        "source_entry_id": "f060c5fd-2e38-3eae-b18a-1796c4a32caa",
                        "source_sense_id": "afb7d9ff-e4d4-3645-8c54-88004e3f23ff",
                        "target_lang_word": "penitence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penitence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08e0c08d-e514-3c40-9694-8b0b853b6232",
                                        "entry_id": "c6c46ef8-ef50-3431-94f2-5ad235dd6663",
                                        "glosses": [
                                            "The condition of being penitent; a feeling of regret or remorse for doing wrong or sinning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1003390a-320b-4be9-8b20-934b6fa5c5b2",
                                                "sense_id": "08e0c08d-e514-3c40-9694-8b0b853b6232",
                                                "text": "an assassin who misses his aim and flounders into penitence much as that discomfortable drama misses its point and stumbles into vacuity"
                                            },
                                            {
                                                "example_id": "601ee196-b8bb-4521-a83e-1b1d916f4275",
                                                "sense_id": "08e0c08d-e514-3c40-9694-8b0b853b6232",
                                                "text": "As for the moral turpitude that man unveiled to me, even with tears of penitence, I cannot, even in memory, dwell on it without a start of horror."
                                            },
                                            {
                                                "example_id": "4c2a2575-68b4-4fca-b6d5-26caf97fbd56",
                                                "sense_id": "08e0c08d-e514-3c40-9694-8b0b853b6232",
                                                "text": "Away, Remorse! / Compunction, hence!. / Go, Moral Force! / Go, Penitence!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75f1e488-6619-4839-bc09-903e36c6b19f",
                        "source_entry_id": "f060c5fd-2e38-3eae-b18a-1796c4a32caa",
                        "source_sense_id": "afb7d9ff-e4d4-3645-8c54-88004e3f23ff",
                        "target_lang_word": "repentance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repentance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81a0d973-6b97-3ee1-a9d3-cf2480e5b3a9",
                                        "entry_id": "16ef1bac-a5a2-3c04-9697-dd98732c4eac",
                                        "glosses": [
                                            "The condition of being repentant, penitent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89775ded-8b5e-4c5c-9326-b1b858e12449",
                                                "sense_id": "81a0d973-6b97-3ee1-a9d3-cf2480e5b3a9",
                                                "text": "1678, Bunyan, The Pilgrim's Progress, second period\nGod hath denied me repentance. His words gives me no encouragement to believe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "521ebf6d-3993-3c95-8c26-243eac9b8320",
                                        "entry_id": "16ef1bac-a5a2-3c04-9697-dd98732c4eac",
                                        "glosses": [
                                            "A feeling of regret or remorse for doing wrong or sinning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02c9c09e-93ac-4a54-b6e1-825f7e274d68",
                                                "sense_id": "521ebf6d-3993-3c95-8c26-243eac9b8320",
                                                "text": "And here, shipmates, is true and faithful repentance; not clamorous for pardon, but grateful for punishment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
