                "senses": [
                    {
                        "sense_id": "5d458fa3-28a7-3f51-acc5-da549de14665",
                        "entry_id": "4bb75903-8d49-37e4-8e96-be14e4ad4d8b",
                        "glosses": [
                            "rzecz rzadko spotykana, osobliwa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94f48315-1751-4938-80dc-457a25015419",
                                "sense_id": "5d458fa3-28a7-3f51-acc5-da549de14665",
                                "text": "Tę starą monetę z rybakiem uznał za numizmatyczny rarytas."
                            },
                            {
                                "example_id": "ed81013c-63f4-4c1f-a58c-24f99001723f",
                                "sense_id": "5d458fa3-28a7-3f51-acc5-da549de14665",
                                "text": "Ty byś chciał jeść same rarytasy, a chleba z pasztetem to nie łaska?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
