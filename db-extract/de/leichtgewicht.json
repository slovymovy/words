                "senses": [
                    {
                        "sense_id": "eedda13a-6ff7-3673-bbf9-9af8950c3708",
                        "entry_id": "be08dd46-2fcf-3505-b6d7-0923826920ef",
                        "glosses": [
                            "Gewichtsklasse für Sportler im Boxen und Gewichtheben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87fcbd03-6e1c-45f2-88e3-e37e6ae6cf2a",
                                "sense_id": "eedda13a-6ff7-3673-bbf9-9af8950c3708",
                                "text": "Er boxt im Leichtgewicht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "802dec54-6932-3269-a391-3c74892cdee5",
                        "entry_id": "be08dd46-2fcf-3505-b6d7-0923826920ef",
                        "glosses": [
                            "jemand, der der Gewichtsklasse Leichtgewicht angehört"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7e60d876-c23f-3f80-85c5-dc3b015455e3",
                        "entry_id": "be08dd46-2fcf-3505-b6d7-0923826920ef",
                        "glosses": [
                            "Person von in einer bestimmten Hinsicht geringer Bedeutung/Fähigkeit"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "55e44abe-3cbb-4081-b98a-2bc784bcf83f",
                                "sense_id": "7e60d876-c23f-3f80-85c5-dc3b015455e3",
                                "text": "„Nicht nur seine Gegner, sondern auch viele aus dem Kreis seiner intellektuellen Verteidiger warteten nur darauf, daß das in ihren Augen literarische Leichtgewicht mit seinem nächsten Roman scheitern würde.“"
                            },
                            {
                                "example_id": "5414a581-43d9-430f-911e-e65a7d024dca",
                                "sense_id": "7e60d876-c23f-3f80-85c5-dc3b015455e3",
                                "text": "„Zweiter Vizepräsident wurde Simon Muzenda, ein politisches Leichtgewicht, der schon während des Unabhängigkeitskrieges als stellvertretender Vorsitzender der ZANU seinem Chef immer wieder bewiesen hatte, dass er sich mit der Rolle des Zweiten zufriedengab und keineswegs nach der Macht greifen würde.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91efae6f-5fdf-4e75-9280-88e15ab26bdf",
                        "source_entry_id": "be08dd46-2fcf-3505-b6d7-0923826920ef",
                        "source_sense_id": "eedda13a-6ff7-3673-bbf9-9af8950c3708",
