                ],
                "senses": [
                    {
                        "sense_id": "a5d4d64d-7129-3744-abcb-331a1e46fd9e",
                        "entry_id": "e8ab36aa-2c85-3ef4-8dee-3afecb7f19d9",
                        "glosses": [
                            "Beschlag auf einem Segelbootes, meist aus Kunststoff, mit zwei beweglichen Backen, der dem Fixieren von Tauen (Schoten, Fallen, Streckern, etc.) dient"
                        ],
                        "tags": [
                            "Seglersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "54eb2376-5365-42a8-9cd5-48621d9666bd",
                                "sense_id": "a5d4d64d-7129-3744-abcb-331a1e46fd9e",
                                "text": "Die Curryklemme hat zwei bewegliche Backen, die sich bei Gegenzug öffnen. Oft ist sie mit einer Leitöse kombiniert."
                            },
                            {
                                "example_id": "ac050b93-d2c0-48f8-8358-09f9382a661b",
                                "sense_id": "a5d4d64d-7129-3744-abcb-331a1e46fd9e",
                                "text": "Eine Curryklemme hat zwei bewegliche und eingekerbte Backen, die durch eine Feder öffnen und die Leine festklemmen können. Zum Lösen der Leine ziehen Sie diese nach oben und zu sich heran (manchmal kräftig), um die Backen zu öffnen."
                            },
                            {
                                "example_id": "9edcffac-8f16-48eb-885d-fc4a505a6c65",
                                "sense_id": "a5d4d64d-7129-3744-abcb-331a1e46fd9e",
                                "text": "„Dazu lässt sich der Kicker beidseitig per Curryklemme holen oder fieren, wie bei Regattayachten üblich.“"
                            },
                            {
                                "example_id": "3fdae11f-44f8-4dfa-a303-18953f962997",
                                "sense_id": "a5d4d64d-7129-3744-abcb-331a1e46fd9e",
                                "text": "„Noch kurz vor dem Start montierte die \"Lightworks\"-Crew fieberhaft die letzten Curryklemmen […].“"
                            },
                            {
                                "example_id": "04272527-96aa-483a-933f-2ecdfce50730",
                                "sense_id": "a5d4d64d-7129-3744-abcb-331a1e46fd9e",
                                "text": "[Orkanwarnung – Aufgerollte Genuas mit einer] „Reffleine in einer Curryklemme zu sichern reicht oft nicht aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
