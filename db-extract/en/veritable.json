                        "sense_id": "59aad0c7-428c-38c6-bbbe-73f1032825c8",
                        "entry_id": "3d20d173-dde9-3fb9-ae0a-6de3b7b36f0e",
                        "glosses": [
                            "True; genuine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb6a2eed-63bb-4dbb-adb0-72a0273b947f",
                                "sense_id": "59aad0c7-428c-38c6-bbbe-73f1032825c8",
                                "text": "He is a veritable genius."
                            },
                            {
                                "example_id": "3852936e-ba45-4ba9-b601-3d4380bb9c11",
                                "sense_id": "59aad0c7-428c-38c6-bbbe-73f1032825c8",
                                "text": "A fair is a veritable smorgasbord."
                            },
                            {
                                "example_id": "6cbf25b1-54d9-44e8-8db0-9b209daa81df",
                                "sense_id": "59aad0c7-428c-38c6-bbbe-73f1032825c8",
                                "text": "The ideal man of the Middle Ages was free of all fear because he was sure of salvation, certain of eternal bliss. He was the saint, and the saint, not the knight nor the troubadour, is the veritable ideal of the Middle Ages."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfc0fbb8-ad02-3eb3-8a77-e9b3742ad93e",
                        "entry_id": "3d20d173-dde9-3fb9-ae0a-6de3b7b36f0e",
                        "glosses": [
                            "As an intensifier: absolute, indisputable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fab28bca-30f3-4363-a37a-2b72f520a392",
                                "sense_id": "bfc0fbb8-ad02-3eb3-8a77-e9b3742ad93e",
                                "text": "From 1748, a veritable troop of elocution experts declared war on Scots diction, providing inspirational lectures, books and yet more lists for diligent anglophiles to memorise."
                            }
                        ]
                    }
