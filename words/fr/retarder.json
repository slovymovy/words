    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "97055a68-643f-3f87-a9d5-8708c06d809a",
                    "sense_definition": "Faire perdre du temps à quelqu'un, le mettre en retard.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ralentissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un appel imprévu m'a <w>retardé</w> ce matin avant de partir au travail."
                        },
                        {
                            "text": "Ne me <w>retarde</w> pas, je dois absolument attraper mon train dans dix minutes."
                        }
                    ],
                    "synonyms": [
                        "ralentir"
                    ],
                    "common_phrases": [
                        "retarder quelqu'un"
                    ]
                },
                {
                    "sense_id": "ad7e9e45-944b-3dd5-834f-48078f489ce8",
                    "sense_definition": "Reporter une action ou un événement à une date ou une heure ultérieure ; différer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "report",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont décidé de <w>retarder</w> leur voyage à cause des mauvaises conditions météorologiques."
                        },
                        {
                            "text": "Nous devons <w>retarder</w> le début de la réunion en attendant l'arrivée du directeur."
                        }
                    ],
                    "synonyms": [
                        "différer",
                        "reporter",
                        "ajourner"
                    ],
                    "antonyms": [
                        "avancer",
                        "hâter"
                    ],
                    "common_phrases": [
                        "retarder l'échéance",
                        "retarder un départ"
                    ]
                },
                {
                    "sense_id": "9b5d5a89-d839-320f-b4b0-95fad1520cdc",
                    "sense_definition": "Ralentir l'avancement, le déroulement ou le développement de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ralentissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette panne technique risque de <w>retarder</w> l'ensemble des travaux sur le chantier."
                        },
                        {
                            "text": "Le froid intense a <w>retardé</w> la floraison des arbres fruitiers au début du printemps."
                        }
                    ],
                    "synonyms": [
                        "ralentir",
                        "freiner"
                    ],
                    "antonyms": [
                        "accélérer"
                    ],
                    "common_phrases": [
                        "retarder la croissance",
                        "retarder les progrès"
                    ]
                },
                {
                    "sense_id": "092c178b-0bdd-3989-bdd7-5832e97551f9",
                    "sense_definition": "Indiquer une heure moins avancée en parlant d'un instrument de mesure du temps ; marcher trop lentement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "horlogerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette vieille horloge <w>retarde</w> d'au moins cinq minutes chaque jour."
                        },
                        {
                            "text": "Ma montre <w>retarde</w>, je vais devoir changer la pile très rapidement."
                        }
                    ],
                    "antonyms": [
                        "avancer"
                    ],
                    "common_phrases": [
                        "retarder de dix minutes",
                        "retarder d'une heure"
                    ]
                }
            ]
        }
    ]
