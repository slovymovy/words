                    {
                        "translation_id": "5d8e99c8-ec43-4b24-ab8c-37967ee69824",
                        "source_entry_id": "1a0a18b1-68ee-3f76-a846-573105b206f8",
                        "source_sense_id": "5c8115b5-6dde-32c6-beaf-18f325f61e22",
                        "target_lang_word": "orfèvre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orfèvre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a84b53db-c8de-3552-a7f3-25c405ab4723",
                                        "entry_id": "4161e707-6d80-3f7e-b686-63557a15d8ca",
                                        "glosses": [
                                            "Artisan et marchand qui fabrique et qui vend des bijoux et autres ouvrages d’or et d’argent, de platine ou de tout métal précieux."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "718720fb-67e2-4d92-8dbc-3d070d0cd046",
                                                "sense_id": "a84b53db-c8de-3552-a7f3-25c405ab4723",
                                                "text": "Je résolus de vendre une bague et un médaillon que je tenais de ma mère, et je parcourus la ville à la recherche d’un orfèvre."
                                            },
                                            {
                                                "example_id": "cb3f7248-7b26-440d-89d6-8b6b5cec96b5",
                                                "sense_id": "a84b53db-c8de-3552-a7f3-25c405ab4723",
                                                "text": "Je n’ose laisser le lecteur sous cette pénible impression de détresse matérielle. […]. Mais on aurait tort de croire que nos orfèvres de la même époque fussent tous des indigents et tirassent le diable par la queue. Au contraire."
                                            },
                                            {
                                                "example_id": "264cb418-590a-4216-9f3d-02f35ae7ef6d",
                                                "sense_id": "a84b53db-c8de-3552-a7f3-25c405ab4723",
                                                "text": "Cette femme, voyant la pierre précieuse étincelante que possédait son mari, lui dit de la porter chez l’orfèvre pour en faire faire un bracelet. L’orfèvre, qui reconnut sa valeur, la remplaça par une autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fcc982e-b003-3786-bf3e-6150d7b8a17c",
                                        "entry_id": "4161e707-6d80-3f7e-b686-63557a15d8ca",
                                        "glosses": [
                                            "Professionnel méticuleux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e51a41f-d928-435f-bf95-c2f2947cf163",
                                                "sense_id": "0fcc982e-b003-3786-bf3e-6150d7b8a17c",
                                                "text": "C’est du travail d’orfèvre."
                                            },
                                            {
                                                "example_id": "d63b390e-1b38-404a-8689-25c853b07c17",
                                                "sense_id": "0fcc982e-b003-3786-bf3e-6150d7b8a17c",
                                                "text": "C’est un orfèvre en la matière, vous pouvez lui faire confiance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
