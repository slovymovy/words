            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bffad5b0-bb78-367c-a22a-19d7bc999676",
                    "sense_definition": "Propriété d'un matériau ou d'une substance qui peut facilement changer de forme ou être modelé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "propriete_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>plasticité</w> de l'argile permet aux sculpteurs de créer des formes variées et très précises."
                        },
                        {
                            "text": "Grâce à sa grande <w>plasticité</w>, cette pâte à modeler ne se fissure pas lors du séchage."
                        }
                    ],
                    "synonyms": [
                        "déformabilité",
                        "malléabilité",
                        "souplesse"
                    ],
                    "antonyms": [
                        "dureté",
                        "rigidité"
                    ],
                    "common_phrases": [
                        "plasticité de l'argile"
                    ]
                },
                {
                    "sense_id": "38c601d8-3ea6-3ec9-b38c-cf32746044ba",
                    "sense_definition": "Capacité d'un organisme, d'un organe ou de l'esprit à s'adapter à de nouvelles situations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adaptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>plasticité</w> cérébrale aide le cerveau des patients à récupérer certaines fonctions après un accident."
                        },
                        {
                            "text": "Cette espèce végétale fait preuve d'une remarquable <w>plasticité</w> face aux changements climatiques."
                        }
                    ],
                    "synonyms": [
                        "malléabilité",
                        "souplesse"
                    ],
                    "antonyms": [
                        "rigidité"
                    ],
                    "common_phrases": [
                        "plasticité cérébrale",
                        "plasticité neuronale"
                    ]
                },
                {
                    "sense_id": "25d3faf0-5cd0-3005-b8b3-120514c1fd77",
                    "sense_definition": "Capacité d'un solide à subir des déformations irréversibles sans se rompre sous l'action d'une contrainte.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "propriete_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ingénieurs vérifient la <w>plasticité</w> des métaux utilisés dans la construction des ponts métalliques."
                        },
                        {
                            "text": "À haute température, la <w>plasticité</w> de l'acier augmente de manière significative."
                        }
                    ],
                    "synonyms": [
                        "déformabilité",
                        "malléabilité"
                    ],
                    "antonyms": [
                        "rigidité"
                    ],
                    "common_phrases": [
                        "limite de plasticité"
                    ]
                }
            ]
        }
    ]
