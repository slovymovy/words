                            {
                                "example_id": "431418ed-f30e-46f7-a0ad-b37005a7555b",
                                "sense_id": "d0e1c0a8-08a1-3767-a6e1-b5f269103707",
                                "text": "„Flohmarktartikel werden zum Verkauf angeboten, die in fünfzehn großen Kisten vor dem Haus stehen.“"
                            },
                            {
                                "example_id": "d0ab9b90-66ba-46c5-a2a9-4b9ac7392fe6",
                                "sense_id": "d0e1c0a8-08a1-3767-a6e1-b5f269103707",
                                "text": "„Artikel aus Rosalinglas aus dem Art déco und den 1950er Jahren werden bis heute, oft unter der nicht korrekten Bezeichnung „antikes Glas“, in unterschiedlichen Preisklassen gehandelt und sind ein beliebter Flohmarktartikel.“"
                            }
