                                        "sense_id": "1f7cef4d-ad3f-3711-9b8d-15353e075010",
                                        "entry_id": "49578bfc-90d8-3ec6-b939-5c6f00b23bc7",
                                        "glosses": [
                                            "The removal of bones from a carcass; filleting."
                                        ],
                                        "tags": [],
