                                "target_senses": [
                                    {
                                        "sense_id": "136b583b-8174-3792-bce9-8eda3ff3ee9f",
                                        "entry_id": "91f287e9-d410-3c84-93f7-5dd8da1b0ecc",
                                        "glosses": [
                                            "Sache, Ereignis oder Zustand ohne Abbild in der Realität; Wunschbild"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f153eee-8f05-404a-8a5c-5af4cbe8dab5",
                                                "sense_id": "136b583b-8174-3792-bce9-8eda3ff3ee9f",
                                                "text": "Das sind doch reine Utopismen! Schau dich doch mal um! Wer sollte sich denn für so etwas starkt machen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "004712f3-fc32-3f4a-b70f-b12002150893",
                                        "entry_id": "91f287e9-d410-3c84-93f7-5dd8da1b0ecc",
                                        "glosses": [
                                            "Haltung/Neigung, sich Unmögliches vorzustellen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d716d86-be15-49d7-9df0-c51815c1e577",
                                                "sense_id": "004712f3-fc32-3f4a-b70f-b12002150893",
                                                "text": "Dein Utopismus in allen Ehren, aber der bringt uns nicht weiter."
                                            }
                                        ],
