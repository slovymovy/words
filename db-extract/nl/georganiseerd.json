                "senses": [
                    {
                        "sense_id": "92554724-6b72-3d47-850e-445d38fedddf",
                        "entry_id": "ed4bfff5-1c7d-3dc9-b201-af712e37aa0f",
                        "glosses": [
                            "voltooid deelwoord van organiseren"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "7ee176cb-a14e-4e75-b522-6da7eacc3894",
                                "sense_id": "92554724-6b72-3d47-850e-445d38fedddf",
                                "text": "Lauren, verontwaardigd: 'Heb je een baan voor haar geregeld?' Terwijl we zien hoe de opkomende zon zachtjes geel licht begint te spetteren op het water van de Libische Zee, vertel ik dat we Lana's vertrek binnen een paar weken hadden georganiseerd."
                            },
                            {
                                "example_id": "224c9d9e-c9dc-47f6-96ff-be677d0ff2db",
                                "sense_id": "92554724-6b72-3d47-850e-445d38fedddf",
                                "text": "Mijn laatste meeting was uitgelopen, waardoor ik me moest haasten om op tijd bij het familiediner te zijn dat mijn moeder met veel gedoe had georganiseerd."
                            }
                        ]
                    }
