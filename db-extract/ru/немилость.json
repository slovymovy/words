                        "sense_id": "8d2b7d0f-63c3-380f-95db-907b0e166906",
                        "entry_id": "3b82105e-4711-3b93-95f2-404cd5a20339",
                        "glosses": [
                            "устар. ирон. нерасположение лица сильного к подчиненному, зависимому"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de50d601-a51c-4c24-8d7e-11d23ea97226",
                                "sense_id": "8d2b7d0f-63c3-380f-95db-907b0e166906",
                                "text": "Не казнь страшна, страшна твоя немилость."
                            }
                        ]
                    },
                    {
                        "sense_id": "19cef54f-72d6-3c85-9c32-c5a2628bf662",
                        "entry_id": "3b82105e-4711-3b93-95f2-404cd5a20339",
                        "glosses": [
                            "книжн. устар. вызванное таким нерасположением состояние зависимого, опала"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7ffb7cb-ded6-48a0-997c-c0c562ef7767",
                                "sense_id": "19cef54f-72d6-3c85-9c32-c5a2628bf662",
                                "text": "С тех пор мне была объявлена немилость за непонимание истинных интересов моего повелителя, а потом начались и преследования, которые разрешились изгнанием из отечества."
                            }
                        ]
                    }
