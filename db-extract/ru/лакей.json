                ],
                "senses": [
                    {
                        "sense_id": "92e93fb3-e2b7-3233-bf89-3493ad53bd3d",
                        "entry_id": "f1d5aa6d-879d-35a8-b145-c83feeddb626",
                        "glosses": [
                            "lackey"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca233804-9e9f-496f-8d1f-da6a1ea0fa1e",
                                "sense_id": "92e93fb3-e2b7-3233-bf89-3493ad53bd3d",
                                "text": "Взоше́дши в пере́днюю, уви́дел он на ко́жаном запа́чканном дива́не лаке́я своего́ Ива́на, кото́рый, лёжа на спине́, плева́л в потоло́к и попада́л дово́льно уда́чно в одно́ и то же ме́сто.",
                                "translation": "In the vestibule he saw his valet Ivan stretched on the leather couch and amusing himself by spitting at the ceiling, which he did very cleverly, hitting every time the same spot.",
                                "english": "In the vestibule he saw his valet Ivan stretched on the leather couch and amusing himself by spitting at the ceiling, which he did very cleverly, hitting every time the same spot."
                            },
                            {
                                "example_id": "2fecc18e-9e25-4b9b-9b99-06131a9c2c1f",
                                "sense_id": "92e93fb3-e2b7-3233-bf89-3493ad53bd3d",
                                "text": "Мне отвори́л дверь высо́кий, то́лстый, бу́рый лаке́й с чёрными ба́кенами и со́нно, вя́ло и гру́бо, как то́лько лаке́й мо́жет разгова́ривать с лаке́ем, спроси́л меня́, что мне ну́жно.",
                                "translation": "The door was opened by a tall, stout, drab-coloured flunkey with black whiskers, who in a sleepy, churlish, and apathetic voice, such as only flunkeys use in addressing other flunkeys, asked me what I wanted.",
                                "english": "The door was opened by a tall, stout, drab-coloured flunkey with black whiskers, who in a sleepy, churlish, and apathetic voice, such as only flunkeys use in addressing other flunkeys, asked me what I wanted."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
