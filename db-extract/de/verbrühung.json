                        "tags": [
                            "Nomen Acti"
                        ],
                        "examples": [
                            {
                                "example_id": "a903dfcc-1e60-4267-bd35-4647ec81706a",
                                "sense_id": "8e874028-5693-35f6-ab8f-a5333709da55",
                                "text": "„Verbrennungen und besonders Verbrühungen gehören zu den häufigsten Unfällen im Kindesalter.“"
                            },
                            {
                                "example_id": "1679c884-9d25-40b4-8557-5c2f3c6ff4cf",
                                "sense_id": "8e874028-5693-35f6-ab8f-a5333709da55",
                                "text": "„Etwa 23 000 Kinder in der Bundesrepublik erleiden jedes Jahr Verbrennungen mittleren Grades, oftmals durch Verbrühungen oder durch offenes Feuer beim Grillen im Freien.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
