                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1414623-cb72-46ab-9bf6-4a8e1f61818a",
                                "sense_id": "0eadb606-4d29-337b-8ae1-53c30fb803fe",
                                "text": "Ils ont en tête le précédent Mitt Romney, qui, en 2012, avait invité les sans-papiers à \"s’autoexpulser\"."
                            },
                            {
                                "example_id": "9ed946d3-4212-437a-b01f-c4e91bd46860",
                                "sense_id": "0eadb606-4d29-337b-8ae1-53c30fb803fe",
                                "text": "Dans I Never Promised You a Rose Garden I et II, j’ai choisi d’inverser la chronologie des images de telle sorte que le sang réintègre les corps, les visages se décrispent, les balles s’autoexpulsent des chairs et pénètrent les armes."
                            },
                            {
                                "example_id": "f152e9a7-57e5-4fa5-9335-8c079d6b96e4",
                                "sense_id": "0eadb606-4d29-337b-8ae1-53c30fb803fe",
                                "text": "Ces vécus archaïques prennent la forme d’un enfant/bouche qui s’autovomit, s’autotousse, s’autoexpulse, s’autodétruit."
                            }
                        ]
                    }
