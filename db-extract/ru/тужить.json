                                        "entry_id": "0528c36c-dbf6-3fbd-a164-65ce1dd328ee",
                                        "glosses": [
                                            "A manager or steward, e.g. of a farm."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
