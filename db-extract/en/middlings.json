                    {
                        "sense_id": "86d2952e-3a9c-3dbb-9df3-07c07fad3b37",
                        "entry_id": "68d0b39d-dedf-3b69-89ac-bde3f79a651d",
                        "glosses": [
                            "Partially refined ore or petroleum."
                        ],
                        "tags": [
