                                                "sense_id": "3cca1f61-7792-343a-b741-075ef688c81b",
                                                "text": "Lecteur de cassette, de CD, de DVD."
                                            },
                                            {
                                                "example_id": "de7fbf05-3d14-46d0-8824-25704d48ea26",
                                                "sense_id": "3cca1f61-7792-343a-b741-075ef688c81b",
                                                "text": "Lecteur de code-barres."
                                            },
                                            {
                                                "example_id": "85933aeb-d5a1-47fd-a5c4-d91d92e4a38e",
                                                "sense_id": "3cca1f61-7792-343a-b741-075ef688c81b",
                                                "text": "Lecteur de MP3, de DivX."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "367c4fff-12b4-381e-a22c-92b963d08743",
                                        "entry_id": "4c155bbd-bc00-3349-a1ec-c9fd90e595ba",
                                        "glosses": [
                                            "Espace de stockage centralisé accessible par plusieurs ordinateurs en réseau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a19c2a1b-356a-4ec2-9263-71d8007aadb4",
                                                "sense_id": "367c4fff-12b4-381e-a22c-92b963d08743",
                                                "text": "Connexion d’un lecteur réseau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "747e9e9d-31b8-3093-9d51-cae1e16f288e",
                                        "entry_id": "4c155bbd-bc00-3349-a1ec-c9fd90e595ba",
                                        "glosses": [
                                            "Boîtier permettant de lire tout ou partie des données informatisées d’une carte à puce en les affichant en clair sur un écran."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b96a0f8-62fe-4083-80cb-cbc970061f89",
                                                "sense_id": "747e9e9d-31b8-3093-9d51-cae1e16f288e",
                                                "text": "Le vol au collet marseillais était une arnaque découverte pour la première fois à Marseille qui consistait à bloquer les cartes bleues grâce à un collet (quelquefois, un simple ticket de métro) apposé sur les lecteurs de distributeurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
