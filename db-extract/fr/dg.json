                "senses": [
                    {
                        "sense_id": "5c4b8297-f572-3690-a1ff-fad4296afc82",
                        "entry_id": "26337f1b-d776-3141-afb0-4f60787e6aab",
                        "glosses": [
                            "Directeur général – ou directrice générale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "763d955b-5be8-4690-a2ea-622afeede544",
                                "sense_id": "5c4b8297-f572-3690-a1ff-fad4296afc82",
                                "text": "Une putain d'idée ! Il paraît que vous êtes le crack des cracks, que vous avez démerdé des situations indémerdables pour la Company. Les DG successifs se refilent votre nom comme le Saint-Sacrement."
                            },
                            {
                                "example_id": "ae07d1ca-0a74-4b20-a173-5fd3c22ebf08",
                                "sense_id": "5c4b8297-f572-3690-a1ff-fad4296afc82",
                                "text": "Après avoir appris les détails de cette folle nuit calaisienne, le DG de la police, furibard, a appelé le big boss des Compagnies républicaines de sécurité, lequel s’était bien garder de lui raconter l’histoire."
                            },
                            {
                                "example_id": "312f4e96-b056-4c49-90be-4882262dd0b3",
                                "sense_id": "5c4b8297-f572-3690-a1ff-fad4296afc82",
                                "text": "Si Florence Hardouin, la DG, s’active pour faire sauter son patron, elle espère passer à travers les gouttes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df8a387b-db75-41dc-a33d-14cfca36ce9d",
                        "source_entry_id": "26337f1b-d776-3141-afb0-4f60787e6aab",
                        "source_sense_id": "5c4b8297-f572-3690-a1ff-fad4296afc82",
