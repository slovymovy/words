                "senses": [
                    {
                        "sense_id": "371cab2e-d128-348b-bc48-3a7819f76f3a",
                        "entry_id": "36931e95-a048-3b08-9eb5-b27952f5d60f",
                        "glosses": [
                            "bak waar voer voor dieren in zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec0a4aed-dcb1-4979-b528-35185fecb7d7",
                                "sense_id": "371cab2e-d128-348b-bc48-3a7819f76f3a",
                                "text": "Amerikanen gooien bijna net zo veel voedsel weg als ze opeten. Voedsel rot weg op het land, verdwijnt in de voerbakken van dieren of gaat naar de vuilstort."
                            },
                            {
                                "example_id": "65373ddb-82b4-484e-81e5-c371565b2d4b",
                                "sense_id": "371cab2e-d128-348b-bc48-3a7819f76f3a",
                                "text": "Ook een zilveren voerbak van Joan Rivers geliefde hond Spike leverde veel meer op dan verwacht. Het kommetje wisselde voor 13.750 dollar (12.000 euro) van eigenaar. Christie’s schatte de waarde vooraf op 500 tot 800 dollar (440 tot 700 euro)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cacda30d-2522-4960-b7a7-db163142d852",
                        "source_entry_id": "36931e95-a048-3b08-9eb5-b27952f5d60f",
                        "source_sense_id": "371cab2e-d128-348b-bc48-3a7819f76f3a",
