    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8681e548-aaee-3c24-aad3-5d10fa03b952",
                    "sense_definition": "Extraire le jus ou le liquide d'un aliment ou d'un objet en exerçant une pression.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "serrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, il aime <w>presser</w> une orange pour boire un jus de fruits frais."
                        },
                        {
                            "text": "Pense à bien <w>presser</w> le citron au-dessus de la salade avant de servir."
                        }
                    ],
                    "common_phrases": [
                        "presser un citron",
                        "presser une orange"
                    ]
                },
                {
                    "sense_id": "38a6056b-307d-37c8-8924-d15fc6519029",
                    "sense_definition": "Appuyer fermement sur un bouton, une touche ou une surface.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "serrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il suffit de <w>presser</w> ce bouton noir pour démarrer le moteur de la voiture."
                        },
                        {
                            "text": "Le photographe a <w>pressé</w> le déclencheur au moment précis où le soleil se couchait."
                        }
                    ],
                    "common_phrases": [
                        "presser un bouton",
                        "presser la touche"
                    ]
                },
                {
                    "sense_id": "6c8aafb5-7dfd-3904-94ff-d0d8ac485486",
                    "sense_definition": "Faire vite, se dépêcher d'accomplir une action.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rapidite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons nous <w>presser</w> si nous voulons monter dans le train à l'heure."
                        },
                        {
                            "text": "Les enfants se <w>pressent</w> de ranger tous leurs jouets avant le dîner."
                        }
                    ],
                    "common_phrases": [
                        "se presser de",
                        "ne pas se presser"
                    ]
                },
                {
                    "sense_id": "49c463f0-f69a-3a77-9c8a-db5153df565a",
                    "sense_definition": "Accélérer le rythme ou la cadence d'un mouvement ou d'une activité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rapidite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En voyant le ciel s'assombrir, les randonneurs ont décidé de <w>presser</w> le pas."
                        },
                        {
                            "text": "Le chauffeur a <w>pressé</w> l'allure pour arriver à l'aéroport avant la fermeture."
                        }
                    ],
                    "common_phrases": [
                        "presser le pas",
                        "presser l'allure"
                    ]
                },
                {
                    "sense_id": "3ab709ac-4bea-3eea-8cb1-3cad29a74d0c",
                    "sense_definition": "Être urgent, ne pouvoir souffrir aucun retard.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "urgence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu peux finir ce travail demain matin parce que rien ne <w>presse</w> vraiment."
                        },
                        {
                            "text": "Il faut agir immédiatement car le temps <w>presse</w> et la situation se complique."
                        }
                    ],
                    "common_phrases": [
                        "le temps presse",
                        "rien ne presse"
                    ]
                },
                {
                    "sense_id": "28a4323d-becf-3079-8a74-41c54d94fef8",
                    "sense_definition": "Inciter quelqu'un avec insistance à faire quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "incitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les journalistes n'ont pas cessé de le <w>presser</w> de questions pendant la conférence."
                        },
                        {
                            "text": "Ses parents le <w>pressent</w> de choisir une formation avant la fin de l'année scolaire."
                        }
                    ],
                    "synonyms": [
                        "pousser",
                        "harceler"
                    ],
                    "common_phrases": [
                        "presser de questions"
                    ]
                },
                {
                    "sense_id": "a1d51085-9596-351c-a32d-b71562c183ff",
                    "sense_definition": "Se serrer étroitement en groupe ou se rassembler en grand nombre dans un espace restreint.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "serrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les spectateurs se <w>pressaient</w> devant les grilles du stade dès l'aube pour entrer."
                        },
                        {
                            "text": "Pour échapper au vent d'hiver, les voyageurs se <w>pressent</w> sous le petit abri."
                        }
                    ],
                    "common_phrases": [
                        "se presser contre",
                        "se presser autour"
                    ]
                }
            ]
        }
    ]
