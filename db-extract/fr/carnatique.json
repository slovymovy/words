                        "sense_id": "62d2dc2a-a317-32f2-9c94-708bc661ecca",
                        "entry_id": "98676843-180e-37b9-a0a5-8e1b75dd6b81",
                        "glosses": [
                            "Relatif à la Carnatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8d42cca-ff86-4415-afe0-adca14551ff6",
                                "sense_id": "62d2dc2a-a317-32f2-9c94-708bc661ecca",
                                "text": "Après les guerres carnatiques et la bataille de Wandiwash contre les Britanniques, la présence française fut réduite et se concentra dans les petits comptoirs de Pondichéry, Karikal, Mahé, Chandernagor et Yanaon."
                            }
                        ]
                    },
                    {
                        "sense_id": "4bf71b09-3688-3fa2-a4be-97c22666d987",
                        "entry_id": "98676843-180e-37b9-a0a5-8e1b75dd6b81",
                        "glosses": [
                            "Relatif au Sud de l’Inde."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "19694d65-217b-43ca-b281-8d4f7896dc7d",
                                "sense_id": "4bf71b09-3688-3fa2-a4be-97c22666d987",
                                "text": "Alors que la musique du Nord se complaît dans de lents étirements du son, la musique carnatique privilégie des ornements beaucoup plus incisifs, appogiatures inférieures ou supérieures de certaines notes, ou sortes d’oscillations plus ou moins rapides, appelées kampita, produites elles aussi par déflection de la corde, mais dont l’ambitus est bien loin d’approcher celui de mind."
                            }
                        ]
                    }
