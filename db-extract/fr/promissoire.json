                        "glosses": [
                            "Relatif à une promesse, au fait de promettre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71e5e5cf-6f47-413e-9465-aec7aca75f78",
                                "sense_id": "82148d39-953c-3af3-92e9-7844d10decfe",
                                "text": "Serment promissoire, serment qui ne doit être observé qu'en tant qu'il ne compromet pas la conscience de la personne qui l'a prêté et que l'observation n'en apporte de préjudice à personne."
                            },
                            {
                                "example_id": "e8c388a5-3d22-4a84-b345-666d46891149",
                                "sense_id": "82148d39-953c-3af3-92e9-7844d10decfe",
                                "text": "Le serment se divisait en assertoire et en promissoire : le premier se faisait pour assurer une chose présente ou passée ; le second, pour garantir une promesse."
                            }
                        ]
                    }
