                    "frequency": "Low",
                    "semantic_group_id": "traditional_clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They too revert to simpler, non-western clothes—saris, dhotis, and <w>pyjamas</w>.",
                            "target_lang_translations": {
