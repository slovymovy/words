                "senses": [
                    {
                        "sense_id": "b030c139-a26f-3fb5-b5e9-8a6e519c9871",
                        "entry_id": "708f92cc-3bcc-3ebe-afbf-97c1faf61e0d",
                        "glosses": [
                            "eye-catching (visually pleasing in a hip or bold manner)"
                        ],
                        "tags": [
                            "Netherlands"
                        ],
                        "examples": [
                            {
                                "example_id": "8e59a9c3-cd5a-418b-9312-24ff14e4dd7d",
                                "sense_id": "b030c139-a26f-3fb5-b5e9-8a6e519c9871",
                                "text": "Dick doet er niet aan mee. Geen kekke overhemden, geen moeilijke kapsels (al was dat over zijn schedel gekamde haar dat hij vroeger had ook een soort van hip, destijds), geen laklederen laarsjes en geen Only God Can Judge Me-tatoeage in zijn nek.",
                                "translation": "Dick does not go along with it. No flashy shirts, no difficult hairdo (although the hairstyle that he used to have, hair combed sideways, was also some kind of trendy, at that time), no glossy leather boots and no \"Only God Can Judge Me\" tattoos on his neck.",
                                "english": "Dick does not go along with it. No flashy shirts, no difficult hairdo (although the hairstyle that he used to have, hair combed sideways, was also some kind of trendy, at that time), no glossy leather boots and no \"Only God Can Judge Me\" tattoos on his neck."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f526d10-6eac-33f7-90c7-c340919a497b",
                        "entry_id": "708f92cc-3bcc-3ebe-afbf-97c1faf61e0d",
                        "glosses": [
                            "fashionable"
                        ],
                        "tags": [
                            "Netherlands",
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6eca50e6-92e5-398a-bce4-d8139a5652ac",
                        "entry_id": "708f92cc-3bcc-3ebe-afbf-97c1faf61e0d",
                        "glosses": [
                            "sassy (bold and spirited; cheeky)"
                        ],
                        "tags": [
                            "Netherlands"
                        ],
                        "examples": [
                            {
                                "example_id": "7cb3212d-6298-4e2e-958c-9b2ca742b10d",
                                "sense_id": "6eca50e6-92e5-398a-bce4-d8139a5652ac",
                                "text": "In feite is het verschil met bedelende zwervers niet heel groot, alleen zijn die meestal veel minder opdringerig en aanwezig. Een ander verschil is dat straatwervers vaak kekke meisjes en jongens zijn die bovendien zeggen dat je kapsel tof is en dat je een relaxt persoon lijkt.",
                                "translation": "In fact the difference with begging vagrants is not very large, but these are usually much less intrusive and prominent. Another difference is that street promoters are often cheeky girls and boys who moreover say that your hairstyle is swell and that you seem like a relaxed kind of person.",
                                "english": "In fact the difference with begging vagrants is not very large, but these are usually much less intrusive and prominent. Another difference is that street promoters are often cheeky girls and boys who moreover say that your hairstyle is swell and that you seem like a relaxed kind of person."
                            }
                        ]
                    }
