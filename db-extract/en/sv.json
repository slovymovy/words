                                    {
                                        "sense_id": "bd5bb65d-c62a-3f57-a581-40a5bf80bdf5",
                                        "entry_id": "21658ac3-fc56-3295-a2ce-f5888f43bacc",
                                        "glosses": [
                                            "Qui évoque la forme d'une lettre V."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5d58f47-588f-42ef-96f9-adc13909e5f6",
                                                "sense_id": "bd5bb65d-c62a-3f57-a581-40a5bf80bdf5",
                                                "text": "Tout là-haut, contre le bleu profond du soir, glissait un mince V d'oies sauvages."
                                            },
                                            {
                                                "example_id": "1885e62e-e9f3-4aa9-ae2a-d4e9788e005b",
                                                "sense_id": "bd5bb65d-c62a-3f57-a581-40a5bf80bdf5",
                                                "text": "Cet homme sympathique, photogénique, un peu bourru, mais très éloquent, fumait des cigares et paraissait derrière le train spécial qui le véhiculait au nom du roi, tenant deux doigts de la main droite levés en signe de V."
                                            },
                                            {
                                                "example_id": "c2e32074-b6d5-45c8-855c-77addeab1542",
                                                "sense_id": "bd5bb65d-c62a-3f57-a581-40a5bf80bdf5",
                                                "text": "Il s’arrêta soudain et, les bras en V comme un président de la République, hurla le nom de Pat qui roula comme une pierre dans le silence."
                                            }
                                        ]
                                    }
                                ]
