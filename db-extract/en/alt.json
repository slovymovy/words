                            },
                            {
                                "example_id": "cd72a2f1-9bd6-4085-bca6-ca8a806f7c78",
                                "sense_id": "88876c26-1dd9-338f-8253-81c266e5bec4",
                                "text": "[…]Adele, Chris Martin of Coldplay, Frank Ocean, Drake, and Ed Sheeran are among many artists who don't appear to spend a lot of time online (or if they do, it's using alt accounts)."
                            }
                        ]
                    },
                    {
                        "sense_id": "7cec8da2-e87f-37a0-bf9a-07a7cf5c1c1f",
