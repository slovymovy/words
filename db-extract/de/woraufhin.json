                                                "example_id": "ce2d2481-8d90-4b8a-a811-7fea1aad591e",
                                                "sense_id": "c09b9c77-fd8c-360e-ab5a-e7915299607f",
                                                "text": "Why yes, that’s true."
                                            },
                                            {
                                                "example_id": "0317fb8b-bbe0-43a8-b75a-6f7787f9adfd",
                                                "sense_id": "c09b9c77-fd8c-360e-ab5a-e7915299607f",
                                                "text": "VVhy Child, I tell thee if I vvas thy Mmother I ſhould not diſovvn thee; Don't you ſee I am as kind to you as if I vvas your Mother?",
                                                "translation": "Roxana",
                                                "english": "Roxana"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "why",
                                "target_lang_code": "en",
