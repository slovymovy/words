                    {
                        "translation_id": "e8067151-98c0-446f-84cc-2ac6549ef562",
                        "source_entry_id": "24c56359-aad6-341b-ad45-30dcb8ae1b54",
                        "source_sense_description": "deduction of inferences or interpretations",
                        "target_lang_word": "redenering",
