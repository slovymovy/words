                                    {
                                        "sense_id": "e0e882f7-0d4f-3b21-9aca-dc2e938ef97c",
                                        "entry_id": "de8ade41-db44-3a0e-8a90-1ff155b065c9",
                                        "glosses": [
                                            "Petit monceau de terre qu’une taupe a élevé en fouillant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3392ff61-19b7-453b-819f-bddb95f57f87",
                                                "sense_id": "e0e882f7-0d4f-3b21-9aca-dc2e938ef97c",
                                                "text": "Une prairie pleine de taupinières."
                                            },
                                            {
                                                "example_id": "328801c1-4bde-44f3-9565-aca8a3d1f292",
                                                "sense_id": "e0e882f7-0d4f-3b21-9aca-dc2e938ef97c",
                                                "text": "La mine ne se réduit pas à des couloirs de taupinière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33706642-1862-3b7b-9afb-16f7c34f31ca",
                                        "entry_id": "de8ade41-db44-3a0e-8a90-1ff155b065c9",
                                        "glosses": [
                                            "Renflement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc8bdbf8-a301-4ae4-b831-fa5f82c05b6c",
                                                "sense_id": "33706642-1862-3b7b-9afb-16f7c34f31ca",
                                                "text": "Des rides brunes de chaque côté du gonflement fiévreux des lèvres, des crevasses, des taupinières."
                                            },
                                            {
                                                "example_id": "acf69555-5c5d-45be-8d56-44759ca03dce",
                                                "sense_id": "33706642-1862-3b7b-9afb-16f7c34f31ca",
                                                "text": "Longtemps j’étouffai dans les vallées, les plaines m’accablèrent : je me traînais sur la planète Mars, la pesanteur m’écrasait ; il me suffisait de gravir une taupinière pour retrouver la joie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68729a45-d884-3837-92d6-a9d53c3e7613",
                                        "entry_id": "de8ade41-db44-3a0e-8a90-1ff155b065c9",
                                        "glosses": [
                                            "Petite élévation de terre, d’un monticule au milieu de la campagne."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09cdf271-9401-4633-bb10-41bdaca3a7d3",
                                                "sense_id": "68729a45-d884-3837-92d6-a9d53c3e7613",
                                                "text": "Il faudrait abattre cette taupinière qui arrête la vue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e499c01b-6831-3745-a6b1-ea37107dadcb",
                                        "entry_id": "de8ade41-db44-3a0e-8a90-1ff155b065c9",
                                        "glosses": [
                                            "Petite maison de campagne basse et sans apparence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfc3e067-9cbf-43f5-8674-2690d52f70d5",
                                                "sense_id": "e499c01b-6831-3745-a6b1-ea37107dadcb",
                                                "text": "Ils logent dans une taupinière décorée du nom de château."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
