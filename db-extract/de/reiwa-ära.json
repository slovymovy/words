                "senses": [
                    {
                        "sense_id": "fdce2c62-0ae6-32dd-b04e-17d647762663",
                        "entry_id": "53a5790a-6faf-388b-9392-dd8765873cec",
                        "glosses": [
                            "in der japanischen Zeitrechnung Zeitraum seit dem 1. Mai 2019, der die Heisei-Zeit vorausgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b04b7d84-7047-4358-8c99-b8a5318fd090",
                                "sense_id": "fdce2c62-0ae6-32dd-b04e-17d647762663",
                                "text": "„Er und Kaiserin Michiko wünschen aufrichtig, dass ‚die Reiwa-Ära, die morgen beginnt, stabil und erfolgreich werde; und ich bete mit ganzem Herzen für den Frieden und das Glück aller Menschen in Japan. Und draußen in der Welt.‘“"
                            },
                            {
                                "example_id": "fc1652ea-83d6-4bc6-b591-e658c5c4c32f",
                                "sense_id": "fdce2c62-0ae6-32dd-b04e-17d647762663",
                                "text": "„Abe lobte das Paket vor der Kabinettsitzung als ersten Wirtschaftsstimulus der Reiwa-Ära.“"
                            },
                            {
                                "example_id": "855163ae-e5cc-461e-8b14-9d641353e73c",
                                "sense_id": "fdce2c62-0ae6-32dd-b04e-17d647762663",
                                "text": "„Für die Reiwa-Ära seines Sohnes Naruhito, die am Mittwoch beginnt, wünschte er, dass es eine stabile und fruchtbare Zeit werde: «Ich bete für Frieden und Glück für die Menschen in Japan und in der Welt.»“"
                            },
                            {
                                "example_id": "76f48738-b1fb-4130-a37f-93c5d3719d98",
                                "sense_id": "fdce2c62-0ae6-32dd-b04e-17d647762663",
                                "text": "„Er wünsche zusammen mit der Kaiserin, dass die beginnende Reiwa-Ära stabil und fruchtbar werde.“"
                            },
                            {
                                "example_id": "9ac0629d-a81e-4bc8-838e-63f2bba6168e",
                                "sense_id": "fdce2c62-0ae6-32dd-b04e-17d647762663",
                                "text": "„Mit dem Amtsantritt seines Sohnes Naruhito öffnet die Reiwa-Ära im Jahr 2019 nun das nächste Kapitel japanischer Geschichte, die Ära der ‚schönen Harmonie‘.“"
                            },
                            {
                                "example_id": "bbcd12c9-f531-45a0-a201-14bf64e3448a",
                                "sense_id": "fdce2c62-0ae6-32dd-b04e-17d647762663",
                                "text": "„Seit Mittwoch lebt Japan im Jahr eins der Reiwa-Ära.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
