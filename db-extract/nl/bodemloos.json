                "translations": [
                    {
                        "translation_id": "7c5fbc58-c940-4ecc-b3a1-cf60c7bb7eb5",
                        "source_entry_id": "e7a93bee-d81f-3f28-a9c5-37529559b210",
                        "source_sense_id": "a12cad99-9868-3570-baa4-e3310839f301",
                        "target_lang_word": "bodenlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bodenlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09884468-aad6-315d-8ff3-e02c64c5b7a2",
                                        "entry_id": "c0121ea9-f7c8-3d07-948c-e98df2b48a36",
                                        "glosses": [
                                            "so tief, dass man keinen Grund, kein Ende sehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fe02d98-5643-4a2a-990d-a8bb98dedd1d",
                                                "sense_id": "09884468-aad6-315d-8ff3-e02c64c5b7a2",
                                                "text": "Ich möchte nicht so nahe an den Abgrund treten, weil ich Angst davor habe, in die bodenlose Tiefe zu stürzen."
                                            },
                                            {
                                                "example_id": "685aa77d-7603-4f9a-8c22-91c0514357ac",
                                                "sense_id": "09884468-aad6-315d-8ff3-e02c64c5b7a2",
                                                "text": "Den kompletten Wortschatz der ganzen Welt fehlerfrei im Wiktionary aufnehmen zu wollen, ist ein bodenloses Unterfangen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0286f7d5-bde7-30ad-bdd4-9ec6a8830367",
                                        "entry_id": "c0121ea9-f7c8-3d07-948c-e98df2b48a36",
                                        "glosses": [
                                            "sehr groß, besonders ausgeprägt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5e00940-9662-4704-97b3-50f58176c5b1",
                                                "sense_id": "0286f7d5-bde7-30ad-bdd4-9ec6a8830367",
                                                "text": "Seine bodenlose Selbsteingenommenheit macht mich ganz verrückt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d589684-9d82-41e2-9050-03abf1ed66e2",
                        "source_entry_id": "e7a93bee-d81f-3f28-a9c5-37529559b210",
                        "source_sense_id": "a12cad99-9868-3570-baa4-e3310839f301",
                        "target_lang_word": "bottomless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bottomless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc554de7-45a0-3292-8fec-09cb9f9b84df",
                                        "entry_id": "a664c6a8-9b20-32df-ae8d-dbe8c95a897f",
                                        "glosses": [
                                            "Having no bottom."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb20ba75-9ea6-4894-adfa-bf8086b577b1",
                                                "sense_id": "cc554de7-45a0-3292-8fec-09cb9f9b84df",
                                                "text": "The vast swamps of Southern Ontario proved a grim nightmare to the construction gangs. Treacherous and seemingly bottomless, the swamps swallowed thousands of tons of timber and debris, yet still afforded no firm surface on which the track could be laid."
                                            },
                                            {
                                                "example_id": "96468232-2e5e-4850-a385-3970fcfac834",
                                                "sense_id": "cc554de7-45a0-3292-8fec-09cb9f9b84df",
                                                "text": "And while the railway's finances will forever remain a bottomless black hole, Highways England finances are rapidly becoming a bottomless pothole!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cca415b-dfbe-3a56-a5ec-1bfbdaa29698",
                                        "entry_id": "a664c6a8-9b20-32df-ae8d-dbe8c95a897f",
                                        "glosses": [
                                            "Extremely deep."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb5483d8-b4e7-35ce-a026-0eb61e20d310",
                                        "entry_id": "a664c6a8-9b20-32df-ae8d-dbe8c95a897f",
                                        "glosses": [
                                            "Having no bounds; limitless."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdd26fb6-0f13-4a0c-8941-d5af00fbcdfe",
                                                "sense_id": "bb5483d8-b4e7-35ce-a026-0eb61e20d310",
                                                "text": "The restaurant offered bottomless drinks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f9d7e1a-a0e0-3d0a-a9ea-7d62461fe102",
                                        "entry_id": "a664c6a8-9b20-32df-ae8d-dbe8c95a897f",
                                        "glosses": [
                                            "Of a meal: accompanied by unlimited drinks."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36a4f9d4-33fa-4c99-89ca-dc3f9ce7ef1a",
                                                "sense_id": "9f9d7e1a-a0e0-3d0a-a9ea-7d62461fe102",
                                                "text": "I get a message from some school friends about a bottomless brunch they want to go to."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "034e5bc2-ef55-364c-bae7-c192dc204ffd",
                                        "entry_id": "a664c6a8-9b20-32df-ae8d-dbe8c95a897f",
                                        "glosses": [
                                            "Difficult to understand; unfathomable."
