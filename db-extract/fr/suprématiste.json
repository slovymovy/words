                        "glosses": [
                            "Adepte du mouvement artistique du suprématisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62e81f83-eb01-4dbe-ad7d-4df48bf6e47b",
                                "sense_id": "51bb8dc5-a5fa-39a4-b631-5c3e95efcd49",
                                "text": "Capitale internationale et résolument engagée, Berlin accueille avec prodigalité les représentants de la peinture moderne, comme Hofer, Nagel, Pechstein, l’écorché vif George Grosz, le photomonteur rebelle John Heartfield, mais aussi les futuristes italiens, les suprématistes ou les constructivistes russes."
                            }
                        ]
                    },
                    {
                        "sense_id": "b97c01b7-f7d8-3455-bf7c-77cf0b0554be",
                        "entry_id": "fcf25410-e0b7-3fda-b794-d204baf9affd",
                        "glosses": [
                            "Tenant de la philosophie néonazie qui pose le principe la suprématie de la race pure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8f915b7-c45e-4bc9-a777-55c53c6bb6c9",
                                "sense_id": "b97c01b7-f7d8-3455-bf7c-77cf0b0554be",
                                "text": "Nous devons nous battre sans relâche contre les bigots, les racistes, les machistes, les suprématistes. Réveillons-nous car nos ennemis sont puissants."
                            }
                        ]
                    }
                ],
