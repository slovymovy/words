                    {
                        "translation_id": "d46ec407-a120-4f6a-a19e-927969edb1fe",
                        "source_entry_id": "1c5826ea-484f-37b8-8c7a-7886e8fa8cfb",
                        "source_sense_id": "0d1b5dda-9980-3971-af8c-6a372ccb44ea",
