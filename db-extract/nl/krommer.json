                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c037b29-99ac-385e-88f3-939586305528",
                        "entry_id": "93d0e5bf-1e9d-333f-a086-9a7ad14af051",
                        "glosses": [
                            "stuk hout met een gebogen vorm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab768020-a2c0-4a7c-9c09-609a2bddde0a",
                                "sense_id": "3c037b29-99ac-385e-88f3-939586305528",
                                "text": "Van de totale uitgaven was tussen de ƒ600.000 en ƒ750.000 bestemd voor de scheepsbouw met als grootste kostenpost eikenhout voor de scheepsromp. Het Hamburgse, overzeese en bovenlandse hout werd aangeleverd als rechthout en krommers (speciaal kromgegroeide bomen), die vervolgens in de houtzaagmolens bij de scheepswerf tot balken en planken verzaagd werden."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bb0ac21-a2f3-3afd-9e9b-bb49d3342476",
                        "entry_id": "93d0e5bf-1e9d-333f-a086-9a7ad14af051",
                        "glosses": [
                            ": staander met een gebogen vorm, bijvoorbeeld als deel van spant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "544294a6-cfab-460e-9df4-bdd1b030faf1",
                                "sense_id": "1bb0ac21-a2f3-3afd-9e9b-bb49d3342476",
                                "text": "De boogvormige ribben van de peer, elk met een doorsnede van ca. 15 × 15 centimeter bestonden elk uit enige zware stukken eikenhout, die destijds uit zwaar plaathout waren gezaagd, overeenkomstig de gewenste kromming. De oorspronkelijke constructie zal bestaan hebben uit krommers aan één stuk."
                            },
                            {
                                "example_id": "e619f63a-8bd3-4286-a3af-4d34253fd16b",
                                "sense_id": "1bb0ac21-a2f3-3afd-9e9b-bb49d3342476",
                                "text": "Om ruimte te winnen werden in de tijd van de eikehoutconstructies soms de spantbenen vervaardigd uit kromgegroeid hout, de zogenaamde krommer."
                            }
                        ]
                    },
                    {
                        "sense_id": "d58d959d-5db2-359f-943c-db8a854dcaa4",
                        "entry_id": "93d0e5bf-1e9d-333f-a086-9a7ad14af051",
                        "glosses": [
                            "dunne scharnierpen die bovenaan in een oog is gebogen, zodat decorstukken met scharnieren snel kunnen worden opgebouwd en afgebroken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d49849d4-a1ad-4d86-aeca-7487dac72aba",
                                "sense_id": "d58d959d-5db2-359f-943c-db8a854dcaa4",
                                "text": "De krommer als woord is voortgekomen uit de traditie van de dagelijks praktijk bij het bouwen van decorstukken. Het betreft een grote spijker, waarvan de kop is omgebogen en die dient als een pin om twee scharnierhelften met elkaar te verbinden. De krommer kan gemakkelijk zonder gereedschap of een klein tikje van een hamer verwijderd worden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18e86643-07c7-4264-92c3-d8df1d5f1a46",
                        "source_entry_id": "93d0e5bf-1e9d-333f-a086-9a7ad14af051",
                        "target_lang_word": "Krummholz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8987e4df-2a64-4c17-96d4-f5bdd1939631",
                        "source_entry_id": "93d0e5bf-1e9d-333f-a086-9a7ad14af051",
                        "target_lang_word": "knee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e46ed72-6bf4-3a34-be36-56b0129395f8",
                                        "entry_id": "e74baa83-df90-3746-9342-5c167a6f800f",
                                        "glosses": [
                                            "In humans, the joint or the region of the joint in the middle part of the leg between the thigh and the shank."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1076ae72-47ec-45f6-96a0-da84a6ded503",
                                                "sense_id": "2e46ed72-6bf4-3a34-be36-56b0129395f8",
                                                "text": "Penny was wearing a miniskirt, so she skinned her exposed knees when she fell."
                                            },
                                            {
                                                "example_id": "6e0c2c69-d6d4-41f5-8866-846e7f5b4eac",
                                                "sense_id": "2e46ed72-6bf4-3a34-be36-56b0129395f8",
                                                "text": "He made him ſtoup perforce vnto his knee, / And doe vnwilling worſhip to the Saint, / That on his ſhield depainted he did ſee[…]"
                                            },
                                            {
                                                "example_id": "39431ab6-8b9d-4406-9e77-3ac72cb08e83",
                                                "sense_id": "2e46ed72-6bf4-3a34-be36-56b0129395f8",
                                                "text": "KORRIS: I have tasted your heart. You have been with them, but you are still \"of\" us. Do not deny the challenge of your destiny. Get off your knees and soar. Open your eyes and let the dream take flight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1de3eeee-16e0-337e-abac-c410b3638f2c",
                                        "entry_id": "e74baa83-df90-3746-9342-5c167a6f800f",
                                        "glosses": [
                                            "In the horse and allied animals, the carpal joint, corresponding to the wrist in humans."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4525652-b120-3a7f-9d2d-283bbe49b232",
                                        "entry_id": "e74baa83-df90-3746-9342-5c167a6f800f",
                                        "glosses": [
                                            "In birds:",
                                            "The tarsal joint, uniting the tarsometatarsus and the tibiotarsus (homologous to the human ankle)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee3c05d1-3ef7-3b8d-85c8-aa140a5337c0",
                                        "entry_id": "e74baa83-df90-3746-9342-5c167a6f800f",
                                        "glosses": [
                                            "In birds:",
                                            "The joint uniting the tibiotarsus and the femur, typically hidden beneath plumage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "251b9776-1267-385f-9db1-3cec260593a4",
                                        "entry_id": "e74baa83-df90-3746-9342-5c167a6f800f",
                                        "glosses": [
                                            "The part of a garment that covers the knee."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "793d2493-60c3-3c5b-8568-563b334258f0",
                                        "entry_id": "e74baa83-df90-3746-9342-5c167a6f800f",
                                        "glosses": [
                                            "A piece of timber or metal formed with an angle somewhat in the shape of the human knee when bent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "107b3164-4a54-4d0c-b962-8ab33948b864",
                                                "sense_id": "793d2493-60c3-3c5b-8568-563b334258f0",
                                                "text": "Deck beams were supported by hanging knees, triangular pieces of wood typically found underneath the timbers they are designed to support, but in this case found above them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6e0ec91-420c-34f4-a193-a84200377f93",
                                        "entry_id": "e74baa83-df90-3746-9342-5c167a6f800f",
                                        "glosses": [
                                            "An act of kneeling, especially to show respect or courtesy."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "111ad0c6-a242-45ed-ba24-dcba6d53a92c",
                                                "sense_id": "c6e0ec91-420c-34f4-a193-a84200377f93",
                                                "text": "Give them title, knee, and approbation."
                                            },
                                            {
                                                "example_id": "9217f3be-75f7-4505-ace7-feb7c2f50a33",
                                                "sense_id": "c6e0ec91-420c-34f4-a193-a84200377f93",
                                                "text": "[…] and he made a knee to the Caesar of Patna, giving that man all honour due to him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffbed8ea-6836-3871-8853-0ce1a4e633dc",
                                        "entry_id": "e74baa83-df90-3746-9342-5c167a6f800f",
                                        "glosses": [
                                            "Any knee-shaped item or sharp angle in a line; an inflection point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3782fcb2-61ad-4766-8939-bb1c4836591f",
                                                "sense_id": "ffbed8ea-6836-3871-8853-0ce1a4e633dc",
                                                "text": "the knee of a graph"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84baf7db-731e-3fa7-b1e2-c75ed66e2115",
                                        "entry_id": "e74baa83-df90-3746-9342-5c167a6f800f",
                                        "glosses": [
                                            "A blow made with the knee; a kneeing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc5c9f75-b466-4df3-88ff-552c2f6c7553",
                                                "sense_id": "84baf7db-731e-3fa7-b1e2-c75ed66e2115",
                                                "text": "Tante was groggy but not quite out so Winnie gave him a knee to the jaw that Rose had shown her, and that was enough. He slumped like a rag-doll to the floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aecfcc95-974c-3ea0-b302-ba9a35df1304",
                                        "entry_id": "e74baa83-df90-3746-9342-5c167a6f800f",
                                        "glosses": [
                                            "The presence of a parent etc., where a young child acquires early knowledge."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50f5386d-dd33-439d-8066-933cb648832e",
                                                "sense_id": "aecfcc95-974c-3ea0-b302-ba9a35df1304",
                                                "text": "The duty is, or should be, a thing taught at one's father's knee, and the structure of the family gently enforces it."
                                            },
                                            {
                                                "example_id": "79ed8ae0-fa33-45db-aa7e-692c6280addb",
                                                "sense_id": "aecfcc95-974c-3ea0-b302-ba9a35df1304",
                                                "text": "This has significant implications for sacramental theology which it seems Pusey even realised in the way he spoke of his early life and of learning all he knew about the Eucharist and the Catholic faith at his mother's knee, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "knee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76c31e32-a759-3503-8c93-70613b774020",
                                        "entry_id": "ca5b630f-f081-3d2f-badd-19055ad9c98a",
                                        "glosses": [
                                            "To kneel to."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "457d3b06-bc0b-4118-9766-84b81b5967ee",
                                                "sense_id": "76c31e32-a759-3503-8c93-70613b774020",
                                                "text": "I could as well be brought / To knee his throne and, squire-like, pension beg / To keep base life afoot"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56f9af64-a470-3130-b31d-997d128a1b39",
                                        "entry_id": "ca5b630f-f081-3d2f-badd-19055ad9c98a",
                                        "glosses": [
                                            "To poke or strike with the knee."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ae891a-e764-4743-98f7-1c7f1a846878",
                                                "sense_id": "56f9af64-a470-3130-b31d-997d128a1b39",
                                                "text": "When I blocked her from leaving, she kneed me in the groin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86611e53-e367-33c5-b27d-fcd9199a236e",
                                        "entry_id": "ca5b630f-f081-3d2f-badd-19055ad9c98a",
                                        "glosses": [
                                            "To move on the knees; to use the knees to move."
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35c6e10b-74b1-44b5-948d-9040c3cb2609",
                                                "sense_id": "86611e53-e367-33c5-b27d-fcd9199a236e",
                                                "text": "Hassan kneed himself up, over, in, soundlessly, feet on floor, knife out, eyes like blunter knife trying to cut darkness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b3ff607-d335-4eb4-a7c6-f43193dd4199",
                        "source_entry_id": "93d0e5bf-1e9d-333f-a086-9a7ad14af051",
                        "target_lang_word": "courbe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courbe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40fc52da-644b-3fb1-9515-e31b62269385",
                                        "entry_id": "7abedefb-66ef-31bb-a121-ab9b4f250db2",
                                        "glosses": [
                                            "Qui n’est ni droit, ni composé de lignes droites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e7cc0c9-e716-4999-b10a-def549ac0e56",
                                                "sense_id": "40fc52da-644b-3fb1-9515-e31b62269385",
                                                "text": "Mais, je n’y ai pas trouvé, comme aux jours où tu partageais mon repas, la trace courbe de tes dents, qui rendait à ma bouche la mie aussi douce qu’un baiser, et c’est le cœur serré que je reprends les sentiers parsemés de pierres violettes."
                                            },
                                            {
                                                "example_id": "0f9b629a-028d-46f4-ae41-586e5df56f74",
                                                "sense_id": "40fc52da-644b-3fb1-9515-e31b62269385",
                                                "text": "Araser les angles ou les éventuelles parties courbes à l’aide d'un cutter à lame droite en prenant appui sur le couteau à maroufler."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "courbe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba3b1b04-79c0-360c-a7de-7028b03e818e",
                                        "entry_id": "30c0711d-094d-3529-a631-900fc538c1da",
                                        "glosses": [
                                            "Ligne dont la direction change de façon continue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef172ae0-b13a-45f2-afc9-f75aae5ad1f8",
                                                "sense_id": "ba3b1b04-79c0-360c-a7de-7028b03e818e",
                                                "text": "Ces considérations nous portaient donc à croire que l’histoire des bouts de corde était le produit de l’imagination de quelque amateur de l’horrible, de ces gens qui ne peuvent voir une hart se balançant à une branche d'arbre sans que leur esprit frappé ne mette un pendu au bout, avec des corbeaux décrivant leur affreuse courbe autour du supplicié pour en choisir les meilleurs morceaux; […]."
                                            },
                                            {
                                                "example_id": "1452ee3a-b92b-477f-a2cc-ddbfc2eb94b6",
                                                "sense_id": "ba3b1b04-79c0-360c-a7de-7028b03e818e",
                                                "text": "[…] et la nuit n'était troublée que par les brusques paraboles des fusées éclairantes qui montaient aux deux côté du marécage et, parvenues au sommet de leur courbe, ouvraient leurs cônes blancs et s'épanchaient doucement comme des lys renversés."
                                            },
                                            {
                                                "example_id": "327faa02-76ed-4b37-bdbc-6ace6c2758ef",
                                                "sense_id": "ba3b1b04-79c0-360c-a7de-7028b03e818e",
                                                "text": "La place de la Nation, […], s'ouvrait à tous les vents. Des tramways éclairés et vides y décrivaient, en piaulant sur leurs rails, une courbe laborieuse […]."
                                            },
                                            {
                                                "example_id": "0787f20f-00e3-439b-b2aa-755527ba77eb",
                                                "sense_id": "ba3b1b04-79c0-360c-a7de-7028b03e818e",
                                                "text": "Certes, le virolo faisait dans le vicelard, il donnait dans le cumul ; en plus d'une longue courbe légèrement en dévers, ce petit rigolo se payait le luxe d'être aussi un viaduc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac318f4f-c9fb-3b47-a8e9-8a82ec2474f7",
                                        "entry_id": "30c0711d-094d-3529-a631-900fc538c1da",
                                        "glosses": [
                                            "Ligne quelconque, sous-ensemble d'un espace euclidien."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c77226e-bc8d-3f49-9585-f377119d9026",
                                        "entry_id": "30c0711d-094d-3529-a631-900fc538c1da",
                                        "glosses": [
                                            "Représentation graphique d'une fonction binomiale sous forme de diagramme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8c65c5c-1f7b-4251-9219-4099065d67fd",
                                                "sense_id": "2c77226e-bc8d-3f49-9585-f377119d9026",
                                                "text": "La courbe d'aimantation stable passe par l'origine; c'est en quelque sorte, la courbe médiane entre les deux branches de la courbe d'hystérésis."
                                            },
                                            {
                                                "example_id": "0877a9f3-9f29-42bf-b957-7c8b64a542fe",
                                                "sense_id": "2c77226e-bc8d-3f49-9585-f377119d9026",
                                                "text": "Ces courbes sont de la forme hyperbolique et sensiblement de l'équation xy = constante."
                                            },
                                            {
                                                "example_id": "e9d388cd-d71c-48e7-ab2b-9011b43da4e4",
                                                "sense_id": "2c77226e-bc8d-3f49-9585-f377119d9026",
                                                "text": "Tel est le but des courbes de lavabilité des charbons imaginées par Hanappe, vers l'année 1912 et dont l'usage est devenu courant dans tous les lavoirs français et belges."
                                            },
                                            {
                                                "example_id": "c6a98152-d3e4-4fc2-8cc5-78a006a05e65",
                                                "sense_id": "2c77226e-bc8d-3f49-9585-f377119d9026",
                                                "text": "Cette table donne le moyen d'établir, dans l'hypothèse où la courbe de la marée est une sinusoïde, la hauteur de la marée à un instant quelconque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "445c9af8-bab4-36c2-ac25-fe745fb25f51",
                                        "entry_id": "30c0711d-094d-3529-a631-900fc538c1da",
                                        "glosses": [
                                            "Pièce de bois en forme d’arc qui sert aux ouvrages de charpenterie et qui entre principalement dans la construction des navires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bfc5b901-0ed5-36f7-8092-0d83f01d6ba5",
