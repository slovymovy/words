                        "source_entry_id": "48f4919d-5407-3dd8-a553-5f466c62211c",
                        "source_sense_id": "7b6cf483-c0b8-37f4-b104-9008be33e35c",
                        "target_lang_word": "уку́с",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "уку́с",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dec51b49-6a98-37cc-9560-5e7eb9725fec",
                                        "entry_id": "ec42d2ca-0267-36bc-beaf-211b7667079f",
                                        "glosses": [
                                            "действие по значению гл. кусать; смыкание челюстей вокруг чего-либо с последующим вгрызанием в него зубов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2a8b63f-3c62-47d5-9910-3a6a42b6bc19",
                                                "sense_id": "dec51b49-6a98-37cc-9560-5e7eb9725fec",
                                                "text": "Тубы с борщом, творогом, крохотные, на один укус, буханочки, чтоб не сорить крошками в невесомости, сублимированные клубника, индейка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98d82615-fb6c-3b22-a02b-dbc73c4fed5a",
                                        "entry_id": "ec42d2ca-0267-36bc-beaf-211b7667079f",
                                        "glosses": [
                                            "действие по значению гл. укусить; вонзание жала или хоботка насекомого"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "445f8750-6b05-4c6b-acbb-594d72a24cdb",
                                                "sense_id": "98d82615-fb6c-3b22-a02b-dbc73c4fed5a",
                                                "text": "Память о наших разговорах перед впадением в сон под низко висящими крупными звездами была бы приятной, если бы не укус скорпиона, которого я во сне случайно коснулся рукой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c173aae-9266-3878-809d-c483ef8b1333",
                                        "entry_id": "ec42d2ca-0267-36bc-beaf-211b7667079f",
                                        "glosses": [
                                            "болезненный след от укуса [1] или [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae1207d7-bb66-48ed-a6d9-2ba9e1beabbb",
                                                "sense_id": "4c173aae-9266-3878-809d-c483ef8b1333",
                                                "text": "От своего крика я просыпаюсь, прибегают из соседней комнаты родители, и на моей ноге довольно долго потом держится укус с четкими отпечатками маленьких зубов."
                                            },
                                            {
                                                "example_id": "562b56fc-8ebb-4c48-8470-45379f32a202",
                                                "sense_id": "4c173aae-9266-3878-809d-c483ef8b1333",
                                                "text": "— Человеческий укус хуже собачьего, — сказал верзила, кривясь от сочувствия."
                                            },
                                            {
                                                "example_id": "0b6a64e1-84b0-4840-a65d-70f425332670",
                                                "sense_id": "4c173aae-9266-3878-809d-c483ef8b1333",
                                                "text": "Ничтожный прыщик на лице повергал ее в уныние, так же как заусеницы или укус комара."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
