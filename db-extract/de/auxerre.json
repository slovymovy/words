                            {
                                "example_id": "0b8e30f1-10cf-4f0a-895b-b00615f7a5d7",
                                "sense_id": "1bc28c71-ffcd-3dee-aae7-5b7ef9e345ff",
                                "text": "„In einer Rede in Auxerre erklärt der französische Ministerpräsident Emile Combes, dass er das Konkordat mit dem Vatikan nicht erneuern werde.“"
                            }
