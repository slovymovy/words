                        "sense_id": "642277bb-4b62-3149-a3ed-b30f59b892ea",
                        "entry_id": "341d4a46-d9bc-334a-a964-9d69f7cc1733",
                        "glosses": [
                            "der Fraktionsvorsitzende der größten Oppositionsfraktion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0a41429-1485-4500-b7b2-efe16f9b5b9e",
                                "sense_id": "642277bb-4b62-3149-a3ed-b30f59b892ea",
                                "text": "Wer ist Sachsens Oppositionsführer?"
                            },
                            {
                                "example_id": "3fc05969-f4e2-411f-8287-cb8693e6cc06",
                                "sense_id": "642277bb-4b62-3149-a3ed-b30f59b892ea",
                                "text": "„Unverkennbare Anzeichen des Greisenalters machten sich deutlich bei ihm bemerkbar: plötzliches Einschlafen, Vergesslichkeit für nur kurze Zeit zurückliegende Ereignisse und ein gutes Gedächtnis für längst Vergangenes; und auch die kindliche Eitelkeit gehörte hierher, mit der er die Rolle des Moskauer Oppositionsführers übernommen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
