                "senses": [
                    {
                        "sense_id": "ea02f013-9fa5-3f10-8887-85b2a4f94dc8",
                        "entry_id": "db5b5d32-b906-33cb-ab24-62419fac0735",
                        "glosses": [
                            "cremiges Pflegemittel für Lederfußbekleidungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f4dec62-047d-4e0c-88b7-901f8b373410",
                                "sense_id": "ea02f013-9fa5-3f10-8887-85b2a4f94dc8",
                                "text": "„Heuer hat die Jury den Begriff Blackfacing ausgesucht, er bezeichnet die umstrittene Praxis, weiße Menschen mit schwarzer Farbe oder Schuhpasta anzumalen und sie – etwa auf dem Theater – Schwarze spielen zu lassen.“"
                            },
                            {
                                "example_id": "ec5f8747-c431-4187-b033-95c627a0158e",
                                "sense_id": "ea02f013-9fa5-3f10-8887-85b2a4f94dc8",
                                "text": "„Im Wohnzimmer gab es dann auch noch einen Schreibtisch, den ich mir zum größten Teil gekapert hatte, um meine Zahnpasta und Schuhpasta darin unterzubringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
