                        "entry_id": "15bc111c-2c99-30cc-ba44-d89235470265",
                        "glosses": [
                            "Characterized by a prevalence of relatively long words containing a large number of morphemes. Typically, the morphemes are bound."
                        ],
                        "tags": [
                            "of languages"
                        ],
                        "examples": [
                            {
                                "example_id": "3b71f7d3-bbd0-4139-9294-7f28321a5218",
                                "sense_id": "5bdf954d-befc-320a-be25-df2d66e9b540",
                                "text": "\"No doubt, sir,\" Summerlee answered. \"Like all such tribes, I shall expect to find them of polysynthetic speech and of Mongolian type.\" \"Polysynthetic certainly,\" said Challenger, indulgently."
                            }
                        ]
                    },
