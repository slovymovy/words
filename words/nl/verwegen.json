                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bouwkundig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Men ging het historische pand voorzichtig <w>verwegen</w> met originele stenen.",
                            "target_lang_translations": {
                                "en": "They carefully began to <w>reface</w> the historic building with original stones."
                            }
