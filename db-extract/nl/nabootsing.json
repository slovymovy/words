                ],
                "translations": [
                    {
                        "translation_id": "c1ab0947-f47d-4423-83d8-cdf5b870ebb5",
                        "source_entry_id": "b3edd48b-f444-399b-8704-39b35f9f4ff7",
                        "source_sense_id": "ab421072-e075-3d93-9f56-65d4a9e4f874",
                        "source_sense_description": "imitatie, het nadoen",
                        "target_lang_word": "Nachahmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachahmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e189e2aa-0a30-3e82-9ae6-e04de92a34c3",
                                        "entry_id": "b505aebc-e5e0-31eb-b44a-14592f8c6ed7",
                                        "glosses": [
                                            "das Nachahmen, Imitieren, Kopieren eines Gegenstandes, einer Person oder Verhaltensweise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd3da0a6-caeb-4f21-b6ef-a283427522c5",
                                                "sense_id": "e189e2aa-0a30-3e82-9ae6-e04de92a34c3",
                                                "text": "Bates bezeichnete die Nachahmung eines wehrhaften oder ungenießbaren Tieres durch harmlose Tiere zur Täuschung von Feinden als Mimikry."
                                            },
                                            {
                                                "example_id": "8f9998eb-cda8-41ae-8327-4a5a0cb0d2d0",
                                                "sense_id": "e189e2aa-0a30-3e82-9ae6-e04de92a34c3",
                                                "text": "„In einem Augenblick sprach er Englisch in einer Nachahmung der Redeweise seines halben ungarischen Landsmannes George Sanders, an den sich Frauen über sechzig als einen sanften Herzensbrecher aus Hollywood erinnern werden.“"
                                            },
                                            {
                                                "example_id": "39ef2a2a-c8bd-49d7-895e-39f545b556dd",
                                                "sense_id": "e189e2aa-0a30-3e82-9ae6-e04de92a34c3",
                                                "text": "„Damit wollte er ihr den sicheren Weg zum ewigen Heil weisen, in Nachahmung der Buße ihrer neuen Schutzpatronin, deren Leben sie bisher geführt hatte.“"
                                            },
                                            {
                                                "example_id": "83b4a83c-3926-4967-8b71-46a5cfbf5fa2",
                                                "sense_id": "e189e2aa-0a30-3e82-9ae6-e04de92a34c3",
                                                "text": "„Natürlich ist das schön von dir, als Dichter bist du ein Berg, aber zur Nachahmung empfiehlt es sich kaum, seinen Freund mit Einsamkeit zu trösten, auch wenn sie so schön bedichtet wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26334884-6ab6-4f23-b515-1526441269f0",
                        "source_entry_id": "b3edd48b-f444-399b-8704-39b35f9f4ff7",
                        "source_sense_id": "ab421072-e075-3d93-9f56-65d4a9e4f874",
                        "source_sense_description": "imitatie, het nadoen",
                        "target_lang_word": "Imitation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Imitation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "615b030a-2f47-3995-b15d-42cc6793eaf7",
                                        "entry_id": "b6a3fb7a-6e91-3679-b8b2-32f95cb9457b",
                                        "glosses": [
                                            "die Handlung, etwas nachzumachen (etwas best möglich zu kopieren)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aef825d6-aa8f-4df4-9683-9e6f0babece8",
                                                "sense_id": "615b030a-2f47-3995-b15d-42cc6793eaf7",
                                                "text": "Die Imitation der Eltern ist Teil des Lernprozesses."
                                            },
                                            {
                                                "example_id": "987db5d2-6e0d-46a5-bbe8-84a0e459ac12",
                                                "sense_id": "615b030a-2f47-3995-b15d-42cc6793eaf7",
                                                "text": "„Die Rolle der Imitation beim Spracherwerb und in der Lerntheorie überhaupt gehört zu den kontroversen Fragen, zu deren Klärung sowohl viele Einzeluntersuchungen als auch genaue Begriffserklärung notwendig sind.“"
                                            },
                                            {
                                                "example_id": "43fff404-5cd9-4d5d-bc1c-e86bbe2379f5",
                                                "sense_id": "615b030a-2f47-3995-b15d-42cc6793eaf7",
                                                "text": "„Das mag zum Teil stimmen; aber manches ist doch, wie ich gestehen muß, bewußte Imitation und Übertreibung der stilkritischen Manierismen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b0b52121-9d8d-31e6-b85e-396228efee31",
                                        "entry_id": "b6a3fb7a-6e91-3679-b8b2-32f95cb9457b",
                                        "glosses": [
                                            "ein (minderwertiges) Produkt, das so gemacht wurde, dass es einem anderen gleicht; eine Produktkopie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef781e91-a30b-44b1-86de-6e1967fcba0a",
                                                "sense_id": "b0b52121-9d8d-31e6-b85e-396228efee31",
                                                "text": "Deine Rolex-Uhr ist eine Imitation."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
