                "senses": [
                    {
                        "sense_id": "cd2fa5a7-6370-3d82-b662-caf125fe24bc",
                        "entry_id": "3add0d55-5779-3bc8-9fe3-231596eb9838",
                        "glosses": [
                            "drastische verandering in uiterlijk of karakter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eabd93e-a530-412d-9771-efa20df59d6a",
                                "sense_id": "cd2fa5a7-6370-3d82-b662-caf125fe24bc",
                                "text": "Ook na rust waarin de thuisclub via Tom Beugelsdijk nog wel op 1-2 komt en het in de slotfase nog even spannend is, blijft Sparta tamelijk moeiteloos op de been. Beter kan de gedaantewisseling van die ooit zo terughoudende Rotterdamse club getypeerd worden."
                            },
                            {
                                "example_id": "d00f7ca9-7ae5-48fb-844b-e5bf140860b1",
                                "sense_id": "cd2fa5a7-6370-3d82-b662-caf125fe24bc",
                                "text": "In 2001 onderging hij een drastische gedaantewisseling door veertig kilo af te vallen. Hij wilde niet langer de dikke man zijn met de waaier, en de pakken van Hedi Slimani die hij zo graag wilde dragen, waren nu eenmaal gemaakte voor dunne mannen."
                            }
                        ]
                    }
