                ],
                "senses": [
                    {
                        "sense_id": "1dcb5839-c397-379c-887d-6587f7c70cba",
                        "entry_id": "e5810910-c559-3280-a986-20d483426d91",
                        "glosses": [
                            "Inflammation de l’appendice du cæcum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2701f9bb-eecc-4efb-ab30-f4e2fbbc8491",
                                "sense_id": "1dcb5839-c397-379c-887d-6587f7c70cba",
                                "text": "Un an plus tard, un de ces enfants, une délicieuse petite fille, la préférée de ma chère mère, était emportée par l'appendicite."
                            },
                            {
                                "example_id": "ab966255-cc5a-4578-af0b-bf4c2f3fec9e",
                                "sense_id": "1dcb5839-c397-379c-887d-6587f7c70cba",
                                "text": "Ça veut dire qu’on va prioriser le cancer, la traumatologie, on va prioriser toutes les urgences comme les appendicites, etc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "894748cd-9a7e-4fcc-a651-b4c13d3d2ae1",
                        "source_entry_id": "e5810910-c559-3280-a986-20d483426d91",
                        "source_sense_id": "1dcb5839-c397-379c-887d-6587f7c70cba",
                        "target_lang_word": "Blinddarmentzündung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
