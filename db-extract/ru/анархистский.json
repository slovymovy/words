                ],
                "senses": [
                    {
                        "sense_id": "df755744-2d0d-3cca-ad1c-f2be505da4d7",
                        "entry_id": "0bf5e740-a7fb-3c2c-b9d3-e9313385c1d9",
                        "glosses": [
                            "относящийся к анархистам"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48940233-9960-4008-a328-de2260e57adf",
                                "sense_id": "df755744-2d0d-3cca-ad1c-f2be505da4d7",
                                "text": "Анархистская символика."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "002666b0-3dee-4dae-a472-0467bd7c75d2",
                        "source_entry_id": "0bf5e740-a7fb-3c2c-b9d3-e9313385c1d9",
                        "source_sense_id": "df755744-2d0d-3cca-ad1c-f2be505da4d7",
                        "target_lang_word": "anarchist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anarchist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0686eef8-8e61-3bc9-b985-c15101e61504",
                                        "entry_id": "b2c8e785-2aab-3fff-9592-cb493598876e",
                                        "glosses": [
                                            "One who believes in or advocates the absence of hierarchy and authority in most forms (compare anarchism), especially one who works toward the realization of such."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65835d05-f8e0-4ffe-bb19-8a436959238e",
                                                "sense_id": "0686eef8-8e61-3bc9-b985-c15101e61504",
                                                "text": "Eh bien ! vous êtes démocrate ? — Non. — Quoi ! vous seriez monarchique ? — Non. — Constitutionnel ? — Dieu m’en garde. — Vous êtes donc aristocrate ? — Point du tout. — Vous voulez un gouvernement mixte ? — Encore moins. — Qu’êtes-vous donc ? — Je suis anarchiste."
                                            },
                                            {
                                                "example_id": "09380134-69c7-44b7-b56a-29d6b924ef31",
                                                "sense_id": "0686eef8-8e61-3bc9-b985-c15101e61504",
                                                "text": "But nothing has revived anarchism like globalization. Anarchists are now battling what they see as a concentration of power in multinational corporations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "084634e7-6a79-3f85-bfe5-355e6021fd74",
                                        "entry_id": "b2c8e785-2aab-3fff-9592-cb493598876e",
                                        "glosses": [
                                            "One who disregards laws and social norms as a form of rebellion against authority."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca5b168d-c90a-3bd7-9c36-a056098015c4",
                                        "entry_id": "b2c8e785-2aab-3fff-9592-cb493598876e",
                                        "glosses": [
                                            "One who promotes chaos and lawlessness."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43d9a1ea-42c8-4a64-97ea-b04114db1108",
                                                "sense_id": "ca5b168d-c90a-3bd7-9c36-a056098015c4",
                                                "text": "You have heard that Anarchists throw bombs, that they believe in violence, and that Anarchy means disorder and chaos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9760fa71-28f9-399e-89ed-3eb695f4907f",
                                        "entry_id": "b2c8e785-2aab-3fff-9592-cb493598876e",
                                        "glosses": [
                                            "One who resents outside control or influence on their life, in particular a government, and therefore desires the absence of political control."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "anarchist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9efce88-c4ec-303e-ace5-1eb90566cc61",
                                        "entry_id": "fcbe0200-f688-387d-9678-e0808558d242",
                                        "glosses": [
                                            "Relating to anarchism or to anarchists; anarchistic."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20aa30e0-c8c1-49b4-b347-c08a647afd48",
                        "source_entry_id": "0bf5e740-a7fb-3c2c-b9d3-e9313385c1d9",
                        "source_sense_id": "df755744-2d0d-3cca-ad1c-f2be505da4d7",
                        "target_lang_word": "anarchiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anarchiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c850b89-b740-33b2-a40c-faa970029f3c",
                                        "entry_id": "15288ac9-5235-3b13-93b3-d01a6247ce9c",
                                        "glosses": [
                                            "Qui a rapport à l’anarchisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bc6593a-dc19-4902-a1dd-e70bcb635a22",
                                                "sense_id": "1c850b89-b740-33b2-a40c-faa970029f3c",
                                                "text": "Il fut bientôt admis, […], que certes l’Anarchie représente une organisation de beaucoup supérieure à celle qui est visée par l’État populaire ; mais, disait-on, l’idéal anarchiste est tellement éloigné de nous, que nous n’avons pas à nous en préoccuper pour le moment. D’autre part, il manquait à la théorie anarchiste une formule concrète et simple à la fois, pour préciser son point de départ, pour donner un corps à ses conceptions."
                                            },
                                            {
                                                "example_id": "f1d16595-d831-4273-86e4-879e684b9a7d",
                                                "sense_id": "1c850b89-b740-33b2-a40c-faa970029f3c",
                                                "text": "Seul, le juge d’instruction, qui était en train de se faire une spécialité des affaires anarchistes, lui tint tête, défendit la civilisation menacée, donna des détails terrifiants sur ce qu’il appelait l’armée de la dévastation et du massacre."
                                            },
                                            {
                                                "example_id": "e6f6a018-0c9c-4598-9047-ddfe9538e066",
                                                "sense_id": "1c850b89-b740-33b2-a40c-faa970029f3c",
                                                "text": "Tous les ouvriers du train, même ceux qui avaient des foulards anarchistes, descendirent des wagons et vinrent pousser notre voiture. Vu leur nombre, ce fut un jeu d’enfants que de nous sortir de la voie ferrée."
                                            },
                                            {
                                                "example_id": "30512a32-6d6e-43ba-99ca-2888ed7e7adf",
                                                "sense_id": "1c850b89-b740-33b2-a40c-faa970029f3c",
                                                "text": "De 1890 à 1897, dans le journal édité à Paris, Le Père Peinard, les militants anarchistes ardennais racontent les dures conditions de la classe ouvrière des Ardennes ainsi que les nombreuses luttes qu’elle mène alors que la répression patronale et policière est féroce."
                                            },
                                            {
                                                "example_id": "261f0800-9b1b-4fdd-a4b5-f7be541604dc",
                                                "sense_id": "1c850b89-b740-33b2-a40c-faa970029f3c",
                                                "text": "Les anarcha-féministes ont de fait souvent critiqué les grands théoriciens anarchistes (Proudhon, Bakounine) qui minoraient trop le problème du patriarcat, voire le validaient."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anarchiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5944e239-150e-3f59-b2e5-dd18802ed4c9",
                                        "entry_id": "b962bb72-db2f-3d2f-b72c-345122adc1a7",
                                        "glosses": [
                                            "Personne qui professe, qui pratique l’anarchisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd06ddec-fa79-469c-a9cc-b324bc77bf99",
                                                "sense_id": "5944e239-150e-3f59-b2e5-dd18802ed4c9",
                                                "text": "— Mais monsieur, il me semble qu’en ces temps de bassesse et d’ignominie universelles, un homme de quelque distinction ne saurait être qu’anarchiste."
                                            },
                                            {
                                                "example_id": "b12ff8ea-5bf9-4303-8ba8-96b073968d2e",
                                                "sense_id": "5944e239-150e-3f59-b2e5-dd18802ed4c9",
                                                "text": "« Tu es un esthète et un anarchiste », me dit Médéric, et je lui rétorque : « Tu es un militaire et un prêtre. » Nous devons avoir raison tous les deux."
                                            },
                                            {
                                                "example_id": "7b902a32-f70a-4c92-bd1e-0d1126571682",
                                                "sense_id": "5944e239-150e-3f59-b2e5-dd18802ed4c9",
                                                "text": "Mais, en général, il aimait rendre service et prenait plaisir à montrer l’influence qu’il avait dans les sphères du pouvoir. Plus étonnant, il intervint enfin pour une prisonnière française en Espagne, une anarchiste originaire de Saint-Jean-de-Vaux, en Saône-et-Loire, sa région d’origine."
                                            },
                                            {
                                                "example_id": "34a5afc8-8638-47e5-99b9-883f91dae676",
                                                "sense_id": "5944e239-150e-3f59-b2e5-dd18802ed4c9",
                                                "text": "À rebours de l’archétype de l’anarchiste, éruptive et extravertie, Voltairine [de Cleyre] fut une personnalité effacée, introvertie, maladive, tout en dispensant des cours aux migrants des ghettos à Philadelphie et à Chicago, et en écrivant sans cesse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
