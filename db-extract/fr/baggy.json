                        "entry_id": "742f6c62-e148-3b9b-87e4-390a9f8b30cd",
                        "glosses": [
                            "Sorte de pantalon à taille basse, le souvent réalisé en coupe droite au confort très large des hanches jusqu'au bas de pantalon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0fcf68f-df58-4549-9bc4-d1fae5b21670",
                                "sense_id": "fb0e34fa-ec5c-38fa-b60a-98e9f242a1fe",
                                "text": "T’es en lingerie fine sous ton baggy, arrête de faire ton fou sur ma messagerie"
                            },
                            {
                                "example_id": "5787420a-1972-4991-94b0-154ed3d34b11",
                                "sense_id": "fb0e34fa-ec5c-38fa-b60a-98e9f242a1fe",
                                "text": "Qui sait ce que penseraient nos boursouflés aïeux des slims et des baggies ?"
                            },
                            {
                                "example_id": "33247fe9-158b-4cb3-a102-3698f2b10e8e",
                                "sense_id": "fb0e34fa-ec5c-38fa-b60a-98e9f242a1fe",
                                "text": "J'avais vingt-deux ans, les cheveux longs et des jeans baggy, je démarchais des patrons de cinquante ans qui ne juraient que par le Minitel."
                            }
                        ]
                    },
