                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a laissé sa vieille <w>tôle</w> garée au fond de la cour toute la semaine.",
                            "target_lang_translations": {
                                "en": "He left his old <w>banger</w> parked at the back of the yard all week.",
                                "ru": "Всю неделю он оставлял свою старую <w>колымагу</w> в глубине двора.",
                                "de": "Die ganze Woche hat er seine alte <w>Kiste</w> hinten im Hof geparkt.",
