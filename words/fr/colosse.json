                    ]
                },
                {
                    "sense_id": "c7cf9e3a-ffbd-3420-acc1-69083c545032",
                    "sense_definition": "État, puissance financière ou organisation d'une influence immense.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "puissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce <w>colosse</w> de l'industrie numérique domine désormais les marchés mondiaux."
                        },
                        {
                            "text": "Cet empire financier paraissait invincible, mais ce n'était qu'un <w>colosse</w> aux pieds d'argile."
                        }
                    ],
                    "synonyms": [
