                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>moment</w> bepaalt of de hefboom in beweging komt.",
                            "target_lang_translations": {
                                "en": "The <w>moment</w> determines whether the lever starts moving.",
                                "ru": "<w>Момент</w> определяет, придет ли рычаг в движение.",
                                "pl": "<w>Moment</w> decyduje o tym, czy dźwignia zacznie się poruszać.",
                                "de": "Das <w>Moment</w> bestimmt, ob sich der Hebel in Bewegung setzt.",
