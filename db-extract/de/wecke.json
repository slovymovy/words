                "senses": [
                    {
                        "sense_id": "131ca511-7505-375f-b045-c61ccd216b3e",
                        "entry_id": "45aeb770-c4e6-39d4-8c01-3674626b5211",
                        "glosses": [
                            "Brötchen"
                        ],
                        "tags": [
                            "South-German"
                        ],
                        "examples": [
                            {
                                "example_id": "58b67463-0824-47e1-a866-80253a76d1d8",
                                "sense_id": "131ca511-7505-375f-b045-c61ccd216b3e",
                                "text": "„Berengar trat näher heran, und die Bäckersfrau reichte ihm eine Wecke.“"
                            },
                            {
                                "example_id": "db2e223e-3e3a-4089-bac0-eb6131c023b2",
                                "sense_id": "131ca511-7505-375f-b045-c61ccd216b3e",
                                "text": "„Er ging gegen Abend hinab ins Städtle und holte im Löwen eine gute Flasche Wein, beim Ketterer-Beck ein paar Wecken und beim Metzger Köbele für einen Sechser Schwartenmagen und lud den Schneider Sebald dazu ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b929fdf1-83b4-346c-bf45-698d9e874acc",
                        "entry_id": "45aeb770-c4e6-39d4-8c01-3674626b5211",
                        "glosses": [
                            "auf die Spitze gestellte Rhombe"
                        ],
                        "tags": [
                            "Heraldik"
                        ],
                        "examples": [
                            {
                                "example_id": "66c3b567-d66a-4f28-a4eb-d16f18940568",
                                "sense_id": "b929fdf1-83b4-346c-bf45-698d9e874acc",
                                "text": "Die bayrische Flagge enthält ein Muster aus blauen Wecken."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
