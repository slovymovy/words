                "senses": [
                    {
                        "sense_id": "9057fdf8-f35d-3c8f-a30c-e80a1a9e28b8",
                        "entry_id": "ec63cec1-c280-3b95-bcf4-158217d2e4fd",
                        "glosses": [
                            "(praktisches) Wissen und Intelligenz, um bestimmte Ziele zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b0eef15-28f6-4e3b-b09d-ea59f668ed91",
                                "sense_id": "9057fdf8-f35d-3c8f-a30c-e80a1a9e28b8",
                                "text": "Um eine elektronische Schaltung aufzubauen, braucht man schon etwas Schläue."
                            },
                            {
                                "example_id": "65346f55-9fb5-4768-ae36-d99c5abce8b5",
                                "sense_id": "9057fdf8-f35d-3c8f-a30c-e80a1a9e28b8",
                                "text": "„Westerwelles Entschiedenheit ist nicht mutig oder stark, sondern kurzfristig überflüssig und langfristig unhaltbar, politisch also von eher zweifelhafter Schläue.“"
                            },
                            {
                                "example_id": "edf957ed-d08e-47e6-8a24-32788a90b591",
                                "sense_id": "9057fdf8-f35d-3c8f-a30c-e80a1a9e28b8",
                                "text": "„Es erfordert große Stärke und Schläue, unermüdlich die gewaltige, gleichgültige Festung weißer Vorherrschaft anzugreifen, wie es Schwarze in diesem Land so lange schon tun.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd8bb503-210a-48e0-9298-015bdeab530b",
                        "source_entry_id": "ec63cec1-c280-3b95-bcf4-158217d2e4fd",
                        "source_sense_id": "9057fdf8-f35d-3c8f-a30c-e80a1a9e28b8",
                        "source_sense_description": "(praktisches) Wissen und Intelligenz, um bestimmte Ziele zu erreichen",
                        "target_lang_word": "shrewdness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shrewdness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "053ee5ff-ef35-3ebd-bff7-45308eeaeee9",
                                        "entry_id": "b58dc22c-5931-32f7-a826-fb75313863e0",
                                        "glosses": [
                                            "The quality of being shrewd."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bd39849-b268-4a29-9d14-07a7cffb7acc",
                                                "sense_id": "053ee5ff-ef35-3ebd-bff7-45308eeaeee9",
                                                "text": "A man with less worldly shrewdness would never have seen how things really stood; a man with less pliability could never have adapted himself to them. It must always be remembered, that his whole administration was one long struggle: he had to maintain his master on the throne, and himself in the ministry; and this was done by sheer force of talent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df454da8-2079-350e-be2a-b63cd39dba62",
                                        "entry_id": "b58dc22c-5931-32f7-a826-fb75313863e0",
                                        "glosses": [
                                            "An invented collective name for a group of apes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b1c9778-e254-4230-9dac-9d79e182d656",
                        "source_entry_id": "ec63cec1-c280-3b95-bcf4-158217d2e4fd",
                        "source_sense_id": "9057fdf8-f35d-3c8f-a30c-e80a1a9e28b8",
                        "source_sense_description": "(praktisches) Wissen und Intelligenz, um bestimmte Ziele zu erreichen",
                        "target_lang_word": "astuce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astuce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "633eea6c-353e-35bd-be61-44fa633736a5",
                                        "entry_id": "de9307fd-d795-355d-a3ee-c95471bca54b",
                                        "glosses": [
                                            "Finesse, ruse qui a pour objet de nuire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8d25142-4018-402f-a260-0df2f9171f40",
                                                "sense_id": "633eea6c-353e-35bd-be61-44fa633736a5",
                                                "text": "Un homme plein d’astuce."
                                            },
                                            {
                                                "example_id": "38f86425-df46-4f8d-8b26-2233ae26cdfc",
                                                "sense_id": "633eea6c-353e-35bd-be61-44fa633736a5",
                                                "text": "Il a fait cela par astuce."
                                            },
                                            {
                                                "example_id": "9927d58a-cc5d-487c-925e-c6c21f48cac2",
                                                "sense_id": "633eea6c-353e-35bd-be61-44fa633736a5",
                                                "text": "Employer de petites astuces."
                                            },
                                            {
                                                "example_id": "0d90522b-9fa2-4694-8a71-3a3ca2b0da8c",
                                                "sense_id": "633eea6c-353e-35bd-be61-44fa633736a5",
                                                "text": "Ton astuce infaillible pour ne pas perdre la face quand tu tombes sur un sujet que tu n'as absolument pas bossé?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bdb8f1d-7c5c-3c62-96a8-f6e8ce7414bf",
                                        "entry_id": "de9307fd-d795-355d-a3ee-c95471bca54b",
                                        "glosses": [
                                            "Quelque chose d’ingénieux."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0efbf95d-5387-4fe5-b4ce-729732757779",
                                                "sense_id": "9bdb8f1d-7c5c-3c62-96a8-f6e8ce7414bf",
                                                "text": "Il existe néanmoins une astuce qui fonctionne réellement et qui permet aux arboretums installés en bordure de forêt de garder intact leurs végétaux : la mise en place de petits miroirs partout où cela est possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1406d21c-8279-3215-bb1b-827d3a055ba9",
                                        "entry_id": "de9307fd-d795-355d-a3ee-c95471bca54b",
                                        "glosses": [
                                            "Solution pour résoudre un problème, une question."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a45911c5-5a2d-401a-878f-4ab73cf92e6e",
                        "source_entry_id": "ec63cec1-c280-3b95-bcf4-158217d2e4fd",
                        "source_sense_id": "9057fdf8-f35d-3c8f-a30c-e80a1a9e28b8",
                        "source_sense_description": "(praktisches) Wissen und Intelligenz, um bestimmte Ziele zu erreichen",
                        "target_lang_word": "slimheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slimheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a8711d34-4e45-3cf1-9a89-f5efb8a013af",
                                        "entry_id": "b69f091c-a349-3ead-86a2-e7b013aa4ce1",
                                        "glosses": [
                                            "de eigenschap van een persoon n.l. dat deze intelligent, vindingrijk maar ook geslepen is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47f36730-be94-49ad-bd43-69fbf17d5d88",
                                                "sense_id": "a8711d34-4e45-3cf1-9a89-f5efb8a013af",
                                                "text": "\"De keeper mag die pass prima geven, al was hij wat zacht. Maar je kunt dan als verdediger ook die bal aanvallen, of de tribune in trappen, of sneller anticiperen. En als je dan voelt dat de aanvaller in het voordeel is, moet je zeker van hem afblijven. Dat zijn cruciale dingen. Het heeft met slimheid te maken. Dat weet Menno ook. Hij is één van onze meest ervaren spelers, dus dit mag hem eigenlijk niet gebeuren. Het snijdt je adem af, want de tactiek klopt wel.\""
                                            },
                                            {
                                                "example_id": "45307dfe-df2e-421b-a779-19d41cee8100",
                                                "sense_id": "a8711d34-4e45-3cf1-9a89-f5efb8a013af",
                                                "text": "Buiten het algemeen klassement van de Tour de France is er voor journalisten en tourvolgers ook een onderlinge competitie. De wedstrijd ’Wie heeft vandaag het éérst een tafeltje op een goed lunchadres?’ heeft te maken met slimheid en tourervaring."
                                            },
                                            {
                                                "example_id": "8ae687c1-1e8e-4a4f-8dce-dffa3e770b48",
                                                "sense_id": "a8711d34-4e45-3cf1-9a89-f5efb8a013af",
                                                "text": "Vogelslimheid komt uit een compact brein: Per gram bevatten vogelhersenen veel meer zenuwcellen dan zoogdierhersenen. Hoe slimheid vleugels kreeg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
