                "senses": [
                    {
                        "sense_id": "f7965f23-9681-3d9a-8435-856b6bc96d2e",
                        "entry_id": "48880b25-1d8a-332b-9dfa-068365029a58",
                        "glosses": [
                            "weibliche Person, die Zeugin eines Tathergangs wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eae5d6bd-0af8-4a47-b9ba-e490407db593",
                                "sense_id": "f7965f23-9681-3d9a-8435-856b6bc96d2e",
                                "text": "„Folterungen im Hafen von Valparaiso – Bericht einer Augenzeugin der Ereignisse vom 11.– 22.9.73“"
                            },
                            {
                                "example_id": "1f8d56aa-4272-4621-b21b-79d3c52033d1",
                                "sense_id": "f7965f23-9681-3d9a-8435-856b6bc96d2e",
                                "text": "„Einer Augenzeugin, die den Sturz beobachtet hat, ist der Schreck noch anzusehen.“"
                            },
                            {
                                "example_id": "0e72d732-226a-4b03-8c28-efd67d476b2a",
                                "sense_id": "f7965f23-9681-3d9a-8435-856b6bc96d2e",
                                "text": "„Eine Augenzeugin sagte, es habe gerade eine Prüfung begonnen, als der Täter den Unterrichtsraum betrat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9704d233-e5b5-473e-96af-00698c9ab0d9",
                        "source_entry_id": "48880b25-1d8a-332b-9dfa-068365029a58",
                        "source_sense_id": "f7965f23-9681-3d9a-8435-856b6bc96d2e",
                        "source_sense_description": "weibliche Person, die Zeugin eines Tathergangs wurde",
                        "target_lang_word": "eyewitness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eyewitness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9f0a4fe-8946-36f9-bdb7-258109d88c5a",
                                        "entry_id": "c005ecbd-c8d7-3541-aba3-665d90dde99a",
                                        "glosses": [
                                            "Someone who sees an event and can report or testify about it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "741924fb-8e9d-4e0c-a944-0c6833ccc15f",
                                                "sense_id": "f9f0a4fe-8946-36f9-bdb7-258109d88c5a",
                                                "text": "And the girl's fate he could picture as plainly as though he were an eyewitness to it."
                                            },
                                            {
                                                "example_id": "9d7dbadb-d830-45a1-9a22-2bbc332a3f25",
                                                "sense_id": "f9f0a4fe-8946-36f9-bdb7-258109d88c5a",
                                                "text": "The evidence of eyewitnesses and the distance travelled after the initial derailment confirmed that the train was travelling at 45 to 50 m.p.h. as it became derailed."
                                            },
                                            {
                                                "example_id": "0ff568ee-a6df-4f03-a940-0f07bab9188f",
                                                "sense_id": "f9f0a4fe-8946-36f9-bdb7-258109d88c5a",
                                                "text": "There was no eyewitness report or independent confirmation for the strike near the town of Mareesa that was also reported by the Dubai-based Al-Arabiya television network."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eyewitness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a8246eb-cc4b-3d23-872b-33fc481c23b3",
                                        "entry_id": "5ce38e07-6af6-3961-8dff-8049c30c214d",
                                        "glosses": [
                                            "To be present at an event, and see it"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82bf6ec0-65b0-4e20-87a0-32f351a8f177",
                        "source_entry_id": "48880b25-1d8a-332b-9dfa-068365029a58",
