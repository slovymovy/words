                "senses": [
                    {
                        "sense_id": "791d2c7e-f242-32b4-bc32-bc1705de4ced",
                        "entry_id": "fa4d44a1-8a66-38bd-8b3e-f45c68a6fbad",
                        "glosses": [
                            "sachgemäße Genauigkeit, Exaktheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a9ea920-16ca-4f56-b9c4-b1d92ecfe6c1",
                                "sense_id": "791d2c7e-f242-32b4-bc32-bc1705de4ced",
                                "text": "Seine hohen Trefferquoten beim Zielschießen bezeugen seine Präzision."
                            },
                            {
                                "example_id": "38ece244-7f3b-4b53-9ab4-c64d24371d20",
                                "sense_id": "791d2c7e-f242-32b4-bc32-bc1705de4ced",
                                "text": "„Die Deutschen sind bekannt für ihre Präzision, sie wollen am liebsten immer alles ganz genau wissen.“"
                            },
                            {
                                "example_id": "1c63d027-a172-4d65-9d87-ad97a6b2bcf2",
                                "sense_id": "791d2c7e-f242-32b4-bc32-bc1705de4ced",
                                "text": "„Das Faszinierende beim Kunstfliegen sei aber kein einzelnes Manöver, sondern die Präzision, mit der so ein Flug ausgeführt werden muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acee60f5-f23e-4c8d-9b35-ea20c5b74d22",
                        "source_entry_id": "fa4d44a1-8a66-38bd-8b3e-f45c68a6fbad",
                        "source_sense_id": "791d2c7e-f242-32b4-bc32-bc1705de4ced",
                        "source_sense_description": "sachgemäße Genauigkeit, Exaktheit",
                        "target_lang_word": "precision",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precision",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50bfdd86-d8dc-39a2-9ee2-9a53ae77b3ba",
                                        "entry_id": "1031c8c8-8619-322b-b8fd-85b33d4af54d",
                                        "glosses": [
                                            "The state of being precise or exact; especially, both exact and accurate."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3389e6da-5aab-431e-b6ad-6775a2ec68a7",
                                                "sense_id": "50bfdd86-d8dc-39a2-9ee2-9a53ae77b3ba",
                                                "text": "Near-synonyms: exactitude, exactness; accuracy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c8f541c-4bd9-3adc-90d1-8f8996ad7cdf",
                                        "entry_id": "1031c8c8-8619-322b-b8fd-85b33d4af54d",
                                        "glosses": [
                                            "The ability of a measurement to be reproduced consistently."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09abd386-ef1e-43df-867e-b0f99be9b9cb",
                                                "sense_id": "1c8f541c-4bd9-3adc-90d1-8f8996ad7cdf",
                                                "text": "Near-synonyms: repeatability; reproducibility"
                                            },
                                            {
                                                "example_id": "6e6e73d6-bc03-4c80-84a2-32167028acf7",
                                                "sense_id": "1c8f541c-4bd9-3adc-90d1-8f8996ad7cdf",
                                                "text": "The classic example of the difference between precision and accuracy is that in target practice, if the grouping is tight but the group is off-center, your precision is good but your accuracy needs calibration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67c38040-7559-3d64-8d19-6d8f8519acfa",
                                        "entry_id": "1031c8c8-8619-322b-b8fd-85b33d4af54d",
                                        "glosses": [
                                            "The number of significant digits to which a value may be measured reliably."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee1836ab-8802-3fec-a480-5832f2e48484",
                                        "entry_id": "1031c8c8-8619-322b-b8fd-85b33d4af54d",
                                        "glosses": [
                                            "A bidding system that makes use of many artificial bids to describe a hand quite precisely."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "precision",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c3c913f-96ae-3ded-99e5-10ebde8e67b1",
                                        "entry_id": "2d24164d-f872-3eff-8044-5bfd0021350d",
                                        "glosses": [
                                            "Used for exact or precise measurement."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dda30d8-1e5e-4cc4-865c-7aed877a4a13",
                                                "sense_id": "9c3c913f-96ae-3ded-99e5-10ebde8e67b1",
                                                "text": "precision instruments"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "843fc213-ab3a-3cc2-a04f-51beac6b9d95",
                                        "entry_id": "2d24164d-f872-3eff-8044-5bfd0021350d",
                                        "glosses": [
                                            "Made, or characterized by accuracy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59bf21c0-fc12-498d-9727-d72cdd30bb56",
                                                "sense_id": "843fc213-ab3a-3cc2-a04f-51beac6b9d95",
                                                "text": "But there was nothing he could do about Villa's second when Agbonlahor crossed from the left and Bent finished with a precision volley."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2a68803-8415-489a-8407-7fcbe29d7b0d",
                        "source_entry_id": "fa4d44a1-8a66-38bd-8b3e-f45c68a6fbad",
                        "source_sense_id": "791d2c7e-f242-32b4-bc32-bc1705de4ced",
                        "source_sense_description": "sachgemäße Genauigkeit, Exaktheit",
                        "target_lang_word": "précision",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "précision",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ffac234-3057-3bbd-b98a-21b5b5a9f64f",
                                        "entry_id": "ee3d679f-a7e8-30b5-b3fe-440300da5538",
                                        "glosses": [
                                            "Recherche d'exactitude de netteté dans la pensée et dans l’expression, par accumulation de détails, de distinctions, d'explications, de preuves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "875b0399-406b-4b37-984f-2d8b591ecc13",
                                                "sense_id": "3ffac234-3057-3bbd-b98a-21b5b5a9f64f",
                                                "text": "C’est un homme qui s’exprime, qui écrit avec une grande précision."
                                            },
                                            {
                                                "example_id": "883dd7e2-c505-45f5-9be1-be357cb40dc8",
                                                "sense_id": "3ffac234-3057-3bbd-b98a-21b5b5a9f64f",
                                                "text": "Cet ouvrage est un modèle de précision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fd053eb-4fa4-3836-b166-7c1166e9b8e5",
                                        "entry_id": "ee3d679f-a7e8-30b5-b3fe-440300da5538",
                                        "glosses": [
                                            "Justesse ; exactitude dans l’action ; détermination stricte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82d165b1-98d1-497b-959f-71c91fff4d62",
                                                "sense_id": "8fd053eb-4fa4-3836-b166-7c1166e9b8e5",
                                                "text": "— Voici la mairie ! dit Omer. Nous ne nous sommes pas pressés ; nous n’avons demandé de renseignements à personne, et nous arrivons avec la précision d’une éclipse."
                                            },
                                            {
                                                "example_id": "9cee8e9d-8dce-4dc3-9b6b-47531f68a167",
                                                "sense_id": "8fd053eb-4fa4-3836-b166-7c1166e9b8e5",
                                                "text": "Jusque-là, nous avions navigué avec une grande sûreté : le poste de Fernando de Noronha et le bâtiment Cigogne firent des relèvements avec beaucoup de précision."
                                            },
                                            {
                                                "example_id": "a68eb5db-f097-4eb1-b6da-8f8b741a8fc7",
                                                "sense_id": "8fd053eb-4fa4-3836-b166-7c1166e9b8e5",
                                                "text": "Le bruit du bombardement au-dessus de l’abri devient formidable. Les obus tombent sur la Chancellerie avec une précision inquiétante."
                                            },
                                            {
                                                "example_id": "5e0c0f5c-fa80-4fef-92f2-f8f871efbbd6",
                                                "sense_id": "8fd053eb-4fa4-3836-b166-7c1166e9b8e5",
                                                "text": "Les estimations furent faites avec toute la précision possible."
                                            },
                                            {
                                                "example_id": "50e6c5a8-b598-44d4-9958-c2a34d57959a",
                                                "sense_id": "8fd053eb-4fa4-3836-b166-7c1166e9b8e5",
                                                "text": "Il s’inclina devant les précisions qui lui étaient données."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97ce8db9-2b3b-323d-bd9e-ac59b5f04846",
                                        "entry_id": "ee3d679f-a7e8-30b5-b3fe-440300da5538",
                                        "glosses": [
                                            "Information supplémentaire pour préciser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "748e5f41-19c9-4ade-b08b-744f6f473de1",
                                                "sense_id": "97ce8db9-2b3b-323d-bd9e-ac59b5f04846",
                                                "text": "Je voudrais vous donner quelques précisions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f49b564-5fe3-3bae-88ea-f4dbd5fd7353",
                                        "entry_id": "ee3d679f-a7e8-30b5-b3fe-440300da5538",
                                        "glosses": [
                                            "En reconnaissance des formes et recherche documentaire, fraction des retours qui sont pertinents."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70532072-6a2c-3042-9fee-086f767cb081",
                                        "entry_id": "ee3d679f-a7e8-30b5-b3fe-440300da5538",
                                        "glosses": [
                                            "Mesure de l’aptitude à distinguer des valeurs très voisines. Étroitesse de l’accord entre les résultats obtenus en appliquant le procédé expérimental à plusieurs reprises dans des conditions déterminées."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ee0a266-02a1-4193-b32a-3d03507db06c",
                                                "sense_id": "70532072-6a2c-3042-9fee-086f767cb081",
                                                "text": "Il ne faut pas confondre précision et exactitude : une mesure précise permet d’obtenir un plus grand nombre de chiffres significatifs, mais peut très bien être erronée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfa8c448-11c7-3d56-818e-172dae4c1545",
                                        "entry_id": "ee3d679f-a7e8-30b5-b3fe-440300da5538",
                                        "glosses": [
                                            "Qualité d’une carte dont l’erreur cartographique est faible."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
