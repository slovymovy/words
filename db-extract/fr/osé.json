                    {
                        "sense_id": "87d50394-e38b-3231-8b12-04668187a45e",
                        "entry_id": "ceede6b1-78c6-3bf8-b8be-cda24c2daab4",
                        "glosses": [
                            "Qui est hardi, audacieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5acd9c37-fcdc-44c9-9a3a-a1b9f90583f2",
                                "sense_id": "87d50394-e38b-3231-8b12-04668187a45e",
                                "text": "Il s'agit d'une tentative osée, dont le succès est incertain."
                            },
                            {
                                "example_id": "1977b7ec-17e6-4a90-9106-86103306dec6",
                                "sense_id": "87d50394-e38b-3231-8b12-04668187a45e",
                                "text": "– Vous allez me trouver bien osée, Monsieur le Comte."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f1d6bd6-e4c7-3c58-aa75-ac0cc9298f77",
                        "entry_id": "ceede6b1-78c6-3bf8-b8be-cda24c2daab4",
                        "glosses": [
                            "Grivois, salace, obscène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c331492b-55c1-44ad-9ab3-a21f2c3e75df",
                                "sense_id": "7f1d6bd6-e4c7-3c58-aa75-ac0cc9298f77",
                                "text": "Les scènes les plus osées de ce film ont dû être coupées au montage."
                            }
                        ]
                    }
                ],
