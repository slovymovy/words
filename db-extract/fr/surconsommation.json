                "senses": [
                    {
                        "sense_id": "95654b6a-14ea-3dd3-8f91-7c02c6b575c0",
                        "entry_id": "83257b15-34e7-3cdb-874f-c6e6378b698c",
                        "glosses": [
                            "Consommation excessive, au-dessus d'un niveau considéré comme normal ou moyen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f813613-bfb3-46be-aa78-daaba26abf6e",
                                "sense_id": "95654b6a-14ea-3dd3-8f91-7c02c6b575c0",
                                "text": "Et l'avarice, considérée comme un péché par l'Église catholique, est devenue le signe d'une défense intelligente contre la surconsommation."
                            },
                            {
                                "example_id": "805c4abc-3c1f-4c1e-b3f8-d0cd99dc6775",
                                "sense_id": "95654b6a-14ea-3dd3-8f91-7c02c6b575c0",
                                "text": "L'élevage industriel et la surconsommation carnée ne sont pas généralisables à l'échelle planétaire."
                            },
                            {
                                "example_id": "f6cc6653-5906-406e-8b1b-4cd75a7272fa",
                                "sense_id": "95654b6a-14ea-3dd3-8f91-7c02c6b575c0",
                                "text": "Cette surconsommation se heurte à un marché tendu depuis la fin de l’été dernier, avec une reprise économique qui s’est accompagnée d’une hausse globale des prix des énergies."
                            }
                        ]
                    }
                ],
