                "senses": [
                    {
                        "sense_id": "9efa98c0-de6c-306b-b72a-7685cdc3d1b2",
                        "entry_id": "6950e85c-f149-3150-a4a8-e1e34547bb79",
                        "glosses": [
                            "Lähmung des siebten von zwölf Hirnnerven, des Gesichtsnervs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aaac704-d9c5-48ae-870e-2f9749c6743f",
                                "sense_id": "9efa98c0-de6c-306b-b72a-7685cdc3d1b2",
                                "text": "Bei einer Fazialisparese denkt man sofort an einen Schlaganfall als Ursache."
                            },
                            {
                                "example_id": "ca9b17ff-2e10-45bd-ad62-43a305fd3abb",
                                "sense_id": "9efa98c0-de6c-306b-b72a-7685cdc3d1b2",
                                "text": "„Liegt eine Fazialisparese i. e. S. vor oder erscheint die Mimik, die Gesichtsmuskulatur aus anderen Gründen schwach oder asymmetrisch?“"
                            },
                            {
                                "example_id": "37f94f8f-5acf-4fb2-813f-c1662c168013",
                                "sense_id": "9efa98c0-de6c-306b-b72a-7685cdc3d1b2",
                                "text": "„Abgeleitet von dem Namen des Nervs bezeichnet man eine Gesichtslähmung auch als Fazialislähmung oder Fazialisparese (Parese, griechisch = Erschlaffung).“"
                            },
                            {
                                "example_id": "9159ddfa-68b8-41ab-b1df-b263b641e998",
                                "sense_id": "9efa98c0-de6c-306b-b72a-7685cdc3d1b2",
                                "text": "„Bei der peripheren Fazialisparese ist ein Teil des Nervs direkt betroffen, zum Beispiel durch einen Unfall oder durch eine Schwellung aufgrund einer Infektion mit Bakterien oder Viren (am häufigsten Herpes simplex-Viren [HSV], aber z. B. auch möglich durch Mumps, Masern, Röteln, Borreliose, Herpes Zoster, etc.).“"
                            },
                            {
                                "example_id": "b1ff57d5-6df9-4287-ae1a-2b1270dfb017",
                                "sense_id": "9efa98c0-de6c-306b-b72a-7685cdc3d1b2",
                                "text": "„Als Ursachen einer Fazialisparese kommen viele Faktoren infrage: Knochenbrüche oder Wunden im Gesicht, Schädigung anderer Nerven, Tumore, Autoimmun- und Stoffwechselerkrankungen, Virusinfektionen wie etwa mit dem Gürtelrose-Erreger (dem Varizella-Zoster-Virus), aber auch bakterielle Infektionen wie bei einer Mittelohrentzündung können eine Gesichtslähmung auslösen.“"
                            },
                            {
                                "example_id": "e71bc71b-a296-4540-ac6a-25efbf06181c",
                                "sense_id": "9efa98c0-de6c-306b-b72a-7685cdc3d1b2",
                                "text": "„Auch eine fortgeschrittene Schwangerschaft oder ein Diabetes mellitus können eine Fazialisparese begünstigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
