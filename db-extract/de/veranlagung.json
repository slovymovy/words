                "senses": [
                    {
                        "sense_id": "17b98735-178a-3b96-a928-ce25fb62d036",
                        "entry_id": "4ca552e4-15b7-3c70-97de-30eca0f1dbdc",
                        "glosses": [
                            "Neigung zu etwas; Charakterzug oder eine Eigenschaft (die oder der in seinen Grundzügen angeboren ist)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71a2cba3-f02f-423a-90e7-7113fc3164f4",
                                "sense_id": "17b98735-178a-3b96-a928-ce25fb62d036",
                                "text": "Die Veranlagung für viele Erkrankungen wird vererbt."
                            },
                            {
                                "example_id": "cb5e4b83-153a-433d-a49e-b1a2f7c92013",
                                "sense_id": "17b98735-178a-3b96-a928-ce25fb62d036",
                                "text": "Geduld und andere Eigenschaften sind ein Mix aus genetischer Veranlagung und Erziehung."
                            },
                            {
                                "example_id": "948f8fad-9b98-487e-9640-209e59cb29ea",
                                "sense_id": "17b98735-178a-3b96-a928-ce25fb62d036",
                                "text": "Ihre musikalische Veranlagung hat sie vom Opa mütterlicherseits."
                            },
                            {
                                "example_id": "55b840fb-787f-466a-adb8-02ba858bb57f",
                                "sense_id": "17b98735-178a-3b96-a928-ce25fb62d036",
                                "text": "„Ist Homosexualität ein Produkt unserer genetischen Veranlagung oder des sozialen Umfelds? Eine Frage, auf die es bis heute keine eindeutige Antwort gibt.“"
                            },
                            {
                                "example_id": "e1a620a1-c19c-4b52-a19a-9802408c98ef",
                                "sense_id": "17b98735-178a-3b96-a928-ce25fb62d036",
                                "text": "„Mit meiner Veranlagung habe ich aber vielleicht gut daran getan, mich nicht unwiderruflich zu binden, obwohl die Unabhängigkeit in meinem Alter eine Art von Sklaverei ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3626b0f0-4fcc-36a7-bc03-6738ec29d901",
                        "entry_id": "4ca552e4-15b7-3c70-97de-30eca0f1dbdc",
                        "glosses": [
                            "Festlegung der Umstände und Höhe einer Besteuerung"
                        ],
                        "tags": [
                            "Finanzamt"
                        ],
                        "examples": [
                            {
                                "example_id": "a26476c6-95a9-41f0-a195-7735f1ab2dd5",
                                "sense_id": "3626b0f0-4fcc-36a7-bc03-6738ec29d901",
                                "text": "Die Veranlagung erfolgt nach Ablauf des Veranlagungszeitraumes und bezieht sich auf das während dieses Zeitraums erzielte Einkommen."
                            }
                        ],
                        "sense_index_json": "\"2\""
