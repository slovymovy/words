                "senses": [
                    {
                        "sense_id": "ba390a2e-44a6-3776-839d-0385873218bb",
                        "entry_id": "30d8f577-7a6d-303e-9670-5f1262050175",
                        "glosses": [
                            "substancja neuroaktywna o działaniu psychodelicznym, wywołująca zwykle odurzenie i wizje, mająca zdolność do wywoływania zmian percepcji, świadomości, sposobu myślenia oraz sposobu odczuwania emocji"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3ba08fd-7cc5-4c5c-b77e-4494acf5d4cf",
                        "source_entry_id": "30d8f577-7a6d-303e-9670-5f1262050175",
                        "source_sense_id": "ba390a2e-44a6-3776-839d-0385873218bb",
                        "target_lang_word": "psychedelic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychedelic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5447a64-0840-301c-8d38-27c657ce3551",
                                        "entry_id": "40156551-27b4-3fe8-8b2b-e588c9da5aa4",
                                        "glosses": [
                                            "Of, containing, generating, or reminiscent of drug-induced hallucinations, distortions of perception, altered awareness, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46754f92-cfde-4f60-a376-51d2aa62054e",
                                                "sense_id": "f5447a64-0840-301c-8d38-27c657ce3551",
                                                "text": "With those drugs has come the psychedelic philosophy, an impassioned belief in the self-revealing, mind-expanding powers of potent weeds and seeds and chemical compounds known to man since prehistory but wholly alien to the rationale of Western society."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03b20612-f272-3c73-9c93-b1acb4b67276",
                                        "entry_id": "40156551-27b4-3fe8-8b2b-e588c9da5aa4",
                                        "glosses": [
                                            "Having bright colours, abstract shapes, etc. reminiscent of drug-induced hallucinations or distortions of perception."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b68f8ce-e52c-42b6-a36c-a240130c346c",
                                                "sense_id": "03b20612-f272-3c73-9c93-b1acb4b67276",
                                                "text": "There was a woman sitting on the edge of his bed. She had coral-orange hair, beryl-blue eyes, arched brows, freckles, a coy smile, a psychedelic labcoat and she was, he suddenly realized, his best friend of over twenty years."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "psychedelic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5a3d6b1-607a-3497-b0c3-9f98c929b4c4",
                                        "entry_id": "c879a83a-e937-39d0-8ab1-c438060e34e2",
                                        "glosses": [
                                            "Any psychoactive substance (such as LSD or psilocybin) which, when consumed, causes perceptual changes (sometimes erratic and uncontrollable), visual hallucination, and altered awareness of the body and mind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "396f0064-c274-499e-985d-fab875c32c41",
                                                "sense_id": "b5a3d6b1-607a-3497-b0c3-9f98c929b4c4",
                                                "text": "I was going to become a three-drug connection to all my friends, psychedelics, hash and pot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "psychedelic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e37c3141-cca6-36ee-b913-cd2917a80e41",
                                        "entry_id": "aae8f476-f899-3ae4-8374-d9fb0b211b1e",
                                        "glosses": [
                                            "Awesome, cool, groovy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf81806d-ee8a-4b18-aa51-23e5e9497c17",
                        "source_entry_id": "30d8f577-7a6d-303e-9670-5f1262050175",
                        "source_sense_id": "ba390a2e-44a6-3776-839d-0385873218bb",
                        "target_lang_word": "психоделик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "психоделик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e2bb7577-8f1f-32d9-961d-dad4e881a0a3",
                                        "entry_id": "b007c5f4-2ab9-336d-b0c5-feb0daee5883",
                                        "glosses": [
                                            "психоактивное вещество, изменяющее восприятие и влияющее на эмоциональное состояние и многие психические процессы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c8a3e1e-b5c8-4fab-85e8-a8186ed7ebfb",
                                                "sense_id": "e2bb7577-8f1f-32d9-961d-dad4e881a0a3",
                                                "text": "Наиболее популярный психоделик индустриальной эпохи — LSD, но известны и другие — мескалин (кактус-пейот), псилоцибин (гриб-строфария), айяхуаска («лиана мертвеца») и т. д."
                                            },
                                            {
                                                "example_id": "bc396006-d966-4399-8a9c-49ea81fd5b43",
                                                "sense_id": "e2bb7577-8f1f-32d9-961d-dad4e881a0a3",
                                                "text": "Американские индейцы считают, что единственно правильное изменение сознания наступает только тогда, когда психоделик естественного происхождения и вырос на земле предков."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
