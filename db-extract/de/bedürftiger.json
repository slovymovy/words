                "senses": [
                    {
                        "sense_id": "4db3f510-3ee4-320a-93c8-fd2054845bf3",
                        "entry_id": "5aed831a-079d-32bf-9886-544d965e3502",
                        "glosses": [
                            "jemand, der für seinen Lebensunterhalt auf Hilfe angewiesen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14126495-5f0b-43fe-ba9a-89b089ba9f30",
                                "sense_id": "4db3f510-3ee4-320a-93c8-fd2054845bf3",
                                "text": "„Sobald sich ein Bedürftiger nähert, sofort an ihm vorbei in die Ferne schauen, sofort einer immaginären Figur zuwinken und losgehen.“"
                            },
                            {
                                "example_id": "30aee9aa-5754-4041-aaa6-605413fd1b8e",
                                "sense_id": "4db3f510-3ee4-320a-93c8-fd2054845bf3",
                                "text": "„Sie erwärmt die Herzen der Menschen, und diese beginnen, sich um ihre Nächsten zu kümmern, den Schwachen zu helfen und die Bedürftigen zu unterstützen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
