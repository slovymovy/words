                        "sense_id": "f08c77d8-cf06-38c8-9141-cb94677e8887",
                        "entry_id": "0fb473f1-124e-386d-95f8-b77624fc1c04",
                        "glosses": [
                            "Pays asiatique composé de la péninsule située au sud de la Thaïlande et de la majeure partie du Nord de l’île de Bornéo. Sa capitale est Kuala Lumpur."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "340936dc-bdbe-3164-95ca-b544dae0d1ec",
                        "entry_id": "0fb473f1-124e-386d-95f8-b77624fc1c04",
                        "glosses": [
                            "Partie de la Malaysia, ancien pays et partie de la péninsule située en Asie du Sud-Est contenant le point le plus méridional du continent asiatique."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "a1ed7eee-d0ad-4f64-87c4-121d3c7fe29d",
                                "sense_id": "340936dc-bdbe-3164-95ca-b544dae0d1ec",
                                "text": "30 juillet 1963 : sommet à Manille entre l’Indonésie, les Philippines et la Malaisie à propos du projet de Grande Malaisie qui regrouperait Singapour et le Nord de l’île de Bornéo."
                            }
                        ]
                    }
                ],
                "translations": [
