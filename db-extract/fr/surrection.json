                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db049637-a4e8-44d6-bba2-89dd869a1c8f",
                                "sense_id": "b050db81-eea4-37dc-8361-13cf5902422c",
                                "text": "Peut-on être surpris par la surrection de ce qu’on espère et qu’on attend ? Bien sûr que oui. Quand le cèpe est là, on ne voit plus que lui."
                            }
                        ]
                    }
