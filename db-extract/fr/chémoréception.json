                    {
                        "sense_id": "97053925-02e8-36cf-b367-953b22f93582",
                        "entry_id": "44600216-f6a5-3a14-a220-64b90ca55ec1",
                        "glosses": [
                            "Processus biologique par lequel des récepteurs moléculaires détectent la présence de substances chimiques spécifiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ed6eaca-5719-499f-b6ac-17780e268956",
                                "sense_id": "97053925-02e8-36cf-b367-953b22f93582",
                                "text": "La chémoréception est le processus qui permet aux organismes de percevoir des stimuli chimiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b850ba3-faee-3a6e-84e8-8d51e263e575",
                        "entry_id": "44600216-f6a5-3a14-a220-64b90ca55ec1",
                        "glosses": [
                            "Fonction sensorielle permettant à un organisme de percevoir des stimuli chimiques via des cellules spécialisées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84ca2252-6e81-4aa7-acbf-5f6c9cacb966",
                                "sense_id": "5b850ba3-faee-3a6e-84e8-8d51e263e575",
                                "text": "La chémoréception est la capacité à détecter des substances chimiques, grâce à des cellules adaptées, qui transmettent un signal nerveux en conséquence."
                            },
                            {
                                "example_id": "ad88d50e-a797-408b-a16c-5a6218af0c8e",
                                "sense_id": "5b850ba3-faee-3a6e-84e8-8d51e263e575",
                                "text": "On ignore aussi s'ils sont ou non générés par des cellules distinctes et si des associations cellulaires sont nécessaires à l'expression d'une chémoréception."
                            }
                        ]
                    }
                ],
