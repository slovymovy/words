                        "entry_id": "f0dfca04-6721-3dbd-9768-0b041bef3c6b",
                        "glosses": [
                            "хим. гликозид, содержащийся в косточках многих растений рода сливы, придавая им горький вкус"
                        ],
                        "tags": [],
                        "examples": [
