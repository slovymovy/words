                    {
                        "sense_id": "6c8d7799-ae72-3733-9eee-07d5f25547ab",
                        "entry_id": "3dcdc58f-2f1c-3dc1-8fd7-7e35317b5e67",
                        "glosses": [
                            "behoefte voelend om aanmerkingen te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "318579a8-bbb7-4444-8e16-82f2b8c24a3e",
                                "sense_id": "6c8d7799-ae72-3733-9eee-07d5f25547ab",
                                "text": "Wij betreuren het dat u een ontevreden lezer geworden bent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "801c5edd-17c6-4299-8d62-6781ac90f7ca",
                        "source_entry_id": "3dcdc58f-2f1c-3dc1-8fd7-7e35317b5e67",
                        "source_sense_id": "6c8d7799-ae72-3733-9eee-07d5f25547ab",
                        "source_sense_description": "behoefte voelend om aanmerkingen te maken",
                        "target_lang_word": "unzufrieden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unzufrieden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "680da296-2dd4-3ad2-b331-8180ea79789b",
                                        "entry_id": "6c402579-a811-3d1a-8440-4fec57d1e6c4",
                                        "glosses": [
                                            "nicht zufrieden, von einem Umstand gestört, mit etwas nicht einverstanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2643213d-39c9-4caf-9c9d-5ff1aad373e1",
                                                "sense_id": "680da296-2dd4-3ad2-b331-8180ea79789b",
                                                "text": "Ich bin mit der Situation im höchsten Maße unzufrieden. Es muss sich einiges ändern."
                                            },
                                            {
                                                "example_id": "6faa9902-2bcd-43e8-a997-a2bc67f2fdef",
                                                "sense_id": "680da296-2dd4-3ad2-b331-8180ea79789b",
                                                "text": "„In Kiel verbreitete sich das Gerücht über die Inhaftierung der Meuterer in Windeseile unter den unzufriedenen Marineangehörigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71513fa3-f551-43ce-9ccf-8183fd6d3625",
                        "source_entry_id": "3dcdc58f-2f1c-3dc1-8fd7-7e35317b5e67",
                        "source_sense_id": "6c8d7799-ae72-3733-9eee-07d5f25547ab",
                        "source_sense_description": "behoefte voelend om aanmerkingen te maken",
                        "target_lang_word": "discontented",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discontented",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a3ed2e7-19e7-3fc2-9119-8627ae3b268d",
                                        "entry_id": "168404c0-1d99-3fe4-aaef-4ae8a0d7e40e",
                                        "glosses": [
                                            "Experiencing discontent, dissatisfaction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f26c29b-384e-4f58-941a-079f12023a14",
                                                "sense_id": "6a3ed2e7-19e7-3fc2-9119-8627ae3b268d",
                                                "text": "After her injury, Alice was a discontented woman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4144c352-f686-389a-9cde-aace7b3c6bb3",
                                        "entry_id": "168404c0-1d99-3fe4-aaef-4ae8a0d7e40e",
                                        "glosses": [
                                            "Of or pertaining to discontent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae379e68-3ca7-45a6-977a-52edcd4560dd",
                                                "sense_id": "4144c352-f686-389a-9cde-aace7b3c6bb3",
                                                "text": "He lived a discontented life."
                                            },
                                            {
                                                "example_id": "e68b13d7-eee3-4096-a1c0-b4a738317229",
                                                "sense_id": "4144c352-f686-389a-9cde-aace7b3c6bb3",
                                                "text": "Clara, like many self-willed and discontented persons, was really very apt, without knowing it, to do as other people told her, and to let her destiny be decided for her by intelligences much below her own."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
