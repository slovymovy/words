                    }
                ],
                "senses": [
                    {
                        "sense_id": "51645beb-625f-35c8-9a90-64709c6d79ed",
                        "entry_id": "61d63fe0-4fc8-36a4-b0a7-9c30206a148a",
                        "glosses": [
                            "dyskusja, rozprawianie, roztrząsanie problemów"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "16351fc0-88a9-4e96-a1f2-5a6fb1ca095f",
                                "sense_id": "51645beb-625f-35c8-9a90-64709c6d79ed",
                                "text": "W Sejmie wciąż trwa debata na temat prezydenckiego weta w sprawie ustawy oświatowej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aeb1a494-10e0-43c2-9bc3-090245661031",
                        "source_entry_id": "61d63fe0-4fc8-36a4-b0a7-9c30206a148a",
                        "source_sense_id": "51645beb-625f-35c8-9a90-64709c6d79ed",
                        "target_lang_word": "debate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "debate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                        "entry_id": "fe441944-0075-3543-bead-dbb4008fb22f",
                                        "glosses": [
                                            "To participate in a debate; to dispute, argue, especially in a public arena."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "reciprocal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59bed9ca-6579-4253-b10d-6656efc74b9a",
                                                "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                                "text": "\"Debate me, coward!\" snarled the completely normal intellectual."
                                            },
                                            {
                                                "example_id": "eb8729b9-2bf5-42b3-aedf-adfdb483402c",
                                                "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                                "text": "a wise council […] that did debate this business"
                                            },
                                            {
                                                "example_id": "387097f8-b990-4f54-bc8d-c8fb97f52003",
                                                "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                                "text": "Debate thy cause with thy neighbour himself."
                                            },
                                            {
                                                "example_id": "2085742e-e8ad-4cad-b921-4bb66199dc19",
                                                "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                                "text": "He presents that great soul debating upon the subject of life and death with his intimate friends."
                                            },
                                            {
                                                "example_id": "4929d094-8fbd-46c4-a8c1-c9580f3dd815",
                                                "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                                "text": "When the legislation was debated by the House of Commons, Labour Deputy Leader Angela Rayner said it was \"riddled with holes\", while former Conservative Commons Leader Jacob Rees-Mogg said it was \"badly written\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "752b9c92-1614-3345-b803-2b624dbb1e03",
                                        "entry_id": "fe441944-0075-3543-bead-dbb4008fb22f",
                                        "glosses": [
                                            "To fight."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete",
                                            "reciprocal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62eb8683-8fa3-4abe-81d2-61eac10f6536",
                                                "sense_id": "752b9c92-1614-3345-b803-2b624dbb1e03",
                                                "text": "Well knew they both his person, sith of late / With him in bloudie armes they rashly did debate."
                                            },
                                            {
                                                "example_id": "a85892a5-5746-46d6-ad07-1e4b15d4a429",
                                                "sense_id": "752b9c92-1614-3345-b803-2b624dbb1e03",
                                                "text": "[…] wasteful Time debateth with Decay,\nTo change your day of youth to sullied night"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dc2a51b-c0be-3e9c-91e4-e2bf5cebde2c",
                                        "entry_id": "fe441944-0075-3543-bead-dbb4008fb22f",
                                        "glosses": [
                                            "To engage in combat for; to strive for."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "316e49f4-cedc-4910-8327-3a8a8feb97ef",
                                                "sense_id": "5dc2a51b-c0be-3e9c-91e4-e2bf5cebde2c",
                                                "text": "Volunteers […] thronged to serve under his banner, and the cause of religion was debated with the same ardour in Spain as on the plains of Palestine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4507488b-1107-36d9-bd76-4809eea9eeb8",
                                        "entry_id": "fe441944-0075-3543-bead-dbb4008fb22f",
                                        "glosses": [
                                            "To consider (to oneself), to think over, to attempt to decide"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cafcb58-caf6-454d-bb64-311dbd02ed8e",
                                                "sense_id": "4507488b-1107-36d9-bd76-4809eea9eeb8",
                                                "text": "He was debating where he'd spend his holiday."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "debate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f030b9e-95fd-385f-bdb3-4789cea390aa",
                                        "entry_id": "57681edb-1dd3-3002-9a6b-333fbfc67778",
                                        "glosses": [
                                            "An argument, or discussion, usually in an ordered or formal setting, often with more than two people, generally ending with a vote or other decision."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c039e8c5-433c-4f00-a28d-5d18e9f9762f",
                                                "sense_id": "0f030b9e-95fd-385f-bdb3-4789cea390aa",
                                                "text": "After a four-hour debate, the committee voted to table the motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00b0c005-2329-3678-9a75-65afcea8a184",
                                        "entry_id": "57681edb-1dd3-3002-9a6b-333fbfc67778",
                                        "glosses": [
                                            "An informal and spirited but generally civil discussion of opposing views."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfa23377-8856-4644-8c09-81cc82928210",
                                                "sense_id": "00b0c005-2329-3678-9a75-65afcea8a184",
                                                "text": "The debate over the age of the universe is thousands of years old."
                                            },
                                            {
                                                "example_id": "5c5e2055-afc4-413d-aaea-a7eba9c9e737",
                                                "sense_id": "00b0c005-2329-3678-9a75-65afcea8a184",
                                                "text": "There was a bit of a debate over who should pay for the damaged fence."
                                            },
                                            {
                                                "example_id": "c96da967-9dcf-4817-bf77-101d5ebc8e90",
                                                "sense_id": "00b0c005-2329-3678-9a75-65afcea8a184",
                                                "text": "The use of algorithms in policing is one example of their increasing influence on our lives. And, as their ubiquity spreads, so too does the debate around whether we should allow ourselves to become so reliant on them – and who, if anyone, is policing their use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1e7b9c5-b0fe-371e-8967-9d3e4cc947b3",
                                        "entry_id": "57681edb-1dd3-3002-9a6b-333fbfc67778",
                                        "glosses": [
                                            "Discussion of opposing views."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59179a42-5b68-447d-aa7e-882a53ecd7ef",
                                                "sense_id": "b1e7b9c5-b0fe-371e-8967-9d3e4cc947b3",
                                                "text": "There has been considerable debate concerning exactly how to format these articles."
                                            },
                                            {
                                                "example_id": "2c0c1e0e-3751-407a-8f93-4bb01bbd35e0",
                                                "sense_id": "b1e7b9c5-b0fe-371e-8967-9d3e4cc947b3",
                                                "text": "Oxygen levels on Earth skyrocketed 2.4 billion years ago, when cyanobacteria evolved photosynthesis:[…]. The evolutionary precursor of photosynthesis is still under debate, and a new study sheds light. The critical component of the photosynthetic system is the “water-oxidizing complex”, made up of manganese atoms and a calcium atom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eccd06d-09d6-3dbd-8c22-52e2632c933f",
                                        "entry_id": "57681edb-1dd3-3002-9a6b-333fbfc67778",
                                        "glosses": [
                                            "A type of literary composition, taking the form of a discussion or disputation, commonly found in the vernacular medieval poetry of many European countries, as well as in medieval Latin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "825e5560-a37e-31fb-a29d-aa5c5193bc5b",
                                        "entry_id": "57681edb-1dd3-3002-9a6b-333fbfc67778",
                                        "glosses": [
                                            "Strife, discord."
                                        ],
