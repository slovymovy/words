                ],
                "senses": [
                    {
                        "sense_id": "6ff882b2-cb45-300f-bccc-1229828d1d79",
                        "entry_id": "e23c2730-4e08-3560-9f4d-024b3f772a3d",
                        "glosses": [
                            "Fermer à demi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c554db9-111b-4377-a7ed-428e20e125dc",
                                "sense_id": "6ff882b2-cb45-300f-bccc-1229828d1d79",
                                "text": "Les battements du cœur lui font entrefermer les yeux."
                            },
                            {
                                "example_id": "f4ea5b57-a6ba-4b8f-83f5-60562d717b48",
                                "sense_id": "6ff882b2-cb45-300f-bccc-1229828d1d79",
                                "text": "Les facultés pensent à entrefermer leur porte pour ne garder que les meilleurs."
                            },
                            {
                                "example_id": "5ef3d860-a2f4-4ce5-9d61-ff67385c504a",
                                "sense_id": "6ff882b2-cb45-300f-bccc-1229828d1d79",
                                "text": "Elle entreferma les paupières, et les muscles de sa mâchoire forte et quasi masculine se durcirent de façon menaçante, tandis qu’elle toisait l’intrus du haut en bas."
                            }
                        ]
                    }
                ],
