                "senses": [
                    {
                        "sense_id": "c6ca6d29-1e6b-3787-bce5-65ceead47682",
                        "entry_id": "1e8fdeea-be20-3b36-98bc-6230936c2b48",
                        "glosses": [
                            "Augmentation anormale de la tonicité musculaire, entrainant l’étirement rapide d’un muscle qui entraîne trop facilement sa contraction réflexe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "080994cd-7c39-4c3a-b7be-877bdaba4187",
                                "sense_id": "c6ca6d29-1e6b-3787-bce5-65ceead47682",
                                "text": "La spasticité se manifeste par des contractures musculaires, parfois très douloureuses, avec une raideur et des spasmes au niveau des membres inférieurs. Chez certains patients, c’est très pénible car cela peut gêner la marche ou perturber le sommeil."
                            },
                            {
                                "example_id": "e290e514-a4c9-4c5f-8d8f-680f69922d86",
                                "sense_id": "c6ca6d29-1e6b-3787-bce5-65ceead47682",
                                "text": "Après un accident de la route, je souffre d’hémiparésie (Ndlr : un déficit partiel de la force musculaire, du côté gauche) et de spasticité (une raideur musculaire involontaire, le plus souvent retrouvée au niveau de certains muscles présentant un déficit moteur.)"
                            }
                        ]
                    }
                ],
