                ],
                "senses": [
                    {
                        "sense_id": "ec768dd1-c195-39fd-bb23-dd0fd30d7ed0",
                        "entry_id": "0c2299c7-674d-373f-a0bb-9c5a2f680cf1",
                        "glosses": [
                            "S’annihiler soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c62ad6e-dd70-471c-a6cc-90280dc1afa1",
                                "sense_id": "ec768dd1-c195-39fd-bb23-dd0fd30d7ed0",
                                "text": "On a découvert qu'on avait la capacité de s'autoannihiler."
                            },
                            {
                                "example_id": "44ee171c-3467-43cf-b139-a2ba6ff6a1fa",
                                "sense_id": "ec768dd1-c195-39fd-bb23-dd0fd30d7ed0",
                                "text": "À la longue, particules et antiparticules auraient dû finir par complètement s'autoannihiler, ce qui n'est pas le cas, puisqu'on observe un surplus de matière."
                            },
                            {
                                "example_id": "a1745fd9-804d-457a-b47b-87a0b032b7f0",
                                "sense_id": "ec768dd1-c195-39fd-bb23-dd0fd30d7ed0",
                                "text": "Alors, je suis né, je suis mort tel le Ying et le Yang j'ai respecté l'équilibre du monde ; je me suis autoannihilé."
                            }
                        ]
                    }
                ],
