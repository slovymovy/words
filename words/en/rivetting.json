                            }
                        },
                        {
                            "text": "He succeeded in <w>rivetting</w> the attention of everyone in the audience.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>приковать</w> к себе внимание всех присутствующих в зале."
