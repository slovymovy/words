                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "7b0b9157-ee11-4581-b5bd-aaaede200683",
                                "sense_id": "0177626c-1553-3c43-bea3-dc590605f7fd",
                                "text": "„Wer so lacht, hat keine solche Kommißstimme.“"
                            },
                            {
                                "example_id": "0cce5af0-c2bf-47b8-bc1a-cb34055e1e69",
                                "sense_id": "0177626c-1553-3c43-bea3-dc590605f7fd",
                                "text": "„Da rief eine kräftige Kommißstimme über den Tisch — und es blieb uns nichts erspart, der Satz hieß anders, und ich gebe ihn hier fein zurechtgebügelt: « Siewers! Sie müßten mal 'n Happen lieben!»“"
                            },
                            {
                                "example_id": "b6e882dc-8412-4dc3-9820-a04a6cd2f5f9",
                                "sense_id": "0177626c-1553-3c43-bea3-dc590605f7fd",
                                "text": "„\"In Viererreihen aufstellen!\" Sofort trat Stille ein. Lauernd sah man mich an. Die bis vor kurzem so verhaßte Kommißstimme verfehlte auch hier ihre Wirkung nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
