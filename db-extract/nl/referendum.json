                                        "entry_id": "26c477c7-5162-3562-b5cb-1b45e6035eac",
                                        "glosses": [
                                            "Vote direct où les votants doivent répondre par « oui » ou par « non » à une question posée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
