                                        "examples": [
                                            {
                                                "example_id": "f6671daf-5490-488f-912f-d7cc8786ab25",
                                                "sense_id": "822fd08b-98ea-33bf-9429-1424f02a1da5",
                                                "text": "A stream of atomic hydrogen is emitted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b76bac4-c573-383a-ad3b-40039f461af0",
                                        "entry_id": "833dcf67-ac03-373f-9952-c5ccfee96842",
                                        "glosses": [
                                            "Employing or relating to nuclear energy or processes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "800abb26-f7f3-45ca-a522-a3ff273dc3b9",
                                                "sense_id": "5b76bac4-c573-383a-ad3b-40039f461af0",
                                                "text": "atomic energy; atomic bombs"
                                            },
                                            {
                                                "example_id": "821f02ab-583e-4863-8a01-bc01196e1e69",
                                                "sense_id": "5b76bac4-c573-383a-ad3b-40039f461af0",
                                                "text": "Some nutjob once built a small atomic pile in his back yard."
                                            },
                                            {
                                                "example_id": "efcedae2-c36e-4f8e-b776-2f63e2b1e3bc",
                                                "sense_id": "5b76bac4-c573-383a-ad3b-40039f461af0",
                                                "text": "Before the atomic spy Allan Nunn May left Canada to go to London, a treff in London had to be arranged for him and another agent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "260b0eff-e417-39a9-b304-a9b16065d2ae",
                                        "entry_id": "833dcf67-ac03-373f-9952-c5ccfee96842",
                                        "glosses": [
                                            "Employing or relating to nuclear energy or processes.",
                                            "Very strong and overpowering."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b28c2049-dbc2-3dc0-a34c-a592a1a939b2",
                                        "entry_id": "833dcf67-ac03-373f-9952-c5ccfee96842",
                                        "glosses": [
                                            "Infinitesimally small."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d33876c-3f04-4a05-a8e3-b3a5ab17a7ef",
                                                "sense_id": "b28c2049-dbc2-3dc0-a34c-a592a1a939b2",
                                                "text": "The hairs on a dust mite are almost atomic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48feb163-b1d2-30ea-8f4f-8655f2843935",
                                        "entry_id": "833dcf67-ac03-373f-9952-c5ccfee96842",
                                        "glosses": [
                                            "Unable to be split or made any smaller."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "763037c3-3419-4b68-a54b-f90638ab6477",
                                                "sense_id": "48feb163-b1d2-30ea-8f4f-8655f2843935",
                                                "text": "A bit is an atomic item of data."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e0143d9-9db5-3ae6-9ce4-8f88d54e16cd",
                                        "entry_id": "833dcf67-ac03-373f-9952-c5ccfee96842",
                                        "glosses": [
                                            "Unable to be split or made any smaller.",
                                            "Containing a single change, as opposed to involving numerous unrelated changes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d1254ac1-5911-3158-8495-d061044049b6",
                                        "entry_id": "833dcf67-ac03-373f-9952-c5ccfee96842",
                                        "glosses": [
                                            "Unable to be split or made any smaller.",
                                            "Lacking logical operators; unable to be made simpler in logical form."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48a88f07-c72a-3710-9a19-0c69d27fa37a",
                                        "entry_id": "833dcf67-ac03-373f-9952-c5ccfee96842",
                                        "glosses": [
                                            "Unable to be split or made any smaller.",
                                            "Such that for every element b>0 there exists an atom a such that b≥a>0."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d843636-c46a-3d4b-8d46-2000c7523a99",
                                        "entry_id": "833dcf67-ac03-373f-9952-c5ccfee96842",
                                        "glosses": [
                                            "Guaranteed to complete either fully or not at all while waiting in a pause, and running synchronously when called by multiple asynchronous threads."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ab51060-2dc8-4221-a9cc-2fd4b8ed584a",
                                                "sense_id": "2d843636-c46a-3d4b-8d46-2000c7523a99",
                                                "text": "In order to avoid race conditions, this operation has to be atomic."
                                            },
                                            {
                                                "example_id": "d45dc2b9-c7e0-4b83-b8c7-559b9f306b61",
                                                "sense_id": "2d843636-c46a-3d4b-8d46-2000c7523a99",
                                                "text": "Whenever possible, use atomic types instead of mutexes."
                                            },
                                            {
                                                "example_id": "5cb3287b-de4a-4d90-9aef-94bda9076e6b",
                                                "sense_id": "2d843636-c46a-3d4b-8d46-2000c7523a99",
                                                "text": "It also provides an atomic compareAndSet method (which if successful has the memory effects of both reading and writing a volatile variable) and, for convenience, atomic add, increment, and decrement methods."
                                            }
                                        ]
                                    }
                                ]
                            },
