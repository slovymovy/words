                "senses": [
                    {
                        "sense_id": "1569d7f9-d0e8-349e-9320-16db711c6949",
                        "entry_id": "1d7ef989-587b-3dee-8f02-a1832c493e1f",
                        "glosses": [
                            "Garten im Stil des Barocks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6724df87-42e8-4adb-b6ef-e3d48933d3da",
                                "sense_id": "1569d7f9-d0e8-349e-9320-16db711c6949",
                                "text": "„Sie wanderte durch die gepflegten Barockgärten des Châteaus, während Sicherheitsleute mit Maschinengewehren sie vom Dach aus beobachteten und Überwachungskameras jeden ihrer Schritte dokumentierten.“"
                            },
                            {
                                "example_id": "154b5e0e-8e5e-446f-a536-5333c1eafc20",
                                "sense_id": "1569d7f9-d0e8-349e-9320-16db711c6949",
                                "text": "„Die Wasserburg, die zu den prachtvollsten Burganlagen Westfalens zählt, begeistert vor allem die Besucher mit Barockgärten und der großzügig angelegten Parkanlage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
