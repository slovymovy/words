                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ded1e66-d502-4a5c-9f4e-8b32216472c5",
                        "source_entry_id": "135def17-b482-3b17-a5a5-cd0771d37f49",
                        "source_sense_id": "4fa1f69d-f296-3491-bf73-2b691a34565e",
                        "source_sense_description": "Muschel mit gestreiftem Muster auf der Schale",
                        "target_lang_word": "moule zébrée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moule zébrée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e32a84b8-a427-3eb9-965e-9a8004f44bcb",
                                        "entry_id": "c5b62929-b95f-3021-8c3c-02e5dcadb164",
                                        "glosses": [
                                            "Petit bivalve d’eau douce originaire du bassin de la Caspienne, qui s’est répandu en Europe et en Amérique du Nord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e73ae0c-cb2c-44f2-8962-f15ce9ca3fae",
                                                "sense_id": "e32a84b8-a427-3eb9-965e-9a8004f44bcb",
                                                "text": "Contrairement aux moules indigènes du Québec, la moule zébrée adulte possède des petits filaments situés sur sa face ventrale qui lui permettent de s’accrocher à pratiquement tous les types de surfaces dures, comme les roches, les autres mollusques, les quais et les prises d’eau."
                                            },
                                            {
                                                "example_id": "b710fa6d-d945-4062-a838-d607ef884754",
                                                "sense_id": "e32a84b8-a427-3eb9-965e-9a8004f44bcb",
                                                "text": "Au cours des dernières années, une multitude d’espèces envahissantes ont fait leur apparition dans les lacs canadiens. La moule zébrée poursuit sa progression au Québec et au Manitoba."
                                            },
                                            {
                                                "example_id": "f0cf014c-aa64-4779-893c-7cd5c8a8cf60",
                                                "sense_id": "e32a84b8-a427-3eb9-965e-9a8004f44bcb",
                                                "text": "Cependant, une espèce a affiché son effectif minimal depuis 1991 avec 5’300 individus dénombrés. Il s’agit du Fuligule morillon qui souffre de la diminution de la moule zébrée, une espèce introduite par l’homme et qui constitue une importante source de nourriture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
