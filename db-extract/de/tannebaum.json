                "senses": [
                    {
                        "sense_id": "9b51a56e-5a0a-3e7c-8248-2e88ac2e0f37",
                        "entry_id": "d3aa4902-a66d-32bd-afbf-4f305e0c5526",
                        "glosses": [
                            "Nadelbaum, der zu Weihnachten in Wohnungen und auf öffentlichen Plätzen aufgestellt und geschmückt wird"
                        ],
                        "tags": [
                            "colloquial",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "f04e447f-cf39-4cef-8242-a0917f7071e2",
                                "sense_id": "9b51a56e-5a0a-3e7c-8248-2e88ac2e0f37",
                                "text": "„Das Programm des Weihnachtskonzertes umfasst moderne Lieder wie „Carol Of The Bells“, „White Christmas“ und „O Tannebaum, du trägst ein‘ grünen Zweig“, aber auch Klassiker wie „Machet die Tore weit“, „Maria durch ein‘ Dornwald ging“ und „Tochter Zion“.“"
                            },
                            {
                                "example_id": "e5750451-2951-488e-989a-cee95976575a",
                                "sense_id": "9b51a56e-5a0a-3e7c-8248-2e88ac2e0f37",
                                "text": "„O Tannebaum! O Tannebaum! Du bist mir ein edler Zweig, So treu bist du, man glaubt es kaum, Grünst sommers und winters gleich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
