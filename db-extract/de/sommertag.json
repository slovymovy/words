                        ],
                        "form": "den Sommertag"
                    },
                    {
                        "form_id": "0ca6e796-b863-4b30-8c26-1a500d90d3a3",
                        "entry_id": "497f6426-890f-342d-aad1-c73a13a6508d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sommertage"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4356a244-6b48-33b7-b650-2e903c120afe",
                        "entry_id": "497f6426-890f-342d-aad1-c73a13a6508d",
                        "glosses": [
                            "Tag im Sommer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f2535ac-9dcc-45ff-ae54-39241087c050",
                                "sense_id": "4356a244-6b48-33b7-b650-2e903c120afe",
                                "text": "„Weniger, öfter und leicht – das ist die ideale Ernährungsweise für heiße Sommertage.“"
                            },
                            {
                                "example_id": "73d6f476-a3bd-4a3d-8dfa-089ce02d72aa",
                                "sense_id": "4356a244-6b48-33b7-b650-2e903c120afe",
                                "text": "„An warmen Sommertagen schippern Kinder mit ihren selbst gebauten Flößen auf dem angestauten Dorfbach.“"
                            },
                            {
                                "example_id": "83d98cbb-c42e-4d37-a02e-2be2be1c9c92",
                                "sense_id": "4356a244-6b48-33b7-b650-2e903c120afe",
                                "text": "„In den ersten heißen Sommertagen wurde das Bezirksamt von der Welle erfasst.“"
                            },
                            {
                                "example_id": "39322ebf-59c1-4049-bc57-e8f2a3a13dc8",
                                "sense_id": "4356a244-6b48-33b7-b650-2e903c120afe",
                                "text": "„Der Sommertag auf der dänischen Heide brannte ihm auf der Haut.“"
                            },
                            {
                                "example_id": "f1f3c7f2-7273-41ff-85d0-1eb269a3ae01",
                                "sense_id": "4356a244-6b48-33b7-b650-2e903c120afe",
                                "text": "Erwin wurde an einem Sommertag geboren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "18d6fbad-7002-3d8f-b174-7abc780cd14c",
                        "entry_id": "497f6426-890f-342d-aad1-c73a13a6508d",
                        "glosses": [
                            "Tag, an dem eine Tageshöchsttemperatur von 25 °C erreicht oder überschritten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78330fc9-dbe5-4458-90f3-b8cce5dc93e1",
                                "sense_id": "18d6fbad-7002-3d8f-b174-7abc780cd14c",
                                "text": "Erwin wurde an einem Sommertag geboren."
                            },
                            {
                                "example_id": "b9e800fb-88b8-45d8-af7a-5f839c380484",
                                "sense_id": "18d6fbad-7002-3d8f-b174-7abc780cd14c",
                                "text": "„‚Damit war der 22. Oktober ein Sommertag, denn zu denen zählen alle Tage, an denen die Temperatur 25 Grad oder mehr erreicht,‘ so Rinderer weiter.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
