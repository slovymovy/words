                        "source_entry_id": "a30e342a-02fb-3f03-9b12-e6513c335724",
                        "source_sense_description": "(Marine) Partie du bordé d’un navire",
                        "target_lang_word": "bulwark",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
