                    {
                        "translation_id": "651bfefb-67c2-4064-89e3-7e8747e25a12",
                        "source_entry_id": "0f7894da-6cc9-3a1f-8b20-fc6bd6e79570",
                        "source_sense_id": "b080cf27-c869-3898-b80c-7c7332a268d5",
                        "source_sense_description": "erste Version eines Gesetzestextes",
                        "target_lang_word": "projet de loi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "projet de loi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b625f18-5798-338e-9eaf-bfc9471e9ef0",
                                        "entry_id": "0cefc7ff-4265-3952-80c7-ae3e0d25f172",
                                        "glosses": [
                                            "Texte de loi présenté à l’Assemblée nationale par le gouvernement."
                                        ],
                                        "tags": [
                                            "Législation",
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "277015ec-e431-47ea-a51e-33363d47c9dc",
                                                "sense_id": "4b625f18-5798-338e-9eaf-bfc9471e9ef0",
                                                "text": "L'honorable M. Bertauld nous a dit encore : Je repousse votre projet de loi parce que c'est un expédient, une loi de circonstance, et qu'il n'appartient pas aux assemblées politiques de se saisir de faits particuliers pour en faire l'objet d'une modification législative."
                                            },
                                            {
                                                "example_id": "90506d3f-bbca-41b5-a919-cc98aa311bbe",
                                                "sense_id": "4b625f18-5798-338e-9eaf-bfc9471e9ef0",
                                                "text": "Le préfet des Ardennes vient de suspendre pour deux mois de ses fonctions, M. Lemoine-Triquat, adjoint au maire de la commune de Mars-sous-Bourcq, pour avoir colporté et signé une protestation contre les projets de loi déposés par M. le Ministre de l’instruction publique."
                                            },
                                            {
                                                "example_id": "b7188549-c1d7-4b16-85e0-8f7ac3a52e2a",
                                                "sense_id": "4b625f18-5798-338e-9eaf-bfc9471e9ef0",
                                                "text": "Ensuite, après l’adoption, des lettres d’excuses furent lues, un petit projet de loi fut même expédié par un vote rapide, à main levée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
