                "senses": [
                    {
                        "sense_id": "3600ca2c-52fe-3bdb-ba3d-21a31e3b0478",
                        "entry_id": "fd8514e3-6836-333b-ad16-6192165223f4",
                        "glosses": [
                            "Mutilation de soi-même, fait de s'infliger des blessures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "034a9585-2e53-40f6-8640-e14a358331bc",
                                "sense_id": "3600ca2c-52fe-3bdb-ba3d-21a31e3b0478",
                                "text": "Dans ce cas, apparaissent des phénomènes inquiétants qui sont les auto-reproches, auto-punition, voire l’auto-mutilation ou le suicide."
                            },
                            {
                                "example_id": "56aa7030-83e5-409a-90ae-2a78c8355793",
                                "sense_id": "3600ca2c-52fe-3bdb-ba3d-21a31e3b0478",
                                "text": "En aucun cas par conséquent l’auto-mutilation en elle-même ne peut être le signe pathognomonique d’une affection mentale déterminée."
                            },
                            {
                                "example_id": "8b64fcbb-e3c1-4f00-87e8-1cc15e4da3c1",
                                "sense_id": "3600ca2c-52fe-3bdb-ba3d-21a31e3b0478",
                                "text": "Dans les auto-mutilations et dans l’auto-chirurgie le sujet s’incise et se sépare aussi quelquefois d’une partie de soi-même, mais il existe des différences essentielles."
                            }
                        ]
                    }
