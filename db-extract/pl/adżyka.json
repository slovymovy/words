                                "target_senses": [
                                    {
                                        "sense_id": "9e20e369-ecac-3eb6-b39e-a294f290f38f",
                                        "entry_id": "b8d80c73-8ee4-3857-98d7-0b6a1b655fab",
                                        "glosses": [
                                            "Sauce épicée caucasienne à base de tomate, poivron, piment, ail et coriandre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d357dc9-0b38-425c-a4eb-d5d36f338d5e",
                                                "sense_id": "9e20e369-ecac-3eb6-b39e-a294f290f38f",
                                                "text": "La tante Naïde apporta un somptueux khinkal avar, des morceaux de viande séchée, du fromage blanc à l’ail, de l’adjika et de la halva brune aux graines de lin."
                                            },
                                            {
                                                "example_id": "8802d59c-3c5e-4f1b-a128-b546909f81fc",
                                                "sense_id": "9e20e369-ecac-3eb6-b39e-a294f290f38f",
                                                "text": "Le père roulait des boulettes de viande hachée dans de la farine, les faisait frire un instant dans la poêle et les déposait dans une assiette remplie d’adjika, une sauce tomate très épicée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
