        "nl-extract.jsonl": [
            {
                "entry_id": "37b476a5-1e8e-310b-95bb-7ca973a2f8d3",
                "word": "inmiddels",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d6445cbf-0ed0-332a-b105-c63591fcad52",
                        "entry_id": "37b476a5-1e8e-310b-95bb-7ca973a2f8d3",
                        "glosses": [
                            "in de tussentijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "542b2d13-c1ca-4b77-bdbc-a5579bfbf969",
                                "sense_id": "d6445cbf-0ed0-332a-b105-c63591fcad52",
                                "text": "Er zijn inmiddels veel woorden bijgekomen."
                            },
                            {
                                "example_id": "481d6946-03a8-4908-a808-7a6cff4fb7f7",
                                "sense_id": "d6445cbf-0ed0-332a-b105-c63591fcad52",
                                "text": "Owens speelde in de jaren 80 schoonzoon Elvin in de hitserie. Alhoewel hij in de jaren daarna geregeld kleine gastrolletjes had in televisieseries, bleef het grote werk uit voor de inmiddels 57-jarige. Hij ging daardoor werken buiten de entertainmentindustrie, en werd afgelopen week door een klant gefotografeerd in de supermarkt waar hij een baan heeft. De foto kwam online te staan, waar veel mensen honend reageerden."
                            },
                            {
                                "example_id": "310d69db-1e06-4c4b-b91a-70be954c1350",
                                "sense_id": "d6445cbf-0ed0-332a-b105-c63591fcad52",
                                "text": "\"Een zwarte dag voor de horeca\", zegt chef-kok Rik van de Laar over het overlijden van Boer. Hij begon op 16-jarige leeftijd in De Librije, het eerste en bekendste restaurant van Boer, werkte er zeven jaar en runt inmiddels twee restaurants in Den Haag."
                            },
                            {
                                "example_id": "5b9637ac-b5c4-4204-b3cc-de4e0f67aebe",
                                "sense_id": "d6445cbf-0ed0-332a-b105-c63591fcad52",
                                "text": "Kinderen zijn, net als iedereen, gewoontedieren. De mijne waren inmiddels een beetje gewend aan het feit dat zowel ik als mijn vrouw af en toe een tijdje weg waren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1d9032e-3d88-41b8-b351-86b3565b0c30",
                        "source_entry_id": "37b476a5-1e8e-310b-95bb-7ca973a2f8d3",
                        "source_sense_id": "d6445cbf-0ed0-332a-b105-c63591fcad52",
                        "source_sense_description": "in de tussentijd",
                        "target_lang_word": "inzwischen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inzwischen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                        "entry_id": "05c9bad7-af7b-3f06-acbe-8c627d977b24",
                                        "glosses": [
                                            "in der Zwischenzeit, nach Ablauf einer gewissen Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1349d96b-0837-4d97-acac-435b2f8e3e17",
                                                "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                                "text": "Während sie noch spielten, konnten wir inzwischen die nötigen Vorbereitungen treffen."
                                            },
                                            {
                                                "example_id": "2afac981-c6dd-4e01-ae54-bdad7673bc82",
                                                "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                                "text": "„Selbst in den Bundesländern wird inzwischen indirekt eingeräumt, dass die Bahn in der Vergangenheit großzügig bedacht wurde.“"
                                            },
                                            {
                                                "example_id": "76671e86-11a6-45ff-9b2c-234b8bc786bc",
                                                "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                                "text": "„Im geistlichen Kurfürstentum Köln hatten inzwischen ebenfalls die Hexenprozesse sich zu häufen begonnen.“"
                                            },
                                            {
                                                "example_id": "b710f268-df84-4275-9a16-e41fba577005",
                                                "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                                "text": "„Inzwischen bringt der Kellner für Maja das bestellte Kännchen Kaffee und die drei Stücke Kuchen, die sie sich am Buffet ausgesucht hat, und Paul bekommt eine Tasse Tee.“"
                                            },
                                            {
                                                "example_id": "d98eab69-a2a9-49fb-a44b-f789b3d35e99",
                                                "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                                "text": "„Den Leichnam hatte man inzwischen entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7786dbee-823c-4924-96e2-26b56fabc216",
                        "source_entry_id": "37b476a5-1e8e-310b-95bb-7ca973a2f8d3",
                        "source_sense_id": "d6445cbf-0ed0-332a-b105-c63591fcad52",
                        "source_sense_description": "in de tussentijd",
                        "target_lang_word": "mittlerweile",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mittlerweile",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07444a27-5a49-3329-b1ac-d05cc2775197",
                                        "entry_id": "9a8b6709-0a05-33b4-b9a8-9199968cd01c",
                                        "glosses": [
                                            "in der Zwischenzeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0041efe7-a94f-476b-870e-7075747c71d4",
                                                "sense_id": "07444a27-5a49-3329-b1ac-d05cc2775197",
                                                "text": "Mittlerweile ist es uns gelungen, das Rätsel zu lösen."
                                            },
                                            {
                                                "example_id": "8bc4e8b6-034a-4c34-8126-84d99c112621",
                                                "sense_id": "07444a27-5a49-3329-b1ac-d05cc2775197",
                                                "text": "„Mittlerweile in Rente, gab sie sich reiselustig in ihrem Trabi.“"
                                            },
                                            {
                                                "example_id": "741ab9fa-c59a-43a8-a7cb-a898686dcf2b",
                                                "sense_id": "07444a27-5a49-3329-b1ac-d05cc2775197",
                                                "text": "„Mittlerweile war es ein offenes Geheimnis, dass sie die Pest an Bord hatten.“"
                                            },
                                            {
                                                "example_id": "5019b5dd-cde6-40e2-8319-23775c54ff37",
                                                "sense_id": "07444a27-5a49-3329-b1ac-d05cc2775197",
                                                "text": "„Solche und ähnliche Erlebnisse führen - für mich mittlerweile nachvollziehbar - viele Frauen zu der todernst gemeinten Aussage, dass sie ohne ihre Wärmflasche nicht leben könnten!“"
                                            },
                                            {
                                                "example_id": "a26d34a3-6154-4799-b1ef-c2126d98bc39",
                                                "sense_id": "07444a27-5a49-3329-b1ac-d05cc2775197",
                                                "text": "„Er freut sich, dass sich endlich mal jemand für ihn interessiert, aber er will nicht mehr erzählen, weil sich mittlerweile eine neugierige Menschentraube um uns gebildet hat.“"
                                            },
                                            {
                                                "example_id": "eb4150c8-459d-4233-9cca-bb0964f25d00",
                                                "sense_id": "07444a27-5a49-3329-b1ac-d05cc2775197",
                                                "text": "„Laut Berichten der Vereinten Nationen galten in den 1970er-Jahren rund zehn Prozent der weltweiten Fischbestände als überfischt. Mittlerweile sind es rund 30 Prozent.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95eca157-d578-4110-9ab0-4882a08398ad",
                        "source_entry_id": "37b476a5-1e8e-310b-95bb-7ca973a2f8d3",
                        "source_sense_id": "d6445cbf-0ed0-332a-b105-c63591fcad52",
