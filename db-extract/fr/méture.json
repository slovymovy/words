                        "entry_id": "5b1c3d6f-271f-335a-b566-40ed0e45275e",
                        "glosses": [
                            "Pain fabriqué avec de la farine de maïs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4904670e-99f5-4f85-a7f3-32cc62878ced",
                                "sense_id": "455d5745-0851-3393-b631-a997b4377649",
                                "text": "Elle avait coupé une tranche de méture et la trempait dans le bol de lait qu’elle tenait serré entre ses deux genoux."
                            },
                            {
                                "example_id": "04c92422-c3a4-4498-acc3-04ba6c29c239",
                                "sense_id": "455d5745-0851-3393-b631-a997b4377649",
                                "text": "La méture, ce pain fabriqué à base de farine de maïs, à la fois gâteau et pain campagnard que les fermières fabriquaient à la maison avec le fruit de leur récolte, revient à Salies de Béarn."
                            }
                        ]
                    },
                    {
                        "sense_id": "476940df-17b1-3785-964e-8eeb74ece17f",
                        "entry_id": "5b1c3d6f-271f-335a-b566-40ed0e45275e",
                        "glosses": [
                            "Bouillie de maïs additionnée d’œufs et lamelles de jambon cru."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69daeaac-379f-4217-b833-a028acf052c6",
                                "sense_id": "476940df-17b1-3785-964e-8eeb74ece17f",
                                "text": "Dans le pays basque et le Béarn, la méture est une bouillie de maïs additionnée d’œufs, dans laquelle on incorpore des lamelles de jambon cru."
                            }
                        ]
                    }
