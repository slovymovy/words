                            "unsinniges Tun"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d165e9c1-a513-4545-99b2-9d16438d6052",
                                "sense_id": "0c032262-7f3e-3928-831c-7b0571a59a07",
                                "text": "Das ist doch Larifari, was ihr hier macht! Macht es ordentlich oder lasst es!"
                            },
                            {
                                "example_id": "13ec608e-82fd-4f52-bee6-8c1e58ebc298",
                                "sense_id": "0c032262-7f3e-3928-831c-7b0571a59a07",
                                "text": "„Schluss mit Larifari, ich lass all die alten Faxen sein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
