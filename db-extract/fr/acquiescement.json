                "senses": [
                    {
                        "sense_id": "f26a8f20-21a6-359f-9037-645e3ad0d486",
                        "entry_id": "47e9110e-0066-32cb-9d11-66fc6cd28d01",
                        "glosses": [
                            "Action d’acquiescer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85e50052-8c51-43c3-9342-7a17d129efe0",
                                "sense_id": "f26a8f20-21a6-359f-9037-645e3ad0d486",
                                "text": "Un entier acquiescement aux volontés de quelqu’un."
                            },
                            {
                                "example_id": "4f238908-9b3b-42ec-9423-522cb8030f42",
                                "sense_id": "f26a8f20-21a6-359f-9037-645e3ad0d486",
                                "text": "Acquiescement à la volonté de Dieu."
                            },
                            {
                                "example_id": "85c6a2e6-1817-4712-93e7-8293a54df534",
                                "sense_id": "f26a8f20-21a6-359f-9037-645e3ad0d486",
                                "text": "On ne peut refuser son acquiescement à une proposition si bien démontrée."
                            },
                            {
                                "example_id": "1c07423b-f2e2-4e81-8c0c-d4481ad425c5",
                                "sense_id": "f26a8f20-21a6-359f-9037-645e3ad0d486",
                                "text": "L'acquiescement est une manière passive de donner son assentiment ou son accord lorsque l'employeur ou l'employé initie, sans l'approbation de l'autre, un changement dans les conditions d'emploi."
                            }
                        ]
                    }
                ],
