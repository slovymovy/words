{
    "word_family": [
        "необходимый",
        "необходимость"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7dcb04be-92e0-3822-9c7c-01521af1735e",
                    "sense_definition": "Нужно, требуется; следует сделать (используется как сказуемое в безличных предложениях).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ему срочно <необходимо> вернуться домой.",
                            "target_lang_translations": {
                                "en": "He urgently <needs to> return home.",
                                "zh": "他急需<w>返回</w>家中。"
                            }
                        },
                        {
                            "text": "Нам <необходимо> купить продукты на ужин.",
                            "target_lang_translations": {
                                "en": "We <need to> buy groceries for dinner.",
                                "zh": "我们<w>需要</w>买些晚餐用的食材。"
                            }
                        }
                    ],
                    "synonyms": [
                        "надо",
                        "нужно"
                    ],
                    "common_phrases": [
                        "крайне необходимо",
                        "жизненно необходимо",
                        "просто необходимо"
                    ],
                    "target_lang_definitions": {
                        "en": "It is needed, required; something should be done (used as a predicate in impersonal sentences).",
                        "zh": "表示需要、必须或应当做某事（用于无主句作谓语）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "necessary",
                                "target_lang_sense_clarification": "often used in 'it is necessary'"
                            },
                            {
                                "target_lang_word": "need to",
                                "target_lang_sense_clarification": "expressing obligation or requirement"
                            },
                            {
                                "target_lang_word": "must",
                                "target_lang_sense_clarification": "strong necessity"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "需要",
                                "target_lang_sense_clarification": "表示有某种需求或必要性"
                            },
                            {
                                "target_lang_word": "必须",
                                "target_lang_sense_clarification": "表示强烈的必要性或义务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28d931c5-fbd0-3e4e-91a2-8e7740ca5fbe",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>необходимый</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это условие <необходимо> для вступления закона в силу.",
                            "target_lang_translations": {
                                "en": "This condition is <necessary> for the law to take effect.",
                                "zh": "这是法律生效的<w>必要</w>条件。"
                            }
                        },
                        {
                            "text": "Ваше присутствие на собрании <необходимо>.",
                            "target_lang_translations": {
                                "en": "Your presence at the meeting is <necessary>.",
                                "zh": "你出席会议是<w>必要</w>的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form neuter singular of the adjective 'necessary'.",
                        "zh": "形容词“必要的”的短尾中性单数形式，表示不可或缺的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "necessary",
                                "target_lang_sense_clarification": "required or essential quality"
                            },
                            {
                                "target_lang_word": "essential",
                                "target_lang_sense_clarification": "absolutely necessary"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "必要",
                                "target_lang_sense_clarification": "指不可缺少或必须具备的"
                            },
                            {
                                "target_lang_word": "必需",
                                "target_lang_sense_clarification": "指一定要有的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "4c478e61-ee01-3813-b396-f0031942b9e5",
                    "sense_definition": "Обязательно, неизбежно; таким образом, что иначе быть не может.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Следствие <необходимо> вытекает из причины.",
                            "target_lang_translations": {
                                "en": "The consequence <necessarily> follows from the cause.",
                                "zh": "结果<w>必然</w>由原因引起。"
                            }
                        },
                        {
                            "text": "Это решение <необходимо> повлечет за собой изменения в структуре компании.",
                            "target_lang_translations": {
                                "en": "This decision will <necessarily> entail changes in the company structure.",
                                "zh": "这一决定<w>必定</w>会引发公司结构的变化。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "необходимо следует"
                    ],
                    "target_lang_definitions": {
                        "en": "Necessarily, inevitably; in such a way that it cannot be otherwise.",
                        "zh": "必然地、不可避免地；指事物发展的逻辑结果。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "necessarily",
                                "target_lang_sense_clarification": "as a logical consequence"
                            },
                            {
                                "target_lang_word": "inevitably",
                                "target_lang_sense_clarification": "unavoidably"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "必然",
                                "target_lang_sense_clarification": "指事理上确定不移"
                            },
                            {
                                "target_lang_word": "必定",
                                "target_lang_sense_clarification": "表示肯定会发生"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}