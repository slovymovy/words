                        "source_entry_id": "f5832900-69dc-3c27-a3ca-b94dc02f8d09",
                        "source_sense_id": "263a7d13-be88-317d-9e64-43d2d4d26512",
                        "target_lang_word": "defrocked priest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
