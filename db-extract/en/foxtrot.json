                                "target_senses": [
                                    {
                                        "sense_id": "f1803997-9437-3a3d-b1bd-5289229168e2",
                                        "entry_id": "1b51c6c0-c8c4-3f0d-b755-464e5063652c",
                                        "glosses": [
                                            "taniec towarzyski w rytmie 4/4 (cztery czwarte)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38e92045-15e5-4db2-b06e-a7fde7f91a4d",
                                                "sense_id": "f1803997-9437-3a3d-b1bd-5289229168e2",
                                                "text": "Choć Maria nie umie tańczyć walca, w fokstrocie jest prawdziwą mistrzynią."
                                            }
