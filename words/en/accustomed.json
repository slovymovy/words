    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "95db888a-b56f-3a1d-9129-6e5f4a5c8f31",
                    "sense_definition": "Familiar with something through repeated experience; adapted or used to specific conditions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She quickly became <w>accustomed</w> to the cold weather in her new city.",
                            "target_lang_translations": {
                                "ru": "Она быстро <w>привыкла</w> к холодной погоде в своем новом городе."
                            }
                        },
                        {
                            "text": "He was <w>accustomed</w> to working late into the night.",
                            "target_lang_translations": {
                                "ru": "Он <w>привык</w> работать до поздней ночи."
                            }
                        }
                    ],
                    "synonyms": [
                        "habituated",
                        "inured",
                        "used"
                    ],
                    "common_phrases": [
                        "accustomed to working",
                        "accustomed to cold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знакомый с чем-либо благодаря повторяющемуся опыту; привыкший к определенным условиям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привыкший",
                                "target_lang_sense_clarification": "к определенным условиям или действиям"
                            },
                            {
                                "target_lang_word": "приученный",
                                "target_lang_sense_clarification": "сформировавший привычку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de9fcb40-f61d-3642-9aa1-3eedad1441ec",
                    "sense_definition": "Usual, traditional, or customary for a particular person, place, or situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She greeted the guests with her <w>accustomed</w> warmth and generous smile.",
                            "target_lang_translations": {
                                "ru": "Она встретила гостей со своей <w>привычной</w> теплотой и щедрой улыбкой."
                            }
                        },
                        {
                            "text": "He took his <w>accustomed</w> place at the head of the dinner table.",
                            "target_lang_translations": {
                                "ru": "Он занял свое <w>привычное</w> место во главе обеденного стола."
                            }
                        }
                    ],
                    "synonyms": [
                        "wonted"
                    ],
                    "common_phrases": [
                        "accustomed place",
                        "accustomed warmth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обычный, традиционный или привычный для конкретного человека, места или ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привычный",
                                "target_lang_sense_clarification": "обычный, традиционный"
                            },
