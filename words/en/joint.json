                                "target_lang_word": "месте́чко",
                                "target_lang_sense_clarification": "разговорное, приятное место"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小店",
                                "target_lang_sense_clarification": "非正式的餐饮场所"
                            },
                            {
                                "target_lang_word": "场所",
                                "target_lang_sense_clarification": "泛指某处地点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fe36896-bb5d-3220-9836-e40b4afcf048",
                    "sense_definition": "A rolled cigarette containing marijuana.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "drug_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teenagers were caught smoking a <w>joint</w> behind the school gym.",
                            "target_lang_translations": {
                                "ru": "Подростков поймали за курением <w>косяка</w> за школьным спортзалом.",
                                "zh": "几个青少年在学校体育馆后面抽<w>大麻烟卷</w>时被抓住了。"
                            }
                        },
                        {
                            "text": "He learned how to roll a <w>joint</w> while he was at the party.",
                            "target_lang_translations": {
                                "ru": "Он научился скручивать <w>косяк</w>, пока был на вечеринке.",
                                "zh": "他在派对上学会了怎么卷<w>大麻烟卷</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spliff",
                        "reefer",
                        "doobie"
                    ],
                    "common_phrases": [
                        "roll a joint",
                        "smoke a joint"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "drug culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самокрутка с марихуаной.",
                        "zh": "卷好的大麻烟卷。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кося́к",
                                "target_lang_sense_clarification": "сленг"
