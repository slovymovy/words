                    {
                        "translation_id": "ad52c623-8fc7-429a-97be-e9720b3efff4",
                        "source_entry_id": "df6908a3-f007-302c-85b9-e12b6f31e991",
                        "target_lang_word": "Pazifismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pazifismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85c9ab73-2d4e-3a49-963a-a99d45ca768a",
                                        "entry_id": "9c5f87e9-140c-33ad-a8a2-ad8082440fe7",
                                        "glosses": [
                                            "die Ideologie, die sich für den Frieden einsetzt und den Krieg und die Gewalt ablehnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df0f34cf-b1e2-4a7e-bacd-e9f166bf15de",
                                                "sense_id": "85c9ab73-2d4e-3a49-963a-a99d45ca768a",
                                                "text": "„Wir müssen unsere Kinder gegen Militarismus impfen, indem wir sie im Geiste des Pazifismus erziehen.“"
                                            },
                                            {
                                                "example_id": "c50f5309-cfb5-4b21-ad6c-026bcadd184b",
                                                "sense_id": "85c9ab73-2d4e-3a49-963a-a99d45ca768a",
                                                "text": "„In Zürich hat Einstein bei einem Freund des Vaters, Gustav Maier, Unterstützung für seinen frühentwickelten Pazifismus gefunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6eac71d-6956-4b63-a706-0a3d6d32b208",
                        "source_entry_id": "df6908a3-f007-302c-85b9-e12b6f31e991",
                        "target_lang_word": "pacifisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pacifisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c43e316d-b141-3b0a-8e58-452f44a744b2",
                                        "entry_id": "cf611b0e-4b07-32fe-be0a-6ad23417b5c8",
                                        "glosses": [
                                            "een wereldbeschouwing die duurzame vrede nastreeft en tegen oorlog en geweld is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0536c206-9023-4169-b090-d390b48d62cb",
                                                "sense_id": "c43e316d-b141-3b0a-8e58-452f44a744b2",
                                                "text": "‘De berichten over de brandhaarden in Berkeley kwamen heel snel binnen en Amerika interesseerde ons bijzonder. Het militarisme van de Verenigde Staten in Vietnam lokte veel protest uit. Een nieuw type pacifisme begon zich te manifesteren. In Berlijn wilden studenten een nieuw soort oppositie, en niet volgens het parlementaire systeem. Je had geen Facebook nodig om dat proces zich te zien verspreiden.’"
                                            },
                                            {
                                                "example_id": "92937af9-07bd-4776-9ab0-6dc4fc746b42",
                                                "sense_id": "c43e316d-b141-3b0a-8e58-452f44a744b2",
                                                "text": "De musical vertelt het verhaal van de provinciaal Claude, die naar New York afreist om zijn dienstplicht te vervullen, lees: te sneuvelen in Vietnam. In de grote stad loopt hij de hippies tegen het lijf, kolkend van rebellie, vrijheidsdrang, pacifisme en navelstaarderij, die hem de Age of Aquarius binnenvoeren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
