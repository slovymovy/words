                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90e085f3-0050-33a7-838f-e2288d29a38c",
                                        "entry_id": "2bb72a07-6145-373c-8f09-2529f3be4387",
                                        "glosses": [
                                            "A recognizable natural or man-made feature used for navigation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ec822b2-6030-462e-a53b-b6b012cab7a7",
                                                "sense_id": "90e085f3-0050-33a7-838f-e2288d29a38c",
                                                "text": "Anyone have any weird landmarks they often remember seeing along roads in the olden days?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a9b55f5-72e9-3967-a3a7-47f22cb0cbdd",
                                        "entry_id": "2bb72a07-6145-373c-8f09-2529f3be4387",
                                        "glosses": [
                                            "A notable location with historical, cultural, or geographical significance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24d37989-67af-39cf-86b2-7157810bb6e7",
                                        "entry_id": "2bb72a07-6145-373c-8f09-2529f3be4387",
                                        "glosses": [
                                            "A major event or discovery."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bba19cf-49cd-4320-8e14-76b5aa942bf4",
                                                "sense_id": "24d37989-67af-39cf-86b2-7157810bb6e7",
                                                "text": "an important landmark in human history"
                                            },
                                            {
                                                "example_id": "6a18df78-d67a-4216-a302-f20e2ede3e1c",
                                                "sense_id": "24d37989-67af-39cf-86b2-7157810bb6e7",
                                                "text": "a landmark paper in neurosurgery"
                                            },
                                            {
                                                "example_id": "7bbdad6a-69fc-47df-8664-8e54eed990b2",
                                                "sense_id": "24d37989-67af-39cf-86b2-7157810bb6e7",
                                                "text": "a landmark ruling/case"
                                            },
                                            {
                                                "example_id": "84fc5315-18c3-4eb8-afb5-9f5eaddea8e7",
                                                "sense_id": "24d37989-67af-39cf-86b2-7157810bb6e7",
                                                "text": "He called the overthrow of Iraqi dictator Saddam Hussein and the recent elections in Afghanistan landmark events in the history of liberty."
                                            },
                                            {
                                                "example_id": "56caf902-ebf7-485f-bcf8-cd4747d643ec",
                                                "sense_id": "24d37989-67af-39cf-86b2-7157810bb6e7",
                                                "text": "Leicester closed out the win to spark emotional scenes as those inside Wembley rejoiced in a landmark victory."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "landmark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d2470b4-ccb5-3c9d-80e4-18b53d60a5f3",
                                        "entry_id": "b07c86af-5197-3a25-bab6-cc3b06f1b4ba",
                                        "glosses": [
                                            "To officially designate a site or building as a landmark."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa54efcb-a8b8-45e2-ba5b-5cf966790408",
                                                "sense_id": "1d2470b4-ccb5-3c9d-80e4-18b53d60a5f3",
                                                "text": "St Mary's Church stands on the north side of the village, a building of flint and stone with a 140 ft high steeple that landmarks one of the most beautiful churches in Suffolk."
                                            },
                                            {
                                                "example_id": "ff805871-6c70-47ba-bef3-23bdde7a5ac5",
                                                "sense_id": "1d2470b4-ccb5-3c9d-80e4-18b53d60a5f3",
                                                "text": "“Permitted demolition or stripping rarely occurs on landmarked buildings,” she said. Ms. de Bourbon also noted that the city already requires the Buildings Department to hold permits for 40 days for “calendared” properties — those currently under landmarks consideration — so the commission has a chance to designate them."
