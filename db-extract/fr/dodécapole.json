                        "examples": [
                            {
                                "example_id": "fbd1f601-f3bf-4ff0-9389-41fe24e51778",
                                "sense_id": "74e997b7-89eb-3c62-9c31-81e33ef9e44d",
                                "text": "La dodécapole étrusque et la dodécapole ionienne."
                            },
                            {
                                "example_id": "4f1fddc3-49c2-4de6-b917-b418e3e06382",
                                "sense_id": "74e997b7-89eb-3c62-9c31-81e33ef9e44d",
                                "text": "L’existence d’une dodécapole, d’un groupement de douze cités, n’est d'ailleurs pas inconnue des Grecs, mais c’est vers la Grèce d’Asie qu’il faut alors nous tourner: il y avait en effet en Asie Mineure, au VIᵉ siècle av. notre ère, une dodécapole ionienne qui comprenait des cités aussi importantes que Phocée, Smyrne, Éphèse ou Milet."
                            }
                        ]
