                                        ],
                                        "examples": [
                                            {
                                                "example_id": "449b012a-7fb4-479c-9b6c-91f4a35ab73d",
                                                "sense_id": "b71510f7-a0bb-38e1-8c1f-cd482044787c",
                                                "text": "Along with the island’s 3,000 other Japanese American residents, she celebrated Japanese holidays; learned the art of flower arranging, ikebana; and wore kimonos."
