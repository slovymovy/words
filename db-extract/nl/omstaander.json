                    {
                        "sense_id": "9b110879-6965-38f0-b077-18fad61bcce1",
                        "entry_id": "d90a3a23-3bd4-3813-8af7-881e771718d4",
                        "glosses": [
                            "iemand die ergens getuige van is zonder aan de handeling deel te nemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5272f5ff-f0a8-446c-b0c5-f4d55d4138bd",
                                "sense_id": "9b110879-6965-38f0-b077-18fad61bcce1",
                                "text": "Door de klap was de auto op zijn kant komen te staan. Omstaanders duwden de wagen terug op zijn vier wielen waarop ik minstens twee inzittenden zag uitstappen en heb zien vluchten."
                            },
                            {
                                "example_id": "809382da-031d-48f6-b76b-f03c602ec1a9",
                                "sense_id": "9b110879-6965-38f0-b077-18fad61bcce1",
                                "text": "Ook de omstaanders konden om de situatie lachen. \"Veel geluk om dit uit te leggen aan je verzekeringsmaatschapij\" [sic!], grapte een omstaander."
                            },
                            {
                                "example_id": "81cb9bb4-35a3-468b-8d32-0dd60ee24da5",
                                "sense_id": "9b110879-6965-38f0-b077-18fad61bcce1",
                                "text": "De videobeelden van de heroïsche tussenkomst van Rogers, die overigens bijval kreeg van een andere omstaander, gingen meteen na het incident het hele internet over. Internetgebruikers prezen hem voor zijn moed en gaven hem de bijnaam \"trolley man\"."
                            }
                        ]
                    }
                ],
