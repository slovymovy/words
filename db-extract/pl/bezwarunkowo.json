                                "target_senses": [
                                    {
                                        "sense_id": "3709d82a-1333-398a-9ea2-6fe3e1557641",
                                        "entry_id": "53f78d81-549a-3927-913d-cab400b55a47",
                                        "glosses": [
                                            "D'une manière inconditionnelle ; sans condition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6af1e2c-c383-474e-a28d-250316cbf661",
                                                "sense_id": "3709d82a-1333-398a-9ea2-6fe3e1557641",
                                                "text": "Le banquier peut opter inconditionnellement entre la contre-passation et l'action cambiaire, et cela même en cas de faillite de son client."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f50f1e7-89f0-4be3-b2f0-3deece3c2d55",
                        "source_entry_id": "81a39a3b-6994-375e-8e76-0a369933a1c9",
                        "source_sense_id": "2fb0daa0-d103-3fdd-8d76-0a895b458f42",
