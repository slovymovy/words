                "senses": [
                    {
                        "sense_id": "ba8d735d-c21e-3699-a5ba-ffbfc517ee54",
                        "entry_id": "448194d3-9adc-3d3b-bc3d-30263041882a",
                        "glosses": [
                            "Prescrire excessivement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef141b0b-0880-4419-94ba-9638227b22b3",
                                "sense_id": "ba8d735d-c21e-3699-a5ba-ffbfc517ee54",
                                "text": "Les femmes seraient davantage sur-prescrites en psychotropes."
                            },
                            {
                                "example_id": "24a431dd-2309-4431-a559-398485525c9f",
                                "sense_id": "ba8d735d-c21e-3699-a5ba-ffbfc517ee54",
                                "text": "Optimiser les traitements c'est donc, dans le meilleur sens du terme, éviter de sur-prescrire, mais aussi de sous-prescrire."
                            },
                            {
                                "example_id": "e6f43b0a-c482-4eed-a61a-3abcaa4b3ba4",
                                "sense_id": "ba8d735d-c21e-3699-a5ba-ffbfc517ee54",
                                "text": "le médicament est sur-prescrit et surconsommé dans notre pays et les règles de l'expertise sont à moderniser."
                            }
                        ]
                    }
