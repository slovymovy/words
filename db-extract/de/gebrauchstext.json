                "senses": [
                    {
                        "sense_id": "d864f4b3-92f7-30af-b6d4-5716124ea0da",
                        "entry_id": "6114d744-09fc-3e1c-8b03-c3d3616de21a",
                        "glosses": [
                            "Text, der der Bewältigung des Lebens dient, ohne dabei gezielt literarische Ansprüche erfüllen zu wollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa74bc24-d78f-4607-830d-56022d5b189b",
                                "sense_id": "d864f4b3-92f7-30af-b6d4-5716124ea0da",
                                "text": "„Aus diesem Grund sind vor allem Gebrauchstexte als Materialgrundlage herangezogen worden.“"
                            },
                            {
                                "example_id": "2f5ec9f4-9ae3-4aec-9146-489042afd843",
                                "sense_id": "d864f4b3-92f7-30af-b6d4-5716124ea0da",
                                "text": "„Für die aschkenasischen Juden waren Bibel- und Talmudkommentare in erster Hinsicht Gebrauchstexte.“"
                            },
                            {
                                "example_id": "196d5f30-8d64-43b0-8ee9-df26954fea5b",
                                "sense_id": "d864f4b3-92f7-30af-b6d4-5716124ea0da",
                                "text": "„Nach der römischen Eroberung schrieben die Kelten überall lateinisch, doch eben nur Gebrauchstexte: Verträge, Grab- und Bauinschriften, Kalender.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
