                        "glosses": [
                            "Caractère de ce qui est gnangnan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4d0608a-d254-4c64-8486-9b967f166b56",
                                "sense_id": "b6977280-1ab8-3ece-a9f8-0d05d6026016",
                                "text": "La barbe, avec ce gnangnantisme sublime et cette espèce de philosophicaillerie dont la jeunesse se veut atteinte."
                            },
                            {
                                "example_id": "9af4d6a4-11ef-4e29-aadb-18df9376c540",
                                "sense_id": "b6977280-1ab8-3ece-a9f8-0d05d6026016",
                                "text": "Et ni la révolution, ni la drogue, ni la pop ne m’amusent. Quitte à devenir imbécile, méchant, puritain, satisfait, renfermé, hypocrite, despotique, intolérant, conjugaliste, analphabète, yeux crevés, tympans morts, bouche flasque, je préférerais l’être franchement que de tartiner tout cela de gnangnantisme libertaire."
                            }
                        ]
                    }
