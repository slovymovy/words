                        ],
                        "examples": [
                            {
                                "example_id": "43db50b9-95d2-4a1e-b1c6-8280028b0c6e",
                                "sense_id": "bf88a7dc-8d9c-3306-963d-a5f98e0061ae",
                                "text": "The great thing about mowing is that it is visually satisfying; with each overlapping pass, one more swath is shorn, and where there was once scraggliness and unkemptness, now there is neatness and trimness."
                            },
                            {
                                "example_id": "e35c7eff-b8fa-47b6-932b-eca2868b639a",
                                "sense_id": "bf88a7dc-8d9c-3306-963d-a5f98e0061ae",
                                "text": "Ditto for Uma Thurman, whose loose blonde strands were defiant in their scraggliness. Your mother would have called this kind of hair a bird's nest."
                            },
                            {
                                "example_id": "163b9b4d-f310-4619-9c60-c4f0620b3858",
                                "sense_id": "bf88a7dc-8d9c-3306-963d-a5f98e0061ae",
                                "text": "He was dressed casually, expensively, a contrast to his older brother's ragged, threadbare clothes and general scraggliness."
                            }
                        ]
                    }
