                        "examples": [
                            {
                                "example_id": "779ddf99-7279-4fc1-a438-57f795af8ab7",
                                "sense_id": "eb64dd99-42ea-3c7f-816b-689bedb00e31",
                                "text": "Il lui montrait ce qu’il voulait qu’on lui mette dans son assiette – en général, c’était un steak, du jambon, du poulet, des galettes de maïs, des patates douces, des beignets d’okras, des tomates avec un oignon et des œufs – plus une part de soufflé à la banane."
                            },
                            {
                                "example_id": "f3ed01f0-190d-4b92-8e0e-db29650f6e99",
                                "sense_id": "eb64dd99-42ea-3c7f-816b-689bedb00e31",
                                "text": "Les Égyptiens furent les premiers à cultiver l’okra, qui poussait à l’état sauvage sur les rives du Nil."
                            },
                            {
                                "example_id": "5f3a2f28-6e12-4dc6-ba64-d98290bfc41a",
                                "sense_id": "eb64dd99-42ea-3c7f-816b-689bedb00e31",
                                "text": "« Il y avait des jardins partout ! poursuit Robert, avec ses yeux rieurs et pétillants. On faisait pousser des beans, des patates, des okras, ça plantait, partout ! »"
                            }
                        ]
                    }
