                "senses": [
                    {
                        "sense_id": "ff475b82-fc6b-31f2-a7a6-09b76b211957",
                        "entry_id": "decc98e5-aa5b-3075-9475-d4f2d4e401c5",
                        "glosses": [
                            "Entnahme einer Probe (Abstrich) aus dem Hals (Rachen); die so entnommene Probe"
                        ],
                        "tags": [
                            "Diagnostik",
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "d49d0129-8c47-4812-bc16-eea3c7da7c3a",
                                "sense_id": "ff475b82-fc6b-31f2-a7a6-09b76b211957",
                                "text": "„Für den Tierarzt ist es wichtig, alles über Krankheitssymptome und deren Beginn, Impfstatus und möglichen Kontakt zu anderen Katzen zu erfahren. Ein direkter Erregernachweis aus einem Rachenabstrich ist sowohl bei den Viren (FHVI, FCV) als auch bei den Bakterien möglich und kann der Unterstützung der klinischen Diagnose und als Endscheidungshilfe für den Therapieplan dienen.“"
                            },
                            {
                                "example_id": "cca21b21-8d45-4874-b0d7-8fe36039549c",
                                "sense_id": "ff475b82-fc6b-31f2-a7a6-09b76b211957",
                                "text": "„Das Team verglich die PCR-Ergebnisse von Rachenabstrichen mit solchen aus Sputum oder Stuhlproben von 133 COVID-19-Patienten. 22 der Teilnehmer wiesen initial oder im Follow-up trotz negativem Rachenabstrich positive Sputum- bzw. Stuhlproben auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
