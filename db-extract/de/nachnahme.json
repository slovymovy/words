                ],
                "senses": [
                    {
                        "sense_id": "3ead6df2-f4b5-398e-9e54-4988f9decca7",
                        "entry_id": "e628ea48-3b20-3a05-89e8-9cb41b586766",
                        "glosses": [
                            "Postwesen, kurz für: Nachnahmesendung, Versendung von Waren, bei der der Adressat die Waren beim Empfang an das Postunternehmen bezahlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "859fc038-635a-46a7-adc5-fa3ec2261a69",
                                "sense_id": "3ead6df2-f4b5-398e-9e54-4988f9decca7",
                                "text": "Die Zahlung erfolgt per Nachnahme."
                            },
                            {
                                "example_id": "11679361-c0d0-495b-b962-38a3e90a8073",
                                "sense_id": "3ead6df2-f4b5-398e-9e54-4988f9decca7",
                                "text": "Die Nachnahme ist kostenintensiv, da Nachnahmegebühren fällig werden."
                            },
                            {
                                "example_id": "62a80889-757b-46f2-9dfc-3edd24613751",
                                "sense_id": "3ead6df2-f4b5-398e-9e54-4988f9decca7",
                                "text": "„Eines Tages während einer Bahnfahrt wurde mir ohne jeden Anlass plötzlich klar, dass eigentlich jede Postsendung per Nachname geschickt wird, aber noch lange nicht jede per Nachnahme.“"
                            },
                            {
                                "example_id": "9af3ede9-0e1f-4122-90e1-6396732f5107",
                                "sense_id": "3ead6df2-f4b5-398e-9e54-4988f9decca7",
                                "text": "„Für den zivilen Konsum wurde dagegen kaum mehr hergestellt, und wenn, dann nur gegen Vorkasse oder Nachnahme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a658571-134e-4c05-9102-0d4106e1f863",
                        "source_entry_id": "e628ea48-3b20-3a05-89e8-9cb41b586766",
                        "source_sense_id": "3ead6df2-f4b5-398e-9e54-4988f9decca7",
                        "source_sense_description": "Postwesen: Nachnahmesendung, Versendung von Waren, bei der der Adressat die Waren beim Empfang an das Postunternehmen bezahlt",
                        "target_lang_word": "collect on delivery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bf5cd931-0367-45cd-9f53-b1b0b4ff7093",
                        "source_entry_id": "e628ea48-3b20-3a05-89e8-9cb41b586766",
                        "source_sense_id": "3ead6df2-f4b5-398e-9e54-4988f9decca7",
                        "source_sense_description": "Postwesen: Nachnahmesendung, Versendung von Waren, bei der der Adressat die Waren beim Empfang an das Postunternehmen bezahlt",
                        "target_lang_word": "remboursement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remboursement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cc14851-e3a0-3bf0-8947-c0f0d44ab21b",
                                        "entry_id": "b03a0f3c-7aad-3ab9-8e92-ff925c0ef23a",
                                        "glosses": [
                                            "Action de rembourser, paiement qui se fait pour rendre une somme que l’on doit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef0efc3c-55d9-414c-b6ce-6c53ea03af44",
                                                "sense_id": "4cc14851-e3a0-3bf0-8947-c0f0d44ab21b",
                                                "text": "Vainement avaient-ils stipulé qu'on ne pourrait les rembourser qu'en écus ; il n'en fallait pas moins qu'ils reçussent leur remboursement en assignats."
                                            },
                                            {
                                                "example_id": "8315440a-0b8d-47ab-8ccb-5218c8f9372b",
                                                "sense_id": "4cc14851-e3a0-3bf0-8947-c0f0d44ab21b",
                                                "text": "Vers 1932, les banquiers commencèrent à redouter l'insolvabilité permanente des fermiers. Prenant peur, ils exigèrent le remboursement ou la saisie des gages."
                                            },
                                            {
                                                "example_id": "9278b2d4-c0f3-4f87-94e3-1f0311143cf6",
                                                "sense_id": "4cc14851-e3a0-3bf0-8947-c0f0d44ab21b",
                                                "text": "Des créanciers qui réclament le remboursement de leurs dettes excitent toujours les rancœurs de leurs débiteurs."
                                            },
                                            {
                                                "example_id": "9b0a47bc-2484-4687-82ab-640e2a815450",
                                                "sense_id": "4cc14851-e3a0-3bf0-8947-c0f0d44ab21b",
                                                "text": "Le coulage consiste à faire faire des travaux qui ne sont pas urgents ou nécessaires, à dégalonner et regalonner les troupes, à commander des vaisseaux sans s’inquiéter s’il y a du bois et de payer alors le bois trop cher, à se préparer à la guerre sans la faire, à payer les dettes d’un État sans lui en demander le remboursement ou des garanties, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
