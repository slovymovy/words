                "senses": [
                    {
                        "sense_id": "55fc3e8b-f4a1-3c62-bb63-31c07c708626",
                        "entry_id": "e132c83d-d031-349c-a0ba-d0b419153562",
                        "glosses": [
                            "eine mit offensichtlichen Komplexen beladene Person"
                        ],
                        "tags": [
                            "Austrian German",
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "7f9778ea-b8e2-42f8-b37f-52dc75981546",
                                "sense_id": "55fc3e8b-f4a1-3c62-bb63-31c07c708626",
                                "text": "„Die Einsicht kommt spät: „Ich bin ein Komplexler. Ich wollte mir Respekt verschaffen“, sagt der 54-jährige Polizist.“"
                            },
                            {
                                "example_id": "12138553-58a0-475a-bb53-c5ab9ed50cf9",
                                "sense_id": "55fc3e8b-f4a1-3c62-bb63-31c07c708626",
                                "text": "„Komplexler treffen einander im gegenüberliegenden Beisl.“"
                            },
                            {
                                "example_id": "11145715-8fae-40c4-85cb-a4a60fddb3f6",
                                "sense_id": "55fc3e8b-f4a1-3c62-bb63-31c07c708626",
                                "text": "„So ein Mensch wird dann im Volksmund als Komplexler bezeichnet, eine Person, die an einem Komplex leidet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
