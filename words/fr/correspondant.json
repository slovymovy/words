{
    "word_family": [
        "correspondance",
        "correspondre"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ec73ec63-06e9-35a9-9b09-4412be4266ef",
                    "sense_definition": "Qui est en relation, en conformité ou qui a un rapport direct avec quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relation_adjective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veuillez cocher la case <w>correspondante</w> à votre situation familiale sur le formulaire."
                        },
                        {
                            "text": "Il faut appliquer le tarif <w>correspondant</w> à la taille exacte de votre colis."
                        }
                    ],
                    "synonyms": [
                        "équivalent",
                        "approprié",
                        "conforme"
                    ],
                    "common_phrases": [
                        "case correspondante",
                        "période correspondante",
                        "montant correspondant"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c9f32b5-925f-3715-9d90-caa2dd99019d",
                    "sense_definition": "Personne avec laquelle on échange des lettres ou des messages, souvent dans le cadre d'un échange linguistique ou scolaire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "person_exchange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ma sœur écrit chaque semaine à sa <w>correspondante</w> espagnole pour progresser."
                        },
                        {
                            "text": "Nous allons accueillir mon <w>correspondant</w> allemand pendant les vacances de printemps."
                        }
                    ],
                    "common_phrases": [
                        "correspondant étranger",
                        "correspondant scolaire"
                    ]
                },
                {
                    "sense_id": "31e4994d-b08b-38ca-a09b-c2315339d479",
                    "sense_definition": "Journaliste basé dans une région ou un pays étranger pour transmettre des informations régulières à sa rédaction.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "journalism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journal interroge son <w>correspondant</w> sur place pour comprendre l'évolution du conflit."
                        },
                        {
                            "text": "Elle a longtemps travaillé comme <w>correspondante</w> de presse en Amérique du Sud."
                        }
                    ],
                    "synonyms": [
                        "envoyé spécial",
                        "reporter"
                    ],
                    "common_phrases": [
                        "correspondant de guerre",
                        "correspondant permanent",
                        "correspondant de presse"
                    ]
                },
                {
                    "sense_id": "d5976c0d-eab8-34f2-88f8-66eedb2eebd0",
                    "sense_definition": "Personne avec laquelle on est en communication, notamment au téléphone ou par courrier électronique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Votre <w>correspondant</w> est actuellement en ligne, veuillez renouveler votre appel plus tard."
                        },
                        {
                            "text": "Je n'ai pas pu joindre mon <w>correspondant</w> malgré plusieurs tentatives ce matin."
                        }
                    ],
                    "synonyms": [
                        "interlocuteur"
                    ],
                    "common_phrases": [
                        "joindre un correspondant",
                        "laisser un message à votre correspondant"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e297479a-3ffa-35f0-9951-29cdf0f33d34",
                    "sense_definition": "Participe présent de <w>correspondre</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>correspondant</w> régulièrement avec des locuteurs natifs, on progresse très rapidement."
                        },
                        {
                            "text": "Les pièces ne <w>correspondant</w> pas au modèle d'origine ont été immédiatement refusées."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participe présent"
                        }
                    ]
                }
            ]
        }
