                                                "sense_id": "511e0b1c-13f1-3c81-b5cd-40a0b5750318",
                                                "text": "We lurked under lee."
                                            },
                                            {
                                                "example_id": "e8fed43e-84f3-46d5-8475-07336a24a47d",
                                                "sense_id": "511e0b1c-13f1-3c81-b5cd-40a0b5750318",
                                                "text": "Desiring me to take shelter in his lee."
                                            },
