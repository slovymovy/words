                "senses": [
                    {
                        "sense_id": "7a704e31-08b1-3193-99c3-4ba9743204ae",
                        "entry_id": "7bbcf107-6bf6-3379-9c22-7ddf0c72cb8d",
                        "glosses": [
                            "To strip (a person) of rights, identity, or humanity."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0d4f50a1-7026-4be4-b0da-0a120bed7baa",
                                "sense_id": "7a704e31-08b1-3193-99c3-4ba9743204ae",
                                "text": "Unhappily, shortcomings here on the part of even a few schools provide a handle for the type of irresponsible generalization that recently labeled the lay professor on the Catholic campus \"unwanted, unpaid, uncared for and unpersoned.\""
                            },
                            {
                                "example_id": "643529bf-a588-4afd-a2bf-d1027bb7c1a6",
                                "sense_id": "7a704e31-08b1-3193-99c3-4ba9743204ae",
                                "text": "Could a decision in the clinic’s favor today mean that, in that future, the lab-gestated babies would be legally unpersoned, because the womb had been held to impart a worth the child did not have on its own?"
                            }
                        ]
                    }
