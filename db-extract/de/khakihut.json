                "senses": [
                    {
                        "sense_id": "2fc5dc6a-9bd3-3b06-b2c3-054d773ee3b2",
                        "entry_id": "bd56e9c3-eeab-320d-9494-4df02253f165",
                        "glosses": [
                            "sandfarbener Hut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5b6af5f-ca6e-40c0-a980-d5929479c850",
                                "sense_id": "2fc5dc6a-9bd3-3b06-b2c3-054d773ee3b2",
                                "text": "„Ich war nur Itzig Finkelstein, einer mit legalen Papieren, einer in einer Khakihose, in einem Khakihemd, einem Khakihut, einer mit derben Schuhen, einer aus dem Kibbuz.“"
                            },
                            {
                                "example_id": "56c8afea-e4d0-4aeb-bcc2-aa922d60766f",
                                "sense_id": "2fc5dc6a-9bd3-3b06-b2c3-054d773ee3b2",
                                "text": "„Er trug wie immer einen Safarianzug und den Khakihut mit einer Banderole aus Schlangenhaut, grobwollene Kniestrümpfe und weiche Velskoens.“"
                            },
                            {
                                "example_id": "d4544024-1240-4af1-af14-7626435e68c1",
                                "sense_id": "2fc5dc6a-9bd3-3b06-b2c3-054d773ee3b2",
                                "text": "„Er nahm seinen breitkrempigen Khakihut ab, strich über sein schwarzes Haar und anschließend über den dichten Schnauzer, der über den unteren Teil des Gesichts hing, und räusperte sich.“"
                            },
                            {
                                "example_id": "e6d15d5f-3a77-44bc-9161-23ae0790c853",
                                "sense_id": "2fc5dc6a-9bd3-3b06-b2c3-054d773ee3b2",
                                "text": "„Sie trägt einen alten Khakihut aus Campingzeiten mit den Freunden vom EL-EY Café, den sie zum Glück in den eleganten Koffer gesteckt hat, als sie sich nach Nützlichem umsah, bevor sie das Cottage und alles Unwesentliche verließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
