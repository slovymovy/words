                        {
                            "text": "Depuis le sommet de la colline, nous avions une vue <w>magnifique</w> sur tout le village.",
                            "target_lang_translations": {
                                "en": "From the top of the hill, we had a <w>magnificent</w> view over the whole village.",
                                "ru": "С вершины холма нам открывался <w>великолепный</w> вид на всю деревню.",
                                "nl": "Vanaf de top van de heuvel hadden we een <w>prachtig</w> uitzicht over het hele dorp.",
                                "de": "Vom Gipfel des Hügels hatten wir eine <w>herrliche</w> Aussicht über das ganze Dorf.",
                                "pl": "Ze szczytu wzgórza mieliśmy <w>wspaniały</w> widok na całą wieś.",
                                "it": "Dalla cima della collina avevamo una vista <w>magnifica</w> su tutto il villaggio.",
                                "cs": "Z vrcholu kopce jsme měli <w>nádherný</w> výhled na celou vesnici.",
                                "tr": "Tepe zirvesinden tüm köy boyunca uzanan <w>harika</w> bir manzaramız vardı.",
                                "es": "Desde la cima de la colina teníamos una <w>magnífica</w> vista de todo el pueblo.",
                                "zh": "从山顶望去，整个村庄尽收眼底，景色非常<w>壮丽</w>。"
                            }
                        },
                        {
                            "text": "Nous avons passé une <w>magnifique</w> journée ensoleillée au bord du grand lac.",
                            "target_lang_translations": {
                                "en": "We spent a <w>wonderful</w> sunny day by the big lake.",
                                "ru": "Мы провели <w>чудесный</w> солнечный день на берегу большого озера.",
                                "nl": "We hebben een <w>prachtige</w> zonnige dag doorgebracht aan de oever van het grote meer.",
                                "de": "Wir haben einen <w>herrlichen</w> sonnigen Tag am Ufer des großen Sees verbracht.",
                                "pl": "Spędziliśmy <w>wspaniały</w> słoneczny dzień nad brzegiem wielkiego jeziora.",
                                "it": "Abbiamo passato una <w>splendida</w> giornata di sole in riva al grande lago.",
                                "cs": "Na břehu velkého jezera jsme strávili <w>skvělý</w> slunečný den.",
                                "tr": "Büyük gölün kıyısında güneşli <w>harika</w> bir gün geçirdik.",
                                "es": "Pasamos un <w>espléndido</w> día soleado a orillas del gran lago.",
                                "zh": "我们在大湖边度过了<w>美妙</w>的一天，阳光明媚。"
                            }
                        }
                    ],
