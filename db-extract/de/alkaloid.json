                        "glosses": [
                            "organische, stickstoffhaltige und meist alkalische natürlich vorkommende Verbindungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "419d444a-9d45-4260-bb08-d96895237785",
                                "sense_id": "bb0d7ad0-a2af-3e38-a8b1-7f9e13f8aca5",
                                "text": "„Chemisch sind die Alkaloide nicht einheitlich definiert. Sie enthalten ein oder mehrere meist heterozyklisch eingebaute Stickstoffatome, haben allerdings kein charakteristisches Strukturelement.“"
                            }
