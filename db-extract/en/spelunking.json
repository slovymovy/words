                    },
                    {
                        "translation_id": "e3ce900d-2221-4f78-84fb-69591de62c9a",
                        "source_entry_id": "d5fab683-a7af-3b24-879e-bc52b996b4af",
                        "source_sense_id": "f9629f7c-67a5-3f99-ad59-fe5958a628e5",
                        "source_sense_description": "exploring underground caverns",
                        "target_lang_word": "spéléologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spéléologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a5b6b18-be2b-3787-9c6f-2839b718ea41",
                                        "entry_id": "b2766a68-799b-39a8-84e7-5d69e339d816",
                                        "glosses": [
                                            "Activité consistant à explorer les cavités naturelles du sol (gouffres, cavernes, rivières souterraines, …), que ce soit dans un but scientifique, technique ou encore sportif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c0b099e-015d-4ca7-8d3b-97b2894c8726",
                                                "sense_id": "2a5b6b18-be2b-3787-9c6f-2839b718ea41",
                                                "text": "La spéléo, qu’il faudrait appeler spéléisme et non spéléologie, n’est pas une science mais une activité sportive."
                                            },
                                            {
                                                "example_id": "4cf7cf86-a6ae-407a-a2c4-e70f760d7f7a",
                                                "sense_id": "2a5b6b18-be2b-3787-9c6f-2839b718ea41",
                                                "text": "Poser au grand public la question suivante : « Que signifie pour vous la spéléologie ? », c’est s’attendre à une réponse du genre « c’est un sport dangereux, on ne voit pas à quoi il sert »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e9c07ed-2fe7-3bbd-a6d4-bfcdba8ca3e4",
                                        "entry_id": "b2766a68-799b-39a8-84e7-5d69e339d816",
                                        "glosses": [
                                            "Science qui a pour objet l’étude des cavités naturelles du sol."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92575a09-9e5e-4ea1-bbe2-d76a95831fad",
                                                "sense_id": "5e9c07ed-2fe7-3bbd-a6d4-bfcdba8ca3e4",
                                                "text": "Il fut l’un des premiers à explorer les grottes de la région. Il nommait la nouvelle science « grottologie », faisant une nette distinction entre celle-ci et le « grottisme », qui est la forme sportive. Il est dommage qu’avec le mot plus moderne, spéléologie, cette distinction ne soit plus faite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
