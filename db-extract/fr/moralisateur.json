                ],
                "senses": [
                    {
                        "sense_id": "480650f3-86fb-3371-b7de-85729c73b556",
                        "entry_id": "fe20ee0d-1f6c-3765-9477-0678fb163043",
                        "glosses": [
                            "Celui qui défend un point de vue moral."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b30c5e6e-86a9-4bbb-a291-3164502228eb",
                                "sense_id": "480650f3-86fb-3371-b7de-85729c73b556",
                                "text": "Le moralisateur donne des conseils aux hommes sur la conduite à tenir dans telle ou telle circonstance."
                            }
                        ]
                    },
                    {
                        "sense_id": "e53c7b10-f204-30ce-a023-5a029961afb7",
                        "entry_id": "fe20ee0d-1f6c-3765-9477-0678fb163043",
                        "glosses": [
                            "Celui qui se veut le défenseur de la morale et moralise à tout propos."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "6e6dcd68-5e22-44f1-884d-068e2a71a4e7",
                                "sense_id": "e53c7b10-f204-30ce-a023-5a029961afb7",
                                "text": "Exemple : Blaise est un vrai moralisateur, il ne peut s’empêcher de faire la morale à tout le monde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c20bc94-63a7-46d5-927b-fedbd1663f8e",
                        "source_entry_id": "fe20ee0d-1f6c-3765-9477-0678fb163043",
                        "target_lang_word": "Sittenrichter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sittenrichter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3998f1e0-32e8-346c-842e-c7a81861391a",
                                        "entry_id": "a0105ab9-c9cc-3e50-917d-cc547aa08cda",
                                        "glosses": [
                                            "Person, die sich ein Urteil über das Verhalten anderer hinsichtlich Sitte und Moral anmaßt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "367378b4-57cf-4c54-afb2-5f47aae8f445",
                                                "sense_id": "3998f1e0-32e8-346c-842e-c7a81861391a",
                                                "text": "„Er ist Satiriker, aber kein Moralist und noch weniger Sittenrichter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b0833a4-f596-429c-8602-e6d67dc6259d",
                        "source_entry_id": "fe20ee0d-1f6c-3765-9477-0678fb163043",
                        "target_lang_word": "self-righteous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-righteous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ef02f2f-c0a3-3278-9836-474029d03841",
                                        "entry_id": "5d515790-16b4-392d-96e5-b9864736be29",
                                        "glosses": [
                                            "Piously self-assured and smugly moralistic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b48d542-06d1-46cf-8210-50fd0b57500d",
                                                "sense_id": "3ef02f2f-c0a3-3278-9836-474029d03841",
                                                "text": "Near-synonyms: smug, complacent; sanctimonious"
                                            },
                                            {
                                                "example_id": "942a5b04-5d6a-4508-8d3a-644f2cba5dd4",
                                                "sense_id": "3ef02f2f-c0a3-3278-9836-474029d03841",
                                                "text": "And is it not possible, Mr. Hier, that people are reacting (in a contemptible way, certainly) against your self-righteous bawling?"
                                            },
                                            {
                                                "example_id": "a38e3f8e-d355-425b-a67e-64dc42ee949b",
                                                "sense_id": "3ef02f2f-c0a3-3278-9836-474029d03841",
                                                "text": "“God's blood, Thomas, self-righteous prickery is not the preserve of the English!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78ec7967-45b6-31a6-96a5-b0ce16d7138a",
                                        "entry_id": "5d515790-16b4-392d-96e5-b9864736be29",
                                        "glosses": [
                                            "Patronizingly moralizing and rebuking."
