                "senses": [
                    {
                        "sense_id": "5aeb741a-4bcc-3408-a6eb-964865837c91",
                        "entry_id": "07008cd8-de5b-3803-b9a9-c60438a3dc55",
                        "glosses": [
                            "hinderlijke, vervelende drukte die nergens voor nodig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63a6b2f5-04b0-4b2f-9101-bf0150ea5319",
                                "sense_id": "5aeb741a-4bcc-3408-a6eb-964865837c91",
                                "text": "Bedrijven in Nederland betalen vandaag 15 procent belasting over het dividend dat zij uitkeren aan hun aandeelhouders. De dividendontvanger kan het ingehouden bedrag vervolgens verrekenen met zijn belastingaanslag. Wat voor Nederlandse bedrijven heel wat rompslomp met zich meebracht."
                            },
                            {
                                "example_id": "ec3c7778-7cd2-4251-87c9-00fcf5f1b976",
                                "sense_id": "5aeb741a-4bcc-3408-a6eb-964865837c91",
                                "text": "Opa Hennie is in elk geval opgelucht dat de boete van tafel is. [voor het wildplassen van zijn 2 jarige kleinzoon] \"Grandioos! Dit scheelt ons een heleboel rompslomp want we hadden er zeker een zaak van gemaakt als de politie vast had gehouden aan deze boete.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25549c27-87d6-4250-a5d8-65db9042ebb1",
                        "source_entry_id": "07008cd8-de5b-3803-b9a9-c60438a3dc55",
                        "source_sense_id": "5aeb741a-4bcc-3408-a6eb-964865837c91",
                        "source_sense_description": "hinderlijke, vervelende drukte die nergens voor nodig is",
                        "target_lang_word": "fuss",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fuss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                        "entry_id": "f667c975-b116-38e7-ada6-78ca63903fd1",
                                        "glosses": [
                                            "Excessive activity, worry, bother, or talk about something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "676b296a-8496-48cf-84a5-fe234e6e5ff4",
                                                "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                                "text": "They made a big fuss about the wedding plans."
                                            },
                                            {
                                                "example_id": "02b41447-ebaa-46d8-85f9-afc5e82bd71d",
                                                "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                                "text": "What's all the fuss about?"
                                            },
                                            {
                                                "example_id": "a1419121-d9ca-4b22-a059-ac83f79bf8e4",
                                                "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                                "text": "Sickness did not last above a ten days; my poor wife zealously assiduous, and with a minimum of fuss or noise."
                                            },
                                            {
                                                "example_id": "b3fcd38e-98fb-4572-ab17-82aed8b3656e",
                                                "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                                "text": "“Anthea hasn't a notion in her head but to vamp a lot of silly mugwumps. She's set her heart on that tennis bloke[…]whom the papers are making such a fuss about.”"
                                            },
                                            {
                                                "example_id": "0564d516-79ea-4755-a82e-3b7e0b4761a8",
                                                "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                                "text": "But in the reader comments section beneath the FT piece, many couldn’t understand what all the fuss was about. “I’m surprised to see the FT reporting this sort of thing,” one person wrote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1316775d-0d76-39ed-9e33-667951302405",
                                        "entry_id": "f667c975-b116-38e7-ada6-78ca63903fd1",
                                        "glosses": [
                                            "A complaint or noise; a scene."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b060867-8f98-4bef-a8b4-e16d5ed6ab82",
                                                "sense_id": "1316775d-0d76-39ed-9e33-667951302405",
                                                "text": "If you make enough of a fuss about the problem, maybe they'll fix it for you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46c0fad0-e85d-3557-a8c3-27679a23b5dd",
                                        "entry_id": "f667c975-b116-38e7-ada6-78ca63903fd1",
                                        "glosses": [
                                            "An exhibition of affection or admiration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af648191-e585-47cb-aefc-8f50f707fa5e",
                                                "sense_id": "46c0fad0-e85d-3557-a8c3-27679a23b5dd",
                                                "text": "They made a great fuss over the new baby."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fuss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "035dd445-9847-32f5-8863-8881cbcab842",
                                        "entry_id": "dbf56873-24ab-3c30-968f-abdc7cebcf04",
                                        "glosses": [
                                            "To be very worried or excited about something, often too much."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7855fbb-09d3-4e02-9016-9cb7d6e48424",
                                                "sense_id": "035dd445-9847-32f5-8863-8881cbcab842",
                                                "text": "His grandmother will never quit fussing over his vegetarianism."
                                            },
                                            {
                                                "example_id": "108d311a-8c7d-4e1b-9371-2ae4e6caf13b",
                                                "sense_id": "035dd445-9847-32f5-8863-8881cbcab842",
                                                "text": "Dear reader, spare me. I don't hate men, I love them; I eat 'em for breakfast. But it seems to me that fussing about masculinity is intimately related to homophobia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d48dc032-5d36-3ec0-80f1-f1df243afe31",
                                        "entry_id": "dbf56873-24ab-3c30-968f-abdc7cebcf04",
                                        "glosses": [
                                            "To fiddle; fidget; wiggle, or adjust"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f238fdd1-17a2-4573-874c-55b094e7f28d",
                                                "sense_id": "d48dc032-5d36-3ec0-80f1-f1df243afe31",
                                                "text": "Quit fussing with your hair. It looks fine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b22380d-0ff2-32e8-876a-5ca60064428a",
                                        "entry_id": "dbf56873-24ab-3c30-968f-abdc7cebcf04",
                                        "glosses": [
                                            "To disturb (a person)"
                                        ],
