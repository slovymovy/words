                ],
                "senses": [
                    {
                        "sense_id": "8e168e6a-9ab0-3285-91b9-a046eba70cc8",
                        "entry_id": "ddbfd4d6-8506-30e2-925f-9b02cd517b5b",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d50c3d6-b79a-4736-a629-9be4d8a2ba5b",
                                "sense_id": "8e168e6a-9ab0-3285-91b9-a046eba70cc8",
                                "text": "Frau Hemmes ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a2b6f770-0471-453b-ac00-fa1f55234ab4",
                                "sense_id": "8e168e6a-9ab0-3285-91b9-a046eba70cc8",
                                "text": "Herr Hemmes wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "af64cf48-e3a0-48ea-a190-b720b13c3928",
                                "sense_id": "8e168e6a-9ab0-3285-91b9-a046eba70cc8",
                                "text": "Die Hemmesens fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "b807da71-e183-426f-a578-1f9d8bea5b06",
                                "sense_id": "8e168e6a-9ab0-3285-91b9-a046eba70cc8",
                                "text": "Der Hemmes trägt nie die Pullover, die die Hemmes ihm strickt."
                            },
                            {
                                "example_id": "b3e31db1-be23-4761-9914-4b086c28ccd4",
                                "sense_id": "8e168e6a-9ab0-3285-91b9-a046eba70cc8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hemmes kommt, geht der Herr Hemmes.“"
                            },
                            {
                                "example_id": "ed7923a5-9741-4255-bd01-722666ac464b",
                                "sense_id": "8e168e6a-9ab0-3285-91b9-a046eba70cc8",
                                "text": "Hemmes kommt und geht."
                            },
                            {
                                "example_id": "402e51f2-9d39-48fa-8541-effae3c2ddb8",
                                "sense_id": "8e168e6a-9ab0-3285-91b9-a046eba70cc8",
                                "text": "Hemmes’ kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
