                                        "glosses": [
                                            "A shell containing one or more sheaves, the whole forming a pulley."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1ffde72-9c92-4e57-a829-3414aacb4cef",
                                                "sense_id": "704bad2f-07a2-3c28-b729-fca085b77bf1",
                                                "text": "In 1799 he [Marc Brunel] designed a machine to make pulley blocks for the British Navy ... who turned out not to be good payers."
                                            },
                                            {
                                                "example_id": "eb52ae54-99d3-4440-9a4c-2aa03da7dce6",
                                                "sense_id": "704bad2f-07a2-3c28-b729-fca085b77bf1",
                                                "text": "The next stage entailed toppling-over each girder into the river by means of hand-winches and pulley-blocks."
                                            }
                                        ]
                                    }
                                ]
