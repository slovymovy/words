                {
                    "sense_id": "ca20d544-6ae8-3d30-a435-b06df3dd4a51",
                    "sense_definition": "een bepaalde smaak hebben",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "smaakbeleving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze rode wijn <w>smaakt</w> voortreffelijk bij vleesgerechten.",
                            "target_lang_translations": {
                                "en": "This red wine <w>tastes</w> excellent with meat dishes.",
                                "ru": "Это красное вино превосходно <w>сочетается на вкус</w> с мясными блюдами."
                            }
                        },
                        {
                            "text": "Ik vind dat deze soep een beetje te zout <w>smaakt</w>.",
                            "target_lang_translations": {
                                "en": "I think this soup <w>tastes</w> a bit too salty.",
                                "ru": "Я нахожу, что этот суп <w>на вкус</w> немного пересолен."
                            }
                        }
                    ],
                    "common_phrases": [
                        "naar meer smaken",
                        "vies smaken",
                        "zoet smaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to have a particular flavor or taste",
                        "ru": "иметь определенный вкус"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to taste",
                                "target_lang_sense_clarification": "to have a specific flavor"
                            }
