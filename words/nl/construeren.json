                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "techniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ingenieur begon de nieuwe motoronderdelen nauwkeurig te <w>construeren</w> op de tekentafel.",
                            "target_lang_translations": {
                                "en": "The engineer began to accurately <w>design</w> the new engine parts on the drawing board."
                            }
                        },
                        {
                            "text": "Voordat de bouw begint, moet de architect het hele gebouw in detail <w>construeren</w>.",
                            "target_lang_translations": {
                                "en": "Before construction begins, the architect must <w>draft</w> the entire building in detail."
                            }
                        }
                    ],
                    "synonyms": [
