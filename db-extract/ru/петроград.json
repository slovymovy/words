                    {
                        "translation_id": "891135dd-ef64-4696-afeb-f7489756b52d",
                        "source_entry_id": "8813af51-d115-305d-bcf9-37f461b9e31b",
                        "target_lang_word": "Petrograd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Petrograd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9ee9b5c-8ccd-3278-8fa7-94160ed956fd",
                                        "entry_id": "a161ab8c-2f5a-3707-85b4-b0d8b18fc45a",
                                        "glosses": [
                                            "der Name der russischen Stadt Sankt Petersburg von 1914 bis 1924"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10200aae-090c-4155-8267-d52e82147c24",
                                                "sense_id": "f9ee9b5c-8ccd-3278-8fa7-94160ed956fd",
                                                "text": "„Der Petrograder Sowjet misstraute der Regierung, und von der Front kamen Hunderte von Delegierten der breiten Soldatenmassen, die erklärten: ›Es ist wahr, wir brauchen Verstärkung; wichtiger aber ist uns, Petrograd und die Revolution in guten Händen zu wissen …‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79c41aa2-dc4f-48d4-b1b4-b5656dec7eb7",
                        "source_entry_id": "8813af51-d115-305d-bcf9-37f461b9e31b",
                        "target_lang_word": "Petrograd",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Petrograd",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f174a1d-97a8-35de-899f-d4340cedc1b5",
                                        "entry_id": "8820c120-77b9-390f-8c86-19987e2cda55",
                                        "glosses": [
                                            "Autre orthographe de Pétrograd, nom que porta Saint-Pétersbourg de 1914 à 1924."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3d56dfd-48ab-4183-acf4-2ca4f7ea49c4",
                                                "sense_id": "3f174a1d-97a8-35de-899f-d4340cedc1b5",
                                                "text": "Toujours aussi loin des réalités, le tsar a pour seule réponse la répression mais, le 27 février, les 150 000 hommes de la garnison de Petrograd passent du côté des insurgés."
                                            },
                                            {
                                                "example_id": "3c9f7922-5728-4b58-9659-91360fa7a0ee",
                                                "sense_id": "3f174a1d-97a8-35de-899f-d4340cedc1b5",
                                                "text": "Je ne partirai pas de Petrograd sans lui."
                                            },
                                            {
                                                "example_id": "a6989469-0f5a-4994-b89b-2352ca9b7120",
                                                "sense_id": "3f174a1d-97a8-35de-899f-d4340cedc1b5",
                                                "text": "Pour prévenir les émeutes, création de la région militaire spéciale de Petrograd, commandée par le général Khabalov, qui avait participé à la répression de 1905."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
