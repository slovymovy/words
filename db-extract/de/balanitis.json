                    {
                        "sense_id": "b6075a25-413f-34c1-8566-c2fe2913c6ec",
                        "entry_id": "78f1d83c-9492-3902-9c4d-5d255ed646c7",
                        "glosses": [
                            "Entzündung der Eichel des männlichen Gliedes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba54abf5-4f45-4c86-b8f0-bd082df87800",
                                "sense_id": "b6075a25-413f-34c1-8566-c2fe2913c6ec",
                                "text": "Bei der Balanitis handelt es sich um eine Entzündung der Glans penis, oft verbunden mit einer Entzündung des äußeren und inneren Vorhautblattes (Balanoposthitis)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "228b0f3b-1267-41c7-bf73-acdebd7853be",
                        "source_entry_id": "78f1d83c-9492-3902-9c4d-5d255ed646c7",
                        "source_sense_id": "b6075a25-413f-34c1-8566-c2fe2913c6ec",
