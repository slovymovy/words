                "senses": [
                    {
                        "sense_id": "9a27fac8-5407-36d2-8e4f-583896b230be",
                        "entry_id": "e2175abd-735b-3f75-8054-3e7aa80de4a1",
                        "glosses": [
                            "корпус старого судна, приспособленный для жилья, хранения запасов и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa5e99fd-2c34-4fa7-b09a-c2ae7637d492",
                                "sense_id": "9a27fac8-5407-36d2-8e4f-583896b230be",
                                "text": "По улице, мерно ступая и звякая цепями, возвращались с работы на блокшивы арестанты."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee5e800a-806f-364b-8bcd-1136ed5f6798",
                        "entry_id": "e2175abd-735b-3f75-8054-3e7aa80de4a1",
                        "glosses": [
                            "воен. разукомплектованное устаревшее судно, переооборудованное под склад или казарму"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5989e7bb-1480-4463-b20a-feed3fde27fd",
                                "sense_id": "ee5e800a-806f-364b-8bcd-1136ed5f6798",
                                "text": "Привезут на блокшив партию списанных за негодностью манильских тросов, нам задание: плести из них маты и кранцы."
                            }
                        ]
                    }
