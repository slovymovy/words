                                        "entry_id": "9da6400b-69a5-33d4-9c7d-0235bea4ea9c",
                                        "glosses": [
                                            "Someone or something that is annoying or frustrating."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bcd4b59-9d94-45bb-801c-51cabd79dd93",
                                                "sense_id": "6e097ad6-58ae-3150-9c2a-242a8fb2e0aa",
                                                "text": "You really are a pain in the arse, aren't you (laugh track)? The PM is going up the wall! Hitting the roof! You can't go around making speeches like that."
                                            }
                                        ]
                                    }
                                ]
                            }
