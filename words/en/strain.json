{
    "word_family": [
        "strainer",
        "constraint",
        "restraint",
        "constrain",
        "restrain"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f11f113-3315-3193-9d60-3f6385ec1645",
                    "sense_definition": "Pressure, worry, or difficulty caused by a demanding situation or heavy responsibilities.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "tension_pressure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long hours at work put a severe <w>strain</w> on his health.",
                            "target_lang_translations": {
                                "ru": "Длительная работа создала серьезную <w>нагрузку</w> на его здоровье.",
                                "tr": "İşteki uzun saatler sağlığı üzerinde ciddi bir <w>baskı</w> oluşturdu."
                            }
                        },
                        {
                            "text": "She felt the <w>strain</w> of trying to balance her job and her family life.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала <w>напряжение</w> от попыток совместить работу и семейную жизнь.",
                                "tr": "İşi ile aile hayatı arasında denge kurmaya çalışmanın <w>gerginliğini</w> hissetti."
                            }
                        }
                    ],
                    "antonyms": [
                        "ease",
                        "relaxation"
                    ],
                    "common_phrases": [
                        "under strain",
                        "put a strain on",
                        "financial strain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давление, беспокойство или трудности, вызванные сложной ситуацией или большой ответственностью.",
                        "tr": "Zor bir durum veya ağır sorumlulukların neden olduğu baskı, endişe veya zorluk."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напряжение",
                                "target_lang_sense_clarification": "состояние стресса или давления"
                            },
                            {
                                "target_lang_word": "нагрузка",
                                "target_lang_sense_clarification": "тяжесть, бремя"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "baskı",
                                "target_lang_sense_clarification": "stres veya zorlanma hali"
                            },
                            {
                                "target_lang_word": "gerginlik",
                                "target_lang_sense_clarification": "zihinsel veya duygusal yük"
                            },
                            {
                                "target_lang_word": "stres",
                                "target_lang_sense_clarification": "yoğun çalışma veya sorumluluk stresi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a1f1ff1-ff54-359c-b048-b9f7c6ba2fe3",
                    "sense_definition": "An injury to a muscle or part of the body caused by stretching it too much or working it too hard.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete had to withdraw from the race due to a leg <w>strain</w>.",
                            "target_lang_translations": {
                                "ru": "Спортсмену пришлось сняться с соревнований из-за <w>растяжения</w> ноги."
                            }
                        },
                        {
                            "text": "He suffered a painful muscle <w>strain</w> while lifting heavy boxes.",
                            "target_lang_translations": {
                                "ru": "Он получил болезненное <w>растяжение</w> мышцы, поднимая тяжелые коробки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "muscle strain",
                        "back strain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Травмировать часть тела, перенапрягая или слишком сильно растягивая её.",
                        "tr": "Bir kasın veya vücut bölümünün aşırı gerilmesi veya zorlanması sonucu oluşan sakatlık."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растянуть",
                                "target_lang_sense_clarification": "травмировать связки или мышцы"
                            },
                            {
                                "target_lang_word": "потянуть",
                                "target_lang_sense_clarification": "разг. травмировать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "burkulma",
                                "target_lang_sense_clarification": "eklem veya bağ zorlanması"
                            },
                            {
                                "target_lang_word": "zorlanma",
                                "target_lang_sense_clarification": "kas incinmesi veya gerilmesi"
                            },
                            {
                                "target_lang_word": "incinme",
                                "target_lang_sense_clarification": "hafif kas zararı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ec84fdc-6f38-3ad6-972a-9f166c97832a",
                    "sense_definition": "A specific variety or type of a bacterium, virus, or plant.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "biology_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists have identified a new <w>strain</w> of the flu virus.",
                            "target_lang_translations": {
                                "ru": "Ученые выявили новый <w>штамм</w> вируса гриппа.",
                                "tr": "Bilim insanları grip virüsünün yeni bir <w>varyantını</w> tespit etti."
                            }
                        },
                        {
                            "text": "This particular <w>strain</w> of wheat is resistant to cold weather.",
                            "target_lang_translations": {
                                "ru": "Этот конкретный <w>сорт</w> пшеницы устойчив к холодной погоде.",
                                "tr": "Bu özel buğday <w>türü</w> soğuk havaya karşı dayanıklıdır."
                            }
                        }
                    ],
                    "common_phrases": [
                        "new strain",
                        "virus strain",
                        "flu strain"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "biology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Особая разновидность или тип бактерии, вируса или растения.",
                        "tr": "Bir bakteri, virüs veya bitkinin belirli bir varyetesi veya türü."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штамм",
                                "target_lang_sense_clarification": "вируса или бактерии"
                            },
                            {
                                "target_lang_word": "сорт",
                                "target_lang_sense_clarification": "растения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "varyant",
                                "target_lang_sense_clarification": "virüs veya bakteri çeşidi"
                            },
                            {
                                "target_lang_word": "suş",
                                "target_lang_sense_clarification": "biyolojik mikrobiyolojik tip"
                            },
                            {
                                "target_lang_word": "tür",
                                "target_lang_sense_clarification": "bitki veya alt grup çeşidi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e2a29c5-b1aa-384b-8879-e4a36f25097d",
                    "sense_definition": "A particular quality, tendency, or trait in a person's character or ancestry.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "character_trait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a <w>strain</w> of stubbornness that runs in her family.",
                            "target_lang_translations": {
                                "ru": "В её семье прослеживается <w>черта</w> упрямства.",
                                "tr": "Ailesinde gelen bir inatçılık <w>damarı</w> var."
                            }
                        },
                        {
                            "text": "He showed a surprising <w>strain</w> of humor during the serious meeting.",
                            "target_lang_translations": {
                                "ru": "Он проявил удивительную <w>нотку</w> юмора во время серьезной встречи.",
                                "tr": "Ciddi toplantı sırasında şaşırtıcı bir mizah <w>izleri</w> sergiledi."
                            }
                        }
                    ],
                    "synonyms": [
                        "propensity",
                        "proneness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особое качество, склонность или черта в характере человека или его происхождении.",
                        "tr": "Bir kişinin karakterinde veya soyunda bulunan belirli bir nitelik, eğilim veya özellik."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черта",
                                "target_lang_sense_clarification": "особенность характера"
                            },
                            {
                                "target_lang_word": "склонность",
                                "target_lang_sense_clarification": "предрасположенность"
                            },
                            {
                                "target_lang_word": "жилка",
                                "target_lang_sense_clarification": "особая способность"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "damar",
                                "target_lang_sense_clarification": "karakter özelliği veya eğilimi"
                            },
                            {
                                "target_lang_word": "eğilim",
                                "target_lang_sense_clarification": "kişilik yatkınlığı"
                            },
                            {
                                "target_lang_word": "iz",
                                "target_lang_sense_clarification": "karakterdeki belirti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e944ae3-9e4a-3544-9be6-d58baa863149",
                    "sense_definition": "The sound of music, especially a melody or a part of a song.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could hear the faint <w>strains</w> of a violin coming from the window.",
                            "target_lang_translations": {
                                "ru": "Мы могли слышать слабые <w>звуки</w> скрипки, доносящиеся из окна.",
                                "tr": "Pencereden gelen hafif keman <w>ezgilerini</w> duyabiliyorduk."
                            }
                        },
                        {
                            "text": "The orchestra played the opening <w>strains</w> of the national anthem.",
                            "target_lang_translations": {
                                "ru": "Оркестр сыграл первые <w>аккорды</w> национального гимна.",
                                "tr": "Orkestra, istiklal marşının giriş <w>melodilerini</w> çaldı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Звучание музыки, особенно мелодия или часть песни.",
                        "tr": "Müzik sesi, özellikle bir melodi veya şarkının parçası."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напев",
                                "target_lang_sense_clarification": "мелодия"
                            },
                            {
                                "target_lang_word": "звуки",
                                "target_lang_sense_clarification": "музыкальное звучание"
                            },
                            {
                                "target_lang_word": "аккорды",
                                "target_lang_sense_clarification": "созвучия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ezgi",
                                "target_lang_sense_clarification": "melodi veya müzik sesi"
                            },
                            {
                                "target_lang_word": "ton",
                                "target_lang_sense_clarification": "müzikal tını"
                            },
                            {
                                "target_lang_word": "sesler",
                                "target_lang_sense_clarification": "kulağa gelen müzik sesleri"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a1f1ff1-ff54-359c-b048-b9f7c6ba2fe3",
                    "sense_definition": "To injure a part of the body by making it work too hard or stretching it too much.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>strain</w> your back when you move the furniture.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, не <w>потяни</w> спину, когда будешь двигать мебель.",
                                "tr": "Mobilyaları taşırken sırtınızı <w>incitmemeye</w> dikkat edin."
                            }
                        },
                        {
                            "text": "He <w>strained</w> a muscle in his leg while running yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера во время бега он <w>растянул</w> мышцу на ноге.",
                                "tr": "Dün koşarken bacağındaki bir kası <w>zorladı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strain a muscle",
                        "strain one's back"
                    ],
                    "target_lang_definitions": {
                        "ru": "Травмировать часть тела, перенапрягая или слишком сильно растягивая её.",
                        "tr": "Bir kasın veya vücut bölümünün aşırı gerilmesi veya zorlanması sonucu oluşan sakatlık."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растянуть",
                                "target_lang_sense_clarification": "травмировать связки или мышцы"
                            },
                            {
                                "target_lang_word": "потянуть",
                                "target_lang_sense_clarification": "разг. травмировать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "burkulma",
                                "target_lang_sense_clarification": "eklem veya bağ zorlanması"
                            },
                            {
                                "target_lang_word": "zorlanma",
                                "target_lang_sense_clarification": "kas incinmesi veya gerilmesi"
                            },
                            {
                                "target_lang_word": "incinme",
                                "target_lang_sense_clarification": "hafif kas zararı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "035d4b04-c4bc-3674-a46e-1d1bd59da949",
                    "sense_definition": "To separate solid pieces from a liquid by pouring it through a utensil with small holes.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "filter_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>strain</w> the pasta and serve it with the sauce immediately.",
                            "target_lang_translations": {
                                "ru": "Нужно <w>слить</w> воду с макарон и сразу подавать их с соусом.",
                                "tr": "Makarnayı <w>süzmeli</w> ve hemen sosla servis etmelisiniz."
                            }
                        },
                        {
                            "text": "She used a cloth to <w>strain</w> the seeds out of the fresh juice.",
                            "target_lang_translations": {
                                "ru": "Она использовала ткань, чтобы <w>отцедить</w> семена из свежего сока.",
                                "tr": "Taze meyve suyundan çekirdekleri <w>süzmek</w> için bir bez kullandı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strain the mixture",
                        "strain off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отделять твердые частицы от жидкости, пропуская её через утварь с мелкими отверстиями.",
                        "tr": "Sıvıyı küçük delikli bir kap veya süzgeçten geçirerek katı parçaları ayırmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "процеживать",
                                "target_lang_sense_clarification": "пропускать через сито или фильтр"
                            },
                            {
                                "target_lang_word": "отцеживать",
                                "target_lang_sense_clarification": "отделять жидкость"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "süzmek",
                                "target_lang_sense_clarification": "sıvıyı katı maddelerden ayırmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83a7ed67-64e0-3e5a-8c8f-c345467a93aa",
                    "sense_definition": "To make a great effort to do something, often pushing one's abilities or senses to the limit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tension_pressure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had to <w>strain</w> to hear what they were whispering in the back of the room.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось <w>напрячься</w>, чтобы услышать, о чем они шептались в конце комнаты.",
                                "tr": "Odanın arkasında ne fısıldadıklarını duymak için <w>zorlanmak</w> zorunda kaldım."
                            }
                        },
                        {
                            "text": "The dog <w>strained</w> against the leash to get closer to the squirrel.",
                            "target_lang_translations": {
                                "ru": "Собака <w>натягивала</w> поводок, пытаясь подобраться ближе к белке.",
                                "tr": "Köpek, sincaba yaklaşmak için tasmayı <w>germe gücüyle çekti</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strain to hear",
                        "strain to see",
                        "strain every nerve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прилагать большие усилия, часто на пределе своих возможностей или чувств.",
                        "tr": "Bir şeyi yapmak için büyük çaba sarf etmek, genellikle yeteneklerini veya duyularını son sınırına kadar zorlamak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напрягать",
                                "target_lang_sense_clarification": "прилагать усилия"
                            },
                            {
                                "target_lang_word": "силиться",
                                "target_lang_sense_clarification": "стараться изо всех сил"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zorlamak",
                                "target_lang_sense_clarification": "kendini veya duyularını aşırı yormak"
                            },
                            {
                                "target_lang_word": "zorlanmak",
                                "target_lang_sense_clarification": "yoğun çaba harcamak"
                            },
                            {
                                "target_lang_word": "germek",
                                "target_lang_sense_clarification": "ip veya kası çekip germek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65beb00d-ad4e-3bc3-9b90-376997be34ac",
                    "sense_definition": "To put too much pressure on something, such as a relationship, system, or material, potentially causing damage.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "tension_pressure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant arguments began to <w>strain</w> their friendship.",
                            "target_lang_translations": {
                                "ru": "Постоянные споры начали <w>осложнять</w> их дружбу.",
                                "tr": "Sürekli tartışmalar arkadaşlıklarını <w>germeye</w> başladı."
                            }
                        },
                        {
                            "text": "The heavy load <w>strained</w> the ropes until they almost broke.",
                            "target_lang_translations": {
                                "ru": "Тяжелый груз <w>натянул</w> веревки так, что они почти порвались.",
                                "tr": "Ağır yük, ipleri neredeyse kopana kadar <w>zorladı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strain relations",
                        "strain resources",
                        "strain patience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывать чрезмерное давление на что-либо, например, на отношения или систему, что может привести к повреждению.",
                        "tr": "İlişki, sistem veya malzeme gibi bir şeye çok fazla baskı uygulayarak potansiyel olarak zarar vermek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осложнять",
                                "target_lang_sense_clarification": "делать трудным (об отношениях)"
                            },
                            {
                                "target_lang_word": "подвергать испытанию",
                                "target_lang_sense_clarification": "проверять на прочность"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zorlamak",
                                "target_lang_sense_clarification": "ilişkileri veya sistemleri yıpratmak"
                            },
                            {
                                "target_lang_word": "gerginleştirmek",
                                "target_lang_sense_clarification": "ilişkide gerginlik yaratmak"
                            },
                            {
                                "target_lang_word": "sarsmak",
                                "target_lang_sense_clarification": "ilişkiyi veya yapıyı olumsuz etkilemek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "875134b7-ee79-3ec8-be12-035baac6bdf7",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Strain</w> has been working at the company for twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Стрейн</w> работает в компании уже двадцать лет.",
                                "tr": "Bay <w>Strain</w> yirmi yıldır şirkette çalışıyor."
                            }
                        },
                        {
                            "text": "We visited the <w>Strain</w> family during our trip to the countryside.",
