                "senses": [
                    {
                        "sense_id": "88f1abcc-54f3-3e11-8eb2-76824af4bfeb",
                        "entry_id": "5c4d0f57-6d9c-3c17-8308-124c7d0ad003",
                        "glosses": [
                            "уникальный признак чего-либо; то, что позволяет идентифицировать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8762080c-dca6-4beb-b2ac-dfb3e4a7e73b",
                                "sense_id": "88f1abcc-54f3-3e11-8eb2-76824af4bfeb",
                                "text": "Пользователь набирает свой идентификатор (login) и пароль (password)."
                            },
                            {
                                "example_id": "42eaca71-81ea-4170-abf6-b557c5efa5b8",
                                "sense_id": "88f1abcc-54f3-3e11-8eb2-76824af4bfeb",
                                "text": "Внешние: выдающийся нос (главный идентификатор), пучеглазость и кудреватость."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee85b019-7f2d-33e0-b36c-0766708958bd",
                        "entry_id": "5c4d0f57-6d9c-3c17-8308-124c7d0ad003",
                        "glosses": [
                            "тот, кто идентифицирует"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3be75a6b-17c4-41f3-8b43-1a56740a5012",
                                "sense_id": "ee85b019-7f2d-33e0-b36c-0766708958bd",
                                "text": "Схема обучения нейросетевого идентификатора"
                            }
                        ]
                    },
