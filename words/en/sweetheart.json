            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d69f4989-3125-3864-b2d8-8edfe8bec1a7",
                    "sense_definition": "A term of endearment used to address someone you love or care about, such as a partner or child.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "endearment_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Goodnight, <w>sweetheart</w>, sleep well.",
                            "target_lang_translations": {
                                "ru": "Спокойной ночи, <w>дорогая</w>, спи сладко.",
                                "zh": "晚安，<w>亲爱的</w>，睡个好觉。"
                            }
                        },
                        {
                            "text": "Can you pass me the salt, <w>sweetheart</w>?",
                            "target_lang_translations": {
                                "ru": "Можешь передать мне соль, <w>милый</w>?",
                                "zh": "能帮我递一下盐吗，<w>宝贝</w>？"
                            }
                        }
                    ],
                    "synonyms": [
