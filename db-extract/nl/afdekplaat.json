                "senses": [
                    {
                        "sense_id": "5a672750-6415-389e-80a5-201964fff2dd",
                        "entry_id": "c9fb9896-b04a-3cff-aa01-526030fac60d",
                        "glosses": [
                            "vlakke plaat die iets afschermt, beschermt en minder zichtbaar maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8b7c15e-b298-4597-836f-aac297cc2a49",
                                "sense_id": "5a672750-6415-389e-80a5-201964fff2dd",
                                "text": "Een kraan tilt twee schoorstenen op het huis. Met die kenmerkende afdekplaat, zodat het huis weer de contouren krijgt van weleer. De woning is zeker 200 jaar oud, was verwaarloosd en droeg sporen van zware aardbevingsschade en zou plat gaan. De NAM had het aangekocht en ging voor sloop."
                            },
                            {
                                "example_id": "3e3aa6af-df34-4c21-a84e-76117b110afd",
                                "sense_id": "5a672750-6415-389e-80a5-201964fff2dd",
                                "text": "Ook Jolyon Palmer (Renault) kwam in de vangrail terecht. De training werd voortijdig afgevlagd nadat Jenson Button met zijn bolide over een losgeraakte afdekplaat was gereden."
                            }
                        ]
                    }
