            {
                "entry_id": "3854ff6b-b737-3837-bdaf-9784b3728f4f",
                "word": "cursive",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "79b63774-f0ab-4c5d-b728-c695f581ed30",
                        "entry_id": "3854ff6b-b737-3837-bdaf-9784b3728f4f",
                        "tags": [
                            "plural"
