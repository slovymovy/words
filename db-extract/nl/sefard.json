                                            {
                                                "example_id": "0a93e216-8421-4420-a51d-c25e3e4dba3d",
                                                "sense_id": "2a45bfd4-13fd-31ac-86d0-f95347a2b067",
                                                "text": "„Und noch ein Wort gehörte hierher, der englische Sepharde hatte es mir im Taxi aufgeschrieben.“"
