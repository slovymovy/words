                        "sense_id": "6e8d89d9-c338-3de0-a7d6-c30ba7b50284",
                        "entry_id": "cee7687f-f1c7-3fc9-846d-a517ea4fa20a",
                        "glosses": [
                            "Chasseur à l’affût."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8a8a03f-0f2f-4963-80e7-6e19135f6be7",
                                "sense_id": "6e8d89d9-c338-3de0-a7d6-c30ba7b50284",
                                "text": "Presque tous les matins, avant le jour, il sortait pour surveiller les colleteurs et affûteurs."
                            },
                            {
                                "example_id": "03eea2ff-eeb4-4528-ac66-b6ab6c22c3e3",
                                "sense_id": "6e8d89d9-c338-3de0-a7d6-c30ba7b50284",
                                "text": "L’ours lève alors le gîte, et va donner en fuyant dans la ligne des affûteurs."
                            },
                            {
                                "example_id": "e576ae93-f021-48a2-b314-5ecd9e16d9e7",
                                "sense_id": "6e8d89d9-c338-3de0-a7d6-c30ba7b50284",
                                "text": "Reconnaître si elles [les populations armées] sont ou non organisées, et si elles doivent être considérées comme des ennemis loyaux ou de simples affûteurs, Confér. de Bruxelles, 1874, protoc. nᵒ 14."
                            }
                        ]
                    }
