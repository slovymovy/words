                                "target_lang_word": "Death",
                                "target_lang_sense_clarification": "the personified figure"
                            },
                            {
                                "target_lang_word": "the Grim Reaper",
                                "target_lang_sense_clarification": "the skeletal figure with a scythe"
                            }
                        ]
                    }
                }
            ]
        },
        {
