                "senses": [
                    {
                        "sense_id": "da2f5237-bcf8-37cd-9ed6-ff8f840686a2",
                        "entry_id": "69e3ad48-dd47-3699-bd4b-00aef9e1eca9",
                        "glosses": [
                            "in den Straßenbelag eingelassene oder eingefräste Markierung am Fahrbahnrand, welche durch haptische und akustische Signale den Fahrer darauf aufmerksam machen, dass er von der Fahrbahn abkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8424367-3d54-4b2c-b75c-88c48299eade",
                                "sense_id": "da2f5237-bcf8-37cd-9ed6-ff8f840686a2",
                                "text": "„Eine wirksame Maßnahme die Verkehrssicherheit zu steigern, sind z.B.: profilierte Fahrbahnmarkierungen oder Rüttelstreifen auf der Standspur.“"
                            },
                            {
                                "example_id": "d3fb6abc-fdc5-434a-8011-0b177c6088c9",
                                "sense_id": "da2f5237-bcf8-37cd-9ed6-ff8f840686a2",
                                "text": "„Rüttelstreifen am Fahrbahnrand von Autobahnen können die Zahl übermüdungsbedingter Verkehrsunfälle deutlich reduzieren.“"
                            },
                            {
                                "example_id": "81411f84-3b7a-4dc9-8571-a98389d9b5c2",
                                "sense_id": "da2f5237-bcf8-37cd-9ed6-ff8f840686a2",
                                "text": "„Schwere Autobahn-Unfälle können mit Hilfe von sogenannten Rüttelstreifen deutlich verringert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
