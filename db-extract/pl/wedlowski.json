                "senses": [
                    {
                        "sense_id": "2bd175e1-c05e-35a5-9faa-ff6bfd519324",
                        "entry_id": "0e6e255c-bb69-31d1-9703-d1cb2dd49ed9",
                        "glosses": [
                            "związany z firmą E.Wedel, wyprodukowany przez tę firmę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9a592e5-54c8-4e8a-b147-e0e89dd2aaf3",
                                "sense_id": "2bd175e1-c05e-35a5-9faa-ff6bfd519324",
                                "text": "Uwielbiam wedlowskie ptasie mleczko."
                            },
                            {
                                "example_id": "66d1faf2-3ca9-40c2-b44f-797dc5dd313b",
                                "sense_id": "2bd175e1-c05e-35a5-9faa-ff6bfd519324",
                                "text": "Wedlowscy mistrzowie od czekolady przygotowali kilka wielkich, słodkich pisanek"
                            },
                            {
                                "example_id": "af2f086d-d8fc-4116-b29d-d7e372260895",
                                "sense_id": "2bd175e1-c05e-35a5-9faa-ff6bfd519324",
                                "text": "Graficy wedlowscy trochę bardziej poszaleli niż wawelscy, efekt w miarę estetyczny, chociaż i nadmiar chaosu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
