                    {
                        "sense_id": "948a4651-79ec-3741-bc60-6bb2b045dd26",
                        "entry_id": "5a2a5b93-d044-3a3b-a8fc-096a80adff16",
                        "glosses": [
                            "ein Blatt Papier, auf dem man seine Wünsche auflistet (besonders Kinder zu Weihnachten, Geburtstagen oder anderen Festtagen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c76e92cf-1172-40e0-bd6d-b472244bc3fd",
                                "sense_id": "948a4651-79ec-3741-bc60-6bb2b045dd26",
                                "text": "„Sie war fünfzehn, als sie zu Weihnachten auf ihren Wunschzettel schrieb: Die Arnsburg.“"
                            },
                            {
                                "example_id": "029fb619-5720-4cf7-81ca-9a7bd3556cf9",
                                "sense_id": "948a4651-79ec-3741-bc60-6bb2b045dd26",
                                "text": "„Jan Simak steht bei Bundesliga-Clubs auf dem Wunschzettel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
