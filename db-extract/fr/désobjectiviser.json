                ],
                "senses": [
                    {
                        "sense_id": "52469024-1a60-3da3-a75a-8d5bf3edb788",
                        "entry_id": "c1dd1152-5330-38bf-9b7a-113a637c80c6",
                        "glosses": [
                            "Faire perdre son caractère d’objet à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "079a74a3-9418-4a6e-b599-3c32385c8fc3",
                                "sense_id": "52469024-1a60-3da3-a75a-8d5bf3edb788",
                                "text": "Il y a là comme un souci de désindividualiser ou de désobjectiviser l’amour particulier qu’un chevalier peut avoir pour une femme réelle."
                            },
                            {
                                "example_id": "d8a09739-af83-4699-a6da-ffacaefd4bf3",
                                "sense_id": "52469024-1a60-3da3-a75a-8d5bf3edb788",
                                "text": "D’autre part, cette manière d’aborder la maladie vient « désobjectiviser » le cas pathologique que représente Conrad Lang, qui devient un sujet à part entière."
                            },
                            {
                                "example_id": "34f1a306-e8d7-4966-88ec-563b533773dc",
                                "sense_id": "52469024-1a60-3da3-a75a-8d5bf3edb788",
                                "text": "Il fallait les désubstantiviser, les désobjectiviser."
                            }
                        ]
                    },
                    {
                        "sense_id": "214c0517-1267-3d2b-953b-41f3988b74b1",
                        "entry_id": "c1dd1152-5330-38bf-9b7a-113a637c80c6",
                        "glosses": [
                            "Faire perdre son caractère objectif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "245b87b3-cbeb-462d-bec6-e24a2dba93fa",
                                "sense_id": "214c0517-1267-3d2b-953b-41f3988b74b1",
                                "text": "Elle désobjectivise la chaîne sonore, elle désubjectivise la projection d’une ambiance."
                            }
                        ]
                    }
