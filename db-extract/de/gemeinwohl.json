                        "form": "dem Gemeinwohl"
                    },
                    {
                        "form_id": "1250735b-0227-43ea-9d96-6a95197aa4ac",
                        "entry_id": "2f386e97-aec0-3788-837c-4525300ea9e6",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Gemeinwohl"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b887a114-3121-3e4c-b38b-8672f0e867b9",
                        "entry_id": "2f386e97-aec0-3788-837c-4525300ea9e6",
                        "glosses": [
                            "Wohl eines Gemeinwesens, Nutzen für die Allgemeinheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4bec166-afb4-4119-a9dd-7044bbca6f70",
                                "sense_id": "b887a114-3121-3e4c-b38b-8672f0e867b9",
                                "text": "Viele Vereine fühlen sich dem Gemeinwohl verpflichtet."
                            },
                            {
                                "example_id": "66ca1a20-ac88-4629-9e8c-e00c80b68e63",
                                "sense_id": "b887a114-3121-3e4c-b38b-8672f0e867b9",
                                "text": "Eine am Gemeinwohl ausgerichtete Politik fühlt sich zuerst den Schwächsten einer Gesellschaft verpflichtet."
                            },
                            {
                                "example_id": "bb1e8d47-cd7f-4623-8293-6054f02f30b4",
                                "sense_id": "b887a114-3121-3e4c-b38b-8672f0e867b9",
                                "text": "Polizisten, Feuerwehrleute, Müllfahrer, Ärzte, Pflegekräfte, Kindergärtnerinnen, sie alle setzen sich für das Gemeinwohl ein."
                            },
                            {
                                "example_id": "65bbaabc-9c95-4b19-9245-0a921227506e",
                                "sense_id": "b887a114-3121-3e4c-b38b-8672f0e867b9",
                                "text": "„Es ist falsch, anzunehmen, dass der Marktwert dieses oder jenes Jobs als Maß für einen Beitrag zum Gemeinwohl dienen kann.“"
                            },
                            {
                                "example_id": "0b53441a-1242-4490-bc4f-78d8d4dae755",
                                "sense_id": "b887a114-3121-3e4c-b38b-8672f0e867b9",
                                "text": "„In den Augen der Gesellschaft (und vielleicht auch in ihren eigenen) stellte ihre Arbeit keinen wertvollen Beitrag zum Gemeinwohl mehr dar.“"
                            },
                            {
                                "example_id": "bd2b5633-bf1d-41fb-a443-dfedc006272b",
                                "sense_id": "b887a114-3121-3e4c-b38b-8672f0e867b9",
                                "text": "„Nur ein glühender Libertärer würde darauf beharren, dass der Beitrag des reichen Casino-Magnaten zum Gemeinwohl tausendmal mehr wert ist als der eines Kinderarztes.“"
                            },
                            {
                                "example_id": "07eaa77b-c7d7-4d25-b5de-ebc2b0c6e1df",
                                "sense_id": "b887a114-3121-3e4c-b38b-8672f0e867b9",
                                "text": "„Der libanesischen Politik warf Macron Versagen auf allen Ebenen vor. Reformversprechen und Verpflichtungen seien nicht eingehalten worden und statt des Gemeinwohls verfolgten die Politiker Privatinteressen.“"
                            },
                            {
                                "example_id": "0e4f7fea-3c56-4b4e-be6e-3335a428051e",
                                "sense_id": "b887a114-3121-3e4c-b38b-8672f0e867b9",
                                "text": "„In der Politischen Philosophie sodann geht es darum, eine konkrete Koordination von individuellen Handlungen zugleich so zu gestalten, dass dabei ein konkretes Gutes – das Gemeinwohl oder bonum commune – unter Endlichkeitsbedingungen bzw. in Raum und Zeit Wirklichkeit wird: […]“"
                            },
                            {
                                "example_id": "3df65a95-0785-4ae5-a6df-df0dae739ddf",
                                "sense_id": "b887a114-3121-3e4c-b38b-8672f0e867b9",
                                "text": "„Das Gemeinwohl liegt ihm am Herzen, und deshalb hat er seinen Spiralblock aus der Tasche gezogen.“"
                            },
                            {
                                "example_id": "92dfce25-b9d4-48fd-8365-0214de6d4a06",
                                "sense_id": "b887a114-3121-3e4c-b38b-8672f0e867b9",
                                "text": "„Ein Ansatz – der vor allem jenen vertraut ist, die Wirtschaftspolitik betreiben – definiert das Gemeinwohl als die Summe der Vorlieben und Interessen aller. Demzufolge erreichen wir das Gemeinwohl, indem wir das Wohlergehen der Verbraucher maximieren – typischerweise durch größtmögliches Wirtschaftswachstum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
