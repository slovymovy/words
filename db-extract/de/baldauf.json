                ],
                "senses": [
                    {
                        "sense_id": "5053661b-aa0e-3b83-83e4-03cfaa771bb9",
                        "entry_id": "e59365cd-127f-34d0-ae6c-68560a225aa7",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19b6678e-1505-40a2-9e0b-19d5d9b0321d",
                                "sense_id": "5053661b-aa0e-3b83-83e4-03cfaa771bb9",
                                "text": "Baldauf kommt und geht."
                            },
                            {
                                "example_id": "28c2f66f-fc27-4d60-aa9c-fb316105bf87",
                                "sense_id": "5053661b-aa0e-3b83-83e4-03cfaa771bb9",
                                "text": "Baldaufs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "6ad961d1-c2ad-42f0-a6ff-e06a7be7005f",
                                "sense_id": "5053661b-aa0e-3b83-83e4-03cfaa771bb9",
                                "text": "Frau Baldauf ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c466c288-3f4f-4b53-bd65-378539c4ae02",
                                "sense_id": "5053661b-aa0e-3b83-83e4-03cfaa771bb9",
                                "text": "Herr Baldauf wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2e4223f2-9a10-4fe8-b9ba-84ca9633c746",
                                "sense_id": "5053661b-aa0e-3b83-83e4-03cfaa771bb9",
                                "text": "Die Baldaufs kommen heute aus Münster."
                            },
                            {
                                "example_id": "151780e5-4c1a-4b34-94da-d46242bf48f0",
                                "sense_id": "5053661b-aa0e-3b83-83e4-03cfaa771bb9",
                                "text": "Der Baldauf trägt nie die Schals, die die Baldauf ihm strickt."
                            },
                            {
                                "example_id": "2706df92-81b2-46ad-bea5-535144c1aa4e",
                                "sense_id": "5053661b-aa0e-3b83-83e4-03cfaa771bb9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Baldauf kommt, geht der Herr Baldauf.“"
                            },
                            {
                                "example_id": "1ccde143-e91d-4c6e-8410-96ebf7945447",
                                "sense_id": "5053661b-aa0e-3b83-83e4-03cfaa771bb9",
                                "text": "An verregneten Herbsttagen ist Familie Baldaufs liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "87a19bab-62d2-447f-87e8-39358e1d04a4",
                                "sense_id": "5053661b-aa0e-3b83-83e4-03cfaa771bb9",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Baldauf das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
