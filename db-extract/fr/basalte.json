        "fr-extract.jsonl": [
            {
                "entry_id": "7e052567-cb2a-3142-87c7-d40973c176fb",
                "word": "basalte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f1b6f225-030e-4f32-a042-38c5403739ae",
                        "entry_id": "7e052567-cb2a-3142-87c7-d40973c176fb",
                        "tags": [
                            "plural"
                        ],
                        "form": "basaltes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8e4128de-23cc-37fa-a46b-9ea329cddd7c",
                        "entry_id": "7e052567-cb2a-3142-87c7-d40973c176fb",
                        "glosses": [
                            "Roche volcanique mafique, souvent noire, à structure microlithique, compacte, formée d’un agrégat de petits cristaux divers noyés dans un verre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45b99f3e-837c-4591-b7b9-0bba5f4aa65d",
                                "sense_id": "8e4128de-23cc-37fa-a46b-9ea329cddd7c",
                                "text": "Si l'on suit la route de Clermont au Puy, on trouve un grand plateau de basalte dès que l'on a passé Vieille-Brioude. Il commence à la Chomette, et les maisons de ce village sont bâties sur cette roche."
                            },
                            {
                                "example_id": "b6b18c0e-e2b6-404c-9a78-fdd319ebd94b",
                                "sense_id": "8e4128de-23cc-37fa-a46b-9ea329cddd7c",
                                "text": "Dix-sept îles, tufs et basaltes en amas pyramidaux ou étrangement déchiquetés, surgissent de la mer ; piliers immenses, elles supportent les brumes hautes, à moins que, monolithes gigantesques, leurs sommets ne les dominent."
                            },
                            {
                                "example_id": "c76a57b9-b934-4210-872c-0035b9a37145",
                                "sense_id": "8e4128de-23cc-37fa-a46b-9ea329cddd7c",
                                "text": "Des montagnes de basalte noire descendaient verticalement dans la mer […]."
                            },
                            {
                                "example_id": "b0716c98-a949-46d4-be9e-773cdd30fe51",
                                "sense_id": "8e4128de-23cc-37fa-a46b-9ea329cddd7c",
                                "text": "[…], c'est ainsi qu'il n'y a qu'une différence de 50 m entre le basalte de Reilhaguet, d’Onsac et le basalte du pliocène moyen entre la Vaissière et Jussac, qu'il n'y a qu'une petite masse de projections entre le trachyte de Giou-de-Mamou et le basalte du Coyan (Plioc. sup.), que le basalte porphyrique de Sézergues est à peine en contrebas du basalte des plateaux."
                            },
                            {
                                "example_id": "cf3aa953-9d10-4c1c-93f2-0ee7d060db8b",
                                "sense_id": "8e4128de-23cc-37fa-a46b-9ea329cddd7c",
                                "text": "La silhouette de ce géant de basalte, planté comme une borne monstrueuse au milieu du Pacifique, était restée dans sa tête, seule image de sa patrie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40de7794-89ef-47ab-b4fa-1e20ee141dd8",
                        "source_entry_id": "7e052567-cb2a-3142-87c7-d40973c176fb",
                        "source_sense_id": "8e4128de-23cc-37fa-a46b-9ea329cddd7c",
                        "target_lang_word": "Basalt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Basalt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef0bdd93-2509-3cb0-9b7a-bbe05304ee34",
                                        "entry_id": "5aef8845-2acb-38e6-a526-7e0e321554e1",
                                        "glosses": [
                                            "dunkles, sehr hartes Gestein vulkanischen Ursprungs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f83ae79e-4dc9-43b9-a50c-9e566148bddb",
                                                "sense_id": "ef0bdd93-2509-3cb0-9b7a-bbe05304ee34",
                                                "text": "„Bekanntlich bildet der Basalt, ein braunes vulkanisches Gestein, oft Formen von überraschender Eigentümlichkeit.“"
                                            },
                                            {
                                                "example_id": "8231ddeb-573c-40eb-8d1f-df152a2d2b44",
                                                "sense_id": "ef0bdd93-2509-3cb0-9b7a-bbe05304ee34",
                                                "text": "„Das mächtige Kreuz vor der Kirche, von Steinmetzen aus heimischem Basalt gehauen, imponiert durch seine monumentale Größe ebenso wie durch seine Aussagekraft als Mahnmal für die Toten der beiden Weltkriege des 20. Jahrhunderts (…).“"
                                            },
                                            {
                                                "example_id": "78ab0ea6-1e59-4746-adab-1a19f0275b68",
                                                "sense_id": "ef0bdd93-2509-3cb0-9b7a-bbe05304ee34",
                                                "text": "„Bereits in der Jungsteinzeit entdeckte man die hervorragende Eignung des hiesigen Basalts für das Mahlen von Getreide.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
