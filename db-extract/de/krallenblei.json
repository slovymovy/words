                ],
                "senses": [
                    {
                        "sense_id": "af6930e0-17de-33d9-952e-c05b8773a087",
                        "entry_id": "aa4df599-e117-3eaa-bd31-92ef4e654b7e",
                        "glosses": [
                            "tropfenförmiges Blei, mit vier klappbaren oder aufbiegbaren Drahtarmen, hält bei starker Strömung den beköderten Haken fest am Grund"
                        ],
                        "tags": [
                            "Angelsport",
                            "Brandungsangeln"
                        ],
                        "examples": [
                            {
                                "example_id": "62bdfd03-980c-48d5-b79a-d80287e99540",
                                "sense_id": "af6930e0-17de-33d9-952e-c05b8773a087",
                                "text": "Das Krallenblei hielt den Köder trotz starker Strömung fest am Grund."
                            },
                            {
                                "example_id": "2df9c927-3128-475d-a680-8919aa4f9192",
                                "sense_id": "af6930e0-17de-33d9-952e-c05b8773a087",
                                "text": "„Am Anfang mögen 80 Gramm reichen, doch wenn der Wind und die Strömung zulegen sind ganz schnell 200 Gramm schwere Krallenbleie notwendig.“"
                            },
                            {
                                "example_id": "8c2a9949-3610-415c-bd6f-0bb70da2897f",
                                "sense_id": "af6930e0-17de-33d9-952e-c05b8773a087",
                                "text": "„Diese Krallenbleie halten durch die Drähte am unteren Ende auch bei starker Strömung ihre Position.“"
                            },
                            {
                                "example_id": "39685b84-6e8c-4f55-999a-1032f752df9a",
                                "sense_id": "af6930e0-17de-33d9-952e-c05b8773a087",
                                "text": "„Was für die glatten Wurfgewichte in Hinsicht auf das Wurfverhalten mit und ohne Führungsstange gilt, zählt gleichermaßen auch für die Krallenbleie.“"
                            },
                            {
                                "example_id": "0ec878e0-2bc6-407d-8aae-3231714e45b8",
                                "sense_id": "af6930e0-17de-33d9-952e-c05b8773a087",
                                "text": "„Beim Brandungsangeln verwenden wir ein Krallenblei, dessen eingegossene und umgebogene Drähte sich wie ein Anker in den Sand krallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
