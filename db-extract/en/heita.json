                        "examples": [
                            {
                                "example_id": "58450c1f-366c-4e03-bc47-5917b0a56ada",
                                "sense_id": "3adecdc1-5a9f-3594-9377-f652662f0a0d",
                                "text": "I can hear the conversation: \"Heita, bra. Let's go. We don't need bullets.\""
                            },
                            {
                                "example_id": "2ab44fd2-7e25-4ab0-8c60-726c8ae58783",
                                "sense_id": "3adecdc1-5a9f-3594-9377-f652662f0a0d",
                                "text": "‘Het ou Pellie!’ I suppose that is the most typical of the popular greetings that belong essentially to Cape Town; but the origin would be hard to trace. One expert thinks it falls into the Malay-Portuguese group."
                            },
                            {
                                "example_id": "7801596d-f8e2-4762-8e9c-0e751633a2f8",
                                "sense_id": "3adecdc1-5a9f-3594-9377-f652662f0a0d",
                                "text": "‘Heita’ is a popular greeting used by the mapantsula. It simply means ‘hello’. Of course, one can go further by saying ‘Heita hoezet majita?’ (Hello, how are you, friends?)."
                            }
                        ]
                    }
