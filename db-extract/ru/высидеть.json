                            },
                            {
                                "target_word": "hatch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a6fe80b-582c-3782-b5f3-211f1c26af3f",
                                        "entry_id": "10faa4f2-23e7-3195-a1e3-e1a972b357c3",
                                        "glosses": [
                                            "To emerge from an egg."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5c181e2-b364-46c3-92a0-cf8be504fdaf",
                                                "sense_id": "7a6fe80b-582c-3782-b5f3-211f1c26af3f",
                                                "text": "These three chicks hatched yesterday morning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb59e9ef-b476-398d-bac3-9c6102a45acb",
                                        "entry_id": "10faa4f2-23e7-3195-a1e3-e1a972b357c3",
                                        "glosses": [
                                            "To break open when a young animal emerges from it."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06fd90cd-7699-47de-b7b0-4a231e905e0e",
                                                "sense_id": "cb59e9ef-b476-398d-bac3-9c6102a45acb",
                                                "text": "She was delighted when she heard the crackling sound of the eggs hatching."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07f72e01-df88-320f-89e5-a46f715491bc",
                                        "entry_id": "10faa4f2-23e7-3195-a1e3-e1a972b357c3",
                                        "glosses": [
                                            "To incubate eggs; to cause to hatch."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fecd727-746f-4add-b5d4-0b7d07a823ee",
                                                "sense_id": "07f72e01-df88-320f-89e5-a46f715491bc",
                                                "text": "I'm hatching this mysterious egg I found in the forest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e92e3de2-0014-307b-89a4-87e40036a7ba",
                                        "entry_id": "10faa4f2-23e7-3195-a1e3-e1a972b357c3",
                                        "glosses": [
                                            "To devise (a plot or scheme)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2e540ea-cc44-49cb-b58a-179e76e4b523",
                                                "sense_id": "e92e3de2-0014-307b-89a4-87e40036a7ba",
                                                "text": "World domination was only one of the evil schemes he had hatched over the years."
                                            },
                                            {
                                                "example_id": "bb7cbca5-7ce6-4ca5-84a2-33cf870f838a",
                                                "sense_id": "e92e3de2-0014-307b-89a4-87e40036a7ba",
                                                "text": "As for Cersei, pretending to work with her enemies while secretly hatching some grander scheme was pretty much what I expected for the truce going into it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hatch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b27e3664-74ea-3866-afbf-74405321bb0a",
                                        "entry_id": "9453d5a6-fbef-3dfb-a443-793d8befea75",
                                        "glosses": [
                                            "The act of hatching."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6bf7a21-9df6-3ba6-8dd3-328b62353cde",
                                        "entry_id": "9453d5a6-fbef-3dfb-a443-793d8befea75",
                                        "glosses": [
                                            "Development; disclosure; discovery."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b69de21-51f4-4bba-b19f-b263e96c9231",
                                                "sense_id": "b6bf7a21-9df6-3ba6-8dd3-328b62353cde",
                                                "text": "There's ſomething in his ſoule? / O'er which his Melancholly ſits on brood, / And I do doubt the hatch, and the diſcloſe / Will be ſome danger, which to preuent / I haue in quicke determination"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bd4b057-3ce6-38c7-a316-4207d680999e",
                                        "entry_id": "9453d5a6-fbef-3dfb-a443-793d8befea75",
                                        "glosses": [
                                            "A group of birds that emerged from eggs at a specified time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e8664e0-6a4d-4b68-985e-d9d86eea5602",
                                                "sense_id": "4bd4b057-3ce6-38c7-a316-4207d680999e",
                                                "text": "These pullets are from an April hatch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8873b416-6015-3c30-9bd4-dd89b88ffa28",
                                        "entry_id": "9453d5a6-fbef-3dfb-a443-793d8befea75",
                                        "glosses": [
                                            "The phenomenon, lasting 1–2 days, of large clouds of mayflies appearing in one location to mate, having reached maturity."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07936ee8-4c4f-4b86-8d83-dd00437bc10c",
                                                "sense_id": "8873b416-6015-3c30-9bd4-dd89b88ffa28",
                                                "text": "a. 1947, Edward R. Hewitt, quoted in 1947, Charles K. Fox, Redistribution of the Green Drake, 1997, Norm Shires, Jim Gilford (editors), Limestone Legends, page 104,\nThe Willowemoc above Livington Manor had the largest mayfly hatch I ever knew about fifty years ago."
                                            },
                                            {
                                                "example_id": "ad12d8d4-d9c2-48ff-a449-3ce8c68ae895",
                                                "sense_id": "8873b416-6015-3c30-9bd4-dd89b88ffa28",
                                                "text": "The major application of the parachute is for mayfly hatches, but it's also useful for midge hatches."
                                            },
                                            {
                                                "example_id": "e51cd248-c970-4488-a1e2-1198ee7ab9ba",
                                                "sense_id": "8873b416-6015-3c30-9bd4-dd89b88ffa28",
                                                "text": "Many years the mayfly hatch begins by the time the lake opens in April. Otherwise, expect strong hatches by mid-May. The hatches continue through midsummer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6764cc7d-74f2-36af-a593-b7892311347c",
                                        "entry_id": "9453d5a6-fbef-3dfb-a443-793d8befea75",
                                        "glosses": [
                                            "A birth, the birth records (in the newspaper)."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b022fc2-32f2-4756-8845-c8e8305050ca",
                                                "sense_id": "6764cc7d-74f2-36af-a593-b7892311347c",
                                                "text": "hatch, match, and dispatch"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hatch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "875353d9-803d-3490-a35c-1ab6f72577ff",
                                        "entry_id": "8a435a94-17e4-36ed-91b0-37da80262604",
                                        "glosses": [
                                            "To shade an area of (a drawing, diagram, etc.) with fine parallel lines, or with lines which cross each other (crosshatch)."
                                        ],
                                        "tags": [
