                "senses": [
                    {
                        "sense_id": "93375659-bc15-3029-8679-f68d11f2e5de",
                        "entry_id": "a2eed94a-2459-39b8-a07a-21f7a8b483d3",
                        "glosses": [
                            "Gesamtheit der Eigenschaften von jemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93bad11f-2643-487f-8f15-a0818eea7ea5",
                                "sense_id": "93375659-bc15-3029-8679-f68d11f2e5de",
                                "text": "„Es ist wahr, daß jeder Stamm in seiner Wesenheit von den anderen kritisiert und angegriffen wird.“"
                            },
                            {
                                "example_id": "b9d391e6-942c-4d74-b38b-08dacde7c844",
                                "sense_id": "93375659-bc15-3029-8679-f68d11f2e5de",
                                "text": "„Auf dem Heimweg überlegte ich, daß alles, was Jussuf mir über die Wesenheit Gottes gesagt hatte, durchaus richtig sein konnte, denn sicherlich konnte der Urgrund alles Seins seiner Wesenheit nach nur das einfachste aller Wesen sein.“"
                            }
                        ],
