                        "examples": [
                            {
                                "example_id": "9158a7a4-8a6e-4331-bb39-d2ca7274b440",
                                "sense_id": "c902bc08-545b-3afa-9df0-9d98deb29973",
                                "text": "Ayant parlé, le puant Hérode bailla un coup de pied amical dans le bedon de Lamprido et s’en retourna à son amphore, y dégargouiller un nouveau torrent de fiel."
                            },
                            {
                                "example_id": "07d4d758-b33b-461c-a477-e10eb4de4ac3",
                                "sense_id": "c902bc08-545b-3afa-9df0-9d98deb29973",
                                "text": "Il leur envoya le « Lapin d’ma sœur » , une romance à dégargouiller la rate de trente-six escadrons."
                            },
                            {
                                "example_id": "e6b59a47-b7e9-4b83-89eb-e7a9fe60ab3b",
                                "sense_id": "c902bc08-545b-3afa-9df0-9d98deb29973",
                                "text": "Il dégargouille ses textes en homme passionné de son sujet."
                            },
                            {
                                "example_id": "ac8390ec-b27e-4aa1-b3a6-de91a74fa30b",
                                "sense_id": "c902bc08-545b-3afa-9df0-9d98deb29973",
                                "text": "Les uns jobbent, les autres se dégargouillent: ainsi naît le Mouktali !"
                            }
                        ]
                    }
