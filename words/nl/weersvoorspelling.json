            "senses": [
                {
                    "sense_id": "9030d953-66ef-3569-bcca-02542ff1f4b9",
                    "sense_definition": "De voorspelling van het verwachte weer voor de komende tijd.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "weerbericht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Volgens de <w>weersvoorspelling</w> wordt het morgen een zonnige dag.",
                            "target_lang_translations": {
                                "ru": "Согласно <w>прогнозу погоды</w>, завтра будет солнечный день."
                            }
                        },
                        {
                            "text": "Ik kijk elke ochtend naar de <w>weersvoorspelling</w> op televisie.",
                            "target_lang_translations": {
                                "ru": "Я каждое утро смотрю <w>прогноз погоды</w> по телевизору."
                            }
                        }
                    ],
                    "synonyms": [
                        "weersverwachting",
                        "weerbericht"
                    ],
                    "common_phrases": [
                        "weersvoorspelling bekijken",
                        "betrouwbare weersvoorspelling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прогноз ожидаемой погоды на ближайшее время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогноз погоды",
                                "target_lang_sense_clarification": "наиболее распространенный термин для сообщения о погоде"
                            },
                            {
                                "target_lang_word": "метеопрогноз",
                                "target_lang_sense_clarification": "более формальный или технический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80da48b1-7ac2-30a5-a404-66178309eb57",
                    "sense_definition": "Het proces of de wetenschap van het voorspellen van het weer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weerbericht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moderne technologie heeft de <w>weersvoorspelling</w> aanzienlijk verbeterd.",
                            "target_lang_translations": {
