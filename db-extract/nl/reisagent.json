                        "entry_id": "8cc4bf0c-0a5d-3325-a995-b5c431eec946",
                        "glosses": [
                            "persoon die bij een reisbureau werkt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "dd3ec773-c1c7-4763-a97c-b02b12ac9442",
                                "sense_id": "bc522d2c-7d99-355e-a3c0-2b7708b80cb7",
                                "text": "In 2004 staat hij op het punt om een opleiding tot reisagent te gaan volgen, maar hij is ook depressief."
                            }
                        ]
                    },
                    {
                        "sense_id": "a52a2896-c801-35b5-9e4e-2468428f5826",
                        "entry_id": "8cc4bf0c-0a5d-3325-a995-b5c431eec946",
                        "glosses": [
                            "onderneming waar mensen die een reis willen maken transport en overnachtingen kunnen boeken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8274cd43-0a73-433e-a8f3-cd5be6393890",
                                "sense_id": "a52a2896-c801-35b5-9e4e-2468428f5826",
                                "text": "De consument kan worden misleid door vergelijkingswebsites die vooringenomen zijn in hun beoordelingen, of ondoorzichtige prijzen hanteren. De ondernemingen in kwestie moeten zich, net als een reisagent, houden aan de Europese consumentenregelgeving."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b8fb809-c3de-32fa-943b-b9f6cd1c6e61",
                        "entry_id": "8cc4bf0c-0a5d-3325-a995-b5c431eec946",
                        "glosses": [
                            "tussenpersoon voor mensensmokkelaars"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba505cba-f434-4870-b310-8623c8f2f076",
                                "sense_id": "0b8fb809-c3de-32fa-943b-b9f6cd1c6e61",
                                "text": "Mirwais’ vader houdt hem vijf dagen binnen. De vijfde nacht, rond twee uur, komt er een taxi. Zijn ‘reisagent’ stelt zich voor als Matin. Hij gaat je naar een veilige plek brengen, zegt zijn vader. Mirwais weet niet dat zijn eindbestemming Europa is."
                            }
                        ]
                    }
