{
    "word_family": [
        "malign",
        "malignancy",
        "malignantly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d2ad4f0b-aa82-3592-9bc9-615205b67f33",
                    "sense_definition": "Tending to produce death or serious illness; threatening a fatal outcome.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor confirmed that the patient had a <w>malignant</w> tumor that required immediate surgery.",
                            "target_lang_translations": {
                                "zh": "医生确认病人患有<w>恶性</w>肿瘤，需要立即手术。"
                            }
                        },
                        {
                            "text": "Early detection is crucial when dealing with <w>malignant</w> diseases.",
                            "target_lang_translations": {
                                "zh": "在处理<w>恶性</w>疾病时，早期发现至关重要。"
                            }
                        }
                    ],
                    "antonyms": [
                        "benign",
                        "non-malignant"
                    ],
                    "common_phrases": [
                        "malignant tumor",
                        "malignant disease"
                    ],
                    "target_lang_definitions": {
                        "zh": "指疾病具有致命性或严重威胁生命，常用于医学领域。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "恶性",
                                "target_lang_sense_clarification": "指肿瘤或疾病具有侵袭性，会扩散或危及生命。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c949b738-fdd7-387e-8179-3c883754bf3b",
                    "sense_definition": "Extremely harmful, malevolent, or showing a desire to cause injury.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known for his <w>malignant</w> temper and often lashed out at his colleagues.",
                            "target_lang_translations": {
                                "zh": "他以<w>恶毒</w>的脾气著称，经常对同事发火。"
                            }
                        },
                        {
                            "text": "The politician spread <w>malignant</w> rumors to destroy his opponent's reputation.",
                            "target_lang_translations": {
                                "zh": "这位政客散布<w>恶毒</w>的谣言以摧毁对手的名誉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "malevolent",
                        "harmful"
                    ],
                    "common_phrases": [
                        "malignant influence",
                        "malignant intent"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容极其有害、心怀恶意或意图造成伤害。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "恶毒",
                                "target_lang_sense_clarification": "形容言行或意图极其阴险、有害。"
                            },
                            {
                                "target_lang_word": "有害",
                                "target_lang_sense_clarification": "指具有破坏性或负面影响。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af36471c-89e6-3e86-bfd2-0888c33e3bf4",
                    "sense_definition": "A person who is hostile, destructive, or harmful to society.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author described the dictator as a <w>malignant</w> who sought only to divide the nation.",
                            "target_lang_translations": {
                                "zh": "作者将这位独裁者描述为一个只会分裂国家的<w>祸害</w>。"
                            }
                        },
                        {
                            "text": "History often remembers such <w>malignants</w> as figures who caused great suffering to their people.",
                            "target_lang_translations": {
                                "zh": "历史往往将这些<w>祸害</w>铭记为给人民带来巨大苦难的人物。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指对社会具有敌意、破坏性或危害性的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "祸害",
                                "target_lang_sense_clarification": "指给社会或他人带来严重灾难或伤害的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "659c1e3e-74c7-3fd3-a3af-678fdd5e7904",
                    "sense_definition": "A supporter of King Charles I during the English Civil War.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "During the conflict, the term <w>malignant</w> was used by Parliamentarians to label Royalist soldiers.",
                            "target_lang_translations": {
                                "zh": "在冲突期间，议会派使用“<w>保皇党人</w>”一词来标记保皇派士兵。"
                            }
                        },
                        {
                            "text": "Many <w>malignants</w> lost their lands and titles after the defeat of the monarchy.",
                            "target_lang_translations": {
                                "zh": "君主制战败后，许多<w>保皇党人</w>失去了他们的土地和头衔。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to a specific historical context."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "英国内战期间，议会派对查理一世支持者的称呼。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "保皇党人",
                                "target_lang_sense_clarification": "指英国内战时期支持君主制的特定历史群体。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}