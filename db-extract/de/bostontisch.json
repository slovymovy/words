                ],
                "senses": [
                    {
                        "sense_id": "4d17a3d8-f2ef-39a6-88d1-d8e968188ef7",
                        "entry_id": "96454fc0-3e8a-3b68-a520-c2a9b2c84604",
                        "glosses": [
                            "Tisch, an dem das Kartenspiel Boston gespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "238f1c84-21b8-4e07-91b0-fd1eac70f5b3",
                                "sense_id": "4d17a3d8-f2ef-39a6-88d1-d8e968188ef7",
                                "text": "„Die Bostontische wurden aufgestellt, es bildeten sich Gruppen von Spielern, und die Gäste des Grafen verteilten sich auf die beiden Salons, das Diwanzimmer und die Bibliothek.“"
                            },
                            {
                                "example_id": "a112868d-78bc-491a-9a79-96f84c94edd0",
                                "sense_id": "4d17a3d8-f2ef-39a6-88d1-d8e968188ef7",
                                "text": "„Und nu denke dir einen Bostontisch und Mutter mit der Landrätin zusammen.“"
                            },
                            {
                                "example_id": "ce0da0b7-74db-4382-8d87-43b56d2c5b32",
                                "sense_id": "4d17a3d8-f2ef-39a6-88d1-d8e968188ef7",
                                "text": "„Beide lebten denn auch ein ebenso kameradschaftliches wie zwangloses Leben, in dem jeder seiner Lust und Laune nachhing und kein andres Haus- oder Tagesgesetz anerkannte wie rechtzeitiges Erscheinen am Mittags- und abends am Bostontisch.“"
                            },
                            {
                                "example_id": "dfd80ced-bac7-4fd4-94fe-d48018988351",
                                "sense_id": "4d17a3d8-f2ef-39a6-88d1-d8e968188ef7",
                                "text": "„Wieder im Hause, hatten sich die jungen Leute erst zu Pfänderspielen, dann für einen Tanz entschieden, aus dem mehrere wurden, die Frau Moorbeck am Flügel festhielten, während die älteren Herren ihre Bostontische aufgesucht hatten, ohne die, wie der Kommerzienrat den Major von Groß belehrte, eine regelrechte Useliner Gesellschaft überhaupt nicht denkbar sei.“"
                            },
                            {
                                "example_id": "4cb03f0a-fc83-4784-9a75-27de4be4c0f0",
                                "sense_id": "4d17a3d8-f2ef-39a6-88d1-d8e968188ef7",
                                "text": "„Und sie erhob sich nicht ohne Anstrengung, was das allgemeine Signal war, zu den Bostontischen zu schreiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
