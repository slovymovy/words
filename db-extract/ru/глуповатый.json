                                    },
                                    {
                                        "sense_id": "0ffb2f45-e464-38f1-8872-60969cfdbe51",
                                        "entry_id": "0f72d58f-f431-391d-a81c-3de20b6a01aa",
                                        "glosses": [
                                            "Por extensión, carente de lógica, razón o coherencia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07992733-d6c6-46a5-9103-000b3cca4e40",
                                                "sense_id": "0ffb2f45-e464-38f1-8872-60969cfdbe51",
                                                "text": "Consumir drogas es una manera estúpida de eludir las responsabilidades"
                                            }
