                        "glosses": [
                            "Caractère de ce qui n’est pas prouvé être impossible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b29ce2-df61-44a3-88e4-9138bb4441c1",
                                "sense_id": "3cc8f11a-22a1-375b-a76a-aa6a34fe42e6",
                                "text": "Seule cette non-impossibilité, cette non-contradiction constitue ontologiquement le possible."
                            },
                            {
                                "example_id": "00aaab8d-2288-495b-b2f1-8b80cacc7f52",
                                "sense_id": "3cc8f11a-22a1-375b-a76a-aa6a34fe42e6",
                                "text": "La non-impossibilité n’est pas un argument d’existence"
                            },
                            {
                                "example_id": "ed452f0d-61a1-417f-a135-370d7006b0eb",
                                "sense_id": "3cc8f11a-22a1-375b-a76a-aa6a34fe42e6",
                                "text": "Qu’un tel caractère « filial » ne soit pas impossible dans une créature, on peut l’entrevoir en songeant à ce qu’est l’incarnation : ce qui fait la non-impossibilité de l’une fait la non-impossibilité de l’autre."
                            }
                        ]
