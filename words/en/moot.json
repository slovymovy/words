{
    "word_family": [
        "mooter",
        "mootable",
        "mootness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b6590751-7a4a-3a21-b47b-825d8b13d884",
                    "sense_definition": "Having no practical consequence or relevance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relevance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Whether we should have taken the train or the bus is now a <w>moot</w> point since we missed both.",
                            "target_lang_translations": {
                                "ru": "Вопрос о том, стоило ли нам ехать на поезде или на автобусе, теперь <w>не имеет значения</w>, так как мы опоздали и на то, и на другое."
                            }
                        },
                        {
                            "text": "The judge decided that the legal challenge was <w>moot</w> because the law had already been repealed.",
                            "target_lang_translations": {
                                "ru": "Судья решил, что судебный иск <w>утратил смысл</w>, поскольку закон уже был отменен."
                            }
                        }
                    ],
                    "synonyms": [
                        "irrelevant"
                    ],
                    "antonyms": [
                        "relevant",
                        "significant"
                    ],
                    "common_phrases": [
                        "moot point"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий практического значения или актуальности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бессмысленный",
                                "target_lang_sense_clarification": "не имеющий значения"
                            },
                            {
                                "target_lang_word": "неактуальный",
                                "target_lang_sense_clarification": "потерявший смысл"
                            },
                            {
                                "target_lang_word": "теоретический",
                                "target_lang_sense_clarification": "не имеющий практического применения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04a91b49-62c3-37a2-86fa-0ed8a70f9cf7",
                    "sense_definition": "Subject to discussion; arguable, debatable, or unsolved.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "discussion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It remains a <w>moot</w> point whether the new policy will actually improve the economy.",
                            "target_lang_translations": {
                                "ru": "Вопрос о том, улучшит ли новая политика экономику на самом деле, остается <w>спорным</w>."
                            }
                        },
                        {
                            "text": "The extent of his involvement in the scandal is still very <w>moot</w> among historians.",
                            "target_lang_translations": {
                                "ru": "Степень его причастности к скандалу до сих пор является предметом жарких <w>дискуссий</w> среди историков."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "certain",
                        "settled"
                    ],
                    "common_phrases": [
                        "moot point"
                    ],
                    "target_lang_definitions": {
                        "ru": "Являющийся предметом обсуждения; спорный, дискуссионный или нерешенный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спорный",
                                "target_lang_sense_clarification": "вызывающий разногласия"
                            },
                            {
                                "target_lang_word": "дискуссионный",
                                "target_lang_sense_clarification": "подлежащий обсуждению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7ec80d0-9e11-3296-82cf-030b9dbf6d55",
                    "sense_definition": "Being an exercise of thought; academic.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "discussion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor engaged the students in a <w>moot</w> discussion about hypothetical legal scenarios.",
                            "target_lang_translations": {
                                "ru": "Профессор вовлек студентов в <w>академическую</w> дискуссию о гипотетических юридических сценариях."
                            }
                        },
                        {
                            "text": "While the theory is interesting, its application remains purely <w>moot</w> in a real-world setting.",
                            "target_lang_translations": {
                                "ru": "Хотя теория интересна, ее применение в реальных условиях остается чисто <w>теоретическим</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "practical"
                    ],
                    "target_lang_definitions": {
                        "ru": "Являющийся упражнением для ума; академический или гипотетический."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "академический",
                                "target_lang_sense_clarification": "чисто теоретический"
                            },
                            {
                                "target_lang_word": "гипотетический",
                                "target_lang_sense_clarification": "предположительный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0579f189-3f92-3fbc-a274-9b67861c9209",
                    "sense_definition": "To bring up as a subject for debate or discussion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discussion_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The idea of a four-day work week was <w>mooted</w> during the last board meeting.",
                            "target_lang_translations": {
                                "ru": "Идея четырехдневной рабочей недели была <w>вынесена на обсуждение</w> во время последнего заседания совета директоров."
                            }
                        },
                        {
                            "text": "Several different solutions were <w>mooted</w> before the committee reached a final decision.",
                            "target_lang_translations": {
                                "ru": "Прежде чем комитет принял окончательное решение, было <w>предложено</w> несколько различных вариантов."
                            }
                        }
                    ],
                    "synonyms": [
                        "propose"
                    ],
                    "antonyms": [
                        "withdraw",
                        "suppress"
                    ],
                    "common_phrases": [
                        "mooted the idea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выносить на обсуждение или дебаты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставить вопрос на обсуждение",
                                "target_lang_sense_clarification": "предлагать тему"
                            },
                            {
                                "target_lang_word": "выносить на обсуждение",
                                "target_lang_sense_clarification": "предлагать для дебатов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a29f169a-efd3-3282-b7d2-ec9590bc806c",
                    "sense_definition": "To discuss or debate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "discussion_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The council spent hours <w>mooting</w> the potential impact of the new construction project.",
                            "target_lang_translations": {
                                "ru": "Совет часами <w>обсуждал</w> потенциальное влияние нового строительного проекта."
                            }
                        },
                        {
                            "text": "It is a problem that has been frequently <w>mooted</w> in academic circles but never solved.",
                            "target_lang_translations": {
                                "ru": "Это проблема, которая часто <w>дискутировалась</w> в академических кругах, но так и не была решена."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обсуждать или вести дебаты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обсуждать",
                                "target_lang_sense_clarification": "рассматривать вопрос"
                            },
                            {
                                "target_lang_word": "дискутировать",
                                "target_lang_sense_clarification": "вести спор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee01060d-7617-3d68-baf0-ac0a98aed05d",
                    "sense_definition": "To make or declare irrelevant.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "relevance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden settlement of the lawsuit <w>mooted</w> the need for further testimony.",
                            "target_lang_translations": {
                                "ru": "Внезапное урегулирование иска <w>сделало ненужными</w> дальнейшие свидетельские показания."
                            }
                        },
                        {
                            "text": "New evidence has effectively <w>mooted</w> the original arguments presented by the defense.",
                            "target_lang_translations": {
                                "ru": "Новые улики фактически <w>аннулировали</w> первоначальные аргументы защиты."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать или объявлять не имеющим значения или неактуальным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аннулировать",
                                "target_lang_sense_clarification": "лишать актуальности"
                            },
                            {
                                "target_lang_word": "делать неактуальным",
                                "target_lang_sense_clarification": "лишать практического смысла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d3ba88d-107a-3446-ad6f-d62b5cc401fe",
                    "sense_definition": "To argue or plead in a hypothetical or supposed case.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_exercise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Law students often spend their evenings <w>mooting</w> complex cases to prepare for their careers.",
                            "target_lang_translations": {
                                "ru": "Студенты-юристы часто проводят вечера, <w>разбирая в учебном суде</w> сложные дела, чтобы подготовиться к карьере."
                            }
                        },
                        {
                            "text": "The competition involved <w>mooting</w> a case regarding international maritime law.",
                            "target_lang_translations": {
                                "ru": "Соревнование включало <w>учебное разбирательство</w> дела, касающегося международного морского права."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аргументировать или защищать позицию в гипотетическом судебном деле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "участвовать в учебном суде",
                                "target_lang_sense_clarification": "разбирать гипотетическое дело"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
