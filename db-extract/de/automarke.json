                            {
                                "example_id": "d7f61a1e-48dd-4a52-af7b-71e914544c8e",
                                "sense_id": "3e4204de-a08c-3f0f-9c57-6bcbac137d80",
                                "text": "Mein Vater mag sehr gerne die Automarke BMW, meinem Bruder gefällt Mercedes."
                            },
                            {
                                "example_id": "6b370a48-7697-4141-8565-f6e2efce8c71",
                                "sense_id": "3e4204de-a08c-3f0f-9c57-6bcbac137d80",
                                "text": "Lass uns Stadt-Land-Fluss zusätzlich mit Automarken spielen."
                            },
                            {
                                "example_id": "6d9df668-3c16-44bd-b959-bc8d3da43dfe",
                                "sense_id": "3e4204de-a08c-3f0f-9c57-6bcbac137d80",
                                "text": "„Er machte eine Handbewegung, die den Innenraum des Wagens umfasste, und ich verstand, dass er über die Automarke sprechen musste.“"
                            }
                        ],
