                                "en": "We live one floor <w>below</w>, so we hear every noise.",
                                "nl": "Wij wonen een verdieping <w>beneden</w>, dus we horen elk geluid.",
                                "de": "Wir wohnen eine Etage <w>unter</w> uns, deshalb hören wir jedes Geräusch.",
                                "fr": "Nous habitons un étage <w>en dessous</w>, donc nous entendons chaque bruit.",
                                "it": "Abitiamo un piano <w>di sotto</w>, quindi sentiamo ogni rumore.",
                                "cs": "Bydlíme o patro <w>níže</w>, takže slyšíme každý hluk.",
                                "tr": "Bir kat <w>aşağıda</w> oturuyoruz, bu yüzden her gürültüyü duyuyoruz.",
                                "es": "Vivimos un piso <w>más abajo</w>, así que oímos cada ruido.",
                                "zh": "我们住在楼下，所以能听到每一个噪音。"
                            }
                        },
                        {
                            "text": "Spójrz <w>poniżej</w>, a zobaczysz płynącą rzekę.",
                            "target_lang_translations": {
                                "ru": "Посмотри <w>ниже</w>, и увидишь текущую реку.",
                                "en": "Look <w>below</w> and you will see the river flowing.",
                                "nl": "Kijk <w>beneden</w> en je zult de rivier zien stromen.",
                                "de": "Schau <w>nach unten</w>, dann siehst du den fließenden Fluss.",
                                "fr": "Regarde <w>plus bas</w> et tu verras la rivière qui coule.",
                                "it": "Guarda <w>più in basso</w> e vedrai il fiume che scorre.",
                                "cs": "Podívej se <w>níže</w> a uvidíš tekoucí řeku.",
                                "tr": "<w>Aşağıya</w> bak, akan nehri göreceksin.",
                                "es": "Mira <w>abajo</w> y verás el río fluyendo.",
                                "zh": "往<w>下面</w>看，你就能看到流动的河水。"
                            }
                        }
