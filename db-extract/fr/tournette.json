        "fr-extract.jsonl": [
            {
                "entry_id": "bdcb53cd-0625-3e14-ba55-cf6a88ae03e9",
                "word": "tournette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8803b839-78f7-4de1-9f90-b0d08d7968a7",
                        "entry_id": "bdcb53cd-0625-3e14-ba55-cf6a88ae03e9",
                        "tags": [
                            "plural"
                        ],
                        "form": "tournettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7ed8fe8-231d-3431-970f-3ed11d9c5b25",
                        "entry_id": "bdcb53cd-0625-3e14-ba55-cf6a88ae03e9",
                        "glosses": [
                            "Dispositif rotatif."
                        ],
                        "tags": [
                            "generically"
                        ],
                        "examples": [
                            {
                                "example_id": "9b3ae178-381c-4f4e-8e44-9f826f9d63f6",
                                "sense_id": "f7ed8fe8-231d-3431-970f-3ed11d9c5b25",
                                "text": "Dans l’étape suivante, on a la « tournette », plateau, qui, cette fois, présente à sa face inférieure une cupule s’adaptant sur un pivot fixe."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f383c12-d08f-3b3d-9274-dd2c2e565a3f",
                        "entry_id": "bdcb53cd-0625-3e14-ba55-cf6a88ae03e9",
                        "glosses": [
                            "Plan de travail rotatif, sur lequel est posée la sculpture lors de sa création."
                        ],
                        "tags": [
                            "Sculpture",
                            "Poterie",
                            "Modelage"
                        ],
                        "examples": [
                            {
                                "example_id": "f1b4becd-a935-4d9b-a8f2-c99cdf1479f8",
                                "sense_id": "3f383c12-d08f-3b3d-9274-dd2c2e565a3f",
                                "text": "Ces cuviers sont fabriqués au colombin, par des femmes sur une espèce de tournette."
                            }
                        ]
                    },
                    {
                        "sense_id": "510979ff-8a5b-3bc1-aa2d-540421e533d4",
                        "entry_id": "bdcb53cd-0625-3e14-ba55-cf6a88ae03e9",
                        "glosses": [
                            "Roulette coupante utilisée en vitrerie, reliure, cuisine, …"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "206a4019-4a78-4e1f-a08f-da91658bdb2d",
                                "sense_id": "510979ff-8a5b-3bc1-aa2d-540421e533d4",
                                "text": "Avant de démarrer, posez le verre sur une surface plane, puis réglez la molette de la tournette (outil utilisé par les vitriers)."
                            }
                        ]
                    },
                    {
                        "sense_id": "171bd5a5-c87c-3047-835c-450cf57a5a89",
                        "entry_id": "bdcb53cd-0625-3e14-ba55-cf6a88ae03e9",
                        "glosses": [
                            "Dévidoir tournant sur un pivot. Guinde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6315fc60-6f4b-40f0-b2a2-b9d5eaaa562b",
                                "sense_id": "171bd5a5-c87c-3047-835c-450cf57a5a89",
                                "text": "[…] manquant, sans conséquence fâcheuse pour le tout, devrait se nouer, s’embarrasser encore plus souvent dans le lieu de sa formation que mes soies sur ma tournette."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed2af92d-89a5-3217-992c-8742d2e35f22",
                        "entry_id": "bdcb53cd-0625-3e14-ba55-cf6a88ae03e9",
                        "glosses": [
                            "Le contenu de ce dévidoir."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "d96e21a2-36f4-432d-8401-b7e44cf9b76c",
                                "sense_id": "ed2af92d-89a5-3217-992c-8742d2e35f22",
                                "text": "Nous employons au bobinage du fil, pour dix tournettes ou bobines, une femme gagnant de 4 fr. 20 à 4 fr. 50 par jour."
                            }
                        ]
                    },
                    {
                        "sense_id": "fcf145fd-3825-3877-bd23-f15045240e00",
                        "entry_id": "bdcb53cd-0625-3e14-ba55-cf6a88ae03e9",
                        "glosses": [
                            "Dévidoir de ficelle pour emballer un paquet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b570c4d0-fdc2-41f1-9563-5aa7fd53b37c",
                                "sense_id": "fcf145fd-3825-3877-bd23-f15045240e00",
                                "text": "[…] afin que le marchand puisse toujours avoir la ficelle à la main. Cette légère machine s’appelle aussi tournette."
                            }
                        ]
                    },
                    {
                        "sense_id": "64d6f640-a096-344f-be10-d13404384d5f",
                        "entry_id": "bdcb53cd-0625-3e14-ba55-cf6a88ae03e9",
                        "glosses": [
                            "Boite tournante pour amuser les écureuils, cochons d’inde, …"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eaf335f-189b-4616-8f4c-fdd4da70317c",
                                "sense_id": "64d6f640-a096-344f-be10-d13404384d5f",
                                "text": "A un des bouts de cette boîte, on voit une de trois pouces sur quatre de hauteur, & au bout opposé est un trou rond par lequel l’écureuil passe de sa boîte dans la tournette."
                            }
                        ]
                    },
                    {
                        "sense_id": "78580958-dcaa-35f5-9d58-ae733500e7d1",
                        "entry_id": "bdcb53cd-0625-3e14-ba55-cf6a88ae03e9",
                        "glosses": [
                            "Plateau disposé sur la scène que l’on peut faire tourner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29ea4a1e-103f-477c-94a2-24120c4784ae",
                                "sense_id": "78580958-dcaa-35f5-9d58-ae733500e7d1",
                                "text": "Quel est le rôle de la tournette dans la scénographie de Retour à la citadelle ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "71a9597d-60dd-3c7b-92d6-28248e605267",
                        "entry_id": "bdcb53cd-0625-3e14-ba55-cf6a88ae03e9",
                        "glosses": [
                            "Pince élastique ou à ressort pour fixer une œuvre sur un chassis."
                        ],
                        "tags": [
                            "Encadrement"
                        ],
                        "examples": [
                            {
                                "example_id": "e1ebe7c3-ba5a-49e5-9341-ec238d9e7ce0",
                                "sense_id": "71a9597d-60dd-3c7b-92d6-28248e605267",
                                "text": "En effet, la tournette, également appelée « accroche amovible » est montée avec des ressorts qui permettent de tenir solidement la toile en place."
                            }
                        ]
                    }
                ],
