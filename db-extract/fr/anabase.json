        "fr-extract.jsonl": [
            {
                "entry_id": "39293c2a-1843-3df3-acfb-5f05550a3305",
                "word": "anabase",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "abc0973e-09ef-4d63-8804-256d3662e591",
                        "entry_id": "39293c2a-1843-3df3-acfb-5f05550a3305",
                        "tags": [
                            "plural"
                        ],
                        "form": "anabases"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "79a36123-de64-31e2-9e8b-28579f62192b",
                        "entry_id": "39293c2a-1843-3df3-acfb-5f05550a3305",
                        "glosses": [
                            "Ascension de l’esprit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7e9a58b-4490-4854-9c2c-de2ba0fb5058",
                                "sense_id": "79a36123-de64-31e2-9e8b-28579f62192b",
                                "text": "Une anabase spirituelle."
                            },
                            {
                                "example_id": "044d62f2-8af2-42b0-844c-0f947284afa3",
                                "sense_id": "79a36123-de64-31e2-9e8b-28579f62192b",
                                "text": "Or, c'était d'une anabase qu'il était question, le mouvement amorcé d'une armée vers son retour."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3b36813-b9ae-3520-b9fe-b3250f830c09",
                        "entry_id": "39293c2a-1843-3df3-acfb-5f05550a3305",
                        "glosses": [
                            "Expédition militaire (en référence à lAnabase de Xénophon)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cf9a5d4-cc16-48f4-a52b-de909660d3d9",
                                "sense_id": "b3b36813-b9ae-3520-b9fe-b3250f830c09",
                                "text": "N’était-ce pas ce à quoi, présentement, hanté par le mirage d’une chimérique anabase, songeait le lieutenant de la Ferté ? La forêt, comme le désert, se charge vite d’abolir, dans les cerveaux les mieux équilibrés, la notion des choses réalisables."
                            },
                            {
                                "example_id": "54e939d5-a7f3-4ddd-bf3d-b9f633e1e34e",
                                "sense_id": "b3b36813-b9ae-3520-b9fe-b3250f830c09",
                                "text": "Dans cette anabase – expédition à l’intérieur des terres –, un autre pays se découvre peu à peu, un délaissement, non une abdication, une relation qui se délie tranquillement à mesure que je m’éloigne du centre."
                            },
                            {
                                "example_id": "883bf53d-cbbb-4ef1-9b48-4a97aea636a1",
                                "sense_id": "b3b36813-b9ae-3520-b9fe-b3250f830c09",
                                "text": "C’est ce principe vieux comme la guerre qui a présidé à la folle anabase de ces hommes, de Dehli à Lacanau en passant par Tobrouk et la Hollande."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4dc2f17-95e2-45cd-a792-16a394c4b37f",
                        "source_entry_id": "39293c2a-1843-3df3-acfb-5f05550a3305",
                        "target_lang_word": "anabasis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anabasis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f1b12f5-0cff-3b93-b7b2-fdc905969d53",
                                        "entry_id": "8f7108d3-b5d9-3eb2-8e9d-ed5d50733f44",
                                        "glosses": [
                                            "A military march up-country, especially that of Cyrus the Younger into Asia."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33628742-c4d1-4c9f-aca7-f54fad511cb1",
                                                "sense_id": "2f1b12f5-0cff-3b93-b7b2-fdc905969d53",
                                                "text": "During the French anabasis to Moscow he entered our service, made himself a prodigious favorite with the whole imperial family, and even now is only in his twenty−second year."
                                            },
                                            {
                                                "example_id": "67477434-1208-49f0-b2b0-10d463cb2b76",
                                                "sense_id": "2f1b12f5-0cff-3b93-b7b2-fdc905969d53",
                                                "text": "‘I have a feeling that if we follow a scent of spring on the air with sufficient eagerness we’ll come to a south without snow more quickly than we think. Thalassa, thalassa. This is what the Greeks called an anabasis.’ They looked at him as if he were barmy."
                                            },
                                            {
                                                "example_id": "6a7a6e23-2b3c-4508-9827-09f2b91cbec1",
                                                "sense_id": "2f1b12f5-0cff-3b93-b7b2-fdc905969d53",
                                                "text": "The Wordsworthian journey to the source […] is more of an amble than an anabasis or strenuous heroic quest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddb5aacb-aa99-3d9f-abde-3d6f2ba7c1fd",
                                        "entry_id": "8f7108d3-b5d9-3eb2-8e9d-ed5d50733f44",
                                        "glosses": [
                                            "The first period, or increase, of a disease; augmentation."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
