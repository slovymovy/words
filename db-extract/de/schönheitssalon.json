                        "examples": [
                            {
                                "example_id": "24a104f2-bcb6-4c4e-a8db-59224857652c",
                                "sense_id": "153735fc-5e26-3b73-9b5e-a5da7f851b96",
                                "text": "„Nach den Badehäusern - den einzigen Orten, in denen es warmes Wasser gab - wurden in Kabul alle Schönheits- und Frisiersalons für Frauen geschlossen.“"
                            },
                            {
                                "example_id": "d321cb7d-6a24-42d7-a4f7-585ae440405b",
                                "sense_id": "153735fc-5e26-3b73-9b5e-a5da7f851b96",
                                "text": "„Ihr schwarzes, gewelltes Haar - ähnlich dem von Roxana - und ihr dick aufgetragenes Make-up machten deutlich, dass sie eben erst einen Schönheitssalon besucht hatte.“"
                            }
                        ],
