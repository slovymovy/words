                "senses": [
                    {
                        "sense_id": "d9fed778-2245-3676-b3f4-d87026a9c66e",
                        "entry_id": "344f6a03-7cc8-3745-bd65-819aec3b2ed2",
                        "glosses": [
                            "bestrijdingsmiddel tegen door organismen veroorzaakte plagen van cultuurgewassen of tot verdelging van onkruid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0f19716-a5ea-4bb3-b599-6aba1cc9fe53",
                                "sense_id": "d9fed778-2245-3676-b3f4-d87026a9c66e",
                                "text": "\"Verkoop schadelijke pesticiden in Nederland veel hoger dan aangenomen\""
                            },
                            {
                                "example_id": "af8e7ce6-fc11-42ed-881b-8c89748c810f",
                                "sense_id": "d9fed778-2245-3676-b3f4-d87026a9c66e",
                                "text": "Zwangere vrouwen die dichtbij grond wonen waar pesticiden worden gespoten, zouden meer kans hebben op baby's met geboorteproblemen"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6378cf74-9e9d-43c6-820f-32071beadd1f",
                        "source_entry_id": "344f6a03-7cc8-3745-bd65-819aec3b2ed2",
                        "source_sense_id": "d9fed778-2245-3676-b3f4-d87026a9c66e",
                        "target_lang_word": "农药",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a651bb7d-cdfd-4bfd-a2e7-483c086e7168",
                        "source_entry_id": "344f6a03-7cc8-3745-bd65-819aec3b2ed2",
                        "source_sense_id": "d9fed778-2245-3676-b3f4-d87026a9c66e",
                        "target_lang_word": "Pestizid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pestizid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a36142e-f263-316b-bb20-8957e4d0c7cd",
                                        "entry_id": "7172a1a2-7800-38ac-9c3b-536073a84edb",
                                        "glosses": [
                                            "Mittel (Flüssigkeit), dessen Wirkstoff die als schädlich empfundenen Lebewesen abtöten oder vertreiben soll (Wildkräuter, Pilze, Insekten und Ähnliches)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e248fd1-081a-4046-8c67-8c40c43dea82",
                                                "sense_id": "0a36142e-f263-316b-bb20-8957e4d0c7cd",
                                                "text": "Der Einsatz von Pestiziden wird in Deutschland von den Verbrauchern kritisch gesehen."
                                            },
                                            {
                                                "example_id": "2c929d94-a7ff-40be-81a7-92a277123811",
                                                "sense_id": "0a36142e-f263-316b-bb20-8957e4d0c7cd",
                                                "text": "Macht das Pestizid Glyphosat krank? Experten kommen in Studien zu widersprüchlichen Ergebnissen."
                                            },
                                            {
                                                "example_id": "8852c86d-439d-4a86-90b3-48a13b1eccdd",
                                                "sense_id": "0a36142e-f263-316b-bb20-8957e4d0c7cd",
                                                "text": "Landwirte, die Pestizide einsetzen, sind einem doppelt so hohen Risiko ausgesetzt, an Parkinson zu erkranken wie Berufskollegen, die auf solche chemischen Keulen verzichten."
                                            },
                                            {
                                                "example_id": "aa6b147c-613a-4db7-a832-89511abe0141",
                                                "sense_id": "0a36142e-f263-316b-bb20-8957e4d0c7cd",
                                                "text": "Nach der Zika-Epidemie im vergangenen Jahr ist die Zahl der Fälle in Brasilien um mehr als 95 Prozent gesunken. Das Militär war mit Pestiziden und Austrocknungsmaßnahmen gegen die Überträger-Mücken vorgegangen."
                                            },
                                            {
                                                "example_id": "5d6f5ebc-ad84-4463-bcb0-9d3dd6e5144e",
                                                "sense_id": "0a36142e-f263-316b-bb20-8957e4d0c7cd",
                                                "text": "„Das Fleisch der Wale ist hoch mit giftigem Quecksilber, krebserregendem PCB (polychlorierte Biphenyle) und Pestiziden belastet – so stark, dass die Gesundheitsbehörde der Färöer 2008 die Empfehlung aussprach, kein Walfleisch und keinen Walspeck mehr zu essen.“"
                                            },
                                            {
                                                "example_id": "b5601338-3505-4a0f-bf51-4113b56b826e",
                                                "sense_id": "0a36142e-f263-316b-bb20-8957e4d0c7cd",
                                                "text": "„Einer der Gründe […] für den Verlust unserer Biodiversität ist der zunehmende Einsatz von Pestiziden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94f23a2b-e988-4412-8ae0-6250272d4c3e",
                        "source_entry_id": "344f6a03-7cc8-3745-bd65-819aec3b2ed2",
                        "source_sense_id": "d9fed778-2245-3676-b3f4-d87026a9c66e",
                        "target_lang_word": "pesticide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pesticide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64fd88c9-0552-3870-af0a-c3190e97f3c5",
                                        "entry_id": "ef60dd20-628d-3d0d-a525-faaa95b73f9c",
                                        "glosses": [
                                            "Anything, especially a synthetic substance but also any substance (e.g. sulfur), or virus, bacterium, or other organism, which kills or suppresses the activities of pests."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5997e81-1f29-40d9-a3df-6207be1678c5",
                                                "sense_id": "64fd88c9-0552-3870-af0a-c3190e97f3c5",
                                                "text": "“Twelve pesticides commonly applied to citrus groves are slated for study in the project’s plots,” reports Tom S. Bellows, UC Riverside assistant entomologist. They include four acaricides (Morestan, Kelthane, Pictran, Vendex), four thripsicides (Cygon, Carzol, Orthene, Sabadilla), and four scalicides (Parathion, Supracide, Lorsban, Sevin)."
                                            },
                                            {
                                                "example_id": "efcc1f6d-9473-410c-bd27-81ac7c290b6c",
                                                "sense_id": "64fd88c9-0552-3870-af0a-c3190e97f3c5",
                                                "text": "Too much pesticide was applied and then washed from the fields by rains and surface runoff."
                                            },
                                            {
                                                "example_id": "7fbe3985-1fdc-41df-bfad-16977339210f",
                                                "sense_id": "64fd88c9-0552-3870-af0a-c3190e97f3c5",
                                                "text": "Pesticide and fertilizer use has been recorded since ancient times, […]"
                                            },
                                            {
                                                "example_id": "013f3062-7ca6-4a8d-898e-c067ee471f81",
                                                "sense_id": "64fd88c9-0552-3870-af0a-c3190e97f3c5",
                                                "text": "Diluted neem oil can be effective as a pesticide and can control various fungal diseases, such as powdery mildew, on animals and plants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abd9a0af-09c8-4b4c-846f-b47d08f0887f",
                        "source_entry_id": "344f6a03-7cc8-3745-bd65-819aec3b2ed2",
                        "source_sense_id": "d9fed778-2245-3676-b3f4-d87026a9c66e",
                        "target_lang_word": "pesticide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pesticide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad729e0f-19ac-39a6-89ba-289d0a43bc3a",
                                        "entry_id": "964fd1a0-6b53-367e-b78e-287f9d019a7b",
                                        "glosses": [
                                            "Substance chimique destinée à éliminer les parasites animaux ou végétaux qui pourraient s’attaquer aux cultures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b91e151-320f-4903-803d-dc74a7816f97",
                                                "sense_id": "ad729e0f-19ac-39a6-89ba-289d0a43bc3a",
                                                "text": "Certaines transformations conservent le pesticide intact et le dispersent dans une autre sphère environnementale."
                                            },
                                            {
                                                "example_id": "a936099a-2e2b-4348-b72c-5583aec2b3e8",
                                                "sense_id": "ad729e0f-19ac-39a6-89ba-289d0a43bc3a",
                                                "text": "Les pesticides sont rares et la main-d’œuvre nombreuse ; la tâche de débarrasser les champs de patates, des doryphores de la pomme de terre, revient aux enfants."
                                            },
                                            {
                                                "example_id": "6b437cfe-e177-44ec-9689-5d3548e83f6e",
                                                "sense_id": "ad729e0f-19ac-39a6-89ba-289d0a43bc3a",
                                                "text": "L’utilisation des pesticides a beaucoup augmenté dans les pays en développement à la fin des années 60 et pendant les années 70, à mesure que l’agriculture se modernisait."
                                            },
                                            {
                                                "example_id": "728370ec-0fef-4f2a-bff5-62a7cb25ff9e",
                                                "sense_id": "ad729e0f-19ac-39a6-89ba-289d0a43bc3a",
                                                "text": "Et sur le dossier très spécifique d'une attaque, par des cochenilles, des tilleuls situés autour de la superbe place de Céroux, menaçant gravement ces arbres séculaires, nous choisirons de recourir à un lâcher de coccinelles, plutôt que de pulvériser des pesticides, comme cela se pratique classiquement."
                                            },
                                            {
                                                "example_id": "8c00906d-8631-4f23-82d2-fed9b08acc39",
                                                "sense_id": "ad729e0f-19ac-39a6-89ba-289d0a43bc3a",
                                                "text": "Par exemple, considérant que les mauvaises herbes et les plantes adventices entraient en concurrence (pour les éléments nutritifs, l’eau et la lumière) avec les plantes cultivées et occasionnaient des pertes estimées à un tiers des rendements potentiels, l’emploi des pesticides a été généralisé, mais en affectant aussi les plantes messicoles, c’est-à-dire les plantes commensales des plantes moissonnées, parmi lesquelles nos symboliques et aujourd’hui fort recherchés bleuets, marguerites et coquelicots."
                                            },
                                            {
                                                "example_id": "54b58bf1-515c-41e5-9f6a-22d68b8f4af4",
                                                "sense_id": "ad729e0f-19ac-39a6-89ba-289d0a43bc3a",
                                                "text": "Bien que les pesticides ionisables soient nombreux, il existe assez peu d'informations sur la variation de leur solubilité avec le pH. Quelques données ont été publiées pour les sulfonylurées."
                                            },
                                            {
                                                "example_id": "e8b87681-9e76-40c3-8edc-136482743639",
                                                "sense_id": "ad729e0f-19ac-39a6-89ba-289d0a43bc3a",
                                                "text": "Le député de Nelligan avait vigoureusement plaidé pour que la maladie de Parkinson soit reconnue comme maladie professionnelle causée par les pesticides."
                                            },
                                            {
                                                "example_id": "f7442043-a724-472a-8ed0-f103703046d1",
                                                "sense_id": "ad729e0f-19ac-39a6-89ba-289d0a43bc3a",
                                                "text": "Elles ont permis de montrer par exemple que l’exposition professionnelle aux pesticides en agriculture augmente le risque de contracter la maladie de Parkinson, des cancers du sang, le cancer de la prostate, des maladies respiratoires, des troubles neurologiques. (...) Il est aussi difficile de documenter les effets des pesticides sur les riverains, qui ont des profils très variés, déménagent et ignorent largement les produits auxquels ils sont exposés"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
