                                "target_senses": [
                                    {
                                        "sense_id": "8d1b3a3e-d6cc-3380-848e-8c1150f13a76",
                                        "entry_id": "9fc2e5bb-891b-3361-9470-d21628e5bfce",
                                        "glosses": [
                                            "Doctrine économique, libéralisme prôné par Margaret Thatcher."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46fb8e39-3f50-4708-95ea-5dfa55cbe483",
                                                "sense_id": "8d1b3a3e-d6cc-3380-848e-8c1150f13a76",
                                                "text": "Davis Cameron, 43 ans, archétype de l’aristocrate tory descendant du roi Guillaume IV, se présente comme le champion d’un \"conservatisme moderne et compatissant\" émancipé de l’héritage du thatchérisme."
                                            },
                                            {
                                                "example_id": "10166e99-a888-4be9-900e-bfdb28d15c7d",
                                                "sense_id": "8d1b3a3e-d6cc-3380-848e-8c1150f13a76",
                                                "text": "Victime d’une crise de thatchérisme aiguë, elle avait décidé de supprimer la tranche d’imposition à 45 %, en clair d’offrir aux plus fortunés un cadeau équivalent à 52 milliards d’euros, à financer par la dette publique."
                                            },
                                            {
                                                "example_id": "a5890e17-f6ce-4727-bd6e-81934bba173a",
                                                "sense_id": "8d1b3a3e-d6cc-3380-848e-8c1150f13a76",
                                                "text": "Celui qui a précédemment chroniqué les dégâts du thatchérisme dans son pays d’origine, révèlera cette fois les dessous, parfois peu reluisants, de la ville lumière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
