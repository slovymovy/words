                                        "glosses": [
                                            "Algonquintaal van de oorspronkelijke bewoners van Noord-Amerika, gesproken door 45.000 mensen in Canada, waar het de op één na grootste inheemse taal is, en zo'n 10.000 in de Verenigde Staten, waar het de op twee na grootste inheemse taal is"
                                        ],
                                        "tags": [
                                            "linguistics",
                                            "no-plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
