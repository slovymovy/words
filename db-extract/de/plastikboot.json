                "senses": [
                    {
                        "sense_id": "bbe7d9bc-1f9a-3f2f-82ab-0e5e484e38bd",
                        "entry_id": "a7dabeb2-82ec-3911-97d2-387c1fe9967b",
                        "glosses": [
                            "kleineres Wasserfahrzeug, das aus Kunststoffen besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ce9d42a-e2b0-4ba1-8e7b-51e6517038fd",
                                "sense_id": "bbe7d9bc-1f9a-3f2f-82ab-0e5e484e38bd",
                                "text": "„Nach vier Monaten und 15.000 Kilometern ist das Plastikboot ‚Plastiki‘ des britischen Umweltschützers David de Rothschild wohlbehalten im Hafen von Sydney gelandet.“"
                            },
                            {
                                "example_id": "bed31c02-56db-4b70-a103-96b13a64d014",
                                "sense_id": "bbe7d9bc-1f9a-3f2f-82ab-0e5e484e38bd",
                                "text": "„Sie sahen genauso lieb aus wie David, als er noch klein war und mit einem Plastikboot in der Badewanne spielte.“"
                            },
                            {
                                "example_id": "1bb0d593-b7d1-45a7-95ff-1a2a4ed2b9fe",
                                "sense_id": "bbe7d9bc-1f9a-3f2f-82ab-0e5e484e38bd",
                                "text": "„Denn wenn er ehrlich war, hatte er natürlich ein mulmiges Gefühl gehabt, als er in das kleine, wackelige Plastikboot gestiegen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
