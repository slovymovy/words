                "senses": [
                    {
                        "sense_id": "63caefd8-3a69-380d-b43a-970ab2eeba3c",
                        "entry_id": "a02f5869-8f82-3c20-b351-61f49f653271",
                        "glosses": [
                            "speziell ausgestatteter Raum für die Bearbeitung von Filmen"
                        ],
                        "tags": [
                            "Film",
                            "Fernsehen"
                        ],
                        "examples": [
                            {
                                "example_id": "837b2a44-2376-4b17-af3b-14a21d628677",
                                "sense_id": "63caefd8-3a69-380d-b43a-970ab2eeba3c",
                                "text": "„Schmeißt sie das sowieso nachher im Schneideraum wieder raus?“"
                            },
                            {
                                "example_id": "27f2ab5c-455c-4d23-bb6f-4b7b168a28c8",
                                "sense_id": "63caefd8-3a69-380d-b43a-970ab2eeba3c",
                                "text": "[…] „die letzten beiden Akte des Films sind nach ihrer Fertigstellung im Schneideraum verbrannt“ […]."
                            },
                            {
                                "example_id": "f203c169-d007-47c0-aea4-7c30af8176a0",
                                "sense_id": "63caefd8-3a69-380d-b43a-970ab2eeba3c",
                                "text": "Mit Hilfe einer Filmklappe synchronisiert man Bild und Ton im Schneideraum."
                            },
                            {
                                "example_id": "0871edb9-6fed-4343-a5f3-9659c3b3b221",
                                "sense_id": "63caefd8-3a69-380d-b43a-970ab2eeba3c",
                                "text": "„Wir sind jetzt gerade im Schneideraum und basteln alles zusammen.“"
                            },
                            {
                                "example_id": "43202ca5-7df9-481b-899a-408c319a9b59",
                                "sense_id": "63caefd8-3a69-380d-b43a-970ab2eeba3c",
                                "text": "„Währenddessen sitzt die Cutterin mit dem Regisseur der zuletzt abgedrehten Staffel im Schneideraum und sorgt dafür, dass alle Szenen in der dramaturgischen Logik zu einer Folge zusammengesetzt werden. Bild für Bild, Szene für Szene.“"
                            },
                            {
                                "example_id": "6ce6c49d-92ad-4489-bd24-e32337b62b1c",
                                "sense_id": "63caefd8-3a69-380d-b43a-970ab2eeba3c",
                                "text": "„Die Aufnahmen aller vier Figuren wurden dann später im Schneideraum zusammengesetzt.“"
                            },
                            {
                                "example_id": "9a16a390-fdea-4841-b1df-3ecd2c02db31",
                                "sense_id": "63caefd8-3a69-380d-b43a-970ab2eeba3c",
                                "text": "„Aber als ich den ersten Entwurf im Schneideraum gesehen habe, da war ich wirklich verblüfft, wie brilliant es geworden ist.“"
                            },
                            {
                                "example_id": "134d1827-9090-4dc0-8c42-87b0f83bd05f",
                                "sense_id": "63caefd8-3a69-380d-b43a-970ab2eeba3c",
                                "text": "„So kam es bei vielen Filmen vor, dass Hitchcock entscheidende Schlüsselszenen in verschiedenen Varianten drehte und meist erst im Schneideraum über die endgültige Form einzelner Szenen entschied.“"
                            },
                            {
                                "example_id": "898b31c3-5167-44a9-9372-4fb6c5832614",
                                "sense_id": "63caefd8-3a69-380d-b43a-970ab2eeba3c",
                                "text": "„Vorhandene Pferdeställe ließ er zur Lagerung von Kulissen und Kostümen und als Schneideraum umbauen.“"
                            },
                            {
                                "example_id": "d6c2191d-8802-4d84-9b9d-6d0fcc4d5350",
                                "sense_id": "63caefd8-3a69-380d-b43a-970ab2eeba3c",
                                "text": "„Wollen wir einen speziellen Schnittstil? Bekommt vielleicht jeder Protagonist eine eigene Musik oder Geräusche? Das verlangt viel Kommunikation im Schneideraum.“"
                            },
                            {
                                "example_id": "13529675-af36-4344-8c2e-cb80bd7ccee8",
                                "sense_id": "63caefd8-3a69-380d-b43a-970ab2eeba3c",
                                "text": "„Eine Videoschnittsoftware für die ersten Versuche im digitalen Schneideraum wird in der Regel bei den Camcordern gleich mitgeliefert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
