                "senses": [
                    {
                        "sense_id": "912bf3ec-7a0a-3e7d-9f8f-94d023ea7753",
                        "entry_id": "2146aa0e-e2ee-3413-9b08-42d628b4cfeb",
                        "glosses": [
                            "iets dat ervoor zorgt dat er mogelijkheden begrensd worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31ae4fcd-a9a4-4ae4-87c5-95f5d3431832",
                                "sense_id": "912bf3ec-7a0a-3e7d-9f8f-94d023ea7753",
                                "text": "Mensen die blind zijn hebben een visuele beperking."
                            },
                            {
                                "example_id": "28b358be-a6af-4b37-b17e-bf78b4398a75",
                                "sense_id": "912bf3ec-7a0a-3e7d-9f8f-94d023ea7753",
                                "text": "In verband met de slechte economische toestand moeten mensen zich beperkingen opleggen."
                            },
                            {
                                "example_id": "536934ad-576e-45a1-bc67-9a305da1aee9",
                                "sense_id": "912bf3ec-7a0a-3e7d-9f8f-94d023ea7753",
                                "text": "De maan heeft geen atmosfeer, dus je ervaart een voortdurend bombardement van micro-meteorieten en de temperatuurverschillen zijn extreem. Daarnaast is zuurstof én zwaartekracht vrijwel helemaal afwezig. Het moge duidelijk zijn dat leven op de maan gepaard gaat met vele beperkingen."
                            },
                            {
                                "example_id": "deaf743b-cf53-4d73-a43f-1fec3b3a4095",
                                "sense_id": "912bf3ec-7a0a-3e7d-9f8f-94d023ea7753",
                                "text": "Hij legt in zijn boek en in het gesprek een rechtstreeks verband tussen deze opwarming en de Amerikaanse vorm van kapitalisme. „Daarin wordt iedere beperking van hoeveel je kunt kopen, bezitten en consumeren gezien als een aanval op de vrijheid.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6856e9bd-1477-401d-90d2-86d885bfcd3e",
                        "source_entry_id": "2146aa0e-e2ee-3413-9b08-42d628b4cfeb",
                        "source_sense_id": "912bf3ec-7a0a-3e7d-9f8f-94d023ea7753",
                        "source_sense_description": "iets dat ervoor zorgt dat de mogelijkheden beperkt worden",
                        "target_lang_word": "Begrenzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Begrenzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea4492da-d861-31d6-8217-8e8c6f45831e",
                                        "entry_id": "fb16631b-3efb-3119-a44c-26e2ddc7d8b2",
                                        "glosses": [
                                            "der symbolisch markierte oder physisch trennende Rand einer Fläche oder eines Raumes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5dc8912-2708-4187-9bd4-9f25515ec535",
                                                "sense_id": "ea4492da-d861-31d6-8217-8e8c6f45831e",
                                                "text": "Der Randstein bildet die Begrenzung der Rasenfläche."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e0d6d2fd-b66f-3e1c-8379-17891980b908",
                                        "entry_id": "fb16631b-3efb-3119-a44c-26e2ddc7d8b2",
                                        "glosses": [
                                            "der minimale oder maximale Wert, die minimale oder maximale Anzahl von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f1f4c9b-a7c4-4b9e-87e2-2356f7f66135",
                                                "sense_id": "e0d6d2fd-b66f-3e1c-8379-17891980b908",
                                                "text": "Die Begrenzung des Risikos ist im Bankensektor bitter nötig."
                                            },
                                            {
                                                "example_id": "1b3f1fa7-8783-4d81-a8b7-9998622eeb12",
                                                "sense_id": "e0d6d2fd-b66f-3e1c-8379-17891980b908",
                                                "text": "„Auf dem Volkskongress in Peking hat der Staatspräsident die Begrenzung seiner Amtszeit aufheben lassen.“"
                                            },
                                            {
                                                "example_id": "85e2a6c2-9fee-41b1-bca1-f794170ae45b",
                                                "sense_id": "e0d6d2fd-b66f-3e1c-8379-17891980b908",
                                                "text": "[…] „nichts deutet darauf hin, dass wir die im Pariser Klimaabkommen vereinbarte Begrenzung von 1,5 Grad schaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbe98a3f-dc14-4e44-a904-0967863b2d7e",
                        "source_entry_id": "2146aa0e-e2ee-3413-9b08-42d628b4cfeb",
                        "source_sense_id": "912bf3ec-7a0a-3e7d-9f8f-94d023ea7753",
                        "source_sense_description": "iets dat ervoor zorgt dat de mogelijkheden beperkt worden",
                        "target_lang_word": "limitation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99a8e086-0378-3edb-b69c-2850634348b9",
                                        "entry_id": "1fac6e9f-f438-3355-8c99-8110dcaaebaa",
                                        "glosses": [
                                            "The act of limiting or the state of being limited."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "465c01a1-9f0b-358f-8bd8-122fa433b0cc",
                                        "entry_id": "1fac6e9f-f438-3355-8c99-8110dcaaebaa",
                                        "glosses": [
                                            "A restriction; a boundary, real or metaphorical, caused by some thing or some circumstance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc8814f3-ced2-47a8-9b07-61160c2500fd",
                                                "sense_id": "465c01a1-9f0b-358f-8bd8-122fa433b0cc",
                                                "text": "Getting into his wheelchair after his amputation, it felt like a limitation you could roll in."
                                            },
                                            {
                                                "example_id": "b689a04d-8916-4f97-bbe1-2b276ad9c084",
                                                "sense_id": "465c01a1-9f0b-358f-8bd8-122fa433b0cc",
                                                "text": "He understood the exam material, but his fear was a limitation he could not overcome."
                                            },
                                            {
                                                "example_id": "1bb90989-7fa8-44fd-8aef-79a3809de221",
                                                "sense_id": "465c01a1-9f0b-358f-8bd8-122fa433b0cc",
                                                "text": "The coaches are similar to those of the Hampshire diesel-electric units, which went into service in September, 1957, but have 8ft 6in wide bodies, instead of 9ft, because of loading gauge limitations on the South Eastern Division."
                                            },
                                            {
                                                "example_id": "f9b5a611-49d1-4d63-bf11-28c76a49c8e3",
                                                "sense_id": "465c01a1-9f0b-358f-8bd8-122fa433b0cc",
                                                "text": "Now, Nielsen is sending all hotel employees through EI training to help them become more open and confident, understand their own limitations and fears, and to boost their self-worth and comfort in dealing with other people."
                                            },
                                            {
                                                "example_id": "c94125f8-db87-4952-a767-e42b547b62ee",
                                                "sense_id": "465c01a1-9f0b-358f-8bd8-122fa433b0cc",
                                                "text": "Telling a story is like an invitation for others to share their stories with you. That’s what I discovered at TED when I shared my story about a limitation that held me back from my dream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdf715ef-cbaf-3869-a062-994adfc14484",
                                        "entry_id": "1fac6e9f-f438-3355-8c99-8110dcaaebaa",
                                        "glosses": [
                                            "An imperfection or shortcoming that limits something's use or value."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4841f5d2-29e5-4cd5-9adf-3bd485ca4385",
                                                "sense_id": "fdf715ef-cbaf-3869-a062-994adfc14484",
                                                "text": "Both the MI score and the t-score have their limitations. MI computes a logarithm representing the number of co-occurrences of words compared to their occurrences apart in the corpus, which can highlight rare collocations if the components tend not to occur with other words. The t-score formula is less susceptible to this but its numerical result cannot be meaningfully compared across corpora of different sizes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e218c59-0f62-38bd-9789-ca127dc559d9",
                                        "entry_id": "1fac6e9f-f438-3355-8c99-8110dcaaebaa",
                                        "glosses": [
                                            "A time period after which some legal action may no longer be brought."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d274cca-b5cd-485b-8430-509e2d87626f",
                                                "sense_id": "0e218c59-0f62-38bd-9789-ca127dc559d9",
                                                "text": "The lawyer obtained impunity by dragging his obviously guilty client's case beyond the ten-year limitation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
