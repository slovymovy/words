                "senses": [
                    {
                        "sense_id": "a22ae565-8d31-3076-9b7a-9ae030de6f85",
                        "entry_id": "6df69d52-803c-30b8-9c26-b94723b55e6d",
                        "glosses": [
                            "Dignitaire de pacotille, apparatchik toc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36d0a9fb-d5dc-4f04-80a4-cd3596e20671",
                                "sense_id": "a22ae565-8d31-3076-9b7a-9ae030de6f85",
                                "text": "Les gourous du goût, les mamamouchis de la mise en marché et les ayatollahs de la pub s’unissent pour éduquer le consommateur qui est en nous."
                            },
                            {
                                "example_id": "f92f83c8-dd13-4d60-9191-875a7ce7f63c",
                                "sense_id": "a22ae565-8d31-3076-9b7a-9ae030de6f85",
                                "text": "Ces dames [évêques de l’Église anglicane] peuvent être intronisées papesses ou grandes mamamouchies, ça reste de la bouillie pour chat."
                            },
                            {
                                "example_id": "1c9d2f89-d074-431d-a602-14d75df082de",
                                "sense_id": "a22ae565-8d31-3076-9b7a-9ae030de6f85",
                                "text": "Les comédies du XVIIᵉ siècle sont pleines de ces joies délirantes de vieux amoureux à qui une Frosine quelconque a persuadé que leurs vœux sont prêts d’être comblés, de ces joies de parvenus que des farceurs font mamamouchis, de ces douleurs d’ingénue devant la perte d’un père ou d’un galant qu’elles ignorent vivant."
                            },
                            {
                                "example_id": "6bc37eba-0f20-4956-bc11-61a52842a25c",
                                "sense_id": "a22ae565-8d31-3076-9b7a-9ae030de6f85",
                                "text": "Venu pour se frotter aux jeunes turcs new-yorkais, le voilà qui tombe sur le grand Mamamouchi en personne."
                            }
                        ]
                    }
                ],
