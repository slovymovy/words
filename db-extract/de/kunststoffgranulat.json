                "senses": [
                    {
                        "sense_id": "40a5a224-8166-3899-a561-6ce0bd1ce469",
                        "entry_id": "536855a2-b6f3-369e-8515-ee47734b5ed7",
                        "glosses": [
                            "thermoplastische Kunststoffe, die durch Granulieren in Körner zerkleinert, als Basisprodukt zur weiteren Kunststoffverarbeitung, dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edeb6653-227d-43f2-89ab-8b0ffcb2b461",
                                "sense_id": "40a5a224-8166-3899-a561-6ce0bd1ce469",
                                "text": "„Kunststoffgranulat ist die gängige Lieferform von thermoplastischen Kunststoffen der Hersteller von Kunststoffrohstoffen für die kunststoffverarbeitende Industrie.“"
                            },
                            {
                                "example_id": "552aefc9-3fcc-40c3-a521-41841fcb7943",
                                "sense_id": "40a5a224-8166-3899-a561-6ce0bd1ce469",
                                "text": "„Bei der Entnahme des Kunststoffgranulats aus Oktabins mittels Sauglanzen traten durch Schachtbildung Auslaufprobleme auf.“"
                            },
                            {
                                "example_id": "d6a476f5-7240-469f-8699-fb29918029f7",
                                "sense_id": "40a5a224-8166-3899-a561-6ce0bd1ce469",
                                "text": "„Nach weiteren technischen Prozessschritten, zum Beispiel zur Definition des Festigkeitsgrades oder der Farbe des benötigten Rohstoffes, wird dann aus Ihren alten Verpackungen das hochwertige Kunststoffgranulat procyclen gewonnen.“"
                            },
                            {
                                "example_id": "c87a79a1-a04a-4c23-8e6e-9303f2d47f25",
                                "sense_id": "40a5a224-8166-3899-a561-6ce0bd1ce469",
                                "text": "„Kunststoffgranulat wird dazu verwendet um Kunststoffspritzgießmaschinen und Extruder zu bestücken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
