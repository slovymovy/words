                        ],
                        "examples": [
                            {
                                "example_id": "7d17d495-e9f2-4196-a639-0dc50c207947",
                                "sense_id": "ffbea821-f38c-3dd0-bcef-8bb7e8b43d28",
                                "text": "La bouche de Lana Del Rey crée le buzz ! Partout, on se demande si la miss ne se serait pas fait repimper les lèvres !"
                            },
                            {
                                "example_id": "e7456ef3-8e24-4551-8e26-2e4da7d2b687",
                                "sense_id": "ffbea821-f38c-3dd0-bcef-8bb7e8b43d28",
                                "text": "Une jacinthe, c’est l’assurance de repimper votre environnement."
                            },
                            {
                                "example_id": "a753b15f-97ba-43af-93bd-3b3671232064",
                                "sense_id": "ffbea821-f38c-3dd0-bcef-8bb7e8b43d28",
                                "text": "Je ne me souviens plus si je les ai déjà cross-postées ici ou non, mais ça ne fait pas de mal de les repimper un peu ?"
                            }
                        ]
                    }
