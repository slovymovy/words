                                "target_senses": [
                                    {
                                        "sense_id": "02b8c4b1-2b1c-359e-b8df-58a1f107e76a",
                                        "entry_id": "694c61d0-e0b1-306b-ae93-ead0ea69b256",
                                        "glosses": [
                                            "An alkaloid extracted from the plant deadly nightshade (Atropa belladonna) and other sources, such as the seeds of the thorn-apple. Though overdoses would be fatal it is used as a drug in medicine for its paralytic effects (e.g. in surgery to relax muscles, in dentistry to dry the mouth, in ophthalmology to dilate the pupils)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d234caa9-4c62-400f-8724-8d034fca079a",
                        "source_entry_id": "f63bc2b6-f56f-3ae7-81cd-cda3442bfd24",
                        "source_sense_id": "226ac17e-2a81-37ce-924a-67e5989eceb2",
                        "source_sense_description": "hochgiftiges Alkaloid oder krampflösendes Arzneimittel, das in Nachtschattengewächsen vorkommt",
                        "target_lang_word": "atropine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atropine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18a140c3-6629-38f1-90e6-0f747e32bfea",
                                        "entry_id": "3c8b22c7-8b2a-3e7c-be38-eda69ff2d6d4",
                                        "glosses": [
                                            "Alcaloïde à noyau tropane, très toxique, tiré, entre autre, de la belladone. C'est un antagoniste cholinergique muscarinique qui provoque la dilatation des pupilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e870c7c0-79d6-4eac-93e7-d457837d9326",
                                                "sense_id": "18a140c3-6629-38f1-90e6-0f747e32bfea",
                                                "text": "Un cobaye de 300 grammes ou une souris de 20 grammes supportent plus d’un centigramme d’atropine injecté sous la peau."
                                            },
                                            {
                                                "example_id": "38de1a8d-2d0f-41a3-b473-ee3ebb33584d",
                                                "sense_id": "18a140c3-6629-38f1-90e6-0f747e32bfea",
                                                "text": "La physostigmine, agoniste muscarinique (qui stimule l’action de l’acétylcholine), déclenche des bâillements, alors que l’atropine, antagoniste de l’acétylcholine, les inhibe."
                                            },
                                            {
                                                "example_id": "5d64d7a8-8bf8-46e5-b27f-5731c4d7424c",
                                                "sense_id": "18a140c3-6629-38f1-90e6-0f747e32bfea",
                                                "text": "On retrouve de l’atropine en unidose dans les collyres pour les yeux ou dans des injections pour stimuler le cœur."
                                            },
                                            {
                                                "example_id": "421dbc11-68f9-4b45-b1fb-42006ea29b35",
                                                "sense_id": "18a140c3-6629-38f1-90e6-0f747e32bfea",
                                                "text": "Difficile donc de tricher… Sauf à s’injecter de l’atropine, comme le faisaient les femmes italiennes au XVIIᵉ siècle pour s’embellir, ou à se dessiner de larges pupilles comme Bambi ou d’autres personnages des studios Disney, dont les dessinateurs ont compris depuis bien longtemps à quel point les pupilles dilatées étaient appréciées !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
