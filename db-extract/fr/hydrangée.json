                        "glosses": [
                            "Arbuste ou arbre appartenant au genre Hydrangea de la famille des Hydrangeaceae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aae38fc-74cf-4be6-8df4-43c786964db2",
                                "sense_id": "6891d3cd-88f1-3530-bfa0-1d248e35be5f",
                                "text": "Quelqu’un qui lui avait écrit récemment une longue lettre, pleine d’effusion, où elle parlait d’hydrangées bleues."
                            },
                            {
                                "example_id": "a63ad0c0-5ccd-43df-ace4-c723c9c4635a",
                                "sense_id": "6891d3cd-88f1-3530-bfa0-1d248e35be5f",
                                "text": "Derrière les appartements particuliers est un long corps de logis séparé par un jardin planté de bosquets de lilas, de camélias, d’hydrangées, et de groupes de grands arbres ; une véranda règne sur toute la façade."
                            },
                            {
                                "example_id": "daad36e7-b8a1-4487-acdf-15a2b605eb9e",
                                "sense_id": "6891d3cd-88f1-3530-bfa0-1d248e35be5f",
                                "text": "L’hortensia est une hydrangée."
                            }
                        ]
                    }
                ],
