                "senses": [
                    {
                        "sense_id": "1ad09781-a93f-328b-967f-f6347cea06f0",
                        "entry_id": "0b3d0b67-b4c6-37f6-970c-bbfbde8950ab",
                        "glosses": [
                            "разг. купаться, мыться с шумом и брызгами; плескаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad32fb0a-a1f5-4c79-b96a-59c49e20b17b",
                                "sense_id": "1ad09781-a93f-328b-967f-f6347cea06f0",
                                "text": "Они полоскались в луже, и я наехал сверху велосипедом."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a12d59d-d6e1-3ab8-8099-d13561a8114b",
                        "entry_id": "0b3d0b67-b4c6-37f6-970c-bbfbde8950ab",
                        "glosses": [
                            "трепетать, колебаться на ветру"
                        ],
                        "tags": [
                            "о флаге, парусе и т.п."
                        ],
                        "examples": [
                            {
                                "example_id": "75576cdc-bacd-4fc5-b0fc-436a3458a964",
                                "sense_id": "1a12d59d-d6e1-3ab8-8099-d13561a8114b",
                                "text": "Красно-бело-зеленый флаг Сардинского королевства полоскался на мачте, в те же цвета раскрашена была дымовая труба."
                            }
                        ]
                    }
