                ],
                "senses": [
                    {
                        "sense_id": "6b12065d-6552-36f2-9e8e-503b08c4682f",
                        "entry_id": "c4b9a659-1c85-3f34-bc5e-9ac00d32d5de",
                        "glosses": [
                            "Stelle am Ufer, an der Schiffe anlegen können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41b56d5f-04de-4132-a4ab-c92a74487779",
                                "sense_id": "6b12065d-6552-36f2-9e8e-503b08c4682f",
                                "text": "„Die Uferzone der Koblenzer Altstadt zieht mit den Anlegestellen für die Touristenschifffahrt, dem Reisebusparkplatz und der räumlichen Nähe zur Innenstadt hohe Touristenzahlen an.“"
                            },
                            {
                                "example_id": "7f9555e1-a30d-4dea-b757-20288d84b697",
                                "sense_id": "6b12065d-6552-36f2-9e8e-503b08c4682f",
                                "text": "„Praktischerweise sind die Anlegestellen direkt vor den bekanntesten Weinstuben, und so muß auf dem Heimweg nur ein kurzes Stück schwankenden Fußes bewältigt werden.“"
                            },
                            {
                                "example_id": "232800b4-0b89-4997-ab18-28256d13e0e3",
                                "sense_id": "6b12065d-6552-36f2-9e8e-503b08c4682f",
                                "text": "„Heute befindet sich die Anlegestelle der Boote mit den hölzernen Bootsschuppen am östlichen Ortsrand.“"
                            },
                            {
                                "example_id": "fcc04252-0ed8-48cc-b660-5ab6954e9fdd",
                                "sense_id": "6b12065d-6552-36f2-9e8e-503b08c4682f",
                                "text": "„Nach dem Essen, als wir wieder auf der Höhe unserer Zurechnungsfähigkeit und unserer normalen Kommunikationsstärke angelangt sind, spazieren wir Richtung Anlegestelle, an unserem Schiff vorbei und winken unseren Mitreisenden zu, die das Sonnendeck bevölkern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4430ce4-bbc4-43f9-abf2-62538152572d",
                        "source_entry_id": "c4b9a659-1c85-3f34-bc5e-9ac00d32d5de",
                        "source_sense_id": "6b12065d-6552-36f2-9e8e-503b08c4682f",
                        "source_sense_description": "Stelle am Ufer, an der Schiffe anlegen können",
                        "target_lang_word": "landing place",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "landing place",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b26b7cc7-6130-373b-9415-d8bcabe24b8c",
                                        "entry_id": "7363cb65-7e4e-3c54-b284-4ecb4073bd64",
                                        "glosses": [
                                            "A place suitable for embarking onto or disembarking from a boat or ship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa07efe5-658b-4a05-ab77-fe31db79e9e2",
                                                "sense_id": "b26b7cc7-6130-373b-9415-d8bcabe24b8c",
                                                "text": "Long before the pier was built, Creggans (from the Gaelic creagan, meaning 'rock' or 'crag'), as this part of Strachur has always been known, was a regular landing place for boats, and it is here that Mary, Queen of Scots landed when she came to Strachur more than four-hundred years ago."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d23aedf-5e76-4b9f-9b24-9adfbdeabffa",
                        "source_entry_id": "c4b9a659-1c85-3f34-bc5e-9ac00d32d5de",
                        "source_sense_id": "6b12065d-6552-36f2-9e8e-503b08c4682f",
                        "source_sense_description": "Stelle am Ufer, an der Schiffe anlegen können",
                        "target_lang_word": "landing stage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "landing stage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfc8360a-2b16-3f65-877f-e3f6c7d73363",
                                        "entry_id": "3a778087-b82d-3a64-bec2-36c609f8c17e",
                                        "glosses": [
                                            "A floating platform attached at one end to a wharf so as to rise and fall with the tide, and thus facilitate passage between the wharf and a vessel lying beside the stage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff715671-1dad-4960-b3d8-4a2fc0fcbede",
                                                "sense_id": "cfc8360a-2b16-3f65-877f-e3f6c7d73363",
                                                "text": "He helped Crabbe along to the rough landing-stage, a groaning Crabbe sorry for himself, a Crabbe with a bandaged foot, looking like a gouty uncle[.]"
                                            },
                                            {
                                                "example_id": "270902c4-cd54-4808-94ee-491a186191e1",
                                                "sense_id": "cfc8360a-2b16-3f65-877f-e3f6c7d73363",
                                                "text": "Close by, across the Parade, are the Customs Examination Rooms and the floating landing stage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c891165-c8eb-4fdd-bd91-189b6751d93a",
                        "source_entry_id": "c4b9a659-1c85-3f34-bc5e-9ac00d32d5de",
