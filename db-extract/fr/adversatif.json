                "senses": [
                    {
                        "sense_id": "985b7eb7-359d-308b-a155-16fe430bcbcd",
                        "entry_id": "360e8bb1-a0bb-37fc-80c0-647faec6f3f7",
                        "glosses": [
                            "Qualifie une conjonction qui marque une opposition, une différence entre ce qui la précède et ce qui la suit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ede027a-4e71-41a9-8540-960c9c45e797",
                                "sense_id": "985b7eb7-359d-308b-a155-16fe430bcbcd",
                                "text": "Mais est une conjonction adversative."
                            },
                            {
                                "example_id": "d9226cf5-78ab-46ae-a559-406f273c3847",
                                "sense_id": "985b7eb7-359d-308b-a155-16fe430bcbcd",
                                "text": "Or dans chacun de ces cas, les deux énoncés reliés par si sont dans un rapport adversatif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3bcd59a-ab3b-4776-a89d-e67314df9247",
                        "source_entry_id": "360e8bb1-a0bb-37fc-80c0-647faec6f3f7",
                        "source_sense_id": "985b7eb7-359d-308b-a155-16fe430bcbcd",
                        "target_lang_word": "adversativ",
