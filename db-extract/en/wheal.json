                "senses": [
                    {
                        "sense_id": "9a532d91-b6c7-35ac-8de6-88805ee65d2a",
                        "entry_id": "83c4df5c-c063-3049-9d77-5de47bae8cb5",
                        "glosses": [
                            "A small raised swelling on the skin, often itchy, caused by a blow from a whip or an insect bite etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65631db6-104c-41af-8cd9-20da4b8f76ee",
                                "sense_id": "9a532d91-b6c7-35ac-8de6-88805ee65d2a",
                                "text": "A Perſon of Honour, of a full Body abounding with ſharp Humours, was ſeized with an Herpes on his right Leg. […] [I]t inflamed and ſwelled very much, many Wheals aroſe, and fretted one into another, with great Excoriation."
                            },
                            {
                                "example_id": "5d7bc472-1a3e-4f86-bb34-42b562892a40",
                                "sense_id": "9a532d91-b6c7-35ac-8de6-88805ee65d2a",
                                "text": "So they gripped again until red wheals rose on their backs and shoulders by reason of the grievous clasping of their arms."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "cb556739-55d0-4578-a600-153658af6e52",
