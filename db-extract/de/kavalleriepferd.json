                "senses": [
                    {
                        "sense_id": "ed8663ec-3736-31e1-a98b-dba7cd092bae",
                        "entry_id": "cf97e20c-7ad1-399d-a6a4-f2bc771ba482",
                        "glosses": [
                            "Pferd der Reiterei"
                        ],
                        "tags": [
                            "Heer"
                        ],
                        "examples": [
                            {
                                "example_id": "9f91c4cb-35ef-4ef1-9ae5-b6886ba1afa1",
                                "sense_id": "ed8663ec-3736-31e1-a98b-dba7cd092bae",
                                "text": "„Solche ca. 1 00 000 Mann umfassende Armee wie die französische Niederrheinarmee dürfte 25 000 Pferde mit sich geführt haben, von denen jedes Kavalleriepferd täglich ein Ration von '/2 Spint Hafer und 12 Pfund Heu erhält, während ein Infanteriepferd mit 15 Pfund Heu ohne jede Haferzuteilung auskommen muß.“"
                            },
                            {
                                "example_id": "77a3167b-eb6c-416e-81e3-7c12130f403b",
                                "sense_id": "ed8663ec-3736-31e1-a98b-dba7cd092bae",
                                "text": "„Noch am Leben waren auch an die tausend Zugochsen und mehr als hunderttausend Pferde, die die Kanonen und Kutschen bis nach Borodino gezogen hatten, dazu die Reitpferde der Garde und die Kavalleriepferde des Königs von Neapel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
