                "senses": [
                    {
                        "sense_id": "40b3a66e-7882-3f09-ab53-09fbc761747e",
                        "entry_id": "aae05b06-7fa5-3def-a7ba-33c8d1852c83",
                        "glosses": [
                            "Gebäude oder Raum, in dem eine Ombudsperson schriftliche und/oder verwaltungstechnische Dinge erledigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5d713c5-8b40-4d33-aa52-5a745469dbe8",
                                "sense_id": "40b3a66e-7882-3f09-ab53-09fbc761747e",
                                "text": "„Im Februar 2012 zogen acht Familien mangels einer geeigneten Alternative vorübergehend in Räume im Ombudsbüro.“"
                            },
                            {
                                "example_id": "408db596-cc7b-4da4-9889-0dd086616906",
                                "sense_id": "40b3a66e-7882-3f09-ab53-09fbc761747e",
                                "text": "„Das namibische Ombudsbüro kritisiert regelmässig die massive Überbelegung der Gefängnisse.“"
                            },
                            {
                                "example_id": "4150cb47-e144-491f-82ba-03738c330926",
                                "sense_id": "40b3a66e-7882-3f09-ab53-09fbc761747e",
                                "text": "„Das Ombudsbüro für Studium und Lehre nimmt zur Sicherstellung guter Studienbedingungen studentische Beschwerden und Verbesserungsvorschläge entgegen.“"
                            },
                            {
                                "example_id": "eaa01b4f-ae28-4b04-ae2c-b148f6ad861c",
                                "sense_id": "40b3a66e-7882-3f09-ab53-09fbc761747e",
                                "text": "„Beide Themen, sowohl Gebühren wie Kontolöschungen, fielen allerdings nicht in den Einflussbereich des Ombudsbüros, sondern seien Geschäftsentscheidungen der Banken.“"
                            },
                            {
                                "example_id": "f35dd781-2772-4cfd-8144-2ce8e765def7",
                                "sense_id": "40b3a66e-7882-3f09-ab53-09fbc761747e",
                                "text": "„Als erstes heimisches Geldinstitut hat die Bank Austria bereits im Jahr 1992 Ombudsbüros als zentrale Anlaufstelle für Kundenprobleme jeglicher Art eingerichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
