                                    {
                                        "sense_id": "ae681583-5894-30ca-b3e0-930a10eec33c",
                                        "entry_id": "9ce45c3f-b08c-3fc9-991b-18792eac7bb5",
                                        "glosses": [
                                            "aus der Säkularisierung (mentaler Prozess der Trennung von Religion und Staat) und der Säkularisation (konkreter Prozess der Ablösung der weltlichen Macht religiöser Institutionen) erwachsene Weltanschauung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fda6f8b-3544-4f50-9723-09d46c0d689b",
                                                "sense_id": "ae681583-5894-30ca-b3e0-930a10eec33c",
                                                "text": "Der Säkularismus ist ein wesentlicher Baustein der Moderne: Die Trennung von Staat und Religion funktioniert nicht mehr, sagen Experten."
                                            },
                                            {
                                                "example_id": "b220889d-a925-422f-be2d-72096484025f",
                                                "sense_id": "ae681583-5894-30ca-b3e0-930a10eec33c",
                                                "text": "Die Türkei sucht nach einer politischen Identität zwischen Islam und Säkularismus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c99533ad-a316-4228-af5a-f07ad8a57aa2",
                        "source_entry_id": "a87e96a1-9ab4-3734-a40c-6a6b1831d3c9",
                        "source_sense_description": "neutrality towards all religions",
                        "target_lang_word": "Laizität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
