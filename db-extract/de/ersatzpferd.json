                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9767587-091e-4216-8eb1-5350e8ee724d",
                                "sense_id": "f65081c4-aa3f-3748-981e-6261389bbe17",
                                "text": "„Die in Preußen bestellten Ersatzpferde ließen auf sich warten, mussten auch erst für den Kriegsdienst abgerichtet werden.“"
                            },
                            {
                                "example_id": "5b87117c-0113-462c-a4fd-3b793ed0f92f",
                                "sense_id": "f65081c4-aa3f-3748-981e-6261389bbe17",
                                "text": "„Pécuchet nahm in Falaise am neunten Tag seiner Reise ein Ersatzpferd zur Aushilfe, und bis Sonnenuntergang kam man gut voran.“"
                            }
                        ],
