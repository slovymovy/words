                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2090bfd-d6f3-42a6-9455-71b3aaab7da7",
                                                "sense_id": "25d882db-74a2-3804-8ef6-71832b00a8a6",
                                                "text": "Rather, they issue forth as fragmented commentary, casual mentionings, and sporadic allusions to aspects of the lives and times of universally known characters who have come to represent archetypes, moral types, and object lessons."
                                            }
                                        ]
