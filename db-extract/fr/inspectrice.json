                                        "examples": [
                                            {
                                                "example_id": "784cdd25-d987-4c8e-a8e0-371cade259c6",
                                                "sense_id": "f1307b85-d93b-344e-8811-959e4c4c5bcc",
                                                "text": "If, after due warning, our light-minded friends will write to us in terms that mislike that excellent and punctilious inspectress, they must aby it in the cold looks and bitter innuendoes which will be their portion when they come to us in the next hunting season."
                                            },
