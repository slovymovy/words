                "senses": [
                    {
                        "sense_id": "57fc6682-b4f1-30a1-8ad3-3ed1dd6849a8",
                        "entry_id": "88227653-0082-3d7c-b3ab-90ddf5262d58",
                        "glosses": [
                            "Ausdruck in Verbindung mit haben für spinnen, verrückt sein"
                        ],
                        "tags": [
                            "Austrian German",
                            "casual",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "20d04687-a656-48df-8f11-07be41aeb209",
                                "sense_id": "57fc6682-b4f1-30a1-8ad3-3ed1dd6849a8",
                                "text": "„Was werden jetzt die Leute von dir denken, wenn du das gleich am Anfang sagst? Die denken doch, du hast einen Huscher!!“"
                            },
                            {
                                "example_id": "84b2d245-c856-4167-90f4-670f4f1cbed2",
                                "sense_id": "57fc6682-b4f1-30a1-8ad3-3ed1dd6849a8",
                                "text": "„Wenn in der Seele etwas nicht passt, und ich gehe zu einem Professionisten dann heißt es, na der hat einen Huscher.“"
                            },
                            {
                                "example_id": "f449f917-9cd1-49ce-b0a8-4a623a8f86f2",
                                "sense_id": "57fc6682-b4f1-30a1-8ad3-3ed1dd6849a8",
                                "text": "„Jeder Mensch hat eine Störung. Es gibt vier Stufen: den Huscher, Zischer, Pascher und Klescher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
