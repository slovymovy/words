                                        "entry_id": "289366f2-6a47-37be-a36d-198ea6e6d937",
                                        "glosses": [
                                            "Schlaf- und Beruhigungsmittel, das während Schwangerschaft zu schweren Fehlbildungen bei den Kindern führte und deswegen aus dem Handel genommen wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e73f9112-577e-45e9-90b0-3ca78cb21262",
                                                "sense_id": "0e68ea91-2b06-3d7a-aa3b-b7ea577a9c34",
                                                "text": "„In Deutschland war das Schlaf- und Beruhigungsmittel Contergan von 1957 bis 1961 rezeptfrei vertrieben worden, es wurde auch von vielen Schwangeren genommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "685fe345-9293-4e86-b64e-12a006390394",
                        "source_entry_id": "de98b34d-34f3-3d32-90c0-db39f1572e3c",
                        "source_sense_id": "3cb0a79b-3305-3849-a9ee-ea8ce7cd6f4f",
                        "source_sense_description": "drug",
                        "target_lang_word": "θαλιδομίδη",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "θαλιδομίδη",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "2567b15d-dac2-3bbc-8b45-ab9ae8488cde",
                                        "entry_id": "3adc8153-e8b2-3baf-9d3d-08e7eb812554",
                                        "glosses": [
                                            "ανοσορυθμιστικό φάρμακο (πλήρης ονομασία: Ν-φθαλίμιδο-γλουταριμίδη) που πρωτοκυκλοφόρησε στη Δυτική Γερμανία και συνταγογραφούταν σαν ηρεμιστικό ή υπνωτικό αλλά και για τη θεραπεία του άγχους, της αϋπνίας κ.ά. Λόγω των επικίνδυνων παρενεργειών του απαγορεύτηκε η κυκλοφορία του"
                                        ],
                                        "tags": [
                                            "φαρμακευτική"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a201201-7b36-464d-9bff-09a73441911d",
                                                "sense_id": "2567b15d-dac2-3bbc-8b45-ab9ae8488cde",
                                                "text": "Η γιατρός προσελήφθη στην υπηρεσία το 1960. Ήταν εκείνη που δεν έδωσε την άδεια στην φαρμακευτική εταιρεία William S Merrell να κυκλοφορήσει την θαλιδομίδη στις Ηνωμένες Πολιτείες επειδή είχε διαβάσει εκθέσεις ότι το φάρμακο συνδεόταν με γενετικές ανωμαλίες. Η θαλιδομίδη ήταν ένα από τα φάρμακα που οι γυναικολόγοι συνήθιζαν να συνταγογραφούν στις έγκυες για να αντιμετωπίζουν την πρωινή αδιαθεσία και τη ναυτία. (*)"
                                            },
                                            {
                                                "example_id": "48df43f4-b934-4d8e-aeef-15ad27e62384",
                                                "sense_id": "2567b15d-dac2-3bbc-8b45-ab9ae8488cde",
                                                "text": "Σε παγκόσμια κλίμακα, δεν υπήρξε ποτέ άλλο φάρμακο που προκάλεσε μια τραγωδία ανάλογη με εκείνη που προκάλεσε η θαλιδομίδη. (*)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
