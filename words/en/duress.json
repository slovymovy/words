{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1a0fa0b7-e36f-3c52-bd2d-f3c02b1df3ec",
                    "sense_definition": "Compulsion or constraint by threat, violence, or force, especially applied unlawfully.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defendant argued that he signed the contract under <w>duress</w>.",
                            "target_lang_translations": {
                                "ru": "Ответчик утверждал, что подписал контракт под <w>принуждением</w>."
                            }
                        },
                        {
                            "text": "Investigators were concerned that the confession had been obtained under <w>duress</w>.",
                            "target_lang_translations": {
                                "ru": "Следователи опасались, что признание было получено под <w>давлением</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "coercion",
                        "compulsion",
                        "pressure"
                    ],
                    "common_phrases": [
                        "under duress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принуждение или ограничение свободы действий угрозами, насилием или силой, особенно противозаконное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принуждение",
                                "target_lang_sense_clarification": "силой или угрозами"
                            },
                            {
                                "target_lang_word": "давление",
                                "target_lang_sense_clarification": "моральное или физическое воздействие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aacc30d9-5c9e-30f0-9fdd-09a0512ce4a8",
                    "sense_definition": "Harsh, severe, or oppressive treatment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoners endured prolonged periods of physical <w>duress</w> before being rescued.",
                            "target_lang_translations": {
                                "ru": "Заключённые перенесли долгие периоды физических <w>лишений</w>, прежде чем их освободили."
                            }
                        },
                        {
                            "text": "Historic records reveal the extreme economic <w>duress</w> faced by local laborers.",
                            "target_lang_translations": {
                                "ru": "Исторические документы свидетельствуют о крайних экономических <w>трудностях</w>, с которыми сталкивались местные рабочие."
                            }
                        }
                    ],
                    "synonyms": [
                        "hardship",
                        "oppression"
                    ],
                    "target_lang_definitions": {
                        "ru": "Суровые, тяжёлые или гнетущие условия, обращение или обстоятельства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лишения",
                                "target_lang_sense_clarification": "тяжкие условия, страдания"
                            },
                            {
                                "target_lang_word": "гнёт",
                                "target_lang_sense_clarification": "тяжёлое или угнетающее воздействие"
                            },
                            {
                                "target_lang_word": "тяжёлые условия",
                                "target_lang_sense_clarification": "бедственное или суровое положение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "71a8571a-10b0-33b6-91df-055d4ac43928",
                    "sense_definition": "To subject someone to duress; to coerce or pressure forcefully.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smaller nation was <w>duressed</w> into surrendering strategic border territory.",
                            "target_lang_translations": {
                                "ru": "Маленькое государство <w>принудили</w> сдать стратегическую приграничную территорию."
                            }
                        },
                        {
                            "text": "He claimed that corrupt officials were actively <w>duressing</w> him to withdraw his testimony.",
                            "target_lang_translations": {
                                "ru": "Он заявлял, что коррумпированные чиновники активно <w>оказывали на него давление</w>, требуя отозвать показания."
                            }
                        }
                    ],
                    "synonyms": [
                        "coerce",
                        "pressurize",
                        "compel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принуждать кого-либо к действию силой, давлением или угрозами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принуждать",
                                "target_lang_sense_clarification": "заставлять силой или угрозами"
                            },
                            {
                                "target_lang_word": "оказывать давление",
                                "target_lang_sense_clarification": "давить с целью заставить что-либо сделать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}