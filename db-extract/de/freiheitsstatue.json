                                        "glosses": [
                                            "A pattern where the props are thrown from one hand to the other in a circular motion, with one hand raised significantly above the other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83064f4d-a90d-42d4-b5a8-41e3f267ec83",
                                                "sense_id": "95d52b09-b3d9-3f57-941e-5f5c97a8d25e",
                                                "text": "Famous tricks such as the Mills Mess, Burke's Barrage, and Rubenstein's Revenge are covered, along with fundamentals (Statue of Liberty, the Snake, the Machine, 4 4 1)[…]"
                                            }
