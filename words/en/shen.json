                },
                {
                    "sense_id": "6554835c-a6ed-3162-bb06-cf4cf23b28dd",
                    "sense_definition": "A river located in Hubei province, China.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The <w>Shen</w> River flows through a mountainous region before joining a larger tributary.",
                            "target_lang_translations": {
                                "ru": "Река <w>Шэнь</w> протекает через горный регион, прежде чем впасть в более крупный приток."
                            }
                        },
                        {
                            "text": "Local farmers rely on the waters of the <w>Shen</w> for their seasonal irrigation.",
                            "target_lang_translations": {
                                "ru": "Местные фермеры полагаются на воды реки <w>Шэнь</w> для сезонного орошения."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Река в провинции Хубэй, Китай."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Шэнь",
                                "target_lang_sense_clarification": "название реки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1851f0e-aaff-3461-94da-b9b84ba8d467",
                    "sense_definition": "A former prefecture of imperial China, now part of Hengshui in Hebei province.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "history",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "Historical records from the Tang dynasty mention the administrative importance of <w>Shen</w>.",
                            "target_lang_translations": {
                                "ru": "Исторические записи династии Тан упоминают об административной важности области <w>Шэнь</w>."
                            }
                        },
                        {
                            "text": "The ancient borders of <w>Shen</w> were reorganized during the modern administrative reforms.",
                            "target_lang_translations": {
                                "ru": "Древние границы <w>Шэнь</w> были изменены в ходе современных административных реформ."
                            }
                        }
                    ],
                    "target_lang_definitions": {
