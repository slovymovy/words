                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "6133da1b-c7e2-4a95-985c-dbb6d67f7c95",
                                "sense_id": "2534cdbd-9fc3-3234-829e-ab2adadb4414",
                                "text": "„Die Vulkanologen leben während des Sommers in einfachen Datschas am Fuß der Feuerberge und sind in der Wildnis Kamtschatkas auf sich allein gestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e53c5a6-70a1-4af0-aeeb-eec646b635d7",
                        "source_entry_id": "a31fc24a-1c0c-3f72-9e49-6a2398d0718c",
                        "source_sense_id": "2534cdbd-9fc3-3234-829e-ab2adadb4414",
                        "source_sense_description": "poetisch: Vulkan",
                        "target_lang_word": "volcano",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volcano",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf7c03d4-646a-3e3e-b175-7ba2f21b845b",
                                        "entry_id": "8629a900-8189-32a6-bbcd-cb567a12ebe2",
                                        "glosses": [
                                            "A vent or fissure on the surface of a planet (usually in a mountainous form) with a magma chamber attached to the mantle of a planet or moon, periodically erupting forth lava and volcanic gases onto the surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe695abb-1ef2-4c6c-af0b-4a6b7d3d2186",
                                                "sense_id": "bf7c03d4-646a-3e3e-b175-7ba2f21b845b",
                                                "text": "Iceland's volcanoes are among the most active on Earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b40b548-0158-35ee-aa52-257cdc0c58c1",
                                        "entry_id": "8629a900-8189-32a6-bbcd-cb567a12ebe2",
                                        "glosses": [
                                            "A kind of firework producing an upward plume of sparks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "volcano",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c5dfb85-d0d2-3fb0-9b4c-54f1f6c2e08e",
                                        "entry_id": "c0682c0a-fde4-367d-bd8f-607680976424",
                                        "glosses": [
                                            "to erupt; to burst forth"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e654de-4db2-4442-9f4f-7c363133c9bd",
                                                "sense_id": "0c5dfb85-d0d2-3fb0-9b4c-54f1f6c2e08e",
                                                "text": "She shrank back, the words volcanoed, words that stabbed again, and yet again"
                                            },
                                            {
                                                "example_id": "ef9c36ac-1700-4640-ab89-d48d5f096675",
                                                "sense_id": "0c5dfb85-d0d2-3fb0-9b4c-54f1f6c2e08e",
                                                "text": "Startled, you look up at the horizon just in time to see a gigantic plume of ash and dust volcanoing up into the sky and spreading out to form a gigantic cloud that will persist for days, weeks, perhaps years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a3495bd-fd17-4749-827b-6e3e3cd82003",
                        "source_entry_id": "a31fc24a-1c0c-3f72-9e49-6a2398d0718c",
                        "source_sense_id": "2534cdbd-9fc3-3234-829e-ab2adadb4414",
                        "source_sense_description": "poetisch: Vulkan",
                        "target_lang_word": "volcan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volcan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "550d0b08-b71c-3da5-bf8b-dad7daa8d3aa",
                                        "entry_id": "623c953f-20e8-3a47-bc0a-5dc01791a94e",
                                        "glosses": [
                                            "Ouverture, gouffre qui s’ouvre sur une chambre magmatique et d’où il sort périodiquement des tourbillons de feu, de fumée, des cendres, des matières en fusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa97a9fd-c203-4f3a-931f-b3d93fbf7043",
                                                "sense_id": "550d0b08-b71c-3da5-bf8b-dad7daa8d3aa",
                                                "text": "Après un tel paroxysme, l’éboulement des côtés du cratère obstrue encore plus l’orifice du volcan, et l’oblitère entièrement. On peut alors procéder à des observations […]."
                                            },
                                            {
                                                "example_id": "0ecd308e-0d5b-4d38-b3b6-0de376d5d89b",
                                                "sense_id": "550d0b08-b71c-3da5-bf8b-dad7daa8d3aa",
                                                "text": "Beaucoup des tripolis et des randanites (ou Kieselguhr), dites souvent improprement « terres d’Infusoires », qui sont employées dans l’industrie, se sont ainsi formés autrefois dans les lacs de notre pays d’Auvergne, en particulier dans le versant nord de l’ancien grand volcan du Cantal, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1d4562b-5dec-3988-906d-9bc43dcb5f85",
                                        "entry_id": "623c953f-20e8-3a47-bc0a-5dc01791a94e",
                                        "glosses": [
                                            "Se dit d’une imagination vive, ardente, impétueuse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fd4bbe5-2928-462b-b82f-38367df84c0c",
                                                "sense_id": "c1d4562b-5dec-3988-906d-9bc43dcb5f85",
                                                "text": "Son imagination est un volcan. La tête de ce jeune homme est un volcan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee0fb47e-f281-3cd7-8239-fa1aa3a7db55",
                                        "entry_id": "623c953f-20e8-3a47-bc0a-5dc01791a94e",
                                        "glosses": [
                                            "Se dit aussi en parlant des intrigues sourdes, des conspirations, des dangers imminents, mais cachés."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaf6bbdc-ddcd-46d8-87c7-738a45764b70",
                                                "sense_id": "ee0fb47e-f281-3cd7-8239-fa1aa3a7db55",
                                                "text": "C’est dormir sur un volcan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b91cda61-5f5b-4df5-9121-9b230c162459",
                        "source_entry_id": "a31fc24a-1c0c-3f72-9e49-6a2398d0718c",
