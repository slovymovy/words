                "senses": [
                    {
                        "sense_id": "c0247c9b-1d0b-3fe8-a747-b17c3eae94e9",
                        "entry_id": "2bc530b1-a6a5-345b-9297-ed2bccface45",
                        "glosses": [
                            "Marché occasionnel souvent dans la rue où les particuliers et les professionnels vendent ce qu’ils veulent.."
                        ],
                        "tags": [
                            "France",
                            "Belgique",
                            "Surtout usité dans le nord de la France et en Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "d41d85a4-a9b1-4fef-b124-43a3a7d5e103",
                                "sense_id": "c0247c9b-1d0b-3fe8-a747-b17c3eae94e9",
                                "text": "C’était [la foire des Mosi] il y a peu d’années encore, une vaste kermesse, un grand marché de campagne, une braderie villageoise."
                            },
                            {
                                "example_id": "cc2f93b9-63ac-47f9-b117-e10bd4365bdc",
                                "sense_id": "c0247c9b-1d0b-3fe8-a747-b17c3eae94e9",
                                "text": "La dénomination de nombreuses braderies et « foires à tout » joue la carte de la transparence : on sait qu'on trouvera, sortis des greniers, plus d'objets de peu de valeur et de nanars que de meubles de style et autres antiquités de prestige […].,"
                            },
                            {
                                "example_id": "6ad89d41-4924-42ed-bf03-f6d22d7b8726",
                                "sense_id": "c0247c9b-1d0b-3fe8-a747-b17c3eae94e9",
                                "text": "Impressionnant ! Tous les ans, le second week-end d'août, c'est le grand bric à brac de Mézilles. Soit le deuxième plus important de France après la grande braderie de Lille."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b4cd223-6595-34bf-979b-c4d2f43c6b2c",
                        "entry_id": "2bc530b1-a6a5-345b-9297-ed2bccface45",
                        "glosses": [
                            "Action de brader, cession à l’encan, gaspillage."
                        ],
                        "tags": [],
                        "examples": [
                            {
