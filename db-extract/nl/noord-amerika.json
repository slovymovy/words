                    {
                        "translation_id": "dbed5b61-dfc7-4b72-abbd-bea07d82a348",
                        "source_entry_id": "c79b06f6-1d9b-308a-a3fc-8611c0f99035",
                        "source_sense_id": "72f9a85b-5542-3aba-9445-40713e7eb6a0",
                        "source_sense_description": "het continent dat ten noorden van Zuid-Amerika ligt, tussen de Grote, Arctische en de Atlantische Oceaan",
                        "target_lang_word": "Amérique du Nord",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amérique du Nord",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43479224-54ea-36ba-992b-033a5ccc9917",
                                        "entry_id": "df567cbf-5878-385f-9f35-57ac5fb93c0a",
                                        "glosses": [
                                            "Sous-continent constituant la partie nord de l’Amérique, formé des États-Unis, du Canada, du Mexique et du Groenland."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1ea2b52-c5f9-461b-9745-30726e157e87",
                                                "sense_id": "43479224-54ea-36ba-992b-033a5ccc9917",
                                                "text": "À peine l’indépendance de l’Amérique du Nord fut-elle proclamée, la paix conclue avec l’ancienne métropole, que ces hommes qui criaient si haut à la tyrannie, à l’oppression, qui réclamaient contre la violation du droit des gens, dont, disaient-ils, ils étaient victimes, organisèrent avec cet implacable sang-froid qu’ils tiennent de leur origine une chasse aux Indiens."
                                            },
                                            {
                                                "example_id": "cc18bdbd-0008-4e63-8444-3eea38980228",
                                                "sense_id": "43479224-54ea-36ba-992b-033a5ccc9917",
                                                "text": "On pouvait alors déterminer la marche des races dites rouges. Parti des steppes mongoles, un courant humain déferlait en Sibérie, gagnait l’Alaska, envahissait peu à peu l’Amérique du Nord."
                                            },
                                            {
                                                "example_id": "98b29b30-b7a5-4c83-996b-b712ad667995",
                                                "sense_id": "43479224-54ea-36ba-992b-033a5ccc9917",
                                                "text": "Cette essence provient de la distillation des racines du sassafras officinal répandu en Amérique du Nord où il se présente sous l’aspect de grands arbres."
                                            },
                                            {
                                                "example_id": "5e8d9b37-7f16-4721-bc9e-f88c9828beff",
                                                "sense_id": "43479224-54ea-36ba-992b-033a5ccc9917",
                                                "text": "L'aventure du phylloxera fut, d'ailleurs, sur le point de se renouveler quelques années plus tard, lors de l’invasion de l'Europe par le doryphore, vulgairement appelés bête du Colorado et comme son nom l'indique, lui aussi originaire de l’Amérique du Nord, et qui parasite la pomme de terre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
