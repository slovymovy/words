                                        "sense_id": "8c3c5d0c-2efd-3a58-ad8b-236e9cfc3410",
                                        "entry_id": "84eb225c-f9c0-3c0e-a7b5-61a6d6e20adb",
                                        "glosses": [
                                            "Someone who sells their services to clients without a long-term employment contract."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dd39f58-2fb2-4b00-9008-4af34f8a4997",
                                                "sense_id": "8c3c5d0c-2efd-3a58-ad8b-236e9cfc3410",
                                                "text": "The objector, one Millworthy, a free-lance of journalism, was not to be so easily silenced."
                                            },
                                            {
                                                "example_id": "12738a92-50b5-4576-af38-9886ae58ea78",
                                                "sense_id": "8c3c5d0c-2efd-3a58-ad8b-236e9cfc3410",
                                                "text": "The person you are revising (the revisee) is a colleague at your own rank, or another freelance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd08314f-adeb-322d-b2fa-ebcd71b9d44a",
