                "senses": [
                    {
                        "sense_id": "31334c5c-9a0a-3f65-a45f-d10b2a343998",
                        "entry_id": "409694cb-74d9-3732-97e5-e9687d0b3250",
                        "glosses": [
                            "Resembling the metal copper, especially in color."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5b12bfe-50f8-4bb8-a009-0419eb88e965",
                                "sense_id": "31334c5c-9a0a-3f65-a45f-d10b2a343998",
                                "text": "That night I dreamed I had a very disagreeable taste in my mouth, which caused me to spit all the time. I awoke and found my mouth full of saliva, with a coppery taste, and sure enough, I was obliged to spit."
                            },
                            {
                                "example_id": "ec70f7a1-8ed0-4b40-91f8-e5b6e9937563",
                                "sense_id": "31334c5c-9a0a-3f65-a45f-d10b2a343998",
                                "text": "Venetian women who wanted coppery hair colors applied bleaching mixtures, such as one that contained alum, sulfur, soda, and rhubarb. Then they sat in the sun, where heat produced a chemical reaction that developed the color."
                            }
                        ]
                    },
                    {
                        "sense_id": "276f4343-e879-38ba-acd6-db7f5db2b6b1",
                        "entry_id": "409694cb-74d9-3732-97e5-e9687d0b3250",
                        "glosses": [
                            "Containing copper, especially if abundantly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a31b73c3-ed60-40ea-96fa-5b0e73fd0b41",
                                "sense_id": "276f4343-e879-38ba-acd6-db7f5db2b6b1",
                                "text": "an especially coppery grade of brass"
                            }
                        ]
