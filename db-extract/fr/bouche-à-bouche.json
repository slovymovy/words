                        "glosses": [
                            "Technique de respiration artificielle qui consiste à insuffler de l'air de ses propres poumons dans la bouche de la victime, tout en lui pinçant le nez."
                        ],
                        "tags": [
                            "Secourisme"
                        ],
                        "examples": [
                            {
                                "example_id": "d03df3ee-66d7-4f7f-8ef4-0775aef8a1a1",
                                "sense_id": "4e1ba5a0-2ed9-35ac-bcef-886cd793ef28",
                                "text": "La ventilation par le bouche-à-bouche (BAB) est le moyen le plus simple pour un secouriste d’administrer à une victime en arrêt ventilatoire une quantité d’air permettant d’assurer une ventilation minimale."
                            }
                        ]
                    }
