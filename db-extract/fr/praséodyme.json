                "senses": [
                    {
                        "sense_id": "5d79c420-b9ef-3174-a206-c3a7478aa4ae",
                        "entry_id": "250b893e-bbd0-30a8-a263-9abbc93f173b",
                        "glosses": [
                            "Élément chimique de numéro atomique 59 et de symbole Pr qui fait partie de la série chimique des lanthanides et des terres rares."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ad80972e-da34-49f7-a140-ee7789c8c99c",
                                "sense_id": "5d79c420-b9ef-3174-a206-c3a7478aa4ae",
                                "text": "Le praséodyme, comme tous les lanthanides, est une terre rare."
                            }
                        ]
                    },
                    {
                        "sense_id": "b738bc2b-b490-3e12-b204-1ca341f19d2f",
                        "entry_id": "250b893e-bbd0-30a8-a263-9abbc93f173b",
                        "glosses": [
                            "Métal pur de cet élément, gris-argenté, ductile, et lentement oxydé à l’air à température ambiante."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42725f8f-2000-4ab0-920d-96270876d629",
                        "source_entry_id": "250b893e-bbd0-30a8-a263-9abbc93f173b",
                        "target_lang_word": "Praseodym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Praseodym",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64b07962-b5da-3052-9007-a213f37b8dea",
                                        "entry_id": "293ceb38-5668-3584-a412-e0aacdb6253e",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 59, das zu den Lanthanoiden gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56034919-d77a-4e68-8556-8f21a757071d",
                                                "sense_id": "64b07962-b5da-3052-9007-a213f37b8dea",
                                                "text": "Praseodym ist ein weiches, silberweißes paramagnetisches Metall."
                                            },
                                            {
                                                "example_id": "663d61e2-b5d4-403c-9ea6-1f4a24b4ec67",
                                                "sense_id": "64b07962-b5da-3052-9007-a213f37b8dea",
                                                "text": "„Wegen seiner Luftempfindlichkeit sollte Praseodym unter Benzin oder in Kunststoff oder Glas versiegelt aufbewahrt werden.“"
                                            },
                                            {
                                                "example_id": "02e3e4b4-11c8-4d73-81c5-3f611c6e51e1",
                                                "sense_id": "64b07962-b5da-3052-9007-a213f37b8dea",
                                                "text": "„Allein von den für Permanentmagnete wichtigen und als knappe Ressource eingestuften Elementen Neodym und Praseodym könnten aus dem Fen Carbonatite Complex mindestens 1,5 Millionen Tonnen gefördert werden, so die vorläufige Abschätzung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3cac187c-01db-447d-bfff-40fa25811dc4",
