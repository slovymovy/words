                                "target_senses": [
                                    {
                                        "sense_id": "797bd376-e7e4-331c-b4f4-f017c1777b92",
                                        "entry_id": "bb02d7b4-02d7-338f-b596-212408dceb26",
                                        "glosses": [
                                            "Of, relating to, or as a result of an entheogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "419ac75b-8c21-48b6-bd98-52f92d92d06f",
                                                "sense_id": "797bd376-e7e4-331c-b4f4-f017c1777b92",
                                                "text": "During the past twenty-five years, entheogenic mushrooms have been available in food preparations prepared by native peoples of third world countries."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "entheogenic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66515541-8ddb-3988-81d6-33d93cc0f26f",
                                        "entry_id": "a29c1b40-ff60-3730-a040-f78e48067ceb",
                                        "glosses": [
                                            "Synonym of entheogen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37c63b92-6a66-46ff-85ae-d83f5b41e22a",
                                                "sense_id": "66515541-8ddb-3988-81d6-33d93cc0f26f",
                                                "text": "The use of entheogenics declined in areas where Judaism, Christianity, and Islam were popular due to these groups' disapproval of the practice."
                                            },
                                            {
                                                "example_id": "45377527-ed93-4db9-ae2f-1bd86ea72d8d",
                                                "sense_id": "66515541-8ddb-3988-81d6-33d93cc0f26f",
                                                "text": "Sensitive states of awareness, evident in various forms of spiritual/religious practice, for example Shamanism's use of entheogenics and Tantra's practices of sexual transcendence have for Morton become paradoxically refined in contemporary capitalism."
                                            },
                                            {
                                                "example_id": "58eee49f-351e-4209-8837-55aa87437931",
                                                "sense_id": "66515541-8ddb-3988-81d6-33d93cc0f26f",
                                                "text": "In spiritually inclined individuals taking entheogenics in a proper setting, this may even be easy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
