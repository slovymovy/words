    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3b2d5f83-4331-3b70-bc8a-04fb4041ab24",
                    "sense_definition": "Positioned so as to face in a particular direction, especially opposite or directly in front of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spatial_orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please refer to the diagram on the <w>facing</w> page for more details.",
                            "target_lang_translations": {
                                "ru": "Для получения более подробной информации обратитесь к диаграмме на <w>противоположной</w> странице."
                            }
                        },
                        {
                            "text": "The two <w>facing</w> houses had identical front gardens.",
                            "target_lang_translations": {
                                "ru": "У двух домов, <w>стоящих друг напротив друга</w, были одинаковые палисадники."
                            }
                        }
                    ],
                    "synonyms": [
                        "opposite",
                        "confronting"
                    ],
                    "common_phrases": [
                        "facing page",
                        "facing seats"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный лицом в определенном направлении, особенно напротив или прямо перед чем-то."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противоположный",
                                "target_lang_sense_clarification": "находящийся напротив"
                            },
                            {
                                "target_lang_word": "обращенный",
                                "target_lang_sense_clarification": "направленный лицом к чему-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87859066-2b8f-3797-8a1f-1f196e4c92b3",
                    "sense_definition": "Diverging in the direction of travel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spatial_orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train passed over a <w>facing</w> point on the railway track.",
                            "target_lang_translations": {
                                "ru": "Поезд проехал по <w>пошерстной</w> стрелке на железнодорожном пути."
                            }
                        },
                        {
                            "text": "Engineers inspected the <w>facing</w> switch to ensure the train would divert safely.",
                            "target_lang_translations": {
                                "ru": "Инженеры осмотрели <w>встречный</w> стрелочный перевод, чтобы убедиться в безопасности перевода поезда."
                            }
                        }
                    ],
                    "antonyms": [
                        "trailing"
                    ],
                    "common_phrases": [
                        "facing points",
                        "facing switch"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term used in railway engineering"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пошерстный (о стрелочном переводе на железной дороге), направленный навстречу движению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пошерстный",
                                "target_lang_sense_clarification": "о стрелочном переводе"
                            },
                            {
                                "target_lang_word": "встречный",
                                "target_lang_sense_clarification": "о направлении стрелки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a337e055-0afc-346a-9fa2-efe5f660d203",
                    "sense_definition": "present participle and gerund of <w>face</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are <w>facing</w> a very difficult challenge this semester.",
                            "target_lang_translations": {
                                "ru": "В этом семестре мы <w>сталкиваемся</w> с очень сложной задачей."
                            }
                        },
                        {
                            "text": "The building has a beautiful facade <w>facing</w> the main street.",
                            "target_lang_translations": {
                                "ru": "Здание имеет красивый фасад, <w>обращенный</w> к главной улице."
                            }
                        }
                    ],
                    "common_phrases": [
                        "facing a challenge",
                        "facing the truth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола face (сталкиваться, быть обращенным к)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сталкивающийся",
                                "target_lang_sense_clarification": "с трудностями или проблемами"
