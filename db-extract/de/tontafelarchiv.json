                ],
                "senses": [
                    {
                        "sense_id": "e28aae47-6e27-363c-91a5-0edea637336d",
                        "entry_id": "c05e22cd-551c-35b0-859e-682a471f9f91",
                        "glosses": [
                            "antike Sammlung beschrifteter Tontafeln, meistens als Urkunden, in der Regel in Tongefäßen verwahrt"
                        ],
                        "tags": [
                            "Vorderasien",
                            "Archiv",
                            "Keilschrift"
                        ],
                        "examples": [
                            {
                                "example_id": "35fa1540-76ae-42c6-adf7-b0ce7cec9ada",
                                "sense_id": "e28aae47-6e27-363c-91a5-0edea637336d",
                                "text": "„Die Briefe sind 1906 in der Türkei im Tontafelarchiv der ehemaligen hethitischen Hauptstadt Hattusa aufgefunden worden.“"
                            },
                            {
                                "example_id": "102e3561-b496-4137-8f50-6480d7558492",
                                "sense_id": "e28aae47-6e27-363c-91a5-0edea637336d",
                                "text": "„Keilschrifttafeln aus der Bronzezeit lüften das Geheimnis einer alten Königsstadt: Ein Tontafelarchiv, das in der Autonomen Region Kurdistan im Irak ausgegraben wurde […], weist den Fundort als die bedeutende mesopotamische Stadt Mardaman aus.“"
                            },
                            {
                                "example_id": "c92afbc5-0c00-40d1-b953-f7af3b35f427",
                                "sense_id": "e28aae47-6e27-363c-91a5-0edea637336d",
                                "text": "„Denn sie legten […] in Teil Beidar […] erst einen Palast, dann ein weiteres offizielles Gebäude […] und schließlich ein Tontafelarchiv frei. […] An diesem Ort […] wurden mit einem Schlag rund hundert Keilschrifttafeln aus Ton entdeckt, […].“"
                            },
                            {
                                "example_id": "77f5b689-017f-4089-87ce-9661ef3c76a3",
                                "sense_id": "e28aae47-6e27-363c-91a5-0edea637336d",
                                "text": "„1975 wurde [in Ebla] ein umfangreiches Tontafelarchiv entdeckt, das in einer bis dahin unbekannten westsemitischen Sprache (Eblaitisch) abgefasst ist.“"
                            },
                            {
                                "example_id": "fbed8c93-7d0c-4c55-8a17-97f81ecdd8b5",
                                "sense_id": "e28aae47-6e27-363c-91a5-0edea637336d",
                                "text": "„In dem von deutschen Archäologen freigelegten Tontafelarchiv im Palast von Hattuscha, der Hauptstadt der Hethiter, fand sich auch ein Text, der uns heute noch anrührt, die sogenannten Pestgebete nach einer langanhaltenden Seuche.“"
                            },
                            {
                                "example_id": "7cf4e07e-be3d-4c7a-acd3-cde7e6a3d378",
                                "sense_id": "e28aae47-6e27-363c-91a5-0edea637336d",
                                "text": "„Die Tafel des Mitannikönigs Tušratta ist durch inhaltsverwandte babylonische Diplomatenbriefe des Tontafelarchives aus El-Amarna aufgeklärt worden, […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
