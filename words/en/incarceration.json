    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a92be9c6-615a-3788-8155-caceb0cb0748",
                    "sense_definition": "The act of confining someone in prison, or the state of being imprisoned.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The activist faced unfair <w>incarceration</w> for protesting peacefully against the government. ",
                            "target_lang_translations": {
                                "tr": "Aktivist, hükümeti barışçıl bir şekilde protesto ettiği için haksız <w>hapse atılma</w> ile karşı karşıya kaldı."
                            }
                        },
                        {
                            "text": "Many human rights organizations are working to end mass <w>incarceration</w> across the globe.",
                            "target_lang_translations": {
                                "tr": "Birçok insan hakları örgütü dünya çapında kitlesel <w>hapis cezalarını</w> sona erdirmek için çalışıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "imprisonment",
                        "confinement",
                        "detention"
                    ],
                    "antonyms": [
                        "liberation",
                        "release",
                        "freedom"
                    ],
                    "common_phrases": [
                        "mass incarceration",
                        "face incarceration"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birini hapse atma eylemi veya hapiste tutulma durumu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hapse atma",
                                "target_lang_sense_clarification": "birini hapse kapatma eylemi"
                            },
                            {
                                "target_lang_word": "hapis",
                                "target_lang_sense_clarification": "hapiste bulunma durumu"
                            },
                            {
                                "target_lang_word": "tutuklama",
                                "target_lang_sense_clarification": "özgürlüğünden yoksun bırakma"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb11e0d1-b021-32c1-a9cc-d387858b9cfc",
                    "sense_definition": "The unnatural constriction or entrapment of a tissue or organ, such as a hernia.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor warned that an untreated hernia could lead to severe <w>incarceration</w> of the tissue. ",
                            "target_lang_translations": {
                                "tr": "Doktor, tedavi edilmeyen bir fıtığın dokunun şiddetli bir şekilde <w>sıkışmasına</w> yol açabileceği konusunda uyardı."
                            }
                        },
                        {
                            "text": "Emergency surgery was required to relieve the hernia <w>incarceration</w> before complication occurred.",
                            "target_lang_translations": {
                                "tr": "Komplikasyon meydana gelmeden önce fıtık <w>inkarserasyonunu</w> gidermek için acil cerrahi müdahale gerekiyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "strangulation",
                        "constriction"
                    ],
                    "common_phrases": [
                        "hernia incarceration"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Tıp dilinde fıtık gibi bir doku veya organın doğal olmayan şekilde sıkışması veya sıkışıp kalması durumu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "inkarserasyon",
                                "target_lang_sense_clarification": "tıbbi doku sıkışması"
                            },
                            {
                                "target_lang_word": "sıkışma",
                                "target_lang_sense_clarification": "organ veya dokunun fıtıklaşarak sıkışması"
                            }
                        ]
                    }
                }
            ]
        }
    ]
