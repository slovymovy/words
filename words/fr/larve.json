                        "stade de larve"
                    ]
                },
                {
                    "sense_id": "6aa35b7f-a7be-3d32-a3b0-4d04ba5e9ff2",
                    "sense_definition": "Personne particulièrement molle, paresseuse et dépourvue de volonté ou d'énergie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il passe ses journées entières devant son écran comme une véritable <w>larve</w>."
                        },
                        {
                            "text": "Ne te comporte pas comme une <w>larve</w> et viens nous aider à ranger."
                        }
                    ],
                    "synonyms": [
                        "lavette",
                        "mollusque"
                    ],
                    "common_phrases": [
