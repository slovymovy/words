                    {
                        "translation_id": "fd45b545-ebd4-4776-a5c8-3c926252db6d",
                        "source_entry_id": "166681b6-537c-373d-b48f-c12cef255803",
                        "source_sense_id": "f5b477b7-bf5c-3e4e-ae19-0401be107996",
                        "target_lang_word": "bolbliksem",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bolbliksem",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fc8d5d26-b4bb-38e5-8993-08507cce198b",
                                        "entry_id": "80b767c8-a3c9-35e2-b68d-7a4eaa06e5d6",
                                        "glosses": [
                                            "een helder oplichtend bolvormig object met een diameter van maximaal 40 centimeter, dat soms waargenomen wordt in de buurt van een blikseminslag en dan gedurende meerdere seconden zichtbaar is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "902f978d-7539-4255-bcec-be733d3ac3e9",
                                                "sense_id": "fc8d5d26-b4bb-38e5-8993-08507cce198b",
                                                "text": "Blikseminslag heeft woensdagmiddag in Noordijk een boom aan de Elsmansdijk gespleten. Getuigen zagen een bolbliksem. Na een enorme flits en dreun vlogen grote stukken van de stam meters in het rond. Boerderijen in de buurt zaten even zonder stroom."
                                            },
                                            {
                                                "example_id": "21192d34-a123-4f3f-b104-3d0583973caa",
                                                "sense_id": "fc8d5d26-b4bb-38e5-8993-08507cce198b",
                                                "text": "Midden in de nacht schrok ik wakker doordat de deur met een klap opensloeg. Twee jongens sprongen verschrikt de hut in, een hoop commotie veroorzakend. Ze waren naar buiten gegaan om te plassen maar werden daar plotseling omringd door een blauwe lichtbol. Niemand wist wat dat blauwe licht was geweest, misschien statische energie van de storm of een bolbliksem?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
