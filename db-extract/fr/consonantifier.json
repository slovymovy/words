                        "examples": [
                            {
                                "example_id": "b5293315-6f70-4d09-b5af-554a72250798",
                                "sense_id": "b6a61570-a4ab-3b7e-b003-ca077fc58595",
                                "text": "L'auteur y a montré, comment, dans certaines conditions, une voyelle quelconque tend en suédois à se consonantifier dans sa partie finale et il en a lui-même conclu (note 2, p. 36 du tirage à part) que « non seulement les voyelles extrêmes i, u, etc., mais encore les voyelles qui ne sont pas aux extrémités de l'échelle vocalique, telles que a, etc., sont susceptibles de produire directement des consonnes épenthétiques sans passer par les degrés de fermeture extréme i,u, etc... »"
                            },
                            {
                                "example_id": "d59cf3fa-bbdc-4681-ba8f-a23844d4d3b0",
                                "sense_id": "b6a61570-a4ab-3b7e-b003-ca077fc58595",
                                "text": "Quelques e pourtant, au lieu de se consonantifier, avaient été élidés en latin vulgaire."
                            }
                        ]
                    }
