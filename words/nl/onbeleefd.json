{
    "word_family": [
        "onbeleefdheid",
        "beleefdheid",
        "beleefd"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d598eb6b-bcb0-3d34-b7f5-e5fc7e0b0b21",
                    "sense_definition": "niet volgens de regels van het fatsoen; slecht gemanierd",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "manieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wees toch niet zo'n <w>onbeleefd</w> mannetje en bied nu je excuses aan!",
                            "target_lang_translations": {
                                "en": "Don't be such a <w>rude</w> little man and apologize now!"
                            }
                        },
                        {
                            "text": "Het is erg <w>onbeleefd</w> om met je mond vol te praten tijdens het eten.",
                            "target_lang_translations": {
                                "en": "It is very <w>impolite</w> to talk with your mouth full while eating."
                            }
                        }
                    ],
                    "synonyms": [
                        "horkerig",
                        "lomp"
                    ],
                    "antonyms": [
                        "beleefd"
                    ],
                    "common_phrases": [
                        "onbeleefd gedrag",
                        "onbeleefd antwoord"
                    ],
                    "target_lang_definitions": {
                        "en": "not according to the rules of decency; bad-mannered"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rude",
                                "target_lang_sense_clarification": "lacking in refinement or civility; bad-mannered"
                            },
                            {
                                "target_lang_word": "impolite",
                                "target_lang_sense_clarification": "not polite; discourteous"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8100627f-9b3c-3edc-8383-7187f1f37a63",
                    "sense_definition": "zonder mededogen of gevoel; wreed en hardvochtig",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>onbeleefde</w> reactie op haar verdriet liet iedereen in shock achter.",
                            "target_lang_translations": {
                                "en": "His <w>harsh</w> reaction to her grief left everyone in shock."
                            }
                        },
                        {
                            "text": "De dictator regeerde het land op een uiterst <w>onbeleefde</w> en meedogenloze wijze.",
                            "target_lang_translations": {
                                "en": "The dictator ruled the country in an extremely <w>callous</w> and ruthless manner."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "without compassion or feeling; cruel and harsh"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "harsh",
                                "target_lang_sense_clarification": "unpleasantly rough, cruel, or severe"
                            },
                            {
                                "target_lang_word": "callous",
                                "target_lang_sense_clarification": "showing or having an insensitive and cruel disregard for others"
                            },
                            {
                                "target_lang_word": "unfeeling",
                                "target_lang_sense_clarification": "unsympathetic, harsh, or cruel"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}