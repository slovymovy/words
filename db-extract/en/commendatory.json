                        ],
                        "form": "commendatories"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e0a97097-ef42-34c0-abf2-436f507a4804",
                        "entry_id": "d395b277-3616-3b78-89b6-13a20ad50aac",
                        "glosses": [
                            "That which commends; a commendation; eulogy."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e34248aa-7244-4960-b15a-43f881922d11",
                                "sense_id": "e0a97097-ef42-34c0-abf2-436f507a4804",
                                "text": "To him he adheres, resigns the whole ware-house of his religion, with all the locks and keyes into his custody; and indeed makes the very person of that man his religion; esteems his associating with him a sufficient evidence and commendatory of his own piety."
                            },
                            {
                                "example_id": "a2b00263-a271-4ff4-aa85-3255aab1c876",
                                "sense_id": "e0a97097-ef42-34c0-abf2-436f507a4804",
                                "text": "[…] what ever did but bear upon it the Image of God and the Superscription of the Holy Jesus, would need no other Commendatories to our Affection, but would upon that alone account be infinitely dear and pretious to us."
                            }
                        ]
                    }
                ],
