                        "examples": [
                            {
                                "example_id": "bc980727-128e-4e22-b85f-58abcc9f3822",
                                "sense_id": "ac277811-32e1-330f-91d8-16246c861f52",
                                "text": "„Die Bergretter stecken den Jungen in einen Wärmesack und fordern einen Hubschrauber an.“"
                            },
                            {
                                "example_id": "da482680-71cf-4758-9e78-798dba9c65e4",
                                "sense_id": "ac277811-32e1-330f-91d8-16246c861f52",
                                "text": "„Die vorliegende Erfindung betrifft einen Wärmesack für den Schutz eines Neugeborenen gegen Auskühlen sowie eine Verpackungseinheit für einen solchen Wärmesack.“"
                            },
                            {
                                "example_id": "1763ebee-ba9d-4522-8d64-eaa2baeba87f",
                                "sense_id": "ac277811-32e1-330f-91d8-16246c861f52",
                                "text": "„Sodann konnte der Verletzte auf einem Combicarryer im Wärmesack auf der Gebirgstrage zum RTH transportiert werden.“"
                            }
                        ],
