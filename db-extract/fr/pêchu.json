                "translations": [
                    {
                        "translation_id": "cb6ec720-8fc9-4058-852c-b33ae65b5dd0",
                        "source_entry_id": "d573484a-b605-35e1-8b1b-cbc46462752c",
                        "source_sense_id": "ba09b20d-7f56-3654-b175-7b412827a5f6",
                        "source_sense_description": "umgangssprachlich: dynamisch, fit, topfit, energiegeladen, beschwingt, mitreißend, spritzig",
                        "target_lang_word": "dynamisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dynamisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64de6904-e9fa-36dc-a961-da1e9ff24d6b",
                                        "entry_id": "9adb1e97-4f89-31aa-bfc8-bb108b44e2a2",
                                        "glosses": [
                                            "die von Kräften erzeugte Bewegung betreffend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff09fdd2-50c9-4712-9a74-d65039434665",
                                                "sense_id": "64de6904-e9fa-36dc-a961-da1e9ff24d6b",
                                                "text": "„Die spezielle Relativitätstheorie tritt an die Stelle der dynamischen Gesetze der klassischen Mechanik, wenn die betrachteten Geschwindigkeiten nicht mehr gegenüber der Lichtgeschwindigkeit vernachlässigbar sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fa7565ad-c920-31e5-8af5-d6078b0bf710",
                                        "entry_id": "9adb1e97-4f89-31aa-bfc8-bb108b44e2a2",
                                        "glosses": [
                                            "voll innerer Bewegung, mit schneller Veränderung, eine Entwicklung aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71392275-47bc-4f0e-8a8c-a4e8452f04ca",
                                                "sense_id": "fa7565ad-c920-31e5-8af5-d6078b0bf710",
                                                "text": "Peter war heute so dynamisch, den kenne ich sonst nur ruhig."
                                            },
                                            {
                                                "example_id": "4e3e2b2e-c013-412a-888d-d224bb8a7d8b",
                                                "sense_id": "fa7565ad-c920-31e5-8af5-d6078b0bf710",
                                                "text": "„Von einer dynamischen Wirtschaft profitieren am Ende auch die Armen.“"
                                            },
                                            {
                                                "example_id": "86b2fae5-e542-4f67-a2ec-823e97940f8f",
                                                "sense_id": "fa7565ad-c920-31e5-8af5-d6078b0bf710",
                                                "text": "„Drachenfliegen ist eine anspruchsvolle, dynamische Flugsportart. Sie erfordert überdurchschnittlich gute körperliche Fitness und regelmäßiges Training.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d7866a8e-229f-34c7-9a85-81ae080e9fc2",
                                        "entry_id": "9adb1e97-4f89-31aa-bfc8-bb108b44e2a2",
                                        "glosses": [
                                            "mit Tatendrang; voll Energie, etwas zu vollbringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "364d763d-2d23-4158-b420-18d73967a271",
                                                "sense_id": "d7866a8e-229f-34c7-9a85-81ae080e9fc2",
                                                "text": "„Dynamisch, sprunggewaltig, torgefährlich - so kannten die Fans Pascal Hens.“"
                                            },
                                            {
                                                "example_id": "92f95968-9eda-4100-ae19-2ab8b73ee10e",
                                                "sense_id": "d7866a8e-229f-34c7-9a85-81ae080e9fc2",
                                                "text": "„Eine Sinnkrise im Alltag oder Berufsleben kann für den dynamischen Menschen und Sinnsucher ein fruchtbarer Moment, ein Auslöser sein, auf Entdeckungsreise nach Alternativen zu gehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "da33ca64-2e98-3d54-9c3f-3980a628a470",
                                        "entry_id": "9adb1e97-4f89-31aa-bfc8-bb108b44e2a2",
                                        "glosses": [
                                            "Veränderung der Tonstärke betreffend"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72798606-846f-4e64-9176-dee088143c65",
                                                "sense_id": "da33ca64-2e98-3d54-9c3f-3980a628a470",
                                                "text": "Die Komposition wirkt durch das kontrastierende Fallen und Steigen der Tonstärke außerordentlich dynamisch."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92cef5c2-3ae9-48f5-a010-9258e99f9b76",
                        "source_entry_id": "d573484a-b605-35e1-8b1b-cbc46462752c",
