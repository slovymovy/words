                    {
                        "sense_id": "3a31e32c-89fe-33de-a331-a26e8533f094",
                        "entry_id": "d00c8995-8c51-3e83-b752-c799d9c9c3d2",
                        "glosses": [
                            "Abtragungsarbeit der Brandung an Meeresküsten"
                        ],
                        "tags": [
                            "Geomorphologie"
                        ],
                        "examples": [
                            {
                                "example_id": "f2e79a5b-ac9f-4433-85b5-8433d8cb9c98",
                                "sense_id": "3a31e32c-89fe-33de-a331-a26e8533f094",
                                "text": "„Diese beiden Aspekte beeinflussen die Küste direkt durch Brandungserosion. Da der Wasserstand des Meeres variieren kann, ist ein Teil der Küste ganz besonders der Brandungserosion ausgeliefert. Nämlich der unterste Teil der Kliffwand.“"
                            },
                            {
                                "example_id": "f4d43abd-6540-47f2-bcba-6dd511640911",
                                "sense_id": "3a31e32c-89fe-33de-a331-a26e8533f094",
                                "text": "„Teilweise ist die Terrassenböschung, die aus Dacit besteht, durch Brandungserosion zurückgewichen; […].“"
                            },
                            {
                                "example_id": "9b7c09c6-202b-48a5-bec5-8539ae7d3648",
                                "sense_id": "3a31e32c-89fe-33de-a331-a26e8533f094",
                                "text": "„Brandungserosion nagt die weicheren Schichten der Steilküste an.“"
                            },
                            {
                                "example_id": "724c0568-0e9b-4eb0-903a-94de689a9573",
                                "sense_id": "3a31e32c-89fe-33de-a331-a26e8533f094",
                                "text": "Durch Brandungserosion entstehen Kliffs."
                            }
                        ],
