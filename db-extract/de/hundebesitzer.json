                "senses": [
                    {
                        "sense_id": "4fd3509e-1628-3f70-b576-362b88299863",
                        "entry_id": "d4caf40f-87fe-3318-b014-de6cfdbd7298",
                        "glosses": [
                            "(männliche) Person, die einen Hund zur Haustierhaltung besitzt, die sich einen Hund hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e9103fa-3d50-47b4-bab1-9a62d81f9faf",
                                "sense_id": "4fd3509e-1628-3f70-b576-362b88299863",
                                "text": "„Sie tun schweigend so, als wäre alles in Ordnung, in Wahrheit aber verformt sich Tag für Tag das Gesicht des Hundebesitzers und wird dem seines Hundes immer ähnlicher.“"
                            },
                            {
                                "example_id": "4ccc4887-a4cb-4fbc-83e9-1849575931cd",
                                "sense_id": "4fd3509e-1628-3f70-b576-362b88299863",
                                "text": "„In weiten Kreisen der Bevölkerung hat man sich an die Tatsache gewöhnt, dass Hundebesitzer ihren Lieblingen im Laufe eines längeren harmonischen Zusammenlebens stark zu ähneln beginnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
