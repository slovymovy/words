                                        "sense_id": "c55c9fe4-4059-361a-a354-42598d028531",
                                        "entry_id": "8190b0ea-eb5f-31ab-afdd-1cf82cb1ee72",
                                        "glosses": [
                                            "Représentation en peinture ou en sculpture de cet enfant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eac32a04-18c8-4b2f-b6f1-21eb08fa077c",
                                                "sense_id": "c55c9fe4-4059-361a-a354-42598d028531",
                                                "text": "Un tout petit Enfant Jésus d’une délicatesse et d’une mignonnerie charmantes."
                                            }
                                        ]
                                    }
