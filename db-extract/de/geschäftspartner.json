                "senses": [
                    {
                        "sense_id": "3f0dbc83-b779-3a4e-bedf-af40bd832e5c",
                        "entry_id": "6a162b97-233f-33fa-a567-e70dea7b6650",
                        "glosses": [
                            "Teilhaber eines privaten Geschäfts, eines Unternehmens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0bba792-b0d7-46e4-8137-aa5bd1dc06dd",
                                "sense_id": "3f0dbc83-b779-3a4e-bedf-af40bd832e5c",
                                "text": "Er hat seinen Geschäftspartner ausgezahlt."
                            },
                            {
                                "example_id": "1f636ce6-1963-4771-b772-020b3b2c3dc0",
                                "sense_id": "3f0dbc83-b779-3a4e-bedf-af40bd832e5c",
                                "text": "„Denn die Rechtsanwaltskanzlei von Leo Specht, Freund und neuerdings auch Geschäftspartner des ehemaligen Kanzlers, befindet sich direkt vis-à-vis des altehrwürdigen Genossen-Hauptquartiers in der Löwelstraße, wo Gusenbauer in seinen acht Jahren als Parteichef im herzeigbaren Eckbüro im zweiten Stock zu residieren pflegte.“"
                            },
                            {
                                "example_id": "01c93b20-861e-4e89-9bf4-93c51dce9ed2",
                                "sense_id": "3f0dbc83-b779-3a4e-bedf-af40bd832e5c",
                                "text": "„Durch seine Beziehungen zu den Amerikanern gelang es dem Geschäftspartner von Christine Troll, größere Mengen von Chemikalien zu beschaffen, die für die Produktion unentbehrlich waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9e5af3bc-54a1-3b35-baf1-769c40d23f00",
                        "entry_id": "6a162b97-233f-33fa-a567-e70dea7b6650",
                        "glosses": [
                            "Person/Partei, die mit einer anderen Partei Geschäfte macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62078b7a-172e-4224-8bd9-9885ae9d1c10",
                                "sense_id": "9e5af3bc-54a1-3b35-baf1-769c40d23f00",
                                "text": "„Über einen Geschäftspartner in Hamburg fand ich die Telefonnummer eines langjährigen Bekannten von Bayer heraus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
