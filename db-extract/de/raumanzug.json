                "senses": [
                    {
                        "sense_id": "fff07721-6ecc-3d7a-89b8-5c2aa7f1d76d",
                        "entry_id": "6f77dace-dcb0-34c5-84c5-139725c78482",
                        "glosses": [
                            "Kleidungsstück eines Astronauten zum Schutz gegen Sonnenstrahlung und zum Aufrechterhalten der Vitalfunktionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf4844b3-9615-40aa-8b78-098e3774cc4a",
                                "sense_id": "fff07721-6ecc-3d7a-89b8-5c2aa7f1d76d",
                                "text": "„Quest […] ist die US-amerikanische Luftschleuse der ISS. Sie ermöglicht das Verlassen der Station in US-amerikanischen Raumanzügen für Wartungs- und Reparaturarbeiten außerhalb der ISS.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63fe41c3-133a-4d85-9656-87a00cb0e72d",
                        "source_entry_id": "6f77dace-dcb0-34c5-84c5-139725c78482",
                        "source_sense_id": "fff07721-6ecc-3d7a-89b8-5c2aa7f1d76d",
                        "target_lang_word": "space suit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "space suit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00bec6bb-8911-3706-b241-70fe59307081",
                                        "entry_id": "286c5716-8140-303b-a475-3f743a0f20d2",
                                        "glosses": [
                                            "A system of protective and pressurized clothing, together with environmental equipment, worn by astronauts when in space."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc7ad290-435e-30e3-b83a-d3b51718ccc4",
                                        "entry_id": "286c5716-8140-303b-a475-3f743a0f20d2",
                                        "glosses": [
                                            "A pressurized protective outfit worn by people working with extreme biohazards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e4f494c-ec24-47bc-b1b0-2a6ddf946e6f",
                                                "sense_id": "bc7ad290-435e-30e3-b83a-d3b51718ccc4",
                                                "text": "Yale officials may have to consider treating Sabia virus as a so-called class 4 biohazard from now on, which means researchers will be able to handle it only inside a glove box or while wearing a space suit."
                                            },
                                            {
                                                "example_id": "22c09651-8294-4515-9394-3763a3bcdc5f",
                                                "sense_id": "bc7ad290-435e-30e3-b83a-d3b51718ccc4",
                                                "text": "It is really a pressurized, heavy-duty biological space suit."
                                            },
                                            {
                                                "example_id": "8792b7c7-edbf-4558-b1e4-b385690107d4",
                                                "sense_id": "bc7ad290-435e-30e3-b83a-d3b51718ccc4",
                                                "text": "Zone Two had its own protective gear—not quite so cumbersume as the space suit, but still requiring an elaborate rite of passage from the outside world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad6efbd5-de02-4820-8823-b633e6b2cf87",
                        "source_entry_id": "6f77dace-dcb0-34c5-84c5-139725c78482",
