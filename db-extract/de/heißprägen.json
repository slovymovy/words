                        "entry_id": "7ec2a02f-3bee-367b-860a-7c63f0b0b150",
                        "glosses": [
                            "ein Hochdruckverfahren, bei dem eine beschichtete Folie auf einen Gegenstand aufgebracht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ea76f8a-a9c0-4279-a6fa-5caa46718f81",
                                "sense_id": "f027a073-6a7f-35d9-bf86-a2a81089d5dc",
                                "text": "Um eine korrekte Haftung zu gewährleisten, sind beim Heißprägen Temperaturen von mehr als 90 °C nötig."
                            },
                            {
                                "example_id": "4b3fdc9c-afee-46d5-b180-41cc96ac8287",
                                "sense_id": "f027a073-6a7f-35d9-bf86-a2a81089d5dc",
                                "text": "„Das umformende Verfahren Heißprägen ermöglicht die kostengünstige Herstellung großflächiger Mikrostrukturen in Kunststoffplatten oder Kunststofffolien.“"
                            },
                            {
                                "example_id": "815b6c42-0af2-4b60-acb2-2f7fac852ad5",
                                "sense_id": "f027a073-6a7f-35d9-bf86-a2a81089d5dc",
                                "text": "Stampfer betont in seiner Dissertation die Wichtigkeit der Prägetemperatur für das Heißprägen auf Kupferprägefolien."
                            }
