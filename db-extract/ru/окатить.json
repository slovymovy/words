                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1dad402-62b4-4f33-8f31-91b0d633b73a",
                                "sense_id": "6f378fc1-6f9d-3461-b124-84c918b555b3",
                                "text": "― Попросил этого полудурка плеснуть ковшик горячей воды ― поддать, а он взял да меня окатил."
                            },
                            {
                                "example_id": "998cbe6a-4515-4987-8198-fb6ed8f89038",
                                "sense_id": "6f378fc1-6f9d-3461-b124-84c918b555b3",
                                "text": "Громадный вал пронёсся над рифом и окатил меня с головой."
                            }
                        ]
