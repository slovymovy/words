                                "target_senses": [
                                    {
                                        "sense_id": "1fbe1e96-583b-33c4-a273-dec45f5c3276",
                                        "entry_id": "56f137bc-d955-33be-b7ac-0124c5155955",
                                        "glosses": [
                                            "nicht heiter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54383891-b208-4b5f-9db6-b2a108f062b4",
                                                "sense_id": "1fbe1e96-583b-33c4-a273-dec45f5c3276",
                                                "text": "Mit ernsthafter Mine begann er seine Rede."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9d0f9290-9b2e-3df5-83ef-17605c2d9b7a",
                                        "entry_id": "56f137bc-d955-33be-b7ac-0124c5155955",
                                        "glosses": [
                                            "eindringlich, gewichtig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1158ac9c-30f2-493b-92e1-c613fe58a911",
                                                "sense_id": "9d0f9290-9b2e-3df5-83ef-17605c2d9b7a",
                                                "text": "Er scheint ernsthaft bemüht zu sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5d2ab417-53c4-312b-9ec7-1afb3ba285af",
                                        "entry_id": "56f137bc-d955-33be-b7ac-0124c5155955",
                                        "glosses": [
                                            "aufrichtig, tatsächlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42f5a432-819f-42bb-bed8-0efd7ff1e2ef",
                                                "sense_id": "5d2ab417-53c4-312b-9ec7-1afb3ba285af",
                                                "text": "An diese Wende habe ich ernsthaft nicht mehr gedacht."
                                            },
                                            {
                                                "example_id": "652eed10-2d0e-4517-b830-507be7afda09",
                                                "sense_id": "5d2ab417-53c4-312b-9ec7-1afb3ba285af",
                                                "text": "„Und er schmunzelte, wenn er dergleichen sagte, seine Hörer jedesmal in Zweifel darüber lassend, ob er’s ernsthaft oder scherzhaft gemeint habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "11e58782-f72d-303f-b97d-3b2b1eb06028",
                                        "entry_id": "56f137bc-d955-33be-b7ac-0124c5155955",
                                        "glosses": [
                                            "gefährlich, schlimm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5c27271-2c3d-468a-a296-9d07dc811827",
                                                "sense_id": "11e58782-f72d-303f-b97d-3b2b1eb06028",
                                                "text": "Die Verletzungen waren ernsthafter Natur."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f461bca2-1c7b-4cfe-bdd1-bf90d462a8f8",
                        "source_entry_id": "50c717a0-9a13-39b0-9a62-d6625dd9ab19",
