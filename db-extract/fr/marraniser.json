                "senses": [
                    {
                        "sense_id": "c089e9b3-ea91-355a-b2b0-ce80039186b4",
                        "entry_id": "c5c429fd-42f6-35bd-9f49-6e6d230500d4",
                        "glosses": [
                            "Donner un caractère rappelant les marranes à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1455c5aa-6a6c-4698-80a0-1ba8ed156e53",
                                "sense_id": "c089e9b3-ea91-355a-b2b0-ce80039186b4",
                                "text": "Quarante années à être Coréen sans l’être, à se marraniser : les Coréens furent les marranes de l’Asie !"
                            }
                        ]
                    },
                    {
                        "sense_id": "39f12cac-36e5-32be-a5c9-389a417d9ca3",
                        "entry_id": "c5c429fd-42f6-35bd-9f49-6e6d230500d4",
                        "glosses": [
                            "Pratiquer (sa religion, etc.) en cachette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f48f4d79-192f-42e2-a6dd-a3d8ef23f9e4",
                                "sense_id": "39f12cac-36e5-32be-a5c9-389a417d9ca3",
                                "text": "Ou si, mais ça revient alors à dissimuler sa pratique, à « marraniser », au risque que cette « marranisation » fonctionne comme le refoulé de nos sociétés."
                            }
                        ]
                    }
