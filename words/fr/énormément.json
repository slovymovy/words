        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "809065d7-8799-34b3-9a44-04e0be60540b",
                    "sense_definition": "D'une manière très importante ou à un très haut degré ; beaucoup, extrêmement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intensite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle organisation nous a permis de progresser <w>énormément</w> en peu de temps.",
                            "target_lang_translations": {
                                "en": "This new organisation has allowed us to progress <w>enormously</w> in a short time.",
                                "ru": "Эта новая организация позволила нам <w>значительно</w> продвинуться за короткое время.",
                                "de": "Diese neue Organisation hat es uns ermöglicht, in kurzer Zeit <w>enorm</w> voranzukommen.",
                                "es": "Esta nueva organización nos ha permitido progresar <w>muchísimo</w> en poco tiempo.",
                                "zh": "这种新的组织方式让我们在短时间里<w>大大</w>进步了。"
                            }
                        },
                        {
                            "text": "Les enfants ont <w>énormément</w> apprécié leur après-midi passée au bord de la mer.",
                            "target_lang_translations": {
                                "en": "The children <w>hugely</w> enjoyed their afternoon spent at the seaside.",
                                "ru": "Детям <w>сильно</w> понравилась вторая половина дня, проведённая на берегу моря.",
                                "de": "Die Kinder haben ihren Nachmittag am Meer <w>sehr</w> genossen.",
                                "es": "Los niños disfrutaron <w>muchísimo</w> de la tarde que pasaron a orillas del mar.",
                                "zh": "孩子们<w>非常</w>喜欢在海边度过的那个下午。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beaucoup",
                        "considérablement",
                        "extrêmement"
                    ],
                    "common_phrases": [
                        "changer énormément",
                        "progresser énormément"
                    ],
                    "target_lang_definitions": {
                        "en": "Very greatly or to a very high degree; very much, extremely.",
                        "ru": "В очень большой степени или очень сильно.",
                        "de": "In sehr hohem Maße oder Grad, außerordentlich stark.",
                        "es": "En un grado muy alto o de manera muy notable; muchísimo o extremadamente.",
                        "zh": "程度非常高，常用来修饰动词或形容词，表示程度极深。"
                    },
                    "translations": {
                        "en": [
                            {
