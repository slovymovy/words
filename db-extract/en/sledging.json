                        ],
                        "examples": [
                            {
                                "example_id": "33a38ed6-ce09-460f-85bd-9aff4064c291",
                                "sense_id": "c7f39f2f-4b5a-318c-843c-1384a706adc4",
                                "text": "In 1831 the naval officer James Clark Ross led the British effort north by sledging out from his ice-bound ship, HMS Victory; after several weeks travelling with Inuit companions he succeeded in finding his compass needle sitting upright."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4b3c4a3-35d5-3a3e-802c-5f9d469a5c0f",
                        "entry_id": "8ecadef3-2dca-3e83-8f5f-460c766afd44",
                        "glosses": [
                            "The act of using a sledgehammer to bend or crush an object."
                        ],
                        "tags": [
                            "countable",
