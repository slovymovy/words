                                                "sense_id": "9b785405-9759-3bac-a1a2-8ff23d4d2265",
                                                "text": "Their next engine design will be a diesel."
                                            },
                                            {
                                                "example_id": "5871d201-f64b-4555-9884-1dc1da0d716a",
                                                "sense_id": "9b785405-9759-3bac-a1a2-8ff23d4d2265",
                                                "text": "Thumbed a diesel down, outside a cafe."
                                            }
                                        ]
