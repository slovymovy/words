                        "form_id": "21a3db99-cee6-4b89-a11f-2986c7b672ba",
                        "entry_id": "10b2368d-2a68-3d0a-8f96-2a0edfc4338f",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Zinnsoldaten"
                    },
                    {
                        "form_id": "800c7f89-14da-48e2-9168-c262413fc79f",
                        "entry_id": "10b2368d-2a68-3d0a-8f96-2a0edfc4338f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zinnsoldaten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2dadba59-b195-38a5-b3e9-8939f7dbce7d",
                        "entry_id": "10b2368d-2a68-3d0a-8f96-2a0edfc4338f",
                        "glosses": [
                            "Spielfigur aus Zinn, die einen Soldaten darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb60f31d-4551-4deb-90ce-e0b62e281098",
                                "sense_id": "2dadba59-b195-38a5-b3e9-8939f7dbce7d",
                                "text": "„Dieter hatte auch Zinnsoldaten und ein Schaukelpferd, und er mußte nichts, was er hatte, mit Geschwistern teilen.“"
                            },
                            {
                                "example_id": "6e2b1370-0954-4ad3-ac97-579b9c4898c4",
                                "sense_id": "2dadba59-b195-38a5-b3e9-8939f7dbce7d",
                                "text": "„Sie waren etwas größer als Zinnsoldaten und aus einem Material, das eine originalgetreue Detailverliebtheit zuließ.“"
                            },
                            {
                                "example_id": "0258a8c0-9248-47cb-aad7-41b9e96fb93f",
                                "sense_id": "2dadba59-b195-38a5-b3e9-8939f7dbce7d",
                                "text": "„Sein Gesicht war mit klumpigem Make-up verschmiert und er bewegte sich so gewandt wie ein rostiger Zinnsoldat.“"
                            },
                            {
                                "example_id": "ec93ac40-7c6c-4a28-9c69-f925ba115cca",
                                "sense_id": "2dadba59-b195-38a5-b3e9-8939f7dbce7d",
                                "text": "„Wir wissen nicht mit Sicherheit, wie sich römische Kinder mit Zinnsoldaten vergnügt haben, aber bestimmt gab die individuelle Phantasie eines jeden Kindes genügend Anregungen, wie man zu fabelhaften Abenteuern aufbrechen konnte.“"
                            },
                            {
                                "example_id": "c8b27bbb-2d15-40b7-93e4-d262f86dca91",
                                "sense_id": "2dadba59-b195-38a5-b3e9-8939f7dbce7d",
                                "text": "„Heute benahmen sie sich wie Kinder, die mit Zinnsoldaten spielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c39252b3-7bf6-47db-acba-b53b99077eea",
                        "source_entry_id": "10b2368d-2a68-3d0a-8f96-2a0edfc4338f",
                        "source_sense_id": "2dadba59-b195-38a5-b3e9-8939f7dbce7d",
                        "source_sense_description": "Spielfigur aus Zinn, die einen Soldaten darstellt",
                        "target_lang_word": "tin soldier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tin soldier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbea47e4-00d5-3b11-9364-3af07fdf79e5",
                                        "entry_id": "2ac42dfe-b0e4-36f1-b089-b60d1d64bfd1",
                                        "glosses": [
                                            "A toy soldier made out of tin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "edbcae26-18c7-3471-ba4f-ba4d414a84ec",
                                        "entry_id": "2ac42dfe-b0e4-36f1-b089-b60d1d64bfd1",
                                        "glosses": [
                                            "One who only plays at being a soldier."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdaecefd-52a0-4d49-a84c-c10107118962",
                                                "sense_id": "edbcae26-18c7-3471-ba4f-ba4d414a84ec",
                                                "text": "By officers and men he was regarded as a tin soldier; by the church people generally, because of Parson Alvord's newspaper articles, he was thought to be a great hero."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b3e6449-130d-471a-9c1e-3eb1412c1e5c",
                        "source_entry_id": "10b2368d-2a68-3d0a-8f96-2a0edfc4338f",
                        "source_sense_id": "2dadba59-b195-38a5-b3e9-8939f7dbce7d",
                        "source_sense_description": "Spielfigur aus Zinn, die einen Soldaten darstellt",
                        "target_lang_word": "soldat de plomb",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soldat de plomb",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6aee3b46-4b9d-3a9b-97f5-c1f351634059",
                                        "entry_id": "cbdc8885-ff8c-3602-86b9-d41fab4989d9",
                                        "glosses": [
                                            "Sorte de petit jouet en plomb ou en étain, qui représente un soldat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94f2a3c2-bd55-4c38-a85a-b0117bef544a",
                                                "sense_id": "6aee3b46-4b9d-3a9b-97f5-c1f351634059",
                                                "text": "— Il y a quatre-vingt-dix-neuf ans, jour pour jour, j’étais sur un guéridon avec une douzaine de camarades qui me ressemblaient comme des frères ; les uns debout, les autres couchés ; plusieurs endommagés de la tête ou des pieds : débris héroïques d’une boîte de soldats de plomb achetée l’année précédente à la foire Saint-Germain."
                                            },
                                            {
                                                "example_id": "bf35bea3-63f6-430c-936b-1ebc82b4e42b",
                                                "sense_id": "6aee3b46-4b9d-3a9b-97f5-c1f351634059",
                                                "text": "Où donc sont ces soldats de plomb dont l’odeur, quand j'ouvrais leur boîte, était tenace et rêche après mes doigts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8be864d7-b44a-4e2c-9ab9-41324b122a01",
                        "source_entry_id": "10b2368d-2a68-3d0a-8f96-2a0edfc4338f",
