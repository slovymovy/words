                        "sense_id": "04103ad8-ae9d-37be-b6fc-833ab89b133a",
                        "entry_id": "2a3656af-5d67-3c34-b651-d96c4afb2043",
                        "glosses": [
                            "разг. действие по значению гл. прибавить, прибавлять; действие или состояние по значению гл. прибавиться, прибавляться"
                        ],
