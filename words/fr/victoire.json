                    ]
                },
                {
                    "sense_id": "33655160-0343-3cd2-a28b-d755bf76e1db",
                    "sense_definition": "Représentation sculptée ou peinte d'une divinité ailée symbolisant le triomphe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une majestueuse <w>victoire</w> en marbre domine le grand escalier de ce célèbre musée."
                        },
                        {
                            "text": "L'artiste a sculpté une <w>victoire</w> ailée pour commémorer l'événement historique sur la place publique."
                        }
                    ],
                    "common_phrases": [
                        "victoire ailée"
                    ]
                }
