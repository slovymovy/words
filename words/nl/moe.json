                {
                    "sense_id": "3a7f39e2-8555-3060-b5e8-8c993af75f96",
                    "sense_definition": "behoefte hebben aan rust of slaap na inspanning",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vermoeidheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange dag op kantoor was hij erg <w>moe</w> van al het werk.",
                            "target_lang_translations": {
                                "en": "After a long day at the office, he was very <w>tired</w> from all the work.",
                                "ru": "После долгого дня в офисе он очень <w>устал</w> от всей этой работы."
                            }
                        },
                        {
                            "text": "Ik merk dat ik ineens ontzettend <w>moe</w> ben en wil graag gaan slapen.",
                            "target_lang_translations": {
                                "en": "I notice that I am suddenly extremely <w>tired</w> and would like to go to sleep.",
                                "ru": "Я чувствую, что внезапно ужасно <w>устал</w> и очень хочу спать."
                            }
                        }
                    ],
                    "synonyms": [
                        "vermoeid",
                        "slaperig",
                        "uitgeput"
                    ],
                    "common_phrases": [
                        "ontzettend moe",
                        "moe van",
                        "doodmoe"
                    ],
                    "target_lang_definitions": {
