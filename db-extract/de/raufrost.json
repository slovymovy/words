                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44bba8f9-2c12-39e0-9796-f71e63a9e6e1",
                                        "entry_id": "18f92f76-875e-3bab-99b6-fcc010fa9a2f",
                                        "glosses": [
                                            "Meuble représentant dans les armoiries un serpent engloutissant un enfant ou un homme (parfois un autre animal). Elle est posée en pal et son corps est entortillé. À rapprocher de bisse, guivre, vouivre, vivre et vuivre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4916382c-e422-47a0-a4c6-f19930767ccf",
                                                "sense_id": "44bba8f9-2c12-39e0-9796-f71e63a9e6e1",
                                                "text": "Coupé, au I de sinople à un pal d’or ; au II d’or à une givre de sinople, qui est de la commune de Saumane des Alpes-de-Haute-Provence → voir illustration « armoiries avec une givre »"
                                            }
                                        ]
                                    }
                                ]
