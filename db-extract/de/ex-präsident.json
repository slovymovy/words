                ],
                "senses": [
                    {
                        "sense_id": "058b4766-8d13-350f-9d69-6299a95d871c",
                        "entry_id": "bd271b31-2d39-3341-9d19-7b1e1bbb6984",
                        "glosses": [
                            "ehemaliges Oberhaupt eines Staates oder ehemaliger Vorsitzender eines politischen Gremiums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6271938f-11d9-4970-a26b-542d13078d88",
                                "sense_id": "058b4766-8d13-350f-9d69-6299a95d871c",
                                "text": "„Auch Ex-Präsident Trump konnte die Migration nicht aufhalten.“"
                            },
                            {
                                "example_id": "71bdcac6-b5a1-4a4a-becb-62ecde946c8e",
                                "sense_id": "058b4766-8d13-350f-9d69-6299a95d871c",
                                "text": "„Außerdem ermittelt derzeit der Oberste Gerichtshof gegen den Ex-Präsidenten wegen des Verdachts, zu Unruhen nach seiner Wahlniederlage angestiftet zu haben.“"
                            },
                            {
                                "example_id": "7eb5f77f-acad-41a9-a714-893be0a25623",
                                "sense_id": "058b4766-8d13-350f-9d69-6299a95d871c",
                                "text": "„Wieder macht der Ex-Präsident negative Schlagzeilen: Die brasilianische Bundespolizei will Jair Bolsonaro wegen Unterschlagung vor Gericht bringen.“"
                            },
                            {
                                "example_id": "ddfefe8f-6cba-4572-b5cd-71ad7ec8c0fd",
                                "sense_id": "058b4766-8d13-350f-9d69-6299a95d871c",
                                "text": "„Wahlen zum Repräsentantenhaus der Vereinigten Staaten 1912 – […] Die Progressive Party von Ex-Präsident Theodore Roosevelt kam auf 9 Sitze.“"
                            },
                            {
                                "example_id": "a113edc1-ea55-44f8-9438-a0c28e7180ac",
                                "sense_id": "058b4766-8d13-350f-9d69-6299a95d871c",
                                "text": "„Carter ist seit dem 30. November 2018 der älteste lebende Ex-Präsident der Vereinigten Staaten und hat das höchste Lebensalter aller US-Präsidenten erreicht.“"
                            },
                            {
                                "example_id": "19b7048e-eb93-4386-a738-c82521ea8f34",
                                "sense_id": "058b4766-8d13-350f-9d69-6299a95d871c",
                                "text": "„Seit 65 Jahren war Südafrikas Ex-Präsident Jacob Zuma Mitglied der Mandela-Partei ANC. Dann stürzte er über Korruptionsfälle.“"
                            },
                            {
                                "example_id": "ce171d8d-2ff9-4fdb-8b84-d1039d7e3936",
                                "sense_id": "058b4766-8d13-350f-9d69-6299a95d871c",
                                "text": "„[Ruth Weiss] knüpft Kontakt zu zahlreichen Persönlichkeiten der afrikanischen Unabhängigkeitsbewegungen, darunter Robert Mugabe, der spätere Diktator Simbabwes, Sambias Ex-Präsident Kenneth Kaunda und Südafrikas Befreiungsheld Nelson Mandela.“"
                            },
                            {
                                "example_id": "3497c828-9fc0-4d3b-9ab2-e657fe32d0d4",
                                "sense_id": "058b4766-8d13-350f-9d69-6299a95d871c",
                                "text": "„Der Oberste Gerichtshof der USA verhandelt, ob Trump als Ex-Präsident absolute Immunität zusteht.“"
                            },
                            {
                                "example_id": "d0696208-0a6c-46f4-a8eb-91a76b06ff7c",
                                "sense_id": "058b4766-8d13-350f-9d69-6299a95d871c",
                                "text": "„Tatsächlich tourte noch nie ein US-amerikanischer Ex-Präsident durch Europa, so wie Barack Obama das jetzt vorhat.“"
                            },
                            {
                                "example_id": "add2dbdf-c3db-408a-9f67-8eb4805905f1",
                                "sense_id": "058b4766-8d13-350f-9d69-6299a95d871c",
                                "text": "[Was geschah am 12. Juli 2003?] „In Norfolk im Bundesstaat Virginia wird der Flugzeugträger \"USS Ronald Reagan\" in Dienst gestellt. Damit wird erstmals ein solches Großkampfschiff nach einem noch lebenden Ex-Präsidenten benannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "175d6931-c2f1-3b26-bb9a-4480c0d0d819",
                        "entry_id": "bd271b31-2d39-3341-9d19-7b1e1bbb6984",
                        "glosses": [
                            "ehemaliger Vorsitzender einer Organisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59d5b816-e714-4063-ad4d-50b59d89b411",
                                "sense_id": "175d6931-c2f1-3b26-bb9a-4480c0d0d819",
                                "text": "[Schlagzeile:] „Bundesverfassungsgericht – Ex-Präsident Papier für Grundgesetzreform zum Schutz vor Demokratiefeinden“"
                            },
                            {
                                "example_id": "cb70b638-6c1b-4ed0-94ea-d2fd414689b6",
                                "sense_id": "175d6931-c2f1-3b26-bb9a-4480c0d0d819",
                                "text": "„Am Ende einer weitestgehend sachlichen Mitgliederversammlung des FC Bayern München sorgte Ex-Präsident Uli Hoeneß doch noch für einen Aufreger.“"
                            },
                            {
                                "example_id": "b91012d3-7f4e-4591-a68e-45e137d7b8fb",
                                "sense_id": "175d6931-c2f1-3b26-bb9a-4480c0d0d819",
                                "text": "[Deutscher Fußball Bund:] „Ihn treffe keine Verantwortung für die WM-Affäre und drohende Schäden, andere \"möglicherweise\" schon, äußert Zwanziger im Telefongespräch mit der Süddeutchen Zeitung. Wen er damit meint, will der Ex-Präsident nicht sagen, das kann man sich aber denken.“"
                            },
                            {
                                "example_id": "c4388899-8dbd-41e6-b943-0b4ac350f228",
                                "sense_id": "175d6931-c2f1-3b26-bb9a-4480c0d0d819",
                                "text": "„Hans-Georg Maaßen klagt gegen seine einstigen Arbeitgeber. Der Ex-Präsident des Bundesamts für Verfassungsschutz wird mittlerweile selbst beobachtet und ist als Rechtsextremist abgespeichert.“"
                            },
                            {
                                "example_id": "c560fad8-e03f-4f3e-9379-383d536456da",
                                "sense_id": "175d6931-c2f1-3b26-bb9a-4480c0d0d819",
                                "text": "[Musikhochschule München:] „Die HMTM hat eine schwere Hypothek, wenn es um das Thema geht: Ex-Präsident Siegfried Mauser wurde 2019 vom Bundesgerichtshof in letzter Instanz zu zwei Jahren und neun Monaten Haft verurteilt - wegen sexueller Nötigung in drei Fällen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2fecacd-55d9-4d9b-9da6-29d64c7a74c2",
                        "source_entry_id": "bd271b31-2d39-3341-9d19-7b1e1bbb6984",
                        "source_sense_id": "058b4766-8d13-350f-9d69-6299a95d871c",
                        "source_sense_description": "Politik: ehemaliges Oberhaupt eines Staates oder ehemaliger Vorsitzender eines politischen Gremiums",
                        "target_lang_word": "ex-president",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ex-president",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b643518-b335-3be6-a60b-7eb09a223b26",
                                        "entry_id": "a4ee85fa-2314-3e35-890f-6d885511a86d",
                                        "glosses": [
                                            "A former president."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0132f3f-058a-4587-913e-4c0481562560",
                                                "sense_id": "7b643518-b335-3be6-a60b-7eb09a223b26",
                                                "text": "She was the third former Trump acolyte to agree to testify against the ex-president and others this week."
                                            },
                                            {
                                                "example_id": "e9ec5a28-d29a-48d6-9362-179285f0bdc8",
                                                "sense_id": "7b643518-b335-3be6-a60b-7eb09a223b26",
                                                "text": "The other living ex-presidents are Jimmy Carter, who has been in hospice care for over a year, and George W. Bush, who is very friendly with both Obama and Clinton, but as a Republican is unlikely to campaign for Biden even given his disdain for Trump’s contempt for democracy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
