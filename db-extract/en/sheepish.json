                                            {
                                                "example_id": "386014cb-97cc-4b23-9927-260af176c89e",
                                                "sense_id": "033e04a3-02b3-3618-8388-a27813abccdb",
                                                "text": "Er kwam alleen een wat schaapachtige reactie uit de overrompelde man."
                                            },
                                            {
                                                "example_id": "b66e67e1-dec8-4628-9d2b-0966b8991b3c",
                                                "sense_id": "033e04a3-02b3-3618-8388-a27813abccdb",
                                                "text": "Touringcars zijn in Amsterdam een bron van irritatie: logge obstakels in het smalle stratenplan van de stad, vies voor de lucht en als ze eenmaal stilstaan, staat er niet zelden een schaapachtig kijkende kudde toeristen inclusief koffers op trottoir of fietspad."
                                            }
                                        ]
                                    }
                                ]
                            },
