                ],
                "senses": [
                    {
                        "sense_id": "066aed88-4d31-39ac-9066-eeb1297ae54b",
                        "entry_id": "eee3e5b1-0d1f-3dd8-ad3e-5eab4ea76327",
                        "glosses": [
                            "In a miserable manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2c0a4d5-5731-4cd9-8027-52e2498a36b7",
                                "sense_id": "066aed88-4d31-39ac-9066-eeb1297ae54b",
                                "text": "I just need you miserably\nBroken man come to me\nI just need you desperately\nJust want to change your mind"
                            },
                            {
                                "example_id": "b49379d3-59a2-4fef-8a75-8aa08a6a245c",
                                "sense_id": "066aed88-4d31-39ac-9066-eeb1297ae54b",
                                "text": "fail miserably"
                            },
                            {
                                "example_id": "7f798d89-2367-4db0-8866-08eac1c92f85",
                                "sense_id": "066aed88-4d31-39ac-9066-eeb1297ae54b",
                                "text": "\"Well, sorcerer?\" growled the Norman. \"Nay, not well,\" replied Catweazle shivering miserably, \"I have the bone-ache.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66f0fa4d-bda9-41b0-b717-590dfbe742ce",
                        "source_entry_id": "eee3e5b1-0d1f-3dd8-ad3e-5eab4ea76327",
                        "source_sense_id": "066aed88-4d31-39ac-9066-eeb1297ae54b",
                        "source_sense_description": "in a miserable manner",
                        "target_lang_word": "misérablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misérablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd3ac9ed-9c3d-35b0-9778-aa0140b5fc72",
                                        "entry_id": "4cd6c281-1712-384a-8513-8c4173b733c2",
                                        "glosses": [
                                            "D’une manière misérable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ac43aaa-1a80-49ee-9b3c-1efd340196a8",
                                                "sense_id": "fd3ac9ed-9c3d-35b0-9778-aa0140b5fc72",
                                                "text": "Est-ce que vous me laisserez périr aussi misérablement ?"
                                            },
                                            {
                                                "example_id": "2c7712e5-c0e2-4179-aa8a-19a80696b8cd",
                                                "sense_id": "fd3ac9ed-9c3d-35b0-9778-aa0140b5fc72",
                                                "text": "C'est là aussi que végètent misérablement les bédouines qui ont voulu suivre leurs maris prisonniers."
                                            },
                                            {
                                                "example_id": "fb35b81f-f008-47e6-a298-72b8052290ec",
                                                "sense_id": "fd3ac9ed-9c3d-35b0-9778-aa0140b5fc72",
                                                "text": "Pour cette cassolette [cadeau du cardinal de Retz], dispensez-moi, ma bonne, de retourner misérablement là-dessus."
                                            },
                                            {
                                                "example_id": "5a27ffc7-2d3c-4938-9f62-bbf9bf90095d",
                                                "sense_id": "fd3ac9ed-9c3d-35b0-9778-aa0140b5fc72",
                                                "text": "La vie de l’homme est misérablement courte."
                                            },
                                            {
                                                "example_id": "f6087394-5a7d-4972-987a-8735e35035d2",
                                                "sense_id": "fd3ac9ed-9c3d-35b0-9778-aa0140b5fc72",
                                                "text": "Ils périrent tous deux misérablement."
                                            },
                                            {
                                                "example_id": "693931f7-6b12-4f32-bd39-874234bb8fb5",
                                                "sense_id": "fd3ac9ed-9c3d-35b0-9778-aa0140b5fc72",
                                                "text": "Beaucoup de juifs chassés d’Espagne par Ferdinand et Isabelle se sont réfugiés à Tétuan, à Méquinez, à Maroc, et y vivent misérablement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
