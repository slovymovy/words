{
    "word_family": [
        "показывать",
        "показ",
        "показание",
        "показатель",
        "казаться"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5dc645be-0cc8-3561-8234-d303a6de94f6",
                    "sense_definition": "Становиться видным, заметным; появляться в поле зрения.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "appearance_visual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждое утро из-за горы медленно <w>показывается</w> солнце.",
                            "target_lang_translations": {
                                "en": "Every morning the sun slowly <w>appears</w> from behind the mountain."
                            }
                        },
                        {
                            "text": "Вдали уже <w>показывались</w> огни города, и мы ускорили шаг.",
                            "target_lang_translations": {
                                "en": "The city lights were already <w>coming into view</w> in the distance, and we quickened our pace."
                            }
                        }
                    ],
                    "synonyms": [
                        "появляться"
                    ],
                    "antonyms": [
                        "исчезать",
                        "скрываться"
                    ],
                    "common_phrases": [
                        "солнце показывается",
                        "показываться из-за туч",
                        "показываться вдали"
                    ],
                    "target_lang_definitions": {
                        "en": "To become visible, noticeable; to appear in the field of view."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "appear",
                                "target_lang_sense_clarification": "general term for becoming visible"
                            },
                            {
                                "target_lang_word": "come into view",
                                "target_lang_sense_clarification": "to become visible in the distance or after being hidden"
                            },
                            {
                                "target_lang_word": "show",
                                "target_lang_sense_clarification": "to become visible (e.g., the sun, the moon)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f32855f-c7b2-38e8-89d4-40b3cefa484f",
                    "sense_definition": "Приходить куда-либо, появляться где-либо (обычно о человеке).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "appearance_presence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он давно не <показывался> в университете из-за болезни.",
                            "target_lang_translations": {
                                "en": "He hasn't <shown up> at the university for a long time due to illness."
                            }
                        },
                        {
                            "text": "Лучше не <показывайся> мне на глаза, пока не успокоишься.",
                            "target_lang_translations": {
                                "en": "You'd better not <show your face> to me until you calm down."
                            }
                        }
                    ],
                    "synonyms": [
                        "появляться"
                    ],
                    "common_phrases": [
                        "показываться на глаза",
                        "показываться на людях",
                        "не показываться дома"
                    ],
                    "target_lang_definitions": {
                        "en": "To arrive somewhere, to appear somewhere (usually about a person)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "show up",
                                "target_lang_sense_clarification": "to arrive or attend, often informally"
                            },
                            {
                                "target_lang_word": "appear",
                                "target_lang_sense_clarification": "to present oneself publicly or formally"
                            },
                            {
                                "target_lang_word": "show one's face",
                                "target_lang_sense_clarification": "idiomatic: to be seen or present somewhere"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6c06d2f-d1c1-34be-bdf6-63e9ef16df08",
                    "sense_definition": "Выступать наружу, проступать на какой-либо поверхности (о слезах, крови, растениях и т.п.).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждую весну из-под талого снега <w>показываются</w> первые подснежники.",
                            "target_lang_translations": {
                                "en": "Every spring the first snowdrops <w>emerge</w> from under the melting snow."
                            }
                        },
                        {
                            "text": "Сквозь бинт уже <w>показывается</w> кровь, повязку нужно сменить.",
                            "target_lang_translations": {
                                "en": "Blood is already <w>showing</w> through the bandage; the dressing needs changing."
                            }
                        }
                    ],
                    "synonyms": [
                        "проступать"
                    ],
                    "common_phrases": [
                        "показываются слёзы",
                        "показывается кровь",
                        "показываются ростки"
                    ],
                    "target_lang_definitions": {
                        "en": "To come out, protrude, or become visible on a surface (about tears, blood, plants, etc.)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "appear",
                                "target_lang_sense_clarification": "to become visible on a surface"
                            },
                            {
                                "target_lang_word": "come out",
                                "target_lang_sense_clarification": "to emerge from a surface or hiding place"
                            },
                            {
                                "target_lang_word": "emerge",
                                "target_lang_sense_clarification": "to come forth into view"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22a3b089-95af-3302-9c52-dd9d21686766",
                    "sense_definition": "Приходить к специалисту (обычно к врачу) для осмотра или проверки.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance_medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он не любит врачей и годами не <w>показывается</w> даже терапевту.",
                            "target_lang_translations": {
                                "en": "He doesn't like doctors and hasn't <w>seen</w> so much as a GP in years."
                            }
                        },
                        {
                            "text": "После операции пациенту нужно <w>показываться</w> хирургу раз в месяц.",
                            "target_lang_translations": {
                                "en": "After the operation, the patient needs to <w>see</w> the surgeon once a month."
                            }
                        }
                    ],
                    "common_phrases": [
                        "показываться врачу",
                        "показываться специалисту"
                    ],
                    "target_lang_definitions": {
                        "en": "To visit a specialist (usually a doctor) for an examination or check-up."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "see",
                                "target_lang_sense_clarification": "to consult a professional (e.g., see a doctor)"
                            },
                            {
                                "target_lang_word": "be examined by",
                                "target_lang_sense_clarification": "to present oneself for medical inspection"
                            }
                        ]
                    },
                    "synonyms": [
                        "обращаться"
                    ]
                },
                {
                    "sense_id": "7030ffae-7cb1-3fcc-a79e-156b9b06e78f",
                    "sense_definition": "Страдательный залог к глаголу <w>показывать</w> (быть демонстрируемым).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "passive_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот фильм <показывается> во всех кинотеатрах страны.",
                            "target_lang_translations": {
                                "en": "This movie <is being shown> in all cinemas of the country."
                            }
                        },
                        {
                            "text": "Хорошие результаты <показываются> нашими спортсменами каждый год.",
                            "target_lang_translations": {
                                "en": "Good results <are shown> by our athletes every year."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "passive voice"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Passive voice of the verb 'to show' (to be demonstrated)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be shown",
                                "target_lang_sense_clarification": "passive form: to be exhibited or screened"
                            },
                            {
                                "target_lang_word": "be displayed",
                                "target_lang_sense_clarification": "passive form: to be presented to view"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}