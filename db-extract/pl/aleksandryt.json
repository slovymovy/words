                                    {
                                        "sense_id": "3634b4a6-0c72-3d29-83e7-a83bf898582a",
                                        "entry_id": "297419b3-2012-3ddc-9dc2-a33f32e1c169",
                                        "glosses": [
                                            "A form of chrysoberyl that displays a colour change dependent upon the light source, along with strong pleochroism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2b932e5-b5ca-438f-abc9-c84f0d7a4485",
                                                "sense_id": "3634b4a6-0c72-3d29-83e7-a83bf898582a",
                                                "text": "[…] the body of each high seat was a single jewel of monstrous size: the left-hand seat a black opal, asparkle with steel-blue fire, the next a fire-opal, as it were a burning coal, the third seat an alexandrite, purple like wine by night but deep sea-green by day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a8014bb-2125-4c6e-9321-8448cfa812a0",
                        "source_entry_id": "10676ef2-52ff-3016-9283-5f098a7fc96c",
                        "source_sense_id": "32a3057f-5ca2-3beb-848b-569df58d010c",
                        "target_lang_word": "alexandrite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alexandrite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "557ddc99-6c4d-329a-b5b5-b493225f5d6d",
                                        "entry_id": "99350e8f-af88-3250-9d9f-373c6b3281b2",
                                        "glosses": [
                                            "Variété de chrysobéryl qui a la particularité de changer de couleur avec l’éclairage : bleu-vert à la lumière du jour, rose-rouge sous une lampe à incandescence ou au feu de bois, gris incolore sous un néon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1f2509c-85b5-47b4-a92c-35edaba87ff2",
                                                "sense_id": "557ddc99-6c4d-329a-b5b5-b493225f5d6d",
                                                "text": "Une des propriétés spécifiques de l’alexandrite, la variété noble, est son pléochroïsme, vert, rouge et orange."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
