                "senses": [
                    {
                        "sense_id": "6f19e34b-7168-3ef6-8e72-0f00ccdf5fc7",
                        "entry_id": "09ccd259-d6b1-38c2-90fc-7fe8f916eff0",
                        "glosses": [
                            "Nom d’un gantelet de cuir souvent garni de plomb, qui servait aux anciens athlètes, pour combattre à coups de poings, dans les jeux publics."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "b920e4d3-5e4f-48b8-9375-1707c7139525",
                                "sense_id": "6f19e34b-7168-3ef6-8e72-0f00ccdf5fc7",
                                "text": "le prix du ceste : le prix donné au vainqueur dans cette sorte de combat."
                            },
                            {
                                "example_id": "d855a67c-b9a2-4a93-8abf-4acc61cae80e",
                                "sense_id": "6f19e34b-7168-3ef6-8e72-0f00ccdf5fc7",
                                "text": "Mes mains exercées à soulever un ceste de fer qui donne la mort, mollissaient sur la poitrine désarmée du nain fantastique."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
