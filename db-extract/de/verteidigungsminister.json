                ],
                "senses": [
                    {
                        "sense_id": "d3a65835-4b63-3edb-a718-636cd3b38996",
                        "entry_id": "c2dcb084-c1e5-3fb5-b3ba-208b9f69bbd2",
                        "glosses": [
                            "für die Streitkräfte verantwortliches Regierungsmitglied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c59e7b3a-bd6a-40cc-bb77-813768bcb7da",
                                "sense_id": "d3a65835-4b63-3edb-a718-636cd3b38996",
                                "text": "Theodor Blank war der erste Verteidigungsminister der Bundesrepublik Deutschland."
                            },
                            {
                                "example_id": "72ee3106-2f35-4562-8fc6-22ffb9f3aeb3",
                                "sense_id": "d3a65835-4b63-3edb-a718-636cd3b38996",
                                "text": "„Rühe, der in den neunziger Jahren sechseinhalb Jahre lang Verteidigungsminister im Kabinett Kohl war, ist zwar kein Mann mehr, der im Rampenlicht steht. Aber wenn er sich hin und wieder doch zu Wort meldet, haben seine Äußerungen Gewicht.“"
                            },
                            {
                                "example_id": "f9326dbc-be11-4e09-866e-ead6517b58b3",
                                "sense_id": "d3a65835-4b63-3edb-a718-636cd3b38996",
                                "text": "„Der Verteidigungsminister sei schon lange nur noch ein Selbstverteidigungsminister, sagt Schulz.“"
                            },
                            {
                                "example_id": "19a3eae0-3d78-4b97-8e61-a7b5ac9a30ee",
                                "sense_id": "d3a65835-4b63-3edb-a718-636cd3b38996",
                                "text": "„In Brüssel trafen sich die Verteidigungsminister der NATO zu einem eilig einberufenen Sondergipfel.“"
                            },
                            {
                                "example_id": "627820c0-281d-4e7d-bc42-072f78a56c04",
                                "sense_id": "d3a65835-4b63-3edb-a718-636cd3b38996",
                                "text": "„In den Achtzigerjahren ereignete sich auch die Kießling-Affäre, die fast eine Regierung zum Sturz brachte, zumindest Kohls Verteidigungsminister Wörner bedrohlich wurde.“"
                            },
                            {
                                "example_id": "1ab5e2c1-ac8e-403f-af6f-2dcadf08eb8d",
                                "sense_id": "d3a65835-4b63-3edb-a718-636cd3b38996",
                                "text": "„Nehrus alter Freund, der Verteidigungsminister Krishna Menon, hatte in Goa wohl vollendete Tatsachen geschaffen, und Nehru hatte dem dann zugestimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
