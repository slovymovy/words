                "senses": [
                    {
                        "sense_id": "5f34f10e-d434-3f12-92b9-de68d43d2349",
                        "entry_id": "ce9434d2-0801-3faa-92e3-52d1469edea4",
                        "glosses": [
                            "Animal qui mange les livres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06d26351-0d50-40db-b3c4-944664a4fc3e",
                                "sense_id": "5f34f10e-d434-3f12-92b9-de68d43d2349",
                                "text": "…en protégeant les livres des rats, des insectes et autres bibliophages."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1244d50-9028-3106-abf7-5d018a3b3258",
                        "entry_id": "ce9434d2-0801-3faa-92e3-52d1469edea4",
                        "glosses": [
                            "Lecteur avide de lecture au point de « dévorer » les livres."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1c6db063-5b8c-4ecc-81be-3a8f4fec30a6",
                                "sense_id": "c1244d50-9028-3106-abf7-5d018a3b3258",
                                "text": "Les bibliophages ne se contentent pas d'aimer les livres, ils les dévorent de la première à la dernière page en un rien de temps."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a37416a7-e6dc-40f9-909c-c2d3ad0f89a1",
                        "source_entry_id": "ce9434d2-0801-3faa-92e3-52d1469edea4",
