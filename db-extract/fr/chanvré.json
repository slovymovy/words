                    },
                    {
                        "sense_id": "cbc77786-229d-3873-b37b-2239f6ddc57e",
                        "entry_id": "30e3affc-d3ab-3009-88e2-45a8fda17d43",
                        "glosses": [
                            "Se dit d'une personne qui est sous l'effet psychodysleptique du cannabis."
