                    },
                    {
                        "translation_id": "0cf087fe-114c-4796-8963-ff206b951698",
                        "source_entry_id": "aaf729db-b54a-3a65-a85f-27c219c4df05",
                        "source_sense_description": "незаметно появиться где-нибудь, проникнуть куда-нибудь",
                        "target_lang_word": "se faufiler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se faufiler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26f5f4f2-cae1-3ecd-905d-438efaaaafd1",
                                        "entry_id": "4d4af16d-f756-3e47-8b3a-41a8c2090ab6",
                                        "glosses": [
                                            "Forme pronominale de faufiler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06b3919b-ede1-4969-95bb-3e00d8b97eb4",
                                                "sense_id": "26f5f4f2-cae1-3ecd-905d-438efaaaafd1",
                                                "text": "On n’entendait dans la clairière que le grouillement des bêtes à poil ou à écailles se faufilant dans la forêt tropicale qui les entourait de trois côtés, le murmure de la rivière et le teuf-teuf incessant du moteur Delco à essence qui fournissait le courant lumière et faisait marcher les vieilles machines de l’atelier de réparation."
                                            },
                                            {
                                                "example_id": "bf726bbb-ff02-4f9e-bfe7-ee481432d00e",
                                                "sense_id": "26f5f4f2-cae1-3ecd-905d-438efaaaafd1",
                                                "text": "Puis, les allées et venues des moineaux au rayon des pâtes, en face de sa caisse, retiennent son attention. Les piafs se faufilent sous les comptoirs et les plus culottés s'attaquent aux paquets de cellophane sous les rayons."
                                            },
                                            {
                                                "example_id": "f83e9af9-9719-4385-b903-a129faf37139",
                                                "sense_id": "26f5f4f2-cae1-3ecd-905d-438efaaaafd1",
                                                "text": "Cette grande analyse, Trump l’a écartée quatre ans plus tard, capitalisant plutôt sur sa célébrité, un populisme simpliste et la candidature peu inspirante — même pour de nombreux démocrates — de Hillary Clinton pour réussir à se faufiler vers la victoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
