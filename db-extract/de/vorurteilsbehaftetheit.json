                "senses": [
                    {
                        "sense_id": "b980a51f-7938-373c-9111-f0ca1fa75b31",
                        "entry_id": "9817e55e-d238-32ab-8e59-01d5eb18eeb4",
                        "glosses": [
                            "Einstellung/Haltung mit Vorurteilen, vorgefassten Meinungen gegenüber anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1e2024c-4a3e-41ee-ae40-219c6d1bd98c",
                                "sense_id": "b980a51f-7938-373c-9111-f0ca1fa75b31",
                                "text": "„Zeichnen sich Vorurteile ab oder kann von einer aller Vorurteilsbehaftetheit vorausliegenden kindlichen Offenheit ausgegangen werden?“"
                            },
                            {
                                "example_id": "fa70a799-42d2-44ab-bbd4-77e55b9c9cbc",
                                "sense_id": "b980a51f-7938-373c-9111-f0ca1fa75b31",
                                "text": "„Befangenheit, also Vorurteilsbehaftetheit, Einseitigkeit im Denken entsteht, wenn ein Mensch seine Perspektive auf die Welt als besondere Einsicht in die Welt ansieht, darin, wie die Welt ist oder wie sie sein sollte.“"
                            },
                            {
                                "example_id": "59dbd1d6-d17e-452f-9122-0f85d1167202",
                                "sense_id": "b980a51f-7938-373c-9111-f0ca1fa75b31",
                                "text": "„In diesen Schilderungen strotzt es nur so von Arroganz und Sturheit, Verlogenheit und Bosheit, Rücksichtslosigkeit, Vorurteilsbehaftetheit und anderen missliebigen Eigenschaften und Verhaltensweisen.“"
                            },
                            {
                                "example_id": "69366a02-4fa2-4fd5-9346-316be28e73a3",
                                "sense_id": "b980a51f-7938-373c-9111-f0ca1fa75b31",
                                "text": "„Sie verringert die Vorurteilsbehaftetheit des Sehens, indem sie der ‚Wirklichkeit‘ Gelegenheit gibt, den Vorurteilen zu widersprechen.“"
                            },
                            {
                                "example_id": "2418683f-be6f-4eb3-a110-09453acfb95f",
                                "sense_id": "b980a51f-7938-373c-9111-f0ca1fa75b31",
                                "text": "„Dass jedoch seine antimodernistischen Abstraktionen der soziokulturellen Judenfeindschaft Althaus missbrauchbar machten und in ihrer Empirie resistenten Vorurteilsbehaftetheit sich als eine schwere Belastung erwiesen, ist im Rückblick unübersehbar und unbestreitbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
