                "translations": [
                    {
                        "translation_id": "75c4daad-9b9f-4503-b6ae-6eb113c30c15",
                        "source_entry_id": "e12e7334-a732-336e-8491-41bce864c79c",
                        "source_sense_id": "ff0280d3-e70b-3822-bd8e-793c25a8ed8a",
                        "source_sense_description": "iemand die meent alles beter te weten dan anderen",
                        "target_lang_word": "Schlaumeier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlaumeier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96c002ff-ae52-341f-a4e0-0d11ee6764b0",
                                        "entry_id": "d50db699-b0b4-3ad6-bdc2-55aa7dbc6547",
                                        "glosses": [
                                            "ein schlauer, listiger, pfiffiger Mensch"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45c267fa-18cc-428d-8204-4a0b036ec092",
                                                "sense_id": "96c002ff-ae52-341f-a4e0-0d11ee6764b0",
                                                "text": "Er ist auch kein Schwindler oder abgefeimter Schlaumeier."
                                            },
                                            {
                                                "example_id": "ef2da266-cac3-497a-b285-257b31f19f22",
                                                "sense_id": "96c002ff-ae52-341f-a4e0-0d11ee6764b0",
                                                "text": "Das jüdische Volk ist kein Volk von Schlaumeiern, Weltverbesserern und reichen Menschen."
                                            },
                                            {
                                                "example_id": "dcca4ae3-7234-4b65-beff-aa4377e3d31d",
                                                "sense_id": "96c002ff-ae52-341f-a4e0-0d11ee6764b0",
                                                "text": "»Er heißt nicht umsonst Finot, der Schlaumeier«, sagte Lucien zu Lousteau."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6728949f-9a56-3f66-b8e6-d8a9eebbff8c",
                                        "entry_id": "d50db699-b0b4-3ad6-bdc2-55aa7dbc6547",
                                        "glosses": [
                                            "ein Mensch, der sich unbegründet für schlau hält oder als schlau ausgibt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73bdf662-dc51-4c9b-84e6-31c59a925808",
                                                "sense_id": "6728949f-9a56-3f66-b8e6-d8a9eebbff8c",
                                                "text": "Der Schlaumeier glaubt wohl, dass seine wahren Absichten nicht von uns durchschaut werden."
                                            },
                                            {
                                                "example_id": "bbf54a03-6de8-4b1b-8039-d461f971b8b7",
                                                "sense_id": "6728949f-9a56-3f66-b8e6-d8a9eebbff8c",
                                                "text": "… in den Füchsen erblicke ich die Schlaumeier, die du bis aufs Blut peitschen wirst, sobald sie dir ins Garn gegangen sind; …"
                                            },
                                            {
                                                "example_id": "41ea99b5-d8ba-48d3-87f3-ce24254a2258",
                                                "sense_id": "6728949f-9a56-3f66-b8e6-d8a9eebbff8c",
                                                "text": "Sie sind ein kleiner Schlaumeier, und ich weiß noch gar nicht, ob wir das so ruhig hinnehmen werden."
                                            },
                                            {
                                                "example_id": "85f152d0-5fc5-47f2-8f56-b7cc5fb4b429",
                                                "sense_id": "6728949f-9a56-3f66-b8e6-d8a9eebbff8c",
                                                "text": "„Das Numinosum, das Krankheit und Starre lösende, erlösende Heilige schenkt sich keinem Schlaumeier, keinem Kurpfuscher und Nekromanten, aber auch keinem Medizinalpfaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8855d26-78f8-4d62-af7a-02d8ba1637df",
                        "source_entry_id": "e12e7334-a732-336e-8491-41bce864c79c",
                        "source_sense_id": "ff0280d3-e70b-3822-bd8e-793c25a8ed8a",
                        "source_sense_description": "iemand die meent alles beter te weten dan anderen",
                        "target_lang_word": "Klugscheißer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klugscheißer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05535941-aaab-3c30-81f9-dd2c5e09508d",
                                        "entry_id": "6329d216-dd1d-36a3-a358-26262116ba86",
                                        "glosses": [
                                            "Person, die immer alles besser wissen will"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0e72c8b-a7b1-4dba-a145-58d2f905d76d",
                                                "sense_id": "05535941-aaab-3c30-81f9-dd2c5e09508d",
                                                "text": "Ich habe die Nase voll von diesen arroganten Klugscheißern!"
                                            },
                                            {
                                                "example_id": "3f793568-26f7-4c11-9ec0-4d1c166ed94f",
                                                "sense_id": "05535941-aaab-3c30-81f9-dd2c5e09508d",
                                                "text": "„Als er sich die Zähne putzen gegangen war, bezeichnete Mama Gustav als Klugscheißer, und Papa sagte, das komme eben dabei raus, wenn ein Junge von seinen Großeltern erzogen werde.“"
                                            },
                                            {
                                                "example_id": "3e58260b-3208-41ef-9c2f-3404482ef436",
                                                "sense_id": "05535941-aaab-3c30-81f9-dd2c5e09508d",
                                                "text": "„Ich deutscher Klugscheißer wusste damals nicht mal, wo der Kandidat Mitterand eigentlich herkam.“"
                                            },
                                            {
                                                "example_id": "29c432d1-b92b-4158-beab-039c7d7f8939",
                                                "sense_id": "05535941-aaab-3c30-81f9-dd2c5e09508d",
                                                "text": "„„Wade, Sie sind ein kleiner Klugscheißer. Sie waren schon bei dem Prozess ein Klugscheißer. Und jetzt sind Sie immer noch ein Klugscheißer. Ich wette, Sie sind schon als Klugscheißer geboren worden. Und ich bin sicher, Ihre Mama war auch schon eine Klugscheißerin und ihre beiden Kinder sind mit Sicherheit auch Klugscheißer. Sie können einfach nicht anders, stimmt's? Aber jetzt hören Sie mir mal zu, Sie kleiner Klugscheißer, ab jetzt werden Sie eine Stunde lang kein Klugscheißer mehr sein. Haben Sie das verstanden, Wade?““"
                                            },
                                            {
                                                "example_id": "d863d523-c6e5-419b-890f-300a02dc8094",
                                                "sense_id": "05535941-aaab-3c30-81f9-dd2c5e09508d",
                                                "text": "»Du redest wie ein kleiner Klugscheißer.« »Es ist ein Zitat von Friedrich Nietzsche.« »Trotzdem Klugscheißer …« »Könnten nicht auch Klugscheißer manchmal recht haben?« »Schon möglich. Aber musst du es jeden spüren lassen?«"
                                            },
                                            {
                                                "example_id": "55d792ef-17e3-4b4e-a727-79ad3b7becd6",
                                                "sense_id": "05535941-aaab-3c30-81f9-dd2c5e09508d",
                                                "text": "„„Und sind Sie sicher, dass Sie nicht schon immer ein Klugscheißer waren?““"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
