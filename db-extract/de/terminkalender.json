                    {
                        "sense_id": "97d4a70c-24bf-3f19-8507-024360b959f2",
                        "entry_id": "7c4cdcf0-32e3-38b9-90fb-e34ebdfb80d9",
                        "glosses": [
                            "Agenda, calendrier ; aussi échéancier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ac23655-42b4-449a-9e50-029ab0536bfa",
                                "sense_id": "97d4a70c-24bf-3f19-8507-024360b959f2",
                                "text": "Die Termine werden im Terminkalender eingetragen.",
                                "translation": "Les rendez-vous sont enregistrés dans l'agenda."
                            },
                            {
                                "example_id": "541a10b8-e0f2-4a3d-952e-988a216081de",
                                "sense_id": "97d4a70c-24bf-3f19-8507-024360b959f2",
                                "text": "Kim Jong Un hat dieser Tage einen wahrlich vollen Terminkalender. (...) Am nächsten Morgen trommelte der 38-Jährige schließlich das Politbüro für ein Krisentreffen zusammen.",
                                "translation": "Kim Jong Un a un calendrier vraiment chargé ces jours-ci. (...) Le lendemain matin, l’homme de 38 ans a finalement convoqué le Politburo pour une réunion de crise.."
                            }
                        ]
                    }
                ],
