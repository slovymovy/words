                "senses": [
                    {
                        "sense_id": "846e55c7-5b67-31d5-baed-91f33872cbd4",
                        "entry_id": "c79f4814-9769-3956-b3f5-8b6c4f829715",
                        "glosses": [
                            "in der x86-Architektur der erste Datenblock (512 Byte) eines in Partitionen aufgeteilten, bootfähigen Speichermediums, wie beispielsweise einer Festplatte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64a763e8-491e-4d88-a16a-881451ba50c6",
                                "sense_id": "846e55c7-5b67-31d5-baed-91f33872cbd4",
                                "text": "Damit das Betriebssystem gestartet werden kann, wird der Master Boot Record nach Starten des Computers in den Arbeitsspeicher geladen und dieser veranlasst, dass der allererste Bootsektor von der Festplatte abgearbeitet wird und letztlich das Betriebssystem startet. Dazu muss der MBR immer in diesem allerersten Sektor der Festplatte liegen, dem Masterbootsektor."
                            }
                        ],
                        "sense_index_json": "\"1\""
