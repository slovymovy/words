                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das ist der Kollege, <w>der</w> mir bei dem schwierigen Projekt geholfen hat."
                        },
                        {
                            "text": "Ich suche einen Arzt, <w>der</w> auch am Wochenende geöffnet hat."
