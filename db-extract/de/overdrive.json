                "translations": [
                    {
                        "translation_id": "0d01c498-dc89-4bf0-939d-f470ec750ed7",
                        "source_entry_id": "400f8acb-22db-3576-817d-077d4a8f3962",
                        "source_sense_id": "52450f46-6f00-379b-a64f-c7d7ac53d9f8",
                        "target_lang_word": "overdrive",
