                "senses": [
                    {
                        "sense_id": "cb0b8ff7-b434-3953-be0a-eec5cbbb602d",
                        "entry_id": "ffe070b1-2e91-3743-85fd-79e59cfe8295",
                        "glosses": [
                            "weibliche Person, die berufsmäßig anderen Haare schneidet, frisiert, wäscht, färbt und pflegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "101b5805-7f54-4b71-ba76-7daa15c8bc47",
                                "sense_id": "cb0b8ff7-b434-3953-be0a-eec5cbbb602d",
                                "text": "Ich vertraue da voll meiner Frisöse. Auch wenn ich mal mit ausgeflippten Frisurenbildern zu ihr komme, sagt sie mir, ob das mit meinen Haaren überhaupt machbar ist und ob das zu mir passt."
                            },
                            {
                                "example_id": "bd6dc3a3-3629-44b5-b875-008dbd9e5345",
                                "sense_id": "cb0b8ff7-b434-3953-be0a-eec5cbbb602d",
                                "text": "Selten wurde, seit Doktor Goebbels' Großregie im deutschen Film, so heroisch gestorben, wie es Hennig Baum als dem Piloten eines abgestürzten Rosinenbombers gelingt, wenige Wochen ehe er der Frisöse Leni Genthin (alias Katharina Wackernagel) als Kriegsbraut das höchste Glück jener Tage bescheren kann: die amerikanische Heirat."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
