                "senses": [
                    {
                        "sense_id": "69ebe2ea-717d-3e2b-8a85-aec012b9ad77",
                        "entry_id": "bf643df2-0883-3f3b-83ba-92cbe7507320",
                        "glosses": [
                            "To hold or believe (something) beforehand; to assume; to anticipate, to predict."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "17887047-94b5-4a95-9708-8570297a8b36",
                                "sense_id": "69ebe2ea-717d-3e2b-8a85-aec012b9ad77",
                                "text": "Instead of that he has encountered nothing but harsh criticism, unkindly dispositions, even on the part of his relatives, and he naturally drifted into places and surroundings where legitimate sympathy was not foreheld."
                            },
                            {
                                "example_id": "989ebfda-f9b6-4055-801a-c046eac173d4",
                                "sense_id": "69ebe2ea-717d-3e2b-8a85-aec012b9ad77",
                                "text": "Or he may call \"he who foreholds\" the one who wants and receives, rather than the one who confers first: he calls […]"
                            },
                            {
                                "example_id": "27c29623-1640-4bde-9781-f8c161f6a699",
                                "sense_id": "69ebe2ea-717d-3e2b-8a85-aec012b9ad77",
                                "text": "In a case regarding hazardous waste disposal, the [European] Commission ordered recovery for that part of the operating aid, which did not concern foreholding a capacity for waste treatment, but rather for the acquisition of commercial hazardous waste."
                            }
                        ]
                    }
                ],
