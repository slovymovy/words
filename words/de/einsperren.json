                {
                    "sense_id": "81f96fa9-ac66-3123-aa22-a9aad3a0946e",
                    "sense_definition": "eine Person gegen ihren Willen in einem Raum oder Gebäude festsetzen und am Verlassen hindern",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "festhalten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>sperrte</w> seinen kleinen Bruder aus Versehen im Keller <w>ein</w>."
                        },
                        {
                            "text": "Niemand hat das Recht, einen Menschen gegen seinen Willen in ein Zimmer <w>einzusperren</w>."
                        }
                    ],
                    "synonyms": [
                        "einschließen",
                        "wegschließen"
                    ],
                    "antonyms": [
                        "freilassen"
                    ],
                    "common_phrases": [
                        "im Zimmer einsperren",
                        "im Keller einsperren"
                    ]
                },
                {
                    "sense_id": "cc819e82-4ce3-31af-8d92-b7ccbbedce09",
                    "sense_definition": "ein Tier in einem Raum, Stall oder Käfig festhalten, sodass es nicht entkommen kann",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "festhalten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wer hat die Katze schon wieder in der Garage <w>eingesperrt</w>?"
                        },
                        {
                            "text": "Man sollte wilde Tiere niemals in einen engen Käfig <w>einsperren</w>."
                        }
                    ],
                    "synonyms": [
