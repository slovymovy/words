                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaac9432-9230-4770-b4e9-6254a29bae1b",
                                "sense_id": "a088675e-c1ed-363e-8533-a3adc82166bf",
                                "text": "Teodora Chiliment, 27 ans, traductrice dans une agence de communication est tombée dans la marmite tango bucarestoise : \"Je vivais dans la routine et je voulais commencer une activité artistique\"."
                            },
                            {
                                "example_id": "aaf776dc-e5f5-427f-aa4a-d0d2bcc80285",
                                "sense_id": "a088675e-c1ed-363e-8533-a3adc82166bf",
                                "text": "Le thermomètre de la voiture indique pourtant un joli 28 degrés, absolument ordinaire pour un mois de juin bucarestois."
                            }
                        ]
                    }
