{
    "word_family": [
        "infirmity",
        "infirmary"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4362b17c-d93d-344b-b945-3bb1401c40d5",
                    "sense_definition": "Weak or ill, not in good health.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>infirm</w> patient required constant care from the nursing staff.",
                            "target_lang_translations": {
                                "zh": "那位<w>虚弱</w>的病人需要护理人员的持续照料。"
                            }
                        },
                        {
                            "text": "Special transport is available for voters who are sick or <w>infirm</w>.",
                            "target_lang_translations": {
                                "zh": "我们为生病或<w>体弱</w>的选民提供特殊交通工具。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ill",
                        "sick",
                        "unwell"
                    ],
                    "common_phrases": [
                        "sick or infirm"
                    ],
                    "target_lang_definitions": {
                        "zh": "身体虚弱的，多病的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "虚弱",
                                "target_lang_sense_clarification": "指身体衰弱，多用于形容老人或病人。"
                            },
                            {
                                "target_lang_word": "体弱",
                                "target_lang_sense_clarification": "指身体素质较差，容易生病。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13eec1d2-71ec-3ced-b9db-9ed1971beee9",
                    "sense_definition": "Frail, unstable, or insecure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The structure stood on <w>infirm</w> ground and risked collapsing during the storm.",
                            "target_lang_translations": {
                                "zh": "该建筑建在<w>不稳固</w>的地面上，在暴风雨中有倒塌的风险。"
                            }
                        },
                        {
                            "text": "His argument was built on <w>infirm</w> logic that failed under scrutiny.",
                            "target_lang_translations": {
                                "zh": "他的论点建立在<w>站不住脚</w>的逻辑之上，经不起推敲。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "不稳固的，不牢靠的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不稳固",
                                "target_lang_sense_clarification": "指结构或基础不牢靠。"
                            },
                            {
                                "target_lang_word": "站不住脚",
                                "target_lang_sense_clarification": "常用于形容逻辑或论点缺乏依据。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0e8fd4c-0e63-3586-94a4-fd403e365ea4",
                    "sense_definition": "Irresolute or weak of mind or will.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>infirm</w> of purpose and could not make a final decision.",
                            "target_lang_translations": {
                                "zh": "他<w>意志薄弱</w>，无法做出最终决定。"
                            }
                        },
                        {
                            "text": "The leader showed an <w>infirm</w> judgment during the crisis.",
                            "target_lang_translations": {
                                "zh": "这位领导人在危机期间表现出了<w>优柔寡断</w>的判断力。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "infirm of purpose"
                    ],
                    "target_lang_definitions": {
                        "zh": "意志薄弱的，优柔寡断的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "意志薄弱",
                                "target_lang_sense_clarification": "指缺乏坚定的决心。"
                            },
                            {
                                "target_lang_word": "优柔寡断",
                                "target_lang_sense_clarification": "指做事犹豫不决。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0710e3b5-937a-3fed-b269-c0ad446c5d07",
                    "sense_definition": "To contradict or provide proof that something is not true.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New data may <w>infirm</w> the previous scientific hypothesis.",
                            "target_lang_translations": {
                                "zh": "新的数据可能会<w>推翻</w>之前的科学假设。"
                            }
                        },
                        {
                            "text": "The evidence serves to <w>infirm</w> the witness's earlier statement.",
                            "target_lang_translations": {
                                "zh": "这些证据足以<w>反驳</w>证人之前的陈述。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disconfirm"
                    ],
                    "antonyms": [
                        "confirm"
                    ],
                    "target_lang_definitions": {
                        "zh": "反驳，证明……不成立。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "反驳",
                                "target_lang_sense_clarification": "提出理由否定对方的观点。"
                            },
                            {
                                "target_lang_word": "推翻",
                                "target_lang_sense_clarification": "指通过证据使原有的结论或假设失效。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}