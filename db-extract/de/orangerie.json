                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "оранжерея",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "45e24f14-5ad5-3991-833d-15ce8d263340",
                                        "entry_id": "93de66b9-e834-3b22-b740-caff68dca53a",
                                        "glosses": [
                                            "застеклённое сооружение с искусственным климатом, предназначенное для выращивания и содержания различных теплолюбивых растений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1a18fa9-a15d-45a4-8ef1-90cf05d2b20d",
                                                "sense_id": "45e24f14-5ad5-3991-833d-15ce8d263340",
                                                "text": "Кроме цветов, пестревших по клумбам вдоль фасада, под окнами выставлены из оранжерей цветы и деревья стран более благосклонных. 〈…〉 Окола оранжерей вся дамская компания рассеялась вдоль шпалер, искать спелых персиков к обеду."
                                            },
                                            {
                                                "example_id": "ea071312-ccab-411f-ad1b-0b07debd5518",
                                                "sense_id": "45e24f14-5ad5-3991-833d-15ce8d263340",
                                                "text": "Чаще всего мы отправлялись в сад, где была уже упомянутая мною громадная оранжерея. В оранжерее росли персики, абрикосы и сливы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
