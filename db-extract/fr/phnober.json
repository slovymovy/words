                "senses": [
                    {
                        "sense_id": "bf252412-9d83-3c6e-8fd6-108c217a51db",
                        "entry_id": "5c2e173b-2f6f-398b-a5a3-9cace20f1edf",
                        "glosses": [
                            "Attitude non-verbale consistant à ignorer un interlocuteur en gardant volontairement l’air profondément concentré sur son smartphone."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "c4eaf6ab-71ef-4b5e-afbb-c5bd475f76cc",
                                "sense_id": "bf252412-9d83-3c6e-8fd6-108c217a51db",
                                "text": "J’essaie de lui parler de quelque chose d’important depuis une heure et pourtant, Thomas s’obstine à me phnober."
                            },
                            {
                                "example_id": "aa9de3f9-750f-4a9a-a61c-52c39e46be97",
                                "sense_id": "bf252412-9d83-3c6e-8fd6-108c217a51db",
                                "text": "Arnaud s’est muré dans le silence, il nous phnobe et ne consacre de l’intérêt qu’aux sms qu’il reçoit de sa petite-amie."
                            }
                        ]
                    }
                ],
