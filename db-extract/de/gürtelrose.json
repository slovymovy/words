                        "entry_id": "51e34ad8-d9d5-3a19-ac8f-245f6d073bf7",
                        "glosses": [
                            "Viruserkrankung, die sich durch schmerzhaften Hautausschlag mit Blasen bemerkbar macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c54496df-f7ad-4d6f-8968-7bf2bf8a603c",
                                "sense_id": "f8315c5a-3cb2-38fa-95be-a3d96fa6ef31",
                                "text": "Eine Gürtelrose zieht sich meist gürtelförmig an den Nervenbahnen entlang und kann dabei auch an den Beinen oder am Kopf vorkommen."
                            },
                            {
                                "example_id": "221d124c-3363-4202-bc69-e447c86516c9",
                                "sense_id": "f8315c5a-3cb2-38fa-95be-a3d96fa6ef31",
                                "text": "Die Gürtelrose ist die Zweitmanifestation des Varizella-Zoster-Virus, der als Ersterkrankung die Windpocken verursacht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
