                "senses": [
                    {
                        "sense_id": "094d91ce-8111-3e24-bcf6-1033a68a75c4",
                        "entry_id": "08c030a6-9d73-39d8-be1d-7d9b6bb31203",
                        "glosses": [
                            "Klimaaktivist, der mit Mitteln des zivilen Ungehorsams (zum Beispiel Straßenblockaden oder das Blockieren von Start- und Landebahnen) Maßnahmen gegen die Klimakrise erzwingen möchte"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "83a37fed-b06d-4850-b1fe-711c5e302591",
                                "sense_id": "094d91ce-8111-3e24-bcf6-1033a68a75c4",
                                "text": "„Claudia Plakolm (ÖVP) bezeichnet Klimaaktivisten als Klimachaoten und Klimaterroristen, Johanna Mikl-Leitner (ÖVP) fordert härtere Strafen bei Klima-Blockaden und für Reifenstecher (die nicht Reifen zerstechen, sondern nur die Luft auslassen).“"
                            },
                            {
                                "example_id": "cc1e54f9-1529-42f1-a8c7-795e1098243d",
                                "sense_id": "094d91ce-8111-3e24-bcf6-1033a68a75c4",
                                "text": "„Heckemann unterstellt in seinem Text der vor Ort gewesenen Notärztin ‚bedingungslose Sympathie für die Klimaterroristen oder aber persönliche Angst vor Repressionen‘, aufgrund ihrer Aussage, sie hätte das Bergungsfahrzeug nicht gebraucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
