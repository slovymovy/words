                    "frequency": "Middle",
                    "semantic_group_id": "monarchie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der junge Prinz wurde in einer feierlichen Zeremonie in der Kathedrale zum König <w>gekrönt</w>."
                        },
                        {
                            "text": "Die Erzbischöfe versammelten sich in der Hauptstadt, um den neuen Herrscher zu <w>krönen</w>."
                        }
                    ],
                    "synonyms": [
