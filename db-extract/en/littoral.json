                                    {
                                        "sense_id": "44e75f85-9323-3ac7-9cd8-23d151b99ad9",
                                        "entry_id": "b4e3c65d-00e6-3fed-9f9d-e0a7a87d2300",
                                        "glosses": [
                                            "Franja en torno a la línea de costa."
                                        ],
                                        "tags": [],
