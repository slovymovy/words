                                        "glosses": [
                                            "iets niet zelf doen maar het door een ander laten doen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52f70cb4-899f-452f-aa38-75285949d677",
                                                "sense_id": "62a3dbc6-4d53-382c-b384-5df167507736",
                                                "text": "De puber had het opruimen van haar kamer uitbesteed aan haar moeder."
                                            },
                                            {
                                                "example_id": "829f2786-91bb-49df-818e-48d7baf06a97",
                                                "sense_id": "62a3dbc6-4d53-382c-b384-5df167507736",
                                                "text": "Veel mensen zien als een berg op tegen de belastingaangifte. Bijna 40 procent besteedt het invullen ervan weleens uit, zo bleek eerder dit jaar uit een enquête van de Consumentenbond. Maar vaak is dat onnodig en het biedt ook geen garantie op een waterdichte aangifte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3c4a5df-a04f-3310-9689-838926bec645",
                                        "entry_id": "f0fba388-8412-3d85-95fb-a2a7230169e0",
                                        "glosses": [
                                            "ten huwelijk geven"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e44c0dd1-3657-46c7-bd07-92b751d10809",
                                                "sense_id": "a3c4a5df-a04f-3310-9689-838926bec645",
                                                "text": "Zijn eenigh oir, en erfgenaeme ontzielt. Is dat niet bly zijn dochter uitbesteden? Ter bruiloft gaen?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81451dda-6e08-3007-94cb-6927c98054a4",
                                        "entry_id": "f0fba388-8412-3d85-95fb-a2a7230169e0",
                                        "glosses": [
                                            "de uitvoering van een proces als gevolg van een strategische keuze door een organisatie, om één of meer bedrijfsactiviteiten uitbesteden aan een dienstverlenende onderneming of toeleverancier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13424dd3-8072-432c-8de2-43bce844c5ee",
                                                "sense_id": "81451dda-6e08-3007-94cb-6927c98054a4",
                                                "text": "Het kleine bedrijf had zijn administratie uitbesteed aan een administratiebedrijf die deze procedure outsourcing noemde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
