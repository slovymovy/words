                ],
                "senses": [
                    {
                        "sense_id": "a5cd5456-9890-3e99-8e9d-7fa42738f430",
                        "entry_id": "0b1e0e92-d41f-3395-8a61-7c520a48d492",
                        "glosses": [
                            "amtliches Dokument, das die Geburt und Abstammung eines Kindes beurkundet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c913fff-2b1d-40f8-870d-77b8ab1489b7",
                                "sense_id": "a5cd5456-9890-3e99-8e9d-7fa42738f430",
                                "text": "„Dessen Geburtsurkunde ist verschwunden, weshalb Konrad fortan mit der falschen Identität weiterleben kann.“"
                            },
                            {
                                "example_id": "32bce5b9-acfc-49c3-87cd-29ca23fa80da",
                                "sense_id": "a5cd5456-9890-3e99-8e9d-7fa42738f430",
                                "text": "„In die Geburtsurkunde und das standesamtliche Register aber wurde, der Wahrheit gemäß, als Religion des Erzeugers und der Mutter »mosaisch« geschrieben.“"
                            },
                            {
                                "example_id": "72d66c8b-e8db-4c83-b84f-1f810005fd42",
                                "sense_id": "a5cd5456-9890-3e99-8e9d-7fa42738f430",
                                "text": "„Der Name prangt auf der Geburtsurkunde und im Album unter den Fotos von der Einschulung.“"
                            },
                            {
                                "example_id": "a705f5d7-ae1b-426b-a864-1a992d101181",
                                "sense_id": "a5cd5456-9890-3e99-8e9d-7fa42738f430",
                                "text": "„Das Ganze wurde mit einer auf alt gemachten Geburtsurkunde bezeugt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4ed0cd18-091c-34d2-b565-fcc15a25b831",
                        "entry_id": "0b1e0e92-d41f-3395-8a61-7c520a48d492",
                        "glosses": [
                            "Urkunde im Geburtenregister über die Geburt einer Person sowie deren Namen und Abstammung"
                        ],
                        "tags": [
                            "Belgien"
                        ],
                        "examples": [
                            {
                                "example_id": "97678714-e5c1-4fc4-bfcd-d1115371371c",
                                "sense_id": "4ed0cd18-091c-34d2-b565-fcc15a25b831",
                                "text": "„Der Auszug aus der Geburtsurkunde kann nur in der Gemeinde beantragt werden, in der die Geburtserklärung stattgefunden hat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
