                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad636f7f-58ae-493b-8652-9136bc250158",
                                "sense_id": "d69b0547-5e6e-3a0c-a68a-016861075bca",
                                "text": "„Die Sonne scheint durch das Birkenlaub und wedelt Schatten über die Buchseiten.“"
                            },
                            {
                                "example_id": "56e2634d-9fb5-4d5e-b76b-b8e91dc3f51d",
                                "sense_id": "d69b0547-5e6e-3a0c-a68a-016861075bca",
                                "text": "„Pferdefutter schien knapp zu werden, und so sollte das Birkenlaub den Engpaß der Futterknappheit überwinden helfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
