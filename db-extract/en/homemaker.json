                                "target_senses": [
                                    {
                                        "sense_id": "c096a13e-a6cb-3fe6-b14f-1c1f714e1954",
                                        "entry_id": "efe4c0fd-6807-39e8-872f-6f08546a67be",
                                        "glosses": [
                                            "Homme, souvent père, qui n’a pas d’activité professionnelle, et qui est chargé de la gestion du foyer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0b48228-fd02-4cba-a94b-44929bd982ad",
                                                "sense_id": "c096a13e-a6cb-3fe6-b14f-1c1f714e1954",
                                                "text": "La situation d’homme au foyer était devenue une mode à la fin des années soixante-dix, acceptée en théorie mais choquante dès qu’il s’agissait du voisin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
