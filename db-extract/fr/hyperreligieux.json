                        "sense_id": "65d4c6b3-cb87-3b6c-83e8-746ff3cb67e1",
                        "entry_id": "7c3c4f24-7e8c-33e3-a428-154d39fd71c8",
                        "glosses": [
                            "Extrêmement religieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f78fdd0e-9cf8-48ff-bb9d-ef20277242b2",
                                "sense_id": "65d4c6b3-cb87-3b6c-83e8-746ff3cb67e1",
                                "text": "Ça crée une atmosphère hyperreligieuse, hyperspirituelle, on le sent dans la rue, les gens sont gentils, hyperdélicats, attentionnés les uns envers les autres."
                            },
                            {
                                "example_id": "2cb4b3ae-5678-4315-b74a-220cf003ee8f",
                                "sense_id": "65d4c6b3-cb87-3b6c-83e8-746ff3cb67e1",
                                "text": "Il est devenu hyperreligieux…"
                            },
                            {
                                "example_id": "f2cbff54-c968-460c-99fd-57edcabf59ef",
                                "sense_id": "65d4c6b3-cb87-3b6c-83e8-746ff3cb67e1",
                                "text": "Ce livre m’a surtout paru intéressant pour vivre avec celui qui l’a vécu le sort malheureux autant qu’injuste d’un athée en milieu hyperreligieux."
                            }
                        ]
                    }
