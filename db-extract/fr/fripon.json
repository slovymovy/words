            {
                "entry_id": "e5fac0f9-351b-352a-b35a-fc92c7ce30ce",
                "word": "fripon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "33a04257-e47c-4e80-b9b6-f278ee305d0a",
                        "entry_id": "e5fac0f9-351b-352a-b35a-fc92c7ce30ce",
                        "tags": [
                            "plural"
                        ],
                        "form": "fripons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ed44096-8db6-3da1-8e5b-289b7d838762",
                        "entry_id": "e5fac0f9-351b-352a-b35a-fc92c7ce30ce",
                        "glosses": [
                            "Celui qui vole adroitement."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "18d88342-7c2c-41aa-908a-57674498b53c",
                                "sense_id": "5ed44096-8db6-3da1-8e5b-289b7d838762",
                                "text": "Vous devez savoir que cette loi agraire, dont vous avez tant parlé, n’est qu’un fantôme créé par les fripons pour épouvanter les imbéciles ; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "9affd503-3355-318d-9f7f-9616a0ada076",
                        "entry_id": "e5fac0f9-351b-352a-b35a-fc92c7ce30ce",
                        "glosses": [
                            "Individu de mauvaise foi, fourbe, trompeur."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "60b491da-46e6-433d-9e45-501270ab5bbe",
                                "sense_id": "9affd503-3355-318d-9f7f-9616a0ada076",
                                "text": "J’appelle un chat un chat et Rollet un fripon."
                            },
                            {
                                "example_id": "8845f74c-65ae-49a3-94bd-329eb052007f",
                                "sense_id": "9affd503-3355-318d-9f7f-9616a0ada076",
                                "text": "Quant à Latournelle, figurez-vous un bon petit homme, aussi rusé que la probité la plus pure le permet, et que tout étranger prendrait pour un fripon à voir l’étrange physionomie à laquelle Le Havre s’est habitué."
                            },
                            {
                                "example_id": "9fef6266-d196-4c21-95d6-52d71578b672",
                                "sense_id": "9affd503-3355-318d-9f7f-9616a0ada076",
                                "text": "Je sais ce qu’on prend pour sa table au marché. Son fripon de cuisinier n'est pas pour rien l’élève d'un Français ; il écorche un chat et le sert en guise de lièvre."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc28097d-1a93-3f61-8b21-9f99bc466782",
                        "entry_id": "e5fac0f9-351b-352a-b35a-fc92c7ce30ce",
                        "glosses": [
                            "Enfant coquin, éveillé."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ee7cc380-4f7e-4067-94b5-68e6c1182261",
                                "sense_id": "cc28097d-1a93-3f61-8b21-9f99bc466782",
                                "text": "Cet enfant est un véritable fripon. Il fera damner sa mère!."
                            }
                        ]
                    },
                    {
                        "sense_id": "a910ca62-98b7-3b29-a874-e88ccb90e6a2",
                        "entry_id": "e5fac0f9-351b-352a-b35a-fc92c7ce30ce",
                        "glosses": [
                            "Jeune homme léger et étourdi, jeune femme coquette, adroite et fine."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "b6acc5bc-6c46-4d26-942b-fb17459905b2",
                                "sense_id": "a910ca62-98b7-3b29-a874-e88ccb90e6a2",
                                "text": "C’est un fripon qui court les aventures."
                            },
                            {
                                "example_id": "966de675-0dc5-4443-a8cd-eca60046c371",
                                "sense_id": "a910ca62-98b7-3b29-a874-e88ccb90e6a2",
                                "text": "La friponne ! Ce que c’est que les jeunes filles ! C’est pour me faire parler qu’elle est venue me cajoler !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "823401ef-9a55-46cd-963e-3d62215883ee",
                        "source_entry_id": "e5fac0f9-351b-352a-b35a-fc92c7ce30ce",
                        "target_lang_word": "rascal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rascal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3102f4c6-5900-352f-8710-ab62c234ef52",
                                        "entry_id": "ee503355-cc2b-3a57-b710-1e518070fbab",
                                        "glosses": [
                                            "A dishonest person; a rogue, a scoundrel, a trickster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89202b7f-76a0-405a-9fb8-9f03aa6a4c69",
                                                "sense_id": "3102f4c6-5900-352f-8710-ab62c234ef52",
                                                "text": "Tuc[ca]. […] Can thy Author doe it impudently enough? / Hiſt[rio]. O, I warrant you, Captaine: and ſpitefully inough too; he ha's one of the moſt ouerflowing villanous wits, in Rome. He will ſlander any man that breathes; If he diſguſt him. / Tucca. I'le know the poor, egregious, nitty Raſcall; and he haue ſuch commendable Qualities, I'le cheriſh him: […]"
                                            },
                                            {
                                                "example_id": "41761047-b687-44d3-98ac-f14a440092bc",
                                                "sense_id": "3102f4c6-5900-352f-8710-ab62c234ef52",
                                                "text": "And he smote Corinius on his shaven jowl with the dice box, calling him cheat and mangy rascal, whereupon Corinius drew forth a bodkin to smite him in the neck withal; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74a11f21-2358-35eb-aa85-6fe5fa486b17",
                                        "entry_id": "ee503355-cc2b-3a57-b710-1e518070fbab",
                                        "glosses": [
                                            "Sometimes diminutive: a cheeky person or creature; a troublemaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60571d97-fa9d-4f53-9682-36cf991a001c",
                                                "sense_id": "74a11f21-2358-35eb-aa85-6fe5fa486b17",
                                                "text": "That little rascal bit me!"
                                            },
                                            {
                                                "example_id": "4c0693cd-3d0b-427f-ad82-c8749c037c6e",
                                                "sense_id": "74a11f21-2358-35eb-aa85-6fe5fa486b17",
                                                "text": "If you have deer in the area, you may have to put a fence around your garden to keep the rascals out."
                                            }
                                        ]
