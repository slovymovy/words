    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "bd30684f-9f92-3323-b112-4edbd2530da9",
                "word": "refulgence",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c0dc600f-5345-44a6-bb4f-afd1c60e3a64",
                        "entry_id": "bd30684f-9f92-3323-b112-4edbd2530da9",
                        "tags": [
                            "plural"
                        ],
                        "form": "refulgences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "24e094f8-d4b0-3628-9acd-a6f71288ff93",
                        "entry_id": "bd30684f-9f92-3323-b112-4edbd2530da9",
                        "glosses": [
                            "the quality of being refulgent; refulgency"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e4bac715-ad74-4788-912c-9419a248ef3d",
                                "sense_id": "24e094f8-d4b0-3628-9acd-a6f71288ff93",
                                "text": "In a parallel way the refulgence of Jesus's body at the Transfiguration was miraculous, transitory, like sun lighting up the air."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e92a4dfd-ba2b-4703-9380-107df3344a2d",
                        "source_entry_id": "bd30684f-9f92-3323-b112-4edbd2530da9",
                        "source_sense_id": "24e094f8-d4b0-3628-9acd-a6f71288ff93",
                        "source_sense_description": "the quality of being refulgent",
                        "target_lang_word": "éclat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éclat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18842f89-e4b1-330d-af95-036be8988792",
                                        "entry_id": "5af0631c-b9be-3c3b-9ecd-a12e4dffbf0d",
                                        "glosses": [
                                            "Partie détachée brusquement d’un corps qui éclate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff7cf83f-c985-4e46-a1e8-0545a6b61474",
                                                "sense_id": "18842f89-e4b1-330d-af95-036be8988792",
                                                "text": "Le 13 juin, alors que le front croulait de toutes parts, en revenant d'une mission de convoyage en Bloch-210 je fus blessé par un éclat sur le terrain de Tours."
                                            },
                                            {
                                                "example_id": "58a7677d-0558-4e7b-b52e-b8533e82a689",
                                                "sense_id": "18842f89-e4b1-330d-af95-036be8988792",
                                                "text": "Les industries archéolithiques et mésolithiques du silex présentent, comme caractères généraux, que des instruments faits d’éclats retouchés de diverses manières ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c18210e-2155-31bb-adc0-8e7ec310130c",
                                        "entry_id": "5af0631c-b9be-3c3b-9ecd-a12e4dffbf0d",
                                        "glosses": [
                                            "Portion d'une plante qui a été séparée par division et qui est destinée à une replantation."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7802c7f8-77ea-445b-8d5c-1697cec16553",
                                                "sense_id": "1c18210e-2155-31bb-adc0-8e7ec310130c",
                                                "text": "La reproduction par semis, même sous cloche, est très-difficile et très-lente à notre climat; la propagation par marcottes, et surtout par éclats, est de beaucoup préférable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "496deb8b-c591-3487-8554-59be99ea8b04",
                                        "entry_id": "5af0631c-b9be-3c3b-9ecd-a12e4dffbf0d",
                                        "glosses": [
                                            "Son, bruit plus ou moins violent qui se fait entendre tout à coup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "831cad82-e41e-4164-875c-6dd85c034ad3",
                                                "sense_id": "496deb8b-c591-3487-8554-59be99ea8b04",
                                                "text": "[…] ; le soir, les cafés, bourrés de monde, restent ouverts bien avant dans la nuit, et les vitres du Cercle des Blancs, éclairées à des heures indues, s’ébranlent sous les éclats de la voix du Dieu."
                                            },
                                            {
                                                "example_id": "a5c25e60-6357-4e90-8cde-1f43a3e5dad9",
                                                "sense_id": "496deb8b-c591-3487-8554-59be99ea8b04",
                                                "text": "On se serait cru chez un grand seigneur d’autrefois, n’eussent été l’allure vulgaire et les éclats de voix canailles qui attestent chez notre amphitryon un muflisme inégalable."
                                            },
                                            {
                                                "example_id": "424627b0-f882-401a-8e89-0deb1e853b53",
                                                "sense_id": "496deb8b-c591-3487-8554-59be99ea8b04",
                                                "text": "Les éclats de la foudre, de tonnerre, de voix, de rires"
                                            },
                                            {
                                                "example_id": "72e4fd18-a003-4e6b-a4d6-d4a702d3a00b",
                                                "sense_id": "496deb8b-c591-3487-8554-59be99ea8b04",
                                                "text": "Rire aux éclats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9844f944-d89c-3eff-a91d-6bd219cb0bd4",
                                        "entry_id": "5af0631c-b9be-3c3b-9ecd-a12e4dffbf0d",
                                        "glosses": [
                                            "Bruit, rumeur, scandale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b2a41b0-e3aa-4f2c-8f0c-2c4cb7492137",
                                                "sense_id": "9844f944-d89c-3eff-a91d-6bd219cb0bd4",
                                                "text": "Cette affaire fait éclat, fait de l’éclat, grand éclat, beaucoup d’éclat."
                                            },
                                            {
                                                "example_id": "14d16d9b-e8de-4a23-bd79-fdad73fb43b2",
                                                "sense_id": "9844f944-d89c-3eff-a91d-6bd219cb0bd4",
                                                "text": "Cet homme est emporté, il est à craindre qu’il ne fasse quelque éclat mal à propos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a178f040-15b6-3b35-a403-76499880c8ac",
                                        "entry_id": "5af0631c-b9be-3c3b-9ecd-a12e4dffbf0d",
                                        "glosses": [
                                            "Mesure violente, parti extrême."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1abbc894-f046-4368-a6ae-883258cb0dbf",
                                                "sense_id": "a178f040-15b6-3b35-a403-76499880c8ac",
                                                "text": "En venir à un éclat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edce3490-7926-3246-93de-c98e4237ece4",
                                        "entry_id": "5af0631c-b9be-3c3b-9ecd-a12e4dffbf0d",
                                        "glosses": [
                                            "Lueur brillante, effet d’une vive lumière, et en général de ce qui produit sur la vue, par une apparence brillante, un effet analogue à celui de la lumière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a142639-5064-4476-8d7e-d92b33d167ad",
                                                "sense_id": "edce3490-7926-3246-93de-c98e4237ece4",
                                                "text": "Les élégantes composaient les rosés de leur teint à l’aide d’un vermillon habilement nuancé ; le kohl d’Egypte servait à faire ressortir l’éclat des yeux, […]"
                                            },
                                            {
                                                "example_id": "d31ef628-d79e-445d-9e0f-b9d7776b4f54",
                                                "sense_id": "edce3490-7926-3246-93de-c98e4237ece4",
                                                "text": "La laine est d'autant meilleure que les brins sont égaux […]. Enfin on recherche le lustre, l'éclat, puis le moelleux qui s'apprécie au toucher."
                                            },
                                            {
                                                "example_id": "9f8d34a2-1084-4ad8-82fb-8789b241d8bf",
                                                "sense_id": "edce3490-7926-3246-93de-c98e4237ece4",
                                                "text": "Par un entrebâillement de rideaux, un rayon de soleil planta dans la pièce sa lance d’or, et son éclat, […], sembla transformer la chambre du poêle du père Jourgeot."
                                            },
                                            {
                                                "example_id": "73b108c2-1ccf-4ab0-b43b-12081f4e9d19",
                                                "sense_id": "edce3490-7926-3246-93de-c98e4237ece4",
                                                "text": "Les crayons pour les lèvres sont destinés soit à empêcher celles-ci de gercer, soit à leur donner un éclat spécial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a8d7091-d5fb-362b-aef9-d28c30d7343c",
                                        "entry_id": "5af0631c-b9be-3c3b-9ecd-a12e4dffbf0d",
                                        "glosses": [
                                            "Effet de lumière, vif et variable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dca1cf32-10b1-4ad1-9b8a-050a498984bb",
                                                "sense_id": "7a8d7091-d5fb-362b-aef9-d28c30d7343c",
                                                "text": "Un éclat de lumière."
                                            },
                                            {
                                                "example_id": "ba64638f-a0a3-4208-ba0b-d3bcd1fac2d2",
                                                "sense_id": "7a8d7091-d5fb-362b-aef9-d28c30d7343c",
                                                "text": "On dirait, de plus, qu’il a des intermittences comme un phare à éclat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcca6a4a-4c8c-3458-8139-7efa296dae50",
                                        "entry_id": "5af0631c-b9be-3c3b-9ecd-a12e4dffbf0d",
                                        "glosses": [
                                            "Ce qui brille dans un style, une pensée, un bon mot."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b1c474a-1a1e-4ed5-a3b9-53d5fa615c37",
                                                "sense_id": "fcca6a4a-4c8c-3458-8139-7efa296dae50",
                                                "text": "Cette pensée a moins de solidité que d’éclat."
                                            },
                                            {
                                                "example_id": "5b18f05c-bcfa-47d4-b39e-bf94b206d34b",
                                                "sense_id": "fcca6a4a-4c8c-3458-8139-7efa296dae50",
                                                "text": "Le style de cet écrivain a de l’éclat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c69dbea-7304-3437-a79e-15e95802c771",
                                        "entry_id": "5af0631c-b9be-3c3b-9ecd-a12e4dffbf0d",
                                        "glosses": [
                                            "Gloire, illustration, splendeur, magnificence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd4938a1-6148-4d0e-89bc-11ae27f0ee1d",
                                                "sense_id": "1c69dbea-7304-3437-a79e-15e95802c771",
                                                "text": "Ses belles actions répandirent un grand éclat sur sa famille."
                                            },
                                            {
                                                "example_id": "6c16ef53-c349-4814-8ca0-57909c415783",
                                                "sense_id": "1c69dbea-7304-3437-a79e-15e95802c771",
                                                "text": "Être ébloui par l’éclat des grandeurs, des richesses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
