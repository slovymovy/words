                                        "entry_id": "dc573464-32e9-34a1-831c-23e291b4bb91",
                                        "glosses": [
                                            "In sports",
                                            "A punishment for an infraction of the rules, often in the form of being removed from play for a specified amount of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36c275c6-ca02-4465-ad91-4d1986942985",
                                                "sense_id": "7ff7a264-8188-3dc8-b7d4-d78675384522",
                                                "text": "A penalty was called when he tripped up his opponent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c46ce6b-3600-3fc5-8d86-884e2e0bf756",
                                        "entry_id": "dc573464-32e9-34a1-831c-23e291b4bb91",
                                        "glosses": [
                                            "A disadvantageous consequence of a previous event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8a9ec6d-02f3-4c0c-a783-6240921720ca",
                                                "sense_id": "2c46ce6b-3600-3fc5-8d86-884e2e0bf756",
                                                "text": "\"But you, my noble, my generous girl!\" exclaimed Lord Avonleigh, \"I dare not let you pay the penalty of my former folly.\""
                                            }
