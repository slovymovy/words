{
    "word_family": [
        "pilgrim"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19702e0a-5559-3e20-9f9d-41c1c0cbe2f5",
                    "sense_definition": "A journey made to a sacred place, or a religious journey.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "journey_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the Muslim faith, the <w>pilgrimage</w> to Mecca is known as the Hajj.",
                            "target_lang_translations": {
                                "ru": "В мусульманской вере <w>паломничество</w> в Мекку известно как хадж.",
                                "zh": "在伊斯兰信仰中，前往麦加的<w>朝圣</w>被称为“朝觐”。"
                            }
                        },
                        {
                            "text": "Thousands of believers make a <w>pilgrimage</w> to the holy shrine every spring.",
                            "target_lang_translations": {
                                "ru": "Тысячи верующих совершают <w>паломничество</w> к святыне каждой весной.",
                                "zh": "每年春天，成千上万的信徒都会前往圣地<w>朝圣</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go on a pilgrimage",
                        "make a pilgrimage",
                        "place of pilgrimage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествие к святому месту или религиозное странствие.",
                        "zh": "前往圣地或出于宗教目的的朝圣之旅。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паломничество",
                                "target_lang_sense_clarification": "путешествие верующих к святым местам"
                            },
                            {
                                "target_lang_word": "богомолье",
                                "target_lang_sense_clarification": "устаревшее; посещение монастырей или храмов для молитвы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "朝圣",
                                "target_lang_sense_clarification": "宗教性的朝拜圣地之行"
                            },
                            {
                                "target_lang_word": "朝圣之旅",
                                "target_lang_sense_clarification": "前往圣地参拜的旅行"
                            },
                            {
                                "target_lang_word": "朝觐",
                                "target_lang_sense_clarification": "尤指伊斯兰教前往麦加的朝圣"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9980d971-19b8-3e3f-8071-de4206fc3637",
                    "sense_definition": "A visit to any site revered or associated with a meaningful event.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "journey_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each year we made a <w>pilgrimage</w> to the city where we first met.",
                            "target_lang_translations": {
                                "ru": "Каждый год мы совершали <w>паломничество</w> в город, где мы впервые встретились.",
                                "zh": "每年我们都会前往初次相遇的城市<w>朝圣</w>。"
                            }
                        },
                        {
                            "text": "For many music fans, visiting the famous studio is a <w>pilgrimage</w>.",
                            "target_lang_translations": {
                                "ru": "Для многих музыкальных фанатов посещение знаменитой студии — это настоящее <w>паломничество</w>.",
                                "zh": "对许多乐迷来说，拜访这家著名的录音室就像是一场<w>朝圣</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "annual pilgrimage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Посещение места, почитаемого или связанного с важным событием.",
                        "zh": "前往令人敬仰或具有特殊意义之地的拜访或旅程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паломничество",
                                "target_lang_sense_clarification": "переносное значение; массовое или значимое посещение какого-либо места"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "朝圣",
                                "target_lang_sense_clarification": "比喻前往心中向往或崇敬的场所"
                            },
                            {
                                "target_lang_word": "朝拜",
                                "target_lang_sense_clarification": "怀着崇敬心情去拜访或游览"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "670e8a7d-5f88-358d-873d-0ddfc317a28a",
                    "sense_definition": "To go on a <w>pilgrimage</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>pilgrimaged</w> to the ancient mountains in search of spiritual peace.",
                            "target_lang_translations": {
                                "ru": "Он <w>совершил паломничество</w> к древним горам в поисках душевного покоя.",
                                "zh": "他前往古老的群山中<w>朝圣</w>，寻求心灵的平静。"
                            }
                        },
                        {
                            "text": "They <w>pilgrimaged</w> across the country to visit the historic battlefield.",
                            "target_lang_translations": {
                                "ru": "Они <w>совершили паломничество</w> через всю страну, чтобы посетить историческое поле битвы.",
                                "zh": "他们横跨整个国家去历史悠久的战场旧址<w>朝拜</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "journey",
                        "travel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершать паломничество.",
                        "zh": "进行朝圣；朝拜旅行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершать паломничество",
                                "target_lang_sense_clarification": "отправляться в путь к святым или значимым местам"
                            },
                            {
                                "target_lang_word": "странствовать",
                                "target_lang_sense_clarification": "путешествовать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "朝圣",
                                "target_lang_sense_clarification": "去圣地或向往之地朝拜"
                            },
                            {
                                "target_lang_word": "去朝圣",
                                "target_lang_sense_clarification": "动词短语，前往朝圣"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "784bb168-c3bd-3447-aaec-ef5a3cfdfa7f",
                    "sense_definition": "The 22nd sura (chapter) of the Qur'an.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "document_or_program_name",
                    "examples": [
                        {
                            "text": "The scholar recited verses from The <w>Pilgrimage</w> during the evening prayer.",
                            "target_lang_translations": {
                                "ru": "Ученый читал стихи из суры «<w>Паломничество</w>» во время вечерней молитвы.",
                                "zh": "学者在晚祷时诵读了《<w>朝觐章</w>》中的经文。"
                            }
                        },
                        {
                            "text": "She studied the themes of sacrifice found in The <w>Pilgrimage</w>.",
                            "target_lang_translations": {
                                "ru": "Она изучала темы жертвоприношения, встречающиеся в суре «<w>Паломничество</w>».",
                                "zh": "她研究了《<w>朝觐章</w>》中所蕴含的牺牲主题。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "22-я сура Корана.",
                        "zh": "《古兰经》第22章（苏拉）的名称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Паломничество",
                                "target_lang_sense_clarification": "название суры"
                            },
                            {
                                "target_lang_word": "Аль-Хадж",
                                "target_lang_sense_clarification": "арабское название суры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "朝觐章",
                                "target_lang_sense_clarification": "《古兰经》第22章的标准中文译名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}