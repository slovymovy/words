                                "target_lang_sense_clarification": "supreme blessedness"
                            },
                            {
                                "target_lang_word": "blessedness",
                                "target_lang_sense_clarification": "religious joy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0596afb7-bc92-320d-8a4d-d79e391a5fce",
                    "sense_definition": "iets concreets of een specifieke ervaring waar men zeer gelukkig van wordt",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bron van geluk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het proeven van dit exclusieve dessert was een ware <w>gelukzaligheid</w> voor de fijnproever.",
                            "target_lang_translations": {
                                "en": "Tasting this exclusive dessert was a true <w>delight</w> for the gourmet."
                            }
                        },
                        {
                            "text": "Zij genoten van alle kleine <w>gelukzaligheden</w> die het leven op het platteland hen te bieden had.",
                            "target_lang_translations": {
                                "en": "They enjoyed all the little <w>joys</w> that life in the countryside had to offer them."
                            }
                        }
                    ],
                    "synonyms": [
                        "bof"
                    ],
                    "common_phrases": [
                        "ware gelukzaligheid"
                    ],
                    "target_lang_definitions": {
