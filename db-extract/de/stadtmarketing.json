                "senses": [
                    {
                        "sense_id": "5d1832c1-6217-30b5-ad8f-c36d0e242bc6",
                        "entry_id": "9ceb949d-057b-3d05-84e6-3f7f7c471ea9",
                        "glosses": [
                            "sämtliche Maßnahmen zur Förderung eines positiven Images einer Stadt oder Gemeinde, wie etwa im Bereich Kultur oder Freizeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7d192b4-b7d3-47c4-abbd-649c51fa93b1",
                                "sense_id": "5d1832c1-6217-30b5-ad8f-c36d0e242bc6",
                                "text": "„Dies ist auch erforderlich, da die Grundlage des Stadtmarketing dadurch gebildet wird, dass die Standortentwicklung vor dem Hintergrund des städtischen Leitbilds im Hinblick auf die zukünftige Entwicklung der Stadt das Fundament bildet.“"
                            },
                            {
                                "example_id": "97c427b4-5ed4-4176-8b32-4350523f27c1",
                                "sense_id": "5d1832c1-6217-30b5-ad8f-c36d0e242bc6",
                                "text": "„Jedoch stellt sich die Frage, wie Stadtmarketing im Sinne einer ‚Positionierung im Wettbewerb der Kommunen‘ sinnvoll durchgeführt werden kann.“"
                            },
                            {
                                "example_id": "0745764e-7fc6-4a7d-9acf-5849526bda6e",
                                "sense_id": "5d1832c1-6217-30b5-ad8f-c36d0e242bc6",
                                "text": "„Die kommunale Gesellschaft für Stadtentwicklung und Stadtmarketing hatte die stromlose Schlittschuhbahn schon im vergangenen Jahr gekauft, als drohender Energiemangel und hohe Strompreise noch kein Thema waren.“"
                            },
                            {
                                "example_id": "ebfd5d31-879e-4c09-bfac-7258a4c314ff",
                                "sense_id": "5d1832c1-6217-30b5-ad8f-c36d0e242bc6",
                                "text": "„Der demografische Wandel als zeitlich weitreichendste Herausforderung unserer Gesellschaft stellt hierbei ganz neue Anforderungen an ein erfolgreiches Stadtmarketing.“"
                            },
                            {
                                "example_id": "29114a32-27d8-45ef-9348-6fd9564052ec",
                                "sense_id": "5d1832c1-6217-30b5-ad8f-c36d0e242bc6",
                                "text": "„Um diese Zielvorgaben zu verwirklichen, wird das Stadtmarketing als Instrument erachtet, mit dem Managementmodelle aus der Wirtschaft für lokale Behörden anwendbar gemacht werden.“"
                            },
                            {
                                "example_id": "b6c9c7cd-5c93-49e3-be7a-15207a3a9391",
                                "sense_id": "5d1832c1-6217-30b5-ad8f-c36d0e242bc6",
                                "text": "„MarketingConsult schlägt der Stadtverwaltung eine Zukunftskonferenz zur Auffrischung des Stadtmarketing vor.“"
                            },
                            {
                                "example_id": "8ba1a01f-2d70-4a5a-b7a2-4cf0dec9e84d",
                                "sense_id": "5d1832c1-6217-30b5-ad8f-c36d0e242bc6",
                                "text": "„Diese Ausarbeitung setzt sich kritisch mit dem Thema Kultur als Wirtschafts- und Standortfaktor sowie mit Stadtmarketing auseinander.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
