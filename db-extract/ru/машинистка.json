                "senses": [
                    {
                        "sense_id": "b4ffb824-7970-3208-b8aa-e5694f5ff207",
                        "entry_id": "03db347d-86f9-37cb-9bfe-6ff006b3d7a9",
                        "glosses": [
                            "female typist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "481559bc-3123-4eff-89c2-39830ac353b6",
                                "sense_id": "b4ffb824-7970-3208-b8aa-e5694f5ff207",
                                "text": "— Я с ней распи́сываюсь, э́то — на́ша машини́стка, жить со мной бу́дет. Бормента́ля на́до бу́дет вы́селить из приёмной. У него́ своя́ кварти́ра есть, — кра́йне неприя́зненно и хму́ро поясни́л Ша́риков.",
                                "translation": "\"We are going to get married, this is our typist, she's going to live with me. We'll have to put Bormental out of the reception room. He's got a flat of his own,\" explained Sharikov, frowning and with intense hostility.",
                                "english": "\"We are going to get married, this is our typist, she's going to live with me. We'll have to put Bormental out of the reception room. He's got a flat of his own,\" explained Sharikov, frowning and with intense hostility."
                            }
                        ]
                    }
