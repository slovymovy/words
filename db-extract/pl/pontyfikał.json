                                    },
                                    {
                                        "sense_id": "2d7e1ce9-8223-30e2-8013-ec56cb4667b7",
                                        "entry_id": "2f5647d7-648e-34ba-8881-80125f10cbec",
                                        "glosses": [
                                            "Pompous, dignified or dogmatic."
                                        ],
