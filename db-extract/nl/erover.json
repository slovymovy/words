        "nl-extract.jsonl": [
            {
                "entry_id": "6d30ac98-e765-3060-88b5-a9be1c983a2f",
                "word": "erover",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a0043491-0a28-31a3-8bfb-27411ddd4d1b",
                        "entry_id": "6d30ac98-e765-3060-88b5-a9be1c983a2f",
                        "glosses": [
                            "boven dit (heen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8002a63-922c-4ba9-947c-d15915e93cb5",
                                "sense_id": "a0043491-0a28-31a3-8bfb-27411ddd4d1b",
                                "text": "Toen ze bij het hek kwam is zij erover geklommen."
                            },
                            {
                                "example_id": "b60a087b-5656-464d-9695-6b193d3c4a6b",
                                "sense_id": "a0043491-0a28-31a3-8bfb-27411ddd4d1b",
                                "text": "Het dorp is in gevaar nu er steeds meer water over de dijk stroomt."
                            }
                        ]
                    },
                    {
                        "sense_id": "e56087df-4316-367a-a8bb-3e32d2c4dfd2",
                        "entry_id": "6d30ac98-e765-3060-88b5-a9be1c983a2f",
                        "glosses": [
                            "aangaande dit onderwerp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ed49f56-1de2-4d94-b3fd-ef6b43e663a7",
                                "sense_id": "e56087df-4316-367a-a8bb-3e32d2c4dfd2",
                                "text": "Hij schrijft erover in zijn boek."
                            },
                            {
                                "example_id": "e38c83ca-d6f6-4019-ab43-ff3b27928c76",
                                "sense_id": "e56087df-4316-367a-a8bb-3e32d2c4dfd2",
                                "text": "Hij schrijft er in zijn boek een heel hoofdstuk over."
                            },
                            {
                                "example_id": "2a4b54c6-e149-4929-b1c1-d743d3564c32",
                                "sense_id": "e56087df-4316-367a-a8bb-3e32d2c4dfd2",
                                "text": "Ik verbaasde me erover hoe een aantal jonge hikers buiten met de naderende storm omgingen. Ze maakten uitgebreid filmpjes en juichten bij elke donderslag terwijl ik juist dieper in mijn slaapzak kroop. Ik voelde me klein en uiterst kwetsbaar."
                            }
                        ]
                    }
