                    {
                        "sense_id": "fa03449f-d238-36f6-b69f-aa36ee25d970",
                        "entry_id": "1fbb282d-b846-3f30-a0da-d10cac2eff10",
                        "glosses": [
                            "Beau, élégant."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "c5dd895f-d51a-43d5-9803-310b025b0b0c",
                                "sense_id": "fa03449f-d238-36f6-b69f-aa36ee25d970",
                                "text": "Elle était pulchre\nEt formose, mais nègre ô chatte du Sépulcre,\nÔ chatte de minuit, ô chatte de Sabbat,\nTu meurs ! quel deuil, sorcière, à ton pâle grabat !"
                            }
                        ]
