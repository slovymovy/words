                "senses": [
                    {
                        "sense_id": "5d6016e7-2aac-36b1-a7a4-8dd783e7a690",
                        "entry_id": "a28b2be3-39d7-38a9-822c-7c0d0f68e02a",
                        "glosses": [
                            "Tabler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ceb5968-9065-4a0c-b432-34dae1376881",
                                "sense_id": "5d6016e7-2aac-36b1-a7a4-8dd783e7a690",
                                "text": "Le mieux si on arrive pas à \"compter\", c'est de retabler sur GP ou Tux pour l'entendre.... zick."
                            }
                        ]
                    },
                    {
                        "sense_id": "f963ab1a-1030-3562-93da-a3170000267e",
                        "entry_id": "a28b2be3-39d7-38a9-822c-7c0d0f68e02a",
                        "glosses": [
                            "Remettre la table d’un instrument de musique."
                        ],
                        "tags": [
                            "Lutherie"
                        ],
                        "examples": [
                            {
                                "example_id": "a5089f91-fef7-447c-ab60-21166161d398",
                                "sense_id": "f963ab1a-1030-3562-93da-a3170000267e",
                                "text": "Il faut détabler réparer et retabler le violon, cela peut aller de 200 à 500 Euro suivant la gravité."
                            },
                            {
                                "example_id": "ff2f202f-f6fc-47dc-b505-a0e3ca2a9640",
                                "sense_id": "f963ab1a-1030-3562-93da-a3170000267e",
                                "text": "Elisabeth, peut-être puis-je faire \"retabler\" mon luth en effet"
                            }
                        ]
                    },
                    {
                        "sense_id": "8a8420d7-7a80-3fd3-8868-8b36413a8011",
                        "entry_id": "a28b2be3-39d7-38a9-822c-7c0d0f68e02a",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81951a13-464a-488c-a8bd-3367127ff66f",
                                "sense_id": "8a8420d7-7a80-3fd3-8868-8b36413a8011",
                                "text": "Je suis pas sûr que ça va la retabler, ça risque même de la détériorer encore plus. — (en parlant d’une anche)"
                            }
                        ]
                    }
