                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33756c6b-cefe-4486-83a4-976690bdde8b",
                        "source_entry_id": "ede93c7b-0280-3f85-bbd2-f2cec0ada4fb",
                        "source_sense_id": "23bafa2a-7996-383a-9608-a6c426001380",
                        "target_lang_word": "рябинник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "рябинник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aae4833d-cb45-3b59-8060-801190c1da60",
                                        "entry_id": "b93f486e-ad45-31d3-8488-4b214ed0519b",
                                        "glosses": [
                                            "рябиновый лес, рябиновая роща, заросли рябины"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c7a18d3-efc2-477d-904c-f3f653d0d973",
                                                "sense_id": "aae4833d-cb45-3b59-8060-801190c1da60",
                                                "text": "Идёшь сентябрем по просеке, где прежде проходила телефонная линия на лесоучасток, по обе её стороны рядами алеют кустарники, и ярче всех горит рябинник, идёшь, будто по улице во время праздничной демонстрации, обочь тебя и впереди ― всё красно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b573113c-6938-372b-99e4-e5bd166f2324",
                                        "entry_id": "b93f486e-ad45-31d3-8488-4b214ed0519b",
                                        "glosses": [
                                            "ботан. листопадный кустарник семейства розоцветных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81d19da0-2f75-41f4-84d8-b87e55e9850b",
                                                "sense_id": "b573113c-6938-372b-99e4-e5bd166f2324",
                                                "text": "Декоративен, благодаря листьям, похожим на листья рябины, и обильному длительному цветению, рябинник рябинолистный (Sorbaria sorbifolia)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "рябинник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b7e50f65-7fe2-369f-b254-f456d0d89768",
                                        "entry_id": "f5a08f23-7ef1-3d90-975c-02f33bfa4906",
                                        "glosses": [
                                            "зоол. птица рода дроздов (Turdus pilaris)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aecad13b-364d-415f-b882-beadadbf5578",
                                                "sense_id": "b7e50f65-7fe2-369f-b254-f456d0d89768",
                                                "text": "Большой дрозд рябинник, несколько поменьше серого дрозда; он очень любит клевать рябину, почему и назван рябинником; пестрины на нём довольно крупны; они лежат в виде продолговатых тёмно-коричневых пятен по серо-желтоватому полю; спина и верхние пёрышки на крыльях коричневые с тёмно-сизыми оттенками; глаза и клюв тёмного, почти чёрного цвета."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79530ccf-3eef-4861-a72c-0918f122e210",
