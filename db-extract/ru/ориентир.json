                                "target_senses": [
                                    {
                                        "sense_id": "844a2789-30f0-3ef4-9f8c-bb486bc16a21",
                                        "entry_id": "2bb72a07-6145-373c-8f09-2529f3be4387",
                                        "glosses": [
                                            "An object that marks the boundary of a piece of land (usually a stone, or a tree)."
