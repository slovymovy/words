                        "glosses": [
                            "S’accepter soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "59aaa444-eb60-4c73-92ba-93b666fe4bd3",
                                "sense_id": "a5a2ddc8-f188-31ce-bb2e-56d4d47fd1fa",
                                "text": "Ainsi ce n'est pas dans la subjectivité opérante du Cogito que la femme se pense elle-même ; elle est pensée en tant que non-pensante et donc elle est condamnée en tant qu'altérité opaque, dans la mesure où elle autoaccepte en elle l'homoféminisation"
                            }
                        ]
                    },
                    {
                        "sense_id": "13d4f1f3-6354-3dcd-86bc-51c80f898699",
                        "entry_id": "d2a518dc-4c41-3be9-b67c-8b88da739549",
                        "glosses": [
