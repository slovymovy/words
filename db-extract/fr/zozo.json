                "senses": [
                    {
                        "sense_id": "bf8416a0-f2e0-3249-b5e9-10b69d3d1e0b",
                        "entry_id": "de582127-2de8-3aab-9ba5-d192f7c898a3",
                        "glosses": [
                            "Bête ; niais."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "e919646a-eff7-4611-8ea5-1f5072c64b4b",
                                "sense_id": "bf8416a0-f2e0-3249-b5e9-10b69d3d1e0b",
                                "text": "Je repasse dans ma tête le petit compliment un peu zozo, œuvre d’Antonin Rabastens, que je réciterai tout à l’heure."
                            },
                            {
                                "example_id": "024f78c0-9605-4d80-8a67-e41aa723f9e2",
                                "sense_id": "bf8416a0-f2e0-3249-b5e9-10b69d3d1e0b",
                                "text": "— Si j’ai vu la momie ? Complètement zozo, notre curé ! fit-elle en se touchant deux fois la tempe avec l’index."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8710bfd4-af1c-3021-ad06-f0af20d09fcc",
                "word": "Zozo",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "137e2758-e862-31d4-95a3-8c3016736bb6",
                        "entry_id": "8710bfd4-af1c-3021-ad06-f0af20d09fcc",
                        "glosses": [
                            "Zozo est un nom de famille originaire de la Côte d’Ivoire, principalement dans les pays bétés (ouest) référence nécessaire (résoudre le problème)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
