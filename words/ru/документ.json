                        "сохранить документ",
                        "текстовый документ",
                        "создать документ"
                    ],
                    "target_lang_definitions": {
                        "en": "A file containing text or data created in a computer program.",
                        "fr": "Fichier contenant du texte ou des données, créé dans un logiciel informatique."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "document",
                                "target_lang_sense_clarification": "a digital file containing text"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "document",
                                "target_lang_sense_clarification": "fichier informatique, traitement de texte"
                            },
                            {
                                "target_lang_word": "fichier",
                                "target_lang_sense_clarification": "fichier contenant des données"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b814f7f-709c-3ef3-9dac-9903853a7e13",
                    "sense_definition": "Деловая бумага, имеющая юридическую силу и подтверждающая какой-либо факт или право.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "official_papers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Директор подписал важный финансовый <w>документ</w>.",
                            "target_lang_translations": {
                                "en": "The director signed an important financial <w>document</w>.",
                                "fr": "Le directeur a signé un important <w>document</w> financier."
                            }
                        },
                        {
                            "text": "В архиве хранятся старые исторические <w>документы</w>.",
                            "target_lang_translations": {
                                "en": "Old historical <w>documents</w> are kept in the archive.",
                                "fr": "De vieux <w>documents</w> historiques sont conservés dans les archives."
                            }
                        }
                    ],
                    "common_phrases": [
                        "подписать документ",
                        "официальный документ",
                        "пакет документов",
                        "копия документа"
                    ],
                    "target_lang_definitions": {
                        "en": "An official paper with legal force that confirms a fact or right.",
                        "fr": "Écrit officiel ou juridique qui atteste un fait, un acte ou un droit."
                    },
