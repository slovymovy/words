                ],
                "senses": [
                    {
                        "sense_id": "6c70b929-ec1c-330b-aa03-0fafba3bf513",
                        "entry_id": "92169aa3-ec21-37bc-8c56-e4b8616735f9",
                        "glosses": [
                            "Kapelle, die sich innerhalb einer Schlossanlage befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "139283ba-7fb8-4ef6-b26e-7f4b5b93d094",
                                "sense_id": "6c70b929-ec1c-330b-aa03-0fafba3bf513",
                                "text": "In der Schlosskapelle fanden alle Gottesdienste für den Schlossherrn und die Schlossbewohner statt."
                            },
                            {
                                "example_id": "b287032b-419f-4d80-8d60-267e685ba53f",
                                "sense_id": "6c70b929-ec1c-330b-aa03-0fafba3bf513",
                                "text": "„Die Schlosskapelle ist fertig, deren Schlingrippengewölbe eine meisterhafte Rekonstruktion historischer Baukunst ist.“"
                            },
                            {
                                "example_id": "91dff837-23da-432a-84cb-c468e4f4a72e",
                                "sense_id": "6c70b929-ec1c-330b-aa03-0fafba3bf513",
                                "text": "„Die barocke Schlosskapelle mit ihren einzigartigen Deckenfresken, dem geschnitzten Altar und der Orgel von 1847 bildet einen festlichen Rahmen für Ihre kirchliche Trauung.“"
                            },
                            {
                                "example_id": "3c9f75c1-c9e2-4b60-8c93-c54e0d1c877a",
                                "sense_id": "6c70b929-ec1c-330b-aa03-0fafba3bf513",
                                "text": "„Der entspricht allenfalls die von Luther 1544 eingeweihte Schlosskapelle, die als erster im evangelischen Glauben errichteter Kirchenbau angesehen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
