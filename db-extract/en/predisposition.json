                        "entry_id": "8c6cdac6-5207-3de4-b57c-219f18f01227",
                        "glosses": [
                            "The state of being predisposed or susceptible to something, especially to a behavior or a health condition."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a73d9da8-d860-45cf-b8ed-433bc41d693e",
                        "source_entry_id": "8c6cdac6-5207-3de4-b57c-219f18f01227",
                        "source_sense_id": "25de31f4-641b-31ed-bcc6-1274318676f9",
                        "source_sense_description": "the state of being predisposed",
                        "target_lang_word": "predispozice",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
