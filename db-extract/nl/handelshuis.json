                        "examples": [
                            {
                                "example_id": "2cfd4256-a82a-4477-ba2f-572a583a1352",
                                "sense_id": "67e1b0a4-7724-3161-b27b-514ccffcd281",
                                "text": "Sinds het verschijnen van het prospectus afgelopen week zijn de negatieve verwachtingen een beetje bijgesteld. Zo belooft Uniper de aandeelhouders een dividend van 55 cent per aandeel. Bovendien heeft Uniper naast de vervuilende gas- en kolencentrales ook nog waterkrachtcentrales in Duitsland en Scandinavië, een handelshuis, en belangen in gasvelden en pijpleidingen in Rusland."
                            },
                            {
                                "example_id": "2bb38c7f-a860-401a-a9bb-5197871dbaa9",
                                "sense_id": "67e1b0a4-7724-3161-b27b-514ccffcd281",
                                "text": "Andere namen zijn die van Mexx-oprichter Rattan Chadha, miljardair en oprichter van Volmac Joop van Oosterom, Bernard Stuivinga van handelshuis Acomo en Toine Manders (niet de lijsttrekker van 50Plus), tot vorig jaar mei voorzitter van de Libertarische Partij."
                            }
                        ]
                    }
