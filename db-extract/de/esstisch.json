                        ],
                        "form": "den Esstisch"
                    },
                    {
                        "form_id": "fad7eb13-be73-4230-a3bb-db6e414c0e2e",
                        "entry_id": "728ddc9a-1066-3d87-bd76-750c3cb222df",
                        "tags": [
                            "accusative",
