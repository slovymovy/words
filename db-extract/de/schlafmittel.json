                ],
                "senses": [
                    {
                        "sense_id": "30915847-88ca-3191-aa17-9e5dc4606933",
                        "entry_id": "a9d434c0-16d0-3436-9163-87b7b51eb1e8",
                        "glosses": [
                            "Mittel, das den Schlaf ermöglicht oder verbessert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd478ffd-64df-44e7-aea2-283e2a159d4e",
                                "sense_id": "30915847-88ca-3191-aa17-9e5dc4606933",
                                "text": "„Doll war erst mitten in der Schlafmittelentwöhnung und noch nicht ganz taktfest in der Stimmung, und der Verdacht würde bei den Ärzten bestehen, dass er sich beim freien Ausgang in die Stadt zusätzliche Schlafmittel oder gar Narkotika besorgen würde.“"
                            },
                            {
                                "example_id": "0123a75b-d2f9-4dd2-be60-76afd11193e8",
                                "sense_id": "30915847-88ca-3191-aa17-9e5dc4606933",
                                "text": "„Auch er nimmt ein Schlafmittel.“"
                            },
                            {
                                "example_id": "ee057ab9-3d25-4e82-a22a-77dc9736cead",
                                "sense_id": "30915847-88ca-3191-aa17-9e5dc4606933",
                                "text": "„Dann waren die Männer schon bei der Arbeit, und die Wirkung des Schlafmittels nahm langsam ab.“"
                            },
                            {
                                "example_id": "b9c1c74c-4aa0-4986-b21c-e6624344a5a6",
                                "sense_id": "30915847-88ca-3191-aa17-9e5dc4606933",
                                "text": "„Morphin wurde bald als Schlafmittel verwendet, von den 1870er Jahren an auch als Sedativum bei erregten Kranken in psychiatrischen Anstalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06e28cf4-ab82-4681-bb64-4cef2592e793",
                        "source_entry_id": "a9d434c0-16d0-3436-9163-87b7b51eb1e8",
                        "source_sense_id": "30915847-88ca-3191-aa17-9e5dc4606933",
                        "source_sense_description": "Mittel, das den Schlaf ermöglicht oder verbessert",
                        "target_lang_word": "sleeping pill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sleeping pill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46698a8d-c591-3125-832f-d67b1408ed7a",
                                        "entry_id": "bd399f49-9812-3d99-ac54-695134c56134",
                                        "glosses": [
                                            "A pill or tablet having a soporific effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d49ae6db-c819-4a10-b83b-da5ac6544944",
                                                "sense_id": "46698a8d-c591-3125-832f-d67b1408ed7a",
                                                "text": "You are my favorite sleeping pill\nThe secret bending of my waking will.\nYou bring me peace, you bring me rest.\nYour gentle presence leaves me blest."
                                            },
                                            {
                                                "example_id": "4da73895-2094-42f4-bee5-e453866c1d8f",
                                                "sense_id": "46698a8d-c591-3125-832f-d67b1408ed7a",
                                                "text": "It was a little past ten that night when his nurse, Sylvia of the Bedpans, came tiptoeing in with sleeping pills on a little tray and told him that his friend, Detective Leary, had just been delivered to the emergency room in a meat wagon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
