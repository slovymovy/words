                    {
                        "form_id": "baeae396-b5da-4e78-bf74-70d653dd5661",
                        "entry_id": "297c7b6d-1265-3215-b4c2-097c604f9e56",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Quantensprünge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61ff19aa-a988-3cae-b03d-f4095268509f",
                        "entry_id": "297c7b6d-1265-3215-b4c2-097c604f9e56",
                        "glosses": [
                            "in der Teilchenphysik ein plötzlicher Übergang ohne Zeitverlauf von einem Quantenzustand in einen anderen"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "57c0791a-2b40-45b8-8134-36f2c0d1b751",
                                "sense_id": "61ff19aa-a988-3cae-b03d-f4095268509f",
                                "text": "In atomaren Systemen sind Quantensprünge etwas vollkommen Normales."
                            },
                            {
                                "example_id": "09c71715-d102-4801-91a2-b0588f687160",
                                "sense_id": "61ff19aa-a988-3cae-b03d-f4095268509f",
                                "text": "„Immer wieder werden Probleme, die nicht so ohne Weiteres widerspruchsfrei zu machen sind, als analog zur Quantenmechanik eingestuft und Begriffe wie ‚Komplementarität‘ oder ‚Dualismus‘ sind neben dem (oft leider fälschlich verwendeten) ‚Quantensprung‘ in die Alltagssprache aufgenommen worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "92096e17-246b-32f2-8dec-b351fffea748",
                        "entry_id": "297c7b6d-1265-3215-b4c2-097c604f9e56",
                        "glosses": [
                            "großer Fortschritt, grundlegende Veränderung"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "8af5c57d-1ef9-4b9c-85fe-635c375179a9",
                                "sense_id": "92096e17-246b-32f2-8dec-b351fffea748",
                                "text": "„Immer wieder werden Probleme, die nicht so ohne Weiteres widerspruchsfrei zu machen sind, als analog zur Quantenmechanik eingestuft und Begriffe wie ‚Komplementarität‘ oder ‚Dualismus‘ sind neben dem (oft leider fälschlich verwendeten) ‚Quantensprung‘ in die Alltagssprache aufgenommen worden.“"
                            },
                            {
                                "example_id": "60b02e52-ab03-4eb7-b63d-cd334238a013",
                                "sense_id": "92096e17-246b-32f2-8dec-b351fffea748",
                                "text": "Die Entwicklung des Ottomotors war ein Quantensprung in der Geschichte des Individualverkehrs."
                            },
                            {
                                "example_id": "aea17c6c-17c7-482a-8854-026c37f9b8aa",
                                "sense_id": "92096e17-246b-32f2-8dec-b351fffea748",
                                "text": "„Wenn Politiker fälschlich von einem ‚Quantensprung‘ sprechen, haben sie meist dieses Bild vor Augen: Vorher hatten wir nur mit einzelnen Groschen gehandelt, jetzt aber nehmen wir einen Schilling in die Hand.“"
                            },
                            {
                                "example_id": "e24821ab-83b3-4cde-b2e7-01664e2da6dc",
                                "sense_id": "92096e17-246b-32f2-8dec-b351fffea748",
                                "text": "„Doch wie kam es nun zu der falschen Verwendung des Begriffs Quantensprung?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "513630c2-ad74-47d5-b364-e24bbad73086",
                        "source_entry_id": "297c7b6d-1265-3215-b4c2-097c604f9e56",
                        "source_sense_id": "61ff19aa-a988-3cae-b03d-f4095268509f",
                        "target_lang_word": "quantum jump",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quantum jump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f1a4aa8-053f-3dac-ba9f-961e692bd76e",
                                        "entry_id": "27c15b4d-4434-30bd-81c7-b770e208024f",
                                        "glosses": [
                                            "Synonym of quantum leap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "889f9ce7-3b10-47df-8fd7-5cf7bdbfb65e",
                                                "sense_id": "1f1a4aa8-053f-3dac-ba9f-961e692bd76e",
                                                "text": "In Italy on a long summer leave, William [T.] Golden had a different response: […] But one thing I wrote him was, \"We, the USA, should intensify our efforts toward development of superweapons. […] A quantum jump in intensity is called for as a matter of urgency comparable in every way to the wartime Manhattan Project.\" […] [Lewis L.] Strauss liked the phrase \"quantum jump\" and the idea of a new Manhattan Project. He began to compose a memorandum. […] Instead, echoing Golden, Strauss proposed [on October 5, 1949]: It seems to me that the time has now come for a quantum jump in our planning (to borow a metaphor from our scientist friends)—that is to say, that we should now make an intensive effort to get ahead with the super [a.k.a. the H-bomb]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quantum jump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "565bcf4a-1802-3a22-a03f-2d736b401818",
                                        "entry_id": "b03fc25e-8522-3b39-a748-55a06fad3ac7",
                                        "glosses": [
                                            "Synonym of quantum leap."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6ddbcfe-1b3d-4d6a-8c2d-a2751237abb6",
                        "source_entry_id": "297c7b6d-1265-3215-b4c2-097c604f9e56",
                        "source_sense_id": "61ff19aa-a988-3cae-b03d-f4095268509f",
                        "target_lang_word": "quantum leap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quantum leap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c29d28b-a49b-3e76-9cb2-c60cea4f1a5f",
                                        "entry_id": "165e84f4-bcbf-355c-a44e-817131195daf",
                                        "glosses": [
                                            "The discontinuous change of the state of an electron in an atom or molecule from one energy level to another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19d160d7-1af3-3082-9706-33ebc5bf65f7",
                                        "entry_id": "165e84f4-bcbf-355c-a44e-817131195daf",
                                        "glosses": [
                                            "An abrupt, extreme change."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15062617-691f-464f-8bdc-c35856aefc0c",
                                                "sense_id": "19d160d7-1af3-3082-9706-33ebc5bf65f7",
                                                "text": "In the end, perhaps the practice of prayer effects a quantum leap of its own kind. It takes us, spontaneously and unexplainably, into the realm of spiritual energy."
                                            },
                                            {
                                                "example_id": "e6e696e0-c277-4988-9d12-6677092c840f",
                                                "sense_id": "19d160d7-1af3-3082-9706-33ebc5bf65f7",
                                                "text": "The beacon was a Prothean artifact unearthed on the Alliance colony of Eden Prime. Its resemblance to the Prothean data banks recovered on Mars provoked immediate interest from the Alliance and the Citadel Council. It proved to be a solid state data storage device, part of a galaxy-spanning comm network similar to the modern extranet. Intact Prothean 'paleo-technology' is rare; the beacon seemed to promise another quantum leap of technology, akin to the discovery of the mass effect drive and relays."
                                            },
                                            {
                                                "example_id": "f0c3b82b-558b-4d60-ae4c-959ec34412ff",
                                                "sense_id": "19d160d7-1af3-3082-9706-33ebc5bf65f7",
                                                "text": "However, if we reject any theory that falls short of this ideal, science will have to progress in quantum leaps, each with infinitesimal probability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33fc6488-7c76-39ce-bdb4-7f7436c52eca",
                                        "entry_id": "165e84f4-bcbf-355c-a44e-817131195daf",
                                        "glosses": [
                                            "A large, massive, significant change."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14da2426-2f29-4a17-826a-4a6120d1ff22",
                                                "sense_id": "33fc6488-7c76-39ce-bdb4-7f7436c52eca",
                                                "text": "I was at the elections in Namibia. We had problems there, … But I would say that this is a quantum leap forward when you think of the Mengistu government and the horrible repression, the famine, the tyranny that existed under him, and you see this movement toward freedom and democracy over there. Although there, admittedly, have been problems, this is a giant step in the right direction."
                                            },
                                            {
                                                "example_id": "90014b80-a850-4bea-9e7c-63d7414b3f03",
                                                "sense_id": "33fc6488-7c76-39ce-bdb4-7f7436c52eca",
                                                "text": "A GIANT LEAP FORWARD\nHumanity is about to face a quantum leap forward. […]"
                                            },
                                            {
                                                "example_id": "6471b87b-e33e-4e7a-809c-07d76815034c",
                                                "sense_id": "33fc6488-7c76-39ce-bdb4-7f7436c52eca",
                                                "text": "The addition of power from God through connectedness with the Holy Spirit results in a quantum leap in our ability to accomplish the will of God in our daily lives."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quantum leap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75b36df4-f133-3ce6-97cb-238d1d9aa6a5",
                                        "entry_id": "23f318e5-d8c3-31f7-a975-8b16c1c3469b",
                                        "glosses": [
                                            "To manifest, to forward the reality of."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94a60154-d3eb-4283-b019-856ee92d3248",
                        "source_entry_id": "297c7b6d-1265-3215-b4c2-097c604f9e56",
                        "source_sense_id": "61ff19aa-a988-3cae-b03d-f4095268509f",
                        "target_lang_word": "saut quantique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saut quantique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81968f36-0b5d-3497-acac-c3a89346ad3f",
                                        "entry_id": "fb01ac77-7389-3e04-9532-de850b011f7e",
                                        "glosses": [
                                            "Changement brusque de l’état d’un système quantique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a05b6155-75fb-4570-8383-89651b2f47a3",
                                                "sense_id": "81968f36-0b5d-3497-acac-c3a89346ad3f",
                                                "text": "L’équipe américaine est arrivée à cette nouvelle étrangeté en voulant étaler au grand jour l’un des plus anciens mystères de cette théorie, le saut quantique. Cette propriété désigne le fait que, pour les particules, le monde n’est pas continu, mais discontinu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
