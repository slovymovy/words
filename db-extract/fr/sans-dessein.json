                "entry_id": "6c192984-c138-3bf9-bf01-1385cc13f31c",
                "word": "sans-dessein",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5ab58884-e9dc-36f7-95e0-635ae0138c4d",
                        "entry_id": "6c192984-c138-3bf9-bf01-1385cc13f31c",
                        "glosses": [
                            "Personne qui n’est pas intelligente ou qui est maladroite, qui ne peut littéralement rien planifier."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "2c3cefc7-93e7-468e-9a86-f14dc446253f",
                                "sense_id": "5ab58884-e9dc-36f7-95e0-635ae0138c4d",
                                "text": "C’est rien qu’un délire de cabochon qui prétend voir la vérité de demain mais qui est juste bon à tourner la tête à un sans-dessein élevé par des frères !"
                            },
                            {
                                "example_id": "91b5f310-527e-440e-814a-a68ce0cdbf6a",
                                "sense_id": "5ab58884-e9dc-36f7-95e0-635ae0138c4d",
                                "text": "Un détraqué comme les autres, un épivardé, un sans-dessein, un drogué, un courailleux, un qui se pend comme ta tante Rosalie ?"
                            },
                            {
                                "example_id": "cecbd5ef-d74a-414b-a308-c16f8c7a7785",
                                "sense_id": "5ab58884-e9dc-36f7-95e0-635ae0138c4d",
                                "text": "Mon vieux, je pense qu’avec des hommes comme toi, le monde est condamné à stagner. Tu es un sans-dessein. Voilà ce que tu es, Manolito."
                            },
                            {
                                "example_id": "452151cb-8b7b-4e84-93eb-6a2cd6cadcdc",
                                "sense_id": "5ab58884-e9dc-36f7-95e0-635ae0138c4d",
                                "text": "Quel sans-dessein a mis la calotte de mon château à l’envers ?"
                            },
                            {
                                "example_id": "ec1d7221-778c-4a84-bc1a-6d4b470713ab",
                                "sense_id": "5ab58884-e9dc-36f7-95e0-635ae0138c4d",
                                "text": "On va passer pour des ignorants ! On va passer pour des sans-dessein !"
                            },
                            {
                                "example_id": "33fc52f6-d78f-469e-89fd-d2ec5de6e1eb",
                                "sense_id": "5ab58884-e9dc-36f7-95e0-635ae0138c4d",
                                "text": "Le premier ministre Justin Trudeau a qualifié de « sans-dessein » et d’« ostrogoths » les influenceurs québécois coincés au Mexique."
                            }
                        ]
                    }
