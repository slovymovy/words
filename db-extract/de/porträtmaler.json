                "senses": [
                    {
                        "sense_id": "8da970ec-0ccf-3a88-8c04-042ad94313c9",
                        "entry_id": "a434ddcf-0982-303f-96ef-aab8c6c7e3f8",
                        "glosses": [
                            "Maler, der vornehmlich oder ausschließlich Porträts anfertigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4beb342b-01ff-4c9e-928b-368052bd7d6e",
                                "sense_id": "8da970ec-0ccf-3a88-8c04-042ad94313c9",
                                "text": "„Viele Porträtmaler bestätigen, dass Kunden häufig etwas von ihrem Besitz verewigt haben möchten – ganz wie frühere Patriarchen.“"
                            },
                            {
                                "example_id": "66344724-5727-4f05-a2bd-bd190581d958",
                                "sense_id": "8da970ec-0ccf-3a88-8c04-042ad94313c9",
                                "text": "„Unausbleiblich entbrennen die heftigsten Ähnlichkeitsdebatten vor der Staffelei der Porträtmaler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
