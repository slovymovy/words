                ],
                "senses": [
                    {
                        "sense_id": "718131f1-913a-34ee-a509-2b30f6b74a02",
                        "entry_id": "13145eed-4502-3a79-aba7-ef5cf56fe930",
                        "glosses": [
                            "de vaardigheden niet hebben die nodig zijn voor het uitvoeren van een taak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0587232-73af-4663-b876-e59b319c2301",
                                "sense_id": "718131f1-913a-34ee-a509-2b30f6b74a02",
                                "text": "Het doel heiligde blijkbaar de middelen. Mensen die al in een vroeg stadium waarschuwden voor de schadelijke gevolgen van de gaswinning zijn weggezet als doemdenkers, incapabele wetenschappers, of als dorpsgekken, zo reconstrueert de Onderzoeksraad Voor de Veiligheid. Het verband tussen aardgaswinning en aardbevingen is door alle bij de gaswinning betrokken partijen jarenlang systematisch en glashard ontkend, ook toen steeds meer wetenschapers en bezorgde burgers met beschadigde huizen op de noodzaak wezen de gaskraan dicht te draaien."
                            },
                            {
                                "example_id": "7000f7b9-e724-48ac-8312-78f54637600a",
                                "sense_id": "718131f1-913a-34ee-a509-2b30f6b74a02",
                                "text": "De fractiewoordvoerder beloofde onmiddellijk te komen. Morten had hem indertijd als spindoctor afgewezen omdat hij de loopjongen was geweest van Tilda Adema, Mortens incapabele voorgangster. Maar hij moest toegeven dat de jongeman het niet slecht deed. Hij had zich met dezelfde toewijding op Mo gestort, de nieuwe baas van de fractie. Loyaliteit moest worden beloond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "493b0ce8-e383-41a2-9db1-97a7f4d4be35",
                        "source_entry_id": "13145eed-4502-3a79-aba7-ef5cf56fe930",
                        "source_sense_id": "718131f1-913a-34ee-a509-2b30f6b74a02",
                        "source_sense_description": "de vaardigheden niet hebben die nodig zijn voor het uitvoeren van een taak",
                        "target_lang_word": "incapable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incapable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fb6e141-c580-3718-9561-b8ad180b91cf",
                                        "entry_id": "7104ecf3-e681-32b7-b731-eadeaca52a04",
                                        "glosses": [
                                            "Not capable (of doing something); unable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c423dfb-7ce4-4d52-ad7c-04d7eb85a5cf",
                                                "sense_id": "3fb6e141-c580-3718-9561-b8ad180b91cf",
                                                "text": "A pint glass is incapable of holding more than a pint of liquid."
                                            },
                                            {
                                                "example_id": "94886d5e-2e0b-470d-955e-538fbad22d11",
                                                "sense_id": "3fb6e141-c580-3718-9561-b8ad180b91cf",
                                                "text": "I consider him incapable of dishonesty."
                                            },
                                            {
                                                "example_id": "16311572-e4b3-4dc3-928f-84ec12c1bddf",
                                                "sense_id": "3fb6e141-c580-3718-9561-b8ad180b91cf",
                                                "text": "The British people seem incapable of avoiding the habit of leaving litter wherever they go, and the railways certainly seem to receive their fair share of it, in carriages and on stations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d6ce791-7c94-377b-82d3-1aeb86cea67f",
                                        "entry_id": "7104ecf3-e681-32b7-b731-eadeaca52a04",
                                        "glosses": [
                                            "Not in a state to receive; not receptive; not susceptible; not able to admit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "504b071d-076b-4c59-9408-789b254b929a",
                                                "sense_id": "7d6ce791-7c94-377b-82d3-1aeb86cea67f",
                                                "text": "incapable of pain, or pleasure; incapable of stain or injury"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incapable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d0960cf-830a-3484-be4d-0461b34860de",
                                        "entry_id": "844a5c79-7790-3ce2-adc4-8bc3d39ce6b4",
                                        "glosses": [
                                            "One who is morally or mentally weak or inefficient; an imbecile; a simpleton."
