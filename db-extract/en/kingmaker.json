                                        "entry_id": "f2bd87bc-7aec-3f2e-b464-6e937ae92814",
                                        "glosses": [
                                            "Personne ou groupe qui a une grande influence dans une succession monarchique ou politique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fedccfb-fb91-4420-b4ec-57bdf9372c88",
                                                "sense_id": "571f6117-04b6-32ae-92f1-9aa07e45dd01",
                                                "text": "A 81 ans, Silvio Berlusconi se rêve en faiseur de rois pour les prochaines élections législatives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17f53ca6-8946-356a-bb73-f138f2d8d36d",
                                        "entry_id": "f2bd87bc-7aec-3f2e-b464-6e937ae92814",
                                        "glosses": [
                                            "Personne ou groupe parlementaire qui dans un parlement a une grande influence dans la sélection d'un leader unique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ff712c1-cc49-434a-8b92-dcecf5edb30b",
                                                "sense_id": "17f53ca6-8946-356a-bb73-f138f2d8d36d",
                                                "text": "En 1992, le scandale Sagawa, du nom de la compagnie de transports Tokyo Sagawa Kyûbin, connue pour ses liens avec certains groupes de Yakuza, a provoqué la chute de Kanemaru Shin, le « faiseur de rois », président de la faction Takeshita (majoritaire au Parlement) et vice-président du PLD."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
