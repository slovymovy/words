                        "examples": [
                            {
                                "example_id": "45a7b529-4810-49aa-b608-0c182cbe9139",
                                "sense_id": "9ea1e5e0-8a37-32f6-b4c5-19fc88be2c43",
                                "text": "The Lake of Lugano has been most exquisitely described as possessing beauties, which at any time would be delightful, but are more contrastedly so after quitting the higher Alps, as they seem to open views of a new world."
                            },
                            {
                                "example_id": "1c546f2f-293a-4dd6-8586-6322d4749c21",
                                "sense_id": "9ea1e5e0-8a37-32f6-b4c5-19fc88be2c43",
                                "text": "If you quit the city, and traverse the vicinity; or, more contrastedly, if you cross over towards the loadstone-veins of the Texas, or down towards the lagoons of the Floridas; you will meet many wonders of the tree-kind; and I doubt not, that you would gladly leave the dust of the city, to stroll on the green grass, under the green trees."
                            },
                            {
                                "example_id": "a84c97dc-52c5-405f-825f-5f1e340a1876",
                                "sense_id": "9ea1e5e0-8a37-32f6-b4c5-19fc88be2c43",
                                "text": "For they serve to exhibit contrastedly the two divers aspects of the movement of the sixteenth century."
                            },
                            {
                                "example_id": "cf1cc0ee-bb0c-4a2c-b8c4-e4b61847359f",
                                "sense_id": "9ea1e5e0-8a37-32f6-b4c5-19fc88be2c43",
                                "text": "[…] the hind tibiæ more luteous than in T. cordiger, but with the apical sixth more contrastedly black; […]"
                            },
                            {
                                "example_id": "a948579b-621c-492f-b22e-073839aaa29d",
                                "sense_id": "9ea1e5e0-8a37-32f6-b4c5-19fc88be2c43",
                                "text": "Mr. Woodberry very contrastedly is rich in polysyllabic pomp and rapidity—[…]"
                            },
                            {
                                "example_id": "5705ac43-afb9-4424-9f5a-b62e684a0d29",
                                "sense_id": "9ea1e5e0-8a37-32f6-b4c5-19fc88be2c43",
                                "text": "Its most conspicuous features are its very contrastedly bicolored leaves, these being green and somewhat velvety above and white with a floccose tomentum beneath."
                            },
                            {
                                "example_id": "58d4f115-3149-4d49-9eca-4139f2eee86f",
                                "sense_id": "9ea1e5e0-8a37-32f6-b4c5-19fc88be2c43",
                                "text": "Contrastedly, the elderly make up a sizeable proportion of TEFAP recipients, comprising 38% of the program's participation."
                            }
                        ]
