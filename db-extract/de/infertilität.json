                        "sense_id": "8464fb5b-4c9a-3d47-82f9-e066031b1f38",
                        "entry_id": "931faef0-48cc-3369-9cb2-55e91f795079",
                        "glosses": [
                            "Eigenschaft, unfruchtbar (infertil) zu sein; das Unvermögen, Nachwuchs zu zeugen oder auch zu empfangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "036a76ab-774a-4c2d-9293-a927320d93ec",
                                "sense_id": "8464fb5b-4c9a-3d47-82f9-e066031b1f38",
                                "text": "Infertilität liegt vor, wenn auch nach 12 Monaten ungeschütztem Sex keine Konzeption erfolgt."
                            },
                            {
                                "example_id": "15f41753-49de-4ce8-8915-a5bd941de34f",
                                "sense_id": "8464fb5b-4c9a-3d47-82f9-e066031b1f38",
                                "text": "Infertilität, früher meistens Sterilität genannt, kann zahlreiche Ursachen haben, die von einer durchgemachten Mumpsinfektion im Kindesalter über eine erfolgte Chemotherapie bis hin zu psychosomatischen Gründen reichen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55d0bc5d-dcfe-4eae-b9dd-7cc05bf74811",
                        "source_entry_id": "931faef0-48cc-3369-9cb2-55e91f795079",
                        "source_sense_id": "8464fb5b-4c9a-3d47-82f9-e066031b1f38",
                        "source_sense_description": "Eigenschaft, unfruchtbar (infertil) zu sein; das Unvermögen, Nachwuchs zu zeugen oder auch zu empfangen",
                        "target_lang_word": "infertility",
                        "target_lang_code": "en",
