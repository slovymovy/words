                "senses": [
                    {
                        "sense_id": "a2689b81-10fb-392a-bb23-82e97666b8ef",
                        "entry_id": "5a33d44d-f1e2-3ad2-8914-0560b683cdff",
                        "glosses": [
                            "historische Entwicklung einer Spielgattung beziehungsweise des Phänomens Spiel allgemein"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "52c655b4-e5e9-4e47-912b-e847d8115912",
                                "sense_id": "a2689b81-10fb-392a-bb23-82e97666b8ef",
                                "text": "„Die wohl profundesten Kenner der Spielgeschichte, Barbara und Hans Holländer, haben zur Verbindung von Spiel und Kunstkammer in Wien eine kleine, aber äußerst präzise Ausstellung gestaltet.“"
                            },
                            {
                                "example_id": "53fa573f-e4fa-409e-8cc6-ab27d7ab4d63",
                                "sense_id": "a2689b81-10fb-392a-bb23-82e97666b8ef",
                                "text": "„Die drei Beispielaktionen zeigen auf ihre Art und Weise eindrucksvoll die Möglichkeit auf, wie unterschiedlich […] in der Spielgeschichte kooperative Abenteuerspiele sein können.“"
                            },
                            {
                                "example_id": "7043dd11-05ac-468b-8096-e5ac607ab7ff",
                                "sense_id": "a2689b81-10fb-392a-bb23-82e97666b8ef",
                                "text": "„Nach 60 Jahren Spielgeschichte gelten Games als Teil des kulturellen Guts.“"
                            },
                            {
                                "example_id": "42c67ae4-c1ee-4195-94fc-ac619f5353ec",
                                "sense_id": "a2689b81-10fb-392a-bb23-82e97666b8ef",
                                "text": "„Die Sommerausstellung im Ostholstein-Museum widmet sich einem bedeutenden Stück deutscher Spielgeschichte und lässt Kinderalltag lebendig werden.“"
                            },
                            {
                                "example_id": "d8cb17e9-92b6-4924-9c71-a3750576f177",
                                "sense_id": "a2689b81-10fb-392a-bb23-82e97666b8ef",
                                "text": "„Zugleich möchten wir dadurch die Firma Spear, die über Jahrzehnte hinweg in Nürnberg Spielgeschichte geschrieben hat, wieder stärker ins Gedächtnis rufen: lokal, national und international.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "300a6ed1-df7d-3f24-af76-db707e36dfa8",
                        "entry_id": "5a33d44d-f1e2-3ad2-8914-0560b683cdff",
                        "glosses": [
                            "Erzählung, die Stoff zum interaktiven Spielen bietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "073bdb92-a03d-41b7-824a-495b8423ad8a",
                                "sense_id": "300a6ed1-df7d-3f24-af76-db707e36dfa8",
                                "text": "„Es sind Spaß- und Spielgeschichten, die ein Vater mit seinen sechs Kindern erfunden, weitergesponnen und aufgeschrieben hat, Lustiges, Freches, Verqueres.“"
                            },
                            {
                                "example_id": "9b7b1f22-e594-49f7-9e6d-c905bff6183f",
                                "sense_id": "300a6ed1-df7d-3f24-af76-db707e36dfa8",
                                "text": "„Kennzeichnend für diese Spezies sind geschlossene, abenteuerliche Spielgeschichten mit festen Personen, deren Handlungen und Dialoge durch den Spieler gesteuert werden.“"
                            },
                            {
                                "example_id": "d2108dd8-0469-420e-a9ef-7e01531ca055",
                                "sense_id": "300a6ed1-df7d-3f24-af76-db707e36dfa8",
                                "text": "„Zu den Kandidaten gehört das Adventure Welt der Wunder – eine Stadt spielt verrückt, der Hip Hop Maker, Sim City 4, die Lernsoftware Verkehr, die Enzensberger- Umsetzung zum Zahlenteufel, die Lernprogramme Freddy, Informaticus und Okay sowie die Spielgeschichten Findet Nemo und Artus und das Piratenschiff.“"
                            },
                            {
                                "example_id": "ca241acb-67b9-4697-a164-35bbbfece7e3",
                                "sense_id": "300a6ed1-df7d-3f24-af76-db707e36dfa8",
                                "text": "„Diese Spielgeschichte für Kinder ab fünf Jahren gehört zu den innovativsten Kindersoftwaretiteln der letzten Jahre.“"
                            },
                            {
                                "example_id": "b4c3e170-1f97-4faf-834d-254ad7dd8fc1",
                                "sense_id": "300a6ed1-df7d-3f24-af76-db707e36dfa8",
                                "text": "„Eine neue multimediale Gattung entsteht, die Spielgeschichte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
