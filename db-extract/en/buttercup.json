                "senses": [
                    {
                        "sense_id": "ef925082-05e6-3d0d-aeae-9cfa0c096933",
                        "entry_id": "654d7199-840e-3354-96c2-570d87774aba",
                        "glosses": [
                            "Renoncule, grenouillette, fleur de l’impatience, gobet du diable, bouton-d’or."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad7c2fe3-22a7-4615-834c-3746be1959cd",
                                "sense_id": "ef925082-05e6-3d0d-aeae-9cfa0c096933",
                                "text": "The buttercups, bright-eyed and bold,\nHeld up their chalices of gold\nTo catch the sunshine and the dew."
                            },
                            {
                                "example_id": "d1ceb5b2-ca9d-47b0-8431-176dd58906a7",
                                "sense_id": "ef925082-05e6-3d0d-aeae-9cfa0c096933",
                                "text": "It is the strangest yellow, that wall paper! It makes me think of all the yellow things I ever saw—not beautiful ones like buttercups, but old foul, bad yellow things."
                            }
                        ]
                    }
                ],
