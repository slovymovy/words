                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1a59ef7-b652-3c53-ab78-3920a818203f",
                                        "entry_id": "3692dd2a-f7b0-3b1d-87fb-e8d60f581347",
                                        "glosses": [
                                            "A powdered substance produced by firing (calcining) calcium carbonate (limestone) and clay that develops strong cohesive properties when mixed with water. The main ingredient of concrete."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d21d5f1-85c5-4e27-8f40-679d2553c923",
                                                "sense_id": "a1a59ef7-b652-3c53-ab78-3920a818203f",
                                                "text": "In the autumn there was a row at some cement works about the unskilled labour men. A union had just been started for them and all but a few joined. One of these blacklegs was laid for by a picket and knocked out of time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f713433b-be98-3d37-be89-a043534b3600",
                                        "entry_id": "3692dd2a-f7b0-3b1d-87fb-e8d60f581347",
                                        "glosses": [
                                            "The paste-like substance resulting from mixing such a powder with water, or the rock-like substance that forms when it dries."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b998a30-c231-3b0f-9d1a-9ef3216e0641",
                                        "entry_id": "3692dd2a-f7b0-3b1d-87fb-e8d60f581347",
                                        "glosses": [
                                            "Any material with strong adhesive and cohesive properties such as binding agents, glues, grout."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0452ed2b-1b16-3f10-88a3-42d2edc426bd",
                                        "entry_id": "3692dd2a-f7b0-3b1d-87fb-e8d60f581347",
                                        "glosses": [
                                            "A bond of union; that which unites firmly, as persons in friendship or in society."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a514bea6-958e-4a63-8f27-7e02901d64ce",
                                                "sense_id": "0452ed2b-1b16-3f10-88a3-42d2edc426bd",
                                                "text": "the cement of our love"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4db57a27-708a-33be-9b0a-25b931c993e2",
                                        "entry_id": "3692dd2a-f7b0-3b1d-87fb-e8d60f581347",
                                        "glosses": [
                                            "The layer of bone investing the root and neck of a tooth; cementum."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2980b60b-25bd-3eb9-9554-850975e95ad2",
                                        "entry_id": "d387773a-284c-3d78-bc83-cdda4ba1c3c0",
                                        "glosses": [
                                            "To affix with cement."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52dd8dea-5e39-3f90-8bcc-bcd6ef5ed76c",
                                        "entry_id": "d387773a-284c-3d78-bc83-cdda4ba1c3c0",
                                        "glosses": [
                                            "To overlay or coat with cement."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbf599de-60b3-46f3-bc56-7af265303621",
                                                "sense_id": "52dd8dea-5e39-3f90-8bcc-bcd6ef5ed76c",
                                                "text": "to cement a cellar floor"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6cb6e2f-747a-35f8-9b02-b61a9a81129a",
                                        "entry_id": "d387773a-284c-3d78-bc83-cdda4ba1c3c0",
                                        "glosses": [
                                            "To unite firmly or closely."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39fd3b6e-9290-4a19-9f85-330cf711d079",
                                                "sense_id": "a6cb6e2f-747a-35f8-9b02-b61a9a81129a",
                                                "text": "For they have entertained cause enough\nTo draw their swords: but how the fear of us\nMay cement their divisions and bind up\nThe petty difference, we yet not know."
                                            },
                                            {
                                                "example_id": "fd8eef17-02bf-4227-8fb8-ea1aa7f31fb5",
                                                "sense_id": "a6cb6e2f-747a-35f8-9b02-b61a9a81129a",
                                                "text": "Olympic Games. — Besides the ordinary confederacies that join independent states together, a singular federal bond is remarkable in the Olympic games, which for many ages cemented the Grecian commonwealths by a joint tie of recreation and religious ritual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9087c92d-f9a7-38ff-815c-cea1a9e3d385",
                                        "entry_id": "d387773a-284c-3d78-bc83-cdda4ba1c3c0",
                                        "glosses": [
                                            "To make permanent."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "964976af-1225-4a0e-97d4-557075674f7d",
                                                "sense_id": "9087c92d-f9a7-38ff-815c-cea1a9e3d385",
                                                "text": "But friendſhip is a calm and ſedate affection, conducted by reaſon and cemented by habit; ſpringing from long acquaintance and mutual obligations; without jealouſies or fears; and without thoſe feveriſh fits of heat and cold, which cauſe ſuch an agreeable torment in the amorous paſſion."
                                            },
                                            {
                                                "example_id": "7bb7de77-3c0e-44ac-811c-e3e7cb549372",
                                                "sense_id": "9087c92d-f9a7-38ff-815c-cea1a9e3d385",
                                                "text": "[Dele] Alli’s ability to break forward from midfield was a prominent feature and the 19-year-old must have gone a long way to cementing his place in the team."
                                            },
                                            {
                                                "example_id": "d7614d59-57af-4127-ba0b-ff627c92522f",
                                                "sense_id": "9087c92d-f9a7-38ff-815c-cea1a9e3d385",
                                                "text": "Me and Mr. Wade, we are good friends. My respect for him has grown over these seven weeks of attacks. We are very good friends. I think but for these attacks, it would have been a friendship that, as life goes, we would have stopped having. I think that you have cemented that we'll be friends to the day we die."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
