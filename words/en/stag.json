                        {
                            "text": "Her grandmother frowned upon the playful <w>stag</w> running through muddy fields.",
                            "target_lang_translations": {
                                "ru": "Бабушка не одобряла резвую <w>пацанку</w>, бегающую по грязным полям."
                            }
