                "senses": [
                    {
                        "sense_id": "55895d05-8464-3703-8250-1760a839778f",
                        "entry_id": "9f2470c2-6055-3623-95b7-8c429074cc6a",
                        "glosses": [
                            "Celui qui est à la solde et agit pour le compte d'un autre ou d'une organisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc98f934-5607-4588-901a-abe80f3b1142",
                                "sense_id": "55895d05-8464-3703-8250-1760a839778f",
                                "text": "Et, avec un rire hideux, ces deux stipendiés de la mort posèrent leur sac dans l'angle, près de l'ancien autel à ma gauche devant moi."
                            },
                            {
                                "example_id": "ae45a9bd-29b0-4f9e-8616-672cc19b3442",
                                "sense_id": "55895d05-8464-3703-8250-1760a839778f",
                                "text": "Formules creuses! narguent les rétrogrades et leurs stipendiés."
                            }
                        ]
                    }
                ],
