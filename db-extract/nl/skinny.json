                                                "example_id": "047a1757-7d38-41b6-9c2d-e5a68093a598",
                                                "sense_id": "d9434e6c-7f80-33df-aba9-aac36c28c9cc",
                                                "text": "He lean'd not on his fathers but himself."
                                            },
                                            {
                                                "example_id": "3c9d6324-2502-4b7c-add3-e0fd334c890a",
                                                "sense_id": "d9434e6c-7f80-33df-aba9-aac36c28c9cc",
