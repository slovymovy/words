                ],
                "senses": [
                    {
                        "sense_id": "0a12c8bc-86c8-308b-9c1f-8669acce78fe",
                        "entry_id": "98bfa5a0-9e80-3fff-a824-c59bf287bb20",
                        "glosses": [
                            "Vorrichtung zum Abscheiden von feinst verteilten, schwebenden festen oder flüssigen Stoffen aus Luft, Gasen oder Dämpfen"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "237a0387-8abd-4a26-8139-a171ef40ab34",
                                "sense_id": "0a12c8bc-86c8-308b-9c1f-8669acce78fe",
                                "text": "„Ein Aerosolabscheider ist dementsprechend eine Anlage der Luftreinigungstechnik. Ein Aerosolabscheider ist dafür zuständig, aus einem Aerosol gefährliche oder umweltschädigende Dispersionen auszuleiten und ihrer korrekten Entsorgung zuzuführen.“"
                            },
                            {
                                "example_id": "5b4e73b6-1f18-4c56-b890-359e84fe85d7",
                                "sense_id": "0a12c8bc-86c8-308b-9c1f-8669acce78fe",
                                "text": "„Bevor die Abluft einer Küche in die Abluftleitungen strömt, muss sie zuvor durch hochwirksame Aerosolabscheider (früher Fettfanggitter) gereinigt werden.“"
                            },
                            {
                                "example_id": "e75d61bb-6717-4707-97d5-0d5409c1b039",
                                "sense_id": "0a12c8bc-86c8-308b-9c1f-8669acce78fe",
                                "text": "„Der mechanische Aerosolabscheider dient dazu, große Aerosolpartikel aus dem Abluftstrom zu entfernen und fungiert außerdem als Brandschutz, indem er Flammen aus dem Abluft- und Kanalbereich der Haube fernhält.“"
                            },
                            {
                                "example_id": "a97f513b-e4a2-47d7-8518-a535560c4c06",
                                "sense_id": "0a12c8bc-86c8-308b-9c1f-8669acce78fe",
                                "text": "„Diese Norm beinhaltet Anforderungen an die Bau- und Betriebsweise von Aerosolabscheidern, die in Küchenlüftungshauben und -decken für den Gebrauch in gewerbsmäßigen Küchen integriert sind, einschließlich der Prüfungen des Flammdurchschlags, der technischen Sicherheit und hygienischen Merkmale.“"
                            },
                            {
                                "example_id": "f50ac6bc-60d2-4ecf-bc7d-13833dbeacc8",
                                "sense_id": "0a12c8bc-86c8-308b-9c1f-8669acce78fe",
                                "text": "„Seit in der VDI 2052 erstmals definiert wurde, wie Abscheidegrade von Aerosolabscheidern (früher Fettabscheider bzw. Filter genannt) zu messen und anzugeben sind, ist die Entwicklung zu hochwertigen Abscheidern rasant fortgeschritten.“"
                            },
                            {
                                "example_id": "bd4e0815-fb14-4938-a300-d62fca7fa9e7",
                                "sense_id": "0a12c8bc-86c8-308b-9c1f-8669acce78fe",
                                "text": "„Die Ergebnisse bildeten die Grundlage für die anschließende Optimierung von Aerosolabscheidern sowie eine komplette Neukonstruktion eines Aerosolabscheiders für nicht wassermischbare Kühlschmierstoffe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
