                    "semantic_group_id": "choroba",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój dziadek <w>cierpi</w> na reumatyzm.",
                            "target_lang_translations": {
                                "en": "My grandfather <w>suffers from</w> rheumatism.",
                                "ru": "Мой дедушка <w>страдает</w> ревматизмом.",
                                "nl": "Mijn grootvader <w>lijdt aan</w> reuma.",
                                "de": "Mein Großvater <w>leidet an</w> Rheuma.",
                                "fr": "Mon grand-père <w>souffre de</w> rhumatismes.",
                                "it": "Mio nonno <w>soffre</w> di reumatismi.",
                                "cs": "Můj dědeček <w>trpí</w> revmatismem.",
                                "tr": "Dedem romatizmadan <w>muzdarip</w>.",
                                "es": "Mi abuelo <w>padece</w> de reumatismo.",
                                "zh": "我爷爷<w>患有</w>风湿病。"
                            }
                        },
                        {
                            "text": "Wiele osób <w>cierpi</w> na bezsenność w dzisiejszych czasach.",
                            "target_lang_translations": {
                                "en": "Many people <w>suffer from</w> insomnia nowadays.",
                                "ru": "В наше время многие люди <w>страдают</w> бессонницей.",
                                "nl": "Veel mensen <w>lijden aan</w> slapeloosheid tegenwoordig.",
                                "de": "Viele Menschen <w>leiden</w> heutzutage <w>an</w> Schlaflosigkeit.",
                                "fr": "Beaucoup de gens <w>souffrent d'</w>insomnie de nos jours.",
                                "it": "Molte persone al giorno d'oggi <w>soffrono</w> di insonnia.",
                                "cs": "Mnoho lidí v dnešní době <w>trpí</w> nespavostí.",
                                "tr": "Günümüzde pek çok insan uykusuzluk <w>çekiyor</w>.",
                                "es": "Hoy en día muchas personas <w>sufren de</w> insomnio.",
                                "zh": "如今许多人都<w>饱受</w>失眠<w>之苦</w>。"
                            }
