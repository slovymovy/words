                "senses": [
                    {
                        "sense_id": "3b3a1904-a71d-3666-847a-1ac77100a38c",
                        "entry_id": "74639574-6fd4-3a39-b06b-09b659f6f707",
                        "glosses": [
                            "Person, die sich in Bergregionen sportlich betätigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4585cf6f-39a6-489c-a774-15ce84be6293",
                                "sense_id": "3b3a1904-a71d-3666-847a-1ac77100a38c",
                                "text": "„Der verinnerlichte Bergsportler begegnet dem Berg mit Respekt vor der Großartigkeit der Natur.“"
                            },
                            {
                                "example_id": "4a31ccd8-cac5-4890-b902-06af7e09f3db",
                                "sense_id": "3b3a1904-a71d-3666-847a-1ac77100a38c",
                                "text": "„Heute nehmen sie die Bergsportler ins Visier, bieten Klettersteige nach Katalog oder nehmen die vorhandenen Wege und klassifizieren sie.“"
                            },
                            {
                                "example_id": "28c24a4d-ec37-4e43-b48f-3f1ce63d6d4a",
                                "sense_id": "3b3a1904-a71d-3666-847a-1ac77100a38c",
                                "text": "„Wenn unerfahrene Bergsportler die falsche Route wählen oder dem sicheren Weg das steile Gelände vorziehen, arbeitet der Leichtsinn der Technik entgegen.“"
                            },
                            {
                                "example_id": "c28652b2-a305-4d42-b297-a0ce04f213df",
                                "sense_id": "3b3a1904-a71d-3666-847a-1ac77100a38c",
                                "text": "„Auf dem Gipfel steht eine Hütte mit Kaminfeuer, in der die Bergsportler sich wärmen können.“"
                            },
                            {
                                "example_id": "23fab4e2-b43f-49ca-9ef2-dbb2b10c0c78",
                                "sense_id": "3b3a1904-a71d-3666-847a-1ac77100a38c",
                                "text": "„Die krisengeplagte Tourismusbranche in den Alpen braucht nicht nur jeden zahlenden Gast, sondern hat gerade abenteuerlustige Bergsportler als lohnende Zielgruppe wiederentdeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
