                        "glosses": [
                            "het glanzende mineraal dat de binnenzijde van bepaalde schelpen bedekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20ade58c-8d0b-4781-9132-ab771769e6b7",
                                "sense_id": "3d398646-2715-3168-a9d1-05227d79097a",
