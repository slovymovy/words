                            {
                                "example_id": "e497c6b2-746c-43ba-9af3-2ce86ca874be",
                                "sense_id": "86af8940-519a-3993-9599-159b753d1aa2",
                                "text": "„Die Seitenblicke-Gesellschaft hat sich indessen nach Salzburg verlagert, wo der neue Intendant, wenn man seine Worte interpretieren darf, die Festspielgäste am liebsten in Ruderleiberl und Minirock sehen würde.“"
                            },
                            {
                                "example_id": "e41aed46-feff-4273-8a21-a9459f775749",
                                "sense_id": "86af8940-519a-3993-9599-159b753d1aa2",
                                "text": "„Obsolet ist damit Holls Vorstellung, dass die »Seitenblicke-Gesellschaft«, die Gesellschaft der »Schönen und Reichen«, die eigentlich schlechte ist.“"
                            }
