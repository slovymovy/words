    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b746cb7-df68-3c31-ade1-91615b4535c2",
                    "sense_definition": "A cord formed by spinning or twisting together textile fibers or filaments into one or more continuous strands, typically used in needlework.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_filament",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a needle and <w>thread</w> to sew the button back onto her coat.",
                            "target_lang_translations": {
                                "ru": "Она использовала иголку с <w>ниткой</w>, чтобы пришить пуговицу обратно к пальто."
                            }
                        },
                        {
                            "text": "The tailor selected a matching <w>cotton</w> <w>thread</w> for the repairs.",
                            "target_lang_translations": {
                                "ru": "Портной выбрал подходящую <w>хлопковую</w> <w>нитку</w> для ремонта."
                            }
                        }
                    ],
                    "synonyms": [
                        "string"
                    ],
                    "common_phrases": [
                        "needle and thread",
                        "cotton thread",
                        "silk thread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонко скрученная пряжа из натуральных или искусственных волокон, используемая для шитья."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нитка",
                                "target_lang_sense_clarification": "обычное слово для шитья"
                            },
                            {
                                "target_lang_word": "нить",
                                "target_lang_sense_clarification": "более формальный или общий термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9eaf22f3-3822-3f45-861a-dc840f6d62fb",
                    "sense_definition": "A series of posts or messages, consisting of an initial post and responses to it, generally relating to the same subject, on a newsgroup, Internet forum, or social media platform.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication_sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I read the entire <w>thread</w> on the forum to find a solution to my problem.",
                            "target_lang_translations": {
                                "ru": "Я прочитал весь <w>тред</w> на форуме, чтобы найти решение своей проблемы."
                            }
                        },
                        {
                            "text": "Please keep your comments relevant to the current <w>discussion</w> <w>thread</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, придерживайтесь темы текущей <w>ветки</w> <w>обсуждения</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "topic"
                    ],
                    "common_phrases": [
                        "discussion thread",
                        "forum thread",
                        "twitter thread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цепочка сообщений по одной теме на интернет-форуме или в социальной сети."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тред",
                                "target_lang_sense_clarification": "интернет-сленг"
                            },
                            {
                                "target_lang_word": "ветка",
                                "target_lang_sense_clarification": "обсуждение на форуме"
                            },
                            {
                                "target_lang_word": "тема",
                                "target_lang_sense_clarification": "предмет обсуждения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2e94e1c-4ab4-3e09-99da-df82e3f61dcf",
                    "sense_definition": "A line of reasoning, sequence of ideas, or train of thought that connects the successive points in a discourse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication_sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor spoke so quickly that I <w>lost</w> <w>the</w> <w>thread</w> of his lecture.",
                            "target_lang_translations": {
                                "ru": "Профессор говорил так быстро, что я <w>потерял</w> <w>нить</w> его лекции."
                            }
                        },
                        {
                            "text": "It was difficult to follow the <w>thread</w> <w>of</w> <w>thought</w> in such a complex novel.",
                            "target_lang_translations": {
                                "ru": "В таком сложном романе было трудно уследить за <w>ходом</w> <w>мыслей</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lose the thread",
                        "thread of thought",
                        "follow the thread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ход мыслей или логическая последовательность рассуждений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нить",
                                "target_lang_sense_clarification": "в контексте разговора или мысли"
                            },
                            {
                                "target_lang_word": "ход",
                                "target_lang_sense_clarification": "в выражении «ход мыслей»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f6ed44d-ff91-3b69-a031-8fba53d82632",
                    "sense_definition": "A continuing theme or recurring element that modifies or connects a whole discourse or story.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication_sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>common</w> <w>thread</w> of social justice runs through all of her political speeches.",
                            "target_lang_translations": {
                                "ru": "Через все её политические речи красной <w>нитью</w> проходит тема социальной справедливости."
                            }
                        },
                        {
                            "text": "The author uses a <w>recurring</w> <w>thread</w> of mystery to keep the readers engaged.",
                            "target_lang_translations": {
                                "ru": "Автор использует <w>повторяющийся</w> <w>мотив</w> тайны, чтобы поддерживать интерес читателей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "common thread",
                        "recurring thread",
                        "central thread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связующий элемент или повторяющаяся тема в истории или дискурсе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нить",
                                "target_lang_sense_clarification": "в выражении «красная нить»"
                            },
                            {
                                "target_lang_word": "лейтмотив",
                                "target_lang_sense_clarification": "повторяющаяся тема"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef0e0924-6171-3592-af6c-6c79b6cb6420",
                    "sense_definition": "A precarious condition; something which offers no real or perceived security.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the accident, his life was <w>hanging</w> <w>by</w> <w>a</w> <w>thread</w> for several days.",
                            "target_lang_translations": {
                                "ru": "После аварии его жизнь несколько дней <w>висела</w> <w>на</w> <w>волоске</w>."
                            }
                        },
                        {
                            "text": "The peace treaty is currently <w>hanging</w> <w>by</w> <w>a</w> <w>thread</w> due to recent border disputes.",
                            "target_lang_translations": {
                                "ru": "Мирный договор сейчас <w>висит</w> <w>на</w> <w>ниточке</w> из-за недавних пограничных споров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hanging by a thread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ненадежное или опасное положение; отсутствие безопасности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волосок",
                                "target_lang_sense_clarification": "в выражении «висеть на волоске»"
                            },
                            {
                                "target_lang_word": "ниточка",
                                "target_lang_sense_clarification": "в выражении «висеть на ниточке»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a8e869f-32d6-342b-adb8-34b9b498b0e7",
                    "sense_definition": "Any of various natural or manufactured filaments, such as spiderwebs, glass, or plastic.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_filament",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning dew made the <w>threads</w> of the spiderweb sparkle in the sunlight.",
                            "target_lang_translations": {
                                "ru": "Утренняя роса заставила <w>нити</w> паутины сверкать на солнце."
                            }
                        },
                        {
                            "text": "The scientist examined the fine <w>glass</w> <w>thread</w> under a powerful microscope.",
                            "target_lang_translations": {
                                "ru": "Ученый исследовал тонкое <w>стеклянное</w> <w>волокно</w> под мощным микроскопом."
                            }
                        }
                    ],
                    "synonyms": [
                        "string"
                    ],
                    "common_phrases": [
                        "glass thread",
                        "silver thread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое тонкое волокно природного или искусственного происхождения."
