                "senses": [
                    {
                        "sense_id": "c172844c-9def-3d41-bc23-7432bab7ae60",
                        "entry_id": "c823dd89-71fe-3ce8-83e0-bce579e4663a",
                        "glosses": [
                            "Annulation de la mainmorte sur un domaine en échange d’une compensation monétaire due au seigneur. Redevance payée par les mainmortables au seigneur pour l’indemniser de la suppression des droits de mutation dont ce dernier se trouverait privé à l'avenir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebb2b532-1306-4450-a9f3-33f02ab38470",
                                "sense_id": "c172844c-9def-3d41-bc23-7432bab7ae60",
                                "text": "On ignore comment et à quelle époque fut fondée la maison de Dormelles, ancienne commanderie du Temple. Tout ce qu'on sait, c'est que les Templiers étaient établis à Dormelles, au commencement du XIIIᵉ siècle, comme on le voit dans des lettres d’amortissement accordées en 1220, par Odeline de Limeni, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb08cb4c-6cab-3de5-bd60-1996b8ff1560",
                        "entry_id": "c823dd89-71fe-3ce8-83e0-bce579e4663a",
                        "glosses": [
                            "Conversion en une rente annuelle d’un capital."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff840e81-d78e-4b08-b02d-d8d89a619df9",
                                "sense_id": "bb08cb4c-6cab-3de5-bd60-1996b8ff1560",
                                "text": "Faire l’amortissement d’une rente, d’une pension."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b4f51cd-0ce9-3903-82ac-85e7d21f9674",
                        "entry_id": "c823dd89-71fe-3ce8-83e0-bce579e4663a",
                        "glosses": [
                            "Rééchelonnement dans le temps des annuités, amoindrissement des annuités."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8bb514d-24b1-4a98-94d8-ac614c8827c3",
                                "sense_id": "1b4f51cd-0ce9-3903-82ac-85e7d21f9674",
                                "text": "L’amortissement de la dette publique."
                            },
                            {
                                "example_id": "ba933147-b2c0-4b7b-81ce-3c241a334e86",
                                "sense_id": "1b4f51cd-0ce9-3903-82ac-85e7d21f9674",
                                "text": "Caisse d’amortissement, Caisse établie pour l’étalement de la dette publique."
                            }
                        ]
                    },
                    {
                        "sense_id": "88741891-13cd-3fc5-96b0-17481d6034ae",
                        "entry_id": "c823dd89-71fe-3ce8-83e0-bce579e4663a",
                        "glosses": [
                            "Affaiblissement, atténuation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d6cba9d-6a71-4088-9199-85614abbb3bd",
                                "sense_id": "88741891-13cd-3fc5-96b0-17481d6034ae",
                                "text": "L’amortissement d’un choc."
                            }
                        ]
                    },
                    {
                        "sense_id": "0410454c-117c-3129-9eb8-c1f21db67cdc",
                        "entry_id": "c823dd89-71fe-3ce8-83e0-bce579e4663a",
                        "glosses": [
                            "Charge passée dans les comptes pour compenser la dépréciation graduelle d'une immobilisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3c64519-1e38-4ca1-8efc-8bf3248fb8cd",
                                "sense_id": "0410454c-117c-3129-9eb8-c1f21db67cdc",
                                "text": "Aussi la manutention mécanique de ces produits est-elle une condition essentielle de l'abaissement des frais de fabrication. Or, pour permettre l'amortissement raisonnable du matériel de manutention mécanique et de la cave continue qui doit lui être associée, une capacité annuelle de 100 000 tonnes au minimum paraît être opportune."
                            }
                        ]
                    },
                    {
                        "sense_id": "92485a49-774d-3478-bdb4-24d10a2ee50d",
                        "entry_id": "c823dd89-71fe-3ce8-83e0-bce579e4663a",
                        "glosses": [
                            "Succession de paiement remboursant le capital d'un emprunt."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "05544ccd-5a43-34dd-82bb-ba138b04de23",
                        "entry_id": "c823dd89-71fe-3ce8-83e0-bce579e4663a",
                        "glosses": [
                            "Ce qui termine et surmonte le comble d’un bâtiment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9871149-a894-408b-b79e-2bc2ee92d390",
                                "sense_id": "05544ccd-5a43-34dd-82bb-ba138b04de23",
                                "text": "On a mis pour amortissement à ce pavillon un vase de fleurs."
                            },
                            {
                                "example_id": "f1457381-7f7b-42be-8c23-5c90e40add0a",
                                "sense_id": "05544ccd-5a43-34dd-82bb-ba138b04de23",
                                "text": "Mettre un vase, mettre une figure en amortissement."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ddd5186-5e97-3182-a941-afd3603765b7",
                        "entry_id": "c823dd89-71fe-3ce8-83e0-bce579e4663a",
                        "glosses": [
                            "Cavet renversé qui couvre les corniches des croisées et des portes extérieures, pour les garantir de la pluie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7052da8d-1670-4e52-89d7-c1b69753d0dd",
                                "sense_id": "4ddd5186-5e97-3182-a941-afd3603765b7",
                                "text": "Mettre des figures, des vases, des trophées au-dessus d’une corniche pour servir d’amortissement."
                            }
                        ]
