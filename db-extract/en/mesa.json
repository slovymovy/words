                                        "entry_id": "ef97264e-764c-3848-9a83-556743c5a7b2",
                                        "glosses": [
                                            "Berg mit flacher, tafelartiger Oberseite"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42bdc441-ad38-4d12-a704-42e8d0bea8d9",
                                                "sense_id": "9c75b545-ac3f-3634-9c33-08d265f60b8d",
                                                "text": "Im Monument Valley gibt es viele Tafelberge."
                                            }
