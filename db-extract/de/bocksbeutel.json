                "senses": [
                    {
                        "sense_id": "3fb9bb8e-ba0f-3092-95e3-954bd6496029",
                        "entry_id": "60a934ae-b06a-31a6-ae69-96a63d23c1b9",
                        "glosses": [
                            "bocksbeutel, wijnfles in de vorm van een afgeplatte ellipsoïde die typisch is voor de Duitse wijnstreek Franken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f44a74d-c9a4-4b9b-88b5-706742d3ff5d",
                                "sense_id": "3fb9bb8e-ba0f-3092-95e3-954bd6496029",
                                "text": "In Bocksbeuteln wird hochwertiger Wein abgefüllt.",
                                "translation": "In bocksbeutels wordt kwaliteitswijn gebotteld."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8f64a2b-5fe1-30c6-b3f0-847d457d1eb1",
                        "entry_id": "60a934ae-b06a-31a6-ae69-96a63d23c1b9",
                        "glosses": [
                            "nalatigheid, sleur"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a73e8820-7851-4d26-ba08-b511a23c58a2",
                                "sense_id": "d8f64a2b-5fe1-30c6-b3f0-847d457d1eb1",
                                "text": "Das Weib soll dem Manne untertan sein, doch allzu oft steht ihm sein Bocksbeutel im Weg.",
                                "translation": "De vrouw moet de man onderdanig zijn, maar al te vaak wordt hij gehinderd door zijn nalatigheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "9adff277-c000-3269-85a4-53d9506ec93e",
                        "entry_id": "60a934ae-b06a-31a6-ae69-96a63d23c1b9",
                        "glosses": [
                            "een naam voor twee geslachten orchideeën (Orchis en Epidendrum)"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6e41fd92-2cb7-4ab4-a7a5-2c5065f403b4",
                                "sense_id": "9adff277-c000-3269-85a4-53d9506ec93e",
                                "text": "Von den Bäumen hängt der Bocksbeutel herab.",
                                "translation": "Aan de bomen hangt de orchidee naar beneden."
                            }
                        ]
                    }
                ],
