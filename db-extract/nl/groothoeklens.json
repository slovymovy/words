                "senses": [
                    {
                        "sense_id": "7c0f69a6-e316-3208-86c2-d195e3bac1b3",
                        "entry_id": "1d802811-d136-3743-8512-85d17e1f6cbc",
                        "glosses": [
                            "een lens met een korte brandpuntafstand zodat men een groot deel van de omgeving in beeld kan krijgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91232860-ca88-4eec-a322-9f78c2d003d0",
                                "sense_id": "7c0f69a6-e316-3208-86c2-d195e3bac1b3",
                                "text": "Ondanks dat Recine niet was voorbereid op een situatie zoals deze, lukte het hem toch om het goed in beeld te brengen. \"Ik heb altijd een groothoeklens in de buurt voor zulke momenten. Al komen ze zelden voor.\""
                            },
                            {
                                "example_id": "402b6214-bde1-42e8-ade4-bdc99cf33eeb",
                                "sense_id": "7c0f69a6-e316-3208-86c2-d195e3bac1b3",
                                "text": "Door het gebruik van fel flitslicht zijn de kleuren in Parrs foto's vaak helder en licht. Dit, in combinatie met een groothoeklens, zorgt ervoor dat de onderwerpen van zijn foto's vaak enigszins surrealistisch lijken."
                            },
                            {
                                "example_id": "3191c1fe-97b0-4826-a700-9a7f0f036328",
                                "sense_id": "7c0f69a6-e316-3208-86c2-d195e3bac1b3",
                                "text": "De telescoop heeft nieuwe radio-ontvangers gekregen die werken als een groothoeklens. Daarmee kunnen onderzoekers veertig keer meer zien dan voorheen."
                            }
                        ]
                    }
                ],
