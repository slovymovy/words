                "senses": [
                    {
                        "sense_id": "ffabeae0-dd89-3a0c-90fc-46a07be266b3",
                        "entry_id": "4cc6c5ca-47f5-32ba-a599-7d4279a33b79",
                        "glosses": [
                            "Pavé."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "fb44027c-fd2c-4d0f-9cad-1dceb921e2c2",
                                "sense_id": "ffabeae0-dd89-3a0c-90fc-46a07be266b3",
                                "text": "Je passe la seconde et file un coup d’accélérateur, les pneus miaulent sur le paveton."
                            },
                            {
                                "example_id": "836ed545-b605-4282-a749-deadeb962738",
                                "sense_id": "ffabeae0-dd89-3a0c-90fc-46a07be266b3",
                                "text": "Puis, les balayeuses municipales sont passées, brossant les pavetons sous des cataractes d’eau."
                            },
                            {
                                "example_id": "d122d6ff-f10d-4fd6-b36e-28411895614e",
                                "sense_id": "ffabeae0-dd89-3a0c-90fc-46a07be266b3",
                                "text": "Roger et moi, on s’était approchés, on s’est mis à bombarder le vieux con à coups de pavetons en le traitant de voleur."
                            },
                            {
                                "example_id": "3df42faf-f686-46ba-89a9-d134fbc9544a",
                                "sense_id": "ffabeae0-dd89-3a0c-90fc-46a07be266b3",
                                "text": "Mais ça les abîme, les livres, c’est nul! Même quand c’est une daube comme ça! La seule raison valable de bousiller ce paveton, ce serait pour venger les arbres…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
