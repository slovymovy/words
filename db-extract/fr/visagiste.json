                                            {
                                                "example_id": "780be052-c00e-4dcd-87b7-bd9550760769",
                                                "sense_id": "3e6a841a-873f-3dcc-ac2d-c7733da17a85",
                                                "text": "Rapper Sjors is tot over zijn oren verliefd op de 27-jarige Spaanse Sue. De uit Valencia afkomstige visagiste sprak met Privé over de ontmoeting, de liefde en de toekomstplannen."
                                            },
                                            {
                                                "example_id": "3863c89d-05c7-42a7-8471-daea8d8b45bf",
                                                "sense_id": "3e6a841a-873f-3dcc-ac2d-c7733da17a85",
                                                "text": "Mario Dedivanovic, een van de vaste visagisten van de Kardashians, zit in zak en as. Zijn make-up koffer, met daarin onder andere peperdure kwasten waarmee hij al jaren werkt, is gestolen op JFK Airport in New York. De make-up artist wil zijn spullen zo graag terug, dat hij 10.000 dollar geeft aan de persoon die de bagage bij hem terugbezorgt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
