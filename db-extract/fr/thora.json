                "senses": [
                    {
                        "sense_id": "c08692a9-b879-3c3f-8547-8bb121406cae",
                        "entry_id": "b1c5cb08-6361-3946-9816-4b940ec955ad",
                        "glosses": [
                            "Nom sous lequel les Juifs désignent le Pentateuque."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "5384c44c-b258-41e5-b65e-9fd555af3ce7",
                                "sense_id": "c08692a9-b879-3c3f-8547-8bb121406cae",
                                "text": "La Thora fut, selon la tradition, dictée à Moïse par Dieu au pied du mont Sinaï."
                            },
                            {
                                "example_id": "c7480e44-2f3b-4d56-954f-bf475bcd45ff",
                                "sense_id": "c08692a9-b879-3c3f-8547-8bb121406cae",
                                "text": "Il décrit enfin l’organisation biblique des tribunaux et les modalités de l’activité juridictionnelle mettant en œuvre, jusqu’à nos jours, les 613 obligations constitutives de la Thora."
                            }
                        ]
                    },
                    {
                        "sense_id": "7549a011-d39d-393c-8258-1ae61e0bc78d",
                        "entry_id": "b1c5cb08-6361-3946-9816-4b940ec955ad",
                        "glosses": [
                            "Entièreté des textes légaux, éthiques et religieux fondant le judaïsme."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9729acce-af31-4401-8ffd-347d95488fcc",
                        "source_entry_id": "b1c5cb08-6361-3946-9816-4b940ec955ad",
                        "source_sense_description": "Pentateuque du judaïsme",
                        "target_lang_word": "Tora",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tora",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f989f08-9e15-3e2a-850b-2de5728a472a",
                                        "entry_id": "bbdb550e-0961-3047-a504-3db560581649",
                                        "glosses": [
                                            "jüdische Religion: alternative Schreibweise von Thora"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68e846a6-0fd5-4833-9263-b66ae1161202",
                                                "sense_id": "7f989f08-9e15-3e2a-850b-2de5728a472a",
                                                "text": "„Im Kanon der Juden hat die Tora bei weitem den 1. Rang gegenüber den Propheten und \"Schriften\", die nur als Ergänzung zu ihr verstanden wurden und ihre Autorität aus der Übereinstimmung mit ihr empfingen.“"
                                            },
                                            {
                                                "example_id": "de15a78c-d8ab-4dd9-9ee2-f2c292640d1b",
                                                "sense_id": "7f989f08-9e15-3e2a-850b-2de5728a472a",
                                                "text": "„Die wichtigsten Gebote der Tora sind in dieser rabbinischen ebenso wie in der urchristlichen Tradition die Zehn Gebote und das Gebot der Nächstenliebe.“"
                                            },
                                            {
                                                "example_id": "9a9a5c30-6311-4686-8240-06eb3c97050a",
                                                "sense_id": "7f989f08-9e15-3e2a-850b-2de5728a472a",
                                                "text": "„Bei einem anderen Paket beschrieb Helena ihn mit Bart, Schläfenlocken, einer Kippa auf dem Kopf und mit großen, braunen Augen, klug, jemand, der die Tora kannte und ihre Gebote erfüllte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33bf6422-5bde-49a8-b1a3-2189d321bcc8",
                        "source_entry_id": "b1c5cb08-6361-3946-9816-4b940ec955ad",
                        "source_sense_description": "Pentateuque du judaïsme",
                        "target_lang_word": "Torah",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Torah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab376cd5-60c7-3a13-a1b1-74f311776265",
                                        "entry_id": "eb604fac-cbd2-3cc5-87fb-d5b917d9c41f",
                                        "glosses": [
                                            "The first five books of the Hebrew Scriptures, traditionally attributed to Moses and therefore also known as the Five Books of Moses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c4941d5-c8ed-4404-b883-01c9be6c066d",
                                                "sense_id": "ab376cd5-60c7-3a13-a1b1-74f311776265",
                                                "text": "Holonyms: Tanakh, Hebrew Bible, Jewish Bible, Septuagint"
                                            },
                                            {
                                                "example_id": "7799956b-b600-45af-8a74-b29ca5ace8e6",
                                                "sense_id": "ab376cd5-60c7-3a13-a1b1-74f311776265",
                                                "text": "Tradition holds that the Torah was handed down to Moses on Mount Sinai."
                                            },
                                            {
                                                "example_id": "59f6fccd-c2c3-43d4-8af7-d1b062d1f6ea",
                                                "sense_id": "ab376cd5-60c7-3a13-a1b1-74f311776265",
                                                "text": "The Jews were denying that the punishment was stoning, and Muhammad demanded to see a copy of the Torah and that it be read to him. The ruling that prescribed stoning the adulterer was in the Torah for all to see, and Muhammad was vindicated. Al-Biqāʿī also cites a different version of the same report in which Muhammad placed the Torah on a cushion as a sign of respect."
                                            },
                                            {
                                                "example_id": "f4176552-ae02-43cf-8359-e489073a4e14",
                                                "sense_id": "ab376cd5-60c7-3a13-a1b1-74f311776265",
                                                "text": "Services during Yom Kippur are held continuously through the day and include readings from the Torah and the reciting of prayers expressing regret or asking for forgiveness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cc789c8-5d49-32d7-8666-0e504ad290b6",
                                        "entry_id": "eb604fac-cbd2-3cc5-87fb-d5b917d9c41f",
                                        "glosses": [
                                            "The full body of written Jewish law, including the Tanakh, the Talmud, the Mishnah and the midrashic texts."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9415009-61c9-40f4-9f40-bd536642abce",
                                                "sense_id": "2cc789c8-5d49-32d7-8666-0e504ad290b6",
                                                "text": "It says in the Torah that both gossip and murder cause irreparable damage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d26e83fb-965c-32f5-9667-6b748776b097",
                                        "entry_id": "eb604fac-cbd2-3cc5-87fb-d5b917d9c41f",
                                        "glosses": [
                                            "The whole of Jewish law, both written and unwritten."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f6d99bb-ba01-3a31-8463-83766ee86e3a",
                                        "entry_id": "eb604fac-cbd2-3cc5-87fb-d5b917d9c41f",
                                        "glosses": [
                                            "The encompassing philosophy of Judaism."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
