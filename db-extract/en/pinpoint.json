                        "cross_references": [
                            {
                                "target_word": "localiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f56c30a-1797-317a-bf16-d9cb7f4c024b",
                                        "entry_id": "b0b55898-d3c1-388a-872d-98b1eb78f00c",
                                        "glosses": [
                                            "Déterminer avec un certain degré de précision l’emplacement physique de quelqu’un ou quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86475aff-738c-41e5-a877-6fbc8d5ab798",
                                                "sense_id": "0f56c30a-1797-317a-bf16-d9cb7f4c024b",
                                                "text": "Certaines nuits, donc, les murs de la villa de M. et Mᵐᵉ Bourdon se mirent à résonner sous les coups terrifiants d’un esprit frappeur si malin que personne ne put le localiser."
                                            },
                                            {
                                                "example_id": "fd2d6869-4121-4d9b-a25d-021d3bf2bc8d",
                                                "sense_id": "0f56c30a-1797-317a-bf16-d9cb7f4c024b",
                                                "text": "Cet animal s’oriente dans l’espace par écholocation : il émet des sons de très haute fréquence et utilise l’écho renvoyé par les obstacles ou les proies pour les localiser."
                                            },
                                            {
                                                "example_id": "503ff1b1-ccc5-43fb-9e57-729a4a3ad00a",
                                                "sense_id": "0f56c30a-1797-317a-bf16-d9cb7f4c024b",
                                                "text": "Pourquoi le 9-1-1 a été incapable de localiser le président de Cora ?"
                                            },
                                            {
                                                "example_id": "7e919964-1087-4112-9481-4765da49d5e8",
                                                "sense_id": "0f56c30a-1797-317a-bf16-d9cb7f4c024b",
                                                "text": "Les traceurs GPS permettent également aux propriétaires de suivre et de localiser leurs véhicules en cas de vol, facilitant ainsi le travail des forces de l'ordre pour récupérer les voitures dérobées."
                                            },
                                            {
                                                "example_id": "834228af-fe35-4e76-85c9-7b15e7feed54",
                                                "sense_id": "0f56c30a-1797-317a-bf16-d9cb7f4c024b",
                                                "text": "Les déclarations définies au paragraphe 4.2 sont destinées à décrire les performances fonctionnelles de la TIC qui permettent aux individus de localiser, d’identifier et d’utiliser les fonctions de la TIC et d’accéder aux informations fournies, indépendamment de leurs capacités physiques, cognitives ou sensorielles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a08181d8-ce95-3953-9a13-3910d8d81a0c",
                                        "entry_id": "b0b55898-d3c1-388a-872d-98b1eb78f00c",
                                        "glosses": [
                                            "Rapporter à une date."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17eeadc4-15a1-43a5-b63d-1c92101ab47f",
                                                "sense_id": "a08181d8-ce95-3953-9a13-3910d8d81a0c",
                                                "text": "Localiser un fait."
                                            },
                                            {
                                                "example_id": "3a0cea4b-7d0f-4057-9eee-6701dd6c6d78",
                                                "sense_id": "a08181d8-ce95-3953-9a13-3910d8d81a0c",
                                                "text": "Localiser une légende."
                                            },
                                            {
                                                "example_id": "4193a22a-882f-403c-81da-c304c6c0678f",
                                                "sense_id": "a08181d8-ce95-3953-9a13-3910d8d81a0c",
                                                "text": "Localiser un souvenir dans le temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03860757-e1ad-3fa6-8dc7-958da25e4148",
                                        "entry_id": "b0b55898-d3c1-388a-872d-98b1eb78f00c",
                                        "glosses": [
                                            "Circonscrire dans tel ou tel endroit de l’organisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d505e497-6757-4a33-be62-da1120e53057",
                                                "sense_id": "03860757-e1ad-3fa6-8dc7-958da25e4148",
                                                "text": "Localiser une affection morbide."
                                            },
                                            {
                                                "example_id": "0d1b0670-04bb-4dc7-8c8a-d481ca8cf13e",
                                                "sense_id": "03860757-e1ad-3fa6-8dc7-958da25e4148",
