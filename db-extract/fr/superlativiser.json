                ],
                "senses": [
                    {
                        "sense_id": "3915974a-2f85-3578-8ea5-94344df314ac",
                        "entry_id": "eb8a21d8-ddba-380e-b72c-5a7d9e85ba5e",
                        "glosses": [
                            "Donner un caractère superlatif à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18454e6d-417d-4a69-93f2-9bf789dbe66a",
                                "sense_id": "3915974a-2f85-3578-8ea5-94344df314ac",
                                "text": "Ce suffixe -issimum > -isme a servi à superlativiser certains adjectifs qualificatifs seulement, plus particulièrement voués à être employés enfatiquement (saintisme, grandisme, etc.)."
                            },
                            {
                                "example_id": "c55a96c1-f970-44a3-9076-2718b13fb824",
                                "sense_id": "3915974a-2f85-3578-8ea5-94344df314ac",
                                "text": "Pour ma part, je reconnais que je lui dois un fleuve de la même façon que je dois un pays aux gens de Charlevoix qui me racontent leur vie de peine et de misère. Non sans parfois la superlativiser."
                            },
                            {
                                "example_id": "4e1461c9-95f7-42de-a061-26b419af3b24",
                                "sense_id": "3915974a-2f85-3578-8ea5-94344df314ac",
                                "text": "Lorsque j’écris de la sorte, on me catalogue d'insensible, d’inhumain, d’« à-côté-de-mes-pompes » et autres qualificatifs qui peuvent se « superlativiser » à l’infini."
                            }
                        ]
                    }
                ],
