                                        "entry_id": "3f4c2577-f9e2-3b5a-b260-7f21efea3a8c",
                                        "glosses": [
                                            "A chair mounted on large wheels for the transportation or use of a sick or disabled person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "048d3b61-440d-4c80-ae8a-6eb679b132eb",
                                                "sense_id": "c28976d1-d1ce-3b91-8e94-af71f5ab5a52",
                                                "text": "\"And there are aspirations that we must rightly meet - people travelling in a wheelchair should be able to get on and off the train.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ee9d483-f3ea-394b-93f6-c879717ebcf7",
                                        "entry_id": "3f4c2577-f9e2-3b5a-b260-7f21efea3a8c",
                                        "glosses": [
                                            "Designed for use by wheelchairbound people."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f3f0372-900d-3539-bc92-00bdfd12d47d",
                                        "entry_id": "3f4c2577-f9e2-3b5a-b260-7f21efea3a8c",
                                        "glosses": [
                                            "Any device involving wheels designed to assist a non-human animal with locomotion."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c034b92-e2bd-46bd-a870-cc825c897ff9",
                                                "sense_id": "9f3f0372-900d-3539-bc92-00bdfd12d47d",
                                                "text": "To build the wheelchair, Dale Ryder attached wheels from a toy plane to an axle that fits over Mrs. T’s shell."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
