                "senses": [
                    {
                        "sense_id": "5753e1d9-3b56-30eb-b607-cb4b372b41a2",
                        "entry_id": "0c35d0a0-5218-3162-bfd8-4b0f0ab66ab5",
                        "glosses": [
                            "Großunternehmen, das nicht selber produziert, sondern Waren einkauft und diese vertreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91a5d435-09aa-4903-a39a-548cbb8d4719",
                                "sense_id": "5753e1d9-3b56-30eb-b607-cb4b372b41a2",
                                "text": "Der Finanz- und Handelskonzern von Anton Fugger war eines der erfolgreichsten Unternehmen des Mittelalters."
                            },
                            {
                                "example_id": "73c976a0-241d-4925-8b91-508927936c99",
                                "sense_id": "5753e1d9-3b56-30eb-b607-cb4b372b41a2",
                                "text": "Die deutsche Unternehmerfamilie Schmidt-Ruthenbeck hält einen Anteil von 15,77 Prozent am Handelskonzern Metro AG."
                            },
                            {
                                "example_id": "c78fd61c-f6bf-4828-885c-156dbc1c8e20",
                                "sense_id": "5753e1d9-3b56-30eb-b607-cb4b372b41a2",
                                "text": "„Investoren aus Tschechien und der Slowakei wollen den Düsseldorfer Handelskonzern Metro komplett übernehmen.“"
                            },
                            {
                                "example_id": "89385d93-c6f3-46c2-b8a4-3f4137eabc19",
                                "sense_id": "5753e1d9-3b56-30eb-b607-cb4b372b41a2",
                                "text": "„Beim Handelskonzern DKSH räumt Konzernchef Jörg Wolle nach fast zwei Jahrzehnten den Chefsessel.“"
                            },
                            {
                                "example_id": "d0305ea4-8e97-470a-966a-dc45cb503063",
                                "sense_id": "5753e1d9-3b56-30eb-b607-cb4b372b41a2",
                                "text": "„Der Handelskonzern Amazon muss in Luxemburg Steuern nachzahlen.“"
                            },
                            {
                                "example_id": "72e9c04e-61d7-4c2d-ad1d-1abcd7397162",
                                "sense_id": "5753e1d9-3b56-30eb-b607-cb4b372b41a2",
                                "text": "Der Handelskonzern hat sich bislang standhaft gegen Arbeitnehmervertretungen gewehrt."
                            },
                            {
                                "example_id": "abf74286-1eba-4d29-a93c-3fa80a03144a",
                                "sense_id": "5753e1d9-3b56-30eb-b607-cb4b372b41a2",
                                "text": "„Der Handelskonzern übernimmt den Kioskbetreiber Naville für 90 Millionen Franken.“"
                            },
                            {
                                "example_id": "3636c24a-436a-48bc-aa9e-dc91308da16c",
                                "sense_id": "5753e1d9-3b56-30eb-b607-cb4b372b41a2",
                                "text": "[…] „der Hamburger Handelskonzern hat in vielen Gebäuden die Heizung heruntergedreht, um Energie zu sparen.“"
                            },
                            {
                                "example_id": "9e06ab67-b042-491a-be04-d28e8f78adce",
                                "sense_id": "5753e1d9-3b56-30eb-b607-cb4b372b41a2",
                                "text": "„Die Schwarz-Gruppe ist aktuell (2020) nach Jahresumsatz der größte Handelskonzern Europas und beschäftigt ca. 429.000 Mitarbeiter.“"
                            },
                            {
                                "example_id": "7543d5ad-d20d-4eb7-8469-50ef094f1768",
                                "sense_id": "5753e1d9-3b56-30eb-b607-cb4b372b41a2",
                                "text": "„Seither entwickelte sich das Unternehmen zum weltweit führenden Handelskonzern mit dem Hauptgeschäftsanteil im Vertrieb von Befestigungs- und Montagematerial sowie Werkzeugen mit über 125.000 verschiedenen Produkten weiter.“"
                            },
                            {
                                "example_id": "62482ffb-1fba-4faa-a34f-42d113afa6ab",
                                "sense_id": "5753e1d9-3b56-30eb-b607-cb4b372b41a2",
                                "text": "Die Discounterkette gehört einem ausländischen Handelskonzern."
                            },
                            {
                                "example_id": "2ec874d2-65e4-4dca-ab00-9e36b1922622",
                                "sense_id": "5753e1d9-3b56-30eb-b607-cb4b372b41a2",
                                "text": "„Noch immer liefern sich die beiden global agierenden Handelskonzerne erbitterte Preisschlachten.“"
                            },
                            {
                                "example_id": "be18a687-2176-4bce-9fd4-0c12f8d96e65",
                                "sense_id": "5753e1d9-3b56-30eb-b607-cb4b372b41a2",
                                "text": "„Schließlich baut der Handelskonzern mit 550.000 Mitarbeitern in 32 Ländern eine eigene Flotte von Container-Schiffen auf.“"
                            },
                            {
                                "example_id": "f5550a98-0cf3-415f-9255-0f556d225f19",
                                "sense_id": "5753e1d9-3b56-30eb-b607-cb4b372b41a2",
                                "text": "„Die Hausdurchsuchungen bei Spar im Vorjahr haben für den Handelskonzern jetzt unangenehme Folgen: Das Kartellgericht verurteilte Spar am Mittwoch wegen Preisabsprachen zu einer Bußgeldzahlung in der Höhe von drei Millionen Euro.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
