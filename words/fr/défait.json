                {
                    "sense_id": "065570b9-f405-3ae7-a4b9-c27fe8a602b8",
                    "sense_definition": "Participe passé masculin singulier de <w>défaire</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a rapidement <w>défait</w> ses valises dès son arrivée dans la chambre d'hôtel.",
                            "target_lang_translations": {
                                "en": "He quickly <w>unpacked</w> his suitcases as soon as he arrived in the hotel room.",
                                "ru": "Он быстро <w>распаковал</w> чемоданы сразу по приезде в гостиничный номер.",
                                "de": "Er hat seine Koffer gleich nach der Ankunft im Hotelzimmer schnell <w>ausgepackt</w>.",
                                "es": "Ha <w>deshecho</w> rápidamente sus maletas nada más llegar a la habitación del hotel.",
                                "zh": "他一到酒店房间就迅速<w>打开</w>了行李箱。"
                            }
                        },
                        {
                            "text": "Le vent violent a complètement <w>défait</w> la coiffure soignée de la jeune fille.",
                            "target_lang_translations": {
                                "en": "The strong wind has completely <w>undone</w> the young girl's neat hairstyle.",
                                "ru": "Сильный ветер полностью <w>растрепал</w> аккуратную причёску девушки.",
                                "de": "Der heftige Wind hat die sorgfältige Frisur des jungen Mädchens völlig <w>zerzaust</w>.",
                                "es": "El fuerte viento ha <w>deshecho</w> por completo el peinado arreglado de la joven.",
                                "zh": "猛烈的风把少女精心梳理的发型完全<w>吹乱</w>了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past participle, masculine singular, of the verb défaire.",
                        "ru": "Причастие прошедшего времени мужского рода единственного числа от глагола défaire.",
                        "de": "Partizip Perfekt, maskulin Singular, des Verbs »défaire«.",
                        "es": "Forma masculina singular del participio pasado del verbo «défaire».",
                        "zh": "动词défaire的阳性单数过去分词，表示被解开、打开或拆散。"
                    },
                    "translations": {
