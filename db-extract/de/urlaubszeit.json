                    {
                        "sense_id": "e81c39e1-2003-3cfe-a040-053c4e666b46",
                        "entry_id": "f313fef3-23eb-3402-83cf-c4f4436f5e28",
                        "glosses": [
                            "Zeit, in der Urlaub gemacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4580a2cc-67c5-4b19-9d69-d6587c27d1c9",
                                "sense_id": "e81c39e1-2003-3cfe-a040-053c4e666b46",
                                "text": "„Deswegen sparten die Sachalinbewohner ihre Urlaubstage an und sammelten Urlaubszeit, wie man anderswo Briefmarken sammelt.“"
                            },
                            {
                                "example_id": "aaf0a8ed-a26d-4e11-bddd-1b26822d0287",
                                "sense_id": "e81c39e1-2003-3cfe-a040-053c4e666b46",
                                "text": "„Ebenso wie früher hauste Rostow mit Denissow zusammen, und die Freundschaft, die beide verband, war seit ihrer Urlaubszeit noch enger geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
