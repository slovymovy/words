                ],
                "senses": [
                    {
                        "sense_id": "8673ddb7-31f7-3825-b0e7-14013eb4adb9",
                        "entry_id": "cdf6cb5f-1b51-3b4d-9698-b8f509a29ade",
                        "glosses": [
                            "Hauteur du corps d’une personne ou d’un animal (dressé sur ses pattes postérieures)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1c8cb48-a485-4f11-9926-f8cffd7c7060",
                                "sense_id": "8673ddb7-31f7-3825-b0e7-14013eb4adb9",
                                "text": "Bakounine était d’une colossale stature, encore que son embonpoint fût évidemment dû à sa maladie."
                            },
                            {
                                "example_id": "e82fdfba-dfb0-4bf5-a0a8-96cf0447977e",
                                "sense_id": "8673ddb7-31f7-3825-b0e7-14013eb4adb9",
                                "text": "La haute stature de ces hommes, leurs épaules arrondies, leur démarche lourde, leurs énormes favoris, les longues redingotes qui les couvraient, tout attirait l’attention de Julien."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5944085-411c-36d7-a41a-d10fbb702121",
                        "entry_id": "cdf6cb5f-1b51-3b4d-9698-b8f509a29ade",
                        "glosses": [
                            "Capacité à se tenir droit, debout."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "dfba56d1-e6aa-3b5c-a767-c65960eaa627",
                        "entry_id": "cdf6cb5f-1b51-3b4d-9698-b8f509a29ade",
                        "glosses": [
                            "Dimension et élévation morale d’une personne, d’un groupe."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "237a6974-2864-4b7c-baf5-cfe338db45df",
                                "sense_id": "dfba56d1-e6aa-3b5c-a767-c65960eaa627",
                                "text": "Si des centaines d’officiers jouent un rôle majeur au sein de forces armées ukrainiennes, tant les commandants du front sont incités à faire preuve d’esprit d’initiative, trois hommes se sont forgés en l’espace d’un an une stature de héros aussi respectés dans l’armée que dans la société ukrainienne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
