                },
                {
                    "sense_id": "ad0d27ad-5b84-3d1b-88d9-2a2a676b5d7c",
                    "sense_definition": "een aangename, goede smaak hebben",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "smaakbeleving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Smaakt</w> het eten u een beetje?",
                            "target_lang_translations": {
                                "en": "Are you <w>enjoying</w> the food?",
                                "ru": "Вам <w>нравится</w> еда?"
                            }
                        },
                        {
                            "text": "De verse aardbeien <w>smaken</w> heerlijk in de zomer.",
                            "target_lang_translations": {
                                "en": "The fresh strawberries <w>taste</w> delicious in the summer.",
                                "ru": "Свежая клубника летом просто <w>объедение</w>."
                            }
                        }
