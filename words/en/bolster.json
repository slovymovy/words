                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government plans to <w>bolster</w> the economy with new tax incentives.",
                            "target_lang_translations": {
                                "zh": "政府计划通过新的税收激励措施来<w>加强</w>经济。"
                            }
