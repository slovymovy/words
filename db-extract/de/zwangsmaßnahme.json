                        "glosses": [
                            "Handlung, mit der eine Person gegen ihren Willen zu etwas gezwungen wird/werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7530b608-5750-4f64-9573-ad80bcac463c",
                                "sense_id": "930ee037-e1b2-3836-bf2e-38f4fccd4d79",
                                "text": "„Sie protestierte in Roberts Namen gegen die Zwangsmaßnahmen und versuchte, bei den Ärzten für ihn Verständnis zu wecken.“"
                            },
                            {
                                "example_id": "0679b64c-348f-4304-8f24-c505c10e6636",
                                "sense_id": "930ee037-e1b2-3836-bf2e-38f4fccd4d79",
                                "text": "„Die sogenannten Landverbesserungsmaßnahmen fielen in die Verantwortung des Native Affairs Department, das zu Zwangsmaßnahmen und Schikanen gegenüber den afrikanischen Bauern griff, vom fehlenden Taktgefühl vieler Native Commissioners ganz zu schweigen.“"
                            }
