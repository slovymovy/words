                "translations": [
                    {
                        "translation_id": "8281532e-e658-4f40-b45b-e080d1fcecf6",
                        "source_entry_id": "278ffc0b-8a3e-3ae1-b2a2-58ef2982a0dd",
                        "source_sense_id": "29667191-9fb2-36ab-b990-809a6e429244",
                        "source_sense_description": "Produced from two breeds, varieties or species",
                        "target_lang_word": "croisé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "croisé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f43cc30-f962-3fee-bc88-37347052a137",
                                        "entry_id": "8e5f5bf0-fe59-3ab5-96dd-d07896ca79e6",
                                        "glosses": [
                                            "Qualifie des choses qui se recouvrent en croix, ou approximativement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3a9615a-bee8-4f7b-93e4-964750859c83",
                                                "sense_id": "4f43cc30-f962-3fee-bc88-37347052a137",
                                                "text": "Un livre à demi ouvert sur mes genoux croisés, je suis assis devant la cheminée, où flambe le premier feu de la saison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24568490-1348-31de-a8f8-3651fbf7bdb0",
                                        "entry_id": "8e5f5bf0-fe59-3ab5-96dd-d07896ca79e6",
                                        "glosses": [
                                            "Qualifie un câble dont les différents fils sont intervertis entre les extrémités, par opposition à droit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05d05393-b327-4838-997c-4593e46b272d",
                                                "sense_id": "24568490-1348-31de-a8f8-3651fbf7bdb0",
                                                "text": "Un câble RJ45 croisé"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8efb93f3-36bd-3d9e-b251-74d9ac5c2acc",
                                        "entry_id": "8e5f5bf0-fe59-3ab5-96dd-d07896ca79e6",
                                        "glosses": [
                                            "Qui provient d’un croisement."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "235ae6c9-802b-4088-8566-2295a583207c",
                                                "sense_id": "8efb93f3-36bd-3d9e-b251-74d9ac5c2acc",
                                                "text": "La chanson que nous avons citée plus haut : « Le roi Loys est sur son pont » a été composée sur un des plus beaux airs qui existent ; c’est comme un chant d’église croisé par un chant de guerre."
                                            },
                                            {
                                                "example_id": "c3a2af8f-ea19-429c-8521-e4cf353b486c",
                                                "sense_id": "8efb93f3-36bd-3d9e-b251-74d9ac5c2acc",
                                                "text": "Le chien croisé est issu de chiens standardisés (race ou type) et identifiables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e22f5a7a-1b58-381f-97bb-f68b49d8eafb",
                                        "entry_id": "8e5f5bf0-fe59-3ab5-96dd-d07896ca79e6",
                                        "glosses": [
                                            "Que l’on rencontre chez l'un si elle existe chez l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f403b296-741c-4371-bde5-8e7c46ed56f9",
                                                "sense_id": "e22f5a7a-1b58-381f-97bb-f68b49d8eafb",
                                                "text": "Cependant, plus récemment, il a été rapporté que certains biotypes résistants à l’isoproturon montrent une résistance croisée au diclofop-méthyl (Kirwood et al. 1997) et probablement au clodinafop-propargyl (Singh et al. 1997b, […]) sans qu'ils soient préalablement utilisé dans le champ, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d0eb491-057d-3a56-aa75-dcfbdd7156bf",
                                        "entry_id": "8e5f5bf0-fe59-3ab5-96dd-d07896ca79e6",
                                        "glosses": [
                                            "Se dit de rimes lorsqu’elles suivent l’alternance ABAB."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad58ad4d-deb2-316a-b9ab-97da31bbf45e",
                                        "entry_id": "8e5f5bf0-fe59-3ab5-96dd-d07896ca79e6",
                                        "glosses": [
                                            "Relatif à Croix-lez-Rouveroy en Belgique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "croisé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1207440f-79f4-3913-8e83-5ebea8c7c073",
                                        "entry_id": "7e5cd9dd-07ab-35c9-bb89-2c9993f986bf",
                                        "glosses": [
                                            "Chrétien qui, au Moyen Âge, prenait la croix et partait pour la croisade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ee0b07f-f4a7-46fc-bad5-d4a936f14842",
                                                "sense_id": "1207440f-79f4-3913-8e83-5ebea8c7c073",
                                                "text": "Souvenons-nous aussi, messieurs, que nos croisés s’étaient laissé distraire, en passant, par la fantaisie de s’asseoir tout éperonnés sur le trône impérial de Constantinople."
                                            },
                                            {
                                                "example_id": "210e8029-2fdf-4f7e-be71-beff9f635c84",
                                                "sense_id": "1207440f-79f4-3913-8e83-5ebea8c7c073",
                                                "text": "Il portait au côté une épée sainte, relique d’un vieux croisé qui avait pris Constantinople avec Ville-Hardouin et Beaudoin de Flandre."
                                            },
                                            {
                                                "example_id": "476edbc3-20b0-471f-b6f6-d11881287087",
                                                "sense_id": "1207440f-79f4-3913-8e83-5ebea8c7c073",
                                                "text": "Palestine ! répéta le Saxon, Palestine ! Combien d’oreilles s’ouvrent aux histoires que des croisés dissolus ou des pèlerins hypocrites apportent de cette terre fatale !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c0a7676-c031-39b8-bc60-4bbbcce516ef",
                                        "entry_id": "7e5cd9dd-07ab-35c9-bb89-2c9993f986bf",
                                        "glosses": [
                                            "Un de ceux qui se croisèrent contre les Albigeois."
                                        ],
                                        "tags": [
                                            "Histoire de France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d9c1242-d291-4521-96e6-e99a5b1f949e",
                                                "sense_id": "5c0a7676-c031-39b8-bc60-4bbbcce516ef",
                                                "text": "Les défenseurs, après avoir perdu les faubourgs, manquant d’eau, furent obligés de capituler. Le siège entrepris par l’armée des croisés ne dura que du 1ᵉʳ au 15 août, jour de la reddition de la place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50a61ea5-8f1f-3b3c-839a-84f186a26837",
                                        "entry_id": "7e5cd9dd-07ab-35c9-bb89-2c9993f986bf",
                                        "glosses": [
                                            "Personne engagée dans une lutte, un combat."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be94d4e7-42b3-4473-8adc-88fbe056c087",
                                                "sense_id": "50a61ea5-8f1f-3b3c-839a-84f186a26837",
                                                "text": "Il existe aux États-Unis une entreprise de mort plus ancienne encore, ironiquement baptisée « Droit à la vie » ; elle est le fait de croisés plus communément connus sous le nom de militants anti-avortement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6935ac5c-6319-3372-9c6f-84d23c876b54",
                                        "entry_id": "7e5cd9dd-07ab-35c9-bb89-2c9993f986bf",
                                        "glosses": [
                                            "Dans des traductions de l’arabe, ennemi supposé des terroristes djihadistes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4237ce24-8a87-413f-99cc-ddc0bcdd92c1",
                                                "sense_id": "6935ac5c-6319-3372-9c6f-84d23c876b54",
                                                "text": "Les « soldats du Califat » ont réussi à faire tomber un avion russe dans la province du Sinaï transportant plus de 220 « croisés » qui ont tous été tués."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e824857-1d97-307f-8240-b887f76f0477",
                                        "entry_id": "7e5cd9dd-07ab-35c9-bb89-2c9993f986bf",
                                        "glosses": [
                                            "Spécimen qui provient d’un croisement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50578b0d-41b9-30b3-ad86-60080422a0dc",
                                        "entry_id": "7e5cd9dd-07ab-35c9-bb89-2c9993f986bf",
                                        "glosses": [
                                            "Coup qui rebondit dans la moitié opposée du camp adverse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "croisé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c192ae64-a691-38cd-8d03-75e56083f7b2",
                                        "entry_id": "4222a15b-fac1-3e36-aff8-fb453568e24b",
                                        "glosses": [
