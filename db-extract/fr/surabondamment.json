                "senses": [
                    {
                        "sense_id": "3d509c96-821a-3833-b4a8-3e0b79919a9e",
                        "entry_id": "263e03bf-ec2c-3f90-94a1-666cfb6b72c2",
                        "glosses": [
                            "D’une manière surabondante ; plus que suffisamment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7000d49-2cbf-4da3-8750-f8bb1c9734b0",
                                "sense_id": "3d509c96-821a-3833-b4a8-3e0b79919a9e",
                                "text": "Les manuscrits originaux de Camille Desmoulins, utilisés sans doute par Matton aîné, constituent une importante liasse de la Bibliothèque de la Ville de Paris. Il prouvent surabondamment que Camille Desmoulins a rédigé le numéro VII du Vieux Cordelier."
                            },
                            {
                                "example_id": "b16eb295-11e1-4c48-81c8-7b4e32656550",
                                "sense_id": "3d509c96-821a-3833-b4a8-3e0b79919a9e",
                                "text": "Nous avons, comme les sourds-muets, un langage par gestes, dont la nécessité vous sera bientôt et surabondamment démontrée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "832d9afe-9e24-42aa-beca-6f8c4caa29d6",
                        "source_entry_id": "263e03bf-ec2c-3f90-94a1-666cfb6b72c2",
                        "source_sense_id": "3d509c96-821a-3833-b4a8-3e0b79919a9e",
                        "target_lang_word": "abundantly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abundantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5a72d95-590f-3298-ac29-b45e00ebb098",
                                        "entry_id": "7c4a6d2d-826a-37f9-a989-4fd4518a6d53",
                                        "glosses": [
                                            "In an abundant manner; in a sufficient degree; in large measure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04a2ec9b-968e-42e9-866e-b32e9fe0288c",
                                                "sense_id": "d5a72d95-590f-3298-ac29-b45e00ebb098",
                                                "text": "And God said, Let the waters bring foorth aboundantly the mouing creature that hath life, and foule that may flie aboue the earth in the open firmament of heauen."
                                            },
                                            {
                                                "example_id": "173e0071-7aeb-4c60-bc64-8474a5a24fab",
                                                "sense_id": "d5a72d95-590f-3298-ac29-b45e00ebb098",
                                                "text": "When strata are so unsymmetrically and abundantly folded that it becomes difficult or impossible to trace out the individual flexures and crumplings — the whole forming an irregular complex of folds — they are said to be contorted […]"
                                            },
                                            {
                                                "example_id": "022e5752-c5b2-4207-96ce-1064e5a53cca",
                                                "sense_id": "d5a72d95-590f-3298-ac29-b45e00ebb098",
                                                "text": "Hodgson also has Wayne Rooney to call on once he has served a two-match suspension at the start of the tournament - and it is abundantly clear England will rely as heavily as ever on his ability to shape the outcome of important games."
                                            },
                                            {
                                                "example_id": "56672de7-f7e7-4ef3-a799-978bb9b8065e",
                                                "sense_id": "d5a72d95-590f-3298-ac29-b45e00ebb098",
                                                "text": "Indian English is today one of the most widespread and abundantly used varieties of English, in extensive use not only throughout South Asia but in virtually every corner of the globe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acbf7f84-7531-3e99-a2ed-6b2319f59ed9",
                                        "entry_id": "7c4a6d2d-826a-37f9-a989-4fd4518a6d53",
                                        "glosses": [
                                            "Extremely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ae429f-ab2a-42e0-bd4e-d548821a6f9c",
                                                "sense_id": "acbf7f84-7531-3e99-a2ed-6b2319f59ed9",
                                                "text": "The explosion, in other words, was unexpected, powerful, and politically diffuse; it vented sharp African frustrations with the colonial situation, but had no readily visible leadership or political goals; it made abundantly obvious the need to speed the pace of self-government"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
