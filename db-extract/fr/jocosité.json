                        "examples": [
                            {
                                "example_id": "1bb625c0-de76-4e70-ae1a-bcfdd5b2bc19",
                                "sense_id": "cc1a7aff-7895-338e-8ef1-72be4cf1ecb1",
                                "text": "Cher adoré toute cette dépense de jocosité bête dissimule une profonde joie. un grand attendrissement et un bonheur sans borne comme mon amour."
