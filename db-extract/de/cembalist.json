                        "sense_id": "fb304640-5345-3948-aacc-9227780a6475",
                        "entry_id": "accf0d36-021d-390f-b5b6-f9ed095bbc71",
                        "glosses": [
                            "(männliche^☆) Person, die Cembalo spielt"
