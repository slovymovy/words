                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "eb71912d-a522-4a92-9589-e4c280cf172c",
                                "sense_id": "e901a368-79b7-34e2-85cc-70ccda465699",
                                "text": "Heart of lion! sound the beme!\nSound it into inner lands; […]"
                            },
                            {
                                "example_id": "1f01a4f2-0798-4c2f-8d9b-9764f8dce4dc",
                                "sense_id": "e901a368-79b7-34e2-85cc-70ccda465699",
                                "text": "One of the long, curved horns was known as a beme and shows up as the instrument of choice blown by angels announcing the Biblical Day of Judgment."
                            },
                            {
                                "example_id": "40092d56-43db-41e1-9011-7c9d2025ee59",
                                "sense_id": "e901a368-79b7-34e2-85cc-70ccda465699",
                                "text": "And when the host on both parties saw that sword drawn, then they blew bemes, trumpets, and horns, and shouted grimly, and so both hosts dressed them together."
                            },
                            {
                                "example_id": "4cf8ef0a-7b5d-4091-b931-e7a4cca86c08",
                                "sense_id": "e901a368-79b7-34e2-85cc-70ccda465699",
                                "text": "[…] be inserted directly into each other to make the long, straight beme or trompe."
                            }
                        ]
                    }
