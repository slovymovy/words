                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used metaphorically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находиться в состоянии сильной тревоги, гнева или подавленной обиды.",
                        "zh": "处于焦虑、愤怒或压抑的怨恨状态中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вариться в собственном соку",
                                "target_lang_sense_clarification": "переживать в одиночестве"
                            },
