{
    "word_family": [
        "faux",
        "fausseté",
        "faussaire",
        "faussement",
        "fausset"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3a2e2e13-985d-31f9-8d86-3b2fbeea890b",
                    "sense_definition": "Altérer des données, des résultats ou des règles de manière à les rendre inexacts ou biaisés.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alteration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette erreur de calcul risque de <w>fausser</w> tous les résultats de l'étude scientifique."
                        },
                        {
                            "text": "L'injection de ces fonds publics risque de <w>fausser</w> la concurrence entre les entreprises locales."
                        }
                    ],
                    "synonyms": [
                        "altérer"
                    ],
                    "common_phrases": [
                        "fausser les résultats",
                        "fausser le jeu",
                        "fausser la concurrence"
                    ]
                },
                {
                    "sense_id": "2ba03147-647d-3cb6-a49c-6c0d941551dd",
                    "sense_definition": "Déformer mécaniquement un objet métallique de manière à compromettre son fonctionnement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En forçant sur la serrure bloquée, il a fini par <w>fausser</w> la clé de la porte d'entrée."
                        },
                        {
                            "text": "Le violent choc contre le trottoir a complètement <w>faussé</w> la roue avant de ma bicyclette."
                        }
                    ],
                    "common_phrases": [
                        "fausser une clé",
                        "fausser une serrure"
                    ]
                },
                {
                    "sense_id": "35591bd9-4a71-34bf-ba8f-1afc52027290",
                    "sense_definition": "Quitter discrètement ou brusquement une personne ou un groupe, ou manquer à ses devoirs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eloignement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fatigué par cette longue réception, il a décidé de <w>fausser</w> compagnie à ses hôtes sans faire de bruit."
                        },
                        {
                            "text": "Le prisonnier a profité de la nuit pour <w>fausser</w> compagnie à ses gardiens distraits."
                        }
                    ],
                    "common_phrases": [
                        "fausser compagnie"
                    ]
                },
                {
                    "sense_id": "43fbb352-621c-3013-8493-e04046b0e0e2",
                    "sense_definition": "Falsifier ou contrefaire délibérément quelque chose pour tromper.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "alteration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les observateurs internationaux craignent que des fraudes ne viennent <w>fausser</w> le scrutin présidentiel."
                        },
                        {
                            "text": "Le comptable a été condamné pour avoir tenté de <w>fausser</w> les bilans annuels de la société."
                        }
                    ],
                    "synonyms": [
                        "falsifier",
                        "déguiser"
                    ],
                    "common_phrases": [
                        "fausser un document",
                        "fausser le vote"
                    ]
                },
                {
                    "sense_id": "808fbdea-fc6e-3d50-80d1-3131b068bb02",
                    "sense_definition": "Interpréter de manière erronée ou dénaturer le sens de quelque chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "alteration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses préjugés culturels finissent par <w>fausser</w> son jugement sur cette situation complexe."
                        },
                        {
                            "text": "En sortant ces propos de leur contexte, le polémiste a complètement <w>faussé</w> la pensée de l'auteur."
                        }
                    ],
                    "synonyms": [
                        "dénaturer",
                        "corrompre"
                    ],
                    "common_phrases": [
                        "fausser le sens",
                        "fausser le jugement"
                    ]
                },
                {
                    "sense_id": "a9217925-3c30-3739-91a5-42f36774942c",
                    "sense_definition": "Rendre une voix ou un instrument de musique incapable d'émettre des sons justes.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une mauvaise technique vocale a fini par lui <w>fausser</w> la voix de façon irrémédiable."
                        },
                        {
                            "text": "L'humidité persistante dans cette vieille salle de répétition a complètement <w>faussé</w> les instruments à cordes."
                        }
                    ],
                    "common_phrases": [
                        "fausser la voix"
                    ]
                }
            ]
        }
    ]
}