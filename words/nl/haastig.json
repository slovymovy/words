    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5227180f-7072-3f1f-84f6-d091879178f2",
                    "sense_definition": "met veel spoed gedaan of gebeurend, vaak zonder de nodige tijd of aandacht te nemen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spoed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een <w>haastige</w> beslissing kan later voor grote problemen zorgen.",
                            "target_lang_translations": {
                                "en": "A <w>hasty</w> decision can cause major problems later on."
                            }
                        },
                        {
                            "text": "Hij wierp een <w>haastige</w> blik op zijn horloge en rende naar de trein.",
                            "target_lang_translations": {
                                "en": "He cast a <w>hurried</w> glance at his watch and ran to the train."
                            }
                        }
                    ],
                    "synonyms": [
                        "jachtig",
                        "schielijk"
                    ],
                    "antonyms": [
                        "kalm",
                        "rustig",
                        "beheerst"
                    ],
                    "common_phrases": [
                        "haastige spoed",
                        "haastige blik",
                        "haastige beslissing"
                    ],
                    "target_lang_definitions": {
                        "en": "done or happening with great speed, often without taking the necessary time or attention"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hasty",
                                "target_lang_sense_clarification": "done too quickly without enough thought"
                            },
                            {
                                "target_lang_word": "hurried",
                                "target_lang_sense_clarification": "done in a rush"
                            },
                            {
                                "target_lang_word": "quick",
                                "target_lang_sense_clarification": "brief and rapid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3dca2d0-6e97-3ab0-b02f-f5f3a0ccd811",
                    "sense_definition": "onbezonnen of impulsief handelen zonder eerst goed na te denken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impulsief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>haastige</w> reactie kwetste zijn vrienden, hoewel hij het niet zo bedoelde.",
                            "target_lang_translations": {
                                "en": "His <w>rash</w> reaction hurt his friends, even though he didn't mean it that way."
                            }
                        },
                        {
                            "text": "Wees niet te <w>haastig</w> met het oordelen over anderen.",
                            "target_lang_translations": {
                                "en": "Don't be too <w>hasty</w> in judging others."
                            }
                        }
                    ],
                    "synonyms": [
                        "jachtig"
                    ],
                    "antonyms": [
                        "bedachtzaam"
                    ],
                    "common_phrases": [
                        "te haastig oordelen"
                    ],
                    "target_lang_definitions": {
                        "en": "acting recklessly or impulsively without thinking things through first"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hasty",
                                "target_lang_sense_clarification": "acting too quickly or rashly"
                            },
                            {
                                "target_lang_word": "rash",
                                "target_lang_sense_clarification": "impulsive and without consideration"
                            },
                            {
                                "target_lang_word": "impulsive",
                                "target_lang_sense_clarification": "acting on a sudden whim"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0b547dd-87bc-3b26-b43d-8096ada6b2ef",
                    "sense_definition": "snel geërgerd of prikkelbaar zijn",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man was een beetje <w>haastig</w> en kon slecht tegen lawaai.",
                            "target_lang_translations": {
                                "en": "The old man was a bit <w>short-tempered</w> and couldn't stand noise."
                            }
                        },
                        {
                            "text": "Door het slaapgebrek werd zij erg <w>haastig</w> tegen haar collega's.",
                            "target_lang_translations": {
                                "en": "Due to the lack of sleep, she became very <w>irritable</w> with her colleagues."
                            }
                        }
                    ],
                    "antonyms": [
                        "geduldig"
                    ],
                    "target_lang_definitions": {
                        "en": "being easily annoyed or irritable"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "short-tempered",
                                "target_lang_sense_clarification": "getting angry or annoyed easily"
                            },
                            {
                                "target_lang_word": "irritable",
                                "target_lang_sense_clarification": "easily frustrated or annoyed"
                            },
                            {
                                "target_lang_word": "hasty",
                                "target_lang_sense_clarification": "having an irascible temperament"
                            }
                        ]
                    }
                }
            ]
        }
    ]
