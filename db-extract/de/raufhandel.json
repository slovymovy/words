                                    },
                                    {
                                        "sense_id": "ef3a2729-9f55-3ff3-bb38-267bafb4b915",
                                        "entry_id": "155fe3a5-d1d6-3c3b-957e-3a7a8a0d5aa8",
                                        "glosses": [
                                            "Alternative form of branle (“dance of French origin dating from the 16th century, performed by couples in a circle or a line; the music for this dance”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e678249e-fea6-4949-a017-a8dde801701d",
                                                "sense_id": "ef3a2729-9f55-3ff3-bb38-267bafb4b915",
                                                "text": "Boy. Maiſter, will you win your loue with a french braule? / Brag[gart]. How meaneſt thou? brawling in French. / Boy. No my complet Maiſter, but to Iigge off a tune at the tongues ende, canarie to it with your feete, humour it with turning vp your eylids, ſigh a note and ſing a note ſomtime through the throate, if you ſwallowed loue with ſinging loue [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
