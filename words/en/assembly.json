                    "sense_definition": "The specific name for the lower house of the legislature in several U.S. states.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "government",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The California State <w>Assembly</w> is currently debating the new environmental bill.",
                            "target_lang_translations": {
                                "ru": "<w>Ассамблея</w> штата Калифорния в настоящее время обсуждает новый законопроект об охране окружающей среды."
                            }
                        },
                        {
                            "text": "She was elected to the Nevada <w>Assembly</w> after serving on the city council.",
                            "target_lang_translations": {
                                "ru": "Она была избрана в <w>законодательное собрание</w> Невады после работы в городском совете."
                            }
                        }
                    ],
                    "common_phrases": [
                        "state assembly"
