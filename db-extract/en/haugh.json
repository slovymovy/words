                "senses": [
                    {
                        "sense_id": "3be86da3-661d-3077-8517-15e084f99a60",
                        "entry_id": "ea74ac1f-63cb-356b-b72f-5757885d2a30",
                        "glosses": [
                            "A low-lying meadow by the side of a river."
                        ],
                        "tags": [
                            "Ireland",
                            "Northern-England",
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "a7391d51-00ee-41cc-bb89-e6a7f59fcd9a",
                                "sense_id": "3be86da3-661d-3077-8517-15e084f99a60",
                                "text": "The sheriff of the county of Lanark was holding the wappen-schaw of a wild district, called the Upper Ward of Clydesdale, on a haugh, or level plain, near to a royal borough, […]"
                            },
                            {
                                "example_id": "920fa8ee-bd5c-409c-a9c0-ffcf0e071a50",
                                "sense_id": "3be86da3-661d-3077-8517-15e084f99a60",
                                "text": "The position of the playfield is here identified as lying north of this open space between it and the burn, and occupying the haugh which extended west […]"
                            },
                            {
                                "example_id": "a8298994-1fde-4416-94e7-e11936a1edc3",
                                "sense_id": "3be86da3-661d-3077-8517-15e084f99a60",
                                "text": "The cattle had […] loved their life in the haughs of Echt, south there across the uncouthy hills was a world cold and unchancy."
                            },
                            {
                                "example_id": "e7d97e19-aaee-44e0-9b9b-d3d6da68b3fd",
                                "sense_id": "3be86da3-661d-3077-8517-15e084f99a60",
                                "text": "It was sung from the top of the oldest house in the burgh every June at the Common riding, which served both for a perambulation of the bounds of the common pastures or Haughs and to commemorate the young men of Harwick[.]"
                            }
                        ]
                    }
