                        "entry_id": "24f55f67-57bb-3e53-8b51-973ebae819cb",
                        "glosses": [
                            "Insecte sauteur de l’ordre des orthoptères, à antennes courtes et élytres longs ou courts selon les espèces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30ebdaa0-50ab-46fd-b8ab-aaa7dfad9a88",
                                "sense_id": "85d68954-0a34-32ea-9846-ad3d328ff9ce",
                                "text": "Le criquet est un acridien."
                            },
                            {
                                "example_id": "c80b595c-3d79-4318-8578-659f59931a14",
                                "sense_id": "85d68954-0a34-32ea-9846-ad3d328ff9ce",
                                "text": "J’en connais un autre qui a fait paraître en 1900 une étude sur le « mécanisme de la digestion chez les acridiens…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c10b0be-4d4c-470a-99d4-ed8b2ae590f1",
                        "source_entry_id": "24f55f67-57bb-3e53-8b51-973ebae819cb",
                        "source_sense_id": "85d68954-0a34-32ea-9846-ad3d328ff9ce",
                        "target_lang_word": "Heuschrecken-",
