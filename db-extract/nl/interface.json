                                        "entry_id": "9a8b5a7f-d0ab-3d3b-b0c2-c79869f4c7ff",
                                        "glosses": [
                                            "Interface réseau, généralement un port RJ45."
                                        ],
                                        "tags": [
                                            "ellipsis"
