                "entry_id": "8e16a644-6e81-3e5e-88db-7807c6d419a6",
                "word": "toileted",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2d188d90-4891-3d15-a581-7b5626f83371",
                        "entry_id": "8e16a644-6e81-3e5e-88db-7807c6d419a6",
                        "glosses": [
                            "Having a toilet."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "da0e3388-ed4c-42e8-bce2-aacc290a445b",
                                "sense_id": "2d188d90-4891-3d15-a581-7b5626f83371",
                                "text": "He thought that the people who had fed him rich foods, driven him about in new cars and opened up their majestically toileted homes to him were living expensively, even greedily, in a fool’s paradise."
                            },
                            {
                                "example_id": "b0aa60b3-7662-4c2b-8878-f0757501c423",
                                "sense_id": "2d188d90-4891-3d15-a581-7b5626f83371",
                                "text": "Excessively toileted houses, Keynes noted, tend to require walls and gates and private guards to protect the porcelain treasure."
                            },
                            {
                                "example_id": "f2a17c84-69ac-434d-b28a-0a77f89271a1",
                                "sense_id": "2d188d90-4891-3d15-a581-7b5626f83371",
                                "text": "All toileted buildings must meet applicable accessibility standards."
                            },
                            {
                                "example_id": "c199236d-2ca9-48e1-b9e3-46a98028357b",
                                "sense_id": "2d188d90-4891-3d15-a581-7b5626f83371",
                                "text": "Then they could sit in their new toileted homes and watch the old-fashioned extroversion of such places on Coronation Street."
                            },
                            {
                                "example_id": "939ca7d7-2b72-4f72-afc3-530a6406d606",
                                "sense_id": "2d188d90-4891-3d15-a581-7b5626f83371",
                                "text": "Paradoxically, open defecation areas were less polluted than densely toileted areas."
                            }
                        ]
                    }
