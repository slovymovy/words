                                            {
                                                "example_id": "f12fdcf1-0529-4e3f-be9d-98928cb5ebca",
                                                "sense_id": "ad1a2e32-ec04-3786-b6ed-ce04a9562d14",
                                                "text": "Auf unbarmherzige Art trennte sie sich von ihrem Partner."
