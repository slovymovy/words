                        "sense_id": "9800cff3-eb5f-3438-ad6c-fd03c0d14bd4",
                        "entry_id": "10ced24d-7272-3caa-b2dd-c13cb5f43363",
                        "glosses": [
                            "To bind (someone) by pledge or security; to engage."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1a090339-e67d-409e-83aa-2e3331f87fb2",
                                "sense_id": "9800cff3-eb5f-3438-ad6c-fd03c0d14bd4",
                                "text": "Great debts / Wherein my time, sometimes too prodigal, / Hath left me gaged."
                            }
                        ]
                    },
                    {
                        "sense_id": "68713ecf-8e2c-3b91-bc77-3e4d3d52da4f",
                        "entry_id": "10ced24d-7272-3caa-b2dd-c13cb5f43363",
                        "glosses": [
                            "To bet or wager (something)."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "73d92dfc-97f3-415a-9591-60a75c485ea6",
                                "sense_id": "68713ecf-8e2c-3b91-bc77-3e4d3d52da4f",
                                "text": "O doe not goe, this feaſt (I'le gage my life) / Is but a plot to trayne you to your ruine, / Be rul'd, you ſha'not goe."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d6d8521-e94c-31d0-a98a-1b06b9c82cd5",
                        "entry_id": "10ced24d-7272-3caa-b2dd-c13cb5f43363",
                        "glosses": [
                            "To deposit or give (something) as a pledge or security; to pawn."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a387bd4a-02a6-4883-8a0a-5626b455e483",
                                "sense_id": "7d6d8521-e94c-31d0-a98a-1b06b9c82cd5",
                                "text": "A moiety competent / Was gaged by our king."
                            }
                        ]
                    }
