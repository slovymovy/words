                                            {
                                                "example_id": "4801adf2-b3df-49e8-b724-c05d8f1b69a6",
                                                "sense_id": "b567a56f-e74a-3eb9-93d9-b72e6e330b43",
                                                "text": "Taught he not thee—the man of eld, / Whose eyes within his eyes beheld / Heaven's numerous hierarchy span / The mystic gulf from God to man?"
                                            },
                                            {
                                                "example_id": "11678191-8c13-4edc-963f-7b4c838f18bf",
                                                "sense_id": "b567a56f-e74a-3eb9-93d9-b72e6e330b43",
                                                "text": "Tho’ truths in manhood darkly join,\n⁠Deep-seated in our mystic frame,\n⁠We yield all blessing to the name\nOf Him that made them current coin; […]"
                                            }
