                "senses": [
                    {
                        "sense_id": "b0bfd701-d7ac-30f4-bf6c-0e41c6153949",
                        "entry_id": "72cc250e-9164-398d-8cac-59574679ea40",
                        "glosses": [
                            "не идущий на соглашение или на примирение; не допускающий компромисса"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "952ebae6-3d69-4049-9068-0339cbb242b1",
                                "sense_id": "b0bfd701-d7ac-30f4-bf6c-0e41c6153949",
                                "text": "Всю жизнь Абарчук был непримиримым к оппортунистам, ненавидел двурушников и социально чуждых."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1364ed3-9614-4709-aea7-dd25abb21366",
                        "source_entry_id": "72cc250e-9164-398d-8cac-59574679ea40",
                        "source_sense_id": "b0bfd701-d7ac-30f4-bf6c-0e41c6153949",
                        "target_lang_word": "irreconcilable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irreconcilable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5c5dd2d-39b0-3632-92e3-d9db91cf07ba",
                                        "entry_id": "dcd92273-f6bd-3e4d-a665-0d84d5c28edb",
                                        "glosses": [
                                            "Unable to be reconciled; opposed; uncompromising."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "927e66bf-868b-49a0-a6f8-cfc195fc2543",
                                                "sense_id": "c5c5dd2d-39b0-3632-92e3-d9db91cf07ba",
                                                "text": "[T]he fact that the peccant doctor [Sir James Clark, 1st Baronet] continued in the Queen's service made the Hastings family irreconcilable and produced an unpleasant impression of unrepentant error upon the public mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ea7798f-9f11-3cad-aae3-7a30a6a0493b",
                                        "entry_id": "dcd92273-f6bd-3e4d-a665-0d84d5c28edb",
                                        "glosses": [
                                            "Incompatible, discrepant, contradictory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b00940d-39d8-4d59-9888-31267ab95d7b",
                                                "sense_id": "4ea7798f-9f11-3cad-aae3-7a30a6a0493b",
                                                "text": "I amused myself by thinking that in his choice of books he showed pleasantly the irreconcilable sides of his fantastic nature."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "irreconcilable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97dc0671-0b84-38f5-b8d3-ab302076fbf2",
                                        "entry_id": "4d2a6766-3b64-34b9-aa2c-76ebb058ff20",
                                        "glosses": [
                                            "Something that cannot be reconciled."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b78752a-3cc5-4e84-85e6-0937788fcef7",
                        "source_entry_id": "72cc250e-9164-398d-8cac-59574679ea40",
                        "source_sense_id": "b0bfd701-d7ac-30f4-bf6c-0e41c6153949",
                        "target_lang_word": "unappeasable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unappeasable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc78178b-7b55-3873-a4cd-5918817d4d80",
                                        "entry_id": "3036c03f-764b-3891-bf18-ca321f19f90f",
                                        "glosses": [
                                            "Not able to be appeased or satisfied."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3c5be91-f246-4604-9f2d-0a9c294ad6aa",
                                                "sense_id": "cc78178b-7b55-3873-a4cd-5918817d4d80",
                                                "text": "The old woman snatched the note, mouthing unappeasable resentment. \"Never think ye'll get out of it for all I take your dirty money,\" she whistled, her breath gone in the clutch of gratified rapacity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bf46f98-a67e-463f-b9e5-3ade33e7d872",
                        "source_entry_id": "72cc250e-9164-398d-8cac-59574679ea40",
                        "source_sense_id": "b0bfd701-d7ac-30f4-bf6c-0e41c6153949",
                        "target_lang_word": "implacable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "implacable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4392a122-a420-3a95-8809-484f13a2f5c1",
                                        "entry_id": "08b8cdc7-8950-33fa-a48d-b2ee2e8c83ef",
                                        "glosses": [
                                            "Not able to be placated or appeased."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc0dd6a2-abce-4f07-920e-6cc45d230f60",
                                                "sense_id": "4392a122-a420-3a95-8809-484f13a2f5c1",
                                                "text": "He is knight dubb'd with vnhatche'd Rapier, and on carpet conſideration, but he is a diuell in priuate brall, soules and bodies hath he diuorc'd three, and his incenſement at this moment is ſo implacable, that ſatisfaction can be none, but by pangs of death and ſepulcher: Hob, nob, is his word: giu't or take't."
                                            },
                                            {
                                                "example_id": "be01791c-438e-409b-9796-136d51623123",
                                                "sense_id": "4392a122-a420-3a95-8809-484f13a2f5c1",
                                                "text": "[I]n the reign of Henry the Second, a body happening, by chance, to be dug up near Glastonbury Abbey, without any symptoms of putrefaction or decay, the Welch, the descendants of the Ancient Britons, tenacious of the dignity and reputation of that illustrious hero [King Arthur], vainly supposed it could be no other than the body of their justly-boasted Pen-Dragon; and that he had been immured in that sepulchre by the spells of some powerful and implacable inchanter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a0bfc63-29fb-3723-8f10-5b6e1ccaab1a",
                                        "entry_id": "08b8cdc7-8950-33fa-a48d-b2ee2e8c83ef",
                                        "glosses": [
                                            "Impossible to prevent or stop; inexorable, unrelenting, unstoppable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34dad373-ff40-4e6f-a5f0-6d2299791b35",
                                                "sense_id": "1a0bfc63-29fb-3723-8f10-5b6e1ccaab1a",
                                                "text": "The battleships Washington and South Dakota pushed through the sea with an implacable ease."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d41bc514-9389-36c1-b9e8-b5f138f7a4ac",
                                        "entry_id": "08b8cdc7-8950-33fa-a48d-b2ee2e8c83ef",
                                        "glosses": [
                                            "Adamant; immovable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "639fec92-9f82-43a0-92df-6835d39613a7",
                                                "sense_id": "d41bc514-9389-36c1-b9e8-b5f138f7a4ac",
                                                "text": "Indeed Cain hated his Brother, becauſe his own works were evil, and his Brothers righteous; and if thy Wife and Children have been offended with thee for this, they thereby ſhew themſelves to be implacable to good; and thou haſt delivered thy ſoul from their blood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc136c94-80fa-4c3c-bcb3-e4b13b1378af",
                        "source_entry_id": "72cc250e-9164-398d-8cac-59574679ea40",
                        "source_sense_id": "b0bfd701-d7ac-30f4-bf6c-0e41c6153949",
