                        ]
                    },
                    {
                        "translation_id": "ed7ddec7-6aae-4edf-ac90-38955ba8caa5",
                        "source_entry_id": "75ac0504-a9e0-39c3-98a5-fab907241574",
                        "source_sense_id": "51d34f10-8b1c-3702-a99f-9ce7bd6ca2c2",
                        "target_lang_word": "yazidi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yazidi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "acf16104-53c5-3dde-9a77-5b43b39b28eb",
                                        "entry_id": "4c278713-e3c2-38a2-a3c4-d605aa4f6e89",
                                        "glosses": [
                                            "Relatif aux Yazidis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d35957c-b8c3-4cdc-993b-232534805037",
                                                "sense_id": "acf16104-53c5-3dde-9a77-5b43b39b28eb",
                                                "text": "François, connu pour ses mains tendues tous azimuts aux autres religions, a tenu à y prier avec des dignitaires yazidis – minorité d'Irak martyrisée par les djihadistes du groupe armé État islamique (EI) – mais aussi sabéens et zoroastriens, communautés multimillénaires dans le pays, ainsi qu’avec des musulmans chiites et sunnites."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d392a4e-78ad-4a87-bb28-a24c290bfb80",
                        "source_entry_id": "75ac0504-a9e0-39c3-98a5-fab907241574",
                        "source_sense_id": "51d34f10-8b1c-3702-a99f-9ce7bd6ca2c2",
                        "target_lang_word": "Jeside",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jeside",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f27ec44-0b45-3b3d-baab-d699cbbb5193",
                                        "entry_id": "107c0198-0a47-310c-ad31-fb1a17708726",
                                        "glosses": [
                                            "Anhänger einer alten monotheistischen Glaubensgemeinschaft im Vorderen Orient (Jesidentum)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dc65d5a-68e2-43be-b520-e5bf89070b37",
                                                "sense_id": "8f27ec44-0b45-3b3d-baab-d699cbbb5193",
                                                "text": "Wie auch in anderen Religionen glauben die Jesiden daran, dass das Leben nach dem Tod nicht endet."
                                            },
                                            {
                                                "example_id": "a18d53c3-8451-4e3a-a4f0-15879659d41b",
                                                "sense_id": "8f27ec44-0b45-3b3d-baab-d699cbbb5193",
                                                "text": "Kann man zum Jesidentum konvertieren oder wird man als Jeside geboren?"
                                            },
                                            {
                                                "example_id": "0908437f-611c-4715-8606-ea6c89bbf439",
                                                "sense_id": "8f27ec44-0b45-3b3d-baab-d699cbbb5193",
                                                "text": "Jesiden glauben an die Reinkarnation: Die Seele eines Verstorbenen lebt in einem anderen Geschöpf weiter. Das kann ein Tier sein oder ein Mensch, ein Jeside oder Angehöriger einer anderen Glaubensgemeinschaft."
                                            },
                                            {
                                                "example_id": "49a9a795-15c9-4224-9523-dd361a7496ba",
                                                "sense_id": "8f27ec44-0b45-3b3d-baab-d699cbbb5193",
                                                "text": "„Wir blieben bei den Jesiden länger, als wir vorgesehen hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1216c4f-b213-4f8a-a42f-86a690d9e819",
                        "source_entry_id": "75ac0504-a9e0-39c3-98a5-fab907241574",
