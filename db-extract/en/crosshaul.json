                "senses": [
                    {
                        "sense_id": "1d839977-454f-345a-973b-d5726c9558ed",
                        "entry_id": "85c5e7a5-e12f-3083-b8c2-84a1eda4f129",
                        "glosses": [
                            "To transport goods away from a locality while similar goods are simultaneously transported into the same locality, often resulting in inefficiencies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2171a413-7a12-46e9-807e-5bbef3b77e7d",
                                "sense_id": "1d839977-454f-345a-973b-d5726c9558ed",
                                "text": "The example that I have used of crosshauling between Pittsburgh and Chicago is an extreme case which, in actual practice, probably seldom occurs, but is illustrative of crosshauling which does occur in very large quantities from various districts."
                            },
                            {
                                "example_id": "991b7487-659d-480e-aa4a-33f3ed34a8e6",
                                "sense_id": "1d839977-454f-345a-973b-d5726c9558ed",
                                "text": "The resulting shipments have been called by critics of the basing point practice “cross-hauling”."
                            }
                        ]
                    }
                ],
