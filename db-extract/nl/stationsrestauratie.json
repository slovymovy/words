                "senses": [
                    {
                        "sense_id": "ab24a948-d610-3dd6-90e1-7e85c8cf517b",
                        "entry_id": "d03ad673-bd8f-3c2b-a520-6ff16c99f6c3",
                        "glosses": [
                            "drink- en eetgelegenheid op of bij een station"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff1f240b-2b40-4b07-8573-b1900bf62dd6",
                                "sense_id": "ab24a948-d610-3dd6-90e1-7e85c8cf517b",
                                "text": "Dáár, op de monitor: een jongen en een meisje lopen hand in hand de stationsrestauratie binnen. Ze schudt het zand uit haar sokken."
                            },
                            {
                                "example_id": "46be6e25-6567-450d-a711-d61542c81a8a",
                                "sense_id": "ab24a948-d610-3dd6-90e1-7e85c8cf517b",
                                "text": "Toen ze de grote hal binnenliep, kondigde een slecht verstaanbare vrouwenstem het vertrek van de sneltrein naar Toulouse aan. De stationsrestauratie bevond zich links van de hoofdingang. Sabine zat op het door een scherm aan het zicht onttrokken verhoogde gedeelte een broodje te eten."
                            },
                            {
                                "example_id": "ab0f1252-2615-4846-8b61-32f0319f54b8",
                                "sense_id": "ab24a948-d610-3dd6-90e1-7e85c8cf517b",
                                "text": "Het spreekt vanzelf dat het vervolgens nog veel meer mis gaat. Niet lang daarna mist Mihly na een koffiepauze in de stationsrestauratie onbewust-bewust de trein waarin Erzsi op hem zit te wachten. Hij doet geen poging haar in te halen."
                            },
                            {
                                "example_id": "1536137b-d067-46d7-905c-56a8390e8361",
                                "sense_id": "ab24a948-d610-3dd6-90e1-7e85c8cf517b",
                                "text": "'Spoorveiligheid'is het thema van de bijeenkomst, die woensdag 1 november wordt gehouden in de stationsrestauratie van Oldenzaal. Aanwonenden van het spoor en overige belangstellenden worden geïnformeerd over de risico's en de werkwijze van de hulpdiensten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40f882ba-3e43-4277-a09b-191f135dacb4",
                        "source_entry_id": "d03ad673-bd8f-3c2b-a520-6ff16c99f6c3",
                        "source_sense_id": "ab24a948-d610-3dd6-90e1-7e85c8cf517b",
                        "source_sense_description": "stationsrestaurant",
                        "target_lang_word": "refreshment room",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refreshment room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bdac27a7-f02b-33f2-b394-81afd581d023",
                                        "entry_id": "ddc8d3fb-539f-3750-a99d-004ff442a607",
                                        "glosses": [
                                            "A room that was once common at larger railway stations in Britain and the British Commonwealth for the purpose of serving food and drink to travellers."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24aee95d-0ced-4914-bfea-8fbba7aeab9b",
                                                "sense_id": "bdac27a7-f02b-33f2-b394-81afd581d023",
                                                "text": "But when his slender, big-wheeled engine had brought him as far as York, in a non-corridor compartment, his inside had begun to make urgent representations. So, to this day, the York refreshment room is extraordinary; the dining room is a regular banqueting hall."
                                            },
                                            {
                                                "example_id": "ef4a3561-675a-45d7-bdce-607610f7f7b3",
                                                "sense_id": "bdac27a7-f02b-33f2-b394-81afd581d023",
                                                "text": "While we were waiting, Eugène suggested a drink in the refreshment room; I assumed this would be more wine, but Eugène marched in and demanded two Cognacs."
                                            },
                                            {
                                                "example_id": "48f124fb-9a5f-43ed-ad0c-75ab18cfb40b",
                                                "sense_id": "bdac27a7-f02b-33f2-b394-81afd581d023",
                                                "text": "There were no waiting rooms. [...] But there were licensed refreshment rooms, provided by those pioneers of station dining Messrs Spiers and Pond."
                                            },
                                            {
                                                "example_id": "8e5d0fee-322c-4221-81b2-e2e4d555ce10",
                                                "sense_id": "bdac27a7-f02b-33f2-b394-81afd581d023",
                                                "text": "Calling at Stalybridge, I cast one eye at the refreshment rooms and one eye at my watch, but 'beer o'clock' it isn't! Besides, I have a long way to travel!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "715f2339-8fe2-4489-a84b-f984ab951a30",
                        "source_entry_id": "d03ad673-bd8f-3c2b-a520-6ff16c99f6c3",
                        "source_sense_id": "ab24a948-d610-3dd6-90e1-7e85c8cf517b",
                        "source_sense_description": "stationsrestaurant",
                        "target_lang_word": "tearoom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tearoom",
