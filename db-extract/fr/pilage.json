                                "example_id": "ba7c5631-2b4c-4b5b-ba30-49020f304e58",
                                "sense_id": "08ab9288-4c4a-36be-b225-16f05bf32845",
                                "text": "La première étape de la fabrication du poiré est le pilage des poires."
                            },
                            {
                                "example_id": "85eb55c8-87a8-4ea5-a0d6-54593d95344d",
                                "sense_id": "08ab9288-4c4a-36be-b225-16f05bf32845",
                                "text": "le pilage des graines."
                            },
                            {
                                "example_id": "250021b3-2990-46ca-9a9c-8ef07c18c8fd",
                                "sense_id": "08ab9288-4c4a-36be-b225-16f05bf32845",
                                "text": "Après avoir mouillé d’un peu d’eau et laissé tremper le grain environ cinq minutes, on fait un second pilage rapide pour obtenir un mil « pilé » ou « mi-pilé » (ādha-kūṭā)."
                            }
                        ]
                    }
