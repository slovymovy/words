                "senses": [
                    {
                        "sense_id": "9ec778d7-5792-373d-b3ae-952ad89e8e63",
                        "entry_id": "789d2c4e-499c-3209-ba08-4dfcabe101ad",
                        "glosses": [
                            "vuurspuwende berg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0820d8f9-8f3f-456d-95ce-66788f43fe0b",
                                "sense_id": "9ec778d7-5792-373d-b3ae-952ad89e8e63",
                                "text": "Een aantal dagen later zag ik voor het eerst de slapende vulkaan Mount Shasta in de verte liggen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af146b27-93e7-4138-8a3e-c90292c8e782",
                        "source_entry_id": "789d2c4e-499c-3209-ba08-4dfcabe101ad",
                        "source_sense_id": "9ec778d7-5792-373d-b3ae-952ad89e8e63",
                        "target_lang_word": "Vulkan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vulkan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ced96a1e-3de5-301f-8a9a-923d2b872398",
                                        "entry_id": "62e1ca6b-9fd2-364a-86d9-263b2d518fbc",
                                        "glosses": [
                                            "Struktur, die entsteht, wenn Magma aus dem Inneren eines Planeten bis zur Oberfläche ansteigt"
                                        ],
                                        "tags": [
                                            "Planetologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfca1397-ef9f-40ae-b913-65914c838a07",
                                                "sense_id": "ced96a1e-3de5-301f-8a9a-923d2b872398",
                                                "text": "Der größte Vulkan des Sonnensystems ist Olympus Mons auf dem Mars."
                                            },
                                            {
                                                "example_id": "30c899f9-b730-4494-9e33-ca1f8a10866e",
                                                "sense_id": "ced96a1e-3de5-301f-8a9a-923d2b872398",
                                                "text": "„Das Gipfelerlebnis, das die Vulkane ihrem Besteiger gewähren, ist kein sentimentalischer Blick auf die Landschaft, sondern ein seltener Moment wissenschaftlicher Synthese und enzyklopädischer Ganzheit.“"
                                            },
                                            {
                                                "example_id": "4568f31c-b83c-46ff-afaa-bd2d520fe4b5",
                                                "sense_id": "ced96a1e-3de5-301f-8a9a-923d2b872398",
                                                "text": "„Im Laufe der folgenden Jahrtausende brachen an vielen Stellen Vulkane aus, deren Lavaströme die gesamte Region durchzogen.“"
                                            },
                                            {
                                                "example_id": "ecf9c908-ceb0-4aca-89e5-fd028cbba543",
                                                "sense_id": "ced96a1e-3de5-301f-8a9a-923d2b872398",
                                                "text": "„Gletscher und Vulkan zusammen sind tausenddreihundert Meter hoch, hundert Quadratkilometer in ihrer Fläche.“"
                                            },
                                            {
                                                "example_id": "ef86a439-915f-4efe-bf4a-d77aefb9ab76",
                                                "sense_id": "ced96a1e-3de5-301f-8a9a-923d2b872398",
                                                "text": "„Gleich dahinter begrenzten Vulkane mit ihren roten, mancherorts fast violetten Hängen die Sicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Vulkan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33e2a7e5-1457-3892-ac0a-078868a20469",
                                        "entry_id": "cab583e8-d308-3a04-a5f6-5970a3654d08",
                                        "glosses": [
                                            "römischer Gott des Feuers und der Schmiedekunst"
                                        ],
                                        "tags": [
                                            "keine Artikel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "526cbfe2-ee19-4a29-86d1-9d23d1c7f66f",
                                                "sense_id": "33e2a7e5-1457-3892-ac0a-078868a20469",
                                                "text": "Vulkan ist das römische Äquivalent zum griechischen Hephaistos."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6113c35c-8639-3e29-8041-76bd8b9a5b15",
                                        "entry_id": "cab583e8-d308-3a04-a5f6-5970a3654d08",
                                        "glosses": [
                                            "Name eines hypothetischen, sonnennahen Planeten im Sonnensystem"
                                        ],
                                        "tags": [
                                            "keine Artikel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cefc2e8-7bf4-4d78-98f4-ec3a702ea3ec",
                                                "sense_id": "6113c35c-8639-3e29-8041-76bd8b9a5b15",
                                                "text": "„Über ein halbes Jahrhundert versuchten Astronomen, den hypothetischen Planeten Vulkan aufzuspüren, vor allem während Sonnenfinsternissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "392577bc-a04f-4231-9505-80f90394253c",
                        "source_entry_id": "789d2c4e-499c-3209-ba08-4dfcabe101ad",
                        "source_sense_id": "9ec778d7-5792-373d-b3ae-952ad89e8e63",
                        "target_lang_word": "volcano",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
