                        "target_lang_word": "Gemüseladen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gemüseladen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62f46e98-edb0-3eb5-84b3-9c56c0e1c48b",
                                        "entry_id": "bfcb0607-b265-3879-8106-b55f86105455",
                                        "glosses": [
                                            "Geschäft zum Verkauf von Gemüse"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07eb5abc-e249-4f8a-9c25-3c0ad5aca4bb",
                                                "sense_id": "62f46e98-edb0-3eb5-84b3-9c56c0e1c48b",
                                                "text": "„Das Schrumpfen der kleinen Einheiten nimmt zu – ob dies nun Märkte, Gemüseläden, Fleischhauer oder Bäcker sind.“"
                                            },
                                            {
                                                "example_id": "244580fe-3b93-49b3-a664-d19dcd5198c9",
                                                "sense_id": "62f46e98-edb0-3eb5-84b3-9c56c0e1c48b",
                                                "text": "„Der Gemüseladen gegenüber war noch immer da.“"
                                            },
                                            {
                                                "example_id": "03883c13-88ed-49fc-bad5-6797f997255e",
                                                "sense_id": "62f46e98-edb0-3eb5-84b3-9c56c0e1c48b",
                                                "text": "„Knapp unterhalb des Gemüseladens Hui hatte ein Bäcker sein Geschäft.“"
                                            },
                                            {
                                                "example_id": "d752ed58-79b2-442d-96de-27ecc8cfedf6",
                                                "sense_id": "62f46e98-edb0-3eb5-84b3-9c56c0e1c48b",
                                                "text": "„Beim Einkauf standen die Einzelhändler ‚Hofladen‘, der Obst- und Gemüseladen Barazzi, das ‚Käsestübchen‘ und der EDEKA Aktivmarkt bereit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
