                "senses": [
                    {
                        "sense_id": "8815640b-f9f6-30ca-b85b-acc826eed99c",
                        "entry_id": "84c54bd6-8e8d-35ad-a3d4-42dfed98670a",
                        "glosses": [
                            "издавать хлипы, прерывисто дыша и втягивая воздух"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbdced9b-0125-4b1e-8572-ac032a0242f5",
                                "sense_id": "8815640b-f9f6-30ca-b85b-acc826eed99c",
                                "text": "Был вешний день, кричали грачи, неподалеку, усердно крестясь, всхлипывала старуха-нищенка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6bdcd81b-8e5e-4b42-bd10-e4d3b967e563",
                        "source_entry_id": "84c54bd6-8e8d-35ad-a3d4-42dfed98670a",
                        "source_sense_id": "8815640b-f9f6-30ca-b85b-acc826eed99c",
                        "target_lang_word": "sob",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c724e67f-59b3-3c56-a710-73307cc05ba5",
                                        "entry_id": "8701203c-6e80-356e-a6a9-2b8d8a3fe0c8",
                                        "glosses": [
                                            "A cry with a short, sudden expulsion of breath."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8954a72-8359-311a-912d-3adcbb6eb5fa",
                                        "entry_id": "8701203c-6e80-356e-a6a9-2b8d8a3fe0c8",
                                        "glosses": [
                                            "sound of sob"
                                        ],
                                        "tags": [
                                            "onomatopoeic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ffa9ca3-191b-455c-820c-b118d8d84876",
                                                "sense_id": "c8954a72-8359-311a-912d-3adcbb6eb5fa",
                                                "text": "“My husband, alas! whom I now (sob, sob) mourn,\nA short time since (sob) to this grave (sob) was borne;\nAnd (sob) he lies buried in this (sob, sob) grave.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f85da92f-300d-3053-8098-931554d863fc",
                                        "entry_id": "6a819516-bb56-3b57-8865-f8d84c79443a",
                                        "glosses": [
                                            "To weep with convulsive gasps."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04922bcc-18c3-4ee7-9920-34236297e65a",
                                                "sense_id": "f85da92f-300d-3053-8098-931554d863fc",
                                                "text": "She was sobbing because she was feeling very miserable."
                                            },
                                            {
                                                "example_id": "da0fd78b-53d0-4d37-b27d-11ccbc22540e",
                                                "sense_id": "f85da92f-300d-3053-8098-931554d863fc",
                                                "text": "She sigh'd, she sobb'd, and, furious with despair, / She rent her garments, and she tore her hair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa593953-becc-3a8f-9f1e-db6d1e520635",
                                        "entry_id": "6a819516-bb56-3b57-8865-f8d84c79443a",
                                        "glosses": [
                                            "To say (something) while sobbing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32ea4173-6499-40a3-9def-4532c857ea92",
                                                "sense_id": "fa593953-becc-3a8f-9f1e-db6d1e520635",
                                                "text": "\"He doesn't love me!\" she sobbed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sob",
                                "target_lang_code": "en",
                                "target_senses": [
