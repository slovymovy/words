                            "comparative"
                        ],
                        "form": "more Kantian"
                    },
                    {
                        "form_id": "aff06d88-91a2-4710-8490-388afc8b7cee",
                        "entry_id": "3b027bfe-f55d-31b6-bcb6-e0993d9c6a36",
