        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f8fd920-04ae-31ea-be6f-45b0f158fc9b",
                    "sense_definition": "To place a helmet on someone's head or to cover something as if with a helmet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers <w>helmeted</w> themselves quickly before the battle began.",
                            "target_lang_translations": {
                                "ru": "Солдаты быстро <w>надели каски</w> перед началом битвы.",
                                "zh": "战斗开始前，士兵们迅速<w>戴上头盔</w>。"
                            }
                        },
                        {
                            "text": "She <w>helmeted</w> her hair to keep it secure against the strong wind.",
                            "target_lang_translations": {
                                "ru": "Она <w>укрыла</w> волосы, чтобы защитить их от сильного ветра.",
                                "zh": "她把头发<w>罩住</w>，以免被大风吹乱。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Надеть шлем на чью-либо голову или накрыть что-либо, как шлемом.",
                        "zh": "给某人戴上头盔，或像头盔一样把某物罩住、覆盖起来。"
                    },
