                    },
                    {
                        "translation_id": "bc2c07fb-61e0-4e92-83ac-f86a646bdf7c",
                        "source_entry_id": "7a37ccf0-f533-3b4f-8762-877b71d72e96",
                        "source_sense_id": "e8412fc6-3faa-35bf-ab7e-851cca5b5965",
