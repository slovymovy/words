                        "form": "das Satzzeichen"
                    },
                    {
                        "form_id": "b96a517b-001d-4add-87af-d3e0d4c341fa",
                        "entry_id": "90ff0638-eb02-3776-8b56-3936cd07dac4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Satzzeichen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "695a1208-b18c-34a7-b3ae-c2f51c2fd884",
                        "entry_id": "90ff0638-eb02-3776-8b56-3936cd07dac4",
                        "glosses": [
                            "graphische Zeichen, die der Abgrenzung und syntaktischen Gliederung von Sätzen dienen. Gelegentlich werden Wortzeichen, die sich nur beim einzelnen Wort auswirken, von Satzzeichen unterschieden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78ecbe16-fa86-4829-8cb5-aa32553558aa",
                                "sense_id": "695a1208-b18c-34a7-b3ae-c2f51c2fd884",
                                "text": "Satzzeichen markieren das Ende von Sätzen oder erleichtern das Erkennen von Syntagmen im Satz."
                            },
                            {
                                "example_id": "e9a6cc40-c1e3-49a6-b16c-67cc73ae70fa",
                                "sense_id": "695a1208-b18c-34a7-b3ae-c2f51c2fd884",
                                "text": "Die Unterscheidung zwischen Satzzeichen und Wortzeichen wird nicht immer konsequent eingehalten."
                            },
                            {
                                "example_id": "faa96a0d-8383-4fce-867b-6feaf35174d9",
                                "sense_id": "695a1208-b18c-34a7-b3ae-c2f51c2fd884",
                                "text": "„Es gibt noch ein zweites Satzzeichen, um ein Satzgefüge durchsichtig zu machen: die Parenthese (Schaltzeichen), das heißt Gedankenstriche vor und hinter einer Einschaltung.“"
                            },
                            {
                                "example_id": "bcd374d8-620e-4a24-b454-94709aca7a2b",
                                "sense_id": "695a1208-b18c-34a7-b3ae-c2f51c2fd884",
                                "text": "„Satzzeichen gliedern den Text.“"
                            },
                            {
                                "example_id": "5d10abcf-7a5f-4d5e-b15b-df765698213a",
                                "sense_id": "695a1208-b18c-34a7-b3ae-c2f51c2fd884",
                                "text": "„Satzzeichen werden ohne Zwischenraum angeschlossen.“"
                            },
                            {
                                "example_id": "b0def465-c90e-4d30-8ac5-a0c19e1b62de",
                                "sense_id": "695a1208-b18c-34a7-b3ae-c2f51c2fd884",
                                "text": "„Die Ägypter verwenden keinerlei Satzzeichen, und Wörter und Sätze folgen ohne Zwischenraum aufeinander.“"
                            },
                            {
                                "example_id": "65889e51-9fab-4791-a3ac-fb620465c168",
                                "sense_id": "695a1208-b18c-34a7-b3ae-c2f51c2fd884",
                                "text": "„Die heute gebräuchlichen Satzzeichen wurden in knapp zweihundert Jahren, zwischen 1400 und 1600, entwickelt und haben sich seither kaum noch verändert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
