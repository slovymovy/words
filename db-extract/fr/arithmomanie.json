                    {
                        "sense_id": "9aba35b4-fccf-3286-a642-297e1ce1b83a",
                        "entry_id": "09aeed00-6dcd-3aec-a743-a87ee681d09c",
                        "glosses": [
                            "Trouble névrotique, obsessionnel-compulsif qui pousse le malade à des calculs mentaux incessants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "720a7b0a-d5ac-45ea-a107-44be77bc1172",
                                "sense_id": "9aba35b4-fccf-3286-a642-297e1ce1b83a",
                                "text": "Lorsque le nombre de répétitions correspond à un chiffre déterminé, la compulsion de répétition est alors associée à un rituel mental d'arithmomanie."
                            },
                            {
                                "example_id": "7fb564fa-e541-4a5e-a0f1-0d0ff65bea16",
                                "sense_id": "9aba35b4-fccf-3286-a642-297e1ce1b83a",
                                "text": "Une étrange arithmomanie me tourmentait : mes yeux brûlés s’effaraient à lire d'inextricables équations, qui leur apparaissaient flamboyantes sur d’imaginaires tableaux noirs ; et, de tête, machinalement, j’extrayais des racines carrées effroyables."
                            }
                        ]
                    }
                ],
