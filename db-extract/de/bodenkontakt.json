                ],
                "senses": [
                    {
                        "sense_id": "efad65c4-a770-388d-8f86-4fda3fc7d0d2",
                        "entry_id": "32097146-9208-3f2e-a442-9cc25b776ace",
                        "glosses": [
                            "Berührung mit dem Erd- oder Fußboden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63b5b3ee-b2f5-44f7-aeae-ed82b7a229d8",
                                "sense_id": "efad65c4-a770-388d-8f86-4fda3fc7d0d2",
                                "text": "„Der Ball muss ohne Bodenkontakt zum nächsten Spieler gepasst werden.“"
                            },
                            {
                                "example_id": "ab681bd1-55ab-410f-ac06-b10a2328844f",
                                "sense_id": "efad65c4-a770-388d-8f86-4fda3fc7d0d2",
                                "text": "„Das Laufen zeichnet sich im Vergleich zum Gehen dadurch aus, dass zwischenzeitlich der Bodenkontakt vollständig verloren geht.“"
                            },
                            {
                                "example_id": "670db0f7-0096-4050-a6aa-85e71ac9dfea",
                                "sense_id": "efad65c4-a770-388d-8f86-4fda3fc7d0d2",
                                "text": "„Übungen ohne Bodenkontakt sind tendenziell schwieriger durchzuführen als bodenbasierte.“"
                            },
                            {
                                "example_id": "2ca7f98d-ad55-41c8-b8fc-b16596d0008b",
                                "sense_id": "efad65c4-a770-388d-8f86-4fda3fc7d0d2",
                                "text": "„Der Flug an sich war unspektakulär, nur bei der Landung, unmittelbar nachdem das Flugzeug mit den Rädern Bodenkontakt hatte, erwischte die Maschine eine heftige Windbö von rechts.“"
                            },
                            {
                                "example_id": "03a83a21-7ad1-4d1a-9d5c-95af6f6995a5",
                                "sense_id": "efad65c4-a770-388d-8f86-4fda3fc7d0d2",
                                "text": "„Die Anzahl an Sprüngen, Hops und Bounds pro Trainingseinheit wird meistens durch die Anzahl der Bodenkontakte bestimmt. Eine Hauptschwäche der meisten Plyometrieprogramme ist, dass sie viele Bodenkontakte fordern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
