                "senses": [
                    {
                        "sense_id": "6349f9b8-73bb-36e4-9b61-f31157ab6420",
                        "entry_id": "5abed58d-594f-387c-aff0-3cab3fff4324",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47e3e56f-16e5-41cf-ab85-cf48cc932847",
                                "sense_id": "6349f9b8-73bb-36e4-9b61-f31157ab6420",
                                "text": "Frau Finkbohner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "34ca5daf-7f63-41e3-8588-4de6d2790ba3",
                                "sense_id": "6349f9b8-73bb-36e4-9b61-f31157ab6420",
                                "text": "Herr Finkbohner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9062d825-754e-4d26-9c73-2fd74077106d",
                                "sense_id": "6349f9b8-73bb-36e4-9b61-f31157ab6420",
                                "text": "Die Finkbohners fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2ebfc5bc-7c2d-4373-85e0-f8b9ce69da91",
                                "sense_id": "6349f9b8-73bb-36e4-9b61-f31157ab6420",
                                "text": "Der Finkbohner trägt nie die Schals, die die Finkbohner ihm strickt."
                            },
                            {
                                "example_id": "9f2d4239-2261-449b-9fb3-a7eb49bf05d6",
                                "sense_id": "6349f9b8-73bb-36e4-9b61-f31157ab6420",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Finkbohner kommt, geht der Herr Finkbohner.“"
                            },
                            {
                                "example_id": "2a3874cf-f336-4f81-a1aa-53c963172b19",
                                "sense_id": "6349f9b8-73bb-36e4-9b61-f31157ab6420",
                                "text": "Finkbohner kommt und geht."
                            },
                            {
                                "example_id": "88fa1411-eb58-44c2-b58f-e61c3068191a",
                                "sense_id": "6349f9b8-73bb-36e4-9b61-f31157ab6420",
                                "text": "Finkbohners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
