{
    "word_family": [
        "bengelen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7d56afb6-f384-376d-825d-76bc666c8d07",
                    "sense_definition": "Een ondeugend of baldadig kind",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ondeugend_kind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die kleine <w>bengel</w> rende lachend door de hele tuin.",
                            "target_lang_translations": {
                                "fr": "Le petit <w>gamin</w> courait en riant à travers tout le jardin."
                            }
                        },
                        {
                            "text": "De leraar moest lachen om de streken van de kleine <w>bengel</w>.",
                            "target_lang_translations": {
                                "fr": "Le professeur a dû rire des bêtises du petit <w>chenapan</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "deugniet",
                        "kwajongen",
                        "rakker",
                        "rekel",
                        "vlegel",
                        "blaag",
                        "schavuit"
                    ],
                    "common_phrases": [
                        "kleine bengel"
                    ],
                    "target_lang_definitions": {
                        "fr": "Un enfant espiègle ou turbulent."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "gamin",
                                "target_lang_sense_clarification": "enfant espiègle"
                            },
                            {
                                "target_lang_word": "diablotin",
                                "target_lang_sense_clarification": "enfant très turbulent"
                            },
                            {
                                "target_lang_word": "petit chenapan",
                                "target_lang_sense_clarification": "enfant qui fait des bêtises"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a457f2d-47b8-3b33-963a-84d5cca4bcd1",
                    "sense_definition": "Een zwaar voorwerp zoals een knuppel of stok",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "voorwerp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gebruikte een zware <w>bengel</w> om de deur open te breken.",
                            "target_lang_translations": {
                                "fr": "Il a utilisé un lourd <w>gourdin</w> pour défoncer la porte."
                            }
                        },
                        {
                            "text": "De oude <w>bengel</w> lag vergeten in de hoek van de schuur.",
                            "target_lang_translations": {
                                "fr": "Le vieux <w>gourdin</w> gisait oublié dans le coin de la grange."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderd gebruik voor een stok of knuppel"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Un objet lourd comme un bâton ou une massue."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "gourdin",
                                "target_lang_sense_clarification": "bâton lourd"
                            },
                            {
                                "target_lang_word": "massue",
                                "target_lang_sense_clarification": "objet contondant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca226d1e-3c8b-3177-936b-e1acb6239daf",
                    "sense_definition": "Het onderdeel in een klok dat tegen de wand slaat om geluid te maken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "klokonderdeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>bengel</w> van de kerkklok was losgeraakt door de storm.",
                            "target_lang_translations": {
                                "fr": "Le <w>battant</w> de la cloche de l'église s'était détaché à cause de la tempête."
                            }
                        },
                        {
                            "text": "Zonder de <w>bengel</w> kan de klok geen geluid meer maken.",
                            "target_lang_translations": {
                                "fr": "Sans le <w>battant</w>, la cloche ne peut plus produire de son."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "La pièce mobile à l'intérieur d'une cloche qui frappe la paroi pour produire un son."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "battant",
                                "target_lang_sense_clarification": "pièce mobile d'une cloche"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f12a207-766e-30f4-afe6-62c4732d78d4",
                    "sense_definition": "Een metalen voorwerp dat geluid maakt wanneer het wordt aangeslagen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "klokonderdeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De grote <w>bengel</w> in de toren luidde voor de zondagsdienst.",
                            "target_lang_translations": {
                                "fr": "La grande <w>cloche</w> dans la tour a sonné pour le service du dimanche."
                            }
                        },
                        {
                            "text": "Men hoorde de zware <w>bengel</w> over het hele dorp galmen.",
                            "target_lang_translations": {
                                "fr": "On entendait la lourde <w>cloche</w> résonner dans tout le village."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Un objet métallique qui produit un son lorsqu'il est frappé."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "cloche",
                                "target_lang_sense_clarification": "instrument de percussion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68860838-ebfe-35e1-878a-6240ecf083c7",
                    "sense_definition": "Een sieraad dat aan het oor wordt gedragen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sieraad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij droeg een glinsterende <w>bengel</w> aan haar oor.",
                            "target_lang_translations": {
                                "fr": "Elle portait une <w>boucle d'oreille</w> scintillante."
                            }
                        },
                        {
                            "text": "De gouden <w>bengel</w> schitterde in het avondlicht.",
                            "target_lang_translations": {
                                "fr": "La <w>boucle d'oreille</w> en or brillait dans la lumière du soir."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Un bijou porté à l'oreille."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pendentif d'oreille",
                                "target_lang_sense_clarification": "bijou pendant"
                            },
                            {
                                "target_lang_word": "boucle d'oreille",
                                "target_lang_sense_clarification": "bijou d'oreille"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff6d34f1-1f61-3166-8d50-ef5fe71fcdbb",
                    "sense_definition": "Een ketting waaraan een zakhorloge wordt gedragen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sieraad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij haalde zijn horloge aan de <w>bengel</w> uit zijn vestzak.",
                            "target_lang_translations": {
                                "fr": "Il a sorti sa montre par sa <w>chaînette</w> de la poche de son gilet."
                            }
                        },
                        {
                            "text": "De zilveren <w>bengel</w> was een erfstuk van zijn grootvader.",
                            "target_lang_translations": {
                                "fr": "La <w>chaînette</w> en argent était un héritage de son grand-père."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "verwijst naar een historisch modeaccessoire"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Une chaîne à laquelle on porte une montre de poche."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "chaînette de montre",
                                "target_lang_sense_clarification": "accessoire de montre de poche"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a128da8a-ae79-3087-80dd-15bd2bf0c0ef",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>bengelen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>bengel</w> met mijn benen over de rand van de muur.",
                            "target_lang_translations": {
                                "fr": "Je <w>pendille</w> mes jambes par-dessus le bord du mur."
                            }
                        },
                        {
                            "text": "Terwijl ik daar zo <w>bengel</w>, kijk ik naar de voorbijgangers.",
                            "target_lang_translations": {
                                "fr": "Pendant que je <w>pendille</w> ainsi, je regarde les passants."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm van het werkwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Première personne du singulier du présent du verbe 'bengelen' (pendiller)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "je pendille",
                                "target_lang_sense_clarification": "forme conjuguée"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d67a44e-19ef-3ed2-9160-2a2939f23362",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>bengelen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>bengel</w> jij zo ongeduldig met je voeten?",
                            "target_lang_translations": {
                                "fr": "Pourquoi <w>pendilles</w>-tu tes pieds avec tant d'impatience ?"
                            }
                        },
                        {
                            "text": "Als jij daar zo <w>bengel</w> op die stoel, val je er nog vanaf.",
                            "target_lang_translations": {
                                "fr": "Si tu <w>pendilles</w> ainsi sur cette chaise, tu vas finir par tomber."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm van het werkwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Deuxième personne du singulier du présent du verbe 'bengelen' (pendiller)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tu pendilles",
                                "target_lang_sense_clarification": "forme conjuguée"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "611fff74-9cdb-34ea-beab-391c61df5302",
                    "sense_definition": "Gebiedende wijs van <w>bengelen</w>",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bengel</w> niet zo met die sleutels aan je vinger!",
                            "target_lang_translations": {
                                "fr": "<w>Ne fais pas pendiller</w> tes clés au bout de ton doigt comme ça !"
                            }
                        },
                        {
                            "text": "<w>Bengel</w> die tas eens even aan de haak.",
                            "target_lang_translations": {
                                "fr": "<w>Accroche</w> ce sac au crochet."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Impératif du verbe 'bengelen' (pendiller)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pendille",
                                "target_lang_sense_clarification": "forme impérative"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}