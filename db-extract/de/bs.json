                                            {
                                                "example_id": "9fba2217-f1f0-4e11-8bf7-86e2af0c1bd8",
                                                "sense_id": "4fd3aed4-8dfc-3ae4-af78-8bb67a09ed6c",
                                                "text": "You did the overseas trip. You went OS."
                                            },
                                            {
                                                "example_id": "b30e3f30-8606-499c-a185-3f1875cb7a22",
                                                "sense_id": "4fd3aed4-8dfc-3ae4-af78-8bb67a09ed6c",
                                                "text": "I kind of expanded my circle a bit more when I went OS [overseas]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "OS",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e92164a-21b9-39b1-af8a-9053d141071c",
                                        "entry_id": "a4c12d3d-e611-3cb5-86af-338e78d495b4",
                                        "glosses": [
                                            "An Ordnance Survey map."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07a3b4c1-d81e-4bc1-af82-a1341d154693",
                                                "sense_id": "9e92164a-21b9-39b1-af8a-9053d141071c",
                                                "text": "We've got an OS of the Cuckmere area."
                                            },
                                            {
                                                "example_id": "65a4bfbf-3cf8-48bb-9697-2ac055f9d50b",
                                                "sense_id": "9e92164a-21b9-39b1-af8a-9053d141071c",
                                                "text": "Calton Hill in Edinburgh is located at OS grid ref NT262741."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "370a2790-3d9c-363f-828e-42e209f2a699",
                                        "entry_id": "a4c12d3d-e611-3cb5-86af-338e78d495b4",
                                        "glosses": [
                                            "Initialism of operating system."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de7f3370-e4d8-4172-8068-e59dfe269f2f",
                                                "sense_id": "370a2790-3d9c-363f-828e-42e209f2a699",
                                                "text": "I've decided to install two different OSes on my new laptop."
                                            },
                                            {
                                                "example_id": "ca3025b9-11d2-43ed-8c34-0591e4bb2ccf",
                                                "sense_id": "370a2790-3d9c-363f-828e-42e209f2a699",
                                                "text": "Some vendors do now have a variant of the per-unit royalty (usually termed a “shared risk,” or similar approach), but it is not strictly the same as for those proprietary embedded OSes mentioned before […]"
                                            },
                                            {
                                                "example_id": "80581176-0883-4b9c-8971-0ffab25a4a90",
                                                "sense_id": "370a2790-3d9c-363f-828e-42e209f2a699",
                                                "text": "A policy-created scheduled task will be accepted by computers running client OSes as old as Windows 2000 […]"
                                            },
                                            {
                                                "example_id": "bd27d03a-2be5-4ccc-923c-d875bea59624",
                                                "sense_id": "370a2790-3d9c-363f-828e-42e209f2a699",
                                                "text": "In a dual-boot configuration, you install two OSs on the computer (Windows XP and Windows 2000, for example)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7220a2f-2ee9-37c0-a1d3-a38183626161",
                                        "entry_id": "a4c12d3d-e611-3cb5-86af-338e78d495b4",
