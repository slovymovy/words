                "senses": [
                    {
                        "sense_id": "988784ca-3140-3f19-baa6-dab7a199728c",
                        "entry_id": "6a6a21ef-b4d9-323d-82f9-3d1b56bf09f0",
                        "glosses": [
                            "Étoffe de coton à tissage très lâche et très apprêté, contrairement à la mousseline, plus souple et légère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1334ff6-76c3-4071-b5d8-e0d28c567211",
                                "sense_id": "988784ca-3140-3f19-baa6-dab7a199728c",
                                "text": "Une robe de tarlatane coquettement chiffonnée, un col plat, de petites manchettes, et, avec une grosse rose sur l’oreille."
                            },
                            {
                                "example_id": "915adadc-920e-4ba5-af31-3ce7e2527879",
                                "sense_id": "988784ca-3140-3f19-baa6-dab7a199728c",
                                "text": "Sur son chapeau se balance un crabe en tarlatane."
                            },
                            {
                                "example_id": "456876dd-ddeb-40fb-9256-0d9f97548545",
                                "sense_id": "988784ca-3140-3f19-baa6-dab7a199728c",
                                "text": "Toujours vêtue d’une robe de tarlatane rose sur laquelle couraient des branchages artificiels, et qu’attachait une ceinture s’élargissant sur le ventre en un losange qui enfermait, imprimés en rouge, des caractères cabalistiques, elle donnait à voir, sous des seins volumineux, une taille d’une minceur extraordinaire, toute remuante d’une vie nerveuse."
                            }
                        ]
                    }
                ],
