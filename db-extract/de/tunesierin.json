                    {
                        "sense_id": "12bf665f-7b64-39f1-9f49-d73bf414d669",
                        "entry_id": "93b7e0ea-aad3-34b2-8e08-1a37c43b040e",
                        "glosses": [
                            "Staatsbürgerin von Tunesien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "924f2049-ef8f-45d4-9018-744f7d833e86",
                                "sense_id": "12bf665f-7b64-39f1-9f49-d73bf414d669",
                                "text": "„Zweitens, zusammen mit der Handvoll Rallye-Damen und einigen verschleierten Tunesierinnen waren wir Frauen ein verschwindend kleines Grüppchen an Bord.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4881b3c5-e082-4e59-851d-f6ef7d3d0f00",
                        "source_entry_id": "93b7e0ea-aad3-34b2-8e08-1a37c43b040e",
