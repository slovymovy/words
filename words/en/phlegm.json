{
    "word_family": [
        "phlegmatic",
        "phlegmatically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f0b48cb-231c-3085-86b7-7ec549b19b9b",
                    "sense_definition": "Thick mucus produced in the respiratory system, often expelled by coughing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient coughed up a large amount of <w>phlegm</w> during the medical examination."
                        },
                        {
                            "text": "Drinking plenty of water can help thin the <w>phlegm</w> in your throat."
                        }
                    ],
                    "synonyms": [
                        "mucus",
                        "sputum"
                    ],
                    "common_phrases": [
                        "clear phlegm",
                        "cough up phlegm"
                    ]
                },
                {
                    "sense_id": "f9531682-deae-38e6-b0ee-9f5cb3b1900b",
                    "sense_definition": "A state of calmness, composure, or sometimes indifference and sluggishness.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "temperament",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He maintained his usual <w>phlegm</w> even when the situation became extremely chaotic."
                        },
                        {
                            "text": "The sudden crisis tested the legendary <w>phlegm</w> of the experienced diplomat."
                        }
                    ],
                    "synonyms": [
                        "composure",
                        "apathy",
                        "indifference"
                    ],
                    "antonyms": [
                        "excitement",
                        "passion"
                    ]
                },
                {
                    "sense_id": "17057365-4288-3dcc-ace5-645266daa6bf",
                    "sense_definition": "One of the four bodily humors in ancient medicine, believed to be cold and moist.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient physicians believed that an excess of <w>phlegm</w> caused a person to be sluggish."
                        },
                        {
                            "text": "The theory of the four humors classified <w>phlegm</w> as a cold and moist substance."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical medical theory."
                        }
                    ]
                },
                {
                    "sense_id": "cad32b52-0a28-31a8-b841-4be38bbb0124",
                    "sense_definition": "A watery distillation or aqueous solution, especially from plant matter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Early chemists often referred to the watery residue of distilled plants as <w>phlegm</w>."
                        },
                        {
                            "text": "The laboratory report described the clear liquid as a simple <w>phlegm</w>."
                        }
                    ],
                    "synonyms": [
                        "distillate",
                        "aqueous solution"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to obsolete chemical terminology."
                        }
                    ]
                }
            ]
        }
    ]
