                        "target_lang_word": "microfoon",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microfoon",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a2073ffe-b236-381d-b158-75108e97689a",
                                        "entry_id": "0bd83b75-c730-3e51-b8fe-6cfc553debe0",
                                        "glosses": [
                                            "een toestel dat geluidstrillingen omzet in een elektrisch signaal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23de4b1e-1161-4bd5-949a-128f0ae26efb",
                                                "sense_id": "a2073ffe-b236-381d-b158-75108e97689a",
                                                "text": "Doordat hij erg zenuwachtig was, liet hij per ongeluk de microfoon uit zijn hand vallen."
                                            }
