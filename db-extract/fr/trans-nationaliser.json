                "senses": [
                    {
                        "sense_id": "6d777be3-46c7-33ec-939e-d5b75226590f",
                        "entry_id": "1663196e-83d5-38f1-bf77-7a3cd017deee",
                        "glosses": [
                            "Donner un caractère trans-national à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70114fcf-9f53-4e0b-8921-00bf63e47750",
                                "sense_id": "6d777be3-46c7-33ec-939e-d5b75226590f",
                                "text": "Ce genre d’organisation criminelle est même parvenu à se trans-nationaliser, comptant des agents dans les pays limitrophes (…) (par. 70)."
                            },
                            {
                                "example_id": "28431e29-2e24-4d3c-b023-8828934bdb2d",
                                "sense_id": "6d777be3-46c7-33ec-939e-d5b75226590f",
                                "text": "Certes, sur base des analyses récentes des processus de diffusion de l’innovation technologique à l’intérieur même des firmes transnationales, on peut douter sérieusement que l’indicateur technologique retenu par cette étude soit le mieux à même, dans le cas d’une petite économie au secteur manufacturier largement trans-nationalisé, de capter l’essentiel des facteurs de compétitivité non-prix."
                            }
                        ]
                    }
