                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aus dem oberen Stockwerk war mitten in der Nacht ein leises <w>Tappen</w> zu hören."
                        },
                        {
                            "text": "Das rhythmische <w>Tappen</w> auf dem Holzboden verriet die Anwesenheit der kleinen Katze."
