                "translations": [
                    {
                        "translation_id": "dea36504-e2c4-4337-a490-c3ab261e9dd2",
                        "source_entry_id": "5b2974f9-0707-36ee-a819-bb139257ae6e",
                        "source_sense_id": "46b76850-9d19-395c-b067-02dd4b32840d",
                        "source_sense_description": "iemand liefhebben; houden van iemand",
                        "target_lang_word": "fall in love",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fall in love",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10c2dea9-6884-3fa1-82c0-64b3aa223888",
                                        "entry_id": "c2480f62-607b-3424-8ff4-703b65983cbc",
                                        "glosses": [
                                            "To come to have feelings of love, particularly romantic love."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa930074-3eb8-4a60-8d42-475f63868414",
                                                "sense_id": "10c2dea9-6884-3fa1-82c0-64b3aa223888",
                                                "text": "I fell in love with him the moment I first saw him."
                                            },
                                            {
                                                "example_id": "ade38dc4-be87-4588-9834-4cfdda2a5952",
                                                "sense_id": "10c2dea9-6884-3fa1-82c0-64b3aa223888",
                                                "text": "Have you ever fallen in love?"
                                            },
                                            {
                                                "example_id": "6403f125-1550-4ea9-a1e9-f2dec378eb92",
                                                "sense_id": "10c2dea9-6884-3fa1-82c0-64b3aa223888",
                                                "text": "It only takes a minute girl / To fall in love"
                                            },
                                            {
                                                "example_id": "fdee45b0-e401-4283-b1f4-dc2da0745fc6",
                                                "sense_id": "10c2dea9-6884-3fa1-82c0-64b3aa223888",
                                                "text": "Oh, Ophelia / You've been on my mind, girl, since the flood / Oh, Ophelia / Heaven help a fool who falls in love"
                                            },
                                            {
                                                "example_id": "15368598-03e4-495f-96db-1a2c5cdbbae2",
                                                "sense_id": "10c2dea9-6884-3fa1-82c0-64b3aa223888",
                                                "text": "Often, I am upset / That I cannot fall in love, but I guess / This avoids the stress of falling out of it"
                                            },
                                            {
                                                "example_id": "8a95f631-595c-44c3-8b77-71a0de0c0181",
                                                "sense_id": "10c2dea9-6884-3fa1-82c0-64b3aa223888",
                                                "text": "It's been a long time since you fell in love / You ain't coming out your shell, you ain't really been yourself / Tell me, what must I do? (Do tell, my love) / 'Cause luckily I'm good at reading / I wouldn't bug him, but he won't stop cheesin'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cf1448e-8e24-3e7d-a280-a4a5c48424a2",
                                        "entry_id": "c2480f62-607b-3424-8ff4-703b65983cbc",
                                        "glosses": [
                                            "To come to have feelings of love towards each other."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "reciprocal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1844ec8-cc86-4ab6-968c-5baf757a2ded",
                                                "sense_id": "0cf1448e-8e24-3e7d-a280-a4a5c48424a2",
                                                "text": "They met, fell in love, got married, and lived happily ever after."
                                            },
                                            {
                                                "example_id": "b0450448-7704-48dc-b505-53e031a86783",
                                                "sense_id": "0cf1448e-8e24-3e7d-a280-a4a5c48424a2",
                                                "text": "'Cause we were just kids when we fell in love\nNot knowing what it was\nI will not give you up this time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fede272-dd4c-326c-b008-2972e1439812",
                                        "entry_id": "c2480f62-607b-3424-8ff4-703b65983cbc",
                                        "glosses": [
                                            "To come to have feelings of intense liking directed at another person or a thing."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b63dfd49-6acb-45ad-b48f-bfc00e29c543",
                                                "sense_id": "9fede272-dd4c-326c-b008-2972e1439812",
                                                "text": "I have just fallen in love with Rome!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
