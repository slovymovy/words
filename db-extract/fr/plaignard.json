                        "glosses": [
                            "ou Personne qui se plaint ou se lamente souvent."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d9ef1f1c-83f1-4961-a92f-19c885207e66",
                                "sense_id": "63735c46-f83a-3c40-ab65-3728aa32aa49",
                                "text": "Mais il est hors de question de ralentir, le petit prince n’est pas un plaignard."
                            },
                            {
                                "example_id": "ec097a32-0f14-484d-92d3-bb44238c31f1",
                                "sense_id": "63735c46-f83a-3c40-ab65-3728aa32aa49",
                                "text": "Il se laisse faire, plaignard avec une muette espérance de ripailles qu'on paiera pour le réconforter."
                            },
                            {
                                "example_id": "c0cc0bff-7d65-495f-ae70-c5116101592f",
                                "sense_id": "63735c46-f83a-3c40-ab65-3728aa32aa49",
                                "text": "Te tairas-tu, maudit plaignard ? … crois-tu que tes éternelles lamentations feront arriver plus vite ce que nous attendons ?"
                            },
                            {
                                "example_id": "5449a6de-c4ba-45a3-bdd6-1bbffc810fd2",
                                "sense_id": "63735c46-f83a-3c40-ab65-3728aa32aa49",
                                "text": "Il ne faut pas croire tout ce qu'il dit, messieurs ! Il est un peu plaignard !"
                            }
                        ]
                    }
