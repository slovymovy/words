                        ],
                        "examples": [
                            {
                                "example_id": "9a7c048d-2dad-4965-8769-282673fb6888",
                                "sense_id": "eb52e192-8cc2-3052-ae06-4ab83cad3b72",
                                "text": "\"I wouldn't fash masel' about them, miss. Them things be all wore out.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "d5403a53-557b-3fea-ac7b-337ad050d332",
                        "entry_id": "2eca7b4d-0b48-38dd-98b5-688c9a76caa6",
                        "glosses": [
                            "To trouble oneself; to take pains."
                        ],
                        "tags": [
                            "Geordie",
                            "Northern-England",
                            "Scotland",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "48fb7b41-0156-47f4-aa67-a89f48e99a79",
                                "sense_id": "d5403a53-557b-3fea-ac7b-337ad050d332",
                                "text": "“They,” said he, meaning the collops, “are such as I gave his Royal Highness in this very house; bating the lemon juice, for at that time we were glad to get the meat and never fashed for kitchen. Indeed, there were mair dragoons than lemons in my country in the year forty-six.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "661844bd-51bc-35df-a5f2-b0d749f02608",
                        "entry_id": "2eca7b4d-0b48-38dd-98b5-688c9a76caa6",
                        "glosses": [
                            "To ignore or forget about someone or something."
                        ],
                        "tags": [
                            "Nigeria",
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3e4c474-1f2d-4d91-93ec-d91a1b4d4695",
                        "source_entry_id": "2eca7b4d-0b48-38dd-98b5-688c9a76caa6",
                        "source_sense_description": "To worry; to bother, annoy",
                        "target_lang_word": "беспоко́ить",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "беспоко́ить",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d003c416-6584-34df-a446-7814a954ecea",
                                        "entry_id": "5bdfab34-cfbc-39dc-b55a-d1ee673ed4da",
                                        "glosses": [
                                            "нарушать покой; доставлять хлопоты"
                                        ],
                                        "tags": [
                                            "кого"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "313f2c0a-ff27-47f4-93a4-a75b37a96018",
                                                "sense_id": "d003c416-6584-34df-a446-7814a954ecea",
                                                "text": "Никогда не беспокой другого тем, что ты можешь сам сделать."
                                            },
                                            {
                                                "example_id": "30a56471-0395-456f-be70-d0d4699e4b30",
                                                "sense_id": "d003c416-6584-34df-a446-7814a954ecea",
                                                "text": "— Иван Антонович, у меня к вам большая, большая просьба… — Денег? — Право, совестно вас беспокоить. Да мне немного, рублей с десяток."
                                            },
                                            {
                                                "example_id": "a9193bc3-57db-4ec5-8ae3-087f395c86d7",
                                                "sense_id": "d003c416-6584-34df-a446-7814a954ecea",
                                                "text": "И Якова Петровича что-то беспокоит во сне."
                                            },
                                            {
                                                "example_id": "c99b3c0e-0a38-49ee-ac1b-54dad9b23e5b",
                                                "sense_id": "d003c416-6584-34df-a446-7814a954ecea",
                                                "text": "— Пусть и сидят в девках. — И что за беда? — Старые девки все злы делаются. — Это только те, которым очень хотелось замуж и их темперамент беспокоит."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94454a67-bccd-3ea3-a7eb-02c17e54e711",
                                        "entry_id": "5bdfab34-cfbc-39dc-b55a-d1ee673ed4da",
                                        "glosses": [
                                            "причинять физическую боль, вызывать неприятные ощущения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20c921b0-02b3-4150-bfe9-3317681348b5",
                                                "sense_id": "94454a67-bccd-3ea3-a7eb-02c17e54e711",
                                                "text": "— Раны меня беспокоили в ненастье, да и надоела мне фронтовая служба…"
                                            },
                                            {
                                                "example_id": "f741c938-bc48-4e97-b00d-168d10ccecaa",
                                                "sense_id": "94454a67-bccd-3ea3-a7eb-02c17e54e711",
                                                "text": "Головная боль беспокоила больных в среднем 10,1 дня (от 1 до 30 дней), максимальная интенсивность головной боли отмечалась на 7-8-е сутки заболевания."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94e10133-5fa0-39d1-8b83-c50a65996f83",
                                        "entry_id": "5bdfab34-cfbc-39dc-b55a-d1ee673ed4da",
                                        "glosses": [
                                            "внушать тревогу, волновать"
                                        ],
                                        "tags": [
                                            "чем"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f14074b4-fe68-49b5-80af-1cdbbc70963c",
                                                "sense_id": "94e10133-5fa0-39d1-8b83-c50a65996f83",
                                                "text": "Илья заметил, что болезнь деда очень беспокоит буфетчика Петруху и дядю Терентия."
                                            },
                                            {
                                                "example_id": "3ba50bc2-9b00-4cea-ac2d-e4a9fdacb48e",
                                                "sense_id": "94e10133-5fa0-39d1-8b83-c50a65996f83",
                                                "text": "Присутствие же старухи, несмотря на её глухоту, беспокоило меня."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
