                        "sense_id": "1be7c9c0-7aab-3e98-84cc-abc7cc943da0",
                        "entry_id": "2e837522-bb33-3ff7-b8d0-7f07d1da934d",
                        "glosses": [
                            "unzutreffende Beschreibung eines Sachverhalts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98bc63bd-ac3b-401b-88f4-7b217984fb76",
                                "sense_id": "1be7c9c0-7aab-3e98-84cc-abc7cc943da0",
                                "text": "„Aber just vor der russischen Ausstrahlung des dritten Teils ist eine Falschdarstellung bekanntgeworden, in der es um Russlands Militäreinsatz in Syrien geht, der sich offiziell gegen Terroristen richtet.“"
                            }
                        ],
