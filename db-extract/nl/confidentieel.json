                        "translation_id": "1f3521c7-839c-4ddf-af80-8ca283f67be9",
                        "source_entry_id": "283aa3cd-7624-35f3-a21b-7365ad329453",
                        "source_sense_id": "378bdc56-87d6-35af-9e84-e39eb7ca4b89",
                        "target_lang_word": "confidentiel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confidentiel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "694fd1f4-53a5-300e-91a0-12e07d9895cf",
                                        "entry_id": "9743abd9-889f-3ebd-a3c6-9bd673f469bb",
                                        "glosses": [
                                            "Qui se fait en confidence, et qui est donc réservé à un nombre restreint de destinataires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cd6d05a-c868-4ef5-93b0-6d8e73607705",
                                                "sense_id": "694fd1f4-53a5-300e-91a0-12e07d9895cf",
                                                "text": "L'usage voulait, pour certaines correspondances véhiculant des informations confidentielles, que l'on cryptât celles-ci en recourant à des lettres ou à des chiffres qui s'apparentaient à des signes cabalistiques."
                                            },
                                            {
                                                "example_id": "ce9188a8-5a06-4c65-a4fd-4603ff0f55ac",
                                                "sense_id": "694fd1f4-53a5-300e-91a0-12e07d9895cf",
                                                "text": "Marc devient de plus en plus gênant, dis-je d’une voix murmurante, confidentielle, tandis que je souris avec la niaiserie convenant à ce qui doit passer pour une banalité de salon."
                                            },
                                            {
                                                "example_id": "70ef20de-5f7a-4d37-a527-51d370d98dd2",
                                                "sense_id": "694fd1f4-53a5-300e-91a0-12e07d9895cf",
                                                "text": "D’après ce tableau confidentiel, produit par l’Agence de l’environnement et de la maîtrise de l’énergie (Ademe), plus de la moitié des intercommunalités collectent de quoi financer largement plus de 100 % du coût réel de la collecte et du traitement des déchets ménagers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4baa57ff-c2f8-3210-978e-88fb18f1b47f",
                                        "entry_id": "9743abd9-889f-3ebd-a3c6-9bd673f469bb",
                                        "glosses": [
                                            "Par opposition à officiel."
                                        ],
                                        "tags": [
                                            "Administration",
                                            "Négociation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5613bcab-40ac-404f-8bec-284a428ab2a8",
                                                "sense_id": "4baa57ff-c2f8-3210-978e-88fb18f1b47f",
                                                "text": "Avis confidentiel."
                                            },
                                            {
                                                "example_id": "6ee6e9d9-b0de-4738-ba3a-908c84b58d9e",
                                                "sense_id": "4baa57ff-c2f8-3210-978e-88fb18f1b47f",
                                                "text": "Note confidentielle."
                                            },
                                            {
                                                "example_id": "abfa322a-e519-428b-891b-96fa3821d206",
                                                "sense_id": "4baa57ff-c2f8-3210-978e-88fb18f1b47f",
                                                "text": "Au vu de la « gravité des faits constatés », explique la ministre du Logement, Emmanuelle Cosse, dans un courrier confidentiel daté de février, Yerres devra s’acquitter d’une amende de 129,000 euros."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
