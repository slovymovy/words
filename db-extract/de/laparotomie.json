                                        "entry_id": "41bdb0db-a852-32f7-828f-e30afe5ce9ce",
                                        "glosses": [
                                            "The surgical procedure for making an incision in the abdominal wall to gain access into the abdominal cavity. Performed either as exploratory surgery, or as the first step in an abdominal operation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c80fef7c-9d3d-41da-825f-6b1c68079c31",
                                                "sense_id": "4a524d37-19df-3589-a4f7-5f2a5b036da2",
                                                "text": "Itʼs known as a laparotomy, which involves cutting open your whole abdomen."
                                            }
                                        ]
                                    }
                                ]
                            }
