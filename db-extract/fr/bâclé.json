                        ],
                        "examples": [
                            {
                                "example_id": "a6fadbd8-8479-472a-9e4c-fcb552e9d813",
                                "sense_id": "114ef479-2154-331a-9dad-9db09692fa3b",
                                "text": "Ébauche bâclée en quelques minutes, en un tour de main."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d5f2582-f898-39b6-ae1f-f99f0116c72d",
