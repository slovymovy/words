                ],
                "senses": [
                    {
                        "sense_id": "3ccd2166-9c6e-3c8b-b0b8-993e18167f69",
                        "entry_id": "22111d97-f72c-353a-a55e-f51ae4896184",
                        "glosses": [
                            "unflektierbares Wort, das eine Ergänzung (in einem bestimmten Kasus, der von der Ambiposition „regiert“ wird) fordert, wobei die Ergänzung vor- oder nachgestellt sein kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af6ba8a5-306c-4575-9c11-05a4b6436ab4",
                                "sense_id": "3ccd2166-9c6e-3c8b-b0b8-993e18167f69",
                                "text": "„Unter einer Ambiposition versteht man eine Wortart, die zur Einbindung nominaler Gruppen in einen Satz oder in Satzteile dient und die dabei sowohl vor als auch nach der Nominalgruppe stehen kann, z. B. nur wegen des Geldes – nur des Geldes wegen.“"
                            },
                            {
                                "example_id": "a0dcb7b5-387a-418b-86bb-fb29aaca9db7",
                                "sense_id": "3ccd2166-9c6e-3c8b-b0b8-993e18167f69",
                                "text": "„Es kommt auch vor, dass bestimmte Präpositionen sowohl vor als auch nach der Nominalgruppe stehen können (z. B. nach seiner Meinung vs. seiner Meinung nach; entgegen der vertraglichen Vereinbarung vs. der vertraglichen Vereinbarung entgegen). Diese werden Ambipositionen genannt.“"
                            },
                            {
                                "example_id": "81bb5ffa-f36c-4c75-a4dd-241aa9a698ac",
                                "sense_id": "3ccd2166-9c6e-3c8b-b0b8-993e18167f69",
                                "text": "„Auffällig, zumindest wenn man es sich erlaubt, die relative Seltenheit dieser Konstruktion im modernen Hindi dagegen in Rechnung zu stellen, ist die hohe Frequenz, in der Ambipositionen in den Texten auftreten […]“"
                            },
                            {
                                "example_id": "6418e7b8-c487-4a42-af92-95531ddd04de",
                                "sense_id": "3ccd2166-9c6e-3c8b-b0b8-993e18167f69",
                                "text": "„So gibt es neben Präpositionen (☒☐) wie auf ☐, über ☐, unter ☐ noch Postpositionen (☐☒) wie ☐ halber, ☐ hinauf, ☐ zuliebe […] und Zirkumpositionen (☒☐☒) wie um ☐ herum und um ☐ willen […]. Bei Ambipositionen (☒☐/☐☒) sind beide Positionen möglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
