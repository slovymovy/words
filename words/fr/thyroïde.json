            "senses": [
                {
                    "sense_id": "4332a451-3ce9-3a8b-bbbb-05d7bb63c8ee",
                    "sense_definition": "Glande endocrine située à la partie antérieure du cou, produisant des hormones essentielles à la régulation du métabolisme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin palpe le cou du patient pour vérifier si sa <w>thyroïde</w> a un volume normal."
                        },
                        {
                            "text": "Un dérèglement de la <w>thyroïde</w> peut provoquer une fatigue persistante et une prise de poids."
                        }
                    ],
                    "synonyms": [
                        "glande thyroïde"
                    ],
                    "common_phrases": [
                        "ablation de la thyroïde",
                        "cancer de la thyroïde"
                    ]
                },
                {
                    "sense_id": "c79133f9-ea09-3490-9f49-8485ab3e5dfe",
                    "sense_definition": "Cartilage le plus volumineux du larynx, formant chez l'être humain la saillie de la pomme d'Adam.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chirurgien a incisé avec précaution sous le <w>thyroïde</w> pour libérer les voies respiratoires."
                        },
                        {
                            "text": "Chez les hommes, le <w>thyroïde</w> forme une saillie bien visible appelée pomme d'Adam."
                        }
                    ],
                    "synonyms": [
                        "cartilage thyroïde"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "87a779f7-015d-3612-91b3-40914c40353f",
                    "sense_definition": "Relatif à la glande endocrine située au niveau du cou ou au cartilage antérieur du larynx.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'échographie a révélé la présence d'un nodule bénin sur la glande <w>thyroïde</w>."
                        },
                        {
                            "text": "Le cartilage <w>thyroïde</w> protège efficacement les cordes vocales situées dans le larynx."
                        }
                    ],
                    "common_phrases": [
                        "cartilage thyroïde",
                        "glande thyroïde"
                    ]
                }
            ]
