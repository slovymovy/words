    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "11ac9193-ec8d-3356-a75a-fa923aff7f9e",
                    "sense_definition": "Een onprettig of ingrijpend gevolg van een gebeurtenis of situatie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gevolg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het ongeluk had een grote <w>weerslag</w> op het drukke wegverkeer.",
                            "target_lang_translations": {
                                "en": "The accident had a major <w>impact</w> on the busy road traffic."
                            }
                        },
                        {
                            "text": "De economische crisis heeft een negatieve <w>weerslag</w> op de werkgelegenheid.",
                            "target_lang_translations": {
                                "en": "The economic crisis has a negative <w>effect</w> on employment."
                            }
                        }
                    ],
                    "synonyms": [
                        "gevolg",
                        "impact",
                        "effect"
                    ],
                    "common_phrases": [
                        "grote weerslag"
                    ],
                    "target_lang_definitions": {
                        "en": "An unpleasant or significant consequence or impact resulting from an event or situation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "impact",
                                "target_lang_sense_clarification": "The strong effect or influence of an event."
                            },
                            {
                                "target_lang_word": "repercussion",
                                "target_lang_sense_clarification": "An unintended or negative consequence of an event."
                            },
                            {
                                "target_lang_word": "effect",
                                "target_lang_sense_clarification": "A change that is a result or consequence of an action."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7d664f7-92e2-32f0-a77a-a1dcea8a7a62",
                    "sense_definition": "Een verslag, weergave of reflectie van feiten of gebeurtenissen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weergave",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De brieven geven een getrouwe <w>weerslag</w> van het feitenonderzoek.",
                            "target_lang_translations": {
                                "en": "The letters provide a faithful <w>reflection</w> of the factual investigation."
                            }
                        },
                        {
                            "text": "Dit rapport vormt een nauwkeurige <w>weerslag</w> van de besproken plannen.",
                            "target_lang_translations": {
                                "en": "This report forms an accurate <w>account</w> of the discussed plans."
                            }
                        }
                    ],
                    "synonyms": [
                        "weergave",
                        "reflectie",
                        "verslag"
                    ],
                    "common_phrases": [
                        "getrouwe weerslag"
                    ],
                    "target_lang_definitions": {
                        "en": "A report, representation, or reflection of facts or events."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reflection",
                                "target_lang_sense_clarification": "A representation or expression of something."
                            },
                            {
                                "target_lang_word": "account",
                                "target_lang_sense_clarification": "A report or description of an event or experience."
                            },
                            {
                                "target_lang_word": "representation",
                                "target_lang_sense_clarification": "The way in which something is portrayed or described."
                            }
                        ]
                    }
                }
            ]
        }
    ]
