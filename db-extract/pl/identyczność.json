                                "target_senses": [
                                    {
                                        "sense_id": "437d91bf-263d-31d0-bc93-f2665700e49c",
                                        "entry_id": "75e755e2-48f4-3491-9c63-74851bdd10ac",
                                        "glosses": [
                                            "Sameness, identicalness; the quality or fact of (several specified things) being the same."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76524576-5660-4b3e-82e8-9022f8c9501a",
                                                "sense_id": "437d91bf-263d-31d0-bc93-f2665700e49c",
                                                "text": "[…] suggesting the two are different stages of the same species. The identity of the two species is further suggested by allozyme analysis […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5944abb3-d874-373a-86df-7068650aa1eb",
                                        "entry_id": "75e755e2-48f4-3491-9c63-74851bdd10ac",
                                        "glosses": [
                                            "The difference or character that marks off an individual or collective from the rest of the same kind; selfhood; the sense of who something or someone or oneself is, or the recurring characteristics that enable the recognition of such an individual or group by others or themselves."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51e9686c-01fb-4f68-9b76-5fde6f595019",
                                                "sense_id": "5944abb3-d874-373a-86df-7068650aa1eb",
                                                "text": "I've been through so many changes, I have no sense of identity."
                                            },
                                            {
                                                "example_id": "c7552b8e-9a4f-4044-acbb-481aba6ad229",
                                                "sense_id": "5944abb3-d874-373a-86df-7068650aa1eb",
                                                "text": "This nation has a strong identity."
                                            },
                                            {
                                                "example_id": "229e5875-0ef7-4a11-a070-081918505cb1",
                                                "sense_id": "5944abb3-d874-373a-86df-7068650aa1eb",
                                                "text": "On the other hand, ME /ɛu/ preserved its identity into the early Modern English period, and the early writers on orthography and pronunciation normally distinguish between lME /iu/ and lME /ɛu/, the latter of which occurs in words with eME /ɛː/ like dew (OE dēaw), few (OE fēawe), hew (OE hēawan), sew (eME ē < ĕ, OE seowian), shrew (OE scrēawa), etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a66c0aa0-4f49-3daf-987b-843a39c34ae1",
                                        "entry_id": "75e755e2-48f4-3491-9c63-74851bdd10ac",
                                        "glosses": [
                                            "A name or persona—a mask or appearance one presents to the world—by which one is known."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b06c8fb1-8656-416b-a89c-31210def62b9",
                                                "sense_id": "a66c0aa0-4f49-3daf-987b-843a39c34ae1",
                                                "text": "This criminal has taken on several identities."
                                            },
                                            {
                                                "example_id": "48e748ba-bef9-4351-8e73-67412f7d9811",
                                                "sense_id": "a66c0aa0-4f49-3daf-987b-843a39c34ae1",
                                                "text": "In this show, the competitor's identity will remain secret until after the vote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4826d9e6-70fe-3ee8-8e45-a695e330ede1",
                                        "entry_id": "75e755e2-48f4-3491-9c63-74851bdd10ac",
                                        "glosses": [
                                            "An equation which always holds true regardless of the choice of input variables."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e168db2d-7eea-4d41-aabd-a31b3178eabe",
                                                "sense_id": "4826d9e6-70fe-3ee8-8e45-a695e330ede1",
                                                "text": "The equation (x+y)(x−y) = x²−y² is an algebraic identity. It is true regardless of the values of x and y."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc406e8e-f7c7-3ce5-a78e-d62a523717b8",
                                        "entry_id": "75e755e2-48f4-3491-9c63-74851bdd10ac",
                                        "glosses": [
                                            "Any function which maps all elements of its domain to themselves."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be6cdf7b-9fa3-320b-9c59-e9a30f84f7fa",
                                        "entry_id": "75e755e2-48f4-3491-9c63-74851bdd10ac",
                                        "glosses": [
                                            "An element of an algebraic structure which, when applied to another element under an operation in that structure, yields this second element."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52ce82ad-4802-4ece-9946-2955f25c79b1",
                                                "sense_id": "be6cdf7b-9fa3-320b-9c59-e9a30f84f7fa",
                                                "text": "Zero is the identity for the addition of real numbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1431f939-d5a7-3208-a08c-81630c348e12",
                                        "entry_id": "75e755e2-48f4-3491-9c63-74851bdd10ac",
                                        "glosses": [
                                            "A well-known or famous person."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9beed88-ae76-4cdb-aa92-c7c2b9ef6a97",
                                                "sense_id": "1431f939-d5a7-3208-a08c-81630c348e12",
                                                "text": "The body of a well known old identity named James Conroy […] was found in the water yesterday afternoon…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1164207-2264-4ed1-b3cc-806b847e8fbe",
                        "source_entry_id": "99257ddb-d517-333b-9c0d-0171a7656895",
                        "source_sense_id": "1c4af351-be66-33b0-a32e-cc5f0d9b1875",
                        "target_lang_word": "identité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "identité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c61ffe3-f5cf-39bf-bec0-78114aae1770",
                                        "entry_id": "ef321978-0873-3081-85db-7a6b8fc56809",
                                        "glosses": [
                                            "Ce qui fait qu’une chose est la même qu’une autre, que deux ou plusieurs choses ne sont qu’une ou sont comprises sous une même idée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21e6b114-671f-47ff-acf8-1018944e6afb",
                                                "sense_id": "7c61ffe3-f5cf-39bf-bec0-78114aae1770",
                                                "text": "Joseph Halévy (1827-1917) qui, le premier défendit la thèse de l’identité entre Hammurabi et l’Amraphel biblique, ont aidé à la compréhension des inscriptions suméro-akkadiennes."
                                            },
                                            {
                                                "example_id": "83195f26-e739-4262-b931-f34fee21a560",
                                                "sense_id": "7c61ffe3-f5cf-39bf-bec0-78114aae1770",
                                                "text": "Pour confirmer l’identité du diamant et du carbone pur, M. Hachette avoit proposé à ses amis , MM. Clouet et Welter, de convertir le fer en acier par le diamant; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47d72f1a-9074-3bc0-aaac-233ce518a1cf",
                                        "entry_id": "ef321978-0873-3081-85db-7a6b8fc56809",
                                        "glosses": [
                                            "Personnalité civile d’un individu, légalement reconnue ou constatée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "125af704-f6fe-4fba-a342-51bbad1910d9",
                                                "sense_id": "47d72f1a-9074-3bc0-aaac-233ce518a1cf",
                                                "text": "Si le déporté rentre sur le territoire du Royaume, il sera, sur la seule preuve de son identité, condamné aux travaux forcés à perpétuité."
                                            },
                                            {
                                                "example_id": "8ecef1c8-8166-4007-bf48-7132ae1b63f2",
                                                "sense_id": "47d72f1a-9074-3bc0-aaac-233ce518a1cf",
                                                "text": "[…] ; le chatbot CYBERLOVER a attiré l'attention des autorités en raison de son penchant à amener les internautes à divulguer suffisamment d'informations personnelles pour que leur identité puisse être usurpée."
                                            },
                                            {
                                                "example_id": "6d0b1fba-920e-4490-a3f5-7cff111d78bd",
                                                "sense_id": "47d72f1a-9074-3bc0-aaac-233ce518a1cf",
                                                "text": "En 2009, le CAAC a reçu le signalement de fraude d’identité de la part de 11,095 victimes au pays, pour des pertes de plus de 10 millions de dollars, ce qui représente une hausse de plus de 1 million de dollars par rapport à 2008."
                                            },
                                            {
                                                "example_id": "4b03c7c6-05e0-4e70-8b75-63fbddf9bb9b",
                                                "sense_id": "47d72f1a-9074-3bc0-aaac-233ce518a1cf",
                                                "text": "Une page Facebook au nom de votre entreprise, même vide, est une manière d'éviter le « cybersquat», c'est-à-dire que quelqu'un usurpe votre identité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ca29a13-43f2-3058-979f-9d72ff82d1cf",
                                        "entry_id": "ef321978-0873-3081-85db-7a6b8fc56809",
                                        "glosses": [
                                            "Caractère unique d'une communauté humaine formant une unité, une nation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d7e0712-a348-4dbb-92ee-eb7ab321b890",
                                                "sense_id": "9ca29a13-43f2-3058-979f-9d72ff82d1cf",
                                                "text": "Sur un plan plus particulier, quiconque a lu mes textes sait que j'ai toujours fustigé les identités, les sectes et les folklores, ironisé sur la « gouroufication » et les « japoniaiseries »."
                                            },
                                            {
                                                "example_id": "23d9070c-3a40-4f3c-ac43-4e14b8522803",
                                                "sense_id": "9ca29a13-43f2-3058-979f-9d72ff82d1cf",
                                                "text": "Les violations des droits de l’homme y prennent un caractère distinct car elles ont pour but d’empêcher les Tibétains en tant que peuple d’affirmer leur identité propre et leur culture spécifique ainsi que leur désir de les défendre."
                                            },
                                            {
                                                "example_id": "2e0cb710-8d6b-44d2-9aae-d9b1a7209907",
                                                "sense_id": "9ca29a13-43f2-3058-979f-9d72ff82d1cf",
                                                "text": "La France est sans doute la seule nation à laquelle il était loisible d'adhérer par autre chose que son identité, la seule nation à laquelle on puisse se rallier par sa culture et par sa langue. Je n'aime d'ailleurs pas la référence, omniprésente actuellement, à l'identité. Et je me méfie des raisonnements sur l'identité."
                                            },
                                            {
                                                "example_id": "3931b393-f560-4a7a-8092-8b20d2cac610",
                                                "sense_id": "9ca29a13-43f2-3058-979f-9d72ff82d1cf",
                                                "text": "Le coup de sang du directeur général, très enclin il est vrai à de telles impétuosités, renvoie sans aucun doute à un élément essentiel de l'identité des cheminots : on ne plaisante pas avec la sécurité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4598cb38-4062-387d-ae33-429b625f3129",
                                        "entry_id": "ef321978-0873-3081-85db-7a6b8fc56809",
                                        "glosses": [
                                            "Ensemble de caractères attribués à une personne et influençant son comportement et ses relations sociales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c415f9df-5c36-4c9b-94f1-0c8024be7483",
                                                "sense_id": "4598cb38-4062-387d-ae33-429b625f3129",
                                                "text": "Conquérir notre identité sexuelle, c'est apprendre à l'assumer, à lui donner sa juste place autant dans notre identité interpersonnelle et sociale que dans notre façon d'être en relation avec notre environnement et dans notre comportement"
                                            },
                                            {
                                                "example_id": "0056833d-1a6c-4e5c-b5b6-4d8aff982bbf",
                                                "sense_id": "4598cb38-4062-387d-ae33-429b625f3129",
                                                "text": "Comment définir mon identité : par ma ou mes langue(s), mon sexe, mon occupation et mon expérience de travail, mon âge,... Mon identité m’apparaît complexe, multi-dimensionnelle. Les mots me manquent."
                                            },
                                            {
                                                "example_id": "b38ddb64-e13c-4d79-a590-c883ea502059",
                                                "sense_id": "4598cb38-4062-387d-ae33-429b625f3129",
                                                "text": "Et cette identité peut fort bien se décliner de la façon la plus typée qui soit : non seulement ces jeunes refusent d’abandonner leur identité Beatles au seuil de l'établissement qu'ils fréquentent, mais ils se réclament d'une posture rebelle qui ne prédispose ni à la discrétion ni à l’invisibilité."
                                            },
                                            {
                                                "example_id": "429bc392-1577-48f6-84b8-4aa525d05fdb",
                                                "sense_id": "4598cb38-4062-387d-ae33-429b625f3129",
                                                "text": "La capacité à ne pas se percevoir uniquement comme une junkie, une looser ou une prostituée, mais d'imaginer d'autres identités, semble contribuer de manière déterminante à engager, avec une chance de succès, un processus de sortie de la drogue […]."
                                            },
                                            {
                                                "example_id": "ede4620b-3c1c-4216-b0e9-d14a155cbe57",
                                                "sense_id": "4598cb38-4062-387d-ae33-429b625f3129",
                                                "text": "Notre vie de table, notre identité ou non de gastronome, nous permet de gravir pas à pas l'échelle allant des besoins physiologiques aux plaisirs alimentaires. Penser sa nourriture, c'est réfléchir au rapport qui existe entre l'homme, ce qui l'entoure et ce qui le fait grandir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "294be078-e9e7-3666-8a9a-39ea522b9af4",
                                        "entry_id": "ef321978-0873-3081-85db-7a6b8fc56809",
                                        "glosses": [
                                            "Espèce d’équation ou d’égalité dont les deux membres sont identiquement les mêmes, quelles que puissent être les valeurs attribuées aux lettres qui constituent cette équation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b518dbc-bfdb-4a11-b96c-51311c7626c3",
                                                "sense_id": "294be078-e9e7-3666-8a9a-39ea522b9af4",
                                                "text": "Les identités ne peuvent conduire à aucune solution ; elles se réduisent toutes à celle-ci : 0 = 0."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f5fc8a2-d916-3e6a-8112-5193835c2137",
                                        "entry_id": "ef321978-0873-3081-85db-7a6b8fc56809",
                                        "glosses": [
                                            "La fonction identité est la fonction mathématique dont tout élément image est égal à son unique antécédent."
                                        ],
                                        "tags": [
                                            "Théorie des ensembles"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51bc6320-fe8a-45d4-9877-aec960c51ae3",
                        "source_entry_id": "99257ddb-d517-333b-9c0d-0171a7656895",
                        "source_sense_id": "1c4af351-be66-33b0-a32e-cc5f0d9b1875",
