                        "glosses": [
                            "A fountain on Mount Helicon, sacred to the Muses and formed by the hooves of Pegasus, the waters of which were supposed to give poetic inspiration when imbibed."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
