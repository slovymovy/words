                    {
                        "sense_id": "eedfadb2-ab26-3b46-8211-164cb3a154cd",
                        "entry_id": "dae42355-4ec6-396d-9489-b3a4521888fd",
                        "glosses": [
                            "Übernahme der Pflichten und Rechte eines Monarchen durch dessen Nachfolger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49c65e34-bc64-4dbe-9a9e-52f238c24048",
                                "sense_id": "eedfadb2-ab26-3b46-8211-164cb3a154cd",
                                "text": "Nach dem frühen Tod seines Vaters musste der junge König bereits mit siebzehn Jahren die Thronfolge antreten."
                            },
                            {
                                "example_id": "40dbf3d3-ed35-4f1b-aa08-e8b252789c5d",
                                "sense_id": "eedfadb2-ab26-3b46-8211-164cb3a154cd",
                                "text": "„Timur Schah hinterließ 24 Söhne und hatte versäumt, seine Thronfolge zu regeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
