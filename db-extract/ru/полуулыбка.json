                "senses": [
                    {
                        "sense_id": "71c073a2-f402-38b8-ae80-6e00c9d2731c",
                        "entry_id": "0735485c-7053-37c1-b900-2978859e3c69",
                        "glosses": [
                            "лёгкая, едва заметная улыбка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23147809-8038-4d1c-b881-f6c19d0d4242",
                                "sense_id": "71c073a2-f402-38b8-ae80-6e00c9d2731c",
                                "text": "Через несколько дней мы уже обменивались теми быстрыми полуулыбками, которые при встрече появляются на губах незнакомых, но постоянно видящих друг друга людей."
                            },
                            {
                                "example_id": "452b7a3d-70b9-4ef6-8b08-b1d974b96641",
                                "sense_id": "71c073a2-f402-38b8-ae80-6e00c9d2731c",
                                "text": "Его полуулыбка выглядела торжествующе, я поддался ей, тоже чуть улыбнулся…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4303e52-ce63-4eae-9908-58d429f8b492",
                        "source_entry_id": "0735485c-7053-37c1-b900-2978859e3c69",
                        "source_sense_id": "71c073a2-f402-38b8-ae80-6e00c9d2731c",
                        "target_lang_word": "semi-smile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "semi-smile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a2e8ebd-4247-3383-b24e-5cfec7b06832",
                                        "entry_id": "28bdecd6-1f62-37c3-b34c-92c911249b72",
                                        "glosses": [
                                            "A faint smile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a8d21af-f6b0-4d71-a963-aafadbc5d038",
                                                "sense_id": "5a2e8ebd-4247-3383-b24e-5cfec7b06832",
                                                "text": "She curled her pink lips upward in a shy semi-smile."
                                            },
                                            {
                                                "example_id": "dd2ed885-b434-45db-99d0-b5ff36ec103e",
                                                "sense_id": "5a2e8ebd-4247-3383-b24e-5cfec7b06832",
                                                "text": "I saw him glance at his wife, and she gave a semi-smile of approval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42c2f094-2ae2-3501-8a80-915fc12efe77",
                                        "entry_id": "28bdecd6-1f62-37c3-b34c-92c911249b72",
                                        "glosses": [
                                            "A suppressed or forced smile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d359863-c250-4a5c-bfa3-98d3f7a5e7ad",
                                                "sense_id": "42c2f094-2ae2-3501-8a80-915fc12efe77",
                                                "text": "He stood looking at nothing in particular, with the blushing, awkward air and semi-smile which are common to shy boys when in company, -- very much as if they had come into the world by mistake, and found it in a degree of undress that was quite embarrassing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
