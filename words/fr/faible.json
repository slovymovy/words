            "senses": [
                {
                    "sense_id": "144b616c-64f4-33d9-ad1a-30138e800da9",
                    "sense_definition": "Penchant particulier, préférence marquée ou goût très vif pour quelqu'un ou quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "penchant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai un <w>faible</w> pour les pâtisseries au chocolat préparées par ma grand-mère."
                        },
                        {
                            "text": "Elle avoue avoir un véritable <w>faible</w> pour la musique classique italienne."
                        }
                    ],
                    "common_phrases": [
                        "avoir un faible pour"
                    ]
                },
                {
                    "sense_id": "b74b9f70-8bf1-3393-9f38-67bd2729eca3",
                    "sense_definition": "Personne qui manque de force, de puissance, de moyens ou d'influence.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personne_vulnerable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La loi doit protéger le <w>faible</w> contre les abus de pouvoir du puissant."
                        },
                        {
                            "text": "Il défend toujours les <w>faibles</w> face aux injustices commises au travail."
                        }
                    ],
                    "synonyms": [
                        "faiblard"
                    ],
                    "antonyms": [
                        "fort"
                    ]
                },
                {
                    "sense_id": "6d61aebb-8755-3bd2-ba2f-e673fbd2903b",
                    "sense_definition": "Partie ou aspect qui présente le moins de résistance, d'épaisseur ou de solidité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "partie_vulnerable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'escrimeur a su attaquer habilement le <w>faible</w> de la lame adverse."
                        },
                        {
                            "text": "Les assiégeants concentrèrent le tir de leurs canons sur le <w>faible</w> de la muraille."
                        }
                    ],
                    "antonyms": [
