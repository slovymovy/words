                        "entry_id": "1c12f614-114a-31d1-8223-4931e9ed7c7e",
                        "glosses": [
                            "groep muzikanten met blaasinstrumenten die klassieke muziek spelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8f6cd87-fa14-4acf-88e6-a825f965cdae",
                                "sense_id": "914c61f4-a055-379b-9e70-e7074bc2d6c6",
                                "text": "Het programma was samengesteld door Bart Schneeman, de artistiek leider van het Nederlands Blazersensemble. Hij had uit honderden inzendingen 33 odes gekozen die vanavond werden opgevoerd. Het getal 33 staat voor de 33 jaar dat Beatrix koningin was."
                            },
                            {
                                "example_id": "d8575284-1f75-4a80-be27-de23b11bdc98",
                                "sense_id": "914c61f4-a055-379b-9e70-e7074bc2d6c6",
                                "text": "In Ahoy brengen 'gewone burgers' dan odes aan de voormalige koningin. Ze worden ondersteund door het Nederlands Blazersensemble. Het evenement wordt rechtstreeks uitgezonden door de NOS."
                            },
                            {
                                "example_id": "462bf7ce-48ed-441f-aa96-9acad9fda576",
                                "sense_id": "914c61f4-a055-379b-9e70-e7074bc2d6c6",
                                "text": "Als muziekwens voor de inhuldiging in 1980 had de koninklijke familie gevraagd om een orgel met zangkoor en het Nederlands blazersensemble. Toenmalig premier Van Agt vond het geheel nogal protestants en wees erop dat het verstandig zou zijn als het programma ook een katholiek element bevatte."
                            }
                        ]
                    }
