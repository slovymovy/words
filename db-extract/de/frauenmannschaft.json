                ],
                "senses": [
                    {
                        "sense_id": "2505a21d-4f0e-36ac-af7a-9a4ec7459ba9",
                        "entry_id": "e7bed207-7557-37f6-96d8-2fdf41a0517f",
                        "glosses": [
                            "Mannschaft, die nur aus Frauen besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0e8915f-bf52-4735-8653-223525b595c6",
                                "sense_id": "2505a21d-4f0e-36ac-af7a-9a4ec7459ba9",
                                "text": "„Der FC Jeunesse Molenbeek Académie, der am alten Stade de Sippelberg in Brüssel trainiert und dessen Nachwuchskicker zu 85 Prozent maghrebinischer Herkunft sind (die Frauenmannschaft mit eingerechnet), leistet einen wichtigen Beitrag zur Integration.“"
                            },
                            {
                                "example_id": "dd7949c0-e176-4a82-a150-059fd3c7a01b",
                                "sense_id": "2505a21d-4f0e-36ac-af7a-9a4ec7459ba9",
                                "text": "„Ein Grossteil der Fans setzte mit einem Besuch des Spiels der Aarauer Frauenmannschaft ein Zeichen gegen die schwachen Auftritte in dieser Saison.“"
                            },
                            {
                                "example_id": "7069f9cb-e35a-44fe-a1b9-7fe1d8ef6e0d",
                                "sense_id": "2505a21d-4f0e-36ac-af7a-9a4ec7459ba9",
                                "text": "„Die Frauenmannschaft des Taschner-Gymnasiums ist im Bundesfiale vom Pech verfolgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
