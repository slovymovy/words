                    {
                        "sense_id": "3b2d7e91-a340-364b-bd3e-dc3cb5146026",
                        "entry_id": "bbea272f-1fc0-33b6-8217-934e852733a1",
                        "glosses": [
                            "Person, die etwas zu jemandem bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd6729e3-c604-4105-8a49-60a1b9df940e",
                                "sense_id": "3b2d7e91-a340-364b-bd3e-dc3cb5146026",
                                "text": "„Unterdessen war von dem Ministerialrat An ein Brief eingetroffen, und Simen Tjing mußte den Überbringer bewirten, bevor er ihn entließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55b64d12-0d9e-4127-8029-2860e4044244",
                        "source_entry_id": "bbea272f-1fc0-33b6-8217-934e852733a1",
                        "source_sense_id": "3b2d7e91-a340-364b-bd3e-dc3cb5146026",
                        "source_sense_description": "Person, die etwas zu jemandem bringt",
                        "target_lang_word": "portador",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portador",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "0a51ec4a-ab0d-3276-9b31-2471239ddb3a",
                                        "entry_id": "8e6e52dc-68ab-3e93-8a5e-94957d295e50",
                                        "glosses": [
                                            "o que traz ou leva"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25127db3-9719-3bcf-8ccf-672e26426634",
                                        "entry_id": "8e6e52dc-68ab-3e93-8a5e-94957d295e50",
                                        "glosses": [
                                            "pessoa ou animal que sofre de uma doença infecciosa, não-infecciosa adquirida ou de origem inata"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7befc2aa-b25d-4c9d-91e5-6cd900129ee0",
                                                "sense_id": "25127db3-9719-3bcf-8ccf-672e26426634",
                                                "text": "Como mineiro, trabalhou num tempo em que as normas de resguardo da saúde do trabalhador não eram tão evoluídas. E se tornou mais um entre muitos portadores de silicose."
                                            },
                                            {
                                                "example_id": "2b36135c-98d9-4bcd-b7ba-f6d524ad7ecc",
                                                "sense_id": "25127db3-9719-3bcf-8ccf-672e26426634",
                                                "text": "Ela era uma portadora de uma síndrome rara e desconhecida da maioria até então."
                                            },
                                            {
                                                "example_id": "9c21749c-1d4c-4e65-9f9d-6ed5fa702bb3",
                                                "sense_id": "25127db3-9719-3bcf-8ccf-672e26426634",
                                                "text": "Normas de segurança para evitar a proliferação de doenças como das cepas mais agressivas de gripes, consistem-se em tentar evitar que portadores tenham contato com não portadores evitando epidemias mundiais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
