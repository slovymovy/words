            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d6d6ad6-a935-313c-80b3-74b5a8a6cdea",
                    "sense_definition": "Главная, обычно старейшая часть города, где сосредоточена культурная и деловая жизнь.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы живём в самом <w>центре</w> Москвы.",
                            "target_lang_translations": {
                                "en": "We live in the very <w>center</w> of Moscow.",
                                "zh": "我们住在莫斯科的<w>市中心</w>。"
                            }
                        },
                        {
                            "text": "Туристы любят гулять в историческом <w>центре</w> города.",
                            "target_lang_translations": {
                                "en": "Tourists love walking in the historic city <w>center</w>.",
                                "zh": "游客们喜欢在城市的历史<w>中心</w>散步。"
                            }
                        }
                    ],
                    "antonyms": [
                        "окраина",
                        "пригород"
                    ],
                    "common_phrases": [
                        "в центре города",
                        "исторический центр",
                        "поехать в центр"
                    ],
                    "target_lang_definitions": {
                        "en": "The main, usually oldest part of a city where cultural and business life is concentrated.",
                        "zh": "城市的主要部分，通常也是最古老的部分，是文化和商业活动的集中地。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "center",
                                "target_lang_sense_clarification": "of a city"
                            },
                            {
                                "target_lang_word": "city center",
                                "target_lang_sense_clarification": "central district"
                            },
                            {
                                "target_lang_word": "downtown",
                                "target_lang_sense_clarification": "business district"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "市中心",
                                "target_lang_sense_clarification": "城市的核心区域"
                            },
                            {
                                "target_lang_word": "中心",
                                "target_lang_sense_clarification": "城市的核心地带"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a245156-129e-3700-ad8a-328f66a5d5cb",
                    "sense_definition": "Середина чего-либо; точка, равноудалённая от краёв.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель нарисовал точку в <w>центре</w> круга.",
                            "target_lang_translations": {
                                "en": "The teacher drew a dot in the <w>center</w> of the circle.",
                                "zh": "老师在圆的<w>中心</w>画了一个点。"
                            }
                        },
                        {
                            "text": "Стол стоит в <w>центре</w> большой комнаты.",
                            "target_lang_translations": {
                                "en": "The table stands in the <w>center</w> of the big room.",
                                "zh": "桌子摆在大房间的<w>中间</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "середина"
                    ],
                    "antonyms": [
                        "край",
                        "периферия"
                    ],
                    "common_phrases": [
                        "центр круга",
                        "в центре стола",
                        "центр Земли"
                    ],
                    "target_lang_definitions": {
                        "en": "The middle point of something; a point equidistant from the edges.",
                        "zh": "某物的中间点；与边缘等距离的点。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "center",
                                "target_lang_sense_clarification": "geometric point"
                            },
                            {
                                "target_lang_word": "middle",
                                "target_lang_sense_clarification": "central part"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中心",
                                "target_lang_sense_clarification": "几何中心点"
                            },
                            {
                                "target_lang_word": "中间",
                                "target_lang_sense_clarification": "位置的中央"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf29304d-c43e-355f-8c29-f416ab9fa34e",
                    "sense_definition": "Учреждение или организация, занимающаяся определённой деятельностью, управлением или обслуживанием.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В выходные мы часто ходим в торговый <w>центр</w> за покупками.",
                            "target_lang_translations": {
                                "en": "On weekends we often go to the shopping <w>center</w> to buy things.",
                                "zh": "周末我们经常去购物<w>中心</w>买东西。"
                            }
                        },
                        {
                            "text": "Вам нужно обратиться в сервисный <w>центр</w> для ремонта телефона.",
                            "target_lang_translations": {
                                "en": "You need to contact the service <w>center</w> to repair the phone.",
                                "zh": "你需要联系服务<w>中心</w>来修理手机。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "торговый центр",
                        "бизнес-центр",
                        "медицинский центр",
                        "культурный центр"
                    ],
                    "target_lang_definitions": {
                        "en": "An institution or organization dedicated to a specific activity, management, or service.",
                        "zh": "专门从事特定活动、管理或服务的机构或组织。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "center",
                                "target_lang_sense_clarification": "facility or organization"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中心",
                                "target_lang_sense_clarification": "机构或设施"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0a06ac8-3cd8-32ea-a2ab-78e58255ba85",
                    "sense_definition": "Место сосредоточения чего-либо; то, что привлекает наибольшее внимание или является главным.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_focus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Известная актриса снова оказалась в <w>центре</w> внимания журналистов.",
                            "target_lang_translations": {
                                "en": "The famous actress was once again at the <w>center</w> of journalists' attention.",
                                "zh": "这位著名女演员再次成为了记者关注的<w>中心</w>。"
                            }
                        },
                        {
                            "text": "Этот город стал крупным промышленным <w>центром</w> региона.",
                            "target_lang_translations": {
                                "en": "This city has become a major industrial <w>center</w> of the region.",
                                "zh": "这座城市已成为该地区重要的工业<w>中心</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "средоточие",
                        "фокус"
                    ],
                    "common_phrases": [
                        "центр внимания",
                        "центр событий",
                        "центр тяжести"
                    ],
                    "target_lang_definitions": {
                        "en": "A place where something is concentrated; that which attracts the most attention or is main.",
                        "zh": "某事物集中的地方；吸引最多注意力的事物或核心。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "center",
                                "target_lang_sense_clarification": "focus of attention or activity"
                            },
                            {
                                "target_lang_word": "focus",
                                "target_lang_sense_clarification": "central point of interest"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中心",
                                "target_lang_sense_clarification": "关注或活动的焦点"
                            },
                            {
                                "target_lang_word": "焦点",
                                "target_lang_sense_clarification": "关注的中心点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3724f8d-2e5c-3b43-b480-c64604af1eaf",
                    "sense_definition": "Высший руководящий орган какой-либо организации или группы.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Региональные отделения должны согласовывать свои действия с <w>центром</w>.",
                            "target_lang_translations": {
                                "en": "Regional branches must coordinate their actions with the <w>center</w>.",
                                "zh": "地区分部必须与<w>中央</w>协调行动。"
                            }
                        },
                        {
                            "text": "Приказ пришёл непосредственно из <w>центра</w>.",
                            "target_lang_translations": {
                                "en": "The order came directly from <w>headquarters</w>.",
                                "zh": "命令直接来自<w>总部</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "руководство",
                        "штаб"
                    ],
                    "antonyms": [
                        "филиал"
                    ],
                    "common_phrases": [
                        "федеральный центр",
                        "единый центр"
                    ],
                    "target_lang_definitions": {
                        "en": "The highest governing body of an organization or group.",
                        "zh": "组织或团体的最高领导机构。"
                    },
                    "translations": {
