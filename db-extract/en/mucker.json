                                    {
                                        "sense_id": "bcea228e-b2f4-3142-b8e8-1ae8129d063b",
                                        "entry_id": "b923e996-2456-3c88-a90d-447fe790bfb8",
                                        "glosses": [
                                            "člen party"
                                        ],
                                        "tags": [
