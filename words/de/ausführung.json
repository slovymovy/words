                        "zur Ausführung kommen"
                    ]
                },
                {
                    "sense_id": "a7e15134-d84b-37bc-afa3-a0c080e49d45",
                    "sense_definition": "Besondere Bauart, Variante oder Herstellungsweise eines Gegenstands.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Modellvariante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dieses neue Smartphone ist in einer besonders leichten <w>Ausführung</w> erhältlich."
                        },
                        {
                            "text": "Wir bieten den Schrank in verschiedenen praktischen <w>Ausführungen</w> aus Holz an."
