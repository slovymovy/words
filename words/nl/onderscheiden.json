                    "sense_id": "4e8e914c-9383-3e26-854d-8c17fcd645a5",
                    "sense_definition": "Van elkaar afwijkend; niet hetzelfde.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "diversity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zijn <w>onderscheiden</w> redenen om voor deze aanpak te kiezen.",
                            "target_lang_translations": {
                                "ru": "Существуют <w>различные</w> причины выбрать этот подход.",
                                "en": "There are <w>distinct</w> reasons to choose this approach.",
                                "fr": "Il existe de <w>distinctes</w> raisons de choisir cette approche."
                            }
                        },
                        {
                            "text": "De <w>onderscheiden</w> groepen in de samenleving hebben elk hun eigen belangen.",
                            "target_lang_translations": {
                                "ru": "<w>Различные</w> группы в обществе имеют свои собственные интересы.",
                                "en": "The <w>distinct</w> groups in society each have their own interests.",
                                "fr": "Les <w>différents</w> groupes de la société ont chacun leurs propres intérêts."
                            }
                        }
