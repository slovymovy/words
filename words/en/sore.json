                    "sense_definition": "Feeling anger, annoyance, or resentment towards someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a <w>sore</w> loser and refused to shake hands after the game.",
