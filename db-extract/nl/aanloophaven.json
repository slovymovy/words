                                        "entry_id": "f01bc05f-525c-3490-82d7-2b16fc81c611",
                                        "glosses": [
                                            "Any port (except its home port) being visited by a ship, especially to load or unload cargo or passengers or to take on supplies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ab5af8f-5510-4b65-8663-9fe0979559e1",
                                                "sense_id": "28a4fe81-f92d-3d6a-8e83-d6e4cc2eb1c9",
                                                "text": "Serving the flat and fertile south-eastern part of Co. Cork is the railway that runs from Glanmire Road Station in Cork City to the popular seaside resort of Youghal (pronounced \"Yawl\") and the town of Cobh (pronounced \"Cove\"), which is Ireland's port of call for transatlantic liners."
                                            }
                                        ]
                                    },
                                    {
