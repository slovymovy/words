                                "target_senses": [
                                    {
                                        "sense_id": "2ebc155a-2dc7-3ec2-8585-5caa94d7c3ee",
                                        "entry_id": "1be1adf7-766f-3b82-98b4-261994c0e8d6",
                                        "glosses": [
                                            "A loud, ringing sound, like that made by free-hanging metal objects striking each other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54ece275-70de-4919-b4e7-e4c44f6ff44d",
                                                "sense_id": "2ebc155a-2dc7-3ec2-8585-5caa94d7c3ee",
                                                "text": "Bang, bang, Maxwell's silver hammer\nCame down upon her head\nClang, clang, Maxwell's silver hammer\nMade sure that she was dead"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a655f86-b936-39b3-b6e7-5bbbbfe10e22",
                                        "entry_id": "1be1adf7-766f-3b82-98b4-261994c0e8d6",
                                        "glosses": [
                                            "Quality of tone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f2beffc-a12e-3ce8-995d-361d87786ff8",
                                        "entry_id": "1be1adf7-766f-3b82-98b4-261994c0e8d6",
                                        "glosses": [
                                            "The cry of some birds, including the crane and the goose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c47c502-984d-3c7f-b34e-ffeb3b72751b",
                                        "entry_id": "1be1adf7-766f-3b82-98b4-261994c0e8d6",
                                        "glosses": [
                                            "A word or phrase linked only by sound and not by meaning, characteristic of some mental disorders."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb50578c-6797-409c-985c-c0b5b7968a09",
                                                "sense_id": "5c47c502-984d-3c7f-b34e-ffeb3b72751b",
                                                "text": "For much of this day, Mrs Y. wrote in her diary, covering page after page in a rapid scrawl full of paligraphic repetitions, puns, clangs, and violent, perseverative crossings-out […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed4232cc-b104-3f4b-8a31-988015a8be83",
                                        "entry_id": "1be1adf7-766f-3b82-98b4-261994c0e8d6",
                                        "glosses": [
                                            "Alternative form of klang."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8588f355-1571-45b7-8213-b90590efa874",
                        "source_entry_id": "773acf45-74f6-3485-8326-8bc821a84455",
                        "source_sense_id": "cac7b714-71a8-345a-9f9d-be1c29eda5b7",
                        "target_lang_word": "clank",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39fcf987-f5f8-3e0d-8b41-400f1a28638b",
                                        "entry_id": "150ddbe0-9db3-397d-aa07-d4d63ce86c4e",
                                        "glosses": [
                                            "A loud, hard sound of metal hitting metal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db431c24-f711-3f9c-98a8-f80289c7fd88",
                                        "entry_id": "beff5c88-5cb2-3b45-9f9f-98131289affd",
                                        "glosses": [
                                            "To make a clanking sound"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6467067f-f975-46de-b114-5ac9440cd44f",
                                                "sense_id": "db431c24-f711-3f9c-98a8-f80289c7fd88",
                                                "text": "The chains clanked."
                                            },
                                            {
                                                "example_id": "80b91bed-f803-4c8c-ba63-383a806a8dfc",
                                                "sense_id": "db431c24-f711-3f9c-98a8-f80289c7fd88",
                                                "text": "Slung from his shoulders clanks a two-handed sword, the pommel a huge star-ruby carven in the image of a heart, for the heart is his sign and symbol."
                                            },
                                            {
                                                "example_id": "d2970063-d5f4-4880-aec6-2404ae3f463a",
                                                "sense_id": "db431c24-f711-3f9c-98a8-f80289c7fd88",
                                                "text": "Far less straightforward was what happened at about 0130 on Friday June 2 1944, as a long goods train was chuffing and clanking its unhurried way across the darkened landscape towards Soham, from Ely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26811f9a-a148-3ce7-ad8a-dd6ff834f0b8",
                                        "entry_id": "beff5c88-5cb2-3b45-9f9f-98131289affd",
                                        "glosses": [
                                            "To cause to sound with a clank."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01ee06a0-c3aa-4f4d-883e-87402bc45848",
                                                "sense_id": "26811f9a-a148-3ce7-ad8a-dd6ff834f0b8",
                                                "text": "The prisoners clank their chains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e403f8f3-3a6c-44ea-9805-896d4ae63211",
                        "source_entry_id": "773acf45-74f6-3485-8326-8bc821a84455",
                        "source_sense_id": "cac7b714-71a8-345a-9f9d-be1c29eda5b7",
                        "target_lang_word": "cliquetis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cliquetis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b79e70b-3618-37ce-b9f0-8fc5bb02003b",
                                        "entry_id": "57e42bbb-69ce-36fe-92e2-03f3b778f9ba",
                                        "glosses": [
                                            "Bruit que font des armes blanches quand on les choque les unes contre les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b78ea49-d651-4670-bcf8-c359739200a9",
                                                "sense_id": "5b79e70b-3618-37ce-b9f0-8fc5bb02003b",
                                                "text": "Leurs ordres étaient étouffés par le cliquetis des armes et les cris assourdissants de ceux à qui ils s’adressaient."
                                            },
                                            {
                                                "example_id": "a053e875-1896-4c7c-9fa7-b5f3cf3cfd02",
                                                "sense_id": "5b79e70b-3618-37ce-b9f0-8fc5bb02003b",
                                                "text": "Le vieillard et sa fille […] distinguèrent alors un bruit d'éperons et un cliquetis d'épées qui retentirent sous le sonore péristyle du château."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce13bf8b-f394-3f72-b548-4c07f84d7800",
                                        "entry_id": "57e42bbb-69ce-36fe-92e2-03f3b778f9ba",
                                        "glosses": [
                                            "Bruit semblable que font certains autres corps sonores lorsqu’on les remue ou qu’on les choque."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30856cbb-5df5-474d-948f-0fe9735cf97e",
                                                "sense_id": "ce13bf8b-f394-3f72-b548-4c07f84d7800",
                                                "text": "Ces lieux communs mythologiques et ce cliquetis de mots sonores, mais à peu près vides de sens, plurent au roi Sighebert et à ceux des seigneurs Francs qui, comme lui, comprenaient quelque peu la poésie latine."
                                            },
                                            {
                                                "example_id": "fde4d8b4-0cae-44cc-863c-92ef25b7a4d5",
                                                "sense_id": "ce13bf8b-f394-3f72-b548-4c07f84d7800",
                                                "text": "Comme la cloison était mince, on entendait le cliquetis des fourchettes sur les assiettes dans la salle à manger."
                                            },
                                            {
                                                "example_id": "f72e7109-fe3f-4b80-83a8-d0aae1b96a9b",
                                                "sense_id": "ce13bf8b-f394-3f72-b548-4c07f84d7800",
                                                "text": "Si j’étais resté en Bretagne, je serais toujours demeuré étranger à cette vanité que le monde a aimée, encouragée, je veux dire à une certaine habileté dans l’art d’amener le cliquetis des mots et des idées."
                                            },
                                            {
                                                "example_id": "3dfe92fc-f2ad-4d41-914d-218f86fb9e11",
                                                "sense_id": "ce13bf8b-f394-3f72-b548-4c07f84d7800",
                                                "text": "Une voix monta, cadencée, accompagnée d'un cliquetis de bracelets..."
                                            },
                                            {
                                                "example_id": "d61a38f6-5e38-4bc8-8e8b-04342d6f1026",
                                                "sense_id": "ce13bf8b-f394-3f72-b548-4c07f84d7800",
                                                "text": "On distinguait, vers la droite, derrière le pâté de maisons qui aboutissait à l’enseigne, et pas très loin, un tumulte parsemé de voix et de cliquetis.\nDeux coups de feu encore ; puis six coups l’un derrière l’autre.\n— Ça, c’est un revolver !"
                                            },
                                            {
                                                "example_id": "32711240-501a-4663-a572-fbe0c13c7b40",
                                                "sense_id": "ce13bf8b-f394-3f72-b548-4c07f84d7800",
                                                "text": "Le moindre bruit la mettait à la torture et cette grande nerveuse mangeait seule, ne pouvant souffrir le cliquetis des couteaux et des fourchettes."
                                            },
                                            {
                                                "example_id": "d9693ba5-0266-4df8-a1d3-47b91a12f709",
                                                "sense_id": "ce13bf8b-f394-3f72-b548-4c07f84d7800",
                                                "text": "Le look rappeur, avec ses panoplies fashion, les étiquettes de marques qui dépassent et le cliquetis des bijoux autour du cou, ça fait marcher flouze et bizness. C'est pour ça qu'on préfère les rebeus habillés en dollars aux rebeues fagotées en foulard."
                                            },
                                            {
                                                "example_id": "f7bfbccc-bff5-4253-86ae-5b5de7165771",
                                                "sense_id": "ce13bf8b-f394-3f72-b548-4c07f84d7800",
                                                "text": "Ils s'engouffrèrent dans le tunnel du stade dans un grand cliquetis de crampons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
