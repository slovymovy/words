                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6333bc65-7250-4bff-80c6-080713822726",
                                "sense_id": "e7689df9-d472-32cb-8e98-e28cc7a00e80",
                                "text": "On peut gluer des baguettes pour prendre des oiseaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "95f00ac0-0df4-3210-add8-1dc1f6acfe48",
                        "entry_id": "531a7503-5854-3806-b0bb-646c486d426e",
                        "glosses": [
                            "Salir de quelque chose de gluant."
