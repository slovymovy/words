                        "entry_id": "9e4e5295-d161-3f44-ac3e-05290dbf77d6",
                        "glosses": [
                            "coś, co nadaje komuś impet, wigor"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "984b084a-24d9-48a8-8e3a-f851f6654375",
                                "sense_id": "caf2e848-e0cc-397d-ac02-f263b879ecac",
                                "text": "Poranne espresso zawsze daje mi niezbędnego kopa do pracy o szóstej."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
