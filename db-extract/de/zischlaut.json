                                "target_senses": [
                                    {
                                        "sense_id": "73e5e9ab-da57-3a86-a79b-12020aa9632b",
                                        "entry_id": "7e76c210-087f-329c-af6d-3cd48d6f3aa0",
                                        "glosses": [
                                            "Consonne qui produit un sifflement, comme \\\\s\\\\, \\\\z\\\\, \\\\ʃ\\\\, \\\\ʒ\\\\, \\\\tʃ\\\\ et \\\\dʒ\\\\."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e99708c3-15b5-4ab8-b65e-1c3332ab10e9",
                                                "sense_id": "73e5e9ab-da57-3a86-a79b-12020aa9632b",
                                                "text": "S, Z sont des sifflantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1665f45d-8847-310f-9c7f-bbd1ca4b20c2",
                                        "entry_id": "7e76c210-087f-329c-af6d-3cd48d6f3aa0",
                                        "glosses": [
                                            "Bruit évoquant un sifflement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f4831d3-35cc-404d-b78c-c4d9a42f8e13",
                                                "sense_id": "1665f45d-8847-310f-9c7f-bbd1ca4b20c2",
                                                "text": "Les skis crépitaient dans le petit matin. Selon les températures, leur chant produit une sifflante, un chuintement, un raclement – un sanglot même, si la neige s’amollit."
                                            }
                                        ]
                                    }
                                ]
                            },
