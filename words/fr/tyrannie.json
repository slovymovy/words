    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ae252516-109a-33e1-9de7-84a513707db4",
                    "sense_definition": "Régime politique autoritaire où le pouvoir est exercé de manière absolue, arbitraire et oppressive par un individu ou un groupe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peuple s'est finalement soulevé pour renverser la <w>tyrannie</w> après des décennies de peur."
                        },
                        {
                            "text": "De nombreux opposants politiques ont fui le pays pour échapper à cette terrible <w>tyrannie</w>."
                        }
                    ],
                    "synonyms": [
                        "despotisme",
                        "dictature",
                        "autocratie"
                    ],
                    "antonyms": [
                        "démocratie",
                        "liberté"
                    ],
                    "common_phrases": [
                        "renverser la tyrannie",
                        "lutter contre la tyrannie"
                    ]
                },
                {
                    "sense_id": "5c469861-e0a0-355b-88e1-c14c83a54178",
                    "sense_definition": "Exercice excessif, arbitraire et injuste de l'autorité au sein d'un groupe ou d'une institution.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oppression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les employés ont fini par dénoncer la <w>tyrannie</w> quotidienne exercée par leur supérieur hiérarchique."
                        },
                        {
                            "text": "Il refusait de courber l'échine devant la <w>tyrannie</w> imposée par l'administration locale."
                        }
                    ],
                    "synonyms": [
                        "oppression",
                        "autoritarisme"
                    ],
                    "antonyms": [
                        "tolérance",
                        "bienveillance"
                    ],
                    "common_phrases": [
                        "exercer une tyrannie",
                        "subir la tyrannie"
                    ]
                },
                {
                    "sense_id": "4224d1d1-4cae-31e8-a92d-5bbbd6548f2a",
                    "sense_definition": "Influence contraignante et irrésistible que des idées, des habitudes ou des passions exercent sur la conduite humaine.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beaucoup de jeunes gens souffrent de la <w>tyrannie</w> de la mode véhiculée par les réseaux sociaux."
                        },
                        {
                            "text": "Pour vivre en paix avec soi-même, il faut savoir s'affranchir de la <w>tyrannie</w> du regard des autres."
                        }
                    ],
                    "synonyms": [
                        "emprise",
                        "joug",
                        "diktat"
                    ],
                    "common_phrases": [
                        "tyrannie de la mode",
                        "tyrannie des apparences"
                    ]
                },
                {
                    "sense_id": "9c2d0a60-2e80-366c-83ab-d7574e47f7c6",
                    "sense_definition": "Comportement capricieux et dominateur d'une personne qui impose sans cesse ses exigences à ses proches.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "oppression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la famille devait subir la <w>tyrannie</w> de cet enfant gâté qui refusait d'obéir."
                        },
                        {
                            "text": "Elle a décidé de quitter le domicile familial pour échapper enfin à la <w>tyrannie</w> de son père."
                        }
                    ],
                    "synonyms": [
                        "despotisme"
                    ],
                    "common_phrases": [
                        "tyrannie domestique"
                    ]
                }
            ]
        }
    ]
}