                        "glosses": [
                            "Synonyme de gaulthérie (Gaultheria procumbens, Gaultheria shallon)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ef53aa0-1cac-435f-b531-b50567102b1f",
                                "sense_id": "0cb097d2-7e6d-3682-ac28-4b3ab16fff49",
                                "text": "Un lapin jaillit du sous-bois, un mouvement gris foncé dans le noir. Turtle dégaine son pistolet, fait claquer la glissière en un seul mouvement fluide, et elle tire. Le lapin virevolte dans un buisson de palommier."
                            },
                            {
                                "example_id": "7300f88d-8265-43f4-a481-1d9bff700e2b",
                                "sense_id": "0cb097d2-7e6d-3682-ac28-4b3ab16fff49",
                                "text": "De son côté, le thé du Canada ou palommier (Gaultheria procumbens L.) est connu pour son huile essentielle riche en salicylate de méthyle (essence de wintergreen, fournie par cette éricacée à feuilles vertes persistantes)."
                            }
                        ]
                    },
                    {
                        "sense_id": "68382000-ea87-3f5e-87e1-815fa19a4999",
                        "entry_id": "77b5505f-9a1f-3b0a-abe7-d10c91beff6a",
                        "glosses": [
                            "Chasseur de palombes."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "87c6565d-6601-4927-a995-07c2b9dc7684",
                                "sense_id": "68382000-ea87-3f5e-87e1-815fa19a4999",
                                "text": "De nos jours on se sert d’un simulacre d’épervier pour pousser les vols de palombes, quand elles passent, dans des rangées d’arbres plantés à dessein où des filets sont tendus. Était-ce dans ces palommières qu’Henri se faisait conduire par les palommiers dont parle la chambre des comptes ?"
                            }
                        ]
                    }
