                ],
                "senses": [
                    {
                        "sense_id": "8361e39b-30c2-3cd3-821b-9cc461e698dd",
                        "entry_id": "fc3a845c-d7c2-31ab-99f7-65f2d0bc7d42",
                        "glosses": [
                            "характеризующийся отсутствием принципов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91e93b75-ec11-4db8-93eb-381ae713a8ce",
                                "sense_id": "8361e39b-30c2-3cd3-821b-9cc461e698dd",
                                "text": "Но в ГИИИ его недолюбливали, считали научно непринципиальным."
                            }
                        ]
                    },
                    {
                        "sense_id": "01bb83b3-68f4-33da-b86e-68e853381daa",
                        "entry_id": "fc3a845c-d7c2-31ab-99f7-65f2d0bc7d42",
                        "glosses": [
                            "неважный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f54b0988-7d6c-47fa-bb07-4dac7f660cac",
                                "sense_id": "01bb83b3-68f4-33da-b86e-68e853381daa",
                                "text": "Правительство подготовило ряд поправок, но они были непринципиальными."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "411062e2-1a31-498d-bb96-32443288ceae",
                        "source_entry_id": "fc3a845c-d7c2-31ab-99f7-65f2d0bc7d42",
                        "source_sense_description": "беспринципный",
                        "target_lang_word": "unprincipled",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unprincipled",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5863b54a-95be-3059-82e1-ff872ac53fa4",
                                        "entry_id": "b1af6b75-a904-3f19-8298-107e000968bb",
                                        "glosses": [
                                            "Lacking moral values."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4462f5f0-5c79-4abc-952e-cf69f732789d",
                                                "sense_id": "5863b54a-95be-3059-82e1-ff872ac53fa4",
                                                "text": "That’s what Joe Biden did. His pardon of his son Hunter was understandable from a paternal perspective (what father wants to see his son in prison?), but it was inexcusably unprincipled."
                                            },
                                            {
                                                "example_id": "bc7f1f6b-3676-48e2-a530-6ff9613a1bd0",
                                                "sense_id": "5863b54a-95be-3059-82e1-ff872ac53fa4",
                                                "text": "Early in his career, Trump apprenticed himself to Roy Cohn, an unprincipled lawyer who taught the young Trump how to gain wealth and influence through ruthless bullying, profane braggadocio, opportunistic bigotry, baseless lawsuits, lying, and more lying.\nYet as Trump’s “fixer” with politicians, judges and mob bosses, Cohn remained utterly loyal to Trump and his father, Fred."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b45df0dc-5176-470d-afd9-2074132d7169",
                        "source_entry_id": "fc3a845c-d7c2-31ab-99f7-65f2d0bc7d42",
