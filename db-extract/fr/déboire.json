        "fr-extract.jsonl": [
            {
                "entry_id": "2c19cb1f-c234-3c9b-88e2-5cfeaa233e5c",
                "word": "déboire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8320b4d6-36f8-452e-b5f1-017c650e3967",
                        "entry_id": "2c19cb1f-c234-3c9b-88e2-5cfeaa233e5c",
                        "tags": [
                            "plural"
                        ],
                        "form": "déboires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e86af10e-a317-3234-9e29-9ead927f6879",
                        "entry_id": "2c19cb1f-c234-3c9b-88e2-5cfeaa233e5c",
                        "glosses": [
                            "Mauvais goût qui reste d’un liquide après qu’on l’a bu."
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "0b957dbb-9c61-40d5-9f7d-de09969eac0f",
                                "sense_id": "e86af10e-a317-3234-9e29-9ead927f6879",
                                "text": "Du vin qui a un insupportable déboire."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f78c24a-d846-3098-83f3-9126db1af127",
                        "entry_id": "2c19cb1f-c234-3c9b-88e2-5cfeaa233e5c",
                        "glosses": [
                            "Dégoût, regret, mécontentement ou désillusion qu’on éprouve face à ou à la suite de situations ou d'événements fâcheux."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b387c8b1-5aaf-4638-802d-e74b26cd2718",
                                "sense_id": "6f78c24a-d846-3098-83f3-9126db1af127",
                                "text": "Ainsi dans les premiers temps du reboisement, beaucoup de reboiseurs […] ne distinguaient pas la valeur forestière des différents sols. Ils ont eu bien des déboires."
                            },
                            {
                                "example_id": "da95118e-6795-44b8-8082-652b00b2f589",
                                "sense_id": "6f78c24a-d846-3098-83f3-9126db1af127",
                                "text": "Un grand clown anglais nous racontait un jour combien de déboires il avait subi, avant de découvrir enfin, après les dizaines d’accoutrements incongrus qu’il avait imaginés, celui qui amuserait les spectateurs."
                            },
                            {
                                "example_id": "a68a16ef-fd68-4fe7-b3be-e582ceb31d95",
                                "sense_id": "6f78c24a-d846-3098-83f3-9126db1af127",
                                "text": "Beaucoup viennent chercher au loin la fortune, qui n’y trouvent que déboires et malheurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6ccb47a-7aa9-3fcf-82d6-c8583e8953f4",
                        "entry_id": "2c19cb1f-c234-3c9b-88e2-5cfeaa233e5c",
                        "glosses": [
                            "Événement malheureux, malchance, déveine."
                        ],
                        "tags": [
                            "figuratively",
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "93dc424c-1d92-4dd6-a92c-09f66eef9614",
                                "sense_id": "b6ccb47a-7aa9-3fcf-82d6-c8583e8953f4",
                                "text": "« Graves déboires constatés ! » Constatés par qui ? On aurait pu le dire. J'avoue ne pas voir la portée de ces « graves déboires », alors que le rapport atteste que le nombre des explosions de chaudières en Belgique a diminué de 60 p. 100."
                            },
                            {
                                "example_id": "86b52352-592b-4355-b1b7-6e367c3b4fa2",
                                "sense_id": "b6ccb47a-7aa9-3fcf-82d6-c8583e8953f4",
                                "text": "Elles acceptaient tout simplement les joies et les déboires que le sort leur distribuait d'ailleurs sans profusion."
                            },
                            {
                                "example_id": "ca1ad100-720f-4c6b-a101-c92479792c09",
                                "sense_id": "b6ccb47a-7aa9-3fcf-82d6-c8583e8953f4",
                                "text": "Je rappelle au passage que le frère d’Andrew Cuomo est l’animateur vedette de CNN, Chris Cuomo. […]. D’ailleurs, on reproche maintenant à l’animateur de faire l’impasse sur la couverture des déboires de son frère."
                            }
                        ]
                    }
                ],
