                ],
                "senses": [
                    {
                        "sense_id": "ec171cb1-44ec-3342-a32a-57fdeff2a430",
                        "entry_id": "6ee2c1dd-a52a-38e6-9eb0-ed8414bd5afc",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a70ff5ac-a4f5-41b8-a12e-8e5448af890f",
                                "sense_id": "ec171cb1-44ec-3342-a32a-57fdeff2a430",
                                "text": "Mam na imię Jacek i wykonuję w Grecji okna na statki."
                            },
                            {
                                "example_id": "fb338a3e-6147-4c32-9a44-9785b2ed8f84",
                                "sense_id": "ec171cb1-44ec-3342-a32a-57fdeff2a430",
                                "text": "Na koniec, jakby ślepym chciał uderzyć ciosem, / Zasłonił oczy ręką i rzekł mocnym głosem: / „Jam jest Jacek Soplica…”"
                            },
                            {
                                "example_id": "55d9677c-cf96-4bd6-b7eb-9a6441635add",
                                "sense_id": "ec171cb1-44ec-3342-a32a-57fdeff2a430",
                                "text": "Czy mamą Jacka jest pani Nagórska?"
                            },
                            {
                                "example_id": "0d731580-d04e-4e8b-beb4-2d3fdd5b0f57",
                                "sense_id": "ec171cb1-44ec-3342-a32a-57fdeff2a430",
                                "text": "Jackowi nic nie wychodziło tak jak powinno."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
