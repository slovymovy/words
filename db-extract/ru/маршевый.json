                ],
                "senses": [
                    {
                        "sense_id": "f5d45dd6-3b5e-3deb-9981-3ddfd73430d2",
                        "entry_id": "e24b57e9-2fc6-372a-8125-03a80a40e87f",
                        "glosses": [
                            "муз. связанный, соотносящийся по значению с существительным марш (в знач. музыкальный жанр, музыкальное произведение)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58a724f2-f627-4115-910c-4fc2f1313413",
                                "sense_id": "f5d45dd6-3b5e-3deb-9981-3ddfd73430d2",
                                "text": "Меня растрогала эта песня и поразила каким-то особо отчетливым, как в маршевых, строевых песнях, ритмом."
                            },
                            {
                                "example_id": "a4da9828-719d-48e8-9fa9-ca083254d2de",
                                "sense_id": "f5d45dd6-3b5e-3deb-9981-3ddfd73430d2",
                                "text": "Веселая маршевая музыка заглушает колокольный звон."
                            }
                        ]
                    }
                ],
