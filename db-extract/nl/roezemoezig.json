                "senses": [
                    {
                        "sense_id": "6466479b-97f3-3d3a-8f8b-6d2b0e0811c1",
                        "entry_id": "05ffdf59-44da-3562-bbfe-771788741ce7",
                        "glosses": [
                            "niet helemaal stil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf663f37-5142-4c90-a44d-1f42bb38754f",
                                "sense_id": "6466479b-97f3-3d3a-8f8b-6d2b0e0811c1",
                                "text": "Er viel een stilte in het anders toch vaak wat roezemoezige DWDD-publiek. Zwanger? Alcohol? Ik hoorde het ze denken. Dat kon toch zomaar niet? Alcohol in combinatie met een ongeboren kind, dat kan toch nooit goed gaan?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2fb6497-161a-4051-84cf-d33a4597eeae",
                        "source_entry_id": "05ffdf59-44da-3562-bbfe-771788741ce7",
                        "source_sense_id": "6466479b-97f3-3d3a-8f8b-6d2b0e0811c1",
                        "source_sense_description": "niet helemaal stil",
                        "target_lang_word": "noisy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
