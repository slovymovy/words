{
    "word_family": [
        "invisibilité",
        "visible",
        "visibilité",
        "visiblement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "41127590-3c44-3f04-915d-6211c81920a7",
                    "sense_definition": "Qu'on ne peut pas voir à l'œil nu, qui échappe au regard par sa nature, sa taille ou la distance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'air que nous respirons tous les jours est totalement <w>invisible</w> pour nos yeux."
                        },
                        {
                            "text": "Il a écrit un message secret avec de l'encre <w>invisible</w> sur cette feuille blanche."
                        }
                    ],
                    "antonyms": [
                        "visible"
                    ],
                    "common_phrases": [
                        "encre invisible",
                        "homme invisible",
                        "devenir invisible"
                    ]
                },
                {
                    "sense_id": "93efa605-9438-379c-b352-b07e635c44ab",
                    "sense_definition": "Qui évite de se montrer, qui se dissimule ou que l'on ne parvient pas à joindre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "presence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur est resté <w>invisible</w> toute la matinée malgré les nombreuses demandes de rendez-vous."
                        },
                        {
                            "text": "Cet espion sait parfaitement se fondre dans la foule pour se rendre <w>invisible</w> aux yeux des gardes."
                        }
                    ],
                    "synonyms": [
                        "caché"
                    ],
                    "antonyms": [
                        "visible"
                    ],
                    "common_phrases": [
                        "rester invisible",
                        "se rendre invisible"
                    ]
                },
                {
                    "sense_id": "20ce049e-be1d-30ca-8f46-e637d35e3d0e",
                    "sense_definition": "Qui n'attire pas l'attention, qui reste ignoré, méconnu ou négligé par la société.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "societe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement souhaite mieux reconnaître ce travail <w>invisible</w> accompli chaque jour par les aidants familiaux."
                        },
                        {
                            "text": "De nombreuses personnes souffrent d'un handicap <w>invisible</w> qui n'est pas immédiatement compris par leurs collègues."
                        }
                    ],
                    "antonyms": [
                        "visible"
                    ],
                    "common_phrases": [
                        "travail invisible",
                        "handicap invisible"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6106ead5-1f3b-32e8-8343-e54360f66d3e",
                    "sense_definition": "Personne marginalisée, précaire ou ignorée par le reste de la société.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "societe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce documentaire donne la parole aux <w>invisibles</w> qui nettoient les bureaux pendant la nuit."
                        },
                        {
                            "text": "Les bénévoles de cette association distribuent des repas chauds pour secourir les <w>invisibles</w> de la ville."
                        }
                    ],
                    "common_phrases": [
                        "les invisibles de la société"
                    ]
                }
            ]
        }
    ]
