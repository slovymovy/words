                ],
                "senses": [
                    {
                        "sense_id": "222d47ec-2309-3e8e-815f-3f79ca85ce53",
                        "entry_id": "9b048467-a9d4-3c6c-88a0-cfb8c77c4304",
                        "glosses": [
                            "Geld, das durch die Ausfuhr einer Waren einkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5312e39f-6a01-4054-8c10-b7d9c9d5e102",
                                "sense_id": "222d47ec-2309-3e8e-815f-3f79ca85ce53",
                                "text": "„Entsprechend können Preisschwankungen auf dem Weltmarkt enorme Auswirkung auf den Exporterlös des Landes entfalten und es kann zu einer Destabilisierung der gesamten Volkswirtschaft kommen […].“"
                            },
                            {
                                "example_id": "8f567b6b-1d82-4bb9-b1d7-954d82b0daa2",
                                "sense_id": "222d47ec-2309-3e8e-815f-3f79ca85ce53",
                                "text": "„Die Vergabe von Aufträgen zu einer geringeren Summe setzt damit eine entsprechende Verringerung des Exporterlöses und die Deckung der fehlenden Summe durch Gold oder Devisen voraus.“"
                            },
                            {
                                "example_id": "0b770eeb-d4f7-4d4f-8d9a-2953e2f62cfb",
                                "sense_id": "222d47ec-2309-3e8e-815f-3f79ca85ce53",
                                "text": "„Ein Land möchte durch eine Abwertung seine in Fremdwährung gemessenen Exporterlöse erhöhen.“"
                            },
                            {
                                "example_id": "764f7e61-4db4-4357-b752-af6b44141a8c",
                                "sense_id": "222d47ec-2309-3e8e-815f-3f79ca85ce53",
                                "text": "„Zur gleichen Zeit werden die Rohstoffpreise durch das gesteigerte Angebot an Nahrungsmitteln aus den Entwicklungsländern gedrückt, was den Exporterlös dieser Länder erheblich vermindert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
