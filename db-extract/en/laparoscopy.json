                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laparoscopie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d94e2e0e-01b0-377b-82a4-81a4af6f5d42",
                                        "entry_id": "aa77f5d2-055d-3f8f-9f8c-04d5e36d6289",
                                        "glosses": [
                                            "met een kijkbuis in de buikholte kijken en opereren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6be0ff93-90c6-4c31-bc28-70e57a31a7f9",
                                                "sense_id": "d94e2e0e-01b0-377b-82a4-81a4af6f5d42",
                                                "text": "Hij wordt vaak gevraagd als spreker en is samen met slechts één andere chirurg binnen de vakgroep gespecialiseerd in laparoscopie, ook wel sleutelgatoperaties genoemd."
                                            },
                                            {
                                                "example_id": "a01696f9-6269-46f0-8c07-3539e74b332e",
                                                "sense_id": "d94e2e0e-01b0-377b-82a4-81a4af6f5d42",
                                                "text": "De simulator is een soort spelcomputer voor chirurgen, zegt Marlies Schijven, chirurg en opleidingscoördinator in het AMC. Laparoscopie vereist een bepaalde handigheid. Als je hand naar rechts gaat, gaat het instrument naar links. Vergelijk het maar met achteruit inparkeren."
                                            },
                                            {
                                                "example_id": "32cabaa0-96d4-4123-ab21-49bddc9cf4bc",
                                                "sense_id": "d94e2e0e-01b0-377b-82a4-81a4af6f5d42",
                                                "text": "Het Sint Lucas Andreas Ziekenhuis start vandaag met de eerste van een reeks gynaecologische ingrepen door middel van 3D laparoscopie. De gynaecologen van het Amsterdamse ziekenhuis zijn hiermee de eersten in Nederland die met deze nieuwe techniek structureel ingrepen gaan doen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8600bb82-6abc-44d1-a728-0eb56dfd3cf8",
                        "source_entry_id": "6b058b7c-2065-330f-aecb-2eb7dffdaacb",
                        "source_sense_id": "6c15f8f7-8bec-3d9e-9281-5b87f818f22c",
                        "source_sense_description": "examination or surgery on the peritoneal cavity",
                        "target_lang_word": "laparoscopie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laparoscopie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a632dc9-19e7-30e4-93f1-30eb1b171b69",
                                        "entry_id": "d2d6023d-a100-3863-8c9b-c7b5e6f0cc57",
                                        "glosses": [
                                            "Cœlioscopie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "842c5ac6-64fc-4d8d-ad10-2155dc90d575",
                                                "sense_id": "6a632dc9-19e7-30e4-93f1-30eb1b171b69",
                                                "text": "Cependant, la méthode de référence pour le diagnostic de l’endométriose est l’examen direct de la cavité abdominale à l’aide d’un endoscope (examen appelé laparoscopie)."
                                            },
                                            {
                                                "example_id": "9987f4fa-a32c-4028-a545-efd832df628e",
                                                "sense_id": "6a632dc9-19e7-30e4-93f1-30eb1b171b69",
                                                "text": "Le diagnostic de certitude de périhépatite est fait par la laparoscopie qui retrouve des membranes périhépatiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
