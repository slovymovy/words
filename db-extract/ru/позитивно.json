        "ru-extract.jsonl": [
            {
                "entry_id": "47b02ed7-39c0-36f2-b879-ca4ddd60da21",
                "word": "позитивно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0d1b480a-6c77-3f68-b9c6-5a3418cf9bde",
                        "entry_id": "47b02ed7-39c0-36f2-b879-ca4ddd60da21",
                        "glosses": [
                            "наречие к позитивный; в нужном, желательном направлении"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "4d1d380d-99f4-4e6c-8c88-9d2060e741e9",
                                "sense_id": "0d1b480a-6c77-3f68-b9c6-5a3418cf9bde",
                                "text": "Но это пока не привело к росту потребления, за исключением продаж авто, позитивно повлиявших на статистику в США."
                            }
                        ]
                    },
                    {
                        "sense_id": "f70d5b93-05ee-3744-88ce-4347e38e7eb7",
                        "entry_id": "47b02ed7-39c0-36f2-b879-ca4ddd60da21",
                        "glosses": [
                            "наречие к позитивный; утвердительно, с одобрением"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "4192a3ec-58a3-415f-bfec-13061b679a45",
                                "sense_id": "f70d5b93-05ee-3744-88ce-4347e38e7eb7",
                                "text": "Как показали опросы ВЦИОМ, население в 1989-1990-х годах позитивно относилось к идее Легализации частной собственности, но крайне негативно — к либерализации цен."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c1fcad5-1180-33c0-bcbf-bdebcfa1e7bd",
                        "entry_id": "47b02ed7-39c0-36f2-b879-ca4ddd60da21",
                        "glosses": [
                            "наречие к позитивный; на положительный, радостный лад"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "41b78d40-91ce-49e4-a26a-a1a9de0aacfc",
                                "sense_id": "2c1fcad5-1180-33c0-bcbf-bdebcfa1e7bd",
                                "text": "Так что позитив! Надо смотреть на мир позитивно. Позитивно."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75e98ece-13e9-498c-a981-9433f3f07d0a",
                        "source_entry_id": "47b02ed7-39c0-36f2-b879-ca4ddd60da21",
                        "source_sense_description": "в нужном, желательном направлении",
                        "target_lang_word": "positively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "positively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "861bcff0-06f3-3dcf-b5fe-32e0c373b696",
                                        "entry_id": "9f66840d-a81d-3439-94a1-ec059e48191d",
                                        "glosses": [
                                            "In a positive manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b75212d-e4fb-43b5-9a25-2a873f320316",
                                                "sense_id": "861bcff0-06f3-3dcf-b5fe-32e0c373b696",
                                                "text": "He approached the interview positively."
                                            },
                                            {
                                                "example_id": "acf4d1e0-4af2-4179-8340-eef77ee98493",
                                                "sense_id": "861bcff0-06f3-3dcf-b5fe-32e0c373b696",
                                                "text": "There’s nothing – not. one. thing. – that Trump could do or say that would be received positively by TDSers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d23723db-941f-3b4b-a641-bbd66539435c",
                                        "entry_id": "9f66840d-a81d-3439-94a1-ec059e48191d",
                                        "glosses": [
                                            "With certainty."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8491cbed-8a17-4084-9d06-c02b7e874d1e",
                                                "sense_id": "d23723db-941f-3b4b-a641-bbd66539435c",
                                                "text": "I will positively be there at 8 a.m."
                                            },
                                            {
                                                "example_id": "4b8c26d4-5dae-40c7-ad3c-4bdd06c77d6a",
                                                "sense_id": "d23723db-941f-3b4b-a641-bbd66539435c",
                                                "text": "The carriage nearly overturned, and he saw her eyes blaze at him, and she positively hissed, “I suppose you are enjoying this?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a558e3fe-bc3f-37e5-9d35-e67e7ea09498",
                                        "entry_id": "9f66840d-a81d-3439-94a1-ec059e48191d",
                                        "glosses": [
                                            "Absolutely; utterly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aa581e0-bab3-4141-99b3-e84dabbc2317",
                                                "sense_id": "a558e3fe-bc3f-37e5-9d35-e67e7ea09498",
                                                "text": "[…] Easter Sunday, for all its traditions, is a gladless day in London. There is positively nothing to do."
                                            },
                                            {
                                                "example_id": "e02b389b-1cd2-4517-9005-9406ac075feb",
                                                "sense_id": "a558e3fe-bc3f-37e5-9d35-e67e7ea09498",
                                                "text": "She talked and laughed and positively forgot until he had come in (just as she had imagined) that Pearl Fulton had not turned up."
                                            },
                                            {
                                                "example_id": "c90f1b58-24be-4234-bc20-f90d31b53ee8",
                                                "sense_id": "a558e3fe-bc3f-37e5-9d35-e67e7ea09498",
                                                "text": "\"Positively do not open,\" reads the message under the cabinet in which Ed and Lorraine put the possessed Annabelle doll."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e96f4916-edd5-382c-a932-838d9902b5a0",
                                        "entry_id": "9f66840d-a81d-3439-94a1-ec059e48191d",
                                        "glosses": [
                                            "Very."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b29cfe6a-4276-4e0d-bcc2-c2fad2f25eb0",
                                                "sense_id": "e96f4916-edd5-382c-a932-838d9902b5a0",
                                                "text": "I had a positively wonderful time."
                                            },
                                            {
                                                "example_id": "e440e8bd-24c1-4ac7-aee7-696707b53a0a",
                                                "sense_id": "e96f4916-edd5-382c-a932-838d9902b5a0",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. […] The bed was the most extravagant piece. Its graceful cane halftester rose high towards the cornice and was so festooned in carved white wood that the effect was positively insecure, as if the great couch were trimmed with icing sugar."
                                            },
                                            {
                                                "example_id": "bb9a8515-0578-489d-9bfa-12b458434a52",
                                                "sense_id": "e96f4916-edd5-382c-a932-838d9902b5a0",
                                                "text": "In the 90s it was Craigslist and AOL chat rooms, then Match.com and Kiss.com. But the lengthy, heartfelt e-mails exchanged by the main characters in You’ve Got Mail (1998) seem positively Victorian in comparison to the messages sent on the average dating app today."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c47ea5d7-a750-49de-90ff-b9980fe4ef57",
                        "source_entry_id": "47b02ed7-39c0-36f2-b879-ca4ddd60da21",
                        "source_sense_description": "в нужном, желательном направлении",
                        "target_lang_word": "positivement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "positivement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1dc9a3d-b98b-3c4b-a176-862c4aaf844f",
                                        "entry_id": "c59306bd-3b7d-3a1b-b5bf-1e369670d553",
                                        "glosses": [
                                            "D’une manière sûre, certaine."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0ce75d7-8e36-4358-b8e6-f77e777bbe69",
                                                "sense_id": "c1dc9a3d-b98b-3c4b-a176-862c4aaf844f",
                                                "text": "Elle rougit positivement et une flamme brilla dans ses grands yeux bleus.\nLa rougeur passa vite et la flamme s'éteignit aussitôt."
                                            },
                                            {
                                                "example_id": "e5247967-eb64-463b-98a1-bf984a9a72f7",
                                                "sense_id": "c1dc9a3d-b98b-3c4b-a176-862c4aaf844f",
                                                "text": "Mais on devrait se rappeler que pendant un long temps la coïncidence de la rotation de la Lune avec sa révolution sidérale, […], a été considérée comme un fait positivement miraculeux ; et qu’il y avait, même parmi les astronomes, une singulière disposition à attribuer cette merveille à l’agence directe et continue de Dieu, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6744a2b-65cf-3a1d-b7fb-5fe73e22372c",
                                        "entry_id": "c59306bd-3b7d-3a1b-b5bf-1e369670d553",
                                        "glosses": [
                                            "D’une manière précise."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71adedee-f004-482e-ac84-63c8167c7745",
                                                "sense_id": "d6744a2b-65cf-3a1d-b7fb-5fe73e22372c",
                                                "text": "Vous voulez éluder un éclaircissement ; Mais il faut me répondre, et positivement."
                                            },
                                            {
                                                "example_id": "0e6efce4-901a-4409-b2c6-1830cae0f406",
                                                "sense_id": "d6744a2b-65cf-3a1d-b7fb-5fe73e22372c",
                                                "text": "Père Adam soutient toujours que ce brave général qui est à présent ministre de la guerre [le comte de Saint-Germain] a commencé par être jésuite ; il le dit si positivement que j’en doute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c5992b1-7de5-3466-b4a9-d56f4b3fcd90",
                                        "entry_id": "c59306bd-3b7d-3a1b-b5bf-1e369670d553",
                                        "glosses": [
                                            "Avec une charge d’électricité positive."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2f79768-97b2-4942-a3b5-860b197303d5",
                                                "sense_id": "7c5992b1-7de5-3466-b4a9-d56f4b3fcd90",
                                                "text": "[…]; si l'on introduit dans la cavité un corps électrisé bien isolé, l'aiguille dévie dans un sens ou dans l'autre suivant que le corps est électrisé positivement ou négativement et la déviation est indépendante de la position du corps électrisé à l'intérieur de la cavité; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ba4525d-b567-3571-bd06-16148a1506dc",
                                        "entry_id": "c59306bd-3b7d-3a1b-b5bf-1e369670d553",
                                        "glosses": [
                                            "Précisément, exactement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bc0b95a-a20f-40c9-98dc-53179e61b28d",
                                                "sense_id": "0ba4525d-b567-3571-bd06-16148a1506dc",
                                                "text": "Voilà positivement ce qu’il m’a dit."
                                            },
                                            {
                                                "example_id": "022f49b6-1d37-42b7-bdf4-70819c2ed24c",
                                                "sense_id": "0ba4525d-b567-3571-bd06-16148a1506dc",
                                                "text": "Il n’est pas positivement laid si vous voulez, mais il est ridicule : ce monocle, ce toupet, ce sourire !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
