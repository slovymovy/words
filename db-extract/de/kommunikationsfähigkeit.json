                "senses": [
                    {
                        "sense_id": "98825ff2-aee3-3184-aab4-0be5db1b27e0",
                        "entry_id": "0dc811af-045e-316b-943e-01de45d4a7d0",
                        "glosses": [
                            "Eigenschaft, dazu fähig zu sein, mit anderen Menschen zu kommunizieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5329e48c-6cd6-474f-8285-4296366d091c",
                                "sense_id": "98825ff2-aee3-3184-aab4-0be5db1b27e0",
                                "text": "„Eine gute Kommunikationsfähigkeit ist unerlässlich für die emotionale Intelligenz.“"
                            },
                            {
                                "example_id": "9c1160be-4de2-491b-9287-2c3d2319e759",
                                "sense_id": "98825ff2-aee3-3184-aab4-0be5db1b27e0",
                                "text": "„Kommunikationsfähigkeit ist eine der zentralen Kompetenzen, über welche die Leitungskräfte aus ihrer Sicht verfügen und auch verfügen müssen.“"
                            },
                            {
                                "example_id": "92e356a8-34e1-4ea9-98ec-7b4ff8a51402",
                                "sense_id": "98825ff2-aee3-3184-aab4-0be5db1b27e0",
                                "text": "„Der Grad der Kommunikationsfähigkeit von beatmeten Patienten ist abhängig von der Invasivität der Beatmung […].“"
                            },
                            {
                                "example_id": "42785088-7e60-4c1e-a675-2e226cc57467",
                                "sense_id": "98825ff2-aee3-3184-aab4-0be5db1b27e0",
                                "text": "„Dieser Mann hat Einfühlungsvermögen, Sensibilität, soziale Intelligenz und Kommunikationsfähigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
