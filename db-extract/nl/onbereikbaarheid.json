                                "example_id": "547909b5-31b7-485c-b793-b35e9fbd700a",
                                "sense_id": "ab4a27f0-3ccc-3956-8ac7-82a17feeeaae",
                                "text": "De hemel werd blauw en stralend en beantwoordde zijn vragende blik met eenzelfde tederheid, maar ook met eenzelfde onbereikbaarheid."
                            }
                        ]
                    },
                    {
