                "senses": [
                    {
                        "sense_id": "733c912f-e24c-32eb-a24c-47501217e8ae",
                        "entry_id": "afad485b-0837-3e8b-8564-27ac2a6de397",
                        "glosses": [
                            "Chor, der ohne instrumentale Begleitung (a cappella) singt"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "f717f552-da18-403a-8bf4-23006f4f69ba",
                                "sense_id": "733c912f-e24c-32eb-a24c-47501217e8ae",
                                "text": "„Der A-Cappella-Chor der internationalen Schule und die Trommelgruppe des Mehrgenerationenhauses in Schöndorf treten auf.“"
                            },
                            {
                                "example_id": "77d84819-c8c4-4939-bae2-777a9f985c3a",
                                "sense_id": "733c912f-e24c-32eb-a24c-47501217e8ae",
                                "text": "„Dabei wird der A-Cappella-Chor Neustadt-Glewe unter Leitung von Christa Maier singen.“"
                            },
                            {
                                "example_id": "407a467f-54dc-403b-8856-1851517d662e",
                                "sense_id": "733c912f-e24c-32eb-a24c-47501217e8ae",
                                "text": "„In den Jahren 1922 bis 1933 leitete er den Kasseler A-Cappella-Chor, bis 1941 dirigierte er das Kasseler Staatstheaterorchester.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
