{
    "word_family": [
        "martyrdom",
        "martyrology"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4aeac593-0071-3323-82f2-33ba2cc34984",
                    "sense_definition": "A person who is killed for refusing to give up their religious beliefs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_martyr",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Saint Stephen is remembered as the first Christian <w>martyr</w>."
                        },
                        {
                            "text": "Many people became a <w>martyr</w> for their faith during the ancient persecutions."
                        }
                    ],
                    "antonyms": [
                        "apostate",
                        "confessor"
                    ]
                },
                {
                    "sense_id": "69eb03c9-7ead-37dd-85b8-26e7369ff034",
                    "sense_definition": "A person who sacrifices their life or well-being for a cause or principle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cause_martyr",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was a <w>martyr</w> for the cause of human rights."
                        },
                        {
                            "text": "The political leader became a <w>martyr</w> for the revolution."
                        }
                    ]
                },
                {
                    "sense_id": "3b21d7a2-449e-3910-8d29-18c01f07fe11",
                    "sense_definition": "A person who suffers constantly from a specific condition or situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sufferer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been a <w>martyr</w> to chronic back pain for many years."
                        },
                        {
                            "text": "She is a <w>martyr</w> to her own perfectionism at work."
                        }
                    ]
                },
                {
                    "sense_id": "f2c4a10e-f090-3886-bf0d-ea2cd5ca4454",
                    "sense_definition": "A person who exaggerates their suffering to gain sympathy from others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sufferer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop trying to play the <w>martyr</w> just to get attention."
                        },
                        {
                            "text": "She loves to play the <w>martyr</w> whenever she has to do extra chores."
                        }
                    ],
                    "common_phrases": [
                        "play the martyr"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6fbf299e-768b-320a-93b5-73210fd31785",
                    "sense_definition": "To kill someone because of their religious or political beliefs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_martyr",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The regime decided to <w>martyr</w> the activists to silence the opposition."
                        },
                        {
                            "text": "Many early saints were <w>martyred</w> for refusing to renounce their faith."
                        }
                    ],
                    "synonyms": [
                        "martyrize"
                    ]
                },
                {
                    "sense_id": "5717d38e-7aa2-354e-856f-791ec838452f",
                    "sense_definition": "To cause someone to suffer intense pain or torture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sufferer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cruel captors continued to <w>martyr</w> the prisoners daily."
                        },
                        {
                            "text": "The villain sought to <w>martyr</w> his enemies with endless torment."
                        }
                    ],
                    "synonyms": [
                        "martyrize"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or historical context."
                        }
                    ]
                },
                {
                    "sense_id": "13e32090-79e1-3cc6-aa60-d02f640cfa86",
                    "sense_definition": "To treat someone with persistent cruelty or harassment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sufferer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The minority group was <w>martyred</w> by the local authorities for years."
                        },
                        {
                            "text": "They were <w>martyred</w> by constant social exclusion and unfair laws."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or historical context."
                        }
                    ]
                }
            ]
        }
    ]
}