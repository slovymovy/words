                    {
                        "sense_id": "ee6508cf-1d72-390f-9222-6c9bd5ebf8a1",
                        "entry_id": "e6d3a89a-193f-3b70-bf4a-1df7a766a090",
                        "glosses": [
                            "Iemand die op vakantie gaat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bb30910-9af5-43a4-824b-4701b7450611",
                                "sense_id": "ee6508cf-1d72-390f-9222-6c9bd5ebf8a1",
                                "text": "In de steden Parijs, Londen en Amsterdam zie je veel vakantiegangers"
                            },
                            {
                                "example_id": "094d0c84-3d08-4f74-b201-62e4e546da27",
                                "sense_id": "ee6508cf-1d72-390f-9222-6c9bd5ebf8a1",
                                "text": "De meeste vakantiegangers nemen de Autoroute du Soleil, een ongezellige snelweg met irritante tolpoorten en karakterloze wegrestaurants."
                            },
                            {
                                "example_id": "9b2ab422-c69e-44a9-a654-f45f6c7db9c3",
                                "sense_id": "ee6508cf-1d72-390f-9222-6c9bd5ebf8a1",
                                "text": "Veel vakantiegangers weten nog steeds niet of hun vlucht vanaf Schiphol binnenkort doorgaat."
                            }
                        ]
                    }
                ],
