                        "entry_id": "2c3d0e87-e52e-3ad4-81af-259704d5941b",
                        "glosses": [
                            "Saiteninstrument, das durch eine Luftströmung erklingt"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "b134932a-b32c-47ea-9737-c225cf916214",
                                "sense_id": "09309c42-bdc5-3272-9656-f10df70bbae1",
                                "text": "Von Harfen, die durch den Luftzug erklingen, berichtet auch das Mittelalter, wo der Klang der Äolsharfe häufig mit Zauberei in Verbindung gebracht wurde."
                            },
                            {
                                "example_id": "e50d0b95-9c85-4135-8747-046bf88cad26",
                                "sense_id": "09309c42-bdc5-3272-9656-f10df70bbae1",
                                "text": "Es schwebet nun in unbestimmten Tönen\nMein lispelnd Lied, der Äolsharfe gleich,"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
