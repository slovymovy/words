                {
                    "sense_id": "fd4ff51b-0577-3d25-9126-9d9c54d0bd38",
                    "sense_definition": "To place shoes on a shoe <w>tree</w> to maintain their shape.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "maintenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carefully <w>treed</w> his shoes before putting them away in the closet.",
                            "target_lang_translations": {
                                "ru": "Он аккуратно <w>вставил распорки</w> в туфли, прежде чем убрать их в шкаф."
                            }
                        },
                        {
                            "text": "It is important to <w>tree</w> your boots if you want them to last for years.",
                            "target_lang_translations": {
                                "ru": "Важно <w>использовать колодки</w> для ботинок, если вы хотите, чтобы они прослужили годы."
                            }
                        }
