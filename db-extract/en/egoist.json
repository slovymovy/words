                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f237121-75c1-477e-86c7-d98ebab0a2d3",
                                                "sense_id": "7ac48fec-4ce7-33a8-bef2-3b499841f83e",
                                                "text": "Dieser Egoist würde uns nie helfen."
                                            },
                                            {
                                                "example_id": "369b753a-e0e5-481d-aeef-09c36782ead3",
                                                "sense_id": "7ac48fec-4ce7-33a8-bef2-3b499841f83e",
                                                "text": "„Nur ein unverbesserlicher Egoist kann den Fesseln entgehen, die ihm durch einen ungleichen Partner auferlegt werden.“"
                                            },
                                            {
                                                "example_id": "398844de-9c67-44f5-9d30-fe94aeb3343c",
                                                "sense_id": "7ac48fec-4ce7-33a8-bef2-3b499841f83e",
                                                "text": "„Lukas Piontek hat schon recht früh sein wahres Gesicht gezeigt: die Visage eines jähzornigen rücksichtslosen brutalen Egoisten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
