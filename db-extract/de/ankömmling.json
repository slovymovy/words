                        "form": "den Ankömmling"
                    },
                    {
                        "form_id": "17ee4734-4647-4156-82f2-20a707dda2a0",
                        "entry_id": "d421c5cb-944b-30c5-9b72-27a10ed6b125",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Ankömmlinge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f3c238aa-8fc9-34d3-9991-f257064370e6",
                        "entry_id": "d421c5cb-944b-30c5-9b72-27a10ed6b125",
                        "glosses": [
                            "Person, die an einem bestimmten Ort eingetroffen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b00a6be-59fe-4e37-8933-16a95d3b72b1",
                                "sense_id": "f3c238aa-8fc9-34d3-9991-f257064370e6",
                                "text": "„Die Ankömmlinge siedelten zunächst im Süden und Osten der Insel, nutzten dabei aber kaum die Infrastruktur und Techniken der Römer.“"
                            },
                            {
                                "example_id": "2681863e-9a1f-4216-9e18-8ecb3008038f",
                                "sense_id": "f3c238aa-8fc9-34d3-9991-f257064370e6",
                                "text": "„In den weiten Wiesen, auf denen häufig Birken gedeihen, sehen die Ankömmlinge Weideland für ihr Vieh.“"
                            },
                            {
                                "example_id": "ff7baf1f-1552-4d14-b5ed-5e6c9d4139ed",
                                "sense_id": "f3c238aa-8fc9-34d3-9991-f257064370e6",
                                "text": "„Zwischendurch schimpfte er furchtbar über die Ankömmlinge.“"
                            },
                            {
                                "example_id": "e938f4f9-80a1-4050-83a7-e68a214f7837",
                                "sense_id": "f3c238aa-8fc9-34d3-9991-f257064370e6",
                                "text": "„Alles, was noch auf dem Balkon verblieben war, sah ihnen neugierig nach, auch Gordon, der ihren Weitermarsch bis ins Bodetal hinein verfolgt haben würde, wenn nicht der eben mit neuen Ankömmlingen eingetrofffene Frühzug sein Interesse nach der entgegengesetzten Seite hin abgezogen hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adfc55f0-10f8-46d3-9781-8c807804fdbf",
                        "source_entry_id": "d421c5cb-944b-30c5-9b72-27a10ed6b125",
                        "source_sense_id": "f3c238aa-8fc9-34d3-9991-f257064370e6",
                        "source_sense_description": "Person, die an einem bestimmten Ort eingetroffen ist",
                        "target_lang_word": "arrivant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrivant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d0ab369-cc14-3bec-bba9-c9ccc50447f8",
                                        "entry_id": "c758c9ae-edc7-3a05-89cd-8ef1e8795d2f",
                                        "glosses": [
                                            "Qui vient d’arriver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20ddba75-2846-4e91-9e8a-bb8dfca51f5d",
                                                "sense_id": "0d0ab369-cc14-3bec-bba9-c9ccc50447f8",
                                                "text": "C’est, je crois, trouble de l'âme qui est trop occupée de son être (chez des provinciaux arrivants), pour qu’elle puisse être sympathisante."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arrivant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6f5f768-1398-3dd1-9ced-569f61bbf432",
                                        "entry_id": "dd47462e-4f21-3d40-bc7a-fe5261b4722e",
                                        "glosses": [
                                            "Personne qui vient d’arriver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6454e9d-58e9-44e4-a303-81b9a1b64c27",
                                                "sense_id": "b6f5f768-1398-3dd1-9ced-569f61bbf432",
                                                "text": "Les hypocrites Néo-Zélandais firent un excellent accueil aux nouveaux arrivants."
                                            },
                                            {
                                                "example_id": "08509924-be36-4326-b966-43d30aba06e8",
                                                "sense_id": "b6f5f768-1398-3dd1-9ced-569f61bbf432",
                                                "text": "Au début, pendant le concert qui chauffait les premiers arrivants, je me suis concentré sur les tracteurs. Les gens qui refilent des tracts, c'est comme ça qu'on les appelle ?"
                                            },
                                            {
                                                "example_id": "462c49b2-f9db-4104-aa48-a974e4acebe2",
                                                "sense_id": "b6f5f768-1398-3dd1-9ced-569f61bbf432",
                                                "text": "L’AVF de Toulon accueille les nouveaux arrivants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arrivant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29a3453f-21bd-32f6-963b-ef28d8f56be0",
                                        "entry_id": "748ccd6c-22c0-397f-b963-036f53a52c32",
                                        "glosses": [
                                            "Participe présent de arriver."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21b37c42-60f6-46e8-8b15-9c94c8c2644d",
                                                "sense_id": "29a3453f-21bd-32f6-963b-ef28d8f56be0",
                                                "text": "Le lendemain matin, en arrivant sur le site, Shana fut étonnée de trouver Pierre Lancarneau, accroupi devant la paroi, montrant aux trois jeunes de l’équipe une technique permettant de prélever un fragment sans mouvementer le reste des éléments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
