                    "sense_definition": "Nagły i bardzo silny strach.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "strach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z <w>przerażeniem</w> zauważyłam na lotnisku, że zostawiłam paszport w domu.",
                            "target_lang_translations": {
                                "ru": "Я с <w>ужасом</w> обнаружила в аэропорту, что оставила паспорт дома."
                            }
                        },
                        {
                            "text": "W jej oczach malowało się wielkie <w>przerażenie</w> na widok pająka.",
                            "target_lang_translations": {
                                "ru": "В её глазах отражался сильный <w>ужас</w> при виде паука."
