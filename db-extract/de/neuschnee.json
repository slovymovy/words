                ],
                "senses": [
                    {
                        "sense_id": "0635a8dc-8f04-3737-9698-c17149994d2a",
                        "entry_id": "1260446d-ae99-378c-bddd-3a9cf3a0bf7e",
                        "glosses": [
                            "frisch gefallener Schnee, welcher nicht älter als drei Tage ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c0361f3-d755-471f-8866-23ec96518730",
                                "sense_id": "0635a8dc-8f04-3737-9698-c17149994d2a",
                                "text": "Super, es gibt noch Neuschnee! Lass uns darin Ski fahren!"
                            },
                            {
                                "example_id": "fbde56bb-2066-4a6a-8111-57b4590af9e9",
                                "sense_id": "0635a8dc-8f04-3737-9698-c17149994d2a",
                                "text": "„In Bad Gastein lag ebenfalls noch Schnee, die Straße nach Sportgastein musste gestern gesperrt werden, dort gab es bis zu 40 Zentimeter Neuschnee.“"
                            },
                            {
                                "example_id": "10cea32f-a485-43c0-8f12-3aa1b1819aef",
                                "sense_id": "0635a8dc-8f04-3737-9698-c17149994d2a",
                                "text": "„Seit Dienstag ist in den Hochlagen mehr als ein Meter Neuschnee zusammengekommen.“"
                            },
                            {
                                "example_id": "612d8d92-c17f-4ad9-bfe6-ab9c03b76a25",
                                "sense_id": "0635a8dc-8f04-3737-9698-c17149994d2a",
                                "text": "„Sie kommen schneller runter und fallen wie Vögel, seltsame Vögel, die viele Geheimnisse kennen, und nur tiefer Neuschnee bringt zusätzliche Gefahr für diejenigen, die gewalzte Skipisten brauchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
