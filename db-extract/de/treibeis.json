                        "examples": [
                            {
                                "example_id": "c4dcfd10-c725-4338-9198-99fbc57fac8b",
                                "sense_id": "bca18f0d-9159-3f35-b225-0c7b92b47245",
                                "text": "Das Treibeis im Nordatlantik stellt eine Gefahr für die Schifffahrer dar."
                            },
                            {
                                "example_id": "8e859db3-063d-4b98-bac1-21a230e3e765",
                                "sense_id": "bca18f0d-9159-3f35-b225-0c7b92b47245",
                                "text": "„Hier sind es überraschende Begegnungen mit dem Treibeis, das von Kanada herüberkommt, oder Eisberge in der Discobucht.“"
                            },
                            {
                                "example_id": "b36524cd-98a2-476d-a522-09fd966c46f2",
                                "sense_id": "bca18f0d-9159-3f35-b225-0c7b92b47245",
                                "text": "„Ihr habt das verdammte Treibeis vom Hals und natürlich diesen sich aufplusternden Gemeindevorsteher Jóhannes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
