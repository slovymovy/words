                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8450cf6a-c6bf-4587-a237-acf04781f38d",
                                "sense_id": "b97a4ee1-15c6-3019-bd05-f011f1e1302e",
                                "text": "Those polluted external intruders who cross the boundaries of her ritual sanctuary unwittingly \"reviolate\" her bodily boundaries with the pollutants which they exude."
                            },
                            {
                                "example_id": "8b213ee9-a256-47e3-b0e5-3d54f5a93e63",
                                "sense_id": "b97a4ee1-15c6-3019-bd05-f011f1e1302e",
                                "text": "Z felt most comfortable imposing the death penalty where the defendant is 'incorrigible and would reviolate if released,' and less comfortable where the defendant is found to have been 'temporarily insane.'"
                            },
                            {
                                "example_id": "44ad8e5e-16be-425e-9ecf-f3d75fe1210a",
                                "sense_id": "b97a4ee1-15c6-3019-bd05-f011f1e1302e",
                                "text": "In this way, the state can learn which measures are most effective in ensuring that offenders do not reviolate."
                            }
                        ]
                    }
