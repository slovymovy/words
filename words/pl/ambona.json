{
    "word_family": [
        "ambonowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ecef41a4-bb05-3396-a280-cf6760c9ccce",
                    "sense_definition": "podwyższenie w kościele, z którego duchowny wygłasza kazanie lub czyta teksty liturgiczne",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "podwyzszenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ksiądz wszedł na <w>ambonę</w>, aby wygłosić niedzielne kazanie do wiernych.",
                            "target_lang_translations": {
                                "en": "The priest climbed into the <w>pulpit</w> to deliver the Sunday sermon to the faithful."
                            }
                        },
                        {
                            "text": "Zabytkowa <w>ambona</w> w tym starym kościele zachwycała pięknymi rzeźbami.",
                            "target_lang_translations": {
                                "en": "The historic <w>pulpit</w> in this old church delighted visitors with its beautiful carvings."
                            }
                        }
                    ],
                    "synonyms": [
                        "kazalnica"
                    ],
                    "common_phrases": [
                        "wejść na ambonę",
                        "głosić z ambony"
                    ],
                    "target_lang_definitions": {
                        "en": "a raised platform in a church from which a member of the clergy delivers a sermon or reads liturgical texts"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pulpit",
                                "target_lang_sense_clarification": "raised platform in a church for preaching"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5075f434-297d-3790-a7f6-0a12df5107d4",
                    "sense_definition": "podwyższone miejsce lub podest przeznaczony dla mówcy",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "podwyzszenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prelegent zajął miejsce na <w>ambonie</w> i rozpoczął swój wykład.",
                            "target_lang_translations": {
                                "en": "The lecturer took his place on the <w>rostrum</w> and began his talk."
                            }
                        },
                        {
                            "text": "Z <w>ambony</w> rozbrzmiewały słowa powitania skierowane do zebranych gości.",
                            "target_lang_translations": {
                                "en": "Words of welcome addressed to the gathered guests resonated from the <w>podium</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mównica",
                        "trybuna"
                    ],
                    "common_phrases": [
                        "przemawiać z ambony"
                    ],
                    "target_lang_definitions": {
                        "en": "a raised platform or stand designated for a speaker"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rostrum",
                                "target_lang_sense_clarification": "raised platform for public speaking"
                            },
                            {
                                "target_lang_word": "podium",
                                "target_lang_sense_clarification": "speaker's platform or stand"
                            },
                            {
                                "target_lang_word": "dais",
                                "target_lang_sense_clarification": "low platform for speakers"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9728966-7bf3-3b5b-8aea-797aef0a590f",
                    "sense_definition": "niewielka wieżyczka służąca myśliwym do obserwacji terenu i polowania na zwierzynę",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Myśliwy spędził kilka godzin na leśnej <w>ambonie</w>, obserwując okolicę.",
                            "target_lang_translations": {
                                "en": "The hunter spent several hours on the forest <w>tree stand</w>, watching the area."
                            }
                        },
                        {
                            "text": "Drewniana <w>ambona</w> stała na skraju gęstego lasu.",
                            "target_lang_translations": {
                                "en": "A wooden <w>hunting blind</w> stood at the edge of the dense forest."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ambona myśliwska"
                    ],
                    "target_lang_definitions": {
                        "en": "a small raised tower or blind used by hunters for observing terrain and shooting game"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hunting blind",
                                "target_lang_sense_clarification": "enclosed shelter or raised hide for hunting"
                            },
                            {
                                "target_lang_word": "tree stand",
                                "target_lang_sense_clarification": "elevated platform used by hunters"
                            },
                            {
                                "target_lang_word": "shooting stand",
                                "target_lang_sense_clarification": "raised structure or post for hunters"
                            },
                            {
                                "target_lang_word": "high seat",
                                "target_lang_sense_clarification": "elevated hunting stand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dee8253b-e843-3e1d-b285-0890fa22671f",
                    "sense_definition": "występ skalny o płaskim wierzchołku, odcinający się od zbocza lub ściany górskiej",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wspinacze zrobili krótki odpoczynek na skalnej <w>ambonie</w> przed dalszą drogą.",
                            "target_lang_translations": {
                                "en": "The climbers took a short rest on the rock <w>ledge</w> before continuing their route."
                            }
                        },
                        {
                            "text": "Z wąskiej <w>ambony</w> rozciągał się zapierający dech w piersiach widok na dolinę.",
                            "target_lang_translations": {
                                "en": "A breathtaking view of the valley opened up from the narrow rock <w>shelf</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kazalnica"
                    ],
                    "common_phrases": [
                        "ambona skalna"
                    ],
                    "target_lang_definitions": {
                        "en": "a flat-topped rock outcrop projecting from a slope or mountain face"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ledge",
                                "target_lang_sense_clarification": "narrow flat rock shelf on a cliff"
                            },
                            {
                                "target_lang_word": "rock shelf",
                                "target_lang_sense_clarification": "flat rocky outcrop"
                            },
                            {
                                "target_lang_word": "rock pulpit",
                                "target_lang_sense_clarification": "protruding flat rock formation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}