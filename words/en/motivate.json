{
    "word_family": [
        "motivation",
        "motivator",
        "motivational",
        "motive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5af772f0-e8e2-339f-a224-7d2f80174784",
                    "sense_definition": "To provide someone with an incentive or enthusiasm to do something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "encourage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager tried to <w>motivate</w> the team by offering a bonus for finishing the project early.",
                            "target_lang_translations": {
                                "ru": "Менеджер пытался <w>мотивировать</w> команду, предложив бонус за досрочное завершение проекта."
                            }
                        },
                        {
                            "text": "It is important to <w>motivate</w> students to learn by making the lessons interesting and relevant.",
                            "target_lang_translations": {
                                "ru": "Важно <w>стимулировать</w> студентов к учебе, делая уроки интересными и актуальными."
                            }
                        }
                    ],
                    "synonyms": [
                        "encourage",
                        "inspire",
                        "stimulate",
                        "spur"
                    ],
                    "antonyms": [
                        "demotivate",
                        "discourage",
                        "dissuade"
                    ],
                    "common_phrases": [
                        "motivate students",
                        "motivate employees",
                        "motivate the team"
                    ],
                    "target_lang_definitions": {
                        "ru": "Побуждать кого-либо к действию, вызывая интерес или энтузиазм."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мотивировать",
                                "target_lang_sense_clarification": "побуждать к действию"
                            },
                            {
                                "target_lang_word": "стимулировать",
                                "target_lang_sense_clarification": "давать толчок к развитию или действию"
                            },
                            {
                                "target_lang_word": "вдохновлять",
                                "target_lang_sense_clarification": "вселять энергию и желание что-то делать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e1ed32c-f641-3fee-84bc-725062d74562",
                    "sense_definition": "To be the reason or driving force behind an action or behavior.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police believe the crime was <w>motivated</w> by a desire for revenge.",
                            "target_lang_translations": {
                                "ru": "Полиция полагает, что преступление было <w>продиктовано</w> желанием отомстить."
                            }
                        },
                        {
                            "text": "He was <w>motivated</w> purely by self-interest when he decided to leave the company.",
                            "target_lang_translations": {
                                "ru": "Им <w>двигал</w> исключительно корыстный интерес, когда он решил покинуть компанию."
                            }
                        }
                    ],
                    "synonyms": [
                        "drive",
                        "impel",
                        "prompt",
                        "induce"
                    ],
                    "antonyms": [
                        "halt",
                        "stop"
                    ],
                    "common_phrases": [
                        "motivated by greed",
                        "motivated by fear",
                        "politically motivated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть причиной или движущей силой какого-либо поступка или поведения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двигать",
                                "target_lang_sense_clarification": "быть внутренним стимулом"
                            },
                            {
                                "target_lang_word": "руководствоваться",
                                "target_lang_sense_clarification": "использовать что-то как мотив (в пассивном смысле)"
                            },
                            {
                                "target_lang_word": "побуждать",
                                "target_lang_sense_clarification": "служить причиной действия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}