{
    "word_family": [
        "reliquary"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d5785416-cd85-3dd4-91e0-26ae1c1976d2",
                    "sense_definition": "Something old and outdated, possibly kept for sentimental reasons.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "historical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old typewriter in the corner of his office was a beloved <w>relic</w> of a bygone era.",
                            "target_lang_translations": {
                                "ru": "Старая пишущая машинка в углу его кабинета была любимой <w>реликвией</w> ушедшей эпохи."
                            }
                        },
                        {
                            "text": "Many people consider the old dial telephone to be a historical <w>relic</w> of the twentieth century.",
                            "target_lang_translations": {
                                "ru": "Многие считают старый дисковый телефон историческим <w>пережитком</w> двадцатого века."
                            }
                        }
                    ],
                    "synonyms": [
                        "remains",
                        "relic"
                    ],
                    "common_phrases": [
                        "historical relic",
                        "relic of the past"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то старое и устаревшее, возможно, сохраняемое по сентиментальным причинам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реликвия",
                                "target_lang_sense_clarification": "предмет, бережно хранимый как память о прошлом"
                            },
                            {
                                "target_lang_word": "пережиток",
                                "target_lang_sense_clarification": "явление или вещь, сохранившаяся от прошлых эпох"
                            },
                            {
                                "target_lang_word": "реликт",
                                "target_lang_sense_clarification": "вещь или явление, сохранившееся как остаток древности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98b0bfc6-9833-3eeb-96a4-335d6210b92f",
                    "sense_definition": "A part of the body of a saint, or an ancient religious object, kept for veneration.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pilgrims traveled from all over the country to see the sacred <w>relic</w> housed in the cathedral.",
                            "target_lang_translations": {
                                "ru": "Паломники съезжались со всей страны, чтобы увидеть священную <w>реликвию</w>, хранящуюся в соборе."
                            }
                        },
                        {
                            "text": "The golden box contained a holy <w>relic</w> that was believed to have healing powers.",
                            "target_lang_translations": {
                                "ru": "В золотом ларце находились святые <w>мощи</w>, которые, как считалось, обладали исцеляющей силой."
                            }
                        }
                    ],
                    "synonyms": [
                        "halidom"
                    ],
                    "common_phrases": [
                        "holy relic",
                        "sacred relic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть тела святого или древний религиозный предмет, сохраняемый для почитания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мощи",
                                "target_lang_sense_clarification": "святые останки"
                            },
                            {
                                "target_lang_word": "реликвия",
                                "target_lang_sense_clarification": "святыня, объект религиозного поклонения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c389991f-9f0b-3b39-bb5f-851fcceeb8c4",
                    "sense_definition": "That which remains; that which is left after loss or decay; a remaining portion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "remains",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient ruins scattered along the coast were the last <w>relics</w> of a once-great empire.",
                            "target_lang_translations": {
                                "ru": "Древние руины, разбросанные по побережью, были последними <w>останками</w> некогда великой империи."
                            }
                        },
                        {
                            "text": "She exerted the last <w>relics</w> of her strength to reach the summit of the hill.",
                            "target_lang_translations": {
                                "ru": "Она напрягла последние <w>остатки</w> сил, чтобы добраться до вершины холма."
                            }
                        }
                    ],
                    "synonyms": [
                        "remnant",
                        "remainder",
                        "residue",
                        "leavings",
                        "leftover",
                        "remains"
                    ],
                    "common_phrases": [
                        "relics of the past"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что остается; то, что уцелело после разрушения или распада; остаток."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "останки",
                                "target_lang_sense_clarification": "сохранившиеся следы или руины чего-либо"
                            },
                            {
                                "target_lang_word": "остатки",
                                "target_lang_sense_clarification": "уцелевшая часть чего-либо"
                            },
                            {
                                "target_lang_word": "след",
                                "target_lang_sense_clarification": "остаток былого чувства или силы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "145ca413-8152-3f18-9e96-c96b3dff7009",
                    "sense_definition": "A particle or entity that has existed since the Big Bang.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cosmology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cosmologists are searching for light thermal <w>relics</w> to better understand the early universe.",
                            "target_lang_translations": {
                                "ru": "Космологи ищут легкие тепловые <w>реликты</w>, чтобы лучше понять раннюю Вселенную."
                            }
                        },
                        {
                            "text": "These hypothetical particles are considered a cosmic <w>relic</w> from the hot big bang.",
                            "target_lang_translations": {
                                "ru": "Эти гипотетические частицы считаются космическим <w>реликтом</w> горячего Большого взрыва."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cosmic relic"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Частица или объект, существующий со времен Большого взрыва."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реликт",
                                "target_lang_sense_clarification": "космический объект или частица ранней Вселенной"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "38f8083a-12ee-3d74-af3a-054fb5fa387f",
                    "sense_definition": "Pertaining to the Big Bang.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cosmology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists analyzed the <w>relic</w> radiation spectrum to find clues about the early universe.",
                            "target_lang_translations": {
                                "ru": "Ученые проанализировали спектр <w>реликтового</w> излучения, чтобы найти подсказки о ранней Вселенной."
                            }
                        },
                        {
                            "text": "The detection of <w>relic</w> gravitational waves remains a major goal in modern astrophysics.",
                            "target_lang_translations": {
                                "ru": "Обнаружение <w>реликтовых</w> гравитационных волн остается важнейшей задачей современной астрофизики."
                            }
                        }
                    ],
                    "common_phrases": [
                        "relic radiation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Большому взрыву."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реликтовый",
                                "target_lang_sense_clarification": "о космическом излучении или волнах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "903192be-d200-3077-9d0e-ad36c28cbcfb",
                    "sense_definition": "To cause (an object) to appear old or worn, to distress.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aging_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workshop specializes in <w>relicing</w> guitars to give them an authentic vintage look.",
                            "target_lang_translations": {
                                "ru": "Мастерская специализируется на <w>состаривании</w> гитар, чтобы придать им аутентичный винтажный вид."
                            }
                        },
                        {
                            "text": "He decided to <w>relic</w> his new instrument to make it look like it had been played for decades.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>состарить</w> свой новый инструмент, чтобы он выглядел так, будто на нем играли десятилетиями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "relic a guitar"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used primarily in the context of musical instruments"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусственно состаривать предмет (например, музыкальный инструмент), придавая ему изношенный вид."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "состаривать",
                                "target_lang_sense_clarification": "придавать винтажный вид"
                            },
                            {
                                "target_lang_word": "реликтовать",
                                "target_lang_sense_clarification": "подвергать искусственному старению гитару"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}