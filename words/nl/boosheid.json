    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c5319255-c653-3c27-a82b-caad2194d201",
                    "sense_definition": "De emotie van kwaad of woedend zijn.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In zijn <w>boosheid</w> scheurde hij het contract doormidden.",
                            "target_lang_translations": {
                                "en": "In his <w>anger</w>, he tore the contract in half."
                            }
                        },
                        {
                            "text": "Zij probeerde haar <w>boosheid</w> te onderdrukken tijdens het gesprek.",
                            "target_lang_translations": {
                                "en": "She tried to suppress her <w>anger</w> during the conversation."
                            }
                        }
                    ],
                    "synonyms": [
                        "woede",
                        "kwaadheid",
                        "nijd"
                    ],
                    "common_phrases": [
                        "boosheid uiten",
                        "boosheid onderdrukken"
                    ],
                    "target_lang_definitions": {
                        "en": "The emotion of being angry or furious."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "anger",
                                "target_lang_sense_clarification": "the feeling of being angry"
                            },
                            {
                                "target_lang_word": "rage",
                                "target_lang_sense_clarification": "extreme or violent anger"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd3d356e-b5f2-3670-a4e5-ab660b8f3aae",
                    "sense_definition": "De hoedanigheid of staat van het <w>boos</w> zijn.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hoedanigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn voortdurende <w>boosheid</w> maakt het moeilijk om met hem samen te werken.",
                            "target_lang_translations": {
                                "en": "His constant <w>anger</w> makes it difficult to work with him."
                            }
                        },
                        {
                            "text": "Schelden uit pure <w>boosheid</w> lost het probleem meestal niet op.",
                            "target_lang_translations": {
                                "en": "Shouting out of pure <w>anger</w> usually does not solve the problem."
                            }
                        }
                    ],
                    "synonyms": [
                        "kwaadheid"
                    ],
                    "common_phrases": [
                        "uit boosheid"
                    ],
                    "target_lang_definitions": {
                        "en": "The quality or state of being angry."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "anger",
                                "target_lang_sense_clarification": "the state of being angry"
                            },
                            {
                                "target_lang_word": "crossness",
                                "target_lang_sense_clarification": "the state of being annoyed or slightly angry"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f379e53-0164-3198-9d57-5d1a2b9dcde3",
                    "sense_definition": "De hoedanigheid van het kwaadaardig of moreel slecht zijn.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schurk in het sprookje stond bekend om zijn extreme <w>boosheid</w>.",
                            "target_lang_translations": {
                                "en": "The villain in the fairy tale was known for his extreme <w>wickedness</w>."
                            }
                        },
                        {
                            "text": "Zij geloofde niet in de inherente <w>boosheid</w> van de mensheid.",
                            "target_lang_translations": {
                                "en": "She did not believe in the inherent <w>wickedness</w> of humanity."
                            }
                        }
                    ],
                    "synonyms": [
                        "boosaardigheid",
                        "kwaadaardigheid",
                        "kwaadwillendheid",
                        "kwaadwilligheid",
                        "perversiteit",
                        "slechtheid",
                        "verdorvenheid"
                    ],
                    "antonyms": [
                        "goedheid",
                        "goedaardigheid",
                        "goedwillendheid"
                    ],
                    "target_lang_definitions": {
                        "en": "The quality of being malicious or morally bad."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wickedness",
                                "target_lang_sense_clarification": "the state of being evil or morally bad"
                            },
                            {
                                "target_lang_word": "malevolence",
                                "target_lang_sense_clarification": "hostile attitude or ill will"
                            },
                            {
                                "target_lang_word": "malice",
                                "target_lang_sense_clarification": "the desire to cause harm to others"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}