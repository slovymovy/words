                                        "glosses": [
                                            "Plagued by incontinence; unable to retain natural discharges or evacuations, most commonly of urine or feces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de5ba988-f2fb-4a89-aa29-5feb4d1036b4",
                                                "sense_id": "79017706-3122-3358-aad1-21321c7d50bb",
                                                "text": "About 90% of all koalas have chlamydia... which makes them incontinent, so they spend all day pissing themselves."
                                            },
                                            {
                                                "example_id": "f6f2f6c1-a808-4810-b55a-50318a8128f8",
                                                "sense_id": "79017706-3122-3358-aad1-21321c7d50bb",
                                                "text": "The male body, opened and bleeding, can assume the shameful attributes of the incontinent female body as both cause of and justification for its evident vulnerability and defeat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d14e8d1e-3b76-3624-8000-2c0a5a9b725b",
                                        "entry_id": "a2c150f0-20a5-3ed3-9f91-85ec5314e12b",
                                        "glosses": [
                                            "Lacking moral or sexual restraint, moderation or self-control, especially of sexual desire."
                                        ],
                                        "tags": [],
