            "senses": [
                {
                    "sense_id": "11d70b14-6294-3ee9-b3ec-dae5526b295f",
                    "sense_definition": "etwas für die Zukunft planen, einplanen oder für einen bestimmten Zweck reservieren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "planen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Für das neue Projekt <w>haben</w> wir drei Monate Arbeitszeit <w>vorgesehen</w>."
                        },
                        {
                            "text": "Der Architekt <w>sieht</w> in seinem Entwurf einen großen Garten hinter dem Haus <w>vor</w>."
                        }
                    ],
                    "synonyms": [
                        "beabsichtigen"
                    ],
                    "common_phrases": [
                        "im Zeitplan vorsehen",
                        "ein Budget vorsehen"
                    ]
                },
                {
                    "sense_id": "48c8317e-5dfe-3e7a-83c6-3cd941450cdc",
                    "sense_definition": "jemanden für eine bestimmte Aufgabe, Position oder Rolle bestimmen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "planen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Leitung hat die junge Kollegin für die Stelle als Abteilungsleiterin <w>vorgesehen</w>."
                        },
                        {
                            "text": "Für diese verantwortungsvolle Aufgabe <w>war</w> von Anfang an ein erfahrener Mitarbeiter <w>vorgesehen</w>."
                        }
                    ],
                    "common_phrases": [
                        "für ein Amt vorsehen",
                        "für eine Stelle vorsehen"
                    ]
                },
                {
                    "sense_id": "5fdbdadc-2335-3bb0-928b-8075c6fff484",
                    "sense_definition": "in Vorschriften, Gesetzen oder Vereinbarungen als Regelung oder Möglichkeit festlegen",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "planen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Vertrag <w>sieht</w> bei vorzeitiger Kündigung eine Entschädigung für den Mieter <w>vor</w>."
                        },
                        {
                            "text": "Das geltende Gesetz <w>hat</w> für solche Ausnahmefälle keine Fristverlängerung <w>vorgesehen</w>."
                        }
                    ],
                    "common_phrases": [
                        "gesetzlich vorgesehen",
                        "im Vertrag vorsehen"
                    ]
                },
                {
                    "sense_id": "d17f9168-cf79-30cc-abd5-a66bb139445d",
                    "sense_definition": "sich vor einer Gefahr hüten oder achtsam sein (reflexiv)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aufpassen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf der vereisten Straße musst du dich unbedingt vor glatten Stellen <w>vorsehen</w>."
                        },
                        {
                            "text": "Er <w>sah</w> sich vor den falschen Versprechungen der Betrüger rechtzeitig <w>vor</w>."
                        }
                    ],
                    "synonyms": [
                        "in Acht nehmen",
                        "aufpassen"
                    ],
                    "common_phrases": [
                        "sich vorsehen vor",
                        "sich gut vorsehen"
                    ]
                },
                {
                    "sense_id": "c1f64c70-6cae-379d-86a0-9cbf9545c64a",
                    "sense_definition": "hinter, unter oder zwischen etwas hervorschauen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "schauen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das neugierige Kind <w>sah</w> vorsichtig hinter dem dicken Baumstamm <w>vor</w>."
                        },
                        {
                            "text": "Er konnte hinter der Hausecke kaum <w>vorsehen</w>, ohne von den Wachen bemerkt zu werden."
                        }
                    ],
                    "synonyms": [
                        "vorschauen",
                        "hervorschauen"
                    ],
                    "common_phrases": [
                        "hinter der Ecke vorsehen"
                    ]
                }
            ]
        }
    ]
