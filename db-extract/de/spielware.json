                        "target_lang_word": "jouet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jouet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3b8612f-99f8-3444-a9d2-d7f18d73305a",
                                        "entry_id": "71401626-f354-3b87-a96c-2c2b1d9f6b4a",
                                        "glosses": [
                                            "Objet qui sert à amuser les enfants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee6109e4-0fb9-4eb9-8586-24a4cf5ffcd0",
                                                "sense_id": "f3b8612f-99f8-3444-a9d2-d7f18d73305a",
                                                "text": "Pour preuve, Netflix, avec une série animée, et Mattel, avec une nouvelle gamme de jouets, ont ressorti Musclor de la naphtaline."
                                            },
                                            {
                                                "example_id": "aec8642d-85da-44d1-855a-660a714e774e",
                                                "sense_id": "f3b8612f-99f8-3444-a9d2-d7f18d73305a",
                                                "text": "Petit Papa Noël\nQuand tu descendras du ciel\nAvec des jouets par milliers\nN’oublie pas mon petit soulier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdc63035-aa26-3d88-8ca0-b9b1fed549a1",
                                        "entry_id": "71401626-f354-3b87-a96c-2c2b1d9f6b4a",
                                        "glosses": [
                                            "Objet à fonction érotique destiné à provoquer le plaisir."
                                        ],
                                        "tags": [
                                            "Par plaisanterie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75204bd9-511a-30f4-a136-99a1dfa0cc72",
                                        "entry_id": "71401626-f354-3b87-a96c-2c2b1d9f6b4a",
                                        "glosses": [
                                            "Objet qui sert à amuser les animaux domestiques."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38c40f8c-94df-3aac-a031-a1649febcba3",
                                        "entry_id": "71401626-f354-3b87-a96c-2c2b1d9f6b4a",
                                        "glosses": [
                                            "De manière plus général, objet que l’on manipule sans règle imposée, pour le seul plaisir, par opposition à un jeu qui fait lui intervenir des règles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf069700-319a-3cb5-a121-bd8b9e54d299",
                                        "entry_id": "71401626-f354-3b87-a96c-2c2b1d9f6b4a",
                                        "glosses": [
                                            "Celui, celle dont on se joue ou une chose dont on s’amuse ou dont on semble s’amuser."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5c605e6-1784-4f36-84d3-023d2b9a8639",
                                                "sense_id": "cf069700-319a-3cb5-a121-bd8b9e54d299",
                                                "text": "Ainsi que tous les hommes qui ont longtemps mené une vie errante, pendant laquelle ils ont été sans cesse le jouet d’événements plus ou moins fâcheux, je suis doué d’une bonne dose de philosophie, […]."
                                            },
                                            {
                                                "example_id": "38eba14d-9641-4e89-9ec8-ce56090eacab",
                                                "sense_id": "cf069700-319a-3cb5-a121-bd8b9e54d299",
                                                "text": "Parmi les personnes […], quelques-unes doivent être plus spécialement signalées, car ce sont elles qui vont devenir le jouet de circonstances terribles, qu’aucune perspicacité humaine ne pouvait prévoir."
                                            },
                                            {
                                                "example_id": "bb81e93f-761c-4085-be3f-10eeb5e34c7c",
                                                "sense_id": "cf069700-319a-3cb5-a121-bd8b9e54d299",
                                                "text": "Redillon. — Dites-moi que je ne suis pas le jouet d’un rêve ! Vous êtes bien à moi ? Rien qu’à moi ?…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65d29b3a-2128-3bd2-8c5b-fff30a9ddeac",
                                        "entry_id": "71401626-f354-3b87-a96c-2c2b1d9f6b4a",
                                        "glosses": [
                                            "Plaque en métal que l’on fixe sur les côtés du sep de drisse de manière à éviter les frottements dues au poulies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89f98925-95a5-3357-9463-343d2d83e3ab",
                                        "entry_id": "71401626-f354-3b87-a96c-2c2b1d9f6b4a",
                                        "glosses": [
                                            "Petite chaîne que l’on accroche à la brisure du canon qui forme l’embouchure dans le mors d’un cheval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95ab616d-04bf-43ab-b85e-ca7d72dad5fa",
                                                "sense_id": "89f98925-95a5-3357-9463-343d2d83e3ab",
                                                "text": "Le mors de filet à jouet, destiné à faire mâchonner les jeunes chevaux et à leur rendre la bouche fraîche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
