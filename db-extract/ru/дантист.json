                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8203376-6d38-4ac1-bbac-c7fbaed32b0d",
                                                "sense_id": "31a27cce-5b81-320b-af2c-91d80e40dfdf",
                                                "text": "Boli mnie ząb, więc muszę iść do dentysty."
                                            },
                                            {
                                                "example_id": "b7213f99-a708-4f82-969d-0f3714e22333",
                                                "sense_id": "31a27cce-5b81-320b-af2c-91d80e40dfdf",
                                                "text": "Chodzę regularnie do dentysty co sześć miesięcy."
                                            },
                                            {
                                                "example_id": "bf90ceee-2db4-4490-ba8e-824c85fd2e47",
                                                "sense_id": "31a27cce-5b81-320b-af2c-91d80e40dfdf",
                                                "text": "Możesz mi polecić dobrego dentystę?"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
