                        "examples": [
                            {
                                "example_id": "85277072-e82b-4193-8ebe-350d59be9f76",
                                "sense_id": "8eead95e-7266-3be2-905b-ca64ac905a81",
                                "text": "Der SS-Obergruppenführer entsprach dem General der Wehrmacht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0826b2e2-7d8d-3846-8355-ce4a34b6268d",
                        "entry_id": "6ba7770b-2ba9-3d78-bc8b-290b515cccca",
                        "glosses": [
                            "General im Range eines SS-Obergruppenführers"
                        ],
                        "tags": [
                            "Schutzstaffel"
                        ],
                        "examples": [
                            {
                                "example_id": "9600200f-90df-4650-9064-b17f2ba2b553",
                                "sense_id": "0826b2e2-7d8d-3846-8355-ce4a34b6268d",
                                "text": "„Butenandt gehörte 1944 auch einem Kreis an, der bis heute nicht bekannt ist: dem Wissenschaftlichen Beirat von SS-Obergruppenführer Karl Brandt (1904 bis 1948), Hitlers Reichskommissar für das Sanitäts- und Gesundheitswesen.“"
                            },
                            {
                                "example_id": "04aa2434-99fd-40bb-b8fe-dbfded2569b9",
                                "sense_id": "0826b2e2-7d8d-3846-8355-ce4a34b6268d",
                                "text": "„Und wer neunzehnhundertsiebzig ein Interesse an derlei bezweifelt, wird an jenem Stand belehrt, wo ein NS-Tandler die kolorierten Bilder von milde dreinblickenden SS-Obergruppenführern im vollen Ornat feilhält.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
