                                            {
                                                "example_id": "0db819a4-fb5e-487c-90f6-e7dc179262f1",
                                                "sense_id": "b2765c2e-fc3f-32e3-aa7c-9bf84e3039a4",
                                                "text": "Die Geräte sind aus Holz, Knochen oder Stein."
                                            },
                                            {
                                                "example_id": "4460e242-fb0e-4628-947f-5d201b7e1ead",
                                                "sense_id": "b2765c2e-fc3f-32e3-aa7c-9bf84e3039a4",
                                                "text": "übertragen: Sie hat ein Herz aus Stein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea8723dc-e5ff-3fd2-9c71-376ad9220fe4",
                                        "entry_id": "b35e34be-5724-36d0-ac02-6caaa6ece7e7",
                                        "glosses": [
                                            "Körper aus mineralischem Material"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1104785f-f74f-4b35-8885-020e51abc7c8",
                                                "sense_id": "ea8723dc-e5ff-3fd2-9c71-376ad9220fe4",
                                                "text": "Als sie [die Schriftgelehrten und Pharisäer] nun fortfuhren, ihn zu fragen, richtete er [Jesus] sich auf und sprach zu ihnen: Wer unter Euch ohne Sünde ist, der werfe den ersten Stein auf sie [die Ehebrecherin]."
                                            },
                                            {
                                                "example_id": "67bfb493-0187-4ba6-9e82-57e8fee1e8f6",
                                                "sense_id": "ea8723dc-e5ff-3fd2-9c71-376ad9220fe4",
                                                "text": "Wer wälzt den Stein von des Grabes Tür?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "56cdbf65-5191-3324-a61b-2b553a3c0b6b",
                                        "entry_id": "b35e34be-5724-36d0-ac02-6caaa6ece7e7",
                                        "glosses": [
                                            "Bauelement für Gebäude und Ähnliches, Baustein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b798348-77ea-4fc9-9139-fa218295319d",
                                                "sense_id": "56cdbf65-5191-3324-a61b-2b553a3c0b6b",
                                                "text": "Stein auf Stein / Das Häuschen wird bald fertig sein! - (Kinderlied)"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2ab9c568-8feb-389a-bdd5-2d3315c1351f",
                                        "entry_id": "b35e34be-5724-36d0-ac02-6caaa6ece7e7",
                                        "glosses": [
                                            "kurz für Edelstein oder Schmuckstein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff7128c5-ef63-4caa-ae4b-a86f4e1d593d",
                                                "sense_id": "2ab9c568-8feb-389a-bdd5-2d3315c1351f",
                                                "text": "Der Stein ist wunderschön geschliffen."
                                            },
                                            {
                                                "example_id": "f42e111f-b138-4a20-8138-111d5f7cffeb",
                                                "sense_id": "2ab9c568-8feb-389a-bdd5-2d3315c1351f",
                                                "text": "„Sie trägt einen grünen Sweater, einen kurzen Rock und große Ohrringe mit falschen Steinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c6b7b3c6-e7e0-3d50-9a7e-adaf48d0d9e1",
                                        "entry_id": "b35e34be-5724-36d0-ac02-6caaa6ece7e7",
                                        "glosses": [
                                            "in der Drogenszene Bezeichnung für Crack"
