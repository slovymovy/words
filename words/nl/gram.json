            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d4792e2c-88f6-3609-a8b5-db90deee562f",
                    "sense_definition": "Een eenheid van massa die gelijk is aan één duizendste van een kilogram.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "massa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een <w>gram</w> van een stof is ook op de maan een <w>gram</w>.",
                            "target_lang_translations": {
                                "en": "A <w>gram</w> of a substance is also a <w>gram</w> on the moon.",
                                "ru": "Один <w>грамм</w> вещества остается <w>граммом</w> и на Луне."
                            }
                        },
                        {
                            "text": "In totaal scheelden deze multifunctionele stokken mij 350 <w>gram</w> aan gewicht.",
                            "target_lang_translations": {
                                "en": "In total, these multifunctional poles saved me 350 <w>grams</w> in weight.",
                                "ru": "В общей сложности эти многофункциональные палки сэкономили мне 350 <w>граммов</w> веса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "honderd gram kaas",
                        "per gram betalen"
                    ],
                    "target_lang_definitions": {
                        "en": "A unit of mass equal to one-thousandth of a kilogram.",
                        "ru": "Единица массы, равная одной тысячной килограмма."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gram",
                                "target_lang_sense_clarification": "unit of mass"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "грамм",
                                "target_lang_sense_clarification": "единица массы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f545f367-8de9-3e2b-95dc-334da2a6c27d",
                    "sense_definition": "Een gevoel van diepe boosheid of verontwaardiging.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij verhaalde zijn <w>gram</w> op zijn kinderen na een lange dag op het werk.",
                            "target_lang_translations": {
                                "en": "He took out his <w>resentment</w> on his children after a long day at work.",
                                "ru": "Он выместил свой <w>гнев</w> на детях после долгого рабочего дня."
                            }
                        },
                        {
                            "text": "Zijn <w>gram</w> halen was het enige waar hij nog aan kon denken.",
                            "target_lang_translations": {
                                "en": "Getting his <w>revenge</w> was the only thing he could still think about.",
                                "ru": "Взять <w>реванш</w> было единственным, о чем он мог думать."
                            }
                        }
                    ],
                    "synonyms": [
                        "woede",
                        "gramschap",
                        "kwaadheid",
                        "toorn"
                    ],
                    "common_phrases": [
                        "zijn gram halen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in de uitdrukking 'zijn gram halen'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A feeling of deep anger, resentment, or indignation.",
                        "ru": "Чувство глубокого гнева, обиды или негодования."
                    },
                    "translations": {
