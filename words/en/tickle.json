                                "target_lang_sense_clarification": "неустойчиво"
                            },
                            {
                                "target_lang_word": "неуверенно",
                                "target_lang_sense_clarification": "в опасном положении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
