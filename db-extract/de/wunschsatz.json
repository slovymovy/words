                "senses": [
                    {
                        "sense_id": "a5406b8b-3828-3196-a929-ed9e417025eb",
                        "entry_id": "df1a31ea-1536-3f95-a677-844445c49a6b",
                        "glosses": [
                            "Satz, der einen Wunsch ausdrückt. Diese Sätze haben im Deutschen das Verb in Erststellung im Konjunktiv oder eine entsprechende Nebensatzform mit \\\"wenn\\\" oder \\\"dass\\\" als Einleitung."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f5d6740-9dc9-4728-9e32-5a5d969e0a36",
                                "sense_id": "a5406b8b-3828-3196-a929-ed9e417025eb",
                                "text": "Der Satz \"Käme er doch endlich!\" ist ein Wunschsatz, ebenso wie: \"Wenn er doch endlich käme!\""
                            },
                            {
                                "example_id": "5e29ff12-19e9-4422-a3c5-58cd1a17dc06",
                                "sense_id": "a5406b8b-3828-3196-a929-ed9e417025eb",
                                "text": "Wunschsätze enden mit einem Ausrufezeichen."
                            },
                            {
                                "example_id": "3cc4f84e-8849-4565-8dcc-0183bad1c5ad",
                                "sense_id": "a5406b8b-3828-3196-a929-ed9e417025eb",
                                "text": "„Wenn man jemanden zu etwas auffordern möchte, drückt man das bei uns oft eher in der Form eines Fragesatzes als mit einem Wunschsatz aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
