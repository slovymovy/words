                        ],
                        "examples": [
                            {
                                "example_id": "7aa69d40-418f-4d54-a724-21ba0a6a5ed5",
                                "sense_id": "a66055b4-9716-3dcb-ae86-a9707ce48858",
                                "text": "\"Well then,\" said he, \"I'm jiggered if I don't see you home!\""
                            },
                            {
                                "example_id": "1320ca8a-5e1b-4188-8038-20d8c31f3849",
                                "sense_id": "a66055b4-9716-3dcb-ae86-a9707ce48858",
                                "text": "\"Well, I'm—I'm jiggered,\" said Peter, and his voice also sounded queer."
                            }
                        ]
