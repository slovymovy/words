                                        "sense_id": "23424e2d-dc99-3ef5-9b6d-5b23bf04edbe",
                                        "entry_id": "57b4e31a-f456-344c-9e7a-1a49f3de3a2f",
                                        "glosses": [
                                            "las bukowy (złożony z buków), buczyna"
                                        ],
                                        "tags": [
                                            "literary",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47746cd2-5c72-4a2d-b1aa-87f3dcf060c6",
                                                "sense_id": "23424e2d-dc99-3ef5-9b6d-5b23bf04edbe",
                                                "text": "Jeszcze dalej ku południowi graniczyło Henrykowo z ogromną bukowiną, czyli lasem bukowym"
                                            },
                                            {
                                                "example_id": "5dc8b17e-13bb-44c4-9047-a17b845bcd99",
                                                "sense_id": "23424e2d-dc99-3ef5-9b6d-5b23bf04edbe",
                                                "text": "Biegnę w zielone gąszcze między zielone drzewa, I zna mnie już dąbrowa, i zna mnie bukowina, I bór wysokopienny dla mnie swój cień rozpina, I taka cisza we mnie"
                                            },
                                            {
                                                "example_id": "8674d7c6-769c-44d8-91a3-a18a43aa0f05",
                                                "sense_id": "23424e2d-dc99-3ef5-9b6d-5b23bf04edbe",
                                                "text": "Jechali więc, początkowo przez bukowiny i dąbrowy, potem duktami, wreszcie drogą, wijącą się wśród pagórków"
                                            }
                                        ],
