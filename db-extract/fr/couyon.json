                "senses": [
                    {
                        "sense_id": "a5418b47-a9be-35e1-8142-964299e3c06a",
                        "entry_id": "a0388e5a-88a2-3a8e-be86-58517fbcd5da",
                        "glosses": [
                            "Jeu de cartes de la région de Malmédy notamment, mais il se pratique dans toute la Wallonie."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "18f9e81f-cd9c-4614-b315-07ec2fe09a6e",
                                "sense_id": "a5418b47-a9be-35e1-8142-964299e3c06a",
                                "text": "A Meux, dans la salle derrière l’église, on organise un concours de « couyon » (jeu de cartes) international dont les vainqueurs reçoivent une coupe offerte par le ministre de la Culture française."
                            },
                            {
                                "example_id": "ae62677a-805b-401d-b98e-66cfdb47fdbb",
                                "sense_id": "a5418b47-a9be-35e1-8142-964299e3c06a",
                                "text": "Tous souriaient de voir Rose en proie à une bienfaisante crise, où sa nature raisonnable, depuis plusieurs heures comprimée par le chausseur, tel un coude-pied dans une bottine mal faite, se dilatait d’aise, enfin. Ils se mirent à jouer au couyon. Flagothier s’intéressait peu au jeu, visiblement mal à l’aise, étonné de rester aussi longtemps chez lui."
                            }
                        ]
                    }
