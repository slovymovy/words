                            "comment": "often used in fashion or pop culture contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исключительного качества, демонстрирующий смелость, стиль или уверенность.",
                        "zh": "指卓越的品质，表现出大胆、时尚或自信。"
