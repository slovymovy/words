        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8522e3f7-9ca9-3b38-8497-dcdfcc6085b0",
                    "sense_definition": "A border, frame, or structure that is placed around something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old fireplace has a beautiful wooden <w>surround</w>.",
                            "target_lang_translations": {
                                "ru": "У старого камина красивое деревянное <w>обрамление</w>.",
                                "zh": "这个旧壁炉有一个漂亮的木制<w>边框</w>。",
                                "es": "La vieja chimenea tiene un hermoso <w>marco</w> de madera.",
                                "tr": "Eski şöminenin güzel bir ahşap <w>çerçevesi</w> var.",
                                "de": "Der alte Kamin hat eine schöne hölzerne <w>Umrandung</w>."
                            }
                        },
                        {
                            "text": "We need to buy a new <w>surround</w> for the bathtub.",
                            "target_lang_translations": {
                                "ru": "Нам нужно купить новую <w>обшивку</w> для ванны.",
                                "zh": "我们需要给浴缸买一个新的<w>围边</w>。",
                                "es": "Necesitamos comprar un nuevo <w>revestimiento</w> para la bañera.",
                                "tr": "Küvet için yeni bir <w>kenarlık</w> almamız gerekiyor.",
                                "de": "Wir müssen eine neue <w>Verkleidung</w> für die Badewanne kaufen."
                            }
                        }
                    ],
                    "common_phrases": [
