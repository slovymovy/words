                "senses": [
                    {
                        "sense_id": "7e7308f5-1c62-3e65-8f18-8a8cf06e9dbd",
                        "entry_id": "dd06e89e-e691-3100-9b13-c08d852f36dc",
                        "glosses": [
                            "sprachlich vollständige (nicht gekürzte) Form eines Ausdrucks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6079a8d5-c2a2-463b-8d99-62eab4bf949d",
                                "sense_id": "7e7308f5-1c62-3e65-8f18-8a8cf06e9dbd",
                                "text": "„Diese Abkürzungen werden in der gesprochenen Sprache gewöhnlich durch die zugrunde liegenden Vollformen ersetzt.“"
                            },
                            {
                                "example_id": "053e3b34-d84c-4bc9-90c5-1b78fd1601e1",
                                "sense_id": "7e7308f5-1c62-3e65-8f18-8a8cf06e9dbd",
                                "text": "„Neben den unverkürzten zweigliedrigen Vollformen treten vielfältige Kurzformen auf.“"
                            },
                            {
                                "example_id": "2be7f9c3-0a64-4cee-b367-5ce41715d72d",
                                "sense_id": "7e7308f5-1c62-3e65-8f18-8a8cf06e9dbd",
                                "text": "„Klar, ein Kürzel nimmt geschrieben oder gedruckt weniger Raum ein als die Vollform.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
