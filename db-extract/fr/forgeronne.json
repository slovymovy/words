                ],
                "senses": [
                    {
                        "sense_id": "b1e389ab-6817-3b8d-80d2-e6ebb14dd7f0",
                        "entry_id": "fcdc9ea0-4f91-306d-8fb4-bc7d492d8a08",
                        "glosses": [
                            "Ouvrière ou artisane qui travaille le fer au marteau, après l’avoir fait chauffer à la forge. Il se dit principalement de celles qui font les gros ouvrages de fer, comme barres, ancres, chaînes et instruments aratoires."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "ceb13b55-ba36-4880-b1be-2b08d560e6a7",
                                "sense_id": "b1e389ab-6817-3b8d-80d2-e6ebb14dd7f0",
                                "text": "Brigit c.-à-d. une poétesse, fille du Dagda. C’est Brigit la sage, ou femme de sagesse, c.-à-d. Brigit la déesse que les poètes adoraient, car très grande et très connue était sa protection. C’est pour cela qu’ils la nomment déesse des poètes, par ce nom. Dont les sœurs étaient Brigit la guérisseuse, Brigit la forgeronne, nom par lequel tous les Irlandais appellent une déesse Brigit."
                            }
                        ]
                    },
                    {
                        "sense_id": "911e2665-9b75-398e-83fd-3d2071a23938",
                        "entry_id": "fcdc9ea0-4f91-306d-8fb4-bc7d492d8a08",
                        "glosses": [
                            "Épouse d’un forgeron."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3b9b940d-cbd4-4757-8587-4a308adc1f8e",
                                "sense_id": "911e2665-9b75-398e-83fd-3d2071a23938",
                                "text": "A dix lieues à la ronde, on n’appelle madame Marguerite que la belle forgeronne."
                            }
                        ]
                    },
                    {
                        "sense_id": "d14b9820-c964-3ed0-922f-c7aa8fef1391",
                        "entry_id": "fcdc9ea0-4f91-306d-8fb4-bc7d492d8a08",
                        "glosses": [
                            "Celle qui pratique l’excision rituelle du clitoris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a99dc1d2-6c2f-42c0-8d09-49c2081ea3cd",
                                "sense_id": "d14b9820-c964-3ed0-922f-c7aa8fef1391",
                                "text": "Depuis qu’elle a vu la forgeronne\nDepuis qu’est apparue la forgeronne qui va tuer la petite Soumba\nSoumba se lamente […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abf4030a-ed7b-4cd0-9733-3c4885c5c8bc",
                        "source_entry_id": "fcdc9ea0-4f91-306d-8fb4-bc7d492d8a08",
                        "source_sense_id": "b1e389ab-6817-3b8d-80d2-e6ebb14dd7f0",
