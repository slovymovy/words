                        "cross_references": [
                            {
                                "target_word": "pho",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf8d84ea-37b6-3df2-89c3-54cc25355ee0",
                                        "entry_id": "a0aca944-a9b8-3ef4-8ac0-8f0356be1446",
                                        "glosses": [
                                            "A Vietnamese soup with a beef base, typically served with rice noodles and optionally beef or chicken."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e5b2fbe-79cd-4f2c-8ba3-d66c7e993f30",
                                                "sense_id": "cf8d84ea-37b6-3df2-89c3-54cc25355ee0",
                                                "text": "PHO is the name of an Annamese soup held in high esteem. It is made with beef, a veal bone, onions, a bayleaf, salt, and pepper, and a small teaspoon of nuoc-man, a typically Annamese condiment which is used in practically all their dishes."
                                            },
                                            {
                                                "example_id": "9ae3b4da-63cd-4741-b041-a739854d96af",
                                                "sense_id": "cf8d84ea-37b6-3df2-89c3-54cc25355ee0",
                                                "text": "2003: Frank Browning, \"73106: Lemongrass on the Prairie\", National Geographic, vol. 203, issue 3 http://ngm.nationalgeographic.com/ngm/0303/feature6/\nTen minutes away from the intersection, the heart of Little Saigon, you can easily walk to five restaurants specializing in pho (the classic Vietnamese beef broth soup), two Asian supermarkets, and several Chinese barbecue cafés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pho",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1eae3d1-79df-396d-95b5-f9f07a14e29f",
                                        "entry_id": "c418dc7e-83ab-37c2-8563-a8cea4206e8b",
                                        "glosses": [
                                            "Expressing dismissive contempt."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7f8315a-bb47-4f57-b4b0-108dcc2ef2ea",
                                                "sense_id": "f1eae3d1-79df-396d-95b5-f9f07a14e29f",
                                                "text": "'She is come!' said the old gentleman, laying his hand upon his heart. 'Cormoran and Blunderbore! She is come! All the wealth I have is hers if she will take me for her slave. Where are grace, beauty, and blandishments, like those? In the Empress of Madagascar? No. In the Queen of Diamonds? No. In Mrs Rowland, who every morning bathes in Kalydor for nothing? No. Melt all these down into one, with the three Graces, the nine Muses, and fourteen biscuit-bakers' daughters from Oxford Street, and make a woman half as lovely. Pho! I defy you.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e36c4022-5f71-4bf1-b57e-d685cf5ebb4b",
                        "source_entry_id": "b22b96d8-d09c-365d-bda0-d11793162bc6",
                        "source_sense_id": "73392c5e-a7fb-31d2-92a2-df55bad0ef0b",
                        "source_sense_description": "вьетнамский суп",
                        "target_lang_word": "phở",
                        "target_lang_code": "vi",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phở",
                                "target_lang_code": "vi",
                                "target_senses": [
                                    {
                                        "sense_id": "24032d83-37eb-3766-a5c4-1688a8c367cd",
                                        "entry_id": "75e11c4f-97a5-3f44-8d4a-3f4b69a035f1",
                                        "glosses": [
                                            "Món ăn gồm có bánh phở và thịt bò, thịt gà hoặc thịt lợn, chan nước dùng, hoặc xào với hành mỡ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19058506-1e87-46d4-bc14-a5bc16143136",
                                                "sense_id": "24032d83-37eb-3766-a5c4-1688a8c367cd",
                                                "text": "Phở là một thứ quà đặc biệt của Hà Nội, không phải chỉ riêng Hà Nội mới có, nhưng chính là vì ở Hà Nội mới ngon. Đó là quà tất cả suốt ngày của tất cả các hạng người, nhất là công chức và thợ thuyền. Người ta ăn phở sáng, ăn phở trưa, và ăn phở tối."
                                            },
                                            {
                                                "example_id": "0bc27973-7539-42a6-8735-59d8dd0114e9",
                                                "sense_id": "24032d83-37eb-3766-a5c4-1688a8c367cd",
                                                "text": "Một con bé đang ăn phở bị trúng đạn, ngã xuống, bát phở văng đi."
                                            },
                                            {
                                                "example_id": "8cd82dcc-96e1-42f3-b167-e99dd1cf57d3",
                                                "sense_id": "24032d83-37eb-3766-a5c4-1688a8c367cd",
                                                "text": "Có lẽ đánh bạc không mong được, mà chỉ thức đêm ăn nhục-phở?"
                                            },
                                            {
                                                "example_id": "b77ef737-a319-4361-a519-0ad9fead2268",
                                                "sense_id": "24032d83-37eb-3766-a5c4-1688a8c367cd",
                                                "text": "Này, bác hàng phở! bác đi bán thế, cả ngày có được dăm bay hào đồng bạc không ?"
                                            },
                                            {
                                                "example_id": "730f5cef-c0b2-49a2-8d0b-4ebb848ac508",
                                                "sense_id": "24032d83-37eb-3766-a5c4-1688a8c367cd",
                                                "text": "Tiếng chi quát tháo mãi đêm trường ? / « Phở » « phở » ồn tai chạy giữa đường."
                                            },
                                            {
                                                "example_id": "3c54b82d-aca6-456f-a3de-09bf665fcfc5",
                                                "sense_id": "24032d83-37eb-3766-a5c4-1688a8c367cd",
                                                "text": "Sách dạy nấu cỗ và các món ăn thường, các món ăn quý, đủ ba cách : ta, tầu, tây — Dạy làm các thứ ăn trưa như : tỉm-sắm, mần-thắn, mì, phở, cháo, — Dạy làm các thứ bánh mặn, bánh ngọt, mứt, kẹo — Dạy làm các thứ nước chanh, rượu bia, rượu mùi, vân vân."
                                            }
                                        ]
                                    }
                                ]
