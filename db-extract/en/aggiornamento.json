                ],
                "senses": [
                    {
                        "sense_id": "db06fc00-c28c-3818-9ace-e05dca47c33a",
                        "entry_id": "1a065a64-61d2-3fae-abcd-5b3fcc5a1397",
                        "glosses": [
                            "A bringing up to date, especially of the Roman Catholic Church by the Second Vatican Council of 1962-65; modernization."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aabe8bcd-b6fc-4388-b27c-8a65c9065d66",
                                "sense_id": "db06fc00-c28c-3818-9ace-e05dca47c33a",
                                "text": "Aggiornamento with the increasingly truculent magistrates was a major plank of Choiseul's recovery strategy for the state."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aeb46977-c2c0-4d4c-a6ba-ec91668160ac",
                        "source_entry_id": "1a065a64-61d2-3fae-abcd-5b3fcc5a1397",
                        "source_sense_id": "db06fc00-c28c-3818-9ace-e05dca47c33a",
                        "source_sense_description": "reform of some teachings of Roman Catholic Church in 1962-65",
                        "target_lang_word": "aggiornamento",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aggiornamento",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0330248-4255-350c-9525-78ed48295310",
                                        "entry_id": "d638c0df-5303-3379-895d-0d7f8ab66905",
                                        "glosses": [
                                            "Mise à jour de la doctrine, des rites de l’Église catholique."
                                        ],
                                        "tags": [],
                                        "note": "Souvent écrit en italique parce que toujours senti comme un mot étranger",
                                        "examples": [
                                            {
                                                "example_id": "89adedb9-8ae5-455d-93e6-072ac8f01a85",
                                                "sense_id": "e0330248-4255-350c-9525-78ed48295310",
                                                "text": "En effet, malgré cet effort d’aggiornamento, l’Église reste prisonnière au début du XIIIᵉ siècle de pesanteurs anciennes et nouvelles."
                                            },
                                            {
                                                "example_id": "b74d8fa7-b0aa-4ea8-b0f1-920db23a24ec",
                                                "sense_id": "e0330248-4255-350c-9525-78ed48295310",
                                                "text": "Pendant le concile de Vatican II, les tenants de l’aggiornamento étaient pour la plupart des catholiques libéraux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bf40f93-28ce-3c01-b3e0-3d1c10fa296c",
                                        "entry_id": "d638c0df-5303-3379-895d-0d7f8ab66905",
                                        "glosses": [
                                            "Actualisation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d57f574-0d8c-410a-b0b9-7d97da08c927",
                                                "sense_id": "5bf40f93-28ce-3c01-b3e0-3d1c10fa296c",
                                                "text": "[Titre] Enseignement de la finance : l’aggiornamento se fait attendre"
                                            },
                                            {
                                                "example_id": "8b23df52-2ee1-4933-a02d-b3a666620428",
                                                "sense_id": "5bf40f93-28ce-3c01-b3e0-3d1c10fa296c",
                                                "text": "[Le FN] a fait une sorte d’aggiornamento sur la Shoah, il est moins obsédé par la Seconde Guerre mondiale."
                                            },
                                            {
                                                "example_id": "48a27b32-1fe6-436c-95da-3caa1223b314",
                                                "sense_id": "5bf40f93-28ce-3c01-b3e0-3d1c10fa296c",
                                                "text": "Tout aggiornamento politique était exclu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
