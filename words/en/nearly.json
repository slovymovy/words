    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c7bf097b-3182-3ece-bf5a-49c7161d83d3",
                    "sense_definition": "In close approximation; not quite but almost.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "approximation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>nearly</w> missed the bus this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня утром я <w>чуть не</w> опоздал на автобус.",
                                "tr": "Bu sabah otobüsü <w>az kalsın</w> kaçırıyordum.",
                                "zh": "今天早上我<w>差点</w>没赶上公交车。",
                                "nl": "Ik heb vanmorgen <w>bijna</w> de bus gemist.",
                                "pl": "Dziś rano <w>prawie</w> spóźniłem się na autobus.",
                                "de": "Ich habe heute Morgen <w>beinahe</w> den Bus verpasst.",
                                "fr": "J'ai <w>failli</w> rater le bus ce matin.",
                                "it": "Stamattina <w>per poco non</w> ho perso l'autobus.",
                                "cs": "Dnes ráno jsem <w>málem</w> zmeškal autobus.",
                                "es": "Esta mañana <w>por poco</w> pierdo el autobús."
                            }
                        },
                        {
                            "text": "The project is <w>nearly</w> finished.",
                            "target_lang_translations": {
                                "ru": "Проект <w>почти</w> завершён.",
                                "tr": "Proje <w>neredeyse</w> bitti.",
                                "zh": "这个项目<w>几乎</w>完成了。",
                                "nl": "Het project is <w>bijna</w> klaar.",
                                "pl": "Projekt jest <w>prawie</w> ukończony.",
                                "de": "Das Projekt ist <w>fast</w> abgeschlossen.",
                                "fr": "Le projet est <w>presque</w> terminé.",
                                "it": "Il progetto è <w>quasi</w> finito.",
                                "cs": "Projekt je <w>skoro</w> hotový.",
                                "es": "El proyecto está <w>casi</w> terminado."
                            }
                        }
                    ],
                    "synonyms": [
                        "almost",
                        "practically",
                        "virtually"
                    ],
                    "antonyms": [
                        "completely",
                        "entirely",
                        "totally"
                    ],
                    "common_phrases": [
                        "nearly always",
                        "nearly finished",
                        "not nearly",
                        "nearly impossible",
                        "nearly ready"
                    ],
