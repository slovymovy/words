                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7718452e-f86d-4f09-a60a-22ec09a42497",
                                "sense_id": "14eec8cc-a73e-34a7-892b-2cf3cf5d38de",
                                "text": "Les outils pour attaquer se trouvent sur Internet : pour « cyber-attaquer », il n’y a pas besoin d’être un expert de l'informatique."
                            },
                            {
                                "example_id": "e86c27c9-8c17-4209-baff-2ebb0f399611",
                                "sense_id": "14eec8cc-a73e-34a7-892b-2cf3cf5d38de",
                                "text": "\"L’Iran a élevé depuis 18 mois son niveau de préparation pour cyber-attaquer des sites industriels\", pointe David Grout, de FireEye."
                            },
                            {
                                "example_id": "399a4799-6aef-4758-ba44-b9e3596eec84",
                                "sense_id": "14eec8cc-a73e-34a7-892b-2cf3cf5d38de",
                                "text": "EviCypher est une invention française pour communiquer sans se faire cyber-attaquer."
                            }
                        ]
                    }
