                "senses": [
                    {
                        "sense_id": "343e3783-e296-39d3-bbf4-a52cb1bbb089",
                        "entry_id": "fca34d6d-6ac0-3642-b67e-db61aca3fcb6",
                        "glosses": [
                            "armator lub dowódca, również członek załogi uzbrojonego statku handlowego, walczący na własny koszt i ryzyko w służbie swego mocodawcy prowadzącego wojnę na morzu"
                        ],
                        "tags": [],
