    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3a24d4de-5aa0-309a-9a61-00e175335f51",
                    "sense_definition": "Concentration de l'esprit sur un objet déterminé ou une action en cours.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "concentration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves écoutent les explications du professeur avec beaucoup d'<w>attention</w>."
                        },
                        {
                            "text": "Ce travail difficile demande une grande <w>attention</w> de la part de chacun."
                        }
                    ],
                    "antonyms": [
                        "distraction",
                        "inattention"
                    ],
                    "common_phrases": [
                        "faire attention",
                        "prêter attention"
                    ]
                },
                {
                    "sense_id": "8ae9a036-4084-3ecc-9574-996aaaae9efb",
                    "sense_definition": "Vigilance ou prudence face à un risque ou à une situation délicate.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vigilance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut conduire avec <w>attention</w> quand il pleut sur l'autoroute."
                        },
                        {
                            "text": "Une <w>attention</w> constante est nécessaire pour surveiller les enfants près de la piscine."
                        }
                    ],
                    "synonyms": [
                        "vigilance"
                    ],
                    "antonyms": [
                        "inattention"
                    ],
                    "common_phrases": [
                        "attention soutenue",
                        "attention particulière"
                    ]
                },
                {
                    "sense_id": "258ab57c-98cb-344b-9761-735440d6b946",
                    "sense_definition": "Marque de délicatesse, de bienveillance ou de prévenance envers une personne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gentillesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a apporté des fleurs, une <w>attention</w> qui lui a fait grand plaisir."
                        },
                        {
                            "text": "Ses hôtes ont eu mille <w>attentions</w> pour rendre son séjour agréable."
                        }
                    ],
                    "common_phrases": [
                        "délicate attention",
                        "mille attentions"
                    ]
                },
                {
                    "sense_id": "8c26508d-103d-3db5-ae28-f84dadd46b59",
                    "sense_definition": "En informatique, mécanisme permettant à un modèle de pondérer l'importance relative de chaque élément dans une séquence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau modèle de traitement automatique des langues repose sur une couche d'<w>attention</w>."
                        },
                        {
                            "text": "L'<w>attention</w> permet au réseau de neurones d'identifier les mots les plus pertinents."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "fd464243-9e33-3edc-b05f-bee914afef53",
                    "sense_definition": "Formule servant à avertir d'un danger imminent ou à réclamer la vigilance de quelqu'un.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Attention</w>, la route est très glissante ce matin !"
                        },
                        {
                            "text": "<w>Attention</w>, ne touche pas cette casserole qui est encore brûlante."
                        }
                    ],
                    "common_phrases": [
                        "attention au chien",
                        "attention aux marches"
                    ]
                }
            ]
        }
    ]
