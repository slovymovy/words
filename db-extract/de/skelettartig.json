                ],
                "senses": [
                    {
                        "sense_id": "ed3d2854-9bee-332b-a88c-4c8251ab9849",
                        "entry_id": "11be1234-f49a-3427-a68f-632c73b87fa2",
                        "glosses": [
                            "einem Skelett ähnelnd, wie ein Skelett aussehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6bf7508-377e-4375-abd7-3fad97aff2ee",
                                "sense_id": "ed3d2854-9bee-332b-a88c-4c8251ab9849",
                                "text": "„Kein Chaos, kein Gedränge, keine mutierten Leute, die herumhüpften. Nur Hitler und seine Verlobte, die zwischen den faden, skelettartigen Häusern unterwegs waren.“"
                            },
                            {
                                "example_id": "9f98f279-3fc1-411c-abcd-bb68f4913041",
                                "sense_id": "ed3d2854-9bee-332b-a88c-4c8251ab9849",
                                "text": "„Die skelettartigen Arme schwebten in Zeitlupe und auf dem Rücken bewegten sich langsam die durchsichtigen Schwingen.“"
                            },
                            {
                                "example_id": "08cf367a-28da-41da-b2e2-71639d20ec39",
                                "sense_id": "ed3d2854-9bee-332b-a88c-4c8251ab9849",
                                "text": "„Joe Lon fuhr mit seinem Pick-up den schmalen Weg entlang, der auf beiden Seiten von den skelettartigen Ästen winterkahler Pekanbäume gesäumt wurde.“"
                            },
                            {
                                "example_id": "4a8ece59-3f75-4878-92af-f4d12157b0b5",
                                "sense_id": "ed3d2854-9bee-332b-a88c-4c8251ab9849",
                                "text": "„Mit seinen spitzen Ohren, seinem skelettartigen Körper und den mächtigen Flügeln sah er aus wie ein wütender Dämon, der sich aus der Hölle erhob.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
