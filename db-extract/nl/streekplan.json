                "senses": [
                    {
                        "sense_id": "f0d53a2a-9de2-39fe-a2c1-601cc8fc5041",
                        "entry_id": "82684571-5f62-36ed-8f4a-dedfb65b96d9",
                        "glosses": [
                            "tot de invoering van de nieuwe Wet ruimtelijke ordening in 2008, een document dat in Nederland beschreef wat er met de ruimte in (een deel van) een provincie mocht gebeuren"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "87009bfe-6454-46c7-b11a-0fc7562420de",
                                "sense_id": "f0d53a2a-9de2-39fe-a2c1-601cc8fc5041",
                                "text": "De Raad van State heeft nu bepaald dat een kleine paardenhouderij aan de Munsterjansdijk niet in strijd is met het streekplan van de provincie. Zo lang het maar kleinschalig blijft. De gemeente heeft dat ook vastgelegd in een bestemmingsplan, dat speciaal is gemaakt voor het terrein van de familie Wolfs. Volgens dit bestemmingsplannetje mag de manege niet meer dan zeven uur per week geopend zijn en mag er slechts n ruiterkamp per jaar plaatsvinden. Het aantal paarden is beperkt tot twaalf."
                            },
                            {
                                "example_id": "32d68441-e6a4-4a71-bea6-18d87e0ef7ac",
                                "sense_id": "f0d53a2a-9de2-39fe-a2c1-601cc8fc5041",
                                "text": "Vergeten zijn de bezwaren van de Werkgroep Zorg voor het Kievitsveld van de Vogelbeschermingswacht Noord Veluwe en de Vereniging Milieuzorg Epe, die zich zorgen maakten over de omvangrijke verstening en landschappelijke aantasting in de ‘Groene wig’ die het gebied rond het Kievitsveld in het Streekplan Gelderland vormt."
                            }
                        ]
                    }
