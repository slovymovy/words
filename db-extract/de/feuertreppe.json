                ],
                "senses": [
                    {
                        "sense_id": "88d3fc2b-e67d-3e39-a4f6-e9da9f8339dc",
                        "entry_id": "276dd1e5-eb19-3ff1-a929-7fa13ecf9201",
                        "glosses": [
                            "eine Treppe, die bei einem Brand genutzt werden kann oder soll, um sich von der Gefahrenstelle zu entfernen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdded2dd-24cc-43e7-8cc4-a6cd1c0fd4a6",
                                "sense_id": "88d3fc2b-e67d-3e39-a4f6-e9da9f8339dc",
                                "text": "Hinter der Nottür befindet sich eine Feuertreppe."
                            },
                            {
                                "example_id": "7a84db6e-ea0c-4579-b3ae-fea7cee3921a",
                                "sense_id": "88d3fc2b-e67d-3e39-a4f6-e9da9f8339dc",
                                "text": "Im Ernstfall können die Bewohner das Haus über die Feuertreppe verlassen."
                            },
                            {
                                "example_id": "9c8ab1af-204d-4d85-b75b-4da5b1ac46ab",
                                "sense_id": "88d3fc2b-e67d-3e39-a4f6-e9da9f8339dc",
                                "text": "Als Feuertreppe wird eine Fluchttreppe bezeichnet, die nur im Brandfall benutzt werden darf und nicht für die normale Erschließung eines Gebäudes zur Verfügung steht."
                            },
                            {
                                "example_id": "efeb8855-6026-4777-9ec9-aec00570ac72",
                                "sense_id": "88d3fc2b-e67d-3e39-a4f6-e9da9f8339dc",
                                "text": "„Es war mir egal, ob er nun auf den anderen Lift warten oder die Feuertreppe nehmen wollte, ich lief über den großgeblümten Teppich den langen Flur entlang.“"
                            },
                            {
                                "example_id": "85b68efe-76b8-4f47-bd80-6d391bf9d2ae",
                                "sense_id": "88d3fc2b-e67d-3e39-a4f6-e9da9f8339dc",
                                "text": "„Hätten Sittenwächter die Party gestürmt, alle wären blitzschnell abgehauen, über den Balkon, durch die Fenster, über die Feuertreppe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
