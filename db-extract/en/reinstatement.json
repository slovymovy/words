                        "entry_id": "aff5c5d0-cacf-359d-a9ca-15eb6e862f11",
                        "glosses": [
                            "The act of restoring something to its previous state."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "93a6c112-d017-479a-9308-5a1fc2777d36",
                                "sense_id": "896ac4a5-940d-34dc-943d-7b3cde777f45",
                                "text": "Many people are unhappy with the sacking of the chief constable and demand his immediate reinstatement."
                            },
                            {
                                "example_id": "b440108d-87d4-46e9-afa9-6402d4186095",
                                "sense_id": "896ac4a5-940d-34dc-943d-7b3cde777f45",
                                "text": "Barry removed Pawlisch last July and the former board member has sought reinstatement to his seat, thus far without success."
                            },
                            {
                                "example_id": "e783b153-9b62-4841-b8f2-ca586fa40508",
                                "sense_id": "896ac4a5-940d-34dc-943d-7b3cde777f45",
                                "text": "CBR calculated the estimated cost of reinstatement of the route, based on 2012 prices for the original Borders Railway project, as £644m.\n\"Admittedly, that's about four years out of date now, so it's looking more like a billion pounds,\" says Walton."
                            }
                        ]
                    }
