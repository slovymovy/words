                                "sense_id": "3c64e0e8-359f-3bcb-b506-0746c95ed99e",
                                "text": "Don’t anyhow say sia, this one not my fault hor.",
                                "translation": "Don’t spout nonsense, it wasn’t my fault, alright?",
                                "english": "Don’t spout nonsense, it wasn’t my fault, alright?"
                            },
