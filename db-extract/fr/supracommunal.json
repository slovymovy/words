                        "examples": [
                            {
                                "example_id": "3101affe-b12e-41cb-932f-3393ab85b4e9",
                                "sense_id": "9c95f546-a04c-3905-bed3-e71ba470124b",
                                "text": "Si une Région supprime ses provinces, elle peut, si elle le désire, les remplacer par des collectivités supracommunales."
                            },
                            {
                                "example_id": "eac5b1ac-a860-4fef-b188-3c8a7ca8e754",
                                "sense_id": "9c95f546-a04c-3905-bed3-e71ba470124b",
                                "text": "Dans aucune ville nouvelle cette solution supracommunale n’a été retenue."
                            },
                            {
