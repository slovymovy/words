                        "examples": [
                            {
                                "example_id": "620040a7-6f48-46d0-949b-9a1e504c329f",
                                "sense_id": "0a01d374-e55c-38e7-9ac2-5660e546da73",
                                "text": "Hun werk is het maaien en afvoeren van ongewenste grassen, bramen en boompjes die te hard groeien door de stikstofbemesting uit de lucht. \"Daarnaast laten we het duinreservaat begrazen door landgeiten. Ook hiermee zorgen we voor een open duinlandschap, dat belangrijk is voor veel bedreigde soorten.\""
                            },
                            {
                                "example_id": "a292d9de-0cf7-4c23-a568-38839c916b2c",
                                "sense_id": "0a01d374-e55c-38e7-9ac2-5660e546da73",
                                "text": "Ook boswachter Evert-Jan Woudsma (46), die werkt in het Noordhollands Duinreservaat, moet bekennen dat het vak van boswachter wat geromantiseerd wordt. \"Iedereen denkt bij een boswachter aan het beeld van een man met groene hoed die de hele dag fluitend door het bos loopt.\""
                            }
                        ]
                    }
