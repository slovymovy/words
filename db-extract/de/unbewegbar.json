                                "example_id": "9b034495-7cfa-4132-b47a-55a84359b309",
                                "sense_id": "784e93a5-f701-3ba5-be6c-4756fdaba16d",
                                "text": "„Die Möbel haben sich mit Wasser und Dreck vollgesogen und sind dadurch nahezu unbewegbar geworden.“"
                            },
                            {
                                "example_id": "dac11cb4-041c-4d8a-bea0-a77cf1749ae0",
                                "sense_id": "784e93a5-f701-3ba5-be6c-4756fdaba16d",
                                "text": "„Das Kniegelenk schaut plötzlich deformiert aus, ist aufgrund der Schmerzen unbewegbar und es passiert oft bei Bagadellereignissen.“"
                            },
                            {
                                "example_id": "1824593d-e8a1-4b99-ad4d-936c355391ee",
                                "sense_id": "784e93a5-f701-3ba5-be6c-4756fdaba16d",
                                "text": "„Ein mutiger Rover tastet sich, auf den quer liegenden Stämmen bis zum Boot vor. Tonnenschwer vom Wasserdruck lag es unbewegbar in den Fluten.“"
                            },
                            {
                                "example_id": "b5c42e21-3620-4938-a7e7-a8cccb1c01e7",
                                "sense_id": "784e93a5-f701-3ba5-be6c-4756fdaba16d",
                                "text": "„Die Lagerung und Verwendung bis zu 35 kg Flüssiggas ist bei Veranstaltungen nur für den Betrieb von am Standort fix und unbewegbar aufgestellten Kochgeräten zulässig“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
