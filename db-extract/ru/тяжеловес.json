                                    },
                                    {
                                        "sense_id": "1179382e-9e9f-37ca-863a-84a0d76c8ace",
                                        "entry_id": "ee4d5899-391c-38d6-86dd-edd8a1baa41d",
                                        "glosses": [
                                            "Important or impressive."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fca222b0-02f4-464c-aeb5-f8042e69141d",
                                                "sense_id": "1179382e-9e9f-37ca-863a-84a0d76c8ace",
                                                "text": "The Olympics, the weather and a comparative lack of heavyweight clashes so far this season have been cited as reasons for the drop in viewers."
                                            },
                                            {
                                                "example_id": "0ba3988c-1bcd-4a93-a4c4-3834427b96cd",
                                                "sense_id": "1179382e-9e9f-37ca-863a-84a0d76c8ace",
                                                "text": "In recent years, much has been made of the lack of new heavyweight male star power in mainstream Hollywood. Talented performers may be everywhere, but Movie Stars, capital M, capital S, are something else."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
