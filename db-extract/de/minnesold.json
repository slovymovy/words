                        ],
                        "examples": [
                            {
                                "example_id": "f1777637-1e94-4e37-9762-a3b725e9a84d",
                                "sense_id": "18979ce5-650e-3266-bca4-ae462fdc03ea",
                                "text": "„»Was suchst du in der Stadt«, ruft er einem Freunde zu, der von dem allgemeinen Zug nach der Großstadt angesteckt ist, »mit deiner Armut und Ehrlichkeit? Wenn du nicht unter die Kuppler, Zechbrüder oder Denunzianten gehen kannst, wenn du nicht die Frau eines Freundes verführen oder den Minnesold alter Weiber verdienen, nicht am Kaiserpalast Dunst verkaufen, noch dich in die Claque der Virtuosen verdingen kannst, wovon willst, Armer, du leben?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
