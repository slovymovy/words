                ],
                "senses": [
                    {
                        "sense_id": "efd44a90-25af-384b-a8b4-e107176720ab",
                        "entry_id": "421aa3a5-043a-384c-87a7-7f214b7f3ba6",
                        "glosses": [
                            "Ende des Lebens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5daaf318-1308-47e5-b803-a415cb331c58",
                                "sense_id": "efd44a90-25af-384b-a8b4-e107176720ab",
                                "text": "„Mit Berlin fertig zu werden ist wohl bis zu meinem Lebensende nicht mehr zu schaffen.“"
                            },
                            {
                                "example_id": "01e096bd-ed1f-4d21-a033-e5e5d1ea5b2b",
                                "sense_id": "efd44a90-25af-384b-a8b4-e107176720ab",
                                "text": "„Man griff die reizende Schöne auf, sperrte sie ein, weckte ihr Schuldbewußtsein und veranlaßte sie zu einer Generalbeichte; die Buße sollte bis zu ihrem Lebensende dauern.“"
                            },
                            {
                                "example_id": "de4f5647-50f5-4298-bf07-7863bbc11f45",
                                "sense_id": "efd44a90-25af-384b-a8b4-e107176720ab",
                                "text": "„Ich wäre am liebsten hier geblieben und hätte bis an mein Lebensende Bonbons und Sütterlinhefte verkauft, mich abends mit Marie oben ins Bett gelegt und bei ihr geschlafen, richtig geschlafen bei ihr, so wie die letzten Stunden vor dem Aufstehen, mit ihren Händen unter meinen Achseln.“"
                            },
                            {
                                "example_id": "e2bd5ac4-626f-46d3-9266-b96e02380cd1",
                                "sense_id": "efd44a90-25af-384b-a8b4-e107176720ab",
                                "text": "„Bis zum Lebensende bleibt er Ina Seidel freundschaftlich verbunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce0b5b5e-2ee5-411b-b708-d410afb055f8",
                        "source_entry_id": "421aa3a5-043a-384c-87a7-7f214b7f3ba6",
                        "source_sense_id": "efd44a90-25af-384b-a8b4-e107176720ab",
                        "source_sense_description": "Ende des Lebens",
                        "target_lang_word": "fin de vie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fin de vie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8a9b802-bcac-3307-add3-654af5f106ec",
                                        "entry_id": "d3ec8005-fb01-3135-8c0c-d41536c88dbf",
                                        "glosses": [
                                            "Euphémisation de « proche de la mort »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12a828a5-3df0-4fe6-9ec3-a0a72942fbb7",
                                                "sense_id": "c8a9b802-bcac-3307-add3-654af5f106ec",
                                                "text": "C'est aussi après cet épisode que la gériatre pose « en tête à tête » à la patiente la question de sa perception de sa maladie ou plutôt de son état, en faisant l'hypothèse qu'elle aussi a perçu un signal intérieur de l'entrée en fin de vie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08b1b839-29e9-391c-bf5b-af4c5f208125",
                                        "entry_id": "d3ec8005-fb01-3135-8c0c-d41536c88dbf",
                                        "glosses": [
                                            "Euthanasie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed5a8725-3d5f-44d9-a507-da8a21bad3ac",
                                                "sense_id": "08b1b839-29e9-391c-bf5b-af4c5f208125",
                                                "text": "Le CHU de Reims peut reprendre le protocole de fin de vie de ce patient tétraplégique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50cc656b-1b5c-311d-9a2d-4d09b7eb79d9",
                                        "entry_id": "d3ec8005-fb01-3135-8c0c-d41536c88dbf",
                                        "glosses": [
                                            "Proche de la cessation de fonctionnement ou de l’obsolescence, en parlant d’un objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "087a1a2a-2109-48c0-9089-0cdc3b5fe235",
                                                "sense_id": "50cc656b-1b5c-311d-9a2d-4d09b7eb79d9",
                                                "text": "Afin d’atteindre la neutralité carbone d’ici à 2050 dans le cadre de son Pacte vert, l’UE interdira la commercialisation de véhicules neufs à essence ou diesel à partir de 2035, cent cinquante ans après l’invention du moteur à combustion. Celui-ci ne disparaîtra pas des routes instantanément : en France, sur les 40 millions d’automobiles qui circulent, 99 % fonctionnent encore à l’essence ou au diesel. Il faudra plusieurs décennies pour que le parc soit entièrement électrifié, le temps que les anciens modèles arrivent en fin de vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
