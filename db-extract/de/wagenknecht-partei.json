                "senses": [
                    {
                        "sense_id": "9f352364-e421-3b23-b40a-b241cedd5c8a",
                        "entry_id": "3ab54cc9-ab9a-3d84-93bc-a57ffa27947f",
                        "glosses": [
                            "politische Partei in Deutschland, deren Namensgeberin und Mitgründerin die Politikerin Sahra Wagenknecht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdf642fb-8fbe-4152-b097-4e0a1cd94a6c",
                                "sense_id": "9f352364-e421-3b23-b40a-b241cedd5c8a",
                                "text": "„Mehr als fünf Millionen Euro hat ein Ehepaar aus Mecklenburg-Vorpommern der Wagenknecht-Partei BSW gespendet.“"
                            },
                            {
                                "example_id": "66505dd3-7828-4009-bdfa-37f5f1e7d9a9",
                                "sense_id": "9f352364-e421-3b23-b40a-b241cedd5c8a",
                                "text": "„Am Sonntag trifft sich die Wagenknecht-Partei in Bonn zum Bundesparteitag.“"
                            },
                            {
                                "example_id": "fc34d180-b27a-441f-a4aa-053b93a14773",
                                "sense_id": "9f352364-e421-3b23-b40a-b241cedd5c8a",
                                "text": "„Die Wagenknecht-Partei weitet ihre Strukturen aus: In Nordrhein-Westfalen und Sachsen-Anhalt gibt es nun Landesverbände, weitere sollen bald folgen.“"
                            },
                            {
                                "example_id": "a58d2c46-d88c-4101-9500-2fd24665b89a",
                                "sense_id": "9f352364-e421-3b23-b40a-b241cedd5c8a",
                                "text": "„In den drei Bundesländern hat die CDU keine größeren Berührungsängste, zumal ein paar ehemalige CDUler zu den handverlesenen Parteimitgliedern der Wagenknecht-Partei gehören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
