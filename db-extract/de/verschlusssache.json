                ],
                "senses": [
                    {
                        "sense_id": "4d196283-704b-3c5f-bf1a-787bd9478194",
                        "entry_id": "907eefd2-fee3-317b-9e70-a59271160489",
                        "glosses": [
                            "Information, document, dossier classifié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3580a2ca-5311-465e-a0f6-7f4799c4ecf6",
                                "sense_id": "4d196283-704b-3c5f-bf1a-787bd9478194",
                                "text": "Anfang August hatte die Bundespolizei FBI Trumps Anwesen in Florida durchsucht. Das FBI beschlagnahmte diverse Verschlusssachen, einige mit höchster Geheimhaltungsstufe.",
                                "translation": "Début août, la police fédérale (FBI) avait perquisitionné la propriété de Trump en Floride. Le FBI a saisi divers documents classifiés, dont certains au plus haut niveau de confidentialité."
                            },
                            {
                                "example_id": "630830ed-35fe-4435-84f8-532c57e09485",
                                "sense_id": "4d196283-704b-3c5f-bf1a-787bd9478194",
                                "text": "Verschlusssachen werden durch besondere Sicherheitsmaßnahmen gegen die Kenntnis durch Unbefugte geschützt.",
                                "translation": "Les informations classifiées sont protégées par différentes mesures de sûreté contre l’accès par des personnes non autorisées."
                            }
                        ]
                    }
                ],
