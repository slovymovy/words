                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9402c033-3d7c-4205-b4f5-d11d8a45829e",
                                "sense_id": "3efe174a-5bd4-3225-9ac2-547e8e61c4e9",
                                "text": "Nigdy nie widziałam zmarłej w robronie."
                            },
                            {
                                "example_id": "83602b83-f019-4d2a-b29b-0bdfcc0dffaa",
                                "sense_id": "3efe174a-5bd4-3225-9ac2-547e8e61c4e9",
                                "text": "Nie powinnyście źle mówić o zmarłej, nie wypada."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a389ee0-26a0-41e6-99c9-61042682964e",
                        "source_entry_id": "de84d300-d394-33a9-a90f-05a5bcf3e0e9",
                        "source_sense_id": "3efe174a-5bd4-3225-9ac2-547e8e61c4e9",
                        "target_lang_word": "deceased",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deceased",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d081206-b4cb-3846-9f98-714b73bbbede",
                                        "entry_id": "797554b0-ea97-344a-aff0-1a9d0b315e8f",
                                        "glosses": [
                                            "No longer alive; dead."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0508dbc7-f5da-40bb-bb8d-2bc1c71d87ed",
                                                "sense_id": "0d081206-b4cb-3846-9f98-714b73bbbede",
                                                "text": "1969, Monty Python, Dead Parrot Sketch\nThat parrot is definitely deceased, and when I purchased it not 'alf an hour ago, you assured me that its total lack of movement was due to it bein' tired and shagged out following a prolonged squawk."
                                            },
                                            {
                                                "example_id": "561a329c-7a48-4525-a853-94cd4ac4cfa4",
                                                "sense_id": "0d081206-b4cb-3846-9f98-714b73bbbede",
                                                "text": "Publicity handouts from Dick's long-deceased record label would have us believe that he was born in Cleveland in 1952."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "209ba59d-2db4-378f-bc75-25d46d6883e9",
                                        "entry_id": "797554b0-ea97-344a-aff0-1a9d0b315e8f",
                                        "glosses": [
                                            "Belonging to the dead."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1eff16e7-9fd0-41ac-80ab-c58375bdd390",
                                                "sense_id": "209ba59d-2db4-378f-bc75-25d46d6883e9",
                                                "text": "The executor's commission for winding up the deceased estate was 3.5%."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09526afc-1515-3d4d-b80c-25746e1bf45d",
                                        "entry_id": "797554b0-ea97-344a-aff0-1a9d0b315e8f",
                                        "glosses": [
                                            "One who has died. In property law, the alternate term decedent is generally used. In criminal law, \\\"the deceased\\\" refers to the victim of a homicide."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "545e007e-2ad2-3bc7-b367-37d306189e03",
                                        "entry_id": "797554b0-ea97-344a-aff0-1a9d0b315e8f",
                                        "glosses": [
                                            "Overwhelmed to the point of being figuratively dead."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bdf2849-073f-4808-9db2-3da0470da988",
                                                "sense_id": "545e007e-2ad2-3bc7-b367-37d306189e03",
                                                "text": "You look so good, I'm deceased!"
                                            },
                                            {
                                                "example_id": "0747f392-8092-413f-a2d3-c244c3d6524d",
                                                "sense_id": "545e007e-2ad2-3bc7-b367-37d306189e03",
                                                "text": "I am deceased, my nuts have been busted."
                                            },
                                            {
                                                "example_id": "c9cec876-8e00-49a2-aacb-d4e082e52808",
                                                "sense_id": "545e007e-2ad2-3bc7-b367-37d306189e03",
                                                "text": "\"So that's it? We're not going to talk anymore? I won't see you?\" she asks through tears. \"Oh, you'll see me,\" Deborah replies. \"In court!\" (OUCH.) Deborah walks away. And I am deceased."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "deceased",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ea6f4d5-9c11-3597-973c-dd5a04931e03",
                                        "entry_id": "b683b23d-8bf8-361b-b7ec-df5f6053a285",
                                        "glosses": [
                                            "Synonym of dead (“those who have died”)."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ab08f09-3e63-4092-8de5-e6e2fead8a8b",
                                                "sense_id": "1ea6f4d5-9c11-3597-973c-dd5a04931e03",
                                                "text": "The deceased was interred in his local churchyard."
                                            },
                                            {
                                                "example_id": "8d786a54-0d69-420a-8233-a23122920dca",
                                                "sense_id": "1ea6f4d5-9c11-3597-973c-dd5a04931e03",
                                                "text": "a memorial to the deceased of two World Wars"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9f86f54-fbca-3e66-a127-08191eac413b",
                                        "entry_id": "b683b23d-8bf8-361b-b7ec-df5f6053a285",
                                        "glosses": [
                                            "One who has died. In property law, the alternate term decedent is generally used in US English. In criminal law, “the deceased” refers to the victim of a homicide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a8eb54a-bc30-4242-8109-a5430678f6b8",
                                                "sense_id": "f9f86f54-fbca-3e66-a127-08191eac413b",
                                                "text": "Deceased had already made a will in his favour before her marriage, but—and Mr. Philips wagged an expressive forefinger—the prisoner was not aware of that. What had induced the deceased to make a fresh will, with the old one still extant, he could not say."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f81817f-bb4c-4293-90dd-ec23c1aa8ff0",
                        "source_entry_id": "de84d300-d394-33a9-a90f-05a5bcf3e0e9",
                        "source_sense_id": "3efe174a-5bd4-3225-9ac2-547e8e61c4e9",
                        "target_lang_word": "Verstorbene",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verstorbene",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09e03cf0-a200-3c39-80ae-336f5672cd82",
                                        "entry_id": "4fec7b5e-3870-346d-869e-8a460de64b80",
                                        "glosses": [
                                            "weibliche Person, die nicht mehr am Leben, sondern tot ist"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bc927ef-19f2-4a78-b0a2-e6571912f9c6",
                                                "sense_id": "09e03cf0-a200-3c39-80ae-336f5672cd82",
                                                "text": "„Die Freundschaft war so eng und vertraut, dass die Verstorbene zu Lebzeiten ihre Freundin als ihre Betreuerin bestimmte und sie ihr eine Vollmacht über ihr Bankkonto gab, die auch nach ihrem Tod noch gilt.“"
                                            },
                                            {
                                                "example_id": "4e1d06fe-01f4-4d03-a4e4-87d53b69153b",
                                                "sense_id": "09e03cf0-a200-3c39-80ae-336f5672cd82",
                                                "text": "„Die Verstorbene wurde laut Polizeimeldung im Flüsschen Panke, unweit der Schwanebecker Chaussee, am Radweg Berlin-Usedom gefunden.“"
                                            },
                                            {
                                                "example_id": "a9bf55fd-ca6d-47db-a087-7386a8136bb7",
                                                "sense_id": "09e03cf0-a200-3c39-80ae-336f5672cd82",
                                                "text": "„Die Verstorbene hat Sender füngzig Taler hinterlassen, und das bringt ihn auf eine neue Idee.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
