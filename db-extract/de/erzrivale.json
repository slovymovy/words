                        "target_lang_word": "ennemi juré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ennemi juré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1536009d-0554-33b2-b0a9-84ba34004426",
                                        "entry_id": "7791a279-404f-3a24-9bbc-15dc632afe6a",
                                        "glosses": [
                                            "Pire ennemi, ennemi nourrissant une haine réciproque à l’encontre du sujet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dff4e99-f738-404c-9ff7-2f7172953de1",
                                                "sense_id": "1536009d-0554-33b2-b0a9-84ba34004426",
                                                "text": "Ami du cher garçon que voici, mais ennemi résolu, ennemi juré, ennemi mortel de son mariage."
                                            },
                                            {
                                                "example_id": "ba400a1f-1bab-42a7-964d-669b7ca4d772",
                                                "sense_id": "1536009d-0554-33b2-b0a9-84ba34004426",
                                                "text": "Abraham trottinait au milieu des autres, mais il n’aimait pas se retrouver là, à prêter main-forte à ses ennemis jurés, les Anglais."
                                            },
                                            {
                                                "example_id": "ce1ccc58-1804-4335-8c9b-0cc84ec9465c",
                                                "sense_id": "1536009d-0554-33b2-b0a9-84ba34004426",
                                                "text": "Ces deux-là sont des ennemis jurés. Ils se détestent mutuellement et sont irréconciliables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
