            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bceda4d4-20ab-3bbe-bd3b-009b9a2e31af",
                    "sense_definition": "Simple past and past participle of <w>acquire</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum recently <w>acquired</w> a rare painting from the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Музей недавно <w>приобрёл</w> редкую картину девятнадцатого века.",
                                "zh": "博物馆最近<w>获得</w>了一幅十九世纪的珍稀画作。",
                                "nl": "Het museum heeft onlangs een zeldzaam schilderij uit de negentiende eeuw <w>verworven</w>."
                            }
                        },
                        {
                            "text": "She <w>acquired</w> valuable experience while working at the international firm.",
                            "target_lang_translations": {
                                "ru": "Она <w>приобрела</w> ценный опыт во время работы в международной фирме.",
                                "zh": "她在国际公司工作期间<w>取得</w>了宝贵的经验。",
                                "nl": "Zij heeft waardevolle ervaring <w>opgedaan</w> tijdens haar werk bij het internationale bedrijf."
                            }
                        }
                    ],
                    "synonyms": [
                        "obtained",
                        "gained",
                        "procured",
                        "earned"
                    ],
                    "antonyms": [
                        "lost",
                        "forfeited"
                    ],
                    "common_phrases": [
