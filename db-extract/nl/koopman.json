                        "examples": [
                            {
                                "example_id": "d9acd451-3f75-41d2-b524-73eb15edf134",
                                "sense_id": "ea12b81f-89a2-30bd-8354-c7e1932d33a1",
                                "text": "De oude stad was vol met drukke kooplui die hun waren aanboden op de markt.",
                                "translation": "The old city was full of busy merchants offering their goods at the market.",
                                "english": "The old city was full of busy merchants offering their goods at the market."
                            },
                            {
                                "example_id": "ce98957e-d8d0-4a97-8df7-349220756c94",
                                "sense_id": "ea12b81f-89a2-30bd-8354-c7e1932d33a1",
                                "text": "De koopman reisde naar verre landen om exotische goederen te verhandelen.",
                                "translation": "The trader traveled to distant lands to trade exotic goods.",
                                "english": "The trader traveled to distant lands to trade exotic goods."
                            },
                            {
                                "example_id": "b91dd77f-de54-4707-bae0-432f7bb3d70d",
                                "sense_id": "ea12b81f-89a2-30bd-8354-c7e1932d33a1",
                                "text": "De rijke koopman investeerde in verschillende bedrijven om zijn rijkdom te vergroten.",
                                "translation": "The wealthy merchantman invested in various businesses to increase his wealth.",
                                "english": "The wealthy merchantman invested in various businesses to increase his wealth."
                            }
                        ]
