                "senses": [
                    {
                        "sense_id": "0a8fc90c-10e2-3f95-b9c4-40e5d13d5647",
                        "entry_id": "d571c794-938e-34b6-881a-5b7a975b1872",
                        "glosses": [
                            "eine Form der Kommunikation des Menschen, während der beide Augenbrauen kurzzeitig, oft unbewusst als Grußsignal angehoben werden"
                        ],
                        "tags": [
                            "Verhaltensbiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "b004472d-9621-4351-be38-37378b350f38",
                                "sense_id": "0a8fc90c-10e2-3f95-b9c4-40e5d13d5647",
                                "text": "Es war so laut, dass sie sich nur mit einem Augengruß begrüßen konnten."
                            },
                            {
                                "example_id": "73e04737-25dc-4382-ae35-e24b6c37f3f7",
                                "sense_id": "0a8fc90c-10e2-3f95-b9c4-40e5d13d5647",
                                "text": "„In seiner \"Urbedeutung\" übermittelt der Augengruß die Botschaft: \"Ja zum sozialen Kontakt\".“"
                            },
                            {
                                "example_id": "4f7cca28-06e0-4201-9c91-4864d02f8208",
                                "sense_id": "0a8fc90c-10e2-3f95-b9c4-40e5d13d5647",
                                "text": "„Der Augengruß wird weltweit als Zeichen der positiven Zuwendung verstanden.“"
                            },
                            {
                                "example_id": "15ac179f-ea54-47c3-ad50-ec6110ca0706",
                                "sense_id": "0a8fc90c-10e2-3f95-b9c4-40e5d13d5647",
                                "text": "„Eine Fortführung ist der freundliche Augengruß: Schnelles Anheben der Augenbrauen, verbunden mit einem Lächeln und einem Heben des Kopfes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
