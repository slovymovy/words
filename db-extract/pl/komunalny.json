                    {
                        "translation_id": "277cbcf0-fbc5-4b15-a10b-4dc4f8ea0744",
                        "source_entry_id": "bdf2766e-356e-37ab-a9c4-2a2533235a4a",
                        "source_sense_id": "f90e4246-adce-3390-9d81-301994a573c0",
                        "target_lang_word": "kommunal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kommunal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b8a6f66-80b4-3765-b564-c8be7ac8e281",
                                        "entry_id": "9ae94f56-ff6e-30bc-96c3-aaa698b769b8",
                                        "glosses": [
                                            "die Kommune, die Gemeinde betreffend; zur Gemeinde gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0722297-47e8-4b1f-b240-cf00c910c9a8",
                                                "sense_id": "9b8a6f66-80b4-3765-b564-c8be7ac8e281",
                                                "text": "Die kommunalen Versorger haben von der Bundesregierung \"deutliche\" Nachbesserungen bei der geplanten Novelle der Düngeverordnung gefordert."
                                            },
                                            {
                                                "example_id": "268c4eaf-3435-4451-aa39-3581e048068f",
                                                "sense_id": "9b8a6f66-80b4-3765-b564-c8be7ac8e281",
                                                "text": "„Die Wasserversorgung ist die kommunalste Aufgabe schlechthin“."
                                            },
                                            {
                                                "example_id": "0c2e9817-f94b-4a41-8ae0-3b2b6e80e0e0",
                                                "sense_id": "9b8a6f66-80b4-3765-b564-c8be7ac8e281",
                                                "text": "Im Kita-Tarifstreit sieht der Verhandlungsführer der kommunalen Arbeitgeber, Thomas Böhle, keinen Spielraum für ein höheres Angebot an die Beschäftigten."
                                            },
                                            {
                                                "example_id": "de140e8e-f307-40d4-932b-d1f7d88b6be6",
                                                "sense_id": "9b8a6f66-80b4-3765-b564-c8be7ac8e281",
                                                "text": "Wiener Wohnen ist mit 220.000 Wohnungen die größte kommunale Hausverwaltung Europas."
                                            },
                                            {
                                                "example_id": "b921d447-4f5f-4887-8c72-7948d3a45292",
                                                "sense_id": "9b8a6f66-80b4-3765-b564-c8be7ac8e281",
                                                "text": "Das kommunale Engagement bewirkte, dass die Stadt kurz vor Weihnachten trotz desolater Haushaltslage ihr Vorkaufsrecht wahrnahm."
                                            },
                                            {
                                                "example_id": "f9cf66f9-b07f-4438-92a2-7d1305a21bb3",
                                                "sense_id": "9b8a6f66-80b4-3765-b564-c8be7ac8e281",
                                                "text": "In Deutschland ist das Referendumsrecht insgesamt nur sehr schwach ausgebildet und allenfalls auf der kommunalen Ebene für den politischen Alltag von größerer Bedeutung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00669cd4-d74d-4992-b133-7346124288f2",
                        "source_entry_id": "bdf2766e-356e-37ab-a9c4-2a2533235a4a",
                        "source_sense_id": "f90e4246-adce-3390-9d81-301994a573c0",
                        "target_lang_word": "Kommunal-",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "536e3dda-a1b6-43b2-a17c-be72f5fe93b7",
                        "source_entry_id": "bdf2766e-356e-37ab-a9c4-2a2533235a4a",
                        "source_sense_id": "f90e4246-adce-3390-9d81-301994a573c0",
                        "target_lang_word": "коммунальный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "коммунальный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9067ec9f-216e-34d5-92b2-9ba62d923503",
                                        "entry_id": "1d0feca3-45f4-348d-900a-d508370a71ef",
                                        "glosses": [
                                            "свойственный низшей административно-территориальной единице в некоторых странах (коммуне, общине, муниципалитету) принадлежащий такой единице, либо имеющий к этой единице иное непосредственное отношение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4ecf84d-3d4b-43d0-9cad-28afb37d351a",
                                                "sense_id": "9067ec9f-216e-34d5-92b2-9ba62d923503",
                                                "text": "В Черногории проходят первые парламентские и коммунальные выборы со времени получения республикой независимости 3 июня нынешнего года."
                                            },
                                            {
                                                "example_id": "42fc548a-b899-480d-a7e3-8629926ef5b7",
                                                "sense_id": "9067ec9f-216e-34d5-92b2-9ba62d923503",
                                                "text": "Что делали во время этой стачки префектурные и коммунальные власти для разрешения спора, когда хозяева отказались войти в переговоры с рабочими?"
                                            },
                                            {
                                                "example_id": "4bd145b6-87f6-41fc-aff4-1f63789c350b",
                                                "sense_id": "9067ec9f-216e-34d5-92b2-9ba62d923503",
                                                "text": "Правительство, коммунальная администрация решительно ничего не делают, да и не могут ничего делать, кроме приготовления к войне, к защите себя, к будущим столкновениям."
                                            },
                                            {
                                                "example_id": "ba745f0a-dd8d-436f-ad8c-fa4230cdfb83",
                                                "sense_id": "9067ec9f-216e-34d5-92b2-9ba62d923503",
                                                "text": "Жители Румелии и всей Турции платят различные налоги, одна часть которых идёт государству, а другая взимается местными властями под предлогом коммунальных расходов и идёт на их собственное обогащение и подарки, которые они обязаны делать, чтобы сохранить свои должности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd37a2b6-3c93-3ce9-8f43-b7f8b81ec5a4",
                                        "entry_id": "1d0feca3-45f4-348d-900a-d508370a71ef",
                                        "glosses": [
                                            "принадлежащий местному (городскому, поселковому и т. п.) хозяйству, свойственный, имеющий иное непосредственное отношение к этому хозяйству."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc1926ed-645d-4257-bb34-ed20b9c6e576",
                                                "sense_id": "dd37a2b6-3c93-3ce9-8f43-b7f8b81ec5a4",
                                                "text": "Столичные коммунальные службы готовы к уборке городских дорог в сильные снегопады."
                                            },
                                            {
                                                "example_id": "93fd26d5-f6d8-41ed-8e48-1c350fa9decf",
                                                "sense_id": "dd37a2b6-3c93-3ce9-8f43-b7f8b81ec5a4",
                                                "text": "Она также много читала ― всё, что могла найти в коммунальной библиотеке."
                                            },
                                            {
                                                "example_id": "c24d7400-89d6-47a1-b543-6881b5d5e325",
                                                "sense_id": "dd37a2b6-3c93-3ce9-8f43-b7f8b81ec5a4",
                                                "text": "Работники городского коммунального хозяйства косят заросли травы на озере прямо с поверхности воды."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "220362ac-8a24-3f5a-a05a-bfdab4988687",
                                        "entry_id": "1d0feca3-45f4-348d-900a-d508370a71ef",
                                        "glosses": [
                                            "используемый для нужд (городского, поселкового и т. п.) хозяйства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04a3948d-65b5-4b78-9fb3-dbf80e161eea",
                                                "sense_id": "220362ac-8a24-3f5a-a05a-bfdab4988687",
                                                "text": "Коммунальная машина действительно универсальна, она предназначена для уборки складских помещений, тротуаров, дорожек, скверов и других территорий."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
