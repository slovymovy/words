                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "4a304290-3428-4d21-a2fd-bdb4c3269820",
                                "sense_id": "fe176b9d-df81-3ba8-81e8-c6844a225e02",
                                "text": "De inkoper was verantwoordelijk voor het selecteren van leveranciers en het onderhandelen over prijzen.",
                                "translation": "The buyer was responsible for selecting suppliers and negotiating prices.",
                                "english": "The buyer was responsible for selecting suppliers and negotiating prices."
                            },
                            {
                                "example_id": "96740428-fdea-4f29-a0c9-03107b311e28",
                                "sense_id": "fe176b9d-df81-3ba8-81e8-c6844a225e02",
                                "text": "De rol van de inkoper is essentieel bij het verkrijgen van de juiste materialen voor de productie.",
                                "translation": "The role of the purchaser is essential in obtaining the right materials for production.",
                                "english": "The role of the purchaser is essential in obtaining the right materials for production."
                            },
                            {
                                "example_id": "f865f8b7-2cd9-4ecb-9253-94fc8b322d1d",
                                "sense_id": "fe176b9d-df81-3ba8-81e8-c6844a225e02",
                                "text": "De inkopers van het bedrijf zorgen voor de inkoop van goederen en diensten voor de organisatie.",
                                "translation": "The purchasers in the company handle the procurement of goods and services for the organization.",
                                "english": "The purchasers in the company handle the procurement of goods and services for the organization."
                            }
                        ]
                    }
