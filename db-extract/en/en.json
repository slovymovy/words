                        "form": "ens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2d21558-eb3d-30da-87ec-785cb22cc5ed",
                        "entry_id": "9f883b35-77cd-373a-9457-2e86ae0d8b72",
                        "glosses": [
                            "The name of the Latin-script letter N/n."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1af5a4f6-4f87-4558-b04c-6697cec85e17",
                                "sense_id": "e2d21558-eb3d-30da-87ec-785cb22cc5ed",
                                "text": "The word length, which contains only four sounds l e ng th, is usually spell'd thus, el ee en gee tee aitch."
                            },
                            {
                                "example_id": "3194bb70-2a25-4902-9974-f208a03d5a11",
                                "sense_id": "e2d21558-eb3d-30da-87ec-785cb22cc5ed",
                                "text": "I have drunk en-ee-cee-tee-ay-ar from the ef-ell-oh-doubleyou-ee-ar-ess in his gee-ay-ar-dee-ee-en many a time."
                            }
                        ]
                    },
                    {
                        "sense_id": "1df7e1fa-b93a-3d83-93cf-c4a5cabf1a22",
                        "entry_id": "9f883b35-77cd-373a-9457-2e86ae0d8b72",
                        "glosses": [
                            "A unit of measurement equal to half an em (half the height of the type in use)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a06cde3-a224-49c4-85c3-172df0fb153e",
                                "sense_id": "1df7e1fa-b93a-3d83-93cf-c4a5cabf1a22",
                                "text": "That the price of work, paid for by letters be advanced from fourpence to fourpence halfpenny per thousand, including English and brevier; and, in leaded matter, the ems and ens at the beginnings and ends of the lines not to be reckoned in the width."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b72e7328-f950-4c35-a94a-e07be56db6e2",
                        "source_entry_id": "9f883b35-77cd-373a-9457-2e86ae0d8b72",
                        "source_sense_description": "name of the letter N, n",
                        "target_lang_word": "enne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac25f870-869a-3bce-8c11-8e8ab37cf925",
                                        "entry_id": "7f15012c-6e9f-327b-8825-10a204b35bec",
                                        "glosses": [
                                            "Lettre N, n."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "368e60ec-a535-4705-b765-9b02f4a9891f",
                                                "sense_id": "ac25f870-869a-3bce-8c11-8e8ab37cf925",
                                                "text": "Н̄ est composée d'un enne avec un macron."
                                            },
                                            {
                                                "example_id": "dc757278-9523-4547-a1b7-471c0af53f5a",
                                                "sense_id": "ac25f870-869a-3bce-8c11-8e8ab37cf925",
                                                "text": "On a coutume aujourd'hui de donner le genre masculin au nom des lettres. Un A, un B, un L, un X, etc. Il n'en a pas toujours été ainsi. Certaines lettres, dont le nom commence par une voyelle, étaient des substantifs féminins.\nOn peut dire encore le féminin pour F, L, M, N, R, S, H (prononcer une effe, une elle, une emme, une enne, une erre, une esse, une ache) mais cet usage tombe en désuétude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
