{
    "word_family": [
        "proclamation",
        "proclamateur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fec74ae4-c867-3324-a446-14501fdfa7b8",
                    "sense_definition": "Annoncer solennellement et publiquement, souvent de manière officielle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "declaration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le président a solennellement <w>proclamé</w> l'état d'urgence lors d'une allocution télévisée hier soir."
                        },
                        {
                            "text": "Après plusieurs jours de délibération, le jury va enfin <w>proclamer</w> les résultats du concours."
                        }
                    ],
                    "synonyms": [
                        "déclarer",
                        "promulguer"
                    ],
                    "common_phrases": [
                        "proclamer la république",
                        "proclamer la victoire",
                        "proclamer les résultats"
                    ]
                },
                {
                    "sense_id": "e8e27038-cce4-3da9-9d39-9145ccadf682",
                    "sense_definition": "Déclarer ou affirmer avec insistance, en parlant souvent de soi-même ou de ses titres.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'athlète s'est empressé de se <w>proclamer</w> vainqueur avant même la validation des juges."
                        },
                        {
                            "text": "Sans apporter aucune preuve sérieuse, cet homme se <w>proclame</w> le chef légitime du mouvement."
                        }
                    ],
                    "synonyms": [
                        "prétendre",
                        "revendiquer"
                    ],
                    "common_phrases": [
                        "se proclamer vainqueur",
                        "se proclamer champion",
                        "se proclamer chef"
                    ]
                },
                {
                    "sense_id": "07bfaea0-5886-3ea0-b5da-2cab5d439cbd",
                    "sense_definition": "Divulguer ou manifester haut et fort une vérité, une opinion ou un sentiment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "divulgation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé de <w>proclamer</w> haut et fort ses convictions politiques devant l'assemblée réunie."
                        },
                        {
                            "text": "Le philosophe <w>proclamait</w> une vérité que la société de son époque refusait absolument d'entendre."
                        }
                    ],
                    "synonyms": [
                        "divulguer",
                        "propager"
                    ],
                    "antonyms": [
                        "dissimuler",
                        "taire"
                    ],
                    "common_phrases": [
                        "proclamer la vérité",
                        "proclamer haut et fort"
                    ]
                }
            ]
        }
    ]
}