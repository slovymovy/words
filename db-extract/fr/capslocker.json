                                "example_id": "fae32259-81b4-47d2-a523-447fc94c5613",
                                "sense_id": "48cefe57-0831-3896-8960-a5efc7445df7",
                                "text": "Ca pourrait être pire, ON POURRAIT CAPSLOCKER. Ouch, capslocker moins fort."
                            },
