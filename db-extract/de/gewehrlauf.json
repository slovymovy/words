                "senses": [
                    {
                        "sense_id": "e9ffc5a4-b5a1-3e43-b8b0-035314548ac0",
                        "entry_id": "f350e832-f2b2-33b9-8505-915484253d84",
                        "glosses": [
                            "Lauf eines Gewehrs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47627285-e5c1-477b-a4ae-5a8971abea63",
                                "sense_id": "e9ffc5a4-b5a1-3e43-b8b0-035314548ac0",
                                "text": "„Danach wickelt der als politischer Hardliner bekannte Cruz den Speck um den Gewehrlauf, deckt ihn mit Aluminiumpapier ab und feuert Schusssalven aus zwei Magazinen ab.“"
                            },
                            {
                                "example_id": "0da7680d-7c28-4540-8e30-be9de5b10546",
                                "sense_id": "e9ffc5a4-b5a1-3e43-b8b0-035314548ac0",
                                "text": "„Die Eltern, so seine Diagnose, hätten die Kugel im Gewehrlauf übersehen, zudem habe offenbar die Kindersicherung versagt.“"
                            }
                        ],
