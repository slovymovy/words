                "senses": [
                    {
                        "sense_id": "a0076db6-64e0-3f38-801c-332881dc1882",
                        "entry_id": "50e75343-a47d-365a-9baf-01520b7d6c69",
                        "glosses": [
                            "Ingenieurwissenschaft, die sich mit der Analyse, dem Entwurf, der Konstruktion, dem Bau und der Wartung von Maschinen und mechanischen Systemen befasst"
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "b6f4e983-6186-4a91-986f-e057c7712e72",
                                "sense_id": "a0076db6-64e0-3f38-801c-332881dc1882",
                                "text": "Herr Giesinger hat langjährige Erfahrung im Maschinenbau. Er hat sich auf Verpackungsmaschinen spezialisiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8174e9d6-befd-3c89-b7e1-96a578efd1f9",
                        "entry_id": "50e75343-a47d-365a-9baf-01520b7d6c69",
                        "glosses": [
                            "Maschinenbauindustrie oder Maschinenbaubranche"
                        ],
                        "tags": [
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "b2b7928c-fc46-4fa7-92d0-5aeec78d1017",
                                "sense_id": "8174e9d6-befd-3c89-b7e1-96a578efd1f9",
                                "text": "Der Maschinenbau erlebe 2008 ein weiteres \"Jahr der Rekorde\"."
                            },
                            {
                                "example_id": "096c4bb8-a68d-4c03-b843-c77b6f195047",
                                "sense_id": "8174e9d6-befd-3c89-b7e1-96a578efd1f9",
                                "text": "Eine Million Menschen arbeiteten im Maschinenbau, was ihn zur größten Industrie des Landes mache."
                            },
                            {
                                "example_id": "414008a9-b600-404d-9e04-36f071cd3125",
                                "sense_id": "8174e9d6-befd-3c89-b7e1-96a578efd1f9",
                                "text": "„Wir sind Marktführer in Präzisionsgeräten, Maschinenbau und Feinmechanik.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
