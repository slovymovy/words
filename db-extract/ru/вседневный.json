                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97a47cea-8379-4f07-b4fd-d47a9ec863fb",
                                "sense_id": "854ad4e9-96df-3151-a2f8-7f7b2450c814",
                                "text": "«Она́ его́ гра́бит, та́щит с него́ всё… э́то вседне́вная исто́рия, а я до сих по́р не догада́лся!» — ду́мал он.",
                                "translation": "She’s robbing him, stripping him of everything. It’s the usual story, and I had no inkling! he thought.",
                                "english": "She’s robbing him, stripping him of everything. It’s the usual story, and I had no inkling! he thought."
                            }
                        ]
                    }
