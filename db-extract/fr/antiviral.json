            {
                "entry_id": "238ce69a-5f2e-3e28-b984-ca02bb81dac0",
                "word": "antiviral",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "058d0c3c-bed3-491c-b4e9-7594adf1e377",
