                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46f2893e-f8da-4987-863d-e5b20ae6dce2",
                                "sense_id": "82674cac-1dbf-320e-b2fb-26a54a3233a1",
                                "text": "Certaines ornières avaient été rempierrées avec des gravats de brique et de plâtre et, plutôt que rendre service, elles se révélaient comme des zones traîtresses pour les pneus usés de la Benelli."
                            },
                            {
                                "example_id": "23c4952a-6ff2-4c3d-8ca1-ee805100b05d",
                                "sense_id": "82674cac-1dbf-320e-b2fb-26a54a3233a1",
                                "text": "T’as rempierré ta cour, il n’y a pas bien longtemps, qu’il avait fini par dire."
                            }
                        ]
                    }
