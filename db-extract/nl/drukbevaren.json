                        "examples": [
                            {
                                "example_id": "60880551-dda2-4065-a4bf-e0e00478211e",
                                "sense_id": "d3bca3d9-8112-3a42-a297-62edb81e1777",
                                "text": "Op een aantal drukbevaren routes zoals het Amsterdam Rijnkanaal en het Noordzeekanaal wordt jaarlijks gepeild en worden autowrakken die als zodanig herkenbaar zijn verwijderd. In totaal worden jaarlijks 50 tot 60 autowrakken uit de rijkswateren (kanalen en rivieren) gehaald."
                            },
                            {
                                "example_id": "847b54ea-b3cd-42cf-904f-82f5c6e65deb",
                                "sense_id": "d3bca3d9-8112-3a42-a297-62edb81e1777",
                                "text": "Hoewel het wrak van de Empress of Ireland op slechts 50 meter diepte in een drukbevaren rivier terechtkwam, werd het verhaal grotendeels vergeten. Het uitbreken van de Eerste Wereldoorlog verdrong het nieuws van de krantenpagina's en later kregen de rampen met de Titanic en de Lusitania (een jaar eerder en later) meer aandacht. Nabestaanden praatten bovendien liever niet over de pijnlijke herinneringen."
                            },
                            {
                                "example_id": "910ce1f0-b955-4ce7-b59a-65efed7b476d",
                                "sense_id": "d3bca3d9-8112-3a42-a297-62edb81e1777",
                                "text": "Het vrachtschip ligt niet al te diep op een kruispunt van twee drukbevaren routes. Het scheepvaartverkeer wordt voor het wrak gewaarschuwd door een schip van de Kustwacht. Later worden om het wrak boeien uitgezet."
                            }
                        ]
                    }
