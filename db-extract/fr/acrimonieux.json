                                "target_senses": [
                                    {
                                        "sense_id": "3b094af0-b54c-3dee-88b1-0dcfaea1f1a7",
                                        "entry_id": "a49a6c1f-e1c7-3b12-a530-2399bfac103a",
                                        "glosses": [
                                            "vaak als onaangenaam ervaren smaak, niet behorend tot zout, zuur of zoet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3582a6c7-80c2-4966-9399-a7863480b584",
                                                "sense_id": "3b094af0-b54c-3dee-88b1-0dcfaea1f1a7",
                                                "text": "Dat was een vieze, bittere drank."
                                            },
                                            {
                                                "example_id": "1d45f7ac-9686-4c3d-b2c9-e305731d43f0",
                                                "sense_id": "3b094af0-b54c-3dee-88b1-0dcfaea1f1a7",
                                                "text": "Ik kan me mijn eigen moeder nauwelijks herinneren. Ik bewaar een herinnering aan armen om me heen, armen die me tegen een zachte boezem drukken, die rook naar keukenvuur, schoonmaakmiddel en een of andere vaag bittere geur die ik niet meer kan thuisbrengen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "711153bf-c711-376c-96b8-dcdc291103a2",
                                        "entry_id": "a49a6c1f-e1c7-3b12-a530-2399bfac103a",
                                        "glosses": [
                                            "zwaar te verduren"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e5a5c42-089e-4999-afc0-beb9b02e06c7",
                                                "sense_id": "711153bf-c711-376c-96b8-dcdc291103a2",
                                                "text": "In dat land is er nog steeds bittere armoede."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bf7a068-3cd9-3f72-949a-99065e1fb7a9",
                                        "entry_id": "a49a6c1f-e1c7-3b12-a530-2399bfac103a",
                                        "glosses": [
                                            "van teleurstelling en/of boosheid blijk gevend"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "632de82e-fe46-48ce-b334-151f0e0f4a6e",
                                                "sense_id": "4bf7a068-3cd9-3f72-949a-99065e1fb7a9",
                                                "text": "Hij sprak mij aan met een bittere toon."
                                            },
                                            {
                                                "example_id": "6ce5dc0b-a7f6-43c8-83f3-0d6c8c5834e1",
                                                "sense_id": "4bf7a068-3cd9-3f72-949a-99065e1fb7a9",
                                                "text": "Terlouw besloot niet terug te keren in de Kamer en haalde zijn gram met de publicatie van een bitter dagboek. Na een periode in het buitenland werd hij tussen 1991 en 1996 commissaris van de Koningin in Gelderland. Het einde van zijn loopbaan stond, net als aan het begin, in het teken van het water: in 1995 liet hij wegens dreigende overstromingen het rivierengebied evacueren."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bitter",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "953200eb-0ad0-3926-bf0e-8716e0a93b45",
                                        "entry_id": "1820a483-0c46-34ac-80fc-276822b687ba",
                                        "glosses": [
                                            "boos, verdrietig, teleurgesteld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69084e87-57a7-4d40-a08c-952acac46639",
                                                "sense_id": "953200eb-0ad0-3926-bf0e-8716e0a93b45",
                                                "text": "Op het puntje van haar stoel wachtte ze haar moment af. 'Er samen uitkomen, zei u?' antwoordde Jeroen bitter."
                                            },
                                            {
                                                "example_id": "8579c6a1-063b-4e42-9898-cb726ce1a4f4",
                                                "sense_id": "953200eb-0ad0-3926-bf0e-8716e0a93b45",
                                                "text": "Ik ben bitter in je teleurgesteld."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
