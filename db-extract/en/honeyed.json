                                        "sense_id": "72f0e5c4-948a-3c22-9523-2c2ea1f30241",
                                        "entry_id": "d81819e5-7c30-37b7-8c90-8997bfbc0376",
                                        "glosses": [
                                            "Qui contient du miel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16b2e429-92ff-4a19-bf67-55a61d31c526",
                                                "sense_id": "72f0e5c4-948a-3c22-9523-2c2ea1f30241",
                                                "text": "Il faut arrouser la partie d’eau miellée et d’huile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "688214ee-6f99-3430-a5dc-3820a2924608",
                                        "entry_id": "d81819e5-7c30-37b7-8c90-8997bfbc0376",
                                        "glosses": [
                                            "Qui a la couleur jaune du miel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9df65f3c-1c3e-4b5f-81ef-5cc7099cb21f",
                                                "sense_id": "688214ee-6f99-3430-a5dc-3820a2924608",
                                                "text": "Jacinthe miellée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b113c4a-5ad6-39fa-b9dc-4203d8c3ae22",
                                        "entry_id": "d81819e5-7c30-37b7-8c90-8997bfbc0376",
                                        "glosses": [
                                            "Doux comme le miel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcb97b20-203c-4df7-9926-c723c5c1b20f",
                                                "sense_id": "5b113c4a-5ad6-39fa-b9dc-4203d8c3ae22",
                                                "text": "Tircis eut beau prêcher ; ses paroles miellées S’en étant aux vents envolées…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "296e0bdd-2521-3528-9505-edac6f5f5935",
                                        "entry_id": "d81819e5-7c30-37b7-8c90-8997bfbc0376",
                                        "glosses": [
                                            "Qui a le goût ou l’odeur du miel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "791c78f0-1db3-4bc1-9123-cfb0d69caf3a",
                                                "sense_id": "296e0bdd-2521-3528-9505-edac6f5f5935",
                                                "text": "L’arome miellé qui montait des prés en fleurs, cette senteur forte fouettée par la pluie, le grisait comme un vin."
                                            },
                                            {
                                                "example_id": "9f45fa3e-61b6-4238-9703-40f625fa8fd5",
                                                "sense_id": "296e0bdd-2521-3528-9505-edac6f5f5935",
                                                "text": "Le navire réduisit sa vitesse, le bouillonnement plus clair de l’étrave s’apaisa ; tout à coup, une bouffée d’air tiède et très lente déplissa sur nous une odeur à la fois fauve et miellée, comme une senteur d’oasis diluée dans l’air calciné du désert."
                                            }
                                        ]
                                    }
                                ]
                            },
