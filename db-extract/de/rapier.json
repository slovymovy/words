                                        "entry_id": "5ff8ba2f-b3e9-341e-bbb7-d32df12cdf76",
                                        "glosses": [
                                            "długa, prosta i obosieczna broń biała z koszem osłaniającym dłoń"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c17e476-e667-49a3-a6cf-3b69591e7328",
                                                "sense_id": "9acfcf10-4e4b-3600-bb66-51847121245b",
                                                "text": "Gdy fechtuję rapierem, staram się przyjmować bardziej wyprostowaną pozycję."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
