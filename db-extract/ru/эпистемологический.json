                    },
                    {
                        "translation_id": "4870d44c-e662-4cc1-b10f-36700d6ba08c",
                        "source_entry_id": "42a14c08-57b4-3411-aa50-c6a7583949a2",
                        "source_sense_id": "19adaf44-631d-353c-960b-f109def3f849",
                        "target_lang_word": "epistemologiczny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epistemologiczny",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "fe9e02ff-ec1c-3620-9282-f163ca1f27da",
                                        "entry_id": "acf0c5a4-4e3a-391d-a214-1277e80dce62",
                                        "glosses": [
                                            "związany z epistemologią, dotyczący epistemologii"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bd7efd5-4c87-412c-98b6-9475e79a0d79",
                                                "sense_id": "fe9e02ff-ec1c-3620-9282-f163ca1f27da",
                                                "text": "Pozytywizm jest szczególnie typową postawą nowożytnego okresu. Ale nie tylko on. Nowożytny jest racjonalista Descartes z racji swej metody i apriorysta Kant z racji epistemologicznego nastawienia swej filozofii"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68b11eee-a8a4-40ba-877b-f05049cc54a5",
                        "source_entry_id": "42a14c08-57b4-3411-aa50-c6a7583949a2",
                        "source_sense_id": "19adaf44-631d-353c-960b-f109def3f849",
                        "target_lang_word": "épistémologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épistémologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7604dff-4267-3b57-bdc8-fcc12720e3b1",
                                        "entry_id": "4994f363-1bda-3b46-8da2-3950db0d76ab",
                                        "glosses": [
                                            "Relatif à l’épistémologie en tant qu’histoire des méthodes et des principes des sciences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "018e4a87-5742-44e5-9a13-4f7d96a0272e",
                                                "sense_id": "d7604dff-4267-3b57-bdc8-fcc12720e3b1",
                                                "text": "La science politique est l'une des sciences humaines. A ce titre elle ne saurait échapper aux embarras d'ordre épistémologique, méthodologique, zététique et autres, propres à ces disciplines, ni à leur destin."
                                            },
                                            {
                                                "example_id": "906c25be-22ef-4c95-96f4-901214f6944e",
                                                "sense_id": "d7604dff-4267-3b57-bdc8-fcc12720e3b1",
                                                "text": "La débat entre les tenants de conceptions épistémologiques différentes est souvent stérile, les positions étant campées et n'évoluant que lentement, en fonction de nombreux facteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62871d18-d5de-3fe7-9a6a-cc5c3db71c6e",
                                        "entry_id": "4994f363-1bda-3b46-8da2-3950db0d76ab",
                                        "glosses": [
                                            "Épistémique, relatif à la connaissance d’une chose, d’un concept."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66637e68-5681-428d-8d39-1ad60c63089f",
                                                "sense_id": "62871d18-d5de-3fe7-9a6a-cc5c3db71c6e",
                                                "text": "La philosophie de l'espace et du temps est une branche de la philosophie qui traite des problèmes liés aux caractères épistémologiques et ontologiques de l'espace et du temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
