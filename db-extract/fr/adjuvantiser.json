                "senses": [
                    {
                        "sense_id": "f7f48df9-4b17-34d9-8641-e7e9698888f2",
                        "entry_id": "492e09d3-5e9e-3f7d-adf8-8015338e536f",
                        "glosses": [
                            "Ajouter un adjuvant à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e29c164-73c1-4f83-97c7-31f1c656da63",
                                "sense_id": "f7f48df9-4b17-34d9-8641-e7e9698888f2",
                                "text": "HPV16/18, l'oncogène E6/E7 du virus est suffisamment pourvoyeur de zones antigéniques pour qu'on puisse synthétiser des peptides et les adjuvantiser avec Montanid (...)."
                            },
                            {
                                "example_id": "108b7001-8e47-452a-8ef9-5df2771b526c",
                                "sense_id": "f7f48df9-4b17-34d9-8641-e7e9698888f2",
                                "text": "Quelqu'un a-t-il compris les explications évoquées sur le principe de la responsabilité de conséquences médicales négatives non gérables suite à une vaccination adjuvantisée ou non."
                            },
                            {
                                "example_id": "44c72b1e-812c-440f-b4a0-2ec788cbe632",
                                "sense_id": "f7f48df9-4b17-34d9-8641-e7e9698888f2",
                                "text": "L’immunothérapie des cancers suscite un vif intérêt depuis 2011 avec des investissements massifs de grandes industries pharmaceutiques dans la vaccination par protéines (antigènes de tumeurs) adjuvantisées et l’obtention de Prix Nobel à leur effigie."
                            }
                        ]
                    }
