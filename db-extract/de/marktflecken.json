                "senses": [
                    {
                        "sense_id": "e2daf2a7-e1a2-3f88-a614-94d75b99f3ef",
                        "entry_id": "d529c3a4-70b8-3bd9-a794-dd333e4523aa",
                        "glosses": [
                            "Ort mit Marktrecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5145685a-5ad3-453a-8551-f7013e8e527f",
                                "sense_id": "e2daf2a7-e1a2-3f88-a614-94d75b99f3ef",
                                "text": "„Die Uhr zeigte drei, und es war noch keiner eingeschlafen, als ein Wachtmeister erschien und den Befehl zum Abmarsch in Richtung auf den Marktflecken Ostrowno überbrachte.“"
                            },
                            {
                                "example_id": "c2cb6883-0442-4b7f-b51e-085aaad876c8",
                                "sense_id": "e2daf2a7-e1a2-3f88-a614-94d75b99f3ef",
                                "text": "„Das war der endgültige Übertritt von der oralen zur schriftlichen Kultur in dem Marktflecken bei Staako.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1a4e667-6b33-4fd0-a833-3a7d5bccc69f",
                        "source_entry_id": "d529c3a4-70b8-3bd9-a794-dd333e4523aa",
                        "source_sense_id": "e2daf2a7-e1a2-3f88-a614-94d75b99f3ef",
                        "source_sense_description": "Ort mit Marktrecht",
                        "target_lang_word": "market town",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "market town",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f03897dd-5e3f-3438-b9a8-8f885fe34ac1",
                                        "entry_id": "402b1c52-3afb-3b1c-a9b6-c00bc1611dfd",
                                        "glosses": [
                                            "A town that has a traditional right to hold a regular market."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e0c2341-31e8-4950-a093-8f9de176986f",
                                                "sense_id": "f03897dd-5e3f-3438-b9a8-8f885fe34ac1",
                                                "text": "Chan Sam had already received two receipts, one from the banking institution in Hong Kong to which he had sent his draft, and another from the broker in the market town of Shekki, which served several satellite villages including Chang Gar Bin. A courier had carried the draft from Hong Kong to Shekki."
                                            },
                                            {
                                                "example_id": "a956ed15-d70a-405c-b84a-03c48a2a7ccf",
                                                "sense_id": "f03897dd-5e3f-3438-b9a8-8f885fe34ac1",
                                                "text": "Frank Fisher’s butcher’s shop had been in business, he liked to tell people, for more than 300 years. A while back, a signpainter was commissioned to advertise this fact on an outside wall, in case any strangers should pass through the market town of Dronfield in Derbyshire and feel compelled to stop and inspect a time capsule."
                                            },
                                            {
                                                "example_id": "c6374a1f-595a-4598-b3b2-13d2edc570f4",
                                                "sense_id": "f03897dd-5e3f-3438-b9a8-8f885fe34ac1",
                                                "text": "Over the past two centuries, the railway has become a force of economic and social transformation connecting towns and cities, carrying ideas and ambitions. One place to experience this change was Swindon. With the arrival of Brunel's Great Western Railway, Swindon began a remarkable transformation as what had been a modest market town quickly became a centre of industrial activity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
