                                        "sense_id": "2ad97c51-dd05-37cc-986d-867ea5ad3f34",
                                        "entry_id": "a7bf7f56-91c0-3f8e-9653-08cd55243548",
                                        "glosses": [
                                            "Denkweise, Eigenschaft, Handlung, die Schlechtes/Übles beinhaltet, realisiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e6b96c7-6394-4e28-965b-c71383ff04bf",
                                                "sense_id": "2ad97c51-dd05-37cc-986d-867ea5ad3f34",
                                                "text": "„Dennoch habe die Schlechtigkeit dieser Mönchen derart zugenommen, dass sie alle über das Klostervermögen völlig eigenmächtig verfügt hätten und das Kloster infolgedessen fast zur Einöde geworden sei.“"
                                            },
                                            {
                                                "example_id": "510eba3d-3e89-40b2-b00e-060a4edb5cc9",
                                                "sense_id": "2ad97c51-dd05-37cc-986d-867ea5ad3f34",
                                                "text": "„In seinen Augen gab es kein Arbeitsgebiet, das nicht mit Schlechtigkeit und Trug durchsetzt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
