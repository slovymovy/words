                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfd4bcef-1b45-447c-a92c-38085084ab24",
                                "sense_id": "abf4e039-3c6a-3f96-8810-60fc687a3aeb",
                                "text": "Я тебе брюки выстираю, выглажу ― будут как из магазина."
                            }
                        ]
                    },
                    {
                        "sense_id": "a77fea54-a7da-3edb-b4a2-029a3a56b778",
