                        "glosses": [
                            "Religieuse qui a la direction, dans un monastère de femmes, après la prieuresse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "196eb9ff-c25c-4fa4-a844-957a1c8ef7c2",
                                "sense_id": "b9f4ea3a-140a-3f72-9c47-2560c5d0c516",
                                "text": "L’abbesse, Ermessinde de Cadoëne, demanda aux religieuses, prieuresse, sous-prieuresse, sacristaine, précentrice, sous-maîtresse de chant, infirmière, l’autorisation de poursuivre en justice les débiteurs des arrérages échus."
                            }
                        ]
                    }
