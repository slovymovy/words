                "translations": [
                    {
                        "translation_id": "ed51ba89-6c7d-40d8-871d-0620bf44c92e",
                        "source_entry_id": "c79de01d-3444-3527-8aa1-fc61ed2914a1",
                        "source_sense_id": "5bf5f97d-40ad-3dcf-af92-60228a482e17",
                        "target_lang_word": "fame",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1815acb-30b5-3bb6-a208-168ea17a794f",
                                        "entry_id": "08307e90-5f60-3a7d-838b-3ab63c658975",
                                        "glosses": [
                                            "Something said or reported; gossip, rumour."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fef84f6-4c6e-449b-9c4d-de4243e998d7",
                                                "sense_id": "c1815acb-30b5-3bb6-a208-168ea17a794f",
                                                "text": "There went a fame in Heav'n that he ere long / Intended to create, and therein plant / A generation, whom his choice regard / Should favour […]."
                                            },
                                            {
                                                "example_id": "bddd68f8-d611-4aeb-98a0-1dcc0aee0a56",
                                                "sense_id": "c1815acb-30b5-3bb6-a208-168ea17a794f",
                                                "text": "If the accused could produce a specified number of honest neighbours to swear publicly that the suspicion was unfounded, and if no one else came forward to contradict them convincingly, the charge was dropped: otherwise the common fame was held to be true."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "403bf493-a876-356c-9e5f-423164fa0f30",
                                        "entry_id": "08307e90-5f60-3a7d-838b-3ab63c658975",
                                        "glosses": [
                                            "One's reputation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56e3909a-1195-3098-b4c8-77a45de0ea80",
                                        "entry_id": "08307e90-5f60-3a7d-838b-3ab63c658975",
                                        "glosses": [
                                            "The state of being famous or well-known and spoken of, especially for something positive."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c438d8bd-dda7-443f-811c-c4876ad1fb59",
                                                "sense_id": "56e3909a-1195-3098-b4c8-77a45de0ea80",
                                                "text": "I find thou art no less than fame hath bruited."
                                            },
                                            {
                                                "example_id": "677586a5-1bd1-4fb7-9f8d-86df1d126f70",
                                                "sense_id": "56e3909a-1195-3098-b4c8-77a45de0ea80",
                                                "text": "I was about to say that I had known the Celebrity from the time he wore kilts. But I see I will have to amend that, because he was not a celebrity then, nor, indeed, did he achieve fame until some time after I left New York for the West."
                                            }
                                        ]
                                    }
                                ]
                            },
