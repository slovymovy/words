                "word": "superscript",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5c918bd4-da3e-47b6-a0fc-8d8f858fd9d0",
                        "entry_id": "3310d8c1-4008-3b5d-a2d1-8b0934d44db8",
                        "tags": [
                            "plural"
                        ],
                        "form": "superscripts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "146937a2-8ebe-3400-99e1-05b4f8431c8d",
                        "entry_id": "3310d8c1-4008-3b5d-a2d1-8b0934d44db8",
                        "glosses": [
                            "A type of lettering form that appears as a number, figure, or symbol above the normal line of type, located at the right or left of another symbol or text."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "09042705-0ce0-41d6-afc3-18fd46f60c47",
                                "sense_id": "146937a2-8ebe-3400-99e1-05b4f8431c8d",
                                "text": "In x², the 2 written in superscript means “to the power of two”."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02a2331a-f6ee-492a-bf32-80175c412ba4",
                        "source_entry_id": "3310d8c1-4008-3b5d-a2d1-8b0934d44db8",
                        "source_sense_id": "146937a2-8ebe-3400-99e1-05b4f8431c8d",
