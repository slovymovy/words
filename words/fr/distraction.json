                },
                {
                    "sense_id": "a2563d3e-ca58-30ce-aae6-4961d204ea19",
                    "sense_definition": "Activité agréable qui délasse l'esprit et fait passer le temps en amusant.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "loisir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une dure journée de travail, il cherche une <w>distraction</w> pour se détendre.",
                            "target_lang_translations": {
                                "en": "After a hard day at work, he is looking for a <w>diversion</w> to help him relax.",
                                "ru": "После тяжёлого рабочего дня он ищет <w>развлечение</w>, чтобы расслабиться.",
                                "de": "Nach einem harten Arbeitstag sucht er eine <w>Ablenkung</w>, um sich zu entspannen.",
                                "es": "Tras una dura jornada de trabajo, busca una <w>distracción</w> para relajarse.",
                                "zh": "忙碌了一天之后，他想找些<w>消遣</w>来放松一下。"
                            }
                        },
                        {
                            "text": "La lecture de romans policiers reste sa principale <w>distraction</w> pendant les vacances.",
                            "target_lang_translations": {
                                "en": "Reading detective novels remains his main <w>pastime</w> during the holidays.",
                                "ru": "Чтение детективов по-прежнему остаётся его главным <w>увлечением</w> во время отпуска.",
                                "de": "Das Lesen von Kriminalromanen bleibt in den Ferien seine wichtigste <w>Zerstreuung</w>.",
                                "es": "La lectura de novelas policiacas sigue siendo su principal <w>pasatiempo</w> durante las vacaciones.",
                                "zh": "假期里，阅读侦探小说仍是他最主要的<w>消遣</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amusement",
                        "divertissement",
                        "passe-temps"
                    ],
                    "antonyms": [
                        "ennui"
                    ],
                    "common_phrases": [
                        "chercher une distraction",
                        "trouver une distraction"
                    ],
                    "target_lang_definitions": {
                        "en": "An enjoyable activity that relaxes the mind and makes time pass pleasantly.",
                        "ru": "Приятное занятие, которое отвлекает и расслабляет, помогая приятно проводить время.",
                        "de": "Angenehme Tätigkeit, die den Geist entspannt und die Zeit unterhaltsam vergehen lässt.",
                        "es": "Actividad agradable que relaja la mente y hace pasar el tiempo de forma amena.",
                        "zh": "令人愉快的活动，能放松精神，让时间在轻松中过去。"
                    },
