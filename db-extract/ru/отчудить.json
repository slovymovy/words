                                "target_senses": [
                                    {
                                        "sense_id": "9a90d7cc-c103-3cdc-ab55-c2b7c4390bf7",
                                        "entry_id": "59769a41-49f6-3eeb-8ae6-33544f7b465f",
                                        "glosses": [
                                            "Adjuger au fisc pour cause de crime ou de contravention aux lois, aux ordonnances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dff9bbe-1305-4843-b9c1-cef5f184463b",
                                                "sense_id": "9a90d7cc-c103-3cdc-ab55-c2b7c4390bf7",
                                                "text": "Le sieur Tassin de Montcourt ayant péri révolutionnairement, ses biens, et notamment les deux septièmes qui lui appartenaient dans la terre de Saint-Escobille, furent confisqués au profit de la nation."
                                            },
                                            {
                                                "example_id": "702be2f8-e756-4416-9a5d-ecbcab768e09",
                                                "sense_id": "9a90d7cc-c103-3cdc-ab55-c2b7c4390bf7",
                                                "text": "Les proscrits avaient le droit d'emporter leurs biens meubles. Mais leurs biens de mainmorte (immeubles, champs, vignobles, caves greniers) furent décrétés propriété royale et confisqués."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d103b3f6-22eb-307a-bd58-3290de5fca2b",
                                        "entry_id": "59769a41-49f6-3eeb-8ae6-33544f7b465f",
                                        "glosses": [
                                            "Saisir des biens à un particulier, pour les adjuger à un autre."
                                        ],
                                        "tags": [
                                            "Jurisprudence commerciale"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9cebbcb-5612-3ac0-9842-164121932a6b",
                                        "entry_id": "59769a41-49f6-3eeb-8ae6-33544f7b465f",
                                        "glosses": [
                                            "Saisir, par acte d'autorité, ce qui appartient à autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35d9f8c9-552f-4e10-8280-aa8882cb57c5",
                                                "sense_id": "d9cebbcb-5612-3ac0-9842-164121932a6b",
                                                "text": "Les gendarmes étaient venus à pied, par sept kilomètres de vieux chemins. En admettant qu’ils confisquassent le filet séance tenante, il leur fallait réveiller le garde-champêtre du plus proche village où tout dormait consciencieusement."
                                            },
                                            {
                                                "example_id": "14dbcc70-1eae-42a6-89aa-310a5241afc5",
                                                "sense_id": "d9cebbcb-5612-3ac0-9842-164121932a6b",
                                                "text": "Mais, pas un instant, Virginie n'avait tenté de saisir le flingue que Coste avait confisqué dans son baisenville."
                                            },
                                            {
                                                "example_id": "9b59a9da-2cb2-442e-b72a-4ced8559ffc6",
                                                "sense_id": "d9cebbcb-5612-3ac0-9842-164121932a6b",
                                                "text": "Peut-être je voulais mettre la main, comme dans les films, sur nos passeports, que bien sûr, les fliquesses avaient confisqués, et avec, nos identités. Pas si simple, en fait, de leur échapper. — (Laure Ly, Demain matin, Paris : Éditions Balland, 2000)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "440c3339-949e-3815-ace7-07b1d60867d1",
                                        "entry_id": "59769a41-49f6-3eeb-8ae6-33544f7b465f",
                                        "glosses": [
                                            "Accaparer quelqu’un, se rendre maître de sa personne, au point de lui ôter sa liberté."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d265a731-d671-4407-ab8c-ec53e64755b6",
                                                "sense_id": "440c3339-949e-3815-ace7-07b1d60867d1",
                                                "text": "Ce vieillard ne s’appartient plus, sa gouvernante l’a confisqué."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd122613-77a4-4c2f-82b4-f91b4450aa9d",
                        "source_entry_id": "5ab3d1b8-293f-3619-a845-6aa00127d0b9",
                        "source_sense_id": "52f80287-4f60-3304-bd59-1cfbfc082e42",
                        "target_lang_word": "exproprier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exproprier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e8515da-b05e-30fe-9e14-13d98c653074",
                                        "entry_id": "3ff9957b-5561-374d-9715-6dc597453557",
                                        "glosses": [
                                            "Priver (quelqu’un) d’une propriété immobilière, pour cause d’utilité publique et moyennant une indemnité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a323759-127f-460e-9136-276b531f7a51",
                                                "sense_id": "6e8515da-b05e-30fe-9e14-13d98c653074",
                                                "text": "Quand ils ne peuvent s’entendre, l’affaire est portée devant un jury qui se prononce souverainement sur l’offre de la Ville et la demande du propriétaire ou du locataire exproprié."
                                            },
                                            {
                                                "example_id": "3836ebc6-31e8-4ce6-bb15-c0be907395ac",
                                                "sense_id": "6e8515da-b05e-30fe-9e14-13d98c653074",
                                                "text": "« Le président tanzanien peut exproprier n’importe qui, toute terre lui appartenant », dénonce Thomas Bart."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
