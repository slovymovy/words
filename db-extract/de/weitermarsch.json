                        "examples": [
                            {
                                "example_id": "9140771a-0a73-4cb1-8b69-cfc353f65503",
                                "sense_id": "e6881e4f-f688-3622-894c-b3e0cbda4fd8",
                                "text": "„Beim Weitermarsch traf die Batterie noch mehrere Soldaten, die Gefangene zurückführten.“"
                            },
                            {
                                "example_id": "c8e73898-5de0-40b8-a6d2-a786873c9e58",
                                "sense_id": "e6881e4f-f688-3622-894c-b3e0cbda4fd8",
                                "text": "„Da den Etappenstädten das Recht zustand, die ihnen zugewiesenen Truppen in ihre Dörfer zu verlegen, so mußten in Berücksichtigung der unberechneten Rück- und Weitermärsche die Etappenmärsche in der Regel nur kurz sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
