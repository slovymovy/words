                "entry_id": "d375f095-ad3e-3c27-abf4-8b9782b3ab93",
                "word": "giantess",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "56d8b743-cc1c-44d8-9427-83ce0bedf5fb",
                        "entry_id": "d375f095-ad3e-3c27-abf4-8b9782b3ab93",
                        "tags": [
                            "plural"
                        ],
                        "form": "giantesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ec92e51-fc10-34ae-9ff9-4ca504ab2d3f",
                        "entry_id": "d375f095-ad3e-3c27-abf4-8b9782b3ab93",
                        "glosses": [
                            "A female giant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b60a9df-63db-4e27-b1db-8bf2c6c319f8",
                                "sense_id": "2ec92e51-fc10-34ae-9ff9-4ca504ab2d3f",
                                "text": "He spide far off a mighty Giauntesse / Fast flying, on a Courser dapled gray […]"
                            },
                            {
                                "example_id": "02e09ef8-0eb1-4842-8d46-70ce53bd2ccb",
                                "sense_id": "2ec92e51-fc10-34ae-9ff9-4ca504ab2d3f",
                                "text": "In the corner lay against the wall a stringed instrument not unlike a dulcimer, which, as people believe, the Giantesses used to play on."
                            },
                            {
                                "example_id": "8e770757-fe19-482d-9f39-54674b27c52d",
                                "sense_id": "2ec92e51-fc10-34ae-9ff9-4ca504ab2d3f",
                                "text": "The giantess picked him up and gave him such a squeeze that he felt he was going to choke."
                            },
                            {
                                "example_id": "b273b3d0-70fd-482c-8e44-1635d5027528",
                                "sense_id": "2ec92e51-fc10-34ae-9ff9-4ca504ab2d3f",
                                "text": "The giantesses lift arms like the trunks of sycamores, each finger tipped with an amaranthine talon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fcec430-8f21-4b84-acaf-4f236488c0f9",
                        "source_entry_id": "d375f095-ad3e-3c27-abf4-8b9782b3ab93",
                        "source_sense_id": "2ec92e51-fc10-34ae-9ff9-4ca504ab2d3f",
                        "source_sense_description": "female giant",
                        "target_lang_word": "géante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "géante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "377b600f-9abb-3d9c-9e4c-ce1641972a12",
                                        "entry_id": "34565cdc-ad6a-3312-b674-dbf3f2b6aee5",
                                        "glosses": [
                                            "Géant femelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "508b0096-777b-4a5b-a998-3f8a7979aef1",
                                                "sense_id": "377b600f-9abb-3d9c-9e4c-ce1641972a12",
                                                "text": "Du temps que la Nature en sa verve puissante\nConcevait chaque jour des enfants monstrueux,\nJ’eusse aimé vivre auprès d’une jeune géante,\nComme aux pieds d’une reine un chat voluptueux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "géante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8656049a-39eb-3cb8-8fc5-92833370dd43",
                                        "entry_id": "02377292-aed2-3801-9071-21eddc94b859",
                                        "glosses": [
                                            "Étoile de grande taille et souvent massive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10e3168d-3527-4750-b285-c266344f31d0",
                                                "sense_id": "8656049a-39eb-3cb8-8fc5-92833370dd43",
                                                "text": "Le Soleil se transformera en une géante rouge qui englobera successivement les orbites de Mercure, de Vénus et de la Terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f57ddb51-5339-3fba-afa5-d358d4740ef0",
                                        "entry_id": "02377292-aed2-3801-9071-21eddc94b859",
                                        "glosses": [
                                            "Planète massive avec une atmosphère épaisse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "géante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ab2043b-89fa-35b3-8cf3-482bd3b9d7c2",
                                        "entry_id": "6be83278-5d61-3f38-ae93-beb5013b0706",
                                        "glosses": [
                                            "Féminin singulier de géant."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7af270bd-54fe-4831-8a07-74514cd72f54",
                                                "sense_id": "7ab2043b-89fa-35b3-8cf3-482bd3b9d7c2",
                                                "text": "À l’aide du jus très noir de la noix géante appelée huito, une main facétieuse avait écrit un mot, un seul : Welcome !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
