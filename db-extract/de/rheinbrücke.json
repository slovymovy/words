                ],
                "senses": [
                    {
                        "sense_id": "8be06b0e-bbb2-30a4-a323-f9afaa9bc95f",
                        "entry_id": "885b80ee-fb0b-3de6-b91c-68cefa4c8b2c",
                        "glosses": [
                            "eine Brücke über den Fluss Rhein"
                        ],
                        "tags": [
                            "Verkehrsinfrastruktur"
                        ],
                        "examples": [
                            {
                                "example_id": "9577e9df-7295-4b40-ac91-29014f712669",
                                "sense_id": "8be06b0e-bbb2-30a4-a323-f9afaa9bc95f",
                                "text": "Koblenz hat mehrere Rheinbrücken."
                            },
                            {
                                "example_id": "a6bf6572-8968-4ec1-add6-6f0c23280765",
                                "sense_id": "8be06b0e-bbb2-30a4-a323-f9afaa9bc95f",
                                "text": "„Von der neuen Rheinbrücke war schon wieder ein Teilstück eingestürzt, und sechs Leute waren draufgegangen.“"
                            },
                            {
                                "example_id": "acab2a78-8682-4bfc-b890-eb95d55f91c1",
                                "sense_id": "8be06b0e-bbb2-30a4-a323-f9afaa9bc95f",
                                "text": "„Als er vor 1700 Jahren den Kaiser Konstantin bat, Juden in den Rat aufnehmen zu dürfen, um gemeinsam eine Reparatur einer Rheinbrücke ausführen zu können, legte der Stadtrat von Köln den Grundstein zum Haus der jiddischen Sprache.“"
                            },
                            {
                                "example_id": "863e4dce-6a18-4201-a930-a6f1d9778048",
                                "sense_id": "8be06b0e-bbb2-30a4-a323-f9afaa9bc95f",
                                "text": "„Wir passierten eine Rheinbrücke, und der breite Strom unter uns glitzerte und funkelte in der Sonne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
