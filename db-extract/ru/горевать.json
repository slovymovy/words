                ],
                "senses": [
                    {
                        "sense_id": "b010ca6e-dd32-360c-bea7-cc7620c76a15",
                        "entry_id": "6c9fcc5c-553a-3999-b6ce-e8cca19cd30d",
                        "glosses": [
                            "испытывать горе, тяжело переживать, страдать морально"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6da11fd-d0d6-4d7a-88bc-c69288310189",
                                "sense_id": "b010ca6e-dd32-360c-bea7-cc7620c76a15",
                                "text": "Варвара Петровна осталась вдовой и облеклась в полный траур. Правда, не могла она горевать очень много, ибо в последние четыре года жила с мужем в совершенной разлуке, по несходству характеров, и производила ему пенсион."
                            },
                            {
                                "example_id": "dc17e508-dbf3-496c-b646-0d98607ec89c",
                                "sense_id": "b010ca6e-dd32-360c-bea7-cc7620c76a15",
                                "text": "Сидит старичок, горюет, а тут, глядь, Лиса по реке ползёт, — так и ползёт, точно кошка."
                            },
                            {
                                "example_id": "ee347240-553e-42d0-8776-24286494468a",
                                "sense_id": "b010ca6e-dd32-360c-bea7-cc7620c76a15",
                                "text": "Не горюй, сиротка…"
                            },
                            {
                                "example_id": "6a3ffc3d-3aab-4616-b1c2-0f1433b22749",
                                "sense_id": "b010ca6e-dd32-360c-bea7-cc7620c76a15",
                                "text": "«Оставь, гусар… ох! сердцу больно. // Ты, знать, не горевал. // Увы! одной слезы довольно, // Чтоб отравить бокал!…»"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d18de1b-4718-4b30-8508-0c963243574c",
                        "source_entry_id": "6c9fcc5c-553a-3999-b6ce-e8cca19cd30d",
                        "source_sense_id": "b010ca6e-dd32-360c-bea7-cc7620c76a15",
                        "target_lang_word": "grieve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grieve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21ae99bc-cbe5-3924-a8e6-b53e99794ac1",
                                        "entry_id": "43497215-0d0a-39ee-9c25-2303d863e9cf",
                                        "glosses": [
                                            "To cause sorrow or distress to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebe7af12-ac17-40a6-aec7-2eb8f400ff5e",
                                                "sense_id": "21ae99bc-cbe5-3924-a8e6-b53e99794ac1",
                                                "text": "Thy maidens griev'd themselves at my concern."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4b52ec6-1c90-3d11-af58-3507acf335df",
                                        "entry_id": "43497215-0d0a-39ee-9c25-2303d863e9cf",
                                        "glosses": [
                                            "To feel very sad about; to mourn; to sorrow for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad2d1b55-8b84-40f9-9a97-419717345173",
                                                "sense_id": "d4b52ec6-1c90-3d11-af58-3507acf335df",
                                                "text": "to grieve one's fate"
                                            }
                                        ]
                                    },
                                    {
