{
    "word_family": [
        "achter",
        "achteren",
        "achterkant",
        "achterop",
        "achteruit"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3b7f042a-4d3a-304d-8311-4b73010ad9b5",
                    "sense_definition": "op een van de laatste plaatsen in een rij of op een verre plek",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "positie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen moesten <w>achteraan</w> in de klas gaan zitten.",
                            "target_lang_translations": {
                                "en": "The children had to sit <w>at the back</w> of the classroom.",
                                "ru": "Детям пришлось сесть <w>сзади</w> в классе."
                            }
                        },
                        {
                            "text": "Helemaal <w>achteraan</w> in de tuin staat een oude eik.",
                            "target_lang_translations": {
                                "en": "All the way <w>at the back</w> of the garden stands an old oak tree.",
                                "ru": "В самом <w>конце</w> сада растет старый дуб."
                            }
                        }
                    ],
                    "synonyms": [
                        "achterin"
                    ],
                    "antonyms": [
                        "vooraan"
                    ],
                    "common_phrases": [
                        "helemaal achteraan",
                        "achteraan zitten",
                        "achteraan sluiten"
                    ],
                    "target_lang_definitions": {
                        "en": "at the back or in one of the last positions in a row or at a distant spot",
                        "ru": "на одном из последних мест в ряду или в отдаленном месте"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at the back",
                                "target_lang_sense_clarification": "position in a space or row"
                            },
                            {
                                "target_lang_word": "in the back",
                                "target_lang_sense_clarification": "location within a room or area"
                            },
                            {
                                "target_lang_word": "at the rear",
                                "target_lang_sense_clarification": "formal position"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сзади",
                                "target_lang_sense_clarification": "в задней части пространства"
                            },
                            {
                                "target_lang_word": "в конце",
                                "target_lang_sense_clarification": "в конце ряда или помещения"
                            },
                            {
                                "target_lang_word": "позади",
                                "target_lang_sense_clarification": "на заднем плане"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6322322-cc18-33b3-83ce-5a41d14588ca",
                    "sense_definition": "onmiddellijk volgend op iets anders in tijd of volgorde",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "volgorde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na zijn eerste vraag kwam de tweede er direct <w>achteraan</w>.",
                            "target_lang_translations": {
                                "en": "After his first question, the second one followed immediately <w>after</w>.",
                                "ru": "После его первого вопроса сразу <w>вслед</w> последовал второй."
                            }
                        },
                        {
                            "text": "Hij rende de dief snel <w>achteraan</w> om hem te vangen.",
                            "target_lang_translations": {
                                "en": "He quickly ran <w>after</w> the thief to catch him.",
                                "ru": "Он быстро побежал <w>вдогонку</w> за вором, чтобы поймать его."
                            }
                        }
                    ],
                    "synonyms": [
                        "erachteraan"
                    ],
                    "common_phrases": [
                        "direct achteraan",
                        "er achteraan gaan"
                    ],
                    "target_lang_definitions": {
                        "en": "immediately following something else in time or sequence",
                        "ru": "непосредственно следующий за чем-то другим во времени или последовательности"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "after",
                                "target_lang_sense_clarification": "following in time or sequence"
                            },
                            {
                                "target_lang_word": "behind",
                                "target_lang_sense_clarification": "following someone in motion"
                            },
                            {
                                "target_lang_word": "afterwards",
                                "target_lang_sense_clarification": "subsequently"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вслед",
                                "target_lang_sense_clarification": "сразу после кого-то или чего-то"
                            },
                            {
                                "target_lang_word": "вдогонку",
                                "target_lang_sense_clarification": "преследуя или следуя за кем-то"
                            },
                            {
                                "target_lang_word": "следом",
                                "target_lang_sense_clarification": "сразу после в последовательности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "c2f7026b-e616-3214-bb6f-07c4bd2392e1",
                    "sense_definition": "aan het einde van een specifieke rij of reeks",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "positie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij stond helemaal <w>achteraan</w> de rij te wachten op een kaartje.",
                            "target_lang_translations": {
                                "en": "He was waiting for a ticket all the way <w>at the back of</w> the line.",
                                "ru": "Он стоял в самом <w>конце</w> очереди в ожидании билета."
                            }
                        },
                        {
                            "text": "De auto die <w>achteraan</w> de file stond werd aangereden.",
                            "target_lang_translations": {
                                "en": "The car <w>at the end of</w> the traffic jam was hit.",
                                "ru": "В машину, которая стояла в <w>хвосте</w> пробки, врезались."
                            }
                        }
                    ],
                    "synonyms": [
                        "achter"
                    ],
                    "antonyms": [
                        "vooraan"
                    ],
                    "common_phrases": [
                        "achteraan de rij",
                        "achteraan de groep"
                    ],
                    "target_lang_definitions": {
                        "en": "at the end of a specific row or series",
                        "ru": "в конце определенного ряда или серии"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at the back of",
                                "target_lang_sense_clarification": "position relative to a line"
                            },
                            {
                                "target_lang_word": "at the end of",
                                "target_lang_sense_clarification": "final position in a sequence"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "в самом конце",
                                "target_lang_sense_clarification": "последняя позиция в очереди или ряду"
                            },
                            {
                                "target_lang_word": "в хвосте",
                                "target_lang_sense_clarification": "в конце движущейся колонны или очереди"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cec4abf-0aee-3005-a678-d2fdc909dd8d",
                    "sense_definition": "bevestigd aan of gesitueerd bij de achterkant van een object",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "positie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De garage bevindt zich <w>achteraan</w> het huis bij de tuin.",
                            "target_lang_translations": {
                                "en": "The garage is located <w>at the back of</w> the house near the garden.",
                                "ru": "Гараж находится <w>позади</w> дома рядом с садом."
                            }
                        },
                        {
                            "text": "Er zit een kleine sticker <w>achteraan</w> de laptop geplakt.",
                            "target_lang_translations": {
                                "en": "There is a small sticker stuck <w>on the back of</w> the laptop.",
                                "ru": "На <w>задней стороне</w> ноутбука наклеен маленький стикер."
                            }
                        }
                    ],
                    "synonyms": [
                        "achterop"
                    ],
                    "antonyms": [
                        "vooraan"
                    ],
                    "common_phrases": [
                        "achteraan het huis",
                        "achteraan de auto"
                    ],
                    "target_lang_definitions": {
                        "en": "attached to or situated at the back of an object",
                        "ru": "прикрепленный к задней части объекта или расположенный у нее"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at the back of",
                                "target_lang_sense_clarification": "location on an object"
                            },
                            {
                                "target_lang_word": "on the back of",
                                "target_lang_sense_clarification": "attached to the rear surface"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сзади",
                                "target_lang_sense_clarification": "на задней стороне объекта"
                            },
                            {
                                "target_lang_word": "позади",
                                "target_lang_sense_clarification": "за объектом"
                            },
                            {
                                "target_lang_word": "на задней части",
                                "target_lang_sense_clarification": "расположение на поверхности сзади"
                            }
                        ]
                    }
                }
            ]
        }
    ]
