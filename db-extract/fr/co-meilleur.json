                        "examples": [
                            {
                                "example_id": "abada6dc-2a79-44ec-976f-c84820d356ae",
                                "sense_id": "31f34c78-d1e6-30f3-8e77-8bf26e2479af",
                                "text": "Le solide Depoortère (1,93 m, 87 kg) a même terminé co-meilleur marqueur de cette édition, avec cinq essais."
                            },
                            {
                                "example_id": "f2de8a5f-2776-4f91-ae01-a9af1d130b02",
                                "sense_id": "31f34c78-d1e6-30f3-8e77-8bf26e2479af",
                                "text": "Parmi les pires défenses la saison dernière, la ligne arrière stéphanoise est tout simplement la co-meilleure défense de Ligue 2 après onze journées avec seulement six buts encaissés, tout comme le Stade Lavallois que les Verts viennent de battre (0-1)."
                            },
                            {
                                "example_id": "8fedc1b3-4ac0-4fde-9fc8-c38018f8e391",
                                "sense_id": "31f34c78-d1e6-30f3-8e77-8bf26e2479af",
                                "text": "Oui, Clarisse Mairot, Lucie Granier (co-meilleures marqueuses bisontines, avec 6 buts) et leurs copines sont passées tout près d'une formidable \"remontada\"…"
                            }
                        ]
                    }
