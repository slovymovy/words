                                "de": "Kannst du mir bitte noch ein Glas kühles Wasser <w>nachschenken</w>?",
                                "es": "¿Me <w>servirías</w> otro vaso de agua fresca, por favor?",
                                "zh": "请<w>再给</w>我一杯凉水，好吗？"
                            }
                        },
                        {
                            "text": "Le professeur a accepté de lui <w>redonner</w> une chance pour son contrôle.",
                            "target_lang_translations": {
                                "en": "The teacher agreed to <w>give</w> them another chance on their test.",
                                "ru": "Учитель согласился <w>дать</w> ему ещё один шанс на контрольной работе.",
                                "de": "Der Lehrer hat zugestimmt, ihm für seine Klausur noch eine Chance zu <w>geben</w>.",
                                "es": "El profesor accedió a que le <w>diera</w> otra oportunidad en su examen.",
                                "zh": "老师同意<w>再给</w>他一次考试的机会。"
                            }
