                    "sense_id": "6e8c8023-a03c-3a0c-9a32-f2cb7bc36ccf",
                    "sense_definition": "Een installatie of apparaat dat bedoeld is om een ruimte, zoals een huis of kamer, warm te maken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij hebben 's winters de <w>verwarming</w> erg hoog staan.",
                            "target_lang_translations": {
                                "en": "They have the <w>heating</w> on very high in winter.",
                                "ru": "Зимой у них очень сильно включено <w>отопление</w>.",
                                "pl": "Zimą mają bardzo mocno odkręcone <w>ogrzewanie</w>.",
                                "de": "Sie haben im Winter die <w>Heizung</w> sehr hoch eingestellt.",
                                "fr": "En hiver, ils mettent le <w>chauffage</w> très fort.",
                                "it": "D'inverno tengono il <w>riscaldamento</w> molto alto.",
                                "cs": "V zimě mají <w>topení</w> puštěné hodně naplno.",
                                "tr": "Kışın <w>kaloriferi</w> çok yüksek dereceye ayarlıyorlar.",
                                "es": "En invierno tienen la <w>calefacción</w> muy alta."
                            }
                        },
                        {
                            "text": "Kun je de <w>verwarming</w> aanzetten, want het is koud hier?",
                            "target_lang_translations": {
                                "en": "Can you turn on the <w>heating</w>, because it is cold here?",
                                "ru": "Ты можешь включить <w>отопление</w>, так как здесь холодно?",
                                "pl": "Czy możesz włączyć <w>ogrzewanie</w>, bo jest tu zimno?",
                                "de": "Kannst du die <w>Heizung</w> anmachen, weil es hier kalt ist?",
                                "fr": "Peux-tu allumer le <w>chauffage</w>, car il fait froid ici ?",
                                "it": "Puoi accendere il <w>riscaldamento</w>, perché fa freddo qui?",
                                "cs": "Můžeš zapnout <w>topení</w>? Je tu totiž zima.",
                                "tr": "Burası soğuk olduğu için <w>kaloriferi</w> açabilir misin?",
                                "es": "¿Puedes encender la <w>calefacción</w>, que hace frío aquí?"
                            }
                        }
                    ],
