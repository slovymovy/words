                "senses": [
                    {
                        "sense_id": "b4b2db24-ffe4-35cb-9818-2bd671e203ca",
                        "entry_id": "deb96932-6daf-3715-9260-3249eb775454",
                        "glosses": [
                            "Unternehmen, das (neue) Vakzine produziert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4622ceab-ddf1-46fe-9479-9f0bf446c16d",
                                "sense_id": "b4b2db24-ffe4-35cb-9818-2bd671e203ca",
                                "text": "„Ein Teilbereich der Pharmaindustrie sind die Impfstoffhersteller.“"
                            },
                            {
                                "example_id": "babba2a5-12b8-48f5-b735-d2916d4493a6",
                                "sense_id": "b4b2db24-ffe4-35cb-9818-2bd671e203ca",
                                "text": "„Natürlich zweimal geimpft, eigentlich dreimal und dann alle halben Jahre, so die Impfstoffhersteller.“"
                            },
                            {
                                "example_id": "dc2165d4-c002-4b39-8441-db506a4291bc",
                                "sense_id": "b4b2db24-ffe4-35cb-9818-2bd671e203ca",
                                "text": "„Unser Immunsystem und Impfstoffhersteller kämpfen, um mit den ständigen Mutationen mitzuhalten.“"
                            },
                            {
                                "example_id": "846c9215-8242-4f26-9515-390267fddd72",
                                "sense_id": "b4b2db24-ffe4-35cb-9818-2bd671e203ca",
                                "text": "„Es ist daher ein Segen, dass sich viele Impfstoffhersteller dieser Mammutaufgabe gestellt und begonnen haben, Impfstoffe gegen Covid-19 zu entwickeln.“"
                            },
                            {
                                "example_id": "c2705ff7-c8c6-4e86-9525-b0a30b50e7eb",
                                "sense_id": "b4b2db24-ffe4-35cb-9818-2bd671e203ca",
                                "text": "„Es gibt keine gesetzlichen Vorgaben für Impfstoffhersteller, die Risiken ihrer Impfstoffe untersuchen und dokumentieren zu müssen.“"
                            },
                            {
                                "example_id": "cd84029d-8520-42e5-97b9-01a56574e02d",
                                "sense_id": "b4b2db24-ffe4-35cb-9818-2bd671e203ca",
                                "text": "„Denn die Impfstoffhersteller müssen nur nachweisen, dass durch die Impfung Antikörper erzeugt werden.“"
                            },
                            {
                                "example_id": "e76576fc-70e7-49be-a821-84014791d9a5",
                                "sense_id": "b4b2db24-ffe4-35cb-9818-2bd671e203ca",
                                "text": "„Sämtliche Zeitungen berichteten über sie, und die Aktien der Impfstoffhersteller schnellten in die Höhe.“"
                            },
                            {
                                "example_id": "17bb61ef-9b27-427b-9022-b3b4011bea11",
                                "sense_id": "b4b2db24-ffe4-35cb-9818-2bd671e203ca",
                                "text": "„Zudem haben Impfstoffhersteller in den USA Ärzte finanziert, mit einseitigen Informationen beeinflusst und so den Weg zur Zulassung bereitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
