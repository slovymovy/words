{
    "word_family": [
        "animate",
        "animation",
        "inanimation",
        "inanimateness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9adcd49e-c068-36cf-9022-d7a86da1bb50",
                    "sense_definition": "Not alive, especially having never possessed life like plants, humans, or animals.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "not_alive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rocks and stones are typical examples of <w>inanimate</w> matter.",
                            "target_lang_translations": {
                                "ru": "Скалы и камни — типичные примеры <w>неживой</w> материи."
                            }
                        },
                        {
                            "text": "He often talks to <w>inanimate</w> objects when working alone in his garage.",
                            "target_lang_translations": {
                                "ru": "Он часто разговаривает с <w>неодушевлёнными</w> предметами, когда работает в гараже один."
                            }
                        }
                    ],
                    "synonyms": [
                        "lifeless",
                        "non-animate",
                        "insentient",
                        "insensate"
                    ],
                    "antonyms": [
                        "animate"
                    ],
                    "common_phrases": [
                        "inanimate object",
                        "inanimate matter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неживой, неодушевлённый; не обладающий признаками жизни в отличие от растений, животных или людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неживой",
                                "target_lang_sense_clarification": "не относящийся к живой природе"
                            },
                            {
                                "target_lang_word": "неодушевлённый",
                                "target_lang_sense_clarification": "лишенный души или жизни; также в грамматике"
                            },
                            {
                                "target_lang_word": "бездушный",
                                "target_lang_sense_clarification": "неживой, предметный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "883288ff-efec-3e7f-8835-05c1d7ddc2d1",
                    "sense_definition": "Showing no signs of life, movement, or consciousness; motionless.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "motionless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fallen soldier lay completely <w>inanimate</w> on the cold ground.",
                            "target_lang_translations": {
                                "ru": "Упавший солдат лежал совершенно <w>неподвижно</w> на холодной земле."
                            }
                        },
                        {
                            "text": "After hours in the freezing water, the rescued animal seemed entirely <w>inanimate</w>.",
                            "target_lang_translations": {
                                "ru": "После нескольких часов в ледяной воде спасённое животное казалось совершенно <w>безжизненным</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "lifeless",
                        "motionless",
                        "inert"
                    ],
                    "antonyms": [
                        "animate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не подающий признаков жизни, неподвижный или лишенный сознания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безжизненный",
                                "target_lang_sense_clarification": "неподвижный, выглядящий мертвым"
                            },
                            {
                                "target_lang_word": "неподвижный",
                                "target_lang_sense_clarification": "застывший без движения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0bdc49f4-e751-36d5-bc7a-5ce4caa2deda",
                    "sense_definition": "An object or thing that is not alive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "not_alive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher distinguished strictly between sentient beings and mere <w>inanimates</w>.",
                            "target_lang_translations": {
                                "ru": "Философ строго разграничивал разумных существ и простые <w>неодушевлённые предметы</w>."
                            }
                        },
                        {
                            "text": "Ancient beliefs often attributed human souls or magical powers to <w>inanimates</w>.",
                            "target_lang_translations": {
                                "ru": "Древние верования нередко приписывали человеческие души или магические силы <w>неживым объектам</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неживой или неодушевлённый предмет, вещь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неодушевлённый предмет",
                                "target_lang_sense_clarification": "вещь, лишенная жизни"
                            },
                            {
                                "target_lang_word": "неживой объект",
                                "target_lang_sense_clarification": "предмет материального мира"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "39ef751b-30ef-3d57-b5d5-6f95e09bd4be",
                    "sense_definition": "To <w>animate</w> or infuse with life and spirit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her vibrant joy seemed to <w>inanimate</w> every corner of the silent hall.",
                            "target_lang_translations": {
                                "ru": "Её лучезарная радость, казалось, <w>оживляла</w> каждый уголок безмолвного зала."
                            }
                        },
                        {
                            "text": "Poets often attempt to <w>inanimate</w> nature with profound emotional truth.",
                            "target_lang_translations": {
                                "ru": "Поэты часто стремятся <w>одухотворить</w> природу глубокой эмоциональной правдой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оживлять, вселять жизнь или вдохновлять (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оживлять",
                                "target_lang_sense_clarification": "вселять жизнь или дух"
                            },
                            {
                                "target_lang_word": "одухотворять",
                                "target_lang_sense_clarification": "наполнять жизнью или возвышенным смыслом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}