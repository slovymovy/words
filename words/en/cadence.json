{
    "word_family": [
        "cadency",
        "cadenza",
        "cadenced"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ef0f8f63-672e-36f3-a831-7df1c59ddd3c",
                    "sense_definition": "The general inflection or modulation of the voice, or of any sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech_and_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cadence</w> of his voice was soothing and helped the children fall asleep.",
                            "target_lang_translations": {
                                "ru": "<w>Ритм</w> его голоса был успокаивающим и помог детям уснуть."
                            }
                        },
                        {
                            "text": "She spoke with a rhythmic <w>cadence</w> that made her poetry reading very engaging.",
                            "target_lang_translations": {
                                "ru": "Она говорила с ритмичной <w>каденцией</w>, что сделало чтение стихов очень увлекательным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rhythmic cadence",
                        "vocal cadence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общая интонация или модуляция голоса или любого звука."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каденция",
                                "target_lang_sense_clarification": "ритм и интонация речи"
                            },
                            {
                                "target_lang_word": "ритм",
                                "target_lang_sense_clarification": "размеренность звучания"
                            },
                            {
                                "target_lang_word": "интонация",
                                "target_lang_sense_clarification": "модуляция голоса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa2c1a91-e066-320c-9dd1-dfc8d05a0dc8",
                    "sense_definition": "A progression of at least two chords which conclude a piece of music, section or musical phrases within it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The symphony ended with a powerful perfect <w>cadence</w> in the key of C major.",
                            "target_lang_translations": {
                                "ru": "Симфония закончилась мощной совершенной <w>каденцией</w> в до-мажоре."
                            }
                        },
                        {
                            "text": "The composer used a deceptive <w>cadence</w> to surprise the audience at the end of the phrase.",
                            "target_lang_translations": {
                                "ru": "Композитор использовал прерванный <w>каданс</w>, чтобы удивить слушателей в конце фразы."
                            }
                        }
                    ],
                    "synonyms": [
                        "clausula"
                    ],
                    "common_phrases": [
                        "perfect cadence",
                        "musical cadence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Последовательность как минимум из двух аккордов, завершающая музыкальное произведение, секцию или фразу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каденция",
                                "target_lang_sense_clarification": "гармонический оборот в конце фразы"
                            },
                            {
                                "target_lang_word": "каданс",
                                "target_lang_sense_clarification": "заключительный музыкальный оборот"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38127df1-728c-3f69-9761-48cd83924dde",
                    "sense_definition": "A balanced, rhythmic flow of events or life.",
