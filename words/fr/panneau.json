            "senses": [
                {
                    "sense_id": "178fe886-f3e2-3af0-acd9-24e7ed84d2a5",
                    "sense_definition": "Support rigide destiné à porter des affiches, des indications ou des signaux routiers.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "signalisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regarde bien le <w>panneau</w> pour savoir quelle direction prendre à l'intersection."
                        },
                        {
                            "text": "La municipalité a dressé un nouveau <w>panneau</w> routier pour signaler la zone scolaire."
                        }
                    ],
                    "synonyms": [
                        "panonceau",
                        "pancarte"
                    ],
                    "common_phrases": [
                        "panneau de signalisation",
                        "panneau routier"
                    ]
                },
                {
                    "sense_id": "1b90d01e-8583-32f7-9c9e-6a68df07e422",
                    "sense_definition": "Élément préfabriqué rigide et plat servant à la construction, à l'isolation ou à la captation d'énergie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont fait installer des <w>panneaux</w> solaires sur le toit de leur maison."
                        },
                        {
                            "text": "Ce bâtiment écologique utilise un <w>panneau</w> photovoltaïque moderne pour produire son électricité."
                        }
                    ],
                    "synonyms": [
                        "plaque"
                    ],
                    "common_phrases": [
                        "panneau solaire",
                        "panneau photovoltaïque"
                    ]
                },
                {
                    "sense_id": "fce1bec6-ded0-3c03-89b7-dff0f42efc2e",
