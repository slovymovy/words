                                "zh": "你能帮我把窗户<w>打开</w>一下吗？"
                            }
                        },
                        {
                            "text": "Hij <w>opende</w> de deur voor de gasten.",
                            "target_lang_translations": {
                                "en": "He <w>opened</w> the door for the guests.",
                                "ru": "Он <w>открыл</w> дверь для гостей.",
                                "es": "Él <w>abrió</w> la puerta para los invitados.",
                                "it": "Lui ha <w>aperto</w> la porta per gli ospiti.",
                                "pl": "On <w>otworzył</w> drzwi dla gości.",
                                "de": "Er <w>öffnete</w> die Tür für die Gäste.",
                                "fr": "Il a <w>ouvert</w> la porte pour les invités.",
                                "cs": "Hostům <w>otevřel</w> dveře.",
                                "tr": "Misafirler için kapıyı <w>açtı</w>.",
                                "zh": "他为客人们<w>打开</w>了门。"
                            }
