                                    {
                                        "sense_id": "0a98e59f-7704-3133-bff9-bae2175ff479",
                                        "entry_id": "45ea75df-b244-34db-af6c-41d79d5baefc",
                                        "glosses": [
                                            "A knob or disc that is passed through a loop or (buttonhole), serving as a fastener."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f44ab18e-607c-4161-8d42-25c3a1d3cbf1",
                                                "sense_id": "0a98e59f-7704-3133-bff9-bae2175ff479",
                                                "text": "I liked the man for his own sake, and even had he promised to turn out a celebrity it would have had no weight with me. I look upon notoriety with the same indifference as on the buttons on a man's shirt-front, or the crest on his note-paper."
                                            },
                                            {
                                                "example_id": "f93bd516-d5b7-488d-8bde-363b06ba2d2f",
                                                "sense_id": "0a98e59f-7704-3133-bff9-bae2175ff479",
                                                "text": "Rather should it be said that these ladies wore dress of military style, since there was nothing uniform about their outfits, one being in powder-blue with silver buttons and a forage-cap, the other in tan with gold buttons and the dinkiest of red-peaked kepis."
                                            },
                                            {
                                                "example_id": "2e6460f5-d93a-41ae-bc3d-85efa3149a28",
                                                "sense_id": "0a98e59f-7704-3133-bff9-bae2175ff479",
                                                "text": "April fastened the buttons of her overcoat to keep out the wind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1174d87d-b256-3b87-88c6-571f6aa2709d",
                                        "entry_id": "45ea75df-b244-34db-af6c-41d79d5baefc",
                                        "glosses": [
                                            "A mechanical device designed to be pressed with a finger in order to open or close an electric circuit or to activate a mechanism."
                                        ],
                                        "tags": [],
                                        "examples": [
