                ],
                "senses": [
                    {
                        "sense_id": "37c34232-3989-39fb-8883-d8fccaaa18a1",
                        "entry_id": "ed740f19-86b2-3e83-b822-e2619f26603d",
                        "glosses": [
                            "Caractère de ce qui est moite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f656b90a-f5f8-4b94-a48a-77a0335bbd3b",
                                "sense_id": "37c34232-3989-39fb-8883-d8fccaaa18a1",
                                "text": "l’ombre y prenait une chaleur renfermée de fournaise, une moiteur d’humidité, une sueur pestilentielle."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0a10d2d-f2b8-31b8-86da-e56a8a65c9d1",
                        "entry_id": "ed740f19-86b2-3e83-b822-e2619f26603d",
                        "glosses": [
                            "Légère humidité, légère transpiration,"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a458585-f086-4777-b35b-4c7fe7eb5750",
                                "sense_id": "a0a10d2d-f2b8-31b8-86da-e56a8a65c9d1",
                                "text": "Il a une petite moiteur aux mains."
                            },
                            {
                                "example_id": "1fcd547b-1c2e-4e1c-9752-6216b7490da9",
                                "sense_id": "a0a10d2d-f2b8-31b8-86da-e56a8a65c9d1",
                                "text": "Après l’accès de fièvre, il reste souvent un peu de moiteur."
                            },
                            {
                                "example_id": "0bc952e4-5dde-4f15-ab68-ff54cffc8212",
                                "sense_id": "a0a10d2d-f2b8-31b8-86da-e56a8a65c9d1",
                                "text": "Il faut chauffer ces draps pour en ôter la moiteur."
                            },
                            {
                                "example_id": "3aad3062-69df-46ef-b61f-649dfcaf3430",
                                "sense_id": "a0a10d2d-f2b8-31b8-86da-e56a8a65c9d1",
                                "text": "Va dehors ! Va voir s’il y a des oranges pour moi chez l’épicier… Va demander à M. Rosimond de me prêter La Revue des Deux-Mondes… Mais marche doucement, le temps est orageux, tu reviendrais en moiteur !…"
                            }
                        ]
                    },
                    {
                        "sense_id": "fae0f30a-91d6-3994-9069-feac0111a291",
                        "entry_id": "ed740f19-86b2-3e83-b822-e2619f26603d",
                        "glosses": [
                            "Tiédeur agréable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c8f1dea-61da-4098-8049-c6f6d19d1cef",
                                "sense_id": "fae0f30a-91d6-3994-9069-feac0111a291",
                                "text": "Sentir dans ses membres une douce moiteur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b68fef9d-eecc-44e5-9c1f-c7a982c60957",
                        "source_entry_id": "ed740f19-86b2-3e83-b822-e2619f26603d",
                        "target_lang_word": "dampness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dampness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3d3397b-6022-3076-807d-d0bc437f454c",
                                        "entry_id": "41631f65-5677-360a-9253-58673f3378a7",
                                        "glosses": [
                                            "Moderate humidity; moisture; moistness; the state or quality of being damp."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2f28eb0-f2ba-45f4-b5bb-cc3485f122fe",
                                                "sense_id": "f3d3397b-6022-3076-807d-d0bc437f454c",
                                                "text": "With 3,600 h.p. underfoot, acceleration was reasonably brisk, but the flickering wheel-slip indicator light showed the prudence of not putting full power through the traction motors while there were traces of early-morning dampness on the rails."
                                            },
                                            {
                                                "example_id": "3e89868e-f84f-4607-b089-af1714a364a8",
                                                "sense_id": "f3d3397b-6022-3076-807d-d0bc437f454c",
                                                "text": "They hadn't reckoned with the attendant personality disorders, which the coldness, the darkness, the dampness, the crampedness and the loneliness were doing nothing to decrease."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2debdf0-8656-313e-a022-e24e21eb434c",
                                        "entry_id": "41631f65-5677-360a-9253-58673f3378a7",
                                        "glosses": [
                                            "The degree to which something is damp or moist."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46f35001-6621-489b-b268-3e4fe0f1b8fb",
                                                "sense_id": "a2debdf0-8656-313e-a022-e24e21eb434c",
                                                "text": "The dampness in the writing paper caused the ink to spread and smudge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "544bf594-9c75-43ea-b976-86dd725be7be",
                        "source_entry_id": "ed740f19-86b2-3e83-b822-e2619f26603d",
