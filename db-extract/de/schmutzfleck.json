                "senses": [
                    {
                        "sense_id": "0f4c465e-41fb-3fc3-a99c-cf962fc72e43",
                        "entry_id": "6acb93dd-1253-3d14-8154-7b9b27d88d79",
                        "glosses": [
                            "Stelle auf einer Oberfläche mit Schmutz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f77da82-116c-4f44-a05d-5e1503abad3b",
                                "sense_id": "0f4c465e-41fb-3fc3-a99c-cf962fc72e43",
                                "text": "„Als wir die Treppe hinaufstiegen, holte Holmes zweimal sein Vergrößerungsglas aus seiner Tasche und untersuchte sorgfältig ein paar Stellen auf der staubigen, als Teppichläufer dienenden Kokosmatte, die mir nur Schmutzflecken zu sein schienen.“"
                            },
                            {
                                "example_id": "b6b9e2b7-e61b-41b9-afdf-d97acd92a019",
                                "sense_id": "0f4c465e-41fb-3fc3-a99c-cf962fc72e43",
                                "text": "„An dem gab es einige halbtrockene Schmutzflecken, die er mit Speichel bedeckte, um sie darauf mit dem Ärmel wegzuwischen, worauf er die ärgsten Beulen am Hutkopf glättete und nunmehr den Hut aufsetzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
