                "senses": [
                    {
                        "sense_id": "814318cd-5626-30a7-bdbd-2205cbdc3d95",
                        "entry_id": "ecde33da-7005-3fe5-81fa-30e253437d8d",
                        "glosses": [
                            "ein kräftiger Schlag mit einer Axt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87fc0936-2324-4b5e-a240-c6dc7197540c",
                                "sense_id": "814318cd-5626-30a7-bdbd-2205cbdc3d95",
                                "text": "„Die Frauen prostituieren sich, ein gutmütiger Arzt erschießt seine untreue Frau, der Gemüsehändler tötet seinen Freund, den Poeten, mit einem Axthieb.“"
                            },
                            {
                                "example_id": "43b31c76-83b7-4713-b458-d27467a42289",
                                "sense_id": "814318cd-5626-30a7-bdbd-2205cbdc3d95",
                                "text": "„Und im selben Augenblick, wo sein Axthieb niedersauste, wurde er rücklings gepackt und ihm eine Decke um den Kopf gewickelt: das war seine Frau, die er meinte erschlagen zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
