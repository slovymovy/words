                "senses": [
                    {
                        "sense_id": "712a429f-e5c4-3bc8-a79b-790b75ecc896",
                        "entry_id": "f43636db-e944-330a-85ae-f2ef10dc133b",
                        "glosses": [
                            "Zubereitungsform des Kaffees, bei der Kaffeepulver in einem Papierfilter mit heißem Wasser überbrüht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6b5a57b-37d9-4472-b7a5-ad0b59f41c34",
                                "sense_id": "712a429f-e5c4-3bc8-a79b-790b75ecc896",
                                "text": "Trotz der steigenden Beliebtheit von Cappuccino, Espresso & Co. ist der gute, alte Filterkaffee nach wie vor der meistgetrunkene Kaffee in Deutschland."
                            },
                            {
                                "example_id": "630ace51-8ad8-414d-ad58-c9716cefbcc0",
                                "sense_id": "712a429f-e5c4-3bc8-a79b-790b75ecc896",
                                "text": "„Seit ich denken kann, trinkt er Filterkaffee mit Kondensmilch und Zucker.“"
                            },
                            {
                                "example_id": "6aeafe0b-1371-43ea-a44c-8e3d922c1a71",
                                "sense_id": "712a429f-e5c4-3bc8-a79b-790b75ecc896",
                                "text": "„Keine fünf Minuten später machte ich mich mit einem großen Becher Filterkaffee in der einen und einem Croissant in der anderen Hand an die Arbeit.“"
                            },
                            {
                                "example_id": "18200717-9de7-4885-9129-7c1686eb50ab",
                                "sense_id": "712a429f-e5c4-3bc8-a79b-790b75ecc896",
                                "text": "„In diesen Morgenstunden, in denen ich, bis ich meine zwei Tassen Filterkaffee getrunken hatte, alles, was Amalia sagte, mit einem Brummen quittierte, war es friedlich im Haus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
