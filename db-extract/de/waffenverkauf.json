                "senses": [
                    {
                        "sense_id": "dcabb37b-7ee1-3ae1-ba7c-ea9992fb65c9",
                        "entry_id": "a02c3326-9ea4-318d-9c04-de9163482d9e",
                        "glosses": [
                            "Verkauf von Waffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8df1135-250c-4f44-9f07-0d5d233a3cb4",
                                "sense_id": "dcabb37b-7ee1-3ae1-ba7c-ea9992fb65c9",
                                "text": "„Waffenverkäufe können die Angriffs- oder Schutzmacht des Käufers stärken, durch Importe das lokale Handwerk behindern oder illegalen Besitz ermöglichen, für die Hersteller viel Gewinn einbringen, die Machthaber eines Staates, die Waffenbesitzer oder die öffentliche Sicherheit gefährden.“"
                            },
                            {
                                "example_id": "34329954-b92b-4a62-9e9d-787ff8262616",
                                "sense_id": "dcabb37b-7ee1-3ae1-ba7c-ea9992fb65c9",
                                "text": "„Gerade in Kriegszeiten kann man mit Waffenverkäufen viel Geld verdienen.“"
                            },
                            {
                                "example_id": "cb2cf6ca-1b93-4d1a-9f1f-f2402b45e237",
                                "sense_id": "dcabb37b-7ee1-3ae1-ba7c-ea9992fb65c9",
                                "text": "„So lag der Anteil an Waffenverkäufen im Mittelalter der Stadt Nürnberg in Friedenszeiten bei 10 % und stieg in Kriegszeiten auf 100 % an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
