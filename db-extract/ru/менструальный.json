                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3a454d3-dde6-322e-89d8-4ab27d4a9799",
                        "entry_id": "00fdf355-3bf0-30e9-84ed-53430f234620",
                        "glosses": [
                            "физиол. связанный, соотносящийся по значению с существительным менструация"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1ceec1b-17e5-4669-8dd3-26400385aff2",
                                "sense_id": "c3a454d3-dde6-322e-89d8-4ab27d4a9799",
                                "text": "― Неграмотные пейзане утверждают, что, напоив мужчину менструальной кровью, возможно навечно приворожить его."
                            },
                            {
                                "example_id": "e3e66657-6e94-4794-99fd-865d7051d3c3",
                                "sense_id": "c3a454d3-dde6-322e-89d8-4ab27d4a9799",
                                "text": "Менструальную кровь нельзя считать «дурной» ― она не содержит каких-либо токсичных элементов, а от обычной отличается тем, что не свёртывается, и в ней есть специфические гормоны, вызывающие сокращение матки."
                            },
                            {
                                "example_id": "4138dad5-3f4e-44c1-83cf-975949f396e6",
                                "sense_id": "c3a454d3-dde6-322e-89d8-4ab27d4a9799",
                                "text": "Она сказала, что гинеколог порекомендовал ей применять таблетки кетонал при менструальных болях."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f5fc860-84fa-41a8-a64d-00896eb0b98c",
                        "source_entry_id": "00fdf355-3bf0-30e9-84ed-53430f234620",
                        "source_sense_id": "c3a454d3-dde6-322e-89d8-4ab27d4a9799",
                        "target_lang_word": "menstrual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menstrual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d17d5743-5bd7-3b26-84a4-ca927bad9a8d",
                                        "entry_id": "5d7509e6-97c8-3e7f-8dee-6053ff8488fe",
                                        "glosses": [
                                            "Of or relating to the menses."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2395a2bd-109e-4378-a7fe-ba8c4888693a",
                                                "sense_id": "d17d5743-5bd7-3b26-84a4-ca927bad9a8d",
                                                "text": "Recent studies in physiology have noted that women who live in close proximity to one another - nurses in a hospital or coeds in a college dormitory - tend to have their menstrual periods at the same time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "087ee8ff-fd8d-3897-b804-f60884dae317",
                                        "entry_id": "5d7509e6-97c8-3e7f-8dee-6053ff8488fe",
                                        "glosses": [
                                            "Occurring once a month; monthly."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3cf23c1a-98b5-3e30-b2d0-8039519d3f17",
                                        "entry_id": "5d7509e6-97c8-3e7f-8dee-6053ff8488fe",
                                        "glosses": [
                                            "Lasting for a month."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7bc498c-0014-4a4a-90c7-a85fcde74e8f",
                                                "sense_id": "3cf23c1a-98b5-3e30-b2d0-8039519d3f17",
                                                "text": "a menstrual flower"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "menstrual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1853275b-16f0-38bc-8fd9-4f7fc6892337",
                                        "entry_id": "a0681ca4-7937-373a-ad0a-ae6662ddfffb",
                                        "glosses": [
                                            "A menstrual period."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34656287-06e4-4197-a3f0-6d4ff7b28a88",
                                                "sense_id": "1853275b-16f0-38bc-8fd9-4f7fc6892337",
                                                "text": "“All that drama for what” I thought. All she had to do was tell me that I was having my menstrual. So much for band aids."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
