                ],
                "senses": [
                    {
                        "sense_id": "0f59b736-d9d4-3081-ba98-af1cedac6467",
                        "entry_id": "9882f6ef-a535-3b93-b3e1-ee85e38ce70c",
                        "glosses": [
                            "iemand die huilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fed0bf18-220a-4e7d-91f2-d2726457ec68",
                                "sense_id": "0f59b736-d9d4-3081-ba98-af1cedac6467",
                                "text": "Tja, 'Love story'. Film en boek groeiden indertijd uit tot klassiekers die tot twee kampen leidden: de huilers en de haters. Het fondantzoete verhaal over de gedoemde liefde tussen de rijke Harvard-'prep'Oliver ('kakker'in de vertaling van Jan Rot) en het arme meisje Jenny, van Italiaanse komaf, zorgde in elk geval voor een internationale opleving in de tissue-industrie."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3ebd42d-7878-3aad-866a-381e3e368485",
                        "entry_id": "9882f6ef-a535-3b93-b3e1-ee85e38ce70c",
                        "glosses": [
                            "jonge zeehond die op het strand of op het wad ligt en zijn moeder is kwijtgeraakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "636e8135-e86d-4c94-8733-c4643652deea",
                                "sense_id": "b3ebd42d-7878-3aad-866a-381e3e368485",
                                "text": "De zeehondencrèche in Pieterburen wordt overspoeld met huilers, jonge zeehonden die hun moeder zijn kwijtgeraakt. Dat bevestigt Daniella van Gennep van de Zeehondencrèche zaterdag."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ed7afe7-89b2-3da5-9d42-0588478b36e6",
                        "entry_id": "9882f6ef-a535-3b93-b3e1-ee85e38ce70c",
                        "glosses": [
                            "marinier in opleiding die niet kan werken onder gezag of tijdsdruk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07e4ae96-c12d-4cfd-a044-87525bc201fa",
                                "sense_id": "9ed7afe7-89b2-3da5-9d42-0588478b36e6",
                                "text": "Zoals voetbalcoach Leo Beenhakker enige tijd geleden repte over ‘de patatgeneratie’, zo wordt bij de opleiders van de mariniers gesproken over de generatie van de ‘huilers’. (Nieuwe Revu, 13/12/1990)"
                            }
                        ]
                    }
                ],
