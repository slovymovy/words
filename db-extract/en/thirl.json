                        "sense_id": "a9d5b1ab-1465-3f1a-a124-d09571ed2a20",
                        "entry_id": "fbd53fea-a9e2-3eee-8ec4-92b91cd183ef",
                        "glosses": [
                            "To pierce; to perforate, penetrate, cut through."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "63ca0f73-845d-45ac-90ce-f27b3b2f5b14",
                                "sense_id": "a9d5b1ab-1465-3f1a-a124-d09571ed2a20",
                                "text": "But yet his hardnesse savde him not against the piercing dart.\nFor hitting right betweene the scales that yeelded in that part\nWhereas the joynts doe knit the backe, it thirled through the skin,\nAnd pierced to his filthy mawe and greedy guts within."
                            }
                        ]
                    },
                    {
                        "sense_id": "13c8ae2b-0e5e-3874-a384-bb6eb2a13ee5",
                        "entry_id": "fbd53fea-a9e2-3eee-8ec4-92b91cd183ef",
                        "glosses": [
