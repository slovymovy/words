                "senses": [
                    {
                        "sense_id": "b966c2c5-58d6-33f3-9557-2529c5887cfd",
                        "entry_id": "5b022540-4078-3fd6-96bf-dbdadd5c8ec3",
                        "glosses": [
                            "An organized search for a criminal or enemy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a552b09d-b2a2-4125-95f8-e3d087bf3456",
                                "sense_id": "b966c2c5-58d6-33f3-9557-2529c5887cfd",
                                "text": "After the murderer escaped, there was a full-scale manhunt to catch him."
                            }
                        ]
                    },
                    {
                        "sense_id": "c554d543-2c12-3b64-ad19-43010d4a70ea",
                        "entry_id": "5b022540-4078-3fd6-96bf-dbdadd5c8ec3",
                        "glosses": [
                            "A variant of hide and seek in which a player who is caught by the seeker themselves becomes a seeker, and the final player remaining is declared the winner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f377e11e-dbf1-4ed7-880e-955c3199c8f2",
                                "sense_id": "c554d543-2c12-3b64-ad19-43010d4a70ea",
                                "text": "Manhunt is a variant of hide-and-seek, she tells me. One person is the seeker. Everyone else hides. If the seeker finds you, you become a seeker, too."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b9a808b-eaa9-415c-bcf3-6c094076fefd",
                        "source_entry_id": "5b022540-4078-3fd6-96bf-dbdadd5c8ec3",
                        "source_sense_description": "organized search",
                        "target_lang_word": "klopjacht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klopjacht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a22199b0-ff7f-35b4-b6a5-4442b7b5fa1d",
                                        "entry_id": "1f7d2256-c772-31a9-bc19-5825921dc9f7",
                                        "glosses": [
                                            "grote drijfjacht op dieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa24bde7-e6aa-4cd7-a9bc-8649cc94c2b1",
                                                "sense_id": "a22199b0-ff7f-35b4-b6a5-4442b7b5fa1d",
                                                "text": "Toen de heren Melville en de St. Mars naar hartelust het mooiste wild van de jacht geschoten hadden, oordeelden zij dat er nu nog een grote klopjacht moest gehouden worden om te eindigen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fec590af-2b06-3aab-8fdf-035d8037d1d9",
                                        "entry_id": "1f7d2256-c772-31a9-bc19-5825921dc9f7",
                                        "glosses": [
                                            "stelselmatige opsporing en achtervolging om iemand te vangen"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "374db583-9baf-45cc-95a0-2fbfebdcdec2",
                                                "sense_id": "fec590af-2b06-3aab-8fdf-035d8037d1d9",
                                                "text": "De klopjacht die vervolgens op de dader werd ingezet duurde mede dankzij de inzet van hondengeleiders niet te lang, zo vervolgde Den Os."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
