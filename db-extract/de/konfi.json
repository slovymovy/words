                "senses": [
                    {
                        "sense_id": "32fe9dd2-d3b2-32eb-ad0f-d68eb8584342",
                        "entry_id": "0e2436f3-2622-3d48-9d4c-2764b1cc256c",
                        "glosses": [
                            "Person, die im Konfirmationsunterricht auf die Konfirmation vorbereitet wird, beziehungsweise: Person, die gerade konfirmiert wird/wurde"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "26410e75-dbf6-48a9-8625-be059c442723",
                                "sense_id": "32fe9dd2-d3b2-32eb-ad0f-d68eb8584342",
                                "text": "Die Konfis hören dem Pastor gespannt zu."
                            },
                            {
                                "example_id": "8de40c05-c845-44cf-aef8-a87b0ca0b52e",
                                "sense_id": "32fe9dd2-d3b2-32eb-ad0f-d68eb8584342",
                                "text": "„Die Konfis lassen Erinnerungsfotos machen, aufgenommen von einem Apparat, der an Passbildautomaten erinnert.“"
                            },
                            {
                                "example_id": "9d578624-a606-4c2d-8d7a-244f5a14e84a",
                                "sense_id": "32fe9dd2-d3b2-32eb-ad0f-d68eb8584342",
                                "text": "„Die Konfis kümmern sich auch ums Essen.“"
                            },
                            {
                                "example_id": "c2fccda2-a580-4035-9181-adc0d5d0f4b4",
                                "sense_id": "32fe9dd2-d3b2-32eb-ad0f-d68eb8584342",
                                "text": "„70 Konfis aus Hamm feiern ihre Konfirmation im Maxipark gemeinsam.“"
                            },
                            {
                                "example_id": "b56116ec-3d27-4b0e-9c24-01a89df74f14",
                                "sense_id": "32fe9dd2-d3b2-32eb-ad0f-d68eb8584342",
                                "text": "„Geboren wurde die Idee zu einer liturgischen Osternacht aus der fünftägigen Wanderung im Oktober, bei der die Gruppe mit 27 Konfis sehr zusammengewachsen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
