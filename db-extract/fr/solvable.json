                ],
                "senses": [
                    {
                        "sense_id": "c96a3b14-e1a3-312f-9be8-f81378dcced2",
                        "entry_id": "083ecc61-e114-308a-9644-0d22bc01fa58",
                        "glosses": [
                            "Qui a de quoi payer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62f3a7a9-d54f-4e4c-87fc-ab8b9b3772a6",
                                "sense_id": "c96a3b14-e1a3-312f-9be8-f81378dcced2",
                                "text": "il valait mieux vendre à monsieur Grandet, homme solvable, et capable d’ailleurs de payer la terre en argent comptant."
                            },
                            {
                                "example_id": "83e0cfab-5365-4c3a-bf4e-4714ba05777f",
                                "sense_id": "c96a3b14-e1a3-312f-9be8-f81378dcced2",
                                "text": "Dans le pays dijonnais, la demande solvable de crédit est d'abord une demande de crédit à l'agriculture, ensuite une demande de crédit à la consommation, secondairement enfin une demande émanant de ceux qui se livrent au négoce."
                            },
                            {
                                "example_id": "147e0fce-2d29-4405-bcd2-b66a3bd40317",
                                "sense_id": "c96a3b14-e1a3-312f-9be8-f81378dcced2",
                                "text": "Effectivement on peut s'étonner que Total n'assume pas ses responsabilités alors qu'il est clairement engagé dans cette affaire. Il est probable que les autres parties ne seront pas totalement solvables eu égard aux sommes considérables qui sont demandées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "017ab41a-9b21-4f52-a508-baa3fb775b18",
                        "source_entry_id": "083ecc61-e114-308a-9644-0d22bc01fa58",
                        "source_sense_id": "c96a3b14-e1a3-312f-9be8-f81378dcced2",
                        "target_lang_word": "zahlungsfähig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zahlungsfähig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8818fe9-5148-3a9d-97cd-186c21f0e51b",
                                        "entry_id": "f8c9db11-d8ff-320b-9348-01e5441c5da8",
                                        "glosses": [
                                            "über genügend Kapital zum Zahlen verfügend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f09e54f-d762-457c-8415-a986b6985f5f",
                                                "sense_id": "f8818fe9-5148-3a9d-97cd-186c21f0e51b",
                                                "text": "„Um Griechenland trotzdem zahlungsfähig zu halten, springt indirekt die Europäische Zentralbank ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
