                                        "glosses": [
                                            "die Eugenik betreffend, zu ihr gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0714e09-4bb1-44aa-b972-5f418377539f",
                                                "sense_id": "6d33724a-2c35-35b4-b7e1-609aa474db49",
                                                "text": "„Im ausgehenden 19. Jahrhundert verbreitete sich eugenisches Gedankengut in allen Industriestaaten.“"
                                            },
                                            {
                                                "example_id": "4075ad9e-89ad-4441-94bc-cd8a810d4e43",
                                                "sense_id": "6d33724a-2c35-35b4-b7e1-609aa474db49",
                                                "text": "„Gegen Ende des 19. Jahrhunderts verbreitete sich das eugenische Denken in den fortgeschrittenen Industrienationen rasch, vor allem unter Ärzten, auch Psychiatern.“"
                                            }
                                        ],
