                        "entry_id": "4114ad36-0261-3da1-a48e-528ec3b2b650",
                        "glosses": [
                            "Pièce de vers composée sur des rimes données, sur des bouts-rimés."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "17495337-cd42-4419-a4a5-c66fc6bfcc14",
                                "sense_id": "7aafe743-9974-3714-b0fb-c6413e32243b",
                                "text": "Après le dîner, quelqu’un se mettait au piano, la famille chantait en chœur ; on jouait aussi à des jeux : charades et bouts-rimés."
                            }
                        ]
                    }
