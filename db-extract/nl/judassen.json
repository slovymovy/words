                "senses": [
                    {
                        "sense_id": "1c4f52f0-d24b-3346-8b2c-4f278b523c68",
                        "entry_id": "a7686fc8-2023-3fdf-8855-30a3bc30112d",
                        "glosses": [
                            "bewust ergeren of bij herhaling uitdagend kwetsen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bc52f31a-b580-48af-9c27-3f29acccfbf7",
                                "sense_id": "1c4f52f0-d24b-3346-8b2c-4f278b523c68",
                                "text": "Zij kunnen hem niet uitstaan en zij zijn hem altijd aan het judassen."
                            },
                            {
                                "example_id": "4c19c9ff-5c4a-4fec-9c27-3e55e7e2454b",
                                "sense_id": "1c4f52f0-d24b-3346-8b2c-4f278b523c68",
                                "text": "Josje merkte wel dat die twee kleine krengen om haar te judassen naar haar steile haar staarden en haar zo de kast op probeerden te krijgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "b05791a0-9200-36bb-a66e-a40c650b94f8",
                        "entry_id": "a7686fc8-2023-3fdf-8855-30a3bc30112d",
                        "glosses": [
                            "stiekem rapporteren aan autoriteiten"
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "32eda5cf-34cd-4821-b80f-6aed793ae3ea",
                                "sense_id": "b05791a0-9200-36bb-a66e-a40c650b94f8",
                                "text": "Vertrouw hem niet, hij gaat alles judassen."
                            }
                        ]
                    }
