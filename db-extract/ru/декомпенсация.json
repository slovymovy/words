                    },
                    {
                        "translation_id": "efb814e4-5a61-4f92-a619-b7ccd88af241",
                        "source_entry_id": "978fecbc-9c5b-3e5c-a983-adf29aa21fa3",
                        "source_sense_id": "caf3f05f-16e9-303c-bf9a-6a07800e4ffa",
                        "target_lang_word": "décompensation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décompensation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dade2684-c2a3-3f5d-992d-357aa8b2175a",
                                        "entry_id": "eb4b269a-6906-358f-9551-fd4bdc9bed4c",
                                        "glosses": [
                                            "Dégradation soudaine et importante du fonctionnement d’un organe, ou d’un organisme qui était maintenu en équilibre par des mécanismes de compensation (homéostasie)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25ee77d7-8b0e-4b12-9aaa-f253e636d2ed",
                                                "sense_id": "dade2684-c2a3-3f5d-992d-357aa8b2175a",
                                                "text": "Outre la surinfection bronchique, la pneumonie peut être à l’origine d’une décompensation."
                                            },
                                            {
                                                "example_id": "8e76db2c-cab7-4a1e-bf79-94e589c32b32",
                                                "sense_id": "dade2684-c2a3-3f5d-992d-357aa8b2175a",
                                                "text": "Nous ferons donc l’hypothèse que le harcèlement moral est une technique de destruction visant de manière délibérée la décompensation du sujet afin d’obtenir sa rédition émotionnelle à des fins économiques ou de jouissance personnelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b0475b0-7e0f-36d1-a769-505b04435af7",
                                        "entry_id": "eb4b269a-6906-358f-9551-fd4bdc9bed4c",
                                        "glosses": [
                                            "Crise d’origine psychiatrique pouvant être particulièrement violente qui survient lorsqu’un individu ne parvient plus à se contrôler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05da85d8-c440-43b7-92da-bd90df778174",
                                                "sense_id": "1b0475b0-7e0f-36d1-a769-505b04435af7",
                                                "text": "Il est avéré que cette personne était en crise de décompensation lorsqu’elle a commis son crime. Elle ne peut ainsi être considérée comme responsable de ses actes et ne peut donc être jugée."
                                            },
                                            {
                                                "example_id": "ad428dac-b379-4f9c-8c08-222bf6aaef1d",
                                                "sense_id": "1b0475b0-7e0f-36d1-a769-505b04435af7",
                                                "text": "[…] le moteur de la décompensation réside dans la peur, une peur folle, qui rompt les digues, peur qui est une abdication devant la dureté de la vie, retour à l’enfance non protégée, à l’abandon des premières heures, jours, semaines, années de vie où l’on est tout petit, nu, misérable, dépassé, innocent, où l’on ne comprend pas l’immensité du mal amour, du non-amour, de la solitude."
                                            },
                                            {
                                                "example_id": "1b633e98-e057-4b03-847b-ba2af1628701",
                                                "sense_id": "1b0475b0-7e0f-36d1-a769-505b04435af7",
                                                "text": "Les trois équipes d'Andréane Dionne-Jalbert interviennent annuellement auprès de quelque 200 patients souffrant de maladie mentale en état de décompensation, sans les sortir de leurs milieux de vie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee5aa430-5c6d-39d1-aed4-8946fa2895c1",
                                        "entry_id": "eb4b269a-6906-358f-9551-fd4bdc9bed4c",
                                        "glosses": [
                                            "Action qui consiste à aller à l’encontre de la compensation dans le mécanisme de régulation des groupes électrogènes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
