                "senses": [
                    {
                        "sense_id": "619d9281-af41-392f-a9c3-de026f319fee",
                        "entry_id": "ab335992-ce48-3d61-93d7-b08792e41493",
                        "glosses": [
                            "Person an der Spitze eines Museums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34500a32-ea7d-44c1-9e09-84a0036a7172",
                                "sense_id": "619d9281-af41-392f-a9c3-de026f319fee",
                                "text": "„Als der Museumsdirektor mich erblickte, konnte er seine wissenschaftliche Begehrlichkeit nur schlecht verhüllen, aber er bemühte sich, liebenswürdig zu sein und erschöpfte sich in Höflichkeit.“"
                            },
                            {
                                "example_id": "045df64a-829d-4351-a6e0-6b87763da480",
                                "sense_id": "619d9281-af41-392f-a9c3-de026f319fee",
                                "text": "„Winckelmann war von Beruf Archäolog, Historiker und Philolog, Ästhetiker, Kritiker und Philosoph, Museumsdirektor, Archivar und Bibliothekar, Dragoman, Cicerone und Connoisseur, in Wirklichkeit aber nie etwas anderes als das, womit er seine wissenschaftliche Laufbahn begonnen hatte: nämlich Rektor und Pädagog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
