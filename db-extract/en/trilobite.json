                    {
                        "translation_id": "29bf2f8e-2df0-42d8-a861-456361f12b80",
                        "source_entry_id": "63cb520e-212c-3726-958f-a064529375d1",
                        "source_sense_id": "0c05e4c6-0564-3bf3-bbbe-3cb66aae14b4",
                        "source_sense_description": "member of the class Trilobita",
                        "target_lang_word": "trilobita",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trilobita",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "f513071c-852f-3bd7-a620-c4cb380a0ea8",
                                        "entry_id": "e65ef415-a6b2-379e-9159-919c2db58278",
                                        "glosses": [
                                            "nome comum do grupo biológico de artrópodes marinhos fósseis que existiram durante a Era Paleozoica, do Cambriano ao Permiano, desaparecendo no evento de extinção em massa no final desse período há 250 milhões de anos, caracterizando-se em comum por possuir uma carapaça e por ter o corpo duplamente trilobado (metamérico em cefalão, tórax e pigídio; longitudinal com um lobo medial ou ráquis, e dois lobos laterais ou pleuras), e suas mais de 22 mil espécies já descritas possuíam uma ampla diversidade de protuberâncias (e provavelmente cores) em sua carapaça, bem como uma diversidade de tamanhos que variam de 1 milímetro a aproximadamente 70 centímetros de comprimento (com tamanho médio entre 2 e 7 cm)"
                                        ],
                                        "tags": [
                                            "Paleontologia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20cd3790-f92c-4229-a960-0c72b86a63c0",
                                                "sense_id": "f513071c-852f-3bd7-a620-c4cb380a0ea8",
                                                "text": "Também existiam trilobitas, que pareciam insetos com armaduras, e animais com tentáculos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6bffa0f-4abe-381b-884a-3131f0e17d26",
                                        "entry_id": "e65ef415-a6b2-379e-9159-919c2db58278",
                                        "glosses": [
                                            "cada uma das espécies ou animal desse grupo"
                                        ],
                                        "tags": [
                                            "Por extensão"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84beb83b-6ab9-4670-8339-9f4d63bd6f34",
                                                "sense_id": "c6bffa0f-4abe-381b-884a-3131f0e17d26",
                                                "text": "Esse trilobita de 13 cm nadava nos mares devonianos cerca de 150 milhões de anos antes do surgimento dos primeiros dinossauros."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
