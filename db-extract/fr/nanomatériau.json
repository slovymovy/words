                    {
                        "sense_id": "68e2d077-717a-3d33-a078-fb9d3d0f8265",
                        "entry_id": "51fa8540-efc1-3c6f-8e7d-280cacdb486c",
                        "glosses": [
                            "Matériau dont tous les constituants ou certains éléments structuraux sont de dimension nanométrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c76842fe-582a-4a89-89ee-bdab7cd6c8e9",
                                "sense_id": "68e2d077-717a-3d33-a078-fb9d3d0f8265",
                                "text": "Elle est le premier pays européen à avoir mis en place, depuis le 1ᵉʳ janvier 2013, un registre des nanomatériaux produits, importés ou distribués sur le territoire national."
                            },
                            {
                                "example_id": "77f3a49b-295f-44e3-b3b2-e6c1cdaf930f",
                                "sense_id": "68e2d077-717a-3d33-a078-fb9d3d0f8265",
                                "text": "La nanocellulose cristalline est un nanomatériau renouvelable, recyclable et abondant fabriqué à l'aide de fibres de bois issues du processus de fabrication de la pâte de bois."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73b0bb51-3adc-4f76-bdef-277acc25baa7",
                        "source_entry_id": "51fa8540-efc1-3c6f-8e7d-280cacdb486c",
                        "source_sense_id": "68e2d077-717a-3d33-a078-fb9d3d0f8265",
