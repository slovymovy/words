                ],
                "senses": [
                    {
                        "sense_id": "8829e377-86dd-3c3a-a588-70cd2258df99",
                        "entry_id": "1fec4877-246b-36bb-99b7-c7ab1ccc0eab",
                        "glosses": [
                            "An obstacle set up against military vehicles; a Czech hedgehog."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e1d4a51-e98d-4f06-b01f-fc3183275683",
                                "sense_id": "8829e377-86dd-3c3a-a588-70cd2258df99",
                                "text": "Horned scullies usually are placed in water about 15 feet apart in a line parallel to the beach, with the rails pointing out to sea"
                            },
                            {
                                "example_id": "7c6e0f30-da6b-4fc1-b801-9f8dd38d66fb",
                                "sense_id": "8829e377-86dd-3c3a-a588-70cd2258df99",
                                "text": "Draw in both man-made and natural obstacles. Anything that may hinder the proposed landing (e.g., cusps, submerged rocks, partially awash or submerged wrecks, scullies, berm scarps, sandbars, rails, etc.) may be considered an obstacle."
                            },
                            {
                                "example_id": "9caa262f-7455-4e56-bf6c-80a85d5a4388",
                                "sense_id": "8829e377-86dd-3c3a-a588-70cd2258df99",
                                "text": "Experiments were carried out with placed charges to breach antitank walls, destroy concrete tubes or horned scullies, and fill anti-tank ditches"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b29b12ea-4dbb-3660-9810-03774932993c",
                "word": "Scully",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4ff790ab-9d6a-3e02-aa31-9e3e3e724b98",
                        "entry_id": "b29b12ea-4dbb-3660-9810-03774932993c",
                        "glosses": [
                            "To be skeptical toward (a person or situation) with ideas that do not coincide with conventional wisdom."
                        ],
                        "tags": [
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5400903c-d7ff-4d35-8936-c07c2b31766c",
                                "sense_id": "4ff790ab-9d6a-3e02-aa31-9e3e3e724b98",
                                "text": "When she complains in another episode that Giles is refusing for once to consider a supernatural explanation, she says, \"I can't believe that you of all people would Scully me,\""
                            },
                            {
                                "example_id": "51bb4429-a829-43e4-ad11-b607b295910d",
                                "sense_id": "4ff790ab-9d6a-3e02-aa31-9e3e3e724b98",
                                "text": "She Scullied me and I'm sure the word “macrobiotics” never made it into my medical file; it's an unexplained disappearance of cancer."
                            },
                            {
                                "example_id": "6640cb70-3c63-49fa-81ba-52272def4f4a",
                                "sense_id": "4ff790ab-9d6a-3e02-aa31-9e3e3e724b98",
                                "text": "If you feel strongly about Scullying this situation and avoiding anyone who believes in made-up sky magic, that’s your prerogative, but you should know that you’re preemptively x’ing out a LOT of the queer population you might otherwise click with!"
                            }
                        ]
                    }
                ],
