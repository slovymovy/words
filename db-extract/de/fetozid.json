                "senses": [
                    {
                        "sense_id": "75b82239-e351-354b-b560-f0ffb8146a5e",
                        "entry_id": "24f374fa-830b-3566-bf47-bdb618780082",
                        "glosses": [
                            "Tötung eines menschlichen Fötus, das heißt eines ungeborenen Kindes ab der 11. Schwangerschaftswoche, insbesondere bei Behinderung (Fetopathie) oder Mehrlingsschwangerschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b64c8e-3b2c-4a84-ba9d-48ea25f82896",
                                "sense_id": "75b82239-e351-354b-b560-f0ffb8146a5e",
                                "text": "„Insbesondere der Fetozid zur Mehrlingsreduktion ist ethisch höchst umstritten. Er wird als dunkelstes Kapitel der Reproduktionsmedizin bezeichnet.“"
                            },
                            {
                                "example_id": "b23bc7e4-9621-4310-ad5c-41212892e28b",
                                "sense_id": "75b82239-e351-354b-b560-f0ffb8146a5e",
                                "text": "Der Fetozid erfolgte durch die Injektion von Kaliumchlorid in das Herz des Kindes, welches unter Umständen bis zur Geburt im Mutterleib verbleibt."
                            },
                            {
                                "example_id": "3e967ec4-24ad-4f2d-a855-e26ec9240a0b",
                                "sense_id": "75b82239-e351-354b-b560-f0ffb8146a5e",
                                "text": "Die Dunkelziffer der Fetozide in Deutschland ist hoch."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e19bb3aa-6e50-4632-840f-6909b31ef689",
