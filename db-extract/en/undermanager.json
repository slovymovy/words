                        "glosses": [
                            "A manager who is lower in the organizational hierarchy than another manager."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "891b3e7b-50fe-48e0-a265-0cd5bf31a3aa",
                                "sense_id": "53e455fd-ee78-3b50-932c-4496e908994a",
                                "text": "Despite the effects of the disease, he was subsequently promoted to overman and thereafter to undermanager."
                            },
                            {
                                "example_id": "3deedbfd-37b7-4522-a374-898c46a4f6e2",
                                "sense_id": "53e455fd-ee78-3b50-932c-4496e908994a",
                                "text": "The undermanager, on duty at reception, could have made a living in World War II movies."
                            },
                            {
                                "example_id": "619f667d-8241-428b-a149-7c9aadd7d498",
                                "sense_id": "53e455fd-ee78-3b50-932c-4496e908994a",
                                "text": "I mean, all the lasses will be after him, him being an undermanager. An' then, he's getting old now, he must be nearly thirty. Nobody gets to be an undermanager lest they're getting on a bit, never mind how clever they are."
                            }
                        ]
                    }
