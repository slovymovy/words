                "senses": [
                    {
                        "sense_id": "8b307bad-eaf2-3f47-8d89-099b8d0c3d08",
                        "entry_id": "f7f7cdd1-ef5f-357a-8c86-e45cc9642083",
                        "glosses": [
                            "A humanoid figure made with large snowballs stacked on each other. Human traits like a face and arms may be fashioned with sticks (arms), a carrot (nose), and stones or coal (eyes, mouth)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "36de4cd6-83ea-3053-a9a4-52a083d83ac4",
                        "entry_id": "f7f7cdd1-ef5f-357a-8c86-e45cc9642083",
                        "glosses": [
                            "A score of eight, especially within one inning (in baseball) or on one hole (in golf, where it is also known as dogballs)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38e447be-bed4-4891-bebe-703f52aeb62c",
                                "sense_id": "36de4cd6-83ea-3053-a9a4-52a083d83ac4",
                                "text": "[The Angels] dropped a snowman early on us [Saturday] and we built a snowman early too."
                            },
                            {
                                "example_id": "0db21f6c-ab1f-41f6-97a5-c3c15449412a",
                                "sense_id": "36de4cd6-83ea-3053-a9a4-52a083d83ac4",
                                "text": "\"Then they dropped a snowman (8) on us and did it pretty quick,\" Narron said. \"Then Stone had to stay out there and suck it up for us […]\""
                            },
                            {
                                "example_id": "f13c6a39-a4d5-4827-8bc7-889a5fe1fa2d",
                                "sense_id": "36de4cd6-83ea-3053-a9a4-52a083d83ac4",
                                "text": "For me, another blow-up score of a snowman, 8, seems about right on this hole."
                            }
                        ]
                    },
                    {
                        "sense_id": "f18bf631-79ae-3b4d-b536-89725eef7ed9",
                        "entry_id": "f7f7cdd1-ef5f-357a-8c86-e45cc9642083",
                        "glosses": [
                            "A playing card with the rank of eight."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "238e3475-f555-3483-b026-d51a980d4ec9",
                        "entry_id": "f7f7cdd1-ef5f-357a-8c86-e45cc9642083",
                        "glosses": [
                            "An attractive but heartless man."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "cf168fdc-f915-4f50-b6f0-637a2cb5d7d5",
                                "sense_id": "238e3475-f555-3483-b026-d51a980d4ec9",
                                "text": "A few years ago there lived a lover\nBy the name of Jimmy Jones\nWho really snowed the girls and left them cold\nAnd gained the title of \"The Great Snowman\"."
                            }
                        ]
                    }
                ],
