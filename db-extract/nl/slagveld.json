                                "sense_id": "30060027-5acc-31f3-95ff-aa93799c15bd",
                                "text": "Het ongeluk had een verwoestend effect en liet een waar slagveld achter.",
                                "translation": "The accident had a devastating effect and left a true carnage behind.",
                                "english": "The accident had a devastating effect and left a true carnage behind."
                            },
                            {
                                "example_id": "d7a8127e-db10-4d29-b56f-a21efa016a74",
                                "sense_id": "30060027-5acc-31f3-95ff-aa93799c15bd",
                                "text": "Na de aardbeving was de stad een slagveldje van ingestorte gebouwen en chaos.",
                                "translation": "After the earthquake, the city was a disaster area of collapsed buildings and chaos.",
                                "english": "After the earthquake, the city was a disaster area of collapsed buildings and chaos."
                            }
                        ]
