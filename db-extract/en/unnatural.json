                                            {
                                                "example_id": "cb9a2e33-4729-465a-9291-a6c3edd27f00",
                                                "sense_id": "dde0cbc7-ada3-3054-89b7-a79fb97fc004",
                                                "text": "In het begin van mijn tocht voelde het heel onnatuurlijk om op mijn intuïtie te vertrouwen."
                                            },
                                            {
                                                "example_id": "d858281c-62e7-4852-9dee-fc9d87f8f6de",
                                                "sense_id": "dde0cbc7-ada3-3054-89b7-a79fb97fc004",
                                                "text": "In deze limonade zitten geen onnatuurlijke smaakstoffen."
