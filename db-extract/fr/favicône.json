                        "sense_id": "b42aa81c-d775-3a8d-9853-0798a1a2e26b",
                        "entry_id": "11f50780-a6f0-37bb-8d4b-8276c0272d1c",
                        "glosses": [
                            "Icône d'un site Internet qui s'affiche dans la barre d'adresse des navigateurs le regardant."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "f30c9046-d442-4878-80ec-2597079130d1",
                                "sense_id": "b42aa81c-d775-3a8d-9853-0798a1a2e26b",
                                "text": "La nouvelle menace des favicônes\n Bien que ces mesures puissent être utiles pour les témoins, Zincir-Heywood affirme qu'il existe une nouvelle menace pour la vie privée sur Internet : les favicônes.\n Ce sont les petites icônes que vous voyez dans le coin de l'onglet lorsque vous naviguez sur un site web. Bien que ces icônes puissent paraître inoffensives, Zincir-Heywood indique qu’une équipe de recherche a récemment découvert qu'elles pouvaient être utilisées comme moyen de suivre l'activité d’une personne sur le web."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "504c8f2f-3a0e-4bce-891a-3385f3dee42d",
                        "source_entry_id": "11f50780-a6f0-37bb-8d4b-8276c0272d1c",
                        "source_sense_id": "b42aa81c-d775-3a8d-9853-0798a1a2e26b",
                        "target_lang_word": "Favicon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Favicon",
