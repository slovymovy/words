                                                "example_id": "2625fa4c-d3cb-4242-9b3a-a191127def8a",
                                                "sense_id": "ea82cfbb-893b-3a8c-8a51-28e05f338175",
                                                "text": "Une retraite assurée."
                                            },
                                            {
                                                "example_id": "8c6f0d6d-27e0-4a51-99fd-12f919761917",
                                                "sense_id": "ea82cfbb-893b-3a8c-8a51-28e05f338175",
                                                "text": "Sans doute, je m’éloigne en laissant derrière moi une situation qui est bonne, cependant elle n’est pas assurée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dd0c437-cc8b-3f5d-b568-61943a313f33",
                                        "entry_id": "908c28fe-0106-3ad4-8e4d-197247300792",
                                        "glosses": [
                                            "Qui est infaillible, certain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c543b74-5f2a-46d8-936f-821731e09ed9",
                                                "sense_id": "1dd0c437-cc8b-3f5d-b568-61943a313f33",
                                                "text": "Un signe, un présage assuré."
                                            },
                                            {
                                                "example_id": "c61b59a1-a935-42a3-82d7-782eeefcb1a5",
                                                "sense_id": "1dd0c437-cc8b-3f5d-b568-61943a313f33",
                                                "text": "Des moyens assurés."
                                            },
                                            {
                                                "example_id": "c654ed0e-2578-43c4-ba38-fffa27347207",
                                                "sense_id": "1dd0c437-cc8b-3f5d-b568-61943a313f33",
                                                "text": "Si ça continue comme ça avec les Diables Rouges, c'est la descente assurée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a977547e-d04c-31ef-80cd-af6d899aa9a6",
                                        "entry_id": "908c28fe-0106-3ad4-8e4d-197247300792",
                                        "glosses": [
                                            "Qui est hardi, sans crainte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffe30b03-4535-47a9-abab-f834f116b91e",
                                                "sense_id": "a977547e-d04c-31ef-80cd-af6d899aa9a6",
                                                "text": "Mine assurée."
                                            },
                                            {
                                                "example_id": "e3e502c1-5b7f-4655-bef4-0955ade114da",
                                                "sense_id": "a977547e-d04c-31ef-80cd-af6d899aa9a6",
