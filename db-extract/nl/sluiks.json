                                        "entry_id": "dca0d7cb-d205-3c4b-9431-765569e83789",
                                        "glosses": [
                                            "In a secret or covert manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d893cd1f-1477-4be9-9186-62bbb949a535",
                                                "sense_id": "2c7d8162-217e-3ab4-a0f3-1d31f270f24f",
                                                "text": "In another moment, Louisa's arms were around her also, welcoming her to Violet Lodge, and pouring on her a thousand thanks, yet asking, with trepidation, \"have you brought the dear girls clandestinely?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7f18ada-6eca-38e8-96bb-09c4b5769d87",
                                        "entry_id": "dca0d7cb-d205-3c4b-9431-765569e83789",
                                        "glosses": [
                                            "In an illicit way, i.e. not permitted by the law or regulations."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cfcecfe-508e-4b14-94a8-b5ea5e8eafb3",
