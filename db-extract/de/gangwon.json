                "senses": [
                    {
                        "sense_id": "3d0412e8-6edb-364b-8493-3950b5984d75",
                        "entry_id": "7e121218-0f93-3bb9-9bff-d1402a1088f9",
                        "glosses": [
                            "Provinz im Nordosten von Südkorea"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f634719-53aa-42a2-9960-d58fd5b939f5",
                                "sense_id": "3d0412e8-6edb-364b-8493-3950b5984d75",
                                "text": "„Ich überlegte, wie weit Gangwon entfernt sein könnte.“"
                            },
                            {
                                "example_id": "86e26c34-9eb0-4b19-b080-5323f8ed581e",
                                "sense_id": "3d0412e8-6edb-364b-8493-3950b5984d75",
                                "text": "„›Warum isst du nicht? Weißt du nicht, wie gut die Kartoffeln aus der Provinz Gangwon schmecken?‹“"
                            },
                            {
                                "example_id": "9cf3ce1d-d2c5-4b2a-bf0e-f7c639ac716e",
                                "sense_id": "3d0412e8-6edb-364b-8493-3950b5984d75",
                                "text": "„In der Provinz Gangwon sei er von einem südkoreanischen Wachposten in Gewahrsam genommen worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5880d3ad-ec3d-41ee-9e5c-caf5cb798d00",
                        "source_entry_id": "7e121218-0f93-3bb9-9bff-d1402a1088f9",
                        "source_sense_id": "3d0412e8-6edb-364b-8493-3950b5984d75",
                        "source_sense_description": "südkoreanische Provinz",
                        "target_lang_word": "江原",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a1fb223f-df67-4fc8-ac9e-3b2419043d9a",
                        "source_entry_id": "7e121218-0f93-3bb9-9bff-d1402a1088f9",
                        "source_sense_id": "3d0412e8-6edb-364b-8493-3950b5984d75",
                        "source_sense_description": "südkoreanische Provinz",
                        "target_lang_word": "Gangwon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gangwon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44133255-9409-3676-9e91-af5f04d6c972",
                                        "entry_id": "27dd6933-27e4-3fcb-998f-b37afe370fbd",
                                        "glosses": [
                                            "A special self-governing province in South Korea. Capital: Chuncheon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "820bd3bb-fa41-4ce8-a7dd-19e82e413bac",
                                                "sense_id": "44133255-9409-3676-9e91-af5f04d6c972",
                                                "text": "GOHAN — This town in Jeongseon (Jungsun) County, Gangwon (Kangwon) Province, in five years may be the hub of one of Asia's greatest vacation destinations."
                                            },
                                            {
                                                "example_id": "a0682a29-0876-4a25-9e08-7ae76fe646ce",
                                                "sense_id": "44133255-9409-3676-9e91-af5f04d6c972",
                                                "text": "Seoraksan, the “Snow Peak Mountain,” is now more formally known as Seoraksan National Park ⑫ (daily). In fact, it is not a lone mountaintop, but rather a series of peaks in the mid-section of the spectacular Baekdudaegan or “Great White Range,” South Korea’s most prominent geographical region. This panoramic backbone of South Korea’s Gangwon province is a tourist destination that actually lives up to its public relations hype."
                                            },
                                            {
                                                "example_id": "d327981c-6a5f-4df7-9a39-57b0b4b39e64",
                                                "sense_id": "44133255-9409-3676-9e91-af5f04d6c972",
                                                "text": "Meanwhile, women who have suffered from violence perceive that they are at fault for their husband’s violence and experience shame and guilt. For example, explaining domestic violence in South Korea’s Gangwon province, the following has been noted: “In Gangwon, a patriarchal aspect still remains, and there is a tendency to view living with violence as shameful\" (Paik, 2004)."
                                            },
                                            {
                                                "example_id": "ebed9842-33a4-4356-9df3-5e0c5486d6df",
                                                "sense_id": "44133255-9409-3676-9e91-af5f04d6c972",
                                                "text": "The Pyeongchang Winter Games are spread across South Korea’s Gangwon Province, a rural region that few overseas had heard of until its hard-fought bid to be an Olympic host — a massively expensive proposition with dubious payoff, now typically dared only by world-class cities and established resort towns. Its organizers touted it as an opportunity to invest in much-needed infrastructure and transportation upgrades — and with it, restore a sense of pride and purpose.[…]\n“We always say that Gangwon Province will be crushed under a pile of debt after the Olympics,” says Kim Jin-tae, a 72-year-old former miner. “This will be a deficit for Gangwon.”"
                                            },
                                            {
                                                "example_id": "ff464c3d-fa19-4bf8-beb6-5a46807d6794",
                                                "sense_id": "44133255-9409-3676-9e91-af5f04d6c972",
                                                "text": "South Korea’s northernmost province, Gangwon, two hours northeast, is a sensible first stop, not to mention the scenic shooting locale for “Okja,” a 2017 movie by the “Parasite” director, Bong Joon Ho, about a lovable pig raised on a lush mountaintop farm. Gangwon is pressed up against the infamous DMZ (Demilitarized Zone), a 160 mile-long, 2.5 mile-wide buffer zone between North Korea and South Korea."
                                            },
                                            {
                                                "example_id": "68b43aeb-154e-41b6-98e6-871ca2cbe413",
                                                "sense_id": "44133255-9409-3676-9e91-af5f04d6c972",
                                                "text": "Gangwon State is a new name that was created on June 11, 2023, after 628 years.\nThe area of Gangwon State is 16,875㎢, which is 16.7% of the total area of Korea."
                                            },
                                            {
                                                "example_id": "bb3b2f1c-7707-4417-be85-a2c2ba37759d",
                                                "sense_id": "44133255-9409-3676-9e91-af5f04d6c972",
                                                "text": "In a statement issued on January 23, six days after the official opening ceremony in the South Korean province of Gangwon, the National Federation of Parents' Organizations demanded that no more condoms should be handed out and that the organizing committee issue an official apology."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
