                "senses": [
                    {
                        "sense_id": "1f607d2a-8100-3646-9082-dd38b01ae68d",
                        "entry_id": "46c7dd64-8a06-36b0-a56e-260b3c6dc471",
                        "glosses": [
                            "The space between merlons in a crenelated battlement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdf788a8-43df-4ff9-b3a5-830ee5cd0f97",
                                "sense_id": "1f607d2a-8100-3646-9082-dd38b01ae68d",
                                "text": "Near-synonym: embrasure (sometimes hypernymous technically)"
                            },
                            {
                                "example_id": "866a34d0-6428-4853-99a2-d1f652559613",
                                "sense_id": "1f607d2a-8100-3646-9082-dd38b01ae68d",
                                "text": "They would wake Lord Bolton and search Harrenhal from crenel to cellar, and when they did they would find the map and the dagger missing, […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7abdbdd3-3cbd-4852-98b4-1afbae6f68d3",
                        "source_entry_id": "46c7dd64-8a06-36b0-a56e-260b3c6dc471",
                        "source_sense_id": "1f607d2a-8100-3646-9082-dd38b01ae68d",
                        "source_sense_description": "space between merlons",
                        "target_lang_word": "créneau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "créneau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Espace entre deux merlons en haut d’un rempart, pour tirer sur l'ennemi, tout en restant abrité de son tir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f85bfd0-322b-472b-ab19-54f4fa578ea8",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "L’unique fenêtre s’ouvrait sur une petite terrasse surmontant la tourelle, […] mais elle vit bientôt qu’elle ne communiquait avec aucune partie des créneaux."
                                            },
                                            {
                                                "example_id": "343d1d38-8fda-4a44-9e78-8497f97da186",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "Elle se penche entre les noirs créneaux de moment en moment, et observe d'un oeil attentif l'ennemi dans son camp."
                                            },
                                            {
                                                "example_id": "133f8fc6-e052-4c3d-a025-b0caf3c3a693",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "Or, cette surélévation est construite en pierres avec bossages, les créneaux sont plus espacés, l’appareil beaucoup plus soigné que dans la partie inférieure."
                                            },
                                            {
                                                "example_id": "89b71505-3669-4484-a324-675251e11b99",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "Cela fait, le gars aux biques alla se poster à un créneau et se mit à envoyer aux tirailleurs allemands des balles bien dirigées."
                                            },
                                            {
                                                "example_id": "a7f77566-c405-43a7-ae20-9b422165d234",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "La loge du concierge figure une tour carrée, avec une plate-forme à créneaux, garnie d'échauguettes."
                                            },
                                            {
                                                "example_id": "8fa31f00-1474-4242-9824-ec99aec340d1",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "Il passa une heure entière à se promener dans le hall, allant d’une pièce à l’autre, dans un silence fortifié, par les créneaux duquel il lançait parfois un regard éperdu, ne voulant, ne pouvant rien dire à personne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceca25f7-0f49-36cd-90d6-a04cf6e67d00",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Ouverture faite au parapet des tranchées, par lesquelles on peut tirer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ff88a18-098d-3a24-a97d-51cb8bf5a87f",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Intervalle que les pelotons laissent entre eux dans l’ordre de bataille et où se placent les chefs de peloton."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e53abbc4-45c8-3e91-9fb6-7108821e8354",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Manœuvre pour mettre en stationnement le long d’un trottoir, un véhicule entre deux autres déjà stationnés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a73397c3-24c8-4d96-b701-5e3e1104c715",
                                                "sense_id": "e53abbc4-45c8-3e91-9fb6-7108821e8354",
                                                "text": "Dans les livres de code de la route, il y a trois types de stationnement : en épi, en bataille ou en créneau."
                                            },
                                            {
                                                "example_id": "fce8cf46-cd00-402c-a34a-6b8916d97082",
                                                "sense_id": "e53abbc4-45c8-3e91-9fb6-7108821e8354",
                                                "text": "Rater un créneau le jour du permis, ça peut être éliminatoire."
                                            },
                                            {
                                                "example_id": "7ff9f711-4415-4ebf-afe1-947e02457096",
                                                "sense_id": "e53abbc4-45c8-3e91-9fb6-7108821e8354",
                                                "text": "Certains modèles sont équipés de systèmes électroniques qui aident le conducteur à faire son créneau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbb7c54f-5145-3ad1-a3d2-24256c61e5a8",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Place disponible sur le marché, segment où peut être exploité un type de produit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54e91585-6d85-4e55-a082-3bd7e01675a1",
                                                "sense_id": "cbb7c54f-5145-3ad1-a3d2-24256c61e5a8",
                                                "text": "A peine moins pessimistes, nombre d’économistes se préoccupent surtout du retard pris par l’Europe en matière d’innovation – au risque de rater les créneaux du futur, comme celui de l’intelligence artificielle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57daf438-cef0-369f-92c5-dcd676e542b6",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Intervalle de temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a3aa80c-9ffb-4ef0-a88c-2d9cb0eab787",
                                                "sense_id": "57daf438-cef0-369f-92c5-dcd676e542b6",
                                                "text": "Notre emploi du temps divise la journée de travail en 5 créneaux."
                                            },
                                            {
                                                "example_id": "beb66212-61ed-48f6-b106-1f423ae8de3c",
                                                "sense_id": "57daf438-cef0-369f-92c5-dcd676e542b6",
                                                "text": "Il y a forcément un créneau qu'on va trouver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcab2a12-2672-3664-82ba-ed00f5c10567",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Emplacement destiné à recevoir un conteneur sur un porte-conteneurs."
                                        ],
                                        "tags": [
                                            "Transport maritime"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f34b7b3-b7fc-32be-96df-f12f075c32e3",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Créneau horaire."
                                        ],
                                        "tags": [
                                            "Transport aérien"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
