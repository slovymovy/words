                            {
                                "example_id": "00549f60-dfa4-4e36-a4e0-9bdb3b4776ce",
                                "sense_id": "51f82afb-d988-3c06-b770-7131ae5bc917",
                                "text": "État monosyllabique et isolatif des langues, état où les racines sont employées comme des mots tout à fait indépendants les uns des autres et sans la moindre altération."
                            }
                        ]
                    },
                    {
