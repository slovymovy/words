                        "entry_id": "cfbdba50-b03d-3382-baf7-02b3566c9d36",
                        "glosses": [
                            "voorzien van voldoende hulpmiddelen en vaardigheden om een bepaalde taak naar behoren te kunnen vervullen"
                        ],
