                {
                    "sense_id": "8d41a470-a04d-373b-be24-7056e52e8239",
                    "sense_definition": "То, что является источником чего-либо, или то, что дорого и близко (обычно о Родине или земле).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Солдаты сражались за Родину-<мать>.",
                            "target_lang_translations": {
                                "en": "The soldiers fought for the <Mother>land.",
                                "nl": "De soldaten vochten voor het <Moeder>land.",
                                "zh": "士兵们为祖国<w>母亲</w>而战。",
                                "pl": "Żołnierze walczyli za Ojczyznę-<matkę>.",
                                "de": "Die Soldaten kämpften für die <w>Mutter</w> Heimat.",
                                "fr": "Les soldats se sont battus pour la <mère> patrie.",
                                "it": "I soldati combattevano per la Patria <madre>.",
                                "cs": "Vojáci bojovali za vlast <matku>.",
                                "tr": "Askerler vatan <w>ana</w> için savaştılar.",
                                "es": "Los soldados lucharon por la <madre> patria."
                            }
                        },
                        {
                            "text": "Фермеры надеются, что <мать>-земля даст хороший урожай.",
                            "target_lang_translations": {
                                "en": "Farmers hope that <Mother> Earth will yield a good harvest.",
                                "nl": "Boeren hopen dat <moeder> aarde een goede oogst zal geven.",
                                "zh": "农民们希望大地<w>母亲</w>能带来好收成。",
                                "pl": "Rolnicy mają nadzieję, że <matka> ziemia da dobre plony.",
                                "de": "Die Bauern hoffen, dass <w>Mutter</w> Erde eine gute Ernte schenkt.",
                                "fr": "Les fermiers espèrent que la <mère> terre donnera une bonne récolte.",
                                "it": "Gli agricoltori sperano che <madre> terra dia un buon raccolto.",
                                "cs": "Zemědělci doufají, že <matka> země dá dobrou úrodu.",
                                "tr": "Çiftçiler toprak <w>ana</w> bereketinin iyi bir hasat getireceğini umuyorlar.",
                                "es": "Los agricultores esperan que la <madre> tierra dé una buena cosecha."
                            }
                        }
                    ],
