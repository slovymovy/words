                "word": "stewardess",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1fdc8c85-87eb-4f08-9be2-67d2e4012793",
                        "entry_id": "2340a23e-b1bc-3429-8323-133f0d2a4e30",
