                        "glosses": [
                            "vrouwelijke winnaar van een wedstrijd om het wereldkampioenschap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a575b782-a836-4a9f-a7ad-47e1815e4b05",
                                "sense_id": "ea81db54-8127-3219-a07a-b2b455089694",
                                "text": "Ceylin del Carmen Alvaradois is de wereldkampioene in het veldrijden, maar mag vanwege haar leeftijd (22) nog meedoen bij de beloftes. En dat deed ze bij de NK mountainbike heel succesvol."
                            },
                            {
                                "example_id": "8f07b7ee-f7ee-4d03-b1af-c6211f9fc733",
                                "sense_id": "ea81db54-8127-3219-a07a-b2b455089694",
                                "text": "De Nederlandse atlete behoorde in 2020 evenals vorig jaar tot de vijf finalisten die kans maakten op de eretitel. Hassan, de tweevoudig wereldkampioene van Doha 2019, verpulverde begin september in Brussel het werelduurrecord en bracht het op 18,930 kilometer."
                            }
                        ]
                    }
