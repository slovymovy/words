{
    "word_family": [
        "mineralogie",
        "mineraloog",
        "mineralogisch",
        "mineraliseren",
        "mineralisatie"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c64b2bf7-5a2b-3f2a-863a-ff4aebc96d64",
                    "sense_definition": "anorganische stof die het menselijk lichaam in kleine hoeveelheden nodig heeft om gezond te blijven",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Groenten en fruit leveren belangrijke vitaminen en een nuttig <w>mineraal</w> zoals ijzer.",
                            "target_lang_translations": {
                                "zh": "蔬菜和水果能提供重要的维生素以及铁等有益的<w>矿物质</w>。"
                            }
                        },
                        {
                            "text": "Ons lichaam heeft verschillende soorten <w>mineralen</w> nodig voor sterke botten en tanden.",
                            "target_lang_translations": {
                                "zh": "我们的身体需要各种<w>矿物质</w>来强健骨骼和牙齿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "voedingszout"
                    ],
                    "common_phrases": [
                        "vitaminen en mineralen"
                    ],
                    "target_lang_definitions": {
                        "zh": "人体为保持健康所需微量摄入的无机营养物质"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "矿物质",
                                "target_lang_sense_clarification": "人体所需的无机营养成分"
                            },
                            {
                                "target_lang_word": "无机盐",
                                "target_lang_sense_clarification": "生物体内的矿物质无机成分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c566267-9a24-3cef-ba22-770e661ca095",
                    "sense_definition": "van nature voorkomende, vaste en anorganische stof met een bepaalde chemische samenstelling en kristalstructuur",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit museum vind je een grote collectie van zeldzame gesteenten en elk bijzonder <w>mineraal</w>.",
                            "target_lang_translations": {
                                "zh": "在这座博物馆里，你可以看到大量稀有岩石以及各种奇特<w>矿物</w>的展藏。"
                            }
                        },
                        {
                            "text": "Kwarts is een veelvoorkomend <w>mineraal</w> in de aardkorst.",
                            "target_lang_translations": {
                                "zh": "石英是地壳中非常常见的一种<w>矿物</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "delfstof"
                    ],
                    "target_lang_definitions": {
                        "zh": "地质作用形成的天然单质或化合物，通常具有固定的化学成分和晶体结构"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "矿物",
                                "target_lang_sense_clarification": "天然地质晶体或固态化合物"
                            },
                            {
                                "target_lang_word": "矿石",
                                "target_lang_sense_clarification": "含有矿物的岩石"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8a74204a-17aa-3bde-9ade-4bbd75e61554",
                    "sense_definition": "betrekking hebbend op delfstoffen of anorganische stoffen; afkomstig uit de aarde",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik bestel liever een glas <w>mineraal</w> water dan een zoete frisdrank.",
                            "target_lang_translations": {
                                "zh": "相比含糖汽水，我更愿意点一杯<w>矿泉</w>水。"
                            }
                        },
                        {
                            "text": "Deze fabriek verwerkt verschillende stoffen van een zuiver <w>minerale</w> oorsprong.",
                            "target_lang_translations": {
                                "zh": "这家工厂加工多种纯<w>矿物</w>来源的原材料。"
                            }
                        }
                    ],
                    "synonyms": [
                        "anorganisch"
                    ],
                    "antonyms": [
                        "organisch"
                    ],
                    "common_phrases": [
                        "mineraal water",
                        "minerale oliën"
                    ],
                    "target_lang_definitions": {
                        "zh": "矿物的；无机的；含有矿物质的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "矿物的",
                                "target_lang_sense_clarification": "与矿物相关的"
                            },
                            {
                                "target_lang_word": "矿质的",
                                "target_lang_sense_clarification": "指含矿物质的性质"
                            },
                            {
                                "target_lang_word": "矿物",
                                "target_lang_sense_clarification": "用作定语修饰水、油等"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}