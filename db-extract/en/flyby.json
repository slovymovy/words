                        "translation_id": "a9af56af-7dc1-4c22-941b-e4f34e89358f",
                        "source_entry_id": "2ff17217-9eac-3ce1-b2c6-c626b6e130da",
                        "source_sense_description": "ceremonial low-level flight",
                        "target_lang_word": "Tiefflug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tiefflug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74475c8a-f9b6-35fa-ade4-27818c84aaa5",
                                        "entry_id": "bd6c4a88-bfd7-3751-9334-146848eb7e6d",
                                        "glosses": [
                                            "Flug in geringer Höhe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32362907-295f-41e3-b958-35c27a50014a",
                                                "sense_id": "74475c8a-f9b6-35fa-ade4-27818c84aaa5",
                                                "text": "„Endlich, am späten Nachmittag, kamen Flugzeuge, einige Spitfire und Mustangs, die aus Richtung Flensburg oder Schleswig hereindrehten, um im Tiefflug über uns hinwegzuflitzen und auf die Nordsee hinaus zu verschwinden.“"
                                            },
                                            {
                                                "example_id": "b43d4c0c-382a-4123-bdf7-da9a28f07639",
                                                "sense_id": "74475c8a-f9b6-35fa-ade4-27818c84aaa5",
                                                "text": "„Der Ablauf des riskanten illegalen Tiefflugs der beiden amerikanischen Piloten, die Umstände der Videoaufzeichnung, eine verbreitete Mentalität in der US-Armee, die lebendige internationale Fliegertradition legen es nahe, von einem fehlgeschlagenen Versuch auszugehen, sich mit einem beweisbaren Mutakt, dem Unterfliegen einer Seilbahn, als unverwüstliche Draufgänger auszuweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
