{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f4161e3-617f-3ce6-a055-42e0d442a309",
                    "sense_definition": "An aircraft without a human pilot on board, operated by remote control or computers.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_uav",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The military used a <w>drone</w> to survey the area.",
                            "target_lang_translations": {
                                "ru": "Военные использовали <w>дрон</w> для осмотра местности.",
                                "zh": "军方使用<w>无人机</w>对该地区进行了勘察。",
                                "es": "El ejército utilizó un <w>dron</w> para inspeccionar la zona."
                            }
                        },
                        {
                            "text": "He bought a camera <w>drone</w> to take aerial photos of the wedding.",
                            "target_lang_translations": {
                                "ru": "Он купил <w>дрон</w> с камерой, чтобы сделать фотографии свадьбы с воздуха.",
                                "zh": "他买了一台航拍<w>无人机</w>来拍摄婚礼的空中照片。",
                                "es": "Compró un <w>dron</w> con cámara para tomar fotos aéreas de la boda."
                            }
                        }
                    ],
                    "synonyms": [
                        "UAV"
                    ],
                    "common_phrases": [
                        "fly a drone",
                        "drone strike",
                        "surveillance drone",
                        "camera drone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспилотный летательный аппарат, управляемый дистанционно или компьютером.",
                        "zh": "一种无人驾驶的飞行器，通过遥控或计算机程序进行操作。",
                        "es": "Aeronave sin piloto a bordo, operada por control remoto o computadoras."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрон",
                                "target_lang_sense_clarification": "летательный аппарат"
                            },
                            {
                                "target_lang_word": "беспилотник",
                                "target_lang_sense_clarification": "разг. беспилотный аппарат"
                            },
                            {
                                "target_lang_word": "БПЛА",
                                "target_lang_sense_clarification": "воен. аббревиатура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无人机",
                                "target_lang_sense_clarification": "无人驾驶飞行器"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "dron",
                                "target_lang_sense_clarification": "término estándar para vehículo aéreo no tripulado"
                            },
                            {
                                "target_lang_word": "vehículo aéreo no tripulado",
                                "target_lang_sense_clarification": "término técnico o formal (VANT)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1158fcb0-38cf-3d2e-a7e7-f3610cc8eaba",
                    "sense_definition": "A continuous low humming or buzzing sound.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could hear the steady <w>drone</w> of the airplane engine.",
                            "target_lang_translations": {
                                "ru": "Мы слышали ровный <w>гул</w> двигателя самолета.",
                                "zh": "我们能听到飞机引擎持续的<w>轰鸣声</w>。",
                                "es": "Podíamos escuchar el <w>zumbido</w> constante del motor del avión."
                            }
                        },
                        {
                            "text": "The monotonous <w>drone</w> of the fan made it hard to concentrate.",
                            "target_lang_translations": {
                                "ru": "Монотонное <w>жужжание</w> вентилятора мешало сосредоточиться.",
                                "zh": "风扇单调的<w>嗡嗡声</w>让人难以集中注意力。",
                                "es": "El <w>zumbido</w> monótono del ventilador dificultaba la concentración."
                            }
                        }
                    ],
                    "common_phrases": [
                        "monotonous drone",
                        "low drone",
                        "steady drone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывный низкий гудящий или жужжащий звук.",
                        "zh": "一种持续的低沉嗡嗡声。",
                        "es": "Un sonido bajo, continuo y monótono."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гул",
                                "target_lang_sense_clarification": "низкий, монотонный звук"
                            },
                            {
                                "target_lang_word": "жужжание",
                                "target_lang_sense_clarification": "звук насекомых или механизмов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嗡嗡声",
                                "target_lang_sense_clarification": "持续的低沉声音"
                            },
                            {
                                "target_lang_word": "轰鸣声",
                                "target_lang_sense_clarification": "机器发出的持续低音"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "zumbido",
                                "target_lang_sense_clarification": "sonido continuo y bronco"
                            },
                            {
                                "target_lang_word": "murmullo",
                                "target_lang_sense_clarification": "sonido sordo e indistinto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "972178e7-78a9-3b9f-a5f5-f53f9b9b18a0",
                    "sense_definition": "A male bee, ant, or wasp that does not gather food but functions to fertilize the queen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_insect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>drone</w> does not collect pollen like the worker bees.",
                            "target_lang_translations": {
                                "ru": "<w>Трутень</w> не собирает пыльцу, как рабочие пчелы.",
                                "zh": "<w>雄蜂</w>不像工蜂那样采集花粉。",
                                "es": "El <w>zángano</w> no recolecta polen como las abejas obreras."
                            }
                        },
                        {
                            "text": "In the hive, the <w>drones</w> are often driven out before winter.",
                            "target_lang_translations": {
                                "ru": "В улье <w>трутней</w> часто изгоняют перед зимой.",
                                "zh": "在蜂巢里，<w>雄蜂</w>通常在冬天来临前被赶走。",
                                "es": "En la colmena, a menudo expulsan a los <w>zánganos</w> antes del invierno."
                            }
                        }
                    ],
                    "common_phrases": [
                        "worker bees and drones"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самец пчелы, муравья или осы, который не собирает пищу, а служит для оплодотворения матки.",
                        "zh": "蜂群中不采集花粉、专门负责与蜂王交配的雄蜂。",
                        "es": "Macho de la abeja, avispa o avispero que no recolecta alimento y cuya función es fecundar a la reina."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трутень",
                                "target_lang_sense_clarification": "самец пчелы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "雄蜂",
                                "target_lang_sense_clarification": "蜂群中的雄性个体"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "zángano",
                                "target_lang_sense_clarification": "macho de la abeja"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "242e4845-2e60-3956-b949-f4e8d762aea8",
                    "sense_definition": "A person who performs menial, tedious work.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_insect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like just another corporate <w>drone</w> sitting in a cubicle all day.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя просто очередным корпоративным <w>винтиком</w>, сидящим в кабинке весь день.",
                                "zh": "他觉得自己就像个整天坐在隔间里的<w>社畜</w>。",
                                "es": "Se sentía como otro <w>zángano</w> corporativo sentado en un cubículo todo el día."
                            }
                        },
                        {
                            "text": "The manager treated them like mindless <w>drones</w> rather than skilled employees.",
                            "target_lang_translations": {
                                "ru": "Менеджер обращался с ними как с безмозглыми <w>роботами</w>, а не как с квалифицированными сотрудниками.",
                                "zh": "经理把他们当作没思想的<w>工具人</w>，而不是技术员工。",
                                "es": "El gerente los trataba como <w>autómatas</w> sin cerebro en lugar de empleados cualificados."
                            }
                        }
                    ],
                    "synonyms": [
                        "drudge"
                    ],
                    "common_phrases": [
                        "office drone",
                        "corporate drone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, выполняющий черную, утомительную работу; бездумный исполнитель.",
                        "zh": "指从事枯燥、机械性工作的员工，常带有贬义。",
                        "es": "Persona que realiza un trabajo monótono, repetitivo o de poco valor."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "винтик",
                                "target_lang_sense_clarification": "перен. мелкий работник"
                            },
                            {
                                "target_lang_word": "робот",
                                "target_lang_sense_clarification": "перен. бездумный исполнитель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "社畜",
                                "target_lang_sense_clarification": "形容被公司压榨的员工"
                            },
                            {
                                "target_lang_word": "工具人",
                                "target_lang_sense_clarification": "指被当作工具使用的员工"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "zángano",
                                "target_lang_sense_clarification": "persona inútil o holgazana"
                            },
                            {
                                "target_lang_word": "autómata",
                                "target_lang_sense_clarification": "persona que actúa sin pensar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22ed5194-3ef9-3d22-a2d8-a582e7116077",
                    "sense_definition": "To make a continuous low humming sound.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The refrigerator <w>droned</w> loudly in the quiet kitchen.",
                            "target_lang_translations": {
                                "ru": "Холодильник громко <w>гудел</w> в тихой кухне.",
                                "zh": "冰箱在安静的厨房里大声地<w>嗡嗡作响</w>。",
                                "es": "El refrigerador <w>zumbaba</w> ruidosamente en la cocina silenciosa."
                            }
                        },
                        {
                            "text": "An airplane <w>droned</w> overhead as we lay on the grass.",
                            "target_lang_translations": {
                                "ru": "Самолет <w>гудел</w> над головой, пока мы лежали на траве.",
                                "zh": "当我们躺在草地上时，一架飞机在头顶<w>轰鸣</w>而过。",
                                "es": "Un avión <w>zumbaba</w> sobre nuestras cabezas mientras estábamos tumbados en la hierba."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать непрерывный низкий гудящий звук.",
                        "zh": "发出持续的低沉嗡嗡声。",
                        "es": "Emitir un sonido bajo, continuo y vibrante."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гудеть",
                                "target_lang_sense_clarification": "издавать низкий звук"
                            },
                            {
                                "target_lang_word": "жужжать",
                                "target_lang_sense_clarification": "издавать вибрирующий звук"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嗡嗡作响",
                                "target_lang_sense_clarification": "发出持续低音"
                            },
                            {
                                "target_lang_word": "轰鸣",
                                "target_lang_sense_clarification": "机器发出持续响声"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "zumbar",
                                "target_lang_sense_clarification": "emitir un zumbido"
                            },
                            {
                                "target_lang_word": "zumborear",
                                "target_lang_sense_clarification": "hacer un ruido continuo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1404ba5-3adb-37b2-9c4c-403988a3b6f7",
                    "sense_definition": "To speak in a boring, monotonous tone for a long time.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lecturer <w>droned</w> on for hours about the history of taxation.",
                            "target_lang_translations": {
                                "ru": "Лектор часами <w>бубнил</w> об истории налогообложения.",
                                "zh": "讲师就税收历史<w>喋喋不休</w>地讲了几个小时。",
                                "es": "El profesor <w>monologó</w> durante horas sobre la historia de los impuestos."
                            }
                        },
                        {
                            "text": "She stopped listening as he continued to <w>drone</w> about his problems.",
                            "target_lang_translations": {
                                "ru": "Она перестала слушать, так как он продолжал <w>нудить</w> о своих проблемах.",
                                "zh": "当他继续<w>絮叨</w>自己的问题时，她不再听了。",
                                "es": "Ella dejó de escuchar mientras él seguía <w>hablando monótonamente</w> sobre sus problemas."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drone on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить скучным, монотонным тоном в течение долгого времени.",
                        "zh": "长时间以单调、乏味的语调说话。",
                        "es": "Hablar de manera aburrida y monótona durante mucho tiempo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бубнить",
                                "target_lang_sense_clarification": "говорить монотонно"
                            },
                            {
                                "target_lang_word": "нудить",
                                "target_lang_sense_clarification": "разг. надоедливо говорить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喋喋不休",
                                "target_lang_sense_clarification": "唠叨且令人厌烦"
                            },
                            {
                                "target_lang_word": "絮叨",
                                "target_lang_sense_clarification": "单调地重复说话"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "monologar",
                                "target_lang_sense_clarification": "hablar sin parar"
                            },
                            {
                                "target_lang_word": "hablar con monotonía",
                                "target_lang_sense_clarification": "expresión descriptiva"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3bcc3d5-cfbf-37b1-8474-08130db59bf1",
                    "sense_definition": "To attack or target with an unmanned aerial vehicle.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_uav",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government was criticized for <w>droning</w> targets in civilian areas.",
                            "target_lang_translations": {
                                "ru": "Правительство критиковали за <w>атаки дронами</w> по целям в гражданских районах.",
                                "zh": "政府因在平民区进行<w>无人机空袭</w>而受到批评。",
                                "es": "El gobierno fue criticado por <w>atacar con drones</w> objetivos en zonas civiles."
                            }
                        },
                        {
                            "text": "Modern warfare increasingly involves <w>droning</w> enemy positions from a distance.",
                            "target_lang_translations": {
                                "ru": "Современная война все чаще включает <w>удары беспилотниками</w> по позициям врага с расстояния.",
                                "zh": "现代战争越来越多地涉及从远处对敌方阵地进行<w>无人机空袭</w>。",
                                "es": "La guerra moderna implica cada vez más <w>atacar con drones</w> posiciones enemigas a distancia."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Атаковать или выслеживать с помощью беспилотного летательного аппарата.",
                        "zh": "使用无人机对目标进行攻击。",
                        "es": "Atacar o alcanzar objetivos mediante el uso de vehículos aéreos no tripulados."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "атаковать дроном",
                                "target_lang_sense_clarification": "использовать БПЛА для удара"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无人机空袭",
                                "target_lang_sense_clarification": "使用无人机进行军事打击"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "atacar con drones",
                                "target_lang_sense_clarification": "acción militar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b9b27faa-3cd0-370b-9331-fec8879466cf",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Drone</w> signed the documents yesterday.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Дроун</w> подписал документы вчера.",
                                "zh": "<w>德罗恩</w>先生昨天签署了文件。",
                                "es": "El señor <w>Drone</w> firmó los documentos ayer."
                            }
                        },
                        {
                            "text": "I met a family named <w>Drone</w> while visiting the village.",
                            "target_lang_translations": {
                                "ru": "Я встретил семью по фамилии <w>Дроун</w>, когда посещал деревню.",
                                "zh": "我在访问那个村庄时遇到了一户姓<w>德罗恩</w>的人家。",
                                "es": "Conocí a una familia llamada <w>Drone</w> mientras visitaba el pueblo."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。",
                        "es": "Un apellido."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дроун",
                                "target_lang_sense_clarification": "транслитерация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "德罗恩",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "Drone",
                                "target_lang_sense_clarification": "apellido (se mantiene igual)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}