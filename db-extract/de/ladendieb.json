                    }
                ],
                "senses": [
                    {
                        "sense_id": "02949d67-a4a6-3b10-836c-a682f7ca6972",
                        "entry_id": "5625c1af-635a-3ef0-bc42-7d4e875e6f79",
                        "glosses": [
                            "Person, die in einem Laden Gegenstände mit der Absicht wegnimmt, sich diese widerrechtlich zuzueignen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62676b96-5812-4080-b2b5-21890069eef2",
                                "sense_id": "02949d67-a4a6-3b10-836c-a682f7ca6972",
                                "text": "Ein Ladendieb hat im Supermarkt vier Eier gestohlen."
                            },
                            {
                                "example_id": "8a51a4d9-a8f1-499e-8fd1-2562644bfb6c",
                                "sense_id": "02949d67-a4a6-3b10-836c-a682f7ca6972",
                                "text": "„Auch für mich ist der Onkel kein Ladendieb.“"
                            },
                            {
                                "example_id": "7aa3e852-a48f-4899-b092-b8d9424ec385",
                                "sense_id": "02949d67-a4a6-3b10-836c-a682f7ca6972",
                                "text": "„Gleich drei Ladendiebe erwischte ein Ladendetektiv in einem Verbrauchermarkt in der Rosenberger Straße am Montag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f41b47a-8a8c-4365-aa59-47e555896138",
                        "source_entry_id": "5625c1af-635a-3ef0-bc42-7d4e875e6f79",
                        "source_sense_id": "02949d67-a4a6-3b10-836c-a682f7ca6972",
                        "source_sense_description": "Person, die in einem Laden Gegenstände mit der Absicht wegnimmt, sich diese widerrechtlich zuzueignen",
                        "target_lang_word": "shoplifter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shoplifter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffebacf0-88b6-3cbc-a07b-898e95ea75ec",
                                        "entry_id": "cb4580d5-8aee-3293-aa97-b85c687b489d",
                                        "glosses": [
                                            "A person who shoplifts, one who steals from shops."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ccefbf7-eea9-4e21-aa26-33e55c24b901",
                                                "sense_id": "ffebacf0-88b6-3cbc-a07b-898e95ea75ec",
                                                "text": "Shoplifters will be prosecuted."
                                            },
                                            {
                                                "example_id": "37aa25d6-123f-4b5c-9a5c-4e4365a3515d",
                                                "sense_id": "ffebacf0-88b6-3cbc-a07b-898e95ea75ec",
                                                "text": "The shoplifters are much less to be dreaded than the sneak, as they do not carry off cash, rarely any very valuable property […]"
                                            },
                                            {
                                                "example_id": "eaba9b81-d605-4e74-b7a2-e79fe313623e",
                                                "sense_id": "ffebacf0-88b6-3cbc-a07b-898e95ea75ec",
                                                "text": "Like their friends the \"draggers,\" the \"hoisters\" or shoplifters are having a thin time these days, […]"
                                            },
                                            {
                                                "example_id": "94f051b1-e513-447d-84a0-cbe805cef85b",
                                                "sense_id": "ffebacf0-88b6-3cbc-a07b-898e95ea75ec",
                                                "text": "[…] just as the unchastised teenage shoplifter, mistaking society’s indulgence for applause, will evolve into a bloodthirsty hired killer, it is inevitable that the author of “The Pencil” will one day morph into the author of “The Toothpick.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41d52a52-5af0-4288-8cc2-647613d6ac31",
                        "source_entry_id": "5625c1af-635a-3ef0-bc42-7d4e875e6f79",
