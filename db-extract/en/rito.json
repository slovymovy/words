                    {
                        "sense_id": "eaa36f83-a8ea-3fc6-bb63-2b730571b361",
                        "entry_id": "9775c2b3-8a01-309e-8a47-63b9e471a2b3",
                        "glosses": [
                            "A stream in the western US."
                        ],
                        "tags": [
                            "US",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fcf1876c-da2d-4a77-9319-a9859e6a74ac",
                                "sense_id": "eaa36f83-a8ea-3fc6-bb63-2b730571b361",
                                "text": "Many small streams and ritos flow down the slopes feeding the Rio Puerco, Chama and Jemez Rivers."
                            },
                            {
                                "example_id": "789268b6-9544-4492-bc4f-3c6588477ad8",
                                "sense_id": "eaa36f83-a8ea-3fc6-bb63-2b730571b361",
                                "text": "[…] to form tiny rills that descended and gathered into larger rititos that rollicked and frollicked as they tumbled down into the ritos that carried the spring run-offs and summer rains across alpine meadows […]"
                            },
                            {
                                "example_id": "47025d10-7baa-4614-9aa4-9adf59b1a571",
                                "sense_id": "eaa36f83-a8ea-3fc6-bb63-2b730571b361",
                                "text": "On this day all the waters of the earth are blessed, the seas, the rivers and the ritos, the clear forest streams and all the muddy acequias meandering through the fields."
                            }
                        ]
                    }
