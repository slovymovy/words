                                        "examples": [
                                            {
                                                "example_id": "81b35cb1-e101-40f1-9777-4e8e0dcf0807",
                                                "sense_id": "ce35351f-2126-38ce-806b-c7ffdd610d59",
                                                "text": "Monsieur, dit-elle, j’ai cédé les guenilles de la rue Chauchat à la petite Héloïse Brisetout de Bixiou ; si vous voulez y réclamer votre bonnet de coton, votre tire-botte, votre ceinture et votre cire à favoris, j’ai stipulé qu’on vous les rendrait."
                                            },
                                            {
                                                "example_id": "ecaf7de1-c39d-4130-b30b-f8db22403787",
                                                "sense_id": "ce35351f-2126-38ce-806b-c7ffdd610d59",
                                                "text": "Il avait pris son temps pour choisir le bois, qu'il était allé voler avec Héloïse et Noël. Du bois de lune, dérobé la nuit, le meilleur qui soit."
                                            },
                                            {
                                                "example_id": "bcddc876-1cd6-41ae-a026-e20193913b0d",
                                                "sense_id": "ce35351f-2126-38ce-806b-c7ffdd610d59",
                                                "text": "Ce qui est recherché de façon collective, c’est un retour symbolique à l’essentiel, au plaisir de l’imprévu, observe Héloïse Van Appelghem."
                                            }
                                        ]
                                    }
