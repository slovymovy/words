                "senses": [
                    {
                        "sense_id": "52229a93-218e-3158-8333-203a701a5ef8",
                        "entry_id": "47b1b08e-ba90-3766-ad39-358bdd3f3997",
                        "glosses": [
                            "untergegangene festlandkeltische Sprache in Kleinasien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "576b1b0c-ec4d-4f73-a830-411094b3c19e",
                                "sense_id": "52229a93-218e-3158-8333-203a701a5ef8",
                                "text": "„Sehr wahrscheinlich wurde bis ins 3./4. Jahrhundert nach Christus hinein Galatisch, die Sprache der Galater in Kleinasien, gesprochen.“"
                            },
                            {
                                "example_id": "2d864cbf-d7dc-44ad-b8cc-047221064c9a",
                                "sense_id": "52229a93-218e-3158-8333-203a701a5ef8",
                                "text": "„Die Kelten, die auf den Balkan und nach Kleinasien zogen, hießen bei den Griechen Galater, und ihre Sprache, das Galatische, hielt sich bis ins 5. Jahrhundert nach Christus.“"
                            }
                        ],
