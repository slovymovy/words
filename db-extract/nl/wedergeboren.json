                                                "sense_id": "799a259c-b2e9-38b5-827e-c6f1a9116d5a",
                                                "text": "To many people a born-again philosophy is a fundamentalist philosophy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d655053-7678-3872-82a4-8af6d8a28308",
                                        "entry_id": "30c97931-1733-3808-b95b-ede4a0933140",
                                        "glosses": [
                                            "Having a newly won zeal for some activity."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e24bbaff-2ba9-47a5-b2ba-225049e808e5",
                                                "sense_id": "0d655053-7678-3872-82a4-8af6d8a28308",
                                                "text": "After not picking up a shovel for twenty years, she finally saw the beauty in flowers and declared herself a born-again gardener."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d20645b-6222-34b2-b866-9604ff01e1e4",
                                        "entry_id": "30c97931-1733-3808-b95b-ede4a0933140",
                                        "glosses": [
                                            "Utter; out-and-out."
