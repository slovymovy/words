                                "target_senses": [
                                    {
                                        "sense_id": "52f00015-fe1b-318d-b207-0ba7930c60ff",
                                        "entry_id": "eb8f49ff-71a2-31a6-85cb-47930f0af8fd",
                                        "glosses": [
                                            "Appareil de rasage utilisé généralement pour raser les poils de barbe. Il se compose d'un ensemble de lames derrière une grille d'une extrême finesse. Les lames sont animées soit d'un mouvement circulaire, soit d'un mouvement linéaire en va-et-vient, par un moteur électrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de6fa070-d0af-4936-bd18-f4785a2d51c5",
                                                "sense_id": "52f00015-fe1b-318d-b207-0ba7930c60ff",
                                                "text": "En 1931, Schick lança le premier rasoir électrique. Son principe dérive de la tondeuse des coiffeurs : un bloc-couteaux animé d'un mouvement transversal sous une grille qui happe les poils en les redressant."
                                            },
                                            {
                                                "example_id": "9146e221-5987-450a-b8d0-02b3fb1ea88f",
                                                "sense_id": "52f00015-fe1b-318d-b207-0ba7930c60ff",
                                                "text": "Ces métaux se retrouvent aussi entre autres dans les brosses à dents et les rasoirs électriques, les écouteurs ou les câbles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
