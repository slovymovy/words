                "senses": [
                    {
                        "sense_id": "6d6aeb2e-6db4-352c-a048-324cb47a68f4",
                        "entry_id": "bb6c6e6e-6e47-32b3-b520-119f6db98d43",
                        "glosses": [
                            "истор. суконный широкий длинный плащ на подкладке с опушкой из рядовой камки куфтерю, украшенный кованным золотым кружевом или галуном"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17cd731f-7915-4d79-b3ff-8de8560b8729",
                                "sense_id": "6d6aeb2e-6db4-352c-a048-324cb47a68f4",
                                "text": "Я желал бы, чтоб Назорой // Ты старалася меня // Удержать умильным взором. // Иль седым Опекуном // Лёгкой, миленькой Розины, // Старым пасынком судьбины, // В епанче и с париком, // Дерзкой пламенной рукою // Белоснежну, полну грудь…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b55a2c1c-dabd-4e7c-92af-7484ee65368f",
                        "source_entry_id": "bb6c6e6e-6e47-32b3-b520-119f6db98d43",
                        "source_sense_id": "6d6aeb2e-6db4-352c-a048-324cb47a68f4",
                        "target_lang_word": "mantle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mantle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd75c293-c0d1-3538-af0f-2f10ca3338b5",
                                        "entry_id": "e89a2243-26ec-36b6-af96-0b3314367664",
                                        "glosses": [
                                            "A piece of clothing somewhat like an open robe or cloak, especially that worn by Orthodox bishops."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07e05935-e93d-399a-8f1a-b9a31d774feb",
                                        "entry_id": "e89a2243-26ec-36b6-af96-0b3314367664",
                                        "glosses": [
                                            "A figurative garment representing authority or status, capable of affording protection."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e44831c-310d-4333-8504-1762fc88915d",
                                                "sense_id": "07e05935-e93d-399a-8f1a-b9a31d774feb",
                                                "text": "At the meeting, she finally assumed the mantle of leadership of the party."
                                            },
                                            {
                                                "example_id": "c758ed11-2e7a-4d21-a713-2b9f0e51e976",
                                                "sense_id": "07e05935-e93d-399a-8f1a-b9a31d774feb",
                                                "text": "The movement strove to put women under the protective mantle of civil rights laws."
                                            },
                                            {
                                                "example_id": "5f203399-f7d9-4b02-b1b1-d83079198b34",
                                                "sense_id": "07e05935-e93d-399a-8f1a-b9a31d774feb",
                                                "text": "“The great millennial novelist”—the mantle has been thrust, by Boomers and Gen Xers alike, upon the Irish writer Sally Rooney, whose two carefully observed and gentle comedies of manners both appeared before her twenty-eighth birthday. With this mantle have come prizes and money. Nearly every review has mentioned at least the prizes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57f3ad38-9e22-35f2-80a4-8f0e128a7087",
                                        "entry_id": "e89a2243-26ec-36b6-af96-0b3314367664",
                                        "glosses": [
                                            "Anything that covers or conceals something else; a cloak."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c21fc317-5766-4cba-be17-f1ab83dbbf45",
                                                "sense_id": "57f3ad38-9e22-35f2-80a4-8f0e128a7087",
                                                "text": "But look, the morn, in russet mantle clad, walks o'er the dew of yon high eastward hill."
                                            },
                                            {
                                                "example_id": "6a0e56c5-e5b3-4045-9088-d39ab0fe2347",
                                                "sense_id": "57f3ad38-9e22-35f2-80a4-8f0e128a7087",
                                                "text": "the green mantle of the standing pool"
                                            },
                                            {
                                                "example_id": "e697bbb7-4e9c-4d96-9748-670fde50c779",
                                                "sense_id": "57f3ad38-9e22-35f2-80a4-8f0e128a7087",
                                                "text": "Know, oh prince, that between the years when the oceans drank Atlantis and the gleaming cities, and the years of the rise of the Sons of Aryas, there was an Age undreamed of, when shining kingdoms lay spread across the world like blue mantles beneath the stars"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28d71f1d-234c-39f3-b7ab-dd530a748521",
                                        "entry_id": "e89a2243-26ec-36b6-af96-0b3314367664",
                                        "glosses": [
                                            "The body wall of a mollusc, from which the shell is secreted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccf15add-8efe-4585-8abe-05cd60879054",
                                                "sense_id": "28d71f1d-234c-39f3-b7ab-dd530a748521",
                                                "text": "He grasps the female from slightly below about the mid-mantle region and positions himself so his arms are close to the opening of her mantle."
                                            },
                                            {
                                                "example_id": "acb6f310-7498-4e97-9f8e-939d32f0b092",
                                                "sense_id": "28d71f1d-234c-39f3-b7ab-dd530a748521",
                                                "text": "Molluscan bodies are broadly divided into two parts: a muscular foot and a shell-secreting mantle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37f6bb06-ba3c-33d6-b777-8533f1643e53",
                                        "entry_id": "e89a2243-26ec-36b6-af96-0b3314367664",
                                        "glosses": [
                                            "The back of a bird together with the folded wings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94496c6d-ebac-3014-ba6d-2c3454ff0f33",
                                        "entry_id": "e89a2243-26ec-36b6-af96-0b3314367664",
                                        "glosses": [
                                            "The zone of hot gases around a flame."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "289307bf-a873-3a95-b524-f465183ffb8a",
                                        "entry_id": "e89a2243-26ec-36b6-af96-0b3314367664",
                                        "glosses": [
                                            "A gauzy fabric impregnated with metal nitrates, used in some kinds of gas and oil lamps and lanterns, which forms a rigid but fragile mesh of metal oxides when heated during initial use and then produces white light from the heat of the flame below it. (So called because it is hung above the lamp's flame like a mantel.)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49e082c9-f73c-32dd-9179-e9d09f28c4af",
                                        "entry_id": "e89a2243-26ec-36b6-af96-0b3314367664",
                                        "glosses": [
                                            "The outer wall and casing of a blast furnace, above the hearth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1dd94e8c-b673-34e1-9b0a-d821433c9a2c",
                                        "entry_id": "e89a2243-26ec-36b6-af96-0b3314367664",
                                        "glosses": [
                                            "A penstock for a water wheel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53e38d36-458f-3215-822a-36440472724b",
                                        "entry_id": "e89a2243-26ec-36b6-af96-0b3314367664",
                                        "glosses": [
                                            "The cerebral cortex."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb26832e-9ab1-3807-82ee-1933c99e75cb",
                                        "entry_id": "e89a2243-26ec-36b6-af96-0b3314367664",
                                        "glosses": [
                                            "The layer between Earth's core and crust."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e921a43-cb1c-4e22-8c81-f7481ccbf3d0",
                                                "sense_id": "fb26832e-9ab1-3807-82ee-1933c99e75cb",
                                                "text": "The crust (a mere 1% of the Earth's volume) is made of lighter melt products from the mantle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c1ad654-b99e-3140-bb16-8a3586c54c03",
                                        "entry_id": "e89a2243-26ec-36b6-af96-0b3314367664",
                                        "glosses": [
                                            "Alternative spelling of mantel (“shelf above fireplace”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e09aaa7a-4d34-3288-a246-687852056058",
                                        "entry_id": "e89a2243-26ec-36b6-af96-0b3314367664",
                                        "glosses": [
                                            "A mantling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mantle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "416e0a95-c90c-3b98-bdd7-b6755bef968c",
                                        "entry_id": "0e7c587c-a930-3dfd-9ca3-519bcf157fc2",
                                        "glosses": [
                                            "To cover or conceal (something); to cloak; to disguise."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c719a42f-d062-4a14-9548-81e44d182098",
                                                "sense_id": "416e0a95-c90c-3b98-bdd7-b6755bef968c",
                                                "text": "As the morning steals upon the night, Melting the darkness; so their rising senses Begin to chace the ign'rant fumes, that mantle Their clearer reason."
                                            },
                                            {
                                                "example_id": "b74d130b-0c83-45da-b93f-b65c84e0a9b7",
                                                "sense_id": "416e0a95-c90c-3b98-bdd7-b6755bef968c",
                                                "text": "I left them I' th' filthy mantled pool beyond your cell, There dancing up to th' chins."
                                            },
                                            {
                                                "example_id": "28856116-8e8d-4354-b6c4-3c9f5b6da02a",
                                                "sense_id": "416e0a95-c90c-3b98-bdd7-b6755bef968c",
                                                "text": "All beneath the pinkish sky from the wildfires / Which mantle the horizon line"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2ef6264-9b6f-3387-95bb-5cf03935b89f",
                                        "entry_id": "0e7c587c-a930-3dfd-9ca3-519bcf157fc2",
                                        "glosses": [
                                            "To become covered or concealed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9a91c4d-d84f-3c9d-b222-8f6d6a5c1e8c",
                                        "entry_id": "0e7c587c-a930-3dfd-9ca3-519bcf157fc2",
                                        "glosses": [
                                            "To spread like a mantle (especially of blood in the face and cheeks when a person flushes)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8f6b25e-4580-4ec7-a99b-ecee0a0f643a",
                                                "sense_id": "e9a91c4d-d84f-3c9d-b222-8f6d6a5c1e8c",
                                                "text": "[…]—that the richest people in the world have the hardest hearts in it, and refuse to help their fellow-creatures, save through the medium of ostentation, and in return for value received?—that the highest and oldest nobility in Europe—the purest blood which ever mantled in the lovely cheek of virgin woman—is regularly exhibited in large bodies, under the protection of British matrons, policemen, and constables, at half-a-crown a head?"
                                            },
                                            {
                                                "example_id": "937bc197-5735-41de-be31-a8c1eb011590",
                                                "sense_id": "e9a91c4d-d84f-3c9d-b222-8f6d6a5c1e8c",
                                                "text": "[…] and then that coffee! what fragrance it diffused through the room — how the foaming hot cream mantled over it, making discovered country from whose bourne no Master Philip's teeth water, […]"
                                            },
                                            {
                                                "example_id": "f4ba4778-a98f-4386-aeb8-902d4dfa1de4",
                                                "sense_id": "e9a91c4d-d84f-3c9d-b222-8f6d6a5c1e8c",
                                                "text": "The blood still mantled below her ears; she bent her head in shame of her humility."
                                            },
                                            {
                                                "example_id": "c371dd7b-860c-48b0-b997-2f3b8ee7bf1e",
                                                "sense_id": "e9a91c4d-d84f-3c9d-b222-8f6d6a5c1e8c",
                                                "text": "“Yes,” he answered, with bowed head, his face mantling with the flush of shame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f07bd27-5749-3c2e-869c-1eb1b34f669f",
                                        "entry_id": "0e7c587c-a930-3dfd-9ca3-519bcf157fc2",
                                        "glosses": [
                                            "To climb over or onto something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6660e1c0-0acf-38e2-af95-33a85b2ce5b9",
                                        "entry_id": "0e7c587c-a930-3dfd-9ca3-519bcf157fc2",
                                        "glosses": [
                                            "The action of stretching out the wings to hide food."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9d02917-6cbe-365e-99e7-a47eba0d741a",
                                        "entry_id": "0e7c587c-a930-3dfd-9ca3-519bcf157fc2",
                                        "glosses": [
                                            "The action of stretching a wing and the same side leg out to one side of the body."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
