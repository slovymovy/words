                "senses": [
                    {
                        "sense_id": "071a8c19-78d0-3b64-a5b5-1c48067e32b6",
                        "entry_id": "ce373685-5e53-3b4d-b70c-6c93911c3119",
                        "glosses": [
                            "Schwimmbecken in einem Hotel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9f8dbbb-2deb-4b0f-9547-6895cf63ca1b",
                                "sense_id": "071a8c19-78d0-3b64-a5b5-1c48067e32b6",
                                "text": "„Die Antwort auf diese Frage wirkte etwas ernüchternd auf das maskuline Ego, deshalb war ich auch ein wenig nervös, als ich sie am Hotelpool ansprach.“"
                            },
                            {
                                "example_id": "25c3d5b1-737c-4af3-9901-ca7fdb5d8286",
                                "sense_id": "071a8c19-78d0-3b64-a5b5-1c48067e32b6",
                                "text": "„Erst hatte sie vor, sich einfach am Hotelpool in die Sonne zu legen, doch nach einem kurzen Rundgang zwischen den Badehäuschen hatte sie bereits genug Männer in zu engen Badehosen und Frauen in zu knappen Bikinioberteilen gesehen, um zu beschließen, dass der Pool doch nicht ganz nach ihrem Geschmack war.“"
                            },
                            {
                                "example_id": "43457a59-ebc4-4e66-9b65-56d5eab1c32c",
                                "sense_id": "071a8c19-78d0-3b64-a5b5-1c48067e32b6",
                                "text": "„Meine Mom ließ ich versprechen, in jeden Hotelpool zu urinieren, in dem sie jemals schwimmen gehe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
