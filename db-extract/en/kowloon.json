                "forms": [],
                "senses": [
                    {
                        "sense_id": "dbeddb8e-189d-3c86-998c-9853f49542c4",
                        "entry_id": "3288c2a0-5205-3bd6-a840-4b7adc602e45",
                        "glosses": [
                            "A region, peninsula, and urban area of Hong Kong."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b328dda4-2ed7-4489-a2bd-a9faaa41019a",
                                "sense_id": "dbeddb8e-189d-3c86-998c-9853f49542c4",
                                "text": "Holonyms: HKSAR, HK (region) < PRC, People's Republic of China, China"
                            },
                            {
                                "example_id": "b2551138-4cd2-420d-84df-2e117910fdf9",
                                "sense_id": "dbeddb8e-189d-3c86-998c-9853f49542c4",
                                "text": "By the late 1930's some modern factories, built by outside interests and producing such goods as bricks, beer, and chinaware for export abroad, had already appeared in Tsuen Wan, a market town near Kowloon."
                            },
                            {
                                "example_id": "59ccef76-5ac5-4057-aa29-24c8b1ed1218",
                                "sense_id": "dbeddb8e-189d-3c86-998c-9853f49542c4",
                                "text": "Next Media said two entryways to its headquarters in Hong Kong’s Tseung Kwan O neighborhood were hit with firebombs around 1 a.m. Monday. At about the same time, a masked man got out of a car outside Mr. Lai’s home in the Ho Man Tin neighborhood and threw a firebomb at the sidewalk outside the gate. Two cars suspected of being those used in the attacks were later found burning in nearby areas of Kowloon."
                            },
                            {
                                "example_id": "893bbee2-3763-4019-879e-9562938c3bad",
                                "sense_id": "dbeddb8e-189d-3c86-998c-9853f49542c4",
                                "text": "Several protesters took up positions on the rooftops of Hong Kong Polytechnic University, armed with bows and arrows, as unrest spread across the territory's central Kowloon district."
                            },
                            {
                                "example_id": "9b794257-5418-4af1-9a5a-36ac784d6126",
                                "sense_id": "dbeddb8e-189d-3c86-998c-9853f49542c4",
                                "text": "Hong Kong authorities evacuated at least 3,400 people from buildings after a fire broke out in a warehouse in the city's Kowloon district on Friday."
                            }
                        ]
                    }
                ],
