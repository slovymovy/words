                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Architektur dieses modernen Gebäudes <w>lehnt</w> sich an den Bauhausstil <w>an</w>."
                        },
                        {
                            "text": "Seine Forschungsergebnisse <w>lehnen</w> sich eng an die Theorien seines Professors <w>an</w>."
