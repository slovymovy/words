        "fr-extract.jsonl": [
            {
                "entry_id": "4c54912b-81f4-363d-9864-a007c0da8b36",
                "word": "jurement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d3436e28-9e45-4337-8f37-30b0036ec580",
                        "entry_id": "4c54912b-81f4-363d-9864-a007c0da8b36",
                        "tags": [
                            "plural"
                        ],
                        "form": "jurements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d4130f04-6c6f-3181-867f-b458ee9c0c86",
                        "entry_id": "4c54912b-81f4-363d-9864-a007c0da8b36",
                        "glosses": [
                            "Serment qu’on fait en vain, sans nécessité et sans obligation."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "08d85257-cb8a-4dce-b231-a2bc633ddfe2",
                                "sense_id": "d4130f04-6c6f-3181-867f-b458ee9c0c86",
                                "text": "— C’est bien assez de poignées de main comme ça, monsieur Léon ; si vous ne voulez pas me croire sur parole, les jurements n’y feront rien."
                            },
                            {
                                "example_id": "be601eff-fe09-4568-975a-a78a4d4683ab",
                                "sense_id": "d4130f04-6c6f-3181-867f-b458ee9c0c86",
                                "text": "On ne nous croira pas, malgré tous vos jurements."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9bf9793-d489-3888-a87a-899133017f19",
                        "entry_id": "4c54912b-81f4-363d-9864-a007c0da8b36",
                        "glosses": [
                            "Blasphème, imprécation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ee79e28-e18e-4690-89d7-59b356a88bda",
                                "sense_id": "f9bf9793-d489-3888-a87a-899133017f19",
                                "text": "Voici le moment où vous devez, père Duchesne, vous repentir de tous vos jurements contre le ci-devant ordre du clergé."
                            },
                            {
                                "example_id": "73695cbe-45fa-4fdf-9a06-2f592f759a53",
                                "sense_id": "f9bf9793-d489-3888-a87a-899133017f19",
                                "text": "… ; quant aux autres, deux mousses leur attachaient les pieds, malgré d'affreux jurements."
                            },
                            {
                                "example_id": "a88ad6bd-9281-40ad-9d3b-7f3bbfe96349",
                                "sense_id": "f9bf9793-d489-3888-a87a-899133017f19",
                                "text": "Une des choses les plus bouffonnes que j’aie vues, c’est le mayoral se lamentant sur les débris de sa carriole ; il en rajustait les morceaux comme un enfant qui vient de casser un verre, et, voyant que le mal était irréparable, il éclatait en affreux jurements, trépignait, se donnait des coups de poing, se roulait par terre, imitant les excès des douleurs antiques, ou bien il s’attendrissait et se livrait aux plus touchantes élégies."
                            },
                            {
                                "example_id": "6b6599a0-5028-4b62-90fe-8104e63c637c",
                                "sense_id": "f9bf9793-d489-3888-a87a-899133017f19",
                                "text": "Pas plus tôt la porte ouverte, voilà un grand cheulard de soldat à Guillaume qui se lève en grognant de dessus les copeaux et vient vers moi, les yeux hors de la tête, avec un tas de jurements que je ne comprends pas."
                            }
                        ]
                    }
                ],
