                            {
                                "example_id": "8a1d517b-dc56-422d-a7ea-25ca98bc1fde",
                                "sense_id": "06002ad5-b51f-3fc2-81f6-476f7a6aec15",
                                "text": "Het langdurig of veelvuldig gebruik van dit medicijn wordt ontraden."
                            },
                            {
                                "example_id": "81b77ebf-c7de-48a2-915a-23ce4928d006",
                                "sense_id": "06002ad5-b51f-3fc2-81f6-476f7a6aec15",
                                "text": "‘Wat vindt je vrouw ervan dat je zo lang weg bent?’ Deze vraag werd mij veelvuldig gesteld, zowel van tevoren als bij terugkomst. Op zich een logische vraag."
                            }
                        ]
                    }
