                        "entry_id": "b8625d2f-0697-308b-a38c-a996480956f2",
                        "glosses": [
                            "erste Regelblutung, Menstruation"
                        ],
                        "tags": [
                            "Gynäkologie"
                        ],
                        "examples": [
                            {
                                "example_id": "fc4c225c-5f13-48d9-abfc-10e1b528adc1",
                                "sense_id": "aff0478b-a5cf-3983-8115-73acf6d918a1",
