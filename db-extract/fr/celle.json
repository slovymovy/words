                "senses": [
                    {
                        "sense_id": "70649dd0-e3b5-3081-950e-cbb58b45c7b1",
                        "entry_id": "13b17931-4f96-3cc3-a0e0-95db45b88da0",
                        "glosses": [
                            "Utilisé pour remplacer la personne ou la chose dont on parle au féminin."
                        ],
                        "tags": [],
                        "note": "Il est toujours suivi par une proposition relative ou par un syntagme prépositionnel",
                        "examples": [
                            {
                                "example_id": "020eaf2f-41d2-4e73-81f0-b70f35facb6f",
                                "sense_id": "70649dd0-e3b5-3081-950e-cbb58b45c7b1",
                                "text": "Or ceci est, comparativement à l’orthographe du temps, comparativement, du reste, à la nôtre même, une orthographe très simplifiée. C’était celle de La Fontaine."
                            },
                            {
                                "example_id": "0cefc976-ca3f-4424-83ed-17f75dfcf521",
                                "sense_id": "70649dd0-e3b5-3081-950e-cbb58b45c7b1",
                                "text": "Rinri me tenait la main, ainsi que chaque amoureux du parcours tenait la main de celle qui l’accompagnait."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b27d6b7-eaf0-39ce-a46f-b0f1d0afb79d",
                        "entry_id": "13b17931-4f96-3cc3-a0e0-95db45b88da0",
                        "glosses": [
                            "La blague."
                        ],
                        "tags": [
                            "ellipsis",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "dfda757e-bf7f-4f49-bae9-24788c3bc8f1",
                                "sense_id": "1b27d6b7-eaf0-39ce-a46f-b0f1d0afb79d",
                                "text": "Tu connais celle du fou qui repeint son plafond ? : Tu connais la blague avec le fou qui repeint son plafond ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1d3f26b-5320-4b5a-a30b-b924e077f911",
                        "source_entry_id": "13b17931-4f96-3cc3-a0e0-95db45b88da0",
                        "source_sense_description": "La personne ou la chose dont on parle au féminin.",
                        "target_lang_word": "degene",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "degene",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "60075d41-b786-395e-a79e-b768f279074f",
                                        "entry_id": "123f8fa9-138b-355b-ad49-7edc146e1969",
                                        "glosses": [
                                            "wijst een antecedent aan vóór de bepalende bijzin. degene = die (persoon) gisteren het woord voerde. degene = die (persoon) mijn gered heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9469fd2d-a8a2-4a15-9347-1521a0294865",
                                                "sense_id": "60075d41-b786-395e-a79e-b768f279074f",
                                                "text": "Is dat degene die gisteren het woord voerde?"
                                            },
                                            {
                                                "example_id": "fcd498a7-730b-45e1-b6e1-687b62447cb3",
                                                "sense_id": "60075d41-b786-395e-a79e-b768f279074f",
                                                "text": "Hij is degene die mij gered heeft."
                                            },
                                            {
                                                "example_id": "cd3cd56f-698a-4c0a-a670-90c7c79573d7",
                                                "sense_id": "60075d41-b786-395e-a79e-b768f279074f",
                                                "text": "Ik heb mijn hele leven gewacht op iemand die het voor mij zou doen, die mij zou helpen, maar degene op wie ik wachtte ben ik zelf."
                                            },
                                            {
                                                "example_id": "9e5ddc53-a811-44e4-a203-e752f6712709",
                                                "sense_id": "60075d41-b786-395e-a79e-b768f279074f",
                                                "text": "Vanochtend had ze het moeilijk en was Lot degene die haar heeft geholpen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
