                    "semantic_group_id": "ecriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir terminé son brouillon, l'élève commence à <w>recopier</w> son devoir sur une feuille propre."
                        },
                        {
                            "text": "Le professeur nous demande de <w>recopier</w> la leçon écrite au tableau."
                        }
                    ],
