    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6a5810f2-1ab0-3380-9e70-c6d2bd3199ae",
                    "sense_definition": "Extremely bad, unpleasant, or of very low quality.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bad_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The food at that restaurant was <w>terrible</w>, so we will not go back.",
                            "target_lang_translations": {
                                "ru": "Еда в том ресторане была <w>ужасной</w>, поэтому мы туда больше не пойдем.",
                                "zh": "那家餐厅的食物太<w>糟糕</w>了，所以我们不会再去了。"
                            }
                        },
                        {
                            "text": "I have a <w>terrible</w> cold and cannot come to work today.",
                            "target_lang_translations": {
                                "ru": "У меня <w>ужасная</w> простуда, и я не могу сегодня прийти на работу.",
                                "zh": "我得了<w>严重</w>的感冒，今天不能去上班了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "awful",
                        "horrible",
                        "dreadful"
                    ],
                    "antonyms": [
                        "excellent"
                    ],
                    "common_phrases": [
                        "terrible weather",
                        "feel terrible",
                        "look terrible",
                        "terrible smell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно плохой, неприятный или очень низкого качества.",
                        "zh": "极其糟糕、令人不快或质量非常低。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужа́сный",
                                "target_lang_sense_clarification": "очень плохой"
                            },
                            {
                                "target_lang_word": "отврати́тельный",
                                "target_lang_sense_clarification": "вызывающий неприязнь"
                            },
                            {
                                "target_lang_word": "скве́рный",
                                "target_lang_sense_clarification": "дурной, нехороший"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "糟糕",
                                "target_lang_sense_clarification": "指情况或质量很差"
                            },
                            {
                                "target_lang_word": "糟糕透顶",
                                "target_lang_sense_clarification": "程度极差"
                            },
                            {
                                "target_lang_word": "恶劣",
                                "target_lang_sense_clarification": "指环境或品质极坏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2baff8e4-0a8a-371a-86d8-647d58b4daa8",
                    "sense_definition": "Very severe, serious, or extreme in degree.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He realized he had made a <w>terrible</w> mistake by deleting the files.",
                            "target_lang_translations": {
                                "ru": "Он понял, что совершил <w>ужасную</w> ошибку, удалив файлы.",
                                "zh": "他意识到自己删掉文件犯了一个<w>严重</w>的错误。"
                            }
                        },
                        {
                            "text": "The athlete was in <w>terrible</w> pain after injuring his leg.",
                            "target_lang_translations": {
                                "ru": "Спортсмен испытывал <w>страшную</w> боль после травмы ноги.",
                                "zh": "运动员腿部受伤后感到<w>剧烈</w>的疼痛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "severe",
                        "extreme",
                        "intense",
                        "awful",
                        "dreadful"
                    ],
                    "common_phrases": [
                        "terrible mistake",
                        "terrible pain",
                        "terrible shock",
                        "terrible loss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень сильный, серьезный или значительный по степени проявления.",
                        "zh": "程度非常严重、剧烈或极端。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужа́сный",
                                "target_lang_sense_clarification": "крайней степени"
                            },
                            {
                                "target_lang_word": "стра́шный",
                                "target_lang_sense_clarification": "сильный, суровый"
                            },
                            {
                                "target_lang_word": "чудо́вищный",
                                "target_lang_sense_clarification": "огромный, невероятный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "严重",
                                "target_lang_sense_clarification": "指程度深或后果重"
                            },
                            {
                                "target_lang_word": "剧烈",
                                "target_lang_sense_clarification": "指程度非常强"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9813bd4-1aee-30fa-9cea-538f56912a73",
                    "sense_definition": "Causing great fear, terror, or dread.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dragon let out a <w>terrible</w> roar that shook the ground.",
                            "target_lang_translations": {
                                "ru": "Дракон издал <w>страшный</w> рев, от которого содрогнулась земля.",
                                "zh": "龙发出一声<w>可怕</w>的咆哮，震动了大地。"
                            }
                        },
                        {
                            "text": "They witnessed a <w>terrible</w> accident on the highway yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера они стали свидетелями <w>жуткой</w> аварии на шоссе.",
                                "zh": "他们昨天在高速公路上目睹了一场<w>可怕</w>的车祸。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terrifying",
                        "frightening",
                        "dreadful"
                    ],
                    "common_phrases": [
                        "terrible accident",
                        "terrible tragedy",
                        "terrible curse",
                        "terrible news"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий сильный страх, ужас или трепет.",
                        "zh": "引起极大的恐惧、惊恐或畏惧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стра́шный",
                                "target_lang_sense_clarification": "пугающий"
                            },
                            {
                                "target_lang_word": "жу́ткий",
                                "target_lang_sense_clarification": "наводящий ужас"
                            },
                            {
                                "target_lang_word": "гро́зный",
                                "target_lang_sense_clarification": "суровый, угрожающий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可怕",
                                "target_lang_sense_clarification": "令人感到恐惧"
                            },
                            {
                                "target_lang_word": "恐怖",
                                "target_lang_sense_clarification": "令人感到惊恐"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c9852e29-d53a-376e-82ca-78abb0e20d42",
                    "sense_definition": "Extremely or very; used to emphasize an adjective in a non-standard way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was <w>terrible</w> cold outside in the snow without a coat.",
                            "target_lang_translations": {
                                "ru": "На улице в снегу без пальто было <w>ужасно</w> холодно.",
                                "zh": "外面下着雪，没穿外套真是<w>特别</w>冷。"
                            }
                        },
                        {
                            "text": "He was <w>terrible</w> upset when he heard about the broken vase.",
                            "target_lang_translations": {
                                "ru": "Он был <w>жутко</w> расстроен, когда услышал о разбитой вазе.",
                                "zh": "当听说花瓶打碎时，他感到<w>非常</w>难过。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "terrible bad"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Used in place of 'terribly' in some dialects or colloquial speech."
                        },
                        {
