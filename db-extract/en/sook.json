            {
                "entry_id": "f7b75f77-4b53-31bf-a70b-3ec6621ceecf",
                "word": "sook",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7119ac41-bbab-446a-86bc-3d569fa942e0",
                        "entry_id": "f7b75f77-4b53-31bf-a70b-3ec6621ceecf",
                        "tags": [
                            "plural"
                        ],
                        "form": "sooks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f9ce57f-f621-345e-9a15-848dde3fc5cf",
                        "entry_id": "f7b75f77-4b53-31bf-a70b-3ec6621ceecf",
                        "glosses": [
                            "A crybaby, a complainer, a whinger; a shy or timid person, a wimp; a coward."
                        ],
                        "tags": [
                            "Atlantic-Canada",
                            "Australia",
                            "New-Zealand",
                            "derogatory",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "4c484982-f0ea-40f5-8116-883ddcfa0880",
                                "sense_id": "1f9ce57f-f621-345e-9a15-848dde3fc5cf",
                                "text": "Don't be such a sook."
                            },
                            {
                                "example_id": "5622355f-28ba-4fe3-9410-33014b3bf083",
                                "sense_id": "1f9ce57f-f621-345e-9a15-848dde3fc5cf",
                                "text": "You must think I'm a sook, hey? Here I am complaining about my dad's job and my curfew and your dad cheated on your mum. You put things into perspective for me."
                            },
                            {
                                "example_id": "1d610f59-62be-4dd2-921a-1b6caa7a6490",
                                "sense_id": "1f9ce57f-f621-345e-9a15-848dde3fc5cf",
                                "text": "‘What a sook! Look at her cry!’\n‘Yeah, look at the Abo cry!’"
                            },
                            {
                                "example_id": "cb2254a8-2bc0-4957-8ea5-665fdb1800b0",
                                "sense_id": "1f9ce57f-f621-345e-9a15-848dde3fc5cf",
                                "text": "Only sooks ask guides how far there is to go."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff68670d-ecb9-3b9d-9a5d-1c9a06645a71",
                        "entry_id": "f7b75f77-4b53-31bf-a70b-3ec6621ceecf",
                        "glosses": [
                            "A sulk or complaint; an act of sulking."
                        ],
                        "tags": [
                            "Atlantic-Canada",
                            "Australia",
                            "New-Zealand",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "55bcbcc5-7d90-412a-9f47-940489277776",
                                "sense_id": "ff68670d-ecb9-3b9d-9a5d-1c9a06645a71",
                                "text": "I was so upset that I went home and had a sook about it."
                            },
                            {
                                "example_id": "328927d3-09e6-4e60-b205-a6e0140f6ae6",
                                "sense_id": "ff68670d-ecb9-3b9d-9a5d-1c9a06645a71",
                                "text": "‘Have a sook! Have a sook!’, they'd all yell. But that time I didn't go outside to cry."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5280e48c-b87b-487b-aad1-cd9de445bfff",
                        "source_entry_id": "f7b75f77-4b53-31bf-a70b-3ec6621ceecf",
                        "source_sense_description": "crybaby",
                        "target_lang_word": "нытик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нытик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f1721907-bf58-3e76-86b1-dc05f5295d02",
                                        "entry_id": "b3a75650-d1de-3003-b295-4acb741b3f3d",
                                        "glosses": [
                                            "разг. ноющий, всегда чем-то недовольный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7862921-55ae-4641-95ea-ab219ada0a87",
                                                "sense_id": "f1721907-bf58-3e76-86b1-dc05f5295d02",
                                                "text": "Мы ослабели, опустились, пали наконец, наше поколение всплошную состоит из неврастеников и нытиков, мы только и знаем, что толкуем об усталости и переутомлении, но виноваты в том не вы и не я: мы слишком мелки, чтобы от нашего произвола могла зависеть судьба целого поколения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e9d2d6b-042d-460a-afb6-4cabc8a208ce",
                        "source_entry_id": "f7b75f77-4b53-31bf-a70b-3ec6621ceecf",
                        "source_sense_description": "crybaby",
                        "target_lang_word": "плакса",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "плакса",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3bd563ce-9c5b-3bc3-83a2-f1f1534767af",
                                        "entry_id": "60ea7023-7d4d-3733-8771-1f2cbd279f11",
                                        "glosses": [
                                            "разг. тот, кто часто, без достаточной причины плачет"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1034b874-31cc-4503-b6f3-76a62bdbd9bb",
                                                "sense_id": "3bd563ce-9c5b-3bc3-83a2-f1f1534767af",
                                                "text": "Где были твои глаза? Плакса! Нюнил до тех пор, пока не утащили из-под его носа жены!"
                                            },
                                            {
                                                "example_id": "1b90d4a1-2800-4948-83de-0578cbe18c50",
                                                "sense_id": "3bd563ce-9c5b-3bc3-83a2-f1f1534767af",
                                                "text": "Ведь ничего еще не случилось, а вы грустите, будто жизнь уж кончена, прошла, пролетела. Вы просто от природы плакса."
                                            },
                                            {
                                                "example_id": "84b9b52f-a64a-4079-b94a-437803a02920",
                                                "sense_id": "3bd563ce-9c5b-3bc3-83a2-f1f1534767af",
                                                "text": "Герда. Я давно бы вошла… Но я заплакала. А я очень не люблю, когда видят, как я плачу. Я вовсе не плакса, поверьте мне!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "f09f164a-1ce3-4f3c-9bea-f3140385df33",
