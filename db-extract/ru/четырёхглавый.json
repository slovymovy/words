                        "target_lang_word": "four-headed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bf3f25bb-edaa-4dfe-b47c-1d6f082ecbf2",
                        "source_entry_id": "d6d0fc7c-c150-3966-b07c-d3efbea65fdc",
                        "source_sense_description": "четырёхголовый",
                        "target_lang_word": "vierköpfig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vierköpfig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f0bb470-2e60-3a63-af73-9f3c87e265c1",
                                        "entry_id": "81d5f004-8cd7-36c3-9200-b428ff931919",
                                        "glosses": [
                                            "mit vier Köpfen ausgestattet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14618acf-c455-45ab-abb6-3c97d587eeb0",
                                                "sense_id": "0f0bb470-2e60-3a63-af73-9f3c87e265c1",
                                                "text": "Ein vierköpfiger Drache verbreitet in dem neuen Horrorstreifen Angst und Schrecken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "40777542-5689-3151-bfe1-2860728a05f6",
                                        "entry_id": "81d5f004-8cd7-36c3-9200-b428ff931919",
                                        "glosses": [
                                            "vier Personen umfassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02c56b26-6e5e-4803-9c90-77a1cd6d99f0",
                                                "sense_id": "40777542-5689-3151-bfe1-2860728a05f6",
                                                "text": "Die vierköpfige Familie muss in einer winzigen Einzimmerwohnung hausen."
                                            },
                                            {
                                                "example_id": "ad7cdfef-eb13-428d-b046-697646724f81",
                                                "sense_id": "40777542-5689-3151-bfe1-2860728a05f6",
                                                "text": "„Das vierköpfige Team bilden der Menorquiner José Carbonell, der Ibizenker Andreu Carles López sowie die Mallorquinerinnen Teresa Miquel und Pilar Esteve.“"
                                            },
                                            {
                                                "example_id": "c7fdfec4-aa60-4f6c-893b-3af4b4819287",
                                                "sense_id": "40777542-5689-3151-bfe1-2860728a05f6",
                                                "text": "„Im Garten hinter dem Haus begann eine vierköpfige Band zu spielen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
