                    },
                    {
                        "form_id": "f1cbd500-33ac-43a3-8942-4647c56010f3",
                        "entry_id": "41c994be-9396-38a1-aeb5-bcadfc350fe6",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kernsätze"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef105885-325d-384d-829f-58be219c534b",
                        "entry_id": "41c994be-9396-38a1-aeb5-bcadfc350fe6",
                        "glosses": [
                            "besonders wichtiger Satz"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "e6283c13-847e-4ad4-83c9-00cc4e89ff3d",
                                "sense_id": "ef105885-325d-384d-829f-58be219c534b",
                                "text": "„Mit dem Kernsatz werden die Inhalte und Ziele der Leitsätze auf den Punkt gebracht.“"
                            },
                            {
                                "example_id": "ad88f5e3-7fcf-47f4-836f-57f13f480553",
                                "sense_id": "ef105885-325d-384d-829f-58be219c534b",
                                "text": "„Bei den Kernsätzen schlägt man mit dem Stock auf die liliengeschmückten Koffer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9556f7b9-9cfd-3422-be9c-fa8a9b9c4818",
                        "entry_id": "41c994be-9396-38a1-aeb5-bcadfc350fe6",
                        "glosses": [
                            "Begriff aus der Syntax des Deutschen: Satz, bei dem das finite Verb die zweite Satzgliedposition einnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "472e3d6d-ebdc-4535-93b2-db65157461d4",
                                "sense_id": "9556f7b9-9cfd-3422-be9c-fa8a9b9c4818",
                                "text": "\"Der Junge spielt gerne Fußball\" hat das finite Verb \"spielt\" an zweiter Satzgliedposition und ist deshalb ein Kernsatz."
                            },
                            {
                                "example_id": "d1443f64-1a97-4bc9-9ee5-1706997e26c2",
                                "sense_id": "9556f7b9-9cfd-3422-be9c-fa8a9b9c4818",
                                "text": "„Beim Stirnsatz steht das Finitum am Anfang des Satzes, beim Kernsatz nach dem ersten Satzglied und beim Spannsatz am Ende des Satzes.“"
                            },
                            {
                                "example_id": "acbbc7ed-3c31-487b-a3fd-a0c248a4f9dc",
                                "sense_id": "9556f7b9-9cfd-3422-be9c-fa8a9b9c4818",
                                "text": "„Allgemeingültige und vollständige Beschreibungen der Topologie des Kernsatzes unterscheiden heute meist sechs Positionen oder Felder…“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0de0c7fd-77e5-3ef5-85b3-a818958c716d",
                        "entry_id": "41c994be-9396-38a1-aeb5-bcadfc350fe6",
                        "glosses": [
                            "speziell in der generativen Grammatik ein Satz, von dem aus komplexere Sätze abgeleitet werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8df38f95-ec04-4161-b465-77e9db1014e7",
                                "sense_id": "0de0c7fd-77e5-3ef5-85b3-a818958c716d",
                                "text": "In den Anfängen der generativen Grammatik waren Kernsätze der Ausgangspunkt für die Erzeugung \"echter\" Sätze, der sogenannten Oberflächenstrukturen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "fcc43e47-043f-35a0-a6da-83205e4a8b92",
                        "entry_id": "41c994be-9396-38a1-aeb5-bcadfc350fe6",
                        "glosses": [
                            "einfacher Aussagesatz, der eine (vorsprachliche) Bedeutung (= Proposition) ausdrückt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a23ecb9e-dc93-4c0a-8c4a-eeaf42670371",
                                "sense_id": "fcc43e47-043f-35a0-a6da-83205e4a8b92",
                                "text": "„Und wenn schließlich, wie angenommen, die Dauer von Kernsätzen nur wenig variiert, und wenn - wie bereits gezeigt - auch die Zahl der Silben nur innerhalb eines engen Rahmens schwankt, dann müssen die Wörter von Sprachen, deren Sätze im Durchschnitt aus relativ vielen Wörtern zusammengesetzt sind, aus relativ wenigen Silben zusammengesetzt sein.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
