                        "source_sense_id": "0767db73-5b33-3629-8c2c-b649be5ea67e",
                        "target_lang_word": "Aufmacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufmacher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5c003ef-bf19-3748-ae12-5339bc55c581",
                                        "entry_id": "427ce36c-0f89-3db4-948a-90b96c453708",
                                        "glosses": [
                                            "ein von einem Medium verwendeter, Aufsehen erregender Beitrag, der auffällig positioniert den Kunden dazu bewegen soll, das Medium zu kaufen oder zu betrachten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa515a95-b482-496b-91d8-bb347bb8762e",
                                                "sense_id": "b5c003ef-bf19-3748-ae12-5339bc55c581",
                                                "text": "„›Kümmere dich darum‹, sagte Hughes. ›Und sag Sol Maltzman, nächste Woche will ich einen Aufmacher mit der Schlagzeile: ›Neger: Überbevölkerung löst Tuberkulose-Epidemie aus‹.‹“"
                                            },
                                            {
                                                "example_id": "8f6f1d7b-8881-4dd3-8ac4-b74e60c60bca",
                                                "sense_id": "b5c003ef-bf19-3748-ae12-5339bc55c581",
                                                "text": "„Vor drei Uhr morgens musste meine letzte Depesche abgehen, und bevor ich zu Bett ging, hinterlegte ich beim Portier stets einen telegrafisch durchzugebenden Aufmacher für die Morgenausgabe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
