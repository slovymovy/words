                        "entry_id": "ca99ad2c-6ac4-3134-848a-a447795dd800",
                        "glosses": [
                            "Espèces de poissons osseux marins allongés à 2 nageoires dorsales et une anale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca9eb19f-748b-44de-bf0d-b509dcd84f1e",
                                "sense_id": "6d30eea5-c5b6-30f7-aed4-daf53533ded0",
                                "text": "De nombreuses variétés de merlu sont pêchées dans l’Atlantique et le Pacifique et en mer Méditerranée."
                            }
                        ]
                    },
                    {
                        "sense_id": "789c2d41-967a-3096-bc9e-eaec768867ef",
