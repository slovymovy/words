                    {
                        "translation_id": "35d0d956-da46-4e5c-8834-627cff0a8d56",
                        "source_entry_id": "a2026e05-d63f-3c10-a770-159f2e95e756",
                        "source_sense_id": "3e383443-9902-3d39-a5a5-4914b7575421",
