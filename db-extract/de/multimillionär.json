                "senses": [
                    {
                        "sense_id": "057501ea-b852-34ed-9ac6-6607df67d326",
                        "entry_id": "9062095d-b43e-3e8f-b29b-e073b02fe792",
                        "glosses": [
                            "Besitzer eines Vermögens im Wert von mehreren Millionen einer „Währungseinheit“ (Euro, Dollar, Pfund oder Ähnliches)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbc97618-5ce0-4bf8-8bd8-82c39c4ca58a",
                                "sense_id": "057501ea-b852-34ed-9ac6-6607df67d326",
                                "text": "Nachdem sie einen Multimillionär geheiratet hatte, hörte sie auf zu arbeiten."
                            },
                            {
                                "example_id": "3ab53e2b-27a3-4fa8-a804-aaa808ed02e6",
                                "sense_id": "057501ea-b852-34ed-9ac6-6607df67d326",
                                "text": "Heute ist der Chef zwar Multimillionär, aber früher hat er hier als Schlosser gearbeitet."
                            },
                            {
                                "example_id": "a8deefe7-4037-4e9c-8f58-4e6827d5f1b3",
                                "sense_id": "057501ea-b852-34ed-9ac6-6607df67d326",
                                "text": "„Der Typ war bestimmt Multimillionär geworden mit seiner Erfindung.“"
                            },
                            {
                                "example_id": "668c127d-b255-47d9-a7d7-423042478419",
                                "sense_id": "057501ea-b852-34ed-9ac6-6607df67d326",
                                "text": "„Zwei Wochen später wollte Gottvater gern wissen, wie es dem Multimillionär erging.“"
                            },
                            {
                                "example_id": "5ff36dd1-f78f-4662-906c-9e37884f9f97",
                                "sense_id": "057501ea-b852-34ed-9ac6-6607df67d326",
                                "text": "„Ein Multimillionär aus dem Taunus zahlt im Jahr 2300 Euro Steuern – weil er sein Jahreseinkommen auf 26.000 Euro runterrechnen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
