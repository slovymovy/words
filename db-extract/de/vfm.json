                            {
                                "example_id": "ec9fb907-19db-4cc1-b5e4-4772429eb5c7",
                                "sense_id": "86d4a108-35a8-3a90-84f8-9548e4f04c1b",
                                "text": "Der Vorrat (Masse) wird in Festmetern je Hektar angegeben, wobei zwischen Vorratsfestmetern (Vfm) und Erntefestmetern (Efm) zu unterscheiden ist. Vfm beinhalten alles stehende Holz (Derbholzvolumen mit Rinde), Efm verbleiben nach Abzug der Ernteverluste sowie des Rindenvolumens als verkaufsfähige Masse."
                            },
                            {
                                "example_id": "e63072a5-0f36-42d0-bf8f-16ac41149624",
                                "sense_id": "86d4a108-35a8-3a90-84f8-9548e4f04c1b",
                                "text": "Zum Stichtag 01.10.2002 wurde für Bayern ein Gesamtvorrat von 978,8 Mio. Vfm Holz (Vorratsfestmeter: Derbholz ab 7 cm BHD) ermittelt."
                            }
                        ],
