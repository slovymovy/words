                                "target_senses": [
                                    {
                                        "sense_id": "dc86d018-feee-3e4e-8c2a-c3ab8c1fee3d",
                                        "entry_id": "415bdd5e-754a-33b4-ac61-ea414bb6267b",
                                        "glosses": [
                                            "Ce qui agglutine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90e88d9d-09bf-4fb8-82e6-5d424ebc500f",
                                                "sense_id": "dc86d018-feee-3e4e-8c2a-c3ab8c1fee3d",
                                                "text": "La guimauve est un agglutinant."
                                            },
                                            {
                                                "example_id": "33ed36e6-e2b4-4a2d-8809-e92d130ff8bc",
                                                "sense_id": "dc86d018-feee-3e4e-8c2a-c3ab8c1fee3d",
                                                "text": "Ces couleurs sont, en effet, broyées avec un agglutinant qui n’a rien, ou presque rien, de commun avec celui des anciens maîtres."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "agglutinant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85c1dac5-fba6-3b69-a01e-f730ad54218e",
                                        "entry_id": "361922eb-5059-3d57-9784-c94c30799c07",
                                        "glosses": [
                                            "Participe présent de agglutiner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d28e8fdd-3db6-48f9-8e06-e69cc5f5aa82",
                                                "sense_id": "85c1dac5-fba6-3b69-a01e-f730ad54218e",
                                                "text": "Les cris mêlés aux détonations enflaient sous son crâne, comme des colloïdes d’argile s’agglutinant sur d’autres particules, fabriquant une pâte grossissant inexorablement."
                                            }
