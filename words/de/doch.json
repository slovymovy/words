{
    "word_family": [
        "jedoch",
        "dennoch"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "55b3e580-9239-3e9e-8146-0794b2779c9c",
                    "sense_definition": "Drückt aus, dass etwas entgegen einer früheren Annahme oder Erwartung geschieht; trotzdem oder dennoch.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "entgegen_erwartung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir wollten eigentlich zu Hause bleiben, sind dann <w>doch</w> ins Kino gegangen."
                        },
                        {
                            "text": "Nach einer sehr langen Suche haben wir die verlorenen Schlüssel <w>doch</w> noch gefunden."
                        }
                    ],
                    "synonyms": [
                        "trotzdem",
                        "dennoch"
                    ],
                    "common_phrases": [
                        "dann doch",
                        "doch noch"
                    ]
                },
                {
                    "sense_id": "57dca3fd-2969-3465-b02b-fd9e890c7f0b",
                    "sense_definition": "Mildert eine Aufforderung, Bitte oder einen Vorschlag ab und verleiht ihr einen freundlichen Ton.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aufforderung_abmildern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Komm <w>doch</w> heute Abend einfach bei uns auf ein Glas Wein vorbei!"
                        },
                        {
                            "text": "Probier <w>doch</w> mal dieses traditionelle Gericht aus unserer Region."
                        }
                    ],
                    "synonyms": [
                        "ruhig"
                    ],
                    "common_phrases": [
                        "komm doch mit",
                        "versuch es doch"
                    ]
                },
                {
                    "sense_id": "6df579b8-b12a-3e27-aad5-7152131b492a",
                    "sense_definition": "Dient als Modalpartikel der Bekräftigung einer Feststellung oder erinnert an einen bekannten Sachverhalt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bekraeftigung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Du weißt <w>doch</w> ganz genau, wie wichtig mir diese Prüfung ist."
                        },
                        {
                            "text": "Reg dich nicht auf, das ist <w>doch</w> überhaupt kein Problem für uns."
                        }
                    ],
                    "synonyms": [
                        "ja"
                    ],
                    "common_phrases": [
                        "du weißt doch",
                        "das ist doch"
                    ]
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "9e7446a2-1cca-3646-a892-8156589e8323",
                    "sense_definition": "Verbindet Sätze oder Satzteile im Sinne eines Gegensatzes oder einer Einschränkung; aber, jedoch.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gegensatz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich wollte ihr gerne helfen, <w>doch</w> sie lehnte mein freundliches Angebot ab."
                        },
                        {
                            "text": "Der Plan klang vielversprechend, <w>doch</w> die praktische Umsetzung erwies sich als äußerst schwierig."
                        }
                    ],
                    "synonyms": [
                        "aber",
                        "jedoch"
                    ],
                    "common_phrases": [
                        "und doch",
                        "doch nicht"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "9c7ee565-642a-33be-8ad3-a388f148413e",
                    "sense_definition": "Dient als bejahende Antwort auf eine verneinte Frage oder als Widerspruch gegen eine verneinte Aussage.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "widerspruch_verneinung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hast du heute keinen Hunger mehr? – <w>Doch</w>, ich möchte gerne eine Suppe essen."
                        },
                        {
                            "text": "Glaubst du mir etwa nicht? – <w>Doch</w>, ich vertraue dir bei dieser Entscheidung vollkommen."
                        }
                    ],
                    "synonyms": [
                        "ja"
                    ],
                    "antonyms": [
                        "nein"
                    ],
                    "common_phrases": [
                        "ja doch",
                        "aber doch"
                    ]
                }
            ]
        }
    ]
}