                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e2299efe-a8a8-3436-99ae-66085ac17fdc",
                        "entry_id": "46365eaa-f962-3ed4-b5f5-0cb16359f561",
                        "glosses": [
                            "past participle of bind."
