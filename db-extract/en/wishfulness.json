                        "entry_id": "781a5e5b-e6e6-3d3d-9db4-88a948412a2b",
                        "glosses": [
                            "The state or quality of being wishful."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f553319e-8095-4620-9bfe-e79c2ee6283c",
                                "sense_id": "3ec42512-5a5f-34b9-b6dd-1504609731f8",
                                "text": "She asked her little question with something of the softness of her old manner, with something of the longing loving wishfulness which used to make so many of her questions sweet to her mother’s ears."
                            },
                            {
                                "example_id": "15bf1973-b92b-4965-ad0f-89281ec6f914",
                                "sense_id": "3ec42512-5a5f-34b9-b6dd-1504609731f8",
                                "text": "[The film American Madness] simply hit too close to home for audiences in 1932: the wishfulness of its happy ending could not compensate for the familiarity of its painful subject."
                            }
                        ]
                    },
                    {
                        "sense_id": "16ebeef6-1dff-31dc-a24e-fd76285b43da",
                        "entry_id": "781a5e5b-e6e6-3d3d-9db4-88a948412a2b",
                        "glosses": [
                            "Wishful thinking."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "43b2920a-6363-45bd-83a3-9e68baba21e7",
                                "sense_id": "16ebeef6-1dff-31dc-a24e-fd76285b43da",
                                "text": "For the long lost glories, that never in fact existed save in the wishfulness of their brains, were being remembered with a reality as vivid, if not more so, as truth itself."
                            },
                            {
                                "example_id": "54dd2762-4981-4bdb-9502-fb77939f2b29",
                                "sense_id": "16ebeef6-1dff-31dc-a24e-fd76285b43da",
                                "text": "[…] Gov. Eliot Spitzer has made New York the latest state to travel down a murky legal road, to a place where laws are made not in response to facts, but to wishfulness and fear."
                            }
                        ]
                    }
