                "senses": [
                    {
                        "sense_id": "d9e4cc2b-012b-3d82-afcb-188ec23dd782",
                        "entry_id": "13743820-f9de-3814-b381-d901ca25cc40",
                        "glosses": [
                            "ausgelassenes, streichbares Fett von der Gans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a438cf8d-79bc-483c-8573-46bbafa6b4e9",
                                "sense_id": "d9e4cc2b-012b-3d82-afcb-188ec23dd782",
                                "text": "„In einem schweren Bräter etwas Fett, bevorzugt Enten- oder Gänseschmalz, schmelzen und den Würzvogel darin auf allen Seiten bräunen.“"
                            },
                            {
                                "example_id": "93b74c73-2742-4b50-8a06-ac9c058de6a0",
                                "sense_id": "d9e4cc2b-012b-3d82-afcb-188ec23dd782",
                                "text": "„Wo sich der Rest vom Emu versteckt, konnte bislang aber nicht geklärt werden. Nur im Topf landen sie offensichtlich nicht. Und Gänseschmalz sieht definitiv anders aus.“"
                            },
                            {
                                "example_id": "8ffa7c24-a66d-42c8-8d34-def6145b06e3",
                                "sense_id": "d9e4cc2b-012b-3d82-afcb-188ec23dd782",
                                "text": "„Ungeklärtes Gänseschmalz oder Hammelfett dagegen haben in der Fritteuse nichts zu suchen, sie entwickeln ein penetrantes Schweißfußaroma.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
