                "senses": [
                    {
                        "sense_id": "244c30f4-10b5-39c2-bd2b-9375baa3db69",
                        "entry_id": "52623b84-0339-37e8-ad44-37fd3ce65c98",
                        "glosses": [
                            "Qui a rapport à la providence ; qui est un effet de la providence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a554f9b-b1bc-4379-b0a4-08e5b95da438",
                                "sense_id": "244c30f4-10b5-39c2-bd2b-9375baa3db69",
                                "text": "Le Prince […] ne peut naturellement vous recevoir en ce moment, mais il juge que votre venue est providentielle. Une dernière grâce du ciel, un heureux présage."
                            },
                            {
                                "example_id": "6c188008-f081-4609-a636-c268946c8589",
                                "sense_id": "244c30f4-10b5-39c2-bd2b-9375baa3db69",
                                "text": "Il n'est pas rare de voir les maraîchers rétais charger le varech providentiel sur leurs remorques pour en engraisser les parcelles de pommes de terre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "980d95ec-739c-47d5-8807-d3d3545c0322",
                        "source_entry_id": "52623b84-0339-37e8-ad44-37fd3ce65c98",
                        "source_sense_id": "244c30f4-10b5-39c2-bd2b-9375baa3db69",
                        "target_lang_word": "providential",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "providential",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db26fb02-87d0-3c4c-9dce-f0356385f292",
                                        "entry_id": "d862a250-e931-31bf-9815-183d7f4cf286",
                                        "glosses": [
                                            "Pertaining to divine providence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34dd1324-8e3d-40f0-b458-d8724683896a",
                                                "sense_id": "db26fb02-87d0-3c4c-9dce-f0356385f292",
                                                "text": "The same belief underlay the providential view of history, in which the rise and fall of nations appeared as the expression of God's unsearchable purposes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a692c3d2-abea-35a0-a09a-4013d8a5f80a",
                                        "entry_id": "d862a250-e931-31bf-9815-183d7f4cf286",
                                        "glosses": [
                                            "Fortunate, as if occurring through the intervention of Providence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "444f0b01-4bee-4bd7-9c83-ed6f79bf0ca5",
                                                "sense_id": "a692c3d2-abea-35a0-a09a-4013d8a5f80a",
                                                "text": "“Why, Jane,” he cried, “what do you mean? What has our providential rescue to do with altering your feelings toward me? You are but unstrung—tomorrow you will be yourself again.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
