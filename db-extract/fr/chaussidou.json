                "senses": [
                    {
                        "sense_id": "0e5ca499-58a4-3006-9c4d-ed625ce4b9e8",
                        "entry_id": "19327a6d-45de-3d57-93bd-24cb46f0980f",
                        "glosses": [
                            "Aménagement de la chaussée où les voitures occupent une unique voie centrale en temps normal, ou empiètent sur les pistes cyclables en cas de croisement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8782a5c8-2286-42c0-bdd6-7bf3557fdb60",
                                "sense_id": "0e5ca499-58a4-3006-9c4d-ed625ce4b9e8",
                                "text": "Devant le centre commercial de l’Arboretum, le chaussidou disparaît et un plateau a été fait pour ralentir les véhicules motorisés et permettre aux piétons de traverser sans danger."
                            },
                            {
                                "example_id": "6ecd59a6-2761-4439-b086-65a42d38c03f",
                                "sense_id": "0e5ca499-58a4-3006-9c4d-ed625ce4b9e8",
                                "text": "Informelle et sous la responsabilité de chacun, cette opération (venez avec votre vélo et un reblochon) vise à sensibiliser les citoyens mais aussi les décideurs au développement de ce mode de déplacement et des infrastructures qui vont avec : création de pistes cyclables et sécurisation de celles déjà existantes, aménagement d’un chaussidou, installation de range-vélos dans les communes."
                            },
                            {
                                "example_id": "242cd830-6c49-4d6c-945a-432c9353537a",
                                "sense_id": "0e5ca499-58a4-3006-9c4d-ed625ce4b9e8",
                                "text": "Le chaussidou, qui consiste à dessiner sur une route une piste, permet de contourner cette règle même s’il ne rassure pas toujours les usagers"
                            },
                            {
                                "example_id": "adce6f14-c82a-4b97-9bc9-882be381964b",
                                "sense_id": "0e5ca499-58a4-3006-9c4d-ed625ce4b9e8",
                                "text": "Toutes les personnes présentes ont indiqué utiliser le chaussidou en voiture, mais ce sont « les autres qui n’en comprennent pas le fonctionnement ! »"
                            }
                        ]
                    }
