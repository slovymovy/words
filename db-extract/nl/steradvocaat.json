                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eb196ec-7fb3-4944-bf31-e71776d76eef",
                                "sense_id": "fb214c9e-2df2-3fba-b716-5f8aa41b486a",
                                "text": "Terwijl de inleidende formaliteiten werden doorgenomen en er geen bezwaren voor de hoorzitting werden aangevoerd zag Eric dat steradvocaat Arvid Olofsson helaas ook deze keer helemaal nuchter leek te zijn."
                            },
