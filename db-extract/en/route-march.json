                ],
                "senses": [
                    {
                        "sense_id": "b393e703-4e90-3835-a438-a4f0ebb8d85c",
                        "entry_id": "0216dae5-f9c1-3ea7-aaac-3745cb2bbb73",
                        "glosses": [
                            "To go or send on a route-march."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74efa1fe-6dba-4926-899d-2dcf9aff5277",
                                "sense_id": "b393e703-4e90-3835-a438-a4f0ebb8d85c",
                                "text": "The troops drilled, trained, route-marched, and adapted to military life and to each other."
                            },
                            {
                                "example_id": "e6cd3436-f5aa-4daa-925a-c7969b876639",
                                "sense_id": "b393e703-4e90-3835-a438-a4f0ebb8d85c",
                                "text": "The Battalion of East Surreys billeted in its sad empty houses was route-marched through the rain around Stirling."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a681468-793d-3f6d-b110-ee94b8289ff7",
                        "entry_id": "0216dae5-f9c1-3ea7-aaac-3745cb2bbb73",
                        "glosses": [
                            "To go or send on a long, exhausting tour by foot."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "1255238c-fcf7-4c77-bed8-24eae0e8fb5b",
                                "sense_id": "9a681468-793d-3f6d-b110-ee94b8289ff7",
                                "text": "I always describe Deaf School as my tertiary education, I was route-marched around galleries and museums for the entire week, with running commentaries by informed people."
                            }
                        ]
                    }
                ],
