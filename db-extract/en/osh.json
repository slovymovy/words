                                        "glosses": [
                                            "Ville du Kirghizistan, centre administratif de la province du même nom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10fd866f-502a-4e8d-aaed-72aecf5d3038",
                                                "sense_id": "5e624721-ff89-3037-954a-2a7bb2c0a06a",
                                                "text": "Notre véhicule slalome entre les carcasses brûlées des voitures et les chicanes qui jalonnent les rues d’Och, quasi désertes."
                                            },
                                            {
                                                "example_id": "849b090b-1373-431c-aa9b-0bb6dfacadd1",
                                                "sense_id": "5e624721-ff89-3037-954a-2a7bb2c0a06a",
                                                "text": "Les violents affrontements entre la population kirghize et la minorité ouzbèke ont fait plus d’une centaine de morts et 1500 blessés dans la ville d’Och et dans le sud-ouest du Kirghizstan."
                                            }
                                        ]
                                    }
                                ]
                            }
