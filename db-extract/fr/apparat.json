                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "230075b8-7dc5-4ec2-9c59-446e302c5d5d",
                                                "sense_id": "e0ab2286-c447-3b5f-8cc6-d7074a9ec135",
                                                "text": "Er sonnte sich im Glanz seines Sieges."
                                            }
