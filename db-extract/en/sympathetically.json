                        "entry_id": "9a882468-0197-307a-8806-c234b2f8a510",
                        "glosses": [
                            "Owing to or showing evidence of sympathy, or affinity; happening through or demonstrating correspondences, whether occult or physiological."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42a66a04-73a1-456d-a630-9657d0ca05ed",
                                "sense_id": "0c87aa08-7ab9-325b-8eb3-de030526061e",
                                "text": "I feel sure that here before me were assembled those, in whose unhealing hearts the sight of those bleak tablets sympathetically caused the old wounds to bleed afresh."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c279e7b-a646-3599-84a1-77a2900a2b64",
                        "entry_id": "9a882468-0197-307a-8806-c234b2f8a510",
                        "glosses": [
                            "In a manner which demonstrates a sharing in the feelings of others; compassionately."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57ac3c69-0e6e-4bdc-b87d-e4b3c7b71bf5",
                                "sense_id": "7c279e7b-a646-3599-84a1-77a2900a2b64",
                                "text": "Still she didn't stir, so he patted her shoulder and added sympathetically, 'Come now, don't take it so much to heart.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cdf34f0f-dcfe-4b7b-9069-fcc12743d1a5",
                        "source_entry_id": "9a882468-0197-307a-8806-c234b2f8a510",
                        "source_sense_description": "demonstrating a sharing in the feelings of others",
                        "target_lang_word": "sympathiquement",
