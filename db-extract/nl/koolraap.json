                "senses": [
                    {
                        "sense_id": "669edde4-4624-3991-a7d6-59fc7bab76d2",
                        "entry_id": "c529b044-f438-3cbe-896b-592317b6d7ef",
                        "glosses": [
                            "Brassica napobrassica een plant uit de kruisbloemenfamilie (Brassicaceae). Een koolraap is de wortel van deze plant. Het jonge blad wordt 'snijmoes' of 'snijkool' genoemd en wordt eveneens gegeten. Koolraap werd vroeger in het Friese kleigebied, de Bommelerwaard, Gelderland, Noord-Limburg en Noord-Brabant verbouwd voor zowel dierlijke (veevoer) als menselijke consumptie. Tegenwoordig wordt het in Nederland weinig meer gegeten en is het een van de zogenoemde vergeten groenten"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bae1a1e1-75cc-4a09-ab9a-798253a6c21e",
                        "source_entry_id": "c529b044-f438-3cbe-896b-592317b6d7ef",
                        "source_sense_id": "669edde4-4624-3991-a7d6-59fc7bab76d2",
                        "target_lang_word": "Kohlrübe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kohlrübe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ffbf3a1-34f6-3526-a8e5-774cb10149ca",
                                        "entry_id": "b67422e1-d3e1-3e5a-8358-3f6f2957f253",
                                        "glosses": [
                                            "Rübe mit dickfleischiger, gelber oder weißer, essbarer Wurzel (Brassica napus subsp. rapifera; Syn.: Brassica napus subsp. napobrassica)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e0000c2-d006-4a3f-a908-67c4810a6b04",
                                                "sense_id": "0ffbf3a1-34f6-3526-a8e5-774cb10149ca",
                                                "text": "Zu Unrecht wird die Kohlrübe als Arme-Leute-Essen abqualifiziert."
                                            },
                                            {
                                                "example_id": "c432cb1f-1fa7-4551-b0a4-9a7a83e03e00",
                                                "sense_id": "0ffbf3a1-34f6-3526-a8e5-774cb10149ca",
                                                "text": "„Die Kohlrübe, Steckrübe, Wrucke, Erdkohlrabi, Bodenkohlrabi, Unterkohlrabi, Krautrübe, Dorſch, ſchwediſche Kohlrübe oder Rutabaga (Brassica napus rapifera DC.) ⚇ kann als eine durch die Cultur entſtandene Varietät des Rapſes (Brassica napus oleifera DC.) ⚇ angeſehen werden.“"
                                            },
                                            {
                                                "example_id": "e4a6f4d9-f3f0-4e59-9dad-391b14e1ef76",
                                                "sense_id": "0ffbf3a1-34f6-3526-a8e5-774cb10149ca",
                                                "text": "„Es gab kaum etwas, das sich nicht aus Kohlrüben zusammenmixen ließ, selbst Bier- und Puddingersatz wurden aus Steckrüben hergestellt.“"
                                            },
                                            {
                                                "example_id": "d2343676-af12-4ac1-88ae-6c970a3ba25e",
                                                "sense_id": "0ffbf3a1-34f6-3526-a8e5-774cb10149ca",
                                                "text": "„Desgleichen mißlang ihm der Rosenkohl, ebenso die Auberginen, die Kohlrüben und die Brunnenkresse, die er in einem Kübel hatte ziehen wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "08a114bd-3227-349e-8e4b-9548bce2c032",
                                        "entry_id": "b67422e1-d3e1-3e5a-8358-3f6f2957f253",
                                        "glosses": [
                                            "Kohl mit dickfleischigem, knollenförmigem, essbarem Stängel (Brassica oleracea var. gongylodes)"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0121ab43-f326-415c-aced-ba35b2271c00",
                                                "sense_id": "08a114bd-3227-349e-8e4b-9548bce2c032",
                                                "text": "„Die Gemüsebauern im Eferdinger Becken, der oberösterreichischen Hochburg im Gemüseanbau, bekommen im Vergleich zum Vorjahr um bis zu zwei Drittel weniger. Besonders betroffen sind alle Arten von Kohlgemüse, wie Kohlrüben, Kraut und Karfiol sowie Erdäpfel und Gurken.“"
                                            },
                                            {
                                                "example_id": "5e40182b-5518-460a-9bea-452c1bb45f63",
                                                "sense_id": "08a114bd-3227-349e-8e4b-9548bce2c032",
                                                "text": "„‚Manche Kunden sagen, der Kohlrabi ist jetzt im Winter noch zarter als im Sommer‘, lacht Gratze und empfiehlt, die Kohlrüben einfach roh zu essen oder als gute Kohlrabisauce zum Fleisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b6305b39-a753-3e6a-92a1-6ed1fc8a45e2",
                                        "entry_id": "b67422e1-d3e1-3e5a-8358-3f6f2957f253",
                                        "glosses": [
                                            "Kopf"
                                        ],
                                        "tags": [
                                            "casual",
                                            "jocular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26836973-7ee0-4c29-9fff-d15249aa5ce4",
                                                "sense_id": "b6305b39-a753-3e6a-92a1-6ed1fc8a45e2",
                                                "text": "„‚Säg mir bloß nicht die Glotzer aus der Kohlrübe‘, sagt Maack freundschaftlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b06583f6-5d09-4efd-a566-11c1d2122bca",
                        "source_entry_id": "c529b044-f438-3cbe-896b-592317b6d7ef",
                        "source_sense_id": "669edde4-4624-3991-a7d6-59fc7bab76d2",
                        "target_lang_word": "Steckrübe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steckrübe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cad9b4e2-71e0-3280-8131-6e401a5c7f16",
                                        "entry_id": "8debcb5b-6de2-37df-b488-5ddd5b87bac4",
                                        "glosses": [
                                            "Rübe mit dickfleischiger, gelber oder weißer, essbarer Wurzel (Brassica napus subsp. rapifera; Syn.: Brassica napus subsp. napobrassica)"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "rare",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3498c896-108d-465a-90b9-00b7c4ff65ef",
                                                "sense_id": "cad9b4e2-71e0-3280-8131-6e401a5c7f16",
                                                "text": "„Lieber Gott, mach, daß es heite keene Steckrüben gibt!“"
                                            },
                                            {
                                                "example_id": "86bec80d-9b36-4970-9f35-8be1b36f6221",
                                                "sense_id": "cad9b4e2-71e0-3280-8131-6e401a5c7f16",
                                                "text": "„Die Schilderungen dessen, wovon sich das hungernde Petersburg ernährt, lesen sich wie ein Lexikon des Absurden – von den geschlachteten Tieren des Zoologischen Gartens bis zur Anfertigung spezieller Rabenfallen. ‚Wir aßen sonderbare Dinge: gefrorene Kartoffeln und verfaulte Steckrüben und Heringe, denen man Kopf und Schwanz abschneiden mußte, damit sie nicht so stanken. […]‘“"
                                            },
                                            {
                                                "example_id": "b823b3d1-dee3-4f33-997a-1c96865b91d7",
                                                "sense_id": "cad9b4e2-71e0-3280-8131-6e401a5c7f16",
                                                "text": "„Er träumte noch lange von der köstlichen, zu hauchdünnen Schnitzeln zerteilten Pferdeleber, zu der er einer unbekannten Wachebeamtenfamilie verholfen hatte, aß wütend die Graupensuppe mit Steckrüben, die Marianne kochte, und wusste, er hatte »das Richtige« getan.“"
                                            },
                                            {
                                                "example_id": "7fc6387f-08f0-4268-8245-6d31cc9189e7",
                                                "sense_id": "cad9b4e2-71e0-3280-8131-6e401a5c7f16",
                                                "text": "„Einzig verfügbar war die Steckrübe, eine Kohlart, die eigentlich als Futter für Schweine angebaut wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bab95b1-67a8-4229-b660-5aa776e14491",
