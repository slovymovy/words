                        "glosses": [
                            "C₁₇H₁₉NO₃ een alkaloïde dat het werkzame bestanddeel van opium is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfa19587-2e8c-454e-96a3-4b8a86191591",
                                "sense_id": "3310f3fc-2b87-3f79-a0fd-97edc4df0c9e",
                                "text": "Hem werd morfine toegediend vanwege de hevige pijnen wooronder hij leed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0edce063-831f-4484-b31f-b14e038a6a88",
                        "source_entry_id": "eee5c862-d6c0-3831-af22-1900bbe35472",
                        "source_sense_id": "3310f3fc-2b87-3f79-a0fd-97edc4df0c9e",
                        "source_sense_description": "een alkaloïde dat het werkzame bestanddeel van opium is",
                        "target_lang_word": "Morphin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Morphin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87515a20-c832-3cd3-a5c0-3b0171df8c53",
                                        "entry_id": "1b8014ff-42bc-3090-95e0-15abc0918e85",
                                        "glosses": [
                                            "Betäubungsmittel, das aus Opium gewonnen wird und hauptsächlich in der Medizin als starkes Schmerzmittel eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83498975-f3e6-4c09-b90d-237421418731",
                                                "sense_id": "87515a20-c832-3cd3-a5c0-3b0171df8c53",
                                                "text": "Seine Schmerzen durch den schweren Autounfall linderten die Ärzte mit Morphin."
                                            },
                                            {
                                                "example_id": "8d6ca436-f610-46b0-9841-788826effbe5",
                                                "sense_id": "87515a20-c832-3cd3-a5c0-3b0171df8c53",
                                                "text": "Morphin löst sich zur schwer in Wasser, deshalb kommen häufig seine Salze zur Anwendung."
                                            },
                                            {
                                                "example_id": "afe16045-7210-459f-99dc-e00768fa8bd4",
                                                "sense_id": "87515a20-c832-3cd3-a5c0-3b0171df8c53",
                                                "text": "„Das Morphin wirkte immer noch, daher waren seine Schmerzen erträglich, aber er tat sich andererseits auch schwer, seine Gedanken zusammenzuhalten.“"
                                            },
                                            {
                                                "example_id": "ce978ce0-6b27-4072-a04d-a233733f8bcf",
                                                "sense_id": "87515a20-c832-3cd3-a5c0-3b0171df8c53",
                                                "text": "„Morphin wurde bald als Schlafmittel verwendet, von den 1870er Jahren an auch als Sedativum bei erregten Kranken in psychiatrischen Anstalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "329eec45-dd48-4f96-98ca-527879776fa9",
                        "source_entry_id": "eee5c862-d6c0-3831-af22-1900bbe35472",
                        "source_sense_id": "3310f3fc-2b87-3f79-a0fd-97edc4df0c9e",
