                                "example_id": "72341404-e9cf-4a67-923c-71891538dbb1",
                                "sense_id": "ab0abdd9-aaeb-34b3-9c15-31f359b64b3c",
                                "text": "Tradycje szaserów w okresie międzywojennym kontynuowało w wojsku polskim dziesięć pułków kawalerii"
                            }
                        ],
