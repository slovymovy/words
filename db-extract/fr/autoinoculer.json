                        "sense_id": "570fb1e4-a00b-35f6-8e22-16a2ed0a9189",
                        "entry_id": "e59a82b1-6f94-3d40-8297-55d3e0d2abf4",
                        "glosses": [
                            "Inoculer à soi-même, ou quelque chose qui provient du destinataire de l'inoculation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0f53cf6-ab0b-4e18-a13f-9390fcb805f7",
                                "sense_id": "570fb1e4-a00b-35f6-8e22-16a2ed0a9189",
                                "text": "Il faut louer l'habileté technique de pareils expérimentateurs capables de s'autoinoculer dans la trachée."
                            },
                            {
                                "example_id": "5927733a-474f-409a-bef7-c472ac612fc7",
                                "sense_id": "570fb1e4-a00b-35f6-8e22-16a2ed0a9189",
                                "text": "Tant que la roséole n'est pas apparue, l'infection peut n'être pas généralisée, et ce qui prouve que l'infection n'est généralisée que lors de la roséole, c'est que certains malades peuvent s'autoinoculer d'une région à une autre avant l'apparition de la roséole."
                            }
                        ]
                    }
