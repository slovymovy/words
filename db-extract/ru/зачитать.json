                        ],
                        "form": "зачита́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0cb6e3f0-8d3a-31a7-bb49-c7e718eab976",
                        "entry_id": "6e0f858b-e8e6-3754-89a3-d34e475330be",
                        "glosses": [
                            "офиц. чтением вслух довести что-нибудь до сведения собрания, огласить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e390633-2587-46b9-b28e-07f4757f1c5f",
                                "sense_id": "0cb6e3f0-8d3a-31a7-bb49-c7e718eab976",
                                "text": "Зачитать протокол."
                            },
                            {
                                "example_id": "d76f80d3-de14-4ebe-942b-707ab6368bc7",
                                "sense_id": "0cb6e3f0-8d3a-31a7-bb49-c7e718eab976",
                                "text": "Зачитать новую пьесу на собрании драмкружка."
                            }
                        ]
                    },
                    {
                        "sense_id": "a76b9dfa-f140-3a1f-90bf-8cdf12b12828",
                        "entry_id": "6e0f858b-e8e6-3754-89a3-d34e475330be",
                        "glosses": [
                            "чтением вслух довести кого-нибудь до изнеможения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "532c7ac7-7d8f-404d-b9c3-11c7de08b44b",
                                "sense_id": "a76b9dfa-f140-3a1f-90bf-8cdf12b12828",
                                "text": "С ночи до бела дня читают и читают и до смерти меня убийцы зачитают."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6dbf4c3-43cc-3de5-a74a-99b6b9d187b9",
                        "entry_id": "6e0f858b-e8e6-3754-89a3-d34e475330be",
                        "glosses": [
                            "читая лекцию, прочитать дольше положенного времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2824d257-8c34-4c0c-89dc-5a15a64743ec",
                                "sense_id": "e6dbf4c3-43cc-3de5-a74a-99b6b9d187b9",
                                "text": "Зачитать полчаса."
                            },
                            {
                                "example_id": "ce9c66c5-9fee-4789-b0fe-e44d66599c1a",
                                "sense_id": "e6dbf4c3-43cc-3de5-a74a-99b6b9d187b9",
                                "text": "Сегодня профессор зачитал."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f0bab1c-bad1-3e6e-9bf1-add2906dc0c5",
                        "entry_id": "6e0f858b-e8e6-3754-89a3-d34e475330be",
                        "glosses": [
                            "перен., разг. небрежным обращением при чтении испачкать, изорвать, затаскать книгу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76cd47f1-208d-4d37-89e7-18c13edc5463",
                                "sense_id": "7f0bab1c-bad1-3e6e-9bf1-add2906dc0c5",
                                "text": "Зачитал книгу до дыр."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3bf6a4d-5c73-36ab-a815-6d3f0724e184",
                        "entry_id": "6e0f858b-e8e6-3754-89a3-d34e475330be",
                        "glosses": [
                            "перен., разг. взяв (книгу) для прочтения, оставить у себя навсегда, не вернуть владельцу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eec6b2d-5700-4474-931f-6f21004cb96c",
                                "sense_id": "e3bf6a4d-5c73-36ab-a815-6d3f0724e184",
                                "text": "Кто-то зачитал у меня 1-й том Пушкина."
                            },
                            {
                                "example_id": "dedd6ee9-19d3-4a31-a5a4-ca85897e57db",
                                "sense_id": "e3bf6a4d-5c73-36ab-a815-6d3f0724e184",
                                "text": "К огромному огорчению, этот альбом у меня взял на короткое время один «любитель литературы» и зачитал его навсегда."
                            }
                        ]
                    },
                    {
                        "sense_id": "49e4d59e-c869-3b6d-9640-605a8ac7c031",
                        "entry_id": "6e0f858b-e8e6-3754-89a3-d34e475330be",
                        "glosses": [
                            "перен., разг. исполнить речитатив"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "021b6490-bf26-42d5-9ef1-5b71aa66da2e",
                                "sense_id": "49e4d59e-c869-3b6d-9640-605a8ac7c031",
                                "text": "Зачитать рэп."
                            }
                        ]
                    }
