                                        "entry_id": "236f1412-e553-3171-afc2-a9446d6d68ff",
                                        "glosses": [
                                            "In a verdant manner; in a fashion indicating greenness (green color.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "654a7693-4e94-4124-b570-e2910fdd02ef",
                                                "sense_id": "08e6d8b8-6476-3c41-b755-a8d0d001caa6",
                                                "text": "Let thy loveliness fade as it will; / And, around the dear ruin each wish of my heart / Would entwine itself verdantly still!"
                                            },
                                            {
                                                "example_id": "98d3916a-e827-42c0-8efb-766a2723cd14",
                                                "sense_id": "08e6d8b8-6476-3c41-b755-a8d0d001caa6",
                                                "text": "With that she left me, and soon returned with a volume, verdantly bound, and garnished with a curious frontispiece in green,—nothing less, than a fragment of real moss cunningly pressed to a fly-leaf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "890cbdb4-433e-3957-8711-2511dde3ffdc",
                                        "entry_id": "236f1412-e553-3171-afc2-a9446d6d68ff",
                                        "glosses": [
