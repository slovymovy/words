                                "target_lang_sense_clarification": "Gebrauch von Schimpfwörtern oder Fluchwörtern"
                            },
                            {
                                "target_lang_word": "das Schimpfen",
                                "target_lang_sense_clarification": "das Ausstoßen böser Worte"
                            },
                            {
