                ],
                "senses": [
                    {
                        "sense_id": "e6951d68-cfa1-3add-a7e1-aa730935975f",
                        "entry_id": "2ae3864d-9025-3b18-b2dd-601116acf5df",
                        "glosses": [
                            "Suchhilfe am Anschnitt einer Buchseite"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d22cf694-0ed0-4897-9823-77dcfa2e0cae",
                                "sense_id": "e6951d68-cfa1-3add-a7e1-aa730935975f",
                                "text": "„Handmarken bieten bloß eine farblich hervorgehobene Kennzeichnung für den jeweiligen Buchstabenbereich.“"
                            },
                            {
                                "example_id": "d0900506-8404-4d07-b027-499e03717605",
                                "sense_id": "e6951d68-cfa1-3add-a7e1-aa730935975f",
                                "text": "„Eine Handmarke oder Daumenregister ist eine farbige (schwarze) Fläche, die auf dem Außensteg sitzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fe249edc-d186-3d0f-8108-d9abde94fb43",
                        "entry_id": "2ae3864d-9025-3b18-b2dd-601116acf5df",
                        "glosses": [
                            "gewollter Fingerabdruck auf Ziegelstein"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "cacfb41c-904a-4780-a781-509b14f40a09",
                                "sense_id": "fe249edc-d186-3d0f-8108-d9abde94fb43",
                                "text": "„Darnach wird es sich empfehlen, bei künftigen Ziegelstempelveröffentlichungen stets die Form des Ziegels und die Handmarke mit abzubilden.“"
                            },
                            {
                                "example_id": "9059ed2a-843d-420a-bf8f-aa9777200fe6",
                                "sense_id": "fe249edc-d186-3d0f-8108-d9abde94fb43",
                                "text": "„Beispiel eines viermal gestempelten Ziegels, der nachher noch mit einer Handmarke versehen wurde.“"
                            },
                            {
                                "example_id": "94f6317e-482a-4921-b713-4a85a052092a",
                                "sense_id": "fe249edc-d186-3d0f-8108-d9abde94fb43",
                                "text": "„Auf zahlreichen Fragmenten begegnen Reste von Wisch- oder Handmarken, die ein typisches Phänomen römischer Ziegel darstellen.“"
                            },
                            {
                                "example_id": "bf833980-0765-4960-ad2d-f32da808b01f",
                                "sense_id": "fe249edc-d186-3d0f-8108-d9abde94fb43",
                                "text": "„Mehrere Fragmente tragen auch verschiedene Handmarken.“"
                            },
                            {
                                "example_id": "d0795ff8-c35c-4fb3-9e9c-d113f3334e36",
                                "sense_id": "fe249edc-d186-3d0f-8108-d9abde94fb43",
                                "text": "„Unter den Funden der Leistenziegelplatten (tegulae) finden sich auch viele mit Stempeln und Handmarken.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
