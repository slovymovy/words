                "senses": [
                    {
                        "sense_id": "4e7c32aa-91ef-3773-ba99-229e807c62ef",
                        "entry_id": "e255f744-8ed3-359d-ae49-d54725d75d1e",
                        "glosses": [
                            "Réseau action climat, association spécialisée sur le thème des changements climatiques fondée en 1996."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "493d7fca-e65f-4828-a1e1-95eeb907e1ba",
                                "sense_id": "4e7c32aa-91ef-3773-ba99-229e807c62ef",
                                "text": "Pierre Leflaive, responsable transport du Réseau action climat (RAC), ajoute un deuxième impératif dans l’équation : la lutte contre le changement climatique, auquel le secteur aérien doit aussi contribuer en réduisant ses émissions de gaz à effet de serre."
                            },
                            {
                                "example_id": "850aa325-652d-4462-b2d4-25294fea030d",
                                "sense_id": "4e7c32aa-91ef-3773-ba99-229e807c62ef",
                                "text": "Arrêté du 7 février 2013 habilitant l’association Réseau Action Climat (RAC) à être désignée pour prendre part au débat sur l’environnement se déroulant dans le cadre des instances consultatives nationales"
                            },
                            {
                                "example_id": "b601decc-8a9f-470c-bd43-e46ab493580f",
                                "sense_id": "4e7c32aa-91ef-3773-ba99-229e807c62ef",
                                "text": "Le RAC a choisi de comptabiliser dans ces dépenses néfastes 45 milliards d’euros de « bouclier » tarifaire mis en place par le gouvernement pour faire face à la flambée des prix de l’énergie."
                            }
                        ]
                    }
