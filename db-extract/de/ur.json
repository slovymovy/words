                                "sense_id": "5b40b6d1-6b0c-3687-a752-2772e06304d0",
                                "text": "Das ist ur super!",
                                "translation": "That's really great!",
                                "english": "That's really great!"
                            },
                            {
                                "example_id": "e60726a5-b166-4989-b0d0-3ecdc40fa76c",
                                "sense_id": "5b40b6d1-6b0c-3687-a752-2772e06304d0",
                                "text": "Ich hab' ur nicht gewusst, was ich tun soll.",
                                "translation": "I had absolutely no idea what to do.",
                                "english": "I had absolutely no idea what to do."
                            },
                            {
                                "example_id": "ffadf426-b837-49a2-99da-b3ec6f14fff4",
                                "sense_id": "5b40b6d1-6b0c-3687-a752-2772e06304d0",
                                "text": "Das ist ur der Trottel!",
                                "translation": "That's totally an idiot!",
                                "english": "That's totally an idiot!"
                            },
                            {
                                "example_id": "da5650b3-2d1e-4324-adb8-0a591c0402ba",
                                "sense_id": "5b40b6d1-6b0c-3687-a752-2772e06304d0",
                                "text": "Das ist der ur Trottel!",
                                "translation": "That's a total idiot!",
                                "english": "That's a total idiot!"
                            }
                        ]
                    }
