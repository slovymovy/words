                "translations": [
                    {
                        "translation_id": "ccc7354c-2934-4d94-9810-2a3e4c94af51",
                        "source_entry_id": "ce1839ed-4afc-3b77-a77a-3665ecbad900",
                        "source_sense_id": "5c7188d4-f324-31d2-acf2-1523ad3008ef",
                        "target_lang_word": "cabanossi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabanossi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c21a431a-328a-3b70-8fb9-a611bff03c28",
                                        "entry_id": "2be7d937-21f6-3cee-87d1-f1ae30a69b91",
                                        "glosses": [
                                            "A kind of spicy smoked Australian sausage."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "965a0f50-9af8-4787-b189-85b989f85580",
                                                "sense_id": "c21a431a-328a-3b70-8fb9-a611bff03c28",
                                                "text": "Sprinkle partly cooked omelette with onion and capsicum mixture, cheese, cabanossi and olives."
                                            },
                                            {
                                                "example_id": "ea1e07c7-0de4-4473-a370-e0c4adde81a3",
                                                "sense_id": "c21a431a-328a-3b70-8fb9-a611bff03c28",
                                                "text": "At lunch, after a cold, hard haul, I gave my portion of reindeer cabanossi to Eric, Clark and Jose."
                                            },
                                            {
                                                "example_id": "c0544112-9ffc-4983-9a70-081fc2353455",
                                                "sense_id": "c21a431a-328a-3b70-8fb9-a611bff03c28",
                                                "text": "I grew up in country NSW but I have Austrian heritage, so my family ate a lot of European food, like schnitzel, dumplings, red cabbage, goulash and cabanossi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3923f3d8-046a-4c1b-8caf-0cf934ef694e",
                        "source_entry_id": "ce1839ed-4afc-3b77-a77a-3665ecbad900",
                        "source_sense_id": "5c7188d4-f324-31d2-acf2-1523ad3008ef",
                        "target_lang_word": "kabana",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kabana",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b12f7ba0-b250-3bc4-bf6c-df1a24b516b3",
                                        "entry_id": "9b6c559b-a05b-355f-8e19-f00917e88e64",
                                        "glosses": [
                                            "A spicy smoked Australian salami, made from pork and beef."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "501b984c-b9be-4fc0-b251-29778f66f427",
                                                "sense_id": "b12f7ba0-b250-3bc4-bf6c-df1a24b516b3",
                                                "text": "You can go for kabana, wedding sausage, csabai, smoked tongue, smoked butterfish or smoked chickens."
                                            },
                                            {
                                                "example_id": "17c35a12-69ed-4b05-a47b-ed42358536c9",
                                                "sense_id": "b12f7ba0-b250-3bc4-bf6c-df1a24b516b3",
                                                "text": "aged, cured and pickled meats and fish—game, caviar, herring, sausages (kabana, pepperoni, salami), bacon, hot-dogs"
                                            },
                                            {
                                                "example_id": "3b44555a-de2b-4e4a-84dd-00e822e830bc",
                                                "sense_id": "b12f7ba0-b250-3bc4-bf6c-df1a24b516b3",
                                                "text": "Peter Kennedy was gazing up at Lisa and her coconut when he suddenly felt a looming presence, an uncomfortably close breath and the smell of kabana sausage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
