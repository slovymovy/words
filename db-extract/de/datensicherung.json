                "senses": [
                    {
                        "sense_id": "eb666c4d-43b0-3279-97e3-ef2a39a7a243",
                        "entry_id": "c1f5b774-f68e-3ba0-9e9c-d8bb868a1e07",
                        "glosses": [
                            "Sauvegarde de données : le processus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4d861e6-0e3e-4278-ab81-792945eef4fa",
                                "sense_id": "eb666c4d-43b0-3279-97e3-ef2a39a7a243",
                                "text": "Zuständig für die tägliche Datensicherung ist der Systemadministrator.",
                                "translation": "L’administrateur système est responsable de la sauvegarde journalière."
                            }
                        ]
                    },
                    {
                        "sense_id": "ddafe27c-b463-3e56-a683-32d5345e97c4",
                        "entry_id": "c1f5b774-f68e-3ba0-9e9c-d8bb868a1e07",
                        "glosses": [
                            "Sauvegarde de données : la copie de sauvegarde générée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1d666f3-0e13-481c-ba70-8bfa8af3ca01",
                                "sense_id": "ddafe27c-b463-3e56-a683-32d5345e97c4",
                                "text": "Auf einen Mausklick scannt das Tool die ausgewählte Datensicherung und listet die neu übertragenen Dateien auf. Sie können so unnötig übertragene Dateien erkennen und diese in die Liste der nicht zu sichernden Dateien aufnehmen.",
                                "translation": "En un clic de souris, l’outil analyse la sauvegarde de données sélectionnée et répertorie les fichiers nouvellement transférés. Vous pouvez ainsi reconnaître les fichiers inutilement transférés et les ajouter à la liste des fichiers à ne pas sauvegarder."
                            }
                        ]
                    }
                ],
