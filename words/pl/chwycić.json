    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a0c9cec4-1639-3076-9e29-78029cf87920",
                    "sense_definition": "Szybko i mocno ująć coś lub kogoś dłonią",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_grab",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pasażer <chwycił> ciężką walizkę i wybiegł z pociągu.",
                            "target_lang_translations": {
                                "ru": "Пассажир <схватил> тяжелый чемодан и выбежал из поезда."
                            }
                        },
                        {
                            "text": "Musisz mocno <chwycić> kierownicę obiema rękami, żeby bezpiecznie prowadzić.",
                            "target_lang_translations": {
                                "ru": "Ты должен крепко <схватиться> за руль обеими руками, чтобы безопасно вести машину."
                            }
                        }
                    ],
                    "synonyms": [
                        "złapać",
                        "pochwycić",
                        "uchwycić",
                        "capnąć"
                    ],
                    "antonyms": [
                        "puścić",
                        "wypuścić"
                    ],
                    "common_phrases": [
                        "chwycić za rękę",
                        "chwycić za klamkę",
                        "chwycić w ramiona",
                        "chwycić za gardło"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро и крепко взять что-либо или кого-либо рукой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схватить",
                                "target_lang_sense_clarification": "резко взять рукой"
                            },
                            {
                                "target_lang_word": "ухватить",
                                "target_lang_sense_clarification": "крепко взять, удержать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "211733a1-98a7-31a6-9b43-eae22ec5c365",
                    "sense_definition": "Przytrzymać się czegoś rękami, aby zachować równowagę lub nie upaść (używane z \"się\")",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_grab",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Starsza pani <chwyciła się> poręczy, wchodząc powoli po schodach.",
                            "target_lang_translations": {
                                "ru": "Пожилая дама <ухватилась> за перила, медленно поднимаясь по лестнице."
                            }
                        },
                        {
                            "text": "Kiedy statek się zakołysał, wszyscy musieli <chwycić się> czegoś stabilnego.",
                            "target_lang_translations": {
                                "ru": "Когда корабль качнуло, все должны были <ухватиться> за что-то устойчивое."
                            }
                        }
                    ],
                    "synonyms": [
                        "przytrzymać się",
                        "uchwycić się"
                    ],
                    "antonyms": [
                        "puścić się"
                    ],
                    "common_phrases": [
                        "chwycić się poręczy",
                        "chwycić się za głowę",
                        "chwycić się deski ratunku"
                    ],
                    "target_lang_definitions": {
                        "ru": "Держаться за что-либо руками, чтобы сохранить равновесие или не упасть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схватиться",
                                "target_lang_sense_clarification": "удержаться за что-то"
                            },
                            {
                                "target_lang_word": "ухватиться",
                                "target_lang_sense_clarification": "крепко взяться за опору"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6c55585-60e2-36b3-875e-6d2fea4c210e",
                    "sense_definition": "Złapać kogoś lub coś uciekającego w celu pozbawienia wolności",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "capture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kot błyskawicznie <chwycił> mysz, która przebiegła przez kuchnię.",
                            "target_lang_translations": {
                                "ru": "Кот молниеносно <поймал> мышь, которая пробежала по кухне."
                            }
                        },
                        {
                            "text": "Policjantom udało się w końcu <chwycić> sprawcę kradzieży na gorącym uczynku.",
                            "target_lang_translations": {
                                "ru": "Полицейским удалось наконец <схватить> вора на месте преступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "złapać",
                        "pojmać",
                        "schwytać"
                    ],
                    "antonyms": [
                        "uwolnić",
                        "wypuścić"
                    ],
                    "common_phrases": [
                        "chwycić złodzieja",
                        "chwycić na gorącym uczynku"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поймать кого-то или что-то убегающее с целью лишения свободы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поймать",
                                "target_lang_sense_clarification": "захватить беглеца"
                            },
                            {
                                "target_lang_word": "схватить",
                                "target_lang_sense_clarification": "задержать преступника"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52456de5-82e0-3dee-b902-039ace7f9306",
                    "sense_definition": "Wykorzystać nadarzającą się okazję lub sprzyjającą sytuację",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opportunity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Powinieneś <chwycić> tę okazję i wyjechać na staż za granicę.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит <воспользоваться> этой возможностью и поехать на стажировку за границу."
                            }
                        },
                        {
                            "text": "Firma <chwyciła> szansę na rozwój, wprowadzając nowy produkt na rynek.",
                            "target_lang_translations": {
                                "ru": "Компания <ухватилась> за шанс на развитие, выпустив новый продукт на рынок."
                            }
                        }
                    ],
                    "synonyms": [
                        "wykorzystać"
                    ],
                    "antonyms": [
                        "zmarnować",
                        "przegapić"
                    ],
                    "common_phrases": [
                        "chwycić okazję",
                        "chwycić szansę",
                        "chwycić wiatr w żagle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Воспользоваться представившейся возможностью или благоприятной ситуацией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воспользоваться",
                                "target_lang_sense_clarification": "использовать шанс"
                            },
                            {
                                "target_lang_word": "ухватиться",
                                "target_lang_sense_clarification": "активно использовать шанс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "500a4d4c-0af2-301d-a7e9-41e6ec5bbe25",
                    "sense_definition": "Zrozumieć sens czegoś lub pojąć, o co chodzi",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dopiero po dłuższej chwili <chwycił>, że to był tylko żart.",
                            "target_lang_translations": {
                                "ru": "Только спустя долгое время он <понял>, что это была всего лишь шутка."
                            }
                        },
                        {
                            "text": "Uczeń bardzo szybko <chwycił> zasady rozwiązywania tych trudnych zadań.",
                            "target_lang_translations": {
                                "ru": "Ученик очень быстро <схватил> правила решения этих сложных задач."
                            }
                        }
                    ],
                    "synonyms": [
                        "zrozumieć",
                        "pojąć",
                        "załapać"
                    ],
                    "common_phrases": [
                        "chwycić w lot",
                        "chwycić sens",
                        "chwycić aluzję"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Понять смысл чего-либо или осознать, в чем дело."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схватить",
                                "target_lang_sense_clarification": "быстро понять суть"
                            },
                            {
                                "target_lang_word": "понять",
                                "target_lang_sense_clarification": "осознать смысл"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d552722d-f633-3bcf-a6f2-d8a3162f052b",
                    "sense_definition": "Zabrać się energicznie do jakiegoś zajęcia lub pracy (używane z \"się\")",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy <chwycić się> roboty, żeby zdążyć ze wszystkim przed wieczorem.",
                            "target_lang_translations": {
                                "ru": "Мы должны <взяться> за работу, чтобы успеть со всем до вечера."
                            }
                        },
                        {
                            "text": "Po utracie pracy nie wiedział, jakiego zajęcia <chwycić się> w nowym mieście.",
                            "target_lang_translations": {
                                "ru": "После потери работы он не знал, за какое занятие <взяться> в новом городе."
                            }
                        }
                    ],
                    "synonyms": [
                        "zabrać się",
                        "podjąć się"
                    ],
                    "common_phrases": [
                        "chwycić się roboty",
                        "chwycić się sposobu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Энергично взяться за какую-либо работу или занятие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взяться",
                                "target_lang_sense_clarification": "начать делать что-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05f884d5-7c9a-3322-932a-a1fd1072ab3c",
                    "sense_definition": "Zorientować się w swoim zachowaniu lub myślach (używane z \"się\")",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W ostatniej chwili <chwycił się> na tym, że prawie zdradził sekret.",
                            "target_lang_translations": {
                                "ru": "В последний момент он <поймал себя> на том, что чуть не выдал секрет."
                            }
                        },
                        {
                            "text": "Często <chwycił się> na myśleniu o niebieskich migdałach podczas lekcji.",
                            "target_lang_translations": {
                                "ru": "Он часто <ловил себя> на том, что витает в облаках во время урока."
                            }
                        }
                    ],
                    "synonyms": [
                        "zreflektować się"
                    ],
                    "common_phrases": [
                        "chwycić się na myśli",
                        "chwycić się na słowie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осознать свое поведение или мысли в момент совершения действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поймать себя",
                                "target_lang_sense_clarification": "осознать свои мысли или действия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}