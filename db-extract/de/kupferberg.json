                "senses": [
                    {
                        "sense_id": "d5f2438e-8e6b-336c-ada9-98afc5566fe6",
                        "entry_id": "ae6ed2cb-2a5a-3d21-aa44-e7f2f21a4963",
                        "glosses": [
                            "eine Stadt in Bayern, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e76ef81-a9df-49f9-a020-a65e27fecf8f",
                                "sense_id": "d5f2438e-8e6b-336c-ada9-98afc5566fe6",
                                "text": "Kupferberg liegt im Südosten von Deutschland."
                            },
                            {
                                "example_id": "954f51e9-23cc-4357-9420-4ae9730db53d",
                                "sense_id": "d5f2438e-8e6b-336c-ada9-98afc5566fe6",
                                "text": "Die Stadt Kupferberg hat ungefähr 1.000 Einwohner."
                            },
                            {
                                "example_id": "4d8fd410-d8c8-467d-b058-93b4116947bd",
                                "sense_id": "d5f2438e-8e6b-336c-ada9-98afc5566fe6",
                                "text": "„Kupferberg ist bekannt für seine Bergbaugeschichte.“"
                            },
                            {
                                "example_id": "48abdfdc-220c-4ae0-a8c5-2cfc1cddeaa3",
                                "sense_id": "d5f2438e-8e6b-336c-ada9-98afc5566fe6",
                                "text": "„Die bereits im 14. Jahrhundert verliehenen Stadtrechte hat Kupferberg ergiebigen Kupferfunden zu verdanken.“"
                            },
                            {
                                "example_id": "402a78f4-5e1a-4ae8-a3a5-cd3d3e31cc01",
                                "sense_id": "d5f2438e-8e6b-336c-ada9-98afc5566fe6",
                                "text": "„Ein weiterer kleiner, rund fünf Kilometer langer, familienfreundlicher Weg, soll rund um die Stadt Kupferberg entstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
