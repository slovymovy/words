                    }
                ],
                "senses": [
                    {
                        "sense_id": "08caadad-1a56-3213-9924-d0b64369964d",
                        "entry_id": "6c0544d6-3021-3e3d-b306-8d4092922a09",
                        "glosses": [
                            "A press used to extract juice from grapes as the first step of winemaking."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69574abd-75ed-41a7-a33a-4a4e3e71d2d3",
                                "sense_id": "08caadad-1a56-3213-9924-d0b64369964d",
                                "text": "Which make oyle within their walles, and tread their winepreſſes, and ſuffer thirſt."
                            },
                            {
                                "example_id": "7b54ef50-ca47-4a62-b30a-4a0dadfe5356",
                                "sense_id": "08caadad-1a56-3213-9924-d0b64369964d",
                                "text": "And the Angel thruſt in his ſickle into the earth, and gathered the vine of the earth, & cast it into the great winepreſſe of the wrath of God."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0dff9b6e-e138-4447-98a8-be5e591dd88b",
                        "source_entry_id": "6c0544d6-3021-3e3d-b306-8d4092922a09",
                        "source_sense_id": "08caadad-1a56-3213-9924-d0b64369964d",
                        "source_sense_description": "device for squeezing grapes",
                        "target_lang_word": "pressoir vinicole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "eba18752-ed2b-446d-a139-24383e22e8b9",
                        "source_entry_id": "6c0544d6-3021-3e3d-b306-8d4092922a09",
                        "source_sense_id": "08caadad-1a56-3213-9924-d0b64369964d",
                        "source_sense_description": "device for squeezing grapes",
                        "target_lang_word": "pressoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pressoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9dffe261-e9d6-349f-8fe4-5eae3c9b3de5",
                                        "entry_id": "44ec7ade-8e63-32bc-bf57-0f41d8d98ef3",
                                        "glosses": [
                                            "Machine servant à presser du raisin, des pommes, etc., pour faire du vin, du cidre, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d03c24d-483a-46a7-9637-4e372b72fa31",
                                                "sense_id": "9dffe261-e9d6-349f-8fe4-5eae3c9b3de5",
                                                "text": "Philippe. – Je m’épuise, vois-tu ! j’ai trop réfléchi ici-bas ; j’ai trop tourné sur moi-même, comme un cheval de pressoir ; je ne vaux plus rien pour la bataille."
                                            },
                                            {
                                                "example_id": "763e0825-0f3a-44be-9f24-81a017e4b848",
                                                "sense_id": "9dffe261-e9d6-349f-8fe4-5eae3c9b3de5",
                                                "text": "Le pressoir a la forme d' une cuve carrée, au-dessus s'étend une poutrelle reposant par chaque extrémité sur une haute fourche ; de cette poutrelle pendent, soit des plaques de bois entre lesquelles on écrase le raisin, soit de longs boyaux d' étoffe dans lesquels on presse la grappe pour en extraire le jus."
                                            },
                                            {
                                                "example_id": "8f36c77e-fee2-417d-8f64-f7a1874920cc",
                                                "sense_id": "9dffe261-e9d6-349f-8fe4-5eae3c9b3de5",
                                                "text": "Les parages du Rousset et de la forêt de Lente, les vallons obscurs de Bouvante et de Cordéac furent serrés comme dans un pressoir à vis par des gels qui écrabouillaient tout ce qu’il y avait de vivant ou le faisaient gicler hors des frontières."
                                            },
                                            {
                                                "example_id": "f4db2b7c-ea95-4ce5-b841-09d54de1971a",
                                                "sense_id": "9dffe261-e9d6-349f-8fe4-5eae3c9b3de5",
                                                "text": "Plusieurs pressoirs à olives subsistent encore dans les ruines de Karanis, car les oliviers étaient nombreux dans l’oasis voisine du Fayoum."
                                            },
                                            {
                                                "example_id": "631b16e7-d101-431f-b611-115e16b79cd1",
                                                "sense_id": "9dffe261-e9d6-349f-8fe4-5eae3c9b3de5",
                                                "text": "Il gardait en mémoire ces imposants pressoirs en bois dans leur cuvage, la macération du moût, son odeur âcre et vinaigrée, la cave humide à laquelle on accédait par un large escalier en pierre."
                                            },
                                            {
                                                "example_id": "2b369212-7f5a-40f2-ae67-2335cf786bb7",
                                                "sense_id": "9dffe261-e9d6-349f-8fe4-5eae3c9b3de5",
                                                "text": "L’arbre d’un pressoir — La vis d’un pressoir."
                                            },
                                            {
                                                "example_id": "832577ac-a7e3-400c-9557-5831b296cbb4",
                                                "sense_id": "9dffe261-e9d6-349f-8fe4-5eae3c9b3de5",
                                                "text": "Fouler le raisin, la vendange dans un pressoir. — Pressoir banal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3381f8dc-b6a4-3f7c-92b4-338f9c2eab08",
                                        "entry_id": "44ec7ade-8e63-32bc-bf57-0f41d8d98ef3",
                                        "glosses": [
                                            "Lieu où cette machine est établie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aec451c6-bfc6-436f-8473-20f54f6b2ff8",
                                                "sense_id": "3381f8dc-b6a4-3f7c-92b4-338f9c2eab08",
                                                "text": "Aller dans le pressoir, au pressoir."
                                            },
                                            {
                                                "example_id": "a677838f-d5b7-4277-a7c9-13354baca102",
                                                "sense_id": "3381f8dc-b6a4-3f7c-92b4-338f9c2eab08",
                                                "text": "C’est là que nous trouvâmes M. Dominique, au milieu de ce laboratoire singulier plein de charpentes, de madriers, de cabestans, de roues en mouvement, qu’on appelle un pressoir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32896686-5308-4cf1-89d7-a2f820bea8b5",
                        "source_entry_id": "6c0544d6-3021-3e3d-b306-8d4092922a09",
                        "source_sense_id": "08caadad-1a56-3213-9924-d0b64369964d",
                        "source_sense_description": "device for squeezing grapes",
                        "target_lang_word": "Kelter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kelter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ede71793-e807-36d6-a6f2-23a4b0c4df03",
                                        "entry_id": "709c78b2-849b-33bd-854f-40d6a76cb3bf",
                                        "glosses": [
                                            "(historische) Apparatur, die dem Auspressen der Trauben dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43bde4e5-9522-417f-ae7f-032f5a445d13",
                                                "sense_id": "ede71793-e807-36d6-a6f2-23a4b0c4df03",
                                                "text": "„Ich fragte Papa, was das hölzerne Ding sei, und Papa sagte, das hölzerne Ding sei eine Presse oder eine Kelter, und in einer solchen Kelter oder Presse würden die Weintrauben zu Wein gepresst.“"
                                            },
                                            {
                                                "example_id": "7a44132e-6a56-4a0b-8b0a-7328814f901b",
                                                "sense_id": "ede71793-e807-36d6-a6f2-23a4b0c4df03",
                                                "text": "„Von der Kelter tropft dann zuckersüßer Saft.“"
                                            },
                                            {
                                                "example_id": "422c819f-a79d-4218-bfcb-d56dfdf50962",
                                                "sense_id": "ede71793-e807-36d6-a6f2-23a4b0c4df03",
                                                "text": "„Die Welle der Kelter erschien ihnen riesenhaft; dann stiegen sie in den Taubenschlag hinauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c45cc3fc-5e4b-3599-b12b-f937ae06eca2",
                                        "entry_id": "709c78b2-849b-33bd-854f-40d6a76cb3bf",
                                        "glosses": [
                                            "(historisches) Kelterhaus, Gebäude, in dem die Kelter (siehe [1]) steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fcb4834-7749-4fd2-a469-b1228ebeb19b",
                                                "sense_id": "c45cc3fc-5e4b-3599-b12b-f937ae06eca2",
                                                "text": "Die Metzinger Keltern sind ein einzigartiges Gebäudeensemble."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
