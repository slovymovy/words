{
    "word_family": [
        "attract",
        "attractive",
        "attractiveness",
        "unattractive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a002d985-dfac-3ff5-9c6c-096c242b4d75",
                    "sense_definition": "A place, event, or thing that people visit for interest or pleasure.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "interest_point",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Eiffel Tower is the most famous tourist <w>attraction</w> in Paris.",
                            "target_lang_translations": {
                                "ru": "Эйфелева башня — самая известная туристическая <w>достопримечательность</w> Парижа."
                            }
                        },
                        {
                            "text": "The new theme park is expected to be a major <w>attraction</w> for families this summer.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что новый тематический парк станет главным <w>аттракционом</w> для семей этим летом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tourist attraction",
                        "main attraction",
                        "major attraction",
                        "star attraction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, событие или объект, которые люди посещают ради интереса или удовольствия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достопримечательность",
                                "target_lang_sense_clarification": "объект, заслуживающий внимания"
                            },
                            {
                                "target_lang_word": "аттракцион",
                                "target_lang_sense_clarification": "развлекательное сооружение в парке"
                            },
                            {
                                "target_lang_word": "центр притяжения",
                                "target_lang_sense_clarification": "популярное место"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e175e395-d2df-3521-ab11-a64e69676fd7",
                    "sense_definition": "A feeling of romantic or sexual interest in someone.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was an immediate physical <w>attraction</w> between the two main characters in the movie.",
                            "target_lang_translations": {
                                "ru": "Между двумя главными героями фильма сразу возникло физическое <w>влечение</w>."
                            }
                        },
                        {
                            "text": "She felt a strong <w>attraction</w> to him because of his kind nature and sense of humor.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала к нему сильное <w>притяжение</w> из-за его доброго характера и чувства юмора."
                            }
                        }
                    ],
                    "synonyms": [
                        "pull"
                    ],
                    "antonyms": [
                        "repulsion"
                    ],
                    "common_phrases": [
                        "physical attraction",
                        "fatal attraction",
                        "mutual attraction",
                        "strong attraction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство романтического или сексуального интереса к кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "влечение",
                                "target_lang_sense_clarification": "сильная склонность к кому-либо"
                            },
                            {
                                "target_lang_word": "притяжение",
                                "target_lang_sense_clarification": "взаимная симпатия"
                            },
                            {
                                "target_lang_word": "привлекательность",
                                "target_lang_sense_clarification": "способность нравиться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f0fc83a-292a-3a97-b298-b9ecc69ec076",
                    "sense_definition": "The physical force that pulls things toward each other.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Moon is held in its orbit by the gravitational <w>attraction</w> of the Earth.",
                            "target_lang_translations": {
                                "ru": "Луна удерживается на своей орбите гравитационным <w>притяжением</w> Земли."
                            }
                        },
                        {
                            "text": "Magnets demonstrate the principle of magnetic <w>attraction</w> by pulling metal objects toward them.",
                            "target_lang_translations": {
                                "ru": "Магниты демонстрируют принцип магнитного <w>притяжения</w>, притягивая к себе металлические предметы."
                            }
                        }
                    ],
                    "synonyms": [
                        "pull"
                    ],
                    "antonyms": [
                        "repulsion"
                    ],
                    "common_phrases": [
                        "gravitational attraction",
                        "magnetic attraction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая сила, которая притягивает объекты друг к другу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притяжение",
                                "target_lang_sense_clarification": "физическая сила"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e4d7aac-c396-3fdc-a5ed-28be48bad1a2",
                    "sense_definition": "A chess tactic where a piece is sacrificed to lure an opponent's piece to a specific square.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chess_tactic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grandmaster used a brilliant <w>attraction</w> sacrifice to force the king into the open.",
                            "target_lang_translations": {
                                "ru": "Гроссмейстер использовал блестящую жертву на <w>завлечение</w>, чтобы выманить короля на открытое место."
                            }
                        },
                        {
                            "text": "In this puzzle, the key move is an <w>attraction</w> that leads to a checkmate in three.",
                            "target_lang_translations": {
                                "ru": "В этой задаче ключевой ход — <w>завлечение</w>, которое ведет к мату в три хода."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in chess"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шахматная тактика, при которой фигура приносится в жертву, чтобы заманить фигуру противника на определенное поле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завлечение",
                                "target_lang_sense_clarification": "шахматный тактический прием"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}