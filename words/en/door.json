    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b8c883e3-832c-3ad4-a8d5-51b17429935b",
                    "sense_definition": "A movable barrier used to close and open an entrance to a building, room, or vehicle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_barrier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please close the <w>door</w> behind you when you leave.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, закрой за собой <w>дверь</w>, когда будешь уходить.",
                                "pl": "Proszę, zamknij za sobą <w>drzwi</w>, kiedy będziesz wychodzić."
                            }
                        },
                        {
                            "text": "She knocked on the front <w>door</w> but nobody answered.",
                            "target_lang_translations": {
                                "ru": "Она постучала во входную <w>дверь</w>, но никто не ответил.",
                                "pl": "Zapukała do frontowych <w>drzwi</w>, ale nikt nie odpowiedział."
                            }
                        }
                    ],
                    "synonyms": [
                        "portal"
                    ],
                    "common_phrases": [
                        "front door",
                        "back door",
                        "lock the door",
                        "open the door",
                        "answer the door"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвижная преграда, используемая для закрытия и открытия входа в здание, комнату или транспортное средство.",
                        "pl": "Ruchoma bariera służąca do zamykania i otwierania wejścia do budynku, pomieszczenia lub pojazdu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дверь",
                                "target_lang_sense_clarification": "физический объект"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "drzwi",
                                "target_lang_sense_clarification": "fizyczny obiekt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6281ab8a-a29b-38ea-91c5-143afa488b3b",
                    "sense_definition": "A means of access, opportunity, or possibility to achieve something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "metaphorical_access",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Education opens the <w>door</w> to a better future.",
                            "target_lang_translations": {
                                "ru": "Образование открывает <w>дверь</w> в лучшее будущее.",
                                "pl": "Edukacja otwiera <w>drzwi</w> do lepszej przyszłości."
                            }
                        },
                        {
                            "text": "We must keep the <w>door</w> open for further negotiations.",
                            "target_lang_translations": {
                                "ru": "Мы должны оставить <w>дверь</w> открытой для дальнейших переговоров.",
                                "pl": "Musimy zostawić otwartą <w>furtkę</w> do dalszych negocjacji."
                            }
                        }
                    ],
                    "synonyms": [
                        "opportunity",
                        "path",
                        "opening",
                        "way",
                        "gateway",
                        "entry"
                    ],
                    "common_phrases": [
                        "open the door to",
                        "close the door on",
                        "foot in the door"
                    ],
                    "target_lang_definitions": {
                        "ru": "Средство доступа, возможность или вероятность достижения чего-либо.",
                        "pl": "Środek dostępu, okazja lub możliwość osiągnięcia czegoś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дверь",
                                "target_lang_sense_clarification": "метафорическое значение"
                            },
                            {
                                "target_lang_word": "путь",
                                "target_lang_sense_clarification": "возможность"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "drzwi",
                                "target_lang_sense_clarification": "znaczenie metaforyczne"
                            },
                            {
                                "target_lang_word": "droga",
                                "target_lang_sense_clarification": "możliwość"
                            },
                            {
                                "target_lang_word": "furtka",
                                "target_lang_sense_clarification": "szansa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2188e6aa-a8b7-3351-afb4-34d654a36e3e",
                    "sense_definition": "A house or building considered as a unit of distance in a street.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "location_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My best friend lives three <w>doors</w> down from me.",
                            "target_lang_translations": {
                                "ru": "Мой лучший друг живёт через три <w>дома</w> от меня.",
                                "pl": "Mój najlepszy przyjaciel mieszka trzy <w>domy</w> dalej."
                            }
                        },
                        {
                            "text": "The bakery is just a few <w>doors</w> away from the bank.",
                            "target_lang_translations": {
                                "ru": "Пекарня находится всего в нескольких <w>домах</w> от банка.",
                                "pl": "Piekarnia znajduje się zaledwie kilka <w>budynków</w> od banku."
                            }
                        }
                    ],
                    "synonyms": [
                        "house",
                        "building"
                    ],
                    "common_phrases": [
                        "next door",
                        "doors down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дом или здание, рассматриваемое как единица измерения расстояния на улице.",
                        "pl": "Dom lub budynek traktowany jako jednostka odległości na ulicy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дом",
                                "target_lang_sense_clarification": "строение"
                            },
                            {
                                "target_lang_word": "подъезд",
                                "target_lang_sense_clarification": "часть здания"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dom",
                                "target_lang_sense_clarification": "jednostka odległości"
                            },
                            {
                                "target_lang_word": "klatka",
                                "target_lang_sense_clarification": "wejście do bloku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6190dcf3-4c0c-3e11-89ba-14bcb9ea8153",
                    "sense_definition": "A small hinged cover or flap on a machine or object.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_barrier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Open the fuel <w>door</w> to fill the tank with gas.",
                            "target_lang_translations": {
                                "ru": "Открой <w>лючок</w> бензобака, чтобы заправить машину.",
                                "pl": "Otwórz <w>klapkę</w> wlewu paliwa, aby zatankować."
                            }
                        },
                        {
                            "text": "The child opened all the little <w>doors</w> on the advent calendar.",
                            "target_lang_translations": {
                                "ru": "Ребёнок открыл все маленькие <w>дверцы</w> на адвент-календаре.",
                                "pl": "Dziecko otworzyło wszystkie małe <w>drzwiczki</w> w kalendarzu adwentowym."
                            }
                        }
                    ],
                    "synonyms": [
                        "flap",
                        "cover",
                        "lid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая откидная створка или крышка на механизме или предмете.",
                        "pl": "Mała ruchoma pokrywa lub klapka w maszynie lub przedmiocie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дверца",
                                "target_lang_sense_clarification": "уменьшительное"
                            },
                            {
                                "target_lang_word": "лючок",
                                "target_lang_sense_clarification": "технический люк"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "drzwiczki",
                                "target_lang_sense_clarification": "małe drzwi"
                            },
                            {
                                "target_lang_word": "klapka",
                                "target_lang_sense_clarification": "osłona"
                            },
                            {
                                "target_lang_word": "drzwi",
                                "target_lang_sense_clarification": "np. od szafki"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdc046f5-8616-3b3b-8bf8-ba02bb7ea130",
                    "sense_definition": "The money collected from admission fees at the entrance of a venue.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "financial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band receives a percentage of the <w>door</w> after the show.",
                            "target_lang_translations": {
                                "ru": "Группа получает процент от <w>входной платы</w> после концерта.",
                                "pl": "Zespół otrzymuje procent z <w>bramki</w> po koncercie."
                            }
                        },
                        {
                            "text": "They made a lot of money on the <w>door</w> because the club was full.",
                            "target_lang_translations": {
                                "ru": "Они заработали много денег на <w>входе</w>, так как клуб был полон.",
                                "pl": "Zarobili dużo pieniędzy na <w>wstępie</w>, ponieważ klub był pełny."
                            }
                        }
                    ],
                    "synonyms": [
                        "gate",
                        "proceeds",
                        "admission"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in entertainment business contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деньги, собранные в качестве платы за вход на мероприятие.",
                        "pl": "Pieniądze zebrane z opłat za wstęp przy wejściu do lokalu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "входная плата",
                                "target_lang_sense_clarification": "стоимость билета"
                            },
                            {
                                "target_lang_word": "выручка за вход",
                                "target_lang_sense_clarification": "доход"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wpływy z biletów",
                                "target_lang_sense_clarification": "dochód z wejść"
                            },
                            {
                                "target_lang_word": "bramka",
                                "target_lang_sense_clarification": "opłata przy wejściu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a7140c09-d6f3-39b9-8812-d96f6882ab02",
                    "sense_definition": "To hit a passing cyclist or pedestrian by suddenly opening the door of a vehicle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Always check your mirror so you do not <w>door</w> a cyclist.",
                            "target_lang_translations": {
                                "ru": "Всегда смотри в зеркало, чтобы не <w>сбить дверью</w> велосипедиста.",
                                "pl": "Zawsze sprawdzaj lusterko, aby nie <w>uderzyć drzwiami</w> rowerzysty."
                            }
                        },
                        {
                            "text": "He was <w>doored</w> by a taxi passenger who didn't look before exiting.",
                            "target_lang_translations": {
                                "ru": "Его <w>сбил дверью</w> пассажир такси, который не посмотрел перед выходом.",
                                "pl": "Został <w>uderzony drzwiami</w> przez pasażera taksówki, który nie spojrzał przed wyjściem."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in cycling contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбить проезжающего велосипедиста или пешехода, внезапно открыв дверь транспортного средства.",
                        "pl": "Uderzenie przejeżdżającego rowerzysty lub pieszego poprzez nagłe otwarcie drzwi pojazdu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбить дверью",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "ударить дверью",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "uderzyć drzwiami",
                                "target_lang_sense_clarification": "czynność"
                            },
                            {
                                "target_lang_word": "otworzyć drzwi przed",
                                "target_lang_sense_clarification": "spowodować kolizję"
                            }
                        ]
                    }
                }
            ]
        }
    ]
