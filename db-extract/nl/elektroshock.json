                "translations": [
                    {
                        "translation_id": "59660184-dfb5-4afd-b485-7e607e162454",
                        "source_entry_id": "11e19b61-9c3d-3491-97a6-568468e16648",
                        "source_sense_id": "7f1a078f-f591-34bd-99a1-f73ae014417f",
                        "target_lang_word": "electroshock",
                        "target_lang_code": "en",
