                        "sense_id": "3c9d0732-3327-324b-9eb5-6b0d0a3a20e1",
                        "entry_id": "5cdd395b-0f11-3377-ba32-9f01ba275566",
                        "glosses": [
                            "устар. высок. величественная красота"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38b5f337-bae9-48d4-9339-c7a4027d385f",
                                "sense_id": "3c9d0732-3327-324b-9eb5-6b0d0a3a20e1",
                                "text": "Не щадили москвитяне ни рублей, ни трудов на благолепие домов божиих."
                            }
                        ]
                    },
                    {
                        "sense_id": "10a377cb-42e4-3067-b86e-a8ef90ca0916",
