                    {
                        "translation_id": "c2120ace-6ccc-4a0a-a5e3-f9125f4cd955",
                        "source_entry_id": "8b471ed0-c7a5-3248-a931-5a513d19d301",
                        "source_sense_id": "01bdc9e8-0717-3d83-aebd-0fd5d5c4cf8a",
                        "source_sense_description": "in de meeste gevallen, met weinig uitzonderingen",
                        "target_lang_word": "im Allgemeinen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "im Allgemeinen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e170633d-8d04-3ae2-b24d-9af3adaa7ffc",
                                        "entry_id": "19190d3f-62f0-3803-8141-6c7c52f4bb9c",
                                        "glosses": [
                                            "von wenigen Ausnahmen, Sonderfällen abgesehen; im Normalfall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5207355a-25fa-4ce0-99c6-54475a41d464",
                                                "sense_id": "e170633d-8d04-3ae2-b24d-9af3adaa7ffc",
                                                "text": "„Frauen lügen im Übrigen weniger, aber wenn sie lügen, dann meist besser. Das liegt insbesondere daran, dass Frauen im Allgemeinen ein bisschen intelligenter sind als wir Männer.“"
                                            },
                                            {
                                                "example_id": "8fc73135-7447-49a1-b69d-bd32b61859b4",
                                                "sense_id": "e170633d-8d04-3ae2-b24d-9af3adaa7ffc",
                                                "text": "Das Gemüse aus dem eigenen Garten schmeckt im Allgemeinen besser als das aus dem Supermarkt."
                                            },
                                            {
                                                "example_id": "4d7e4bec-7708-4fc0-9d05-fe36e44c63ef",
                                                "sense_id": "e170633d-8d04-3ae2-b24d-9af3adaa7ffc",
                                                "text": "„Das Klima von Zürich ist mitteleuropäisch kühlgemäßigt, das Wetter ähnelt dem deutscher Weinbauregionen, ist im Allgemeinen also eher mild.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8171ec1-1a2c-4e76-afaa-515ebda18e94",
                        "source_entry_id": "8b471ed0-c7a5-3248-a931-5a513d19d301",
                        "source_sense_id": "01bdc9e8-0717-3d83-aebd-0fd5d5c4cf8a",
                        "source_sense_description": "in de meeste gevallen, met weinig uitzonderingen",
                        "target_lang_word": "typically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "typically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48b74561-9749-3e8a-9941-32c375ce82c1",
                                        "entry_id": "ae97d92e-2877-3e6d-9d9b-65465b99bd87",
                                        "glosses": [
                                            "In a typical or common manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "778a4eb1-606e-4b58-9c0b-cd2d31772733",
                                                "sense_id": "48b74561-9749-3e8a-9941-32c375ce82c1",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic[…]real kidneys[…]. But they are nothing like as efficient, and can cause bleeding, clotting and infection—not to mention inconvenience for patients, who typically need to be hooked up to one three times a week for hours at a time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ac8294e-e18a-3565-ba2a-ccf66de6e46c",
                                        "entry_id": "ae97d92e-2877-3e6d-9d9b-65465b99bd87",
                                        "glosses": [
                                            "In an expected or customary manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37acb021-f98b-4ec5-a5db-2160778b625b",
                                                "sense_id": "9ac8294e-e18a-3565-ba2a-ccf66de6e46c",
                                                "text": "And Netherlands, backed by a typically noisy and colourful travelling support, started the second period in blistering fashion and could have had four goals within 10 minutes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c6fca20-c974-4a23-a127-c06bebfd911b",
                        "source_entry_id": "8b471ed0-c7a5-3248-a931-5a513d19d301",
                        "source_sense_id": "01bdc9e8-0717-3d83-aebd-0fd5d5c4cf8a",
                        "source_sense_description": "in de meeste gevallen, met weinig uitzonderingen",
                        "target_lang_word": "usually",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "usually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bb78c03-999e-3cff-ac69-65cdbe5f5d58",
                                        "entry_id": "bcf8a114-78df-30a5-aa3e-7e36dd637ce8",
                                        "glosses": [
                                            "Most of the time; less than always, but more than occasionally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e958f07-9355-478e-a378-1ff94306a9e3",
                                                "sense_id": "6bb78c03-999e-3cff-ac69-65cdbe5f5d58",
                                                "text": "Except for one or two days a year, he usually walks to work."
                                            },
                                            {
                                                "example_id": "99b2aa89-3040-4c42-ab4e-38e00e966efb",
                                                "sense_id": "6bb78c03-999e-3cff-ac69-65cdbe5f5d58",
                                                "text": "He and Gerald usually challenged the rollers in a sponson canoe when Gerald was there for the weekend ; or, when Lansing came down, the two took long swims seaward or cruised about in Gerald's dory, clad in their swimming-suits; and Selwyn's youth became renewed in a manner almost ridiculous,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "552ad584-410f-3d1a-8395-c0571badc9ed",
                                        "entry_id": "bcf8a114-78df-30a5-aa3e-7e36dd637ce8",
                                        "glosses": [
                                            "Under normal conditions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71d4b7b7-093f-4592-8e12-a5a719004014",
                        "source_entry_id": "8b471ed0-c7a5-3248-a931-5a513d19d301",
                        "source_sense_id": "01bdc9e8-0717-3d83-aebd-0fd5d5c4cf8a",
                        "source_sense_description": "in de meeste gevallen, met weinig uitzonderingen",
                        "target_lang_word": "generally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "generally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d020baa0-30a6-3d42-9ef5-9f6b326125f4",
                                        "entry_id": "d88578e7-22b6-37a1-847b-843efd8947ab",
                                        "glosses": [
                                            "Popularly or widely."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e16e6fcb-3d58-4e13-ad64-bb0386362e35",
                                                "sense_id": "d020baa0-30a6-3d42-9ef5-9f6b326125f4",
                                                "text": "It is generally known that the Earth is round."
                                            },
                                            {
                                                "example_id": "519f628c-74d0-4225-b66d-4b47fa3e750d",
                                                "sense_id": "d020baa0-30a6-3d42-9ef5-9f6b326125f4",
                                                "text": "The action he inaugurated culminated in the law for the suppression of trampage, that has accomplished such good in the Granite State, and that has been so generally copied in other states."
                                            },
                                            {
                                                "example_id": "749d48fa-2470-41f7-b10b-ed4e958a602c",
                                                "sense_id": "d020baa0-30a6-3d42-9ef5-9f6b326125f4",
                                                "text": "After defending our argument against several objections, we conclude by considering the implications our argument has for the rest of the instrumental convergence thesis and for AI safety more generally."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                        "entry_id": "d88578e7-22b6-37a1-847b-843efd8947ab",
                                        "glosses": [
                                            "As a rule; usually; typically; in most cases."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f0de959-6370-4d44-8cd3-102dfc099fad",
                                                "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                                "text": "I generally have a walk in the afternoon."
                                            },
                                            {
                                                "example_id": "a1c0c42e-bd79-47f9-a4f3-3cd27f41a0da",
                                                "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant[…]"
                                            },
                                            {
                                                "example_id": "3fb82351-93d4-4dbb-9275-1b2d03ed8eea",
                                                "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                                "text": "He used to drop into my chambers once in a while to smoke, and was first-rate company. When I gave a dinner there was generally a cover laid for him. I liked the man for his own sake, and even had he promised to turn out a celebrity it would have had no weight with me."
                                            },
                                            {
                                                "example_id": "63885bff-b15c-4799-b985-8259d937ce51",
                                                "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                                "text": "Ivor had acquired more than a mile of fishing rights with the house ; he was not at all a good fisherman, but one must do something ; one generally, however, banged a ball with a squash-racket against a wall."
                                            },
                                            {
                                                "example_id": "bade9e44-193a-4e4f-a5a0-f1cf565f3a88",
                                                "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                                "text": "Musk’s Israel tour was transparently transactional and frankly insulting. The antisemitic sentiment Musk endorsed had nothing to do with Israel; “replacement theory” is generally an unsupported allegation that Jews and other immigrants in the US and Europe are destroying Western civilization."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99d7283d-bfbc-3619-a875-6dfb5856e80e",
                                        "entry_id": "d88578e7-22b6-37a1-847b-843efd8947ab",
                                        "glosses": [
                                            "Without reference to specific details."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d290153-c3e6-4cd9-820b-36dce0dacf35",
                                                "sense_id": "99d7283d-bfbc-3619-a875-6dfb5856e80e",
                                                "text": "Generally speaking …"
                                            },
                                            {
                                                "example_id": "75748979-4423-405c-929b-cb704530d8a7",
                                                "sense_id": "99d7283d-bfbc-3619-a875-6dfb5856e80e",
                                                "text": "“There ain’t no drain of nothing short handy, is there?” said the Chicken, generally. “This here sluicing night is hard lines to a man as lives on his condition.”\nCaptain Cuttle proffered a glass of rum […]"
                                            },
                                            {
                                                "example_id": "01b904a1-a814-49d1-ad9f-ae0313a73180",
                                                "sense_id": "99d7283d-bfbc-3619-a875-6dfb5856e80e",
                                                "text": "Autopsy results revealed that Braydon was generally malnourished and thin. His cause of death was hyperthermia due to the extreme heat, which would have “caused extreme discomfort and difficulty breathing as he died.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c96bdc97-5f95-3cd3-ab03-7b594e9cd7ce",
                                        "entry_id": "d88578e7-22b6-37a1-847b-843efd8947ab",
                                        "glosses": [
                                            "In the general case, without exception; in all cases."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b88d2433-f6f4-4a6b-846c-be0359b13345",
                                                "sense_id": "c96bdc97-5f95-3cd3-ab03-7b594e9cd7ce",
                                                "text": "It is generally true that the angles of a triangle sum to 180 degrees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c06098d4-c2fa-3231-bf11-136d8f37b069",
                                        "entry_id": "d88578e7-22b6-37a1-847b-843efd8947ab",
                                        "glosses": [
                                            "Collectively; as a whole; without omissions."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "comparative",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce8ad0db-c031-4cb2-94f1-291a42f22085",
                                                "sense_id": "c06098d4-c2fa-3231-bf11-136d8f37b069",
                                                "text": "I counsel that all Israel be generally gathered unto thee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
