                {
                    "sense_id": "de2153a0-387a-38cc-b455-f3a5ee15eea6",
                    "sense_definition": "A former British coin worth sixpence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He paid three shillings and a <w>bender</w> for the worn pocket watch.",
                            "target_lang_translations": {
                                "it": "Ha pagato tre scellini e un <w>sei pence</w> per l'orologio da taschino consumato."
                            }
