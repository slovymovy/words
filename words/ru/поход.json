            "pos": "noun",
            "senses": [
                {
                    "sense_id": "426190fe-5f3e-3ab1-b031-ecf55baaa236",
                    "sense_definition": "Организованное путешествие или прогулка, обычно пешком, с целью отдыха, спорта или познания.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом мы с друзьями часто ходим в <w>поход</w> с палатками.",
                            "target_lang_translations": {
                                "en": "In summer, my friends and I often go on a <w>camping trip</w> with tents.",
                                "de": "Im Sommer gehen wir mit Freunden oft auf einen <w>Campingausflug</w> mit Zelten."
                            }
                        },
                        {
                            "text": "Для горного <w>похода</w> тебе понадобится крепкая и удобная обувь.",
                            "target_lang_translations": {
                                "en": "For a mountain <w>hike</w>, you will need sturdy and comfortable shoes.",
                                "de": "Für eine Berg<w>wanderung</w> brauchst du festes und bequemes Schuhwerk."
                            }
                        }
                    ],
                    "synonyms": [
                        "путешествие",
                        "прогулка"
                    ],
                    "antonyms": [
                        "стоянка"
                    ],
                    "common_phrases": [
                        "пойти в поход",
                        "туристический поход",
                        "однодневный поход",
                        "вернуться из похода"
                    ],
                    "target_lang_definitions": {
                        "en": "An organized journey or walk, usually on foot, for recreation, sport, or learning.",
                        "de": "Eine organisierte Reise oder Wanderung, meist zu Fuß, zu Erholungs-, Sport- oder Bildungszwecken."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hike",
                                "target_lang_sense_clarification": "long walk for pleasure or exercise"
                            },
                            {
                                "target_lang_word": "camping trip",
                                "target_lang_sense_clarification": "outdoor journey involving staying in tents"
                            },
                            {
                                "target_lang_word": "expedition",
                                "target_lang_sense_clarification": "organized journey for a specific purpose"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Wanderung",
                                "target_lang_sense_clarification": "längerer Spaziergang oder Fußmarsch in der Natur"
                            },
                            {
                                "target_lang_word": "Campingausflug",
                                "target_lang_sense_clarification": "Reise mit Übernachtung im Zelt"
                            },
                            {
                                "target_lang_word": "Expedition",
                                "target_lang_sense_clarification": "geplante Reise zu einem bestimmten Zweck"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "055bc860-9a7e-36bc-9233-b7718a06494c",
                    "sense_definition": "Целенаправленное посещение какого-либо места или мероприятия.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наш вчерашний <w>поход</w> по магазинам занял целый день.",
                            "target_lang_translations": {
                                "en": "Our shopping <w>trip</w> yesterday took the whole day.",
                                "de": "Unser gestriger <w>Einkaufsbummel</w> hat den ganzen Tag gedauert."
                            }
                        },
                        {
                            "text": "Совместный <w>поход</w> в кино помог нам помириться.",
                            "target_lang_translations": {
                                "en": "A joint <w>trip</w> to the cinema helped us reconcile.",
                                "de": "Ein gemeinsamer <w>Kinobesuch</w> hat uns geholfen, uns wieder zu versöhnen."
                            }
                        }
                    ],
                    "synonyms": [
                        "посещение"
                    ],
                    "common_phrases": [
                        "поход по магазинам",
                        "поход в кино",
                        "поход в театр",
                        "поход к врачу"
                    ],
                    "target_lang_definitions": {
                        "en": "A purposeful visit to a place or event.",
                        "de": "Ein zielgerichteter Besuch eines Ortes oder einer Veranstaltung."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trip",
                                "target_lang_sense_clarification": "journey or excursion to a place"
                            },
