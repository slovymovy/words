                        "sense_id": "1f7484bb-baaf-36f2-b3bf-f4624c850d6f",
                        "entry_id": "b85defec-9ea7-38fe-8cd3-39aa0c11fb49",
                        "glosses": [
                            "op verrassend eenvoudige wijze, om verrassend eenvoudige redenen, zonder meer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c54e176f-8e97-447e-b4bd-6fc18ef2428a",
                                "sense_id": "1f7484bb-baaf-36f2-b3bf-f4624c850d6f",
                                "text": "Dat is simpelweg onaanvaardbaar."
                            },
                            {
                                "example_id": "92f09699-b2ef-43c6-9a4a-bac0733e18da",
                                "sense_id": "1f7484bb-baaf-36f2-b3bf-f4624c850d6f",
                                "text": "Andere opties voor waterfiltering zijn de Aquamira-chlorine-dioxine-druppels, of simpelweg chloor, waarvan alle bacteriën en microben blijkbaar doodgaan."
                            },
                            {
                                "example_id": "0cb57c64-18fa-47fe-aeb7-7619ff403e39",
                                "sense_id": "1f7484bb-baaf-36f2-b3bf-f4624c850d6f",
                                "text": "En ze wist hoe ze zich moest gedragen, zag er representatief uit en sprak vloeiend Duits, Engels en Frans. Ze wees naar de drie vlaggen op de revers van de blazer. Ik wist wat het betekende om 'je te gedragen', dat was simpelweg de opvoeding die je in deftige families kreeg."
                            }
                        ]
                    }
