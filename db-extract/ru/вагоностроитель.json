                "senses": [
                    {
                        "sense_id": "d6f877b4-8921-3053-a538-015d9af6fbb6",
                        "entry_id": "8d26aa4f-a7d3-32a1-af2b-34f0f7ce016c",
                        "glosses": [
                            "производитель вагонов; работник вагоностроительного предприятия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7368166a-dda7-4874-8d70-cba0db7b437d",
                                "sense_id": "d6f877b4-8921-3053-a538-015d9af6fbb6",
                                "text": "Не может не радовать и тот факт, что ряды вагоностроителей постоянно пополняет молодёжь."
                            },
                            {
                                "example_id": "4b4af8a7-1c51-47e8-86d9-492d12721eb9",
                                "sense_id": "d6f877b4-8921-3053-a538-015d9af6fbb6",
                                "text": "В РЖД отмечают, что поддерживают любое действие правительства, направленное на поддержку вагоностроителей и обновление парка вагонов."
                            },
                            {
                                "example_id": "229a4d46-8193-4a66-93f0-9413b3e3fd1f",
                                "sense_id": "d6f877b4-8921-3053-a538-015d9af6fbb6",
                                "text": "Общение с вагоностроителями проходило в уже отработанном формате: кружком в два-три ряда сидят полсотни рабочих, премьер занимает крутящийся стул в центре."
                            }
                        ]
                    }
