                "senses": [
                    {
                        "sense_id": "0014a315-2731-3fba-bfd0-ec813e0f8266",
                        "entry_id": "8e1e13e6-be4e-3a18-8f5a-6924f258cd0c",
                        "glosses": [
                            "nach dem 2. Weltkrieg Bezeichnung für die drei westlichen Besatzungszonen, nachdem die Franzosen mit ihrer Besatzungszone mit der amerikanischen und britischen Zone kooperierten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95273d56-a5f4-4d05-ace9-9c73ffa1dcbb",
                                "sense_id": "0014a315-2731-3fba-bfd0-ec813e0f8266",
                                "text": "Der Zusammenschluss zur Trizone erfolgte 1948."
                            },
                            {
                                "example_id": "f29bf956-9b48-4022-a0bd-61998c3529f9",
                                "sense_id": "0014a315-2731-3fba-bfd0-ec813e0f8266",
                                "text": "Die Trizone ist eine Vorstufe der Bundesrepublik Deutschland."
                            },
                            {
                                "example_id": "c97502a5-cc35-471e-b0a6-460b4b09aedc",
                                "sense_id": "0014a315-2731-3fba-bfd0-ec813e0f8266",
                                "text": "„Hier zeichneten sich die ersten Ansätze einer zonalen Aufsplitterung ab: Bizone, Trizone, am Ende die Ost-West-Teilung des Landes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
