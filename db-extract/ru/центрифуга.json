                    {
                        "translation_id": "d4455d9e-d978-4cbc-bcd5-d5dbf08ffd14",
                        "source_entry_id": "6cdd15a5-157f-3819-b350-d3170d47255c",
                        "source_sense_id": "dd6bd610-9107-3015-86c0-f03ad35c2647",
                        "target_lang_word": "Zentrifuge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zentrifuge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88b06b00-3a40-3acc-9570-e8f00c67e317",
                                        "entry_id": "cfd9553f-53f6-3998-8ac2-f604e7cfba0c",
                                        "glosses": [
                                            "Gerät zur Trennung von Substanzen mit verschiedenen spezifischen Gewichten unter Ausnutzung der Massenträgheit bei Rotationen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ea04a7-16ba-4ca6-bdbb-807e3bef2269",
                                                "sense_id": "88b06b00-3a40-3acc-9570-e8f00c67e317",
                                                "text": "Der iranische Präsident Ahmadineschad hat die Montage von 6000 Zentrifugen eines modernen Typs in der Uran-Anreicherungsanlage Natans angekündigt."
                                            },
                                            {
                                                "example_id": "9f9ac1a1-761e-44b8-9e04-614c337468c3",
                                                "sense_id": "88b06b00-3a40-3acc-9570-e8f00c67e317",
                                                "text": "Derartige Zentrifugen werden über eine Luftturbine mit Preßluft angetrieben."
                                            },
                                            {
                                                "example_id": "9c726864-fda9-47ec-87d0-938982d16b0b",
                                                "sense_id": "88b06b00-3a40-3acc-9570-e8f00c67e317",
                                                "text": "Doch ist der Betrieb einer Diffusionsanlage wegen des hohen Stromverbrauchs kostspielig, eine Zentrifuge gleicher Kapazität braucht nur ein Sechstel der elektrischen Energie."
                                            },
                                            {
                                                "example_id": "108f749f-654c-4042-98f5-de73514542f5",
                                                "sense_id": "88b06b00-3a40-3acc-9570-e8f00c67e317",
                                                "text": "Die neue Zentrifuge, vier Meter im Durchmesser, ist für umfangreiche Versuchsserien mit kleinen Modellen gedacht, die in großer Stückzahl hergestellt werden können. Bochum ist der einzige Standort für Großzentrifugentechnik in Deutschland."
                                            },
                                            {
                                                "example_id": "3fd4bd10-2a45-4c6c-8139-c7dbc126e4e8",
                                                "sense_id": "88b06b00-3a40-3acc-9570-e8f00c67e317",
                                                "text": "Die Flüssigkeiten werden dann in einer Zentrifuge getrennt und die Meßergebnisse von mehreren Mundspülungen nach einem komplizierten Schlüssel hochgerechnet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
