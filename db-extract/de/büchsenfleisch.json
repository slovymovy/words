                                "sense_id": "3ef020f5-7d04-3b6d-8d0d-552a50fd99bb",
                                "text": "„Dort, in einer Plattenbauwohnung im Süden St. Petersburgs, stehen Makkaroni mit Büchsenfleisch für die Heimkehrer bereit.“"
                            },
                            {
                                "example_id": "21c3fb32-c260-4c61-8b37-f99564a530ce",
                                "sense_id": "3ef020f5-7d04-3b6d-8d0d-552a50fd99bb",
                                "text": "„Es war heißes Büchsenfleisch und schmeckte sehr gut.“"
                            }
                        ],
