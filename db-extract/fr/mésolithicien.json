                        "glosses": [
                            "Préhistorien du Mésolithique."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9ce8640b-0b0d-4edc-81a3-c5e3b86bcbde",
                                "sense_id": "b654687d-afcc-3c63-9b2c-174f778a1278",
                                "text": "Il s’entoure de collaborateurs : Hugo Thoen, orienté vers la céramologie, un mésolithicien de l’Université de Liège, André Gob, et Jean Bourgeois."
                            },
                            {
                                "example_id": "9e4de357-1585-4859-bf80-60af3b1a4963",
                                "sense_id": "b654687d-afcc-3c63-9b2c-174f778a1278",
                                "text": "Plusieurs chercheurs s’y emploient désormais dans de bonnes conditions (depuis peu, le nombre de mésolithiciens statutaires va croissant) : ils bénéficient du dynamisme des recherches paléolithiques et néolithiques et tirent aussi avantageusement parti des avancées dans d’autres régions d’Europe."
                            }
                        ]
