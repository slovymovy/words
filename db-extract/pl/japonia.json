                                        "entry_id": "88bc12ad-784a-3a62-b447-256339a7323e",
                                        "glosses": [
                                            "een land in het oosten van Azië, bestaande uit vier grote eilanden en vele kleine eilanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fae00a5-7f0b-494b-9c6f-11091b5f97e5",
                                                "sense_id": "40998274-042b-329d-9a80-4bc77e15a656",
                                                "text": "Jaren later liep ik op mijn 42ste de 88 Tempels Trail, een pelgrimstocht van 1.300 kilometer door Japan. Daar ondervond ik voor het eerst hoe verslavend lopen kan zijn."
                                            }
                                        ]
                                    }
                                ]
