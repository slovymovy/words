{
    "word_family": [
        "frequency",
        "frequenter",
        "frequentation",
        "infrequent"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "92c654ee-8c79-3d71-ad58-b21f07db4481",
                    "sense_definition": "Happening or done many times or at short intervals.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I take <w>frequent</w> breaks so I do not get too tired during the long workday.",
                            "target_lang_translations": {
                                "ru": "Я делаю <w>частые</w> перерывы, чтобы не слишком уставать в течение долгого рабочего дня.",
                                "zh": "我<w>频繁</w>地休息，这样在漫长的工作日里就不会太累。"
                            }
                        },
                        {
                            "text": "There are <w>frequent</w> trains to the beach available during the summer months.",
                            "target_lang_translations": {
                                "ru": "В летние месяцы на пляж ходят <w>частые</w> поезда.",
                                "zh": "夏季几个月里，有<w>频繁</w>往返海滩的火车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "regular",
                        "recurring",
                        "continual",
                        "steady"
                    ],
                    "antonyms": [
                        "rare",
                        "uncommon"
                    ],
                    "common_phrases": [
                        "frequent breaks",
                        "frequent visitor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий или совершаемый многократно или через короткие промежутки времени.",
                        "zh": "指发生或做某事次数多，或间隔时间短。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "частый",
                                "target_lang_sense_clarification": "повторяющийся много раз"
                            },
                            {
                                "target_lang_word": "регулярный",
                                "target_lang_sense_clarification": "постоянно повторяющийся"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "频繁的",
                                "target_lang_sense_clarification": "次数多且持续发生"
                            },
                            {
                                "target_lang_word": "经常的",
                                "target_lang_sense_clarification": "习惯性或反复发生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "788650f0-0084-3e92-b5d4-467246d54d22",
                    "sense_definition": "Occurring at very short intervals or appearing in close proximity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>frequent</w> towers along the ancient wall provided a strong defense for the city.",
                            "target_lang_translations": {
                                "ru": "<w>Часто</w> расположенные башни вдоль древней стены обеспечивали городу надежную защиту.",
                                "zh": "古城墙上<w>密集</w>的塔楼为这座城市提供了坚固的防御。"
                            }
                        },
                        {
                            "text": "He suffered from <w>frequent</w> headaches that made it difficult to concentrate on his studies.",
                            "target_lang_translations": {
                                "ru": "Он страдал от <w>частых</w> головных болей, из-за которых ему было трудно сосредоточиться на учебе.",
                                "zh": "他饱受<w>频繁</w>头痛的困扰，这使他难以集中精力学习。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recurring",
                        "continual"
                    ],
                    "antonyms": [
                        "rare"
                    ],
                    "common_phrases": [
                        "frequent intervals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный близко друг к другу или происходящий с очень короткими интервалами.",
                        "zh": "指事物在空间上分布密集，或在时间上发生间隔极短。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "частый",
                                "target_lang_sense_clarification": "плотно расположенный или повторяющийся"
                            },
                            {
                                "target_lang_word": "густой",
                                "target_lang_sense_clarification": "о расположении объектов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "密集的",
                                "target_lang_sense_clarification": "空间分布紧密"
                            },
                            {
                                "target_lang_word": "紧密的",
                                "target_lang_sense_clarification": "时间或空间上靠得很近"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "121a56f9-22b3-3fae-875e-5c655a0ea8d5",
                    "sense_definition": "Habitual or persistent in a specific behavior or course of conduct.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>frequent</w> in his complaints about the office temperature every single morning.",
                            "target_lang_translations": {
                                "ru": "Он был <w>постоянен</w> в своих жалобах на температуру в офисе каждое божье утро.",
                                "zh": "他每天早上都<w>不断</w>地抱怨办公室的温度。"
                            }
                        },
                        {
                            "text": "The politician was loud and <w>frequent</w> in declaring his support for the new government policy.",
                            "target_lang_translations": {
                                "ru": "Политик громко и <w>неустанно</w> заявлял о своей поддержке новой правительственной политики.",
                                "zh": "那位政客大声且<w>频繁</w>地宣称他支持政府的新政策。"
                            }
                        }
                    ],
                    "synonyms": [
                        "steady"
                    ],
                    "common_phrases": [
                        "frequent in declaring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянный или настойчивый в определенном поведении или действиях.",
                        "zh": "指在某种行为或行动中表现得持续、执着或习惯性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "постоянный",
                                "target_lang_sense_clarification": "неизменный в своих действиях"
                            },
                            {
                                "target_lang_word": "неустанный",
                                "target_lang_sense_clarification": "часто проявляющий себя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不断的",
                                "target_lang_sense_clarification": "持续进行某行为"
                            },
                            {
                                "target_lang_word": "一贯的",
                                "target_lang_sense_clarification": "始终如一地做某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e84ec889-09c2-329a-b7dd-3c11774a369d",
                    "sense_definition": "Commonly reported or widely rumored.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>frequent</w> in the city that the general has finally subdued the enemy tribes.",
                            "target_lang_translations": {
                                "ru": "В городе <w>повсеместно</w> говорят о том, что генерал наконец покорил враждебные племена.",
                                "zh": "城里<w>广为流传</w>着将军终于征服了敌对部落的消息。"
                            }
                        },
                        {
                            "text": "The news of the discovery became <w>frequent</w> among the scholars of the university.",
                            "target_lang_translations": {
                                "ru": "Новость об открытии стала <w>широко известной</w> среди ученых университета.",
                                "zh": "这一发现的消息在大学的学者们中间变得<w>众所周知</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to mean commonly reported"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часто упоминаемый, широко обсуждаемый или общеизвестный (архаичное).",
                        "zh": "指被广泛报道或流传的（古语用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распространенный",
                                "target_lang_sense_clarification": "о слухах или новостях"
                            },
                            {
                                "target_lang_word": "повсеместный",
                                "target_lang_sense_clarification": "известный всем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "广为流传的",
                                "target_lang_sense_clarification": "关于消息或传闻"
                            },
                            {
                                "target_lang_word": "众所周知的",
                                "target_lang_sense_clarification": "被大众所知晓"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "500b0d96-d37b-3ba2-8aaf-6387a5767462",
                    "sense_definition": "Full of people; crowded or thronged.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "crowd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leader requested a <w>frequent</w> senate to discuss the urgent matters of the state.",
                            "target_lang_translations": {
                                "ru": "Лидер созвал <w>многолюдный</w> сенат для обсуждения неотложных государственных дел.",
                                "zh": "领导人召集了一个<w>拥挤</w>的参议院会议来讨论国家的紧急事务。"
                            }
                        },
                        {
                            "text": "They walked through the <w>frequent</w> streets of the capital during the festival.",
                            "target_lang_translations": {
                                "ru": "Во время фестиваля они гуляли по <w>людным</w> улицам столицы.",
                                "zh": "节日期间，他们走在首都<w>人头攒动</w>的街道上。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used to describe a crowded assembly or place"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Многолюдный, заполненный людьми или тесный (архаичное).",
                        "zh": "指人多拥挤的（古语用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "многолюдный",
                                "target_lang_sense_clarification": "наполненный людьми"
                            },
                            {
                                "target_lang_word": "людный",
                                "target_lang_sense_clarification": "о месте или собрании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拥挤的",
                                "target_lang_sense_clarification": "充满人群的"
                            },
                            {
                                "target_lang_word": "人头攒动的",
                                "target_lang_sense_clarification": "形容场所非常热闹"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4975efd5-7951-3b1f-8b75-3abfa5f046f5",
                    "sense_definition": "To visit a particular place often or habitually.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "visiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I used to <w>frequent</w> that restaurant when I lived in the city center.",
                            "target_lang_translations": {
                                "ru": "Я часто <w>посещал</w> тот ресторан, когда жил в центре города.",
                                "zh": "我住在市中心时，曾<w>常去</w>那家餐馆。"
                            }
                        },
                        {
                            "text": "Local artists often <w>frequent</w> this cafe to discuss their latest projects.",
                            "target_lang_translations": {
                                "ru": "Местные художники часто <w>захаживают</w> в это кафе, чтобы обсудить свои последние проекты.",
                                "zh": "当地艺术家经常<w>出入</w>这家咖啡馆，讨论他们最新的项目。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "frequent that restaurant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часто или привычно посещать определенное место.",
                        "zh": "指经常或习惯性地去某个地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "часто посещать",
                                "target_lang_sense_clarification": "бывать где-либо регулярно"
                            },
                            {
                                "target_lang_word": "захаживать",
                                "target_lang_sense_clarification": "наведываться время от времени"
                            },
                            {
                                "target_lang_word": "бывать",
                                "target_lang_sense_clarification": "посещать привычное место"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "常去",
                                "target_lang_sense_clarification": "习惯性地造访某地"
                            },
                            {
                                "target_lang_word": "出入",
                                "target_lang_sense_clarification": "经常进出某场所"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}