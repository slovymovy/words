                        "entry_id": "a490811e-8093-3628-b971-7a6065270b9e",
                        "glosses": [
                            "A type of fructification of some ascomycete fungi, forming cyst structures of various shapes. Often the fungal components of lichens have this sort of fertile structure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b91fc8f3-5d16-4617-9615-cad3aa3811c8",
                                "sense_id": "f026f519-c91f-3cee-a06d-43b5f1ef7d58",
                                "text": "Apothecia lecanoroid; multilocular; each cell containing a single theke; paraphyses deficient."
                            }
                        ]
                    }
                ],
                "translations": [
