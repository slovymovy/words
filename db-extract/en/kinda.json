    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c556b95a-5d07-369a-9efd-cd7e35e56eed",
                "word": "kinda",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5c43c479-4b93-3e5a-a5c2-079188c6f545",
                        "entry_id": "c556b95a-5d07-369a-9efd-cd7e35e56eed",
                        "glosses": [
                            "Kind of; somewhat."
                        ],
                        "tags": [
                            "colloquial",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5e5953d9-f896-40f1-abe6-31b3f27fe393",
                                "sense_id": "5c43c479-4b93-3e5a-a5c2-079188c6f545",
                                "text": "I kinda hafta do this right now."
                            },
                            {
                                "example_id": "485a1f58-f99b-4bac-87a3-bb7588cc2778",
                                "sense_id": "5c43c479-4b93-3e5a-a5c2-079188c6f545",
                                "text": "That’s kinda funny."
                            },
                            {
                                "example_id": "aef44c1d-9bc9-4048-8b4e-c75e3caa0500",
                                "sense_id": "5c43c479-4b93-3e5a-a5c2-079188c6f545",
                                "text": "But when I spoke about it he just smiled and shook his head, and started whistling to himself kinda soft."
                            },
                            {
                                "example_id": "e36774b1-ef4e-4a37-bc1c-72bbe88a68f6",
                                "sense_id": "5c43c479-4b93-3e5a-a5c2-079188c6f545",
                                "text": "… He got on Forty-second Street, and he was kinda fresh from the start. At Sixty-sixth he came sasshaying^([sic]) right down the car and said ‘Hello, patootie!’ Well, I drew myself up …"
                            },
                            {
                                "example_id": "a81e9ad7-904a-4f21-97e3-edf480612fc3",
                                "sense_id": "5c43c479-4b93-3e5a-a5c2-079188c6f545",
                                "text": "In those days, flour sacks was kinda purty. They might come printed up with flowers on em, or birds."
                            },
                            {
                                "example_id": "4cb516c7-e182-43e7-97bd-599e0eca654c",
                                "sense_id": "5c43c479-4b93-3e5a-a5c2-079188c6f545",
                                "text": "The facial expression on my mask kinda looks like Han Solo in the carbonite …"
                            },
                            {
                                "example_id": "c2168913-279f-4c8d-96ac-f71e06cbff1b",
                                "sense_id": "5c43c479-4b93-3e5a-a5c2-079188c6f545",
                                "text": "It makes me feel better that I’m not the only one who fantasizes about being struck down by a meteor on my way to work. Mind you, I’m not actively suicidal at all. I just kinda think being dead without actually killing myself would be easier and way less exhausting.”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "1b7a0256-9e5d-49c1-8d4c-cf9c38384dc0",
                        "source_entry_id": "c556b95a-5d07-369a-9efd-cd7e35e56eed",
