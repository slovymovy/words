{
    "word_family": [
        "biser",
        "bisou"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "def4df99-5457-3573-a630-5e61523c8db5",
                    "sense_definition": "Baiser amical ou affectueux échangé sur la joue pour saluer ou prendre congé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "salutation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En France, les amis ont souvent l'habitude de se faire la <w>bise</w> pour se saluer."
                        },
                        {
                            "text": "Avant de partir pour l'école, l'enfant a donné une affectueuse <w>bise</w> à sa grand-mère."
                        }
                    ],
                    "synonyms": [
                        "bisou",
                        "bécot"
                    ],
                    "common_phrases": [
                        "faire la bise",
                        "grosses bises"
                    ]
                },
                {
                    "sense_id": "90ba3d4c-2fe7-3cf8-bcb8-0d760b2a4e7c",
                    "sense_definition": "Vent froid et sec qui souffle généralement du nord ou du nord-est.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meteorologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une <w>bise</w> glaciale traversait les rues désertes de la ville en plein mois de janvier."
                        },
                        {
                            "text": "Nous avons dû enfiler un manteau épais pour supporter cette terrible <w>bise</w>."
                        }
                    ]
                },
                {
                    "sense_id": "03d5319d-61fd-3d3a-8422-9a446bddc830",
                    "sense_definition": "Nom familier attribué à la macreuse noire, espèce de canard marin des régions septentrionales.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "faune",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les chasseurs postés près de l'estuaire ont observé une <w>bise</w> qui plongeait dans l'eau glacée."
                        },
                        {
                            "text": "Ce canard marin, souvent désigné comme une <w>bise</w>, passe tout l'hiver le long des rivages rocheux."
                        }
                    ],
                    "synonyms": [
                        "macreuse"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "terme cynégétique local"
                        }
                    ]
                },
                {
                    "sense_id": "dfb67011-af90-36e9-8225-b6a22d16271d",
                    "sense_definition": "Nom usuel de divers champignons de sous-bois, notamment des russules.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au cours de sa promenade en forêt, il a cueilli une <w>bise</w> cachée sous les feuilles mortes."
                        },
                        {
                            "text": "Ce champignon comestible que les habitants nomment une <w>bise</w> pousse volontiers dans les sous-bois humides."
                        }
                    ],
                    "synonyms": [
                        "russule"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "terme populaire champêtre"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1c469054-dfbe-328d-b373-7a6b0b232e7c",
                    "sense_definition": "Féminin singulier de <w>bis</w>, qualifiant une teinte d'un gris brun ou terne.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le boulanger prépare son pain complet avec une farine <w>bise</w> issue de céréales locales."
                        },
                        {
                            "text": "Elle portait une étoffe <w>bise</w> dont la couleur sombre rappelait la terre d'automne."
                        }
                    ],
                    "synonyms": [
                        "grisâtre",
                        "brunâtre"
                    ],
                    "antonyms": [
                        "blanche"
                    ],
                    "common_phrases": [
                        "farine bise"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d3592b8-25e5-3ca9-9e04-663a43d1fd9c",
                    "sense_definition": "Troisième personne du singulier de l'indicatif présent de <w>biser</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "salutation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin avant de partir travailler, il <w>bise</w> tendrement ses enfants sur le pas de la porte."
                        },
                        {
                            "text": "Quand elle retrouve ses vieux camarades de classe, elle les <w>bise</w> chaleureusement pour les saluer."
                        }
                    ],
                    "synonyms": [
                        "embrasse"
                    ]
                }
            ]
        }
    ]
}