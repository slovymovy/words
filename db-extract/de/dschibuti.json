                    },
                    {
                        "sense_id": "5d905931-c092-3514-9d54-aa3330feb997",
                        "entry_id": "a8ee5c2e-77b8-3f85-a0a8-e3da243c0ff7",
                        "glosses": [
                            "Stadt im gleichnamigen Staat, gleichzeitig dessen Hauptstadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed9d0cf3-271d-4b1b-b011-442d6292ba53",
                                "sense_id": "5d905931-c092-3514-9d54-aa3330feb997",
                                "text": "„Dschibuti ist der Endpunkt der Eisenbahnlinie von Addis Abeba und Freihafen für Äthiopien, das keinen eigenen Zugang zum Meer hat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
