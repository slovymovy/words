                                        "entry_id": "663efca6-f2ef-34d3-a2f8-9878088a9123",
                                        "glosses": [
                                            "versiert im Bereich Literatur, reich an Kenntnissen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1213cc1-5bb8-4358-8256-1dc65412bd66",
                                                "sense_id": "5c4f227d-ad79-3b7c-a96e-e11ab8c11370",
                                                "text": "Die Handlung spielt Anfang der Siebzigerjahre und ist, so sind sich viele Kritiker einig, nur schwer festzunageln: Herrndorf sei ungewöhnlich im Ton, gewitzt und belesen, stilsicher und einfallsreich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
