                "translations": [
                    {
                        "translation_id": "6581e6a5-779d-4a65-9f17-b7337fda2148",
                        "source_entry_id": "21c38d47-4ef3-32cc-94de-42958b4aa035",
                        "source_sense_id": "2c64ea87-e562-30c7-8288-1032dc4bb749",
                        "target_lang_word": "leucine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leucine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45d386de-03a7-3dbd-a4b9-895eeaf99ae7",
                                        "entry_id": "fc618f09-25c3-3894-ab1e-f00f93108691",
                                        "glosses": [
                                            "An essential amino acid, C₆H₁₃NO₂, isomeric with isoleucine, found in most animal proteins; it is essential for growth in children."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6ff7a96-d479-4121-83e7-02821b00819d",
                                                "sense_id": "45d386de-03a7-3dbd-a4b9-895eeaf99ae7",
                                                "text": "Thus, leucine is already being seen as a pharmaconutrient of great relevance for the supplementary feeding of malnourished and frail elderly and for specific subpopulations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09624abe-07b2-4b01-a01f-1ead21aed50b",
                        "source_entry_id": "21c38d47-4ef3-32cc-94de-42958b4aa035",
                        "source_sense_id": "2c64ea87-e562-30c7-8288-1032dc4bb749",
                        "target_lang_word": "Leucin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leucin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12683d1e-68d1-320b-89ae-baa781708af6",
                                        "entry_id": "cdd63b46-b1e7-3ed2-b75f-121e148bb7a6",
                                        "glosses": [
                                            "eine Aminosäure, Bestandteil der Proteine"
                                        ],
                                        "tags": [
                                            "Biochemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db064159-3c9f-4f63-a348-36edd6a1e973",
                                                "sense_id": "12683d1e-68d1-320b-89ae-baa781708af6",
                                                "text": "Leucin ist eine essentielle Aminosäure."
                                            },
                                            {
                                                "example_id": "ad96c895-9427-450a-92fd-5d8dc1c1822f",
                                                "sense_id": "12683d1e-68d1-320b-89ae-baa781708af6",
                                                "text": "„Valin, Leucin und Isoleucin werden vom Gehirn besonders leicht aufgenommen und dort dem Stoffwechsel zugeführt, während die anderen Aminosäuren vorwiegend in der Leber abgebaut werden.“"
                                            },
                                            {
                                                "example_id": "f1307857-65ef-4d51-9c22-df661fcf94f7",
                                                "sense_id": "12683d1e-68d1-320b-89ae-baa781708af6",
                                                "text": "„Die Leucine konnten nur durch sehr hydrophobe und sperrige Aminosäuren ersetzt werden, ohne den Transport von Ist2 zu beeinträchtigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
