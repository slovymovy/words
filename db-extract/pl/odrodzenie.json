                                "target_senses": [
                                    {
                                        "sense_id": "63a264a9-7faf-34cf-bab0-c44bcc042b1f",
                                        "entry_id": "af8010aa-f339-36f6-8259-5bac5a2af75c",
                                        "glosses": [
                                            "Movimiento cultural surgido en Europa durante los siglos XV y XVI que marca el interés por el estudio Antigüedad clásica griega y romana y tiene notable influencia en el arte, la filosofía y la literatura de la época."
                                        ],
