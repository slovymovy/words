                ],
                "senses": [
                    {
                        "sense_id": "d793c84e-5a2e-388a-bc62-3b44fc3b5d7d",
                        "entry_id": "0c22356b-f4b7-3199-bac7-b7ab814aa6ee",
                        "glosses": [
                            "Stadt in Usbekistan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc6976ba-1a60-418b-8dc5-9c144a42ce99",
                                "sense_id": "d793c84e-5a2e-388a-bc62-3b44fc3b5d7d",
                                "text": "„Von Kabul aus, seiner ersten Residenz, verlagerte Babur (1500–1530) nach verschiedenen missglückten Versuchen, das zentralasiatische Samarkand einzunehmen, 1519 sein Herrschaftszentrum in die Region südlich des Hindukusch.“"
                            },
                            {
                                "example_id": "00922a6b-6e33-44c6-972d-521921881cf6",
                                "sense_id": "d793c84e-5a2e-388a-bc62-3b44fc3b5d7d",
                                "text": "„So war die Stadt selbst zu einem Sternenhimmel der Träume geworden, erfüllt von fantastischer Musik und verschmolzen mit den Wundern von Carcassonne, Samarkand, El Dorado und all den anderen glorreichen, sagenumwobenen Städten.“"
                            },
                            {
                                "example_id": "3a725b06-ebf5-45ea-94e6-284ca429a68b",
                                "sense_id": "d793c84e-5a2e-388a-bc62-3b44fc3b5d7d",
                                "text": "„Edward Stones letzter großer Kreuzzug begann in jenem Januar in der Stadt Samarkand in der sowjetischen Republik Usbekistan.“"
                            },
                            {
                                "example_id": "34122269-6531-4ec7-bd29-f24f241007f1",
                                "sense_id": "d793c84e-5a2e-388a-bc62-3b44fc3b5d7d",
                                "text": "„Die Männer züchten die Raupen, und die Frauen stellen die berühmte Hudayl-Seide her, die sogar auf dem Markt in Samarkand begehrt ist.“"
                            },
                            {
                                "example_id": "4b361c62-0d87-43c8-ad93-c11d1f8a322b",
                                "sense_id": "d793c84e-5a2e-388a-bc62-3b44fc3b5d7d",
                                "text": "„›Ihr Diener; er hat mir keine Angst gemacht. Auch vor Cthulhu habe ich keine Angst, und genausowenig vor Ithaqua, mit dem ich über das Antlitz der Erde geflogen bin, über Ägypten und Samarkand, über die große, weiße Ebene der Stille, über Hawaii und den Pazifik - aber ich fürchte mich vor Lloigor, der den Körper Stück für Stück von der Erde fortholen kann, und vor seinem Zwillingsbruder Zhat und dem schrecklichen Volk der Tcho-Tcho, das sie auf den Hochebenen Tibets anbetet, und vor...‹“"
                            },
                            {
                                "example_id": "533e2de1-f081-403a-859b-b8288e793d78",
                                "sense_id": "d793c84e-5a2e-388a-bc62-3b44fc3b5d7d",
                                "text": "„Im darauf folgenden Jahrhundert erschuf Taimur - oder Tamerlan, wie er im Westen genannt wird -, ein Abkömmling von Dschingis Khan, ein neues Riesenreich, das sich über Russland und Persien erstreckte und aus seiner Hauptstadt Samarkand im heutigen Usbekistan regiert wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fcac5d1-898d-499c-b7fe-4a2f9df4300b",
                        "source_entry_id": "0c22356b-f4b7-3199-bac7-b7ab814aa6ee",
                        "source_sense_id": "d793c84e-5a2e-388a-bc62-3b44fc3b5d7d",
                        "source_sense_description": "Stadt in Usbekistan",
                        "target_lang_word": "Samarkand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Samarkand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7e67165-9db0-38d4-b4a2-e97f7f97d452",
                                        "entry_id": "704f88a8-65e2-3ef1-bc85-4a27d3760f3a",
                                        "glosses": [
                                            "The regional capital of the Samarkand region, Uzbekistan. Official name: Samarqand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfd87926-ef76-4862-a084-a32947a1e1f7",
                                                "sense_id": "b7e67165-9db0-38d4-b4a2-e97f7f97d452",
                                                "text": "Look ’round thee now on Samarcand! —\nIs she not queen of Earth? her pride\nAbove all cities? in her hand\nTheir destinies?"
                                            },
                                            {
                                                "example_id": "c85b159e-bd4b-42cf-ba9f-e3b1ee002a05",
                                                "sense_id": "b7e67165-9db0-38d4-b4a2-e97f7f97d452",
                                                "text": "In the quaver of his voice was a remembering of long muletrains jingling through the gate, queens in litters hung with patchwork curtains from Samarcand, […]"
                                            },
                                            {
                                                "example_id": "fb215ce6-1d61-402d-a07c-d901bc829408",
                                                "sense_id": "b7e67165-9db0-38d4-b4a2-e97f7f97d452",
                                                "text": "When the tsarist government crumbled with the abdication of Nicholas II in March 1917 a dual administration was established in Samarkand, as it was throughout the entire country."
                                            },
                                            {
                                                "example_id": "8d996489-c458-4636-b789-46b609ca5495",
                                                "sense_id": "b7e67165-9db0-38d4-b4a2-e97f7f97d452",
                                                "text": "Formerly Samarkand, the city, after the 1991 independence of Uzbekistan, adopted the Uzbek form, Samarqand."
                                            },
                                            {
                                                "example_id": "18628c09-0ae9-4311-a00a-7c03cf1dc0c8",
                                                "sense_id": "b7e67165-9db0-38d4-b4a2-e97f7f97d452",
                                                "text": "Originating in the ancient city of Afrasiab, Samarqand is one of the centers of Tajik culture and history. At the time of the Soviet delimitation of Central Asia in 1924, Samarqand was included in Uzbekistan, where it is a provincial center."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "223c0274-b42a-3e89-b907-45c45562d684",
                                        "entry_id": "704f88a8-65e2-3ef1-bc85-4a27d3760f3a",
                                        "glosses": [
                                            "A region of Uzbekistan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
