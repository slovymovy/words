                                    },
                                    {
                                        "sense_id": "f7f633b7-76fd-3289-b0af-bc6a5d6d4604",
                                        "entry_id": "cffc0164-bf3d-3f46-8eb2-69d170eb73fe",
                                        "glosses": [
                                            "A catching of the voice."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e75471b-7358-35ef-af7c-b6bd9fd17677",
                                        "entry_id": "cffc0164-bf3d-3f46-8eb2-69d170eb73fe",
                                        "glosses": [
                                            "A hasty snack; a bite to eat."
                                        ],
