                "senses": [
                    {
                        "sense_id": "7807e426-9f02-34f3-87b7-9754e5dc6440",
                        "entry_id": "b0e9d38a-9359-30d3-9e78-e6575ca19782",
                        "glosses": [
                            "meist flüssige, seltener feste Substanzen, die in der Regel dem Abwaschwasser beim Spülen von Geschirr hinzugefügt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baa7b9d3-2e2f-4de3-ba8c-cbfcd8aacc26",
                                "sense_id": "7807e426-9f02-34f3-87b7-9754e5dc6440",
                                "text": "„Alle Spülmittel, die bei manuellen Reinigungsverfahren verwendet werden, sind Neutralreiniger.“"
                            },
                            {
                                "example_id": "22772b54-c26d-46a3-8539-7844db6fbec1",
                                "sense_id": "7807e426-9f02-34f3-87b7-9754e5dc6440",
                                "text": "„Der Junge kommt wieder herein, gibt Spülmittel hinzu, streift sich ein Paar Einweghandschuhe über und beginnt, die Teegläschen einzuschäumen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
