                ],
                "senses": [
                    {
                        "sense_id": "c78f4538-3c75-3147-a3e7-64b03c86f0de",
                        "entry_id": "4dcec405-e362-39ec-ae72-f21ffba77856",
                        "glosses": [
                            "aus Teilchen bestehend"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "a7c23503-ced7-41d4-9feb-2b3003c8f243",
                                "sense_id": "c78f4538-3c75-3147-a3e7-64b03c86f0de",
                                "text": "„Der Dualismus des Lichtes wurde 1905 von A. Einstein mit seiner Erklärung des Photoeffekts durch korpuskulare Materie konstatiert, nachdem über hundert Jahre die Welleninterpretation des Lichtes dominierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c9bbb20d-f5ff-31f6-8639-d0859dc58650",
                        "entry_id": "4dcec405-e362-39ec-ae72-f21ffba77856",
                        "glosses": [
                            "einem Teilchencharakter entsprechend"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "9adb238d-455c-4c11-8d54-6570864e6e58",
                                "sense_id": "c9bbb20d-f5ff-31f6-8639-d0859dc58650",
                                "text": "„Die Korpuskeltheorie wurde im 19. Jahrhundert durch die Wellentheorie des Lichtes abgelöst, jedoch werden dem Licht seit der Photonentheorie von Albert Einstein (1905) teilweise wieder auch korpuskulare Eigenschaften zugeschrieben (siehe dazu: Welle-Teilchen-Dualismus).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
