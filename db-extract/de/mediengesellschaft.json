                "senses": [
                    {
                        "sense_id": "4e543cfc-1740-370f-9caf-3ac9b6c24810",
                        "entry_id": "29c141fe-28ce-344f-8f8f-cbaacfb6c55c",
                        "glosses": [
                            "Firma, die im Bereich der Medien tätig ist (Herstellung, Verbreitung, Vermarktung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ac2463b-118c-4ef5-a0cb-14184e97b8e5",
                                "sense_id": "4e543cfc-1740-370f-9caf-3ac9b6c24810",
                                "text": "„Die Beteiligung eines bedeutenden europäischen Medienkonzerns an EM.TV könnte den Anfang einer Phase darstellen, in der am Neuen Markt gehandelte Mediengesellschaften einen Teil ihrer Aktiva zum Verkauf anbieten könnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e238cfc6-c951-3d4f-bffe-5dbdc045e2ef",
                        "entry_id": "29c141fe-28ce-344f-8f8f-cbaacfb6c55c",
                        "glosses": [
                            "Gesellschaft, in der (digitale) (Massen-)Medien eine zentrale Rolle für die allgemeine Informationsbeschaffung und Meinungsbildung spielen"
                        ],
                        "tags": [
                            "Soziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "f6825aa0-cb34-4025-a8ab-4772b30c1450",
                                "sense_id": "e238cfc6-c951-3d4f-bffe-5dbdc045e2ef",
                                "text": "„Nach dem Germanwings-Absturz ist klar: Die Mediengesellschaft braucht Regeln zur Wahrung der Besonnenheit in besinnungslosen Zeiten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
