                        "sense_id": "98e4de12-9c2a-3507-8d18-4c0d6a7fe28a",
                        "entry_id": "c6100d2c-ddb7-39d1-beee-e3ab6d0ecf7b",
                        "glosses": [
                            "In an unnatural manner; to an unnatural extent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0f9f94a-37a6-4045-b9ab-1f6ea2ebd7f7",
                                "sense_id": "98e4de12-9c2a-3507-8d18-4c0d6a7fe28a",
                                "text": "Another, with the bump of order unnaturally developed, had his folios and quartos all reduced, in binding, to one size, so that they might look even on his bookshelves."
                            },
                            {
                                "example_id": "c3d032db-158c-4d9f-a97f-a4462f4b987a",
                                "sense_id": "98e4de12-9c2a-3507-8d18-4c0d6a7fe28a",
                                "text": "Not unnaturally, “Auntie” took this communication in bad part. Thus outraged, she showed herself to be a bold as well as a furious virago. Next day she found her way to their lodgings and tried to recover her ward by the hair of the head."
                            }
                        ]
                    }
                ],
