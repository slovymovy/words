        "fr-extract.jsonl": [
            {
                "entry_id": "d04b5ca8-3e23-3a6c-a3b7-89a482fc85c1",
                "word": "irresponsabilité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "88c0d600-8432-44a3-96b4-7eba67f6168c",
                        "entry_id": "d04b5ca8-3e23-3a6c-a3b7-89a482fc85c1",
                        "tags": [
                            "plural"
                        ],
                        "form": "irresponsabilités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f6a4503-021b-32ec-ba99-9bb60160685d",
                        "entry_id": "d04b5ca8-3e23-3a6c-a3b7-89a482fc85c1",
                        "glosses": [
                            "Qualité de ce qui est irresponsable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec99e44c-c1f2-42b0-ab4b-ad6b88519e29",
                                "sense_id": "4f6a4503-021b-32ec-ba99-9bb60160685d",
                                "text": "L’irresponsabilité du chef de l’état."
                            },
                            {
                                "example_id": "91aa279a-b343-4d2c-becb-f0c66b04229f",
                                "sense_id": "4f6a4503-021b-32ec-ba99-9bb60160685d",
                                "text": "En énonçant les causes d’irresponsabilité et d’atténuation de responsabilité, le Code pénal ne distingue pas entre les personnes physiques et les personnes morales."
                            },
                            {
                                "example_id": "784cfb68-049b-4e30-a716-be810231f447",
                                "sense_id": "4f6a4503-021b-32ec-ba99-9bb60160685d",
                                "text": "On fustige au procès Mazan l’irresponsabilité des hommes prêts à tout pour soumettre sexuellement des femmes, mais on ne voit aucun inconvénient à les encourager, dans la prostitution, à leur extorquer un consentement factice au moyen d’un billet…"
                            }
                        ]
                    },
                    {
                        "sense_id": "83e52cf0-dd45-321d-b6c4-66d429904c00",
                        "entry_id": "d04b5ca8-3e23-3a6c-a3b7-89a482fc85c1",
                        "glosses": [
                            "Dans les gouvernements parlementaires, doctrine, loi qui ôte toute responsabilité au souverain et la reporte tout entière sur ses ministres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01876cc1-b444-4a79-bb5a-e6ec4301f343",
                                "sense_id": "83e52cf0-dd45-321d-b6c4-66d429904c00",
                                "text": "L’irresponsabilité royale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81be715c-db3c-4360-a506-ea38679f89ee",
                        "source_entry_id": "d04b5ca8-3e23-3a6c-a3b7-89a482fc85c1",
                        "target_lang_word": "Verantwortungslosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verantwortungslosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a963f91-4336-3237-b3ce-c21b8515e6ac",
                                        "entry_id": "656e33d6-e630-3794-abb9-eb93ff25274a",
                                        "glosses": [
                                            "Eigenschaft, verantwortungslos zu handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7272a4b-a958-4c4a-9f3e-2a271776ab77",
                                                "sense_id": "5a963f91-4336-3237-b3ce-c21b8515e6ac",
                                                "text": "„Sicherheitsberater Henry Kissinger schäumt: ‘Ich sehe nicht ein, warum wir herumstehen und zuschauen sollen, wenn ein Land aufgrund der Verantwortungslosigkeit seiner Bevölkerung kommunistisch wird.‘ “"
                                            },
                                            {
                                                "example_id": "54671909-b871-4dba-9974-8fac27583765",
                                                "sense_id": "5a963f91-4336-3237-b3ce-c21b8515e6ac",
                                                "text": "[Das deutsche Bildungssystem] „ist der Inbegriff organisierter Verantwortungslosigkeit.“"
                                            },
                                            {
                                                "example_id": "a4ee3929-6c1e-4427-8f09-939727c4b1c5",
                                                "sense_id": "5a963f91-4336-3237-b3ce-c21b8515e6ac",
                                                "text": "„Lenken eines Fahrzeuges im hochgradig alkoholbeeinträchtigten Zustand als besonders verwerfliche Verantwortungslosigkeit und als krasser Verstoß gegen die Schutznorm (§ 1311 ABGB) des § 5 Abs 1 StVO.“"
                                            },
                                            {
                                                "example_id": "3da83603-cd40-448b-a6bf-21982c582791",
                                                "sense_id": "5a963f91-4336-3237-b3ce-c21b8515e6ac",
                                                "text": "„Weiterhin zeichnet solche Personen ein hoher Grad an Verantwortungslosigkeit, Angst, Schuldgefühlen, Perfektionismus und Narzissmus aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9cb0501-42ab-4e47-ad8c-fb9f662be241",
                        "source_entry_id": "d04b5ca8-3e23-3a6c-a3b7-89a482fc85c1",
                        "target_lang_word": "irresponsibility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irresponsibility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57d9764a-852a-3e2d-90f6-100f5056619a",
                                        "entry_id": "cadc6ec1-d2d9-32f0-b8d2-05b8c83957d9",
                                        "glosses": [
                                            "The character or state of being irresponsible; lack of or freedom from responsibility; want of accountability."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da7f6ce5-510a-475d-9003-e16ba36e631a",
                                                "sense_id": "57d9764a-852a-3e2d-90f6-100f5056619a",
                                                "text": "How important can the greenhouse effect, biodiversity or future worldwide timber shortages seem to a third-worlder, for example? It would be wrong to think of this third-worlder as irresponsible or as a squanderer of resources before serious steps are taken towards solving the well-known and much worse problem of resource squandering and environmental irresponsibility in the developed nations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3b844ac-65a2-468a-a819-03c49876d7d0",
