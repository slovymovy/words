                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8e9622a-353d-38dc-aee5-ea38de5c930d",
                        "entry_id": "8f3054e0-c9cb-3047-bef8-b3b80b936047",
                        "glosses": [
                            "Relatif à l’ardoise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b51e5265-1874-44e8-8357-fbe0f3ad7db6",
                                "sense_id": "b8e9622a-353d-38dc-aee5-ea38de5c930d",
                                "text": "Depuis ces temps reculés, l’industrie ardoisière a pris un assez grand développement."
                            }
                        ]
                    },
                    {
                        "sense_id": "471ae352-8737-305c-8bae-dc1391913661",
                        "entry_id": "8f3054e0-c9cb-3047-bef8-b3b80b936047",
                        "glosses": [
                            "Qui est fait d'ardoise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63a62c5d-e3e7-4751-bf21-014b34196f89",
                                "sense_id": "471ae352-8737-305c-8bae-dc1391913661",
                                "text": "Les lieux qui forment le département des Ardennes, considérés géologiquement, sont constitués par le terrain ardoisier au nord, le terrain calcaire jurassique au milieu, le terrain crétacé au midi."
                            },
                            {
                                "example_id": "2ff314c9-dd43-47a4-83a2-591a68f5dece",
                                "sense_id": "471ae352-8737-305c-8bae-dc1391913661",
                                "text": "Le massif ardoisier forme le plateau le plus élevé des Ardennes."
                            }
                        ]
                    },
                    {
                        "sense_id": "27cd0bff-d171-36d5-9bc8-7ed25b9902c4",
                        "entry_id": "8f3054e0-c9cb-3047-bef8-b3b80b936047",
                        "glosses": [
                            "Qui a la même structure que l’ardoise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "592de612-a7f6-457d-92d6-e15a96dfff08",
                                "sense_id": "27cd0bff-d171-36d5-9bc8-7ed25b9902c4",
                                "text": "Généralement plus les schistes ardoisiers sont droits et relevés, plus ils sont propres à la confection des ardoises."
                            },
                            {
                                "example_id": "fef0f446-3742-4865-873e-45259d36b07e",
                                "sense_id": "27cd0bff-d171-36d5-9bc8-7ed25b9902c4",
                                "text": "Le schiste ardoisier doit ses applications à sa remarquable fissilité ; il peut se fendre en feuillets aussi minces qu'on le désire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcafd5ad-7fbf-429f-b0f4-5dc37ca2ba64",
                        "source_entry_id": "8f3054e0-c9cb-3047-bef8-b3b80b936047",
                        "target_lang_word": "slaty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slaty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01e3a39c-d48a-3ed1-a1e4-f2917a48d898",
                                        "entry_id": "d08bbe52-51d5-3722-a150-1815ac7efee4",
                                        "glosses": [
                                            "Resembling the rock slate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb8523c0-196a-4e78-b6c7-c80c34697e25",
                                                "sense_id": "01e3a39c-d48a-3ed1-a1e4-f2917a48d898",
                                                "text": "Their faces and hands were yellow as saffron; their small and slaty eyes were set obliquely beneath lashless lids; and their thin lips, which smiled eternally, were crooked. as the blades of scimitars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecbcb1ef-44bb-3945-87dc-474910476647",
                                        "entry_id": "d08bbe52-51d5-3722-a150-1815ac7efee4",
                                        "glosses": [
                                            "Of a light grey colour as slate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c80434f1-9dad-448f-8f0f-7412bb875e4f",
                                                "sense_id": "ecbcb1ef-44bb-3945-87dc-474910476647",
                                                "text": "But snow had now begun to fall out of a forbiddingly slaty-grey sky, and this seemed to depress both engine and crew."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
