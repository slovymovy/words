                ],
                "senses": [
                    {
                        "sense_id": "8db1387c-f98e-3c7a-bc8e-aa355fb00fd0",
                        "entry_id": "bcdc7e0b-5214-381c-b564-91f5b6285efb",
                        "glosses": [
                            "Religion: einfach gestaltetes Andachtsgebäude, kleines Gotteshaus, das nicht für regelmäßige Gottesdienste einer Gemeinde bestimmt ist und von Kreuzwegstationen begleitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff9da24e-4a7b-4ff6-93c3-ad3c4d869e76",
                                "sense_id": "8db1387c-f98e-3c7a-bc8e-aa355fb00fd0",
                                "text": "„Die Kalvarienkapelle ist das einzige Gotteshaus im Landkreis Dachau, das noch eine solche \"Heilige Stiege\" (Scala santa) birgt.“"
                            },
                            {
                                "example_id": "38a660d7-6da8-4623-8e65-2839f2a723a3",
                                "sense_id": "8db1387c-f98e-3c7a-bc8e-aa355fb00fd0",
                                "text": "„Wer sich in der Kalvarienkapelle noch ein wenig genauer umschaut, wird ent decken, dass sie – fast 20 Jahre nach ihrer letzten Renovierung – wieder einmal irdische Hilfe gut gebrauchen könnte.“"
                            },
                            {
                                "example_id": "9d3e8921-dcdd-4bbe-8d04-361b1f139216",
                                "sense_id": "8db1387c-f98e-3c7a-bc8e-aa355fb00fd0",
                                "text": "„Die Kalvarienkapelle gehört den Griechisch-Orthodoxen, deshalb kann Andrei nur dort putzen.“"
                            },
                            {
                                "example_id": "e1a4a590-56e7-4825-b250-3eca539a4706",
                                "sense_id": "8db1387c-f98e-3c7a-bc8e-aa355fb00fd0",
                                "text": "„Eine große Bedeutung hatte einmal die „Bergkirche“ (1715) auf dem Aarberg, die heutige Kalvarienkapelle, die von den Kapuzinermönchen betreut worden ist, die im Kloster vor dem Unteren Tor ihr Domizil hatten.“"
                            },
                            {
                                "example_id": "49c4a51e-fd4d-4650-a3d3-e26d19f39a0b",
                                "sense_id": "8db1387c-f98e-3c7a-bc8e-aa355fb00fd0",
                                "text": "„Am Montag, den 6. Mai 2013, um 8.00 Uhr früh, gingen Gläubige in Begleitung der Volksschulkinder zum Bittgang zur Kalvarienkapelle hoch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
