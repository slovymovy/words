                        "examples": [
                            {
                                "example_id": "7b227c3e-2f53-42a4-975e-dd666f946bf9",
                                "sense_id": "44ae6d8a-6d99-329f-8dbd-2c2ca57167fa",
                                "text": "„»Sie ist eine mündige Staatsbürgerin, du Nulpe«, sagte Feldberg.“"
                            },
                            {
                                "example_id": "319886c2-0e38-4e26-928d-ad1bc6dc3855",
                                "sense_id": "44ae6d8a-6d99-329f-8dbd-2c2ca57167fa",
                                "text": "„Ich kann mich doch von dieser Nulpe nicht einfach so abwimmeln lassen!"
                            }
                        ],
                        "sense_index_json": "\"1\""
