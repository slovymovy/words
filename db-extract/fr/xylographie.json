                    {
                        "translation_id": "5733a845-5738-4c4b-80da-eef13ce77c14",
                        "source_entry_id": "35708e46-8662-3ac7-8d1b-3c94e988793e",
                        "source_sense_description": "impression sur bois",
                        "target_lang_word": "ксилография",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ксилография",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7961ba1a-b844-3c49-8d01-5c2781a03f75",
                                        "entry_id": "7d1e5508-12ed-3d40-bbcb-d85700f74e88",
                                        "glosses": [
                                            "техника гравюры на дереве"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ab839fd-8701-4d7e-bd96-35ffe7470ac3",
                                                "sense_id": "7961ba1a-b844-3c49-8d01-5c2781a03f75",
                                                "text": "Особенно велики достижения В. Матэ в области гравюры на дереве ― ксилографии и офорта."
                                            },
                                            {
                                                "example_id": "e548d88d-e6c6-4e63-844e-0948df01a213",
                                                "sense_id": "7961ba1a-b844-3c49-8d01-5c2781a03f75",
                                                "text": "И разве в мастерской художника не может стоять кислота, если уже десять лет я занимаюсь ксилографией?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2858e59-11da-318e-bd5c-6a4bd9fd7c6e",
                                        "entry_id": "7d1e5508-12ed-3d40-bbcb-d85700f74e88",
                                        "glosses": [
                                            "гравюра, исполненная в такой технике"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4426f3a5-27b0-4940-aa94-94544d1484ca",
                                                "sense_id": "b2858e59-11da-318e-bd5c-6a4bd9fd7c6e",
                                                "text": "Коричнево-красные, жёлтые, серые краски сохранили свежесть, в этом ты можешь убедиться и сам ― посылаю тебе репродукцию одной из лучших ксилографий конца четырнадцатого века."
                                            },
                                            {
                                                "example_id": "d1d462a0-21e4-40c1-979f-c3752e81868c",
                                                "sense_id": "b2858e59-11da-318e-bd5c-6a4bd9fd7c6e",
                                                "text": "Во главе всего его гравюрного творчества, бесспорно, стоят великолепные ксилографии к «Кентерберийским рассказам» Чосера."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
