                "senses": [
                    {
                        "sense_id": "e3f4f6ad-41ea-31b5-b81f-5dd81c8a15d4",
                        "entry_id": "67db4887-6ab4-3526-92c2-9c3801010033",
                        "glosses": [
                            "Singapore (an island and city-state in Southeast Asia, located off the southernmost tip of the Malay Peninsula; a former British crown colony and state of Malaysia (1963-1965))"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee3d741-4c0d-498e-9750-40421187bda2",
                                "sense_id": "e3f4f6ad-41ea-31b5-b81f-5dd81c8a15d4",
                                "text": "Стен Биль, команди́р да́тского корве́та «Галате́я» и а́втор путеше́ствия, сра́внивает ны́нешний Сингапу́р, в торго́вом отноше́нии, с дре́вней Вене́цией.",
                                "translation": "Sten Biel, the commander of the Danish corvette \"Galatea\" and author of a travel account, compares Singapore of today with Venice of old, with respect to trade.",
                                "english": "Sten Biel, the commander of the Danish corvette \"Galatea\" and author of a travel account, compares Singapore of today with Venice of old, with respect to trade."
                            },
                            {
                                "example_id": "b18427e6-ed0b-476f-a8d9-f46f172a38fa",
                                "sense_id": "e3f4f6ad-41ea-31b5-b81f-5dd81c8a15d4",
                                "text": "Чемпиона́т ми́ра по во́дным ви́дам спо́рта 2025 го́да прохо́дит в Сингапу́ре с 11 ию́ля по 3 а́вгуста.",
                                "translation": "Sovetsky Sport",
                                "english": "Sovetsky Sport"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
