                {
                    "sense_id": "c314e356-474e-3d36-9c94-158354af9d2a",
                    "sense_definition": "Se dit d'un dispositif électronique qui réagit au contact direct du doigt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "technologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon nouveau téléphone portable possède un grand écran <w>tactile</w> très réactif."
                        },
                        {
                            "text": "Il est souvent difficile d'utiliser une tablette <w>tactile</w> en portant des gants."
                        }
                    ],
                    "common_phrases": [
                        "écran tactile",
                        "tablette tactile"
                    ]
                },
                {
                    "sense_id": "e00cc25a-4b77-3e41-b346-4901644df27d",
                    "sense_definition": "Relatif au sens du toucher ou à ses mécanismes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les personnes malvoyantes développent souvent une sensibilité <w>tactile</w> particulièrement fine."
                        },
                        {
                            "text": "Le système braille repose entièrement sur la perception <w>tactile</w> de points en relief."
                        }
                    ],
                    "common_phrases": [
                        "perception tactile",
                        "sens tactile"
                    ]
                },
                {
                    "sense_id": "dd2cb447-27b1-32bc-8850-062461a5ca54",
                    "sense_definition": "Qui a l'habitude ou le besoin spontané de toucher les personnes en leur parlant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon collègue est une personne <w>tactile</w> qui pose souvent sa main sur l'épaule."
                        },
                        {
                            "text": "Elle garde toujours ses distances car elle n'est pas du tout <w>tactile</w> avec les inconnus."
                        }
                    ],
                    "common_phrases": [
                        "personne tactile",
                        "être tactile"
                    ]
                },
                {
                    "sense_id": "f3137c29-cf6f-3705-a44c-2a289823ab44",
