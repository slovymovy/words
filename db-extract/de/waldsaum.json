                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f93e942f-2833-4384-ba5a-cefb4ac5b768",
                                "sense_id": "f0444fc7-db98-3af2-a11a-32f2e7ee2201",
                                "text": "„Wir zogen uns über die weißgeschossene Wiese und dann an einem Waldsaum aufwärts.“"
                            },
                            {
                                "example_id": "5fbd72a6-6019-448c-860b-9c94377f60d3",
                                "sense_id": "f0444fc7-db98-3af2-a11a-32f2e7ee2201",
                                "text": "„Ungefähr hundert Schritte weiter hielt im Gebüsch am Waldsaum ein anderer Reitknecht des Grafen, Mitka, ein sehr waghalsiger Reiter und leidenschaftlicher Jäger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
