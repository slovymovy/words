            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "42ce0694-4002-3025-a343-0bf600951e4f",
                    "sense_definition": "Qui a des ennuis, qui est contrarié, embarrassé ou tracassé par une situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "contrarie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je suis sincèrement <w>ennuyé</w> de ne pas pouvoir assister à votre fête ce soir."
                        },
                        {
                            "text": "Il affichait un air <w>ennuyé</w> en apprenant le retard imprévu de son train."
                        }
                    ],
                    "synonyms": [
                        "contrarié",
                        "embarrassé",
                        "embêté",
                        "tracassé"
                    ],
                    "antonyms": [
                        "rassuré",
                        "tranquille"
                    ],
                    "common_phrases": [
