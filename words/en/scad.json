                    }
                },
                {
                    "sense_id": "b61f13ad-f3d4-374c-a0a8-40fe266124d5",
                    "sense_definition": "Any of several marine fish belonging to the family Carangidae, typically found in the western Atlantic.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman caught a small <w>scad</w> near the reef and decided to use it as bait for larger fish.",
                            "target_lang_translations": {
                                "ru": "Рыбак поймал небольшую <w>ставриду</w> у рифа и решил использовать её в качестве наживки для более крупной рыбы."
                            }
                        },
                        {
                            "text": "The Atlantic <w>scad</w> is known for its streamlined body and is often found in large schools.",
                            "target_lang_translations": {
                                "ru": "Атлантическая <w>ставрида</w> известна своим обтекаемым телом и часто встречается большими косяками."
                            }
                        }
                    ],
                    "synonyms": [
                        "horse mackerel"
                    ],
                    "common_phrases": [
