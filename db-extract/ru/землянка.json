                "senses": [
                    {
                        "sense_id": "064e9833-8ff8-37f0-841c-38adcca041c1",
                        "entry_id": "5e30953c-db90-3307-bf31-b2effb259639",
                        "glosses": [
                            "a female Earthling (a woman or girl from Earth)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64b99cc4-a0df-4c25-9e2c-2c8b63b29159",
                                "sense_id": "064e9833-8ff8-37f0-841c-38adcca041c1",
                                "text": "Не инопланетя́нка и не земля́нка ― так, в о́бщем, не поймёшь что!",
                                "translation": "You are not an alien and you are not an Earthling, so in short, we don't know what sort of thing you are!",
                                "english": "You are not an alien and you are not an Earthling, so in short, we don't know what sort of thing you are!"
                            }
                        ]
                    }
