                "senses": [
                    {
                        "sense_id": "9bd41158-f6ec-380c-9f32-44a851bae22b",
                        "entry_id": "4f58238c-2d0c-3a4f-b131-d5aa4294ec6d",
                        "glosses": [
                            "Stoßzahn eines Mammuts"
