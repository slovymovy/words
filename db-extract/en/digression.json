                    },
                    {
                        "translation_id": "5e1de2ba-b5f4-47e9-93ef-af3ba007a3ef",
                        "source_entry_id": "d249b866-c34e-3255-bf73-b0ed2675e61c",
                        "source_sense_description": "a departure from the main subject in speech or writing",
                        "target_lang_word": "uitweiding",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uitweiding",
