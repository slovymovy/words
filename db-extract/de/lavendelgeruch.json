                "senses": [
                    {
                        "sense_id": "96e0e63d-fa86-393b-b0bf-eded15afeca0",
                        "entry_id": "df003776-c750-316e-8736-71e819e0a216",
                        "glosses": [
                            "Duftstoff, der von einer Lavendel abgegeben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2192070-3ae2-4022-aa53-e420aa64b075",
                                "sense_id": "96e0e63d-fa86-393b-b0bf-eded15afeca0",
                                "text": "„Dabei ist inzwischen bewiesen, dass zum Beispiel das Kauen von Gewürznelken gegen Zahnschmerzen hilft, der Duft von Pfefferminzöl Heißhunger-Attacken vorbeugt oder Lavendelgeruch entspannend wirkt.“"
                            },
                            {
                                "example_id": "95427949-7e44-4259-86ec-3377a1f3ace7",
                                "sense_id": "96e0e63d-fa86-393b-b0bf-eded15afeca0",
                                "text": "„Pflanzen Sie Lavendelbüsche zwischen die Rosenstöcke - der intensive Lavendelgeruch vertreibt die lästigen Krabbeltiere zuverlässig - und duftet dazu noch himmlisch nach Sommer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
