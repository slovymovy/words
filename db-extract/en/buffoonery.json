                    },
                    {
                        "translation_id": "ea828d34-2373-46b3-817f-8c747eeb23ed",
                        "source_entry_id": "d2fa18a7-0552-3457-bc0f-ae2a6fe66cbc",
                        "source_sense_id": "2cc54b08-67c6-358f-af7f-6c6e5a7f7fd3",
                        "source_sense_description": "behaviour expected of a buffoon — see also foolishness, silliness",
                        "target_lang_word": "Clownerie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Clownerie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfedd468-ff62-3045-b6fc-53fa4866d50c",
                                        "entry_id": "f692e6d5-0ab7-3f24-bbac-91a1c634c2bf",
                                        "glosses": [
                                            "Verhalten nach Art eines Clowns"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8be6c3e-13aa-4022-b330-0107e49662b8",
                                                "sense_id": "bfedd468-ff62-3045-b6fc-53fa4866d50c",
                                                "text": "„Seine Clownerie hatte plötzlich etwas Verzweifeltes, es war die Verzweiflung eines übergeschnappten Eichhörnchens, und Claire fand dieses Gebaren erchreckender als Nikolais deutliche Vision kommenden Unheils.“"
                                            },
                                            {
                                                "example_id": "54a4b2f3-9cd4-4e5a-b815-7232bdd4e18f",
                                                "sense_id": "bfedd468-ff62-3045-b6fc-53fa4866d50c",
                                                "text": "„Wer nicht weiß, was die Worte bedeuten, hätte es für Clownerie halten können, den Auftritt eines mittelalterlichen Possenreißers mit schwarz bemaltem Gesicht; an Requisiten fehlten nur Laute oder ein Tamburin.“"
                                            },
                                            {
                                                "example_id": "e0fff44e-74d8-4bf4-9605-b60801ef01ee",
                                                "sense_id": "bfedd468-ff62-3045-b6fc-53fa4866d50c",
                                                "text": "„Jon Davison, Clownschauspieler, Clownlehrer und Autor der Studie Clown Readings in Theater Practice bezeichnet die Unmittelbarkeit, die auf den gegenwärtigen Moment fokussiert, als Hauptmerkmal der Clownerie.“"
                                            },
                                            {
                                                "example_id": "267dd9e5-44d6-4d4a-860b-5a363d77fdfe",
                                                "sense_id": "bfedd468-ff62-3045-b6fc-53fa4866d50c",
                                                "text": "„Lachen entspannt, und Gags, Wortverdrehungen, Sprüche, Clownerien schaffen die auflockernde Atmosphäre, die das harte Geschäft des Lernens angenehm macht.“"
                                            },
                                            {
                                                "example_id": "dceb6464-3e22-43a3-9d71-8fc6fc25a99b",
                                                "sense_id": "bfedd468-ff62-3045-b6fc-53fa4866d50c",
                                                "text": "Das ‚Endspiel’ ist hier auf eine Clownerie zusammengeschrumpft, die das Antidrama mit seiner grauenhaften Monotonie auf eine makabre Weise endgültig ad absurdum führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e508e50-b260-4595-bf96-09dc40e106b7",
                        "source_entry_id": "d2fa18a7-0552-3457-bc0f-ae2a6fe66cbc",
