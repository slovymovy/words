                        "glosses": [
                            "Gewand indischer Frauen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f713a5d1-18e9-4561-a953-c084fcf30df2",
                                "sense_id": "5a2dfd73-e296-3cb1-9381-3247412182cf",
                                "text": "„Frauen in pinkfarbenen Saris waschen ihre Kinder, Hunde kläffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03361109-1003-40f1-9e79-ecc6bc3660f7",
                        "source_entry_id": "eede6b15-b209-30da-b835-200a599c2b00",
                        "source_sense_id": "5a2dfd73-e296-3cb1-9381-3247412182cf",
                        "source_sense_description": "Gewand indischer Frauen",
                        "target_lang_word": "sari",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sari",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9732bf0-eeeb-3bec-ade1-5a7062f1e86a",
                                        "entry_id": "193be66f-8108-32aa-9084-841ab8420d07",
                                        "glosses": [
                                            "The traditional dress of women in the Indian Subcontinent; an outer garment consisting of a single length of cotton or silk, most often with one end wrapped around the waist to form a skirt, the other draped over the shoulder or head."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2865e84a-9457-41f6-847e-6b33b2514947",
                        "source_entry_id": "eede6b15-b209-30da-b835-200a599c2b00",
                        "source_sense_id": "5a2dfd73-e296-3cb1-9381-3247412182cf",
                        "source_sense_description": "Gewand indischer Frauen",
                        "target_lang_word": "sari",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sari",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3219f2b2-5ddc-3d4d-8540-b9f37fc7239d",
                                        "entry_id": "7ae6f289-72fa-3fd8-9546-9b5b52850cf1",
                                        "glosses": [
                                            "Robe traditionnelle des femmes en Inde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec2f0bd3-7a50-49e8-809b-448ecd28c595",
                                                "sense_id": "3219f2b2-5ddc-3d4d-8540-b9f37fc7239d",
                                                "text": "Elle-même s’était parée du sari de cérémonie rouge et or qu’ils avaient apporté du village. C’était son sari de mariage."
                                            },
                                            {
                                                "example_id": "ac00cd53-cf53-4327-b66f-23b70dc3be4c",
                                                "sense_id": "3219f2b2-5ddc-3d4d-8540-b9f37fc7239d",
                                                "text": "Dans les rues, se promènent : les vaches à l’aise à se « jobrer » le museau dans les poubelles (est-ce très sain pour elles et le lait qu’elles délivrent ?), les écoliers en costume marchent fièrement, les femmes ont confectionné de longues guirlandes, les présentent dans des corbeilles tressées, étalage rehaussé sur des caisses en bois défoncées, les fleurs et les saris sont éclatants de couleurs (jamais en blanc signe de deuil), les hommes et femmes s’arrêtent acheter les rubans colorés pour les offrir aux divinités du temple, les portables sont dans toutes les mains et souvent plaqués à l’oreille."
                                            },
                                            {
                                                "example_id": "faa1dcf0-b574-4ce9-abd6-c2c2e1387cee",
                                                "sense_id": "3219f2b2-5ddc-3d4d-8540-b9f37fc7239d",
                                                "text": "Elle avait un sari tellement usé que le bleu d'origine tirait inexorablement vers le blanc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sari",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3487655-89c8-36d1-bf68-1c17283ecfce",
                                        "entry_id": "6582a93f-014d-3807-8180-9dd18de9a93e",
                                        "glosses": [
                                            "Mollusque du Sénégal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62180e0e-5023-4590-ac2e-40e1e92dd454",
                                                "sense_id": "f3487655-89c8-36d1-bf68-1c17283ecfce",
                                                "text": "La coquille du sari n’a guère plus de deux lignes de longueur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
