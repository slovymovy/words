                    {
                        "translation_id": "fd0011f4-5557-4fce-8c2a-f6b9d56fb577",
                        "source_entry_id": "86836f09-8866-3e80-8db2-2c083787aadf",
                        "source_sense_id": "d60e996f-fda5-3193-a6bb-09f474d2e4e4",
                        "target_lang_word": "carabattole",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "14e48d51-72c3-4766-8c9c-7ba729c8f80d",
                        "source_entry_id": "86836f09-8866-3e80-8db2-2c083787aadf",
                        "source_sense_id": "d60e996f-fda5-3193-a6bb-09f474d2e4e4",
                        "target_lang_word": "Gerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4c33b49-b8a7-3904-9c0b-bfd0548ce931",
                                        "entry_id": "93f47244-3495-3194-afb0-fc940a63337b",
                                        "glosses": [
                                            "ein Werkzeug oder Hilfsmittel; ein (ursprünglich einfach aufgebauter) beweglicher Gegenstand, mit dem etwas bewirkt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65be73e8-3b9a-4548-b6b9-793171ed1304",
                                                "sense_id": "a4c33b49-b8a7-3904-9c0b-bfd0548ce931",
                                                "text": "Der Werkzeugschrank ist voll mit Geräten aller Art."
                                            },
                                            {
                                                "example_id": "0eb25d79-b843-4374-a7a5-43657a65ff72",
                                                "sense_id": "a4c33b49-b8a7-3904-9c0b-bfd0548ce931",
                                                "text": "[Schlagzeile:] „Smartphones – Was die Geräte mit uns machen“"
                                            },
                                            {
                                                "example_id": "2c73df4a-b037-4cb5-9e3f-b144f86cbb10",
                                                "sense_id": "a4c33b49-b8a7-3904-9c0b-bfd0548ce931",
                                                "text": "„»Die Raumstation [Anmerkung: ISS] hat in ihrer Halbzeit eine kleine Renovierung hinter sich: Neue Geräte und noch mehr spannende Experimente«, sagt Cristoforetti.“"
                                            },
                                            {
                                                "example_id": "86c824e0-18a6-4d0a-8706-3706054c709e",
                                                "sense_id": "a4c33b49-b8a7-3904-9c0b-bfd0548ce931",
                                                "text": "„Das Auto wurde dabei so stark beschädigt, dass [Anmerkung: der Golfspieler Tiger] Woods mit einem hydraulischen Gerät aus dem Wrack befreit werden musste.“"
                                            },
                                            {
                                                "example_id": "c4c0554c-64e0-4c2f-8e5d-94b14bda0f45",
                                                "sense_id": "a4c33b49-b8a7-3904-9c0b-bfd0548ce931",
                                                "text": "„Eltern haben neben der Blockade von unerwünschten Seiten und Diensten die Möglichkeit, die Nutzung von Geräten zeitlich einzugrenzen.“"
                                            },
                                            {
                                                "example_id": "4d5b1fb1-98cc-4866-a5c5-82ca23071517",
                                                "sense_id": "a4c33b49-b8a7-3904-9c0b-bfd0548ce931",
                                                "text": "„Das Familienunternehmen aus Lübeck stellt eines der derzeit begehrtesten Produkte her: Beatmungsgeräte. Auch die deutsche Bundesregierung bestellte 10.000 Geräte.“"
                                            },
                                            {
                                                "example_id": "04ed6e24-467f-4f22-8c48-3f30b20d8ea4",
                                                "sense_id": "a4c33b49-b8a7-3904-9c0b-bfd0548ce931",
                                                "text": "„Der Skipper hatte das Gerät schon einmal zerlegt, um einen neuen Joystickschalter einzubauen. So zerlegt er auch diesmal das Gerät, trocknet die Einzelteile mit Hilfe des Haarföhns und – oh Wunder – nach dem Zusammenbau arbeitet der Plotter bestimmungsgemäß. Gut gemacht!“"
                                            },
                                            {
                                                "example_id": "82c1400a-3c82-4e99-9276-5757a5444d7e",
                                                "sense_id": "a4c33b49-b8a7-3904-9c0b-bfd0548ce931",
                                                "text": "[Fernseher:] „Dieses Gerät von Grundig entstand um 1970 und erinnert stark an die Werke italienischer Designer dieser Zeit.“"
                                            },
                                            {
                                                "example_id": "2774d9a9-7db0-41b1-9224-1410cc7d1fc0",
                                                "sense_id": "a4c33b49-b8a7-3904-9c0b-bfd0548ce931",
                                                "text": "[Schlagzeile:] „Elektroschrott - Händler müssen ausgediente Geräte annehmen“"
                                            },
                                            {
                                                "example_id": "bf3630c0-96a2-4f52-8419-8305dae8966b",
                                                "sense_id": "a4c33b49-b8a7-3904-9c0b-bfd0548ce931",
                                                "text": "„Optional nutzen Sie einen Cloudspeicher-Dienst, um die Aufgaben zwischen Geräten abzugleichen […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "680594eb-432e-3e97-af80-122735a4d661",
                                        "entry_id": "93f47244-3495-3194-afb0-fc940a63337b",
                                        "glosses": [
                                            "der sportlichen Ertüchtigung dienende Vorrichtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe06c2cb-9dc2-4c0a-a686-775f0ef40906",
                                                "sense_id": "680594eb-432e-3e97-af80-122735a4d661",
                                                "text": "An welchem Gerät wirst du deine Abschlusskür zeigen?"
                                            },
                                            {
                                                "example_id": "82345d0d-5d90-4834-89d0-bb2bb0e31952",
                                                "sense_id": "680594eb-432e-3e97-af80-122735a4d661",
                                                "text": "„[…] schon 1896 - bei den ersten Spielen der Neuzeit in Athen - kämpften die Männer an Barren, Reck, Seitpferd und im Pferdsprung um den Titel. […] Mittlerweile sind aus vier Geräten sechs geworden: dazugekommen sind Boden und Ringe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b5d9b12f-f9af-3407-a733-472b9e8b1385",
                                        "entry_id": "93f47244-3495-3194-afb0-fc940a63337b",
                                        "glosses": [
                                            "technische Gesamtheit an Ausrüstung mit Geräten"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8126d03d-a14e-46e3-9cd3-17e385f2d9db",
                                                "sense_id": "b5d9b12f-f9af-3407-a733-472b9e8b1385",
                                                "text": "Das schwere Gerät wurde schon am Vortag auf die Baustelle gebracht."
                                            },
                                            {
                                                "example_id": "7b32b103-e953-40a0-b747-223309b22261",
                                                "sense_id": "b5d9b12f-f9af-3407-a733-472b9e8b1385",
                                                "text": "Manche Autofahrer kann man nach einem Unfall nur mit schwerem Gerät aus Ihrem Auto befreien."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff225e83-b65d-4f05-b7bb-a9ec40ea0311",
                        "source_entry_id": "86836f09-8866-3e80-8db2-2c083787aadf",
                        "source_sense_id": "d60e996f-fda5-3193-a6bb-09f474d2e4e4",
