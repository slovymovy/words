                                                "sense_id": "794a6188-5176-314b-b571-3ca5f83de3a7",
                                                "text": "Gummiteile sollen die Vibrationen der Festplatte dämpfen."
                                            },
                                            {
                                                "example_id": "a348166b-5271-40b1-b638-1e14b57d9688",
