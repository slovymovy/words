{
    "word_family": [
        "wringing",
        "wrong",
        "uitwringen",
        "verwringen",
        "wringijzer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b159470-71ce-3c55-a399-1919f6408282",
                    "sense_definition": "met een draaiende beweging vocht uit iets persen of iets vervormen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vervormen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de natte kleren goed <w>wringen</w> voordat je ze aan de lijn hangt.",
                            "target_lang_translations": {
                                "en": "You must <w>wring</w> the wet clothes well before hanging them on the line."
                            }
                        },
                        {
                            "text": "Na het wassen van de auto moet hij de doek stevig <w>wringen</w>.",
                            "target_lang_translations": {
                                "en": "After washing the car, he has to <w>wring</w> the cloth out firmly."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitwringen",
                        "draaien",
                        "persen"
                    ],
                    "common_phrases": [
                        "kleren wringen",
                        "een doek wringen"
                    ],
                    "target_lang_definitions": {
                        "en": "to press moisture out of something or to deform it using a rotating motion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wring",
                                "target_lang_sense_clarification": "to squeeze liquid out by twisting"
                            },
                            {
                                "target_lang_word": "twist",
                                "target_lang_sense_clarification": "to turn or rotate with force"
                            },
                            {
                                "target_lang_word": "contort",
                                "target_lang_sense_clarification": "to twist into a strained shape"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17655f3b-1b92-38db-a65f-737f72cd003a",
                    "sense_definition": "zich met moeite of door te draaien door een nauwe opening of menigte verplaatsen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze <w>wrong</w> zich door de smalle deuropening de kamer in.",
                            "target_lang_translations": {
                                "en": "She <w>squeezed</w> herself into the room through the narrow doorway."
                            }
                        },
                        {
                            "text": "De ontsnapte gevangene probeerde zich door het kleine raampje te <w>wringen</w>.",
                            "target_lang_translations": {
                                "en": "The escaped prisoner tried to <w>wriggle</w> through the small window."
                            }
                        }
                    ],
                    "synonyms": [
                        "wurmen",
                        "dringen"
                    ],
                    "common_phrases": [
                        "zich door de menigte wringen",
                        "zich in bochten wringen"
                    ],
                    "target_lang_definitions": {
                        "en": "to move through a narrow opening or crowd with difficulty or by twisting one's body"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "squeeze",
                                "target_lang_sense_clarification": "to force oneself through a tight space"
                            },
                            {
                                "target_lang_word": "wriggle",
                                "target_lang_sense_clarification": "to move with small twisting motions"
                            },
                            {
                                "target_lang_word": "worm",
                                "target_lang_sense_clarification": "to move through a narrow space like a worm"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71622fbe-6977-3493-aec7-746e9123e0d4",
                    "sense_definition": "onaangenaam strak zitten of knellen, vaak gezegd van kleding of schoeisel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "knellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze nieuwe schoenen <w>wringen</w> nog een beetje bij mijn hiel.",
                            "target_lang_translations": {
                                "en": "These new shoes still <w>pinch</w> a bit at my heel."
                            }
                        },
                        {
                            "text": "Ik voel dat mijn kraag begint te <w>wringen</w> nu het zo warm is.",
                            "target_lang_translations": {
                                "en": "I feel my collar starting to <w>chafe</w> now that it's so hot."
                            }
                        }
                    ],
                    "synonyms": [
                        "knellen",
                        "drukken"
                    ],
                    "common_phrases": [
                        "schoenen wringen"
                    ],
                    "target_lang_definitions": {
                        "en": "to be uncomfortably tight or to pinch, often said of clothing or footwear"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pinch",
                                "target_lang_sense_clarification": "to be too tight and cause pain"
                            },
                            {
                                "target_lang_word": "chafe",
                                "target_lang_sense_clarification": "to rub or irritate due to tightness"
                            },
                            {
                                "target_lang_word": "bind",
                                "target_lang_sense_clarification": "to be uncomfortably restrictive"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da5b2164-7366-3169-9e0b-1198466f8f1c",
                    "sense_definition": "iets met kracht of geweld uit iemands greep of uit een positie halen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kracht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dief probeerde de tas uit haar handen te <w>wringen</w>.",
                            "target_lang_translations": {
                                "en": "The thief tried to <w>wrest</w> the bag from her hands."
                            }
                        },
                        {
                            "text": "Hij wist de sleutel eindelijk uit het slot te <w>wringen</w>.",
                            "target_lang_translations": {
                                "en": "He finally managed to <w>wrench</w> the key out of the lock."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontrukken",
                        "trekken"
                    ],
                    "common_phrases": [
                        "uit de handen wringen"
                    ],
                    "target_lang_definitions": {
                        "en": "to remove something from someone's grasp or from a position using force or violence"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wrest",
                                "target_lang_sense_clarification": "to pull away with a violent twist"
                            },
                            {
                                "target_lang_word": "wrench",
                                "target_lang_sense_clarification": "to pull or twist suddenly and violently"
                            },
                            {
                                "target_lang_word": "pry",
                                "target_lang_sense_clarification": "to force something out of a position"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}