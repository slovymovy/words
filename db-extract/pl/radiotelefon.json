                "senses": [
                    {
                        "sense_id": "dbaf3e3c-6077-384a-965f-0ce5456e8997",
                        "entry_id": "2feec486-dbfe-33da-8f66-f2bf47f48383",
                        "glosses": [
                            "radiotelephone (a device that allows two-way communication via radio)"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "9451ce28-239a-4f68-a418-82af37ca7aa9",
                                "sense_id": "dbaf3e3c-6077-384a-965f-0ce5456e8997",
                                "text": "Nagle radiotelefon jednego z nich zachrobotał i pośród szumów i pisków usłyszeliśmy szumiący głos: - Dwójka, zgłoś się!",
                                "translation": "Suddenly, a radiotelephone of one of them grated and, among noise and screeching, we heard a humming voice: - Number two, report!",
                                "english": "Suddenly, a radiotelephone of one of them grated and, among noise and screeching, we heard a humming voice: - Number two, report!"
                            },
                            {
                                "example_id": "8954ffa3-fdbe-41b5-86eb-646f9036243d",
                                "sense_id": "dbaf3e3c-6077-384a-965f-0ce5456e8997",
                                "text": "Zainstalowanie w nich radiotelefonu umożliwia natychmiastowy kontakt lekarza wiejskiego ośrodka zdrowia z ordynatorem oddziału, uzyskanie fachowej konsultacji i rady czy też szybkie wezwanie pogotowia ratunkowego.",
                                "translation": "Installing a radiotelephone in them enables a rural health center doctor to immediately contact a medical director of a ward, obtain professional consultation and advice, or quickly call an ambulance.",
                                "english": "Installing a radiotelephone in them enables a rural health center doctor to immediately contact a medical director of a ward, obtain professional consultation and advice, or quickly call an ambulance."
                            },
                            {
                                "example_id": "87b93385-a99d-44f0-ab8e-202b6f8fdaa9",
                                "sense_id": "dbaf3e3c-6077-384a-965f-0ce5456e8997",
                                "text": "Jeśli pacjent transportowany jest naszą sanitarką kardiologiczną, to już jadący z nim lekarz wykonuje EKG i podaje nam przez radiotelefon, jaki jest stan pacjenta — podkreśla dr Lekston.",
                                "translation": "If a patient is transported in our ambulance, the doctor riding with him already does ECG and tells us with a radiotelephone what is the patient's status — dr Lekston underline.",
                                "english": "If a patient is transported in our ambulance, the doctor riding with him already does ECG and tells us with a radiotelephone what is the patient's status — dr Lekston underline."
                            }
                        ]
                    }
                ],
