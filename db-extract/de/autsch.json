                                        "sense_id": "4829edce-7870-37f0-90ab-f6aa0fe8e029",
                                        "entry_id": "f6b4f7e3-1b7c-3f42-954c-c022c0e6b9c7",
                                        "glosses": [
                                            "Synonym of ouch (“cry of pain”)."
