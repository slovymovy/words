                "senses": [
                    {
                        "sense_id": "6070ae2a-15d5-3b28-9a1a-42a83c404de9",
                        "entry_id": "7ae4d748-1721-3a75-ae15-0a15de01265c",
                        "glosses": [
                            "Vereinigung von Ingenieuren und Technikern mit privatrechtlichem Sonderstatus; größeres Ingenieurbüro mit unterschiedlichen Fachrichtungen als PartG oder GbR"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8f2032c-ec90-4f57-955d-7736ee3c98a4",
                                "sense_id": "6070ae2a-15d5-3b28-9a1a-42a83c404de9",
                                "text": "„Die Ingenieurgesellschaft Ansbach ( IGA ) wurde im Mai 1992 von den beiden Diplomingenieuren Dietmar Fischer und Hagen Bischoff als Gesellschaft des bürgerlichen Rechts gegründet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f2707b43-a6c7-335f-bff9-92440e292ff6",
                        "entry_id": "7ae4d748-1721-3a75-ae15-0a15de01265c",
                        "glosses": [
                            "wirtschaftliche Vereinigung von Ingenieuren und Technikern in der Rechtsform einer eingetragenen Kapitalgesellschaft als GmbH oder AG"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eb21aea-1565-4079-9d42-efd5778ba032",
                                "sense_id": "f2707b43-a6c7-335f-bff9-92440e292ff6",
                                "text": "„Die Ingenieurgesellschaft HTP GmbH & Co. KG ist ein unabhängiges Planungs- und Beratungsunternehmen, das Anfang der 90er Jahre seine Geschäftstätigkeit aufnahm.“"
                            },
                            {
                                "example_id": "d75e3b14-2bdb-4ae3-bc93-56d50ee9427a",
                                "sense_id": "f2707b43-a6c7-335f-bff9-92440e292ff6",
                                "text": "„Unsere Ingenieurgesellschaft ist auf allen Planungsebenen vom Bund (z.B. bei der Bearbeitung von Forschungsvorhaben), über die Bundesländer (z.B. mit einer Untersuchung zur geplanten Autobahn A14 in Sachsen-Anhalt), die Landkreise (z.B. im Rahmen der Erstellung von Nahverkehrsplänen) sowie Kommunen bis hin zu privaten Investoren (z.B. bei neuen Gewerbeansiedlungen) tätig.“"
                            },
                            {
                                "example_id": "aad117b4-4078-408a-b4ec-1ede58ab397a",
                                "sense_id": "f2707b43-a6c7-335f-bff9-92440e292ff6",
                                "text": "„Die Ingenieurgesellschaft Nordwest wurde 1978 von Dipl.-Ing. Jürgen Becker gegründet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
