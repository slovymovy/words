                                "example_id": "fc2325c5-a83f-4dc2-bb92-030ab2a68b81",
                                "sense_id": "8dd5b9ec-1df1-38ea-b001-8bbe148d4598",
                                "text": "Rozwój komórek tłuszczowych Komórka prekursorowa jest przekształcana z progenitorowej komórki mezenchymalnej w dojrzałego adipocyta poprzez akumulację i zlewanie się […]",
                                "translation": "Adipocyte development The precursor cell is transformed from a mesenchymal progenitor cell to a mature adipocyte through accumulation and fusion […]",
                                "english": "Adipocyte development The precursor cell is transformed from a mesenchymal progenitor cell to a mature adipocyte through accumulation and fusion […]"
                            }
