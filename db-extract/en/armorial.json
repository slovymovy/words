    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4909686d-e659-3692-8f75-0076f4095c26",
                "word": "armorial",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "513a797d-56b0-37c9-94c9-4b28734df0eb",
                        "entry_id": "4909686d-e659-3692-8f75-0076f4095c26",
                        "glosses": [
                            "Of, or relating to heraldry, or to heraldic arms."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c2752d26-fea7-4df6-9017-f0902bf3680e",
                                "sense_id": "513a797d-56b0-37c9-94c9-4b28734df0eb",
                                "text": "Mute Memento of that union\nIn a Saxon Church survives,\nWhere a cross-legged Knight lies sculptured\nAs between two wedded Wives—\nFigures with armorial signs of race and birth,\nAnd the vain rank the Pilgrims bore while yet on earth."
                            },
                            {
                                "example_id": "2e8cd12c-5cbf-4052-8919-77682fdc91f4",
                                "sense_id": "513a797d-56b0-37c9-94c9-4b28734df0eb",
                                "text": "The Metropolitan District Railway did not at any time employ an armorial device on its rolling stock, though one was frequently displayed on its maps and timetables."
                            },
                            {
                                "example_id": "2c41bfeb-18bd-4dc1-b2bf-fef8a6967513",
                                "sense_id": "513a797d-56b0-37c9-94c9-4b28734df0eb",
                                "text": "Nick found a set of Trollope which had a relatively modest and approachable look among the rest, and took down The Way We Live Now, with an armorial bookplate, the pages uncut."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a7339f4-7a90-45c4-b543-4f02d6ecbe43",
                        "source_entry_id": "4909686d-e659-3692-8f75-0076f4095c26",
                        "source_sense_id": "513a797d-56b0-37c9-94c9-4b28734df0eb",
