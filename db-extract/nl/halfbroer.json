                ],
                "senses": [
                    {
                        "sense_id": "ed9f4fe4-65d7-3e6e-b514-e0fba977d6bb",
                        "entry_id": "c0415754-1924-3d06-b3e9-a1ad2b1dffda",
                        "glosses": [
                            "Een halfbroer van een persoon is iemand van het mannelijk geslacht die één ouder, maar niet beide, deelt met die persoon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce91e89d-3bfb-4ac3-ab9a-0e059471f056",
                                "sense_id": "ed9f4fe4-65d7-3e6e-b514-e0fba977d6bb",
                                "text": "Mijn vader is hertrouwd en mijn halfbroer is het kind van zijn nieuwe vrouw."
                            },
                            {
                                "example_id": "7362f871-994a-4b2b-b359-694840be5377",
                                "sense_id": "ed9f4fe4-65d7-3e6e-b514-e0fba977d6bb",
                                "text": "Politiek en gokwereld spanden samen om Helmin Wiels te vermoorden. Dat beeld kwam naar voren in de rechtszaak tegen Burney F., gisteren op Curaçao. Ex-minister van Financiën, George Jamaloodin van de partij van Gerrit Schotte, de MFK, zou de grote organisator zijn. Samen met zijn halfbroer en gokbaas op het eiland, Robbie dos S."
                            },
                            {
                                "example_id": "d04a7df4-a644-468a-b169-36290504a9c3",
                                "sense_id": "ed9f4fe4-65d7-3e6e-b514-e0fba977d6bb",
                                "text": "En ik had een halfbroer gekregen met de belachelijke naam Axel Edvin Hansson, die in de eerste klas was begonnen en zover ik wist op school ook Lauritzen werd genoemd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "138dd8b2-de7b-4591-8df8-88524673afa2",
                        "source_entry_id": "c0415754-1924-3d06-b3e9-a1ad2b1dffda",
                        "source_sense_id": "ed9f4fe4-65d7-3e6e-b514-e0fba977d6bb",
                        "target_lang_word": "Halbbruder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halbbruder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                                        "entry_id": "25f34ba6-461e-3e39-b363-547d37534d8c",
                                        "glosses": [
                                            "blutsverwandter Bruder anderer Kinder nur von Vater oder Mutter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d903934-eff1-40c8-be12-a5b6d4cef3da",
                                                "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                                                "text": "„Mein älterer Halbbruder nahm die Sache klaglos so, wie sie kam.“"
                                            },
                                            {
                                                "example_id": "9ee54ec9-3cd1-4717-b688-b2fb1595c298",
                                                "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                                                "text": "„Mit dieser Bemerkung erinnerte er Henriette daran, dass sie einen Halbbruder in Skopun hatte.“"
                                            },
                                            {
                                                "example_id": "42f603a3-899c-4642-8c3a-6ddc44f53f52",
                                                "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                                                "text": "„Es gibt ein Foto von Annie und ihrem Vater und ihrem Halbbruder, die drei blicken direkt in die Kamera.“"
                                            },
                                            {
                                                "example_id": "ed8a4102-76d3-463e-bb02-ef32ea2d16a8",
                                                "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                                                "text": "„Doch die ehelichen Kinder erfuhren erst nach dessen Tod von der Existenz ihres Halbbruders.“"
                                            },
                                            {
                                                "example_id": "06dd869d-d0e6-4a58-b3db-aa3d4e0d8fd6",
                                                "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                                                "text": "„Vorsitzender des Gewerkschaftsdachverbands ZCTU wurde 1981 Mugabes Halbbruder Albert, der die Arbeiterorganisationen auf Parteilinie bringen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a9b3dcf-804e-4a24-a80d-f4943f6b73d6",
                        "source_entry_id": "c0415754-1924-3d06-b3e9-a1ad2b1dffda",
