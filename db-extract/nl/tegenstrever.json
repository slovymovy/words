                ],
                "senses": [
                    {
                        "sense_id": "6364f5de-f38f-3a1f-a83a-bfcca408a597",
                        "entry_id": "b03b2a7d-e4b4-3ca7-9a1e-6c1cd9401e66",
                        "glosses": [
                            "iemand die tegenwerkt, tegenspeler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a8cfc8a-7233-406d-a4e4-0c6690c65f2c",
                                "sense_id": "6364f5de-f38f-3a1f-a83a-bfcca408a597",
                                "text": "Zijn tegenstrevers waren te sterk, er bleef hem niets anders over dan zijn zaak verkopen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "748b157d-66bf-4733-80f2-314e794a6d62",
                        "source_entry_id": "b03b2a7d-e4b4-3ca7-9a1e-6c1cd9401e66",
                        "source_sense_id": "6364f5de-f38f-3a1f-a83a-bfcca408a597",
                        "source_sense_description": "iemand die tegenwerkt",
                        "target_lang_word": "Gegner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                        "entry_id": "52366874-c34c-3fda-a884-d52c30d728ca",
                                        "glosses": [
                                            "Person oder Institution/Organisation, die gegenteilige Interessen verfolgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb35f0aa-e4e5-4431-9918-8ca4c93090e6",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "Der Gegner von Hannover 96 war diesmal der 1. FC Köln."
                                            },
                                            {
                                                "example_id": "098461f2-d727-4a52-88a3-0c743e197ce9",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "„Entgegen den Beteuerungen der romfreundlichen Autoren, die den 2. Römisch-Karthagischen Krieg als ein Ringen zwischen zwei gleich starken Gegnern darstellen, war die Disproportion zwischen den Beteiligten groß.“"
                                            },
                                            {
                                                "example_id": "3ce54634-dab5-4456-a339-9d263b8523ac",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "„Es ist für viele wahlentscheidend, auf welchen Gegner sich die präferierte Partei einlassen würde.“"
                                            },
                                            {
                                                "example_id": "2d92df93-efc7-46ed-8492-73c6f414ade7",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "„Seine Idee hatte viele Gegner, vor allem unter den Kongressabgeordneten aus dem landwirtschaftlich geprägten Süden.“"
                                            },
                                            {
                                                "example_id": "5f5ba438-bbd4-45f2-a6bd-3b65e08cf604",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "„Wenn der Analytiker sich seiner gewöhnlichen Hilfsquellen beraubt sieht, denkt er sich in den Geist seines Gegners hinein, identifiziert sich mit ihm, und dann gelingt es ihm nicht selten, auf den ersten Blick eine oft verblüffend einfache Methode zu finden, durch die er den andern irreführen oder zu einem unbesonnenen Zug veranlassen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4675e32-cf48-4b69-8117-580e53181445",
                        "source_entry_id": "b03b2a7d-e4b4-3ca7-9a1e-6c1cd9401e66",
                        "source_sense_id": "6364f5de-f38f-3a1f-a83a-bfcca408a597",
                        "source_sense_description": "iemand die tegenwerkt",
                        "target_lang_word": "opponent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opponent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75db4a88-0a1a-3e42-9425-3b3b005ecd58",
                                        "entry_id": "5e0c1e01-2fc3-3167-a1fb-03a0750a745d",
                                        "glosses": [
                                            "One who opposes another; one who works or takes a position against someone or something; one who attempts to stop the progress of someone or something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d09d9fc7-4647-4928-ad72-a94c8022e2de",
                                                "sense_id": "75db4a88-0a1a-3e42-9425-3b3b005ecd58",
                                                "text": "The person who ran against her in the last election proved to be a formidable opponent."
                                            },
                                            {
                                                "example_id": "3e88ae5e-a54a-4f9b-84c4-fe7dfd0cbf8e",
                                                "sense_id": "75db4a88-0a1a-3e42-9425-3b3b005ecd58",
                                                "text": "During the crackdown, many opponents of the regime were arrested."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ed6d2c0-3dcd-3e72-825f-9393027f85d7",
                                        "entry_id": "5e0c1e01-2fc3-3167-a1fb-03a0750a745d",
                                        "glosses": [
                                            "One who opposes another; one who works or takes a position against someone or something; one who attempts to stop the progress of someone or something.",
                                            "One who opposes another physically (in a fight, sport, game, or competition)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d283b84-20d4-4fe8-956f-988e7fab9a7f",
                                                "sense_id": "7ed6d2c0-3dcd-3e72-825f-9393027f85d7",
                                                "text": "1720, Alexander Pope, The Iliad of Homer, London: Bernard Lintott, Volume 6, “Observations on the Twenty-Third Book,” no. 39, p. 136,\nIn the Chariot-Race Achilles is represented as being able to conquer every Opponent […]"
                                            },
                                            {
                                                "example_id": "ae3e68c8-5129-4dcf-9308-07301de98fe3",
                                                "sense_id": "7ed6d2c0-3dcd-3e72-825f-9393027f85d7",
                                                "text": "[…] he slid his right hand down to his left, and with the full swing of the weapon struck his opponent on the left side of the head, who instantly measured his length upon the green sward."
                                            },
                                            {
                                                "example_id": "d2533182-cd04-4856-899d-665f0ec002fb",
                                                "sense_id": "7ed6d2c0-3dcd-3e72-825f-9393027f85d7",
                                                "text": "[…] it is possible for a good [draughts] player to defeat an opponent without capturing his pieces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "768343d6-26ff-3a86-8065-dd8e76c628e5",
                                        "entry_id": "5e0c1e01-2fc3-3167-a1fb-03a0750a745d",
                                        "glosses": [
                                            "One who opposes another; one who works or takes a position against someone or something; one who attempts to stop the progress of someone or something.",
                                            "One who opposes another in words (in a dispute, argument or controversy)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c185dfba-54a4-48af-9942-593eb9df0899",
                                                "sense_id": "768343d6-26ff-3a86-8065-dd8e76c628e5",
                                                "text": "It is easier to confound than to convince an opponent; the former may be effected by a turn that has more happiness than truth in it."
                                            },
                                            {
                                                "example_id": "6263a1ca-d83f-4933-8c42-ac2227284e47",
                                                "sense_id": "768343d6-26ff-3a86-8065-dd8e76c628e5",
                                                "text": "“What more have you to say?” she asked, rather in the tone in which a person might address an opponent of adult age than such as is ordinarily used to a child."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bb1ac9e-9c0a-3bab-b034-30971e4c493a",
                                        "entry_id": "5e0c1e01-2fc3-3167-a1fb-03a0750a745d",
                                        "glosses": [
                                            "One who opposes another; one who works or takes a position against someone or something; one who attempts to stop the progress of someone or something.",
                                            "One who is opposed or objects (to a policy, course of action or set of ideas)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97343ac8-4e8f-48b1-8a34-48b8d862b7c5",
                                                "sense_id": "0bb1ac9e-9c0a-3bab-b034-30971e4c493a",
                                                "text": "She was a dedicated opponent of the death penalty."
                                            },
                                            {
                                                "example_id": "36d95131-df5c-473d-81a8-55f098608f83",
                                                "sense_id": "0bb1ac9e-9c0a-3bab-b034-30971e4c493a",
                                                "text": "Their Oath is to maintain the Romish-Catholick Religion, and persecute all Opponents to it."
                                            },
                                            {
                                                "example_id": "69e005b2-39ff-449e-b103-9f9f3fdb69a9",
                                                "sense_id": "0bb1ac9e-9c0a-3bab-b034-30971e4c493a",
                                                "text": "My own friends had been among the bitterest opponents of any proposal to visit the Captain and his daughters, only twelve months before; and now he was even admitted in the tabooed hours before twelve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f6c517f-cc47-3f66-91e0-23a4ea67ea03",
                                        "entry_id": "5e0c1e01-2fc3-3167-a1fb-03a0750a745d",
                                        "glosses": [
                                            "One who opposes another; one who works or takes a position against someone or something; one who attempts to stop the progress of someone or something.",
                                            "The participant who opens an academic debate by putting forward objections to a theological or philosophical thesis."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62b237d3-5aff-4d56-b27a-3fae678176de",
                                                "sense_id": "9f6c517f-cc47-3f66-91e0-23a4ea67ea03",
                                                "text": "We make the argument appere slender, when we receiue it laughyngly, and declare by wordes, euen at the first, that it is nothyng to the purpose, and so abashe the opponent."
                                            },
                                            {
                                                "example_id": "f6ea1cad-afd8-4398-90a5-a2bc146e48c4",
                                                "sense_id": "9f6c517f-cc47-3f66-91e0-23a4ea67ea03",
                                                "text": "[…] diuinitie disputations, in all which those learned opponents, respondents, & moderators, quited themselues like themselues, sharplie and soundlie, besides all other solemne sermons & lectures."
                                            },
                                            {
                                                "example_id": "ca03ef77-903b-4097-ba53-ea6b40ff31c4",
                                                "sense_id": "9f6c517f-cc47-3f66-91e0-23a4ea67ea03",
                                                "text": "[…] by the many Disputes that rise from hence, Mens Wits were confounded with their matters, Truth was lost & Brotherhood destroyed: thus the Devil acted the Part both of Opponent and Defendant, and managed the Passions of both Parties to his End, which was DISCORD."
                                            },
                                            {
                                                "example_id": "80451af2-27d3-46d3-a14e-9270f7a8cfb4",
                                                "sense_id": "9f6c517f-cc47-3f66-91e0-23a4ea67ea03",
                                                "text": "[…] this untoward Method allows him who is the Respondent, to prevaricate from his Duty, and turn Opponent: Which confounds those two Offices, and perverts all the Laws of Reasoning or Discoursing."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "opponent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5baa705-0ae3-3c30-86de-48dbcdbe860f",
                                        "entry_id": "cea85cc1-72f2-370c-bdb3-c58e6753a836",
                                        "glosses": [
                                            "Opposing; adverse; antagonistic."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5d1ae4e-abf3-4d7a-884e-5816ef157822",
                                                "sense_id": "c5baa705-0ae3-3c30-86de-48dbcdbe860f",
                                                "text": "[…] we are to consider enemies as men opponent to peace and justice, and to these they are by warrs to be reduced; And no other ends in the pursuite of enemies by sword and hostile Acts are to be sought for […]"
                                            },
                                            {
                                                "example_id": "ab8d5367-c813-4f2b-8572-c53248d5ed19",
                                                "sense_id": "c5baa705-0ae3-3c30-86de-48dbcdbe860f",
                                                "text": "Young Ithacus advanc’d, defies the foe,\nPoising his lifted lance in act to throw:\nThe savage renders vain the wound decreed,\nAnd springs impetuous with opponent speed!"
                                            },
                                            {
                                                "example_id": "28ece360-8a1e-466d-a156-4a9fd97832f6",
                                                "sense_id": "c5baa705-0ae3-3c30-86de-48dbcdbe860f",
                                                "text": "The reasons you have urged are indeed weighty: yet they have never made an impression so deep upon my mind, as not to take flight, and leave their opponent arguments in some sort the victors."
                                            },
                                            {
                                                "example_id": "4951dc8c-bf8a-4e64-837a-44c1bad45c35",
                                                "sense_id": "c5baa705-0ae3-3c30-86de-48dbcdbe860f",
                                                "text": "Let it not be supposed, that by “catholic,” I mean to designate men who are lax in their principles, and alike indifferent to all religious systems. On the contrary, they are more earnestly attached to truth, and more opponent to sin than others […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df13e201-67b3-3acf-8c45-dd02f6e41740",
                                        "entry_id": "cea85cc1-72f2-370c-bdb3-c58e6753a836",
                                        "glosses": [
                                            "Situated in front; opposite."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8643bee-c6c6-4721-baf1-7f4e9dcfbd50",
                                                "sense_id": "df13e201-67b3-3acf-8c45-dd02f6e41740",
                                                "text": "Her sympathizing Lover takes his Stand\nHigh on th’ opponent Bank […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e7516eb-8dd9-49ce-985f-8188e529f47a",
                        "source_entry_id": "b03b2a7d-e4b4-3ca7-9a1e-6c1cd9401e66",
                        "source_sense_id": "6364f5de-f38f-3a1f-a83a-bfcca408a597",
                        "source_sense_description": "iemand die tegenwerkt",
                        "target_lang_word": "adversary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adversary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "144bec8f-96e7-36d7-9363-2eb71c3ce2a1",
                                        "entry_id": "e2de6575-5579-3f0d-a864-cb51f1f8c98e",
                                        "glosses": [
                                            "An opponent or rival."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bafa1bbf-c2f7-4657-939c-f44cfc6901ce",
                                                "sense_id": "144bec8f-96e7-36d7-9363-2eb71c3ce2a1",
                                                "text": "He prepared to fight his adversary."
                                            },
                                            {
                                                "example_id": "3f54a002-82d9-4243-a925-6ab67a3bffda",
                                                "sense_id": "144bec8f-96e7-36d7-9363-2eb71c3ce2a1",
                                                "text": "In the political drama that Donald Trump has created in Washington, he could not have dreamed up a more formidable adversary than James Comey."
                                            },
                                            {
                                                "example_id": "85eb58a1-9f0d-43ce-bd83-086fa658f975",
                                                "sense_id": "144bec8f-96e7-36d7-9363-2eb71c3ce2a1",
                                                "text": "The real bombshell it contains is not the confidence of the spy agencies that Russia hoped to subvert American democracy. It is that US intelligence experts effectively confirmed that for the second election in a row, Trump acolytes repeatedly used, knowingly or otherwise, misinformation produced by the spies of one of America’s most sworn foreign adversaries to try to win a US election."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ff86ae9-8a5d-40c0-84d2-e84e406bf407",
                        "source_entry_id": "b03b2a7d-e4b4-3ca7-9a1e-6c1cd9401e66",
                        "source_sense_id": "6364f5de-f38f-3a1f-a83a-bfcca408a597",
                        "source_sense_description": "iemand die tegenwerkt",
                        "target_lang_word": "adversaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adversaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "116cd86a-d819-3a05-a07a-3f90940a3115",
                                        "entry_id": "612aa2fd-8d47-3b4e-95a2-c8b49148e4a0",
                                        "glosses": [
                                            "Personne qui est opposée à une autre, dans une compétition, un conflit, une lutte, un procès..."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c179003-bf1d-4190-97a6-9d681b3ab34d",
                                                "sense_id": "116cd86a-d819-3a05-a07a-3f90940a3115",
                                                "text": "Vuillet était la bête noire d’Aristide. Il ne se passait pas de semaine sans que les deux journalistes échangeassent les plus grossières injures. En province, où l’on cultive encore la périphrase, la polémique met le catéchisme poissard en beau langage : Aristide appelait son adversaire « frère Judas », ou encore « serviteur de saint Antoine », et Vuillet répondait galamment en traitant le républicain de « monstre gorgé de sang dont la guillotine était l’ignoble pourvoyeuse. »"
                                            },
                                            {
                                                "example_id": "25e9c973-ccbc-462b-825f-d55d850f877c",
                                                "sense_id": "116cd86a-d819-3a05-a07a-3f90940a3115",
                                                "text": "Ce principe de la philosophie cartésienne, je pense, donc je suis, est ce que les adversaires du cartésianisme ont attaqué avec le plus de persévérance; et cela se conçoit, car ce principe admis, l’autorité de la conscience et de la raison s’ensuit nécessairement."
                                            },
                                            {
                                                "example_id": "34ce0706-e0e8-4996-816a-a74fe0e92b55",
                                                "sense_id": "116cd86a-d819-3a05-a07a-3f90940a3115",
                                                "text": "Une coalition se forme dans l’ombre et l’on dirige contre moi, un tir de barrage. Me voilà propre avec cette cohorte d’adversaires sur le reins."
                                            },
                                            {
                                                "example_id": "1c97a3e2-6e89-4f41-a08f-ecc383682cf7",
                                                "sense_id": "116cd86a-d819-3a05-a07a-3f90940a3115",
                                                "text": "Silence, voyons, dit le maire. Chacun doit écouter avec courtoisie l’adversaire, même s’il est de mauvaise foi, même s’il manque de civilité ! Exprimons-nous poliment. Rétorquons de même, sans nous départir de sang-froid."
                                            },
                                            {
                                                "example_id": "cc0c50a3-1df7-4d18-b345-75c7303ddf34",
                                                "sense_id": "116cd86a-d819-3a05-a07a-3f90940a3115",
                                                "text": "Nietzsche s'est dressé face au siècle. Et l’adversaire qu'il s'est choisi, c'est l’esprit de lourdeur, notre poids naturel, notre faculté naturelle de retombement dans la coutume."
                                            },
                                            {
                                                "example_id": "58992ad7-d94f-4d48-9f02-93363dee528e",
                                                "sense_id": "116cd86a-d819-3a05-a07a-3f90940a3115",
                                                "text": "Tenez vos engagements. Cela découragera totalement vos adversaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "510df991-79f3-46c1-86d9-068b6bd32b36",
                        "source_entry_id": "b03b2a7d-e4b4-3ca7-9a1e-6c1cd9401e66",
                        "source_sense_id": "6364f5de-f38f-3a1f-a83a-bfcca408a597",
                        "source_sense_description": "iemand die tegenwerkt",
                        "target_lang_word": "concurrent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concurrent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e29dabbd-a174-39b6-a075-67104132a057",
                                        "entry_id": "22a76ccf-fda1-329b-91b2-429ad7dda54f",
                                        "glosses": [
                                            "Qui se rencontre avec."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79a4b38a-1bcd-4f70-858b-dca07d8b5348",
                                                "sense_id": "e29dabbd-a174-39b6-a075-67104132a057",
                                                "text": "Forces concurrentes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74f53119-1512-3502-9763-410033250d8d",
                                        "entry_id": "22a76ccf-fda1-329b-91b2-429ad7dda54f",
                                        "glosses": [
                                            "Qui est en compétition pour une même ressource ou un même but."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e4e9b94-8fa7-48c7-8791-547bd42b03ab",
                                                "sense_id": "74f53119-1512-3502-9763-410033250d8d",
                                                "text": "Notons que le terme association a été très mal choisi. Il n’implique pas que les plantes se prêtent une aide quelconque. En général, elles sont concurrentes."
                                            },
                                            {
                                                "example_id": "e916b6ab-b95e-40d1-9c0b-7d23b63b3a2d",
                                                "sense_id": "74f53119-1512-3502-9763-410033250d8d",
                                                "text": "Ainsi, dans ces deux verbes, la forme populaire dépareiller et la forme savante désappareiller demeurent concurrentes. L'Académie autorise indistinctement l'emploi de l'une ou de l'autre forme, tout en reconnaissant que la forme populaire est la plus usitée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc2de6c2-dde3-3032-8165-0317e82161a0",
                                        "entry_id": "22a76ccf-fda1-329b-91b2-429ad7dda54f",
                                        "glosses": [
                                            "Qui produit et vend la même chose sur le même marché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78b07f38-dd60-42fb-92d1-4cae0ebb1595",
                                                "sense_id": "cc2de6c2-dde3-3032-8165-0317e82161a0",
                                                "text": "Il sourit en apprenant que nous venons de Roanne. Roanne est justement la ville concurrente de Thann pour les tissages et les impressions d’étoffe. Roanne a fait baisser ici les salaires ; mais il ne nous en veut pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c395facc-857e-3c28-85ae-998170c3d7f3",
                                        "entry_id": "22a76ccf-fda1-329b-91b2-429ad7dda54f",
                                        "glosses": [
                                            "Qualifie l’un des jours qu’on ajoute aux 52 semaines de l’année pour faire concorder l’année civile et l’année solaire, sachant qu’une année commune comprend 52 semaines et 1 jour et les années bissextiles, 52 semaines et 2 jours."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "concurrent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eea8075b-284b-38a4-bd39-ff1807fa1a44",
                                        "entry_id": "0d0e2445-d94d-3be0-aeab-27d2e8e73977",
                                        "glosses": [
                                            "Celui qui poursuit une même chose, et en même temps qu’un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eb2b070-e5d0-49f0-88c8-8a8b0f456326",
                                                "sense_id": "eea8075b-284b-38a4-bd39-ff1807fa1a44",
                                                "text": "Nos pères étaient donc plus sages que nous lorsqu’ils repoussaient l’idée des courses. En 1820 il se présentait seulement sur nos hippodromes 120 concurrents se disputant 60 prix."
                                            },
                                            {
                                                "example_id": "e6387e14-55b7-4a2f-b3f7-34af24514eba",
                                                "sense_id": "eea8075b-284b-38a4-bd39-ff1807fa1a44",
                                                "text": "Les Chasseurs n’étaient peut-être pas non plus étrangers à cette manigance. Parbleu, en se débarrassant d’un concurrent, ils profitaient de son gibier."
                                            },
                                            {
                                                "example_id": "20000df2-be72-4ac3-be6f-55a7635a4374",
                                                "sense_id": "eea8075b-284b-38a4-bd39-ff1807fa1a44",
                                                "text": "— […] ; le régime du taillis sous futaie pratiqué en vue de la production de l’écorce et du tan — […] — a favorisé le Chêne qui, « rejetant » abondamment de souche, a peu à peu éliminé ses concurrents."
                                            }
                                        ]
                                    }
                                ]
