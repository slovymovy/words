{
    "word_family": [
        "quiet",
        "quietly",
        "quietness",
        "quietude"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "33767861-b628-3dec-a85e-607543ecc7af",
                    "sense_definition": "A state of mental or physical unease or lack of tranquility.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anxiety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was filled with <w>disquiet</w> at the thought of her long journey alone.",
                            "target_lang_translations": {
                                "cs": "Při pomyšlení na svou dlouhou cestu o samotě ji naplnil <w>neklid</w>.",
                                "de": "Bei dem Gedanken an ihre lange Reise allein erfüllte sie <w>Unruhe</w>."
                            }
                        },
                        {
                            "text": "The sudden news caused great <w>disquiet</w> among the local residents.",
                            "target_lang_translations": {
                                "cs": "Náhlá zpráva vyvolala mezi místními obyvateli velké <w>znepokojení</w>.",
                                "de": "Die plötzliche Nachricht löste unter den Anwohnern große <w>Beunruhigung</w> aus."
                            }
                        }
                    ],
                    "synonyms": [
                        "anxiety",
                        "disturbance",
                        "restlessness",
                        "uneasiness"
                    ],
                    "common_phrases": [
                        "sense of disquiet",
                        "growing disquiet"
                    ],
                    "target_lang_definitions": {
                        "cs": "Stav duševního nebo fyzického neklidu či nedostatek vnitřního klidu.",
                        "de": "Ein Zustand seelischer oder körperlicher Unruhe, Besorgnis oder mangelnder innerer Gelassenheit."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "neklid",
                                "target_lang_sense_clarification": "obecný pocit napětí nebo úzkosti"
                            },
                            {
                                "target_lang_word": "znepokojení",
                                "target_lang_sense_clarification": "pocit obavy z určité situace"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Unruhe",
                                "target_lang_sense_clarification": "innere Anspannung oder Nervosität"
                            },
                            {
                                "target_lang_word": "Beunruhigung",
                                "target_lang_sense_clarification": "Gefühl der Sorge oder Besorgnis"
                            },
                            {
                                "target_lang_word": "Besorgnis",
                                "target_lang_sense_clarification": "quälendes Gefühl wegen unangenehmer Erwartungen"
                            },
                            {
                                "target_lang_word": "Unbehagen",
                                "target_lang_sense_clarification": "Gefühl des Unwohlseins oder Missbehagens"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "52900d29-cd4b-32da-91cf-5229cfd6ab31",
                    "sense_definition": "To make someone feel worried, anxious, or uneasy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anxiety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strange noises in the attic <w>disquieted</w> the entire family.",
                            "target_lang_translations": {
                                "cs": "Podivné zvuky na půdě celou rodinu <w>znepokojily</w>.",
                                "de": "Die merkwürdigen Geräusche auf dem Dachboden <w>beunruhigten</w> die gesamte Familie."
                            }
                        },
                        {
                            "text": "His cold behavior continued to <w>disquiet</w> her throughout the evening.",
                            "target_lang_translations": {
                                "cs": "Jeho chladné chování ji po celý večer nadále <w>znepokojovalo</w>.",
                                "de": "Sein kaltes Verhalten fuhr fort, sie den ganzen Abend über zu <w>beunruhigen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "unsettle"
                    ],
                    "common_phrases": [
                        "disquiet the mind"
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit, že se někdo cítí znepokojený, úzkostný nebo nesvůj.",
                        "de": "Jemanden in Sorge, Angst oder innere Unruhe versetzen."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "znepokojovat",
                                "target_lang_sense_clarification": "vyvolávat v někom obavy"
                            },
                            {
                                "target_lang_word": "vyvádět z míry",
                                "target_lang_sense_clarification": "narušovat něčí klid"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "beunruhigen",
                                "target_lang_sense_clarification": "in Unruhe oder Sorge versetzen"
                            },
                            {
                                "target_lang_word": "verunsichern",
                                "target_lang_sense_clarification": "die Gewissheit oder das Vertrauen nehmen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "25acb25f-cb46-305d-bc40-8776aaca3ba1",
                    "sense_definition": "Feeling or showing a lack of peace, rest, or calm.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anxiety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt <w>disquiet</w> after hearing the unsettling news from home.",
                            "target_lang_translations": {
                                "cs": "Poté, co uslyšel znepokojivé zprávy z domova, se cítil <w>nesvůj</w>.",
                                "de": "Er fühlte sich <w>unruhig</w>, nachdem er die beunruhigenden Neuigkeiten von zu Hause gehört hatte."
                            }
                        },
                        {
                            "text": "The <w>disquiet</w> atmosphere in the room made everyone feel tense.",
                            "target_lang_translations": {
                                "cs": "Kvůli <w>neklidné</w> atmosféře v místnosti se všichni cítili napjatě.",
                                "de": "Die <w>unruhige</w> Atmosphäre im Raum ließ alle angespannt sein."
                            }
                        }
                    ],
                    "synonyms": [
                        "restlessness",
                        "uneasiness"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pocit nebo projev nedostatku klidu, míru či vyrovnanosti.",
                        "de": "Einen Mangel an Ruhe, Frieden oder Gelassenheit verspürend oder zeigend (gehoben/veraltet)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "neklidný",
                                "target_lang_sense_clarification": "stav mysli nebo atmosféry"
                            },
                            {
                                "target_lang_word": "nesvůj",
                                "target_lang_sense_clarification": "pocit vnitřní nepohody"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "unruhig",
                                "target_lang_sense_clarification": "nicht zur Ruhe kommend; rastlos"
                            },
                            {
                                "target_lang_word": "besorgt",
                                "target_lang_sense_clarification": "voller Sorge oder Unbehagen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}