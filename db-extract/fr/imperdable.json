                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2031c92d-8931-3f47-bcd5-b3d8faf73343",
                        "entry_id": "90bcb962-7cb0-3796-9da1-f9d97b2eedd6",
                        "glosses": [
                            "Qu’on ne peut perdre, dont le gain est sûr."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95eb93c2-7d0e-4729-b713-5b389ce52c7f",
                                "sense_id": "2031c92d-8931-3f47-bcd5-b3d8faf73343",
                                "text": "Un procès, une cause, une partie imperdable."
                            },
                            {
                                "example_id": "060f8765-cd25-4813-b2b5-28b7b172b145",
                                "sense_id": "2031c92d-8931-3f47-bcd5-b3d8faf73343",
                                "text": "Une bataille imperdable."
                            },
                            {
                                "example_id": "8f6184c7-3d92-4152-b9e4-5defd8986a0a",
                                "sense_id": "2031c92d-8931-3f47-bcd5-b3d8faf73343",
                                "text": "« Faut-il qu’elle soit détestée, cette droite, pour avoir réussi à perdre des élections réputées imperdables pour elle », s’exclame-t-elle."
                            },
                            {
                                "example_id": "c9254594-36d5-428e-b077-67a2562749be",
                                "sense_id": "2031c92d-8931-3f47-bcd5-b3d8faf73343",
                                "text": "Une vis imperdable."
                            }
                        ]
                    }
                ],
