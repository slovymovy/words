                        "entry_id": "88d86fb7-2c70-3b23-a76c-1a86bc17c2a6",
                        "glosses": [
                            "прост. широко раскрыть, выпучить; вытаращить (глаза)"
                        ],
                        "tags": [
                            "что."
                        ],
                        "examples": [
                            {
                                "example_id": "d3e2439c-ffda-4dd5-9760-6c99046709ab",
                                "sense_id": "59d83fa9-d338-3387-96dd-9bd54722cc03",
                                "text": "Фёдор Константинович сидит ― вылупил глаза."
                            },
                            {
                                "example_id": "0387e388-f477-418b-a108-7fab5b2ea752",
                                "sense_id": "59d83fa9-d338-3387-96dd-9bd54722cc03",
                                "text": "Санька пальто скинул, партнер на рубаху бельма вылупил."
                            }
                        ]
                    },
                    {
                        "sense_id": "b34b8966-fc1d-37e4-a18a-f737f6a4e0fa",
                        "entry_id": "88d86fb7-2c70-3b23-a76c-1a86bc17c2a6",
                        "glosses": [
                            "прост. очистив от кожуры, от скорлупы, вынуть"
                        ],
                        "tags": [
                            "что."
                        ],
                        "examples": [
                            {
                                "example_id": "1ad6dc1a-a32f-443f-aec4-6a11a0058a25",
                                "sense_id": "b34b8966-fc1d-37e4-a18a-f737f6a4e0fa",
                                "text": "Если цыплята вылупиться не могут, то надобно их вылупить."
                            }
                        ]
