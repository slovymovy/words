                "senses": [
                    {
                        "sense_id": "476e1f25-20f8-37b2-9e77-a3db0c136c69",
                        "entry_id": "ae303b77-502a-343c-bf0b-6e6d904e1c8c",
                        "glosses": [
                            "Existence permanente d’un grand nombre de pauvres dans un pays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59794fd2-6590-48f4-850e-4b13e2d3d6a3",
                                "sense_id": "476e1f25-20f8-37b2-9e77-a3db0c136c69",
                                "text": "[…] ils rechercheront les causes de la multiplication des crimes, de l’extension toujours croissante du paupérisme […]"
                            },
                            {
                                "example_id": "741e9cdd-cd99-43fb-a4c2-790cbf4886b8",
                                "sense_id": "476e1f25-20f8-37b2-9e77-a3db0c136c69",
                                "text": "Cette seconde conséquence du progrès est l’apparition d’un nombre important d’individus qui n’ont ni propriété ni fonction évidente dans l’organisme social. Ce nouvel élément est plus apparent dans les villes ; on en parle fréquemment sous le nom de paupérisme, et on le trouve également sous ses traits caractéristiques dans les districts ruraux."
                            },
                            {
                                "example_id": "400152a9-8426-45c0-ba51-1e635861de9e",
                                "sense_id": "476e1f25-20f8-37b2-9e77-a3db0c136c69",
                                "text": "Tu remarqueras qu’il s’intéressait déjà au problème du paupérisme, ainsi que n’importe quel millionnaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcb2605a-a7bd-490e-a73a-5b2ef1a67300",
                        "source_entry_id": "ae303b77-502a-343c-bf0b-6e6d904e1c8c",
                        "source_sense_id": "476e1f25-20f8-37b2-9e77-a3db0c136c69",
                        "target_lang_word": "Pauperismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pauperismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2c2082e-96ea-3cf6-8f12-59fb275c8326",
                                        "entry_id": "565f8322-2d5a-32ce-aa93-7de711ca0200",
                                        "glosses": [
                                            "die massenhafte Verarmung in der ersten Hälfte des 19. Jahrhunderts (vor allem in den 1830er- und 1840er-Jahren) in Deutschland, die sich aus der Schere zwischen wachsender Bevölkerung und stagnierender Wirtschaft ergab"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc01d7a2-f7ff-4671-b3d1-4c64fe1db2e3",
                                                "sense_id": "a2c2082e-96ea-3cf6-8f12-59fb275c8326",
                                                "text": "„Das schnelle Ende des krisenhaften Pauperismus nach 1850 ist gerade auf die Industrialisierung und die von ihr geschaffenen neuen Arbeitsplätze zurückzuführen.“"
                                            },
                                            {
                                                "example_id": "a4f1fc0b-b702-4a97-85fa-95902e480a6d",
                                                "sense_id": "a2c2082e-96ea-3cf6-8f12-59fb275c8326",
                                                "text": "„Erst jetzt gab es in der antiken Welt Pauperismus in großem Ausmaße: Besitzlose, die als Bettler das Land durchstreiften.“"
                                            },
                                            {
                                                "example_id": "d571ddc9-cc6d-46bf-adde-d052dfbcf6d9",
                                                "sense_id": "a2c2082e-96ea-3cf6-8f12-59fb275c8326",
                                                "text": "„Dabei nahmen sie den Pauperismus in Kauf – die langfristige Armut großer Teile der Bevölkerung, vor allem der wie Sklaven behandelten Leibeigenen –, aber das war ja für sie persönlich kein Problem.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68fd7583-ff14-48b4-8255-89bcf293fc80",
                        "source_entry_id": "ae303b77-502a-343c-bf0b-6e6d904e1c8c",
