        "nl-extract.jsonl": [
            {
                "entry_id": "98b0b2e6-e3bb-3784-9b66-91d3ec26fb54",
                "word": "verlangzamen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5aa91a0d-75d1-3f44-9915-a0e72299a81d",
                        "entry_id": "98b0b2e6-e3bb-3784-9b66-91d3ec26fb54",
                        "glosses": [
                            "trager worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7db6af84-424e-4597-8bf1-3d546a356a9b",
                                "sense_id": "5aa91a0d-75d1-3f44-9915-a0e72299a81d",
                                "text": "Verlangzamen is het toverwoord, zegt Esther. Je kunt ontvelde hazelnoten kopen, maar je kunt ze ook zelf ontvellen. Eerst noten roosteren in een droge pan en dan in een theedoek de vliesjes eraf wrijven. Dat vinden de kinderen leuk om te doen. Net als het malen van de noten in een notenmolen of het fijnmaken van de pasta in een vijzel."
                            },
                            {
                                "example_id": "ebd2d4cd-2a2c-48cb-8b33-73895e0942f7",
                                "sense_id": "5aa91a0d-75d1-3f44-9915-a0e72299a81d",
                                "text": "Na een drukke werkweek de natuur ingaan: beter kan het niet. Voor Lisette Baars (25) en Marleen de Graaff (27) is wandelen verlangzamen. Weg van de computer en de stress achter je laten."
                            }
                        ]
                    }
                ],
