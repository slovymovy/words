                    }
                ],
                "senses": [
                    {
                        "sense_id": "87d30384-b4d2-3573-b39c-9173184bf61f",
                        "entry_id": "8d5e53e2-a19e-38e0-831f-40129d63b506",
                        "glosses": [
                            "Donner un caractère apologétique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2dd9c9b-f33e-4522-b707-bfb40763f51c",
                                "sense_id": "87d30384-b4d2-3573-b39c-9173184bf61f",
                                "text": "Que les structures et superstructures, lois et rapports sociaux soient acceptés ou refusés, que l’idéologie dominante soit par l’observateur superficiel apologétisée ou réfutée n'y change rien."
                            },
                            {
                                "example_id": "35441342-c4ef-4ee9-9f65-bcaae3ea6df9",
                                "sense_id": "87d30384-b4d2-3573-b39c-9173184bf61f",
                                "text": "Où donc nous a-t-on si bien entraînés à polémiquer, apologétiser, argumenter, et toujours triompher, par devoir sacré, au nom de l’orthodoxie, mais sans cesser de tourner en rond dans l’arsenal de nos concepts et de nos shèmes, nos catégories intellectuelles d’occidentaux, sans nous demander ce que tout ce déballage peut bien signifier pour l’interlocuteur abasourdi de notre assurance, qui, devant ce dialogue de sourd, en bon Oriental, sera le premier à recourir au silence."
                            },
                            {
                                "example_id": "eadcd55a-368c-4947-95e5-bffaf79100b9",
                                "sense_id": "87d30384-b4d2-3573-b39c-9173184bf61f",
                                "text": "Il faut sans cesse ratiociner, justifier des innovations tardives, apologétiser à tout vent."
                            },
                            {
                                "example_id": "5df6d93c-ca76-4f66-8615-78cc671743fc",
                                "sense_id": "87d30384-b4d2-3573-b39c-9173184bf61f",
                                "text": "Il y a dans la passion humaine une tendance incoercible à vouloir « s'apologétiser »."
                            }
                        ]
                    }
                ],
