                        "sense_id": "9a5623d9-9e93-3be3-9daa-c56d2b93417d",
                        "entry_id": "8f6ab7e8-f85d-3ddc-a7a1-1f399231f7ab",
                        "glosses": [
                            "To relieve from boredom."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9bfc2aea-f40d-4793-a874-b2bda87c8ec1",
                                "sense_id": "9a5623d9-9e93-3be3-9daa-c56d2b93417d",
                                "text": "Let you tell her from me and from us, that there is a chapter in Deirdre that unbores God when He gets bored, & remembers who He ought to read."
                            },
                            {
                                "example_id": "4c4e9cc7-a48c-4dea-b3aa-5d24f881e0b2",
                                "sense_id": "9a5623d9-9e93-3be3-9daa-c56d2b93417d",
                                "text": "Rose felt right down at her very roots that if you have once thoroughly bored somebody it is next to impossible to unbore him. Once a bore always a bore — certainly, she thought, to the person originally bored."
                            }
                        ]
                    }
                ],
