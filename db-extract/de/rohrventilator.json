                "senses": [
                    {
                        "sense_id": "1b7726e4-d82b-3bb6-a124-2d206cbbf9ab",
                        "entry_id": "d5114310-4932-3624-8a15-05584b71e496",
                        "glosses": [
                            "Gerät, welches umgebende Luft durch Drehung eines Laufrades mit Schaufeln in einem Lüftungsrohr fördert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "745a6fc5-62d3-4b55-b140-b1422a003c18",
                                "sense_id": "1b7726e4-d82b-3bb6-a124-2d206cbbf9ab",
                                "text": "„Die Rohrventilatoren werden in das Rohr eingesetzt und dann in Betrieb genommen.“"
                            },
                            {
                                "example_id": "239a5160-50c5-4fb1-8040-c1e2b3c3310b",
                                "sense_id": "1b7726e4-d82b-3bb6-a124-2d206cbbf9ab",
                                "text": "„Ein Rohrventilator wird vor allem dort eingesetzt, wo sich die Fenster und Wände eines Raumes nicht zum Anbringen von Ventilatoren eignen.“"
                            },
                            {
                                "example_id": "20849ca4-3f88-484a-8918-45ecee9f00cc",
                                "sense_id": "1b7726e4-d82b-3bb6-a124-2d206cbbf9ab",
                                "text": "„Die AcousticLine Rohrventilatoren garantieren niedrigste Geräuschwerte für Saugseite und Gehäuseabstrahlung.“"
                            },
                            {
                                "example_id": "edcbeee9-b69e-4173-9b53-83b02d34b204",
                                "sense_id": "1b7726e4-d82b-3bb6-a124-2d206cbbf9ab",
                                "text": "„Der Rohrventilator hat eine halbradiale Bauart und ist aerodynamisch und akustisch optimiert worden.“"
                            },
                            {
                                "example_id": "3e3b0c7b-033a-4838-beb6-3ea1858b7611",
                                "sense_id": "1b7726e4-d82b-3bb6-a124-2d206cbbf9ab",
                                "text": "„Denn bereits 1974 revolutionierte der schwedische Ventilatorenhersteller mit der Entwicklung des Rohrventilators die Lüftungswelt. Auch der neue Rohrventilator prioAir stellt eine Innovation auf dem Markt dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
