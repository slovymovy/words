                                                "example_id": "7943c8ad-4dc9-4252-b0d3-c2f4958a2453",
                                                "sense_id": "3585db9f-8eb7-30f4-a4d1-50c0c3bd405b",
                                                "text": "Cet emploi est dépendant du Ministère de la Guerre."
                                            },
