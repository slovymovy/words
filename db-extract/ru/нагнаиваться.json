                                        "entry_id": "6209125b-46ee-3864-ae65-f9a283b87da6",
                                        "glosses": [
                                            "To form or discharge pus."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ac0a750-4b68-45dc-a537-a6a5fffb4ff7",
                                                "sense_id": "b9a39ea4-4b71-3e69-84da-496d34ba538c",
                                                "text": "Their suppurating wounds, their goitres, their tumours are hideously evident on their hairless bodies."
                                            },
                                            {
                                                "example_id": "b81632e3-2b58-44d3-a0db-b18717dc6459",
                                                "sense_id": "b9a39ea4-4b71-3e69-84da-496d34ba538c",
                                                "text": "The only difference being Bezos was worth $60.7bn, while Bloodworth and his fellow “associates” walked back at midnight to fetid digs “with heavy legs supporting suppurating feet which over the course of the day had puffed up half a size bigger”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63967773-882a-391f-ad42-2ae266b9d4d6",
                                        "entry_id": "6209125b-46ee-3864-ae65-f9a283b87da6",
                                        "glosses": [
                                            "To cause to generate pus."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2b1cd35-24b7-4e30-84fe-cc64968076b3",
                                                "sense_id": "63967773-882a-391f-ad42-2ae266b9d4d6",
                                                "text": "to suppurate a sore"
                                            }
                                        ]
                                    }
                                ]
