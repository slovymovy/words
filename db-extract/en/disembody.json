                    {
                        "sense_id": "c539e6ff-3195-38d7-b1b8-8472968de671",
                        "entry_id": "fddea780-acad-35c6-af74-3fd2bb4f9ce0",
                        "glosses": [
                            "To cause someone's soul, spirit, consciousness, voice, etc, to become separated from the physical body."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3a1ebb37-d52c-3a9b-aba8-df2b2a85cfd2",
                        "entry_id": "fddea780-acad-35c6-af74-3fd2bb4f9ce0",
                        "glosses": [
                            "To separate (a part of the body) from the body."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f18d6ad-22b4-4d2e-8543-5e2893dd8f0c",
                                "sense_id": "3a1ebb37-d52c-3a9b-aba8-df2b2a85cfd2",
                                "text": "\"[he] wore the high, stiff collars which were the fashion of the day: in pictures these tend to disembody his head, making him look constrained, uncomfortable, yet they remained his choice.\""
                            },
                            {
                                "example_id": "12e86144-fbbd-4fc4-8c67-c9491f3d5a70",
                                "sense_id": "3a1ebb37-d52c-3a9b-aba8-df2b2a85cfd2",
                                "text": "Jerusha turned, a flush on her cheeks that wasn't makeup, a swath of steam from the vaporizer swirling around her chest, disembodying her head."
                            }
                        ]
                    },
                    {
                        "sense_id": "a107e24a-c00b-3911-a89d-e08b86cfbadc",
                        "entry_id": "fddea780-acad-35c6-af74-3fd2bb4f9ce0",
                        "glosses": [
                            "To discharge from military service or array."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b4ece2c-e184-410c-958e-3ba78d25a93a",
                        "source_entry_id": "fddea780-acad-35c6-af74-3fd2bb4f9ce0",
                        "source_sense_description": "to cause one's soul, spirit, or consciousness to become separated from the physical body",
                        "target_lang_word": "entkörperlichen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entkörperlichen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a13277a5-a569-3666-9898-51872f878fd1",
                                        "entry_id": "72ab5b03-f9eb-352e-9837-94b4f5cc64ad",
                                        "glosses": [
                                            "die räumliche/dreidimensionale Existenz in Form des Körpers wegnehmen; die Aspekte, die mit dem Körperlichen/real Existierenden zu tun haben, ausblenden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5bf78a5-35e0-4d1a-b7b2-26f025ac9c41",
                                                "sense_id": "a13277a5-a569-3666-9898-51872f878fd1",
                                                "text": "„Schon bei Worringer besteht das Wesentliche der abstrakten oder abstraktiven Funktion der gotischen Linie darin, Körper zu entkörperlichen und den Raum zu enträumlichen.“"
                                            },
                                            {
                                                "example_id": "d7dd4828-cecb-4388-9bc5-117fba1d5dac",
                                                "sense_id": "a13277a5-a569-3666-9898-51872f878fd1",
                                                "text": "„Im Diskurs zur Züchtigung zeigt sich diese Schattenseite der Aufklärung – mit Umberto Eco gesprochen, die »dunkle Seite der Vernunft«, die »die Kraft [besitzt], jedes Erkenntnisobjekt zu entkörperlichen, um es in Form eines Begriffs unter die eigene Herrschaft zu bringen«.“"
                                            },
                                            {
                                                "example_id": "71643091-69d4-40ba-9072-9cd130829fc0",
                                                "sense_id": "a13277a5-a569-3666-9898-51872f878fd1",
                                                "text": "„Ihre technische Beschränkung, in der immer noch häufigsten Praxis nämlich die Reduktion auf menschliche Stimme, erweist sich als medialer Selektionsvorteil: Telefone virtualisieren Personen. Sie entkörperlichen Menschen.“"
                                            },
                                            {
                                                "example_id": "0de21aa6-4c75-4d3c-9c90-d564cb1470f5",
                                                "sense_id": "a13277a5-a569-3666-9898-51872f878fd1",
                                                "text": "„Das heißt, die Zentrierung des Sozialisationsprozesses um die Etablierung und Reproduktion männlicher Identität bedingt, daß die Frau nicht im selben Maße »entkörperlicht« wurde wie der Mann.“"
                                            },
                                            {
                                                "example_id": "6562fe80-2944-47e8-971d-2facd782cf20",
                                                "sense_id": "a13277a5-a569-3666-9898-51872f878fd1",
                                                "text": "„Wie sehr die medieninduzierte gesellschaftliche Modernisierung den alltäglichen Tauschverkehr entindividualisiert und entkörperlicht hat, zeigt ein Vergleich zwischen traditionalen und modernen Markttypen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
