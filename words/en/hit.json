{
    "word_family": [
        "hitter",
        "hitting",
        "hitless"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "418e811b-4eb1-3899-b5ac-94c61b10ccf9",
                    "sense_definition": "To touch someone or something quickly and with force, often using the hand or a weapon.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physical_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "One boy <w>hit</w> the other on the arm during the game.",
                            "target_lang_translations": {
                                "ru": "Один мальчик <w>ударил</w> другого по руке во время игры.",
                                "zh": "比赛时，一个男孩<w>打</w>了另一个男孩的胳膊一下。"
                            }
                        },
                        {
                            "text": "He tried to <w>hit</w> me, but I moved out of the way just in time.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>ударить</w> меня, но я вовремя увернулся.",
                                "zh": "他想<w>打</w>我，但我及时躲开了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strike",
                        "punch",
                        "beat",
                        "whack",
                        "slap"
                    ],
                    "common_phrases": [
                        "hit hard",
                        "hit someone",
                        "hit a ball"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро и с силой прикоснуться к кому-либо или чему-либо, часто рукой или оружием.",
                        "zh": "迅速而有力地碰到某人或某物，常常用手或武器；打。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ударить",
                                "target_lang_sense_clarification": "совершить однократный удар"
                            },
                            {
                                "target_lang_word": "бить",
                                "target_lang_sense_clarification": "наносить удары (многократно)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打",
                                "target_lang_sense_clarification": "用手、拳头或武器打一下"
                            },
                            {
                                "target_lang_word": "击打",
                                "target_lang_sense_clarification": "较正式，指击打、打中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "295f044a-f5f7-3f82-97b8-88d7dbb54794",
                    "sense_definition": "To come into contact with something forcefully and suddenly; to collide with.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car lost control and <w>hit</w> a tree by the side of the road.",
                            "target_lang_translations": {
                                "ru": "Машина потеряла управление и <w>врезалась</w> в дерево на обочине.",
                                "zh": "汽车失控后<w>撞上</w>了路边的一棵树。"
                            }
                        },
                        {
                            "text": "The ball <w>hit</w> the fence and bounced back into the field.",
                            "target_lang_translations": {
                                "ru": "Мяч <w>ударился</w> о забор и отскочил обратно на поле.",
                                "zh": "球<w>撞到</w>围栏后弹回了场内。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crash into",
                        "collide with",
                        "strike"
                    ],
                    "antonyms": [
                        "miss"
                    ],
                    "common_phrases": [
                        "hit the ground",
                        "hit a wall",
                        "hit the brakes"
                    ],
                    "target_lang_definitions": {
                        "ru": "С силой и внезапно соприкоснуться с чем-либо; столкнуться.",
                        "zh": "突然并有力地与某物接触；撞上，碰撞。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "врезаться",
                                "target_lang_sense_clarification": "столкнуться на скорости"
                            },
                            {
                                "target_lang_word": "удариться",
                                "target_lang_sense_clarification": "стукнуться обо что-то"
                            },
                            {
                                "target_lang_word": "попасть",
                                "target_lang_sense_clarification": "угодить в цель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撞上",
                                "target_lang_sense_clarification": "车辆、人或物猛然碰上某物"
                            },
                            {
                                "target_lang_word": "撞到",
                                "target_lang_sense_clarification": "碰到并产生冲击"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "619ab147-becf-34eb-ab1c-b9d40290de38",
                    "sense_definition": "To press a button or key in order to activate a machine or function.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "digital_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>hit</w> the Enter key to save your changes.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>нажмите</w> клавишу Enter, чтобы сохранить изменения.",
                                "zh": "请<w>按</w>回车键保存你的更改。"
                            }
                        },
                        {
                            "text": "Someone needs to <w>hit</w> the lights so we can see the screen.",
                            "target_lang_translations": {
                                "ru": "Кто-нибудь должен <w>выключить</w> свет, чтобы мы могли видеть экран.",
                                "zh": "得有人<w>按</w>一下灯的开关，这样我们才能看清屏幕。"
                            }
                        }
                    ],
                    "synonyms": [
                        "press",
                        "push",
                        "click"
                    ],
                    "common_phrases": [
                        "hit the button",
                        "hit play",
                        "hit the switch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нажать кнопку или клавишу для активации устройства или функции.",
                        "zh": "按下按钮、按键或开关来启动机器或某项功能。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нажать",
                                "target_lang_sense_clarification": "надавить на кнопку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "按",
                                "target_lang_sense_clarification": "按按钮、按键或开关"
                            },
                            {
                                "target_lang_word": "按下",
                                "target_lang_sense_clarification": "更完整的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35bace22-8edc-3fd0-bb52-a5f86b9da799",
                    "sense_definition": "To reach a particular level, target, or place.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "achievement_reach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The temperature is expected to <w>hit</w> 30 degrees this afternoon.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что сегодня днем температура <w>достигнет</w> 30 градусов.",
                                "zh": "预计今天下午气温将<w>达到</w>30度。"
                            }
                        },
                        {
                            "text": "We hope to <w>hit</w> our sales target by the end of the month.",
                            "target_lang_translations": {
                                "ru": "Мы надеемся <w>достичь</w> нашей цели по продажам к концу месяца.",
                                "zh": "我们希望在月底前<w>达到</w>销售目标。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reach",
                        "attain",
                        "achieve",
                        "get to",
                        "touch"
                    ],
                    "antonyms": [
                        "miss"
                    ],
                    "common_phrases": [
                        "hit a target",
                        "hit the road",
                        "hit a record"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достичь определенного уровня, цели или места.",
                        "zh": "达到某个水平、目标或地点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достичь",
                                "target_lang_sense_clarification": "дойти до уровня или цели"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "达到",
                                "target_lang_sense_clarification": "到达某个数字、水平或目标"
                            },
                            {
                                "target_lang_word": "达成",
                                "target_lang_sense_clarification": "用于目标、标准等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8766fccc-c4b2-3702-a7ae-5f973bc06f46",
                    "sense_definition": "To have a strong, often negative, effect on someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small business was <w>hit</w> hard by the economic recession.",
                            "target_lang_translations": {
                                "ru": "Экономический спад сильно <w>ударил</w> по малому бизнесу.",
                                "zh": "这家小企业受到经济衰退的沉重<w>打击</w>。"
                            }
                        },
                        {
                            "text": "The bad news really <w>hit</w> him later that evening.",
                            "target_lang_translations": {
                                "ru": "Плохие новости по-настоящему <w>поразили</w> его позже тем же вечером.",
                                "zh": "那天晚上晚些时候，这个坏消息真的<w>打击</w>了他。"
                            }
                        }
                    ],
                    "synonyms": [
                        "affect",
                        "impact",
                        "devastate"
                    ],
                    "common_phrases": [
                        "hit hard",
                        "hit home"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказать сильное, часто негативное, воздействие на кого-либо или что-либо.",
                        "zh": "对某人或某事产生强烈的、通常是负面的影响。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ударить",
                                "target_lang_sense_clarification": "сильно повлиять (обычно негативно)"
                            },
                            {
                                "target_lang_word": "поразить",
                                "target_lang_sense_clarification": "произвести сильное впечатление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打击",
                                "target_lang_sense_clarification": "造成强烈影响，常指负面影响"
                            },
                            {
                                "target_lang_word": "冲击",
                                "target_lang_sense_clarification": "较书面，指带来不利影响"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5568e221-bb02-3b4a-a54e-d9fd1f56c939",
                    "sense_definition": "To go to or arrive at a place, often briefly or for a specific purpose.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "visit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>hit</w> the grocery store before heading home.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>заскочить</w> в продуктовый магазин перед возвращением домой.",
                                "zh": "我们决定回家前先<w>去</w>一趟杂货店。"
                            }
                        },
                        {
                            "text": "I try to <w>hit</w> the gym at least three times a week.",
                            "target_lang_translations": {
                                "ru": "Я стараюсь <w>ходить</w> в спортзал не реже трех раз в неделю.",
                                "zh": "我尽量每周至少<w>去</w>三次健身房。"
                            }
                        }
                    ],
                    "synonyms": [
                        "visit",
                        "go to",
                        "stop by"
                    ],
                    "common_phrases": [
                        "hit the gym",
                        "hit the shops",
                        "hit the bar"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пойти или прибыть в какое-либо место, часто ненадолго или с определенной целью.",
                        "zh": "去某个地方或到达某处，常指短暂前往或为了某个特定目的前往。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заскочить",
                                "target_lang_sense_clarification": "разг. зайти ненадолго"
                            },
                            {
                                "target_lang_word": "сходить",
                                "target_lang_sense_clarification": "посетить место"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "去",
                                "target_lang_sense_clarification": "口语，去某地一趟"
                            },
                            {
                                "target_lang_word": "去一趟",
                                "target_lang_sense_clarification": "强调前往并进入某地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adafd4c5-f661-34b2-81d3-4f9fa62b81ca",
                    "sense_definition": "To kill a person, usually on the instructions of a third party.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mob boss ordered his men to <w>hit</w> the witness before the trial.",
                            "target_lang_translations": {
                                "ru": "Главарь мафии приказал своим людям <w>убрать</w> свидетеля до суда.",
                                "zh": "黑帮老大命令手下在开庭前<w>干掉</w>那个证人。"
                            }
                        },
                        {
                            "text": "They planned to <w>hit</w> the target quietly and leave no trace.",
                            "target_lang_translations": {
                                "ru": "Они планировали <w>ликвидировать</w> цель тихо и не оставить следов.",
                                "zh": "他们计划悄悄<w>除掉</w>目标，不留下任何痕迹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kill",
                        "murder",
                        "bump off"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "criminal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Убить человека, обычно по указанию третьей стороны.",
                        "zh": "杀死某人，通常是受第三方指使。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убрать",
                                "target_lang_sense_clarification": "крим. сленг: убить"
                            },
                            {
                                "target_lang_word": "ликвидировать",
                                "target_lang_sense_clarification": "устранить, убить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "干掉",
                                "target_lang_sense_clarification": "黑道、口语中指杀掉某人"
                            },
                            {
                                "target_lang_word": "除掉",
                                "target_lang_sense_clarification": "较正式，指秘密或定点杀害"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d97e3ff-29e8-3ef7-8db7-3cef383bb42b",
                    "sense_definition": "Something very popular or successful, such as a song, film, or play.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band played their biggest <w>hit</w> to the delight of the fans.",
                            "target_lang_translations": {
                                "ru": "Группа сыграла свой самый известный <w>хит</w> на радость фанатам.",
                                "zh": "乐队演奏了他们最红的<w>热门歌曲</w>，歌迷们非常高兴。"
                            }
                        },
                        {
                            "text": "The new animated movie is a huge <w>hit</w> with children.",
                            "target_lang_translations": {
                                "ru": "Новый мультфильм стал огромным <w>хитом</w> среди детей.",
                                "zh": "这部新动画电影在孩子当中是个大<w>热门</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "success",
                        "winner",
                        "triumph",
                        "smash"
                    ],
                    "antonyms": [
                        "flop",
                        "miss",
                        "turkey"
                    ],
                    "common_phrases": [
                        "smash hit",
                        "big hit",
                        "greatest hits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то очень популярное или успешное, например песня, фильм или спектакль.",
                        "zh": "非常流行或成功的东西，如歌曲、电影或戏剧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хит",
                                "target_lang_sense_clarification": "популярное произведение"
                            },
                            {
                                "target_lang_word": "шлягер",
                                "target_lang_sense_clarification": "популярная песня (устар.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "热门",
                                "target_lang_sense_clarification": "非常流行、很成功的作品，如歌曲、电影等"
                            },
                            {
                                "target_lang_word": "热门歌曲",
                                "target_lang_sense_clarification": "指流行且成功的歌曲"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f54a7bb7-0f59-3737-a441-1f7fb4877e3d",
                    "sense_definition": "An act of striking someone or something; a physical blow or collision.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer took a heavy <w>hit</w> to the jaw in the second round.",
                            "target_lang_translations": {
                                "ru": "Боксер получил сильный <w>удар</w> в челюсть во втором раунде.",
                                "zh": "拳击手在第二回合下巴挨了重重一<w>击</w>。"
                            }
                        },
                        {
                            "text": "The car suffered a direct <w>hit</w> from the falling branch.",
                            "target_lang_translations": {
                                "ru": "Машина получила прямой <w>удар</w> упавшей веткой.",
                                "zh": "汽车受到掉落树枝的直接<w>撞击</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blow",
                        "punch",
                        "strike",
                        "impact",
                        "knock"
                    ],
                    "antonyms": [
                        "miss"
                    ],
                    "common_phrases": [
                        "take a hit",
                        "direct hit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт удара по кому-либо или чему-либо; физический удар или столкновение.",
                        "zh": "击打某人或某物的一次动作；一次物理上的打击或撞击。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удар",
                                "target_lang_sense_clarification": "физическое воздействие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一击",
                                "target_lang_sense_clarification": "一次打击、撞击"
                            },
                            {
                                "target_lang_word": "打击",
                                "target_lang_sense_clarification": "一般说法，指物理上的打或撞"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9c9d856-f35f-32c1-9637-986810026635",
                    "sense_definition": "A single visit to a website or a match found by a search engine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "digital_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My blog received over a thousand <w>hits</w> yesterday after I posted the news.",
                            "target_lang_translations": {
                                "ru": "Мой блог получил более тысячи <w>просмотров</w> вчера после того, как я опубликовал новости.",
                                "zh": "我发布那条消息后，我的博客昨天收到了超过一千次<w>访问</w>。"
                            }
                        },
                        {
                            "text": "The search engine returned zero <w>hits</w> for that specific phrase.",
                            "target_lang_translations": {
                                "ru": "Поисковая система не выдала ни одного <w>совпадения</w> по этой конкретной фразе.",
                                "zh": "搜索引擎对那个特定短语没有返回任何<w>匹配结果</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "view",
                        "visit",
                        "result",
                        "click"
                    ],
                    "common_phrases": [
                        "website hits",
                        "search hits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единичное посещение веб-сайта или совпадение, найденное поисковой системой.",
                        "zh": "网站的一次访问，或搜索引擎找到的一条匹配结果。"
                    },
                    "translations": {
                        "ru": [
