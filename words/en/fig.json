{
    "word_family": [
        "figgy",
        "figleaf"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c9b00a10-24af-3cf6-89fc-fbef2ac77435",
                    "sense_definition": "The soft, sweet, pear-shaped fruit of the fig tree, which contains many small seeds and is often eaten dried.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fruit_tree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a basket of fresh <w>figs</w> from the market.",
                            "target_lang_translations": {
                                "ru": "Она купила корзину свежего <w>инжира</w> на рынке.",
                                "zh": "她从市场上买了一篮新鲜的<w>无花果</w>。"
                            }
                        },
                        {
                            "text": "Dried <w>figs</w> are a healthy snack rich in fiber.",
                            "target_lang_translations": {
                                "ru": "Сушёный <w>инжир</w> — это полезная закуска, богатая клетчаткой.",
                                "zh": "无花果干是一种富含纤维的健康零食。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dried fig",
                        "fresh fig",
                        "fig jam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкий, сладкий плод грушевидной формы фигового дерева, содержащий множество мелких семян, который часто едят в сушеном виде.",
                        "zh": "一种柔软、甜美、梨形的无花果树果实，含有许多小种子，常被制成干果食用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инжир",
                                "target_lang_sense_clarification": "плод"
                            },
                            {
                                "target_lang_word": "фига",
                                "target_lang_sense_clarification": "разг. плод"
                            },
                            {
                                "target_lang_word": "винная ягода",
                                "target_lang_sense_clarification": "устар. название плода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无花果",
                                "target_lang_sense_clarification": "果实"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e6e9d0e-11f6-3ebe-8da7-5c564fc89c7d",
                    "sense_definition": "A short form of the word <w>figure</w>, used to refer to a diagram or illustration in a text.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please look at <w>fig</w> 2 to see the growth chart.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, посмотрите на <w>рис.</w> 2, чтобы увидеть график роста.",
                                "zh": "请看<w>图</w> 2 以查看增长图表。"
                            }
                        },
                        {
                            "text": "The parts of the machine are labeled in <w>fig</w> 1.",
                            "target_lang_translations": {
                                "ru": "Части машины обозначены на <w>рис.</w> 1.",
                                "zh": "机器的部件在<w>图</w> 1 中有标注。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "see fig"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation of figure"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от слова 'рисунок', используемое для ссылки на диаграмму или иллюстрацию в тексте.",
                        "zh": "单词 figure 的缩写，用于指代文中的图表或插图。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рис.",
                                "target_lang_sense_clarification": "сокращение от 'рисунок'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "图",
                                "target_lang_sense_clarification": "用于引用图表"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdccd233-68d9-3947-8b74-a1098f7f3118",
                    "sense_definition": "A tree or shrub that grows in warm climates and produces sweet, pear-shaped fruits.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fruit_tree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They sat under the shade of the old <w>fig</w> in the garden.",
                            "target_lang_translations": {
                                "ru": "Они сидели в тени старого <w>инжира</w> в саду.",
                                "zh": "他们坐在花园里那棵老<w>无花果树</w>的树荫下。"
                            }
                        },
                        {
                            "text": "Adam and Eve are often depicted wearing <w>fig</w> leaves.",
                            "target_lang_translations": {
                                "ru": "Адама и Еву часто изображают прикрытыми <w>фиговыми</w> листьями.",
                                "zh": "亚当和夏娃常被描绘成用<w>无花果叶</w>遮体。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fig tree",
                        "fig leaf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дерево или кустарник, произрастающий в теплом климате и дающий сладкие грушевидные плоды.",
                        "zh": "一种生长在温暖气候下，结出甜美梨形果实的树木或灌木。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инжир",
                                "target_lang_sense_clarification": "дерево"
                            },
                            {
                                "target_lang_word": "фиговое дерево",
                                "target_lang_sense_clarification": "ботаническое"
                            },
                            {
                                "target_lang_word": "смоковница",
                                "target_lang_sense_clarification": "библейское/устар."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无花果树",
                                "target_lang_sense_clarification": "植物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8206ef8-12ab-3711-9422-d18fdb90bd6f",
                    "sense_definition": "A very small amount or value; used in phrases to express that something is worthless or that one does not care.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not care a <w>fig</w> about their gossip.",
                            "target_lang_translations": {
                                "ru": "Мне совершенно <w>наплевать</w> на их сплетни.",
                                "zh": "我一点也不在乎他们的闲言碎语。"
                            }
                        },
                        {
                            "text": "His promises are not worth a <w>fig</w>.",
                            "target_lang_translations": {
                                "ru": "Его обещания не стоят и ломаного <w>гроша</w>.",
                                "zh": "他的承诺连<w>分文</w>都不值。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ginger"
                    ],
                    "common_phrases": [
                        "not care a fig",
                        "not worth a fig"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "idiomatic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень малое количество или ценность; используется в фразах, чтобы выразить, что что-то ничего не стоит или безразлично.",
                        "zh": "极小的数量或价值；用于短语中表示某物毫无价值或某人毫不在意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фига",
                                "target_lang_sense_clarification": "перен. кукиш, ничего"
                            },
                            {
                                "target_lang_word": "шиш",
                                "target_lang_sense_clarification": "разг. ничего"
                            },
                            {
                                "target_lang_word": "грош",
                                "target_lang_sense_clarification": "в идиомах о малой ценности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分文",
                                "target_lang_sense_clarification": "用于表示价值极低"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "42cdbbca-166d-3693-8222-a78babdb3167",
                    "sense_definition": "To dress someone or oneself in a smart, showy, or formal way.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were all <w>figged</w> out for the wedding.",
                            "target_lang_translations": {
                                "ru": "Дети были <w>разряжены</w> к свадьбе.",
                                "zh": "孩子们为了参加婚礼都<w>盛装打扮</w>了一番。"
                            }
                        },
                        {
                            "text": "She spent hours <w>figging</w> herself up for the party.",
                            "target_lang_translations": {
                                "ru": "Она потратила часы, чтобы <w>принарядиться</w> к вечеринке.",
                                "zh": "她花了几个小时为派对<w>盛装打扮</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fig out",
                        "fig up"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used with 'out' or 'up'"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одевать кого-либо или себя нарядно, броско или формально.",
                        "zh": "将自己或他人打扮得时髦、华丽或正式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принарядиться",
                                "target_lang_sense_clarification": "одеться нарядно"
                            },
                            {
                                "target_lang_word": "вырядиться",
                                "target_lang_sense_clarification": "одеться слишком броско"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盛装打扮",
                                "target_lang_sense_clarification": "动词短语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7b2c0bbc-b270-3322-91a5-fa7826de8ad4",
                    "sense_definition": "The 95th sura (chapter) of the Qur'an.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "document_or_program_name",
                    "examples": [
                        {
                            "text": "The Imam recited the <w>Fig</w> during the evening prayer.",
                            "target_lang_translations": {
                                "ru": "Имам читал суру <w>Смоковница</w> во время вечерней молитвы.",
                                "zh": "伊玛目在晚祷时诵读了《<w>无花果章</w>》。"
                            }
                        },
                        {
                            "text": "Scholars analyze the verses of the <w>Fig</w> for deeper meaning.",
                            "target_lang_translations": {
                                "ru": "Ученые анализируют стихи суры <w>Смоковница</w> для поиска глубокого смысла.",
                                "zh": "学者们分析《<w>无花果章</w>》的经文以探求更深层的含义。"
                            }
                        }
                    ],
                    "synonyms": [
                        "The Fig-tree"
                    ],
                    "target_lang_definitions": {
                        "ru": "95-я сура (глава) Корана.",
                        "zh": "《古兰经》的第 95 章。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Смоковница",
                                "target_lang_sense_clarification": "название суры"
                            },
                            {
                                "target_lang_word": "Ат-Тин",
                                "target_lang_sense_clarification": "транслитерация названия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无花果章",
                                "target_lang_sense_clarification": "经文名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}