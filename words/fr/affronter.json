            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bd76ee28-2fcb-31a5-a13d-21c5855a4b93",
                    "sense_definition": "Faire face avec courage à un danger, un ennemi, un obstacle ou une difficulté.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune marin doit <w>affronter</w> la tempête pour ramener son bateau au port en toute sécurité."
                        },
                        {
                            "text": "Elle a trouvé la force d'<w>affronter</w> la réalité sans chercher à fuir ses responsabilités."
                        }
                    ],
                    "synonyms": [
                        "faire face"
                    ],
                    "common_phrases": [
                        "affronter la réalité",
                        "affronter la tempête",
                        "affronter ses peurs"
                    ]
                },
                {
                    "sense_id": "f7afc061-3597-3f83-a918-1be6501ce417",
                    "sense_definition": "S'opposer ou entrer en lutte réciproque lors d'un combat, d'une compétition ou d'une dispute.",
