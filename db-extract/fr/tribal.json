                        "examples": [
                            {
                                "example_id": "528c8666-bf98-4dd7-b058-91a6814216f0",
                                "sense_id": "a65c4975-5b5e-373f-90ee-c603d58786ae",
                                "text": "les Indiens tribals/tribaux."
                            }
