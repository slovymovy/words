                                "target_senses": [
                                    {
                                        "sense_id": "005a5532-28b3-34c1-b9c6-d0a7d515e376",
                                        "entry_id": "d6289f92-3ad6-3c15-9e13-f3d486a38a3c",
                                        "glosses": [
                                            "de manier waarop aan iets vorm gegeven is"
                                        ],
                                        "tags": [
                                            "masculine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54edd515-8dc5-4196-ab4c-dfb9f5ab5a0c",
                                                "sense_id": "005a5532-28b3-34c1-b9c6-d0a7d515e376",
                                                "text": "De opzet van deze procedure laat veel te wensen over."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f94cac3a-4d5a-39bc-93bd-87a1d458de33",
                                        "entry_id": "d6289f92-3ad6-3c15-9e13-f3d486a38a3c",
                                        "glosses": [
                                            "het onderdeel zijn van een zo gewenst plan"
                                        ],
                                        "tags": [
                                            "neuter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da58e6bf-188b-4408-a6ca-fcba6ccac443",
                                                "sense_id": "f94cac3a-4d5a-39bc-93bd-87a1d458de33",
                                                "text": "Was het werkelijk opzet dat zij aangereden werd?"
                                            },
                                            {
                                                "example_id": "3a1b0f2c-0384-4f84-872b-4c8d8f9d2e2c",
                                                "sense_id": "f94cac3a-4d5a-39bc-93bd-87a1d458de33",
                                                "text": "Nietsvermoedende konijnen hopsten door de boomgaard en op de heuvels in de verte werden geiten gehoed, de bellen om hun nek klingelden atonaal en onregelmatig, een rustgevend geluid, omdat er geen enkele opzet achter zat."
                                            },
                                            {
                                                "example_id": "a1e41057-f187-4fa3-b94f-5f39c96944a2",
                                                "sense_id": "f94cac3a-4d5a-39bc-93bd-87a1d458de33",
                                                "text": "De zestien wielrenners uit België fietsten volgens de politie op de weg en niet op het naastgelegen fietspad. De bestuurder van een zwarte auto wilde de groep passeren. Bij het inhalen heeft de automobilist waarschijnlijk twee wielrenners geraakt. Volgens de Belgen was er opzet in het spel."
                                            },
                                            {
                                                "example_id": "a381b996-b2be-4c15-996b-a83af0799d6d",
                                                "sense_id": "f94cac3a-4d5a-39bc-93bd-87a1d458de33",
                                                "text": "Dat kon vreemd lijken, maar zoals de situatie toen was, was zij degene die geld had en hij was op dat moment vrijwel blut, ongeveer zoals wijzelf nu. En toen gebeurde wat moest gebeuren. Of liever: toen gebeurde wat mama en Antoine wilden. Ze werden met opzet zwanger."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "opzet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f70c08a9-0e0f-37c8-a0f2-877ec7592ac8",
                                        "entry_id": "3a5a87b7-d73f-3bbd-9ed2-05681abb60e4",
                                        "glosses": [
