{
    "word_family": [
        "capacité",
        "capacitaire",
        "incapable",
        "incapacité"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4b834b12-45a4-30f9-80a1-9fcdb30cb6c2",
                    "sense_definition": "Qui a les aptitudes, la force ou les moyens nécessaires pour faire quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "aptitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs semaines d'entraînement intensif, elle est enfin <w>capable</w> de courir dix kilomètres sans s'arrêter."
                        },
                        {
                            "text": "Il ne se sentait pas <w>capable</w> de terminer ce projet complexe tout seul dans les délais imposés."
                        }
                    ],
                    "antonyms": [
                        "incapable"
                    ],
                    "common_phrases": [
                        "être capable de",
                        "se sentir capable"
                    ]
                },
                {
                    "sense_id": "a04e1cb2-84c3-3103-a01d-5b7726ebbe5b",
                    "sense_definition": "Qui a la disposition morale, le courage ou l'audace de poser certains actes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais attention à cet individu sans scrupules, il est tout à fait <w>capable</w> de mentir pour obtenir ce poste."
                        },
                        {
                            "text": "Malgré leurs différends passés, elle s'est montrée <w>capable</w> de pardon et de réconciliation."
                        }
                    ],
                    "common_phrases": [
                        "être capable de tout",
                        "être capable du pire"
                    ]
                },
                {
                    "sense_id": "f63271a6-8ca0-3fe5-8043-a88d1c7652c7",
                    "sense_definition": "Qui montre de l'habileté, de l'intelligence et une bonne maîtrise dans son travail.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "competence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise cherche un ingénieur <w>capable</w> pour diriger la nouvelle équipe technique."
                        },
                        {
                            "text": "C'est une femme très <w>capable</w> qui sait résoudre les problèmes les plus délicats."
                        }
                    ],
                    "synonyms": [
                        "compétent"
                    ],
                    "antonyms": [
                        "incapable"
                    ]
                },
                {
                    "sense_id": "b090cf1c-f412-37d0-aba1-e2571b194b75",
                    "sense_definition": "Qui jouit des droits et des conditions juridiques requises pour accomplir un acte valable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La loi précise les conditions sous lesquelles un mineur émancipé devient juridiquement <w>capable</w> de signer un contrat."
                        },
                        {
                            "text": "Les héritiers doivent être déclarés légalement <w>capables</w> pour recevoir la succession sans représentant légal."
                        }
                    ],
                    "antonyms": [
                        "incapable"
                    ]
                },
                {
                    "sense_id": "dcae7a68-91be-3b7a-9abf-6fc9e38884f8",
                    "sense_definition": "Qui peut contenir un volume, un espace ou une quantité donnés.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "contenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon ce vieil inventaire, la citerne du château était <w>capable</w> de cent muids d'eau."
                        },
                        {
                            "text": "Ce récipient traditionnel était <w>capable</w> de plusieurs litres d'huile d'olive."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "033fc587-1b09-37b5-a984-330cbd50c7d6",
                    "sense_definition": "Personne prétentieuse qui affiche une assurance exagérée ou se vante de ses compétences.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pretentieux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il aime faire le <w>capable</w> devant ses collègues alors qu'il n'a presque aucune expérience pratique."
                        },
                        {
                            "text": "Ne prêtez pas attention à ce <w>capable</w> qui passe son temps à donner des leçons à tout le monde."
                        }
                    ],
                    "common_phrases": [
                        "faire le capable"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ]
                }
            ]
        }
    ]
}