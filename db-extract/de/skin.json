                "senses": [
                    {
                        "sense_id": "8c57f277-8f24-3f38-bcaf-0c64ce9db7de",
                        "entry_id": "12d77033-fc40-35a1-98e5-0335ff71a91f",
                        "glosses": [
                            "Angehöriger einer heterogenen (Jugend-)Gruppe, der sehr kurze Haare oder einen völlig kahl rasierten Kopf hat, spezielle Kleidung bevorzugt (etwa Bomber-, Harrington- oder Donkeyjacken sowie Stiefel) und unter Umständen links- oder rechtsradikale Ansichten vertritt, aber auch völlig unpolitisch sein kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0540e512-82be-4ff2-8aee-8bc6f29322b9",
                                "sense_id": "8c57f277-8f24-3f38-bcaf-0c64ce9db7de",
                                "text": "Treib dich nicht dauernd mit den Skins rum!"
                            },
                            {
                                "example_id": "5e74cf07-32b9-48f8-9374-3972f9862438",
                                "sense_id": "8c57f277-8f24-3f38-bcaf-0c64ce9db7de",
                                "text": "Wir könnten den Skin da drüben nach der Uhrzeit fragen."
                            },
                            {
                                "example_id": "70551d61-167b-48e5-a347-0a3b7720a050",
                                "sense_id": "8c57f277-8f24-3f38-bcaf-0c64ce9db7de",
                                "text": "„Zu den Skins fand er über das Bier, die Langeweile und den HSV - über die klassischen Einstiegsdrogen der kahlköpfigen Subkultur.“"
                            },
                            {
                                "example_id": "1043b0c6-5e78-4839-ad1e-9b698110387a",
                                "sense_id": "8c57f277-8f24-3f38-bcaf-0c64ce9db7de",
                                "text": "„Laut Anklageschrift waren die Punks für die aus den Kantonen Zürich, Thurgau und St. Gallen stammenden Skins politische Gegner, die es mit Gewalt zu bekämpfen galt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
