                },
                {
                    "sense_id": "4a737816-8267-3e66-bf02-826765e7a5ec",
                    "sense_definition": "Producing flowers throughout the entire growing season.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener recommended <w>perpetual</w> roses for a garden that stays colorful all summer.",
                            "target_lang_translations": {
                                "ru": "Садовник порекомендовал <w>ремонтантные</w> розы для сада, который остается ярким все лето.",
                                "tr": "Bahçıvan, tüm yaz renkli kalan bir bahçe için <w>remontant</w> güller önerdi."
                            }
                        },
                        {
                            "text": "These <w>perpetual</w> bloomers require regular pruning to maintain their health.",
                            "target_lang_translations": {
                                "ru": "Эти <w>вечноцветущие</w> растения требуют регулярной обрезки для поддержания их здоровья.",
                                "tr": "Bu <w>sürekli</w> çiçek açan bitkiler, sağlıklarını korumak için düzenli budama gerektirir."
                            }
                        }
                    ],
                    "synonyms": [
                        "evergreen",
                        "perennial"
                    ],
                    "common_phrases": [
                        "perpetual bloomers",
                        "perpetual roses"
                    ],
                    "target_lang_definitions": {
