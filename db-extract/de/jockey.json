                                                "example_id": "b1847c2a-1123-4ae4-9a6d-10cb7916af10",
                                                "sense_id": "20af0021-153b-3101-a5b1-5a93e7338c02",
                                                "text": "They were jockeying for position toward the end of the race."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10907e8f-53b1-3fe5-b23b-70186d08dba1",
                                        "entry_id": "f28c617b-cabe-38e8-b4a1-e850c3315461",
                                        "glosses": [
                                            "To maneuver (something) by skill; especially, to do so for one's advantage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcf07c2c-fce1-47a2-862e-4cb2957c43fa",
                                                "sense_id": "10907e8f-53b1-3fe5-b23b-70186d08dba1",
                                                "text": "This particularly obtains in all Parliamentary affairs. Whether the business in hand be to get a man in, or get a man out, or get a man over, or promote a railway, or jockey a railway, or what else, nothing is understood to be so effectual as scouring nowhere in a violent hurry—in short, as taking cabs and going about."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76cc774b-2eb1-3ba3-a478-890fcb482c54",
                                        "entry_id": "f28c617b-cabe-38e8-b4a1-e850c3315461",
                                        "glosses": [
                                            "To cheat or trick."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d6a613b-9e3a-4033-95c0-125050a7ef41",
                        "source_entry_id": "336d9970-5102-3141-8f77-b28fa77955f4",
                        "source_sense_id": "b5ae2b03-2c82-3af2-b331-78302fa5f7d3",
