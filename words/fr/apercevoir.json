                    "common_phrases": [
                        "laisser apercevoir"
                    ],
                    "target_lang_definitions": {
                        "en": "To make out or catch sight of something by sight, seeing it briefly or from a distance.",
                        "ru": "Различить взглядом что-либо, мельком увидеть или разглядеть издалека.",
                        "nl": "Iets met het oog onderscheiden, kort of van ver zien.",
                        "de": "Etwas mit den Augen wahrnehmen, kurz oder aus einiger Entfernung sehen.",
                        "pl": "Dostrzec coś wzrokiem, zobaczyć coś szybko lub z oddali.",
                        "it": "Riuscire a distinguere qualcosa con la vista, vederlo rapidamente o da lontano.",
                        "cs": "Rozeznat zrakem něco, uvidět to krátce nebo z dálky.",
                        "tr": "Bir şeyi görüş yoluyla kısaca ya da uzaktan seçerek fark etmek.",
                        "es": "Distinguir algo con la vista, verlo brevemente o desde lejos.",
                        "zh": "通过视觉辨认出某物，指快速瞥见或从远处看到。"
                    },
