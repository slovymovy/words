                                                "example_id": "94b5f8c2-3fa4-4b74-818d-65e030f19518",
                                                "sense_id": "bb8ab394-e957-3100-bebb-6f4ba21b82a8",
                                                "text": "В этом случае бита игроку не возвращается, а возвратившийся в «город» выбитый городок убирают."
                                            },
                                            {
                                                "example_id": "81676bca-bc0a-48f3-b821-ffad55ada55d",
                                                "sense_id": "bb8ab394-e957-3100-bebb-6f4ba21b82a8",
                                                "text": "— Ура! — закричала она после пятого броска, когда два городка от пушки были выбиты."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
