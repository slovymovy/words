                                        "sense_id": "5d6d155d-4b77-340c-ad36-6ec94c5ee7ad",
                                        "entry_id": "39bf7d03-467f-3618-b7e2-315dddc2e3a3",
                                        "glosses": [
                                            "Commentateur de textes profanes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a09a2359-491d-4f0a-9cac-2100bcb62f01",
                                                "sense_id": "5d6d155d-4b77-340c-ad36-6ec94c5ee7ad",
                                                "text": "Dans un des innombrables groupes d’études qui commentent les Écrits de Lacan, un herméneute, pour l’émerveillement de ses complices, parle soudain des écrans de l’acquis. Mais, à l’analyse, il apparaît clairement qu’aucun progrès n’a été fait dans la connaissance, et que c’est justement cela qui a réjoui les participants."
                                            }
                                        ]
                                    }
