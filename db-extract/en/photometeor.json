                                        "sense_id": "c0e2caa5-f603-3dfc-abab-63ed0949e252",
                                        "entry_id": "65d9d29e-3326-38e8-8c4e-87879a78c57f",
                                        "glosses": [
                                            "Phénomène optique atmosphérique engendré par la déviation (réflexion, réfraction, diffraction, interférence, …) de la lumière solaire ou lunaire, tels que le mirage, le halo, l’arc-en-ciel, le rayon vert, etc."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ed9c1a6-65ca-4679-a81d-2276cf5c1067",
                                                "sense_id": "c0e2caa5-f603-3dfc-abab-63ed0949e252",
                                                "text": "Ce photométéore s’observe lorsque l’horizon est très pur et le disque solaire ni rouge ni orangé, mais très éclatant."
                                            },
                                            {
                                                "example_id": "9b1c2908-7172-40ad-bb00-2cb9156c9968",
                                                "sense_id": "c0e2caa5-f603-3dfc-abab-63ed0949e252",
                                                "text": "… il est midi, la prairie craque, il règne un grand silence, le ciel est sillonnée de photométéores, je traîne un grand sac-poubelle de plastique noir, et devant moi, l’herbe aplatie, piétinée, creuse une surface plus claire dans le couvert végétal, une vaste cuvette où les pierres qui cette nuit cerclaient notre foyer sont encore chaudes."
                                            },
                                            {
                                                "example_id": "50f828a1-1e6e-484e-8cc4-1900ba33d74a",
                                                "sense_id": "c0e2caa5-f603-3dfc-abab-63ed0949e252",
                                                "text": "L’arc-en-ciel est un photométéore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
