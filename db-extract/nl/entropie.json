                        "sense_id": "3b76b57d-5edf-304e-af98-33b3b4d687ad",
                        "entry_id": "b4632b80-e744-360f-b8d4-7c2dcf78f5ca",
                        "glosses": [
                            "een getal evenredig met de logaritme van het aantal realiseringmogelijkheden, ook wel gedefinieerd als de reversibele warmte gedeeld door de temperatuur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5c66e57-09e4-4adb-9090-ae521326bedb",
                                "sense_id": "3b76b57d-5edf-304e-af98-33b3b4d687ad",
                                "text": "In een geïsoleerd systeem neemt de entropie altijd toe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85de4b18-4c04-49ea-913d-2a570598ba60",
                        "source_entry_id": "b4632b80-e744-360f-b8d4-7c2dcf78f5ca",
                        "source_sense_id": "3b76b57d-5edf-304e-af98-33b3b4d687ad",
                        "source_sense_description": "een getal evenredig met de logaritme van het aantal realiseringmogelijkheden, ook wel gedefinieerd als de reversibele warmte gedeeld door de temperatuur",
                        "target_lang_word": "Entropie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entropie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba5ae93a-6264-3197-8615-805305c73191",
                                        "entry_id": "18a4f22d-934e-3ba6-9865-99fde47a2617",
                                        "glosses": [
                                            "Grad der Unumkehrbarkeit eines Vorganges"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d655cc97-4111-45e3-b472-a6783479a418",
                                                "sense_id": "ba5ae93a-6264-3197-8615-805305c73191",
                                                "text": "Die Entropie des Weltalls ist nicht berechenbar."
                                            },
                                            {
                                                "example_id": "aec1ab57-2a74-4f4c-9cd6-71d0f7e54215",
                                                "sense_id": "ba5ae93a-6264-3197-8615-805305c73191",
                                                "text": "„Die Entropie ist in gewissem Sinne ein Bruder der Energie, wenn auch ein sehr ungleicher Bruder, also vielleicht eher eine Schwester.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e9108d67-7f9c-3cf7-ade5-e02d2116b4e4",
                                        "entry_id": "18a4f22d-934e-3ba6-9865-99fde47a2617",
                                        "glosses": [
                                            "Maß für den mittleren Informationsgehalt einer Menge von Zeichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d477d9a8-5441-47ac-9407-88e18b1a60ee",
                                                "sense_id": "e9108d67-7f9c-3cf7-ade5-e02d2116b4e4",
                                                "text": "Die Entropie des Alphabets ist weithin bekannt."
                                            },
                                            {
                                                "example_id": "4b466feb-0630-4cbc-904a-703bc208445d",
                                                "sense_id": "e9108d67-7f9c-3cf7-ade5-e02d2116b4e4",
                                                "text": "„Das erstellte Protokoll dient als Ausgangspunkt für die Berechnung der Entropie und der Redundanz pro Buchstabe einer Sprache, die sich aus der Anzahl von Rateversuchen ergibt.“"
                                            },
                                            {
                                                "example_id": "a1b81cb0-7072-4a76-baf5-0d6888c6a385",
                                                "sense_id": "e9108d67-7f9c-3cf7-ade5-e02d2116b4e4",
                                                "text": "„Im Vordergrund stehen in dieser Gruppe die Untersuchung der Entropie, die Phonem- und Graphemstatistik sowie Untersuchungen von Texteigenschaften und die Automatische Übersetzung.“"
                                            },
                                            {
                                                "example_id": "f4741a1b-54bf-48e5-a56e-e72187294726",
                                                "sense_id": "e9108d67-7f9c-3cf7-ade5-e02d2116b4e4",
                                                "text": "„Etwas langwieriger, aber keineswegs schwieriger ist die Berechnung der Entropie, die aus der Informationstheorie übernommen wurde und sich daher an eine weit entwickelte Disziplin anlehnt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "29d12a0d-d7c3-3a2b-9ba5-aff14df264ee",
                                        "entry_id": "18a4f22d-934e-3ba6-9865-99fde47a2617",
                                        "glosses": [
                                            "Maß für die Unordnung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
