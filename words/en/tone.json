    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f26d491-f389-3513-858f-0a9d1b143316",
                    "sense_definition": "The manner in which speech or writing is expressed, especially regarding the speaker's attitude, emotion, or choice of words.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "attitude_mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I did not appreciate the sharp <w>tone</w> of his voice when he answered.",
                            "target_lang_translations": {
                                "ru": "Мне не понравился резкий <w>тон</w> его голоса, когда он ответил.",
                                "zh": "他回答时那尖锐的<w>语气</w>让我很不舒服。"
                            }
                        },
                        {
                            "text": "The author uses a humorous <w>tone</w> to describe serious events in the book.",
                            "target_lang_translations": {
                                "ru": "Автор использует юмористический <w>тон</w> для описания серьезных событий в книге.",
                                "zh": "作者在书中用幽默的<w>笔调</w>来描述严肃的事件。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tone of voice",
                        "watch your tone",
                        "harsh tone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Манера, в которой выражается речь или письмо, особенно в отношении отношения говорящего, эмоций или выбора слов.",
                        "zh": "说话或写作时表达的方式，特别是关于说话者的态度、情绪或用词选择。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тон",
                                "target_lang_sense_clarification": "эмоциональная окраска речи"
                            },
                            {
                                "target_lang_word": "интонация",
                                "target_lang_sense_clarification": "выразительность голоса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "语气",
                                "target_lang_sense_clarification": "说话时的情感色彩"
                            },
                            {
                                "target_lang_word": "语调",
                                "target_lang_sense_clarification": "说话时的声音高低起伏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfa9b8cb-dcbc-3733-9ff7-d06b7f94dd1e",
                    "sense_definition": "The quality or character of a sound, especially the timbre of an instrument or voice.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "sound_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cello is known for its deep and rich <w>tone</w>.",
                            "target_lang_translations": {
                                "ru": "Виолончель известна своим глубоким и богатым <w>тоном</w>.",
                                "zh": "大提琴以其深沉而丰富的<w>音色</w>而闻名。"
                            }
                        },
                        {
                            "text": "She adjusted the <w>tone</w> on the radio to reduce the treble.",
                            "target_lang_translations": {
                                "ru": "Она отрегулировала <w>тон</w> на радио, чтобы уменьшить высокие частоты.",
                                "zh": "她调节了收音机的<w>音质</w>以降低高音。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rich tone",
                        "musical tone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество или характер звука, особенно тембр инструмента или голоса.",
                        "zh": "声音的质量或特征，特别是乐器或人声的音色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тон",
                                "target_lang_sense_clarification": "качество звука, тембр"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "音色",
                                "target_lang_sense_clarification": "声音的特质"
                            },
                            {
                                "target_lang_word": "音质",
                                "target_lang_sense_clarification": "声音的质量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96c97218-580d-3acc-ab26-34e8b35213e1",
                    "sense_definition": "The general character, atmosphere, or mood of a place, situation, or event.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "attitude_mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The decorations and music set a festive <w>tone</w> for the party.",
                            "target_lang_translations": {
