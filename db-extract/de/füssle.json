                "senses": [
                    {
                        "sense_id": "48363980-5c47-3a72-aae1-d98d87f291d6",
                        "entry_id": "ec44fb26-95a1-324a-b6c3-4baf9bbc8019",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fb7ea5d-ea52-4e62-8153-4bf1c8f52624",
                                "sense_id": "48363980-5c47-3a72-aae1-d98d87f291d6",
                                "text": "Frau Füssle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "35152c5d-1c3b-44b1-8df3-35509ab9bb4d",
                                "sense_id": "48363980-5c47-3a72-aae1-d98d87f291d6",
                                "text": "Herr Füssle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a7d92610-3d94-48ca-8251-d3daf1c90f55",
                                "sense_id": "48363980-5c47-3a72-aae1-d98d87f291d6",
                                "text": "Die Füssles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0fa860e6-2840-4135-9cad-dfed05812f5b",
                                "sense_id": "48363980-5c47-3a72-aae1-d98d87f291d6",
                                "text": "Der Füssle trägt nie die Schals, die die Füssle ihm strickt."
                            },
                            {
                                "example_id": "7450dc7c-b7a2-4580-acc9-df350bbb69ac",
                                "sense_id": "48363980-5c47-3a72-aae1-d98d87f291d6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Füssle kommt, geht der Herr Füssle.“"
                            },
                            {
                                "example_id": "4800a191-7469-4fcc-9643-e9c2c96a5694",
                                "sense_id": "48363980-5c47-3a72-aae1-d98d87f291d6",
                                "text": "Füssle kommt und geht."
                            },
                            {
                                "example_id": "1a30db51-799c-4ee7-bc97-8249e316f11a",
                                "sense_id": "48363980-5c47-3a72-aae1-d98d87f291d6",
                                "text": "Füssles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
