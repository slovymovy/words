                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "0412fa27-9944-454d-a926-7c4af65dde10",
                                "sense_id": "9761b9e3-a435-3779-8ae4-6b35e49d3339",
                                "text": "чего́ вам недостаёт?",
                                "translation": "what are you short of?; what are you lacking?",
                                "english": "what are you short of?; what are you lacking?"
                            },
                            {
                                "example_id": "e24e9fa0-4468-4aa4-a50a-b496487d8291",
                                "sense_id": "9761b9e3-a435-3779-8ae4-6b35e49d3339",
                                "text": "ему́ недостаёт де́нег",
                                "translation": "he is short of money",
                                "english": "he is short of money"
                            },
                            {
                                "example_id": "82904a47-702c-4708-b513-f471934e14e8",
                                "sense_id": "9761b9e3-a435-3779-8ae4-6b35e49d3339",
                                "text": "нам недостаёт рабо́тников",
                                "translation": "we lack workers; we are short of workers",
                                "english": "we lack workers; we are short of workers"
                            },
                            {
                                "example_id": "2a312a15-b20a-4749-82f9-2ec7702bc8b0",
                                "sense_id": "9761b9e3-a435-3779-8ae4-6b35e49d3339",
                                "text": "ему́ недостаёт слов, что́бы вы́разить",
                                "translation": "he cannot find words to express",
                                "english": "he cannot find words to express"
                            },
                            {
                                "example_id": "125ccf99-66fb-4830-9e88-a0fff1511b52",
                                "sense_id": "9761b9e3-a435-3779-8ae4-6b35e49d3339",
                                "text": "ему́ недоста́нет сил",
                                "translation": "his strength will not suffice him; he will not have sufficient strength",
                                "english": "his strength will not suffice him; he will not have sufficient strength"
                            },
                            {
                                "example_id": "26cdf17d-9c97-421a-ac52-a7019c1d9b46",
                                "sense_id": "9761b9e3-a435-3779-8ae4-6b35e49d3339",
                                "text": "э́того ещё недостава́ло!",
                                "translation": "that's all we needed",
                                "english": "that's all we needed"
                            }
                        ]
                    },
                    {
                        "sense_id": "7e4bca9e-bba3-383d-91b4-f63855024cfe",
                        "entry_id": "2ef6e702-ac96-38ac-935e-e20b4997fd2e",
                        "glosses": [
                            "to miss"
                        ],
                        "tags": [],
                        "examples": [
