                                "sense_id": "7165153b-45a9-3fc8-aa91-b231dea060f6",
                                "text": "Десятеро мужчин."
                            },
                            {
                                "example_id": "f4e62d97-0e98-44ec-b48a-ab425435f803",
                                "sense_id": "7165153b-45a9-3fc8-aa91-b231dea060f6",
