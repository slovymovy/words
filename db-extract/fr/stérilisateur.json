                        "examples": [
                            {
                                "example_id": "bc772b89-cf28-4315-8bd9-d9fc56e6fc2e",
                                "sense_id": "cf89d029-2b90-3722-9d22-3a541c98814b",
                                "text": "Après les avoir blanchis à l'eau bouillante, on rangeait les haricots dans les bocaux, puis on fermait avec un joint orange à languette ; les bocaux s'empilaient dans le stérilisateur en acier galvanisé avec son grand thermomètre central, bloqués par une araignée métallique."
                            },
                            {
                                "example_id": "abfb035c-3012-474f-8cd3-c9aee8c79ff1",
                                "sense_id": "cf89d029-2b90-3722-9d22-3a541c98814b",
                                "text": "« Il ne faut surtout pas se jeter sur les Babycook ou les stérilisateurs à biberon, c’est bling-bling et totalement superflu », commente Mehdi."
                            }
                        ]
