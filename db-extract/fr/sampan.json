                ],
                "senses": [
                    {
                        "sense_id": "dece363a-8581-3b69-88f3-00bc04cc10c1",
                        "entry_id": "11efc5ec-1453-3d8e-bf82-66234bedd812",
                        "glosses": [
                            "Navire léger en usage en Extrême-Orient dans la navigation fluviale et le cabotage."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "a0f09fc5-13c4-41d2-9204-a9d20556f4e4",
                                "sense_id": "dece363a-8581-3b69-88f3-00bc04cc10c1",
                                "text": "De même le mot Sampan, fait des deux mots chinois san, trois, et pan, planche, trois planches — éléments constitutifs de la barque la plus primitive — signifie également : barque, et l’emploi qui est fait, dans l’archipel Indien, de ce mot et de l’objet qu’il désigne, affirme ouvertement la migration des Chinois du continent aux îles de l’archipel Indien."
                            },
                            {
                                "example_id": "fb18495e-1884-450c-ad16-a465265ba238",
                                "sense_id": "dece363a-8581-3b69-88f3-00bc04cc10c1",
                                "text": "Han-Kéou était toute proche : le mouvement des sampans couvrait presque le fleuve."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cfe56c7-d7e1-4bbf-b6d3-ae12be39d001",
                        "source_entry_id": "11efc5ec-1453-3d8e-bf82-66234bedd812",
                        "source_sense_id": "dece363a-8581-3b69-88f3-00bc04cc10c1",
                        "target_lang_word": "Sampan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sampan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a113e4e4-902f-36bc-b21e-9c9feb7495ea",
                                        "entry_id": "13e74bc2-2fc1-3ab1-ba08-fea31c7188e2",
                                        "glosses": [
                                            "flaches, breites Ruder- oder Segelboot"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69c1acaa-37b8-41e0-8387-1775558fa968",
                                                "sense_id": "a113e4e4-902f-36bc-b21e-9c9feb7495ea",
                                                "text": "„Schlimmer noch, wir haben uns nicht etwa von sanften Pazifikströmungen an Bord eines Sampans zu diesem Umwelt-Camp treiben lassen.“"
                                            },
                                            {
                                                "example_id": "e2b0c780-e460-4811-ae97-17137e4382d4",
                                                "sense_id": "a113e4e4-902f-36bc-b21e-9c9feb7495ea",
                                                "text": "„Aber die meisten Boote des Floßes sind eben nichts weiter als Boote. Kleine Vergnügungsjachten, Sampans, Barken, Dingis, Rettungsboote, Hausboote, behelfsmäßige Konstruktionen auf leeren Öltonnen und Styropormatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9c61611-5b50-4964-b0ba-c2558d2bbd62",
                        "source_entry_id": "11efc5ec-1453-3d8e-bf82-66234bedd812",
                        "source_sense_id": "dece363a-8581-3b69-88f3-00bc04cc10c1",
                        "target_lang_word": "sampan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sampan",
