                        ],
                        "form": "démente"
                    },
                    {
                        "form_id": "d1c95012-d6cd-4869-a9ae-e0ccfd2b0a89",
                        "entry_id": "9357783c-b4c0-37ca-b2dd-28d47e4d34fe",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "démentes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6da1dbe7-0b25-39af-9e9e-5e816bf070a5",
                        "entry_id": "9357783c-b4c0-37ca-b2dd-28d47e4d34fe",
                        "glosses": [
                            "Qui est dans l’état de démence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50b01bfb-556d-4f60-9643-b549b2d2888e",
                                "sense_id": "6da1dbe7-0b25-39af-9e9e-5e816bf070a5",
                                "text": "Le Jones dément, acculant au suicide sa secte d’arriérés, est à peine différent du lunatique Khadafi, le prophète de la lubie, du calamiteux Khomeini qui ayatollise gâteusement à Téhéran, ou du débile Lefebvre, qui rafistole à Écône sa petite église pour lui tout seul."
                            }
                        ]
                    },
                    {
                        "sense_id": "fef2a628-9ac8-3837-b250-9b5f1d8f8d99",
                        "entry_id": "9357783c-b4c0-37ca-b2dd-28d47e4d34fe",
                        "glosses": [
                            "Qui défie la raison ; incroyable."
                        ],
                        "tags": [
                            "broadly",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "93c63ca0-065e-4694-96a8-2b145a8e9457",
                                "sense_id": "fef2a628-9ac8-3837-b250-9b5f1d8f8d99",
                                "text": "Ainsi, défilèrent consécutivement les qualificatifs de dément, délirant, chouette, bath, et pas mal. On pouvait tout aussi bien dire d'une fille qu'elle était chouette et d'une capitale étrangère visitée à Pâques que c'était pas mal."
                            },
                            {
                                "example_id": "da2fa5c6-43ee-45f9-aa11-10b057805a8a",
                                "sense_id": "fef2a628-9ac8-3837-b250-9b5f1d8f8d99",
                                "text": "« Hier soir, l’armée russe a établi un record dément de plus. Ils frappent notre infrastructure civile, nos habitations, notre population », a déclaré le président ukrainien, Volodymyr Zelensky, à la suite de l’attaque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0f0ab8c-c051-4510-8b9f-575f596f1958",
                        "source_entry_id": "9357783c-b4c0-37ca-b2dd-28d47e4d34fe",
                        "target_lang_word": "demenzkrank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demenzkrank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c5792543-7671-36a8-b244-27b59ac565f3",
                                        "entry_id": "33726edd-3119-306d-afeb-80711e791e26",
                                        "glosses": [
                                            "an Demenz erkrankt; unter der Krankheit Demenz leidend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dd000f1-c33a-40dd-a4cd-363bcf0a2318",
                                                "sense_id": "c5792543-7671-36a8-b244-27b59ac565f3",
                                                "text": "„Man spricht in solchen Situationen davon, dass der demenzkranke Mensch eine gute Fassade aufrechterhalten kann. […] Als Angehörige kann mich die gute Fassade des Kranken in äußerst unangenehme Situationen bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e0d9fec-4938-49e9-af45-bed0e530ce29",
                        "source_entry_id": "9357783c-b4c0-37ca-b2dd-28d47e4d34fe",
                        "target_lang_word": "demented",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demented",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1130ed18-51c4-3505-86b2-ea6bbdc6ce3d",
                                        "entry_id": "82ac1902-914e-3622-a89c-0c558da43a72",
                                        "glosses": [
                                            "Insane; mentally ill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89eadc7d-e1db-47df-a531-5a851467b1db",
                                                "sense_id": "1130ed18-51c4-3505-86b2-ea6bbdc6ce3d",
                                                "text": "So while Ralph generally seems to inhabit a different, more glorious and joyful universe than everyone else here his yearning and heartbreak are eminently relateable. Ralph sometimes appears to be a magically demented sprite who has assumed the form of a boy, but he’s never been more poignantly, nakedly, movingly human than he is here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79452658-84b0-35e4-959b-446f16802f91",
                                        "entry_id": "82ac1902-914e-3622-a89c-0c558da43a72",
                                        "glosses": [
                                            "Having dementia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3f3e452-21c9-3ed8-8877-ba834b2106a5",
                                        "entry_id": "82ac1902-914e-3622-a89c-0c558da43a72",
                                        "glosses": [
                                            "Crazy; ridiculous."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d6fbf2b-2629-4b6f-ad89-661295ac0d03",
                                                "sense_id": "c3f3e452-21c9-3ed8-8877-ba834b2106a5",
                                                "text": "a demented idea"
                                            },
                                            {
                                                "example_id": "591bf9d6-106b-4c78-8a04-661153799a8b",
                                                "sense_id": "c3f3e452-21c9-3ed8-8877-ba834b2106a5",
                                                "text": "One of these new recruits is Jagger Froid, a demented alien from the Black Hole Galaxy, who dishes out punishment with a laser-sharp tongue."
                                            },
                                            {
                                                "example_id": "e4cc55a5-ee4b-4b85-ac2d-716c56688baa",
                                                "sense_id": "c3f3e452-21c9-3ed8-8877-ba834b2106a5",
                                                "text": "Literally nothing happens, apart from Donaldson counting to 100,000. In this sense, it is nothing like his later videos, defined as they are by a near-demented commitment to maximum viewer-stimulation."
                                            }
                                        ]
                                    }
                                ]
                            },
