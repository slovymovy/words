                        "examples": [
                            {
                                "example_id": "f658380e-a44a-4056-b706-2c7507b09caf",
                                "sense_id": "7d578cea-8265-34f4-96ac-bc5bf4164c73",
                                "text": "Wśród różnych środków ochrony roślin to zwłaszcza sprzedaż tak zwanych fungicydów, czyli środków grzybobójczych, szła dobrze, odnotowując wzrost obrotów o 20,7 proc."
                            },
                            {
                                "example_id": "b71f7280-3f36-4c50-a9b0-67fa1f83436d",
                                "sense_id": "7d578cea-8265-34f4-96ac-bc5bf4164c73",
                                "text": "2,4,6-Trichlorofenol jest fungicydem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
