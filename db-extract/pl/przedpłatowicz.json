                            {
                                "example_id": "ba84c669-d670-4b99-b375-424eaa183f53",
                                "sense_id": "7b077e2c-bb8a-39da-a661-8da294e65636",
                                "text": "Jednocześnie przedpłatowicze mają wciąż prawo do rekompensaty lub zakupu samochodu krajowej produkcji z bonifikatą"
                            },
                            {
                                "example_id": "c0733526-8cdd-4aa1-a1d4-6b7cf006ff86",
                                "sense_id": "7b077e2c-bb8a-39da-a661-8da294e65636",
                                "text": "Przedpłatowiczom pozwolono handlować prawem do ulgi, zwalniano ich z cła przy imporcie samochodów (co znów doprowadziło do patologii) i niektórych podatków"
                            }
                        ],
