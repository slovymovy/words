{
    "word_family": [
        "sweep",
        "sweeper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "65d1bd98-8d80-33e1-975f-06b9ce6ef787",
                    "sense_definition": "Present participle of <w>sweep</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>sweeping</w> the kitchen floor with a new broom.",
                            "target_lang_translations": {
                                "ru": "Она <w>подметает</w> пол на кухне новой метлой.",
                                "zh": "她正在用一把新扫帚<w>扫</w>厨房的地板。"
                            }
                        },
                        {
                            "text": "The wind is <w>sweeping</w> across the open fields.",
                            "target_lang_translations": {
                                "ru": "Ветер <w>проносится</w> над открытыми полями.",
                                "zh": "风正掠过开阔的田野。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола sweep (мести, подметать).",
                        "zh": "动词 sweep 的现在分词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подметающий",
                                "target_lang_sense_clarification": "причастие"
                            },
                            {
                                "target_lang_word": "метущий",
                                "target_lang_sense_clarification": "о ветре или снеге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扫",
                                "target_lang_sense_clarification": "指清扫动作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9020ad1f-1152-33a2-840b-221afe222121",
                    "sense_definition": "Affecting many things, people, or a wide area; comprehensive and extensive in impact.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "broad_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new government introduced <w>sweeping</w> changes to the healthcare system.",
                            "target_lang_translations": {
                                "ru": "Новое правительство внесло <w>радикальные</w> изменения в систему здравоохранения.",
                                "zh": "新政府对医疗保健系统进行了<w>彻底的</w>改革。"
                            }
                        },
                        {
                            "text": "He made a <w>sweeping</w> statement about the entire industry without checking the facts.",
                            "target_lang_translations": {
                                "ru": "Он сделал <w>огульное</w> заявление о всей индустрии, не проверив факты.",
                                "zh": "他在未核实事实的情况下，对整个行业做出了<w>笼统的</w>评价。"
                            }
                        }
                    ],
                    "synonyms": [
                        "broad",
                        "comprehensive",
                        "wide-ranging",
                        "all-encompassing",
                        "exhaustive",
                        "thorough"
                    ],
                    "antonyms": [
                        "limited",
                        "narrow",
                        "restricted"
                    ],
                    "common_phrases": [
                        "sweeping changes",
                        "sweeping statement",
                        "sweeping generalization",
                        "sweeping reform"
                    ],
                    "target_lang_definitions": {
                        "ru": "Затрагивающий многое или многих; имеющий широкие последствия или охват.",
                        "zh": "影响广泛、全面且彻底的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "радикальный",
                                "target_lang_sense_clarification": "об изменениях или реформах"
                            },
                            {
                                "target_lang_word": "огульный",
                                "target_lang_sense_clarification": "о заявлениях или обобщениях"
                            },
                            {
                                "target_lang_word": "широкий",
                                "target_lang_sense_clarification": "об охвате"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "彻底的",
                                "target_lang_sense_clarification": "指影响深远"
                            },
                            {
                                "target_lang_word": "笼统的",
                                "target_lang_sense_clarification": "指概括性过强"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3c237fc-1f2d-3ff2-84f6-7519ffa74f02",
                    "sense_definition": "Extending in a long, wide, and continuous curve or line.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel room offered a <w>sweeping</w> view of the ocean and the coastline.",
                            "target_lang_translations": {
                                "ru": "Из номера отеля открывался <w>панорамный</w> вид на океан и побережье.",
                                "zh": "从酒店房间可以<w>广阔地</w>俯瞰海洋和海岸线。"
                            }
                        },
                        {
                            "text": "We drove along the <w>sweeping</w> curve of the mountain road.",
                            "target_lang_translations": {
                                "ru": "Мы ехали по <w>широкому</w> изгибу горной дороги.",
                                "zh": "我们沿着山路<w>平缓的</w>弯道行驶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "broad"
                    ],
                    "common_phrases": [
                        "sweeping view",
                        "sweeping curve",
                        "sweeping gesture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Простирающийся длинной, широкой и непрерывной кривой или линией.",
                        "zh": "呈长而宽的连续曲线或线条延伸的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "панорамный",
                                "target_lang_sense_clarification": "о виде или обзоре"
                            },
                            {
                                "target_lang_word": "широкий",
                                "target_lang_sense_clarification": "о жесте или изгибе"
                            },
                            {
                                "target_lang_word": "плавный",
                                "target_lang_sense_clarification": "о линии или движении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "广阔的",
                                "target_lang_sense_clarification": "指视野开阔"
                            },
                            {
                                "target_lang_word": "平缓的",
                                "target_lang_sense_clarification": "指曲线形状"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73e44853-5dd1-355d-a521-1e6bacc1d2fd",
                    "sense_definition": "Complete and decisive; often used to describe a victory.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decisive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political party celebrated a <w>sweeping</w> victory in the recent election.",
                            "target_lang_translations": {
                                "ru": "Политическая партия отпраздновала <w>убедительную</w> победу на недавних выборах.",
                                "zh": "该政党在最近的选举中庆祝了<w>压倒性的</w>胜利。"
                            }
                        },
                        {
                            "text": "Their team achieved a <w>sweeping</w> success against their rivals.",
                            "target_lang_translations": {
                                "ru": "Их команда добилась <w>полного</w> успеха в борьбе с соперниками.",
                                "zh": "他们的团队在对抗对手时取得了<w>全面的</w>成功。"
                            }
                        }
                    ],
                    "synonyms": [
                        "comprehensive"
                    ],
                    "common_phrases": [
                        "sweeping victory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный и решительный; часто используется для описания победы.",
                        "zh": "完全且决定性的，常用于描述胜利。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убедительный",
                                "target_lang_sense_clarification": "о победе"
                            },
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "об успехе"
                            },
                            {
                                "target_lang_word": "безоговорочный",
                                "target_lang_sense_clarification": "о триумфе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "压倒性的",
                                "target_lang_sense_clarification": "指胜利的程度"
                            },
                            {
                                "target_lang_word": "全面的",
                                "target_lang_sense_clarification": "指成功范围"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e07bdbc-6d41-3cd7-ae9d-00b0f9ed199c",
                    "sense_definition": "The act or activity of cleaning a surface with a broom or brush.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cleaning_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Daily <w>sweeping</w> is necessary to keep the dusty workshop clean.",
                            "target_lang_translations": {
                                "ru": "Ежедневное <w>подметание</w> необходимо, чтобы содержать пыльную мастерскую в чистоте.",
                                "zh": "为了保持多尘车间的清洁，每天的<w>清扫</w>是必不可少的。"
                            }
                        },
                        {
                            "text": "The sidewalk needs a good <w>sweeping</w> after the storm.",
                            "target_lang_translations": {
                                "ru": "Тротуар нуждается в хорошем <w>подметании</w> после шторма.",
                                "zh": "暴风雨过后，人行道需要好好<w>清扫</w>一下。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "street sweeping",
                        "chimney sweeping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или действие по уборке поверхности метлой или щеткой.",
                        "zh": "用扫帚或刷子清洁表面的行为或活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подметание",
                                "target_lang_sense_clarification": "процесс уборки"
                            },
                            {
                                "target_lang_word": "уборка",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清扫",
                                "target_lang_sense_clarification": "指清洁动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
