                    {
                        "sense_id": "6551e071-93af-3ca4-9fc1-11d4b9e2a905",
                        "entry_id": "a88396e4-a8e1-3d66-9145-5f5b71809ca4",
                        "glosses": [
                            "Qu’on peut contenter, qu’on peut satisfaire."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a55cb4d2-4307-4683-a53d-564d80ebf1f4",
                                "sense_id": "6551e071-93af-3ca4-9fc1-11d4b9e2a905",
                                "text": "Monseigneur le Public, soit dit avec tout le respect dû à vos grandes, à vos vives, à vos profondes lumières, vous n’êtes nullement une personne contentable."
                            },
                            {
                                "example_id": "3faba09e-90eb-47e5-9882-f18834fea123",
                                "sense_id": "6551e071-93af-3ca4-9fc1-11d4b9e2a905",
                                "text": "Comme tu redoutes justement le dilettantisme et l’anarchie, que tu n’as pas l’âme molle et aisément contentable, que tu es à la fois déçu, volontaire et désespéré, tu t’accroches à la première branche, à la première religion qui passe à ta portée."
                            },
                            {
                                "example_id": "9accd128-30da-4950-acfa-5b8211199042",
                                "sense_id": "6551e071-93af-3ca4-9fc1-11d4b9e2a905",
                                "text": "À nouveau, Julianna prit la main de son mari et la mit sur son ventre.\n- Oh non pas encore, refusa François avec un petit sourire. T’es pas contentable !"
                            }
                        ]
                    }
                ],
