                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "231d9490-eb93-4ae9-96ad-44087b9bcf39",
                        "source_entry_id": "1df6f1d2-ccd3-374d-a077-b5cecfcf7326",
                        "source_sense_id": "5cf58670-a375-3aed-90ab-029518d2273f",
                        "source_sense_description": "umgangssprachlich: sehr weiß, blütenweiß, schneeweiß",
                        "target_lang_word": "blütenweiß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blütenweiß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df286719-fc87-3ba4-932b-d673daeb9363",
                                        "entry_id": "5ba3f2b8-5349-3d90-b640-929f698e92ff",
                                        "glosses": [
                                            "ein sehr helles (glänzendes, leuchtendes, strahlendes) Weiß aufweisend"
                                        ],
                                        "tags": [
                                            "vor allem bezüglich Kleidung und Wäsche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1e467dd-39da-4539-bb76-bb3fc705b8a0",
                                                "sense_id": "df286719-fc87-3ba4-932b-d673daeb9363",
                                                "text": "Blütenweiße Bettdecken sind uns am liebsten."
                                            },
                                            {
                                                "example_id": "9dd5300c-4ca4-403b-a5d5-b7b01ba4fa6a",
                                                "sense_id": "df286719-fc87-3ba4-932b-d673daeb9363",
                                                "text": "Hast du ein blütenweißes Näpfchen in deinem Farbkasten?"
                                            },
                                            {
                                                "example_id": "871f55f1-17d9-47e1-83cf-2f2b69994e4a",
                                                "sense_id": "df286719-fc87-3ba4-932b-d673daeb9363",
                                                "text": "„‚Darf ich Ihnen die Beſtätigung des uns gütigſt erteilten Auftrages überreichen?‘ fragt Maack und entnimmt einer Brieftaſche einen blütenweißen Umſchlag, den er Herrn Bär hinter ſeinem Schreibtiſch überreicht.“"
                                            },
                                            {
                                                "example_id": "57c4de1c-ea98-4848-8a02-cea4ba7eb4d2",
                                                "sense_id": "df286719-fc87-3ba4-932b-d673daeb9363",
                                                "text": "„Ihre schwarzen Samtanzüge glänzten, ihre Hemden waren blütenweiß.“"
                                            },
                                            {
                                                "example_id": "4ad6472c-1357-4fff-97e2-172583a39595",
                                                "sense_id": "df286719-fc87-3ba4-932b-d673daeb9363",
                                                "text": "„Sie trägt das prächtigste aller Kleider, golddurchwebt, schwer, die nackten Brüste sind blütenweiß.“"
                                            },
                                            {
                                                "example_id": "6223bb3e-6ab8-4b82-896a-92481511ac33",
                                                "sense_id": "df286719-fc87-3ba4-932b-d673daeb9363",
                                                "text": "„Aber ist es wirklich nötig, daß sie die Wäsche nur nach 30 oder 60 Grad sortiert und weiß und bunt gemeinsam in die Maschine stopft? Schon nach kurzer Zeit sind meine blütenweißen Dessous grau oder auch rosa, hellblau oder gelblich geworden.“"
                                            },
                                            {
                                                "example_id": "f86e64d0-6502-4c7e-8fdc-16f0b097a121",
                                                "sense_id": "df286719-fc87-3ba4-932b-d673daeb9363",
                                                "text": "„Auf den erdschwarzen Staub segelte blütenweißer Schnee herab.“"
                                            },
                                            {
                                                "example_id": "ea9921e4-dd26-46b0-9c6b-6ea4a310b7a7",
                                                "sense_id": "df286719-fc87-3ba4-932b-d673daeb9363",
                                                "text": "„Das Taschentuch in der Brusttasche ist blütenweiß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60917f17-355c-4426-831f-c16681435a67",
                        "source_entry_id": "1df6f1d2-ccd3-374d-a077-b5cecfcf7326",
                        "source_sense_id": "5cf58670-a375-3aed-90ab-029518d2273f",
                        "source_sense_description": "umgangssprachlich: sehr weiß, blütenweiß, schneeweiß",
                        "target_lang_word": "schneeweiß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schneeweiß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f4b57dd-fc9d-3f21-a98b-ae2c44128aff",
                                        "entry_id": "7b196e47-27f7-3050-87b9-2fd1beb1b955",
                                        "glosses": [
                                            "weiß wie Schnee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50647d51-aa96-4958-823d-e049f9585be3",
                                                "sense_id": "4f4b57dd-fc9d-3f21-a98b-ae2c44128aff",
                                                "text": "„Seine Partnerin, ein blutjunges Ding, auf alabasternem Hälschen das eirunde Gesichtchen, das Haar, glatt und braun, über den Ohren in Schnecken geflochten – trug das schneeweißeste Kleid von der Welt – dünne, bebende Seide.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
