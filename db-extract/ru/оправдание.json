                                                "example_id": "3dcc70d7-a21b-45cd-a206-5a5e1d24355a",
                                                "sense_id": "9f79cc17-0ded-3f6e-8301-cb287e19df14",
                                                "text": "Better manned and more strongly defenced."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2532a0a-7790-4b4b-8826-0892b81e88d4",
                        "source_entry_id": "4812f36e-affe-3ddc-b863-c4b14fd2aa63",
                        "target_lang_word": "justification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "justification",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da525cfd-dc32-3f20-a9c9-e3391629c58f",
                                        "entry_id": "d5c2c84f-db58-3bf9-af4e-ec27417c1404",
                                        "glosses": [
                                            "Action de justifier quelqu’un, de se justifier ; preuves qui servent à justifier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97589364-0807-4993-b33e-417847fc57b7",
                                                "sense_id": "da525cfd-dc32-3f20-a9c9-e3391629c58f",
                                                "text": "J’entreprendrai leur justification. - Il sera reçu, admis à sa justification. - Je veux travailler à la justification de mon père."
                                            },
                                            {
                                                "example_id": "7b56bc35-13cb-4469-b5f9-73a25cf2bab5",
                                                "sense_id": "da525cfd-dc32-3f20-a9c9-e3391629c58f",
                                                "text": "Ce mémoire contient ma justification, la justification de mes actes, de ma conduite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23776648-5cd3-3aa3-a825-1730db119d0a",
                                        "entry_id": "d5c2c84f-db58-3bf9-af4e-ec27417c1404",
                                        "glosses": [
                                            "Preuve que l’on fait de quelque chose par titres, par témoins, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87695468-70b5-468a-a473-28267928863e",
                                                "sense_id": "23776648-5cd3-3aa3-a825-1730db119d0a",
                                                "text": "La justification d’un fait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c67d3dd0-3292-369f-8832-a6451160d298",
                                        "entry_id": "d5c2c84f-db58-3bf9-af4e-ec27417c1404",
                                        "glosses": [
                                            "Action et effet de la grâce pour rendre les hommes justes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cf97948-02b3-4a43-9e3d-7813e940e0b9",
                                                "sense_id": "c67d3dd0-3292-369f-8832-a6451160d298",
                                                "text": "La justification des hommes. - La justification des pécheurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04075cc7-c427-3aff-a3a5-853c6d0ba684",
                                        "entry_id": "d5c2c84f-db58-3bf9-af4e-ec27417c1404",
                                        "glosses": [
                                            "Longueur des lignes, leur nombre dans une page."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "055fdd9a-ad8c-47b5-a375-4e196c28e33d",
                                                "sense_id": "04075cc7-c427-3aff-a3a5-853c6d0ba684",
                                                "text": "La justification prise, le compositeur prend une galée ou in-fol. ou in-4° ou in-8°. suivant le format de l’ouvrage sur lequel il va travailler, & la place sur les petites capitales de sa casse de romain."
                                            },
                                            {
                                                "example_id": "d54e2c20-b14a-45a3-a858-4944d384e9e0",
                                                "sense_id": "04075cc7-c427-3aff-a3a5-853c6d0ba684",
                                                "text": "La distance qui se trouve sur le composteur entre sa tête et la tête de la coulisse inférieure, fixe la longueur de chaque ligne ; et c’est ce qu’on nomme la Justification."
                                            },
                                            {
                                                "example_id": "aafcd742-10d8-4907-aac7-62e2670cae38",
                                                "sense_id": "04075cc7-c427-3aff-a3a5-853c6d0ba684",
                                                "text": "Justification : il s’agit de la longueur d’une ligne ou de la largeur de la colonne la plus longue d’un texte en rapport aux marges. Il en existe quatre : justifié, centré, ferré à gauche, ferré à droite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad8e20e1-a56a-33fa-abcf-3f236cf19c4e",
                                        "entry_id": "d5c2c84f-db58-3bf9-af4e-ec27417c1404",
                                        "glosses": [
                                            "Composition d’une ligne ajustée à une longueur déterminée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3005946-1f44-3c8e-9cff-a7b457304561",
                                        "entry_id": "d5c2c84f-db58-3bf9-af4e-ec27417c1404",
                                        "glosses": [
                                            "Longueur d’une ligne d’un texte justifié."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a04e04fc-72b8-4cff-a460-86babafda06e",
                        "source_entry_id": "4812f36e-affe-3ddc-b863-c4b14fd2aa63",
                        "target_lang_word": "acquittement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acquittement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3882e5c0-24b7-3ed4-b155-08d45a7950e9",
                                        "entry_id": "e0c2d9e6-2e98-3ad9-93ad-5550b91ece1a",
                                        "glosses": [
                                            "Action d’acquitter, en parlant de dettes ou d’engagements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fad4d2a7-eb81-4f14-80f4-50920c503f00",
                                                "sense_id": "3882e5c0-24b7-3ed4-b155-08d45a7950e9",
                                                "text": "Vous aurez là un ensemble … d’une poésie toute Moyen-Âge, quoique le monument n’ait été construit qu’en 1602 en acquittement d’un vœu fait quatre ans auparavant à propos de je ne sais quelle épidémie."
                                            },
                                            {
                                                "example_id": "c0cdac31-a05f-482d-a0cf-bbe35b867763",
                                                "sense_id": "3882e5c0-24b7-3ed4-b155-08d45a7950e9",
                                                "text": "L’acquittement, l’entier acquittement des dettes, des frais d’une succession."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b038e6a-0dd7-382e-a451-cbf871124c57",
                                        "entry_id": "e0c2d9e6-2e98-3ad9-93ad-5550b91ece1a",
                                        "glosses": [
                                            "Renvoi d’un accusé déclaré non coupable."
                                        ],
                                        "tags": [
                                            "Droit criminel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f593559-cffb-4eda-9673-191253764ddd",
                                                "sense_id": "2b038e6a-0dd7-382e-a451-cbf871124c57",
                                                "text": "Dans ce cas, il se peut que le seul espoir d'acquittement pour les défendeurs soit de convaincre le jury de la justesse de leur cause, et la défense politique devient alors clairement préférable."
                                            },
                                            {
                                                "example_id": "bb496887-9858-457f-9587-ef9958a57888",
                                                "sense_id": "2b038e6a-0dd7-382e-a451-cbf871124c57",
                                                "text": "M. le juge d’instruction Guillot demande, avec raison, que l’on enferme aussi étroitement ces candidats à la folie, ces demi-fous, demi-criminels, demi-responsables dont l’acquittement est arraché à la faiblesse et à la crédulité des jurys."
                                            },
                                            {
                                                "example_id": "a3b8a537-8627-4c7d-b7cb-b37c768b889f",
                                                "sense_id": "2b038e6a-0dd7-382e-a451-cbf871124c57",
                                                "text": "Gérard Chemla, avocat de parties civiles, le reconnaît : il s’attendait « à tout, notamment à d’éventuels acquittements »."
                                            },
                                            {
                                                "example_id": "b068c42f-c02c-4f56-a184-bd755dac91e4",
                                                "sense_id": "2b038e6a-0dd7-382e-a451-cbf871124c57",
                                                "text": "Dans tous ces récits des victimes apparaissent des figures protectrices, celles qui ont dit « je te crois » et qui ont agi en conséquence : une mère ou un parent, un enseignant, une policière ou un gendarme, l’avocat général à l’audience malgré l’acquittement, une psychologue ou un médecin, un éducateur, la littérature, une émission, un article dans un journal, le témoignage d’une autre victime, un groupe de parole sur l’inceste, un film, la description des troubles de stress post-traumatique. Quelqu’un, une voix, un point fixe qui permet de ne pas se croire folle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba89b627-7839-3cbf-b054-84d26aa1a7bb",
                                        "entry_id": "e0c2d9e6-2e98-3ad9-93ad-5550b91ece1a",
                                        "glosses": [
                                            "Confirmation, par l’utilisateur d’une machine, qu’il a vu et pris en compte un signal ou un message de la machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0365214f-fb50-40a9-8235-8de89e4a0d46",
                                                "sense_id": "ba89b627-7839-3cbf-b054-84d26aa1a7bb",
                                                "text": "La procédure ne peut reprendre qu’après acquittement du message d’erreur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
