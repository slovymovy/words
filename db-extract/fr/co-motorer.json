                "senses": [
                    {
                        "sense_id": "7fefdd9f-0dfb-3088-a944-e457c87b38d9",
                        "entry_id": "19962e3c-2341-3400-8eb5-0d4ec4e63995",
                        "glosses": [
                            "Partager une moto pour un déplacement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0c85564-2374-4137-b8ca-4840c8eca2b4",
                                "sense_id": "7fefdd9f-0dfb-3088-a944-e457c87b38d9",
                                "text": "Mais on peut s’organiser pour co-voiturer/co-motorer."
                            },
                            {
                                "example_id": "4cd40ec2-73bd-48f1-9369-c97e459089f3",
                                "sense_id": "7fefdd9f-0dfb-3088-a944-e457c87b38d9",
                                "text": "Est-ce que quelqu’un est dispo demain, le 13/05, à partir de 16h30 / 17h00 pour me co-motorer (ou covoiturer) de Cellieu à Tarare pour récupérer ma moto ?"
                            },
                            {
                                "example_id": "7be62504-3d29-48cc-8e08-c5335853253b",
                                "sense_id": "7fefdd9f-0dfb-3088-a944-e457c87b38d9",
                                "text": "Les participants déja pré-inscrits pour les DR Days peuvent s’inscrire ici afin de se mettre en relation pour co-motorer ou co-remorquer : certains d’entre eux se proposent de partager leur remorque ou cherche ^([sic : cherchent]) une place dans une remorque pour venir ou bien encore veulent tailler la route avec d’autres pour leur pélérinage ^([sic : pélerinage]) en terre sainte vosgienne !!"
                            }
                        ]
                    }
