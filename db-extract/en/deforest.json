                                "target_senses": [
                                    {
                                        "sense_id": "f18088cc-86db-314e-86d5-241f35c68f23",
                                        "entry_id": "4d490364-45cb-36b4-8936-e66050296a94",
                                        "glosses": [
                                            "een gebied ontdoen van het erop groeiende woud"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0a7db79-89eb-4e16-bdb3-0a6bf1ed4489",
                                                "sense_id": "f18088cc-86db-314e-86d5-241f35c68f23",
                                                "text": "In de tropen worden steeds meer streken ontbost, onder andere omdat hardhout veel opbrengt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81bc4f2d-9371-4d51-aa24-c12f8f51007c",
                        "source_entry_id": "26109246-3e02-37f6-9f97-e19549c45cc5",
                        "source_sense_description": "to clear an area of forest",
                        "target_lang_word": "déboiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déboiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0db2d46-128a-3d59-8fef-9a6a56ea4e97",
                                        "entry_id": "33808754-29be-3450-8d66-91a37d084526",
                                        "glosses": [
                                            "Dégarnir un terrain des bois qui le couvraient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ae24487-de01-4d95-91d2-809f412825f7",
                                                "sense_id": "d0db2d46-128a-3d59-8fef-9a6a56ea4e97",
                                                "text": "Ils étaient trop engagés pour faire demi-tour, et il espérait que le chemin finirait par enjamber une crête déboisée d’où il pourrait au moins découvrir un bout de route et s’orienter."
                                            },
                                            {
                                                "example_id": "05385bf3-49cf-4a86-8237-2592bbe97691",
                                                "sense_id": "d0db2d46-128a-3d59-8fef-9a6a56ea4e97",
                                                "text": "Une zone déboisée et brûlée à Manicoré, État d’Amazonas, Brésil, en septembre 2022."
                                            },
                                            {
                                                "example_id": "8479fa72-395c-43bf-af4f-3a7bafebd3f2",
                                                "sense_id": "d0db2d46-128a-3d59-8fef-9a6a56ea4e97",
                                                "text": "Depuis qu’on a déboisé, le cours des fleuves est devenu moins régulier."
                                            },
                                            {
                                                "example_id": "721e37e7-7dca-4755-b491-af420707929f",
                                                "sense_id": "d0db2d46-128a-3d59-8fef-9a6a56ea4e97",
                                                "text": "En vertu du règlement adopté l’année dernière, les entreprises qui commercialisent du soja, du bœuf, de l’huile de palme, du bois, du cacao, du café ou du caoutchouc sur le marché de l’UE doivent être en mesure de prouver que leurs produits ne proviennent pas de zones récemment déboisées ou qu’ils n’ont pas contribué à la dégradation des forêts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b65bc54f-53d5-4399-8c72-0993307f2fdb",
                        "source_entry_id": "26109246-3e02-37f6-9f97-e19549c45cc5",
