                                        "entry_id": "b5118483-be4b-383e-a5c2-fcf9b4ccabe4",
                                        "glosses": [
                                            "Pour les croyants, s’efforcer de chasser les démons du corps d’un possédé en se servant des prières et des cérémonies de l’Église."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "284d1910-647b-4726-a9ad-3aed79b22557",
                                                "sense_id": "9c319ed8-6d02-38ff-aa3d-ebfbf4af77a0",
                                                "text": "Exorciser un possédé."
                                            },
                                            {
                                                "example_id": "b8fa0283-5cfc-4fd5-8333-9ee406af7186",
                                                "sense_id": "9c319ed8-6d02-38ff-aa3d-ebfbf4af77a0",
                                                "text": "— Tes parents m'ont appris que tu ne passais pas les fêtes chez eux, ils m'ont invité, j'ai dit non, ils essaieraient encore de me faire exorciser. A la place, c'est la fête du slip à Mykonos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "883d7956-a5bd-36e2-90af-8e8ca7562001",
                                        "entry_id": "b5118483-be4b-383e-a5c2-fcf9b4ccabe4",
                                        "glosses": [
                                            "Assainir en éliminant un phénomène immatériel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87877a88-f5e5-4fca-9eab-33616694cfb9",
                                                "sense_id": "883d7956-a5bd-36e2-90af-8e8ca7562001",
                                                "text": "Emménager dans un appartement, c'est d'abord y poser son empreinte, sa patte, c'est le désenvoûter de l'anonymat, l'exorciser des présences antérieures."
                                            }
                                        ]
                                    }
                                ]
                            }
