                                        "glosses": [
                                            "Of or pertaining to calling; used in calling or vocation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7a52cfd-322a-3fa2-8e14-021403594b6a",
                                        "entry_id": "e35755bd-0f69-351a-9449-b9c015cadda6",
                                        "glosses": [
                                            "Used in address; appellative; said of the case or form of the noun, pronoun, or adjective by which a person or thing is addressed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f1442d-69f9-407d-b03d-66bcc300fa05",
                                                "sense_id": "e7a52cfd-322a-3fa2-8e14-021403594b6a",
                                                "text": "In English, the vocative may be indicated by an addressee–address separation comma, or by the particle O, as in \"What is the matter, sir?\", \"Mother, listen!\", or \"O Lord\"."
                                            }
                                        ]
                                    }
                                ]
                            },
