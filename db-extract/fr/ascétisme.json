                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d7026e3a-c210-4459-9663-8bf17c7b8f37",
                        "entry_id": "46d64973-ea5b-37d8-9f85-9353018ceb31",
                        "tags": [
                            "plural"
                        ],
                        "form": "ascétismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b043fb3-b373-3dd3-8050-2d956a6aa815",
                        "entry_id": "46d64973-ea5b-37d8-9f85-9353018ceb31",
                        "glosses": [
                            "Genre de vie des ascètes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1279b6a8-a59a-4128-bed9-bafcd78d1886",
                                "sense_id": "2b043fb3-b373-3dd3-8050-2d956a6aa815",
                                "text": "Très souvent on a fait de l’ascétisme oriental la manifestation la plus remarquable du pessimisme."
                            },
                            {
                                "example_id": "ee4670dc-83fb-4daf-bb7a-9d270e33d826",
                                "sense_id": "2b043fb3-b373-3dd3-8050-2d956a6aa815",
                                "text": "L’ascétisme de Pascal n’est pas la conséquence du christianisme de Pascal. Il en est la cause première."
                            },
                            {
                                "example_id": "ce863693-6bac-40b7-aebf-380d5c53532d",
                                "sense_id": "2b043fb3-b373-3dd3-8050-2d956a6aa815",
                                "text": "Fantasmant sur Sparte, Rousseau développe une théorie de l’aliment qui n’est pas sans faire penser au contrat social : ascétisme et sobriété, absence de fantaisie et de hasard."
                            },
                            {
                                "example_id": "86fce3b6-54da-4c39-9f00-b36495d26427",
                                "sense_id": "2b043fb3-b373-3dd3-8050-2d956a6aa815",
                                "text": "Rasé, en sabots et rêche tenue verdâtre, avec casquette de cuir coiffant sa calvitie, il passa de l’absinthe à l’abstinence, du péquet au piquet, de l’éthylisme à l’ascétisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33e34348-931e-4260-8438-3ca8f6d50994",
                        "source_entry_id": "46d64973-ea5b-37d8-9f85-9353018ceb31",
                        "source_sense_id": "2b043fb3-b373-3dd3-8050-2d956a6aa815",
                        "target_lang_word": "Askese",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Askese",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4cc1a561-8c6d-3b3e-b9df-798ed62cd35a",
                                        "entry_id": "a6fc3779-9c96-306b-92bc-e0baeec35b6c",
                                        "glosses": [
                                            "streng enthaltsame Lebensweise"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c5d221a-d104-4215-9471-a020c8d530cd",
                                                "sense_id": "4cc1a561-8c6d-3b3e-b9df-798ed62cd35a",
                                                "text": "Die Askese bekam ihnen nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "90268fbf-2230-3f44-a394-bb6d721251e1",
                                        "entry_id": "a6fc3779-9c96-306b-92bc-e0baeec35b6c",
                                        "glosses": [
                                            "streng enthaltsames Leben verbunden mit dem Ziel des Seelenheils"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d01be3d-6399-4c58-89c0-5e0fe549c699",
                                                "sense_id": "90268fbf-2230-3f44-a394-bb6d721251e1",
                                                "text": "Der Mönch verbrachte sein gesamtes Leben in Askese."
                                            },
                                            {
                                                "example_id": "14962960-1a9b-42d3-9e8e-3d5582e41f7e",
                                                "sense_id": "90268fbf-2230-3f44-a394-bb6d721251e1",
                                                "text": "„Der biedere Küan fand bei dem heiligen Einsiedler tatsächlich Aufnahme und gelangte in zwanzig Jahren harter Askese zur Vollendung.“"
                                            },
                                            {
                                                "example_id": "774354a1-f435-4ad4-8406-c07627fccc06",
                                                "sense_id": "90268fbf-2230-3f44-a394-bb6d721251e1",
                                                "text": "„Mit der Vergeblichkeit der Askese hat sich Busch immer wieder beschäftigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7eec748-19dd-49b4-9e1f-399d9c243592",
