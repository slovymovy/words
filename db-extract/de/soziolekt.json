                        ],
                        "form": "den Soziolekt"
                    },
                    {
                        "form_id": "8de86899-a12b-472e-b090-1dae662ab7e6",
                        "entry_id": "ac07878f-0414-39d7-86de-8b5a4bafe6af",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Soziolekte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "532a5101-2fa4-3693-ba3f-32e9cc108d83",
                        "entry_id": "ac07878f-0414-39d7-86de-8b5a4bafe6af",
                        "glosses": [
                            "besondere Sprachform, charakteristische Sprachverwendung einer durch soziale Eigenschaften wie Geschlecht, Einkommen et cetera definierten Menge von Mitgliedern einer Sprachgemeinschaft"
                        ],
                        "tags": [
                            "speziell Soziolinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "cb4f7399-ae40-4d69-82be-57b86e3fd471",
                                "sense_id": "532a5101-2fa4-3693-ba3f-32e9cc108d83",
                                "text": "Soziolekte sind z.B. die Gruppensprachen von Mitgliedern der Mittel- oder der Oberschicht, der jungen und der alten Menschen, etc."
                            },
                            {
                                "example_id": "8bec78d1-29af-4f65-9cde-6b698f736886",
                                "sense_id": "532a5101-2fa4-3693-ba3f-32e9cc108d83",
                                "text": "„Auch die Sprache einer sozialen Klasse (Soziolekt) ist eine Gruppensprache.“"
                            },
                            {
                                "example_id": "3b237adf-e5ba-4da2-a79c-d13c68c52ebb",
                                "sense_id": "532a5101-2fa4-3693-ba3f-32e9cc108d83",
                                "text": "„Als solche Varietäten können die historisch gebundenen, die Historiolekte, und die Soziolekte als regional und historisch bestimmte Varietäten aufgefaßt werden.“"
                            },
                            {
                                "example_id": "37103467-44ce-4fb3-a65d-89743041bce8",
                                "sense_id": "532a5101-2fa4-3693-ba3f-32e9cc108d83",
                                "text": "„Die Existenz von Soziolekten (und anderen Varietäten) hat unmittelbare Bedeutung für den Sprachwandel, denn diese Subsysteme sind Ausdruck genereller Merkmale der Sprache und der sprachlichen Kommunikation…“"
                            },
                            {
                                "example_id": "0eab407a-ba73-4588-8589-156815d2d053",
                                "sense_id": "532a5101-2fa4-3693-ba3f-32e9cc108d83",
                                "text": "„In der Tradition der germanistischen Lexikologie findet man außer dem nur vereinzelt berücksichtigten sogenannten Register als der situationsbezogenen Varietät vor allem die Dialekte, Historiolekte und Soziolekte als die geographisch (diatopisch), historisch (diachronisch) und sozial (diastratisch) dimensionierten Varietäten behandelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "471a6f4a-f07d-455c-8c25-61a3a71c2372",
                        "source_entry_id": "ac07878f-0414-39d7-86de-8b5a4bafe6af",
                        "source_sense_id": "532a5101-2fa4-3693-ba3f-32e9cc108d83",
                        "source_sense_description": "Sprachform einer sozialen Gruppe",
                        "target_lang_word": "sociolect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sociolect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2aab9204-1e43-3d33-8646-8551cf843daa",
                                        "entry_id": "f9fe4a06-30b2-3de5-a282-30c43c82f736",
                                        "glosses": [
                                            "The variant of language used by a social group such as a socioeconomic class, an ethnic group, an age group, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e97499d2-64b7-476a-8802-b5bcbf5f2042",
                                                "sense_id": "2aab9204-1e43-3d33-8646-8551cf843daa",
                                                "text": "The French literary critic Roland Barthes has paid special attention to the relationship between the individual language (\"idiolect\") and the language of a collective of speech (\"sociolect\"). Public life is characterized by \"social multilingualism.\" There are a number of languages, such as the language of the church, the language of the prison, the language of the children, the language of the ruling elite, and other \"social languages.\""
                                            },
                                            {
                                                "example_id": "674beb8f-0531-4823-a5a8-7887c4f278e2",
                                                "sense_id": "2aab9204-1e43-3d33-8646-8551cf843daa",
                                                "text": "[…] I believe that it is mistaken to maintain that the language of ideology is a discrete ‘sociolect’, a sort of meta-language which draws upon but remains distinct from the language of everyday life."
                                            },
                                            {
                                                "example_id": "aa42bb3e-faee-45c7-8bea-cd2402a6dc0e",
                                                "sense_id": "2aab9204-1e43-3d33-8646-8551cf843daa",
                                                "text": "This paper uses sociolect as a cover term for slang, technical jargon (professionalisms), and argot. From the point of view of its secret nature, two kinds of sociolects are distinguished: slang and technical jargon on the one hand, and argot on the other, with the difference being in the presence or lack of an intention of secrecy.",
                                                "translation": "What is Slang? Studies on the Concept of Slang",
                                                "english": "What is Slang? Studies on the Concept of Slang"
                                            },
                                            {
                                                "example_id": "8aceb4ce-bc62-4ab5-a855-196790934a29",
                                                "sense_id": "2aab9204-1e43-3d33-8646-8551cf843daa",
                                                "text": "In sociolinguistics, a sociolect or social dialect is a variety of language (a register) associated with a social group such as a socioeconomic class, an ethnic group (precisely termed ethnolect), an age group, etc. Sociolects involve both passive acquisition of particular communicative practices through association with a local community, as well as active learning and choice among speech or writing forms to demonstrate identification with particular grounds. Sociolinguists define a sociolect by examining the social distribution of specific linguistic terms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e062d74-4b55-4c9c-984d-993c28556ed1",
                        "source_entry_id": "ac07878f-0414-39d7-86de-8b5a4bafe6af",
                        "source_sense_id": "532a5101-2fa4-3693-ba3f-32e9cc108d83",
                        "source_sense_description": "Sprachform einer sozialen Gruppe",
                        "target_lang_word": "social dialect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
