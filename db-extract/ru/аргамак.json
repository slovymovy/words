        "fr-extract.jsonl": [
            {
                "entry_id": "f8fc5ae1-bd87-3e77-b2c9-788dded61fbf",
                "word": "аргамак",
                "pos": "noun",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0f206b1b-1453-33f3-923a-8aa5ce313320",
                        "entry_id": "f8fc5ae1-bd87-3e77-b2c9-788dded61fbf",
                        "glosses": [
                            "Akhal-Teké."
                        ],
                        "tags": [
                            "Hippologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c7f300c1-eee7-4b0d-b376-9bbab45373b5",
                                "sense_id": "0f206b1b-1453-33f3-923a-8aa5ce313320",
                                "text": "Аргама́к м. встарь, рослая и дорогая азиатская лошадь, под-верх; кабардинские и трухменские аргамаки известны у нас доныне; последние узкогруды, поджары, ходулеваты, почему аргамаком и аргамачи́хой, в шутку, называют высокого и худощавого, неуклюжего человека.",
                                "translation": "Argamak m. vieux cheval asiatique grand et cher ; les argamaks kabardes et trukhmen nous sont connus à ce jour ; ces derniers sont à la poitrine étroite, minces, guindés, c'est pourquoi on appelle, en plaisantant, une personne grande, mince et maladroite argamak et argamatchikh."
                            },
                            {
                                "example_id": "ad6d17d1-4c92-470c-a67b-7e27cfc79b22",
                                "sense_id": "0f206b1b-1453-33f3-923a-8aa5ce313320",
                                "text": "Карабаир — весьма известная в Средней Азии порода лошадей, происшедшая от помеси туркменской лошади (аргамак) с киргизской.",
                                "translation": "Le karabair est une race de cheval très célèbre en Asie centrale, issue d'un croisement entre un cheval turkmène (argamak) et un cheval kirghize."
                            }
                        ]
                    }
                ],
