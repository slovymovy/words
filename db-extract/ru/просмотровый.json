                "senses": [
                    {
                        "sense_id": "62b59449-7d72-31ab-a343-2a763fa79de7",
                        "entry_id": "445a72b4-5334-3d21-8bac-0781c5cf4033",
                        "glosses": [
                            "предназначенный, служащий для просмотра, ознакомления с чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2cfc03c-577a-404c-a911-37add8491cf6",
                                "sense_id": "62b59449-7d72-31ab-a343-2a763fa79de7",
                                "text": "Телеметрия тогда записывалась на фотопленки, смотреть которые надо было на специальном просмотровом столике с подсветкой."
                            },
                            {
                                "example_id": "5af5a060-ce2c-4644-a6d7-1878df1cddf7",
                                "sense_id": "62b59449-7d72-31ab-a343-2a763fa79de7",
                                "text": "Лупа просмотровая — для просмотра деталей, мелких предметов и т. д."
                            },
                            {
                                "example_id": "240bf83d-b559-4c9b-89d3-165aa723747e",
                                "sense_id": "62b59449-7d72-31ab-a343-2a763fa79de7",
                                "text": "Просмотровая зона детектора позволяет проверять банкноты, разложенные веером."
                            }
                        ]
                    }
