                "senses": [
                    {
                        "sense_id": "31c606bd-45c0-3338-898d-4d2c2791e6ff",
                        "entry_id": "0079d1c7-3d20-328c-8e2c-7845de5d26c5",
                        "glosses": [
                            "Personne qui vend au détail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbae208a-99d0-47d5-a8b1-e4189cb54e84",
                                "sense_id": "31c606bd-45c0-3338-898d-4d2c2791e6ff",
                                "text": "Il rêvait une alliance, une entente des petits détaillants pour tenir tête au colosse."
                            },
                            {
                                "example_id": "489af11a-ae6e-4cd0-8554-cc2fa39c9cba",
                                "sense_id": "31c606bd-45c0-3338-898d-4d2c2791e6ff",
                                "text": "Les petits détaillants vendent ici à l'hectogramme, comme en Italie, et non au « quart » (125 grammes), comme en France."
                            },
                            {
                                "example_id": "66a374c5-5021-4ddc-9395-6fc11725c32e",
                                "sense_id": "31c606bd-45c0-3338-898d-4d2c2791e6ff",
                                "text": "Un marchand détaillant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d43158b-7533-4bd8-89fd-a7474578f160",
                        "source_entry_id": "0079d1c7-3d20-328c-8e2c-7845de5d26c5",
                        "source_sense_id": "31c606bd-45c0-3338-898d-4d2c2791e6ff",
                        "target_lang_word": "Einzelhändler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einzelhändler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b80574b-30c4-352a-a0e9-56dfbd38e84c",
                                        "entry_id": "0042ce6e-977e-3623-aa48-ce9858a2df8d",
                                        "glosses": [
                                            "Person oder Firma, die Waren ohne weitere Be- oder Verarbeitung an die Verbraucher verkauft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8706bf47-dec6-4c66-83f8-23759ce35ce4",
                                                "sense_id": "2b80574b-30c4-352a-a0e9-56dfbd38e84c",
                                                "text": "Der Einzelhändler verkauft die Teppiche an die Endverbraucher."
                                            },
                                            {
                                                "example_id": "265b077b-cace-41aa-a10d-62bf8f044fc0",
                                                "sense_id": "2b80574b-30c4-352a-a0e9-56dfbd38e84c",
                                                "text": "„Plötzlich machte er damit ein richtig gutes Geschäft, obwohl er eigentlich nur Einzelhändler war.“"
                                            },
                                            {
                                                "example_id": "5542e0de-c642-4e68-a1d0-6e5ef8d4a208",
                                                "sense_id": "2b80574b-30c4-352a-a0e9-56dfbd38e84c",
                                                "text": "„Das neu entwickelte Fachmarktzentrum auf dem früheren Baumax-Standort im Gewerbepark Stadlau ist langfristig an Einzelhändler wie Intersport, TK Maxx, Lidl, dm und ccc shoes vermietet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
