{
    "word_family": [
        "voorkomend",
        "voorkomenheid",
        "onvoorkomend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a1a8666-81d1-3048-b400-08710a782d3f",
                    "sense_definition": "bestaan of op een bepaalde plaats of in een bepaalde situatie aangetroffen worden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bestaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze zeldzame vogelsoort <w>komt</w> alleen in dit specifieke natuurgebied <w>voor</w>.",
                            "target_lang_translations": {
                                "en": "This rare bird species only <w>occurs</w> in this specific nature reserve."
                            }
                        },
                        {
                            "text": "Het is bekend dat dit chemische element in de vrije natuur <w>voorkomt</w>.",
                            "target_lang_translations": {
                                "en": "It is known that this chemical element <w>is found</w> in the wild."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in de natuur voorkomen",
                        "veelvuldig voorkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "to exist or be found in a particular place or situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "occur",
                                "target_lang_sense_clarification": "to be present or found in a specific context"
                            },
                            {
                                "target_lang_word": "be found",
                                "target_lang_sense_clarification": "to exist in a certain location"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b8a7239-f048-3aa6-9f01-0db625accec2",
                    "sense_definition": "ervoor zorgen dat iets ongewenst niet gebeurt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verhinderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten maatregelen nemen om te <w>voorkomen</w> dat het virus zich verder verspreidt.",
                            "target_lang_translations": {
                                "en": "We must take measures to <w>prevent</w> the virus from spreading further."
                            }
                        },
                        {
                            "text": "Een goede voorbereiding kan veel problemen <w>voorkomen</w> tijdens de reis.",
                            "target_lang_translations": {
                                "en": "Good preparation can <w>avoid</w> many problems during the trip."
                            }
                        }
                    ],
                    "synonyms": [
                        "preveniëren"
                    ],
                    "common_phrases": [
                        "problemen voorkomen",
                        "erger voorkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "to ensure that something undesirable does not happen"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prevent",
                                "target_lang_sense_clarification": "to stop an outcome from happening"
                            },
                            {
                                "target_lang_word": "avoid",
                                "target_lang_sense_clarification": "to keep away from or stop something from occurring"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ae0a242-89eb-3d5e-988e-bf08bc05e6d7",
                    "sense_definition": "gebeuren of plaatsvinden",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gebeuren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>komt</w> wel eens <w>voor</w> dat de trein een paar minuten vertraging heeft.",
                            "target_lang_translations": {
                                "en": "It sometimes <w>happens</w> that the train is delayed by a few minutes."
                            }
                        },
                        {
                            "text": "Dergelijke fouten <w>komen</w> helaas vaker <w>voor</w> dan we zouden willen.",
                            "target_lang_translations": {
                                "en": "Such errors unfortunately <w>occur</w> more often than we would like."
                            }
                        }
                    ],
                    "common_phrases": [
                        "het komt voor dat",
                        "vaak voorkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "to happen or take place"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "happen",
                                "target_lang_sense_clarification": "to occur or take place"
                            },
                            {
                                "target_lang_word": "occur",
                                "target_lang_sense_clarification": "to take place, especially of events"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0700f432-23ab-3b7e-9baf-14d223787173",
                    "sense_definition": "een bepaalde indruk maken op iemand; lijken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indruk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>kwam</w> mij nogal vreemd <w>voor</w> dat hij gisteren niet op het feestje was.",
                            "target_lang_translations": {
                                "en": "It <w>seemed</w> rather strange to me that he wasn't at the party yesterday."
                            }
                        },
                        {
                            "text": "Zijn gedrag <w>komt</w> nogal onbeleefd <w>voor</w> bij de rest van de groep.",
                            "target_lang_translations": {
                                "en": "His behavior <w>appears</w> quite rude to the rest of the group."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vreemd voorkomen",
                        "bekend voorkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a certain impression on someone; to seem"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "seem",
                                "target_lang_sense_clarification": "to appear to be or give an impression"
                            },
                            {
                                "target_lang_word": "appear",
                                "target_lang_sense_clarification": "to look a certain way to someone"
                            },
                            {
                                "target_lang_word": "strike",
                                "target_lang_sense_clarification": "to create a specific impression (e.g., it strikes me as...)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ac743e6-84f0-3d62-8a7d-743e25316a6e",
                    "sense_definition": "officieel voor een rechter of rechtbank moeten verschijnen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "juridisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verdachte moet volgende week dinsdag voor de politierechter <w>voorkomen</w>.",
                            "target_lang_translations": {
                                "en": "The suspect must <w>appear</w> before the police magistrate next Tuesday."
                            }
                        },
                        {
                            "text": "Zijn zaak <w>komt</w> pas over drie maanden <w>voor</w> bij de rechtbank.",
                            "target_lang_translations": {
                                "en": "His case will not <w>be heard</w> in court for another three months."
                            }
                        }
                    ],
                    "common_phrases": [
                        "voor de rechter voorkomen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "juridische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to have to appear officially before a judge or court"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "appear",
                                "target_lang_sense_clarification": "to stand before a court or authority"
                            },
                            {
                                "target_lang_word": "be heard",
                                "target_lang_sense_clarification": "of a legal case, to be presented in court"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9053bacc-f877-3883-ac62-cd7bfc82ffe3",
                    "sense_definition": "de uiterlijke verschijning of de manier waarop iemand zich presenteert",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn verzorgde <w>voorkomen</w> maakte direct een goede indruk tijdens het sollicitatiegesprek.",
                            "target_lang_translations": {
                                "en": "His well-groomed <w>appearance</w> immediately made a good impression during the job interview."
                            }
                        },
                        {
                            "text": "Zij heeft een zeer gedistingeerd <w>voorkomen</w> dat respect afdwingt.",
                            "target_lang_translations": {
                                "en": "She has a very distinguished <w>presence</w> that commands respect."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een verzorgd voorkomen",
                        "uiterlijk voorkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "the outward appearance or the way someone presents themselves"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "appearance",
                                "target_lang_sense_clarification": "the way that someone or something looks"
                            },
                            {
                                "target_lang_word": "presence",
                                "target_lang_sense_clarification": "the impressive manner or appearance of a person"
                            },
                            {
                                "target_lang_word": "demeanor",
                                "target_lang_sense_clarification": "outward behavior or bearing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}