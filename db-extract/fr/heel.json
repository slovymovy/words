                                    {
                                        "sense_id": "eede17a6-58b0-38e7-8932-05ace2ab37a2",
                                        "entry_id": "fc304141-2988-3b9a-bced-a7cea0ae6f88",
                                        "glosses": [
                                            "The part of the palm of a hand closest to the wrist."
