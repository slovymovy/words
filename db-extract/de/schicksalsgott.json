                "senses": [
                    {
                        "sense_id": "a301de62-d861-37f2-a532-57d0b27ab359",
                        "entry_id": "98141522-0de7-35bf-aacc-43d77528b231",
                        "glosses": [
                            "Gottesgestalt, der in einer Mythologie die Rolle zukommt, das Schicksal der Menschen zu bestimmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13f31467-5eda-44e4-8613-e6d7939e6e63",
                                "sense_id": "a301de62-d861-37f2-a532-57d0b27ab359",
                                "text": "„Wenn der Schicksalsgott erscheint, dann nimmt das Leben eine Wende – es kann Glück bedeuten, aber auch großes Unglück.“"
                            },
                            {
                                "example_id": "64efbb95-004a-4625-9704-d75a053723b9",
                                "sense_id": "a301de62-d861-37f2-a532-57d0b27ab359",
                                "text": "„Die Götter bemitleideten ihn, die Schicksalsgötter aber verfügten über ihn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
