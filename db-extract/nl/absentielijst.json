                "senses": [
                    {
                        "sense_id": "6ff6fa8d-932e-3e97-b348-650d698c19e3",
                        "entry_id": "e0d92cee-3aa6-372a-b9b8-c186c0a9bc3d",
                        "glosses": [
                            "lijst met namen van hen die afwezig zijn (waardoor je ook kunt weten wie er wel aanwezig zijn)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3d34212-50ca-4169-bfaf-5c52c7b0f9a6",
                                "sense_id": "6ff6fa8d-932e-3e97-b348-650d698c19e3",
                                "text": "Omdat de app is gekoppeld aan het onderwijssysteem van veel scholen, hoeven roosters, cijfers en absentielijsten niet meer zelf te worden ingevuld."
                            },
                            {
                                "example_id": "98355453-d7ee-49af-9f52-7bc5d77e1908",
                                "sense_id": "6ff6fa8d-932e-3e97-b348-650d698c19e3",
                                "text": "Onze mindere klassering ligt niet aan mij. Niet dat ik nu zo ontzettend goed ben, het is meer dat ik de afgelopen maanden, tot afgelopen zondag, vooral op de absentielijst stond. Tijdens de verbouwing moest ik elke weekend klussen en kon ik dus niet als een jonge hinde in de wei achter de bal aan huppelen. Ik heb het gemist."
                            }
                        ]
                    }
