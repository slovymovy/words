        "fr-extract.jsonl": [
            {
                "entry_id": "ee16128e-bdb3-3b0d-bf42-df299acd4783",
                "word": "tonus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3c3dc500-3eee-3ee9-921a-934d2e6a0c59",
                        "entry_id": "ee16128e-bdb3-3b0d-bf42-df299acd4783",
                        "glosses": [
                            "Tension, contraction légère et permanente, tenue des muscles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a5d1e0f-f289-49d2-8f37-84517e3cad97",
                                "sense_id": "3c3dc500-3eee-3ee9-921a-934d2e6a0c59",
                                "text": "Le tonus musculaire est l'état de tension permanente et légère de certains muscles afin de s'opposer à l'action de la gravité sur le corps humain. Ceci permet le maintien de la posture (équilibre)."
                            },
                            {
                                "example_id": "df67409a-2c7e-4ba1-bf05-bb41e771f39e",
                                "sense_id": "3c3dc500-3eee-3ee9-921a-934d2e6a0c59",
                                "text": "Le tonus postural est le degré de tension des muscles antérieurs et postérieurs antigravitaires."
                            },
                            {
                                "example_id": "96dfdbe5-b9f7-48a2-af5c-9683188e719e",
                                "sense_id": "3c3dc500-3eee-3ee9-921a-934d2e6a0c59",
                                "text": "Le tonus psychologique est la tension psychique légère et d'éveil nécessaires au fonctionnement satisfaisant des activités mentales."
                            }
                        ]
                    },
                    {
                        "sense_id": "80a2580c-5d67-356d-bdfd-6a3112a6a8d5",
                        "entry_id": "ee16128e-bdb3-3b0d-bf42-df299acd4783",
                        "glosses": [
                            "Énergie."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8b27f93a-67cf-4e2d-8242-8f4be45dba0f",
                                "sense_id": "80a2580c-5d67-356d-bdfd-6a3112a6a8d5",
                                "text": "Avoir du tonus, manquer de tonus."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c904a7d-d483-34df-ae3f-9d15d3b1a22b",
                        "entry_id": "ee16128e-bdb3-3b0d-bf42-df299acd4783",
                        "glosses": [
                            "Soirée ou bal étudiant organisé par les élèves."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a83b357a-2788-4487-83a5-c6d307497adf",
                                "sense_id": "3c904a7d-d483-34df-ae3f-9d15d3b1a22b",
                                "text": "Dans le même temps, la participation aux tonus (bals) étudiants, beaucoup plus intégrés dans les rythmes de travail de ces écoles et de ces facs, se distribue de façon inverse"
                            },
                            {
                                "example_id": "fe58f4dd-efe5-4865-9a75-cfe537546b47",
                                "sense_id": "3c904a7d-d483-34df-ae3f-9d15d3b1a22b",
                                "text": "20 août 1941 – Dans le deuxième canoë, il y avait un étudiant en médecine qui avait échoué trois fois à l’externat et pour qui l’hôpital se résumait à la salle de garde et aux tonus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4914fe31-9da2-4f39-a1ab-c697bd5963e1",
                        "source_entry_id": "ee16128e-bdb3-3b0d-bf42-df299acd4783",
                        "target_lang_word": "Tonus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tonus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a8687d2-faac-3160-ba75-91b2c61a5594",
                                        "entry_id": "e5a8078d-e03a-3456-aaa3-35c847b5706c",
                                        "glosses": [
                                            "Grad des ständigen Spannungszustandes von lebendem Gewebe, Organen oder Organteilen, insbesondere der Muskeln, Gefäße und Nerven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6e5ac68-6189-4e3a-9805-f7c5ff60cf68",
                                                "sense_id": "2a8687d2-faac-3160-ba75-91b2c61a5594",
                                                "text": "Tonische Muskulatur hielt man bisher für ein System, das den Tonus (Spannungszustand) eines relaxierten Körpers aufrecht erhält, damit er nicht in sich zusammensackt."
                                            },
                                            {
                                                "example_id": "823aaab9-4bef-433a-a1fa-e0a86868d3cf",
                                                "sense_id": "2a8687d2-faac-3160-ba75-91b2c61a5594",
                                                "text": "Aus Tierversuchen und der klinischen Praxis ist bekannt, dass Epo viel mehr bewirkt, als die roten Blutkörperchen zu vermehren. Es steigert den Blutdruck und den Tonus der Blutgefäße, fördert die Bildung feinster Blutgefäße in Muskeln und Gehirn."
                                            },
                                            {
                                                "example_id": "2671076e-2896-40e4-9bf4-9741fda3b1e4",
                                                "sense_id": "2a8687d2-faac-3160-ba75-91b2c61a5594",
                                                "text": "Durch das vorsichtige Auseinanderziehen des Muskels wird der Tonus gesenkt, der Muskel entspannt."
                                            },
                                            {
                                                "example_id": "193cc7d8-b8fe-4938-ab0e-a652e317f46d",
                                                "sense_id": "2a8687d2-faac-3160-ba75-91b2c61a5594",
                                                "text": "„Da alle Bewegungen des Körpers eine gewisse Spannungslage der Muskulatur erfordern, beeinflusst der Tonus also auch die Stimmgebung unmittelbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "358a3bcc-7783-33d6-86ab-ea8db4449147",
                                        "entry_id": "e5a8078d-e03a-3456-aaa3-35c847b5706c",
                                        "glosses": [
                                            "ein Ganzton"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b7dd6a5-c597-4014-8758-01f38cc40ab2",
                                                "sense_id": "358a3bcc-7783-33d6-86ab-ea8db4449147",
                                                "text": "Die Oktave kann aber auch durch zwei Quarten geteilt werden, wobei zwischen diese ein Ganzton geschoben wird, der sogenannte Tonus, also Oktave = Quart · Tonus · Quart (3/4 · 8/9 · 3/4 = 72/144 = 1/2)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "18ffdaf5-c578-3666-bca7-18eed167f40f",
                                        "entry_id": "e5a8078d-e03a-3456-aaa3-35c847b5706c",
                                        "glosses": [
                                            "der Zustand der Empfindlichkeit von Pflanzen gegenüber Umweltreizen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e132d8f1-c4a5-4205-895a-a40592d35a26",
                                                "sense_id": "18ffdaf5-c578-3666-bca7-18eed167f40f",
                                                "text": "In Versuchen mit Pflanzen habe ich bei verschiedenen Serien ähnlicher Keimlinge den Tonus künstlich beeinflußt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce05aff4-ed0e-4c2d-a0d1-d6ac54da77bb",
                        "source_entry_id": "ee16128e-bdb3-3b0d-bf42-df299acd4783",
                        "target_lang_word": "tonus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tonus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fac08973-8628-3d5f-8414-de0d1b5fb900",
                                        "entry_id": "afb6f094-f74d-31ab-b376-465aebddb8ca",
                                        "glosses": [
                                            "tonicity; tone"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57443888-6581-4647-8f9f-97b8e0240aa5",
                                                "sense_id": "fac08973-8628-3d5f-8414-de0d1b5fb900",
                                                "text": "muscular tonus"
                                            },
                                            {
                                                "example_id": "1e1375b4-8090-478e-bf5e-61159b273dd1",
                                                "sense_id": "fac08973-8628-3d5f-8414-de0d1b5fb900",
                                                "text": "The amount of stretch possible increases with the range in the joint and decreases with the cross section of the muscle and the amount of tonus or contraction in these antagonists ."
                                            },
                                            {
                                                "example_id": "217925ea-62c5-45dc-9ef2-c47c5ba23d60",
                                                "sense_id": "fac08973-8628-3d5f-8414-de0d1b5fb900",
                                                "text": "Dr. H. S. Sullivan, for example, is known to many for his acute understanding of the postural tonuses of his patients."
                                            },
                                            {
                                                "example_id": "d664470c-a548-4cdf-9613-96a54790ac8d",
                                                "sense_id": "fac08973-8628-3d5f-8414-de0d1b5fb900",
                                                "text": "At the same time, from the vasomotor point of view the artrioles are an extremely active part of the vascular bed , and every important change in the peripheral resistance is traceable to a corresponding change in the tonus of the arterioles ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bb1308f-e5c2-3f21-8716-89495c8a8c6f",
                                        "entry_id": "afb6f094-f74d-31ab-b376-465aebddb8ca",
                                        "glosses": [
                                            "A tonal system or mode used in Gregorian chant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79cb66d3-3c4b-4d77-a4e0-02004bb0d190",
                                                "sense_id": "0bb1308f-e5c2-3f21-8716-89495c8a8c6f",
                                                "text": "Aurelian associates antiphons and toni of the plain chant, so that the octave-based Pythagorean scale is exemlified by means of the liturgical chant, with the outstanding consequence that church music becomes the sounding representation of the harmony of the spherese and of human beings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbe956cf-9359-47f9-991d-4296f3c0e473",
