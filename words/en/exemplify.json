{
    "word_family": [
        "example",
        "exemplification",
        "exemplary"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8e01de6f-9d70-3e76-9ccb-ce4b853faa1a",
                    "sense_definition": "To be a typical example or perfect model of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "represent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her dedication and hard work best <w>exemplify</w> the core values of our company.",
                            "target_lang_translations": {
                                "ru": "Её преданность делу и трудолюбие лучше всего <w>олицетворяют</w> ключевые ценности нашей компании."
                            }
                        },
                        {
                            "text": "The new design aims to <w>exemplify</w> perfection in modern architecture.",
                            "target_lang_translations": {
                                "ru": "Новый дизайн призван <w>служить примером</w> совершенства в современной архитектуре."
                            }
                        }
                    ],
                    "synonyms": [
                        "typify",
                        "epitomize",
                        "represent"
                    ],
                    "common_phrases": [
                        "exemplify perfection",
                        "exemplify the spirit",
                        "best exemplify"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служить типичным примером или идеальным воплощением чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "служить примером",
                                "target_lang_sense_clarification": "быть образцом или наглядным выражением"
                            },
                            {
                                "target_lang_word": "олицетворять",
                                "target_lang_sense_clarification": "воплощать в себе определенные качества или ценности"
                            },
                            {
                                "target_lang_word": "воплощать",
                                "target_lang_sense_clarification": "являться живым выражением идеи или принципа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc23e8a2-cf9b-37ae-8552-2df4b3c71345",
                    "sense_definition": "To clarify or show something clearly by providing an example.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "illustrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor used several simple diagrams to <w>exemplify</w> the complex scientific process.",
                            "target_lang_translations": {
                                "ru": "Профессор использовал несколько простых схем, чтобы <w>проиллюстрировать</w> сложный научный процесс."
                            }
                        },
                        {
                            "text": "He chose to <w>exemplify</w> the concept with a real-life case study.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>пояснить на примере</w> эту концепцию с помощью анализа реальной ситуации."
                            }
                        }
                    ],
                    "synonyms": [
                        "illustrate",
                        "demonstrate"
                    ],
                    "common_phrases": [
                        "exemplify a concept",
                        "exemplify with examples"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пояснять или наглядно показывать что-либо с помощью примера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иллюстрировать",
                                "target_lang_sense_clarification": "наглядно пояснять примером"
                            },
                            {
                                "target_lang_word": "показывать на примере",
                                "target_lang_sense_clarification": "демонстрировать суть через конкретный случай"
                            },
                            {
                                "target_lang_word": "демонстрировать",
                                "target_lang_sense_clarification": "наглядно разъяснять или доказывать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2066eaf-d6d4-3654-9cde-c1cd81bc50dd",
                    "sense_definition": "To make an official, attested copy of an official document under seal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_copy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court was asked to <w>exemplify</w> the official legal document for foreign recognition.",
                            "target_lang_translations": {
                                "ru": "Суд попросили <w>заверить официальной печатью копию</w> юридического документа для признания за рубежом."
                            }
                        },
                        {
                            "text": "The attorney arranged to <w>exemplify</w> the document before submitting it to the consulate.",
                            "target_lang_translations": {
                                "ru": "Адвокат организовал <w>нотариальное заверение с гербовой печатью</w> документа перед подачей его в консульство."
                            }
                        }
                    ],
                    "common_phrases": [
                        "exemplify a document"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used primarily in formal or legal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изготавливать официально заверенную копию документа с гербовой печатью (в праве)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заверять официальной печатью",
                                "target_lang_sense_clarification": "делать нотариально или судебно заверенную копию"
                            },
                            {
                                "target_lang_word": "скреплять печатью",
                                "target_lang_sense_clarification": "удостоверять копию документа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c41d379-0310-332f-896f-6a983cea1209",
                    "sense_definition": "To prove or authenticate a legal matter using an official attested copy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_proof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer needed to <w>exemplify</w> the claim by presenting a certified legal transcript.",
                            "target_lang_translations": {
                                "ru": "Адвокату потребовалось <w>подтвердить</w> претензию, представив заверенную судебную стенограмму."
                            }
                        },
                        {
                            "text": "They were able to <w>exemplify</w> the agreement in court using authenticated papers.",
                            "target_lang_translations": {
                                "ru": "Они смогли <w>удостоверить</w> соглашение в суде с помощью заверенных документов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "exemplify the claim"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used primarily in legal terminology."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Доказывать или удостоверять юридический факт с помощью официальной заверенной копии документа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удостоверять",
                                "target_lang_sense_clarification": "подтверждать подлинность юридическим документом"
                            },
                            {
                                "target_lang_word": "подтверждать заверенной копией",
                                "target_lang_sense_clarification": "доказывать факт официальным документом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}