                        "examples": [
                            {
                                "example_id": "f0f242a7-fdb9-45ad-afcd-39013136faff",
                                "sense_id": "74fec6dc-627e-3a3d-a414-acd0a5cbc4a3",
                                "text": "He was bearded, blunt, thickset, and he wore gold-rimmed spectacles. In his bourrue-bienfaisance, in his honesty, and in his brusque insuavity towards such as would compel his sympathy without justification, he was the very type of the dogmatic family doctor—of the gruffly practical allopathist of the old school."
                            },
                            {
                                "example_id": "154508d4-5f2b-4f5c-b185-399326e89351",
                                "sense_id": "74fec6dc-627e-3a3d-a414-acd0a5cbc4a3",
                                "text": "Bradly squatted on the flat rock to wash his legs, saying gruffly to Podson, \"Better wash that dam' mud off; it sticks like hell when it's dry.\""
                            },
                            {
                                "example_id": "a7e33f27-2849-4a8f-89fb-93843f423ecf",
                                "sense_id": "74fec6dc-627e-3a3d-a414-acd0a5cbc4a3",
                                "text": "'Hey, what's that?' he exclaimed gruffly, staring searchingly at her as he took her hand."
                            }
                        ]
                    }
