                                                "text": "missing data point"
                                            },
                                            {
                                                "example_id": "2261116b-71c8-4782-9c64-ca6390e87d31",
                                                "sense_id": "4b0bcfbd-7751-38c0-9b9a-b1c04d365775",
                                                "text": "Joe went missing last year. He had all teeth missing when he was finally found."
                                            },
                                            {
                                                "example_id": "98f0ba02-0c4e-493a-b909-28a72ee629c5",
                                                "sense_id": "4b0bcfbd-7751-38c0-9b9a-b1c04d365775",
                                                "text": "We've got some flatware missing - There seem to be some cooking utensils missing too!"
                                            },
                                            {
                                                "example_id": "11c5c0bd-5e26-4d4c-8df3-d0c25000f3c7",
                                                "sense_id": "4b0bcfbd-7751-38c0-9b9a-b1c04d365775",
                                                "text": "How likely is it that all the people who are described as missing are living together in a small town somewhere?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bde1d31-6f72-3c47-87ee-8ded5144e28a",
                                        "entry_id": "668c6fe4-6cef-38e7-807c-d085b08d01bd",
                                        "glosses": [
                                            "Of an internal combustion engine: running roughly due to an occasional lack of a spark or other irregular fault."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
