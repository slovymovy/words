                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7658f67-1d8f-4cd6-ae3d-2d02d8c6968e",
                                                "sense_id": "0e9272ed-3a7e-348d-84e7-1b92d8d8d0a5",
                                                "text": "The stock exchange is open for trading."
