    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b72386cf-b8c7-3996-924d-cdbd8e969b2f",
                    "sense_definition": "Lacking intelligence or good judgment.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lack_of_intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be <w>dumb</w>; wear a helmet when you ride your bike.",
                            "target_lang_translations": {
                                "ru": "Не будь <w>глу́пым</w>; надевай шлем, когда катаешься на велосипеде.",
                                "tr": "<w>Aptallık etme</w>; bisiklete binerken kask tak."
                            }
                        },
                        {
                            "text": "He felt <w>dumb</w> after forgetting his own phone number.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>глу́пым</w>, забыв свой собственный номер телефона.",
                                "tr": "Kendi telefon numarasını unuttuktan sonra kendini <w>aptal</w> gibi hissetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "stupid",
                        "unintelligent",
                        "foolish",
                        "brainless",
                        "dense",
                        "slow",
                        "silly"
                    ],
                    "antonyms": [
                        "smart",
                        "intelligent"
                    ],
                    "common_phrases": [
                        "play dumb",
                        "dumb luck",
                        "look dumb"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не обладающий высоким интеллектом или здравым смыслом.",
                        "tr": "Aptalca veya mantıksız davranan, zekadan yoksun."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глу́пый",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "тупо́й",
                                "target_lang_sense_clarification": "разговорное, грубое"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "aptal",
                                "target_lang_sense_clarification": "genel kullanım"
                            },
                            {
                                "target_lang_word": "aptalca",
                                "target_lang_sense_clarification": "davranış için"
                            },
                            {
                                "target_lang_word": "salak",
                                "target_lang_sense_clarification": "samimi / kaba"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a4f4200-0823-353c-bd62-135bf1b889b0",
                    "sense_definition": "Pointless, foolish, or lacking intellectual value.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lack_of_intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That was a <w>dumb</w> movie with no real plot.",
                            "target_lang_translations": {
                                "ru": "Это был <w>дура́цкий</w> фильм без настоящего сюжета.",
                                "tr": "Gerçek bir konusu olmayan <w>saçma</w> bir filmdi."
                            }
                        },
                        {
                            "text": "I made a <w>dumb</w> mistake on the test because I was rushing.",
                            "target_lang_translations": {
                                "ru": "Я совершил <w>глу́пую</w> ошибку в тесте, потому что торопился.",
                                "tr": "Acele ettiğim için sınavda <w>saçma</w> bir hata yaptım."
                            }
                        }
                    ],
                    "synonyms": [
                        "silly",
                        "ridiculous",
                        "absurd",
                        "pointless",
                        "stupid"
                    ],
                    "antonyms": [
                        "smart"
                    ],
                    "common_phrases": [
                        "dumb idea",
                        "dumb question",
                        "dumb joke"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бессмысленный, нелепый или не представляющий интеллектуальной ценности.",
                        "tr": "Anlamsız, saçma veya zihinsel değeri olmayan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дура́цкий",
