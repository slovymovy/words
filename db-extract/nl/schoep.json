                "senses": [
                    {
                        "sense_id": "43939be3-628e-3870-9717-a213a56ed15e",
                        "entry_id": "7733e8e9-fa59-31f8-9613-63c4c06a420e",
                        "glosses": [
                            "de wiek van een windmolen of de bladen van een waterschroef"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdb79684-d548-4b2e-851e-4143cb72f5b8",
                                "sense_id": "43939be3-628e-3870-9717-a213a56ed15e",
                                "text": "Fairwind ontwikkelde molens die er wat anders uitzien dan het klassieke beeld van de windturbine met een horizontale as. De schoepen van de windmolens van Fairwind draaien immers rond een verticale as."
                            },
                            {
                                "example_id": "e5931085-2e5a-4509-aa2b-106ae10f9723",
                                "sense_id": "43939be3-628e-3870-9717-a213a56ed15e",
                                "text": "Directeur Gerard Scholten: „Onze bi-directionele getijdenturbine is een doorontwikkeling van onze visvriendelijke turbine. Bijzonder eraan is dat de schoepen 180 graden kunnen draaien en dus mee draaien met het getij.”"
                            },
                            {
                                "example_id": "1dc2b48a-1f8e-41e3-b26f-25e4e9fce37f",
                                "sense_id": "43939be3-628e-3870-9717-a213a56ed15e",
                                "text": "In Nature Chemistry beschrijven de Groningers deze week hoe ze een uitstekend deel van een organisch molecuul als een schoep 360 graden om zijn as laten draaien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
