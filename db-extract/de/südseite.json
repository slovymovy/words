                        "examples": [
                            {
                                "example_id": "3534a687-3ce1-46d7-afb0-45de8675cacb",
                                "sense_id": "0f9c869e-11bd-3ada-808b-0c1f7c0e3cec",
                                "text": "„Die Bezoarziege ist auf der Südseite des Kaukasus, im Taurus, in vielen Gebieten Kleinasiens und Persiens sowie auf einigen Inseln des Ägäischen Meers beheimatet.“"
                            },
                            {
                                "example_id": "3b177ae3-f5da-4b36-a381-d1249f82e5b3",
                                "sense_id": "0f9c869e-11bd-3ada-808b-0c1f7c0e3cec",
                                "text": "„An der Südseite liegen die St.-Ursula-Schulen mit Gymnasium und Realschule für Mädchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
