{
    "word_family": [
        "tobber",
        "tobberig",
        "tobberij"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1a007a2-dfe1-33f2-b6f4-5c1c0917d7d4",
                    "sense_definition": "zich aanhoudend zorgen maken of piekeren over problemen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij bleef de hele nacht <w>tobben</w> over haar financiële situatie.",
                            "target_lang_translations": {
                                "fr": "Elle a passé toute la nuit à <w>se tourmenter</w> au sujet de sa situation financière."
                            }
                        },
                        {
                            "text": "Hij <w>tobde</w> vaak over de toekomst van zijn kinderen.",
                            "target_lang_translations": {
                                "fr": "Il <w>se faisait</w> souvent <w>du souci</w> pour l'avenir de ses enfants."
                            }
                        }
                    ],
                    "synonyms": [
                        "kniezen",
                        "piekeren"
                    ],
                    "common_phrases": [
                        "zitten te tobben",
                        "tobben over"
                    ],
                    "target_lang_definitions": {
                        "fr": "se tourmenter, s'inquiéter de manière continue ou ruminer des soucis"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "se faire du souci",
                                "target_lang_sense_clarification": "s'inquiéter"
                            },
                            {
                                "target_lang_word": "se tourmenter",
                                "target_lang_sense_clarification": "être angoissé ou préoccupé"
                            },
                            {
                                "target_lang_word": "ruminer",
                                "target_lang_sense_clarification": "ressasser des pensées négatives"
                            },
                            {
                                "target_lang_word": "se tracasser",
                                "target_lang_sense_clarification": "s'inquiéter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad652688-ce30-3fab-a5c7-7881947d415e",
                    "sense_definition": "langdurig moeite of last hebben van een kwaal, ziekte of probleem",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man heeft maandenlang <w>getobd</w> met een zware griep.",
                            "target_lang_translations": {
                                "fr": "Le vieil homme a <w>galéré</w> pendant des mois avec une mauvaise grippe."
                            }
                        },
                        {
                            "text": "Hij bleef maar <w>tobben</w> met die oude auto die steeds kapotging.",
                            "target_lang_translations": {
                                "fr": "Il n'arrêtait pas d'<w>avoir des ennuis</w> avec cette vieille voiture qui tombait sans cesse en panne."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tobben met gezondheid"
                    ],
                    "target_lang_definitions": {
                        "fr": "peiner, galérer durablement avec une maladie, un problème de santé ou une difficulté technique"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "galérer avec",
                                "target_lang_sense_clarification": "avoir du mal avec (familier)"
                            },
                            {
                                "target_lang_word": "peiner avec",
                                "target_lang_sense_clarification": "avoir des difficultés prolongées"
                            },
                            {
                                "target_lang_word": "avoir des ennuis avec",
                                "target_lang_sense_clarification": "santé ou problème matériel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77489972-e5b4-33a3-a6c8-217147886b23",
                    "sense_definition": "iemand kwellen, lastigvallen of plagen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De strenge vorst <w>tobde</w> de arme reizigers gedurende de hele tocht.",
                            "target_lang_translations": {
                                "fr": "Le gel rigoureux <w>tourmenta</w> les pauvres voyageurs tout au long du périple."
                            }
                        },
                        {
                            "text": "Die nare gedachten bleven haar geest dag en nacht <w>tobben</w>.",
                            "target_lang_translations": {
                                "fr": "Ces sombres pensées continuaient de lui <w>tourmenter</w> l'esprit jour et nuit."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "tourmenter, harceler ou faire souffrir quelqu'un (archaïque)"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tourmenter",
                                "target_lang_sense_clarification": "faire souffrir moralement ou physiquement"
                            },
                            {
                                "target_lang_word": "harceler",
                                "target_lang_sense_clarification": "importuner sans relâche"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce4e1c8b-b139-331e-b3c4-f9101ad42c71",
                    "sense_definition": "onrustig heen en weer bewegen of spartelen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gevangen vis begon wild in het net te <w>tobben</w>.",
                            "target_lang_translations": {
                                "fr": "Le poisson capturé se mit à se <w>débattre</w> sauvagement dans le filet."
                            }
                        },
                        {
                            "text": "Het schip bleef op de woeste golven <w>tobben</w>.",
                            "target_lang_translations": {
                                "fr": "Le navire continua d'être <w>balloté</w> sur les vagues déchaînées."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "s'agiter, se débattre ou être balloté violemment (archaïque)"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "se débattre",
                                "target_lang_sense_clarification": "s'agiter vigoureusement"
                            },
                            {
                                "target_lang_word": "être balloté",
                                "target_lang_sense_clarification": "par les vagues"
                            }
                        ]
                    }
                }
            ]
        },
        {
