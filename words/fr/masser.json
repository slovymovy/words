    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "34644c06-17d3-31ad-b1e3-9bed32c5d748",
                    "sense_definition": "Frictionner et presser méthodiquement le corps ou les muscles avec les mains pour détendre ou soigner.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "massage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue journée de marche, elle aime se faire <w>masser</w> les pieds pour soulager la fatigue."
                        },
                        {
                            "text": "Le kinésithérapeute applique une crème spéciale pour <w>masser</w> le dos de son patient avec précaution."
                        }
                    ],
                    "synonyms": [
                        "frictionner",
                        "pétrir"
                    ],
                    "common_phrases": [
                        "masser le dos",
                        "masser les épaules",
                        "se faire masser"
                    ]
                },
                {
                    "sense_id": "7dc9fd3b-6523-34d2-9f8d-ebda0ab25858",
                    "sense_definition": "Se rassembler en foule dense ou en grand nombre dans un même espace.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regroupement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des centaines de partisans enthousiastes viennent se <w>masser</w> devant le bâtiment officiel pour écouter le discours."
                        },
                        {
                            "text": "Les touristes continuent de se <w>masser</w> le long du fleuve afin d'admirer les illuminations du soir."
                        }
                    ],
                    "synonyms": [
                        "s'amasser",
                        "s'attrouper",
                        "se rassembler"
                    ],
                    "antonyms": [
                        "se disperser"
                    ],
                    "common_phrases": [
                        "se masser devant",
                        "se masser le long"
                    ]
                },
                {
                    "sense_id": "ff38fb94-02ec-3230-8490-4446ab5bc0ba",
                    "sense_definition": "Disposer ou concentrer des forces militaires, des véhicules ou des effectifs en grand nombre à un point stratégique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "regroupement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le commandement militaire a décidé de <w>masser</w> des troupes près de la frontière pour sécuriser la zone."
                        },
                        {
                            "text": "Les forces armées ont achevé de <w>masser</w> leurs véhicules blindés sur le flanc ouest de la plaine."
                        }
                    ],
                    "synonyms": [
                        "concentrer",
                        "regrouper"
                    ],
                    "antonyms": [
                        "disperser"
                    ],
                    "common_phrases": [
                        "masser des troupes"
                    ]
                },
                {
                    "sense_id": "d88c7ebf-4ecb-31e3-88c1-a59f5444e73e",
                    "sense_definition": "Disposer et équilibrer les grands volumes, les ombres ou les lumières dans la composition d'un tableau.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre a pris grand soin de <w>masser</w> les ombres profondes pour accentuer le relief de sa toile."
                        },
                        {
                            "text": "Avant de peindre chaque détail individuel, il convient de bien <w>masser</w> les feuillages des arbres en arrière-plan."
                        }
                    ],
                    "synonyms": [
                        "agencer",
                        "distribuer"
                    ]
                }
            ]
        }
    ]
