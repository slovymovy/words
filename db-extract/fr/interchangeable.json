                    {
                        "form_id": "dff8c07c-efc5-4462-b081-af4a372909fa",
                        "entry_id": "f3785f2f-c7d1-32ba-aa61-436da5a52cb4",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "interchangeables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fac22c78-816c-3d5a-a769-1cf4721ba594",
                        "entry_id": "f3785f2f-c7d1-32ba-aa61-436da5a52cb4",
                        "glosses": [
                            "Qui peut être changé l’un pour l’autre, en parlant des éléments d’un mécanisme ou d’une organisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d00df67a-1ba7-4f04-8b5f-0996150857cb",
                                "sense_id": "fac22c78-816c-3d5a-a769-1cf4721ba594",
                                "text": "Dans ce mécanisme il y a des pièces interchangeables."
                            },
                            {
                                "example_id": "3d40edd3-d13d-44db-a32e-4e3b772146bf",
                                "sense_id": "fac22c78-816c-3d5a-a769-1cf4721ba594",
                                "text": "Mauriac aussi, quand il note que : « Les journaux usent pour la plupart de formules interchangeables au point que nous ne distinguons plus ceux de droite de ceux de gauche. »"
                            },
                            {
                                "example_id": "0def586e-df73-402b-924a-686fe848095d",
                                "sense_id": "fac22c78-816c-3d5a-a769-1cf4721ba594",
                                "text": "Cabaïa, la marque originalement spécialisée dans le bonnet aux pompons interchangeables, a lancé sa gamme de sacs en se basant sur les envies de ses clients."
                            },
                            {
                                "example_id": "016d5f51-8924-4f55-90d5-c5918c605f47",
                                "sense_id": "fac22c78-816c-3d5a-a769-1cf4721ba594",
                                "text": "Elle arrive à ce constat dans un passage du livre « La condition ouvrière » , où elle remarque que les pièces détachées dans l’usine où elle travaille lui paraissent traitées plus dignement que les humains, parce qu’on leur reconnaît une forme « d’individualité » (elles sont soigneusement identifiées et étiquetées, comme si elles avaient une sorte « d’état civil »), alors qu’à l’inverse, les ouvriers y sont devenus des êtres anonymes et interchangeables que les patrons déplacent à leur guise sur les différents postes de la chaîne de production."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6095018-ef6f-46e6-a3b3-679621f78bea",
                        "source_entry_id": "f3785f2f-c7d1-32ba-aa61-436da5a52cb4",
                        "source_sense_id": "fac22c78-816c-3d5a-a769-1cf4721ba594",
                        "target_lang_word": "austauschbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "austauschbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7d44816-4cda-3758-b5ea-dcec63b1cf43",
                                        "entry_id": "2731c48a-e0ec-327b-80f5-504575069c4d",
                                        "glosses": [
                                            "bei Bedarf aus einem Gerät entfernbar und durch ein neues Teil ersetzbar"
                                        ],
                                        "tags": [
                                            "technisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6657d776-912f-4adb-9666-dc7b85f19395",
                                                "sense_id": "b7d44816-4cda-3758-b5ea-dcec63b1cf43",
                                                "text": "„Wichtige Teile wie Akkus in Handys sollen austauschbar sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e823dcad-05d5-336b-8d9d-3dc1ea0530fc",
                                        "entry_id": "2731c48a-e0ec-327b-80f5-504575069c4d",
                                        "glosses": [
                                            "miteinander kombinierbar, zusammenpassend"
                                        ],
                                        "tags": [
                                            "technisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db66a523-47da-4a95-a416-930cd381b26d",
                                                "sense_id": "e823dcad-05d5-336b-8d9d-3dc1ea0530fc",
                                                "text": "„Das Leibniz‑Rechenzentrum der Bayerischen Akademie der Wissenschaften LRZ fungiert als eine Art Schaltzentrale, in der die Eingaben in die Computer tausender Wissenschaftler koordiniert und untereinander austauschbar gemacht werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cfa174d8-3fdd-3e61-ae9f-d13ef1aa7d92",
                                        "entry_id": "2731c48a-e0ec-327b-80f5-504575069c4d",
                                        "glosses": [
                                            "beliebig durch jemand anderen ersetzbar"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "283c184d-d281-4ffb-a4d2-109db04073ba",
                                                "sense_id": "cfa174d8-3fdd-3e61-ae9f-d13ef1aa7d92",
                                                "text": "„Ich wollte nicht bloß hübsches, austauschbares Dekor in einem Film sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa2249ab-f30d-4524-8bc4-071085be1de0",
                        "source_entry_id": "f3785f2f-c7d1-32ba-aa61-436da5a52cb4",
                        "source_sense_id": "fac22c78-816c-3d5a-a769-1cf4721ba594",
