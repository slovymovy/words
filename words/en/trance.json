{
    "word_family": [
        "entrance",
        "entranced",
        "entrancing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d234ad4a-2469-30ab-a131-0b876559e8f4",
                    "sense_definition": "A state of low response to stimulus and diminished, narrow attention, particularly one induced by hypnosis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hypnotist helped the patient enter a deep <w>trance</w> to explore past memories.",
                            "target_lang_translations": {
                                "ru": "Гипнотизер помог пациенту войти в глубокий <w>транс</w>, чтобы исследовать прошлые воспоминания."
                            }
                        },
                        {
                            "text": "She seemed to be in a <w>trance</w> and did not hear me call her name.",
                            "target_lang_translations": {
                                "ru": "Она казалась отрешенной, будто была в <w>трансе</w>, и не слышала, как я звал ее по имени."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deep trance",
                        "hypnotic trance",
                        "enter a trance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние слабой реакции на стимулы и суженного внимания, особенно вызванное гипнозом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "транс",
                                "target_lang_sense_clarification": "состояние измененного сознания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "facc7310-5755-3038-8f08-d99a4b9f3e56",
                    "sense_definition": "A state of awareness or focus that filters experience, such as a state of meditation or spiritual possession.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monk sat in a meditative <w>trance</w> for several hours without moving.",
                            "target_lang_translations": {
                                "ru": "Монах сидел в медитативном <w>трансе</w> несколько часов, не шевелясь."
                            }
                        },
                        {
                            "text": "During the ritual, he fell into a <w>trance</w> and began to speak in a different voice.",
                            "target_lang_translations": {
                                "ru": "Во время ритуала он впал в <w>транс</w> и заговорил чужим голосом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "meditative trance",
                        "spiritual trance",
                        "fall into a trance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние осознанности или сосредоточенности, фильтрующее восприятие, например, состояние медитации или духовной одержимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "транс",
                                "target_lang_sense_clarification": "медитативное или ритуальное состояние"
                            },
                            {
                                "target_lang_word": "экстаз",
                                "target_lang_sense_clarification": "религиозный или духовный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2be8e08-0a99-3a54-835e-2152089e6a22",
                    "sense_definition": "A genre of electronic dance music characterized by repetitive melodic phrases and a high tempo.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The DJ played a mix of techno and <w>trance</w> all night long.",
                            "target_lang_translations": {
                                "ru": "Диджей всю ночь играл смесь техно и <w>транса</w>."
                            }
                        },
                        {
                            "text": "He loves listening to <w>trance</w> because the rhythmic beats help him focus while working.",
                            "target_lang_translations": {
                                "ru": "Он любит слушать <w>транс</w>, потому что ритмичные биты помогают ему сосредоточиться во время работы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "trance music",
                        "vocal trance",
                        "trance producer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortened form of trance music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жанр электронной танцевальной музыки, характеризующийся повторяющимися мелодическими фразами и высоким темпом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "транс",
                                "target_lang_sense_clarification": "музыкальный стиль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0cc5263-9813-3937-a225-a5e241815888",
                    "sense_definition": "A dazed or unconscious condition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the accident, he walked around in a <w>trance</w>, unable to process what happened.",
                            "target_lang_translations": {
                                "ru": "После аварии он ходил как в <w>трансе</w>, не в силах осознать случившееся."
                            }
                        },
                        {
                            "text": "The shocking news left her in a dazed <w>trance</w> for the rest of the afternoon.",
                            "target_lang_translations": {
                                "ru": "Шокирующие новости оставили ее в состоянии <w>оцепенения</w> до конца дня."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dazed trance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оцепенелое или бессознательное состояние."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прострация",
                                "target_lang_sense_clarification": "состояние полной отрешенности"
                            },
                            {
                                "target_lang_word": "оцепенение",
                                "target_lang_sense_clarification": "неподвижность от шока"
                            },
                            {
                                "target_lang_word": "транс",
                                "target_lang_sense_clarification": "состояние отрешенности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e51f10a0-4d77-35a8-aede-1706270467e9",
                    "sense_definition": "A tedious or difficult journey.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long <w>trance</w> through the muddy fields exhausted the travelers.",
                            "target_lang_translations": {
                                "ru": "Долгий <w>переход</w> через грязные поля измотал путешественников."
                            }
                        },
                        {
                            "text": "They faced a weary <w>trance</w> across the mountains before reaching the village.",
                            "target_lang_translations": {
                                "ru": "Им предстоял изнурительный <w>путь</w> через горы, прежде чем они достигли деревни."
                            }
                        }
                    ],
                    "common_phrases": [
                        "weary trance"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "primarily found in older Scots or regional literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Утомительное или трудное путешествие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяжелый путь",
                                "target_lang_sense_clarification": "утомительное странствие"
                            },
                            {
                                "target_lang_word": "переход",
                                "target_lang_sense_clarification": "трудный путь пешком"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "285d7413-f64d-3d04-8910-6a8723083588",
                    "sense_definition": "To cause someone to be in a trance; to entrance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rhythmic sound of the waves <w>tranced</w> the onlookers into a peaceful sleep.",
                            "target_lang_translations": {
                                "ru": "Ритмичный шум волн <w>погрузил</w> зрителей в мирный сон."
                            }
                        },
                        {
                            "text": "She was completely <w>tranced</w> by the flickering flames of the campfire.",
                            "target_lang_translations": {
                                "ru": "Она была полностью <w>заворожена</w> мерцающим пламенем костра."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вводить кого-либо в состояние транса; очаровывать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вводить в транс",
                                "target_lang_sense_clarification": "гипнотизировать"
                            },
                            {
                                "target_lang_word": "заворожить",
                                "target_lang_sense_clarification": "полностью захватить внимание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8de82987-2d21-34a2-bb23-6b5188674417",
                    "sense_definition": "To pass across or over; to traverse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The moon began to <w>trance</w> the sky as the sun dipped below the horizon.",
                            "target_lang_translations": {
                                "ru": "Луна начала <w>пересекать</w> небосвод, когда солнце скрылось за горизонтом."
                            }
                        },
                        {
                            "text": "He intended to <w>trance</w> the world o'er in search of adventure.",
                            "target_lang_translations": {
                                "ru": "Он намеревался <w>обойти</w> весь мир в поисках приключений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "trance the world"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проходить сквозь или над чем-либо; пересекать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересекать",
                                "target_lang_sense_clarification": "проходить через пространство"
                            },
                            {
                                "target_lang_word": "проходить",
                                "target_lang_sense_clarification": "совершать путь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99c3ebae-c5b9-3bee-8a24-a9b33c903276",
                    "sense_definition": "To walk heavily or with difficulty; to tramp or trudge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers had to <w>trance</w> through the deep snow to reach the camp.",
                            "target_lang_translations": {
                                "ru": "Солдатам пришлось <w>брести</w> через глубокий снег, чтобы добраться до лагеря."
                            }
                        },
                        {
                            "text": "We watched him <w>trance</w> along the path with his heavy backpack.",
                            "target_lang_translations": {
                                "ru": "Мы смотрели, как он <w>тащится</w> по тропе со своим тяжелым рюкзаком."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional or archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти тяжело или с трудом; тащиться или брести."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брести",
                                "target_lang_sense_clarification": "идти медленно и тяжело"
                            },
                            {
                                "target_lang_word": "тащиться",
                                "target_lang_sense_clarification": "идти с трудом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "29965846-353e-36af-91e4-75b9ceca90ea",
                    "sense_definition": "A variant or archaic spelling of <w>France</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "In some ancient texts, the country is referred to as <w>Trance</w> instead of its modern name.",
                            "target_lang_translations": {
                                "ru": "В некоторых древних текстах страна упоминается как <w>Транция</w> вместо ее современного названия."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical variant"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант или архаичное написание названия страны Франция."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Франция",
                                "target_lang_sense_clarification": "историческое написание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}