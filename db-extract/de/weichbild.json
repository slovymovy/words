                        "examples": [
                            {
                                "example_id": "75f5a6a0-3cb7-4afc-9d05-ed5ad4c63a48",
                                "sense_id": "1966a30c-56f6-359f-8a74-2893d640fd75",
                                "text": "Die Landschaft fliegt vorbei, grün und flammend sommerbunt. Ist man erst aus dem Weichbild Dresdens heraus, sind die Dörfer und Städte unzerstört."
                            },
                            {
                                "example_id": "288cc1cf-9570-4abe-bc0e-0d89c85efc0f",
                                "sense_id": "1966a30c-56f6-359f-8a74-2893d640fd75",
                                "text": "Und ganz in der Ferne, im Dunst, kann man das Weichbild von San Diego erkennen. In Tijuana reicht die Bebauung bis unmittelbar an die Mauer."
                            }
                        ]
                    }
