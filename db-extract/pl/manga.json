                "senses": [
                    {
                        "sense_id": "4191445d-e84a-3742-bd97-26464d744468",
                        "entry_id": "b8ef79ce-5c74-3076-8a0b-1d4ab0630534",
                        "glosses": [
                            "japoński komiks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8012f8d0-7d71-4f5a-9f83-a940e6e6808e",
                                "sense_id": "4191445d-e84a-3742-bd97-26464d744468",
                                "text": "W zeszłym tygodniu kupiłem nową mangę."
                            }
