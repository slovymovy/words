        "fr-extract.jsonl": [
            {
                "entry_id": "090c41ab-90d7-3047-9054-0a91e60777f0",
                "word": "lagune",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "884087ef-3387-4dd6-aeb2-503513deede1",
                        "entry_id": "090c41ab-90d7-3047-9054-0a91e60777f0",
                        "tags": [
                            "plural"
                        ],
                        "form": "lagunes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "228c7e3f-8f94-3844-9372-665a0893f2c1",
                        "entry_id": "090c41ab-90d7-3047-9054-0a91e60777f0",
                        "glosses": [
                            "Étendue plus ou moins grande d’eau de mer, sur un haut-fond, entre des îlots ou des bancs de sable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "017ccf71-d8a5-4906-ae40-5ac8d7c6c54b",
                                "sense_id": "228c7e3f-8f94-3844-9372-665a0893f2c1",
                                "text": "Les lagunes de Venise."
                            },
                            {
                                "example_id": "0ad1cb0e-221f-44b2-84b2-0e71bb11aa59",
                                "sense_id": "228c7e3f-8f94-3844-9372-665a0893f2c1",
                                "text": "Des goëlands tournent en criant sur les lagunes, une cloche tinte et, parmi les toits fumants, se dresse un cyprès solitaire."
                            },
                            {
                                "example_id": "5cd1e18d-e581-424a-b921-89d89e5eb134",
                                "sense_id": "228c7e3f-8f94-3844-9372-665a0893f2c1",
                                "text": "— Les lagunes ou les chenaux qui se forment entre les floes et les floebergs sont souvent vastes et larges."
                            },
                            {
                                "example_id": "567c3b01-736b-4b7e-af29-645f2628179c",
                                "sense_id": "228c7e3f-8f94-3844-9372-665a0893f2c1",
                                "text": "À travers ses colonnettes aussi travaillées que de la dentèle, nous avons une vue exceptionnelle sur la lagune."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d945547-8cc7-3bd1-babb-82183dffe91c",
                        "entry_id": "090c41ab-90d7-3047-9054-0a91e60777f0",
                        "glosses": [
                            "Fosse artificielle où l’on peut stocker ou traiter des liquides (lisier, eaux usées, boues, etc.)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6699da0a-418a-46f9-ad48-ff2a61508219",
                        "source_entry_id": "090c41ab-90d7-3047-9054-0a91e60777f0",
                        "target_lang_word": "Lagune",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lagune",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47e3df04-7ed5-3043-b9b1-68a367e996a2",
                                        "entry_id": "b33781d5-ee14-3f9a-8e0d-b87119dd315e",
                                        "glosses": [
                                            "vom Meer abgetrenntes Gewässer"
                                        ],
                                        "tags": [
                                            "Geographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fde60bf-b1d3-404b-99a4-6160475ca8fe",
                                                "sense_id": "47e3df04-7ed5-3043-b9b1-68a367e996a2",
                                                "text": "In der Lagune konnten die Fischer vor kleinen Stürmen sicher sein."
                                            },
                                            {
                                                "example_id": "7940a8fa-6002-4e5d-b272-7651725a66cd",
                                                "sense_id": "47e3df04-7ed5-3043-b9b1-68a367e996a2",
                                                "text": "„Oberhalb einer Lagune in einem Talkessel gelegen, scheint hier die Zeit stillzustehen.“"
                                            },
                                            {
                                                "example_id": "b7d0eb4e-579b-4aee-8279-27372184edd7",
                                                "sense_id": "47e3df04-7ed5-3043-b9b1-68a367e996a2",
                                                "text": "„Dann waren wir in der Lagune, die im Mondlicht dunkel und ruhig dalag.“"
                                            },
                                            {
                                                "example_id": "c246dca1-bc37-4f1d-b249-9ec8eff593bb",
                                                "sense_id": "47e3df04-7ed5-3043-b9b1-68a367e996a2",
                                                "text": "„Wir legten als Ziel die Pforte fest, die auf die Lagune führte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
