                        "entry_id": "e71e959b-d7b6-357e-b04e-5a8a0f3514ae",
                        "glosses": [
                            "Tissu en élasthanne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d6062ba-5a02-4a51-bc36-5a0225af7cf8",
                                "sense_id": "6dd091d5-f604-354a-b820-3a151729e7bf",
                                "text": "Il était là, sous ses yeux, presque nu, avec juste un string indécent en Lycra rose néon."
                            },
                            {
                                "example_id": "fbd33632-7fe0-4fe0-9dba-882a78359665",
                                "sense_id": "6dd091d5-f604-354a-b820-3a151729e7bf",
                                "text": "Une combinaison en lycra."
                            },
                            {
                                "example_id": "25ec5c20-0acc-4abe-867e-ad35cf57a199",
                                "sense_id": "6dd091d5-f604-354a-b820-3a151729e7bf",
                                "text": "À ce moment, on oublie que dans les coulisses du Cirque du Soleil fourmille une équipe de 400 créateurs qui transforment des kilomètres de lycra en seconde peau pour les artistes."
                            },
                            {
                                "example_id": "c54dc126-84ad-4667-9685-35bd282f58e7",
                                "sense_id": "6dd091d5-f604-354a-b820-3a151729e7bf",
                                "text": "Pantalons noirs de yoga dont le tissu [est] un mélange de nylon et de lycra."
                            }
                        ]
                    }
