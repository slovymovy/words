                        ]
                    },
                    {
                        "translation_id": "02cd0c01-b7a3-4e63-9794-900a5d45bfdd",
                        "source_entry_id": "eb043884-3e4b-3f10-af50-c647ee4a56be",
                        "source_sense_id": "dd4a025e-9db8-3ea2-85c7-7b65185f76e3",
