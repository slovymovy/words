                        "glosses": [
                            "ou (En parlant des personnes.) Déjà un peu grand ; grand pour son âge ; grandelet."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3941f35b-e25c-4fa9-b39b-905610c74184",
                                "sense_id": "d24a222e-c8ec-3281-b92b-0a2f41df6790",
                                "text": "Un garçon déjà grandet, qui traînait la jambe, dit à l’un de ses camarades, d’un air désabusé : « Culture ! »"
                            },
                            {
                                "example_id": "2c97cb7e-c6bb-45dc-9115-94233a8d0979",
                                "sense_id": "d24a222e-c8ec-3281-b92b-0a2f41df6790",
                                "text": "Mais, lorsque Gustav débarqua de Pretoria, la découverte d’un frère déjà grandet fut une révélation pour lui."
                            }
                        ]
                    }
