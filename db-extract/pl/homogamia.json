                                "target_senses": [
                                    {
                                        "sense_id": "520666c4-6305-3517-b684-17da02d610c1",
                                        "entry_id": "243dade0-994d-3620-a815-8dbd797149f8",
                                        "glosses": [
                                            "Fertilization of a flower by pollen from the same plant."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e89da8b7-6023-30da-85d6-8c4361f1b1db",
                                        "entry_id": "243dade0-994d-3620-a815-8dbd797149f8",
                                        "glosses": [
                                            "The quality of being homogamous."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d57d972-d657-3018-ad5d-4a8fbb3640f7",
                                        "entry_id": "243dade0-994d-3620-a815-8dbd797149f8",
                                        "glosses": [
                                            "Breeding between similar individuals."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10b7ff9e-891b-3e23-9a62-078a39b072ee",
                                        "entry_id": "243dade0-994d-3620-a815-8dbd797149f8",
                                        "glosses": [
                                            "Marriage or other union between similar people, or people of the same sex."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfd9831a-1816-4f33-a9db-55a2702ba38c",
                                                "sense_id": "10b7ff9e-891b-3e23-9a62-078a39b072ee",
                                                "text": "Surgeons no longer pursue nurses as they did when the former were most likely men and the latter women; now they go for anaesthetists or other surgeons. In one sense homogamy is desirable, because it means women are less dependent on status-asymmetric marriages; in another, it’s dismal because it constitutes a form of social closure […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67378863-c2a5-4a1d-a7fa-2499ae3f3d5e",
                        "source_entry_id": "ab9a69ea-9ce0-3589-8b04-3ae12bb2e8c3",
                        "source_sense_id": "884e2fc5-9a72-3491-9976-a6883dbde4b0",
                        "target_lang_word": "homogamie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homogamie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7fe77742-9631-3e6e-94ec-e1d4b8de4843",
                                        "entry_id": "c646bea2-d357-32f5-b981-29d6f2036be1",
                                        "glosses": [
                                            "État d’une plante dont la fleur hermaphrodite a des étamines et des pistils qui arrivent à maturité au même moment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8bdebf66-5381-3b57-a173-25a1cd594611",
                                        "entry_id": "c646bea2-d357-32f5-b981-29d6f2036be1",
                                        "glosses": [
                                            "Pour un individu, mariage avec une personne de rang social égal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "031fc1fb-cb34-46d9-9648-b70704b5a8d2",
                                                "sense_id": "8bdebf66-5381-3b57-a173-25a1cd594611",
                                                "text": "L’homogamie des femmes est très remarquable avec 55 % d’entre elles ayant un conjoint qui est aussi ingénieur diplômé (et 18 % pour les hommes)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d67452a9-d028-39d8-955b-2a4912569d4e",
                                        "entry_id": "c646bea2-d357-32f5-b981-29d6f2036be1",
                                        "glosses": [
                                            "Comportement sexuel d’un animal qui a tendance à se reproduire avec des individus de phénotype ou de génotype similaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66e3d369-bae0-4084-bfff-1a59c9db2f4b",
                                                "sense_id": "d67452a9-d028-39d8-955b-2a4912569d4e",
                                                "text": "C’est la sélection. En particulier, la sélection d’un trait favorisant l’homogamie, puisque le fait de se reproduire uniquement au sein de sa propre espèce constitue finalement le point clé de la spéciation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
