                        "sense_id": "a4ae8afa-aff4-3859-bab9-c2db891f14d6",
                        "entry_id": "1c3fb4e3-d9dd-32ec-ab87-8dfb060bd72c",
                        "glosses": [
                            "iets tot de meest pure essentie terugbrengen"
