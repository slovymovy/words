                "senses": [
                    {
                        "sense_id": "6c35382d-bc3d-3cd4-9593-92d04a59863d",
                        "entry_id": "fee47cfc-bdbf-35a9-9630-29db734ea14e",
                        "glosses": [
                            "A form of endocytosis in which a cell incorporates a particle by extending pseudopodia and drawing the particle into a vacuole of its cytoplasm."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6be2a251-f8d7-4aa0-8630-17857877b03b",
                                "sense_id": "6c35382d-bc3d-3cd4-9593-92d04a59863d",
                                "text": "On account of the possession of this property, Metschnikoff has suggested for these groups of cells the term phagocytes, as expressive of their most distinctive feature, and for the process in general the term phagocytosis."
                            }
                        ]
                    }
                ],
