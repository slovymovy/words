                    },
                    {
                        "sense_id": "e290f6c6-abed-3aa8-8ed4-1c359a8fdcb0",
                        "entry_id": "1b34bdf6-893c-34a2-968f-8de62cad9169",
                        "glosses": [
                            "In the shape of the uppercase Greek letter delta (Δ); triangular.",
                            "Of a triangular or roughly triangular shape and attached to the stem via the side."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
