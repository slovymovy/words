                "senses": [
                    {
                        "sense_id": "edf74fd8-6174-3188-85ac-2078c629aa1a",
                        "entry_id": "e7511598-4a59-3f11-917f-5eefb720962a",
                        "glosses": [
                            "Person, die meist über einen längeren Zeitraum und häufig in sozialen Netzwerken des Internets Hass/Hetze verbreitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc22bb64-d14c-40ae-97e4-838b9d14c5d5",
                                "sense_id": "edf74fd8-6174-3188-85ac-2078c629aa1a",
                                "text": "„Es ist nicht leicht, Menschen zu finden, die Negatives über Annalena Baerbock berichten – abgesehen von den Hatern im Internet, die ihren Hass auf die Grünen an Habeck und Baerbock auslassen.“"
                            },
                            {
                                "example_id": "44ec1069-feb8-4250-8bfa-68c20b29d857",
                                "sense_id": "edf74fd8-6174-3188-85ac-2078c629aa1a",
                                "text": "„Jetzt erst recht: Wir überlassen den Hatern dieses Land nicht!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
