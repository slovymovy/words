                ],
                "senses": [
                    {
                        "sense_id": "ae28c986-c1e4-38a2-860e-5fc7cb3bc6a1",
                        "entry_id": "171d53ab-1c17-3298-8ed7-d14502cb5606",
                        "glosses": [
                            "Pêcheur de sardines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85bf83c9-ed95-4e55-a4fc-1f07dd67bd80",
                                "sense_id": "ae28c986-c1e4-38a2-860e-5fc7cb3bc6a1",
                                "text": "Les sardiniers et les pêcheurs de thon de Douarnenez, de Concarneau et d'Audierne, eux, sont les véritables prolétaires de la mer."
                            }
                        ]
                    },
                    {
                        "sense_id": "5aa544fc-507a-386d-b39e-627afc3b397c",
                        "entry_id": "171d53ab-1c17-3298-8ed7-d14502cb5606",
                        "glosses": [
                            "Ouvrier qui prépare les sardines."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7354f1c9-9398-3513-a57a-5ee543e1ddeb",
                        "entry_id": "171d53ab-1c17-3298-8ed7-d14502cb5606",
                        "glosses": [
                            "Industriel de la sardine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47d1d625-4d21-4a00-afe6-7143aff93c49",
                                "sense_id": "7354f1c9-9398-3513-a57a-5ee543e1ddeb",
                                "text": "Maman s’est levée ce matin à dix heures, elle est descendue déjeuner, elle est restée tout l’après-midi avec nous et, en l’absence de Maurice qui postillonne pour le compte d’un sardinier mécontent de ses huiles, nous aurions pu nous croire revenues à la belle époque."
                            }
                        ]
                    },
                    {
                        "sense_id": "03f4ae15-15d0-313d-a27c-2f2dcfbec0b5",
                        "entry_id": "171d53ab-1c17-3298-8ed7-d14502cb5606",
                        "glosses": [
                            "Bateau qui se consacre à la pêche à la sardine."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "35931c27-9748-49ad-98ba-086e5fa696a2",
                                "sense_id": "03f4ae15-15d0-313d-a27c-2f2dcfbec0b5",
                                "text": "Sur la cale dallée de larges pierres plates usées par le temps, les quilles des sardiniers et les marées, la mer montait doucement."
                            }
                        ]
                    }
                ],
