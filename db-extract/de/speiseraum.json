                        "entry_id": "bcb9808c-8154-3e8e-a8d4-bc12b25d673c",
                        "glosses": [
                            "Raum für die Mahlzeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12f1f2b9-a427-450c-a208-3d70131d1027",
                                "sense_id": "79687c94-9833-38d8-89eb-926a5d96b990",
                                "text": "„Da aber sagte der Herbergsvater, daß ich doch gleich noch den Speiseraum fegen könne, wo ich doch bereits so gut in Schwung sei.“"
                            },
                            {
                                "example_id": "e7df25a6-0abd-4728-805b-0a753b38abd3",
                                "sense_id": "79687c94-9833-38d8-89eb-926a5d96b990",
                                "text": "„Die Mahlzeiten waren einfach und vorzüglich, und der Speiseraum und die Weinstube mit ihren Holzdielen waren gut beheizt und freundlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
