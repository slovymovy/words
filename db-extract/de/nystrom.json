                ],
                "senses": [
                    {
                        "sense_id": "8480df39-52b1-3bc3-993b-cdf22f6e65e4",
                        "entry_id": "d4f38f8f-41ae-35ed-8daa-d1c1dc8dddf3",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5a055ad-c6a2-468e-bd31-8f5a0cd16321",
                                "sense_id": "8480df39-52b1-3bc3-993b-cdf22f6e65e4",
                                "text": "Frau Nystrom ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6be28ab2-5749-432c-a081-0ae264013f9a",
                                "sense_id": "8480df39-52b1-3bc3-993b-cdf22f6e65e4",
                                "text": "Herr Nystrom wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cec20c38-9367-4595-8049-9bbcc80dc999",
                                "sense_id": "8480df39-52b1-3bc3-993b-cdf22f6e65e4",
                                "text": "Die Nystroms kommen heute von Bornholm."
                            },
                            {
                                "example_id": "576bbaa2-6355-4337-b8ef-85577d82dd32",
                                "sense_id": "8480df39-52b1-3bc3-993b-cdf22f6e65e4",
                                "text": "Der Nystrom trägt nie die Schals, die die Nystrom ihm strickt."
                            },
                            {
                                "example_id": "3c2ba098-153e-4973-9b50-08bcd387786a",
                                "sense_id": "8480df39-52b1-3bc3-993b-cdf22f6e65e4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Nystrom kommt, geht der Herr Nystrom.“"
                            },
                            {
                                "example_id": "e71d3944-9b03-45c3-a0e4-0b898e0e6cf3",
                                "sense_id": "8480df39-52b1-3bc3-993b-cdf22f6e65e4",
                                "text": "Nystrom kommt und geht."
                            },
                            {
                                "example_id": "a8af4c94-42c4-4ce7-b5cf-4091ab805b37",
                                "sense_id": "8480df39-52b1-3bc3-993b-cdf22f6e65e4",
                                "text": "Nystroms kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
