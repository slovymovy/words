                        "sense_id": "b475a623-633e-3f5f-8932-0b7357710d35",
                        "entry_id": "b4ded60f-e7f9-3422-991e-0bfe25cc6ede",
                        "glosses": [
                            "A blow that winds somebody, or takes away their breath."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5fd14d9c-4da5-4144-9e13-566282ee0320",
                                "sense_id": "b475a623-633e-3f5f-8932-0b7357710d35",
                                "text": "\"Well!\" exclaimed the miner. \"That's a winder.\" He considered it a moment, said \"H'm!\" and proceeded with his dinner. Suddenly his face contracted with wrath. \"I hope he may never set foot i' my house again,\" he said."
                            }
                        ]
                    }
