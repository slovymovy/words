                    },
                    {
                        "form_id": "69622244-02cb-48a1-93ab-26402f972409",
                        "entry_id": "1e3f58b7-c95a-3709-a083-f3d3037f655b",
                        "tags": [
                            "masculine"
                        ],
                        "form": "faiseur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0e2ced65-6260-38eb-a72c-322f95bd4a42",
                        "entry_id": "1e3f58b7-c95a-3709-a083-f3d3037f655b",
                        "glosses": [
                            "Celle qui fait certains ouvrages, qui fabrique certains objets, en parlant des choses de mode."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86e90bac-c497-42df-8a8f-78d6d6b3e311",
                                "sense_id": "0e2ced65-6260-38eb-a72c-322f95bd4a42",
                                "text": "Oh ! oh ! dit la fortunée à l’envieuse, vous portez les mêmes jarretières que la reine ! Vous les prenez donc chez la même faiseuse ?"
                            },
                            {
                                "example_id": "928dd4b1-0b1e-45b8-94ad-59332eca7620",
                                "sense_id": "0e2ced65-6260-38eb-a72c-322f95bd4a42",
                                "text": "Comme [ce chapeau] avait été confectionné par une des premières faiseuses de Paris, je t'assure que, fût-il tombé du haut d'une cathédrale, il ne se serait pas déformé !"
                            }
                        ]
                    },
                    {
                        "sense_id": "b2e9f05d-85a3-3d8b-b36a-ee78a05a9ef4",
                        "entry_id": "1e3f58b7-c95a-3709-a083-f3d3037f655b",
                        "glosses": [
                            "Celle qui fait ou qui dit souvent et médiocrement les mêmes choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a11d908-04cc-4797-92fd-88bd8af25547",
                                "sense_id": "b2e9f05d-85a3-3d8b-b36a-ee78a05a9ef4",
                                "text": "Nous avons maintenant des faiseurs et des faiseuses de vers qui en pondent des centaines à l’heure, comme des œufs de mouches, qui donnent l’impression qu’ils et qu’elles pourraient en pondre des milliers, des dizaines, des centaines de milliers. C’est le triomphe de la sauce sur le poisson, du bavardage sur la sensation vraie, de la sensation sur le sentiment, du sentiment sur la pensée."
                            }
                        ]
                    },
                    {
                        "sense_id": "e411b650-35fa-38a5-bc51-3d7a8f71d93a",
                        "entry_id": "1e3f58b7-c95a-3709-a083-f3d3037f655b",
                        "glosses": [
                            "Celle qui produit un résultat, qui génère des effets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96b1d8fb-3db6-4e7f-b7df-5a75fa71fa27",
                                "sense_id": "e411b650-35fa-38a5-bc51-3d7a8f71d93a",
                                "text": "Apaisées les quotidiennes irritations de l’été, la solidarité du travail se révélait faiseuse d’amitié loyale."
                            },
                            {
                                "example_id": "8dc020d7-ff87-4ab8-8aaa-b85b2e1e7c6a",
                                "sense_id": "e411b650-35fa-38a5-bc51-3d7a8f71d93a",
                                "text": "Au lendemain des longues tractations pour Matignon, Marine Le Pen a souhaité minimiser son rôle de faiseuse de premier ministre."
                            }
                        ]
                    }
                ],
