                "senses": [
                    {
                        "sense_id": "ab036b09-f3dd-3314-8cae-b8360f0cc935",
                        "entry_id": "bcca4b05-ff53-33dd-be2c-382f602df541",
                        "glosses": [
                            "Faire partir les éléphants du parti socialiste, c’est-à-dire les membres en place depuis longtemps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "897c9d2f-2e47-4ff6-a28c-0c1cfda73967",
                                "sense_id": "ab036b09-f3dd-3314-8cae-b8360f0cc935",
                                "text": "Si Hamon gagne, comme il n’est pas présidentiable, ca va se calmer, et, dans ce cas, je compte sur lui pour déséléphantiser le PS."
                            },
                            {
                                "example_id": "a5c3b9d0-2a9a-4d85-b767-25e04aba18e3",
                                "sense_id": "ab036b09-f3dd-3314-8cae-b8360f0cc935",
                                "text": "C’est cela que SEGOLENE avait voulu casser en voulant « DESELEPHANTISER » la direction du PS, en allant vers les militants avec sa démocratie participative."
                            }
                        ]
                    }
                ],
