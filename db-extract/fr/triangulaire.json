                                    },
                                    {
                                        "sense_id": "06ffbc10-bbaa-31f7-83c8-e5f72182ab81",
                                        "entry_id": "1075c15d-59a7-3fad-a0b3-bf8588cea804",
                                        "glosses": [
                                            "mající tvar trojúhelníku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e36f5df6-32d2-4856-8686-0039af7357f5",
                                                "sense_id": "06ffbc10-bbaa-31f7-83c8-e5f72182ab81",
                                                "text": "Jestli máte drobnější poprsí a vlastníte oděv s hlubším výstřihem, oblékněte pod něj trojúhelníkovou krajkovou podprsenku, kterou bez obav přiznejte."
                                            }
                                        ]
                                    }
                                ]
