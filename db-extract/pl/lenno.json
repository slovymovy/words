                "senses": [
                    {
                        "sense_id": "2e50ac85-d01f-3fc4-8f6e-dfec32ab1d18",
                        "entry_id": "10fd4a10-a5ba-367d-ac9e-21d174c245aa",
                        "glosses": [
                            "w ustroju feudalnym / systemie lennym: dobra (najczęściej ziemskie) nadawane wasalowi przez seniora w użytkowanie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d99ce21-e415-4306-a4b9-845b06c8262e",
                                "sense_id": "2e50ac85-d01f-3fc4-8f6e-dfec32ab1d18",
                                "text": "Pozbawione męskiego dziedzica lenno z mocy prawa i obyczaju stawało się ponownie nieograniczoną własnością seniora, który mógł nim dowolnie dysponować"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "fe44d30e-2909-3899-9282-ce77a4505388",
                        "entry_id": "10fd4a10-a5ba-367d-ac9e-21d174c245aa",
                        "glosses": [
                            "w epoce feudalizmu: całokształt stosunków między seniorem a wasalem"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc4da6c7-fa11-408f-b97e-155b58a3333c",
                        "source_entry_id": "10fd4a10-a5ba-367d-ac9e-21d174c245aa",
                        "source_sense_id": "2e50ac85-d01f-3fc4-8f6e-dfec32ab1d18",
                        "target_lang_word": "feud",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81c0480f-51d9-3cc8-864d-263010489880",
                                        "entry_id": "99c26bfb-e4cc-3086-8d88-55619aa6e521",
                                        "glosses": [
                                            "A state of long-standing mutual hostility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ff1dda1-4c11-4eb4-aee0-1486a785dab7",
                                                "sense_id": "81c0480f-51d9-3cc8-864d-263010489880",
                                                "text": "You couldn't call it a feud exactly, but there had always been a chill between Phil Mickelson and Tiger Woods."
                                            },
                                            {
                                                "example_id": "0877e12c-6904-43ae-af7f-27dd4bb441f5",
                                                "sense_id": "81c0480f-51d9-3cc8-864d-263010489880",
                                                "text": "Mr. Cumming’s Dionysus in “The Bacchae” is conceived as a rock star, the rhythm-and-blues Maenads as his backup singers and groupies, and his feud with his cousin Pentheus, king of Thebes, as an encounter of the hedonistic, ambigendered, exotic Other, with “the fear of letting that into your culture,” Mr. Tiffany said."
                                            },
                                            {
                                                "example_id": "c933c749-14a6-4775-8e27-4d05a517e205",
                                                "sense_id": "81c0480f-51d9-3cc8-864d-263010489880",
                                                "text": "The feuds between Namsang and Borduria continued. In 1875-76 the dispute between the Namsang and Borduria arose about the buffaloes which were carried off by Borduria people from Namsang areas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "425c3fce-7218-377b-a765-6466458a4c7f",
                                        "entry_id": "99c26bfb-e4cc-3086-8d88-55619aa6e521",
                                        "glosses": [
                                            "A staged rivalry between wrestlers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e678f50-4819-378a-9794-35478d41f5f9",
                                        "entry_id": "99c26bfb-e4cc-3086-8d88-55619aa6e521",
                                        "glosses": [
                                            "A combination of kindred to avenge injuries or affronts, done or offered to any of their blood, on the offender and all his race."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "feud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c1457f2-27bb-30ad-955b-b64c5426a487",
                                        "entry_id": "afc0884b-f58a-371f-8478-09eefac4b533",
                                        "glosses": [
                                            "To carry on a feud."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa20f013-2cc8-44d8-80b2-0c8fae9c4867",
                                                "sense_id": "3c1457f2-27bb-30ad-955b-b64c5426a487",
                                                "text": "The two men began to feud after one of them got a job promotion and the other thought he was more qualified."
                                            },
                                            {
                                                "example_id": "f423c17c-01ef-43df-8760-1f0745808f35",
                                                "sense_id": "3c1457f2-27bb-30ad-955b-b64c5426a487",
                                                "text": "As a result of the heel turn, [Riki] Choshu was instantly elevated as a headliner and feuded with [Tatsumi] Fujinami in main events for two years over the WWF [World Wrestling Federation] International Heavyweight strap."
                                            },
                                            {
                                                "example_id": "bf8eeec0-6627-416d-8940-0354292bee4c",
                                                "sense_id": "3c1457f2-27bb-30ad-955b-b64c5426a487",
                                                "text": "Don’t look back in anger—Oasis, the prodigal sons of Brit-pop, is returning. After years of public feuding and subtweets and alleged battery with a cricket bat, the Gallagher brothers—Liam and Noel, obvs—are working it out on the remix, with a rash of 2025 summer dates announced on their website."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffe160de-d81e-3ac2-844b-4766e730cb64",
                                        "entry_id": "78b111d5-9c0c-344b-85da-5f0730862bd9",
                                        "glosses": [
                                            "An estate granted to a vassal by a feudal lord in exchange for service."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "857a4df2-0160-408a-9f38-872881715993",
                        "source_entry_id": "10fd4a10-a5ba-367d-ac9e-21d174c245aa",
                        "source_sense_id": "2e50ac85-d01f-3fc4-8f6e-dfec32ab1d18",
                        "target_lang_word": "fee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8369666e-6c32-3304-9cf7-8a73749fa6ab",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "An amount charged for a privilege."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37b289a0-9010-428e-a1aa-3c6e03a0662f",
                                                "sense_id": "8369666e-6c32-3304-9cf7-8a73749fa6ab",
                                                "text": "late fee; license fee, admission fee; activation fee; service fee"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbe44777-1e9f-3561-9c5d-221ce27f330e",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "An amount charged for professional services."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11da372a-f8c4-416d-b95f-8ec169b45ed8",
                                                "sense_id": "bbe44777-1e9f-3561-9c5d-221ce27f330e",
                                                "text": "legal fees; consulting fees"
                                            },
                                            {
                                                "example_id": "bd6f92fe-9d56-41c7-a4c5-eebb83dd000d",
                                                "sense_id": "bbe44777-1e9f-3561-9c5d-221ce27f330e",
                                                "text": "Imagine a country where children do nothing but play until they start compulsory schooling at age seven. Then, without exception, they attend comprehensives until the age of 16. Charging school fees is illegal, and so is sorting pupils into ability groups by streaming or setting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38893f15-7968-345e-946b-e2a25eb492e6",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "An additional monetary payment charged for a service or good, especially one that is minor compared to the underlying cost."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac87e302-e4db-30bd-ba3d-2effd6637236",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "An inheritable estate in land, whether absolute and without limitation to potential heirs (fee simple) or with limitations to particular kinds of heirs (fee tail)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1e97c2d-a288-3940-8fc7-19746fb7f186",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "A right to the use of a superior's land as a stipend for certain services to be performed, typically military service."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31db57ae-0ed8-3a8c-b295-4b70c4c8dadd",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "Synonym of fief: the land so held."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35deb5c0-ec9c-3e07-bc9a-89d398e04529",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "An inheritable estate in land held of a feudal lord on condition of performance of certain services, typically military service."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad105ea1-92e6-31f6-8a9d-441dbcbb396a",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "Synonym of possession."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd0745c9-a4e0-45be-9f38-a4b42973d161",
                                                "sense_id": "ad105ea1-92e6-31f6-8a9d-441dbcbb396a",
                                                "text": "Once did she hold the gorgeous East in fee;"
                                            },
                                            {
                                                "example_id": "622a0069-e6f3-46f3-bf7e-13e2ee51e8ff",
                                                "sense_id": "ad105ea1-92e6-31f6-8a9d-441dbcbb396a",
                                                "text": "What doth the poor man's son inherit? / Stout muscles and a sinewy heart, / A hardy frame, a hardier spirit; / King of two hands, he does his part / In every useful toil and art; / A heritage, it seems to me, / A king might wish to hold in fee."
                                            },
                                            {
                                                "example_id": "67f3450f-b002-42e2-8856-8b4009ffd2a8",
                                                "sense_id": "ad105ea1-92e6-31f6-8a9d-441dbcbb396a",
                                                "text": "Cronshaw had told him that the facts of life mattered nothing to him who by the power of fancy held in fee the twin realms of space and time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e427a7d3-7fe9-3eea-8b79-71bd458171c8",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "Money paid or bestowed; payment; emolument."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5a2e22c-42fb-318c-a874-b1d7b9f80ebd",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "A prize or reward. Only used in the set phrase \\\"A finder's fee\\\" in Modern English."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77d60fb5-ce1b-4ba7-9a8e-550485b0900f",
                                                "sense_id": "a5a2e22c-42fb-318c-a874-b1d7b9f80ebd",
                                                "text": "For though sweet love to conquer glorious bee, / Yet is the paine thereof much greater than the fee."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e06ebb6-09e7-3ee1-839b-d1f6183215f9",
                                        "entry_id": "cf855820-5b07-3bda-8588-f2925e45337a",
                                        "glosses": [
                                            "To reward for services performed, or to be performed; to recompense; to hire or keep in hire; hence, to bribe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57ae6e47-fcce-4bae-898c-7886abdd2165",
                                                "sense_id": "7e06ebb6-09e7-3ee1-839b-d1f6183215f9",
                                                "text": "In vain for Hellebore the patient cries / And fees the doctor; but too late is wise"
                                            },
                                            {
                                                "example_id": "6a7d6100-6680-43d6-880b-729284a36d79",
                                                "sense_id": "7e06ebb6-09e7-3ee1-839b-d1f6183215f9",
                                                "text": "There's not a one of them but in his house I keep a servant feed."
                                            },
                                            {
                                                "example_id": "3d797110-105c-4b30-957d-963ab564cbcd",
                                                "sense_id": "7e06ebb6-09e7-3ee1-839b-d1f6183215f9",
                                                "text": "We departed the grounds without seeing Marbonna; and previous to vaulting over the picket, feed our pretty guide, after a fashion of our own."
                                            },
                                            {
                                                "example_id": "5f0dc84c-4a8a-406a-aac7-e8681f40b6c8",
                                                "sense_id": "7e06ebb6-09e7-3ee1-839b-d1f6183215f9",
                                                "text": "It was at a much earlier hour than that which Mrs. Santon had named, that Delwood presented himself, and handsomely feeing the porter who answered his summons, he asked to see Miss Santon […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10fe9d31-7801-41d2-8819-a750f8162f6f",
                        "source_entry_id": "10fd4a10-a5ba-367d-ac9e-21d174c245aa",
                        "source_sense_id": "2e50ac85-d01f-3fc4-8f6e-dfec32ab1d18",
                        "target_lang_word": "fief",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fief",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47400b44-6f3d-3720-bde2-ac1e5d9888e1",
                                        "entry_id": "26a0bcdc-e8c8-35b6-ad7a-8d4db261306d",
                                        "glosses": [
                                            "Land held of a superior, particularly on condition of homage, fealty, and personal service, especially military service."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6524a35f-79c3-4a7f-9601-a55ded12a142",
                                                "sense_id": "47400b44-6f3d-3720-bde2-ac1e5d9888e1",
                                                "text": "Fief: m[asculine] A Fief. A (Knights) fee, a Mannor, or inheritance held by homage, and fealty; and given at the firſt, in truſt, and upon promiſe of aſſiſtance, or ſervice in the wars: […] Alſo, a Tenure, or Eſtate in fief, or in fee. This word was firſt heard of, after the conqueſt of Gallia by the Francs (or ancient French-men) when their Soveraign Princes, reſerving ſome land for their own Domains, diſtributed the reſt (by whole Countreys, or large territories) among their Captains, and principal followers, on condition, that they ſhould hold of them, and aid them in their wars […]"
                                            },
                                            {
                                                "example_id": "3c841cfc-2b20-4731-a04a-0a9f58f4e48f",
                                                "sense_id": "47400b44-6f3d-3720-bde2-ac1e5d9888e1",
                                                "text": "And be it further ordained and enacted by the Authority aforesaid, That the Right and Title of the said Ecclesiastics of the Seminary of Saint Sulpice of Montreal, in and to all and singular the said Fiefs and Seigniories of the Island of Montreal, of the Lake of the Two Mountains, and of Saint Sulpice, and their several Dependencies, and in and to all Seigniorial and Feudal Rights, Privileges, Dues, and Duties arising out of and from the same, and in and to all and every the Domains, Lands, Reservations, Buildings, Messuages, Tenements, and Hereditaments within the said several Fiefs and Seigniories now held and possessed by them as Proprietors thereof, […] shall be and they are hereby confirmed and declared good, valid, and effectual in the Law; […]"
                                            },
                                            {
                                                "example_id": "6aab957e-4226-4c19-931f-8cf757c9f99f",
                                                "sense_id": "47400b44-6f3d-3720-bde2-ac1e5d9888e1",
                                                "text": "The chief obligation of a sipahi was to take up residence on his fief and to be prepared at all times to rally, armed for battle, to his banner-holder's flag on the sultan's order. According to the income of his fief, every sipahi had to raise a fixed number of armed horsemen (cebeli), who followed him on campaigns."
                                            },
                                            {
                                                "example_id": "e6ad8c24-2023-424e-8c51-a2f581c05483",
                                                "sense_id": "47400b44-6f3d-3720-bde2-ac1e5d9888e1",
                                                "text": "By the 14th century, however, fief holding was in decline, as salaries and retainer fees, rather than fiefs, became standard for aristocrats in binding their knights to them, and as kings increasingly exercised royal power directly or through judges and bureaucrats, not through dukes and counts. Fief holding, which is what \"feudalism\" must be considered to mean if the term has any precise meaning at all—and what the term meant when it was coined in the 17th century—had become an insignificant part of social and governmental relations by the end of the Middle Ages."
                                            },
                                            {
                                                "example_id": "58851e97-8a83-4616-bac8-c4161f9df9e5",
                                                "sense_id": "47400b44-6f3d-3720-bde2-ac1e5d9888e1",
                                                "text": "Where a vassal kills the brother, son, or grandson of his lord, he should lose his fief on account of it."
                                            },
                                            {
                                                "example_id": "fdf6ff67-af5b-4aaa-9f32-2a99d9e7587e",
                                                "sense_id": "47400b44-6f3d-3720-bde2-ac1e5d9888e1",
                                                "text": "Investiture was the conferring of a fief by the lord to the vassal, and the rite consisted in the handing over by the lord of some symbolic object intended to represent the act of concession."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6c7c465-94b9-372a-8988-228665ee24d2",
                                        "entry_id": "26a0bcdc-e8c8-35b6-ad7a-8d4db261306d",
                                        "glosses": [
                                            "Synonym of estate: any land, when considered as a region over which the owner exercises lordly control."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36bf80e9-00cc-4a4c-9c7a-df3c637068a2",
                                                "sense_id": "e6c7c465-94b9-372a-8988-228665ee24d2",
                                                "text": "Through the years of my childhood my maternal grandmother remained the one unforgettable presence, the strong country woman ruling over her farm like a medieval lord. On her fief I first opened my eyes to poetry and to the land. […] There was something of the ancient matriarch in her, who had given her life to the ground, who felt that on her fief in southern Luxembourg she stood in the right place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd0c637c-eae8-38ef-a06e-acb1f744dede",
                                        "entry_id": "26a0bcdc-e8c8-35b6-ad7a-8d4db261306d",
                                        "glosses": [
                                            "A territory, a domain, an area over which one exercises lordly control, particularly with regard to corporate or governmental bureaucracies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
