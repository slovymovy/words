                ],
                "senses": [
                    {
                        "sense_id": "1bbd293b-d8bc-35d9-a28b-8a97cddd8414",
                        "entry_id": "62a22f5a-8db8-3751-bb7e-a8b27460dfd0",
                        "glosses": [
                            "Celui qui arpente, qui mesure les terres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06221c53-46f9-4ab2-a8c6-bc810d28b844",
                                "sense_id": "1bbd293b-d8bc-35d9-a28b-8a97cddd8414",
                                "text": "Des arpenteurs avec de longues chaînes allaient mesurant le terrain ; des arbitres établissaient les premières propriétés."
                            },
                            {
                                "example_id": "1bedf719-6923-418e-bbb2-7b65080727bd",
                                "sense_id": "1bbd293b-d8bc-35d9-a28b-8a97cddd8414",
                                "text": "M. Gauthier, loin de voler, vivait tout juste de son métier d’arpenteur attaché au cadastre."
                            },
                            {
                                "example_id": "c87ea4b9-0f70-4f07-bc14-d1a09639b8a0",
                                "sense_id": "1bbd293b-d8bc-35d9-a28b-8a97cddd8414",
                                "text": "Les mesures agraires de Quarré, avant la Révolution (elles persistent aujourd'hui), n'avaient pas de base fixe. Un journal de champ, une « soiture » de pré oscillaient entre vingt-deux et trente-cinq ares de nos mesures métriques. L’arpenteur a besoin de passer par là avant les transactions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b5e9794-b95f-475e-8c76-aac4ff12ea67",
                        "source_entry_id": "62a22f5a-8db8-3751-bb7e-a8b27460dfd0",
                        "source_sense_id": "1bbd293b-d8bc-35d9-a28b-8a97cddd8414",
                        "target_lang_word": "Feldmesser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feldmesser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f672acc5-8579-3fb0-9953-946123a4a9b6",
                                        "entry_id": "057ad9c6-65e8-3332-95b6-81e358fda422",
                                        "glosses": [
                                            "Person, welche beruflich die Erde und die auf ihr vorhandenen, festen Objekte wie Grundstücke oder Bauwerke vermisst"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3be22539-7aa8-47d3-a767-6a8c7bd2ec06",
                                                "sense_id": "f672acc5-8579-3fb0-9953-946123a4a9b6",
                                                "text": "Feldmesser gab es bereits im Römischen Reich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Feldmesser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d868d6b2-34af-3fec-8647-76f41192dde5",
                                        "entry_id": "3ab6f10f-569c-3409-b796-81a1a64a469b",
                                        "glosses": [
                                            "speziell für das Schlachtfeld konzipiertes Schneidewerkzeug mit Griff und Klinge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b79fee1-dfb5-4828-a1b7-d73892887752",
                                                "sense_id": "d868d6b2-34af-3fec-8647-76f41192dde5",
                                                "text": "Ein typisches Feldmesser ist etwa 15-20 Zentimeter lang."
                                            },
                                            {
                                                "example_id": "d10cf82f-deb3-4991-a34f-a8ff5f9c7acc",
                                                "sense_id": "d868d6b2-34af-3fec-8647-76f41192dde5",
                                                "text": "„Von Zeitler bis Glock 1975 erhielt die Wiener Firma Zeitler den Auftrag, ein Mehrzweckmesser zu entwerfen, das sowohl als Feldmesser und bei Bedarf auch als Seitengewehr zu verwenden sein sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76f7a41c-3960-46ad-97e5-3fa054c5118e",
                        "source_entry_id": "62a22f5a-8db8-3751-bb7e-a8b27460dfd0",
                        "source_sense_id": "1bbd293b-d8bc-35d9-a28b-8a97cddd8414",
                        "target_lang_word": "Geometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
