                    {
                        "sense_id": "cccc53bb-a050-33ae-bf5b-17bb5c631206",
                        "entry_id": "f336f226-ac4f-3974-8129-815a3848703e",
                        "glosses": [
                            "A person who follows or supports Lenin or the philosophy of Leninism."
                        ],
