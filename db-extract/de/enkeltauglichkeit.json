                "senses": [
                    {
                        "sense_id": "33597e9d-9417-3453-abe1-565d84479b01",
                        "entry_id": "e635f8a6-bb34-3898-ba94-f855756e293c",
                        "glosses": [
                            "Eigenart, die Enkelgeneration nicht zu belasten (insbesondere im Hinblick auf die Umwelt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe5b3085-51df-435a-9d29-0947bf779154",
                                "sense_id": "33597e9d-9417-3453-abe1-565d84479b01",
                                "text": "„Bei der Enkeltauglichkeit sollen Strukturen auf ihre Nachhaltigkeit getestet werden.“"
                            },
                            {
                                "example_id": "919dd51e-c192-4499-9f04-a2b85cc03b4e",
                                "sense_id": "33597e9d-9417-3453-abe1-565d84479b01",
                                "text": "„Denn Enkeltauglichkeit klingt irgendwie konservativ und nach Jägerzaun-Idylle.“"
                            },
                            {
                                "example_id": "299db7c1-f9a5-4e45-b14f-41ea5fc417a4",
                                "sense_id": "33597e9d-9417-3453-abe1-565d84479b01",
                                "text": "„Seit Beginn der kommunalen Gartenämter ab der 2. Hälfte des 19. Jahrhunderts ist deren Wirken im Zuge der gründerzeitlichen Stadterweiterungen in die Zukunft gerichtet, mit einer Dauerperspektive verbunden und insofern der Enkeltauglichkeit verpflichtet.“"
                            },
                            {
                                "example_id": "c48336fe-4fe9-4268-aaf4-19fa24097397",
                                "sense_id": "33597e9d-9417-3453-abe1-565d84479b01",
                                "text": "„Georg Hiltner, Hauptgeschäftsführer der Handwerkskammer Konstanz, sieht in puncto Enkeltauglichkeit auch das Handwerk in der Pflicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
