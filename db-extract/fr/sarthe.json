                    {
                        "sense_id": "89f06bc1-6e0b-3443-9737-19da86e95177",
                        "entry_id": "53b475d3-d8a1-30d0-be20-ab2c073ace47",
                        "glosses": [
                            "Département français de la région administrative des Pays de la Loire. Ce département porte le numéro 72."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc163f7d-71de-482c-99fa-82b3b6e2d167",
                                "sense_id": "89f06bc1-6e0b-3443-9737-19da86e95177",
                                "text": "Essentiellement agricole, mais peu accessible aux innovations, le département de la Sarthe n’a pour toute richesse que des produits aujourd’hui dépréciés : des céréales , quelques bestiaux."
                            },
                            {
                                "example_id": "2e7368e6-8cf2-4f99-a912-ce22b0f39d23",
                                "sense_id": "89f06bc1-6e0b-3443-9737-19da86e95177",
                                "text": "Mon Dieu ! ce n’était peut-être pas un saint. Qui donc est saint dans le département de la Sarthe ?"
                            },
                            {
                                "example_id": "48edcae4-d750-4f96-99c0-c1ea276de4cb",
                                "sense_id": "89f06bc1-6e0b-3443-9737-19da86e95177",
                                "text": "Le 14 janvier, on était en route sur Laval, à l’extrémité ouest de ce pauvre département de la Sarthe dont les six cent mille hectares furent assignés aux dernières convulsions de la Défense nationale."
                            }
                        ]
