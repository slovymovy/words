                    },
                    {
                        "sense_id": "977bd7f9-3c59-33ab-8c19-ed5a498569d2",
                        "entry_id": "b2901a63-e1d5-3274-a3ff-b245b62474b5",
                        "glosses": [
                            "изменение расположения или направления движения кого-либо, чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3549aeee-b204-4087-a3ad-f8de31fe3acb",
                                "sense_id": "977bd7f9-3c59-33ab-8c19-ed5a498569d2",
                                "text": "Отвод в сторону прямого удара глефой по плечу."
                            }
                        ]
                    },
                    {
                        "sense_id": "38199e6f-ac34-35a7-99cb-de20d4d830ef",
                        "entry_id": "b2901a63-e1d5-3274-a3ff-b245b62474b5",
                        "glosses": [
                            "назначение, предоставление в пользование, в распоряжение, предназначить для чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e2e532e-ad0d-4b79-9642-e15ecc940381",
                                "sense_id": "38199e6f-ac34-35a7-99cb-de20d4d830ef",
                                "text": "Претензий ни от кого не поступило, почему власти сразу приступили к отводу площади застройщикам."
                            }
                        ]
                    },
                    {
                        "sense_id": "d64d49d9-9834-3d31-9cf5-b1824b4b7e3a",
                        "entry_id": "b2901a63-e1d5-3274-a3ff-b245b62474b5",
                        "glosses": [
                            "юр. заявление об отстранении кого-либо от участия в чём-либо, о снятии чьей-либо кандидатуры; само́отстранение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65a0134b-7b7d-4ff4-af69-7bd9bad5d191",
                                "sense_id": "d64d49d9-9834-3d31-9cf5-b1824b4b7e3a",
                                "text": "Дать отвод судье при наличии оснований считать его пристрастным."
                            },
                            {
                                "example_id": "b524bbae-408e-4672-8277-389c72511f6f",
                                "sense_id": "d64d49d9-9834-3d31-9cf5-b1824b4b7e3a",
                                "text": "Дать отвод председателю кооператива из-за его казнокрадства."
                            },
                            {
                                "example_id": "dd95dd1b-f95d-4117-babf-bbb7769ffbd4",
                                "sense_id": "d64d49d9-9834-3d31-9cf5-b1824b4b7e3a",
                                "text": "Есть отводы по чьей-либо кандидатуре."
                            }
                        ]
                    },
                    {
                        "sense_id": "82bfd203-e22a-32ac-928b-1b3f25074961",
                        "entry_id": "b2901a63-e1d5-3274-a3ff-b245b62474b5",
                        "glosses": [
                            "техн. процесс перемещения каких-либо субстанций с помощью специальных устройств, чтобы направить их в нужном направлении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51b6cfb8-0d73-4fe6-adc8-b8a793eb6b98",
                                "sense_id": "82bfd203-e22a-32ac-928b-1b3f25074961",
                                "text": "Отвод воды из водохранилища."
                            }
                        ]
                    },
                    {
                        "sense_id": "821e4c4e-e624-3377-aa43-53256d4b0abf",
                        "entry_id": "b2901a63-e1d5-3274-a3ff-b245b62474b5",
                        "glosses": [
                            "техн. боковая линия, ответвление в трубе, кабеле"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b79a2a3-2691-4df8-92a8-6968fb6db0fc",
                                "sense_id": "821e4c4e-e624-3377-aa43-53256d4b0abf",
                                "text": "На тридцатом километре магистрального кабеля есть отвод."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1bd89d7-3a04-3ab1-9419-2646b27aab07",
                        "entry_id": "b2901a63-e1d5-3274-a3ff-b245b62474b5",
                        "glosses": [
                            "воен. перемещение на другую позицию, перевод чего-либо вглубь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af31fd1c-1069-493b-988c-273a4038d32c",
                                "sense_id": "b1bd89d7-3a04-3ab1-9419-2646b27aab07",
                                "text": "Отвод солдат в укрытие."
                            },
                            {
                                "example_id": "86d6e4b9-9659-4f90-81b4-2cc32c44ec56",
                                "sense_id": "b1bd89d7-3a04-3ab1-9419-2646b27aab07",
                                "text": "Отвод роты на запасной рубеж."
                            }
                        ]
                    },
                    {
                        "sense_id": "9457517e-b5ba-3863-a8c5-02758dbafdee",
                        "entry_id": "b2901a63-e1d5-3274-a3ff-b245b62474b5",
                        "glosses": [
                            "устар. один из двух изогнутых брусьев, идущих под углом от передка саней и служащих для устройства более широкой поверхности саней"
                        ],
                        "tags": [
                            "в санях"
                        ],
                        "examples": [
                            {
                                "example_id": "7cd4f573-37cb-49c1-9703-74db89db69fd",
                                "sense_id": "9457517e-b5ba-3863-a8c5-02758dbafdee",
                                "text": "Сел было на отвод саней."
                            }
                        ]
                    },
                    {
                        "sense_id": "fee8aeef-a58e-314f-a2a9-f77638ebb294",
                        "entry_id": "b2901a63-e1d5-3274-a3ff-b245b62474b5",
                        "glosses": [
                            "керам. цветные полосы, каёмки, наносящиеся вокруг чего-либо"
                        ],
                        "tags": [
                            "обычно мн.",
                            "в стекольно-фарфоровом производстве"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "01a9ad7d-2e18-3cd9-9a1f-df6a9c780f21",
                        "entry_id": "b2901a63-e1d5-3274-a3ff-b245b62474b5",
                        "glosses": [
                            "выгон, пастбище"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79139a8c-53ff-4848-a706-561bdad72f1d",
                                "sense_id": "01a9ad7d-2e18-3cd9-9a1f-df6a9c780f21",
                                "text": "Кус земли во многие тысячи десятин был отведен под попас станичных жеребцов, потому и назван — отводом."
                            }
                        ]
                    }
