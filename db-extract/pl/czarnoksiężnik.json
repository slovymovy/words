                "senses": [
                    {
                        "sense_id": "63f73824-9b89-3492-83b5-11e5b47c2abb",
                        "entry_id": "bb75d713-122c-3d5c-ad5c-ae3969049f8f",
                        "glosses": [
                            "osoba zajmująca się czarami i zjawiskami nadprzyrodzonymi"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "cdbf7b86-8389-313f-8929-9a9743bb62da",
                        "entry_id": "bb75d713-122c-3d5c-ad5c-ae3969049f8f",
                        "glosses": [
                            "osoba zajmująca się czarami w formie badań naukowych i okultystycznych, z użyciem „czarnych ksiąg” tj. grymuarów"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "430c938e-a178-49e9-a0e6-fffb7c79e33c",
                                "sense_id": "cdbf7b86-8389-313f-8929-9a9743bb62da",
                                "text": "[…] mniemana owa mądrość zaklinania i odklinania nieba i ziemi, czyli czarodziejska, na rodzinnéj powstała ziemi i tylko ją w obce ubrano kształty, czyli po obcemu ubrano w szatę nauki, że tego, który ją transcendentalnie czyli naukowo (t.j. przy pomocy ksiąg) wykształcał i praktykował, czarnoksiężnikiem – tego zaś, który sposobem dostępnym wykonywał ją (z przymiotów przyrodzenia moc nadprzyrodzoną wyciskać umiejąc) czarodziejem mianowano"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "96aff612-1937-31b4-ab54-cd50ddd5a01d",
                        "entry_id": "bb75d713-122c-3d5c-ad5c-ae3969049f8f",
                        "glosses": [
                            "osoba uczona, bardzo zręczna"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6a7c06b-ab46-44db-93a3-00dfd67153a1",
                        "source_entry_id": "bb75d713-122c-3d5c-ad5c-ae3969049f8f",
                        "source_sense_id": "63f73824-9b89-3492-83b5-11e5b47c2abb",
                        "target_lang_word": "sorcerer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorcerer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32dd64b0-f086-3663-8db4-6d638c589dab",
                                        "entry_id": "b8a3cb3a-5338-3514-9425-9ccf36257571",
                                        "glosses": [
                                            "A magician or wizard. Sometimes specifically male."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3298215e-0bc5-4c17-aa36-2200e2e9168e",
                                                "sense_id": "32dd64b0-f086-3663-8db4-6d638c589dab",
                                                "text": "Pope Joan, who once occupied the throne of the Vatican, was reputed to be the blackest sorcerer of them all."
                                            },
                                            {
                                                "example_id": "e7a46346-c9b2-4598-9e25-03c2001fb7ac",
                                                "sense_id": "32dd64b0-f086-3663-8db4-6d638c589dab",
                                                "text": "\"Well, sorcerer?\" growled the Norman. \"Nay, not well,\" replied Catweazle shivering miserably, \"I have the bone-ache.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8d654a1-b7ce-4736-801c-bbd1d064c00b",
                        "source_entry_id": "bb75d713-122c-3d5c-ad5c-ae3969049f8f",
                        "source_sense_id": "63f73824-9b89-3492-83b5-11e5b47c2abb",
                        "target_lang_word": "warlock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warlock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7012e3f-e85c-382a-9308-569ade782153",
                                        "entry_id": "6ef573ae-a9f4-3122-b656-11fb8c4f54af",
                                        "glosses": [
                                            "A male magic-user; a male witch; a wizard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c61cbe08-244d-48ba-811a-1c6d8139b4b4",
                                                "sense_id": "e7012e3f-e85c-382a-9308-569ade782153",
                                                "text": "He was himself a warlock, or wizard, which they knew by his taking the witch's part."
                                            },
                                            {
                                                "example_id": "f3d34789-75ba-4365-860c-0907bf4f1f8b",
                                                "sense_id": "e7012e3f-e85c-382a-9308-569ade782153",
                                                "text": "It was the day of warlocks and apparitions, now happily driven out by the zeal of the General Assembly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e2b8cf0-c864-313f-a101-da310ce2e263",
                                        "entry_id": "6ef573ae-a9f4-3122-b656-11fb8c4f54af",
                                        "glosses": [
                                            "A magic-user (regardless of gender)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e200918-f21d-441d-b57a-0a2681e586ca",
                                                "sense_id": "2e2b8cf0-c864-313f-a101-da310ce2e263",
                                                "text": "“Is it because she was a warlock?” she asked. “I know different kinds of magic . . .” “No, that's not it, or at least . . .” Mereth paused, collecting her thoughts, then explained, “The warlockry doesn't help, Lady Sarai,[…]”"
                                            },
                                            {
                                                "example_id": "500b6d41-b551-4f64-bae0-28285f619f47",
                                                "sense_id": "2e2b8cf0-c864-313f-a101-da310ce2e263",
                                                "text": "It seemed like a strange thing for her to risk on a student she barely knew—but then, she was a warlock. Simon had no idea what they were capable of, but he was getting better at imagining."
                                            },
                                            {
                                                "example_id": "b5d61fc8-f9d8-4a28-b152-09c68c515b12",
                                                "sense_id": "2e2b8cf0-c864-313f-a101-da310ce2e263",
                                                "text": "Usually she blended in with the rest of the Academy faculty, making it easy to forget she was a warlock (at least, if you overlooked the blue skin). But he'd noticed that whenever another Downworlder was on campus, Catarina went out[…]"
                                            },
                                            {
                                                "example_id": "5b4640a3-bd47-4409-893a-5c3533c99004",
                                                "sense_id": "2e2b8cf0-c864-313f-a101-da310ce2e263",
                                                "text": "“We're also looking for a couple of warlocks,” Magnus said. “A Korean woman and a green fellow with horns.” “Oh,” said Fang with a distinct change of mood. “Them.” “You've seen them?” Alec said, trying not to sound too eager."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07508178-e590-4f90-ab5e-64c830208991",
                        "source_entry_id": "bb75d713-122c-3d5c-ad5c-ae3969049f8f",
                        "source_sense_id": "63f73824-9b89-3492-83b5-11e5b47c2abb",
