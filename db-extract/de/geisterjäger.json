                                "target_senses": [
                                    {
                                        "sense_id": "7fb7825f-d7dc-3a84-a229-1541193c468c",
                                        "entry_id": "09d1bcf8-ea3a-307d-9ba0-6ad875786a51",
                                        "glosses": [
                                            "Personne qui se présente comme un spécialiste des phénomènes paranormaux et particulièrement des lieux hantés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f23d63b1-86c1-4a19-815f-969924856c20",
                                                "sense_id": "7fb7825f-d7dc-3a84-a229-1541193c468c",
                                                "text": "Depuis plusieurs années, ce \"chasseur de fantômes\" explore toutes sortes de lieux à la recherche d’esprits en errance."
                                            },
                                            {
                                                "example_id": "c111316d-a4b6-48ae-ab15-520d43f2c329",
                                                "sense_id": "7fb7825f-d7dc-3a84-a229-1541193c468c",
                                                "text": "Également invité dans l’émission, River James est chasseur de fantômes depuis huit ans. Il nous parle de ce lieu emblématique, une référence française en matière de paranormal."
                                            },
                                            {
                                                "example_id": "9852740d-62dc-4298-85d7-bf7dbd6f7bef",
                                                "sense_id": "7fb7825f-d7dc-3a84-a229-1541193c468c",
                                                "text": "Chasseur de fantômes de son état - lui préfère l’appellation \"passeur d’âmes\" - Raymond a eu une \"révélation\" à l’âge de quarante-deux ans. Depuis, il désenvoute les maisons encore \"habitées\" de leurs précédents propriétaires décédés, et traque les \"mémoires\" douloureuses qui en imprègnent les murs."
                                            }
                                        ]
                                    }
                                ]
                            }
