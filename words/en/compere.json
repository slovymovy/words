                    "frequency": "Low",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>compere</w> welcomed the audience to the start of the variety show.",
                            "target_lang_translations": {
                                "nl": "De <w>presentator</w> verwelkomde het publiek bij de start van de variétéshow."
                            }
                        },
                        {
                            "text": "Our local <w>compere</w> kept the quiz night moving with his jokes.",
                            "target_lang_translations": {
                                "nl": "Onze lokale <w>spreekstalmeester</w> hield de quizavond levendig met zijn grappen."
                            }
                        }
