                ],
                "senses": [
                    {
                        "sense_id": "3402280c-4575-3fb5-a369-dea8838a0934",
                        "entry_id": "3ab710f1-21b3-3800-8136-735d35a725c1",
                        "glosses": [
                            "al het water dat zich in de aardbodem bevindt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34797cb7-33a2-405b-b5df-1400244717f4",
                                "sense_id": "3402280c-4575-3fb5-a369-dea8838a0934",
                                "text": "De zorg voor het ondiepe grondwater in de openbare ruimte is een gemeentetaak."
                            },
                            {
                                "example_id": "23820d58-c7b9-43b5-8d8f-51d3a1d5f8fa",
                                "sense_id": "3402280c-4575-3fb5-a369-dea8838a0934",
                                "text": "Het grondwater, geelachtig en roodbruin, verbreidt een strontstank."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "618d55fe-8b1b-4421-a854-10148617b133",
                        "source_entry_id": "3ab710f1-21b3-3800-8136-735d35a725c1",
                        "source_sense_id": "3402280c-4575-3fb5-a369-dea8838a0934",
                        "source_sense_description": "al het water dat zich in de aardbodem bevindt",
                        "target_lang_word": "Grundwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grundwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac251f68-4912-3f93-95d1-0bee677b8d36",
                                        "entry_id": "7a1dabf5-8262-3edb-8d93-6c5c56e3cf81",
                                        "glosses": [
                                            "nach DIN 4049 definiert als „unterirdisches Wasser, das die Hohlräume der Erdrinde zusammenhängend ausfüllt und dessen Bewegung ausschließlich oder nahezu ausschließlich von der Schwerkraft und den durch die Bewegung selbst ausgelösten Reibungskräften bestimmt wird“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "277e4c8f-dc84-498e-afe1-f9d370cdd3a8",
                                                "sense_id": "ac251f68-4912-3f93-95d1-0bee677b8d36",
                                                "text": "Grundwasser entsteht, wenn Niederschläge versickern oder Wasser im Uferbereich von Oberflächengewässern (Flüssen, Seen, siehe auch Uferfiltrat) in den Untergrund infiltriert."
                                            },
                                            {
                                                "example_id": "c570007e-3ba7-4bc8-94ca-915ac57892a1",
                                                "sense_id": "ac251f68-4912-3f93-95d1-0bee677b8d36",
                                                "text": "„Dort, wo Grundwasser stauende Bodenschichten sich mit der Erdoberfläche schneiden, wo Spalten und Höhlungen des Gesteins sich nach außen öffnen, tritt Grundwasser als Quelle ans Tageslicht.“"
                                            },
                                            {
                                                "example_id": "2ed6c887-f2eb-47d0-ac37-41128643675f",
                                                "sense_id": "ac251f68-4912-3f93-95d1-0bee677b8d36",
                                                "text": "„Warum das Wasser der keltischen Göttin Sirona geweiht war, lässt sich nur mutmaßen – vielleicht deshalb, weil es Grundwasser ist, das unmittelbar aus dem Boden strömt, so kalkhaltig, dass es bereits eine Sinterdecke gebildet hat.“"
                                            },
                                            {
                                                "example_id": "a326f0f9-de08-422b-a23f-e822bb7ac5c7",
                                                "sense_id": "ac251f68-4912-3f93-95d1-0bee677b8d36",
                                                "text": "„In Manching ging das hoch stehende Grundwasser eine unheilige Allianz mit den Abfällen ein, die die Kelten in ausrangierten Vorratsgruben verscharrten.“"
                                            },
                                            {
                                                "example_id": "3b7de012-7946-4ce4-9158-7bcd45e5bb24",
                                                "sense_id": "ac251f68-4912-3f93-95d1-0bee677b8d36",
                                                "text": "„Das Salz, das den Ton gebunden hatte, wurde langsam von Regen und Grundwasser ausgespült.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36d0eaf8-830b-4cf6-9c0c-8267ff256f37",
                        "source_entry_id": "3ab710f1-21b3-3800-8136-735d35a725c1",
                        "source_sense_id": "3402280c-4575-3fb5-a369-dea8838a0934",
                        "source_sense_description": "al het water dat zich in de aardbodem bevindt",
                        "target_lang_word": "groundwater",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "groundwater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70ba5b77-9237-3f04-955a-925603f69c25",
                                        "entry_id": "969ef4cb-f80d-3a25-bf1a-fd677f169a82",
                                        "glosses": [
                                            "Water that exists beneath the earth's surface in underground streams and aquifers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b396b19-c0d6-4fa4-b622-75c0bffb4164",
                                                "sense_id": "70ba5b77-9237-3f04-955a-925603f69c25",
                                                "text": "The pH in water of the hillside soils varied between 3.1 and 6.1 with a mean of 4.2. The pattern of pH variation is complex and does not clearly relate either to cultivation or occupation. The most consistent, though weak, correlation appears to be between higher pH and flushes or bogs, which indicates that the local groundwaters are comparatively basic."
                                            },
                                            {
                                                "example_id": "6abe9833-2cff-4722-be2e-793ed7cc0685",
                                                "sense_id": "70ba5b77-9237-3f04-955a-925603f69c25",
                                                "text": "Research has shown bone apatite to undergo chemical exchange with carbonates in either vadose water or groundwater."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e332cc34-9bb3-4bcb-b86c-a51b3b3a1718",
                        "source_entry_id": "3ab710f1-21b3-3800-8136-735d35a725c1",
                        "source_sense_id": "3402280c-4575-3fb5-a369-dea8838a0934",
                        "source_sense_description": "al het water dat zich in de aardbodem bevindt",
                        "target_lang_word": "nappe phréatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nappe phréatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe4a5fdb-83cd-347c-b28b-487eb486df82",
                                        "entry_id": "887b6f41-0658-3a67-9662-6b25f4b7594f",
                                        "glosses": [
                                            "Couche souterraine à faible profondeur, contenant de l’eau, et qui alimente traditionnellement les puits et les sources en eau potable."
                                        ],
                                        "tags": [
                                            "Hydrogéologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17f13842-a77d-47c9-b8a6-968c16da0e32",
                                                "sense_id": "fe4a5fdb-83cd-347c-b28b-487eb486df82",
                                                "text": "Reprenons ici l'exemple de l’atrazine, appliquée pour le désherbage des voies de chemin de fer en Suisse. Après avoir été détectée dans les nappes phréatiques, l’atrazine a été remplacée par le diuron."
                                            },
                                            {
                                                "example_id": "20db4dd4-8fdd-42c3-903a-170ebbeb58ae",
                                                "sense_id": "fe4a5fdb-83cd-347c-b28b-487eb486df82",
                                                "text": "Les ressources en eau sont également impactées car les forêts permettent de reconstituer les nappes phréatiques et fournissent trois quarts de l’eau accessible aux villes."
                                            },
                                            {
                                                "example_id": "8de6f6d7-2f27-48ef-ba6f-a59e80b44f8a",
                                                "sense_id": "fe4a5fdb-83cd-347c-b28b-487eb486df82",
                                                "text": "Dans ces régions de massifs anciens, à faible manteau détritique, les nappes phréatiques sont généralement peu importantes et limitées au seul talweg."
                                            },
                                            {
                                                "example_id": "f61e6d19-364a-458d-865d-2411a877df92",
                                                "sense_id": "fe4a5fdb-83cd-347c-b28b-487eb486df82",
                                                "text": "Ils alertent notamment « sur la menace qui pèse sur la nappe phréatique du bassin rhénan en raison des défaillances structurelles du site de stockage ». Un risque est désormais « certain », selon eux, que la mine soit rapidement inondée, ce qui « provoquera une pollution irréversible de la nappe phréatique »."
                                            },
                                            {
                                                "example_id": "f5080b30-c9df-4634-a796-79c70c845912",
                                                "sense_id": "fe4a5fdb-83cd-347c-b28b-487eb486df82",
                                                "text": "La nappe phréatique de Campbon, qui approvisionne la région de Saint-Nazaire en eau potable, est aussi utilisée par le producteur d’eau en bouteille, Cristaline."
                                            },
                                            {
                                                "example_id": "f795cb03-9638-4973-beee-d111f5a0de58",
                                                "sense_id": "fe4a5fdb-83cd-347c-b28b-487eb486df82",
                                                "text": "En mars 2023, Atlantic’eau, le syndicat départemental d’alimentation en eau potable qui gère la nappe, a révélé avoir découvert la présence de 33 molécules résistant au traitement de l’usine de potabilisation. Toutes ces molécules n’ont pu être identifiées, mais sept sont des pesticides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
