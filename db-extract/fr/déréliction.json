                        "source_entry_id": "b183d784-fd99-3b85-a634-f891ca5e683f",
                        "target_lang_word": "verlatenheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verlatenheid",
