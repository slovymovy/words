                                "target_senses": [
                                    {
                                        "sense_id": "82dfe56a-df71-3fb6-ab09-6cbbd229e984",
                                        "entry_id": "451a9bd0-6301-38a7-9217-5b8513688349",
                                        "glosses": [
                                            "Alternative spelling of lighthearted."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bd7fddd-889a-4169-ae0a-ac2008fd468c",
                                                "sense_id": "82dfe56a-df71-3fb6-ab09-6cbbd229e984",
                                                "text": "Musicals are lighter-hearted than operas – West Side Story, for example, has a very sad ending, but it also has America and Gee, Officer Krupke."
                                            },
                                            {
                                                "example_id": "ae0cb890-cbbf-4690-9d07-76f6fa6608c0",
                                                "sense_id": "82dfe56a-df71-3fb6-ab09-6cbbd229e984",
                                                "text": "And I didn’t think I would ever write things like infanticide, which you see in Morrison’s novels. I thought I was writing away from that to something lighter-hearted, but I kept getting pulled back."
                                            },
                                            {
                                                "example_id": "ad657544-ce25-4e00-b987-a18c34c54e8e",
                                                "sense_id": "82dfe56a-df71-3fb6-ab09-6cbbd229e984",
                                                "text": "Even the lightest-hearted of the nominees bears the shadow of suspense."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
