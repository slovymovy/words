                ],
                "senses": [
                    {
                        "sense_id": "3ae2e094-c47f-3efe-830b-99fb185f5004",
                        "entry_id": "2c50892e-3799-3a97-b1e0-9d1d66ab2b7f",
                        "glosses": [
                            "Verlauf eines Flusses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21d8f97b-3a5f-40ca-a59f-fbff44921fd9",
                                "sense_id": "3ae2e094-c47f-3efe-830b-99fb185f5004",
                                "text": "Folge dem Flusslauf, bis du zu einem roten Haus kommst."
                            },
                            {
                                "example_id": "34dddd00-6683-4bbd-868e-d36b2e032b9b",
                                "sense_id": "3ae2e094-c47f-3efe-830b-99fb185f5004",
                                "text": "„Mehrere Stunden kletterten wir im Flusslauf abwärts, bis wir zu einem sbgeschiedenen, von Kiefern umstandenen See kamen.“"
                            },
                            {
                                "example_id": "d883ad6d-3537-4dca-8117-22beb58ab600",
                                "sense_id": "3ae2e094-c47f-3efe-830b-99fb185f5004",
                                "text": "„Wie Küstenkonturen eine Herausforderung für Seefahrer und Meereskartografen waren, so waren Flussläufe eine für reisende Kaufleute, Wegbeschreiber und Landkartenzeichner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
