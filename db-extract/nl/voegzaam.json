                                    {
                                        "sense_id": "1e7b8bcf-7f63-3565-a4d7-7524b25b514d",
                                        "entry_id": "71130544-4da4-331d-b2ea-5d3c0e740de8",
                                        "glosses": [
                                            "Having sufficient or the required properties for a certain purpose or task; appropriate to a certain occasion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04bf0bff-5204-4c36-b8b1-fc296ee0cb67",
                                                "sense_id": "1e7b8bcf-7f63-3565-a4d7-7524b25b514d",
                                                "text": "Doctors told Matthew Parker’s family there was only a 1% chance of finding a suitable donor for Matthew because his body had rejected a previous transplant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
