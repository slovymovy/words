                "senses": [
                    {
                        "sense_id": "22b86937-b32d-3173-a361-1821ca678578",
                        "entry_id": "14230921-ca8e-37f1-8048-8f24cb882329",
                        "glosses": [
                            "привести, доставить куда-нибудь, подгоняя ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfc7c91e-9356-4530-9272-b900beff16b8",
                                "sense_id": "22b86937-b32d-3173-a361-1821ca678578",
                                "text": "Пленных пригнали к нему во двор."
                            },
                            {
                                "example_id": "918b997b-fc9f-44bc-b896-7a32a3de4fbc",
                                "sense_id": "22b86937-b32d-3173-a361-1821ca678578",
                                "text": "Пригнать коров с поля."
                            }
                        ]
                    },
                    {
                        "sense_id": "86ee250f-5b18-34be-aa8a-9c96e4043461",
                        "entry_id": "14230921-ca8e-37f1-8048-8f24cb882329",
                        "glosses": [
                            "разг. доставить что-нибудь (паровоз, автомобиль и т.п.), передвигаясь на нем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b3372ab-d7fa-47e2-8454-c443a5f3dba8",
                                "sense_id": "86ee250f-5b18-34be-aa8a-9c96e4043461",
                                "text": "Пригнать машину в гараж."
                            }
                        ]
                    },
                    {
                        "sense_id": "c36eede8-5bf8-3702-915d-c3e39c09594a",
                        "entry_id": "14230921-ca8e-37f1-8048-8f24cb882329",
                        "glosses": [
                            "спец. приладить одно к другому так, чтобы совпадало, приходилось впору по размерам"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce027f8e-8fff-4ed1-a97e-b32fdb34fbf3",
                                "sense_id": "c36eede8-5bf8-3702-915d-c3e39c09594a",
                                "text": "Пригнать дверь к косяку. Пригнать оконную раму."
                            }
                        ]
                    },
                    {
                        "sense_id": "06418255-7a34-3acb-b6ed-e8d9fc89e22d",
                        "entry_id": "14230921-ca8e-37f1-8048-8f24cb882329",
                        "glosses": [
                            "разг. рег. быстро приехать, примчаться куда-нибудь на чем-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6954a46c-032d-4dc1-9d08-4e13d409b25b",
                                "sense_id": "06418255-7a34-3acb-b6ed-e8d9fc89e22d",
                                "text": "Пригнал из деревни на тройке."
                            }
                        ]
