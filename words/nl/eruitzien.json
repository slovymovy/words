{
    "word_family": [
        "uitzien",
        "zien"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8423cd79-7f5e-3d34-ac2e-7c525033e0d3",
                    "sense_definition": "een bepaald uiterlijk of aanschijn hebben",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet goed slapen, want je <w>ziet</w> <w>er</w> vandaag erg moe <w>uit</w>.",
                            "target_lang_translations": {
                                "en": "You need to sleep well, because you <w>look</w> very tired today.",
                                "it": "Devi dormire bene, perché oggi <w>sembri</w> molto stanco."
                            }
                        },
                        {
                            "text": "De nieuwe auto van mijn buren <w>ziet</w> <w>er</w> heel modern <w>uit</w>.",
                            "target_lang_translations": {
                                "en": "My neighbors' new car <w>looks</w> very modern.",
                                "it": "La nuova auto dei miei vicini <w>ha un aspetto</w> molto moderno."
                            }
                        }
                    ],
                    "synonyms": [
                        "schijnen",
                        "lijken"
                    ],
                    "common_phrases": [
                        "er goed uitzien",
                        "er slecht uitzien"
                    ],
                    "target_lang_definitions": {
                        "en": "to have a certain appearance or look",
                        "it": "Avere un determinato aspetto o sembrare"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "look",
                                "target_lang_sense_clarification": "to appear or seem"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "sembrare",
                                "target_lang_sense_clarification": "Avere un certo aspetto"
                            },
                            {
                                "target_lang_word": "apparire",
                                "target_lang_sense_clarification": "Presentarsi alla vista in un certo modo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f298aadf-8278-3778-918d-aaf25e071c3f",
                    "sense_definition": "gelijkenis vertonen met iets of iemand anders",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met die grote hoed <w>zag</w> ze <w>eruit</w> als een bekende filmster.",
                            "target_lang_translations": {
                                "en": "With that big hat, she <w>looked like</w> a famous movie star.",
                                "it": "Con quel cappello grande <w>sembrava</w> una famosa stella del cinema."
                            }
                        },
                        {
                            "text": "Het <w>ziet</w> <w>eruit</w> alsof het vanmiddag gaat regenen.",
                            "target_lang_translations": {
                                "en": "It <w>looks like</w> it is going to rain this afternoon.",
                                "it": "<w>Sembra</w> che stia per piovere questo pomeriggio."
                            }
                        }
                    ],
                    "synonyms": [
                        "lijken op"
                    ],
                    "common_phrases": [
                        "eruitzien als"
                    ],
                    "target_lang_definitions": {
                        "en": "to resemble or look like something or someone else",
                        "it": "Somigliare o sembrare qualcosa o qualcuno"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "look like",
                                "target_lang_sense_clarification": "to resemble"
                            },
                            {
                                "target_lang_word": "look as if",
                                "target_lang_sense_clarification": "to appear as though"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "sembrare",
                                "target_lang_sense_clarification": "Avere l'aspetto di qualcosa o qualcuno"
                            },
                            {
                                "target_lang_word": "somigliare a",
                                "target_lang_sense_clarification": "Avere un aspetto simile a"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}