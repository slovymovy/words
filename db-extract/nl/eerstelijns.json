                "senses": [
                    {
                        "sense_id": "2a004af1-7c5f-3d91-9c4f-3e9af91426b8",
                        "entry_id": "b25a0025-8bd5-354a-9d2e-477acb157bd1",
                        "glosses": [
                            "betrekking hebbend op de zorg die direct toegankelijk is voor alle patiënten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5077d28-9f33-4594-b352-998fccf14a21",
                                "sense_id": "2a004af1-7c5f-3d91-9c4f-3e9af91426b8",
                                "text": "Binnen het zorgpersoneel zijn de verschillen gering. De grootste vaccinatiebereidheid is er in de eerstelijns- (onder meer huisartsen), ziekenhuis- en geestelijke gezondheidszorg. In de jeugdzorg is die het laagst."
                            },
                            {
                                "example_id": "4e1615ee-56d0-423f-86a8-97885501072d",
                                "sense_id": "2a004af1-7c5f-3d91-9c4f-3e9af91426b8",
                                "text": "Het is nu iets rustiger, veel patiënten zijn verplaatst naar andere ziekenhuizen, maar er komen nog steeds gemiddeld 40 mensen per dag naar de SEH. Dat dat aantal niet verder stijgt komt volgens mij vooral door de goede eerstelijns zorg in Nederland. Niet elke coronapatiënt komt hier namelijk terecht."
                            }
                        ]
                    },
                    {
                        "sense_id": "200db6df-4e88-3258-8fb0-884526c5b585",
                        "entry_id": "b25a0025-8bd5-354a-9d2e-477acb157bd1",
                        "glosses": [
                            "partner, kind, ouder, schoonouder, schoonzoon, schoondochter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d20c8d22-de34-4893-8cf4-75b76ca7c391",
                                "sense_id": "200db6df-4e88-3258-8fb0-884526c5b585",
                                "text": "Jan Kropf, algemeen secretaris van de ACOM, geeft eenzelfde beeld. \"Partners en eerstelijns familieleden worden in de screening meegenomen, dat is al jaren zo.\""
                            }
                        ]
