                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>rook</w> even aan de melk om te zien of die nog goed was.",
                            "target_lang_translations": {
                                "en": "He briefly <w>smelled</w> the milk to see if it was still good.",
                                "ru": "Он <w>понюхал</w> молоко, чтобы проверить, свежее ли оно.",
                                "pl": "Na chwilę <w>powąchał</w> mleko, żeby sprawdzić, czy jest jeszcze dobre.",
                                "de": "Er <w>roch</w> kurz an der Milch, um zu sehen, ob sie noch gut war.",
                                "fr": "Il a <w>senti</w> le lait un instant pour voir s'il était encore bon.",
                                "it": "Ha <w>annusato</w> un attimo il latte per vedere se era ancora buono.",
