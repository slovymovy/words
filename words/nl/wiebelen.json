{
    "word_family": [
        "gewiebel",
        "wiebelig",
        "wiebelstoel",
        "wiebelbenen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "016df46d-b022-3ea4-98c5-28aefe73be4f",
                    "sense_definition": "onrustig heen en weer bewegen terwijl men zit of staat",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het onrustige kind <w>wiebelde</w> de hele dag op haar stoel.",
                            "target_lang_translations": {
                                "en": "The restless child <w>fidgeted</w> on her chair all day long."
                            }
                        },
                        {
                            "text": "Je moet niet zo <w>wiebelen</w> met je benen tijdens de les.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>wiggle</w> your legs like that during class."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op een stoel wiebelen",
                        "met de benen wiebelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to move restlessly back and forth while sitting or standing"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fidget",
                                "target_lang_sense_clarification": "moving restlessly"
                            },
                            {
                                "target_lang_word": "wiggle",
                                "target_lang_sense_clarification": "small movements of body parts"
                            },
                            {
                                "target_lang_word": "squirm",
                                "target_lang_sense_clarification": "moving nervously or uncomfortably"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5551b14-4367-3369-84e7-f872f0b70c04",
                    "sense_definition": "onstabiel of onvast staan waardoor iets dreigt om te vallen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vaas <w>wiebelde</w> en viel in stukken op de grond.",
                            "target_lang_translations": {
                                "en": "The vase <w>wobbled</w> and fell to pieces on the floor."
                            }
                        },
                        {
                            "text": "De tafel <w>wiebelt</w> omdat een van de poten korter is dan de rest.",
                            "target_lang_translations": {
                                "en": "The table <w>wobbles</w> because one of the legs is shorter than the rest."
                            }
                        }
                    ],
                    "synonyms": [
                        "wankelen",
                        "wobbelen"
                    ],
                    "common_phrases": [
                        "een wiebelende tafel"
                    ],
                    "target_lang_definitions": {
                        "en": "to stand unstably or insecurely, threatening to fall over"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wobble",
                                "target_lang_sense_clarification": "unsteady movement of an object"
                            },
                            {
                                "target_lang_word": "be shaky",
                                "target_lang_sense_clarification": "not firm or stable"
                            },
                            {
                                "target_lang_word": "rock",
                                "target_lang_sense_clarification": "moving unsteadily from side to side"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}