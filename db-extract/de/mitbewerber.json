                    {
                        "sense_id": "c0d1d4c5-e835-38d6-a163-e3b178b5eca6",
                        "entry_id": "3cecd458-76bb-3e0f-be91-312e6206d3fd",
                        "glosses": [
                            "jemand, der in Konkurrenz zu jemand anderem das Gleiche anstrebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0f67310-aa02-48cc-a4fe-4f558bc5b566",
                                "sense_id": "c0d1d4c5-e835-38d6-a163-e3b178b5eca6",
                                "text": "„Die als sehr gut verlaufend empfundene Präsidentschaft brachte ihr breite Zustimmung gegenüber ihren Mitbewerbern ein, darunter mit Elisabeth Rehn eine weitere Frau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09e12704-d377-44af-a875-198a75cdb82c",
                        "source_entry_id": "3cecd458-76bb-3e0f-be91-312e6206d3fd",
                        "source_sense_id": "c0d1d4c5-e835-38d6-a163-e3b178b5eca6",
