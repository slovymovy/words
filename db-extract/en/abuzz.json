                                    {
                                        "sense_id": "5c5ca4d7-f28e-373e-875d-d519bb203d0a",
                                        "entry_id": "1ff83261-c56b-3378-8312-8d70ac9d4e22",
                                        "glosses": [
                                            "sich mit surrendem, zitterndem Geräusch schnell durch die Luft bewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "108755cd-b96f-43e8-a6c2-6011bf09152c",
                                                "sense_id": "5c5ca4d7-f28e-373e-875d-d519bb203d0a",
                                                "text": "Es schwirren zwei Helikopter über dem Haus."
                                            },
                                            {
                                                "example_id": "bdeed697-370e-48a2-99ad-24c50141d938",
                                                "sense_id": "5c5ca4d7-f28e-373e-875d-d519bb203d0a",
                                                "text": "In meinem Kopf schwirrt es von Ideen."
                                            }
                                        ],
