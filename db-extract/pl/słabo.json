                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f73bea6-2183-45ff-a768-69ad51103ef8",
                                                "sense_id": "e2dbce81-bdb3-3c75-b3e5-7e9b92523466",
                                                "text": "I think poorly of them."
                                            },
                                            {
                                                "example_id": "8f369367-8afd-467f-8713-be8d2405a958",
                                                "sense_id": "e2dbce81-bdb3-3c75-b3e5-7e9b92523466",
