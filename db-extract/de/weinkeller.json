                    }
                ],
                "senses": [
                    {
                        "sense_id": "121d135e-f0e4-3ac5-a8f6-8777bc824a01",
                        "entry_id": "9ca924af-f64f-3498-ae71-c2dda8927d7c",
                        "glosses": [
                            "meist unterirdischer Lagerraum für Wein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1298b434-fd4c-4e19-ab4f-6505370f8909",
                                "sense_id": "121d135e-f0e4-3ac5-a8f6-8777bc824a01",
                                "text": "Der Wirt holte einen Spätburgunder aus seinem Weinkeller."
                            },
                            {
                                "example_id": "76328054-bc41-4ac6-b958-9070bcf25274",
                                "sense_id": "121d135e-f0e4-3ac5-a8f6-8777bc824a01",
                                "text": "„Im kühlen Weinkeller zeigte er uns als Zeichen seines Vertrauens sehr alte und überaus wertvolle Weinflaschen, die nur bei Hochzeiten oder Taufen angeboten wurden.“"
                            },
                            {
                                "example_id": "3a0669f8-b3d4-4f79-9cfd-deb79aee0cb9",
                                "sense_id": "121d135e-f0e4-3ac5-a8f6-8777bc824a01",
                                "text": "„Mitten im Weinkeller des Gasthauses »Schöne Höhe« trifft die Sächsische Weinstraße übrigens auf die ersten Felsen des Elbsandsteingebirges.“"
                            },
                            {
                                "example_id": "39df457c-ce87-4b02-983d-29302ead073b",
                                "sense_id": "121d135e-f0e4-3ac5-a8f6-8777bc824a01",
                                "text": "„In jener Nacht plünderten sie den Weinkeller im Erzbischöflichen Palais.“"
                            },
                            {
                                "example_id": "ff1152f3-cef8-4148-86bc-f265d7af001e",
                                "sense_id": "121d135e-f0e4-3ac5-a8f6-8777bc824a01",
                                "text": "„Ein Teil des Weinkellers war betoniert, mit Stahlträgern gestützt und als Luftschutzkeller ausgebaut worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
