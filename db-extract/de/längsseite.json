                "senses": [
                    {
                        "sense_id": "e5fb3843-1e9a-3d00-98c5-05ce4480373f",
                        "entry_id": "a514874b-8cbe-3c78-bc91-84386cf4111d",
                        "glosses": [
                            "eine der beiden längeren Seiten eines rechteckigen Gegenstands"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36d1ae62-64cf-43ad-a426-19553a989522",
                                "sense_id": "e5fb3843-1e9a-3d00-98c5-05ce4480373f",
                                "text": "„In der Mitte des Zimmers stand ein schwerer Holztisch, an den beiden Längsseiten je ein Stuhl.“"
                            },
                            {
                                "example_id": "9a5d5b0a-2452-4b37-8895-f9c12ca54427",
                                "sense_id": "e5fb3843-1e9a-3d00-98c5-05ce4480373f",
                                "text": "„An den beiden Längsseiten stehen in dichten Reihen nach ganz eigenem Aufstellungsprinzip die Lieblingsbücher nebeneinander.“"
                            },
                            {
                                "example_id": "20419758-a480-4d6e-9876-efaad37da283",
                                "sense_id": "e5fb3843-1e9a-3d00-98c5-05ce4480373f",
                                "text": "„Von den Längsseiten des Dachfirstes hingen, grün in der Sonne aufleuchtend, gewaltige Kupferplatten herab, die zu einer schrundigen Masse mit ausgezackten Kanten verschmolzen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
