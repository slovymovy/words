                        "target_lang_word": "perseverance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perseverance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58134b33-4695-3e45-a840-32d825b87d62",
                                        "entry_id": "075282dd-e139-3ee4-84cd-ca5570d81365",
                                        "glosses": [
                                            "Continuing in a course of action without regard to discouragement, opposition or previous failure."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f45158c-2d7d-4f2d-b15d-90a343a50a7e",
                                                "sense_id": "58134b33-4695-3e45-a840-32d825b87d62",
                                                "text": "It had taken nine years from the evening that Truman first showed up with a pie plate at her mother's door, but his dogged perseverance eventually won him the hand of his boyhood Sunday school crush."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
