                        "entry_id": "369d441a-aee9-3e7b-8968-145b4522ab86",
                        "glosses": [
                            "Expansion des activités d’une entreprise au-delà de ses frontières nationales, par la création ou l’acquisition de filiales ou par des partenariats avec d’autres entreprises dans plusieurs pays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "875d0c43-ee63-40fa-b981-1ecff89fb792",
                                "sense_id": "aa000fc8-e748-3bb0-aec7-c415883882df",
                                "text": "Le phénomène de multinationalisation des entreprises se renouvelle en permanence, sous l’effet de l’évolution des orientations géographiques et sectorielles des implantations et de leurs modalités."
                            },
                            {
                                "example_id": "1aa3544d-8da9-4b0a-8ab0-4394bf2ba832",
                                "sense_id": "aa000fc8-e748-3bb0-aec7-c415883882df",
                                "text": "Les retombées locales d’une expansion à l’international, l’accompagnement de nos entrepreneurs et la multinationalisation, ses tendances et ses modes sont autant de sujets qui seront abordés."
                            }
                        ]
