                    {
                        "sense_id": "3751a958-e3db-3c2b-b252-b4d0a92147bd",
                        "entry_id": "6a3817b8-b7f5-3977-81ba-8c7440be3064",
                        "glosses": [
                            "To dismiss from an office or station."
                        ],
                        "tags": [
