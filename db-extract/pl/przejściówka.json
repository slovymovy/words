                "senses": [
                    {
                        "sense_id": "38ffd7ec-9220-34e2-8b6f-ba293a938ced",
                        "entry_id": "3e847e67-40d2-3ad6-816b-322d5236ead4",
                        "glosses": [
                            "okres przejściowy"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1c963e17-b6d4-33d0-81d8-ff2fcc9ed80f",
                        "entry_id": "3e847e67-40d2-3ad6-816b-322d5236ead4",
                        "glosses": [
                            "coś tymczasowego, mającego charakter przejściowy, zwykle o mieszkaniu"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "95dd48a5-46b3-4b5a-a477-eb8c08015678",
                                "sense_id": "1c963e17-b6d4-33d0-81d8-ff2fcc9ed80f",
                                "text": "Mieszkamy w przejściówce, nawet nie rozpakowujemy rzeczy z kartonów."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "16a2079f-7d44-3039-9240-1756e8db903e",
                        "entry_id": "3e847e67-40d2-3ad6-816b-322d5236ead4",
                        "glosses": [
                            "element umożliwiający podłączenie urządzenia do innego gniazda niż przeznaczenie wtyczki"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "389e5a74-c7d5-45b0-8814-6bd6ae94aea1",
                                "sense_id": "16a2079f-7d44-3039-9240-1756e8db903e",
                                "text": "Rewelacyjna, poręczna, wygodna w użyciu przejściówka dysku twardego 2,5 cala na 3,5"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "0a045463-c512-3626-b9f0-4754992aa9a8",
                        "entry_id": "3e847e67-40d2-3ad6-816b-322d5236ead4",
                        "glosses": [
                            "wierzchnie okrycie noszone w okresie jesiennym lub wiosennym"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2a31ae11-68f4-4566-8999-c2b202de33c2",
                                "sense_id": "0a045463-c512-3626-b9f0-4754992aa9a8",
                                "text": "Robi się chłodno, muszę kupić sobie jakąś przejściówkę."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "12b73b72-146c-35a8-82f0-f52f1da41f00",
                        "entry_id": "3e847e67-40d2-3ad6-816b-322d5236ead4",
                        "glosses": [
                            "przejściowa cela więzienna w czasach okupacji hitlerowskiej"
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "5dd961c0-1aea-3c99-8d0b-fadd86f23fd0",
                        "entry_id": "3e847e67-40d2-3ad6-816b-322d5236ead4",
                        "glosses": [
                            "bilet kolejowy umożliwiający podróżowanie między ostatnią stacją przed przejściem granicznym a pierwszą stacją po drugiej stronie granicy"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c3ff2b52-5419-4f6c-bb37-b722423dc4c7",
                                "sense_id": "5dd961c0-1aea-3c99-8d0b-fadd86f23fd0",
                                "text": "U konduktora w pociągu bądź na stacji granicznej kupuje się przejściówkę"
                            }
                        ],
                        "sense_index_json": "\"1.6\""
                    },
                    {
                        "sense_id": "f80c4cd1-b4ad-3976-9595-bc470a987319",
                        "entry_id": "3e847e67-40d2-3ad6-816b-322d5236ead4",
                        "glosses": [
                            "samochód osobowy marki Polonez w wersji MR'89"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1b70d085-ba3c-4f98-8750-9267cd4658b4",
                                "sense_id": "f80c4cd1-b4ad-3976-9595-bc470a987319",
                                "text": "Ale fajnego poloneza przejściówkę kupiłeś! Ja nadal marzę o kapitalnym remoncie mojego malucha."
                            }
                        ],
                        "sense_index_json": "\"1.7\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5542887c-1baa-4528-b946-a20e72fb0b48",
                        "source_entry_id": "3e847e67-40d2-3ad6-816b-322d5236ead4",
                        "source_sense_id": "16a2079f-7d44-3039-9240-1756e8db903e",
                        "target_lang_word": "adapter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adapter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "faf2f0d2-618c-3566-8c07-a6cd136b3fdf",
                                        "entry_id": "265fd948-6165-311a-8191-1b75cc60a32b",
                                        "glosses": [
                                            "One who is capable of adapting to differing situations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "493303ee-20a9-4242-bb33-fcf1b1a41b5c",
                                                "sense_id": "faf2f0d2-618c-3566-8c07-a6cd136b3fdf",
                                                "text": "He was an able adapter, and could easily adjust to the differences when the company changed ownership."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ba3abd3-d827-3583-ad7a-d5c80d476a5e",
                                        "entry_id": "265fd948-6165-311a-8191-1b75cc60a32b",
                                        "glosses": [
                                            "One who adapts a thing, e.g. a play."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cfcafa8-a7e1-47b2-8db9-b5303c72c941",
                                                "sense_id": "1ba3abd3-d827-3583-ad7a-d5c80d476a5e",
                                                "text": "The critic gave rave reviews to the adapter of the ancient play, who worked to give the text more relevance to the modern day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59ee2a18-234e-3a8f-ac6c-56f32422d0e2",
                                        "entry_id": "265fd948-6165-311a-8191-1b75cc60a32b",
                                        "glosses": [
                                            "A device or application used to achieve operative compatibility between devices that otherwise are incompatible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2f3ebaf-ac6e-425c-a7d2-de47c12f78ff",
                                                "sense_id": "59ee2a18-234e-3a8f-ac6c-56f32422d0e2",
                                                "text": "He had an adapter that let him plug his phone into the car's cigarette lighter for power."
                                            },
                                            {
                                                "example_id": "2597e500-49c6-4c06-9021-ad816c75bbaf",
                                                "sense_id": "59ee2a18-234e-3a8f-ac6c-56f32422d0e2",
                                                "text": "Sitting in the courtroom ..., their laptops and tablets propped before them, power cables snaking through convoluted adapters, the Twitterati have sight of witnesses at all times – the troubadours, or perhaps the tricoteuses, of the digital revolution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6d8000e-e681-3c21-bf16-c4492fc73c06",
                                        "entry_id": "265fd948-6165-311a-8191-1b75cc60a32b",
                                        "glosses": [
                                            "A device or application used to achieve operative compatibility between devices that otherwise are incompatible.",
                                            "Specifically, a device that permits two or more plugs to be used at a single electrical power point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e80e2e5e-a60f-40ce-8fe6-b090a5b6b51d",
                                                "sense_id": "e6d8000e-e681-3c21-bf16-c4492fc73c06",
                                                "text": "The wall outlet sprouted an electrical monstrosity of adapters plugged into adapters that sparked ominously."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df244678-10e8-3885-826b-2086562a98f6",
                                        "entry_id": "265fd948-6165-311a-8191-1b75cc60a32b",
                                        "glosses": [
                                            "A device or application used to achieve operative compatibility between devices that otherwise are incompatible.",
                                            "Specifically, a device that allows one format of plug to be used with a different format of socket."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc09a6a1-f0a1-4440-890d-82e751f5a24d",
                                                "sense_id": "df244678-10e8-3885-826b-2086562a98f6",
                                                "text": "We bought adapters to use our three-prong plugs in the two-prong, unpolarized outlets of the old house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db0706aa-0add-3086-9bc1-2b35f6d1830b",
                                        "entry_id": "265fd948-6165-311a-8191-1b75cc60a32b",
                                        "glosses": [
                                            "A device or application used to achieve operative compatibility between devices that otherwise are incompatible.",
                                            "Specifically, an AC adapter: a device that reduces voltage and converts AC to DC to allow a battery-powered device to use mains power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee2e288c-d223-424d-878f-9630fe59ed74",
                                                "sense_id": "db0706aa-0add-3086-9bc1-2b35f6d1830b",
                                                "text": "I lost my cellphone's adapter so I couldn't recharge it."
                                            }
                                        ]
                                    },
