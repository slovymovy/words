                ],
                "senses": [
                    {
                        "sense_id": "d977dec9-87ac-37af-8ed9-953cf0af2708",
                        "entry_id": "33de087d-d9af-3f72-b8ec-444d04fbb23a",
                        "glosses": [
                            "A sword with one sharp edge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f09f7276-4c27-4114-a1a5-5bb7e5c55945",
                                "sense_id": "d977dec9-87ac-37af-8ed9-953cf0af2708",
                                "text": "It [the dáo of the Nágá tribe, south-east of Assam] is a thick, heavy backsword, eighteen inches long, with a bevel where the point should be, worn at the waist in a half-scabbard of wood, and used for digging as well as killing."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7b95af0-188a-3794-9cf1-b6920fcef9f1",
                        "entry_id": "33de087d-d9af-3f72-b8ec-444d04fbb23a",
                        "glosses": [
                            "A stick with a basket handle, used in rustic amusements."
                        ],
                        "tags": [
                            "UK",
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "17c38650-9f58-3f23-8c8a-ef80bc6b303f",
                        "entry_id": "33de087d-d9af-3f72-b8ec-444d04fbb23a",
                        "glosses": [
                            "The game in which the stick is used."
                        ],
                        "tags": [
                            "UK",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "85bceeaa-5839-48ee-a270-d72d56126ec1",
                                "sense_id": "17c38650-9f58-3f23-8c8a-ef80bc6b303f",
                                "text": "One afternoon, as the missionary and I were sitting outside our tents, my attention was attracted towards a group of sepahis engaged under a banyantree, playing the game of backsword […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b916fa9e-e12d-4413-aef8-fba64ce5e304",
                        "source_entry_id": "33de087d-d9af-3f72-b8ec-444d04fbb23a",
                        "source_sense_description": "sword with one sharp edge",
                        "target_lang_word": "Pallasch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pallasch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cef051a3-65be-3066-851e-6beaf153db5e",
                                        "entry_id": "a3448358-6228-3b07-b222-2933750c7a08",
                                        "glosses": [
                                            "schwere Hieb- und Stichwaffe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5ae1c83-4824-4dc5-ab10-e2c19e4e08ab",
                                                "sense_id": "cef051a3-65be-3066-851e-6beaf153db5e",
                                                "text": "„Zu dem Haugewehr gehören jetzt die Pallasche und verschiedenen Säbel.“"
                                            },
                                            {
                                                "example_id": "173bc0fd-5220-456a-893a-15385620bf5e",
                                                "sense_id": "cef051a3-65be-3066-851e-6beaf153db5e",
                                                "text": "„Langsam war Erkennen in sein Auge getreten; über den geschwungenen Muschelaufsatz des Ehebettes fort, flankiert von den beiden Knäufen rechts und links, sieht er gerade auf die Wand, an der sein Pallasch hängt aus der Zeit, da er noch Wachtmeister bei den Pasewalker Kürassieren war, neben dem Helm, unter dem Bild, das ihn an seinem Entlassungstage aus dem Dienst vor nun zwanzig Jahren zeigt.“"
                                            },
                                            {
                                                "example_id": "2edfd23f-7fea-431b-adde-2cab9d6db880",
                                                "sense_id": "cef051a3-65be-3066-851e-6beaf153db5e",
                                                "text": "„Im kniehohen Gestrüpp fand er einen russischen Ulanen und einen Württemberger Dragoner, die sich gegenseitig den Pallasch in den Leib gebohrt hatten.“"
                                            },
                                            {
                                                "example_id": "14bd9b21-59bb-4ff1-b3be-bcf4f7af2550",
                                                "sense_id": "cef051a3-65be-3066-851e-6beaf153db5e",
                                                "text": "„Nostitz ließ den Lärm eine Weile dauern und klopfte dann erst mit dem ihm als Zeichen seiner Würde zur Seite liegenden Pallasch auf den Tisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f00e18b-b873-4a75-a88c-26c7e82d2a0d",
                        "source_entry_id": "33de087d-d9af-3f72-b8ec-444d04fbb23a",
