        "fr-extract.jsonl": [
            {
                "entry_id": "70b02a7a-aac2-383c-bfbe-0a8a5f732d56",
                "word": "mollement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3f85653d-6c5a-32f8-be90-c8d6f100835a",
                        "entry_id": "70b02a7a-aac2-383c-bfbe-0a8a5f732d56",
                        "glosses": [
                            "D’une manière molle."
                        ],
                        "tags": [
                            "literally",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f1755abb-3947-4f54-a812-f4a18d7c3b11",
                                "sense_id": "3f85653d-6c5a-32f8-be90-c8d6f100835a",
                                "text": "Être couché mollement, être étendu mollement. être couché dans un bon lit, être étendu de manière à reposer ses membres."
                            }
                        ]
                    },
                    {
                        "sense_id": "5484077d-2165-37b3-82b2-c1ceaa7c6efe",
                        "entry_id": "70b02a7a-aac2-383c-bfbe-0a8a5f732d56",
                        "glosses": [
                            "Avec un abandon gracieux."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "21970976-9bb4-4837-85d1-6100292c296a",
                                "sense_id": "5484077d-2165-37b3-82b2-c1ceaa7c6efe",
                                "text": "Ses bras, à moitié endormis, mollement jetés hors de la bergère, achevaient d'exprimer une pensée de bonheur."
                            },
                            {
                                "example_id": "7bf2e3ab-f986-4e72-83f6-71d780d9092c",
                                "sense_id": "5484077d-2165-37b3-82b2-c1ceaa7c6efe",
                                "text": "Quand Miette riait, renversant la tête en arrière et la penchant mollement sur son épaule droite, elle ressemblait à la Bacchante antique, avec sa gorge gonflée de gaieté sonore, ses joues arrondies comme celles d’un enfant, ses larges dents blanches, ses torsades de cheveux crépus que les éclats de sa joie agitaient sur sa nuque, ainsi qu’une couronne de pampres."
                            }
                        ]
                    },
                    {
                        "sense_id": "76374d63-0e60-36f1-81bd-b10a3e8ad439",
                        "entry_id": "70b02a7a-aac2-383c-bfbe-0a8a5f732d56",
                        "glosses": [
                            "Faiblement ; lâchement ; sans vigueur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ad84b8a-a2e0-41e8-be2c-bff461077362",
                                "sense_id": "76374d63-0e60-36f1-81bd-b10a3e8ad439",
                                "text": "Vers le soir, il entre dans un champ de blé, de blés hauts et mûrs, dont la brise balance mollement les beaux épis d’or."
                            },
                            {
                                "example_id": "8a6b8fa2-979e-4cf7-baf6-26f55eb0d1c7",
                                "sense_id": "76374d63-0e60-36f1-81bd-b10a3e8ad439",
                                "text": "Les tribunaux frappèrent, tout d'abord, assez durement, les gentilles délinquantes qui s'obstinaient à porter […] le cirsac mollement cotonneux."
                            },
                            {
                                "example_id": "31138fda-53a5-45e5-89f2-002ed0831864",
                                "sense_id": "76374d63-0e60-36f1-81bd-b10a3e8ad439",
                                "text": "Pourtant j’aurais voulu examiner le paysage, mollement éclairé par la lune, et crayonner quelques notes au passage."
                            },
                            {
                                "example_id": "cf1d194d-b067-4adb-9585-5496cbf42ca9",
                                "sense_id": "76374d63-0e60-36f1-81bd-b10a3e8ad439",
                                "text": "[…]; cette bande qui s'étend sur les villages de Brotte, Ailloncourt, Éhuns, Citers, etc., est représentée par des collines ou des croupes mollement ondulées de 300 mètres d'altitude moyenne, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c4c8172-2980-3316-af33-6d1af6b229f4",
                        "entry_id": "70b02a7a-aac2-383c-bfbe-0a8a5f732d56",
                        "glosses": [
                            "D’une manière molle et efféminée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67dec09f-11a7-4671-9633-fe23f59c75d8",
                                "sense_id": "7c4c8172-2980-3316-af33-6d1af6b229f4",
                                "text": "Vivre mollement."
                            }
                        ]
                    }
                ],
