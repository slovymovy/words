                "senses": [
                    {
                        "sense_id": "5c021953-3201-32f6-a49a-42bf0ef571c0",
                        "entry_id": "691c4b86-2a7d-3783-9b5a-fe79dfa5c456",
                        "glosses": [
                            "harde val"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bffc8ff1-397b-44ab-ba75-e76eba078adb",
                                "sense_id": "5c021953-3201-32f6-a49a-42bf0ef571c0",
                                "text": "De smakker die ze maakte op 7 augustus 2016 tijdens de olympische wegwedstrijd in Rio maakte zal Annemiek van Vleuten waarschijnlijk voor altijd achtervolgen."
                            },
                            {
                                "example_id": "fcf1f542-1c5e-436e-8b7f-1ef9c685056c",
                                "sense_id": "5c021953-3201-32f6-a49a-42bf0ef571c0",
                                "text": "Wie achter de schermen kan kijken weet dat de Italiaan bij de generale repetitie van zijn rola-rola act een lelijke en vooral pijnlijke smakker heeft gemaakt."
                            },
                            {
                                "example_id": "e1d4ee92-9ccc-4848-9fb8-8c946b4b5f96",
                                "sense_id": "5c021953-3201-32f6-a49a-42bf0ef571c0",
                                "text": "'Na die val van dinsdag voelde Tom zich niet helemaal zeker over het werk dat hij moest doen. Tijdens de koers hebben we het plan daarom aangepast. Als je zo'n smakker maakt, zet dat toch heel je lijf op zijn kop."
                            }
                        ]
                    },
                    {
                        "sense_id": "98271d7b-2f69-352f-a97d-6bf4cc374cbf",
