                "senses": [
                    {
                        "sense_id": "07d05b8e-1ca3-3690-be5f-e378ca3355f1",
                        "entry_id": "af0da65a-4683-3784-9a5d-6f2cfed92bdf",
                        "glosses": [
                            "weibliche Person, die in einem Handwerk Meisterin ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4e9ef07-20ed-408b-a0a9-24b455e7cc8b",
                                "sense_id": "07d05b8e-1ca3-3690-be5f-e378ca3355f1",
                                "text": "Meine Cousine ist Handwerksmeisterin."
                            },
                            {
                                "example_id": "9f3e66bd-e7c7-4da5-85be-160950cba65d",
                                "sense_id": "07d05b8e-1ca3-3690-be5f-e378ca3355f1",
                                "text": "„Einen Tag lang lernten jugendliche Geflüchtete einen Handwerksbetrieb kennen, indem sie die jeweilige Handwerksmeisterin bzw. den Handwerksmeister bei der täglichen Arbeit begleiteten.“"
                            },
                            {
                                "example_id": "2a6c7922-991d-452d-9dba-61750ab710c0",
                                "sense_id": "07d05b8e-1ca3-3690-be5f-e378ca3355f1",
                                "text": "„Meine Prüfung zur Handwerksmeisterin habe ich 1998 vor der Handwerkskammer Aachen mit Auszeichnung abgelegt, daher bin ich bestens ausgebildet, alles was sich um das Thema Hüte und Kopfbedeckungen dreht zu verwirklichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
