                "senses": [
                    {
                        "sense_id": "5c22a616-cce6-3a82-a56a-cd00c92301b8",
                        "entry_id": "5a1b6e95-3286-39b8-9ace-d0ce1e36d140",
                        "glosses": [
                            "napój chłodzący z utartych migdałów, cukru i wody lub mleka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b693da52-79b2-4d15-96fe-cc22c6d034be",
                                "sense_id": "5c22a616-cce6-3a82-a56a-cd00c92301b8",
                                "text": "Emma chciała wyjść; tłum jednak napełniał korytarze, opadła więc na fotel z biciem serca, które tamowało jej oddech. Karol, obawiając się, aby nie zemdlała, pobiegł do bufetu przynieść szklankę orszady"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "519331e1-f151-47b6-9afc-cb6956d2482a",
                        "source_entry_id": "5a1b6e95-3286-39b8-9ace-d0ce1e36d140",
                        "source_sense_id": "5c22a616-cce6-3a82-a56a-cd00c92301b8",
                        "target_lang_word": "orgeat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orgeat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af47469f-b451-3b74-8762-586d43a94e6a",
                                        "entry_id": "a6ab4939-06fa-3c52-a714-55c03b6e35c9",
                                        "glosses": [
                                            "A sweet syrup made from sugar and almonds (or originally barley) and rose water or orange-flower water."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec603cd2-b57e-4899-acb6-6a12c91256f9",
                                                "sense_id": "af47469f-b451-3b74-8762-586d43a94e6a",
                                                "text": "Syrup of orgeat was a cooling potion, originally made from barley, later, from almonds, and orange-flower water."
                                            },
                                            {
                                                "example_id": "0e39f2f6-873b-47b8-8a02-435329c26c77",
                                                "sense_id": "af47469f-b451-3b74-8762-586d43a94e6a",
                                                "text": "Stop by after brunch downtown and enjoy $2 off our winetinis--passionfruit, mango, guava and pineapple. Don't forget about our maitini, made with real rock candy and almond orgeat syrup. Ah, Sundays never tasted so good!"
                                            },
                                            {
                                                "example_id": "dfd2f44e-7990-4947-a747-661262a3c50f",
                                                "sense_id": "af47469f-b451-3b74-8762-586d43a94e6a",
                                                "text": "He’s right in my case. My favorite drink at L’Aperitif has been the Miss Bonde, a raspberry-infused vodka “caressed with champagne.” On my most recent trip, I also experienced the “Mai Tini,” a mai tai served in a martini glass. L’Aperitif has a different mai tai recipe from House Without A Key, using lemon juice with a squeeze of lime, a mai mix of simple syrup, orgeat, triple sec, and rum; no dark rum, as there isn’t a float. And shaken with ice but not served with it, save for a single cube emblazoned with Halekulani’s logo (the Cattleya orchid). Kawaiaea notes that the lemon juice, which gives this mai tai a zestier flavor, was in Halekulani’s original recipe for the drink. But he draws the line at other juices. “We’ve made mai tais, and guests will come in and say, ‘Oh, can you add pineapple juice?’ No, that’s not a mai tai!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "892d8539-4041-472e-9710-a9b9e3a03db8",
                        "source_entry_id": "5a1b6e95-3286-39b8-9ace-d0ce1e36d140",
                        "source_sense_id": "5c22a616-cce6-3a82-a56a-cd00c92301b8",
