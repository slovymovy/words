                "word": "curette",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ac6cad19-2630-4714-8978-cbff17636f6f",
                        "entry_id": "686fdea0-0bfe-3a63-aed8-1bb43786fc70",
                        "tags": [
                            "plural"
                        ],
