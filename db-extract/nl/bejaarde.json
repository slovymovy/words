                                "sense_id": "aee90c5c-573c-3a7a-9848-3a089e38bd96",
                                "text": "Een groep bejaarde toeristen in de lobby keek geschrokken op en ik gaf me gewonnen."
                            },
                            {
                                "example_id": "041c3d1f-6963-4df2-b0eb-59701a1ba2f5",
                                "sense_id": "aee90c5c-573c-3a7a-9848-3a089e38bd96",
                                "text": "Om ons heen zaten bejaarde wandelaars met stokken, rugtassen en zuinige gezichten."
                            }
                        ]
                    }
