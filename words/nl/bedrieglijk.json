            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "209199b7-6dd3-3284-a53b-cc795e53f947",
                    "sense_definition": "niet eerlijk of oprecht, bedoeld om iemand te misleiden of een valse indruk te geven",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "misleiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een <w>bedrieglijk</w> glimlachje speelde om haar mond terwijl ze de papieren verborg.",
                            "target_lang_translations": {
                                "en": "A <w>deceitful</w> little smile played around her mouth as she hid the papers.",
                                "ru": "<w>Обманчивая</w> улыбка играла на её губах, пока она прятала бумаги.",
                                "pl": "<w>Fałszywy</w> uśmieszek błąkał się po jej ustach, gdy chowała dokumenty."
                            }
                        },
                        {
                            "text": "Zijn <w>bedrieglijke</w> gedrag zorgde ervoor dat niemand hem meer kon vertrouwen.",
                            "target_lang_translations": {
                                "en": "His <w>deceptive</w> behavior meant that no one could trust him anymore.",
                                "ru": "Его <w>лживое</w> поведение привело к тому, что никто больше не мог ему доверять.",
                                "pl": "Jego <w>podstępne</w> zachowanie sprawiło, że nikt już nie mógł mu ufać."
                            }
                        }
                    ],
                    "synonyms": [
                        "oneerlijk",
                        "vals"
                    ],
                    "antonyms": [
                        "eerlijk",
                        "waarheidsgetrouw"
                    ],
                    "common_phrases": [
                        "bedrieglijk glimlachje",
                        "bedrieglijke schijn"
                    ],
                    "target_lang_definitions": {
                        "en": "not honest or sincere, intended to deceive someone or give a false impression",
                        "ru": "нечестный или неискренний, предназначенный для введения в заблуждение или создания ложного впечатления",
                        "pl": "nieszczery, nieuczciwy, mający na celu wprowadzenie kogoś w błąd lub stworzenie fałszywego wrażenia"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deceitful",
                                "target_lang_sense_clarification": "deliberately misleading or cheating"
                            },
                            {
                                "target_lang_word": "deceptive",
                                "target_lang_sense_clarification": "likely or attempting to deceive"
                            },
                            {
                                "target_lang_word": "false",
                                "target_lang_sense_clarification": "dishonest or deceitful"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "обманчивый",
