                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3569c939-c78f-4e6d-91f6-c874a9719f8f",
                                                "sense_id": "1153625a-21c8-306c-902c-6c372d7ee5e8",
                                                "text": "Huon von Sagar mocno chwycił konia za wodze przy munsztuku."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "7ea7174f-d3fe-32a5-ac05-9b87c70a9fd1",
                                        "entry_id": "5ad62988-1c8c-335a-ba73-582b249a3482",
                                        "glosses": [
                                            "ustnik instrumentu muzycznego lub ustnik fajki"
                                        ],
                                        "tags": [
                                            "Old-Polish",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd5d0b22-cc6a-47ed-9215-362931c1a0f9",
                                                "sense_id": "7ea7174f-d3fe-32a5-ac05-9b87c70a9fd1",
                                                "text": "… przynajmniej w niedzielę i dni święte, co samo na wolą się daje, gdyż to dobrowolne rzeczy być mają, aby, gdy trębacz przez munsztuk rano da hasło, na …"
                                            },
                                            {
                                                "example_id": "a260a3db-c23c-4444-8315-aa9e42992e92",
                                                "sense_id": "7ea7174f-d3fe-32a5-ac05-9b87c70a9fd1",
                                                "text": "… wydano rozkaz, że za pierwszym cichym zatrąbieniem przez munsztuk wszyscy mają siadać na koń i stawać w gotowości."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "4bba8f3a-ae1e-35a6-b483-235a6452fa49",
                                        "entry_id": "5ad62988-1c8c-335a-ba73-582b249a3482",
                                        "glosses": [
                                            "część zwijki papierosa albo część fajki, trzymana przez palacza w ustach"
                                        ],
                                        "tags": [
                                            "Old-Polish",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c30ca77-788f-4a3d-bb3d-cda843314d9f",
                                                "sense_id": "4bba8f3a-ae1e-35a6-b483-235a6452fa49",
                                                "text": "Paliła papierosy z długim munsztukiem, nauczyła się tego, jak sama mówiła, ze zmartwień, papierosy trochę na to pomagały."
                                            }
                                        ],
