                                "sense_id": "fcf6578d-3dc2-395e-8cbf-9fa9593cf492",
                                "text": "Some women with postpartum depression and thyroid imbalance may require antidepressants and psychiatric therapy."
                            },
                            {
                                "example_id": "c1500701-868b-4239-bcd7-cd0166b0ece0",
                                "sense_id": "fcf6578d-3dc2-395e-8cbf-9fa9593cf492",
                                "text": "She had a history of depression and was taking phenelzine, an antidepressant."
                            },
                            {
                                "example_id": "d5697c9e-cf7f-451d-82a3-8ec3e398d6ea",
                                "sense_id": "fcf6578d-3dc2-395e-8cbf-9fa9593cf492",
                                "text": "Dr. Melanie met with Annabelle and delivered her diagnosis: Benny was in the prodromal phase of schizoaffective disorder, and she was recommending that they stop the Ritalin and start him on an antidepressant for the mood disorder and an antipsychotic to treat the auditory hallucinations."
                            }
                        ]
