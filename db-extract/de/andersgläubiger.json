                "senses": [
                    {
                        "sense_id": "158306de-a179-34f1-a9b7-d4b0f825254d",
                        "entry_id": "5c16be86-5990-3d2d-a9ba-5ab12381bcaa",
                        "glosses": [
                            "Person anderen Glaubens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c484fa90-8499-4d30-a617-5b65673d7fcc",
                                "sense_id": "158306de-a179-34f1-a9b7-d4b0f825254d",
                                "text": "Die Andersgläubigen wurden stark diskriminiert."
                            },
                            {
                                "example_id": "d8e960d0-4e1d-4aad-83f9-215dfc72084f",
                                "sense_id": "158306de-a179-34f1-a9b7-d4b0f825254d",
                                "text": "„Um seiner Kirche einen Gefallen zu tun, hat er alle Andersgläubigen aus seinem Reich verbannt, auch die Juden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5628166-f12f-4875-8bb7-8e1962da11fd",
                        "source_entry_id": "5c16be86-5990-3d2d-a9ba-5ab12381bcaa",
                        "source_sense_id": "158306de-a179-34f1-a9b7-d4b0f825254d",
                        "source_sense_description": "Person anderen Glaubens",
                        "target_lang_word": "иноверный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "иноверный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d8f5f3f3-0bf1-37c9-8c24-c1a932f0f1a0",
                                        "entry_id": "ea39a73a-3a03-3f33-a29c-bc2f9bb9880c",
                                        "glosses": [
                                            "религ. принадлежащий иной вере, отличной от веры говорящего"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e65cd821-812f-437d-aec3-cd55b7c558e8",
                                                "sense_id": "d8f5f3f3-0bf1-37c9-8c24-c1a932f0f1a0",
                                                "text": "Прогресс наш сделал то, что на всякий иноверный и твёрдый в своем иноверчестве элемент государства нашего теперь надо смотреть как на благо!"
                                            },
                                            {
                                                "example_id": "78b82324-a637-4b27-a828-360aa5eddcba",
                                                "sense_id": "d8f5f3f3-0bf1-37c9-8c24-c1a932f0f1a0",
                                                "text": "Что хорошего под инове́рный суд идти?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65321a03-9f8f-37b6-9e4b-d091f95874e6",
                                        "entry_id": "ea39a73a-3a03-3f33-a29c-bc2f9bb9880c",
                                        "glosses": [
                                            "субстантивир. то же, что иноверец; человек, исповедующий иную веру"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e825bc5d-1d1e-477f-b779-cc4f0aac04e5",
                                                "sense_id": "65321a03-9f8f-37b6-9e4b-d091f95874e6",
                                                "text": "И поэтому инове́рный, иносла́вный, язычник по нашим понятиям, неверующий — если он всем сердцем и умом живёт согласно своей вере и верит в то, что говорит, может сказать слово правды, и мы можем научиться чему-нибудь."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
