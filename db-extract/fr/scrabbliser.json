                "senses": [
                    {
                        "sense_id": "8ab1bd8f-7f4b-3f3e-b487-4d43b10576a1",
                        "entry_id": "5e7ce4b8-f198-3ac1-b3fe-9eb6c2d46e9c",
                        "glosses": [
                            "Considérer ou traiter quelque chose du point de vue du Scrabble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "672bfcf6-85cb-4255-935d-04c9a5e0fd2b",
                                "sense_id": "8ab1bd8f-7f4b-3f3e-b487-4d43b10576a1",
                                "text": "Exemple: avec TPCLAEU il y avait quatre anagrammes (à vous de les trouver) : et une propension à \"scrabbliser\" constamment le répertoire des mots intéressants, soit par écrit (confection d'un carnet \"top-secret\"), soit oralement: enregistrement et récitation de mots dits \"techniques\" afin de mieux les mémoriser."
                            },
                            {
                                "example_id": "5deed596-8797-4872-ab19-d66f1363790f",
                                "sense_id": "8ab1bd8f-7f4b-3f3e-b487-4d43b10576a1",
                                "text": "Faut être cintré pour tout scrabbliser"
                            }
                        ]
                    },
                    {
                        "sense_id": "179c60f8-8ef1-3080-a52e-c8a2017e7686",
                        "entry_id": "5e7ce4b8-f198-3ac1-b3fe-9eb6c2d46e9c",
                        "glosses": [
                            "Jouer au Scrabble."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "71795032-c6d2-4c55-8a5d-e5c431ef4b08",
                                "sense_id": "179c60f8-8ef1-3080-a52e-c8a2017e7686",
                                "text": "J'espère qu'on pourra de nouveau scrabbliser tous ensemble sur les 1000 un de ces jours!"
                            }
                        ]
                    }
