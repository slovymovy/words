                                        "glosses": [
                                            "A rigid bracelet or anklet, especially one with no clasp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0ef2a77-8fb2-4070-a934-ff5f69ba19cf",
                                                "sense_id": "9e7f1230-539b-3cd2-94be-c1ddc95cb28c",
                                                "text": "Mrs. MacAndrew smoothed down the lap of her gown, and gold bangles fell over her wrists."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bangle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7255d12-f528-3cb4-be35-d05d61a40094",
                                        "entry_id": "1dc08a5e-a083-3acf-8e7e-7a96e6e7d5ef",
                                        "glosses": [
                                            "to beat about or beat down, as corn by the wind."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27ac3bfa-fc97-37e2-b23f-a83266e98c33",
                                        "entry_id": "1dc08a5e-a083-3acf-8e7e-7a96e6e7d5ef",
                                        "glosses": [
                                            "to waste away little by little; squander carelessly; fritter (away)."
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3afd3d72-f130-494e-8bcd-b340e9cf2da6",
                                                "sense_id": "27ac3bfa-fc97-37e2-b23f-a83266e98c33",
                                                "text": "Thus betwixt hope and fear, suspicions, angers […] betwixt falling in, falling out, etc., we bangle away our best days, befool out our times […]."
                                            },
                                            {
                                                "example_id": "e9d8bc59-7241-4230-ba7b-b50c3bae5646",
                                                "sense_id": "27ac3bfa-fc97-37e2-b23f-a83266e98c33",
                                                "text": "If we bangle away the legacy of peace left us by Christ, it is a sign of our want of regard for him. — Duty of Man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50c155ec-3337-33c4-84c4-dc046573f5db",
                                        "entry_id": "1dc08a5e-a083-3acf-8e7e-7a96e6e7d5ef",
                                        "glosses": [
                                            "(falconry) to beat about in the air; flutter: said of a hawk which does not rise steadily and then swoop down upon its prey."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2a313a0-8995-3e8a-9cb5-2af6d2c47d0b",
                                        "entry_id": "1dc08a5e-a083-3acf-8e7e-7a96e6e7d5ef",
                                        "glosses": [
                                            "to flap or hang down loosely, as a hat brim or an animal's ear."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
