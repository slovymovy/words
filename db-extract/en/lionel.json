                "entry_id": "d09e6e57-31ef-37c8-98ee-b2ea248ede40",
                "word": "Lionel",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4f377927-80bf-3c14-8c14-68e210d37c84",
                        "entry_id": "d09e6e57-31ef-37c8-98ee-b2ea248ede40",
                        "glosses": [
                            "A male given name from Latin of mostly British usage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "109099c0-ae02-47af-a396-98ae40963566",
                                "sense_id": "4f377927-80bf-3c14-8c14-68e210d37c84",
                                "text": ", Scene IV\nHis grandfather was Lionel, Duke of Clarence,\nThird son to the third Edward, King of England.\nSpring crestless yeomen from so deep a root?"
                            },
                            {
                                "example_id": "8902deb1-94f3-438e-ae65-021160e8b469",
                                "sense_id": "4f377927-80bf-3c14-8c14-68e210d37c84",
                                "text": "\"Yes. You see, I was born under the sign of Leo, though it's not my real name.\"\n\"What is your real name?\"\nI saw Marcus looking at me, but I couldn't refuse to tell her.\n\"It's Lionel. But don't tell anyone.\"\n\"Why not?\"\n\"Because it's rather a fancy name.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "9fe3a064-5fef-3d51-84c1-a3e5a75cab69",
                        "entry_id": "d09e6e57-31ef-37c8-98ee-b2ea248ede40",
                        "glosses": [
                            "A village in Ness, Isle of Lewis, Western Isles council area, Scotland (OS grid ref NB5363). From Scottish Gaelic."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
