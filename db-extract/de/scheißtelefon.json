                    {
                        "sense_id": "0b578e3a-fe50-37ab-88d4-bd52aa9e8b55",
                        "entry_id": "0c1ad60b-aa34-3c87-ac51-c3c627ffc3b0",
                        "glosses": [
                            "schlechtes/unsinniges Telefon"
