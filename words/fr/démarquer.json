                        "se démarquer par son style"
                    ]
                },
                {
                    "sense_id": "f757d6a0-45fb-36b8-bb23-8625c27d7735",
                    "sense_definition": "Prendre ses distances par rapport aux propos, aux actes ou aux idées d'une autre personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distanciation",
                    "name_type": "no",
                    "examples": [
