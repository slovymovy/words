                "senses": [
                    {
                        "sense_id": "d60e06b9-072b-3ebd-9062-93eacb27b9fe",
                        "entry_id": "6bad2a9e-ee49-3bf0-8d61-fe0f8f72a293",
                        "glosses": [
                            "met droevige gedachten aan de dagen van weleer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cc80a2e-befb-4f48-942c-9cb77cbb4fdc",
                                "sense_id": "d60e06b9-072b-3ebd-9062-93eacb27b9fe",
                                "text": "De eenzaamheid maakte haar melancholiek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e868638a-0cd1-4d63-bbac-626383bde259",
                        "source_entry_id": "6bad2a9e-ee49-3bf0-8d61-fe0f8f72a293",
                        "source_sense_id": "d60e06b9-072b-3ebd-9062-93eacb27b9fe",
                        "source_sense_description": "met droevige gedachten aan de dagen van weleer",
                        "target_lang_word": "melancholisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melancholisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c6c253a-a90a-30c7-9cca-3f06e80e81e3",
                                        "entry_id": "ea8e90f9-6084-34ab-aad3-f395ce3cab4c",
                                        "glosses": [
                                            "schwermütig, Melancholie habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb75acd0-e491-4005-ab0c-e75f60ea2a80",
                                                "sense_id": "6c6c253a-a90a-30c7-9cca-3f06e80e81e3",
                                                "text": "Er war in melancholischer Stimmung und konnte durch nichts aufgeheitert werden."
                                            },
                                            {
                                                "example_id": "93264d75-e5bd-421e-b654-d034190a2974",
                                                "sense_id": "6c6c253a-a90a-30c7-9cca-3f06e80e81e3",
                                                "text": "„Gregors Blick richtete sich dann zum Fenster, und das trübe Wetter – man hörte Regentropfen auf das Fensterblech aufschlagen – machte ihn ganz melancholisch.“"
                                            },
                                            {
                                                "example_id": "aed32979-0b3e-4135-b96e-c4dd0f99a36a",
                                                "sense_id": "6c6c253a-a90a-30c7-9cca-3f06e80e81e3",
                                                "text": "[Coronapandemie 2020:] „Wir haben ja alle diese letzten Wochen und Monate erlebt - ein wirklich bedrückender, melancholischer Stillstand, wo niemand so wirklich wusste, welche Perspektive wir noch geben können.“"
                                            },
                                            {
                                                "example_id": "867717c8-b9a1-4353-a09a-a1c72f5b3e25",
                                                "sense_id": "6c6c253a-a90a-30c7-9cca-3f06e80e81e3",
                                                "text": "[Coronapandemie 2021:] „Natürlich ist auch das breiteste digitale Angebot kein Ersatz für den wirklichen Museumsbesuch. Wen das - und alles andere - melancholisch stimmt, tut gut daran. Sagt jedenfalls Isabelle Görgen-Lammers, die in der Hamburger Kunsthalle gerade eine Ausstellung des melancholischen Malers Giorgio de Chirico kuratiert hat.“"
                                            },
                                            {
                                                "example_id": "b3699898-7890-401a-aa38-f8bcab795772",
                                                "sense_id": "6c6c253a-a90a-30c7-9cca-3f06e80e81e3",
                                                "text": "[Schlagzeile:] „Pablo Picassos Frühwerk - Ein melancholischer Meister malt sich in den Olymp der Kunst“"
                                            },
                                            {
                                                "example_id": "0b2dbadb-137c-4ce6-855c-2f402a0b6fdf",
                                                "sense_id": "6c6c253a-a90a-30c7-9cca-3f06e80e81e3",
                                                "text": "„Melancholisch, mit dunkler Stimme trägt sie [Tanita Tikaram] ihre Lieder vor.“"
                                            },
                                            {
                                                "example_id": "04fa2897-a32e-4e48-b7b9-d3e161625f6c",
                                                "sense_id": "6c6c253a-a90a-30c7-9cca-3f06e80e81e3",
                                                "text": "„Auch das Altern hat Jones musikalisch aufgegriffen: \"I'm Growing Old\" heißt einer der Songs - eine melancholische, unaufdringliche Ballade.“"
                                            },
                                            {
                                                "example_id": "2a861792-1a76-4355-b346-a2948bf31148",
                                                "sense_id": "6c6c253a-a90a-30c7-9cca-3f06e80e81e3",
                                                "text": "„Der Tango ist trotzdem allzeit präsent, denn der heimwehkranke Vincente liebt den melancholischen Klang über alles.“"
                                            },
                                            {
                                                "example_id": "b9f4b1c9-0f22-43aa-90de-df00bced206a",
                                                "sense_id": "6c6c253a-a90a-30c7-9cca-3f06e80e81e3",
                                                "text": "[Maria Schrader] „gelang […] der endgültige Durchbruch mit der Hauptrolle in Doris Dörries melancholischer Komödie \"Keiner liebt mich\".“"
                                            },
                                            {
                                                "example_id": "86ed8408-5f66-4e14-8b20-8e19fc97ab46",
                                                "sense_id": "6c6c253a-a90a-30c7-9cca-3f06e80e81e3",
                                                "text": "„\"Große Freiheit Nr. 7\" mit Hans Albers soll 1944 für Ablenkung vom Krieg sorgen, doch der Film ist den Nazis zu wenig linientreu und zu melancholisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a752f7d9-f655-4435-b03f-e57eb4914f7a",
                        "source_entry_id": "6bad2a9e-ee49-3bf0-8d61-fe0f8f72a293",
                        "source_sense_id": "d60e06b9-072b-3ebd-9062-93eacb27b9fe",
                        "source_sense_description": "met droevige gedachten aan de dagen van weleer",
                        "target_lang_word": "melancholy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melancholy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f8cdfa2-3578-3200-be35-23b7fcba2341",
                                        "entry_id": "bff5e659-0944-3a3a-96af-88c5df07f6d8",
                                        "glosses": [
                                            "Black bile, formerly thought to be one of the four \\\"cardinal humours\\\" of animal bodies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22c425b3-26d4-4a76-b5ed-d6bfbfa2f18d",
                                                "sense_id": "1f8cdfa2-3578-3200-be35-23b7fcba2341",
                                                "text": "Melancholy, cold and dry, thick, black, and sour, […] is a bridle to the other two hot humours, blood and choler, preserving them in the blood, and nourishing the bones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                        "entry_id": "bff5e659-0944-3a3a-96af-88c5df07f6d8",
                                        "glosses": [
                                            "Great sadness or depression, especially of a thoughtful or introspective nature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0307c175-9790-4017-abd3-f5675a01ff4d",
                                                "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                                "text": "My mind was troubled with deep melancholy."
                                            },
                                            {
                                                "example_id": "93c233e1-b1a2-4891-9422-369335f87292",
                                                "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                                "text": "I have neither the scholar’s melancholy, which is emulation; nor the musician’s, which is fantastical; nor the courtier’s, which is proud; nor the soldier’s, which is ambitious; nor the lawyer’s, which is politic; nor the lady’s, which is nice; nor the lover’s, which is all these; but it is a melancholy of mine own, compounded of many simples, extracted from many objects, and, indeed, the sundry contemplation of my travels; in which my often rumination wraps me in a most humorous sadness."
                                            },
                                            {
                                                "example_id": "ceda47bf-1209-4f90-8612-fd4d136999b5",
                                                "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                                "text": "\"The ancients referred melancholy to the mind, the moderns make it matter of digestion—to either case my plan applies,\" said Lady Mandeville."
                                            },
                                            {
                                                "example_id": "8b1514c4-373a-43a6-8c0f-2ad9bb567f0c",
                                                "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                                "text": "As to Ernest... He is quite as nervously broken down as I am but it manifests itself in different ways. His inclination is towards megalomania and mine towards melancholy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "melancholy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                        "entry_id": "62d7b7ad-cfc0-3539-978f-64a64043c1d0",
                                        "glosses": [
                                            "Affected with great sadness or depression."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c9d3648-3a09-463a-a7dc-1f1e82fa1506",
                                                "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                                "text": "Melancholy people don't talk much."
                                            },
                                            {
                                                "example_id": "3265362c-9be8-4312-a0af-b62feb6c647b",
                                                "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                                "text": "[…] he is melancholy without cause, and merry against the hair: […]"
                                            },
                                            {
                                                "example_id": "dccecd0a-19b5-45e0-8b80-aa6f78492945",
                                                "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                                "text": "“[…] the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. […] And then, when you see [the senders], you probably find that they are the most melancholy old folk with malignant diseases. […]”"
                                            },
                                            {
                                                "example_id": "1c37b54e-6b07-4f1f-8006-00dddf8ccca1",
                                                "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                                "text": "It was the same old song / With a melancholy sound"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
