                        "examples": [
                            {
                                "example_id": "c8814bcb-6ce4-4a15-8cf3-a08638692333",
                                "sense_id": "935052d6-383a-3294-a450-8d0fcc6fe7c6",
                                "text": "Repense à trop de choses disparates, conscient d’avoir en tête un Rubik’s Cube dont il n’arrivera jamais à monochromiser les six faces."
                            },
                            {
                                "example_id": "9e758f4c-c6f7-48d5-8acc-7d21e7730dbd",
                                "sense_id": "935052d6-383a-3294-a450-8d0fcc6fe7c6",
                                "text": "Il a voulu se reproduire, Se redire, Se lithopolycopier Pour prismatiquement se décomposer, Se démarquer, Se sérier, Se monochromiser."
                            }
                        ]
                    }
