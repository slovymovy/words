    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3d62ca23-ced6-319b-87c4-3772ea2aff92",
                    "sense_definition": "Przedstawienie, omówienie istoty problemu bądź zagadnienia; wytłumaczenie, uczynienie zrozumiałym.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "making_clear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauczyciel przedstawił nam dokładne <w>wyjaśnienie</w> nowego tematu.",
                            "target_lang_translations": {
                                "ru": "Учитель представил нам подробное <w>объяснение</w> новой темы.",
                                "en": "The teacher gave us a detailed <w>explanation</w> of the new topic."
                            }
                        },
                        {
                            "text": "To jest jedyne logiczne <w>wyjaśnienie</w> tej dziwnej sytuacji.",
                            "target_lang_translations": {
                                "ru": "Это единственное логичное <w>объяснение</w> этой странной ситуации.",
                                "en": "This is the only logical <w>explanation</w> for this strange situation."
                            }
                        }
                    ],
                    "synonyms": [
                        "wytłumaczenie",
                        "wyklarowanie",
                        "eksplikacja",
                        "klaryfikacja",
                        "eksplanacja"
                    ],
                    "antonyms": [
                        "mataczenie"
                    ],
                    "common_phrases": [
                        "logiczne wyjaśnienie",
                        "słowo wyjaśnienia",
                        "żądać wyjaśnień"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раскрытие смысла чего-либо; толкование, делающее предмет или проблему понятными.",
                        "en": "Presentation or discussion of the essence of a problem or issue; making something understandable."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объяснение",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "разъяснение",
                                "target_lang_sense_clarification": "уточнение, детальное объяснение"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "explanation",
                                "target_lang_sense_clarification": "general statement or account that makes something clear"
                            },
                            {
                                "target_lang_word": "clarification",
                                "target_lang_sense_clarification": "making something clearer or freeing from obscurity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "585139c3-e299-30bb-b37c-88218f2ea7af",
                    "sense_definition": "Usprawiedliwienie, przedstawienie motywu czegoś.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "justification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego <w>wyjaśnienie</w> spóźnienia nie przekonało szefa.",
                            "target_lang_translations": {
                                "ru": "Его <w>объяснение</w> опоздания не убедило начальника.",
                                "en": "His <w>explanation</w> for being late did not convince the boss."
                            }
                        },
                        {
                            "text": "Podejrzany postanowił złożyć <w>wyjaśnienia</w> w prokuraturze.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый решил дать <w>объяснения</w> в прокуратуре.",
                                "en": "The suspect decided to make a <w>statement</w> at the prosecutor's office."
                            }
                        }
                    ],
                    "synonyms": [
                        "wytłumaczenie",
                        "ekskuza"
                    ],
                    "common_phrases": [
                        "złożyć wyjaśnienia",
                        "odmówić składania wyjaśnień"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оправдание или изложение мотивов какого-либо поступка.",
                        "en": "Justification or presentation of motives for something."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объяснение",
                                "target_lang_sense_clarification": "изложение причин"
                            },
                            {
                                "target_lang_word": "оправдание",
                                "target_lang_sense_clarification": "в значении извинения"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "explanation",
                                "target_lang_sense_clarification": "reasons given to justify an action or event"
                            },
                            {
                                "target_lang_word": "statement",
                                "target_lang_sense_clarification": "formal account or defense, especially to authorities"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c265c6c-5779-3f9c-badd-154b6d54aca0",
                    "sense_definition": "Rzeczownik odczasownikowy od słowa <w>wyjaśnić</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "making_clear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziękuję za szybkie <w>wyjaśnienie</w> tej kwestii.",
                            "target_lang_translations": {
                                "ru": "Спасибо за быстрое <w>разъяснение</w> этого вопроса.",
                                "en": "Thank you for the quick <w>clarification</w> of this issue."
                            }
                        },
                        {
                            "text": "<w>Wyjaśnienie</w> tego problemu zajmie nam trochę czasu.",
                            "target_lang_translations": {
                                "ru": "<w>Выяснение</w> этой проблемы займет у нас некоторое время.",
                                "en": "<w>Clearing up</w> this problem will take us some time."
                            }
                        }
                    ],
                    "synonyms": [
                        "wytłumaczenie",
                        "wyklarowanie"
                    ],
                    "antonyms": [
                        "mataczenie"
                    ],
                    "common_phrases": [
                        "prosić o wyjaśnienie",
                        "próba wyjaśnienia"
                    ],
                    "traits": [
