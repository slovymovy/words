                    },
                    {
                        "form_id": "bc5db9ed-e966-49cf-be86-3075f5a3df7e",
                        "entry_id": "7b23d8dd-3bac-37e9-a119-95f8fad146ed",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "пресмыка́ющихся"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ca09f994-123f-32b8-88bd-4ed32191934b",
                        "entry_id": "7b23d8dd-3bac-37e9-a119-95f8fad146ed",
                        "glosses": [
                            "прич. от пресмыкаться; ползающий по земле, передвигающийся ползком"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0112f6ac-fab0-39fb-b9fd-733b1d3affcd",
                        "entry_id": "7b23d8dd-3bac-37e9-a119-95f8fad146ed",
                        "glosses": [
                            "перен. раболепствующий, угодничающий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bec768a4-fc4c-4480-9ea0-1fce1d137440",
                                "sense_id": "0112f6ac-fab0-39fb-b9fd-733b1d3affcd",
                                "text": "Страх лишиться насущного хлеба отъемлет от души всю её силу, каждый червонный золотою горою представляет и в каждое выражение впечатлевает знаки в пыли пресмыкающегося рабства."
                            },
                            {
                                "example_id": "6095980f-f25e-46d1-9714-e67559cef9a9",
                                "sense_id": "0112f6ac-fab0-39fb-b9fd-733b1d3affcd",
                                "text": "Но и тогда среди покорных вьючных животных, среди трусливых пресмыкающихся рабов вдруг подымали головы нетерпеливые гордые люди, герои с пламенными душами."
                            },
                            {
                                "example_id": "a769b80e-dd8f-4700-9313-4e3a9dd64c28",
                                "sense_id": "0112f6ac-fab0-39fb-b9fd-733b1d3affcd",
                                "text": "Вместо: деревенским девкам навстречу идут цыганки: пестрые толпы сельских ореад сретаются с смуглыми ватагами пресмыкающихся фараонит."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d4c38df-2b2d-3121-9f5a-b1c2e16ed4a8",
                        "entry_id": "7b23d8dd-3bac-37e9-a119-95f8fad146ed",
                        "glosses": [
                            "перен. лежащий на земле, ползущий по ней; стелющийся"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "693388f7-e35e-4dcf-9133-4b5f186bdbbe",
                                "sense_id": "3d4c38df-2b2d-3121-9f5a-b1c2e16ed4a8",
                                "text": "Одинаково дышали ими влезшие под небо кедры и пресмыкающиеся у их подножий мхи."
                            },
                            {
                                "example_id": "442ba5ca-0e70-4173-ba8a-ae25206fe1bb",
