                        "glosses": [
                            "The Panhellenic Socialist Movement, a Greek political party."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f17a4b2-1ca4-4b7e-8be9-d09564124aec",
                                "sense_id": "ee1ae693-5c11-39ce-a7e2-501a33a3c1c4",
                                "text": "One of the noticeable trends in European politics in the past decade has been the decline of the traditional center-left parties. This is described by the popular term \"PASOKification,\" named after the Panhellenic Socialist Movement (PASOK) of Greece and its epic fall from power in the 2010s."
                            },
                            {
                                "example_id": "5f09fcff-ca63-4b86-93d7-be028d2d02a6",
                                "sense_id": "ee1ae693-5c11-39ce-a7e2-501a33a3c1c4",
                                "text": "As such, the electoral collapse and marginalisation of PASOK was a prominent example of the general decline of major social-democratic parties in Western Europe, which was often accompanied by the emergence of nationalist, left-wing or right-wing parties. A trend labelled 'Pasokification'."
                            }
                        ]
                    }
