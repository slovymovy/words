                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a537d5d1-cc90-43d6-9164-cf99554775c6",
                                                "sense_id": "6bc18878-eb32-3fe5-867d-152acd79086c",
                                                "text": "Get ready for the most thrilling experience of your life!"
