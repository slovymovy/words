{
    "word_family": [
        "remercier",
        "remerciement"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "a23de825-b506-3d64-9a22-5f0753286c45",
                    "sense_definition": "Formule de politesse employée pour exprimer sa gratitude ou son acceptation.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "remerciement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vous remercie pour votre accueil chaleureux, <w>merci</w> beaucoup."
                        },
                        {
                            "text": "Elle a souri en disant <w>merci</w> pour le cadeau offert."
                        }
                    ],
                    "common_phrases": [
                        "merci beaucoup",
                        "merci bien",
                        "grand merci"
                    ]
                },
                {
                    "sense_id": "d3d5ad74-284a-333e-bc2f-c44d0b5522f7",
                    "sense_definition": "Formule polie exprimant une consigne, une invitation ou une demande ferme.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "demande",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Merci</w> de fermer la porte à clé en partant ce soir."
                        },
                        {
                            "text": "<w>Merci</w> de bien vouloir patienter quelques instants dans la salle d'attente."
                        }
                    ],
                    "common_phrases": [
                        "merci de"
                    ]
                },
                {
                    "sense_id": "3f1efaa1-a40d-3dbb-9b83-fddced5ddda6",
                    "sense_definition": "Formule d'insistance placée en fin de phrase pour appuyer une qualification.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce travail était particulièrement difficile et épuisant <w>merci</w>."
                        },
                        {
                            "text": "Après toute cette marche en montagne, nous étions fatigués <w>merci</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Canada"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "28ec0c8d-9108-36d8-a18c-9990ba4ca0a6",
                    "sense_definition": "Parole, formule ou geste exprimant la reconnaissance ou le remerciement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "remerciement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est parti sans même adresser un simple <w>merci</w> à ses hôtes."
                        },
                        {
                            "text": "Je vous envoie mille <w>mercis</w> pour votre précieuse aide."
                        }
                    ],
                    "common_phrases": [
                        "un simple merci",
                        "mille mercis"
                    ]
                },
                {
                    "sense_id": "e728e410-c0f2-38d4-a965-4bc226f773ac",
                    "sense_definition": "Pitié, grâce ou clémence que l'on accorde à quelqu'un ou que l'on implore.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clemence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les marins se trouvaient totalement à la <w>merci</w> des vagues déchaînées."
                        },
                        {
                            "text": "Les deux armées se sont affrontées dans un combat sans <w>merci</w>."
                        }
                    ],
                    "synonyms": [
                        "grâce",
                        "miséricorde",
                        "pitié"
                    ],
                    "common_phrases": [
                        "à la merci de",
                        "sans merci",
                        "crier merci"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Principalement conservé dans des locutions figées"
                        }
                    ]
                }
            ]
        }
    ]
}