                                                "example_id": "0c5e78ee-1bc0-42ea-9382-c22c09617ed0",
                                                "sense_id": "5858a89d-10a9-3be5-bab7-23ca9e0547fa",
                                                "text": "„Stattdessen senkte er seufzend den Kopf und verharrte so lange in dieser untypisch gebeugten Haltung, dass ich fürchtete, ihm könnte etwas fehlen.“"
                                            },
                                            {
                                                "example_id": "bad61c33-79a4-4b61-a17b-6081d801994a",
                                                "sense_id": "5858a89d-10a9-3be5-bab7-23ca9e0547fa",
                                                "text": "„Diese Beschreibung ist untypisch für die Charakterisierung einer Frau im Mittelalter.“"
                                            },
                                            {
                                                "example_id": "4af8d7a6-c4e2-4279-a21c-9025ed329a5e",
                                                "sense_id": "5858a89d-10a9-3be5-bab7-23ca9e0547fa",
                                                "text": "„Auf Papas Geburtstag mischt er sich, völlig untypisch für ihn, lautstark ein, und ergreift, noch viel untypischer, Partei für mich.“"
                                            },
                                            {
                                                "example_id": "c8652911-8917-4fd2-bd9a-d9d2194cff65",
                                                "sense_id": "5858a89d-10a9-3be5-bab7-23ca9e0547fa",
                                                "text": "„Gib den Charakteren untypische Hobbys, untypische Phobien, einen untypischen Modestil.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
