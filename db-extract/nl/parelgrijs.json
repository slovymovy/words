                            {
                                "example_id": "f8e1563b-78f4-42b0-8a3c-7b632e46bec2",
                                "sense_id": "557de0a4-551d-36ff-987f-f90c1c806eee",
                                "text": "Het was kalm en stil in de oude boerderij, waar de dikke muren de stormgeluiden absorbeerden en het verblekende licht algauw parelgrijs door de met spinnenwebben bedekte ramen scheen."
                            },
                            {
                                "example_id": "b34d6626-79fa-4e58-be2e-7759e4b1f2f7",
                                "sense_id": "557de0a4-551d-36ff-987f-f90c1c806eee",
                                "text": "Ook de twee kanten lingeriesetjes zijn verkrijgbaar in twee kleuren: kobaltblauw en parelgrijs. Het gaat volgens Armani om supervrouwelijk ondergoed, geschikt voor dagelijks gebruik en zeer budgetvriendelijk."
                            }
