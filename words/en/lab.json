                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography_canada",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The shipping address was listed as Happy Valley-Goose Bay, <w>Lab</w>.",
                            "target_lang_translations": {
                                "ru": "Адрес доставки был указан как Хэппи-Вэлли-Гус-Бей, <w>Лабрадор</w>.",
                                "zh": "收货地址写的是快乐谷-鹅湾，<w>拉布拉多</w>地区。"
                            }
                        },
                        {
                            "text": "Weather conditions in <w>Lab</w>. can be very harsh in winter.",
                            "target_lang_translations": {
                                "ru": "Погодные условия на <w>Лабрадоре</w> могут быть очень суровыми зимой.",
                                "zh": "<w>拉布拉多</w>地区的冬季天气条件可能非常恶劣。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от \"Labrador\", региона на востоке Канады.",
                        "zh": "加拿大东部地区拉布拉多（Labrador）的缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лабрадор",
                                "target_lang_sense_clarification": "регион"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉布拉多",
                                "target_lang_sense_clarification": "地理区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2d3c639-e50d-3df6-9f55-94cf65a7f226",
                    "sense_definition": "A river and region in northeastern Kosovo.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography_kosovo",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The <w>Lab</w> river flows through a valley in the northeastern part of the country.",
                            "target_lang_translations": {
                                "ru": "Река <w>Лаб</w> протекает через долину в северо-восточной части страны.",
                                "zh": "<w>拉布河</w>流经该国东北部的一处山谷。"
                            }
                        },
                        {
                            "text": "Several villages are located along the banks of the <w>Lab</w>.",
                            "target_lang_translations": {
                                "ru": "Несколько деревень расположены по берегам <w>Лаба</w>.",
                                "zh": "有几个村庄坐落在<w>拉布河</w>岸边。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Llap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Река и регион на северо-востоке Косово.",
                        "zh": "科索沃东北部的一条河流及地区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лаб",
                                "target_lang_sense_clarification": "река"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉布河",
                                "target_lang_sense_clarification": "河流名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
