                                "example_id": "33ab9ae9-6006-4a8c-aea7-800856f636af",
                                "sense_id": "958eded2-245e-31f5-b11e-608f6b462ce4",
                                "text": "„Ein Anrainer hat in einem Haus eine Brandleiche entdeckt.“"
                            },
                            {
                                "example_id": "cfd5221b-8532-4dea-bae2-3043496fc2f6",
                                "sense_id": "958eded2-245e-31f5-b11e-608f6b462ce4",
                                "text": "„Die Obduktion von Brandleichen ist für die Gerichtsmedizin oftmals mit Schwierigkeiten verbunden.“"
                            },
                            {
                                "example_id": "3ec196d8-8a77-4f64-8058-6f5828faf708",
                                "sense_id": "958eded2-245e-31f5-b11e-608f6b462ce4",
                                "text": "„Die Brandleiche war am Donnerstag vergangener Woche in einem verkohlten Schuppen auf einem Grundstück in der Beethovenstraße gefunden worden.“"
                            },
                            {
                                "example_id": "72a715ab-eeb3-4a10-a470-3a98751b1d37",
                                "sense_id": "958eded2-245e-31f5-b11e-608f6b462ce4",
                                "text": "„Die Polizei sucht erneut Zeugen, die Angaben zur Identität der Brandleiche machen können, die ein Fußgänger im Juli 2012 gefunden hatte.“"
                            }
