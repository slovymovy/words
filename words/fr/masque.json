                },
                {
                    "sense_id": "2da07b0d-a2e6-3e5e-8282-7d52179ea617",
                    "sense_definition": "Préparation cosmétique que l'on applique sur la peau ou les cheveux pour les purifier ou les hydrater.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cosmetique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle laisse poser ce <w>masque</w> hydratant pendant une dizaine de minutes avant de rincer."
                        },
                        {
                            "text": "Un <w>masque</w> à l'argile permet de purifier le visage en profondeur."
