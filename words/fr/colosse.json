                        "nabot"
                    ],
                    "common_phrases": [
                        "force de colosse"
                    ]
                },
                {
                    "sense_id": "614233b8-35af-3f94-921e-cb3a1bc9454c",
                    "sense_definition": "Statue d'une dimension extraordinaire, beaucoup plus grande que nature.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "monument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les archéologues ont mis au jour les fragments d'un ancien <w>colosse</w> en marbre."
                        },
                        {
                            "text": "Le <w>colosse</w> de Rhodes était l'une des sept merveilles du monde antique."
                        }
                    ],
                    "antonyms": [
                        "figurine",
                        "statuette"
                    ],
                    "common_phrases": [
