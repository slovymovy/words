                        "source_sense_id": "76af7d1d-a7a7-3b0d-abbd-a84702b03ca6",
                        "source_sense_description": "supposed ability to detect whether or not a person is gay",
                        "target_lang_word": "gaydar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaydar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46867dd7-b072-337d-b6c8-ea6e76c3c9ed",
                                        "entry_id": "1af1c919-8e21-3de5-9855-d6e4a610161e",
                                        "glosses": [
                                            "Capacité de reconnaître un homosexuel par son apparence, ses manières, ou encore par instinct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c07b219-4c5d-4ee8-8c8e-5785a70199a1",
                                                "sense_id": "46867dd7-b072-337d-b6c8-ea6e76c3c9ed",
                                                "text": "Est-ce que le gaydar est valable pour les femmes ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "469ecbd7-8b66-4424-ab29-c065c9bb843c",
                        "source_entry_id": "c997b106-55e9-3c42-ab16-3d0165b4b1bf",
                        "source_sense_id": "76af7d1d-a7a7-3b0d-abbd-a84702b03ca6",
                        "source_sense_description": "supposed ability to detect whether or not a person is gay",
                        "target_lang_word": "Gaydar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gaydar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b88479b-f0c3-3364-85b2-c44d7fba91e0",
                                        "entry_id": "063c7996-869e-3632-84be-1979bb53c58e",
                                        "glosses": [
                                            "Fähigkeit eines Menschen, Lesben und Schwule als solche zu erkennen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a73e26c-cf79-4d69-a2d1-8a0c9de08519",
                                                "sense_id": "5b88479b-f0c3-3364-85b2-c44d7fba91e0",
                                                "text": "„Bedeutete ursprünglich Gaydar die ‚natürliche‘ Fähigkeit schwuler Männer bzw. Lesben, sich anhand eines Blicks untereinander erkennen zu können, bekommt es bei gaydar.co.uk und ähnlich funktionierenden Websites die Bedeutung, wie ein Radar ganze Länder, Regionen, Städte durchblättern zu könnnen nach anderen Schwulen – und von diesen dann mti einem Klick Profilinformationen zu erhalten.“"
                                            },
                                            {
                                                "example_id": "b7a4c9e8-4717-4247-8681-86ef4adaf532",
                                                "sense_id": "5b88479b-f0c3-3364-85b2-c44d7fba91e0",
                                                "text": "„Wir sprechen mit großer Offenheit über das Thema Homosexualität, und Kasper ist zugänglich, hört zu, stellt Fragen, und ich weiß von mehreren Quellen und auch intuitiv – dank des Gaydars – dass ich wahrscheinlich einen der wenigen Kardinäle der Kurie vor mir habe, der nicht schwul ist.“"
                                            },
                                            {
                                                "example_id": "bd0b745a-08f8-4a7e-87e7-545af087ad2d",
                                                "sense_id": "5b88479b-f0c3-3364-85b2-c44d7fba91e0",
                                                "text": "„Gab es nicht so etwas wie ein Gaydar, um zu erkennen, ob sein Gegenüber auch auf Männer steht?“"
                                            },
                                            {
                                                "example_id": "b8b4d974-fc77-427e-9214-c1c23b9b7eed",
                                                "sense_id": "5b88479b-f0c3-3364-85b2-c44d7fba91e0",
                                                "text": "„Hast du nicht gewusst, dass echte Kölner Mädchen einen Gaydar haben?“"
                                            },
                                            {
                                                "example_id": "0bc00b6c-3389-4427-8e89-5506e75156e3",
                                                "sense_id": "5b88479b-f0c3-3364-85b2-c44d7fba91e0",
                                                "text": "„Das liegt an den Signalen, Ola. Kleine unbewusste und bewusste Signale. Außerdem können sich auch Gaydare irren. Glaub mir.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
