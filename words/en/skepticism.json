    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "06e3232e-0566-345f-8477-738117ceff41",
                    "sense_definition": "A studied attitude of questioning and doubt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "doubt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The public viewed the new government policy with considerable <w>skepticism</w>."
                        },
                        {
                            "text": "Despite the expert's claims, many scientists expressed <w>skepticism</w> regarding the results."
                        }
                    ],
                    "synonyms": [
                        "doubt",
                        "distrust",
                        "cynicism"
                    ],
                    "antonyms": [
                        "belief",
                        "certainty",
                        "trust"
                    ],
                    "common_phrases": [
                        "widespread skepticism",
                        "express skepticism"
                    ]
                },
                {
                    "sense_id": "0f801ecd-8b72-32dd-8fd7-db6b15995579",
                    "sense_definition": "The practice or philosophy of being a skeptic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient <w>skepticism</w> challenged the possibility of attaining true knowledge."
                        },
                        {
                            "text": "His approach to life was rooted in a form of philosophical <w>skepticism</w>."
                        }
                    ]
                },
                {
                    "sense_id": "10986d01-f960-3071-a4c5-c9d8e0d966bd",
                    "sense_definition": "Doubt or disbelief of religious doctrines.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "doubt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rise of scientific inquiry led to increased <w>skepticism</w> toward traditional religious teachings."
                        },
                        {
                            "text": "He openly discussed his <w>skepticism</w> regarding the miracles described in the text."
                        }
                    ],
                    "synonyms": [
                        "unbelief",
                        "disbelief"
                    ],
                    "antonyms": [
                        "faith",
                        "belief"
                    ]
                },
                {
                    "sense_id": "26583a33-2749-3658-b76f-4a538b196e89",
                    "sense_definition": "The doctrine that absolute knowledge is not possible.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The core of his argument relies on the tenets of radical <w>skepticism</w>."
                        },
                        {
                            "text": "Many philosophers have debated the implications of <w>skepticism</w> for human understanding."
                        }
                    ]
                },
                {
                    "sense_id": "43b90b75-0b26-3c86-ad51-1be2002bbaec",
                    "sense_definition": "A methodology that starts from a neutral standpoint and aims to acquire certainty through scientific or logical observation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern scientific <w>skepticism</w> requires rigorous testing of all hypotheses."
                        },
                        {
                            "text": "By applying systematic <w>skepticism</w>, the researchers eliminated potential biases in their data."
                        }
                    ],
                    "synonyms": [
                        "inquiry"
                    ]
                }
            ]
        }
    ]
