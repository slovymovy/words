        "nl-extract.jsonl": [
            {
                "entry_id": "a60d5720-807a-30c0-8803-ae8c60e54b3a",
                "word": "hedonisme",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4ac590dd-fceb-395c-b193-00e5418aefb3",
                        "entry_id": "a60d5720-807a-30c0-8803-ae8c60e54b3a",
                        "glosses": [
                            "een filosofische leer die stelt dat (zinnelijk) genot het richtsnoer van het menselijk handelen hoort te zijn en het hoogste goed is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21fc4727-f505-47f1-a518-97d2f86d6080",
                                "sense_id": "4ac590dd-fceb-395c-b193-00e5418aefb3",
                                "text": "Wie niet permanent zo uitbundig mogelijk geniet van het leven, wordt al snel gezien als sneu. Dat berust op een groot misverstand, leert een filosofische doorlichting van het hedonisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ccfcf73-067b-4194-89e0-db6a627b1850",
                        "source_entry_id": "a60d5720-807a-30c0-8803-ae8c60e54b3a",
                        "source_sense_id": "4ac590dd-fceb-395c-b193-00e5418aefb3",
                        "source_sense_description": "leer dat genot het hoogste goed is",
                        "target_lang_word": "Hedonismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hedonismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd794a7a-445d-3de4-8e74-e37f35e66cdd",
                                        "entry_id": "43f0bb50-1b3e-398c-aad3-c259ad989a99",
                                        "glosses": [
                                            "Streben nach Sinneslust und Genuss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8fb6a7e-e535-4554-a7de-c7c40accff32",
                                                "sense_id": "cd794a7a-445d-3de4-8e74-e37f35e66cdd",
                                                "text": "Für ihn ist Hedonismus ein Lebensprinzip."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea9738fd-c84b-332c-b842-6e35e0f5c591",
                                        "entry_id": "43f0bb50-1b3e-398c-aad3-c259ad989a99",
                                        "glosses": [
                                            "Lehre, dass das Streben nach Genuss und Sinneslust die höchsten Werte des Lebens seien; eine an den Genusssüchten des Lebens orientierte Grundeinstellung"
                                        ],
                                        "tags": [
                                            "Ethik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1653e897-8c12-458d-84af-06972d98ff30",
                                                "sense_id": "ea9738fd-c84b-332c-b842-6e35e0f5c591",
                                                "text": "„Der Hedonismus ist diejenige ethische Richtlinie, welche sinnliche Lust, das Vergnügen, den Genuß als Motiv, Ziel oder Beweis alles sittlichen Handelns betrachtet.“"
                                            },
                                            {
                                                "example_id": "31346d12-19cb-4e4b-bdb5-77fa5da38357",
                                                "sense_id": "ea9738fd-c84b-332c-b842-6e35e0f5c591",
                                                "text": "Der griechische Philosoph Aristippos von Kyrene gilt als der Begründer des Hedonismus."
                                            },
                                            {
                                                "example_id": "54bcb26d-e5e2-47e8-bfb7-0ad5d6de364f",
                                                "sense_id": "ea9738fd-c84b-332c-b842-6e35e0f5c591",
                                                "text": "„Seine bedeutsame Fortentwicklung hat der antike Hedonismus in der Lehre Epikurs erhalten ….“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51ec52d9-4720-48b1-9878-454ab192f502",
                        "source_entry_id": "a60d5720-807a-30c0-8803-ae8c60e54b3a",
                        "source_sense_id": "4ac590dd-fceb-395c-b193-00e5418aefb3",
                        "source_sense_description": "leer dat genot het hoogste goed is",
                        "target_lang_word": "hedonism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hedonism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "271498a8-a8da-3e16-80db-f97dafdf5d06",
                                        "entry_id": "11fbf743-1df8-32ce-92c6-c49d3713ee7a",
                                        "glosses": [
                                            "The philosophical belief that happiness, particularly sensual pleasure, is the highest good in life."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e865bb55-64b8-422c-a14e-999254c5ff0f",
                                                "sense_id": "271498a8-a8da-3e16-80db-f97dafdf5d06",
                                                "text": "It began with his shrugging off of both family and faith and taking the Amtrak Vermonter out of Penn Station to major in minor hedonism and minor in the major modernists at a hippie college in the great Jewless north."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daae4f58-55be-3ac0-8ade-62c070a988fa",
                                        "entry_id": "11fbf743-1df8-32ce-92c6-c49d3713ee7a",
                                        "glosses": [
                                            "A general devotion to the pursuit of pleasure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fd602c3-e0dc-4ac3-a50c-5d1cbe0c8fc6",
                        "source_entry_id": "a60d5720-807a-30c0-8803-ae8c60e54b3a",
                        "source_sense_id": "4ac590dd-fceb-395c-b193-00e5418aefb3",
                        "source_sense_description": "leer dat genot het hoogste goed is",
                        "target_lang_word": "hédonisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hédonisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66ef6d02-ef78-3d55-b406-f1dca14acc53",
                                        "entry_id": "a3a668fc-dcc1-34bc-8a08-dad445ca516b",
                                        "glosses": [
                                            "Doctrine philosophique remontant à Aristippe de Cyrène. Le plaisir serait la première chose à rechercher pour être heureux dans la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "800ba781-12f3-4988-b825-14e3d6c2ea9f",
                                                "sense_id": "66ef6d02-ef78-3d55-b406-f1dca14acc53",
                                                "text": "« Toute existence est construite sur du sable, la mort est la seule certitude que nous ayons. Il s'agit moins de l'apprivoiser que de la mépriser. L'hédonisme est l'art de ce mépris. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0cb6c20-6958-320f-9647-c3957c86108b",
                                        "entry_id": "a3a668fc-dcc1-34bc-8a08-dad445ca516b",
                                        "glosses": [
                                            "Recherche systématique du plaisir, de la satisfaction des sens ; le plaisir l'emporte alors sur toutes les autres valeurs morales."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7415a0d0-09cf-47f9-be0e-1fd05a422e44",
                                                "sense_id": "f0cb6c20-6958-320f-9647-c3957c86108b",
                                                "text": "Jadis, l’hédonisme était suspect. Cette mentalité s’est longtemps maintenue, là encore, par la double culture laïque et chrétienne, fondée sur le travail, l’effort et l’ascèse. … Depuis, bonheur, bien-être et jouissance sont devenus des absolus. « Je me suis fait plaisir », entend-on. Un tel aveu, autrefois, aurait été indécent. Maintenant, il donne le ton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "636380c2-c80c-3ba8-a74c-a35e19aa32e3",
                                        "entry_id": "a3a668fc-dcc1-34bc-8a08-dad445ca516b",
                                        "glosses": [
                                            "(Morale) Recherche de plaisirs égoïstes. Quête effrénée du plaisir, allant de pair avec un mépris affiché pour la réserve, l'abstinence et la privation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f9d4e19-c1e4-3dc3-9aa7-eca7b164939b",
                                        "entry_id": "a3a668fc-dcc1-34bc-8a08-dad445ca516b",
                                        "glosses": [
                                            "Plaisir fugace. Recherche insatiable d'objets renouvelés de satisfaction précaire : rencontres, objets manufacturés, spectacles, images, musique."
                                        ],
                                        "tags": [
                                            "Publicité"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "241ebb73-967a-353e-9a2c-cbdfc017e854",
                                        "entry_id": "a3a668fc-dcc1-34bc-8a08-dad445ca516b",
                                        "glosses": [
                                            "Explication de l'économie par la recherche du maximum de satisfaction, avec le minimum d'effort.  ^([1])"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
