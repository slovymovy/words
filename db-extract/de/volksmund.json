                                        "entry_id": "2563396e-3292-30c2-99a4-bdc83d517636",
                                        "glosses": [
                                            "Indigenous spoken language, as distinct from a literary or liturgical language such as Ecclesiastical Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c318e76-639e-4f53-874a-eeb886675ed6",
                                                "sense_id": "844a7d70-10ad-3388-b3c3-4fd95500eafc",
                                                "text": "Vatican II, a church council in the 1960s, allowed the celebration of the mass in the vernacular."
