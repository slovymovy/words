                "senses": [
                    {
                        "sense_id": "2aead282-e781-32ed-a063-58f89e6dc087",
                        "entry_id": "378d82cd-b6e4-37a1-8cb6-dc8831a2fcc9",
                        "glosses": [
                            "Faire perdre son caractère de chenal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78dafce3-09c9-4119-b00b-f457ad6bd144",
                                "sense_id": "2aead282-e781-32ed-a063-58f89e6dc087",
                                "text": "C'est à Voies navigables de France que revient la mise en oeuvre de ce vaste chantier, qui vise à « déchenaliser », de recréer, entre Nantes et Ancenis, des seuils."
                            },
                            {
                                "example_id": "6755a489-80fb-4a95-ac39-54517d07b795",
                                "sense_id": "2aead282-e781-32ed-a063-58f89e6dc087",
                                "text": "M. RÉ lui rappelle que la suppression du tertre va déchenaliser la rivière et faire décroître les vitesses pour une extension plus large."
                            },
                            {
                                "example_id": "6944504a-7870-43b9-820a-3d5149f5c0c8",
                                "sense_id": "2aead282-e781-32ed-a063-58f89e6dc087",
                                "text": "Dévégétalisation et scarification des atterrissements de façon à déchenaliser le lit vif du cours d'eau."
                            }
                        ]
                    }
