                    {
                        "sense_id": "5d0ed50f-5583-31c2-a005-ae9beeff4b99",
                        "entry_id": "876da02c-f379-3dc0-a24e-06e4fdd54de3",
                        "glosses": [
                            "einem Herrn geschuldete, erzwungene Arbeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a93569a1-ac76-43f6-9834-f69442e5a437",
                                "sense_id": "5d0ed50f-5583-31c2-a005-ae9beeff4b99",
                                "text": "„Sie mussten Fronarbeit leisten und Tribute erbringen.“"
                            },
                            {
                                "example_id": "666f52df-2e0b-428d-8db7-41db91e21757",
                                "sense_id": "5d0ed50f-5583-31c2-a005-ae9beeff4b99",
                                "text": "„Ueberall sah Pierre aus den ihm vorgelegten Büchern der Verwalter, dass die Fronarbeit gegen früher beträchtlich eingeschränkt worden war, und überall bekam er aus diesem Anlass rührende Danksagungen von Bauerndeputationen in blauen Kaftans zu hören.“"
                            },
                            {
                                "example_id": "78fda038-5dca-4d08-a7ef-8b1b14637e27",
                                "sense_id": "5d0ed50f-5583-31c2-a005-ae9beeff4b99",
                                "text": "„Sie legten dort Plantagen an und zwangen die Bevölkerung zur Fronarbeit.“"
                            }
                        ],
