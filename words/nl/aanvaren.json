{
    "word_family": [
        "varen",
        "aanvaart",
        "gevaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a6921ad6-2f6b-3bde-bdc6-61c490496389",
                    "sense_definition": "Al varend in botsing komen met een ander vaartuig of een object.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "botsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schip heeft gisteren een andere boot <w>aangevaren</w>.",
                            "target_lang_translations": {
                                "en": "The ship <w>collided with</w> another boat yesterday."
                            }
                        },
                        {
                            "text": "Door de dichte mist was er een groot gevaar om een rots aan te varen.",
                            "target_lang_translations": {
                                "en": "Due to the dense fog, there was a great danger of <w>hitting</w> a rock."
                            }
                        }
                    ],
                    "synonyms": [
                        "botsen"
                    ],
                    "common_phrases": [
                        "een schip aanvaren"
                    ],
                    "target_lang_definitions": {
                        "en": "To collide with another vessel or object while sailing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "collide with",
                                "target_lang_sense_clarification": "of a ship or boat"
                            },
                            {
                                "target_lang_word": "hit",
                                "target_lang_sense_clarification": "strike a vessel or object with a ship"
                            },
                            {
                                "target_lang_word": "run into",
                                "target_lang_sense_clarification": "accidental collision at sea"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cca435dc-329e-3b82-b533-7768cc09d063",
                    "sense_definition": "Per schip of boot dichterbij komen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "naderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij kwam heel langzaam met de veerboot <w>aangevaren</w>.",
                            "target_lang_translations": {
                                "en": "He came <w>sailing up</w> very slowly on the ferry."
                            }
                        },
                        {
                            "text": "De kapitein besloot voorzichtig naar de haven aan te varen.",
                            "target_lang_translations": {
                                "en": "The captain decided to cautiously <w>approach</w> the harbor."
                            }
                        }
                    ],
                    "synonyms": [
                        "naderen"
                    ],
                    "antonyms": [
                        "wegvaren"
                    ],
                    "common_phrases": [
                        "komen aanvaren"
                    ],
                    "target_lang_definitions": {
                        "en": "To come closer by ship or boat."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "approach",
                                "target_lang_sense_clarification": "by boat or ship"
                            },
                            {
                                "target_lang_word": "sail up to",
                                "target_lang_sense_clarification": "come near by sailing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b91fdfdf-d224-34bd-a8c9-7f47b823a5a2",
                    "sense_definition": "Met een schip een haven binnengaan.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "naderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schipper wilde vroeg in de ochtend de haven <w>aanvaren</w>.",
                            "target_lang_translations": {
                                "en": "The skipper wanted to <w>enter</w> the harbor early in the morning."
                            }
                        },
                        {
                            "text": "Ze <w>voeren</w> rustig <w>aan</w> om af te meren bij de kade.",
                            "target_lang_translations": {
                                "en": "They <w>approached</w> quietly to moor at the quay."
                            }
                        }
                    ],
                    "synonyms": [
                        "binnenlopen"
                    ],
                    "antonyms": [
                        "uitvaren"
                    ],
                    "common_phrases": [
                        "de haven aanvaren"
                    ],
                    "target_lang_definitions": {
                        "en": "To enter a harbor with a ship."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enter",
                                "target_lang_sense_clarification": "a harbor by ship"
                            },
                            {
                                "target_lang_word": "make for",
                                "target_lang_sense_clarification": "head towards a port or harbor"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}