{
    "word_family": [
        "briskly",
        "briskness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4ba79117-d708-3c71-b257-2044f6af28ad",
                    "sense_definition": "Full of energy and activity; characterized by quick motion or action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lively",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We took a <w>brisk</w> walk through the park this morning.",
                            "target_lang_translations": {
                                "zh": "我们今天早上在公园里进行了一次<w>轻快</w>的散步。",
                                "es": "Dimos un paseo <w>enérgico</w> por el parque esta mañana."
                            }
                        },
                        {
                            "text": "The team made a <w>brisk</w> start to the game and scored early.",
                            "target_lang_translations": {
                                "zh": "球队开局<w>迅猛</w>，很快就进球了。",
                                "es": "El equipo tuvo un comienzo <w>rápido</w> en el partido y marcó pronto."
                            }
                        }
                    ],
                    "synonyms": [
                        "lively",
                        "spirited",
                        "quick"
                    ],
                    "common_phrases": [
                        "brisk walk",
                        "brisk pace"
                    ],
                    "target_lang_definitions": {
                        "zh": "充满活力、动作迅速的；形容行动、步伐或节奏轻快有力。",
                        "es": "Lleno de energía y actividad; caracterizado por un movimiento o acción rápida."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "轻快的",
                                "target_lang_sense_clarification": "形容步伐、节奏等快而有活力"
                            },
                            {
                                "target_lang_word": "迅猛的",
                                "target_lang_sense_clarification": "形容行动、开局等迅速有力"
                            },
                            {
                                "target_lang_word": "精神抖擞的",
                                "target_lang_sense_clarification": "形容人或状态充满精神"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "enérgico",
                                "target_lang_sense_clarification": "Que denota energía y vigor en la acción."
                            },
                            {
                                "target_lang_word": "rápido",
                                "target_lang_sense_clarification": "Que se hace con prontitud o velocidad."
                            },
                            {
                                "target_lang_word": "brioso",
                                "target_lang_sense_clarification": "Que muestra brío, resolución y energía."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c089d7e-f3dd-3895-80b8-e0b7a6249d13",
                    "sense_definition": "Stimulating or invigorating, often referring to cool weather.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lively",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>brisk</w> autumn morning with a cool breeze.",
                            "target_lang_translations": {
                                "zh": "那是一个<w>凉爽</w>的秋日清晨，微风轻拂。",
                                "es": "Era una mañana de otoño <w>vigorizante</w> con una brisa fresca."
                            }
                        },
                        {
                            "text": "The <w>brisk</w> air helped everyone wake up quickly.",
                            "target_lang_translations": {
                                "zh": "那股<w>清新</w>的空气让大家很快清醒过来。",
                                "es": "El aire <w>fresco</w> ayudó a todos a despertarse rápidamente."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brisk air",
                        "brisk wind"
                    ],
                    "target_lang_definitions": {
                        "zh": "（天气、空气等）凉爽而使人精神振奋的。",
                        "es": "Estimulante o vigorizante, a menudo referido al clima fresco."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "凉爽的",
                                "target_lang_sense_clarification": "形容天气凉而舒适"
                            },
                            {
                                "target_lang_word": "清新的",
                                "target_lang_sense_clarification": "形容空气、微风等使人精神一振"
                            },
                            {
                                "target_lang_word": "令人精神一振的",
                                "target_lang_sense_clarification": "强调凉意带来的振奋感"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "vigorizante",
                                "target_lang_sense_clarification": "Que da vigor o energía, especialmente referido al aire o clima."
                            },
                            {
                                "target_lang_word": "fresco",
                                "target_lang_sense_clarification": "Referido al clima, que es agradablemente frío y estimulante."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08518855-fd2e-30d4-8cfc-1f3a3e812997",
                    "sense_definition": "Abrupt or curt in manner when dealing with others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave a <w>brisk</w> reply and turned back to her work.",
                            "target_lang_translations": {
                                "zh": "她给了一个<w>生硬</w>的回答，然后转身继续工作。",
                                "es": "Ella dio una respuesta <w>brusca</w> y volvió a su trabajo."
                            }
                        },
                        {
                            "text": "His <w>brisk</w> manner made it clear he had no time for small talk.",
                            "target_lang_translations": {
                                "zh": "他那种<w>冷淡</w>的态度表明他没时间寒暄。",
                                "es": "Su actitud <w>seca</w> dejó claro que no tenía tiempo para charlas triviales."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（待人接物时）态度或语气简短生硬的；显得冷淡唐突的。",
                        "es": "Abrupto o cortante en el trato con los demás."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "生硬的",
                                "target_lang_sense_clarification": "指说话或态度简短而不够柔和"
                            },
                            {
                                "target_lang_word": "冷淡的",
                                "target_lang_sense_clarification": "指待人态度冷冷的、不热情"
                            },
                            {
                                "target_lang_word": "唐突的",
                                "target_lang_sense_clarification": "强调言行唐突、不够客气"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "brusco",
                                "target_lang_sense_clarification": "Que se comporta sin suavidad ni gentileza en el trato."
                            },
                            {
                                "target_lang_word": "seco",
                                "target_lang_sense_clarification": "Referido al trato o respuesta, que es cortante o poco amable."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c50611e8-e3c7-3f40-a74e-932a27beaa66",
                    "sense_definition": "Sparkling or fizzy, often used for drinks.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>brisk</w> cider was refreshing on a hot day.",
                            "target_lang_translations": {
                                "zh": "这种<w>起泡</w>的苹果酒在热天里喝起来很清爽。",
                                "es": "La sidra <w>chispeante</w> era refrescante en un día caluroso."
                            }
                        },
                        {
                            "text": "The wine had a <w>brisk</w> quality that tickled the tongue.",
                            "target_lang_translations": {
                                "zh": "这款酒有一种<w>起泡</w>的口感，让舌尖微微发痒。",
                                "es": "El vino tenía una cualidad <w>efervescente</w> que hacía cosquillas en la lengua."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（饮料）带气或微微起泡的，入口清爽并略有刺激感。",
                        "es": "Espumoso o gaseoso, a menudo usado para bebidas."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "起泡的",
                                "target_lang_sense_clarification": "指饮料带有气泡"
                            },
                            {
                                "target_lang_word": "有气的",
                                "target_lang_sense_clarification": "指饮料含气、微有刺激感"
                            },
                            {
                                "target_lang_word": "清爽带劲的",
                                "target_lang_sense_clarification": "强调饮料清爽、带刺激口感"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "chispeante",
                                "target_lang_sense_clarification": "Que tiene burbujas o una cualidad vivaz en la boca."
                            },
                            {
                                "target_lang_word": "efervescente",
                                "target_lang_sense_clarification": "Que desprende burbujas de gas."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "26933779-6653-3289-ba07-e107f909bd1a",
                    "sense_definition": "To make or become lively or animated.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The music helped to <w>brisk</w> up the tired party guests.",
                            "target_lang_translations": {
                                "zh": "音乐让疲惫的派对客人们<w>振作</w>了起来。",
                                "es": "La música ayudó a <w>animar</w> a los cansados invitados de la fiesta."
                            }
                        },
                        {
                            "text": "A cold shower will <w>brisk</w> you up before the meeting.",
                            "target_lang_translations": {
                                "zh": "开会前冲个冷水澡会让你<w>清醒</w>起来。",
                                "es": "Una ducha fría te <w>espabilará</w> antes de la reunión."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使变得有精神、活跃或生动起来；也可指自己振作起来。",
                        "es": "Hacer o volverse animado o lleno de vida."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "振作起来",
                                "target_lang_sense_clarification": "使人恢复精神、变得有活力"
                            },
                            {
                                "target_lang_word": "活跃起来",
                                "target_lang_sense_clarification": "使气氛或人变得更活跃"
                            },
                            {
                                "target_lang_word": "提起精神",
                                "target_lang_sense_clarification": "使人变得更清醒有精神"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "animar",
                                "target_lang_sense_clarification": "Infundir ánimo o energía a alguien."
                            },
                            {
                                "target_lang_word": "espabilar",
                                "target_lang_sense_clarification": "Hacer que alguien se vuelva más despierto o activo."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}