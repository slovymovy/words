    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f50b7999-bc83-3734-afe8-40f4d231b880",
                    "sense_definition": "een andere richting inslaan, meestal haaks op de huidige weg",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "richting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet bij de volgende kruising links <w>afslaan</w> om bij het station te komen.",
                            "target_lang_translations": {
                                "en": "You need to <w>turn</w> left at the next intersection to get to the station."
                            }
                        },
                        {
                            "text": "Hij <w>sloeg</w> plotseling <w>af</w> naar een klein zandpad.",
                            "target_lang_translations": {
                                "en": "He suddenly <w>turned off</w> onto a small dirt path."
                            }
                        }
                    ],
                    "common_phrases": [
                        "links afslaan",
                        "rechts afslaan",
                        "bij de kruising afslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To change direction, usually at a right angle to the current road"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to turn",
                                "target_lang_sense_clarification": "changing direction while driving or walking"
                            },
                            {
                                "target_lang_word": "to turn off",
                                "target_lang_sense_clarification": "leaving a main road for a smaller one"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a446ebaa-9f23-3d61-aa96-bee47866131c",
                    "sense_definition": "iets weigeren aan te nemen of niet op een aanbod ingaan",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "weigeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft het gulle aanbod van zijn baas beleefd <w>afgeslagen</w>.",
                            "target_lang_translations": {
                                "en": "He politely <w>turned down</w> his boss's generous offer."
                            }
                        },
                        {
                            "text": "Ik kon die uitnodiging voor het feestje echt niet <w>afslaan</w>.",
                            "target_lang_translations": {
                                "en": "I really couldn't <w>decline</w> that invitation to the party."
                            }
                        }
                    ],
                    "antonyms": [
                        "aannemen",
                        "accepteren"
                    ],
                    "common_phrases": [
                        "een aanbod afslaan",
                        "een uitnodiging afslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To refuse to accept something or not respond to an offer"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to turn down",
                                "target_lang_sense_clarification": "refusing an offer or invitation"
                            },
                            {
                                "target_lang_word": "to decline",
                                "target_lang_sense_clarification": "politely refusing something"
                            },
                            {
                                "target_lang_word": "to reject",
                                "target_lang_sense_clarification": "dismissing an offer or proposal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77a6c6e9-6b48-34d6-968f-7663919e2c93",
                    "sense_definition": "het plotseling stoppen van een motor of machine",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stoppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De motor is midden op het drukke kruispunt plotseling <w>afgeslagen</w>.",
                            "target_lang_translations": {
                                "en": "The engine suddenly <w>stalled</w> in the middle of the busy intersection."
                            }
                        },
                        {
                            "text": "Als je de koppeling te snel loslaat, zal de auto <w>afslaan</w>.",
                            "target_lang_translations": {
                                "en": "If you release the clutch too quickly, the car will <w>stall</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de motor slaat af"
                    ],
                    "target_lang_definitions": {
                        "en": "The sudden stopping of an engine or machine"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to stall",
                                "target_lang_sense_clarification": "when an engine stops unexpectedly"
                            },
                            {
                                "target_lang_word": "to cut out",
                                "target_lang_sense_clarification": "when a motor suddenly stops working"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aebab2cf-b73f-3047-9496-023a046d3ac6",
                    "sense_definition": "een aanval succesvol tegenhouden of verdrijven",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verdediging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het leger wist de vijandelijke aanval met moeite <w>af te slaan</w>.",
                            "target_lang_translations": {
                                "en": "The army managed to <w>repel</w> the enemy attack with difficulty."
                            }
                        },
                        {
                            "text": "De keeper <w>sloeg</w> de bal krachtig <w>af</w> voordat de spits kon scoren.",
                            "target_lang_translations": {
                                "en": "The goalkeeper <w>parried</w> the ball powerfully before the striker could score."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een aanval afslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To successfully stop or repel an attack"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to repel",
                                "target_lang_sense_clarification": "driving back an attacking force"
                            },
                            {
                                "target_lang_word": "to beat back",
                                "target_lang_sense_clarification": "forcing an enemy to retreat"
                            },
                            {
                                "target_lang_word": "to parry",
                                "target_lang_sense_clarification": "warding off a blow or attack"
                            }
                        ]
                    }
                },
                {
