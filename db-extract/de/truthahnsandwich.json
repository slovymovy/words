                "senses": [
                    {
                        "sense_id": "5c7163e1-5657-31a4-93fb-75c0467b1225",
                        "entry_id": "965c6690-7875-3b73-9596-f2599165ed8a",
                        "glosses": [
                            "mit Truthahnfleisch belegtes Sandwich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad312e84-e654-4411-9efe-c7afe9abe587",
                                "sense_id": "5c7163e1-5657-31a4-93fb-75c0467b1225",
                                "text": "„Shaw nahm sich eine Dose Reifendichtmittel, denn er hatte ja keinen Ersatzreifen mehr, und setzte sich auf einen der Barhocker, um ein Truthahnsandwich und einen großen Becher Kaffee zum Mitnehmen zu bestellen.“"
                            },
                            {
                                "example_id": "ffb99c63-c37e-4351-bf28-e367eb051411",
                                "sense_id": "5c7163e1-5657-31a4-93fb-75c0467b1225",
                                "text": "„Um die Mittagszeit marschierte er in das Örtchen Brady, Virginia, hinein, setzte sich in einen Diner und bestellte sich ein Truthahnsandwich und eine kalorienarme Cola.“"
                            }
                        ],
