{
    "word_family": [
        "tête",
        "entêtement",
        "entêté",
        "entêtant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "73465953-dac3-3fd9-b2d1-c4d2ca18ef06",
                    "sense_definition": "Persister avec obstination dans une décision, une idée ou une attitude.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "obstination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il refuse d'écouter les conseils et s'<w>entête</w> à continuer malgré les risques évidents."
                        },
                        {
                            "text": "Pourquoi t'<w>entêtes</w>-tu à refaire toujours la même erreur sans demander de l'aide ?"
                        }
                    ],
                    "common_phrases": [
                        "s'entêter dans son erreur",
                        "s'entêter à refuser"
                    ]
                },
                {
                    "sense_id": "afe9661e-0b03-39f2-b675-e73e4643d006",
                    "sense_definition": "Étourdir ou causer un mal de tête, en parlant d'un parfum, d'un vin ou d'une forte chaleur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effet_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce parfum aux notes de jasmin est trop fort et m'<w>entête</w> rapidement."
                        },
                        {
                            "text": "Fais attention avec ce vin rouge très lourd car il <w>entête</w> facilement."
                        }
                    ],
                    "synonyms": [
                        "monter à la tête"
                    ],
                    "common_phrases": [
                        "parfum qui entête",
                        "vin qui entête"
                    ]
                },
                {
                    "sense_id": "95157b2d-3034-3c93-84f5-7f9d578d78be",
                    "sense_definition": "Griser l'esprit en donnant une vaine fierté ou des illusions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "effet_moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toutes ces flatteries excessives finissent par <w>entêter</w> le jeune comédien."
                        },
                        {
                            "text": "Les louanges et le succès soudain <w>entêtent</w> ceux qui manquent d'expérience."
                        }
                    ],
                    "common_phrases": [
                        "louanges qui entêtent"
                    ]
                },
                {
                    "sense_id": "f9c60997-59f2-303d-b1bf-1785484b918a",
                    "sense_definition": "Prévenir fortement quelqu'un en faveur d'une personne, d'un projet ou d'une doctrine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "obstination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On l'a tellement <w>entêté</w> de ce nouveau projet qu'il n'envisage rien d'autre."
                        },
                        {
                            "text": "Son discours passionné a réussi à <w>entêter</w> les partisans de son mouvement."
                        }
                    ],
                    "common_phrases": [
                        "entêter quelqu'un d'un projet"
                    ]
                },
                {
                    "sense_id": "7854acac-7407-30d7-823f-5e85a1f5a11e",
                    "sense_definition": "Fixer la tête d'une épingle sur sa tige au cours de la fabrication.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cet atelier traditionnel, l'artisan devait <w>entêter</w> chaque épingle manuellement."
                        },
                        {
                            "text": "La machine permet d'<w>entêter</w> des centaines d'épingles à la minute sans défaut."
                        }
                    ],
                    "common_phrases": [
                        "entêter une épingle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "terme technique d'artisanat ancien"
                        }
                    ]
                }
            ]
        }
    ]
}