                "senses": [
                    {
                        "sense_id": "a6801c49-5ea3-3742-a144-31259b3aaaff",
                        "entry_id": "4e200e80-1bf2-3b68-a94f-096f4b9e5dd7",
                        "glosses": [
                            "Zur Jagd auf, am Bach lebende, Biber und Otter abgerichtete Hunde. Es wurden kleine, starke Dachshunde verwendet, aber auch größere Hühnerhunde und (langhaarige) Wasserhunde."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "2904132a-bdca-4f7d-bbd2-5a39d77ef4d8",
                                "sense_id": "a6801c49-5ea3-3742-a144-31259b3aaaff",
                                "text": "Bachhund, ein kleiner dachsartiger, zur Biber- und Fischotterjagd abgerichteter Hund."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "20328825-45e3-36d6-84f5-d1ba18c64b82",
                        "entry_id": "4e200e80-1bf2-3b68-a94f-096f4b9e5dd7",
                        "glosses": [
                            "Sagengestalt, die in der Nähe der luxemburgischen Gemeinde Sandweiler hausen soll."
                        ],
                        "tags": [
                            "fiktional"
                        ],
                        "examples": [
                            {
                                "example_id": "310d3e34-97a8-4053-9608-9ec134368cd0",
                                "sense_id": "20328825-45e3-36d6-84f5-d1ba18c64b82",
                                "text": "[…] denn in diesem Moore haust der Bachhund, ein böser, tückischer Geist, der dahin verwünscht worden ist und des Nachts in Gestalt eines großen, schwarzen Hundes auf den Höhen von Stöckelts umgeht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
