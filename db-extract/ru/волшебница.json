                    {
                        "translation_id": "5eabc4aa-9869-42c9-a10d-e7f02285e2cc",
                        "source_entry_id": "2e2084ef-c4c5-36aa-a531-9cf6f038bbee",
                        "source_sense_id": "a0aa8577-7f2a-3939-b2e4-3b797d4835c9",
                        "target_lang_word": "enchantress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enchantress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1dd5e579-9321-3dc6-9561-f8a3dfd944a9",
                                        "entry_id": "cf9058ec-6892-3cdd-9946-31934c3aa7ec",
                                        "glosses": [
                                            "A woman, especially an attractive one, skilled at using magic; an alluring witch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5324d610-cb61-42e8-bbf3-b462719456f7",
                                                "sense_id": "1dd5e579-9321-3dc6-9561-f8a3dfd944a9",
                                                "text": "Him fortuned (hard fortune ye may gheſſe)\n To come, where vile Acraſia does wonne [live],\n Acraſia a falſe enchauntereſſe,\n That many errant knightes hath fowle fordonne: […]"
                                            },
                                            {
                                                "example_id": "ccf9d290-bf4f-4522-8e04-a34fd9e39cb0",
                                                "sense_id": "1dd5e579-9321-3dc6-9561-f8a3dfd944a9",
                                                "text": "The tablets upon which the events of the day were recorded refer to enchantresses, and we can conclude that they were by no means restricted to ancient beldames."
                                            },
                                            {
                                                "example_id": "405f5f65-840c-417f-9d3b-d157f22341d0",
                                                "sense_id": "1dd5e579-9321-3dc6-9561-f8a3dfd944a9",
                                                "text": "For even the enchantresses Circe and Medea could not, by their black arts, prevent the unfaithfulness of Odysseus and Jason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afcfc152-490a-3d22-9838-bdfb229e43f6",
                                        "entry_id": "cf9058ec-6892-3cdd-9946-31934c3aa7ec",
                                        "glosses": [
                                            "A beautiful, charming and irresistible woman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0069e96e-4e08-484d-bef3-a0a77a2bd8c7",
                                                "sense_id": "afcfc152-490a-3d22-9838-bdfb229e43f6",
                                                "text": "She was the enchantress of men’s hearts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "244448dc-56aa-3284-94ff-b484963cfb74",
                                        "entry_id": "cf9058ec-6892-3cdd-9946-31934c3aa7ec",
                                        "glosses": [
                                            "A femme fatale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae8b7ff-4497-42cc-af2b-518df2ffb92b",
                                                "sense_id": "244448dc-56aa-3284-94ff-b484963cfb74",
                                                "text": "His desire for that enchantress led him to financial ruin."
                                            }
                                        ]
                                    }
                                ]
                            }
