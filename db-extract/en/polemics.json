                "word": "polemics",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a51f288b-1470-391a-926c-0ab998d43101",
                        "entry_id": "bf2974a6-4418-3335-bc85-86d340562eb6",
                        "glosses": [
                            "The art or practice of making arguments or controversies."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2c85cb2b-3ffc-3ed2-99af-f711abd29727",
                        "entry_id": "bf2974a6-4418-3335-bc85-86d340562eb6",
                        "glosses": [
                            "The refutation of errors in theological doctrine."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b2467cc-f83a-4892-9ad9-8c2b3c82626a",
                        "source_entry_id": "bf2974a6-4418-3335-bc85-86d340562eb6",
                        "source_sense_description": "art or practice of making arguments or controversies",
                        "target_lang_word": "Polemik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polemik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8269c177-4a60-370e-b1f7-0610f631c07b",
                                        "entry_id": "b918c727-edc0-3e80-b048-d7203cced1f6",
                                        "glosses": [
                                            "öffentlicher, meist scharfer Meinungsstreit im Rahmen politischer, literarischer, gesellschaftlicher, religiöser oder wissenschaftlicher Diskussionen, der neben der sachlichen Widerlegung zugleich auch die moralische Demaskierung des Diskussionsgegners bezweckt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bc9d79f-7e0b-4a31-a376-2d6a2e2d863c",
                                                "sense_id": "8269c177-4a60-370e-b1f7-0610f631c07b",
                                                "text": "Diese Polemik der Berufsagitatoren wird ihm langsam zuwider."
                                            },
                                            {
                                                "example_id": "0b8a4ef4-783c-4364-a5c2-5a2a410b92ea",
                                                "sense_id": "8269c177-4a60-370e-b1f7-0610f631c07b",
                                                "text": "„Dennoch muß verwundern, wie selbst angesehene, sonst meisterlich schreibende Autoren in ihren Sprachkritikastereien gelegentlich zu offenem Grobianismus oder hitziger Polemik neigen.“"
                                            },
                                            {
                                                "example_id": "0a79f244-d2f3-46f5-a9ca-d031898fbd4f",
                                                "sense_id": "8269c177-4a60-370e-b1f7-0610f631c07b",
                                                "text": "„Hier, im Raum der kritischen Absicherung des Systems, ist die Polemik mit der Theologie noch latent.“"
                                            },
                                            {
                                                "example_id": "3c997c5d-ddce-4169-833b-ca315112734e",
                                                "sense_id": "8269c177-4a60-370e-b1f7-0610f631c07b",
                                                "text": "„Dass nicht zuletzt Wielands Shakespeare-Übersetzungen einer der wichtigsten Schritte zur Modernisierung der deutschen Sprache waren, macht Friedrichs Polemik so interessant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dab81bbf-ab39-379e-9693-a2364a97ca72",
                                        "entry_id": "b918c727-edc0-3e80-b048-d7203cced1f6",
                                        "glosses": [
                                            "unsachlicher Angriff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f43fedb9-f6ff-42c7-812f-970fb4707567",
                                                "sense_id": "dab81bbf-ab39-379e-9693-a2364a97ca72",
                                                "text": "In Polemik zu verfallen hilft dir jetzt auch nicht weiter."
                                            },
                                            {
                                                "example_id": "bc7d34e3-5527-4746-a221-bda175af8a87",
                                                "sense_id": "dab81bbf-ab39-379e-9693-a2364a97ca72",
                                                "text": "„Man hat Busch immer wieder einer boshaften Polemik beschuldigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
