                                    {
                                        "sense_id": "82de0494-74b4-3f9c-9f40-2b4dfe5f175c",
                                        "entry_id": "3fe4eddd-d0d3-334e-85d4-ae3d90d1e0a6",
                                        "glosses": [
                                            "In a sensational manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6682221c-1dc1-310e-bd96-d29078f01da6",
                                        "entry_id": "3fe4eddd-d0d3-334e-85d4-ae3d90d1e0a6",
                                        "glosses": [
                                            "To a sensational extent; amazingly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30feb2ab-59d5-40a8-828d-df0c92a776ba",
                                                "sense_id": "6682221c-1dc1-310e-bd96-d29078f01da6",
                                                "text": "\"Yes,\" said Slartibartfast, \"staggeringly dull. Bewilderingly so. [...] Would you like me to quote you some statistics?\" \"Er, well...\" \"Please, I would like to. They, too, are quite sensationally dull.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c2f6fc9-89cd-464f-a205-424cc15b9fe9",
                        "source_entry_id": "041ae16f-efdc-3f15-9538-576059658294",
                        "target_lang_word": "strikingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strikingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b90566f4-a443-3ed2-97c1-7af705128aee",
                                        "entry_id": "398edab8-1b74-3f79-bffc-3eea5fe9d9e0",
                                        "glosses": [
                                            "In a striking way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3104fb2c-0ce9-42e2-b146-5344837d7867",
                                                "sense_id": "b90566f4-a443-3ed2-97c1-7af705128aee",
                                                "text": "He entered strikingly, taking over the stage."
                                            },
                                            {
                                                "example_id": "34a7baf8-8b5f-4c7d-a460-14de714bfeeb",
                                                "sense_id": "b90566f4-a443-3ed2-97c1-7af705128aee",
                                                "text": "Fully air-conditioned and fluorescently lit, it is strikingly decorated and there is a magnificent outlook through the wide windows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcc2d99d-27ea-35e8-8843-2e1da345c264",
                                        "entry_id": "398edab8-1b74-3f79-bffc-3eea5fe9d9e0",
                                        "glosses": [
                                            "To a remarkable degree or extent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9dc6a76-9a91-4f01-b1ea-6d7b61b38c78",
                                                "sense_id": "bcc2d99d-27ea-35e8-8843-2e1da345c264",
                                                "text": "He was strikingly deficient in good sense."
                                            },
                                            {
                                                "example_id": "d0285495-5fbf-4e81-814b-276d58baecb5",
                                                "sense_id": "bcc2d99d-27ea-35e8-8843-2e1da345c264",
                                                "text": "Each mate nursed his fellow, and some strikingly pathetic touches of devotion were shown here and there amongst them."
                                            },
                                            {
                                                "example_id": "68994cb3-a53f-4ea8-bddd-d2de5f56bf26",
                                                "sense_id": "bcc2d99d-27ea-35e8-8843-2e1da345c264",
                                                "text": "Patterns of evolution in the two families, however, are strikingly different."
                                            },
                                            {
                                                "example_id": "0595fe38-6ea2-4028-92e6-19452f320778",
                                                "sense_id": "bcc2d99d-27ea-35e8-8843-2e1da345c264",
                                                "text": "Warwick's first glance had revealed the fact that the young woman was strikingly handsome, with a stately beauty seldom encountered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9adc859-94b5-3702-b72a-fc6fe4bf8247",
                                        "entry_id": "398edab8-1b74-3f79-bffc-3eea5fe9d9e0",
                                        "glosses": [
                                            "Remarkably, surprisingly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13102f89-eefd-4700-8482-c0c9d9311368",
                                                "sense_id": "e9adc859-94b5-3702-b72a-fc6fe4bf8247",
                                                "text": "Strikingly, he had bowed deeply to the Emperor."
                                            },
                                            {
                                                "example_id": "37a959f9-cb26-439f-a8b2-43c076e651f3",
                                                "sense_id": "e9adc859-94b5-3702-b72a-fc6fe4bf8247",
                                                "text": "Then, they looked up which lawyers in these various lawsuits won their cases, and those who didn’t. Most strikingly, the researchers found that if the legal teams more closely mirrored a judge’s preferred writing style in documents such as past legal opinions, their chances of winning could more than double."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
