                        "pl": [
                            {
                                "target_lang_word": "pisać",
                                "target_lang_sense_clarification": "tworzyć dzieło literackie"
                            },
                            {
                                "target_lang_word": "napisać",
                                "target_lang_sense_clarification": "ukończyć pisanie utworu"
