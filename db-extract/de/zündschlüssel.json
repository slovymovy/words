                "senses": [
                    {
                        "sense_id": "8d79dded-afd4-3747-bb42-a9104c2ea3e7",
                        "entry_id": "c00db1a4-b666-327c-9b84-3024bb48b557",
                        "glosses": [
                            "Schlüssel, mit dem man einen Motor starten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "430e8fe3-3091-4f1a-9d32-7ae4fa483378",
                                "sense_id": "8d79dded-afd4-3747-bb42-a9104c2ea3e7",
                                "text": "„Hastig dreht sie den Zündschlüssel.“"
                            },
                            {
                                "example_id": "2d6d3e36-f111-4e06-8bb5-fb016b8340dd",
                                "sense_id": "8d79dded-afd4-3747-bb42-a9104c2ea3e7",
                                "text": "„Ich wachte erst wieder auf, als Papa den Zündschlüssel abzog.“"
                            },
                            {
                                "example_id": "05c08e28-f6e8-4213-baac-e919ad2897c1",
                                "sense_id": "8d79dded-afd4-3747-bb42-a9104c2ea3e7",
                                "text": "„Val drehte den Zündschlüssel im Schloss.“"
                            },
                            {
                                "example_id": "347ff106-a4c7-4b40-bfe4-580d7e065389",
                                "sense_id": "8d79dded-afd4-3747-bb42-a9104c2ea3e7",
                                "text": "„Er schiebt den Zündschlüssel hinein und läßt den Motor an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
