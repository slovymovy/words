                        "cross_references": [
                            {
                                "target_word": "Zechgelage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f8f2757-cfed-34f6-abcf-3178bb3aa06f",
                                        "entry_id": "e00b8c77-68e2-3d5b-919e-a2798838a28e",
                                        "glosses": [
                                            "Veranstaltung oder Zusammenkunft, bei der exzessiv Alkohol konsumiert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e5dc681-4bbf-4cdb-9680-89586ee6adbe",
                                                "sense_id": "5f8f2757-cfed-34f6-abcf-3178bb3aa06f",
                                                "text": "„Häufig liessen sie Balaga an ihren Zechgelagen teilnehmen, liessen ihn bei den Zigeunern mit ihnen selbst trinken und tanzen und hatten manchen Tausender durch seine Hände gehen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
