                "senses": [
                    {
                        "sense_id": "b794b1cd-4336-3800-8828-4f9ccdfcb414",
                        "entry_id": "d00ddac1-7998-3466-adc8-862e6c22575c",
                        "glosses": [
                            "Expedition nach China"
