                                "tr": "Kayıp belgeler <w>şans eseri</w> bir çekmecede bulundu.",
                                "zh": "<w>好在</w>丢失的文件在抽屉里被找到了。",
                                "pl": "Zaginione dokumenty <w>szczęśliwie</w> odnalazły się w szufladzie.",
                                "nl": "De vermiste documenten werden <w>gelukkig</w> teruggevonden in een lade.",
                                "de": "Die fehlenden Dokumente fanden sich <w>glücklicherweise</w> in einer Schublade wieder.",
                                "fr": "Les documents manquants ont <w>heureusement</w> été retrouvés dans un tiroir.",
                                "it": "I documenti mancanti sono stati <w>fortunatamente</w> ritrovati in un cassetto.",
                                "cs": "Ztracené dokumenty se <w>naštěstí</w> našly v šuplíku.",
                                "es": "Los documentos perdidos fueron <w>afortunadamente</w> encontrados en un cajón."
                            }
                        }
