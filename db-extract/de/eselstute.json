                                                "example_id": "3d614c5c-3afe-4f5d-85b3-cebfe36b05cc",
                                                "sense_id": "30442600-cf2d-3f4e-8a1c-f500bab35339",
                                                "text": "En longeant le faîte des murailles épaisses qui entourent la ville, de la terrasse où croît la jusquiame blanche, je vois des ânesses paisibles couchées sur la paille chaude, les troupeaux serrés que ramènent les pasteurs et les fours flambants où les ménagères apprêtent le repas du soir."
                                            },
                                            {
                                                "example_id": "b04ea8d4-e5e0-4585-ac8f-5943b2dc5d41",
                                                "sense_id": "30442600-cf2d-3f4e-8a1c-f500bab35339",
                                                "text": "Sitôt levé, Balaam sella son ânesse et partit avec les princes de Moab."
                                            },
                                            {
                                                "example_id": "cef8d3c0-7020-4132-9dc9-680eed494d07",
                                                "sense_id": "30442600-cf2d-3f4e-8a1c-f500bab35339",
                                                "text": "Lait d’ânesse."
                                            }
