                "senses": [
                    {
                        "sense_id": "8880ee40-a08c-387a-9152-26cf74281e49",
                        "entry_id": "3591fc3e-6792-340e-91f7-77063d10f1c5",
                        "glosses": [
                            "Schachtel aus Karton, in der Milch aufbewahrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79e0b494-b309-4449-8b23-c0b3f341c5c1",
                                "sense_id": "8880ee40-a08c-387a-9152-26cf74281e49",
                                "text": "„Während ich die Milchkartons mit Talg fülle, stellt Tyler sie in den Kühlschrank.“"
                            },
                            {
                                "example_id": "a690a50c-a5c1-42fd-9ec8-08e55990ad6f",
                                "sense_id": "8880ee40-a08c-387a-9152-26cf74281e49",
                                "text": "„Er öffnet einen Milchkarton auf dem Boden und legt Stufen frei, die nach unten in die Dunkelheit führen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
