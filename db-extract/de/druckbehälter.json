                    },
                    {
                        "form_id": "2366e2ab-225f-408f-bcfb-f1339111da93",
                        "entry_id": "8232a027-1005-353a-bf81-9908bb18a5ca",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Druckbehälter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b987cc83-d7ff-3e3a-aa71-cde2ab533339",
                        "entry_id": "8232a027-1005-353a-bf81-9908bb18a5ca",
                        "glosses": [
                            "geschlossenes Behältnis/Gefäß mit erhöhtem Innendruck für Gase oder Flüssigkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05371860-3592-4fce-a873-dac2c4ce9569",
                                "sense_id": "b987cc83-d7ff-3e3a-aa71-cde2ab533339",
                                "text": "„Jeder Druckbehälter muss für sich von den Druckzuleitungen abgesperrt werden können.“"
                            },
                            {
                                "example_id": "a79cf421-ff0d-4e64-8bc0-399b6fae162e",
                                "sense_id": "b987cc83-d7ff-3e3a-aa71-cde2ab533339",
                                "text": "„Druckbehälter sind einzigartige Strukturen, die typischerweise einen Innendruck haben, der in einer hüllenartigen Struktur herrscht und sich vom Außendruck unterscheidet (dem Umgebungsdruck).“"
                            },
                            {
                                "example_id": "6fc2c091-7cba-4632-9c03-510c848d2c31",
                                "sense_id": "b987cc83-d7ff-3e3a-aa71-cde2ab533339",
                                "text": "„Bei dezentraler stationärer Speicherung empfehlen sich Druckbehälter wie bei der Speicherung von Erdgas.“"
                            },
                            {
                                "example_id": "8aab82eb-2b88-4ca6-8afa-d3be9f4697e7",
                                "sense_id": "b987cc83-d7ff-3e3a-aa71-cde2ab533339",
                                "text": "„Ein Druckbehälter ist ein geschlossenes Bauteil, das zur Aufnahme von unter Druck stehenden Fluiden (Gase, Dämpfe und Flüssigkeiten) ausgelegt und gebaut ist.“"
                            },
                            {
                                "example_id": "14b864a2-2867-44c7-bc93-cd61eb4b3043",
                                "sense_id": "b987cc83-d7ff-3e3a-aa71-cde2ab533339",
                                "text": "„Sie waren zugleich Speicher und Druckbehälter, um das Gas in die vorwiegend städtischen Leitungen zu pumpen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
