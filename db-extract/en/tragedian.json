                                                "sense_id": "1bb82ffb-04d6-392a-98e7-0e084d8f059d",
                                                "text": "Sie ist eine begnadete Tragödin und auf allen Theaterbühnen sehr gefragt."
                                            },
                                            {
                                                "example_id": "787c4792-1f37-47ef-b345-a2536b6cc983",
                                                "sense_id": "1bb82ffb-04d6-392a-98e7-0e084d8f059d",
                                                "text": "Durch die Erkrankung unserer Tragödin und ihrer Zweitbesetzung muss die Vorstellung heute ausfallen."
                                            },
                                            {
                                                "example_id": "2b4acc65-677e-4695-a9f5-9a29c21e60fc",
                                                "sense_id": "1bb82ffb-04d6-392a-98e7-0e084d8f059d",
                                                "text": "„Sie ging mit der schwerfälligen Majestät einer großen Tragödin, die über die Bühne schreitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
