                        "sense_id": "cc220702-8f15-30fe-ba13-542bb5c3b158",
                        "entry_id": "dd4872c1-239c-3152-b214-fed3c7c66c53",
                        "glosses": [
                            "Bénéficiaire du RMI (revenu minimum d’insertion)."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "6b222b45-6d4c-424b-8b31-9eb69dc1451d",
                                "sense_id": "cc220702-8f15-30fe-ba13-542bb5c3b158",
                                "text": "Quant aux RMistes, l’ajustement à la baisse du chômage se ferait toujours avec un ou deux trimestres de retard."
                            },
                            {
                                "example_id": "a2797445-499b-41a3-a233-d121c2b33a8e",
                                "sense_id": "cc220702-8f15-30fe-ba13-542bb5c3b158",
                                "text": "C'est ce qui explique l’apparition de travailleurs pauvres, que l’on s’apprête à cantonner dans le RSA aux côtés des Rmistes."
                            }
                        ]
                    }
                ],
