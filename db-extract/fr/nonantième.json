                "senses": [
                    {
                        "sense_id": "24851eee-e6b6-3f53-90cc-0c46f71a6f04",
                        "entry_id": "d2c39da5-8ed3-360b-9ccb-fcc4e0a1b797",
                        "glosses": [
                            "neunzigste"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e7a9803-56f7-40eb-b5a6-15cb7efbadff",
                        "source_entry_id": "d2c39da5-8ed3-360b-9ccb-fcc4e0a1b797",
                        "source_sense_id": "24851eee-e6b6-3f53-90cc-0c46f71a6f04",
                        "source_sense_description": "neunzigste",
                        "target_lang_word": "neunzigste",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neunzigste",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3fcf2d9c-73f7-37d9-a720-6a69926e90df",
                                        "entry_id": "8e2c8741-e1cf-3205-8ad2-51f8585e98dc",
                                        "glosses": [
                                            "nach dem oder der neunundachtzigsten kommend; in einer Reihenfolge an Stelle neunzig"
                                        ],
                                        "tags": [
                                            "Ordnungszahl"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4389119d-ae22-482a-ae16-22f9cf1a0201",
                                                "sense_id": "3fcf2d9c-73f7-37d9-a720-6a69926e90df",
                                                "text": "„Als akute Nebenwirkungen gelten solche, die zwischen dem ersten und dem neunzigsten Tag auftreten.“"
                                            },
                                            {
                                                "example_id": "33d40b5e-d1cc-48c1-97cd-bf7529a81b93",
                                                "sense_id": "3fcf2d9c-73f7-37d9-a720-6a69926e90df",
                                                "text": "„Die Darlehen, die ihm die Mendelssohns gewährten, belasteten zunehmend sein Gewissen, da er trotz härtester Arbeit bis ins neunzigste Jahr keine Aussichten restloser Zurückzahlung sah.“"
                                            },
                                            {
                                                "example_id": "90fd06af-22e7-44d2-b012-e425a9534c63",
                                                "sense_id": "3fcf2d9c-73f7-37d9-a720-6a69926e90df",
                                                "text": "„Ihr durfte der Biograph ihres Großvaters zu ihrem neunzigsten Geburtstag den dritten Band seines Werkes widmen.“"
                                            },
                                            {
                                                "example_id": "cbdcfa4f-5f2f-40bb-89c7-6b7f652d1157",
                                                "sense_id": "3fcf2d9c-73f7-37d9-a720-6a69926e90df",
                                                "text": "„Hieronymus hatte an einer der Zusammenkünfte auf dem Aventin den neunzigsten Psalm gelesen.“"
                                            },
                                            {
                                                "example_id": "1786a108-3f62-4aca-a2ff-5674716a1646",
                                                "sense_id": "3fcf2d9c-73f7-37d9-a720-6a69926e90df",
                                                "text": "„Am neunzigsten Tag versprach die Lageradministration, ihre Forderungen zu erfüllen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
