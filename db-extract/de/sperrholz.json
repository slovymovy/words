                        "sense_id": "616ca50f-fb50-36aa-88c0-8b45e60ac947",
                        "entry_id": "bf4f8f5f-4de0-3d86-8683-a46691cb2d58",
                        "glosses": [
                            "Holzplatte aus mehreren miteinander verleimten Holzschichten verschiedener Faserrichtung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21baee69-0532-46c9-b874-2caaf7d1cc87",
                                "sense_id": "616ca50f-fb50-36aa-88c0-8b45e60ac947",
                                "text": "„Volker schraubte die Rückwand ab, die aus Sperrholz war.“"
                            },
                            {
                                "example_id": "98898cb8-b63d-4234-9dc4-904a289a2b58",
                                "sense_id": "616ca50f-fb50-36aa-88c0-8b45e60ac947",
                                "text": "„Nachdem die Wohnung mit Planen und Sperrholz halbwegs bewohnbar gemacht war, setzte Hurrikan Delta ihr Zuhause sechs Wochen später komplett unter Wasser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
