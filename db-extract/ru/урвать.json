                    }
                ],
                "translations": [
                    {
                        "translation_id": "c04b6024-c787-4dd9-ba76-2fa4d98f366f",
                        "source_entry_id": "e532c796-13f0-3387-808c-747b59a76fb2",
                        "source_sense_description": "быстрым и внезапным движением оторвать, захватить, вырвать для себя часть чего-либо",
                        "target_lang_word": "snatch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snatch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b99b0714-5cfc-3335-a4b3-19df57abe85f",
                                        "entry_id": "1711ec6d-f736-3098-a200-fdb46d27b48f",
                                        "glosses": [
                                            "To grasp and remove quickly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea68004f-fd79-4559-8a18-9428d69d2878",
                                                "sense_id": "b99b0714-5cfc-3335-a4b3-19df57abe85f",
                                                "text": "He snatched up the phone."
                                            },
                                            {
                                                "example_id": "d273c657-bd39-4572-b210-3ae2f5b6cc15",
                                                "sense_id": "b99b0714-5cfc-3335-a4b3-19df57abe85f",
                                                "text": "She snatched the letter out of the secretary's hand."
                                            },
                                            {
                                                "example_id": "91565a14-de2b-48fe-b31a-b5cb82577ce2",
                                                "sense_id": "b99b0714-5cfc-3335-a4b3-19df57abe85f",
                                                "text": "Snatch me to heaven."
                                            },
                                            {
                                                "example_id": "3bee85f0-11c1-4841-b333-c692ff86e97a",
                                                "sense_id": "b99b0714-5cfc-3335-a4b3-19df57abe85f",
                                                "text": "\"How many times have I told you?\" she cried, and seized him and snatched his stick away from him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "924ffbac-e225-3d91-a643-1a7feb6322a2",
                                        "entry_id": "1711ec6d-f736-3098-a200-fdb46d27b48f",
                                        "glosses": [
                                            "To attempt to seize something suddenly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a25e3b4e-eda1-408e-9165-35136905e008",
                                                "sense_id": "924ffbac-e225-3d91-a643-1a7feb6322a2",
                                                "text": "to snatch at a rope"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3302bcff-5e04-3724-8466-216588e17045",
                                        "entry_id": "1711ec6d-f736-3098-a200-fdb46d27b48f",
                                        "glosses": [
                                            "To take or seize hastily, abruptly, or without permission or ceremony."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7c97da8-4c68-4769-84bf-de8a5db934fc",
                                                "sense_id": "3302bcff-5e04-3724-8466-216588e17045",
                                                "text": "to snatch a kiss"
                                            },
                                            {
                                                "example_id": "d357fb58-ca11-49db-a2b4-76d58d9ccf1a",
                                                "sense_id": "3302bcff-5e04-3724-8466-216588e17045",
                                                "text": "1731-1735, Alexander Pope, Moral Essays\nwhen half our knowledge we must snatch, not take"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc3aa120-d8a9-3433-afb2-14f4021849a9",
                                        "entry_id": "1711ec6d-f736-3098-a200-fdb46d27b48f",
                                        "glosses": [
                                            "To steal."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17e20298-0f3c-49da-9b69-6504591f796e",
                                                "sense_id": "fc3aa120-d8a9-3433-afb2-14f4021849a9",
                                                "text": "Someone has just snatched my purse!"
                                            },
                                            {
                                                "example_id": "0c8c26f6-7db2-4469-8ece-c12fc74ed1d4",
                                                "sense_id": "fc3aa120-d8a9-3433-afb2-14f4021849a9",
                                                "text": "Laura snatches coins from inside a truck to make a telephone call, scrounges shoes and clothes for them at a municipal beach, schemes to get a room key so she and Howie can sleep overnight in the Starlight Motel, steals a Jeepster from a deputy sheriff who's trying to arrest them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dde3d4dc-f2b4-3b88-b3d0-d79d20b40e19",
                                        "entry_id": "1711ec6d-f736-3098-a200-fdb46d27b48f",
                                        "glosses": [
                                            "To take (a victory) at the last moment."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58bd0aee-3e39-4a8d-abeb-46d548df2e55",
                                                "sense_id": "dde3d4dc-f2b4-3b88-b3d0-d79d20b40e19",
                                                "text": "But, with United fans in celebratory mood as it appeared their team might snatch glory, they faced an anxious wait as City equalised in stoppage time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c81462af-e540-3868-bc1c-8cca9827bcd5",
                                        "entry_id": "1711ec6d-f736-3098-a200-fdb46d27b48f",
                                        "glosses": [
                                            "To do something quickly in the limited time available."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8435080b-aad2-4ade-819c-b08c520a7221",
                                                "sense_id": "c81462af-e540-3868-bc1c-8cca9827bcd5",
                                                "text": "He snatched a sandwich before catching the train."
                                            },
                                            {
                                                "example_id": "03d8f2be-50f6-4072-90ee-cb71f96c61e4",
                                                "sense_id": "c81462af-e540-3868-bc1c-8cca9827bcd5",
                                                "text": "He snatched a glimpse of her while her mother had her back turned."
                                            },
                                            {
                                                "example_id": "9cc6b331-68dc-456e-85c5-bb1a84f0a394",
                                                "sense_id": "c81462af-e540-3868-bc1c-8cca9827bcd5",
                                                "text": "It was a joy to snatch some brief respite, and find himself in the rectory drawing–room. Listening here was as pleasant as talking; just to watch was pleasant. The young priests who lived here wore cassocks and birettas; their faces were fine and mild, yet really strong, like the rector's face; and in their intercourse with him and his wife they seemed to be brothers."
                                            },
                                            {
                                                "example_id": "6f575a6b-53e8-43d0-b62b-079779046204",
                                                "sense_id": "c81462af-e540-3868-bc1c-8cca9827bcd5",
                                                "text": "No department of the Southern Railway escaped some share of the work involved, and the outdoor traffic and locomotive staffs in particular were engaged literally night and day, snatching a few hours' sleep as opportunity offered, until the task was completed."
                                            },
                                            {
                                                "example_id": "3b417ede-5830-4778-98bf-c15c5993f750",
                                                "sense_id": "c81462af-e540-3868-bc1c-8cca9827bcd5",
                                                "text": "You might now reason that even a 12-minute walk to the store to buy a can of beans is too great an expenditure of time, and that the fee paid for one-hour delivery is a fair price to snatch those minutes back into your life."
                                            },
                                            {
                                                "example_id": "0ec328a4-0ab0-41d3-bcff-d15745c3b308",
                                                "sense_id": "c81462af-e540-3868-bc1c-8cca9827bcd5",
                                                "text": "In 1914, the Hendon and Finchley Times published a piece titled 'People who have no Christmas'. An engine-driver's comment was this: \"For many years now I have never enjoyed a real Christmas. My engine has claimed me on this day, and my only regret is that I am not attached to a slow goods train, so that I could snatch time to eat some plum-pudding.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "snatch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cd79168-3533-31af-8b41-49b97f2ae37c",
                                        "entry_id": "cffc0164-bf3d-3f46-8eb2-69d170eb73fe",
                                        "glosses": [
                                            "A quick grab or catch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f98ddc52-be1c-4c9f-8015-d57f10e83d7e",
                                                "sense_id": "1cd79168-3533-31af-8b41-49b97f2ae37c",
                                                "text": "The leftfielder makes a nice snatch to end the inning."
                                            },
                                            {
                                                "example_id": "162eb644-cc75-4834-8f9e-bf8678fb22e8",
                                                "sense_id": "1cd79168-3533-31af-8b41-49b97f2ae37c",
                                                "text": "And he […] glared on the cold pistols that hung before him—ready for anything. And he took down one with a snatch and weighed it in his hand, and fell to thinking again; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04c554d4-a73a-3575-81e1-ec0a7868a080",
                                        "entry_id": "cffc0164-bf3d-3f46-8eb2-69d170eb73fe",
                                        "glosses": [
                                            "A short period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "830ea971-7dff-40ad-891d-4ebedb709718",
                                                "sense_id": "04c554d4-a73a-3575-81e1-ec0a7868a080",
                                                "text": "Frank looked at the screens dully. He had slept about three hours, in snatches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab5e82c4-644b-3525-84c5-2354ddd419ab",
                                        "entry_id": "cffc0164-bf3d-3f46-8eb2-69d170eb73fe",
                                        "glosses": [
                                            "A competitive weightlifting event in which a barbell is lifted from the platform to locked arms overhead in a smooth continuous movement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bcd14018-afa4-3da0-baac-6e185d3e33e3",
                                        "entry_id": "cffc0164-bf3d-3f46-8eb2-69d170eb73fe",
                                        "glosses": [
                                            "A piece of some sound, usually music or conversation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e524df51-ab67-4978-abf1-130f5e96d692",
                                                "sense_id": "bcd14018-afa4-3da0-baac-6e185d3e33e3",
                                                "text": "I heard a snatch of Mozart as I passed the open window."
                                            },
                                            {
                                                "example_id": "9510ec44-5270-40b6-b067-73440ad84a33",
                                                "sense_id": "bcd14018-afa4-3da0-baac-6e185d3e33e3",
                                                "text": "But, purgatory as the place would appear, the stranger advances into it; and, like Orpheus in his gay descent to Tartarus, lightly hums to himself an opera snatch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58a00272-0f65-301f-8fa3-9b8af0250500",
                                        "entry_id": "cffc0164-bf3d-3f46-8eb2-69d170eb73fe",
                                        "glosses": [
                                            "The vulva."
                                        ],
                                        "tags": [
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f788c31-58bc-4f77-975f-3c545cd64f06",
                                                "sense_id": "58a00272-0f65-301f-8fa3-9b8af0250500",
                                                "text": "Dan: Hey, Ani, I found my keys! They were in my pocket.\nAni: That's great, Dan! Of course, I've never lost mine.\nDan: Really? Where do you keep yours?\nAni: In my snatch!"
                                            },
                                            {
                                                "example_id": "5156cd6b-cd6b-4dc0-8693-369fce1fc301",
                                                "sense_id": "58a00272-0f65-301f-8fa3-9b8af0250500",
                                                "text": "Claude, is it true what they say about Olovia? Of course she’s getting a little old for us—what about Marilyum, did you try her snatch?"
                                            },
                                            {
                                                "example_id": "afb46cc2-a563-4ab5-ba4a-485f5da94e95",
                                                "sense_id": "58a00272-0f65-301f-8fa3-9b8af0250500",
                                                "text": "Roughly Santino ripped the sheet from the bed, exposing all of her. She had blond hair on her snatch, which drove him crazy. He was partial to blondes."
                                            },
                                            {
                                                "example_id": "3ef4ae6c-368f-4a54-8209-85653a2ee17a",
                                                "sense_id": "58a00272-0f65-301f-8fa3-9b8af0250500",
                                                "text": "“[…]You want me to ask Brandy to let you paint her naked body with all this gooey stuff to make a mold of her snatch?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60458a6b-215b-3f86-a588-bced4af874bd",
                                        "entry_id": "cffc0164-bf3d-3f46-8eb2-69d170eb73fe",
                                        "glosses": [
                                            "Rapid, uncommanded jerking or oscillation of the ailerons of some aircraft at high Mach numbers, resulting from shock wave formation at transonic speeds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bb9e894-13ed-4d4d-95f3-3b1666ed6409",
                                                "sense_id": "60458a6b-215b-3f86-a588-bced4af874bd",
                                                "text": "If, after the pilot notices the overspeed, he deploys the spoilers, or if aileron \"snatch\" rolls the airplane to an excessive bank angle, it may become impossible to recover."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2408f9b2-194d-3cd7-a631-bd0f5848f0a5",
                                        "entry_id": "cffc0164-bf3d-3f46-8eb2-69d170eb73fe",
                                        "glosses": [
                                            "A brief period of exertion."
                                        ],
