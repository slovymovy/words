                                "example_id": "cc27e649-3e1a-467f-bf54-8c89a744efe0",
                                "sense_id": "faeeaf7d-9856-3069-88a4-5513cd3df421",
                                "text": "„Noch märchenhafter als alle Schlösser und Kosakendörfer Potsdams erschienen mir jedoch die Filmstudios in Babelsberg, Deutschlands größte Traumfabrik.“"
                            }
