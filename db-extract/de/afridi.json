                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b3aef75-63ad-4353-886c-98df27794ad1",
                                                "sense_id": "9557e8a0-0b37-3f84-b5ab-6a194d30ffac",
                                                "text": "A certain Afridi being desirous to learn to read, went into a village to a Mulla and said to him, that it would be a great favour if he would give him lessons."
