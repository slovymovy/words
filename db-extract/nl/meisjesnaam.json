                "senses": [
                    {
                        "sense_id": "d2dc9a11-6c69-3974-aebf-aaef43d9fc8a",
                        "entry_id": "44113324-9842-340e-908f-4795d95e48d2",
                        "glosses": [
                            "voornaam die doorgaans gegeven wordt aan kinderen van het vrouwelijk geslacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73cef526-7da6-4cdf-ba46-9978c2dab0b2",
                                "sense_id": "d2dc9a11-6c69-3974-aebf-aaef43d9fc8a",
                                "text": "Sinds zij weet dat haar zus een dochtertje krijgt probeert ze leuke meisjesnamen te bedenken."
                            }
                        ]
                    },
                    {
                        "sense_id": "e67f742f-bec3-3e0c-a38a-96994faf5368",
                        "entry_id": "44113324-9842-340e-908f-4795d95e48d2",
                        "glosses": [
                            "eigen achternaam van een vrouw die de naam van haar echtgenoot of geregistreerd partner voert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a3572b3-7f28-4587-b232-b97a3f241aba",
                                "sense_id": "e67f742f-bec3-3e0c-a38a-96994faf5368",
                                "text": "Haar oud-klasgenoot kon haar niet traceren omdat zij haar meisjesnaam niet meer gebruikte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97a2ed1d-bb77-4e80-843b-3adba887b2d5",
                        "source_entry_id": "44113324-9842-340e-908f-4795d95e48d2",
                        "source_sense_id": "d2dc9a11-6c69-3974-aebf-aaef43d9fc8a",
                        "source_sense_description": "voornaam die doorgaans gegeven wordt aan kinderen van het vrouwelijk geslacht",
                        "target_lang_word": "Mädchenname",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mädchenname",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4b364f2-5b38-3ade-95d1-8f28ee627d6f",
                                        "entry_id": "08f26a23-d295-37b4-b291-9bca1d339095",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ab3cfbe-d3e8-4392-96ac-13a5f72a6ee7",
                                                "sense_id": "d4b364f2-5b38-3ade-95d1-8f28ee627d6f",
                                                "text": "„Anna“ ist ein sehr beliebter Mädchenname."
                                            },
                                            {
                                                "example_id": "76166cb3-7195-457c-b61b-b41117ee6696",
                                                "sense_id": "d4b364f2-5b38-3ade-95d1-8f28ee627d6f",
                                                "text": "„Hier zusammenfassend werden die jeweils ersten zehn Mädchen- und Jungennamen 2011 aufgeführt…“"
                                            },
                                            {
                                                "example_id": "df077e50-610b-4971-8cec-d4ae12fa20fd",
                                                "sense_id": "d4b364f2-5b38-3ade-95d1-8f28ee627d6f",
                                                "text": "„Modenamen kommen und gehen, doch läßt sich bei den Jungennamen eine gewisse Konstanz beobachten. Bei den Mädchennamen geht es etwas bewegter zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1c6586bd-80ee-3d7d-8b33-545b6e543cfa",
                                        "entry_id": "08f26a23-d295-37b4-b291-9bca1d339095",
                                        "glosses": [
                                            "Nachname einer Frau vor ihrer Heirat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c275ae64-b919-45cd-b3e1-6f5b1ac286fb",
                                                "sense_id": "1c6586bd-80ee-3d7d-8b33-545b6e543cfa",
                                                "text": "Ihr Mädchenname war Müller, jetzt – nach ihrer Heirat – heißt sie Schmitz."
                                            },
                                            {
                                                "example_id": "66465e43-386a-4133-bb10-16ac27f7aedb",
                                                "sense_id": "1c6586bd-80ee-3d7d-8b33-545b6e543cfa",
                                                "text": "„Nachdem er Hitlers Gauleiter geworden war, ließ er den Mädchennamen seiner Mutter germanisieren.“"
                                            },
                                            {
                                                "example_id": "eb0c4fe1-7f2b-4f3e-ba0b-45075d013f2e",
                                                "sense_id": "1c6586bd-80ee-3d7d-8b33-545b6e543cfa",
                                                "text": "„Die Marquise nahm ihren Mädchennamen wieder an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
