                    ]
                },
                {
                    "sense_id": "375a622a-8cc9-3cee-87a7-299612ac131f",
                    "sense_definition": "Грубо выражать пренебрежение или отказ от общения.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "пренебрежение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он не хочет слушать советы и постоянно <w>шлет</w> всех куда подальше."
                        },
                        {
                            "text": "Не стоит <w>слать</w> людей, которые искренне пытаются вам помочь."
                        }
                    ],
                    "common_phrases": [
                        "слать куда подальше"
                    ],
                    "traits": [
