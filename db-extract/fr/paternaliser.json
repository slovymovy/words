                ],
                "senses": [
                    {
                        "sense_id": "0777aefb-98e9-3b07-a791-222829653492",
                        "entry_id": "fa2b6c45-d558-34f1-bc12-8139a299359f",
                        "glosses": [
                            "Agir de façon paternelle, paternaliste, envers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c5f9fef-a2d3-4c55-8d74-290db7ab0eab",
                                "sense_id": "0777aefb-98e9-3b07-a791-222829653492",
                                "text": "Ils font partie des rares personnes, au boulot, à ne pas me paternaliser, me prendre pour une Aïcha."
                            },
                            {
                                "example_id": "b5a970ee-f01c-416f-8c19-a65c61dbe161",
                                "sense_id": "0777aefb-98e9-3b07-a791-222829653492",
                                "text": "Cela ne m'intéresse pas de paternaliser le public ou à faire appel à lui d'une manière truquée."
                            },
                            {
                                "example_id": "d4b46814-cab1-4055-9841-9ab681c73a45",
                                "sense_id": "0777aefb-98e9-3b07-a791-222829653492",
                                "text": "L’homme libre ne désire rien tant que d’être paternalisé, protégé par le nombre, l’élu ou l’homme providentiel, l’institution."
                            }
                        ]
                    }
                ],
