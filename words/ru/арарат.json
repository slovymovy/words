            "senses": [
                {
                    "sense_id": "404fa860-30fc-382b-bb3e-07f3ebe60986",
                    "sense_definition": "Самый высокий вулканический массив Армянского нагорья, расположенный на востоке Турции.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toponym",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "В ясную погоду из Еревана открывается прекрасный вид на заснеженный <w>Арарат</w>.",
                            "target_lang_translations": {
                                "en": "In clear weather, Yerevan offers a beautiful view of snow-capped <w>Ararat</w>."
                            }
                        },
                        {
                            "text": "Согласно библейскому преданию, после всемирного потопа ковчег Ноя остановился на горе <w>Арарат</w>.",
                            "target_lang_translations": {
                                "en": "According to biblical tradition, Noah's ark came to rest on Mount <w>Ararat</w> after the Great Flood."
                            }
                        }
                    ],
                    "common_phrases": [
                        "гора Арарат",
                        "вершина Арарата"
                    ],
                    "target_lang_definitions": {
                        "en": "The highest volcanic massif of the Armenian Highland, located in eastern Turkey (Mount Ararat)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Ararat",
                                "target_lang_sense_clarification": "mountain"
                            },
                            {
                                "target_lang_word": "Mount Ararat",
                                "target_lang_sense_clarification": "mountain"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b7a2957-fee9-3f5d-aca3-7394813f5ec3",
