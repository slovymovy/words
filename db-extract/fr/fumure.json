                                        "glosses": [
                                            "An application of manure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c6da330-d9d8-4c2b-99ce-1b1379c513a2",
                                                "sense_id": "a6cf4b36-e1cc-32aa-b559-b6c165033283",
                                                "text": "When the clay is five or six feet or more below the surface, so that manures are liable to be washed down below the roots, three or four light manurings, one in January, another in March, another in June, and the last in August, are better than one or two heavy manurings."
                                            }
                                        ]
