                        "examples": [
                            {
                                "example_id": "a8aa104c-24f1-4a7e-8612-d6e50ba248f7",
                                "sense_id": "7ac3ae78-0688-3078-8b0f-dca4fdddbeb4",
                                "text": "Ce modèle de parasitémie paludique offre un nouvel outil pour sonder le nombre de parasites dans différentes conditions, notamment en cas de vaccin ou de test de médicament."
                            },
                            {
                                "example_id": "81291319-a07f-401a-ac2e-849c2c5a69b2",
                                "sense_id": "7ac3ae78-0688-3078-8b0f-dca4fdddbeb4",
                                "text": "Rien que pour le mois d’avril dernier, sur les 315 malades reçus à l’Hôpital de Lusambo, 155 ont présenté cette forme de trouble paludique."
                            }
                        ]
                    }
