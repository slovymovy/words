                                "sense_id": "0556ab23-2485-3118-a593-18359a44caf2",
                                "text": "Musieliśmy się wydostać z miasta.",
                                "translation": "We had to get out of the city.",
                                "english": "We had to get out of the city."
                            },
                            {
                                "example_id": "53164676-7b84-459b-ba82-90d0a5b4decf",
                                "sense_id": "0556ab23-2485-3118-a593-18359a44caf2",
                                "text": "W zeszłym tygodniu Marek wydostał się z aresztu/więzienia.",
                                "translation": "Marek got out of jail last week.",
                                "english": "Marek got out of jail last week."
                            }
                        ]
