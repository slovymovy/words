                                                "example_id": "07018460-a978-4505-8458-7180a9088271",
                                                "sense_id": "0c848e35-712d-37ec-bb89-9159a055a057",
                                                "text": "Während des Festes haben wir uns gestritten."
                                            },
                                            {
                                                "example_id": "2e80ef95-9f51-422d-940c-3bc0b27dac39",
                                                "sense_id": "0c848e35-712d-37ec-bb89-9159a055a057",
                                                "text": "Hier liegt noch das während dem Winter angetriebene Strandgut."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "während",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0389daab-ba4a-3da5-b8ee-171a3e74c31b",
                                        "entry_id": "66578852-4d40-331a-a812-9186f0b9ce24",
                                        "glosses": [
                                            "in der Zeit, als"
