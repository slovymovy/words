                ],
                "senses": [
                    {
                        "sense_id": "06aa22fd-3c22-37ea-ba42-09470fea7be1",
                        "entry_id": "9c20d95d-dfd6-3c9a-ab4b-e6bef0d7b194",
                        "glosses": [
                            "Gesamtheit der Verhältnisse, insoweit sie sich in der Heimat der an die Front berufenen Soldatinnen und Soldaten entwickeln und durch die Kriegsbedingungen verursacht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "592ec62c-fe23-4ed9-8bab-6a16d9d00e6b",
                                "sense_id": "06aa22fd-3c22-37ea-ba42-09470fea7be1",
                                "text": "„Für eine Trennung zwischen Front und Heimatfront war entsprechend kein Raum.“"
                            },
                            {
                                "example_id": "a7381379-0d15-426f-9760-b19460450d3b",
                                "sense_id": "06aa22fd-3c22-37ea-ba42-09470fea7be1",
                                "text": "„In der Heimatfront wurden Fotografien von Leichen veröffentlicht, die gar nicht nur aus Nemmersdorf stammten.“"
                            },
                            {
                                "example_id": "bf7ad5bb-4070-4ec1-9e55-348920bacb2b",
                                "sense_id": "06aa22fd-3c22-37ea-ba42-09470fea7be1",
                                "text": "„Hitler hatte nicht die Niederlage der Sowjets und den totalen Sieg verkündet, um Propaganda zu machen und die Moral der Heimatfront zu stärken, sondern weil er glaubte, es verhalte sich wirklich so.“"
                            },
                            {
                                "example_id": "50aa5c2c-90eb-403d-bc81-dd2fb4c8fdf4",
                                "sense_id": "06aa22fd-3c22-37ea-ba42-09470fea7be1",
                                "text": "„Der Dienst im Militär oder an der Heimatfront stärkte ihre Kontakte mit der Welt außerhalb ihrer Gruppen und Reservate.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
