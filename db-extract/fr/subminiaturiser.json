                "senses": [
                    {
                        "sense_id": "0fcb0b59-713c-36d2-8e93-e1d3c0919fa1",
                        "entry_id": "28c379f9-d709-31c9-8cc1-a2bb186f372c",
                        "glosses": [
                            "Rendre encore plus petit que ce qu'on considère habituellement comme miniature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7f6c925-9192-4b55-ae2f-18a8b4268dfe",
                                "sense_id": "0fcb0b59-713c-36d2-8e93-e1d3c0919fa1",
                                "text": "Si oui je crois que je vais subminiaturiser tout ça mdr"
                            },
                            {
                                "example_id": "5fe104bd-55d5-4755-8df9-86b10b541a7a",
                                "sense_id": "0fcb0b59-713c-36d2-8e93-e1d3c0919fa1",
                                "text": "Et pour que chacun puisse garder son fil à la patte toujours et partout, il se « subminiaturise » sous forme de netbook aux performances certes limitées, mais relié via 3G à l'omniprésent internet."
                            },
                            {
                                "example_id": "cde23ef9-b3c7-4d37-97bc-ca7bf68d9c2e",
                                "sense_id": "0fcb0b59-713c-36d2-8e93-e1d3c0919fa1",
                                "text": "On dirait un ruban garni de plomb… Non ! Ce n'est pas du plomb !! Il y a là tous les composants d’un circuit électronique subminiaturisé…"
                            }
                        ]
                    }
