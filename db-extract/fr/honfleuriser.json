                "senses": [
                    {
                        "sense_id": "e13cb9eb-b023-320c-b4ee-4bf762b273e0",
                        "entry_id": "ad225c04-1725-3c20-b2e0-46a50049479b",
                        "glosses": [
                            "Donner un caractère honfleurais ou rappelant Honfleur à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "801a85af-3cbd-46a7-8b76-0a1884222347",
                                "sense_id": "e13cb9eb-b023-320c-b4ee-4bf762b273e0",
                                "text": "Il se plaira à Honfleur et nous ne manquerons pas de le « Honfleuriser »."
                            },
                            {
                                "example_id": "1f29e650-d564-4c8e-9780-e9ea37ad78b9",
                                "sense_id": "e13cb9eb-b023-320c-b4ee-4bf762b273e0",
                                "text": "Et toi, pendant ce temps-là, tu peaufinais ton art en vierzonnant Vesoul, en vesoulant Vierzon, en Anversant Honfleur, en honfleurisant Dutronc."
                            },
                            {
                                "example_id": "3876f7b4-925d-419b-8886-328eba4dd67c",
                                "sense_id": "e13cb9eb-b023-320c-b4ee-4bf762b273e0",
                                "text": "Fidèle à l'énigme, l'auteur poursuit des ombre: c'est Anaïs Aubert quittant Paris pour Veules-les-Roses (les débuts d'un village qui « s'honfleurise… »)"
                            }
                        ]
                    }
