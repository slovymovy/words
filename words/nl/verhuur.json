                        },
                        {
                            "text": "Waarom <w>verhuur</w> je die fiets niet?",
                            "target_lang_translations": {
                                "en": "Why don't you <w>rent out</w> that bicycle?",
                                "ru": "Почему бы тебе не <w>сдать</w> этот велосипед в прокат?"
                            }
                        }
