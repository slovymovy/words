                "senses": [
                    {
                        "sense_id": "bceb9ce9-5b15-3483-a602-9fa93ae12fdc",
                        "entry_id": "d798a488-d160-3abc-a75d-fa1432face99",
                        "glosses": [
                            "Hospitable, especially to visiting strangers or foreigners."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "3f20a2b8-2ba8-447b-a971-58812efc0677",
                                "sense_id": "bceb9ce9-5b15-3483-a602-9fa93ae12fdc",
                                "text": "Thus then society is not arranged in clans, but in tribes, united by the general sense of a common name, a common abode, a common history, a common religion, and a remote sense of a common tribal stock, without any sense of personal affinity in each individual case. Again, it is curious to observe that the xenial relation was not less vivacious than that of blood."
                            },
                            {
                                "example_id": "d91719aa-516b-4737-af1c-ce63206f6a44",
                                "sense_id": "bceb9ce9-5b15-3483-a602-9fa93ae12fdc",
                                "text": "House Democrats will always put American values over autocracy, benevolence over bigotry, […] working families over the well-connected, xenial over xenophobia, “Yes we can!” over “You can’t do it,” and zealous representation over zero-sum confrontation!"
                            }
                        ]
                    },
                    {
                        "sense_id": "011c99a0-61f1-3431-823d-7b84da415136",
                        "entry_id": "d798a488-d160-3abc-a75d-fa1432face99",
                        "glosses": [
                            "Of the relation between a host and guest; friendly."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01f045b2-f53b-472f-882a-efbde303f10c",
                        "source_entry_id": "d798a488-d160-3abc-a75d-fa1432face99",
                        "source_sense_description": "hospitable",
                        "target_lang_word": "pohostinný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6df28cb2-b7c7-4097-b48c-637b8b396033",
                        "source_entry_id": "d798a488-d160-3abc-a75d-fa1432face99",
                        "source_sense_description": "hospitable",
                        "target_lang_word": "accueillant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accueillant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09b205b9-12cf-35af-b442-b50aa49f70c3",
                                        "entry_id": "885d4b63-2074-3a0c-b6e5-935b6fc34c02",
                                        "glosses": [
                                            "Qui fait bon accueil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6090b5d2-6f11-4d2f-b48d-cfe7a59f49cb",
                                                "sense_id": "09b205b9-12cf-35af-b442-b50aa49f70c3",
                                                "text": "Les îliens sont aussi très accueillants."
                                            },
                                            {
                                                "example_id": "9bdaaf2f-1b89-44da-935a-52714918d3ea",
                                                "sense_id": "09b205b9-12cf-35af-b442-b50aa49f70c3",
                                                "text": "Il la reportait au contraire, en pleine connaissance de cause, dans le château si accueillant de la vallée du Rhône."
                                            },
                                            {
                                                "example_id": "d5feab09-fe58-4438-a248-a8cd7145892b",
                                                "sense_id": "09b205b9-12cf-35af-b442-b50aa49f70c3",
                                                "text": "Et quelle que soit votre méthode, tâchez de vous faire accueillant dès la salutation. Pas hypocrite, niais ou fleur bleue : accueillant, simplement."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "accueillant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da9dfadf-dc7e-3c9f-8a45-db76bef7f4eb",
                                        "entry_id": "c729158f-4304-3298-91e6-e4dc0777434b",
                                        "glosses": [
                                            "Personne qui accueille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5b71b51-0c54-40e0-b602-9e7992895ee2",
                                                "sense_id": "da9dfadf-dc7e-3c9f-8a45-db76bef7f4eb",
                                                "text": "Toute ma paye y passait. Il me fallait, le soir venu, les promiscuités érotiques de ces splendides accueillantes pour me refaire une âme."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "accueillant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65c860dc-fcd7-3dbc-9d71-01f5c739dfe3",
                                        "entry_id": "597dcecd-8b66-30a6-a873-5a4e1a140067",
                                        "glosses": [
                                            "Participe présent de accueillir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e369ee9a-677e-4c72-83f2-4c9e433e8570",
                                                "sense_id": "65c860dc-fcd7-3dbc-9d71-01f5c739dfe3",
                                                "text": "Pour reprendre les expressions d’Éléonore Sioui, nous voulons un peu «sauvagiser» (p. 29) la littérature québécoise, explorer un espace où « l’étreinte accueillant à la fois le même et l’autrui» peut advenir et écouter «les mots […] jetés comme des ponts entre les corps étrangers au-dessus des ronds dans l’eau»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e391363-e86f-4559-aa13-19604b480fef",
                        "source_entry_id": "d798a488-d160-3abc-a75d-fa1432face99",
                        "source_sense_description": "hospitable",
                        "target_lang_word": "hospitalier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hospitalier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16b5c5e9-0e94-3997-9614-e5552becc980",
                                        "entry_id": "62a3ff2c-e61e-3bda-aef4-052f28952f70",
                                        "glosses": [
                                            "Relatif aux hôpitaux et aux hospices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1cb75c0-f17e-4e3f-bd37-921f5f5bc6ec",
                                                "sense_id": "16b5c5e9-0e94-3997-9614-e5552becc980",
                                                "text": "\"Comme vous le savez, les hospitalisations sont en hausse et nous devons prendre des mesures pour éviter que les capacités hospitalières soient atteintes dans les prochaines semaines\", a expliqué le MSSS dans un courriel transmis à Radio-Canada lundi."
                                            },
                                            {
                                                "example_id": "2328c152-95f0-4cd1-8f11-66a3890d2f61",
                                                "sense_id": "16b5c5e9-0e94-3997-9614-e5552becc980",
                                                "text": "Services hospitaliers."
                                            },
                                            {
                                                "example_id": "35e62bfc-6ac5-4b3b-9af1-feea031be499",
                                                "sense_id": "16b5c5e9-0e94-3997-9614-e5552becc980",
                                                "text": "Établissements hospitaliers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9d4f209-7bb4-30de-8dae-8e57e2d6f705",
                                        "entry_id": "62a3ff2c-e61e-3bda-aef4-052f28952f70",
                                        "glosses": [
                                            "Qualifiait certains ordres et les religieux qui y sont attachés et qui administraient des hôpitaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba33b210-e1b5-4276-a22d-283330df304f",
                                                "sense_id": "e9d4f209-7bb4-30de-8dae-8e57e2d6f705",
                                                "text": "Religieuses hospitalières."
                                            },
                                            {
                                                "example_id": "5b36a9c3-25dd-489c-935b-61cd167cdc41",
                                                "sense_id": "e9d4f209-7bb4-30de-8dae-8e57e2d6f705",
                                                "text": "Sœurs hospitalières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85185457-2696-302c-8ca5-420b8f75b39d",
                                        "entry_id": "62a3ff2c-e61e-3bda-aef4-052f28952f70",
                                        "glosses": [
                                            "Qualifiait certains ordres monastiques institués pour administrer les hôpitaux destinés aux pèlerins vers la Terre sainte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1075ac85-fe86-4650-bd26-1853504aceb1",
                                                "sense_id": "85185457-2696-302c-8ca5-420b8f75b39d",
                                                "text": "Située sur la commune de Saint-Martin-sur-Oreuse, la commanderie de Launay, la plus ancienne fondation de l'Ordre de l’Hôpital dans l'Yonne, administre, à partir du XVᵉ siècle et jusqu'en 1789, la plupart des maisons hospitalières du Sénonais et du Jovignien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8166feaa-acc2-3e30-924d-c7e92356f9e8",
                                        "entry_id": "62a3ff2c-e61e-3bda-aef4-052f28952f70",
                                        "glosses": [
                                            "Qui pratique l’hospitalité ; qui est accueillant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c14c469a-d0e3-40a7-a7ab-e8a8bfb3314f",
                                                "sense_id": "8166feaa-acc2-3e30-924d-c7e92356f9e8",
                                                "text": "Qu'un drame se fût passé là, et qu'on y eût caché le produit ou la preuve d'un crime, c'était possible. Et il était permis de supposer que l’hospitalière gérante savait à quoi s'en tenir sur ce point."
                                            },
                                            {
                                                "example_id": "90da94c8-e2c1-46d0-9b81-16827de2bbbb",
                                                "sense_id": "8166feaa-acc2-3e30-924d-c7e92356f9e8",
                                                "text": "Cependant, généreux et hospitaliers entre eux, ils se secourent mutuellement, et ce serait en vain qu’on chercherait un mendiant dans le pays."
                                            },
                                            {
                                                "example_id": "378c1a0c-456c-47cc-876b-b9ec7da73be3",
                                                "sense_id": "8166feaa-acc2-3e30-924d-c7e92356f9e8",
                                                "text": "Les adieux furent faits. Chacun remercia le sergent Felton, qui s'était montré fort hospitalier dans cette circonstance."
                                            },
                                            {
                                                "example_id": "8ca69f28-8164-4826-97f5-e55aa5587345",
                                                "sense_id": "8166feaa-acc2-3e30-924d-c7e92356f9e8",
                                                "text": "Le chîkh vient alors nous souhaiter la bienvenue. C'est un vieillard pauvrement vêtu mais à la figure sympathique encadrée d'une longue barbe blanche, un vrai croyant, fidèle observateur des préceptes hospitaliers de sa foi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e64885b-ef12-3718-a5bf-936e9e2a1176",
                                        "entry_id": "62a3ff2c-e61e-3bda-aef4-052f28952f70",
                                        "glosses": [
                                            "Qualifie les lieux où l’on pratique volontiers l’hospitalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99b56bad-85e8-41a3-91b0-73ed28ea801b",
                                                "sense_id": "0e64885b-ef12-3718-a5bf-936e9e2a1176",
                                                "text": "Il est impossible que, dans la noble Angleterre, dans ce pays hospitalier, généreux et libre, où tant de chevaliers sont disposés à risquer leur vie pour l’honneur, il ne se trouve pas un homme qui veuille combattre pour la justice."
                                            },
                                            {
                                                "example_id": "df56b331-c75d-452f-8c6a-92acf5a6d57e",
                                                "sense_id": "0e64885b-ef12-3718-a5bf-936e9e2a1176",
                                                "text": "C’était la première demeure qui offrit l’invite hospitalière d’une porte ouverte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9f2e71b-fcdb-3e60-8362-ade574bc507d",
                                        "entry_id": "62a3ff2c-e61e-3bda-aef4-052f28952f70",
                                        "glosses": [
                                            "Qui offre l’hospitalité et ses avantages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bc03726-0b3a-435c-87da-f5754f9ccef7",
                                                "sense_id": "c9f2e71b-fcdb-3e60-8362-ade574bc507d",
                                                "text": "Les clients […] s'installaient placidement, qui sur des banquettes de velours moelleux, qui dans le creux de fauteuils hospitaliers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6eba114e-4514-3cd2-b477-af593e577a91",
                                        "entry_id": "62a3ff2c-e61e-3bda-aef4-052f28952f70",
                                        "glosses": [
                                            "Relatif à Hôpital-Camfrout, commune du Finistère, en France."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7e1d25d-6d82-3f91-9701-33a6a46fcc6a",
                                        "entry_id": "62a3ff2c-e61e-3bda-aef4-052f28952f70",
                                        "glosses": [
                                            "Relatif à Lhôpital, commune de l’Ain, en France."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae782b9b-48da-38b5-a8b5-266fa7eaed80",
                                        "entry_id": "62a3ff2c-e61e-3bda-aef4-052f28952f70",
                                        "glosses": [
                                            "Relatif à L’Hôpital-le-Grand, commune de la Loire, en France."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hospitalier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0aabc26a-575e-3836-810d-4b34b63e3f75",
                                        "entry_id": "94ab9ae0-45a1-3f61-b55f-0ceb4d96b223",
                                        "glosses": [
                                            "Religieux de l’ordre de Saint-Jean de Jérusalem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0aae1b0-9590-4571-9e2f-6c4fd85668e1",
                                                "sense_id": "0aabc26a-575e-3836-810d-4b34b63e3f75",
                                                "text": "C'est précisément l'époque des croisades qui donnèrent naissance aux hospitaliers, aux templiers et à l'ordre teutonique."
                                            },
                                            {
                                                "example_id": "57be28eb-4b8a-421a-81d8-87f8766e09c8",
                                                "sense_id": "0aabc26a-575e-3836-810d-4b34b63e3f75",
                                                "text": "Touchez le bouclier de Ralph de Vipont ! touchez le bouclier de l’hospitalier ! c’est lui qui est le moins solide sur sa selle."
                                            },
                                            {
                                                "example_id": "f394713e-9462-4257-a4c0-709a47699666",
                                                "sense_id": "0aabc26a-575e-3836-810d-4b34b63e3f75",
                                                "text": "Livres hérités de son père et de son grand-père qui racontaient tous la même histoire, la seule au monde qui l’intéressât, l’histoire des Chevaliers Hospitaliers de Saint-Jean de Jérusalem, nommés au quatorzième siècle Chevaliers de Rhodes et plus tard Chevaliers de Malte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e93c5dc-77cc-322b-9cf1-83cc97bbc532",
                                        "entry_id": "94ab9ae0-45a1-3f61-b55f-0ceb4d96b223",
                                        "glosses": [
                                            "Officier qui, dans une loge, est chargé de la bienfaisance."
                                        ],
                                        "tags": [
                                            "Franc-maçonnerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d249abf8-d52d-4a33-b0d1-63a4431b1dee",
                                                "sense_id": "7e93c5dc-77cc-322b-9cf1-83cc97bbc532",
                                                "text": "Que le tronc de l’hospitalier soit apporté sur le plateau du vénérable, il sera décompté après la tenue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
