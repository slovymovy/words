                        "source_entry_id": "7e7a6715-7958-3d58-838f-014b35e20077",
                        "source_sense_description": "person",
                        "target_lang_word": "Zeitungsverkäufer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeitungsverkäufer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66f1fff0-ed33-3545-be44-e9483c1b552d",
                                        "entry_id": "ec442768-fba9-3973-848a-3103347dd775",
                                        "glosses": [
                                            "Verkäufer von Zeitungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36731486-6a99-4a34-895c-a6fe0c1aea93",
                                                "sense_id": "66f1fff0-ed33-3545-be44-e9483c1b552d",
                                                "text": "„Im ganzen Land haben sie sich organisiert, die Zeitungsverkäufer und die Hausmädchen, die Minenkinder und die Autowäscher, die kleinen Schuhputzer und die minderjährigen Maurer.“"
                                            },
                                            {
                                                "example_id": "ae192b9b-0745-4d73-9064-ff76acf1cecf",
                                                "sense_id": "66f1fff0-ed33-3545-be44-e9483c1b552d",
                                                "text": "„Der Zeitungsverkäufer Kunowski, der Fifi von seinem Platz innerhalb des Kiosks nicht sehen konnte, mußte einen sechsten Sinn haben.“"
                                            },
                                            {
                                                "example_id": "ec02bb10-1f4e-4020-a4b7-c79f81fe58b6",
                                                "sense_id": "66f1fff0-ed33-3545-be44-e9483c1b552d",
                                                "text": "„Hier war nur Ruhe, was auch für Unglücksbotschaften nachher die letzten Zeitungsverkäufer krächzen mochten, sobald wir die Cannebière betraten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51a72e12-3c10-4a82-a625-454231a956e3",
                        "source_entry_id": "7e7a6715-7958-3d58-838f-014b35e20077",
