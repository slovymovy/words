                "entry_id": "8deed13b-bd59-3da0-8ab1-187251a3001d",
                "word": "browser",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0ab61da2-b625-4bfe-b036-acf0ffbd594e",
                        "entry_id": "8deed13b-bd59-3da0-8ab1-187251a3001d",
