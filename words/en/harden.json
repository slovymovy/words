{
    "word_family": [
        "hardness",
        "hardy",
        "hardener"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d97a6cc0-e017-3b06-988b-719b49fb07b1",
                    "sense_definition": "To become solid or firm in texture.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clay will <w>harden</w> as it dries in the sun.",
                            "target_lang_translations": {
                                "cs": "Hlína na slunci <w>ztvrdne</w>, jakmile uschne."
                            }
                        },
                        {
                            "text": "Let the chocolate <w>harden</w> before you serve the dessert.",
                            "target_lang_translations": {
                                "cs": "Než dezert podáte, nechte čokoládu <w>ztuhnout</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "solidify",
                        "stiffen"
                    ],
                    "antonyms": [
                        "soften"
                    ],
                    "common_phrases": [
                        "let harden"
                    ],
                    "target_lang_definitions": {
                        "cs": "Stát se pevným nebo tuhým v textuře."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tvrdnout",
                                "target_lang_sense_clarification": "proces nabývání pevnosti"
                            },
                            {
                                "target_lang_word": "ztuhnout",
                                "target_lang_sense_clarification": "přechod do pevného stavu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f4b86a2-f910-389b-b332-d34e774f45b1",
                    "sense_definition": "To make something solid or firm.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold weather <w>hardened</w> the ground.",
                            "target_lang_translations": {
                                "cs": "Chladné počasí <w>vytvrdilo</w> půdu."
                            }
                        },
                        {
                            "text": "They used a special chemical to <w>harden</w> the surface of the metal.",
                            "target_lang_translations": {
                                "cs": "Použili speciální chemikálii, aby <w>vytvrdili</w> povrch kovu."
                            }
                        }
                    ],
                    "synonyms": [
                        "stiffen"
                    ],
                    "antonyms": [
                        "soften"
                    ],
                    "target_lang_definitions": {
                        "cs": "Učinit něco pevným nebo tuhým."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vytvrdit",
                                "target_lang_sense_clarification": "procesem učinit tvrdším"
                            },
                            {
                                "target_lang_word": "tvrdit",
                                "target_lang_sense_clarification": "technický proces zvyšování tvrdosti materiálu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca595ee2-7f47-3eea-9b92-8ae8e71c5e7a",
                    "sense_definition": "To make something stronger or more resistant to damage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strengthen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>harden</w> its security measures against cyber threats.",
                            "target_lang_translations": {
                                "cs": "Společnost se rozhodla <w>posílit</w> svá bezpečnostní opatření proti kybernetickým hrozbám."
                            }
                        },
                        {
                            "text": "Engineers worked to <w>harden</w> the structure against potential earthquakes.",
                            "target_lang_translations": {
                                "cs": "Inženýři pracovali na tom, aby <w>zpevnili</w> konstrukci proti případným zemětřesením."
                            }
                        }
                    ],
                    "synonyms": [
                        "steel",
                        "temper"
                    ],
                    "target_lang_definitions": {
                        "cs": "Učinit něco silnějším nebo odolnějším vůči poškození."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "posílit",
                                "target_lang_sense_clarification": "zvýšit odolnost nebo bezpečnost"
                            },
                            {
                                "target_lang_word": "zpevnit",
                                "target_lang_sense_clarification": "učinit konstrukci odolnější"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9e55f96-fe36-37ec-8e20-16982ac7824d",
                    "sense_definition": "To make a person less sensitive or more emotionally detached.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "strengthen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Years of working in the emergency room <w>hardened</w> her to the sight of suffering.",
                            "target_lang_translations": {
                                "cs": "Léta práce na pohotovosti ji <w>zatvrdila</w> vůči pohledu na utrpení."
                            }
                        },
                        {
                            "text": "The difficult experiences of his youth <w>hardened</w> his heart against others.",
                            "target_lang_translations": {
                                "cs": "Těžké zkušenosti z mládí <w>zatvrdily</w> jeho srdce vůči ostatním."
                            }
                        }
                    ],
                    "synonyms": [
                        "inure"
                    ],
                    "target_lang_definitions": {
                        "cs": "Učinit osobu méně citlivou nebo emočně odtažitou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zatvrdit se",
                                "target_lang_sense_clarification": "stát se citově chladným nebo neústupným"
                            },
                            {
                                "target_lang_word": "otupět",
                                "target_lang_sense_clarification": "ztratit citlivost vůči vnějším vlivům"
                            }
                        ]
                    }
                }
            ]
        },
        {
