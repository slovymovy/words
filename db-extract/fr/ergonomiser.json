                "senses": [
                    {
                        "sense_id": "b6c4084f-861d-3c02-9dc3-0f661253631c",
                        "entry_id": "43b539b3-faca-3ed9-96d2-b49d3e9eb01a",
                        "glosses": [
                            "Rendre plus ergonomique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b61c0c07-ad31-4bbc-ac2c-d348931d5eb4",
                                "sense_id": "b6c4084f-861d-3c02-9dc3-0f661253631c",
                                "text": "La société U. de Burbank a demandé d’ergonomiser le scénario d’un de ses plus fameux films, pour optimiser l’astreinte et augmenter le plaisir du spectateur."
                            },
                            {
                                "example_id": "2574ad3e-8d3f-487d-8a54-9ea3b395c14d",
                                "sense_id": "b6c4084f-861d-3c02-9dc3-0f661253631c",
                                "text": "Les concepteurs ont tenu spécialement à ergonomiser les modèles afin de faciliter l'emploi pour une utilisation de masse."
                            },
                            {
                                "example_id": "f315a611-3d18-4bf7-ad7f-51bc088d900b",
                                "sense_id": "b6c4084f-861d-3c02-9dc3-0f661253631c",
                                "text": "Dans une partie matérielle, nous expliquerons comment et pourquoi ergonomiser les postes de travail, et comment gérer les problèmes vis à vis du matériel."
                            }
                        ]
                    }
