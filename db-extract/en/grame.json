                "forms": [],
                "senses": [
                    {
                        "sense_id": "89ade82a-e04d-347b-9873-9210ac86f86b",
                        "entry_id": "a1d4d11e-0dfb-3178-ba0b-16c78f704012",
                        "glosses": [
                            "Anger; wrath; scorn; bitterness; repugnance."
                        ],
                        "tags": [
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "284c0fe1-6a01-3d8b-bdd9-ab8dbee972e8",
                        "entry_id": "a1d4d11e-0dfb-3178-ba0b-16c78f704012",
                        "glosses": [
                            "Sorrow; grief; misery."
                        ],
                        "tags": [
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bb653964-6a11-4e47-be72-1dc52e67e6b3",
                                "sense_id": "284c0fe1-6a01-3d8b-bdd9-ab8dbee972e8",
                                "text": "to save the from the Blame\nof all my greffe & grame"
                            },
                            {
                                "example_id": "ab63e7dd-3694-4e04-aec9-902dc57ae785",
                                "sense_id": "284c0fe1-6a01-3d8b-bdd9-ab8dbee972e8",
                                "text": "Age doth me mvche grame."
                            },
                            {
                                "example_id": "8eb9c1ba-87da-4695-8f17-0b291c7fe6ff",
                                "sense_id": "284c0fe1-6a01-3d8b-bdd9-ab8dbee972e8",
                                "text": "God's strength shall be my trust, / Fall it to good or grame / 'Tis in his name."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
