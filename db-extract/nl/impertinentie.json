                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "e870d9cc-b972-4552-9fce-acbb1581abf1",
                        "entry_id": "d3d1021d-55ca-303c-9ca1-b2a55190351d",
                        "tags": [
                            "plural"
                        ],
                        "form": "impertinenties"
