                ],
                "senses": [
                    {
                        "sense_id": "28b87281-18bc-32d1-a49d-4d6d1f764f9a",
                        "entry_id": "0e17e139-cecb-363e-a9e2-5f484d5dad3f",
                        "glosses": [
                            "The capacity to know everything."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bf895b74-43ad-46ae-b257-1779815b7ea9",
                                "sense_id": "28b87281-18bc-32d1-a49d-4d6d1f764f9a",
                                "text": "Near-synonyms: all-seeingness, omnividence"
                            },
                            {
                                "example_id": "04842458-1d4b-4367-8dc1-a5cfb68cabe1",
                                "sense_id": "28b87281-18bc-32d1-a49d-4d6d1f764f9a",
                                "text": "Many people believe in God's omniscience."
                            },
                            {
                                "example_id": "b349f669-54e0-450f-a6e6-09f469fe1306",
                                "sense_id": "28b87281-18bc-32d1-a49d-4d6d1f764f9a",
                                "text": "If, a few pages back, the present writer claimed the privilege of peeping into Miss Amelia Sedley's bedroom, and understanding with the omniscience the novelist all the gentle pains and passions which were tossing upon that innocent pillow, why should he not declare himself to be Rebecca's confidante too, master of her secrets, and seal-keeper of that young woman's conscience?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d7f38f1-6d11-485e-9e6f-9a9c5429a848",
                        "source_entry_id": "0e17e139-cecb-363e-a9e2-5f484d5dad3f",
                        "source_sense_id": "28b87281-18bc-32d1-a49d-4d6d1f764f9a",
                        "source_sense_description": "capacity to know everything",
                        "target_lang_word": "vševědoucnost",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "64d1cc54-441e-4077-826f-598c2db26339",
                        "source_entry_id": "0e17e139-cecb-363e-a9e2-5f484d5dad3f",
                        "source_sense_id": "28b87281-18bc-32d1-a49d-4d6d1f764f9a",
                        "source_sense_description": "capacity to know everything",
                        "target_lang_word": "alwetendheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alwetendheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dab1106c-f301-39fe-991d-56ecb6ac28a5",
                                        "entry_id": "2b0fd759-339c-32d5-a71d-dba9d0bc2e57",
                                        "glosses": [
                                            "het alwetend zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d12533e0-18b8-4cbb-8d16-540ed98914b7",
                                                "sense_id": "dab1106c-f301-39fe-991d-56ecb6ac28a5",
                                                "text": "„Zij geeft zich graag een air van alwetendheid,\" was het commentaar van madame de Marsan."
                                            },
                                            {
                                                "example_id": "de85c83a-5aa1-45bf-9538-c1ac87bae6ee",
                                                "sense_id": "dab1106c-f301-39fe-991d-56ecb6ac28a5",
                                                "text": "Ik heb niet zo'n vertrouwen in zijn alwetendheid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edbc8a4a-7d97-45a1-be4e-f8965f9ed5c9",
                        "source_entry_id": "0e17e139-cecb-363e-a9e2-5f484d5dad3f",
                        "source_sense_id": "28b87281-18bc-32d1-a49d-4d6d1f764f9a",
                        "source_sense_description": "capacity to know everything",
