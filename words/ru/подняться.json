    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4444f0d-4a71-3bab-b080-e50cff535391",
                    "sense_definition": "Встать с постели или принять вертикальное положение.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он сегодня <w>поднялся</w> очень рано, чтобы успеть на поезд."
                        },
                        {
                            "text": "Больной с трудом <w>поднялся</w> с кровати после долгого сна."
                        }
                    ],
                    "synonyms": [
                        "встать"
                    ],
                    "common_phrases": [
                        "рано подняться"
                    ]
                },
                {
                    "sense_id": "337e095d-aff5-394d-8f8c-fb9d21d7a9cf",
                    "sense_definition": "Переместиться на более высокий уровень или этаж.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нам нужно <w>подняться</w> на второй этаж, чтобы найти офис."
                        },
                        {
                            "text": "Альпинисты решили <w>подняться</w> на вершину горы до заката."
                        }
                    ],
                    "antonyms": [
                        "опуститься"
                    ],
                    "common_phrases": [
                        "подняться на этаж",
                        "подняться на гору"
                    ]
                },
                {
                    "sense_id": "4c0357f3-bef3-34df-9283-7151174d9e6c",
                    "sense_definition": "Стать больше по количеству, цене или уровню.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Цены на продукты в магазине заметно <w>поднялись</w> за последний месяц."
                        },
                        {
                            "text": "Уровень воды в реке <w>поднялся</w> после сильных дождей."
                        }
                    ],
                    "synonyms": [
                        "повыситься",
                        "увеличиться",
                        "вырасти"
                    ],
                    "antonyms": [
                        "снизиться"
                    ],
                    "common_phrases": [
                        "цены поднялись"
                    ]
                },
                {
                    "sense_id": "66e3147b-a01b-36b1-b9f8-4cf891ac187e",
                    "sense_definition": "Стать лучше, наладиться.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Настроение после хорошей музыки сразу <w>поднялось</w>."
                        },
                        {
                            "text": "Дела на работе наконец <w>поднялись</w> после кризиса."
                        }
                    ],
                    "synonyms": [
                        "наладиться",
                        "улучшиться"
                    ],
                    "common_phrases": [
                        "настроение поднялось"
                    ]
                },
                {
                    "sense_id": "6ee990db-8836-3d96-8caf-da23893d7e98",
                    "sense_definition": "Начаться, возникнуть (обычно о природных явлениях или беспорядках).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Внезапно на море <w>поднялся</w> сильный ветер."
                        },
                        {
                            "text": "В городе <w>поднялись</w> волнения из-за новых законов."
                        }
                    ],
                    "synonyms": [
                        "начаться",
                        "возникнуть",
                        "появиться"
                    ],
                    "common_phrases": [
                        "поднялся ветер"
                    ]
                },
                {
                    "sense_id": "090bb78d-8c3b-3311-a6cd-5692542012bc",
                    "sense_definition": "Начать активные действия, восстать.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Солдаты <w>поднялись</w> в атаку по сигналу командира."
                        },
                        {
                            "text": "Народ <w>поднялся</w> на защиту своей свободы."
                        }
                    ],
                    "synonyms": [
                        "восстать"
                    ]
                },
                {
                    "sense_id": "a1488497-6b90-3d2a-a300-1be868975a1f",
                    "sense_definition": "Разбогатеть, добиться успеха.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он быстро <w>поднялся</w> на продаже недвижимости в центре города."
                        },
                        {
                            "text": "Многие бизнесмены <w>поднялись</w> в девяностые годы."
                        }
                    ],
                    "synonyms": [
                        "возвыситься"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ]
                }
            ]
        }
    ]
