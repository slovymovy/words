                "senses": [
                    {
                        "sense_id": "79a3a30e-10ed-348a-ad31-5d62597b56c9",
                        "entry_id": "46a03ccf-7b84-3413-ae7c-f287eac46e9d",
                        "glosses": [
                            "находящийся внутри (в пределах) комнаты; предназначенный для использования внутри (в пределах) комнаты"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c9faf41-79d2-488e-88ad-4da3b4c565db",
                                "sense_id": "79a3a30e-10ed-348a-ad31-5d62597b56c9",
                                "text": "Гипс быстро схватывается, но недостаток его состоит в том, что такая конструкция будет служить только внутрикомнатной перегородкой и только в доме, в котором поддерживается определенная температура."
                            }
                        ]
                    },
                    {
                        "sense_id": "3cfb3536-41ec-334c-b40e-57ef061e9181",
                        "entry_id": "46a03ccf-7b84-3413-ae7c-f287eac46e9d",
                        "glosses": [
                            "происходящийся (разворачивающийся) внутри комнаты"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34f19669-bf7d-4e8d-b7c3-cb99afb3b6aa",
                                "sense_id": "3cfb3536-41ec-334c-b40e-57ef061e9181",
                                "text": "Занятый этим странным зрелищем, я позабыл о внутрикомнатном."
                            }
                        ]
                    }
                ],
