                "senses": [
                    {
                        "sense_id": "e20dbbfc-8599-3f75-aac1-46c0b84f56cf",
                        "entry_id": "9772a740-9b2b-3668-b20f-43e892d3208d",
                        "glosses": [
                            "aus Stein gefertigte Skulptur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55bbb5f1-1b78-4ae9-b4c0-c0f43f82dea6",
                                "sense_id": "e20dbbfc-8599-3f75-aac1-46c0b84f56cf",
                                "text": "„Jede einzelne Steinskulptur war jetzt zu einem lebendigen Dämon geworden, und die massigen Monumente der Osterinsel richteten sich schwerfällig auf und umringten zu Hunderten und Aberhunderten die symbolische Statue, die ihnen ihr Leben verliehen hatte.“"
                            },
                            {
                                "example_id": "8f77ff25-679c-474c-9cf2-164d1764341e",
                                "sense_id": "e20dbbfc-8599-3f75-aac1-46c0b84f56cf",
                                "text": "„Wir legten unsere Ausrüstung in der Mitte des gigantischen Platzes ab und ließen uns auf einer kunstvollen Steinskulptur nieder.“"
                            },
                            {
                                "example_id": "d971c91a-6f7e-4f7b-982a-4a828c85e662",
                                "sense_id": "e20dbbfc-8599-3f75-aac1-46c0b84f56cf",
                                "text": "„Er war entzückt von der Schnitzerei, besonders weil er sofort überraschende Ähnlichkeiten mit den Steinskulpturen von Smith feststellte.“"
                            },
                            {
                                "example_id": "71131242-1453-4e82-b489-2b99896ad084",
                                "sense_id": "e20dbbfc-8599-3f75-aac1-46c0b84f56cf",
                                "text": "„Es war an jenen Steinskulpturen und Schnitzereien, der Maske und den gewebten Stoffen an sich nichts besonders Bizarres oder Erschreckendes ... außer der Tatsache, dass sie zusammengenommen überraschende und sogar leicht beunruhigende Übereinstimmungen in Thema und Design aufwiesen, die umso rätselhafter waren, wenn man bedenkt, welche Entfernungen zwischen ihren Ursprungsorten lagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
