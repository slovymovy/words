                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "atmosphaere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit einem modernen Teleskop kann man tief in den <w>Himmel</w> blicken."
                        },
                        {
                            "text": "Astronomische Instrumente erforschen die Geheimnisse des weiten <w>Himmels</w>."
