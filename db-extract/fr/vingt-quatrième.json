                        "sense_id": "ebb222d1-498e-3527-b34b-10c8c120ec10",
                        "entry_id": "219ce735-1a47-3b97-920a-7ab7efd0774c",
                        "glosses": [
                            "1/24, fraction obtenue en divisant vingt-quatre fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1320e969-a220-478b-b833-21eeea733705",
                                "sense_id": "ebb222d1-498e-3527-b34b-10c8c120ec10",
                                "text": "Donnez-moi le vingt-quatrième de ce gâteau."
                            }
                        ]
