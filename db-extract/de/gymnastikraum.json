                ],
                "senses": [
                    {
                        "sense_id": "6f26f636-2ae0-3b37-a1df-7d3fabf14358",
                        "entry_id": "30892fe6-eb00-3591-a2eb-3fba406a0a27",
                        "glosses": [
                            "Raum, in dem Personen Sport treiben können, beispielsweise Turnen, Gymnastik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1e66d8b-4b14-4fda-a37e-fc89e46e3a7c",
                                "sense_id": "6f26f636-2ae0-3b37-a1df-7d3fabf14358",
                                "text": "In meinem Verein wird der Gymnastikraum für Ballspiele, Fitnesstraining und Kinderturnen genutzt."
                            },
                            {
                                "example_id": "4cd65a79-2639-4d10-8e4f-c2e6d27a2335",
                                "sense_id": "6f26f636-2ae0-3b37-a1df-7d3fabf14358",
                                "text": "Der Yogakurs findet nicht wie angekündigt im Gymnastikraum am Montag von 19 - 20 Uhr statt, sondern von 20 - 21 Uhr."
                            },
                            {
                                "example_id": "af4f2da3-e120-4ca6-bdc4-0152750065d1",
                                "sense_id": "6f26f636-2ae0-3b37-a1df-7d3fabf14358",
                                "text": "[Bauhaus 1926:] „Sogar ein Gymnastikraum befand sich im Keller.“"
                            },
                            {
                                "example_id": "d4550756-b9ff-43b1-9714-67fbd3f04118",
                                "sense_id": "6f26f636-2ae0-3b37-a1df-7d3fabf14358",
                                "text": "„Die Gefängnisse sind mit Sportstätten (Sportplatz, Turnhalle und/oder Kraftsport- und Gymnastikraum) ausgestattet.“"
                            },
                            {
                                "example_id": "cde9e32f-7f84-441e-8ab2-e4322e9df6ad",
                                "sense_id": "6f26f636-2ae0-3b37-a1df-7d3fabf14358",
                                "text": "[Alte römischen Thermen in Süddeutschland:] „Man begann mit Warmbad, dann folgten Schwitzbad und Kaltbad, bis man sich schließlich im Gymnastikraum sportlich betätigte.“"
                            },
                            {
                                "example_id": "28956a20-1604-4a10-b50a-337840bc0bc7",
                                "sense_id": "6f26f636-2ae0-3b37-a1df-7d3fabf14358",
                                "text": "„Ein Bewegungsbad und Ruheraum stehen genauso zur Verfügung wie ein Gymnastikraum, Kneipptretbecken, Liegewiese und eine medizinische Abteilung.“"
                            },
                            {
                                "example_id": "c58b6d40-a6c9-404a-aae6-b69c2601c1ac",
                                "sense_id": "6f26f636-2ae0-3b37-a1df-7d3fabf14358",
                                "text": "„Bade- und Schlafzimmer waren fensterlos, der Gymnastikraum dagegen besaß eine Fensterfront zum Gewächshaus.“"
                            },
                            {
                                "example_id": "33132011-f4d3-4cf3-8ad7-fd77bb0211f8",
                                "sense_id": "6f26f636-2ae0-3b37-a1df-7d3fabf14358",
                                "text": "„Auch heuer investiert die Gemeinde wieder in das Happyland - konkret 700.000 Euro. Dieses Geld fließt etwa in einen neuen Gymnastikraum, der […] bis zum Herbst fertig gestellt werden soll.“"
                            },
                            {
                                "example_id": "4e73eba7-3799-40b2-8765-a56a460d9789",
                                "sense_id": "6f26f636-2ae0-3b37-a1df-7d3fabf14358",
                                "text": "[Sie] „meckerte über die Unordnung im Gymnastikraum.“"
                            },
                            {
                                "example_id": "48c2e293-b3b4-490f-a982-4458c08dbb58",
                                "sense_id": "6f26f636-2ae0-3b37-a1df-7d3fabf14358",
                                "text": "„Im Pavillon angekommen, nahmen meine Schüler die Garderobe vor dem Gymnastikraum in Besitz und begannen sich umzuziehen.“"
                            },
                            {
                                "example_id": "9aa77f3a-888d-438d-9ebb-2a52df18d469",
                                "sense_id": "6f26f636-2ae0-3b37-a1df-7d3fabf14358",
                                "text": "„Zeit für eine Stunde Easy Yoga mit Hotel-Trainerin Lotta. Der Gymnastikraum ist voll, 15 Sportbegeisterte folgen konzentriert den Anweisungen der Schwedin.“"
                            },
                            {
                                "example_id": "d210c087-7611-447b-a4e2-c3c0aab475ba",
                                "sense_id": "6f26f636-2ae0-3b37-a1df-7d3fabf14358",
                                "text": "„Im schmucklosen Gymnastikraum, vorne auf dem Podium, sitzen zwei Sponsorenvertreter, zwei Vorstandsmitglieder, ein Trainer und zwei Fußballer.“"
                            },
                            {
                                "example_id": "889fbaa7-ea09-487e-9652-b5806bbbb8c3",
                                "sense_id": "6f26f636-2ae0-3b37-a1df-7d3fabf14358",
                                "text": "„Auf der Suche nach dem Gymnastikraum ging er den Korridor entlang. Als er an der Toilette vorbeikam, stand dort der junge Arzt, den er vorhin im Fahrstuhl getroffen hatte […]. »Wo ist denn der Gymnastikraum?« »Dort, ganz am Ende«, antwortete der Arzt […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
