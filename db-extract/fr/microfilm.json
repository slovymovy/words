                                "target_senses": [
                                    {
                                        "sense_id": "82f688a6-0765-3b9b-aaa4-a80e974ae814",
                                        "entry_id": "aaef2bed-bf5f-3f97-ba31-d40b6ebc0c90",
                                        "glosses": [
                                            "Film mit stark verkleinert aufgenommenen Informationen oder Texten (Mikrokopien) zur Archivierung oder Transport"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e992fd9c-4faf-4599-b45d-43894feefc74",
                                                "sense_id": "82f688a6-0765-3b9b-aaa4-a80e974ae814",
                                                "text": "„Leo hatte solche Münzen schonmal gesehen. Man benutzte sie zum Schmuggeln von Mikrofilmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
