                                            {
                                                "example_id": "1fb44a21-71c8-4c22-b1a6-16fa2ac6dd29",
                                                "sense_id": "b0926563-8299-3717-92e1-63d02d049f94",
                                                "text": "The Saturnalia was apparently the only occasion, however, when the synthesis could be worn in public with decorum."
