                        "glosses": [
                            "de gezondheidszorg voor werknemers met werkgerelateerde aandoeningen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70eefde4-f0f0-4d27-bd91-60887b6ae4f5",
                                "sense_id": "991ecded-4286-3d8e-a25f-dfc8c71f52d7",
                                "text": "Volgens de onderzoekers moeten gezondheid en welzijn meer aandacht krijgen in het beleid voor arbeidsmigranten. Zo zou er betere bedrijfsgezondheidszorg beschikbaar moeten zijn en moet er geïnvesteerd worden in preventie en taalonderwijs."
                            },
                            {
                                "example_id": "740a8f67-8b4f-4e0f-a0bb-c92f84b811a3",
                                "sense_id": "991ecded-4286-3d8e-a25f-dfc8c71f52d7",
                                "text": "Minister Asscher van Sociale Zaken en Schippers van Volksgezondheid willen dat werknemers en werkgevers een goed functionerende bedrijfsgezondheidszorg hebben."
                            }
                        ]
                    }
