                "senses": [
                    {
                        "sense_id": "55471583-e7a5-3cf5-b3eb-502c0b61dadb",
                        "entry_id": "10b757f2-14d4-3527-b7a2-1695125d2b4b",
                        "glosses": [
                            "Donner un caractère mémoriel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4639ae8f-b0cf-4b80-b26e-529bb063fdc4",
                                "sense_id": "55471583-e7a5-3cf5-b3eb-502c0b61dadb",
                                "text": "Les proches d'une personne décédée peuvent au choix fermer ou «mémorialiser» son compte, comme on vous l'expliquait en 2010."
                            },
                            {
                                "example_id": "030866cb-f158-41e5-931d-4181d697332a",
                                "sense_id": "55471583-e7a5-3cf5-b3eb-502c0b61dadb",
                                "text": "Comment \"mémorialiser\" un profil Facebook ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "0312f108-8829-3a3d-830f-e03239a5cbf0",
                        "entry_id": "10b757f2-14d4-3527-b7a2-1695125d2b4b",
                        "glosses": [
                            "Créer des mémoriaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c2c476a-7dcd-42bd-91fc-2c0b525cf9f1",
                                "sense_id": "0312f108-8829-3a3d-830f-e03239a5cbf0",
                                "text": "Qu'est ce que la mémoire initiative ? Pourquoi mémorialiser ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "572c8620-9e1c-4b66-b1f2-3023fdaf1587",
                        "source_entry_id": "10b757f2-14d4-3527-b7a2-1695125d2b4b",
                        "target_lang_word": "memorialize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "memorialize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96c671c5-0c1a-35a9-8dd7-9b1ff4a56fae",
                                        "entry_id": "df15ccbd-f689-3a1e-80b8-3a7a20167e8f",
                                        "glosses": [
                                            "To provide a memorial for someone; to commemorate."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5a32f06-03b6-4ce1-82ab-b6c1a333aac5",
                                                "sense_id": "96c671c5-0c1a-35a9-8dd7-9b1ff4a56fae",
                                                "text": "In this passage, Andromaque sees Astyanax only through the memorializing lens of his attribution to Hector, his status as \"gage.\""
                                            },
                                            {
                                                "example_id": "8be86eb9-48bf-47bf-8e08-789151ce93b7",
                                                "sense_id": "96c671c5-0c1a-35a9-8dd7-9b1ff4a56fae",
                                                "text": "President Emmanuel Macron decided this summer that 46 years after her death, Baker would become only the sixth woman to be memorialised in the Panthéon in a ceremony on 30 November – the anniversary of the marriage to Jean Lion that allowed her to acquire French nationality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6ae845e-b8d4-38b5-b613-938ac33ad410",
                                        "entry_id": "df15ccbd-f689-3a1e-80b8-3a7a20167e8f",
                                        "glosses": [
                                            "To convert (someone’s profile) into a memorial site/page (e.g. on Facebook)."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61bde1a0-050d-4066-be29-f433badfb34d",
                                                "sense_id": "b6ae845e-b8d4-38b5-b613-938ac33ad410",
                                                "text": "Facebook says people with memorialized accounts do not appear in advertisements or birthday reminders on the site and are also excluded from the People You May Know list of friend suggestions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9ed6095-35ae-393e-b9b2-f7c7cdf530cb",
                                        "entry_id": "df15ccbd-f689-3a1e-80b8-3a7a20167e8f",
                                        "glosses": [
                                            "To create a written record of a meeting or conversation."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ddcc13a-8852-4cfb-b4e8-aa87b890bb1d",
                                                "sense_id": "d9ed6095-35ae-393e-b9b2-f7c7cdf530cb",
                                                "text": "Most of the time, the National Security Council — the foreign policy arm of the White House — memorializes presidential phone or video calls with foreign heads of state on the so-called TNet system, the officials said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "403e782c-3475-31cc-8932-844a4b871603",
                                        "entry_id": "df15ccbd-f689-3a1e-80b8-3a7a20167e8f",
                                        "glosses": [
                                            "To petition with a memorial, or statement of facts."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eef69ce9-e59b-4132-935a-97f0fb6afae3",
                                                "sense_id": "403e782c-3475-31cc-8932-844a4b871603",
                                                "text": "Why, you'll—you'll ask till they tell you. Then you'll memorialize that Department (according to regular forms which you'll find out) for leave to memorialize this Department."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
