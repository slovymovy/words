                        "target_lang_word": "Kolumnist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kolumnist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af2d13a8-9ec2-35d2-a3ec-f8536ad09865",
                                        "entry_id": "75cc625d-5ae5-3927-95bd-b6d80e3a7f54",
                                        "glosses": [
                                            "Autor eines kurzen, regelmäßig erscheinenden, journalistischen Beitrags in einer Zeitung oder einer Zeitschrift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85685c59-604b-47b0-842a-0b42972aeed0",
                                                "sense_id": "af2d13a8-9ec2-35d2-a3ec-f8536ad09865",
                                                "text": "Der Kolumnist der überregionalen Zeitung genießt in der Öffentlichkeit hohes Ansehen."
                                            },
                                            {
                                                "example_id": "e2bcc709-e8ce-4e28-971e-c91453dd2836",
                                                "sense_id": "af2d13a8-9ec2-35d2-a3ec-f8536ad09865",
                                                "text": "„In jenen Tagen besuchten viele Leute die Cafés an der Kreuzung Boulevard Montparnasse und Boulevard Raspail, um gesehen zu werden, und in gewisser Weise nahmen solche Lokale die Kolumnisten vorweg, als den täglichen Ersatz für Unsterblichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2114dd67-62e8-485c-a2cf-ea6b85dacb3e",
                        "source_entry_id": "91da554b-12cb-3cb4-8dfb-3548a167a708",
