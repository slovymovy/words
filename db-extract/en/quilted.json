                        "glosses": [
                            "Having characteristics that approximate the above to some degree."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c635ac7-92b2-4118-91eb-595c420377c1",
                                "sense_id": "76203e14-40f9-39a4-a53a-bcee5bf1e26f",
                                "text": "a brand of quilted toilet paper"
                            },
                            {
                                "example_id": "83a29c75-1be2-4f56-8e1a-3c62ab2281c0",
                                "sense_id": "76203e14-40f9-39a4-a53a-bcee5bf1e26f",
                                "text": "The stateroom panelling is veneered with quilted maple and walnut, and the furniture is in sycamore and walnut."
