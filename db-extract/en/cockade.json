                    {
                        "translation_id": "6b1efcb4-656f-4c4d-b5fd-d7be79fcbc4a",
                        "source_entry_id": "f7fd83cc-2c9f-3f78-aa0f-0622bb065729",
                        "source_sense_description": "a rosette worn in a hat as an office or party badge",
                        "target_lang_word": "Kokarde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kokarde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36f13b7f-f96f-338b-a551-ef703856b28c",
                                        "entry_id": "dc8d521c-b67d-3348-8d5d-03c4a2224b0c",
                                        "glosses": [
                                            "militärisches oder politisches, kreisrundes, auf der Kleidung oder Militärflugzeugen angebrachtes Abzeichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c63b2d89-22d2-4efc-953d-60d73aba4803",
                                                "sense_id": "36f13b7f-f96f-338b-a551-ef703856b28c",
                                                "text": "„Das Tragen von schwarz-rot-goldenen, schwarz-gelben oder sonstigen Kokarden erscheint uns heute so.“"
                                            },
                                            {
                                                "example_id": "05632f46-58a8-4f2e-bc06-fe6cdc3a0e37",
                                                "sense_id": "36f13b7f-f96f-338b-a551-ef703856b28c",
                                                "text": "„Die zwei Studenten schlugen ihre Rockaufschläge um und entblößten schwarzrote Kokarden, durchwirkt mit Goldfäden.“"
                                            },
                                            {
                                                "example_id": "c0f764ee-a57c-4e3a-b7ed-7fbbf8c26c9d",
                                                "sense_id": "36f13b7f-f96f-338b-a551-ef703856b28c",
                                                "text": "„Man merkt, dass sie noch nicht lange im Kriege sind; sie sammeln noch Andenken, Achselklappen, Kokarden, Koppelschlösser, Orden, Uniformknöpfe.“"
                                            },
                                            {
                                                "example_id": "dd356c92-ee7e-43b1-82b1-11ae53c6a24a",
                                                "sense_id": "36f13b7f-f96f-338b-a551-ef703856b28c",
                                                "text": "„Die Strafkompanie zog jetzt vorbei, die Soldaten zweiter Klasse, ohne Kokarde an der Mütze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
