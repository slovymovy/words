                                        "glosses": [
                                            "A publication that provides synonyms (and sometimes antonyms and other semantic relations) for the words of a given language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e41a2773-09fb-4d27-a778-891c903918a3",
                                                "sense_id": "97a2bfd0-eb27-3646-8660-2dbd06ab4284",
                                                "text": "\"Roget\" is the leading brand name for a print English thesaurus that lists words under general concepts rather than just close synonyms."
                                            },
                                            {
                                                "example_id": "78a98f3b-8435-4e95-9827-ab19471889ac",
                                                "sense_id": "97a2bfd0-eb27-3646-8660-2dbd06ab4284",
                                                "text": "As reference books go, the thesaurus has had a somewhat checkered history, in fact, and has probably occasioned as much bad writing as good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b2c5473-d45e-3e7d-a914-93175ff19d4b",
