                                "example_id": "2b3d8efb-8e5f-4f8d-97bf-8a718eb4f78e",
                                "sense_id": "e0d6011b-74ad-3ccc-93a0-c7dc702cd36f",
                                "text": "„Die sudetendeutschen Gebiete – und damit eben auch die verbliebene Minderheit der Hitler-Gegner – wurden an Nazideutschland ausgeliefert.“"
                            },
