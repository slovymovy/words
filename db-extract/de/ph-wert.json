                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "904a78f2-bd44-4af9-b98a-ad23737b3448",
                        "source_entry_id": "9244b5a6-6f9b-34d7-a971-ddf8a7a67a83",
                        "source_sense_id": "00e5cdf4-eb12-333a-966e-c09689c700a6",
                        "source_sense_description": "Chemie: ein Maß für die Stärke der sauren beziehungsweise basischen Wirkung einer Lösung",
                        "target_lang_word": "pH",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pH",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "aacfe7dc-b05d-337a-96be-5c3732b8317d",
                                        "entry_id": "ecc9dc39-2142-339e-8774-afab911b14e0",
                                        "glosses": [
                                            "Cuantificador de acidez o de basicidad (alcalinidad) de soluciones químicas, referido a iones de hidronio (H₃O)⁺. Consta de una escala de cero a catorce donde el valor siete es neutro, cifras inferiores corresponden a substancias ácidas, y las superiores, a básicas (alcalinas)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a30c14c4-c947-4b39-bfdc-1858dd7e7545",
                                                "sense_id": "aacfe7dc-b05d-337a-96be-5c3732b8317d",
                                                "text": "La calidad del agua y el pH son a menudo mencionados en la misma frase. El pH es un factor muy importante, porque determinados procesos químicos solamente pueden tener lugar a un determinado pH. Por ejemplo, las reacciones del cloro solo tienen lugar cuando el pH tiene un valor de entre 6,5 y 8"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c745baac-a01e-3dc2-8563-0366b1769522",
                                        "entry_id": "ecc9dc39-2142-339e-8774-afab911b14e0",
                                        "glosses": [
                                            "Símbolo de picohenrio: unidad de inductancia del Sistema Internacional de Unidades (SI), equivalente a 10⁻¹² henrio."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3793fe1a-d2c8-4f99-82b3-1e49fac77f2d",
                                                "sense_id": "c745baac-a01e-3dc2-8563-0366b1769522",
                                                "text": "Unidad: henrio; submúltiplos: picohenrio, nanohenrio, microhenrio, milihenrio"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
