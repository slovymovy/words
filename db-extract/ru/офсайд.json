                    {
                        "translation_id": "afd62ff8-ae77-4901-8c83-dee2c0910d3a",
                        "source_entry_id": "c744642e-b015-38bb-a7c9-844514cd2783",
                        "source_sense_description": "нарушение правил, при котором игрок атакующей команды находится ближе к воротам команды соперника до передачи ему мяча, чем игроки защищающейся команды",
                        "target_lang_word": "Abseits",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abseits",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93c4ce99-3c70-3062-94d0-d5cfc1755bba",
                                        "entry_id": "e3020980-c4b8-37f2-90fc-31ba406168e1",
                                        "glosses": [
                                            "Ort in großer Entfernung von einem Bezugspunkt"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "901fc503-d639-4c99-8c90-0f1abfcf84a7",
                                                "sense_id": "93c4ce99-3c70-3062-94d0-d5cfc1755bba",
                                                "text": "Wenn die Kinder spielten, stand Peter immer im Abseits."
                                            },
                                            {
                                                "example_id": "c574b21a-f51d-4260-8569-eb5802adac3c",
                                                "sense_id": "93c4ce99-3c70-3062-94d0-d5cfc1755bba",
                                                "text": "„Der in seinem zweiten Tribunat eingebrachte Gesetzesantrag zugunsten der Ausweitung des römischen Bürgerrechts (civitas Romana) auf die italischen Bundesgenossen brachte Gaius Gracchus ins politische Abseits, und so konnte er von seinen politischen Gegnern ausmanövriert werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d0cbc78a-bf6a-3d26-84da-8585eecaa09a",
                                        "entry_id": "e3020980-c4b8-37f2-90fc-31ba406168e1",
                                        "glosses": [
                                            "Sport, Fußball: Spielsituation, bei der (mindestens) ein Spieler der angreifenden Mannschaft regelwidrig die gegnerische Verteidigung vor dem Ball überlaufen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e924a98d-1213-420f-a340-a503911cf45a",
                                                "sense_id": "d0cbc78a-bf6a-3d26-84da-8585eecaa09a",
                                                "text": "Der Stürmer stand schon wieder im Abseits."
                                            },
                                            {
                                                "example_id": "8592efd8-73dc-4d20-b71d-6820abb537e3",
                                                "sense_id": "d0cbc78a-bf6a-3d26-84da-8585eecaa09a",
                                                "text": "„Aus dem Wohnzimmer erklangen Jubelschreie, die sich sofort in Fluchen wandelten, gefolgt von lautstarken Erklärungen, dass es doch bestimmt kein verdammtes Abseits war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
