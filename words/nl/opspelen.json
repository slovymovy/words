{
    "word_family": [
        "spelen",
        "afspelen",
        "meespelen",
        "uitspelen",
        "speler",
        "speelgoed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7de93d20-f66a-36a7-af8c-e9f161e86ead",
                    "sense_definition": "Op een vervelende of pijnlijke manier weer de kop opsteken of merkbaar worden, met name van lichamelijke klachten of problemen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "klachten-en-problemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de ruzie met zijn vrouw <w>speelde</w> zijn maag weer <w>op</w>.",
                            "target_lang_translations": {
                                "en": "After the argument with his wife, his stomach started <w>acting up</w> again."
                            }
                        },
                        {
                            "text": "Zodra het kouder wordt buiten, begint zijn oude blessure weer <w>op</w> te <w>spelen</w>.",
                            "target_lang_translations": {
                                "en": "As soon as it gets colder outside, his old injury starts to <w>flare up</w> again."
                            }
                        }
                    ],
                    "synonyms": [
                        "opspelen",
                        "opvlammen",
                        "opkomen"
                    ],
                    "antonyms": [
                        "luwen",
                        "wegtrekken"
                    ],
                    "common_phrases": [
                        "blessure speelt op",
                        "maag speelt op"
                    ],
                    "target_lang_definitions": {
                        "en": "To flare up, act up, or become noticeable again in an annoying or painful way, especially regarding physical ailments or problems."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to act up",
                                "target_lang_sense_clarification": "of a physical ailment or problem"
                            },
                            {
                                "target_lang_word": "to flare up",
                                "target_lang_sense_clarification": "of symptoms or pain"
                            },
                            {
                                "target_lang_word": "to recur",
                                "target_lang_sense_clarification": "of a medical issue"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f163155e-e0f5-33f9-87ff-9f3134903271",
                    "sense_definition": "Zich heftig of boos uiten tegen iemand; uitvaren of protesteren.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "boosheid-uiten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ontevreden klant begon flink <w>op</w> te <w>spelen</w> tegen de winkelier.",
                            "target_lang_translations": {
                                "en": "The dissatisfied customer started to <w>make a big scene</w> at the shopkeeper."
                            }
                        },
                        {
                            "text": "Toen hij onterecht beschuldigd werd, <w>speelde</w> hij meteen fel <w>op</w>.",
                            "target_lang_translations": {
                                "en": "When he was falsely accused, he immediately <w>lashed out</w> fiercely."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitvaren",
                        "tekeergaan",
                        "protesteren"
                    ],
                    "antonyms": [
                        "berusten",
                        "zwijgen"
                    ],
                    "common_phrases": [
                        "fel opspelen",
                        "tegen iemand opspelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To express oneself vehemently or angrily against someone; to lash out, protest, or make a scene."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to lash out",
                                "target_lang_sense_clarification": "to react angrily or protest vehemently"
                            },
                            {
                                "target_lang_word": "to make a fuss",
                                "target_lang_sense_clarification": "to protest loudly or angrily"
                            },
                            {
                                "target_lang_word": "to kick up a fuss",
                                "target_lang_sense_clarification": "to complain or protest aggressively"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4184ace9-5767-379b-9ad6-3d5bf0b7b966",
                    "sense_definition": "Een kaart op tafel leggen of uitspelen bij een kaartspel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "kaartspel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>speelde</w> zijn kaarten <w>op</w>, met de mededeling dat alle slagen door hem gehaald zullen worden.",
                            "target_lang_translations": {
                                "en": "He <w>played</w> his cards, announcing that he would win all the tricks."
                            }
                        },
                        {
                            "text": "Je moet eerst een troefkaart <w>opspelen</w> voor je de rest kunt pakken.",
                            "target_lang_translations": {
                                "en": "You must first <w>play</w> a trump card before you can take the rest."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitspelen",
                        "opgooien"
                    ],
                    "common_phrases": [
                        "kaarten opspelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To play or lay down a card on the table in a card game."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to play",
                                "target_lang_sense_clarification": "a card in a game"
                            },
                            {
                                "target_lang_word": "to lead",
                                "target_lang_sense_clarification": "a card or suit in a card game"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}