                ],
                "senses": [
                    {
                        "sense_id": "70ecf667-7840-3eff-9eff-f04c34b1c9f5",
                        "entry_id": "dc0026a5-7297-37be-b771-b1f65b8a7067",
                        "glosses": [
                            "weibliche Person, die im Gebirge wandern geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5825285-ac1c-459a-9737-4f8c60c819f4",
                                "sense_id": "70ecf667-7840-3eff-9eff-f04c34b1c9f5",
                                "text": "„Diese Berggeherin macht 1700 Höhenmeter mit mir auf zwei Gipfel und beim Eintritt in ihr Haus kommt gleich die Frage, ob ich mit ihr schlafen will!“"
                            },
                            {
                                "example_id": "fae998a5-8608-49e5-9ab1-94d37cc3277a",
                                "sense_id": "70ecf667-7840-3eff-9eff-f04c34b1c9f5",
                                "text": "„Also, was ist, verweigerst du einer hungrigen und erschöpften Berggeherin das Gastrecht?““"
                            },
                            {
                                "example_id": "cf93a6ba-058e-472b-9b8c-f53f723fe8c4",
                                "sense_id": "70ecf667-7840-3eff-9eff-f04c34b1c9f5",
                                "text": "„Der Bergretter Liesel war eine begeisterte Berggeherin und hat einige Alpenüberquerungen absolviert.“"
                            },
                            {
                                "example_id": "06fb68b6-b07c-4313-8cad-c3eb9beff25e",
                                "sense_id": "70ecf667-7840-3eff-9eff-f04c34b1c9f5",
                                "text": "„Für mich als Berggeherin bietet Irland ein großes Betätigungsfeld, ich liebe das Gehen auf Wegen, die nicht »vorgefertigt« sind.“"
                            },
                            {
                                "example_id": "da7a4b8a-7e77-4abf-92de-3917dd571f6a",
                                "sense_id": "70ecf667-7840-3eff-9eff-f04c34b1c9f5",
                                "text": "„Zwölf Touren zu königlichen Hütten hat die begeisterte Berggeherin für das Buch beschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
