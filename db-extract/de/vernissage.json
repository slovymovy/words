                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7606e9b-e5f2-4f14-a47e-e97f9ee927b0",
                                "sense_id": "9d4db24f-c184-3ed3-a463-f68a40836cfd",
                                "text": "Man hat mich gerade von der Absage ihrer Vernissage in Kenntnis gesetzt. Wie schade, dass sie nicht stattfinden kann.",
                                "translation": "On vient de m’informer de l’annulation de son vernissage. Quel dommage qu’il ne puisse pas avoir lieu."
                            },
                            {
                                "example_id": "40cf446c-8a0f-4fe5-a132-c71859040ef0",
                                "sense_id": "9d4db24f-c184-3ed3-a463-f68a40836cfd",
                                "text": "Bei der Vernissage konnte man mit dem Künstler ausgiebig plaudern.",
                                "translation": "Lors du vernissage, on a pu abondamment papoter avec l’artiste."
                            }
                        ]
                    }
