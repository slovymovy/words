                ],
                "senses": [
                    {
                        "sense_id": "273ee80e-159b-3555-9262-5e4492748e7b",
                        "entry_id": "09994609-1fc5-3df1-bea8-d248cb884eaa",
                        "glosses": [
                            "истор. женск. к израильтянин; представительница древнееврейского народа, дочь Израиля"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c897561-8e95-4454-b220-9dd251a33f71",
                                "sense_id": "273ee80e-159b-3555-9262-5e4492748e7b",
                                "text": "Сестра Моисея Мириям увлекла израильтянок за собой в торжественной пляске воздать хвалу Богу после чудесного перехода через море, как рассказано в книге Исхода (15:21)."
                            }
                        ]
                    },
                    {
                        "sense_id": "f62d1cf6-8b80-3f05-af22-cee7d26734ef",
                        "entry_id": "09994609-1fc5-3df1-bea8-d248cb884eaa",
                        "glosses": [
                            "женск. к израильтянин; жительница или уроженка Израиля"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c54e6c9-5e62-433d-b06b-2a71b1d94eba",
                                "sense_id": "f62d1cf6-8b80-3f05-af22-cee7d26734ef",
                                "text": "Израильтянки служат в армии, некоторые в боевых частях. Но израильтянка призывного возраста имеет право заявить, что не может служить в армии по религиозным соображениям, и тогда по её желанию девушка проходит альтернативную службу на благо общества, или получает полное освобождение от службы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a528fd0-36ad-4e1c-a2ad-311184fa88f0",
                        "source_entry_id": "09994609-1fc5-3df1-bea8-d248cb884eaa",
                        "source_sense_description": "жительница Израиля",
                        "target_lang_word": "Israeli",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Israeli",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e639ba12-4183-3f48-adf1-bfcb2e6d7ff6",
                                        "entry_id": "1eefea2c-d4c3-3651-a2ca-08e86e83a8ad",
                                        "glosses": [
                                            "A person from Israel or of Israeli descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2842828-3dc5-4b52-aad1-5bc3317aebdd",
                                                "sense_id": "e639ba12-4183-3f48-adf1-bfcb2e6d7ff6",
                                                "text": "Until Israel’s critics figure out how to acknowledge the pain and suffering resulting from Palestinian terrorism and exterminationist rhetoric, by pointing the Palestinians and the Arabs toward real change, they will fail to sway those Israelis and Jews that are ready to take a shot at reconciliation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Israeli",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78686e8a-2a97-39f5-9cdb-e45c2eb1152b",
                                        "entry_id": "dc151239-a169-3aa9-b678-bafafe31d294",
                                        "glosses": [
                                            "Of, from, or pertaining to Israel or the Israeli people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2d0fc87-190a-4a06-8e7b-074f4e9b2e18",
                                                "sense_id": "78686e8a-2a97-39f5-9cdb-e45c2eb1152b",
                                                "text": "The current Israeli government has been working to curtail and eliminate critical voices within Israeli society in recent years, particularly those fighting to end the occupation and expose human rights violations against Palestinians and marginalized communities."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Israeli",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34694121-82c7-3c28-951f-97105a9af22f",
                                        "entry_id": "9c16cd8b-94f5-37dd-b4a7-ca60cbfc182f",
                                        "glosses": [
                                            "The modern Hebrew language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64772b8b-4b0d-4a77-91ad-3e4172448582",
                                                "sense_id": "34694121-82c7-3c28-951f-97105a9af22f",
                                                "text": "Thus, when most native Israeli-speakers speak Israeli, their intonation is much more similar to that of Yiddish, the mother tongue of most revivalists, than to that of Arabic or any other language belonging to the Semitic branch […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
