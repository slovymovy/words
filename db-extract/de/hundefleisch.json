                    {
                        "sense_id": "0a923ecd-dcc0-3878-971c-73e74de6b390",
                        "entry_id": "c56a8cbb-29c7-31ce-af54-7e81610824e6",
                        "glosses": [
                            "Fleisch, das von Hunden stammt"
