                "senses": [
                    {
                        "sense_id": "e40f1eb4-8b9b-33ba-83ca-4f55be32c450",
                        "entry_id": "0cb122bf-c1ff-3f4c-8bb3-20ce372aa61f",
                        "glosses": [
                            "провести ночь где-либо, как правило не дома"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9ca309a-529a-4ddb-9116-7864bd0f5869",
                                "sense_id": "e40f1eb4-8b9b-33ba-83ca-4f55be32c450",
                                "text": "Мы пообедали ананасным вареньем и печеньем, которые у нас случайно оказались, и переночевали на станции."
                            },
                            {
                                "example_id": "41c7fb40-129d-40a5-946b-82e2c41f5e7f",
                                "sense_id": "e40f1eb4-8b9b-33ba-83ca-4f55be32c450",
                                "text": "Сегодня переночуем на острове, а завтра полетим дальше, распорядился Самоделкин."
                            }
                        ]
                    }
                ],
