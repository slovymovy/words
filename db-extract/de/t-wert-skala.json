                                "example_id": "fc5f1412-84e7-4bd5-ba17-829c7530bf36",
                                "sense_id": "2315e6bb-ece3-393f-b058-9cc06213230d",
                                "text": "„In der Praxis wird man fast nur T-Wert-Skalen finden, die von T-Wert 20 bis T-Wert 80 reichen.“"
                            },
                            {
                                "example_id": "4690428b-c54e-4fa0-a800-dd50ee3dd525",
                                "sense_id": "2315e6bb-ece3-393f-b058-9cc06213230d",
                                "text": "„Die T-Wert-Skala hat einen Mittelwert von 50 und eine Standardabweichung von 10.“"
                            },
                            {
                                "example_id": "c25225c6-e798-4d59-b6d2-784fe4e1cd53",
                                "sense_id": "2315e6bb-ece3-393f-b058-9cc06213230d",
                                "text": "„Die PR-Skala und T-Wert-Skala werden häufig bei standardisierten Verfahren zur objektivierten Ermittlung von Schülerleistungen und -fähigkeiten als Norm- Maßstäbe verwendet.“"
                            }
