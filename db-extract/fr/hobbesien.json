                                        "sense_id": "c2f92501-3b50-3794-8d62-1b21c944aa8b",
                                        "entry_id": "c3dc2f20-0658-3ed6-a229-2665f325ae94",
                                        "glosses": [
                                            "Rare form of Hobbesian."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3be00dfc-7758-4647-9f7f-98774d35ba6d",
                                                "sense_id": "c2f92501-3b50-3794-8d62-1b21c944aa8b",
                                                "text": "They make fun of Thom's \"Einstein in sheepskin\" and see the life of ancient Avebury in a Hobbsian way as \"nasty, brutish, and short.\" They forget that ancient Ireland transformed the emergence of Western Europe in the Dark Ages, and that ancient Ireland did not store knowledge in cities, but in rural monasteries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
