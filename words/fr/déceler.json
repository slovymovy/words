    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6d4f369e-8980-37a2-8b7e-62484c954836",
                    "sense_definition": "Découvrir ou apercevoir ce qui est difficile à percevoir ou dissimulé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les analyses médicales ont permis de <w>déceler</w> la maladie avant l'apparition des premiers symptômes."
                        },
                        {
                            "text": "L'audit a permis de <w>déceler</w> une anomalie majeure dans les comptes de l'entreprise."
                        }
                    ],
                    "synonyms": [
                        "détecter",
                        "découvrir"
                    ],
                    "common_phrases": [
                        "déceler une anomalie",
                        "déceler des indices"
                    ]
                },
                {
                    "sense_id": "294192e4-5794-37f4-9065-63da90326139",
                    "sense_definition": "Laisser paraître ou révéler ce que l'on cherche à cacher.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "revelation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son regard fuyant et son ton hésitant <w>décèlent</w> une vive inquiétude."
                        },
                        {
                            "text": "Rien dans son attitude ne <w>décelait</w> ses véritables intentions lors de cette négociation tendue."
                        }
                    ],
                    "synonyms": [
                        "révéler",
                        "dévoiler"
                    ],
                    "common_phrases": [
                        "déceler ses intentions",
                        "déceler un malaise"
                    ]
                },
                {
                    "sense_id": "103d8088-3eeb-3f1c-b370-08f09f196ce4",
                    "sense_definition": "Faire connaître ou démasquer quelqu'un qui veut rester caché.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "revelation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'espion prenait garde d'agir prudemment pour que personne ne vienne le <w>déceler</w>."
                        },
                        {
                            "text": "Le témoin anonyme redoutait qu'une indiscrétion ne finisse par le <w>déceler</w> auprès des suspects."
                        }
                    ],
                    "synonyms": [
                        "dévoiler"
                    ]
                },
                {
                    "sense_id": "deb4060b-047d-3121-8b3f-d208408df9b5",
                    "sense_definition": "Se manifester ou devenir perceptible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une légère pointe d'agacement se <w>décelait</w> dans sa voix malgré ses efforts pour sourire."
                        },
                        {
                            "text": "Aucun défaut de fabrication ne se <w>décèle</w> à la surface de cette pièce métallique."
                        }
                    ],
                    "synonyms": [
                        "se montrer"
                    ],
                    "common_phrases": [
                        "se déceler facilement"
                    ]
                }
            ]
        }
    ]
