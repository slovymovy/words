    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f2833dd8-27b7-3fae-83ca-49d82f6e023c",
                "word": "claviger",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b0a5678f-d6f1-4ae8-937d-1ec97c49977a",
                        "entry_id": "f2833dd8-27b7-3fae-83ca-49d82f6e023c",
                        "tags": [
                            "plural"
                        ],
                        "form": "clavigers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f96fb7c-2452-3a40-bb43-098f2ec634d9",
                        "entry_id": "f2833dd8-27b7-3fae-83ca-49d82f6e023c",
                        "glosses": [
                            "One who carries a club; a club bearer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ba8e598-69cc-417b-ae1e-d23f07665c9e",
                                "sense_id": "1f96fb7c-2452-3a40-bb43-098f2ec634d9",
                                "text": "They goaded him into testing one of his planes, tricked him into throwing one out of the window to see if it would glide, and it did; it glided right into a claviger patrolling outside."
                            },
                            {
                                "example_id": "d731a38a-091f-4218-9968-8a0ac9fc6e6d",
                                "sense_id": "1f96fb7c-2452-3a40-bb43-098f2ec634d9",
                                "text": "But he was the claviger, and he took that duty seriously. And he never helped her. He followed her, to protect her, because that was his job."
                            }
                        ]
                    },
                    {
                        "sense_id": "df3d9604-21d5-38d1-a0eb-32e8fc819e22",
                        "entry_id": "f2833dd8-27b7-3fae-83ca-49d82f6e023c",
                        "glosses": [
                            "A group within genus Lasius (formerly considered a subgenera Acanthomyops) of bright yellow to orange species of ant that have 3 maxillary palps and give off a distinctive citronella odor when disturbed. The group name comes from their club-shaped palps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3876ff9-7836-437e-acb5-ba937457a779",
                                "sense_id": "df3d9604-21d5-38d1-a0eb-32e8fc819e22",
                                "text": "Standing body hairs are relatively less numerous and longer in claviger."
                            },
                            {
                                "example_id": "c919ab74-bcfd-4ff4-8bdd-3c2a593c9698",
                                "sense_id": "df3d9604-21d5-38d1-a0eb-32e8fc819e22",
                                "text": "The workers of flavus group species are sometimes confused with claviger group workers, but can be distinguished by relatively dense pubescence all over the body, which creates a dull overall appearances."
                            },
                            {
                                "example_id": "7387d763-d679-4518-a4b4-aa620517915e",
                                "sense_id": "df3d9604-21d5-38d1-a0eb-32e8fc819e22",
                                "text": "All of the species of the claviger group are believed to be temporary social parasits of other Lasius species, but the actual hosts are not all known."
                            }
                        ]
                    },
                    {
                        "sense_id": "6aaece34-8018-3032-85a4-4fce93102a51",
                        "entry_id": "f2833dd8-27b7-3fae-83ca-49d82f6e023c",
                        "glosses": [
                            "A species of mosquito, Anopheles claviger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "875ef5d3-5654-4a18-8e00-e325541b7683",
                                "sense_id": "6aaece34-8018-3032-85a4-4fce93102a51",
                                "text": "Over much of its range claviger lays eggs without a blood meal, whereas forms requiring blood for egg laying have been observed on the Black Sea coast."
                            },
                            {
                                "example_id": "001a1578-66f2-41cd-bec8-3058020b7a3e",
                                "sense_id": "6aaece34-8018-3032-85a4-4fce93102a51",
                                "text": "Claviger is Palearctic in distribution, extending from the British Isles to the Pamir Mountains of Turkestan and the Ob River of western Siberia."
                            },
                            {
                                "example_id": "6ecd90a5-9e9a-4bfb-8a3d-d1b40dcb08d2",
                                "sense_id": "6aaece34-8018-3032-85a4-4fce93102a51",
                                "text": "The usual breeding places of claviger are springs and wells."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "59a0d0d4-1c4b-341e-81d2-c91753e8fe41",
