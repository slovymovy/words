                "translations": [
                    {
                        "translation_id": "88899e4a-cc72-4d25-a319-748342843280",
                        "source_entry_id": "daf59f51-1f81-3cdf-8380-8d8474443a75",
                        "source_sense_id": "0abbb196-85b5-3fc6-b96b-2bb040da26cf",
                        "source_sense_description": "nachahmender Künstler, Konstrukteur oder Ähnliches ohne eigene Ideen",
                        "target_lang_word": "epigone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epigone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e19f2865-1f67-3e51-8b75-82e9cd4ad1c4",
                                        "entry_id": "34dc7e6c-bf37-315b-8d79-70d71f690b3c",
                                        "glosses": [
                                            "A follower or disciple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "074e3e8e-9e92-4d6b-a514-fca4859c39b8",
                                                "sense_id": "e19f2865-1f67-3e51-8b75-82e9cd4ad1c4",
                                                "text": "India is run by gerontocrats and epigones: grey hairs and groomed heirs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f35d7a9-3230-374e-b48f-d05f2771b706",
                                        "entry_id": "34dc7e6c-bf37-315b-8d79-70d71f690b3c",
                                        "glosses": [
                                            "An undistinguished or inferior imitator of a well known artist or their style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6907fd9c-c27b-4ec3-ac47-3342a3a934f5",
                                                "sense_id": "2f35d7a9-3230-374e-b48f-d05f2771b706",
                                                "text": "While Shaler remained subordinate, he followed Agassiz’s intellectual lead, often with the epigone’s habit of exaggerating his master’s voice."
                                            },
                                            {
                                                "example_id": "3a869383-4d75-4d5c-a100-bf5bc94c9438",
                                                "sense_id": "2f35d7a9-3230-374e-b48f-d05f2771b706",
                                                "text": "In another twist to the myth, his Head of Department, the ageless and loathsome Vermishank, was not a plodding epigone but an exceptional bio-thaumaturge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d5fa386-5976-4931-95dd-ff43ba861e2f",
                        "source_entry_id": "daf59f51-1f81-3cdf-8380-8d8474443a75",
                        "source_sense_id": "0abbb196-85b5-3fc6-b96b-2bb040da26cf",
                        "source_sense_description": "nachahmender Künstler, Konstrukteur oder Ähnliches ohne eigene Ideen",
                        "target_lang_word": "epigone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2c32bb9f-7f23-4cf1-8a9f-bd76be922c61",
                        "source_entry_id": "daf59f51-1f81-3cdf-8380-8d8474443a75",
                        "source_sense_id": "0abbb196-85b5-3fc6-b96b-2bb040da26cf",
                        "source_sense_description": "nachahmender Künstler, Konstrukteur oder Ähnliches ohne eigene Ideen",
                        "target_lang_word": "epigon",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epigon",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "ce30c0f1-0d38-38e8-8dd0-a226c9479282",
                                        "entry_id": "b64f7d07-f60b-3bae-8988-227367bdf150",
                                        "glosses": [
                                            "nietwórczy, pozbawiony oryginalności naśladowca wielkich, utalentowanych poprzedników; kontynuator nieaktualnych idei, prądów, stylów"
                                        ],
                                        "tags": [
                                            "literary",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "372520ba-fb5e-4b49-b97e-7b1eea211bd1",
                                                "sense_id": "ce30c0f1-0d38-38e8-8dd0-a226c9479282",
                                                "text": "Olga, którą jeszcze w roku 1909 zaliczano do grona młodych, dobrze zapowiadających się malarek (…), po dziesięciu raptem latach znalazła się nagle pośród malarzy XIX-wiecznych, epigonów stylu, któremu wojna nie dała w pełni zaznać powodzenia i któremu nowa, powojenna publiczność nie okazywała już dawnego zainteresowania"
                                            },
                                            {
                                                "example_id": "30f785b7-ff0d-4ca6-88cb-0a42460a8921",
                                                "sense_id": "ce30c0f1-0d38-38e8-8dd0-a226c9479282",
                                                "text": "Nie miał mistrzów, nie pozostawił ani uczniów, ani epigonów. W jego przypadku najbardziej trafnie sprawdza się stara chińska maksyma – być mistrzem to znaczy, być niepodobnym do nikogo"
                                            },
                                            {
                                                "example_id": "d727a78c-5e6f-4723-9985-301ce83d558a",
                                                "sense_id": "ce30c0f1-0d38-38e8-8dd0-a226c9479282",
                                                "text": "Jaworski wydaje się dziś jednak epigonem Witkacego, chociaż to nieprawda"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
