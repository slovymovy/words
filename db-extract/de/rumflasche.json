                "senses": [
                    {
                        "sense_id": "06285101-c25e-3194-97b6-ca4cd46fc932",
                        "entry_id": "7b200d44-f29f-327c-bed3-da96545ef535",
                        "glosses": [
                            "Flasche, in der Rum aufbewahrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdc4637c-d11b-4e04-bd7c-071032529853",
                                "sense_id": "06285101-c25e-3194-97b6-ca4cd46fc932",
                                "text": "In einem Spirituosengeschäft kann man auch Rumflaschen finden."
                            },
                            {
                                "example_id": "24761dd3-12f9-44ce-98a8-6bf258464f9c",
                                "sense_id": "06285101-c25e-3194-97b6-ca4cd46fc932",
                                "text": "„Neben einem menschlichen Skelett seien eine Armbanduhr, ein Löffel, Schneeschuhe, ein Messer und eine aus Bruchstücken einer Rumflasche gebastelte Sonnenbrille gefunden worden.“"
                            },
                            {
                                "example_id": "a98d4bdf-06ce-4fe5-96d5-d82a5915332e",
                                "sense_id": "06285101-c25e-3194-97b6-ca4cd46fc932",
                                "text": "„Die Rumflasche ist ein Geschenk für die Grossmutter, eine Trinkerin vor dem Herrn, wie die Enkelinnen lachend sagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
