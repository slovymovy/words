                    {
                        "translation_id": "b04a8593-2fc5-4138-b4e9-136c3223fb1b",
                        "source_entry_id": "1ca31f5a-de1b-3699-97b1-e5529cfa57a9",
                        "source_sense_id": "17ef087f-c48a-3222-aed0-ca9f752046a3",
