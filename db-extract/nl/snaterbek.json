                        "examples": [
                            {
                                "example_id": "fb638727-b15e-4dfe-8795-02ed3c85c497",
                                "sense_id": "4d87e14e-8c0a-3abd-8c80-94a7eef303d9",
                                "text": "Al op haar zevende moet Joy doordeweeks weer naar een gehandicapteninstelling, omdat moeder het niet meer trekt. Van meet af aan voelt Joy zich daar niet thuis. „Het mocht dan gemakkelijker zijn, geholpen worden bij uitkleden en naar de wc gaan, maar de ’echte dingen’ -boodschappen doen, buiten spelen, vies worden- waren er niet meer. Die zaten in de Grote Wereld. Ik voelde me diep ongelukkig.” Ze botst met haar leeftijdsgenootjes die zich de verzorging laten aanleunen -zij noemen haar „juffrouw Snaterbek”- én met de verzorgers - „je bent brutaal.”"
                            }
                        ]
                    }
