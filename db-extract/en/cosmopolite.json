                                            {
                                                "example_id": "747c4bd1-0f40-4df5-b1f6-78f13bb74437",
                                                "sense_id": "3bf7d94f-5f4c-354b-a90f-ae7ce1134592",
                                                "text": "„Auf einmal fühlten sie sich wie Weltbürger, nur wenige Kilometer von Neuseeland entfernt.“"
                                            },
                                            {
                                                "example_id": "f0751753-3ad0-4051-b794-1ac6f12c2748",
