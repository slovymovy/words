                "senses": [
                    {
                        "sense_id": "2d7e6a0b-9c6a-3a78-a828-4574ac057daa",
                        "entry_id": "66e1ffc5-30c2-33a0-a471-0added36d6f9",
                        "glosses": [
                            "rodzaj prymitywnego pieczywa w postaci małego placka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db6a66cf-ceca-4d47-b79f-43447e101679",
                                "sense_id": "2d7e6a0b-9c6a-3a78-a828-4574ac057daa",
                                "text": "Jeżeli chcesz złożyć w darze jako ofiarę pokarmową ciasto pieczone w piecu, będą to placki przaśne z najczystszej mąki zaprawionej oliwą albo przaśne podpłomyki, pomazane oliwą"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5954599c-c58c-454c-b8dc-1c1270e3e58f",
                        "source_entry_id": "66e1ffc5-30c2-33a0-a471-0added36d6f9",
                        "source_sense_id": "2d7e6a0b-9c6a-3a78-a828-4574ac057daa",
                        "target_lang_word": "podplamenice",
                        "target_lang_code": "cs",
