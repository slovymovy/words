{
    "word_family": [
        "straiten",
        "straitlaced",
        "straitjacket"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b3b69592-e25a-3ab4-aceb-87db702158be",
                    "sense_definition": "A narrow waterway or channel connecting two larger bodies of water.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship navigated through the narrow <w>strait</w> carefully.",
                            "target_lang_translations": {
                                "tr": "Gemi dar <w>boğazdan</w> dikkatlice geçti.",
                                "zh": "船只小心翼翼地穿过了那条狭窄的<w>海峡</w>。"
                            }
                        },
                        {
                            "text": "Many trading vessels pass through the <w>Strait</w> of Gibraltar every day.",
                            "target_lang_translations": {
                                "tr": "Her gün birçok ticaret gemisi Cebelitarık <w>Boğazı'ndan</w> geçer.",
                                "zh": "每天都有许多商船通过直布罗陀<w>海峡</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "channel",
                        "sound"
                    ],
                    "common_phrases": [
                        "Strait of Gibraltar",
                        "narrow strait"
                    ],
                    "target_lang_definitions": {
                        "tr": "İki büyük su kütlesini birbirine bağlayan dar su yolu veya geçit.",
                        "zh": "连接两个较大水域的狭窄水道或海峡。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "boğaz",
                                "target_lang_sense_clarification": "iki kara arasındaki dar deniz veya su yolu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "海峡",
                                "target_lang_sense_clarification": "连接两个海洋或大湖的狭窄水道"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f95cc275-fb33-3f2c-8ee3-551be609a32a",
                    "sense_definition": "A difficult, troubled, or distressing situation (usually used in plural).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was in dire <w>straits</w> after losing its main investor.",
                            "target_lang_translations": {
                                "tr": "Şirket, ana yatırımcısını kaybettikten sonra büyük bir <w>darboğaza</w> girdi.",
                                "zh": "在失去主要投资者后，该公司陷入了严重的<w>困境</w>。"
                            }
                        },
                        {
                            "text": "Without financial aid, they will remain in severe economic <w>straits</w>.",
                            "target_lang_translations": {
                                "tr": "Finansal yardım olmadan ciddi ekonomik <w>sıkıntı içinde</w> kalacaklar.",
                                "zh": "如果没有经济援助，他们将继续处于严重的经济<w>窘境</w>中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plight",
                        "predicament",
                        "hardship"
                    ],
                    "common_phrases": [
                        "dire straits",
                        "financial straits",
                        "economic straits"
                    ],
                    "target_lang_definitions": {
                        "tr": "Zor, sıkıntılı veya kriz dolu durum (genellikle çoğul kullanılır).",
                        "zh": "困难、困境或窘迫的处境（通常用复数）。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dar boğaz",
                                "target_lang_sense_clarification": "maddi veya genel kriz, sıkıntılı durum"
                            },
                            {
                                "target_lang_word": "sıkıntı",
                                "target_lang_sense_clarification": "zor durum, dar geçit"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "困境",
                                "target_lang_sense_clarification": "难以摆脱的窘迫处境"
                            },
                            {
                                "target_lang_word": "窘境",
                                "target_lang_sense_clarification": "经济或生活上的困难状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4756e8e5-c4b6-3118-8da6-365cf1cfc242",
                    "sense_definition": "A narrow pass, passage, or street.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers squeezed through the rocky <w>strait</w> between the two cliffs.",
                            "target_lang_translations": {
                                "tr": "Gezginler iki uçurum arasındaki kayalık <w>dar geçitten</w> sıkışarak geçtiler.",
                                "zh": "旅行者们挤过了两座悬崖之间那条岩石嶙峋的<w>隘口</w>。"
                            }
                        },
                        {
                            "text": "Only one person at a time could move down the narrow <w>strait</w>.",
                            "target_lang_translations": {
                                "tr": "Dar <w>geçitten</w> tek seferde sadece bir kişi ilerleyebiliyordu.",
                                "zh": "一次只能有一个人通过那条狭窄的<w>通道</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pass",
                        "defile",
                        "passage"
                    ],
                    "common_phrases": [
                        "narrow strait"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or literary in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Dar bir geçit veya yol.",
                        "zh": "狭窄的通道、隘口或街道。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dar geçit",
                                "target_lang_sense_clarification": "dağ veya kayalıklar arasındaki dar yol"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "隘口",
                                "target_lang_sense_clarification": "山间狭窄的通道"
                            },
                            {
                                "target_lang_word": "狭道",
                                "target_lang_sense_clarification": "狭窄的通行路径"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "117dd9f3-15a5-3a64-aa04-9dbdc4ac2004",
                    "sense_definition": "A narrow strip of land linking two larger land masses; an isthmus.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A dark <w>strait</w> of barren land connected the peninsula to the mainland.",
                            "target_lang_translations": {
                                "tr": "Çorak araziden oluşan karanlık bir <w>berzah</w> yarımadayı karaya bağlıyordu.",
                                "zh": "一条贫瘠的深色<w>地峡</w>将半岛与大陆连接了起来。"
                            }
                        },
                        {
                            "text": "They built a small fortress to guard the narrow <w>strait</w>.",
                            "target_lang_translations": {
                                "tr": "Dar <w>kıstayı</w> korumak için küçük bir kale inşa ettiler.",
                                "zh": "他们建造了一座小堡垒来守卫那条狭窄的<w>地峡</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "isthmus",
                        "neck"
                    ],
                    "common_phrases": [
                        "strait of land"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "İki büyük kara parçasını bağlayan dar kara şeridi; berzah.",
                        "zh": "连接两块较大陆地的狭长地带；地峡。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "berzah",
                                "target_lang_sense_clarification": "kara kıstayı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地峡",
                                "target_lang_sense_clarification": "连接两块陆地的狭窄陆地"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cc2aa6da-6476-3054-befe-236644647a82",
                    "sense_definition": "Strict, rigorous, or morally uncompromising.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "strictness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried his best to follow the <w>strait</w> and narrow path of honesty.",
                            "target_lang_translations": {
                                "tr": "Dürüstlüğün <w>doğru</w> ve dürüst yolundan gitmek için elinden geleni yaptı.",
                                "zh": "他尽最大努力遵循诚实这一<w>严格</w>而正确的道路。"
                            }
                        },
                        {
                            "text": "The strict religious community adhered to very <w>strait</w> rules.",
                            "target_lang_translations": {
                                "tr": "Katı dini topluluk çok <w>sıkı</w> kurallara bağlıydı.",
                                "zh": "这个严格的宗教团体遵守着非常<w>严格</w>的规章。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strict",
                        "rigorous",
                        "exacting"
                    ],
                    "antonyms": [
                        "lenient"
                    ],
                    "common_phrases": [
                        "strait and narrow",
                        "strait rule"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mostly survives in set phrases like 'strait and narrow'"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Katı, sıkı veya ahlaki olarak tavizsiz.",
                        "zh": "严格的、严谨的或道德上不妥协的。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sıkı",
                                "target_lang_sense_clarification": "katı kural veya tutum"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "严格的",
                                "target_lang_sense_clarification": "遵守规则或标准"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b97569a-73ac-392a-ab65-4b41a0043f03",
                    "sense_definition": "Narrow or restricted in space.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "narrowness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoners were kept in a <w>strait</w> enclosure with little room to move.",
                            "target_lang_translations": {
                                "tr": "Mahkumlar hareket edecek az yeri olan <w>dar</w> bir alanda tutuluyordu.",
                                "zh": "囚犯们被关在一个几乎没有活动空间的<w>狭窄</w>围栏里。"
                            }
                        },
                        {
                            "text": "Enter by the <w>strait</w> gate, for wide is the path to destruction.",
                            "target_lang_translations": {
                                "tr": "<w>Dar</w> kapıdan girin, çünkü yıkıma giden yol geniştir.",
                                "zh": "你们要进<w>狭窄</w>的门，因为通往毁灭的路是宽阔的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "narrow",
                        "confined",
                        "restricted"
                    ],
                    "antonyms": [
                        "wide",
                        "broad"
                    ],
                    "common_phrases": [
                        "strait gate",
                        "strait enclosure"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Replaced by 'narrow' in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Dar veya alanca kısıtlı.",
                        "zh": "空间狭窄或受限的。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dar",
                                "target_lang_sense_clarification": "kısıtlı alan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狭窄的",
                                "target_lang_sense_clarification": "空间有限的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ed68213-8bb8-328c-b60a-5b4e2eff432d",
                    "sense_definition": "Fitting very tightly or closely.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "narrowness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight adjusted his <w>strait</w> jacket before going into battle.",
                            "target_lang_translations": {
                                "tr": "Şövalye savaşa girmeden önce <w>dar</w> ceketini düzeltti.",
                                "zh": "骑士在投入战斗前调整了一下他那件<w>紧身</w>上衣。"
                            }
                        },
                        {
                            "text": "Her collar was so <w>strait</w> that it was uncomfortable to breathe.",
                            "target_lang_translations": {
                                "tr": "Yakası o kadar <w>sıkıydı</w> ki nefes almak rahatsız ediciydi.",
                                "zh": "她的领子太<w>紧</w>了，以至于呼吸都感到不舒服。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tight",
                        "close-fitting"
                    ],
                    "antonyms": [
                        "loose"
                    ],
                    "common_phrases": [
                        "strait jacket",
                        "strait garment"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Replaced by 'tight' in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Çok sıkı veya dar oturan.",
                        "zh": "非常紧或贴身的。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dar",
                                "target_lang_sense_clarification": "sıkı oturan giysi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧身的",
                                "target_lang_sense_clarification": "衣物贴合身体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9aabef73-06d2-3f2b-a910-24021300f3b9",
                    "sense_definition": "Characterized by difficulty, hardship, or financial distress.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had to manage their budget during these <w>strait</w> circumstances.",
                            "target_lang_translations": {
                                "tr": "Bu <w>sıkıntılı</w> koşullarda bütçelerini idare etmek zorundaydılar.",
                                "zh": "在这些<w>拮据</w>的情况下，他们不得不精打细算。"
                            }
                        },
                        {
                            "text": "Living in <w>strait</w> financial conditions forced them to cut back expenses.",
                            "target_lang_translations": {
                                "tr": "<w>Kısıtlı</w> maddi koşullarda yaşamak onları masrafları kısmaya zorladı.",
                                "zh": "生活在<w>拮据</w>的经济条件下，迫使他们削减开支。"
                            }
                        }
                    ],
                    "synonyms": [
                        "difficult",
                        "distressful",
                        "meager"
                    ],
                    "antonyms": [
                        "prosperous"
                    ],
                    "common_phrases": [
                        "strait circumstances"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rare except in formal or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Zorluk, sıkıntı veya maddi darboğaz ile karakterize edilen.",
                        "zh": "以困难、艰苦或经济拮据为特征的。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sıkıntılı",
                                "target_lang_sense_clarification": "maddi veya genel zorluk içeren"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拮据的",
                                "target_lang_sense_clarification": "经济困难的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0dc8812-ea4c-3153-bc5b-c06e4099276d",
                    "sense_definition": "Close, intimate, or familiar.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "closeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He maintained a <w>strait</w> friendship with the king for many years.",
                            "target_lang_translations": {
                                "tr": "Kral ile uzun yıllar <w>yakın</w> bir dostluk sürdürdü.",
                                "zh": "他与国王保持了多年的<w>亲密</w>友谊。"
                            }
                        },
                        {
                            "text": "They enjoyed a <w>strait</w> degree of trust with one another.",
                            "target_lang_translations": {
                                "tr": "Birbirleriyle <w>yakın</w> derecede bir güven bağına sahiplerdi.",
                                "zh": "他们彼此之间享有高度的<w>亲密</w>信任。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intimate",
                        "close"
                    ],
                    "antonyms": [
                        "distant"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Yakın, samimi veya dostane.",
                        "zh": "亲密的、熟悉的或友好的。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yakın",
                                "target_lang_sense_clarification": "samimi ilişki"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亲密的",
                                "target_lang_sense_clarification": "关系密切的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6e42fbc-e605-36ac-aa86-59ce48a6b0ec",
                    "sense_definition": "Parsimonious; excessively frugal or stingy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "frugality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old merchant was so <w>strait</w> that he refused to buy basic necessities.",
                            "target_lang_translations": {
                                "tr": "Yaşlı tüccar o kadar <w>cimriydi</w> ki temel ihtiyaçları bile almayı reddediyordu.",
                                "zh": "那位老商人太<w>吝啬</w>了，连基本的生活必需品都不愿买。"
                            }
                        },
                        {
                            "text": "He was known to be <w>strait</w> with his money when dealing with servants.",
                            "target_lang_translations": {
                                "tr": "Hizmetçilerle olan ilişkilerinde parası konusunda <w>sıkı</w> davranmasıyla bilinirdi.",
                                "zh": "众所周知，他在对待仆人时对钱财非常<w>吝啬</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stingy",
                        "parsimonious",
                        "mean"
                    ],
                    "antonyms": [
                        "generous"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Aşırı tutumlu, cimri.",
                        "zh": "吝啬的；过度节俭或小气的。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "cimri",
                                "target_lang_sense_clarification": "parada aşırı tutumlu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吝啬的",
                                "target_lang_sense_clarification": "在金钱上过度节俭"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cff0af8a-dc84-3e3d-9613-c8699a2c7a0d",
                    "sense_definition": "Obsolete spelling of <w>straight</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old manuscript, a <w>strait</w> line was drawn across the page.",
                            "target_lang_translations": {
                                "tr": "Eski el yazmasında sayfa boyunca <w>düz</w> bir çizgi çizilmişti.",
                                "zh": "在那份旧手稿中，页面上画了一条<w>直</w>线。"
                            }
                        },
                        {
                            "text": "The path was laid out in a <w>strait</w> direction through the forest.",
                            "target_lang_translations": {
                                "tr": "Yol ormanın içinden <w>düz</w> bir doğrultuda ilerliyordu.",
                                "zh": "这条小路穿过森林，方向是<w>直</w>的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Historical spelling variant"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "\"Straight\" (düz) sözcüğünün eski yazılış biçimi.",
                        "zh": "straight（直的）的过时拼写。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "düz",
                                "target_lang_sense_clarification": "eski imla biçimi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "直的",
                                "target_lang_sense_clarification": "方向或形状"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
