                                    },
                                    {
                                        "sense_id": "9662982a-3040-3c7c-b120-0cbe85881632",
                                        "entry_id": "72f2623b-48fe-3321-958a-bacae2a8332e",
                                        "glosses": [
                                            "A piece of a person's suit, beside trousers and, sometimes, waistcoat; coat (US)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c447510-a47a-3923-8fd3-770c42ee43fd",
                                        "entry_id": "72f2623b-48fe-3321-958a-bacae2a8332e",
                                        "glosses": [
                                            "A protective or insulating cover for an object (e.g. a book, hot water tank, bullet.)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8d5cba5-fea4-31b1-a447-ee1237881259",
                                        "entry_id": "72f2623b-48fe-3321-958a-bacae2a8332e",
                                        "glosses": [
                                            "A police record."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "113d10b7-5912-4c17-9cd4-6846048d06d1",
                                                "sense_id": "a8d5cba5-fea4-31b1-a447-ee1237881259",
                                                "text": "We got a crowd of black, white customers, out-of-state license plates, what have you. Somebody gonna check that out. They gonna drop a dime on me, call 911. And you know with my jacket I can't go back to jail."
                                            },
                                            {
                                                "example_id": "40e25565-ae8c-4ceb-bc2b-aacf57f04b48",
                                                "sense_id": "a8d5cba5-fea4-31b1-a447-ee1237881259",
                                                "text": "Yo's jacket shows possession with intent, possession of unlicensed firearm, and assault, for which he still owes three years."
                                            },
                                            {
                                                "example_id": "3116c5f3-95e3-4454-9eb0-1b6c0e4d10bf",
                                                "sense_id": "a8d5cba5-fea4-31b1-a447-ee1237881259",
                                                "text": "\"I need to look up somebody's jacket.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7190f67-57f3-3800-a8ae-ed758be7fae7",
                                        "entry_id": "72f2623b-48fe-3321-958a-bacae2a8332e",
                                        "glosses": [
                                            "In ordnance, a strengthening band surrounding and reinforcing the tube in which the charge is fired."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d09c59d-97c0-3f8e-8f34-32ae300f631b",
                                        "entry_id": "72f2623b-48fe-3321-958a-bacae2a8332e",
                                        "glosses": [
                                            "The tough outer skin of a baked potato."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a124df7-c6bb-4db7-a290-c02b47efbf4f",
                                                "sense_id": "1d09c59d-97c0-3f8e-8f34-32ae300f631b",
                                                "text": "Cook the potatoes in their jackets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b3023c5-7f98-398b-8c8f-bf1a55097f84",
                                        "entry_id": "72f2623b-48fe-3321-958a-bacae2a8332e",
                                        "glosses": [
                                            "A bastard child, in particular one whose father is unaware that he is not the child’s biological father."
                                        ],
                                        "tags": [
                                            "Jamaica"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3929bf7c-9921-3e5c-a1c7-04266fce47b4",
                                        "entry_id": "72f2623b-48fe-3321-958a-bacae2a8332e",
                                        "glosses": [
                                            "A vest (US); a waistcoat (UK)."
                                        ],
                                        "tags": [
                                            "Appalachia"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "jacket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36f283f9-f682-3650-9dbd-3f4033c75fe7",
                                        "entry_id": "1ca85fc1-f169-3e9b-9e07-4e61ade6f208",
                                        "glosses": [
                                            "To confine (someone) to a straitjacket."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "984d38f0-bbc6-4c59-b513-b7846bcffffa",
                                                "sense_id": "36f283f9-f682-3650-9dbd-3f4033c75fe7",
                                                "text": "‘None of your gab, I tell you! If you speak another word, I'll have you jacketed[…]!’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec2cc643-b7a8-3905-9cfb-a47591d6bd8e",
                                        "entry_id": "1ca85fc1-f169-3e9b-9e07-4e61ade6f208",
                                        "glosses": [
                                            "To enclose or encase in a jacket or other covering."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf98cd7f-8834-4d6c-9650-c7b9da29ca7f",
                                                "sense_id": "ec2cc643-b7a8-3905-9cfb-a47591d6bd8e",
                                                "text": "...to...prevent...the loss of heat...there is also a layer of silicate cotton or slag wool. This latter material is also employed to jacket the chimney for a certain portion of its length."
                                            },
                                            {
                                                "example_id": "4ade6554-b515-4a00-b654-a9db1fc95a3b",
                                                "sense_id": "ec2cc643-b7a8-3905-9cfb-a47591d6bd8e",
                                                "text": "By jacketting the mercury tube determinations can be made at any temperature desired."
                                            },
                                            {
                                                "example_id": "817487d4-c99c-4f4b-937e-150033423e20",
                                                "sense_id": "ec2cc643-b7a8-3905-9cfb-a47591d6bd8e",
                                                "text": "By jacketting the rod and putting the whole resonant-bar device in a pressure vessel, the intrinsic attenuation can be measured under helium confining pressure."
                                            },
                                            {
                                                "example_id": "4cbbb956-fbce-4a23-8c2c-08b85f269d3a",
                                                "sense_id": "ec2cc643-b7a8-3905-9cfb-a47591d6bd8e",
                                                "text": "Jaw has been exposed for preserving and jacketting. Note other bone fragments near jaw."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b541d0bc-cdb4-453b-910e-ddfc55130c9c",
                        "source_entry_id": "68731e5c-16bf-30e7-91de-bf7c5b6c7bae",
                        "source_sense_id": "c7e602e3-7dc6-35d8-9ac2-f17c960944c9",
                        "target_lang_word": "veste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff0d4735-9f4e-37a5-96ee-7ced6318b39f",
                                        "entry_id": "95aabae1-3c02-317d-ba29-05189bdbb6ea",
                                        "glosses": [
                                            "Sorte de vêtement court et sans basques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb7ccd73-d6b6-430c-b09a-e42c32d2ef52",
                                                "sense_id": "ff0d4735-9f4e-37a5-96ee-7ced6318b39f",
                                                "text": "— Pourquoi le caches-tu ? avait demandé Hortense. — Il est en veste, avait répliqué la vieille fille en riant."
                                            },
                                            {
                                                "example_id": "8569472d-e39a-49a2-8090-f08f40321623",
                                                "sense_id": "ff0d4735-9f4e-37a5-96ee-7ced6318b39f",
                                                "text": "Les femmes, très coquettes, revêtent en général le costume traditionnel ; la petite veste très serrée moulant le torse et les bras, passe dans la ceinture d’une culotte flottante."
                                            },
                                            {
                                                "example_id": "1e85cab7-38b9-4c2e-bcdf-d6e92094f0d2",
                                                "sense_id": "ff0d4735-9f4e-37a5-96ee-7ced6318b39f",
                                                "text": "Elle revint habillée d’un tailleur noir, hyper-sexy, la veste bâillant sur une poitrine à damner un intégriste."
                                            },
                                            {
                                                "example_id": "92638c70-f285-40f9-a49e-bc38b136b84e",
                                                "sense_id": "ff0d4735-9f4e-37a5-96ee-7ced6318b39f",
                                                "text": "Entourés de vestons-cravates, Girard et moi détonnions dans nos vestes de denim fatiguées, arborées comme par défi à la barbe de cet obscur aréopage de diplomates culturels à la solennité empesée."
                                            },
                                            {
                                                "example_id": "d54cd077-0827-4e04-b8bd-7177e3045fe4",
                                                "sense_id": "ff0d4735-9f4e-37a5-96ee-7ced6318b39f",
                                                "text": "Il avait l'air ridicule ainsi. […], avec un jean très serré à la taille, il faisait style de défiler sur un podium de mode avec une veste ridiculement trop petite pour lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78b7e78f-03bc-32cf-b244-8f7db182d5da",
                                        "entry_id": "95aabae1-3c02-317d-ba29-05189bdbb6ea",
                                        "glosses": [
                                            "Chemise à manches longues (ou cardigan) et souvent à fermeture éclair habituellement portée l’hiver."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6324b91b-6a35-39ca-b1ca-7774be02d073",
                                        "entry_id": "95aabae1-3c02-317d-ba29-05189bdbb6ea",
                                        "glosses": [
                                            "Échec, déconvenue."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "216213e9-c043-483b-9110-6e947ccd96e3",
                                                "sense_id": "6324b91b-6a35-39ca-b1ca-7774be02d073",
                                                "text": "Moi, j’assistais à tout cela en parfait spectateur, car la moindre entame de discussion avec une fille se terminait immanquablement et très rapidement par un snobage, un camouflet, une éconduite, en termes plus crus un vent, une veste ou un râteau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5f3dd42-4098-35d2-b7c2-411f8076d36a",
                                        "entry_id": "95aabae1-3c02-317d-ba29-05189bdbb6ea",
                                        "glosses": [
                                            "Une des trois ou quatre enveloppes successives du cocon du ver à soie."
                                        ],
                                        "tags": [
                                            "Soierie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "323a6d12-b4b0-470e-adaf-e9be4b3830e6",
                                                "sense_id": "c5f3dd42-4098-35d2-b7c2-411f8076d36a",
                                                "text": "Le seul déchet consiste dans les « vestes » ou couches supérieures formées d’un fil de contexture irrégulière que l’on enlève au moment du dévidage."
                                            },
                                            {
                                                "example_id": "8ea7bf94-ecaa-408e-9c63-afeb732ef4f4",
                                                "sense_id": "c5f3dd42-4098-35d2-b7c2-411f8076d36a",
                                                "text": "Ces vestes ne sont ni uniformes, ni complètes, en général ; elles sont plus épaisses à la partie inférieure du cocon, tandis qu’elles sont plus minces et d’un tissu plus lâche à l’extrémité opposée, celle où se trouve le ruban d’attache et qui correspond à la tête de la chrysalide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
