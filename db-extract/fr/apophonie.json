                    {
                        "translation_id": "f977f76f-8628-4b31-b487-f162ec2b802d",
                        "source_entry_id": "9660ec0c-d228-3b17-b6ae-fd4c06059928",
                        "source_sense_id": "129f9342-bccb-3fac-9cff-b5521d5c96fd",
                        "target_lang_word": "ablaut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ablaut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08b2ba0c-8fdb-3229-a87c-0fcad8fcca23",
                                        "entry_id": "da99dbbd-fd04-3670-91fd-b558f2ec5d1d",
                                        "glosses": [
                                            "The substitution of one root vowel for another, thus indicating a corresponding modification of use or meaning; vowel permutation, distinct from the phonetic influence of a succeeding vowel."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09a6f681-d043-49aa-b7eb-d00774d528a4",
                                                "sense_id": "08b2ba0c-8fdb-3229-a87c-0fcad8fcca23",
                                                "text": "I declare to you that Literature was not written for schoolmasters, nor for schoolmistresses. I would not exchange it for a wilderness of schoolmasters. It should be delivered from them, who, with their silly Ablauts and ‘tendencies,’ can themselves neither read nor write."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ablaut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28075d16-c79d-36c3-9251-6ce4161de458",
                                        "entry_id": "4242ece3-c76e-370e-b378-bd12cc0d3dae",
                                        "glosses": [
                                            "To undergo a change of vowel."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32e38ce4-1f5c-4cd6-811d-8b05fa6a8b8f",
                                                "sense_id": "28075d16-c79d-36c3-9251-6ce4161de458",
                                                "text": "This root must once have ablauted, given the associated nominal derivatives prthii- 'broad', prthivl- 'earth'. However, it does not ablaut at all in its verbal forms."
                                            },
                                            {
                                                "example_id": "83afdb41-2082-40cd-a45c-d47a6d21a069",
                                                "sense_id": "28075d16-c79d-36c3-9251-6ce4161de458",
                                                "text": "What we find is that one cannot predict which members of V a given member of E will cause to ablaut"
                                            },
                                            {
                                                "example_id": "95fa0962-6d1f-440b-920f-75f9d6dcb09b",
                                                "sense_id": "28075d16-c79d-36c3-9251-6ce4161de458",
                                                "text": "It is these co-opted verbs that tend to ablaut variably in the different Dakotan dialects and that forced morphological restructuring"
                                            },
                                            {
                                                "example_id": "e1792e23-a4a1-4e8c-8e5f-3d8e3a5988b7",
                                                "sense_id": "28075d16-c79d-36c3-9251-6ce4161de458",
                                                "text": "This allomorph also causes the back vowel to ablaut to a low vowel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad4a5aab-5143-341d-a747-7ce351547e77",
                                        "entry_id": "4242ece3-c76e-370e-b378-bd12cc0d3dae",
                                        "glosses": [
                                            "To cause to change a vowel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
