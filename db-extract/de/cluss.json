                "senses": [
                    {
                        "sense_id": "9248b26a-c7da-3a8f-aba7-83a0a6bc2553",
                        "entry_id": "2330d37f-c4a5-3b42-96bf-c8dd1542a677",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "687d8d9d-7b51-44f3-a4d9-8d6beda9fb56",
                                "sense_id": "9248b26a-c7da-3a8f-aba7-83a0a6bc2553",
                                "text": "Frau Cluss ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "41404a0c-fdf5-4069-8cc3-c1d37846d3d0",
                                "sense_id": "9248b26a-c7da-3a8f-aba7-83a0a6bc2553",
                                "text": "Herr Cluss wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e9f7b2f5-5d4d-46c5-94ff-eccd2d2c1a17",
                                "sense_id": "9248b26a-c7da-3a8f-aba7-83a0a6bc2553",
                                "text": "Die Clussens fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "0adb4b60-504f-4e78-a6cd-56e1cf9626ea",
                                "sense_id": "9248b26a-c7da-3a8f-aba7-83a0a6bc2553",
                                "text": "Der Cluss trägt nie die Pullover, die die Cluss ihm strickt."
                            },
                            {
                                "example_id": "01ffb571-2e40-4449-bfeb-86a986f2ba48",
                                "sense_id": "9248b26a-c7da-3a8f-aba7-83a0a6bc2553",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Cluss kommt, geht der Herr Cluss.“"
                            },
                            {
                                "example_id": "2a5dafd8-f3aa-4ba7-855b-6031db93e93e",
                                "sense_id": "9248b26a-c7da-3a8f-aba7-83a0a6bc2553",
                                "text": "Cluss kommt und geht."
                            },
                            {
                                "example_id": "9c0128aa-1087-4e60-8b00-7bf481b46c52",
                                "sense_id": "9248b26a-c7da-3a8f-aba7-83a0a6bc2553",
                                "text": "Cluss’ kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
