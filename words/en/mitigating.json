                {
                    "sense_id": "cd23127d-8f5a-36bd-a25f-92eef71850b2",
                    "sense_definition": "Making something less severe, serious, or painful.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge considered the <w>mitigating</w> circumstances before passing the final sentence.",
