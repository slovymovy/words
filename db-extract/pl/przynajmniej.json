                                        "examples": [
                                            {
                                                "example_id": "9bfe43f4-8b3d-40f2-93c4-a0f3a2a7370a",
                                                "sense_id": "f8aef063-ead3-3831-9cf5-907cb5cda93d",
                                                "text": "Vypadá to, že minimálně v Brně a na jižní Moravě všechno spěje správným směrem."
                                            }
                                        ]
                                    }
                                ]
                            }
