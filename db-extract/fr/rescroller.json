                                "example_id": "7320b306-f6a3-4045-8c9d-0cc425b425d3",
                                "sense_id": "f2245fff-f908-3d89-a0e2-9e2dc500c7b4",
                                "text": "Pour cela je dois rescroller en haut."
                            },
                            {
                                "example_id": "f3feae39-aedf-4661-8385-934bb8776c97",
                                "sense_id": "f2245fff-f908-3d89-a0e2-9e2dc500c7b4",
                                "text": "Cette pub 1 contre 100 va me rendre dingue. Elle s'affiche à chaque chargement et en plus faut rescroller en haut de page pour aller la chercher/virer."
                            },
                            {
                                "example_id": "826c7890-06b0-4e03-80e1-f5e28fce3237",
                                "sense_id": "f2245fff-f908-3d89-a0e2-9e2dc500c7b4",
                                "text": "Mais le bug qui fait rescroller tout en haut tout seul sans prévenir, par contre, c'est à s'arracher les cheveux et à devenir fou !"
                            }
                        ]
                    }
