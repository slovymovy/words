                                        "sense_id": "fefbaba6-8f3f-3fe7-a954-8c73905f6334",
                                        "entry_id": "55c71028-5577-33c7-84c3-0700d74c782d",
                                        "glosses": [
                                            "Person, die Witze erzählt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd380ca1-4434-4659-80d7-81cbc968cd20",
                                                "sense_id": "fefbaba6-8f3f-3fe7-a954-8c73905f6334",
                                                "text": "„In diesem Sinne ist die Erzählsituation und die Persönlichkeit des Witzeerzählers und -hörers von ebenso großer Bedeutung wie der Text des Witzes selbst.“"
                                            },
                                            {
                                                "example_id": "b12e49de-9c5e-4b1b-a985-f477e114277e",
                                                "sense_id": "fefbaba6-8f3f-3fe7-a954-8c73905f6334",
                                                "text": "„Das Sächsische ist in dieser Gattung von Witzen selbst zum Witz geworden, und jeder Witzeerzähler bemüht sich, die Aussprache möglichst »echt« zu bieten.“"
                                            },
                                            {
                                                "example_id": "a1bedd5c-3ada-4c78-8810-7a25a6c6ca70",
                                                "sense_id": "fefbaba6-8f3f-3fe7-a954-8c73905f6334",
                                                "text": "„Der Witzeerzähler blickt sie dankbar an und fährt fort.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f72f9e64-1f71-4ee8-92b5-a235d27333da",
