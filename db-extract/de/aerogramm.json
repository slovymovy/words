                        "entry_id": "0842f686-587e-3b19-bdb8-d468ac98b0ad",
                        "glosses": [
                            "postalischer Vordruck, meist in Form eines Briefbogens, der besonders gefaltet wird und zu einem Einheitsporto mit Luftpost transportiert wird"
                        ],
                        "tags": [
                            "Philatelie"
                        ],
                        "examples": [
                            {
                                "example_id": "33bd73af-9ec2-477d-974a-3087e7b02985",
                                "sense_id": "9bc71ebc-c23c-31dd-9dbb-b17ee0471862",
                                "text": "Das Aerogramm besteht aus einem gefalteten Bogen Briefpapier und darf keine Einlagen enthalten."
                            },
                            {
                                "example_id": "2fe421b2-5a4c-438a-99ec-b6ba7786bb6b",
                                "sense_id": "9bc71ebc-c23c-31dd-9dbb-b17ee0471862",
                                "text": "In Deutschland wurden Aerogramme als Form der Postsendung am 01.01.2007 eingestellt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
