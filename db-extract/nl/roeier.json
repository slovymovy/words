                "senses": [
                    {
                        "sense_id": "44236149-f112-365d-ba1f-36acea2d7d25",
                        "entry_id": "cc00c317-1230-3b7b-a25d-ce4f32760627",
                        "glosses": [
                            "iemand die roeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea7ae99d-14ce-4212-927f-f170f89faabe",
                                "sense_id": "44236149-f112-365d-ba1f-36acea2d7d25",
                                "text": "Om vooruit te zien moet een roeier achterom kijken."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1247f7d-ffd7-34d9-9906-ccfc61438610",
                        "entry_id": "cc00c317-1230-3b7b-a25d-ce4f32760627",
                        "glosses": [
                            "een havenwerker die de meertrossen van schepen aan de meerpalen vastmaakt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "fb89a767-4670-4ff7-8336-bf82a3e96223",
                                "sense_id": "e1247f7d-ffd7-34d9-9906-ccfc61438610",
                                "text": "Vroeger had de roeier slechts een roeiboot te beschikking."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "645d6464-2a4f-42a8-8c0e-c32aea1ec616",
                        "source_entry_id": "cc00c317-1230-3b7b-a25d-ce4f32760627",
                        "source_sense_id": "44236149-f112-365d-ba1f-36acea2d7d25",
                        "source_sense_description": "iemand die roeit",
                        "target_lang_word": "Ruderer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ruderer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7cb72b5-e30a-3219-9298-f99868cafb6a",
                                        "entry_id": "f62180b1-ae08-34a6-abca-4f8b819bd5f3",
                                        "glosses": [
                                            "Person, die ein Boot rudert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd013090-ccdf-4302-9384-cf06d37b95e6",
                                                "sense_id": "f7cb72b5-e30a-3219-9298-f99868cafb6a",
                                                "text": "„Auf die gleiche Weise werden die Sitzbalken für die Ruderer eingezogen und fixiert.“"
                                            },
                                            {
                                                "example_id": "5f7ffacd-d77c-4888-8d1c-ed30d5b48c1d",
                                                "sense_id": "f7cb72b5-e30a-3219-9298-f99868cafb6a",
                                                "text": "„Die Ruderer schafften stromabwärts vier Meilen pro Stunde und stromaufwärts die Hälfte.“"
                                            },
                                            {
                                                "example_id": "d3a182af-baee-4221-b5e7-2b736a2ef4ce",
                                                "sense_id": "f7cb72b5-e30a-3219-9298-f99868cafb6a",
                                                "text": "„Ich verließ Korfu bei Einbruch der Nacht und kam am frühen Morgen in Otranto an, ohne daß meine Ruderer auch nur einmal ihre Ruder eintauchten.“"
                                            },
                                            {
                                                "example_id": "7d2ed0e2-b499-46b0-97f0-8f8683174505",
                                                "sense_id": "f7cb72b5-e30a-3219-9298-f99868cafb6a",
                                                "text": "„Sein Offizier wandte sich nun zu den Ruderern, die noch im Boote saßen, und erteilte ihnen die ihm zugekommenen Orders.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0764555-e11b-487e-bab5-f1caf69e6b7d",
                        "source_entry_id": "cc00c317-1230-3b7b-a25d-ce4f32760627",
                        "source_sense_id": "44236149-f112-365d-ba1f-36acea2d7d25",
                        "source_sense_description": "iemand die roeit",
                        "target_lang_word": "rower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85cfdc4b-0f26-3dfa-9a96-29e7ca968194",
                                        "entry_id": "8fe1d129-f945-3487-be79-0356c90e0700",
                                        "glosses": [
                                            "One who rows."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e236a5ce-42ff-494d-9aca-afed1fe5cc53",
                                                "sense_id": "85cfdc4b-0f26-3dfa-9a96-29e7ca968194",
                                                "text": "It had been a sort of race hitherto, and the rowers, with set teeth and compressed lips, had pulled stroke for stroke."
                                            },
                                            {
                                                "example_id": "f4486bff-0cc8-4d16-b775-beda6f4e1062",
                                                "sense_id": "85cfdc4b-0f26-3dfa-9a96-29e7ca968194",
                                                "text": "Upon her deck were rowers with dream-made oars, and the rowers were the people of men’s fancies, and princes of old story and people who had died, and people who had never been."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f319e00-ea4d-34c7-9eb4-b5e6aaffeaaf",
                                        "entry_id": "8fe1d129-f945-3487-be79-0356c90e0700",
                                        "glosses": [
                                            "A rowing machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e284bf7-990f-4792-8b04-429960c0afe4",
                                                "sense_id": "4f319e00-ea4d-34c7-9eb4-b5e6aaffeaaf",
                                                "text": "Aerobic and weight training sessions should also complement each other. For example, on a day you work your upper body with weights, you can use a rower for aerobics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96c423ab-3b65-48e5-84ea-c161596ab94a",
                        "source_entry_id": "cc00c317-1230-3b7b-a25d-ce4f32760627",
