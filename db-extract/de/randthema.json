                "senses": [
                    {
                        "sense_id": "ce93d2c2-6e12-3f49-9d2e-eaf853a03cb2",
                        "entry_id": "60beec59-6dd9-3f8a-a906-43beb0708313",
                        "glosses": [
                            "Gegenstand einer Diskussion/Sache (= Thema), das nicht den Kern der Diskussion/Sache bildet/nicht das wichtigste ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84ff7c4b-5b91-4bef-804c-253db575ae91",
                                "sense_id": "ce93d2c2-6e12-3f49-9d2e-eaf853a03cb2",
                                "text": "„Zu einem weiteren Randthema der evangelischen Schulbücher gehört die Genderperspektive auf die Reformation.“"
                            },
                            {
                                "example_id": "f34e2625-c504-4eed-84a5-66c7759fff55",
                                "sense_id": "ce93d2c2-6e12-3f49-9d2e-eaf853a03cb2",
                                "text": "„Obdachlosigkeit tritt nicht nur gesellschaftlich, sondern auch in der Forschung als Randthema in Erscheinung.“"
                            },
                            {
                                "example_id": "bc80d5c4-cef6-4f1c-84ee-8838192adbc9",
                                "sense_id": "ce93d2c2-6e12-3f49-9d2e-eaf853a03cb2",
                                "text": "„Im Gegensatz zu den Magazinen war der Film für die Illustrierten eher ein Randthema, und wenn sie darauf eingingen, geschah dies in ganz anderer Weise als in den Magazinen.“"
                            },
                            {
                                "example_id": "b37d914b-2086-4149-954e-877c0b5f0588",
                                "sense_id": "ce93d2c2-6e12-3f49-9d2e-eaf853a03cb2",
                                "text": "„Immer noch erscheint eine kritische Reflexion gängiger kunsthistorischer Praxis als ein Randthema der Forschung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
