                        "examples": [
                            {
                                "example_id": "3542d844-1b83-4e35-bbff-8608d4424ff2",
                                "sense_id": "83dad354-4fb9-39c6-acf0-ebe483b89f7d",
                                "text": "Die deutsche Mannschaft hatte lange kein Gegentor aus einer Standardsituation heraus kassiert."
                            },
                            {
                                "example_id": "2faf3b32-fae5-435d-940a-8a2018aec3cd",
                                "sense_id": "83dad354-4fb9-39c6-acf0-ebe483b89f7d",
                                "text": "„Nach der Pause dauerte es neun Minuten, bis die Spanier durch eine bestens erprobte Standardsituation wieder den Ausgleich erzielten.“"
                            },
                            {
                                "example_id": "7e7b5251-c8c9-42b0-89b4-d3976364705b",
                                "sense_id": "83dad354-4fb9-39c6-acf0-ebe483b89f7d",
                                "text": "„Er trainierte ganz offensichtlich Standardsituationen seines Arbeitsalltages.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
