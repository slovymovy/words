                {
                    "sense_id": "32e53c14-b487-3c03-8ffe-b5361a685075",
                    "sense_definition": "Een dom of onnozel persoon.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let toch eens op, jij stomme <w>eend</w>!",
                            "target_lang_translations": {
                                "ru": "Будь внимательнее, ты, глупая <w>дура</w>!",
                                "en": "Pay attention, you stupid <w>goose</w>!",
                                "pl": "Uważaj no, ty głupi <w>głupku</w>!",
                                "de": "Pass doch mal auf, du dumme <w>Gans</w>!",
                                "fr": "Fais donc attention, espèce de <w>cloche</w> !",
                                "it": "Fai attenzione, <w>sciocco</w> che non sei altro!",
                                "cs": "Dávej přece pozor, ty hloupá <w>huso</w>!",
                                "tr": "Dikkat etsene be hey şapşal <w>kaz</w>!",
                                "es": "¡Presta atención, pedazo de <w>ganso</w>!"
                            }
                        },
                        {
                            "text": "Welke <w>eend</w> heeft de deur open laten staan?",
                            "target_lang_translations": {
                                "ru": "Какой <w>олух</w> оставил дверь открытой?",
                                "en": "Which <w>fool</w> left the door open?",
                                "pl": "Który <w>naiwniak</w> zostawił otwarte drzwi?",
                                "de": "Welcher <w>Dussel</w> hat die Tür offen gelassen?",
                                "fr": "Quel <w>serin</w> a laissé la porte ouverte ?",
                                "it": "Quale <w>idiota</w> ha lasciato la porta aperta?",
                                "cs": "Který <w>hlupák</w> nechal otevřené dveře?",
                                "tr": "Hangi <w>şaşkın</w> kapıyı açık bıraktı?",
                                "es": "¿Qué <w>tonto</w> ha dejado la puerta abierta?"
                            }
                        }
