                "senses": [
                    {
                        "sense_id": "63e664b3-c9bf-345e-83eb-2cf757c08f2b",
                        "entry_id": "db9835ce-e65c-3f23-bee1-ce9ec3c2ee41",
                        "glosses": [
                            "zanger die bij een optreden iets zingt, waarop een koor hetzelfde zingt of een gezongen antwoord geeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fef56b6-64b9-4cbc-8055-069285834cd7",
                                "sense_id": "63e664b3-c9bf-345e-83eb-2cf757c08f2b",
                                "text": "De meeste van deze liederen hadden de bekende call-and-response-zangstructuur: de voorzanger zingt een couplet dat door de anderen herhaald wordt."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8fb3de5-bdba-3600-a646-b351b134689c",
                        "entry_id": "db9835ce-e65c-3f23-bee1-ce9ec3c2ee41",
                        "glosses": [
                            "bij kerkdiensten iemand die als eerste of enige zingt, meestal nagevolgd door de gemeente of het koor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b8e39f9-34e9-4052-8a4a-c844d7a3363b",
                                "sense_id": "e8fb3de5-bdba-3600-a646-b351b134689c",
                                "text": "Hij trad daar overigens ook op als voorzanger, in een van de twee protestantse kerken, misschien wel in allebei."
                            }
                        ]
                    }
                ],
