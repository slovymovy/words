                        "glosses": [
                            "iemand die de leiding van iemand anders wil overnemen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "47a60a95-0933-40cc-af50-402cb411985c",
                                "sense_id": "193cbe91-9da4-380d-9653-e23c586087fb",
                                "text": "Met de verrassend sterke Peter Velits kreeg Nibali er wel een troonpretendent bij, al deed de Slowaak niet echt mee toen er in rit negentien werd gestreden om de nalatenschap van Alejandro Valverde."
                            }
