                "translations": [
                    {
                        "translation_id": "6944961b-58e7-4e5f-83f1-657b3945fa3f",
                        "source_entry_id": "6841cfb4-a024-38ca-91b3-a32f3aef55c1",
                        "source_sense_id": "486e5951-5488-3e1c-a63b-1182fdbbf528",
                        "source_sense_description": "Befehl zum Anhalten (nur zu Zug- oder Reittieren, meistens zu Pferden; zu Menschen nur scherzhaft)",
                        "target_lang_word": "whoa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whoa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e569ceed-df4b-3c73-96e2-d71af7f0ac00",
                                        "entry_id": "b21e2f2c-7ce5-3e1d-a8eb-c206730db180",
                                        "glosses": [
                                            "Stop (especially when commanding a horse or imitative thereof); calm down; slow down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d717c965-e50f-4d4b-856d-8915c5f5b9e1",
                                                "sense_id": "e569ceed-df4b-3c73-96e2-d71af7f0ac00",
                                                "text": "Whoa, Nelly!"
                                            },
                                            {
                                                "example_id": "b978a670-4ce0-4df6-b00c-db5110c202ae",
                                                "sense_id": "e569ceed-df4b-3c73-96e2-d71af7f0ac00",
                                                "text": "I can see Mickie getting hot, I'm about to grab his arm, hold him back, say, Whoa, whoa, Mick, not here, it ain't worth it what happened inside just now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dea964a7-d37f-3088-b95a-8250daece38d",
                                        "entry_id": "b21e2f2c-7ce5-3e1d-a8eb-c206730db180",
                                        "glosses": [
                                            "An expression of surprise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44faaf63-de30-400d-9154-9ad0274abe67",
                                                "sense_id": "dea964a7-d37f-3088-b95a-8250daece38d",
                                                "text": "Whoa, are you serious?"
                                            },
                                            {
                                                "example_id": "5261117e-06b5-43ae-abab-8d728d87980a",
                                                "sense_id": "dea964a7-d37f-3088-b95a-8250daece38d",
                                                "text": "Whoa. Wait a minute, Doc. Are you trying to tell me that my mother has got the hots for me?"
                                            },
                                            {
                                                "example_id": "bed3186f-dace-42c7-84a8-9dd1779294e8",
                                                "sense_id": "dea964a7-d37f-3088-b95a-8250daece38d",
                                                "text": "Jen: Douglas has asked me to be his PA.\nMoss: Oh. My. God! Well, that is something and a half. His PA? How... Whoa! His PA... Shut up! His PA!\nJen: It means \"personal assistant\".\nMoss: Thank you. Right, OK."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b98054d-8dca-3b3a-9100-6c1c50e51f2f",
                                        "entry_id": "b21e2f2c-7ce5-3e1d-a8eb-c206730db180",
                                        "glosses": [
                                            "Used as a meaningless filler in song lyrics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39d96ac3-a2e6-4416-81f0-03ffdd2637bb",
                                                "sense_id": "7b98054d-8dca-3b3a-9100-6c1c50e51f2f",
                                                "text": "I am the type who is liable to snipe you\nWith two seconds left to go, whoa."
                                            },
                                            {
                                                "example_id": "ef88987b-a809-48e6-a1eb-de7756414ce5",
                                                "sense_id": "7b98054d-8dca-3b3a-9100-6c1c50e51f2f",
                                                "text": "And oh whoa girl, it's a shame.\nOh whoa girl, it's a doggone shame."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whoa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c66a110-3999-32ba-b87a-7a0eb288fb83",
                                        "entry_id": "b988bad8-55a4-37bb-b1a3-041c093a02ef",
                                        "glosses": [
                                            "To attempt to slow (an animal) by crying \\\"whoa\\\"."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "851343bd-b7cd-47de-9674-1ed90225e9c5",
                                                "sense_id": "4c66a110-3999-32ba-b87a-7a0eb288fb83",
                                                "text": "He was whoaing the horses loudly, and they did seem to be going faster than usual—in fact, they were galloping."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cfba5bf-2f3c-46e0-8938-8975eacb67fd",
                        "source_entry_id": "6841cfb4-a024-38ca-91b3-a32f3aef55c1",
                        "source_sense_id": "fe9aeba4-25a0-3d0e-a403-5a96123eb229",
                        "source_sense_description": "Ausruf bei übermäßiger Kälte",
                        "target_lang_word": "brr",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brr",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce7bf939-a9d7-35a5-872e-236a77f85a53",
                                        "entry_id": "a5ef40bf-ba28-3a1e-b600-8420d000ae6c",
                                        "glosses": [
                                            "Used to express being cold, to show shivering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ee21a28-2c5f-405c-a224-e6fbb1e51208",
                                                "sense_id": "ce7bf939-a9d7-35a5-872e-236a77f85a53",
                                                "text": "The teeth chattered faster, stopped, and began again twice before the man could master his shiver sufficiently to say, \"Ju-ju-st in ti-ti-me....Brrrr.\""
                                            },
                                            {
                                                "example_id": "2ed01ad8-27e1-4616-ae81-22ceff5a6660",
                                                "sense_id": "ce7bf939-a9d7-35a5-872e-236a77f85a53",
                                                "text": "'Brrrrr,' said Lieutenant Dubosc, realizing to the full how cold he was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c906d89-713a-38a5-926d-fc7791bbf791",
                                        "entry_id": "a5ef40bf-ba28-3a1e-b600-8420d000ae6c",
                                        "glosses": [
                                            "An expression of disgust or aversion, as if shuddering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a04e38c5-0c09-4157-89e6-26414223ba27",
                                                "sense_id": "2c906d89-713a-38a5-926d-fc7791bbf791",
                                                "text": "Brrr. Even the thought of going underground made Old Bailey shudder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bc0af71-ad16-31c3-9465-5c1d6a368d8a",
                                        "entry_id": "a5ef40bf-ba28-3a1e-b600-8420d000ae6c",
                                        "glosses": [
                                            "The ringing sound of a telephone or an alarm bell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9bbd835-93d5-47d0-bc87-852150c260ca",
                                                "sense_id": "1bc0af71-ad16-31c3-9465-5c1d6a368d8a",
                                                "text": "Brr-brr, brr-brr. The phone rang insistently."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
