                "senses": [
                    {
                        "sense_id": "dd3d6b54-651a-31d4-b9d3-83dcf3303fc1",
                        "entry_id": "52c1dc8b-f779-386c-be88-2a3f6d60dd55",
                        "glosses": [
                            "Orner de pampilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "568afb49-3e94-4d1f-9e97-178044989502",
                                "sense_id": "dd3d6b54-651a-31d4-b9d3-83dcf3303fc1",
                                "text": "A la fois artiste et poète, Eve Saint-Jalmes peut réaliser toutes les demandes sur mesure, guider chaque client dans son choix, «sculpter son espace», l'illuminer, le «pampiller» de malice, de délicatesse, ou d'audace."
                            }
                        ]
                    },
                    {
                        "sense_id": "dac1252b-9a00-346f-93b6-2e232619dcd9",
                        "entry_id": "52c1dc8b-f779-386c-be88-2a3f6d60dd55",
                        "glosses": [
                            "Fabriquer des pampilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd45578a-e37c-4c89-98fa-7d702cd65cae",
                                "sense_id": "dac1252b-9a00-346f-93b6-2e232619dcd9",
                                "text": "Belle & douce soirée à pampiller !!!!"
                            }
                        ]
                    },
                    {
                        "sense_id": "158d5fde-f2b8-3f28-9c80-b3829b38b81e",
                        "entry_id": "52c1dc8b-f779-386c-be88-2a3f6d60dd55",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba1d2dd8-eb54-4fba-8638-398ffffea0ea",
                                "sense_id": "158d5fde-f2b8-3f28-9c80-b3829b38b81e",
                                "text": "Fauteuils légers comme des nuages, qui referment leurs bras sur vous lorsque vous y prenez place, meubles transparents, et cet immense lustre de cristal qui pampille de toutes ses couleurs au-dessus de nos têtes."
                            }
                        ]
                    }
