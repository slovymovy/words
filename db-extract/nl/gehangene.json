                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f672b97a-9f25-44e1-9210-596da4804450",
                        "source_entry_id": "a507ed61-e3c3-3b11-8fda-553dd52c9f30",
