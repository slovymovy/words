                        "entry_id": "e4d319d2-3b8f-3874-a815-c3cf55fc5129",
                        "glosses": [
                            "any substance with a thick, gooey or almost-solid consistency, such as:",
                            "slush (of snow)"
                        ],
                        "tags": [
                            "feminine",
