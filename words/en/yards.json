                            }
                        },
                        {
                            "text": "We cleaned our <w>yards</w> to prepare for the neighborhood party.",
                            "target_lang_translations": {
                                "ru": "Мы убрали наши <w>дворы</w>, чтобы подготовиться к вечеринке с соседями.",
                                "zh": "我们打扫了各自的<w>院子</w>，为邻里聚会做准备。"
                            }
