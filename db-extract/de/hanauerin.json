                        "examples": [
                            {
                                "example_id": "02b0b57d-6ac4-459e-a8cf-d7f331b8fc81",
                                "sense_id": "8bce4a29-5445-362a-b1ea-ea95d276b8d8",
                                "text": "„Drei Hanauerinnen haben dazu beigetragen, dem Team des Deutschen Rollsport und Inline-Verbandes (DRIV) bei der Rollkunstlauf -WM eine gute Bilanz zu bescheren.“"
                            },
                            {
                                "example_id": "13525684-0878-4f8c-9a4c-9061ae20c996",
                                "sense_id": "8bce4a29-5445-362a-b1ea-ea95d276b8d8",
                                "text": "„Pech hatte die talentierte Hanauerin Sarah Bormann, die in ihrem Kampf gegen die Spanierin Zurine Celaya nach Punkten vorne lag, dann allerdings wegen Verletzung ausschied.“"
                            }
                        ],
