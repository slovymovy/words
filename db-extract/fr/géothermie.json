                    {
                        "sense_id": "6d345e3f-b9e1-3c2d-be41-1ca4132d4082",
                        "entry_id": "508447cf-ea11-3d62-abab-073e099e1ccb",
                        "glosses": [
                            "Science qui étudie les phénomènes thermiques internes du globe terrestre et la technique qui vise à l’exploiter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c9c458e-4b6d-41e4-8c20-9d8b195d4a0c",
                                "sense_id": "6d345e3f-b9e1-3c2d-be41-1ca4132d4082",
                                "text": "À l’exception de l’énergie nucléaire, de la géothermie et de l’énergie marémotrice, l’énergie solaire est à l’origine de toutes les énergies sur Terre."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5f37c6c-8736-3dcd-b426-975b474d12f2",
                        "entry_id": "508447cf-ea11-3d62-abab-073e099e1ccb",
                        "glosses": [
                            "Énergie géothermique issue de l’énergie de la Terre qui récupère la chaleur puis la convertit éventuellement en électricité."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1132384c-de76-433c-83ea-36c932a8549b",
                                "sense_id": "a5f37c6c-8736-3dcd-b426-975b474d12f2",
                                "text": "Saisissons cette opportunité pour accélérer à Saint-Cloud l’implantation de panneaux photovoltaïques sur les toits de nos bâtiments, installons des ombrières et lançons un projet de géothermie afin de se chauffer grâce à nos sous-sols !"
                            }
                        ]
                    }
