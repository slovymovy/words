                "senses": [
                    {
                        "sense_id": "adf28b38-a1ae-3239-94d3-de0ad3bfde07",
                        "entry_id": "b637c730-18d1-39f7-b3b1-46dcfa174f20",
                        "glosses": [
                            "van iets dat het adviserend is, maar niet dwingend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f9bcd42-dc75-4360-9386-50563559119c",
                                "sense_id": "adf28b38-a1ae-3239-94d3-de0ad3bfde07",
                                "text": "Het kabinet wil van de raadgevende volksraadpleging af sinds het referendum over de Associatieovereenkomst tussen de Europese Unie en Oekraïne. De argumenten van de regering om het raadgevend referendum af te schaffen, zijn niet wetenschappelijk onderbouwd. Dat hield wetenschapper Martin Rosema uit Enschede de Eerste Kamer in maart dit jaar voor."
                            },
                            {
                                "example_id": "5f74ca56-c539-4ce5-94d7-01177a49a421",
                                "sense_id": "adf28b38-a1ae-3239-94d3-de0ad3bfde07",
                                "text": "Na het raadgevend referendum in maart deed het kabinet wel enkele voorstellen tot aanpassing. Zo wil het strengere regels voor het delen van gegevens met andere landen. Na de zomer wordt hier in de politiek pas verder over gesproken."
                            }
                        ]
                    }
                ],
