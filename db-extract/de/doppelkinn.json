                                        "glosses": [
                                            "Bourrelet sous le menton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "721baff6-eb8a-4fc7-933c-566afb340d84",
                                                "sense_id": "2b78207b-0967-3c6b-ab8d-d7b2b47f6e81",
                                                "text": "Il inclina sur sa poitrine sa tête qui s’encadra d’un double menton."
                                            },
                                            {
                                                "example_id": "0555a93a-12f2-4af5-9e02-0bcd1d08f1a9",
                                                "sense_id": "2b78207b-0967-3c6b-ab8d-d7b2b47f6e81",
                                                "text": "Tout le poids du double menton se situe entre le menton et le cou."
                                            },
                                            {
                                                "example_id": "539ddc7a-df63-454f-82c2-ede61db19518",
                                                "sense_id": "2b78207b-0967-3c6b-ab8d-d7b2b47f6e81",
                                                "text": "Je notai qu’elle avait un début de double menton."
                                            }
