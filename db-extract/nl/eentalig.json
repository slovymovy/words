                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4198dee2-ff7c-48f2-a65d-08909e8d7475",
                                "sense_id": "1fcfd1bf-093a-3307-97b3-2437b01728ba",
                                "text": "In het eentalige woordenboek worden de woordbetekenissen gegeven in dezelfde taal."
