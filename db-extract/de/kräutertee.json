                        ]
                    },
                    {
                        "translation_id": "720a96f7-4aeb-44cd-9e9d-b4bcbe410262",
                        "source_entry_id": "6041cb7e-5a83-360c-be93-5846be53d34c",
                        "source_sense_id": "55c0ec87-9716-32d6-8780-f4d5e87daf71",
                        "source_sense_description": "aus Pflanzenteilen zubereitetes Aufgussgetränk, in dem bestimmte Kräuter enthalten sind",
                        "target_lang_word": "infusion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infusion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0178b50-096a-375c-9b63-9c017d774add",
                                        "entry_id": "9eb98ce3-ff59-3495-90b6-b6e7bba5b558",
                                        "glosses": [
                                            "Action d’infuser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34c51011-8bf3-4ec9-87b6-f4b13e2dc4e5",
                                                "sense_id": "d0178b50-096a-375c-9b63-9c017d774add",
                                                "text": "— Non, non, pas en infusion. Ça se prend en gélules, avait-il répondu, fou de joie d’avoir trouvé une oreille intéressée, avant de continuer à psalmodier : La cristallothérapie est aussi très efficace, très réussie."
                                            },
                                            {
                                                "example_id": "c1d4da45-f223-4649-b4b4-e3e47281b736",
                                                "sense_id": "d0178b50-096a-375c-9b63-9c017d774add",
                                                "text": "Cette tisane se fait par infusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cd2ad4a-d8f9-3391-a854-31437040d542",
                                        "entry_id": "9eb98ce3-ff59-3495-90b6-b6e7bba5b558",
                                        "glosses": [
                                            "Résultat de l’action d’infuser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f417c886-ac91-443a-9aae-b99bf31aac78",
                                                "sense_id": "8cd2ad4a-d8f9-3391-a854-31437040d542",
                                                "text": "Quant aux Russes, généralement sobres, l’infusion de thé leur suffit, paraît-il, non sans une certaine addition de « vodka », qui est l’eau-de-vie moscovite par excellence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32b9f52c-43d6-321f-8aed-f72737e196de",
                                        "entry_id": "9eb98ce3-ff59-3495-90b6-b6e7bba5b558",
                                        "glosses": [
                                            "Résultat de l’action d’infuser.",
                                            "Boisson obtenue par le processus."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82602963-c3a4-30ba-98e5-e08d915e8b94",
                                        "entry_id": "9eb98ce3-ff59-3495-90b6-b6e7bba5b558",
                                        "glosses": [
                                            "Manière dont certaines facultés surnaturelles sont infuses dans l’âme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b184eb40-cea7-492c-87ae-475b61054278",
                                                "sense_id": "82602963-c3a4-30ba-98e5-e08d915e8b94",
                                                "text": "Les apôtres avaient le don des langues, par l’infusion de l’Esprit."
                                            },
                                            {
                                                "example_id": "1351169a-b018-4478-a46a-1c8d04618536",
                                                "sense_id": "82602963-c3a4-30ba-98e5-e08d915e8b94",
                                                "text": "Certaines vertus morales sont-elles en nous par infusion?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3869bee6-d465-42f9-888e-2c64c236a8ec",
                        "source_entry_id": "6041cb7e-5a83-360c-be93-5846be53d34c",
                        "source_sense_id": "55c0ec87-9716-32d6-8780-f4d5e87daf71",
                        "source_sense_description": "aus Pflanzenteilen zubereitetes Aufgussgetränk, in dem bestimmte Kräuter enthalten sind",
                        "target_lang_word": "tisane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tisane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b314e4a6-f383-3d9a-bdaa-bf5e90884afa",
                                        "entry_id": "b99bb29f-85ec-383d-abc3-d9aa1a21b944",
                                        "glosses": [
                                            "Boisson obtenue par infusion, macération ou décoction de plantes sèches, généralement avec des vertus médicamenteuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b348a90-9fac-4e37-b80a-ab4cc3753992",
                                                "sense_id": "b314e4a6-f383-3d9a-bdaa-bf5e90884afa",
                                                "text": "Une tasse de tisane."
                                            },
                                            {
                                                "example_id": "73705296-f64a-40e4-b899-dd654a82fb0e",
                                                "sense_id": "b314e4a6-f383-3d9a-bdaa-bf5e90884afa",
                                                "text": "On lui fit boire quelques tasses de tisane rafraîchissante, dont la pharmacie végétale de Granite-house fournit les ingrédients."
                                            },
                                            {
                                                "example_id": "67c6a4a4-3078-4d9e-b650-0bb9bedad389",
                                                "sense_id": "b314e4a6-f383-3d9a-bdaa-bf5e90884afa",
                                                "text": "Elle avait beau avaler des boules de gomme et des pâtes, s’ingurgiter des tisanes de mauve et des quatre-fleurs, des sirops calmants et des loochs, la toux ne s’en allait point."
                                            },
                                            {
                                                "example_id": "5ff2aaba-a4f1-4b65-ad35-d5f96c095506",
                                                "sense_id": "b314e4a6-f383-3d9a-bdaa-bf5e90884afa",
                                                "text": "La semaine suivante, Mme la directrice l’invita à venir boire chez elle une tisane anglaise qu’on appelait du thé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7ac1a73-e300-3b77-916f-f39a8a9c9f69",
                                        "entry_id": "b99bb29f-85ec-383d-abc3-d9aa1a21b944",
                                        "glosses": [
                                            "Paroles douçâtres, consolations lénifiantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01f227ff-f2f1-48c3-b55e-3df716c4e8d3",
                                                "sense_id": "d7ac1a73-e300-3b77-916f-f39a8a9c9f69",
                                                "text": "Son tourment profond n’avait que faire de ces tisanes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9787068d-5fbe-39ca-9357-f64b0cb61e9f",
                                        "entry_id": "b99bb29f-85ec-383d-abc3-d9aa1a21b944",
                                        "glosses": [
                                            "Essence, carburant."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88b7d66d-bf75-4287-8318-0fc641c3d81b",
                                                "sense_id": "9787068d-5fbe-39ca-9357-f64b0cb61e9f",
                                                "text": "On a pu franchir quelque vingt mille bornes en si peu de temps avec si peu de tisane ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bb47ec9-2ab7-3c4b-a044-fb12731105f9",
