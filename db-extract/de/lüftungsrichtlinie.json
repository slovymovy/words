                "senses": [
                    {
                        "sense_id": "5342df6c-a1cf-3cc1-acee-a62988514095",
                        "entry_id": "8937b429-9ed2-35d5-8398-01046e57bebe",
                        "glosses": [
                            "eine rechtsverbindliche Vorschrift oder Anweisung, ohne Gesetzescharakter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57d71025-77e1-4b81-871e-743026d325f4",
                                "sense_id": "5342df6c-a1cf-3cc1-acee-a62988514095",
                                "text": "„Die Lüftungsrichtlinie stellt die Nachfolge der SKI Richtlinie 35-87 dar.“"
                            },
                            {
                                "example_id": "4819a2b1-1f73-42e0-a38d-3cc0912b5f41",
                                "sense_id": "5342df6c-a1cf-3cc1-acee-a62988514095",
                                "text": "„Als Folge der aktuellen Lüftungsrichtlinien des ASTRA (Bundesamt für Strassenbau) musste die bestehende Zwischendecke in einem Bereich von je ca. 200 m pro Portal (Nord/Süd) zurückgebaut werden.“"
                            },
                            {
                                "example_id": "45534733-1ae0-4e55-b6ca-38335686a2df",
                                "sense_id": "5342df6c-a1cf-3cc1-acee-a62988514095",
                                "text": "„Es wurde nach neuen Lösungen gesucht, wobei den 2004 in Kraft getretenen Tunnelbau- und Lüftungsrichtlinien des Bundes Rechnung getragen werden musste.“"
                            },
                            {
                                "example_id": "c8337ef8-5d96-49c5-9285-4c3b8363dccf",
                                "sense_id": "5342df6c-a1cf-3cc1-acee-a62988514095",
                                "text": "„Das Projekt wird gesundheitsbasierte EU-Lüftungsrichtlinien für nicht-industrielle Gebäude (Büros, Wohnungen, Schulen, Kindergärten und Tagesstätten) erarbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d0ba4a56-7a3d-3614-b6a6-a8040d2bb035",
                        "entry_id": "8937b429-9ed2-35d5-8398-01046e57bebe",
                        "glosses": [
                            "Regel, die den Umgang mit der Lüftung vorgibt und nur geringfügig den Zwang enthält, sich daran zu halten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abb25649-b605-4bf3-b771-c714d088cb38",
                                "sense_id": "d0ba4a56-7a3d-3614-b6a6-a8040d2bb035",
                                "text": "„Das Projekt wird gesundheitsbasierte EU-Lüftungsrichtlinien für nicht-industrielle Gebäude (Büros, Wohnungen, Schulen, Kindergärten und Tagesstätten) erarbeiten.“"
                            },
                            {
                                "example_id": "a100404e-1157-4339-b128-f365064a5b6f",
                                "sense_id": "d0ba4a56-7a3d-3614-b6a6-a8040d2bb035",
                                "text": "„Luftkanäle, Schalldämpfer, Zuluftventile, Lufteinlassgitter und Fortluftrohre sind gemäß den Lüftungsrichtlinien zu montieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
