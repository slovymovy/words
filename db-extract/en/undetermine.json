                        "glosses": [
                            "To undo the determining of; to make uncertain."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f8a93a9b-68bc-468a-b179-8b68f718bc72",
                                "sense_id": "a3c42244-eada-3030-8ffd-5c65175c7527",
                                "text": "The antithetical features of atomist doctrine are no longer seen as undetermining the principle of the atom, or negating sensuous appearance, but rather as intrinsic to both. Nature is full of contradictions […]"
                            },
                            {
                                "example_id": "77a5fe95-0848-4624-8268-6f2ce36b3989",
                                "sense_id": "a3c42244-eada-3030-8ffd-5c65175c7527",
                                "text": "In such cases, even the licence conferred by strict speaking is powerless to 'undetermine' the statement—to make any and every context seem admissible."
                            }
                        ]
                    }
