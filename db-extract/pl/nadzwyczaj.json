                                "sense_id": "03708660-edde-3fe4-8313-3f31470804c3",
                                "text": "Ten pomysł wydaje mi się nadzwyczaj rozsądny."
                            },
                            {
                                "example_id": "e5646edf-be7c-4bf7-819e-fd3b487ac4c3",
                                "sense_id": "03708660-edde-3fe4-8313-3f31470804c3",
                                "text": "W tym roku wiosna była nadzwyczaj piękna."
                            },
                            {
                                "example_id": "13ca9f79-f697-4b55-96c8-6eb76e9ab185",
                                "sense_id": "03708660-edde-3fe4-8313-3f31470804c3",
                                "text": "Dziś czuję się nadzwyczaj dobrze."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
