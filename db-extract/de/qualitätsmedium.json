                "senses": [
                    {
                        "sense_id": "8eee6d17-8ba5-331f-b5f7-f40430a4f410",
                        "entry_id": "1093d9f6-08b0-3c5b-b503-451dcb0f8a2a",
                        "glosses": [
                            "Medium, das in der Gesellschaft für qualitativ hochwertige und seriöse Berichterstattung steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "534c8ece-fd4d-444a-9e2d-7a54c92a0854",
                                "sense_id": "8eee6d17-8ba5-331f-b5f7-f40430a4f410",
                                "text": "„An keiner Stelle gibt Twitter vor, ein Qualitätsmedium zu sein, das Anforderungen wie dem Trennungsgebot unterliegt, um eine unabhängige Berichterstattung zu garantieren.“"
                            },
                            {
                                "example_id": "d4c244c8-f4a6-4894-81a6-69ba5d4b8b8e",
                                "sense_id": "8eee6d17-8ba5-331f-b5f7-f40430a4f410",
                                "text": "„Auf Organisationsebene sind bei Qualitätsmedien mehr Auslandskorrespondenten beschäftigt, und in einzelnen Berichterstattungsfeldern gibt es eine höhere Form von Spezialisierung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
