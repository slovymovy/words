                    {
                        "translation_id": "05c29b43-e4c3-4fad-ac35-f1c43b4c1018",
                        "source_entry_id": "000244f2-8f24-3782-b35e-17f97fc1a7d8",
                        "source_sense_id": "0895e417-f59b-3178-84b1-e271a5f35f66",
                        "source_sense_description": "durch einen Ring zusammengehaltene Gegenstände zum Schließen und Öffnen von Schlössern",
                        "target_lang_word": "trousseau de clefs",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trousseau de clefs",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3f12d5d-cd32-3ebb-a39f-7e413e5a476e",
                                        "entry_id": "59d95d07-bdbe-37ff-a7d1-55d5d225b6c2",
                                        "glosses": [
                                            "Ensemble de plusieurs clefs, utilisées par une même personne, et réunies par une boucle de métal, de cordelette, un porte-clefs, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "530a8d98-e549-4652-aa25-3fd76011eaa2",
                                                "sense_id": "f3f12d5d-cd32-3ebb-a39f-7e413e5a476e",
                                                "text": "Il n’avait d’autre arme qu’un poignard fixé à sa ceinture, lequel servait de pendant à un trousseau de clefs rouillées attaché de l’autre côté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2dfdca6a-217d-460c-b121-96c90a4f520f",
                        "source_entry_id": "000244f2-8f24-3782-b35e-17f97fc1a7d8",
                        "source_sense_id": "0895e417-f59b-3178-84b1-e271a5f35f66",
                        "source_sense_description": "durch einen Ring zusammengehaltene Gegenstände zum Schließen und Öffnen von Schlössern",
                        "target_lang_word": "trousseau de clés",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trousseau de clés",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "225ff2c2-4179-3217-8337-71102ca671d0",
                                        "entry_id": "f9a2e774-f7f7-364b-baea-6f3368fea423",
                                        "glosses": [
                                            "Variante orthographique de trousseau de clefs."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e9fe82-4e55-499f-9de0-80943984736c",
                                                "sense_id": "225ff2c2-4179-3217-8337-71102ca671d0",
                                                "text": "J’allai chercher le trousseau de clés et redescendis tranquillement d’un étage.\nDes mille clés, la cent cinquante-deuxième ouvrit la porte des M."
                                            },
                                            {
                                                "example_id": "6a90fbef-8790-409b-8926-76c4a9df4b12",
                                                "sense_id": "225ff2c2-4179-3217-8337-71102ca671d0",
                                                "text": "C'est infernal ! Elle les trouve ses clés ? Pauvre femme ! À trembler comme elle tremble, elle ferait mieux d'attacher son trousseau de clés à quelque chose de facilement attrapable. Attrapable, ça se dit ça ? Peu importe."
                                            },
                                            {
                                                "example_id": "5d498b31-99ea-4144-9998-a25ddcbb3afc",
                                                "sense_id": "225ff2c2-4179-3217-8337-71102ca671d0",
                                                "text": "Les jetons matériels sont généralement assez petits pour être transportés dans une poche ou un sac et sont souvent munis d'un anneau permettant de l'accrocher à un trousseau de clés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ce77c48-842e-40e6-ba5d-03e310bff514",
                        "source_entry_id": "000244f2-8f24-3782-b35e-17f97fc1a7d8",
                        "source_sense_id": "0895e417-f59b-3178-84b1-e271a5f35f66",
                        "source_sense_description": "durch einen Ring zusammengehaltene Gegenstände zum Schließen und Öffnen von Schlössern",
                        "target_lang_word": "trousseau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trousseau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "804966eb-16a3-38e5-a42c-b46ffacd9918",
                                        "entry_id": "325405ec-b0bc-36a9-ad7c-4285ca3e6a77",
                                        "glosses": [
                                            "Petite trousse."
                                        ],
                                        "tags": [],
                                        "note": "Il n’est guère usité, en ce sens, que dans l'expression ; trousseau de clefs",
                                        "examples": [
                                            {
                                                "example_id": "8351e36b-8834-488b-9560-a867f60f701f",
                                                "sense_id": "804966eb-16a3-38e5-a42c-b46ffacd9918",
                                                "text": "Comme maîtresse de maison, Alix a en gouvernation les clefs des appartements. Elle a tiré du trousseau poudreux relégué a l'office la clef qui ouvre la porte de la chambre de son cousin, […]."
                                            },
                                            {
                                                "example_id": "aadff71d-905f-40c2-86f6-474c0d1c88a9",
                                                "sense_id": "804966eb-16a3-38e5-a42c-b46ffacd9918",
                                                "text": "Un matin d’hiver, il partit avant le jour, bien équipé, une arbalète sur l’épaule et un trousseau de flèches à l’arçon de la selle."
                                            },
                                            {
                                                "example_id": "f521c36f-64b3-404b-a34d-8f6134970220",
                                                "sense_id": "804966eb-16a3-38e5-a42c-b46ffacd9918",
                                                "text": "Toutes les clés de la maison, des armoires et des coffres, cliquetaient autour de sa taille en un trousseau noué à sa ceinture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "384e338e-dfc1-35db-95a3-f0f2cfb6131b",
                                        "entry_id": "325405ec-b0bc-36a9-ad7c-4285ca3e6a77",
                                        "glosses": [
                                            "Vêtements, linge, tout ce qu’on donne à une jeune fille lorsqu’elle se marie ou se fait religieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d84981b-1d25-4eca-8f9a-92515e7af791",
                                                "sense_id": "384e338e-dfc1-35db-95a3-f0f2cfb6131b",
                                                "text": "Elle cousait, de ses petites mains maladroites, son humble trousseau de fiancée nomade."
                                            },
                                            {
                                                "example_id": "577e4cb6-aea7-47d4-b638-403c3066532e",
                                                "sense_id": "384e338e-dfc1-35db-95a3-f0f2cfb6131b",
                                                "text": "A douze ans, les filles se marient, si toutefois elles ont un trousseau complet ; autrement, les partis ne se présenteraient pas. Ce trousseau, il faut qu'elles le fassent elles-mêmes; la plus habile est la mieux ornée."
                                            },
                                            {
                                                "example_id": "e80baeed-bbab-4952-b6b5-ed419a8410ca",
                                                "sense_id": "384e338e-dfc1-35db-95a3-f0f2cfb6131b",
                                                "text": "MARIE. – Moi, madame, j’aurai dix mille francs de dot. Mon trousseau est prêt depuis longtemps. C’est celui d’une sœur de ma mère qui est morte à dix-huit ans, il y a une vingtaine d’années. J’aurai aussi une machine à coudre qu’on a gagnée à la loterie."
                                            },
                                            {
                                                "example_id": "52faa23d-6f5b-4fe7-880f-de4194ed458c",
                                                "sense_id": "384e338e-dfc1-35db-95a3-f0f2cfb6131b",
                                                "text": "Dose après dose, les éditeurs ont scellé un pacte tacite avec la plateforme, un pacte aux allures de mariage de raison. Il faut dire que le trousseau de la mariée est bien garni avec ses deux milliards d’utilisateurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3270437-e83a-3196-985e-ce5f63f2a360",
                                        "entry_id": "325405ec-b0bc-36a9-ad7c-4285ca3e6a77",
                                        "glosses": [
                                            "Ensemble des vêtements, du linge, etc., que devait apporter un élève, ou qu’on lui fournissait, lors de son entrée dans une école, dans une maison d’éducation, etc."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "620c0201-763c-4e36-bdde-15a73a8a9838",
                                                "sense_id": "b3270437-e83a-3196-985e-ce5f63f2a360",
                                                "text": "Les pièces dont se compose le trousseau réglementaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41171fc1-8a2a-3c63-8aff-7af8c863a178",
                                        "entry_id": "325405ec-b0bc-36a9-ad7c-4285ca3e6a77",
                                        "glosses": [
                                            "Liste de vêtements que les enfants doivent avoir lorsqu’ils partent en colonie de vacances, en centre ou à l’hôpital."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e58b4c47-e895-4c64-95cb-4e02ebb852e4",
                                                "sense_id": "41171fc1-8a2a-3c63-8aff-7af8c863a178",
                                                "text": "Avant de partir, je dois t’acheter des chaussettes pour compléter ton trousseau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trousseau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f4b200a-bb01-3f5b-9fb1-bd95000131dd",
                                        "entry_id": "f0d3c9c3-63bb-34d8-a0c7-e5aee8759222",
                                        "glosses": [
                                            "Cépage originaire du Jura, où il est utilisé pour les vins rouges."
                                        ],
                                        "tags": [
                                            "Viticulture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2710b488-70f9-4a71-b5df-01ee8ab95046",
                                                "sense_id": "7f4b200a-bb01-3f5b-9fb1-bd95000131dd",
                                                "text": "L’appellation Arbois, qui se décline en blanc et en rosé, est surtout connue pour ses rouges réalisés avec le trousseau, un cépage authentique d’origine comtoise et qui fournit des vins élégants et lumineux aux saveurs poivrées et épicées."
                                            },
                                            {
                                                "example_id": "74384dbe-50cd-4ba6-8967-85e01219d819",
                                                "sense_id": "7f4b200a-bb01-3f5b-9fb1-bd95000131dd",
                                                "text": "Capitale du cépage du trousseau, Montigny est un village bâti en amphithéâtre sur le versant occidental du Jura."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
