                                    {
                                        "sense_id": "fa212b37-1bd2-3683-ac35-9914de12ec2b",
                                        "entry_id": "f750af24-1b9f-391b-bacc-1a1b741fa738",
                                        "glosses": [
                                            "In secret, covertly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "955eb3c7-3628-4239-b56d-95885089fe35",
                                                "sense_id": "fa212b37-1bd2-3683-ac35-9914de12ec2b",
                                                "text": "Mary cheated secretly in the test, and never got caught."
                                            },
                                            {
                                                "example_id": "0700bdb5-d9fa-46ff-b7bd-e8349ca073f2",
                                                "sense_id": "fa212b37-1bd2-3683-ac35-9914de12ec2b",
                                                "text": "Sometimes her prose hyperventilates (\"Once, years ago, his and N.'s love for each other had glowed like phosphorescent fire on the surfaces of their bodies\"), and she has a weakness for epiphanies (\"There was a man, no longer young, though not yet old, who, traveling alone in northern Europe, began to feel that his soul was being drained slowly, almost secretly from him, drop by drop\")."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7ce549e-c0a1-44f0-be5f-3a797cab0a58",
                        "source_entry_id": "45f5640a-ef5b-34a1-8c6b-fe09569d5c55",
                        "source_sense_id": "ea50f0f3-b8c5-38ca-9512-08e8111af935",
                        "target_lang_word": "covertly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "covertly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbc7747d-dec1-3af1-a66e-956efd365119",
                                        "entry_id": "a3bb890e-6fa6-34b6-931c-40839b77a4f0",
                                        "glosses": [
                                            "In a covert manner, secretly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92bcb9ca-86e5-436e-a2e8-011c96b45972",
                                                "sense_id": "dbc7747d-dec1-3af1-a66e-956efd365119",
                                                "text": "Only a little removed from the predatory oafdom of male adolescence, he is suspicious of Christian and covertly protective of Cher's person and future."
                                            },
                                            {
                                                "example_id": "4798c8cc-07f7-44d9-a834-66cc6191142d",
                                                "sense_id": "dbc7747d-dec1-3af1-a66e-956efd365119",
                                                "text": "Shimon’s interestingly stereotypical role as a conformist, but in reality covertly resistant, dominand […] is accentuated in the second half of the story[.]"
                                            },
                                            {
                                                "example_id": "24ad0c24-4686-450c-8018-b6559624688a",
                                                "sense_id": "dbc7747d-dec1-3af1-a66e-956efd365119",
                                                "text": "Over at least the past year, RT and its employees, including KOSTIANTYN KALASHNIKOV, a/k/a \"Kostya,\" and ELENA AFANASYEVA, a/k/a \"Lena,\" the defendants, have deployed nearly $10 million, laundered through a network of foreign shell entities, to covertly fund and direct U.S. Company-1."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
