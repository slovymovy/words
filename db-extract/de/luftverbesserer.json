                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12a8ca03-77aa-4292-bdb1-423eef3a7d5c",
                                "sense_id": "066eeaf7-be05-3919-bf74-6597fd47997e",
                                "text": "„Beim nächsten Rastplatz fuhren wir raus, und ich stürmte in den Laden, um einen Luftverbesserer zu kaufen.“"
                            },
                            {
                                "example_id": "65dc53ed-0211-4711-b228-7dbe94cb2e0a",
                                "sense_id": "066eeaf7-be05-3919-bf74-6597fd47997e",
                                "text": "„Ein Hauch von parfümiertem Luftverbesserer streifte seine Nüstern, als er erneut tief durchatmete.“"
                            },
                            {
                                "example_id": "ccfc7fb4-c1b0-4b0d-b2f1-42c25fe6863b",
                                "sense_id": "066eeaf7-be05-3919-bf74-6597fd47997e",
                                "text": "„Jetzt besprühte Earl die Ränder der Grube und die Erde innerhalb der Grenzen der Hundehütte mit dem Luftverbesserer aus der Spraydose, den Laird nicht leiden konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
