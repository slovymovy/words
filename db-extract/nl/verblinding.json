                        "sense_id": "789f7bd1-6be3-316b-8291-aa5e68f2ab36",
                        "entry_id": "2064233a-7488-374d-ac12-757f70956547",
                        "glosses": [
                            "een ding zo helder zien dat men alle andere zaken niet meer kan of wil waarnemen"
