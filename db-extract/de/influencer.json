                    },
                    {
                        "form_id": "917adbb9-cd85-48c9-9af8-e2bd397c8da6",
                        "entry_id": "7eeefdeb-db6c-3efd-95f7-a6fcf6411ebd",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Influencer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ca0bb110-06a5-3994-9db8-557b07020dee",
                        "entry_id": "7eeefdeb-db6c-3efd-95f7-a6fcf6411ebd",
                        "glosses": [
                            "Person, die aufgrund ihres häufigen Auftretens und ihrer guten Reputation in ihrem sozialen Netzwerk als marktwirtschaftlich interessante Person, also als Werbeträger, in Frage kommt und so gegen Entgelt eingesetzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b78a7620-dfa3-4dcc-83fb-33b093c7a187",
                                "sense_id": "ca0bb110-06a5-3994-9db8-557b07020dee",
                                "text": "Der Influencer vermarktete das Produkt öffentlichkeitswirksam."
                            },
                            {
                                "example_id": "a7542cd7-c8af-4354-9982-961dae1348ef",
                                "sense_id": "ca0bb110-06a5-3994-9db8-557b07020dee",
                                "text": "Influencer verpacken Werbebotschaften als freundschaftliche Empfehlung."
                            },
                            {
                                "example_id": "dd106599-8ea8-4e60-8e33-0066fbb5f92a",
                                "sense_id": "ca0bb110-06a5-3994-9db8-557b07020dee",
                                "text": "Influencer sorgen für Authentizität."
                            },
                            {
                                "example_id": "b043b66c-c230-40c2-8877-1987e766d7a1",
                                "sense_id": "ca0bb110-06a5-3994-9db8-557b07020dee",
                                "text": "„Du kannst als Influencer total viel Geld machen, schon als Teenager; […]“"
                            },
                            {
                                "example_id": "2be46d35-78e3-47fe-814a-2367b09574e7",
                                "sense_id": "ca0bb110-06a5-3994-9db8-557b07020dee",
                                "text": "Wer regelmäßig im Netz unterwegs ist, kommt an Influencern nicht vorbei."
                            },
                            {
                                "example_id": "5910655a-66c4-452e-8879-51db191d3aa2",
                                "sense_id": "ca0bb110-06a5-3994-9db8-557b07020dee",
                                "text": "Posten für die Bundeswehr, Meetings im Kanzleramt, T-Shirts für das Entwicklungsministerium: Die Bundesregierung investiert massiv in Reichweiten auf Social Media. Doch dürfen Influencer auf ihren Kanälen überhaupt für den Staat werben?"
                            },
                            {
                                "example_id": "0124c66f-5556-4df1-8af3-ab4b4be67d89",
                                "sense_id": "ca0bb110-06a5-3994-9db8-557b07020dee",
                                "text": "„Erst als die Influencer anfingen, die Produkte in die Kamera zu halten, ging das Geschäft richtig los.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65ffcfd4-ad88-49c8-acad-27077fec9931",
                        "source_entry_id": "7eeefdeb-db6c-3efd-95f7-a6fcf6411ebd",
                        "source_sense_id": "ca0bb110-06a5-3994-9db8-557b07020dee",
                        "target_lang_word": "influenceur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "influenceur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96e14dea-78ab-33dd-8e80-d9d995bc18e7",
                                        "entry_id": "0cd0bfed-9749-313c-adc2-6927228cad25",
                                        "glosses": [
                                            "Personne qui, grâce à son exposition médiatique, exerce une influence sur un public qui peut être commerciale ou publicitaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5815bdb1-37bd-4b5d-bbad-454497add39a",
                                                "sense_id": "96e14dea-78ab-33dd-8e80-d9d995bc18e7",
                                                "text": "Elle est adorée des publicitaires, des intellos, des designers, bref, des influenceurs qui font la tendance et amplifient son impact."
                                            },
                                            {
                                                "example_id": "cdc69d07-2379-42e5-9d09-930e626a3f97",
                                                "sense_id": "96e14dea-78ab-33dd-8e80-d9d995bc18e7",
                                                "text": "Un influenceur se positionne comme un leader d’opinion ; il assure une forte présence sur le Web, souvent via les réseaux sociaux."
                                            },
                                            {
                                                "example_id": "c81b9087-6334-4974-8ffb-09981d495772",
                                                "sense_id": "96e14dea-78ab-33dd-8e80-d9d995bc18e7",
                                                "text": "Tiens, comme ces influenceurs, là, qui influencent les lecteurs influençables pour devenir influents. Des manipulateurs, oui ! Des trafiquants d'influence !"
                                            },
                                            {
                                                "example_id": "417c5558-d74b-4558-8877-e70a5d7e1a8f",
                                                "sense_id": "96e14dea-78ab-33dd-8e80-d9d995bc18e7",
                                                "text": "Pire encore, ceux qui sont chargés d’assurer l’infinie explication du monde ne sont plus, généralement, ceux qui pensent, mais ceux que le réseau a déjà désignés par effet d’algorithmes et de statistiques comme influenceurs."
                                            },
                                            {
                                                "example_id": "1dd5dfab-fd9d-49ec-948f-ddc9fd647609",
                                                "sense_id": "96e14dea-78ab-33dd-8e80-d9d995bc18e7",
                                                "text": "Les influenceurs «saisonniers», qui apparaissent dès que les saisons télévisuelles se terminent, se succèdent annuellement et deviennent hyper-présents quelques mois, avant, pour la plupart, de tomber dans l’oubli."
                                            },
                                            {
                                                "example_id": "9ab3b2e1-8738-4903-8b83-ee5a78ac7f03",
                                                "sense_id": "96e14dea-78ab-33dd-8e80-d9d995bc18e7",
                                                "text": "Kevin possédait un vieux compte Facebook qui réunissait ses parents et une poignée d'amis, ainsi qu'un Instagram datant de ses années d’AgroParisTech et un Twitter qu'il utilisait de manière passive. Les seuls influenceurs qu'il suivait étaient des géodrilologues."
                                            },
                                            {
                                                "example_id": "e7f628c0-04a4-45d4-a935-78f83f1ca3fe",
                                                "sense_id": "96e14dea-78ab-33dd-8e80-d9d995bc18e7",
                                                "text": "Leur commercialisation est souvent confiée à des influenceurs sur les réseaux sociaux qui ne déclarent pas publiquement qu’ils ont un intérêt économique à commercialiser certains crypto-actifs."
                                            },
                                            {
                                                "example_id": "8b854aa7-cf7a-4f25-93ba-5ff1ca8cd2e6",
                                                "sense_id": "96e14dea-78ab-33dd-8e80-d9d995bc18e7",
                                                "text": "En 2023, le gouvernement français estimait à 150 000 le nombre d' influenceurs actifs sur YouTube, Instagram, TikTok ou encore Facebook et a voulu encadrer ce marché économique, qualifié à l’époque de Far West numérique, en proposant un projet de loi. Le texte qui a été adopté est destiné à lutter contre certaines dérives des influenceurs et des arnaques maintes fois constatées sur les réseaux sociaux."
                                            },
                                            {
                                                "example_id": "7fe93adb-a91d-45d5-a1fb-ee6029d7b5b7",
                                                "sense_id": "96e14dea-78ab-33dd-8e80-d9d995bc18e7",
                                                "text": "Sur les vidéos analysées par Bruxelles, la quasi-totalité des clips publiés par les influenceurs, soit 97 %, affichaient « des contenus commerciaux » en oubliant « systématiquement » de prévenir les internautes que leur message était commandité moyennant finance par des marques."
                                            },
                                            {
                                                "example_id": "f5734ae4-bdb6-4efd-8974-79a6423ebbf9",
                                                "sense_id": "96e14dea-78ab-33dd-8e80-d9d995bc18e7",
                                                "text": "Le statut d’ influenceur commercial sera désormais reconnu à toute personne physique ou morale, mobilisant sa notoriété auprès de ses followers, par voie électronique, à titre onéreux, pour communiquer des contenus promotionnels."
                                            },
                                            {
                                                "example_id": "c9d3afff-6573-447a-af54-3bf256e8c040",
                                                "sense_id": "96e14dea-78ab-33dd-8e80-d9d995bc18e7",
                                                "text": "L’étude a également révélé que les entreprises rendent souvent difficile l’annulation des abonnements, et que les influenceurs sur les réseaux sociaux se livrent parfois à des promotions trompeuses."
                                            },
                                            {
                                                "example_id": "eec73f2c-609e-44dd-a702-a6c8eed9a645",
                                                "sense_id": "96e14dea-78ab-33dd-8e80-d9d995bc18e7",
                                                "text": "“Selon des documents déclassifiés des services de renseignement, des influenceurs rémunérés, ainsi que des membres de groupes d’extrême droite et des personnes liées au crime organisé, ont promu la candidature de Calin Georgescu en ligne avant le 24 novembre”, raconte Politico."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a77c9ca8-3eef-4108-9726-5be05d43190d",
                        "source_entry_id": "7eeefdeb-db6c-3efd-95f7-a6fcf6411ebd",
                        "source_sense_id": "ca0bb110-06a5-3994-9db8-557b07020dee",
                        "target_lang_word": "influencer",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "influencer",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "580a5bb2-c646-3525-b88b-a570fc1be564",
                                        "entry_id": "7e165efe-e7b2-3951-822a-9df262a404cd",
                                        "glosses": [
                                            "osoba mająca wpływ na opinie i decyzje innych, zwykle twórca internetowy o znacznym rozgłosie posiadający znaczne grono odbiorców"
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "206cd954-4807-4fc7-9881-fc9404c3d91e",
                                                "sense_id": "580a5bb2-c646-3525-b88b-a570fc1be564",
                                                "text": "Influencerzy umiejętnie budują wokół siebie grupę lojalnych odbiorców, z którymi łączą ich silne relacje i zainteresowania"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
