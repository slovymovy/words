                "senses": [
                    {
                        "sense_id": "23e1143e-935a-3769-bfe7-56cecd33cb4e",
                        "entry_id": "38f603ea-4e54-3c3b-bbcd-9c53fec5ffe2",
                        "glosses": [
                            "État de ce qui s’assombrit, au propre comme au figuré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cf5a02e-e0c2-414e-b12b-dc7633e593ec",
                                "sense_id": "23e1143e-935a-3769-bfe7-56cecd33cb4e",
                                "text": "L’assombrissement du ciel."
                            },
                            {
                                "example_id": "76927e9a-40ae-44d7-a398-b8f64cd64923",
                                "sense_id": "23e1143e-935a-3769-bfe7-56cecd33cb4e",
                                "text": "Le commencement des devoirs, des leçons, des cahiers, des taches d’encre, ah ! quel assombrissement subit dans mon histoire !"
                            },
                            {
                                "example_id": "d4c96cc2-9413-4e4a-bc93-d979b060a8f7",
                                "sense_id": "23e1143e-935a-3769-bfe7-56cecd33cb4e",
                                "text": "Un assombrissement est visible sur le bord de la tache polaire, à l’est d’Argyre."
                            },
                            {
                                "example_id": "a2544bde-0b87-4601-9d9e-08f9857b0575",
                                "sense_id": "23e1143e-935a-3769-bfe7-56cecd33cb4e",
                                "text": "L’assombrissement de son caractère."
                            }
                        ]
                    },
                    {
