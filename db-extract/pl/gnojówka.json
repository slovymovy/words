                        "cross_references": [
                            {
                                "target_word": "močůvka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "b5704033-130a-364f-9c81-a3be278353ab",
                                        "entry_id": "858b1c15-e809-3d4e-9028-19850cbb81e4",
                                        "glosses": [
                                            "směs moči hospodářských zvířat a stájových splašků"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a95b5a3-cbfa-4bed-b3a4-c9d58921a835",
                                                "sense_id": "b5704033-130a-364f-9c81-a3be278353ab",
                                                "text": "Zemědělci přestali používat močůvku na hnojení kvůli znečištění povrchových vod fosforem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bba9d7e2-4709-4129-852d-1e0b816c7eda",
                        "source_entry_id": "911398f4-2022-3895-a851-1709db3cc462",
                        "source_sense_id": "c984395d-4f56-39c1-82ee-42b724427af3",
                        "target_lang_word": "purin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "purin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c3db7d7-53ab-360a-bc20-09f1aecda08b",
                                        "entry_id": "3fac9be9-ef9d-3db2-b4bc-ad8d40df5e89",
                                        "glosses": [
                                            "Partie liquide du fumier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0a12e9b-c7e9-4122-815a-8281ab5631af",
                                                "sense_id": "5c3db7d7-53ab-360a-bc20-09f1aecda08b",
                                                "text": "Il n’y avait dans la cour, formée par quatre pauvres bâtiments, aucun être vivant, sinon les poules picorant le fumier qui, tout près de la bergerie, baignait dans un lit immonde de purin."
                                            },
                                            {
                                                "example_id": "a0109aef-0f28-412c-8bfa-825264bd8e4b",
                                                "sense_id": "5c3db7d7-53ab-360a-bc20-09f1aecda08b",
                                                "text": "Il crut marcher une dernière fois dans la grande rue, criblée de soleil, parmi les tas de fumier, suant les flots noirs de purin, […]."
                                            },
                                            {
                                                "example_id": "e926a290-761d-4f5f-93bc-bd7ce3176adf",
                                                "sense_id": "5c3db7d7-53ab-360a-bc20-09f1aecda08b",
                                                "text": "Le village auvergnat est resté malpropre, boueux, puant, délavé par les purins; il est sans lumières; les conditions d'habitation y sont exécrables."
                                            },
                                            {
                                                "example_id": "4f04084b-d952-44b0-b472-2e4aeb60fd81",
                                                "sense_id": "5c3db7d7-53ab-360a-bc20-09f1aecda08b",
                                                "text": "Les purins, étendus de quatre à six fois leur volume d'eau et utilisés en arrosage dans les cultures de légumes herbacés, communiquent une grande vigueur aux plantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a55b4600-3cc9-33b1-a3c1-e7a304947b28",
                                        "entry_id": "3fac9be9-ef9d-3db2-b4bc-ad8d40df5e89",
                                        "glosses": [
                                            "Produit issu de la macération de certains végétaux, utilisé à des fins de fertilisation ou de traitement des cultures."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b656b0e-47d5-4b9e-8abc-7fdc8bca8e83",
                                                "sense_id": "a55b4600-3cc9-33b1-a3c1-e7a304947b28",
                                                "text": "« Purins » ou « extraits fermentés » ? Peu importe le vocabulaire ... pourvu qu’on puisse en bénéficier !"
                                            },
                                            {
                                                "example_id": "cbf41964-3aa1-4882-b61f-ffc6a0558ba8",
                                                "sense_id": "a55b4600-3cc9-33b1-a3c1-e7a304947b28",
                                                "text": "Prévoyez un récipient par plante, même si, à l’application, les purins de consoude, ortie et prêle peuvent être mélangés pour certaines utilisations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
