                        "tags": [],
                        "examples": [
                            {
                                "example_id": "322fe126-2f5a-4227-bc7c-533190f908d0",
                                "sense_id": "5bd26235-2c50-3b05-809e-a2e238044a4f",
                                "text": "Sitting in the front seats of the bus staring at the storm burying the highway and the sagebrush and the antelope, Mike and I were trembling from an untaintable, undauntable expectancy."
                            },
                            {
                                "example_id": "0e564942-51f4-49bb-95a9-4b42bd6dd453",
                                "sense_id": "5bd26235-2c50-3b05-809e-a2e238044a4f",
                                "text": "How untaintable and sanctimonious are your morals and ethics?"
                            },
                            {
                                "example_id": "0a075b85-bf46-4b69-b759-165a07be9ddb",
                                "sense_id": "5bd26235-2c50-3b05-809e-a2e238044a4f",
                                "text": "This was rare for a successful Mexican politician, and his supporters held this up as proof that he was not only untainted, but untaintable."
                            }
                        ]
                    }
