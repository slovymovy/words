                ],
                "senses": [
                    {
                        "sense_id": "7a933dfd-d39a-3628-8556-b133412331bc",
                        "entry_id": "e1a53d11-1c95-3e44-b84e-22ee99253a24",
                        "glosses": [
                            "Tänzerin, welche die Funken begleitet (Akteuren in Karneval in der Uniform der ehemaligen Kölner Stadtsoldaten)"
                        ],
                        "tags": [
                            "Karneval",
                            "Fasching",
                            "Fastnacht"
                        ],
                        "examples": [
                            {
                                "example_id": "913dd670-be79-42c4-a859-aef93edf28f1",
                                "sense_id": "7a933dfd-d39a-3628-8556-b133412331bc",
                                "text": "„Denn als Mädchen tanzte sie als Funkemariechen beim Karneval in ihrer Heimatstadt Backnang (Baden-Württemberg).“"
                            },
                            {
                                "example_id": "dae9e10d-f1e4-4441-a7f0-10a630042039",
                                "sense_id": "7a933dfd-d39a-3628-8556-b133412331bc",
                                "text": "„Funkemariechen Janina lebt für die Session.“"
                            },
                            {
                                "example_id": "1fc1becc-60f9-451a-a88d-b5021d120edf",
                                "sense_id": "7a933dfd-d39a-3628-8556-b133412331bc",
                                "text": "„Das können die Funkemariechen der Katholischen Jugend Düsseldorf aus dem Effeff.“"
                            },
                            {
                                "example_id": "77165087-e70a-4b74-ad85-5951641f92e1",
                                "sense_id": "7a933dfd-d39a-3628-8556-b133412331bc",
                                "text": "„Und auch Funkemariechen Britta wird dem Gardetanz verbunden bleiben.“"
                            },
                            {
                                "example_id": "3229cde0-4eb0-4d9f-b613-952ab49a82c1",
                                "sense_id": "7a933dfd-d39a-3628-8556-b133412331bc",
                                "text": "„Bis heute tragen die richtigen Funkemariechen der alten Gesellschaften deshalb häufig noch ein Fässchen bei sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
