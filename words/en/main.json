                    "target_lang_definitions": {
                        "ru": "Чрезвычайно, крайне или очень сильно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очень",
                                "target_lang_sense_clarification": "в диалектном значении"
                            },
                            {
                                "target_lang_word": "крайне",
                                "target_lang_sense_clarification": "в диалектном значении"
                            }
                        ]
                    }
                }
            ]
        }
    ]
