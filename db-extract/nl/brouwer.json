                                    {
                                        "sense_id": "cc9c5f62-e544-3eac-b062-9927aa536f1a",
                                        "entry_id": "f3146890-9701-37df-bbcb-b8cc51a2d350",
                                        "glosses": [
                                            "Personne qui brasse de la bière et qui en vend en gros."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58469257-81fc-4040-89d0-9238007950f1",
                                                "sense_id": "cc9c5f62-e544-3eac-b062-9927aa536f1a",
                                                "text": "Quand les Fresnois sortirent des vêpres, le brasseur les engagea de nouveau à se rafraîchir."
                                            },
                                            {
                                                "example_id": "e71a0058-c7ce-4609-a484-c7c8f01956c5",
                                                "sense_id": "cc9c5f62-e544-3eac-b062-9927aa536f1a",
                                                "text": "En vérité je vous le dis, s’il existe en ce coin reculé de France un seul brasseur qui substitue encore au houblon un ersatz chimique, c’est bien grand malfaiteur, car l’Alsace, à elle seule, regorge en ce moment de houblon au point de ne savoir qu’en faire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82b6b6e2-fd13-3b8b-a5fa-010e965d41d9",
                                        "entry_id": "f3146890-9701-37df-bbcb-b8cc51a2d350",
                                        "glosses": [
                                            "Tenancier d’une brasserie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ae39626-84c5-304c-8328-7e6368e25955",
                                        "entry_id": "f3146890-9701-37df-bbcb-b8cc51a2d350",
                                        "glosses": [
                                            "Personne qui brasse."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ad0de24-543d-36e8-b689-e87788940e12",
                                        "entry_id": "f3146890-9701-37df-bbcb-b8cc51a2d350",
                                        "glosses": [
                                            "Personne qui machine, trame, complote."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1233e467-05c2-4472-9ff7-042af0e9ebd2",
                                                "sense_id": "0ad0de24-543d-36e8-b689-e87788940e12",
                                                "text": "Aristide Saccard avait enfin trouvé son milieu. Il s’était révélé grand spéculateur, brasseur de millions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brasseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30fd5678-dea1-3c30-8e3a-6a1268778c55",
                                        "entry_id": "920234da-0404-3bf0-aa51-d1f5073400c7",
                                        "glosses": [
                                            "Personne qui pratique la brasse."
                                        ],
