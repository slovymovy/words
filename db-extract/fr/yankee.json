                "senses": [
                    {
                        "sense_id": "a751a7ac-f44c-3927-853b-ed6c1dd06763",
                        "entry_id": "a5447ef9-0c72-3fd1-9c5c-5f8d6d869a72",
                        "glosses": [
                            "Relatif aux Yankees, Américains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "133c8b07-68a6-462c-84c8-e9a776b3b6fd",
                                "sense_id": "a751a7ac-f44c-3927-853b-ed6c1dd06763",
                                "text": "Je revenais de Barcelone à Paris ; dans mon compartiment se trouvait un voyageur qu’à son accent, à la coupe de sa barbe et à ce sans-gêne qui tient lieu d’éducation surtout chez les Américains, je reconnus pour un yankee."
                            },
                            {
                                "example_id": "34880fd0-e52a-4006-918e-7b03fea6e3d7",
                                "sense_id": "a751a7ac-f44c-3927-853b-ed6c1dd06763",
                                "text": "Et pourquoi tous ces discours avant l’exposé du morceau. À moins d’être familiarisé avec la langue yankee, l’amateur de jazz ne les assimile pas."
                            },
                            {
                                "example_id": "2a989954-738e-4d1c-8120-1ce8b88251cc",
                                "sense_id": "a751a7ac-f44c-3927-853b-ed6c1dd06763",
                                "text": "Les rues, les magasins, les cinémas, les tavernes de Londres s’emplissaient de militaires yankees bons garçons et sans façons."
                            }
                        ]
                    },
                    {
                        "sense_id": "686648af-efcf-3685-beea-abff76393da5",
                        "entry_id": "a5447ef9-0c72-3fd1-9c5c-5f8d6d869a72",
                        "glosses": [
                            "Relatif aux yankees, jeunes de la rue des grands centres urbains du Congo-Brazzaville ou de l’ouest du Congo-Kinshasa. référence nécessaire (résoudre le problème)"
                        ],
                        "tags": [
                            "Congo-Brazzaville",
                            "Congo-Kinshasa"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c67eb12-1ee3-4753-b3b1-aa9eb98d07a0",
                        "source_entry_id": "a5447ef9-0c72-3fd1-9c5c-5f8d6d869a72",
                        "source_sense_id": "a751a7ac-f44c-3927-853b-ed6c1dd06763",
                        "source_sense_description": "Relatif aux Yankees",
                        "target_lang_word": "Yankee",
