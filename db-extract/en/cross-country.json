                "senses": [
                    {
                        "sense_id": "e7055bd6-f341-3d36-9ffd-06cd9f7d11cd",
                        "entry_id": "7db73839-4738-3f6c-81db-46fc33f16aa6",
                        "glosses": [
                            "From one side of a country to the other."
                        ],
