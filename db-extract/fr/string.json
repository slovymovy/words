                                    {
                                        "sense_id": "6c249ffb-02fa-3fc2-9c61-7fdb4a50ada8",
                                        "entry_id": "cb20dc69-8c79-3ad0-9dc1-973634065be3",
                                        "glosses": [
                                            "A narrow strip of material, typically leather, used to fasten, bind, or secure objects."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a8d93a3-2ade-30e2-a69c-545073fdd621",
                                        "entry_id": "cb20dc69-8c79-3ad0-9dc1-973634065be3",
                                        "glosses": [
                                            "An item of footwear, usually of rubber, secured by two straps which join to pass between the big toe and its neighbour."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b7406f4-034d-4285-a27d-2b874ae89b34",
                                                "sense_id": "9a8d93a3-2ade-30e2-a69c-545073fdd621",
                                                "text": "Because of August he wears shorts and sandals, the Japanese geta sort called thongs."
                                            },
                                            {
                                                "example_id": "3199675a-93f5-4fa9-981b-3ab88fefcc68",
                                                "sense_id": "9a8d93a3-2ade-30e2-a69c-545073fdd621",
                                                "text": "T-shirts, cut-offs, and a pair of thongs (T-shirts, cut-offs, and a pair of thongs)."
                                            },
                                            {
                                                "example_id": "ce1f3b3a-3c50-418b-8006-fbd20f2e0707",
                                                "sense_id": "9a8d93a3-2ade-30e2-a69c-545073fdd621",
                                                "text": "2006, Peter Murray, David Poole, Grant Jones, Contemporary Issues in Management and Organisational Behaviour, Thomson, page 108,\nPlayers turned up for questioning wearing thongs, shorts and T-shirts."
                                            },
                                            {
                                                "example_id": "f9dfdf6d-7606-4549-980c-e57481cf3506",
                                                "sense_id": "9a8d93a3-2ade-30e2-a69c-545073fdd621",
                                                "text": "Thongs are the favoured footwear for many Aussies, especially near the beaches, but most people in the Outback find that they can't put a foot wrong with a tough, nicely worn-in pair or workboots."
                                            },
                                            {
                                                "example_id": "b0133d59-3828-4ac3-a240-e1eb7027a4b2",
                                                "sense_id": "9a8d93a3-2ade-30e2-a69c-545073fdd621",
                                                "text": "You shouldn′t face condescension if you rock into a boutique in your thongs and a singlet, but neither will you be treated like a princess just because you've splashed $5000 on daddy's credit card."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5323ed4-bdbc-3d0a-8c89-8f531f2e9379",
                                        "entry_id": "cb20dc69-8c79-3ad0-9dc1-973634065be3",
                                        "glosses": [
                                            "An item of clothing, usually an undergarment or swimwear consisting of very narrow strips designed to cover just the genitals and nothing more."
                                        ],
                                        "tags": [
                                            "UK",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9f1c149-24e7-4b1f-b755-699435be0092",
                                                "sense_id": "f5323ed4-bdbc-3d0a-8c89-8f531f2e9379",
                                                "text": "She was impressed by her friend's confidence to wear a thong on the crowded beach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fee0b64-7f2a-3cf8-a5c7-bf5c732e7131",
                                        "entry_id": "cb20dc69-8c79-3ad0-9dc1-973634065be3",
                                        "glosses": [
                                            "The largest section of a bullwhip constructed of many straps of braided leather."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
