                    {
                        "sense_id": "42e0f7a3-f49d-399a-89d6-6bfdcbff9f45",
                        "entry_id": "0e4844ff-acd9-37bd-87a9-4be6db2100ec",
                        "glosses": [
                            "Vorschrift, die besagt, dass bestimmte Fahrzeuge oder Verkehrsteilnehmer nachts nicht fahren dürfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a34c7d19-d58f-4e80-b728-546155f32f09",
                                "sense_id": "42e0f7a3-f49d-399a-89d6-6bfdcbff9f45",
                                "text": "Die Regierung dementiert ein Vorhaben, das zu einem Nachtfahrverbot für Pkw in Innenstädten führen würde."
                            },
                            {
                                "example_id": "5cd48eae-b8ea-4e29-929f-d252745fb874",
                                "sense_id": "42e0f7a3-f49d-399a-89d6-6bfdcbff9f45",
                                "text": "Ein Nachtfahrverbot zielt in erster Linie darauf ab, die Nachtruhe von Anwohnern der betroffenen Straßen (meist Bundesstraßen und stark befahrene Hauptstraßen) sicherzustellen."
                            },
                            {
                                "example_id": "19da7f4c-4c98-4d28-8704-8e1fdc939e05",
                                "sense_id": "42e0f7a3-f49d-399a-89d6-6bfdcbff9f45",
                                "text": "„Nachtfahrverbot – Auf folgenden Seen und seenartigen Erweiterungen dürfen Sportfahrzeuge mit in Betrieb gesetztem Verbrennungsmotor während der Zeit von 22:00 Uhr bis 05:00 Uhr nicht fahren (Fahrverbot): Kleiner Müggelsee, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
