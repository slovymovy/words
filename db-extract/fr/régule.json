                        "entry_id": "ee4655ab-7b18-3f72-b8e1-2bc0f00c2129",
                        "glosses": [
                            "Ensemble de deux poids servant de régulateur à une horloge à foliot (traverse portant ces poids)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9c0f4d1-c43a-4391-a36f-12c24e9fa0de",
                                "sense_id": "082fba58-56f8-33cb-983c-3515b1063bb1",
                                "text": "Selon qu’on approche ou qu’on éloigne du centre du foliot les poids du régule, on peut faire avancer ou retarder l’horloge."
                            }
                        ]
                    }
                ],
