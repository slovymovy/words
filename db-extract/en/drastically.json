                        "tags": [
                            "comparative"
                        ],
                        "form": "more drastically"
                    },
                    {
                        "form_id": "ee38db55-879d-4dcb-98e0-4558c31cf084",
                        "entry_id": "51c0a4d5-77b3-3e7a-974e-7c633bcc2796",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most drastically"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b78cc53-0eeb-3d12-af2a-0407355775dd",
                        "entry_id": "51c0a4d5-77b3-3e7a-974e-7c633bcc2796",
                        "glosses": [
                            "To a drastic degree."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5301fbab-cb5a-46af-b403-4f7bfe104afc",
                                "sense_id": "8b78cc53-0eeb-3d12-af2a-0407355775dd",
                                "text": "drastically reduced prices"
                            },
                            {
                                "example_id": "5a443ea4-2eab-45e4-9a83-562d06924126",
                                "sense_id": "8b78cc53-0eeb-3d12-af2a-0407355775dd",
                                "text": "This recession has been drastically different."
                            },
                            {
                                "example_id": "243b3674-2d26-4334-a91e-9999411e857a",
                                "sense_id": "8b78cc53-0eeb-3d12-af2a-0407355775dd",
                                "text": "The corn ration was drastically reduced, and it was announced that an extra potato ration would be issued to make up for it."
                            },
                            {
                                "example_id": "20d2bad9-53cc-4e95-84a3-e34126feb993",
                                "sense_id": "8b78cc53-0eeb-3d12-af2a-0407355775dd",
                                "text": "On Christmas Day itself there will be no trains, for recent experience has shown that few wish to travel then, even on services which had been drastically reduced: earlier closing of shops and offices on Christmas Eve is the chief reason for this change in the pattern of travel."
                            },
                            {
                                "example_id": "e9954274-ebad-4072-96cb-e9a1acef11c7",
                                "sense_id": "8b78cc53-0eeb-3d12-af2a-0407355775dd",
                                "text": "The proposed cuts mean that the agency could be forced to drastically shrink its workforce from about 10,000 to 294 employees."
                            }
                        ]
                    },
                    {
                        "sense_id": "d89faa17-5c2b-3d5c-9cfe-d00ed4f0b4d4",
                        "entry_id": "51c0a4d5-77b3-3e7a-974e-7c633bcc2796",
                        "glosses": [
                            "In a drastic manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9cbed27-9922-4765-8c77-7ad041f13eff",
                                "sense_id": "d89faa17-5c2b-3d5c-9cfe-d00ed4f0b4d4",
                                "text": "Lisa always wore shorts and a T-shirt, which clashed drastically with her brother's thick winter coat."
                            },
                            {
                                "example_id": "fd37d606-b5b0-48d6-811f-527935b89ff2",
                                "sense_id": "d89faa17-5c2b-3d5c-9cfe-d00ed4f0b4d4",
                                "text": "It explains why a Democratic Congress foisted Prohibition on the country and a Republican Congress drastically legislated to enforce it, when ordinarily the two parties are only too anxious for any political stick to beat each other with."
                            },
                            {
                                "example_id": "4b34f376-403b-4571-9a64-651d8300932d",
                                "sense_id": "d89faa17-5c2b-3d5c-9cfe-d00ed4f0b4d4",
                                "text": "Seldom have democratic principles been so drastically enacted into law."
                            },
                            {
                                "example_id": "6480626c-a4b4-4e34-9b9a-11899b76f95c",
                                "sense_id": "d89faa17-5c2b-3d5c-9cfe-d00ed4f0b4d4",
                                "text": "A uniform marriage and divorce law must be drastically enacted by the Central Government and rigidly administrated by the higher courts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f8174b9-5169-4104-94fa-0784dcdee6ab",
                        "source_entry_id": "51c0a4d5-77b3-3e7a-974e-7c633bcc2796",
                        "source_sense_description": "to a drastic degree",
                        "target_lang_word": "extrêmement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extrêmement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71045a72-9799-3900-8f17-0c8fae388635",
                                        "entry_id": "bec77ccd-7cf0-345d-9471-2083d2c2e27f",
                                        "glosses": [
                                            "D’une manière extrême, au dernier degré, au dernier point, à la dernière limite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48543cca-7f7d-4e41-af03-76f3d2b9fee7",
                                                "sense_id": "71045a72-9799-3900-8f17-0c8fae388635",
                                                "text": "Marseille, quand elle est belle, est extrêmement belle, mais, dans ses hideurs, elle va au paroxysme."
                                            },
                                            {
                                                "example_id": "d5dbd535-3a57-4288-91ab-e952c939f786",
                                                "sense_id": "71045a72-9799-3900-8f17-0c8fae388635",
                                                "text": "Il vous aime extrêmement."
                                            },
                                            {
                                                "example_id": "d226ccdd-1a39-4ca7-8865-3610276101cc",
                                                "sense_id": "71045a72-9799-3900-8f17-0c8fae388635",
                                                "text": "Il compose extrêmement vite."
                                            },
                                            {
                                                "example_id": "ddd51335-80c6-4a8f-b0d6-24022290337f",
                                                "sense_id": "71045a72-9799-3900-8f17-0c8fae388635",
                                                "text": "Peut-être dans la classe des gens supérieurs, est-il plus facile de trouver des gens extrêmement vertueux que des hommes extrêmement sages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86897a17-4462-3ecc-a5b4-280596375d8d",
                                        "entry_id": "bec77ccd-7cf0-345d-9471-2083d2c2e27f",
                                        "glosses": [
                                            "Très ; beaucoup ; fort."
                                        ],
                                        "tags": [
                                            "Souvent"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a94ae2b5-e267-407a-a710-6f7fc247cfbf",
                                                "sense_id": "86897a17-4462-3ecc-a5b4-280596375d8d",
                                                "text": "L’administration romaine était extrêmement dure pour tout homme qui lui semblait susceptible de troubler la tranquillité publique et surtout pour tout accusé qui bravait sa majesté."
                                            },
                                            {
                                                "example_id": "82722a3d-3753-464d-809f-7910d639958a",
                                                "sense_id": "86897a17-4462-3ecc-a5b4-280596375d8d",
                                                "text": "Enfin les îles sorties des eaux (atolls) portent une flore extrêmement pauvre, venue par des apports lointains."
                                            },
                                            {
                                                "example_id": "45c49830-4b6b-4a4b-abe1-ed45c85e3b8d",
                                                "sense_id": "86897a17-4462-3ecc-a5b4-280596375d8d",
                                                "text": "Il y a en ce lieu de certains animaux qui ont la forme du corps fort agréable et la peau extrêmement douce, souples, éveillées et plaisantes, fort aisées à apprivoiser et naturellement amies des hommes."
                                            },
                                            {
                                                "example_id": "2ef7a782-9ba6-4162-bc2a-ebfc2b23ac40",
                                                "sense_id": "86897a17-4462-3ecc-a5b4-280596375d8d",
                                                "text": "Je ne sais pas bien certainement qui vous êtes ; mais je suis assuré que la lettre que j’ai reçue ne peut être que d’un extrêmement honnête homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b823ce84-afba-34da-af9d-dc6a3a314578",
                                        "entry_id": "bec77ccd-7cf0-345d-9471-2083d2c2e27f",
                                        "glosses": [
                                            "Un nombre extrême de. Une quantité extrême de. Extrêmement beaucoup de."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efd58365-fd17-41a8-bb93-ed43c04fe997",
                                                "sense_id": "b823ce84-afba-34da-af9d-dc6a3a314578",
                                                "text": "Je vais à Vannes, Monsieur ; j’y deviens amoureux d’une femme de condition, jolie veuve, assez jeune, ayant extrêmement d’esprit et beaucoup de goût pour les lettres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b21ee4d6-5f02-4b89-91ad-6ce51c17127a",
                        "source_entry_id": "51c0a4d5-77b3-3e7a-974e-7c633bcc2796",
                        "source_sense_description": "to a drastic degree",
                        "target_lang_word": "radikal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radikal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04b5d198-ad69-3ae5-9792-7a3ab563f416",
                                        "entry_id": "1fcae27f-772f-35d8-b00f-bd867c53ae96",
                                        "glosses": [
                                            "im Denken und oder Handeln in besonderem Maße von der Norm abweichend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02a7ec95-50fe-4294-9cff-3f270d9e671a",
                                                "sense_id": "04b5d198-ad69-3ae5-9792-7a3ab563f416",
                                                "text": "Manche Menschen denken radikal, besonders dann, wenn sie zu einem Thema persönliche Erfahrungen gesammelt haben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c74bc283-1b78-3c76-b1a6-0ca36e13b965",
                                        "entry_id": "1fcae27f-772f-35d8-b00f-bd867c53ae96",
                                        "glosses": [
                                            "in besonders hervorstechendem Maße"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6426667-7f62-43a5-bc58-4b2a5aa594c9",
                                                "sense_id": "c74bc283-1b78-3c76-b1a6-0ca36e13b965",
                                                "text": "Die Verkaufspreise der Produkte wurden radikal gesenkt."
                                            },
                                            {
                                                "example_id": "c33dc026-89a4-4375-8b10-05a0b26eaf1c",
                                                "sense_id": "c74bc283-1b78-3c76-b1a6-0ca36e13b965",
                                                "text": "Der neue Eigentümer steht für einen radikalen Wechsel in der Geschäftspolitik."
                                            },
                                            {
                                                "example_id": "b2b12dff-6a82-45ca-8b13-adcc3c2ffa76",
                                                "sense_id": "c74bc283-1b78-3c76-b1a6-0ca36e13b965",
                                                "text": "„Maximal zwei Grad Erderwärmung im Vergleich zur vorindustriellen Zeit, im besten Fall sogar nur 1,5 Grad: Die Ziele des Pariser Klimaabkommens von 2015 sind ehrgeizig. Innerhalb vergleichsweise kurzer Zeit müssten die Länder den Ausstoß von Treibhausgasen radikal senken, damit das gelingt.“"
                                            },
                                            {
                                                "example_id": "eee71889-9b78-4971-abd2-fb7582c238da",
                                                "sense_id": "c74bc283-1b78-3c76-b1a6-0ca36e13b965",
                                                "text": "„Der Rechtspopulist Wilders hatte bei der Vorlage des Koalitionsabkommens am 16. Mai einen radikalen Kurswechsel für die Niederlande angekündigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "94fc38a6-dde0-3e85-adee-39c4662b53bd",
                                        "entry_id": "1fcae27f-772f-35d8-b00f-bd867c53ae96",
                                        "glosses": [
                                            "eine Bestrebung bezeichnend, die Gesellschaft umfassend (an der Wurzel) zu verändern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5508c463-d6c6-46a2-8a42-662fbee87fa5",
                                                "sense_id": "94fc38a6-dde0-3e85-adee-39c4662b53bd",
                                                "text": "„Wir möchten die Welt verändern - in ökonomischer, sozialer Hinsicht, aber es scheint mir, dass eine wesentliche äußere Veränderung nicht möglich sein wird, wenn es keine radikale psychologische Revolution, eine Transformation gibt.“"
                                            },
                                            {
                                                "example_id": "233d8d93-d0fc-4287-870b-0c0bc4addd3c",
                                                "sense_id": "94fc38a6-dde0-3e85-adee-39c4662b53bd",
                                                "text": "„Er hatte in Mailand eine Lehrerausbildung gemacht, war gläubiger Moslem, trug keinen Bart, hatte jahrelang in Italien gelebt und stand im Verdacht, eine radikale Gruppierung logistisch unterstützt zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcd41a15-3ee0-4e18-8cfd-2707b29a0b84",
                        "source_entry_id": "51c0a4d5-77b3-3e7a-974e-7c633bcc2796",
                        "source_sense_description": "to a drastic degree",
                        "target_lang_word": "drastisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drastisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23e262d6-b8fd-3482-8ed8-102ba9b84858",
                                        "entry_id": "244e01f9-2c06-34dc-a732-8c26cd6a35f4",
                                        "glosses": [
                                            "auffällig bis hin zu übertrieben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6e53eb2-5a33-4228-9d6e-17a37c5043dc",
                                                "sense_id": "23e262d6-b8fd-3482-8ed8-102ba9b84858",
                                                "text": "Mit seinem drastischen Augenrollen hat er uns ziemlich erschreckt."
                                            },
                                            {
                                                "example_id": "214e0fbf-31f6-4a07-80e5-ed083df72304",
                                                "sense_id": "23e262d6-b8fd-3482-8ed8-102ba9b84858",
                                                "text": "Ein Symptom der Krankheit sind die drastischen Bewegungen."
                                            },
                                            {
                                                "example_id": "eb2c72dc-cc67-4cb2-b58b-8022791fcbf4",
                                                "sense_id": "23e262d6-b8fd-3482-8ed8-102ba9b84858",
                                                "text": "„Was shit betrifft, ist dieses Wort möglicherweise drastischer als seine deutsche Entsprechung, und in seiner Einsilbigkeit mit dem kurzen Vokal und dem harten konsonantischen Ausgang ist es wohl auch expressiver und vielleicht schon deshalb schärfer (…).“"
                                            },
                                            {
                                                "example_id": "5710211b-7b86-4605-9271-730e299bba68",
                                                "sense_id": "23e262d6-b8fd-3482-8ed8-102ba9b84858",
                                                "text": "Ihre Reaktion war vielleicht ein wenig zu drastisch."
                                            },
                                            {
                                                "example_id": "83bdb36b-5ebd-4d8d-a37d-6cdeab4190d4",
                                                "sense_id": "23e262d6-b8fd-3482-8ed8-102ba9b84858",
                                                "text": "„Er hörte gern eine freie Meinung, je drastischer und extremer, desto besser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "75daf675-7f29-31e3-8d03-ae752c26e8f5",
                                        "entry_id": "244e01f9-2c06-34dc-a732-8c26cd6a35f4",
                                        "glosses": [
                                            "sehr stark, in hohem Maß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bb0fd22-b164-447f-b7d6-f5427c2c9cc7",
                                                "sense_id": "75daf675-7f29-31e3-8d03-ae752c26e8f5",
                                                "text": "Der Aktienkurs ist drastisch eingebrochen."
                                            },
                                            {
                                                "example_id": "4a32215e-903e-45c2-bbb8-7b0358e0f305",
                                                "sense_id": "75daf675-7f29-31e3-8d03-ae752c26e8f5",
                                                "text": "Es wurden drastische (merklich spürbare) Sparmaßnahmen eingeleitet."
                                            },
                                            {
                                                "example_id": "7e474bdc-e035-40b5-a764-e1340c00cf42",
                                                "sense_id": "75daf675-7f29-31e3-8d03-ae752c26e8f5",
                                                "text": "„Das Umweltbundesamt rät […] zu drastischen Schritten, um die Klimaziele im Verkehr zu erreichen.“"
                                            },
                                            {
                                                "example_id": "cacd45c2-4867-4d12-a8ae-937f13b75a29",
                                                "sense_id": "75daf675-7f29-31e3-8d03-ae752c26e8f5",
                                                "text": "„Unser Schulsystem ist drastisch unterfinanziert“, so die stellvertretende Vorsitzende des Deutschen Gewerkschaftsbundes, Elke Hannack."
                                            },
                                            {
                                                "example_id": "6ba56d19-7fdd-43db-819b-f6702e5038ca",
                                                "sense_id": "75daf675-7f29-31e3-8d03-ae752c26e8f5",
                                                "text": "„Angesichts des Ukraine-Kriegs haben die deutschen Bauern vor drastischen Erhöhungen der Brotpreise gewarnt.“"
                                            },
                                            {
                                                "example_id": "60340bae-8cdc-437b-857f-277b41300f1c",
                                                "sense_id": "75daf675-7f29-31e3-8d03-ae752c26e8f5",
                                                "text": "„Beim Drachenflug ist es besonders wichtig, den Windeinfluss zu berücksichtigen, da schon relativ geringe Gegenwindgeschwindigkeiten zu einer drastischen Verschlechterung der Gleitzahl führen.“"
                                            },
                                            {
                                                "example_id": "6e7362d0-bc38-43a7-97f3-f055a9e5b68c",
                                                "sense_id": "75daf675-7f29-31e3-8d03-ae752c26e8f5",
                                                "text": "„Um die Klimaziele einzuhalten, müssten“ […] „90 Prozent der Autos in den USA bis 2050 elektrisch betrieben werden. Das wäre nur mit drastischen Maßnahmen möglich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "201bf7d3-223e-4c20-b1ab-9aa1343cfb02",
                        "source_entry_id": "51c0a4d5-77b3-3e7a-974e-7c633bcc2796",
