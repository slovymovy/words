{
    "word_family": [
        "organize",
        "organization",
        "organizer",
        "disorganize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8a609590-3c3d-33fc-ab5a-32ba0809a49b",
                    "sense_definition": "The act of breaking down a system or structure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "state_of_disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>disorganization</w> of the company's internal structure led to many resignations.",
                            "target_lang_translations": {
                                "zh": "公司内部结构的突然<w>瓦解</w>导致了许多人辞职。"
                            }
                        },
                        {
                            "text": "The <w>disorganization</w> of the project plan caused significant delays in the final delivery.",
                            "target_lang_translations": {
                                "zh": "项目计划的<w>混乱</w>导致最终交付严重延误。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disruption",
                        "dismantling"
                    ],
                    "antonyms": [
                        "organization",
                        "structuring"
                    ],
                    "target_lang_definitions": {
                        "zh": "破坏系统或结构的行动"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "瓦解",
                                "target_lang_sense_clarification": "指系统或组织结构的崩溃或解体"
                            },
                            {
                                "target_lang_word": "拆解",
                                "target_lang_sense_clarification": "指将结构拆开或分解"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6c39026-8c77-339b-8f78-c5957a762cca",
                    "sense_definition": "The state of being messy, chaotic, or lacking order.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The total <w>disorganization</w> in the office made it impossible to find important documents.",
                            "target_lang_translations": {
                                "zh": "办公室里一片<w>混乱</w>，根本找不到重要文件。"
                            }
                        },
                        {
                            "text": "Her desk was in a state of complete <w>disorganization</w> after the busy week.",
                            "target_lang_translations": {
                                "zh": "忙碌的一周过后，她的办公桌处于完全<w>杂乱</w>的状态。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chaos",
                        "mess",
                        "disorder"
                    ],
                    "antonyms": [
                        "order",
                        "tidiness"
                    ],
                    "common_phrases": [
                        "complete disorganization"
                    ],
                    "target_lang_definitions": {
                        "zh": "杂乱、混乱或缺乏秩序的状态"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "混乱",
                                "target_lang_sense_clarification": "指缺乏条理或秩序的状态"
                            },
                            {
                                "target_lang_word": "杂乱",
                                "target_lang_sense_clarification": "指物品摆放无序或环境凌乱"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}