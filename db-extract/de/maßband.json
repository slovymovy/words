                                    {
                                        "sense_id": "91900a48-fdba-31ea-9216-b930507c2f68",
                                        "entry_id": "b575ef13-e465-3850-abfe-26396ea772d1",
                                        "glosses": [
                                            "A graduated flexible ribbon used for measuring lengths."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9698b7a5-c0cc-4f3b-b5bf-654a1848c4dc",
                                                "sense_id": "91900a48-fdba-31ea-9216-b930507c2f68",
                                                "text": "Reappearing, tape-measure in hand, he went into the bedroom and took slow and accurate measurements, whistling delightedly to find that his pre-mortem theoretical calculations and post-mortem practical measurements hardly varied."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
