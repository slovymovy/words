{
    "word_family": [
        "equate",
        "equality",
        "equator",
        "equitable",
        "inequality"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47045ac4-b9ee-33df-8915-f75e879b64bb",
                    "sense_definition": "A mathematical statement showing that two expressions are equal using an equal sign.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher asked the students to solve the quadratic <w>equation</w> on the blackboard.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил учеников решить квадратное <w>уравнение</w> на доске."
                            }
                        },
                        {
                            "text": "You must balance both sides of the <w>equation</w> to find the correct value of x.",
                            "target_lang_translations": {
                                "ru": "Вы должны уравновесить обе части <w>уравнения</w>, чтобы найти правильное значение x."
                            }
                        }
                    ],
                    "synonyms": [
                        "formula"
                    ],
                    "common_phrases": [
                        "solve the equation",
                        "mathematical equation",
                        "linear equation",
                        "quadratic equation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Математическое равенство, содержащее одну или несколько неизвестных величин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уравнение",
                                "target_lang_sense_clarification": "математическое равенство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9117c8ae-8e84-3e19-9817-90b7ec16344b",
                    "sense_definition": "The act of considering two or more things as being the same or equal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>equation</w> of wealth with happiness is a common mistake in modern society.",
                            "target_lang_translations": {
                                "ru": "<w>Приравнивание</w> богатства к счастью — распространенная ошибка в современном обществе."
                            }
                        },
                        {
                            "text": "We need to bring the balance of power into the <w>equation</w> when discussing the new treaty.",
                            "target_lang_translations": {
                                "ru": "Нам нужно включить баланс сил в этот <w>расклад</w> при обсуждении нового договора."
                            }
                        }
                    ],
                    "synonyms": [
                        "identification",
                        "comparison",
                        "equivalence"
                    ],
                    "antonyms": [
                        "differentiation",
                        "distinction"
                    ],
                    "common_phrases": [
                        "personal equation",
                        "part of the equation",
                        "bring into the equation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассмотрение двух или более вещей как одинаковых или равных; также совокупность факторов в ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приравнивание",
                                "target_lang_sense_clarification": "сопоставление как равных"
                            },
                            {
                                "target_lang_word": "уравнение",
                                "target_lang_sense_clarification": "действие по значению уравнивать"
                            },
                            {
                                "target_lang_word": "фактор",
                                "target_lang_sense_clarification": "составляющая ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60b27f80-a163-305c-aa91-321cfaa2ad76",
                    "sense_definition": "A small correction made to observed values to account for systematic errors.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_correction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The astronomer applied a specific <w>equation</w> to the data to remove the effects of atmospheric distortion.",
                            "target_lang_translations": {
                                "ru": "Астроном применил к данным специальное <w>уравнение</w> (поправку), чтобы устранить эффекты атмосферных искажений."
                            }
                        },
                        {
                            "text": "Without this technical <w>equation</w>, the final measurements would be slightly inaccurate.",
                            "target_lang_translations": {
                                "ru": "Без этой технической <w>поправки</w> итоговые измерения были бы немного неточными."
                            }
                        }
                    ],
                    "synonyms": [
                        "adjustment",
                        "correction"
                    ],
                    "common_phrases": [
                        "personal equation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage in sciences like astronomy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая поправка к наблюдаемым значениям для учета систематических ошибок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поправка",
                                "target_lang_sense_clarification": "техническая корректировка"
                            },
                            {
                                "target_lang_word": "уравнение",
                                "target_lang_sense_clarification": "в астрономии или геодезии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}