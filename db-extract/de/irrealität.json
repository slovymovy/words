                ],
                "senses": [
                    {
                        "sense_id": "c156e8ab-8afe-3f8c-974a-349b92c708f4",
                        "entry_id": "34c3b03a-2a37-33c3-8175-434a89155667",
                        "glosses": [
                            "Eigenschaft, nicht wirklich (real), sondern nur gedacht, unwirklich (irreal) oder auch nicht nachvollziehbar zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8a9b920-e921-4cd7-8205-aa8a6b65a1e0",
                                "sense_id": "c156e8ab-8afe-3f8c-974a-349b92c708f4",
                                "text": "„Aber man schreibt dem Intellekt zu, was das Gemüt leistet: das Gefallen am eigenen Abbild, also Narzißmus, führt das Kind durch fortgesetzte Vergleiche des eigenen Ichs mit dem Bilde dazu, die Irrealität des letzteren zu begreifen.“"
                            },
                            {
                                "example_id": "7e55855f-0e1f-4d88-bf63-5f76282fa6b7",
                                "sense_id": "c156e8ab-8afe-3f8c-974a-349b92c708f4",
                                "text": "„Sie drücken aber auch eine Unmöglichkeit, eine Irrealität, mithin ein bloßes Als-ob, aus, da gerade das Mitdasein – die Koexistenz – des Anderen mein gleichzeitiges Dortsein grundsätzlich ausschließt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
