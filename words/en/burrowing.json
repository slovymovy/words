                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роющий",
                                "target_lang_sense_clarification": "причастие, описывающее действие по выкапыванию"
                            },
                            {
                                "target_lang_word": "зарывающийся",
