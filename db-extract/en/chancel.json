            {
                "entry_id": "e9331206-c094-31f4-bc95-db94555cf615",
                "word": "chancel",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e3555281-c109-4cfa-b786-1de98e7045f2",
