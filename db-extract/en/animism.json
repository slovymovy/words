                                        "entry_id": "c04e35c4-5c98-3a7b-a305-6f322853c450",
                                        "glosses": [
                                            "Glaube an die Beseeltheit der Natur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9e6feb2-82b2-48f7-acc6-a79eaf40c5cd",
                                                "sense_id": "3c78fd49-dae6-33a9-9a70-756b24c7c2e1",
                                                "text": "„Der Brauch, ein solches Häuschen aufzustellen für die Geister, die den Grund und Boden vorher besaßen, stammt aus dem Animismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
