                        "glosses": [
                            "Variante orthographique rare de bibelot : petit objet décoratif, souvent fait de verre ou de porcelaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21c784bb-ca01-454d-ae0b-9e2770557879",
                                "sense_id": "b4227dfe-c36f-3929-8bbb-f2690952b778",
                                "text": "Ah ! si j’avais connu la valeur de ses biblots, et si j’avais su ce qu’il m'a dit de ses amours, je serais sans inquiétude aujourd’hui…"
                            },
                            {
                                "example_id": "9cd970db-e3ed-4ffa-b0c7-8327dbeb929b",
                                "sense_id": "b4227dfe-c36f-3929-8bbb-f2690952b778",
                                "text": "Voilà votre affaire, me dit-il en me montrant un biblot dont je n’aurais pas donné 3 fr. 50."
                            },
                            {
                                "example_id": "0a4c361c-568a-4d3b-852a-b777dac48e1b",
                                "sense_id": "b4227dfe-c36f-3929-8bbb-f2690952b778",
                                "text": "Vous pouvez, par exemple, acheter un article chez Emmaüs, une antiquité chez un brocanteur, ou même hériter d’un biblot, et soudain, lorsque vous le déballez chez vous, vous éprouvez quelque chose d’étrange."
                            }
                        ]
                    }
