{
    "word_family": [
        "settle",
        "unsettle",
        "settled",
        "unsettled",
        "settlement",
        "settler"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "324612bf-a012-3bff-8475-f8b22fa6e395",
                    "sense_definition": "causing a feeling of anxiety, unease, or distress",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The silence in the old house was deeply <w>unsettling</w> for the new residents.",
                            "target_lang_translations": {
                                "ru": "Тишина в старом доме была крайне <w>тревожной</w> для новых жильцов."
                            }
                        },
                        {
                            "text": "She had an <w>unsettling</w> feeling that someone was watching her from the shadows.",
                            "target_lang_translations": {
                                "ru": "У неё было <w>беспокоящее</w> чувство, что кто-то наблюдает за ней из тени."
                            }
                        }
                    ],
                    "synonyms": [
                        "disturbing",
                        "disquieting",
                        "troubling",
                        "perturbing"
                    ],
                    "antonyms": [
                        "reassuring",
                        "comforting",
                        "soothing"
                    ],
                    "common_phrases": [
                        "unsettling feeling",
                        "deeply unsettling",
                        "unsettling experience"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывающий чувство тревоги, беспокойства или дискомфорта"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тревожный",
                                "target_lang_sense_clarification": "вызывающий беспокойство"
                            },
                            {
                                "target_lang_word": "беспокоящий",
                                "target_lang_sense_clarification": "нарушающий покой"
                            },
                            {
                                "target_lang_word": "неприятный",
                                "target_lang_sense_clarification": "вызывающий внутренний дискомфорт"
                            },
                            {
                                "target_lang_word": "тревожащий",
                                "target_lang_sense_clarification": "заставляющий волноваться"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea891477-3c1e-34fa-b599-46947b117d53",
                    "sense_definition": "present participle and gerund of <w>unsettle</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden change in management is <w>unsettling</w> the entire department.",
                            "target_lang_translations": {
                                "ru": "Внезапная смена руководства <w>выбивает из колеи</w> весь отдел."
                            }
                        },
                        {
                            "text": "By <w>unsettling</w> the established rules, the new law caused widespread confusion.",
                            "target_lang_translations": {
                                "ru": "<w>Нарушая</w> установленные правила, новый закон вызвал повсеместное замешательство."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие настоящего времени и герундий от глагола «unsettle» (выбивать из колеи, дестабилизировать)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбивающий из колеи",
                                "target_lang_sense_clarification": "лишающий уверенности"
                            },
                            {
                                "target_lang_word": "дестабилизирующий",
                                "target_lang_sense_clarification": "нарушающий стабильность"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ff548d5-b6d6-3338-9e5e-5cb163291764",
                    "sense_definition": "the act of weakening or disturbing a previously established system, theory, or norm",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book explores the <w>unsettling</w> of traditional social hierarchies during the revolution.",
                            "target_lang_translations": {
                                "ru": "В книге исследуется <w>расшатывание</w> традиционных социальных иерархий во время революции."
                            }
                        },
                        {
                            "text": "These philosophical <w>unsettlings</w> of Western thought led to new ways of understanding identity.",
                            "target_lang_translations": {
                                "ru": "Эти философские <w>дестабилизации</w> западной мысли привели к новым способам понимания идентичности."
                            }
                        }
                    ],
                    "synonyms": [
                        "disruption",
                        "destabilization",
                        "weakening"
                    ],
                    "antonyms": [
                        "stabilization",
                        "establishment"
                    ],
                    "target_lang_definitions": {
                        "ru": "акт ослабления или нарушения ранее установленной системы, теории или нормы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расшатывание",
                                "target_lang_sense_clarification": "ослабление основ"
                            },
                            {
                                "target_lang_word": "дестабилизация",
                                "target_lang_sense_clarification": "нарушение устойчивости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}