                "senses": [
                    {
                        "sense_id": "ce03636e-c4d4-3764-b0a8-55d6608854c6",
                        "entry_id": "77debfe9-ee95-382e-91e1-52f42e5a3404",
                        "glosses": [
                            "Agent des sowjetischen Geheimdiensts KGB"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4583a44f-597b-4125-9bb8-a2fb46bb7614",
                                "sense_id": "ce03636e-c4d4-3764-b0a8-55d6608854c6",
                                "text": "„Die sowjetische Führung sah aufgrund der «Rückständigkeit» Afghanistans nicht die rudimentären Voraussetzungen, die für eine sozialistische Revolution notwendig waren, oder wie es der KGB-Agent Mitrokhin beschrieb: «Wenn es ein Land in der Welt gibt, wo wir nicht den wissenschaftlichen Sozialismus einführen wollen, dann ist es Afghanistan.»“"
                            },
                            {
                                "example_id": "03471f20-e476-407b-ab7d-113083b79385",
                                "sense_id": "ce03636e-c4d4-3764-b0a8-55d6608854c6",
                                "text": "„Er wusste, dass er sich vor KGB-Agenten in Zivil in Acht nehmen musste und nicht vor der Miliz.“"
                            },
                            {
                                "example_id": "c52e56fd-a92c-4184-b31d-0e6a4b8abb8d",
                                "sense_id": "ce03636e-c4d4-3764-b0a8-55d6608854c6",
                                "text": "„Wenn man Glück hatte, bekam man sogar billige Ausrüsrungsgegenstände und Waffen, die ehemalige KGB-Agenten für ein Butterbrot an die russische Mafia verkauft hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
