                "senses": [
                    {
                        "sense_id": "43470e42-880a-392b-8230-64bb048d2358",
                        "entry_id": "2a6b4f7f-3b9b-36a3-a4d0-d27884dc7b0b",
                        "glosses": [
                            "Fleurter plus ou moins."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "cdf3539c-7121-49e6-a4bf-534cacc2f1ac",
                                "sense_id": "43470e42-880a-392b-8230-64bb048d2358",
                                "text": "Ça blaguait ferme entre les boiseries d’acajou, ça fleurtaillait, ça dansotait, tandis qu’Ethel et Pop, imperturbables, continuaient de promener leurs plateaux."
                            },
                            {
                                "example_id": "06c4b2c9-8b95-4a49-bcf5-227611c2c173",
                                "sense_id": "43470e42-880a-392b-8230-64bb048d2358",
                                "text": "En v'la un qui avait bigrement envie de fleurtailler avec la mort !"
                            },
                            {
                                "example_id": "071ca3f1-89a2-41a1-a26c-999918b2b57b",
                                "sense_id": "43470e42-880a-392b-8230-64bb048d2358",
                                "text": "Certes, mais tout en fleurtaillant avec Adolf et en faisant les yeux doux à l'Angleterre..."
                            }
                        ]
                    }
