                                        "glosses": [
                                            "Surface carrée qui a un pied de côté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8595878-b4a5-4f21-aaa1-c9247b369ac2",
                                                "sense_id": "ac8174bb-deb1-35a9-953a-1d51c38b5163",
                                                "text": "Alost. Le bonnier = 3 arpents = 4 journaux = 400 perches carrées = 160.000 pieds carrés ....... 122,9437 ares"
                                            },
                                            {
                                                "example_id": "157a7145-26c4-4cc5-ba65-b50f83163354",
                                                "sense_id": "ac8174bb-deb1-35a9-953a-1d51c38b5163",
                                                "text": "Le document remis initialement aux défendeurs par Mᵉ Pelletier indique que le lot 8 mesure 100 pieds de largeur par 371 pieds de profondeur pour un total de 37 100 pieds carrés."
                                            }
                                        ]
                                    }
                                ]
                            }
