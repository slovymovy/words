                    {
                        "translation_id": "162bbe4e-7a51-499d-ac09-acc617629190",
                        "source_entry_id": "fb18346f-1372-3d91-a073-3d260803b2e6",
                        "source_sense_id": "75f5a013-8d1c-3a81-9b89-43792d9bd88f",
