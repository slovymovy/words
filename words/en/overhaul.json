                            },
                            {
                                "target_lang_word": "moderniseren",
                                "target_lang_sense_clarification": "aanpassen aan de huidige tijd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b322c879-f1ef-382f-9b2c-b52c98e750e5",
