                                "target_senses": [
                                    {
                                        "sense_id": "f40e6651-7d12-31b3-b891-45a9e718ebca",
                                        "entry_id": "ab038f6e-fefd-39b1-97f2-aab12d5306ff",
                                        "glosses": [
                                            "Livre qui contient les prières de la messe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23164db5-d4cf-46b6-ab70-fc5bf2ec30ca",
                                                "sense_id": "f40e6651-7d12-31b3-b891-45a9e718ebca",
                                                "text": "Ce prieur est, comme on dit, un prêtre franc et gaillard, qui préfère la coupe et le cor à la cloche et au missel."
                                            },
                                            {
                                                "example_id": "de7b8144-208a-4cb7-8147-de267ec67a19",
                                                "sense_id": "f40e6651-7d12-31b3-b891-45a9e718ebca",
                                                "text": "Van Helsing ouvrit le missel, commença à lire ; Quincey et moi lui répondîmes de notre mieux."
                                            },
                                            {
                                                "example_id": "581f6998-bec0-4c8a-900a-6c43d4330142",
                                                "sense_id": "f40e6651-7d12-31b3-b891-45a9e718ebca",
                                                "text": "La première traduction intégrale en français de la Bible liturgique a été validée par le Vatican à l’été 2013. Mais ce feu vert est resté sans effet à ce jour sur la manière de réciter la plus célèbre prière chrétienne à l’église, où c’est le missel (livre de messe) qui a cours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
