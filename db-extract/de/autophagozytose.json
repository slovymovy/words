                        "sense_id": "96559d1a-0b95-3356-82d0-36178258a76e",
                        "entry_id": "5df5a818-8369-326f-820c-b14cb2428435",
                        "glosses": [
                            "Vorgang, bei dem eine Zelle (durch Phagozyten, z.B. Lysosomen) eigene Bestandteile abbaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58813558-2f70-4bb9-8695-99ea7c60e4ba",
                                "sense_id": "96559d1a-0b95-3356-82d0-36178258a76e",
                                "text": "„Die Autophagozytose dient der Zelle dazu, überflüssige Zellbestandteile und alte Organellen zu beseitigen.“"
                            },
                            {
                                "example_id": "c98b9973-b2a1-42ab-a122-f070d4f3f3de",
                                "sense_id": "96559d1a-0b95-3356-82d0-36178258a76e",
                                "text": "„Die überzähligen Peroxisomen werden durch Autophagozytose eliminiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
