{
    "word_family": [
        "hobbitish",
        "hobbitry"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03991d5d-812a-35c7-871a-dd0f4a413d06",
                    "sense_definition": "A member of an imaginary race of small, humanlike beings with hairy feet, created by J.R.R. Tolkien.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fantasy_creature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brave little <w>hobbit</w> set out on a dangerous adventure across the mountains."
                        },
                        {
                            "text": "In the fantasy novel, every <w>hobbit</w> enjoys good food and a peaceful life at home."
                        }
                    ],
                    "synonyms": [
                        "halfling"
                    ]
                },
                {
                    "sense_id": "85f988ff-75e2-335b-8926-569554ed73fa",
                    "sense_definition": "A person of particularly short stature.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "short_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Standing beside his tall teammates, he felt like a <w>hobbit</w> in the team photo."
                        },
                        {
                            "text": "She joked that she was the family <w>hobbit</w> because she barely reached five feet."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used playfully or informally"
                        }
                    ]
                },
                {
                    "sense_id": "106cfdd8-2cbd-3b99-bd45-e6e562f927aa",
                    "sense_definition": "An extinct species of small-bodied hominin (Homo floresiensis) whose fossils were found on Flores island.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "paleoanthropology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Archaeologists studying the island discovered skeletal remains of the prehistoric <w>hobbit</w>."
                        },
                        {
                            "text": "Scientists debate whether the <w>hobbit</w> evolved directly from an earlier human ancestor."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal scientific nickname"
                        }
                    ]
                },
                {
                    "sense_id": "6c6d6780-1872-3258-8f19-6753ee8195a3",
                    "sense_definition": "A student who is socially awkward and obsessed with academic work.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "student_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent every weekend studying alone in the library like a typical <w>hobbit</w>."
                        },
                        {
                            "text": "The other students avoided him because he acted like an unsociable <w>hobbit</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "student slang"
                        }
                    ]
                },
                {
                    "sense_id": "d8510474-0cd1-34e9-aa57-2a1020f7ede3",
                    "sense_definition": "A historical Welsh unit of weight, usually equal to 168 pounds.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nineteenth-century merchant sold four sacks of flour by the <w>hobbit</w>."
                        },
                        {
                            "text": "Old records show that farmers measured their grain using the traditional Welsh <w>hobbit</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Wales"
                        },
                        {
                            "trait_type": "obsolete",
                            "comment": "historical measure"
                        }
                    ]
                },
                {
                    "sense_id": "dc661798-ffc7-3b35-9e6a-f9ea3bc87f21",
                    "sense_definition": "An old unit of volume, traditionally equal to about two and a half bushels.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cellar contained several barrels of wheat, each measured as one <w>hobbit</w>."
                        },
                        {
                            "text": "Before modern standardisation, local millers measured bulk grain with the traditional <w>hobbit</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "historical unit"
                        }
                    ]
                }
            ]
        }
    ]
}