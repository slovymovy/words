                {
                    "sense_id": "6ff9aee6-b64e-36e2-9400-e28420da157c",
                    "sense_definition": "Agacer fortement, exaspérer ou énerver quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "agacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses plaintes continuelles finissent par me <w>pomper</w> l'air au bureau.",
                            "target_lang_translations": {
                                "en": "His constant complaints end up <w>annoying</w> me at the office.",
                                "ru": "Его вечные жалобы в конце концов начинают <w>доставать</w> меня на работе.",
                                "de": "Seine ewigen Klagen <w>nerven</w> mich im Büro am Ende.",
                                "es": "Sus constantes quejas me acaban <w>fastidiando</w> en la oficina.",
                                "zh": "他没完没了地抱怨，最后在办公室里把我<w>烦</w>透了。"
                            }
                        },
                        {
                            "text": "Arrête de faire autant de bruit, tu commences vraiment à me <w>pomper</w> !",
                            "target_lang_translations": {
                                "en": "Stop making so much noise, you're really starting to <w>annoy</w> me!",
                                "ru": "Перестань шуметь так сильно, ты меня правда начинаешь <w>доставать</w>!",
                                "de": "Hör auf, so einen Lärm zu machen, du fängst echt an, mich zu <w>nerven</w>!",
                                "es": "¡Deja de hacer tanto ruido, de verdad me estás empezando a <w>fastidiar</w>!",
                                "zh": "别这么吵了，你真的开始<w>烦</w>我了！"
                            }
                        }
