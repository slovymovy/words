                                "target_senses": [
                                    {
                                        "sense_id": "5aa916c3-94b3-3bc4-9baa-764ebe16bb8f",
                                        "entry_id": "e87731fa-dc24-31ae-89a7-17656d9b0e62",
                                        "glosses": [
                                            "Einführung von automatischen Abläufen, insbesondere in der Fabrikation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ad05eb-5e5d-4e3d-b6aa-51ff775a078c",
                                                "sense_id": "5aa916c3-94b3-3bc4-9baa-764ebe16bb8f",
                                                "text": "„Wir wissen alle, daß Arbeitslosigkeit nicht abgeschafft werden kann. Läuft der Betrieb schlecht, dann wird entlassen, läuft er gut, dann wird in Automatisation investiert - und auch entlassen.“'"
                                            }
