                ],
                "senses": [
                    {
                        "sense_id": "3897a224-0a3d-3716-9002-88fdc91714bf",
                        "entry_id": "3c05d3e1-d9a4-3563-9c02-502e640490ef",
                        "glosses": [
                            "Aktion, bei der eine Person/eine Personengruppe für eine bestimmte Arbeit eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b844b3c9-2f5e-4873-8ed3-ad786a8d6243",
                                "sense_id": "3897a224-0a3d-3716-9002-88fdc91714bf",
                                "text": "Sie wurden zum Arbeitseinsatz in der Landwirtschaft bestimmt."
                            },
                            {
                                "example_id": "cfd7ecd6-131b-4b7d-80cc-b2f4b29ce707",
                                "sense_id": "3897a224-0a3d-3716-9002-88fdc91714bf",
                                "text": "„Wer nicht im Lager arbeitete, wurde zu Arbeitseinsätzen auf die Güter im nördlichen Ostpreußen verteilt; auch die Fremdarbeiter in Götzlack und Kukehnen waren aus Stablack-Außenlagern zugewiesen worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2019348b-461c-312b-88d7-0ef41cf5db36",
                        "entry_id": "3c05d3e1-d9a4-3563-9c02-502e640490ef",
                        "glosses": [
                            "intensive Bemühung um eine erfolgreiche Bewältigung einer Arbeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e851a7-3eda-4ad9-adac-63bc3de742fe",
                                "sense_id": "2019348b-461c-312b-88d7-0ef41cf5db36",
                                "text": "„Der kahle Kopf als Zeichen selbstlosen Arbeitseinsatzes ist das feste Bindeglied zwischen den intellektuellen Werktätigen beiderlei Geschlechts.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
