                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We heard a loud <w>pop</w> when the balloon burst.",
                            "target_lang_translations": {
                                "ru": "Мы услышали громкий <w>хлопок</w>, когда шарик лопнул.",
                                "zh": "气球破裂时我们听到了巨大的<w>砰</w>的一声。"
