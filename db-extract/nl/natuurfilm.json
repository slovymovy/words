                        ],
                        "examples": [
                            {
                                "example_id": "f71f84aa-961b-4e18-bf52-d6758027844b",
                                "sense_id": "94392fb4-aa4a-3458-aaf9-a562b9645261",
                                "text": "Bij natuurfilms denken we meestal meteen aan Afrika en niet aan de Hollandse polder. Maar de bioscoopfilm de Nieuwe Wildernis is juist daar in de Oostvaardersplassen opgenomen."
                            },
                            {
                                "example_id": "bdb65f99-7aef-4b21-9a57-794b3ba2791d",
                                "sense_id": "94392fb4-aa4a-3458-aaf9-a562b9645261",
                                "text": "Earth, Bird Flight, Frozen Planet? natuurfilms lijken populairder dan ooit en de documentairemakers gaan steeds een stapje verder voor het perfecte shot. Een Britse documentairemaker is nu alleen iets te ver gegaan. Volgens de Noorse autoriteiten heeft de filmcrew van Jason Roberts de ijsberen lastig gevallen."
                            }
                        ]
