                        "entry_id": "e6f715b6-af65-3a32-b52c-c0eb6d5213a8",
                        "glosses": [
                            "Bremsanlage, bei welcher der Bremsvorgang mittels Druckluft durchgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cf86327-b7c7-4b19-bcdb-4228669b51ce",
                                "sense_id": "8c6b53fb-895d-37e7-8722-37cd9e25b551",
                                "text": "„Er war nicht besetzt, aber offenbar betriebsbereit, denn der Stromabnehmer war ausgefahren und hin und wieder konnte ich das Klopfen der Druckluftbremse unterhalb des Fahrzeugbodens hören.“"
                            },
                            {
                                "example_id": "7b44f22d-0e7d-4388-8421-5c81b4a991bf",
                                "sense_id": "8c6b53fb-895d-37e7-8722-37cd9e25b551",
                                "text": "„Die Druckluftbremse des Laster wurde beschädigt, das Schwerfahrzeug dadurch manövrierunfähig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
