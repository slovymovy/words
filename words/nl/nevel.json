                                "target_lang_sense_clarification": "fine droplets"
                            },
                            {
                                "target_lang_word": "spray",
                                "target_lang_sense_clarification": "liquid particles"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "brumisation",
                                "target_lang_sense_clarification": "fines gouttelettes projetées"
                            },
                            {
                                "target_lang_word": "nuage",
                                "target_lang_sense_clarification": "fines gouttelettes en suspension"
                            },
                            {
                                "target_lang_word": "brouillard",
                                "target_lang_sense_clarification": "gouttelettes d'eau ou de peinture"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3776bb90-6136-3575-8277-3bb41c02d3f4",
                    "sense_definition": "Een lichtende wolk van gas en stof in het heelal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "astronomy_nebula",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Astronomen hebben met een krachtige telescoop een nieuwe <w>nevel</w> ontdekt.",
                            "target_lang_translations": {
                                "ru": "Астрономы с помощью мощного телескопа открыли новую <w>туманность</w>.",
                                "en": "Astronomers have discovered a new <w>nebula</w> with a powerful telescope.",
                                "fr": "Les astronomes ont découvert une nouvelle <w>nébuleuse</w> à l'aide d'un puissant télescope."
                            }
                        },
                        {
                            "text": "Deze kleurrijke <w>nevel</w> is de geboorteplaats van vele jonge sterren.",
                            "target_lang_translations": {
                                "ru": "Эта красочная <w>туманность</w> — место рождения множества молодых звезд.",
                                "en": "This colorful <w>nebula</w> is the birthplace of many young stars.",
                                "fr": "Cette <w>nébuleuse</w> colorée est le berceau de nombreuses jeunes étoiles."
                            }
                        }
                    ],
                    "synonyms": [
                        "sterrennevel",
                        "nevelvlek"
                    ],
                    "common_phrases": [
                        "planetaire nevel"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "astronomy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Светящееся облако газа и пыли в космосе.",
                        "en": "A luminous cloud of gas and dust in the universe.",
                        "fr": "Nuage lumineux de gaz et de poussières dans l'espace."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "туманность",
                                "target_lang_sense_clarification": "астрономия"
                            }
                        ],
