                        "entry_id": "efaa8976-f990-32fb-8470-0f8a4f36b614",
                        "glosses": [
                            "een jeugdig persoon van het mannelijk geslacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e687d549-1a3d-477d-ad1c-10211ed4f38f",
                                "sense_id": "7bd742ce-eb4a-346d-adb8-c10270c89bca",
                                "text": "Er stonden nog twee jongemannen op de bus te wachten."
                            },
                            {
                                "example_id": "d793c8fb-af00-495a-8442-23537f883e18",
                                "sense_id": "7bd742ce-eb4a-346d-adb8-c10270c89bca",
                                "text": "De twee jongemannen uit Westerhaar waren op zaterdag 23 november bij een vriend in Vroomshoop geweest. Toen ze het welletjes vonden en naar huis fietsten, hoorden ze gespartel in het water. „We wisten toen nog niet wat het was, het kon ook een dier zijn”, zegt Thomas."
                            },
                            {
                                "example_id": "e7607e4f-1d2c-43ff-8770-fde9d8575171",
                                "sense_id": "7bd742ce-eb4a-346d-adb8-c10270c89bca",
                                "text": "Ik heb je zelf aangemoedigd om een jongeman te zoeken."
                            }
                        ]
                    }
