                "senses": [
                    {
                        "sense_id": "50872144-04db-3235-b0de-3e909541cdb1",
                        "entry_id": "e71065c9-b576-3214-b071-31d82b953190",
                        "glosses": [
                            "een onzinnige gebeurtenis waar je maar het beste om kunt lachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "432c2da2-d229-4d90-b155-4b0023039c60",
                                "sense_id": "50872144-04db-3235-b0de-3e909541cdb1",
                                "text": "De Waalse derby tussen Charleroi en Standard is helaas alweer ontaard in een schertsvertoning dankzij de fans."
                            },
                            {
                                "example_id": "4b75305c-5dcb-4790-b0f0-45a43b727a0e",
                                "sense_id": "50872144-04db-3235-b0de-3e909541cdb1",
                                "text": "Voor Halsema was het belangrijkste aan de schertsvertoning van de afgelopen weken dat Verdonk op haar plaats was gezet. Als je het om die reden acceptabel vindt dat er tig asielzoekers toegelaten worden, ben je als politicus wel heel diep gezonken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4728ed3f-7224-43f1-9ad8-41f993b90e5b",
                        "source_entry_id": "e71065c9-b576-3214-b071-31d82b953190",
                        "source_sense_id": "50872144-04db-3235-b0de-3e909541cdb1",
                        "target_lang_word": "joke",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "joke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "360587ac-72a1-3d01-99f0-829f3531df37",
                                        "entry_id": "615da529-88f3-306f-a8b2-fbd261dedd0e",
                                        "glosses": [
                                            "An amusing story."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccc5ef8d-5c3c-408b-80e4-c8e89e694f94",
                                                "sense_id": "360587ac-72a1-3d01-99f0-829f3531df37",
                                                "text": "Or witty joke our airy senses moves / To pleasant laughter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38127af2-0c75-3088-9789-ec5118ecf93b",
                                        "entry_id": "615da529-88f3-306f-a8b2-fbd261dedd0e",
                                        "glosses": [
                                            "Something said or done for amusement, not in seriousness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe7c74f8-ec1b-477a-a99c-320b6bd33336",
                                                "sense_id": "38127af2-0c75-3088-9789-ec5118ecf93b",
                                                "text": "It was a joke!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b0ae0af-fdbf-37e9-b018-3fdbf76015e9",
                                        "entry_id": "615da529-88f3-306f-a8b2-fbd261dedd0e",
                                        "glosses": [
                                            "The root cause or main issue, especially an unexpected one"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "efc79c99-a0ba-3b16-9e03-2e329bc2f74c",
                                        "entry_id": "615da529-88f3-306f-a8b2-fbd261dedd0e",
                                        "glosses": [
                                            "A laughably worthless thing or person; a sham."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "329d1221-4728-4db5-b853-9991a746e440",
                                                "sense_id": "efc79c99-a0ba-3b16-9e03-2e329bc2f74c",
                                                "text": "Your effort at cleaning your room is a joke."
                                            },
                                            {
                                                "example_id": "181f606b-75c2-4ad4-9c64-4496135cfc3b",
                                                "sense_id": "efc79c99-a0ba-3b16-9e03-2e329bc2f74c",
                                                "text": "The president was a joke."
                                            },
                                            {
                                                "example_id": "2a482e20-523c-4809-a979-948ba5dd742b",
                                                "sense_id": "efc79c99-a0ba-3b16-9e03-2e329bc2f74c",
                                                "text": "The other wheel on the tender of the L.N.W.R. engines operated the tender brake, and this was always rather a joke. Sometimes it operated with good results and on other occasions it did not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "418d9564-cbc5-324e-8a6f-bdedab97cd8c",
                                        "entry_id": "615da529-88f3-306f-a8b2-fbd261dedd0e",
                                        "glosses": [
                                            "Something that is far easier or far less challenging than expected."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cab6c23f-0a90-4857-9344-046a6c24bcbb",
                                                "sense_id": "418d9564-cbc5-324e-8a6f-bdedab97cd8c",
                                                "text": "The final exam was a joke."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "joke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d083d80-173f-3624-bbf4-3ba3a0958ec2",
                                        "entry_id": "f8fd964c-077e-3dcc-bd89-2f6af3a11234",
                                        "glosses": [
                                            "To do or say something for amusement rather than seriously."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "853086bb-e3b6-4524-84f5-c9a0565c5843",
                                                "sense_id": "7d083d80-173f-3624-bbf4-3ba3a0958ec2",
                                                "text": "I didn’t mean what I said — I was only joking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1267649-ca2d-350f-8c97-148f4bfe4b38",
                                        "entry_id": "f8fd964c-077e-3dcc-bd89-2f6af3a11234",
                                        "glosses": [
                                            "To dupe in a friendly manner for amusement; to mess with, play with."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cab71566-b5bc-4a12-a0ee-bd9025301bf2",
                                                "sense_id": "e1267649-ca2d-350f-8c97-148f4bfe4b38",
                                                "text": "Relax, man, I'm just joking with you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "109f2b5f-311c-3587-9a35-2be159ca77e0",
                                        "entry_id": "f8fd964c-077e-3dcc-bd89-2f6af3a11234",
                                        "glosses": [
                                            "To make merry with; to make jokes upon; to rally."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7101bcef-d2ba-4435-9922-8e8818a4443b",
                                                "sense_id": "109f2b5f-311c-3587-9a35-2be159ca77e0",
                                                "text": "to joke a comrade"
                                            },
                                            {
                                                "example_id": "4223608e-11d6-448a-a7cb-d4436bc4c356",
                                                "sense_id": "109f2b5f-311c-3587-9a35-2be159ca77e0",
                                                "text": "He made more than one visit to Oxbridge, where the young fellows were amused by entertaining the old gentleman, and gave parties and breakfasts and fêtes, partly to joke him and partly to do him honour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59c4eca3-c8c6-458b-9416-68795ccf9ecc",
                        "source_entry_id": "e71065c9-b576-3214-b071-31d82b953190",
                        "source_sense_id": "50872144-04db-3235-b0de-3e909541cdb1",
                        "target_lang_word": "farce",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "farce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb07d702-cc8b-3db9-857a-bad3ceb08b00",
                                        "entry_id": "1edd39a3-d8d1-3b3c-9a17-8d50172dad89",
                                        "glosses": [
                                            "A style of humor marked by broad improbabilities with little regard to regularity or method."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ce9247d-1ba1-347a-a39c-0492d1b6cce4",
                                        "entry_id": "1edd39a3-d8d1-3b3c-9a17-8d50172dad89",
                                        "glosses": [
                                            "A motion picture or play featuring this style of humor."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "499a7911-711b-4dce-908e-7be8abc9e22a",
                                                "sense_id": "3ce9247d-1ba1-347a-a39c-0492d1b6cce4",
                                                "text": "The farce that we saw last night had us laughing and shaking our heads at the same time."
                                            },
                                            {
                                                "example_id": "58b730ad-f626-4be5-a5f0-bcd5cad91155",
                                                "sense_id": "3ce9247d-1ba1-347a-a39c-0492d1b6cce4",
                                                "text": "Thus, when he drew up instructions in lawyer language[…]; his clerks […] understood him very well. If he had written a love letter, or a farce, or a ballade, or a story, no one, either clerks, or friends, or compositors, would have understood anything but a word here and a word there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c0470b8-46dd-3404-a768-3de072a804f6",
                                        "entry_id": "1edd39a3-d8d1-3b3c-9a17-8d50172dad89",
                                        "glosses": [
                                            "A situation abounding with ludicrous incidents."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fb8b1f6-d4a8-4808-855b-a4d58edd85a0",
                                                "sense_id": "3c0470b8-46dd-3404-a768-3de072a804f6",
                                                "text": "The first month of labor negotiations was a farce."
                                            },
                                            {
                                                "example_id": "b33e9c1e-925f-459f-a062-775a207f859b",
                                                "sense_id": "3c0470b8-46dd-3404-a768-3de072a804f6",
                                                "text": "The first match in the magnificent new national stadium was a Euro 2012 qualifier between Romania and France that soon descended into farce as the pitch cut up and players struggled to maintain their footing. Amorebieta at times seemed to be paying homage to that game, but nobody else seemed to have a problem; it was just that Falcao was far better than him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1755cea0-4322-3213-988c-1bcfa3eab996",
                                        "entry_id": "1edd39a3-d8d1-3b3c-9a17-8d50172dad89",
                                        "glosses": [
                                            "A ridiculous or empty show."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfd30260-cb18-44c9-b44b-1683388e996c",
                                                "sense_id": "1755cea0-4322-3213-988c-1bcfa3eab996",
                                                "text": "The United States, he declared, was \"a farce controlled by dirty, hook-nosed, circumcised Jew bastards.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "768391b2-295f-3367-b444-7928c345af69",
                                        "entry_id": "1edd39a3-d8d1-3b3c-9a17-8d50172dad89",
                                        "glosses": [
                                            "An elaborate lie."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aaf92011-cf1a-357c-8abe-242083357cec",
                                        "entry_id": "1edd39a3-d8d1-3b3c-9a17-8d50172dad89",
                                        "glosses": [
                                            "Forcemeat, stuffing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "farce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f8c08c8-dcab-349a-aede-8dfa5dda7258",
                                        "entry_id": "a18a1f76-e2f9-3002-bd44-01807779da60",
                                        "glosses": [
                                            "To stuff with forcemeat or other food items."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81728a09-29dd-4a1d-8476-5be0bf6c9e00",
                                                "sense_id": "8f8c08c8-dcab-349a-aede-8dfa5dda7258",
                                                "text": "The lunch […] consisted […] of […] lobster mayonnaise, cold game sausages, an immense veal and ham pie farced with eggs, truffles, and numberless delicious flavours; besides kickshaws, creams and sweetmeats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "797754d9-3d9c-3f8a-899e-9b7e241c423b",
                                        "entry_id": "a18a1f76-e2f9-3002-bd44-01807779da60",
                                        "glosses": [
                                            "To fill full; to stuff."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "208805f0-971e-4490-be2b-46bff1488900",
                                                "sense_id": "797754d9-3d9c-3f8a-899e-9b7e241c423b",
                                                "text": "The first principles of religion should not be farced with school points and private tenets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "785423b9-b67a-3fdf-9381-adcccba8b566",
                                        "entry_id": "a18a1f76-e2f9-3002-bd44-01807779da60",
                                        "glosses": [
                                            "To make fat."
                                        ],
