                                "target_senses": [
                                    {
                                        "sense_id": "708300f8-d696-3d4c-89a7-4eda890840e8",
                                        "entry_id": "36815d42-ec4c-3735-afef-6c1d3fb2e5da",
                                        "glosses": [
                                            "costela de rês com carne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1ba0921-6cef-48ed-9cc7-9f7ab83c107b",
                                                "sense_id": "708300f8-d696-3d4c-89a7-4eda890840e8",
                                                "text": "Houve época em que o pudim yorkshire era parte indispensável das festas de fim de ano, servido com uma enorme costeleta."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "722e67e7-0e29-3514-8aa9-66c34b0fae6c",
                                        "entry_id": "36815d42-ec4c-3735-afef-6c1d3fb2e5da",
                                        "glosses": [
                                            "corte da barba que deixa com volume o pedaço de pelos à frente da orelha descendo até o queixo; suíças, patilha"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5695751d-5517-47f2-9268-fdab022e538e",
                                                "sense_id": "722e67e7-0e29-3514-8aa9-66c34b0fae6c",
                                                "text": "Christian Ribeiro (à esquerda) optou pela costeleta \"Wolverine\", enquanto Bruno Autran (à direita) adotou o estilo Johnny Depp."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8835c1d0-9d22-4942-9977-dccd86ee9f71",
                        "source_entry_id": "c6a280cc-5178-3d62-8c4e-3ef4d08134ea",
