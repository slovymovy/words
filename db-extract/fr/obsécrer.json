                "senses": [
                    {
                        "sense_id": "84e60eba-89d3-3726-b948-3783561b84b2",
                        "entry_id": "3a370640-2c78-3b59-84b9-05ad7e52d68b",
                        "glosses": [
                            "Supplier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3c35967-c65a-4113-8cd9-bc62efcd4d9d",
                                "sense_id": "84e60eba-89d3-3726-b948-3783561b84b2",
                                "text": "Et enfin il y eut une plaidoirie pathétique d’un jeune stagiaire, pour obtenir des juges la dissolution d’un mariage d’employés, ravagé par les violences de la femme, une virago qui, même sous l’œil sévère du président, continuait à obsécrer son pitoyable conjoint."
                            },
                            {
                                "example_id": "8b688f4b-01e1-420b-92f5-db6d3215462c",
                                "sense_id": "84e60eba-89d3-3726-b948-3783561b84b2",
                                "text": "Comment ne sentir pas mollir le courage en avisant larmoyer deux beaux yeux et oyant une bouche vermeillette vous obsécrer de ne courir pas tant gros risques et périls!"
                            },
                            {
                                "example_id": "32f9fc50-bf33-4d4b-b1b4-b399a2fe3719",
                                "sense_id": "84e60eba-89d3-3726-b948-3783561b84b2",
                                "text": "Oh ! que n’ai-je gardé en mon cœur cet arcane redoutable ! murmura-t-elle; Vierge Marie ! plus je n’ose vous obsécrer, car suis doublement damnée…"
                            }
                        ]
                    }
                ],
