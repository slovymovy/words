                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d8834a4-4d6a-41cd-987b-1a20d4f8ed76",
                                "sense_id": "c9ff70ac-d636-3120-96f9-1fc34e3fd24f",
                                "text": "Die Schwarzwurzel ist botanisch mit dem Löwenzahn verwandt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9564431e-23dd-3039-a44d-800839b7eee1",
                        "entry_id": "2a78a52a-57b2-3d6c-bf57-3f5969832b33",
                        "glosses": [
                            "ein Gemüse, die schwarzbraune Pfahlwurzel von [1], wird auch als Ersatz für Spargel benutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2a4d8e6-66f1-4228-b31c-3f0a3c4a5c16",
                                "sense_id": "9564431e-23dd-3039-a44d-800839b7eee1",
                                "text": "Gedünstete Schwarzwurzeln, mit brauner Butter übergossen, in der Semmelbrösel geröstet wurden, sind sehr lecker."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb4574a7-cd97-4d96-9e8b-cf1147c89e1b",
                        "source_entry_id": "2a78a52a-57b2-3d6c-bf57-3f5969832b33",
                        "source_sense_id": "c9ff70ac-d636-3120-96f9-1fc34e3fd24f",
                        "source_sense_description": "ein Korbblütler mit rötlichen oder gelben Blüten",
                        "target_lang_word": "black salsify",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "black salsify",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee24c1e9-d42e-3b59-90d2-803552ef4c26",
                                        "entry_id": "bedaf744-512c-3205-9936-38476330b232",
                                        "glosses": [
                                            "A perennial member of the sunflower family (Asteraceae), cultivated as a root vegetable (Pseudopodospermum hispanicum, syn. Scorzonera hispanica)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10556f50-11f4-4774-b1d5-77404e7920bc",
                                                "sense_id": "ee24c1e9-d42e-3b59-90d2-803552ef4c26",
                                                "text": "Black salsify is lumped in as a member of the salsify-type vegetable family even though it is a different genus and species due to similarities in its flavor and textural profile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9b2fc43-49c3-4fe5-895a-60c38fd17fd9",
                        "source_entry_id": "2a78a52a-57b2-3d6c-bf57-3f5969832b33",
                        "source_sense_id": "c9ff70ac-d636-3120-96f9-1fc34e3fd24f",
                        "source_sense_description": "ein Korbblütler mit rötlichen oder gelben Blüten",
                        "target_lang_word": "scorsonère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scorsonère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8dd45b18-84f9-3bb6-a9f6-0a152a7047ba",
                                        "entry_id": "de190f51-262f-3eb2-89fe-0a7c8793a43b",
                                        "glosses": [
                                            "Genre de composées, dont l’espèce la plus connue, à racine noire en dessus et blanche en dedans, se mange cuite, comme le salsifis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "971a4d60-21cc-45cd-8f04-2fc9d39c7b7d",
                                                "sense_id": "8dd45b18-84f9-3bb6-a9f6-0a152a7047ba",
                                                "text": "Dans les terrains légers, à la fin de ce mois, l’on plante l’échalote, l’ail et la rocambole ; on sème des scorsonères et des salsifis. La scorsonère ne se mange que la seconde année de sa semence ; […]\nLe suc de la scorsonère est bon pour la vue et contre les morsures de vipères."
                                            },
                                            {
                                                "example_id": "9db5d5a6-8bde-4383-b698-eb4aaea9bf58",
                                                "sense_id": "8dd45b18-84f9-3bb6-a9f6-0a152a7047ba",
                                                "text": "Les plus folles disposent les barbes du gramen qui monte dans les manches, ou scellent au calice des scorsonères et des pissenlits les petites graines ailées sur lesquelles on souffle pour savoir si un projet réussira."
                                            },
                                            {
                                                "example_id": "b5d081fe-78d7-4579-901b-c9235f53e6c3",
                                                "sense_id": "8dd45b18-84f9-3bb6-a9f6-0a152a7047ba",
                                                "text": "Toujours selon notre expert, la scorsonère produit une sorte de latex très collant; il vaut donc mieux en faire tremper les tronçons de racine dans de l’eau citronnée. Elle est meilleure lorsqu’elle est blanchie puis revenue dans la poêle avec une gousse d’ail et une feuille de laurier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
