{
    "word_family": [
        "torchlight",
        "torchwort"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a6b625cf-5b96-3a1d-a1cb-034a30f35736",
                    "sense_definition": "A battery-powered hand-held light source.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "light_source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is dark outside, so please take a <w>torch</w> with you.",
                            "target_lang_translations": {
                                "zh": "外面很黑，请带上一个<w>手电筒</w>。"
                            }
                        },
                        {
                            "text": "I used my <w>torch</w> to find the keys under the sofa.",
                            "target_lang_translations": {
                                "zh": "我用<w>手电筒</w>照着找沙发底下的钥匙。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "carry a torch",
                        "switch on torch"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种手持的、电池供电的照明工具。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "手电筒",
                                "target_lang_sense_clarification": "现代便携式照明设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ed5208c-e9ad-35c4-9c24-974994d05e45",
                    "sense_definition": "A stick with a flammable end used as a light source, often held in the hand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "light_source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers walked through the forest carrying a <w>torch</w> to light their way.",
                            "target_lang_translations": {
                                "zh": "村民们举着<w>火把</w>穿过森林照亮前路。"
                            }
                        },
                        {
                            "text": "Ancient stone walls often had brackets to hold a burning <w>torch</w>.",
                            "target_lang_translations": {
                                "zh": "古代石墙上常有用来放置燃烧<w>火把</w>的支架。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brand",
                        "firebrand",
                        "flambeau"
                    ],
                    "common_phrases": [
                        "light a torch"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种顶端可燃烧的木棍，用作照明工具。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "火把",
                                "target_lang_sense_clarification": "古代或原始的照明工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e62e16cb-7b71-3597-a883-547beec53ad9",
                    "sense_definition": "A precious cause, principle, or tradition that needs to be protected and transmitted to others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>pass</w> on the <w>torch</w> to the next generation of leaders.",
                            "target_lang_translations": {
                                "zh": "她决定将<w>火炬</w>传递给下一代领导者。"
                            }
                        },
                        {
                            "text": "It is our duty to <w>take</w> up the <w>torch</w> and continue the fight for justice.",
                            "target_lang_translations": {
                                "zh": "我们有责任接过<w>火炬</w>，继续为正义而战。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pass the torch",
                        "take up the torch"
                    ],
                    "target_lang_definitions": {
                        "zh": "比喻需要保护并传承下去的珍贵事业、原则或传统。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "火炬",
                                "target_lang_sense_clarification": "象征精神或事业的传承"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bc8cb35-7d4c-3963-8851-b38bd0c4052a",
                    "sense_definition": "A person who intentionally sets fire to property.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "criminal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police finally caught the <w>torch</w> responsible for the series of warehouse fires.",
                            "target_lang_translations": {
                                "zh": "警方终于抓住了导致一系列仓库火灾的<w>纵火犯</w>。"
                            }
                        },
                        {
                            "text": "Investigators interviewed the <w>torch</w> to find out who hired him.",
                            "target_lang_translations": {
                                "zh": "调查人员审问了那名<w>纵火犯</w>，以查明是谁雇佣了他。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "故意纵火烧毁财产的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "纵火犯",
                                "target_lang_sense_clarification": "犯罪行为人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fbbc6272-5b52-308c-8764-79e0659b2d0a",
                    "sense_definition": "To intentionally destroy something by setting it on fire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminals <w>torched</w> the building to hide the evidence of their crime.",
                            "target_lang_translations": {
                                "zh": "罪犯们<w>纵火烧毁</w>了那栋建筑以销毁犯罪证据。"
                            }
                        },
                        {
                            "text": "They <w>torched</w> the old car and left it in the field.",
                            "target_lang_translations": {
                                "zh": "他们<w>纵火烧毁</w>了那辆旧车，并把它丢在田野里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "burn",
                        "ignite"
                    ],
                    "common_phrases": [
                        "torched the building"
                    ],
                    "target_lang_definitions": {
                        "zh": "故意放火烧毁某物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "纵火烧毁",
                                "target_lang_sense_clarification": "破坏性行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43a25387-f0d1-3f27-99dd-d7b3bfc66cc3",
                    "sense_definition": "To ruin the reputation of someone or something through damaging claims.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disparage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journalist <w>torched</w> the politician's reputation in her latest article.",
                            "target_lang_translations": {
                                "zh": "那位记者在最新的文章中<w>抨击</w>了这位政客的声誉。"
                            }
                        },
                        {
                            "text": "The critic <w>torched</w> the new movie, calling it the worst film of the year.",
                            "target_lang_translations": {
                                "zh": "影评人<w>抨击</w>了这部新电影，称其为年度最烂影片。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disparage",
                        "defame",
                        "vilify"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过恶意言论破坏某人或某事的声誉。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抨击",
                                "target_lang_sense_clarification": "严厉批评或诋毁"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}