                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banzaï",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7959f20f-c09a-37a2-9715-8b667570f3a4",
                                        "entry_id": "7b15d03a-6eb3-3f76-8baa-574c2b163135",
                                        "glosses": [
                                            "Variante orthographique de banzai."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98b1b7eb-b3d9-4a2b-b474-a2f387bce304",
                                                "sense_id": "7959f20f-c09a-37a2-9715-8b667570f3a4",
                                                "text": "Attention ! C’est le virage de la mort ! BANZAÏ !"
                                            },
                                            {
                                                "example_id": "a5f90bb7-a279-4741-b80d-b3ac4f21d7c0",
                                                "sense_id": "7959f20f-c09a-37a2-9715-8b667570f3a4",
                                                "text": "Alors se produisit un phénomène dont le souvenir n’a pas fini de me bouleverser ; des centaines de poitrines réunies là, dont la mienne, s’éleva une clameur :\n— Banzaï !\nCe cri était une litote : dix mille ans n’auraient pas suffi à exprimer le sentiment d’éternité japonaise suscité par ce spectacle."
                                            },
                                            {
                                                "example_id": "5beb1299-ae84-4664-bf51-46561004d1ac",
                                                "sense_id": "7959f20f-c09a-37a2-9715-8b667570f3a4",
                                                "text": "Ah bon ?\n— Oui. Tu as dit : “Banzaï !”\n— Banzaï ? Eh bien, ça alors.\n— Toute la soirée, pendant qu’on, tu sais, j’ai entendu ce mot résonner dans mes oreilles. Banzaï ! Banzaï ! Comme si Tonto remuait en rythme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
