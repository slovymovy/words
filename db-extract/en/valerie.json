                        "entry_id": "1451bcd3-2fd7-3c67-a875-4e9dcd55ffe5",
                        "glosses": [
                            "A female given name from Latin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09cab965-899c-41a6-b457-941c3d17a98d",
                                "sense_id": "27073776-201b-3e27-b3da-5a124883f37f",
                                "text": "Cos since I've come home, well my body's been a mess\nAnd I've missed your ginger hair and the way you dress\nWon't you come on over stop making a fool out of me?\nWhy won't you come on over Valerie? Valerie? Valerie? Valerie?"
                            }
                        ]
