                {
                    "sense_id": "dfe7ec7e-660a-3472-88ed-39c05e31c0c1",
                    "sense_definition": "A type of floodlight used in photography or film to provide even illumination.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lighting technician set up several <w>broads</w> to wash the set with light.",
                            "target_lang_translations": {
                                "ru": "Осветитель установил несколько <w>софитов</w>, чтобы залить съемочную площадку светом.",
                                "tr": "Işık teknisyeni, seti ışıkla doldurmak için birkaç <w>geniş açılı projektör</w> kurdu."
                            }
                        },
                        {
                            "text": "Using a <w>broad</w> helps to eliminate harsh shadows in the studio.",
                            "target_lang_translations": {
                                "ru": "Использование <w>широкоизлучателя</w> помогает устранить резкие тени в студии.",
                                "tr": "Bir <w>projektör</w> kullanmak stüdyodaki sert gölgeleri gidermeye yardımcı olur."
                            }
