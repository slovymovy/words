                    }
                ],
                "senses": [
                    {
                        "sense_id": "08a9fdb9-fb70-340b-b3f4-aeed01c55a5a",
                        "entry_id": "7a570318-b200-3dbf-b49d-0ecb4c2c55ff",
                        "glosses": [
                            "von Würmern zerfressen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed140b5e-c491-4688-b55d-6f89b001eca1",
                                "sense_id": "08a9fdb9-fb70-340b-b3f4-aeed01c55a5a",
                                "text": "„Im Jahr nach meiner Entdeckung des Grabes stieß ich im büchergefüllten Speicher meines Elternhauses auf eine wurmzerfressene Übersetzung von Plutarchs Parallelbiografien.“"
                            },
                            {
                                "example_id": "0a025739-f282-4057-a3bd-e20820d75dc3",
                                "sense_id": "08a9fdb9-fb70-340b-b3f4-aeed01c55a5a",
                                "text": "„Er öffnete den wurmzerfressenen Ledereinband mit den Schließspangen aus mattem Stahl und las sich selbst vor, wobei er eben den Absatz aus dem altertümlichen Französisch übersetzte, der sich auf Zon Mezzamalech bezog:“"
                            },
                            {
                                "example_id": "fb08ba41-959a-44f7-b34b-f2f25d2f435b",
                                "sense_id": "08a9fdb9-fb70-340b-b3f4-aeed01c55a5a",
