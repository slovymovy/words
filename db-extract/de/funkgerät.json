                        ],
                        "form": "das Funkgerät"
                    },
                    {
                        "form_id": "aa95d0ad-6906-49f6-bfa3-9c2d4992d269",
                        "entry_id": "ba86cac8-ce3d-37ef-93cd-bff9c644349d",
                        "tags": [
                            "accusative",
