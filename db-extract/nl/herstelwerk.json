                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bf458d4-5438-402c-8325-d476d1995d51",
                                "sense_id": "07162f6a-b82a-385a-888b-7bf242e23ab8",
                                "text": "Voor de restauratie zal Dooijes allereerst oud herstelwerk ongedaan moeten maken: breuklijnen zijn in het verleden bijgewerkt met mortel. \"Dat lijkt op het zandsteen van de kist, maar het water waar mortel mee gemaakt wordt, trekt in de poreuze steen. Daardoor zet vuiligheid of kleurresten zich als een rand vast verderop in de steen. Die verkleuring is heel storend.\""
                            }
                        ]
                    }
