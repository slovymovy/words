                "senses": [
                    {
                        "sense_id": "9808a69a-1e02-30b1-8598-2fddf558f6b9",
                        "entry_id": "91d4a049-d87a-31e3-be31-d7bb7508e080",
                        "glosses": [
                            "Creux, cavité"
