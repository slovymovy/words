                "senses": [
                    {
                        "sense_id": "5d6c4ecd-bc22-3baf-8bff-3881ee3b744f",
                        "entry_id": "e7610638-133c-3bdc-9399-bc237975fdac",
                        "glosses": [
                            "Beauté trouvée dans la simplicité et la sobriété pour les Japonais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7a7673f-06fb-46aa-8dda-5b9997e000c2",
                                "sense_id": "5d6c4ecd-bc22-3baf-8bff-3881ee3b744f",
                                "text": "À l’époque Heian, le goût général allant aux atmosphères sobres et sereines, la rusticité des shiba-gaki était particulièrement appréciée. Cette inclinaison rejoignait les tendances érémitiques de la population chinoise d’alors, tendances d'où naquit par la suite la notion japonaise de wabi."
                            },
                            {
                                "example_id": "1f7e6deb-8097-4efe-87f8-95341e24fdd8",
                                "sense_id": "5d6c4ecd-bc22-3baf-8bff-3881ee3b744f",
                                "text": "Le bon goût suprême. Et… l’ascétisme. Quelques pièces de collection. Ici, une lampe ; là, une table, une bibliothèque, une gravure au mur. Le sens japonais inouï du wabi. Un concept impensable en anglais."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7be66f01-1424-4357-b027-682aeedd76c2",
                        "source_entry_id": "e7610638-133c-3bdc-9399-bc237975fdac",
                        "source_sense_id": "5d6c4ecd-bc22-3baf-8bff-3881ee3b744f",
                        "target_lang_word": "wabi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wabi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42e52447-23a9-3d30-8f98-fa3089be46e0",
                                        "entry_id": "49ead03a-be48-350f-93d2-ad8ab443e232",
                                        "glosses": [
                                            "A quality of simple or solitary beauty, especially as expressed in various forms of Japanese art or culture."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eab4b349-69c1-4e07-9e90-dbb063dcda23",
                                                "sense_id": "42e52447-23a9-3d30-8f98-fa3089be46e0",
                                                "text": "A lamp here, table, bookcase, print on the wall. The incredible Japanese sense of wabi."
                                            },
                                            {
                                                "example_id": "3bc34ffb-3b0b-4692-bf28-7164ea752907",
                                                "sense_id": "42e52447-23a9-3d30-8f98-fa3089be46e0",
                                                "text": "One of these changes would be the further refinement of the concept of wabi as an aesthetic ideal, and that was to be the work of Takeno Jōō, under whom the Way of Tea would mature."
                                            }
                                        ]
                                    }
                                ]
                            }
