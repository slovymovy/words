                ],
                "senses": [
                    {
                        "sense_id": "25192615-4517-307d-a691-cda4395470e2",
                        "entry_id": "40498476-dd97-3937-9684-8099ffe9dd1e",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1bd04ec-5ff1-482d-b3be-81e2a669c140",
                                "sense_id": "25192615-4517-307d-a691-cda4395470e2",
                                "text": "Élise se déchatouillant l’oreille."
                            },
                            {
                                "example_id": "8adb0dca-ccd3-408d-9f6e-f9b7aed0e9fe",
                                "sense_id": "25192615-4517-307d-a691-cda4395470e2",
                                "text": "Élise, infirmière canadienne plus têtue qu'une chèvre et plus généreuse qu'un champ de coquelicots, s'occupa de la perfusion."
                            },
                            {
                                "example_id": "f45034a3-6225-4dd3-b7a5-05e5329cb1d3",
                                "sense_id": "25192615-4517-307d-a691-cda4395470e2",
                                "text": "La rencontre avec sa passagère, Élise, puis la complicité avec sa propre fille, Klara, vont conduire Brendan, au fil des rebondissements de ce roman, à une prise de conscience inédite pour lui."
                            },
                            {
                                "example_id": "087686fa-360b-4532-a8ed-662cf8a22ea2",
                                "sense_id": "25192615-4517-307d-a691-cda4395470e2",
                                "text": "Demain, à 11 h, Élise Kermanac’h et Laurent Wagschal interpréteront des œuvres pour clavier de Bach."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
