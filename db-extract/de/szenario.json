                        ],
                        "form": "die Szenarios"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd685323-921d-35cc-9053-30e779c51cb4",
                        "entry_id": "206674da-61e8-34d3-8039-d64a8cf55093",
                        "glosses": [
                            "Entwurf der Situation, des Rahmens, in die das Geschehen des Kunstwerks eingebettet wird"
                        ],
                        "tags": [
                            "Film"
                        ],
                        "examples": [
                            {
                                "example_id": "f2c5b7ac-e68f-4035-ba35-a2ccc9538ea9",
                                "sense_id": "fd685323-921d-35cc-9053-30e779c51cb4",
                                "text": "Grass wählte als Szenario für seine Blechtrommel Danzig und die Kaschubei."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "77b7570d-0d0e-3ffe-a5cf-4de3b7b19dc3",
                        "entry_id": "206674da-61e8-34d3-8039-d64a8cf55093",
                        "glosses": [
                            "die Gesamtheit der Gegebenheiten, Umstände, in denen sich ein Geschehen abspielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cfb9cf7-e29f-4670-b0c5-0762f00cd606",
                                "sense_id": "77b7570d-0d0e-3ffe-a5cf-4de3b7b19dc3",
                                "text": "Die wirtschaftliche Entwicklung muss man zur Zeit in dem Szenario der Finanzkrise sehen."
                            },
                            {
                                "example_id": "d53f69e4-daad-401f-8961-1fbda0f91f56",
                                "sense_id": "77b7570d-0d0e-3ffe-a5cf-4de3b7b19dc3",
                                "text": "„Was dem Szenario in den Folterkammern vorausgegangen war, entpuppte sich coram publico als unbeschreibliche Grausamkeitswollust.“"
                            },
                            {
                                "example_id": "8333fa68-17b1-44ae-a10f-12a940928002",
                                "sense_id": "77b7570d-0d0e-3ffe-a5cf-4de3b7b19dc3",
                                "text": "„Die Feuerwehr raste auf das nun merkwürdig still daliegende Szenario zu.“"
                            },
                            {
                                "example_id": "afcd6626-20d5-44e3-8f5c-69e36f8f3a18",
                                "sense_id": "77b7570d-0d0e-3ffe-a5cf-4de3b7b19dc3",
                                "text": "„Als sie anschließend gefragt wurden, wie fair ihnen das jeweilige Szenario erschien, wurden die Aktivitäten in unterschiedlichen Gehirnregionen mithilfe der Kernspintomographie gemessen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a154940e-022b-38da-9417-71755559d912",
                        "entry_id": "206674da-61e8-34d3-8039-d64a8cf55093",
                        "glosses": [
                            "für die Zukunft geplante oder vorgestellte Umstände"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "126a5aba-1e86-4034-83e2-2857a8ac32fb",
                                "sense_id": "a154940e-022b-38da-9417-71755559d912",
                                "text": "Für die Zukunft sollte ein Szenario entwickelt werden, in dem die Fehler der Vergangenheit vermieden werden."
                            },
                            {
                                "example_id": "d7140ed1-e00d-41e8-9380-d681d2d87d6c",
                                "sense_id": "a154940e-022b-38da-9417-71755559d912",
                                "text": "„Voraussetzung für diesen Appell ist das in dem Programm konstruierte Szenario einer Masseneinwanderung von Migranten und Flüchtlingen, die die deutsche Kultur in Gefahr bringt.“"
                            },
                            {
                                "example_id": "f5fbb2f6-c939-4d6d-8b80-c0a95ceb17fe",
                                "sense_id": "a154940e-022b-38da-9417-71755559d912",
                                "text": "„Natürlich ist ein solches Szenario nur möglich, wenn das Volk die Frage erzwingt.“"
                            },
                            {
                                "example_id": "1f879094-d701-4a76-9764-a2144bafe65f",
                                "sense_id": "a154940e-022b-38da-9417-71755559d912",
                                "text": "„Mit Hilfe von Klimamodellen haben die Wissenschaftlerinnen und Wissenschaftler die Auswirkungen auf das globale und regionale Klima auf der Basis von Szenarien untersucht.“"
                            },
                            {
                                "example_id": "47eb171b-4858-4c63-a18c-4442d571c892",
                                "sense_id": "a154940e-022b-38da-9417-71755559d912",
                                "text": "„Für Hamburg ergibt sich je nach gewähltem Szenario eine Erhöhung der Jahresmitteltemperatur von mindestens 1 °C bis hin zu knapp 4 °C bis zum Ende des Jahrhunderts.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
