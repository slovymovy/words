{
    "word_family": [
        "fidel",
        "infidel"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cbf3c4ac-8ba2-379a-b8c9-1daf5a145818",
                    "sense_definition": "Faithfulness to one's duties or obligations.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "loyalty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The employee was praised for his <w>fidelity</w> to the company's core values.",
                            "target_lang_translations": {
                                "ru": "Сотрудника похвалили за его <w>верность</w> основным ценностям компании."
                            }
                        },
                        {
                            "text": "She maintained strict <w>fidelity</w> to her duties throughout the long project.",
                            "target_lang_translations": {
                                "ru": "Она сохраняла строгую <w>верность</w> своим обязанностям на протяжении всего долгого проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "allegiance",
                        "devotion"
                    ],
                    "common_phrases": [
                        "strict fidelity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преданность своим обязанностям или обязательствам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ве́рность",
                                "target_lang_sense_clarification": "постоянство в исполнении долга или обязательств"
                            },
                            {
                                "target_lang_word": "преда́нность",
                                "target_lang_sense_clarification": "глубокая привязанность и верность делу или человеку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15d949af-c013-313a-b2a6-6365fd3ca465",
                    "sense_definition": "Loyalty to one's spouse or partner, including abstention from cheating.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "loyalty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The couple promised lifelong <w>fidelity</w> to each other during their wedding ceremony.",
                            "target_lang_translations": {
                                "ru": "Во время свадебной церемонии пара пообещала хранить друг другу <w>верность</w> всю жизнь."
                            }
                        },
                        {
                            "text": "Their marriage was built on a foundation of mutual trust and <w>fidelity</w>.",
                            "target_lang_translations": {
                                "ru": "Их брак был построен на фундаменте взаимного доверия и <w>верности</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "faithfulness",
                        "loyalty"
                    ],
                    "antonyms": [
                        "infidelity"
                    ],
                    "common_phrases": [
                        "marital fidelity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Верность супругу или партнеру, включая воздержание от измен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "супру́жеская ве́рность",
                                "target_lang_sense_clarification": "верность в браке"
                            },
                            {
                                "target_lang_word": "ве́рность",
                                "target_lang_sense_clarification": "отсутствие измен в отношениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7317d44-9f42-3c50-9cec-cde4eecf1d06",
                    "sense_definition": "The quality of being accurate or having an exact correspondence to a fact or original.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "accuracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian praised the <w>fidelity</w> of the film to the actual historical events.",
                            "target_lang_translations": {
                                "ru": "Историк высоко оценил <w>точность</w> фильма в передаче реальных исторических событий."
                            }
                        },
                        {
                            "text": "The translation was noted for its high <w>fidelity</w> to the original text.",
                            "target_lang_translations": {
                                "ru": "Перевод был отмечен своей высокой <w>точностью</w> по отношению к исходному тексту."
                            }
                        }
                    ],
                    "synonyms": [
                        "accuracy",
                        "precision"
                    ],
                    "common_phrases": [
                        "high fidelity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество точности или точного соответствия факту или оригиналу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "то́чность",
                                "target_lang_sense_clarification": "соответствие оригиналу или истине"
                            },
                            {
                                "target_lang_word": "достове́рность",
                                "target_lang_sense_clarification": "соответствие реальным фактам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02a68ac4-f788-3114-b024-6c9925e61dd7",
                    "sense_definition": "The degree to which an electronic system accurately reproduces an input signal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "accuracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Audiophiles often prefer equipment that offers high <w>fidelity</w> for the best sound quality.",
                            "target_lang_translations": {
                                "ru": "Аудиофилы часто предпочитают оборудование, обеспечивающее высокую <w>точность</w> воспроизведения для наилучшего качества звука."
                            }
                        },
                        {
                            "text": "We need to improve the <w>fidelity</w> of the system to ensure clear audio transmission.",
                            "target_lang_translations": {
                                "ru": "Нам нужно улучшить <w>точность</w> системы, чтобы обеспечить четкую передачу звука."
                            }
                        }
                    ],
                    "synonyms": [
                        "clarity",
                        "accuracy"
                    ],
                    "common_phrases": [
                        "high fidelity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Степень, с которой электронная система точно воспроизводит входной сигнал."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокое ка́чество",
                                "target_lang_sense_clarification": "высокая степень точности воспроизведения звука"
                            },
                            {
                                "target_lang_word": "то́чность воспроизведе́ния",
                                "target_lang_sense_clarification": "техническая характеристика аудиосистем"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}