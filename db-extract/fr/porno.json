                                            {
                                                "example_id": "bacfe32e-daa2-4242-ae31-c0588413c848",
                                                "sense_id": "94819481-daae-3f77-ab5f-fc908aaec682",
                                                "text": "Насмотрелся дед порнухи, // Начал дед дурачиться! // Деревенские старухи // По чуланам прячутся!"
                                            },
                                            {
                                                "example_id": "66b6567b-af68-4c83-9294-7de83f39315d",
                                                "sense_id": "94819481-daae-3f77-ab5f-fc908aaec682",
                                                "text": "Вся порнуха, которую мы смотрели в юности, вывозилась через дипломатическую почту."
                                            }
                                        ]
                                    }
                                ]
                            }
