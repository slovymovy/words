                        "examples": [
                            {
                                "example_id": "7b8cd35a-3191-4450-a26c-9e6c3c751472",
                                "sense_id": "e17d7549-8264-3350-a6c7-91eca851f0a1",
                                "text": "De koper- en zinkhoudende verf die eigenaren van privé jachten en motorboten regelmatig gebruiken, zouden ook zeer schadelijk zijn en zelfs al verboden in bepaalde regio’s."
                            },
                            {
                                "example_id": "4a3dd5ef-3ee9-45bc-8690-5fea64abbcc0",
                                "sense_id": "e17d7549-8264-3350-a6c7-91eca851f0a1",
                                "text": "Zij trok in maart van dit jaar nog aan de bel. \"Heel veel mensen gebruiken een antifouling verf,\" zei ze toen tegen NOS. \"Dat is dan vaak een koper- of zinkhoudende verf. De verf die dan op je boot zit, zit na een jaar in het water.\""
                            }
                        ]
                    }
