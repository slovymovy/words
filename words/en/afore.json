    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "962dde9f-43cf-36ab-975e-a9ca51c8fad5",
                    "sense_definition": "Earlier than; in advance of a particular time or event.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old farmer promised he would finish harvesting the wheat <w>afore</w> nightfall.",
                            "target_lang_translations": {
                                "es": "El viejo granjero prometió que terminaría de cosechar el trigo <w>antes del</w> anochecer."
                            }
                        },
                        {
                            "text": "They had lived peacefully in the village together long <w>afore</w> the war began.",
                            "target_lang_translations": {
                                "es": "Habían vivido juntos en paz en la aldea mucho <w>antes de que</w> comenzara la guerra."
                            }
                        }
                    ],
                    "synonyms": [
                        "before",
                        "prior to",
                        "ahead of"
                    ],
                    "antonyms": [
                        "after"
                    ],
                    "common_phrases": [
                        "afore nightfall",
                        "long afore"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in archaic or dialectal contexts instead of before"
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "Persists in regional speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Antes de; con anterioridad a un momento o suceso específico."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "antes de",
                                "target_lang_sense_clarification": "temporal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd9e9444-6bf2-3eb9-8d29-ed16713ce04a",
                    "sense_definition": "In front of someone or something, physically or in the presence of.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner was brought to kneel humbly <w>afore</w> the king and his royal court.",
                            "target_lang_translations": {
                                "es": "El prisionero fue llevado a arrodillarse humildemente <w>ante</w> el rey y su corte real."
                            }
                        },
                        {
                            "text": "He dared not utter a single untruth while standing <w>afore</w> his accusers.",
                            "target_lang_translations": {
                                "es": "No se atrevió a decir ni una sola mentira mientras estaba de pie <w>delante de</w> sus acusadores."
                            }
                        }
                    ],
                    "synonyms": [
                        "before",
                        "in front of"
                    ],
                    "antonyms": [
                        "behind"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in archaic or dialectal English"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Delante de alguien o algo, físicamente o en presencia de."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "ante",
                                "target_lang_sense_clarification": "en presencia de"
                            },
                            {
                                "target_lang_word": "delante de",
                                "target_lang_sense_clarification": "frente a"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "4398a07a-61c9-3583-8e14-2325714c2888",
                    "sense_definition": "Earlier than the time that; before.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure to pack up all the fishing gear <w>afore</w> it begins to storm.",
                            "target_lang_translations": {
                                "es": "Asegúrate de empacar todo el equipo de pesca <w>antes de que</w> empiece la tormenta."
                            }
                        },
                        {
                            "text": "She ran out into the courtyard <w>afore</w> anyone could speak another word.",
                            "target_lang_translations": {
                                "es": "Salió corriendo al patio <w>antes de que</w> nadie pudiera pronunciar otra palabra."
                            }
                        }
                    ],
                    "synonyms": [
                        "before",
                        "ere"
                    ],
                    "antonyms": [
                        "after"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in archaic or dialectal speech"
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "Found in certain regional English dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Antes de que; con anterioridad al momento en que ocurre algo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "antes de que",
                                "target_lang_sense_clarification": "conjunción temporal"
                            },
                            {
                                "target_lang_word": "antes que",
                                "target_lang_sense_clarification": "conjunción temporal"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d9ef7232-b4b1-31ae-a216-fc56999c7cc8",
                    "sense_definition": "At an earlier time; beforehand or previously.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had never tasted such sweet wine in my life <w>afore</w>.",
                            "target_lang_translations": {
                                "es": "Nunca <w>antes</w> en mi vida había probado un vino tan dulce."
                            }
                        },
                        {
                            "text": "As was mentioned <w>afore</w>, the travelers could not cross the frozen river.",
                            "target_lang_translations": {
                                "es": "Como se mencionó <w>previamente</w>, los viajeros no pudieron cruzar el río congelado."
                            }
                        }
                    ],
                    "synonyms": [
                        "before",
                        "previously",
                        "beforehand",
                        "earlier"
                    ],
                    "antonyms": [
                        "afterwards",
                        "later"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Archaic and dialectal variant of before"
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "Common in regional English"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "En un momento anterior; previamente o de antemano."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "antes",
                                "target_lang_sense_clarification": "con anterioridad"
                            },
                            {
                                "target_lang_word": "previamente",
                                "target_lang_sense_clarification": "de antemano"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c46b2468-7435-3859-8bdd-48f0faf2c0a3",
                    "sense_definition": "In front or ahead in physical position, especially toward the front.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A scout rode swiftly <w>afore</w> to ensure that the mountain road was clear.",
                            "target_lang_translations": {
                                "es": "Un explorador cabalgó velozmente <w>por delante</w> para asegurarse de que el camino de montaña estuviera despejado."
                            }
                        },
                        {
                            "text": "The sailors gathered on deck to see what obstacles lay floating <w>afore</w>.",
                            "target_lang_translations": {
                                "es": "Los marineros se reunieron en la cubierta para ver qué obstáculos flotaban <w>más adelante</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ahead",
                        "before",
                        "in front"
                    ],
                    "antonyms": [
                        "behind",
                        "abaft"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Archaic or nautical spatial use"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Hacia adelante o en una posición delantera en el espacio."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "adelante",
                                "target_lang_sense_clarification": "en posición delantera"
                            },
                            {
                                "target_lang_word": "por delante",
                                "target_lang_sense_clarification": "al frente"
                            }
                        ]
                    }
                }
            ]
        }
