                ],
                "senses": [
                    {
                        "sense_id": "76659dbf-cbe0-3db9-a8eb-8f77cad3b911",
                        "entry_id": "1284686f-3e0c-3117-91e1-7da9c0a51606",
                        "glosses": [
                            "jemand, der Mitglied in einer Koalition ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a64a8d6-7421-4e8c-bd48-0334910fb907",
                                "sense_id": "76659dbf-cbe0-3db9-a8eb-8f77cad3b911",
                                "text": "„Nach einem relativ ereignisarmen U-Ausschuss-Termin kam es donnerstagabends noch zum Eklat: Die Grünen stimmten gemeinsam mit SPÖ, FPÖ und Neos zwei Ladungsbegehren des Koalitionspartners ÖVP nieder.“"
                            },
                            {
                                "example_id": "0b0744be-8314-4ece-88fb-bf521adea048",
                                "sense_id": "76659dbf-cbe0-3db9-a8eb-8f77cad3b911",
                                "text": "„Im Panjab regierte die Unionist Party, eine konservative Agrarpartei, in der muslimische und hinduistische Grundbesitzer einen gemeinsamen Nenner gefunden hatten, und in Bengalen konnte die Krishak Proja Party, eine Partei der muslimischen Pächter, mit einigen Koalitionspartnern eine Regierung bilden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
