                                "example_id": "12db6ee7-c98e-434d-9b38-31bcade22422",
                                "sense_id": "f364fb7a-8380-33ac-bb8c-7c4260d4e64b",
                                "text": "Ôtez les fanes des mini-betteraves et gardez-les pour l’émulsion."
                            },
                            {
                                "example_id": "4247b557-e712-43ce-b20e-4ddc873b814f",
                                "sense_id": "f364fb7a-8380-33ac-bb8c-7c4260d4e64b",
                                "text": "À la mandoline, taillez le fenouil, le poivron, les cébettes, les radis, les mini-betteraves, le concombre et les asperges."
