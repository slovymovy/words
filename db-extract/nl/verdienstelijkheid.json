                    }
                ],
                "senses": [
                    {
                        "sense_id": "9845b679-08a3-39bf-a6c9-9c00dade9bae",
                        "entry_id": "1bb05223-7d20-3072-971d-2acebd5a80bf",
                        "glosses": [
                            "de hoedanigheid van een beloning verdienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "416b5022-f94f-4208-97e9-dc78ff73a841",
                                "sense_id": "9845b679-08a3-39bf-a6c9-9c00dade9bae",
                                "text": "Hij voelde hoe er een gevoel van woede in hem opkwam dat zijn rust verstoorde en de verdienstelijkheid van zijn daad tenietdeed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f00e9856-3a17-47a2-bdb8-115206fc0213",
                        "source_entry_id": "1bb05223-7d20-3072-971d-2acebd5a80bf",
                        "source_sense_id": "9845b679-08a3-39bf-a6c9-9c00dade9bae",
                        "source_sense_description": "de hoedanigheid van een beloning verdienen",
                        "target_lang_word": "merit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "merit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dbaccf8-b306-33a8-8083-394f6ba8a1a7",
                                        "entry_id": "e2393776-4072-385f-8a74-06be0ae82977",
                                        "glosses": [
                                            "A claim to commendation or a reward."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3880dda-2fa4-461e-9961-341e62f15efa",
                                                "sense_id": "0dbaccf8-b306-33a8-8083-394f6ba8a1a7",
                                                "text": "[R]eputation is an idle and moſt falſe impoſition , oft got without merit and loſt without deſeruing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0be124d3-f515-3ef3-b86a-2f6e7df5c0a8",
                                        "entry_id": "e2393776-4072-385f-8a74-06be0ae82977",
                                        "glosses": [
                                            "A mark or token of approbation or to recognize excellence."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c246f6a0-6f5c-45e3-9373-5bc633837747",
                                                "sense_id": "0be124d3-f515-3ef3-b86a-2f6e7df5c0a8",
                                                "text": "For her good performance in the examination, her teacher gave her ten merits."
                                            },
                                            {
                                                "example_id": "f579d396-b1cc-46ff-91d0-58078066443c",
                                                "sense_id": "0be124d3-f515-3ef3-b86a-2f6e7df5c0a8",
                                                "text": "Thoſe laurel groves (the merits of thy youth), / Which thou from Mahomet didſt greatly gain, / While, bold aſſertor of reſiſtleſs truth, / Thy ſword did godlike liberty maintain, / Muſt from thy brow their falling honours ſhed, / And their tranſplanted wreaths muſt deck a worthier head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45bcc63a-1fb6-304f-92b0-7f88775cd6e2",
                                        "entry_id": "e2393776-4072-385f-8a74-06be0ae82977",
                                        "glosses": [
                                            "Something deserving or worthy of positive recognition or reward."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46d1300b-2b38-4673-ba85-d3977ad2a80b",
                                                "sense_id": "45bcc63a-1fb6-304f-92b0-7f88775cd6e2",
                                                "text": "His reward for his merit was a check for $50."
                                            },
                                            {
                                                "example_id": "b63e8f17-113d-44bb-9fc3-53d31d5ad30c",
                                                "sense_id": "45bcc63a-1fb6-304f-92b0-7f88775cd6e2",
                                                "text": "Such was Roſcommon—not more learn’d than good; / With Manners gen’rous as his Noble Blood; / To him the Wit of Greece and Rome was known, / And ev’ry Author’s Merit but his own."
                                            },
                                            {
                                                "example_id": "1da57f3f-fdeb-4c4d-8a5d-eaac73278b07",
                                                "sense_id": "45bcc63a-1fb6-304f-92b0-7f88775cd6e2",
                                                "text": "In all our noble Anglo-Saxon language, there is scarcely a nobler word than worth; yet this term has now almost exclusively a pecuniary meaning. So that if you ask what a man is worth, nobody ever thinks of telling you what he is, but what he has. The answer will never refer to his merits, his virtues, but always to his possessions. He is worth—so much money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74a2d1d5-625b-33f6-b095-b8f2b289a84e",
                                        "entry_id": "e2393776-4072-385f-8a74-06be0ae82977",
                                        "glosses": [
                                            "The sum of all the good deeds that a person does which determines the quality of the person's next state of existence and contributes to the person's growth towards enlightenment."
                                        ],
                                        "tags": [
                                            "Jainism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18a2cb6d-be21-4f3f-8d8c-bf7f68074b30",
                                                "sense_id": "74a2d1d5-625b-33f6-b095-b8f2b289a84e",
                                                "text": "to acquire or make merit"
                                            },
                                            {
                                                "example_id": "6e9e5814-cd84-4f49-b7f1-83ae9cd47b18",
                                                "sense_id": "74a2d1d5-625b-33f6-b095-b8f2b289a84e",
                                                "text": "It is no small tax upon the people to support their [Buddhist] priests, but they do it with a willing heart. When I was once at the old capital, I saw a woman, from her own stock, feed more than fifty priests, who came to her in his turn, and received his portion. [...] If I had asked her why she thus spent so much of her living, her answer would have been, 'To make merit.'"
                                            },
                                            {
                                                "example_id": "95915e18-a818-4df4-8540-1d672d51966d",
                                                "sense_id": "74a2d1d5-625b-33f6-b095-b8f2b289a84e",
                                                "text": "At funerals, acts of sharing religious merit are central and relatives of the deceased make merit in order to ensure that the departed family member will have a favourable rebirth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d6bbcf7-adad-3386-9e5b-e7d56fde2d24",
                                        "entry_id": "e2393776-4072-385f-8a74-06be0ae82977",
                                        "glosses": [
                                            "Usually in the plural form the merits: the substantive rightness or wrongness of a legal argument, a lawsuit, etc., as opposed to technical matters such as the admissibility of evidence or points of legal procedure; (by extension) the overall good or bad quality, or rightness or wrongness, of some other thing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "915687e7-9923-4a05-a382-8d0f0b1e2efb",
                                                "sense_id": "8d6bbcf7-adad-3386-9e5b-e7d56fde2d24",
                                                "text": "Even though the plaintiff was ordered by the judge to pay some costs for not having followed the correct procedure, she won the case on the merits."
                                            },
                                            {
                                                "example_id": "5d5bf672-ed24-4497-b22f-6ace3197355d",
                                                "sense_id": "8d6bbcf7-adad-3386-9e5b-e7d56fde2d24",
                                                "text": "The Plaintiff muſt ſhew Cauſe either on the Merits, or upon filing Exceptions; if upon the Merits, the Court may put what Terms they pleaſe on him; as bringing in the Money, or paying it to the Parties, ſubject to the Order of the Court, [...]"
                                            },
                                            {
                                                "example_id": "6618f4a8-8431-4040-a415-43b4734e7dd5",
                                                "sense_id": "8d6bbcf7-adad-3386-9e5b-e7d56fde2d24",
                                                "text": "[I]n most cases once the Court has performed its judicial function – as it had been determined by the parties through their Application or Special Agreement and their submissions – and has rendered its judgment on the merits of the case, a new phrase of functional interaction commences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14c65c7a-e53a-327f-b7cf-b295bbba322b",
                                        "entry_id": "e2393776-4072-385f-8a74-06be0ae82977",
                                        "glosses": [
                                            "The quality or state of deserving retribution, whether reward or punishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e1e3d29-60b2-414b-9ead-9a1309c16869",
                                                "sense_id": "14c65c7a-e53a-327f-b7cf-b295bbba322b",
                                                "text": "Be it known, that we the greateſt are mis-thoght / For things that others do : and when we fall, / We anſwer others merits, in our name / Are therefore to be pittied."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "merit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b109a33-2857-3258-ad15-ecd806a12af9",
                                        "entry_id": "47fa9788-af2b-3a7a-ad26-6c2517fd241b",
                                        "glosses": [
                                            "To deserve, to earn."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edac4adb-5709-4b10-9782-e8123c6210c2",
                                                "sense_id": "9b109a33-2857-3258-ad15-ecd806a12af9",
                                                "text": "Her performance merited wild applause."
                                            },
                                            {
                                                "example_id": "f059cc1c-4b14-453b-b85f-22144eaca1e3",
                                                "sense_id": "9b109a33-2857-3258-ad15-ecd806a12af9",
                                                "text": "Oh! France! charming country! where I had the good fortune to be born! one never quits thee with impunity. Celebrated for the rich beauty of thy soil, for the sociability of thy inhabitants, for all the comforts of civilized life, thou meritest thy reputation, and nothing is so rare."
                                            },
                                            {
                                                "example_id": "3a50d196-81e8-4c65-ad5d-81a920a3d439",
                                                "sense_id": "9b109a33-2857-3258-ad15-ecd806a12af9",
                                                "text": "What other could I answer save \"I come\"? / I said it, somewhat with that colour ting'd / Which oftimes pardon meriteth for man."
                                            },
                                            {
                                                "example_id": "9c3b9378-8086-4f7d-91ed-4aeff9a6b69f",
                                                "sense_id": "9b109a33-2857-3258-ad15-ecd806a12af9",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness, the consciousness dawning upon him that his eccentricity was not receiving the ovation it merited."
                                            },
                                            {
                                                "example_id": "b61bec6a-174b-44f3-8ec7-62a2075c44e4",
                                                "sense_id": "9b109a33-2857-3258-ad15-ecd806a12af9",
                                                "text": "Sudden anger rose in him. “What I’m looking for,” he barked, “is to be left in peace.” His voice trembled with a rage far bigger than her intrusion merited, the rage which shocked him whenever it coursed through his nervous system, like a flood."
                                            },
                                            {
                                                "example_id": "afe5edee-333f-4549-a3c3-31a978dd6e9c",
                                                "sense_id": "9b109a33-2857-3258-ad15-ecd806a12af9",
                                                "text": "Take the principle that requires distribution of help in accord with need. It would certainly support allocating some help to its only potential recipient, provided she is in need. And on the plausible assumption that the more meriting of some good one is the more good one merits, the principle would support allocating more of the help to her the greater her needs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1438879-ff81-35d5-812f-b27ee5e136d2",
                                        "entry_id": "47fa9788-af2b-3a7a-ad26-6c2517fd241b",
                                        "glosses": [
                                            "To be deserving or worthy."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5ff3a26-a2da-4fc0-8626-931bec72eb55",
                                                "sense_id": "d1438879-ff81-35d5-812f-b27ee5e136d2",
                                                "text": "They were punished as they merited."
                                            },
                                            {
                                                "example_id": "45c585e3-d81c-4466-bedb-f2b2ed59b399",
                                                "sense_id": "d1438879-ff81-35d5-812f-b27ee5e136d2",
                                                "text": "[A]nd yet he bode them do yt, and they were bounde to obaye and meryted and deserued by theyr obedyēce."
                                            },
                                            {
                                                "example_id": "46e0e08d-bf2f-4c36-a886-9f8de9c7d95d",
                                                "sense_id": "d1438879-ff81-35d5-812f-b27ee5e136d2",
                                                "text": "There is none but thee, O ſon of the living God! O faithful friend of our ſouls! that willingly beareſt the croſs for others. All that thou meriteſt by thy croſs, thou meriteſt for us; and thou deſireſt no our recompence for it than our profit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff38dad2-99e7-310c-a9c0-3746f0fb28a8",
                                        "entry_id": "47fa9788-af2b-3a7a-ad26-6c2517fd241b",
                                        "glosses": [
                                            "To reward."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "236eadc3-7de8-4942-938f-1638a8919df0",
                                                "sense_id": "ff38dad2-99e7-310c-a9c0-3746f0fb28a8",
                                                "text": "Thus charg’d thy sire, which thou forgett’st: yet now those thoughts appease / That torture thy great spirit with wrath; which if thou wilt give surcease, / The king will merit it with gifts ; and if thou wilt give ear / I’ll tell you how much he offers thee:—yet thou sitt’st angry here."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
