                "senses": [
                    {
                        "sense_id": "80bc299e-3831-361f-8bde-93235ae7a3a5",
                        "entry_id": "2070b39e-bb3c-39db-99da-9255ba89911b",
                        "glosses": [
                            "Menge an Brennstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a662b320-515d-4039-811e-60bb618e78d5",
                                "sense_id": "80bc299e-3831-361f-8bde-93235ae7a3a5",
                                "text": "„Gasöfen beziehen ihren Brennstoff überwiegend aus dem Netz; vorteilhaft wegen der unmittelbaren Heizwirkung, des hohen Wärmewirkungsgrads und der leichten Regelbarkeit der Brennstoffmenge.“"
                            },
                            {
                                "example_id": "be0d0da2-b196-47d6-a1e8-998582431cdd",
                                "sense_id": "80bc299e-3831-361f-8bde-93235ae7a3a5",
                                "text": "„Infolge der vergrößerten Dichte kann eine größere Luftmenge in den Verbrennungsraum gebracht werden, womit eine größere Brennstoffmenge verbrannt werden kann.“"
                            },
                            {
                                "example_id": "1363866d-e0ec-4b27-b9da-ca81c8c64c1b",
                                "sense_id": "80bc299e-3831-361f-8bde-93235ae7a3a5",
                                "text": "„Jedes der drei Haupthindernisse eines Fusionsantriebs – Steigerung der Leistung, Plasmaeinschluß und magnetische Düsen sowie Beschaffung ausreichender Brennstoffmengen – ist schon für sich genommen überwältigend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
