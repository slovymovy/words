                                        ],
                                        "examples": [
                                            {
                                                "example_id": "327196f9-846a-4907-adca-dd2663744efc",
                                                "sense_id": "2437fc4b-5da6-392e-afb6-1eb9b40f958c",
                                                "text": "But come, it's getting dreadful late, you had better be turning flukes--it's a nice bed; Sal and me slept in that ere bed the night we were spliced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77b44e2d-ad7f-327b-b2b6-088b46858847",
