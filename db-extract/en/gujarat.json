                                                "example_id": "b6effb4d-37d4-46fa-9ad6-874568e9f71e",
                                                "sense_id": "62142184-ec3f-32c4-8655-2fa74d51c1d2",
                                                "text": "Gandhinagar ist die Hauptstadt von Gujarat."
                                            },
                                            {
                                                "example_id": "51590bcc-cb4c-4827-a715-09faa38db581",
                                                "sense_id": "62142184-ec3f-32c4-8655-2fa74d51c1d2",
                                                "text": "„Schließlich wollte es Gandhi wagen, von der Nichtzusammenarbeit zum bürgerlichen Ungehorsam überzugehen, und er hatte dazu den Unterbezirk Bardoli in Gujarat ausgewählt, wo eine Kampagne für die Verweigerung der Grundsteuer beginnen sollte.“"
                                            },
                                            {
                                                "example_id": "08436872-1c09-40ab-8918-ce5e9444fca1",
                                                "sense_id": "62142184-ec3f-32c4-8655-2fa74d51c1d2",
                                                "text": "„Besonders in den Bundesstaaten Gujarat und Maharaschtra werden ihm zudem gute Verbindungsnetzwerke - auch zu Kriminellen - nachgesagt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
