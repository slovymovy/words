                                "target_senses": [
                                    {
                                        "sense_id": "f7fd3060-498f-38b1-a59e-8549e04c016c",
                                        "entry_id": "d5c959b1-9184-321c-94c6-dc602efde52e",
                                        "glosses": [
                                            "Being the same as another; identical, often having been copied from an original."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f82962e7-d0cf-4857-8a92-e9839cae7dfa",
                                                "sense_id": "f7fd3060-498f-38b1-a59e-8549e04c016c",
                                                "text": "This is a duplicate entry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67f4cd22-036d-3451-936a-02822b17f64e",
                                        "entry_id": "d5c959b1-9184-321c-94c6-dc602efde52e",
                                        "glosses": [
                                            "In which the hands of cards, tiles, etc. are preserved between rounds to be played again by other players."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0944ddad-57cf-4b42-b547-ba24b2d5f72a",
                                                "sense_id": "67f4cd22-036d-3451-936a-02822b17f64e",
                                                "text": "duplicate whist"
                                            },
                                            {
                                                "example_id": "ee1ec4d2-81e5-4af2-acdf-0a803457c239",
                                                "sense_id": "67f4cd22-036d-3451-936a-02822b17f64e",
                                                "text": "duplicate Scrabble"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "duplicate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a99dc144-eae6-3dec-be60-9b5eadf7455a",
                                        "entry_id": "0b8b9643-d1f3-335c-b0c0-718930f79575",
                                        "glosses": [
                                            "To make a copy of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "658152f7-f9cb-41c8-885d-d690853fe3d1",
                                                "sense_id": "a99dc144-eae6-3dec-be60-9b5eadf7455a",
                                                "text": "If we duplicate the information, are we really accomplishing much?"
                                            },
                                            {
                                                "example_id": "636866e0-ee46-4e48-b9b0-2927290ac5ea",
                                                "sense_id": "a99dc144-eae6-3dec-be60-9b5eadf7455a",
                                                "text": "Can you duplicate this kind of key?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0e0037e-a043-384a-bb0b-21544d295c1c",
                                        "entry_id": "0b8b9643-d1f3-335c-b0c0-718930f79575",
                                        "glosses": [
                                            "To do repeatedly; to do again."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3600a5cb-5b7a-4145-a1b0-3e3ae6dacd64",
                                                "sense_id": "d0e0037e-a043-384a-bb0b-21544d295c1c",
                                                "text": "You don't need to duplicate my efforts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5bb812f-21c6-3a04-8edd-da4fc47c1921",
                                        "entry_id": "0b8b9643-d1f3-335c-b0c0-718930f79575",
                                        "glosses": [
                                            "To produce something equal to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c933c00-3607-4ebe-aca0-2e7b299674ae",
                                                "sense_id": "a5bb812f-21c6-3a04-8edd-da4fc47c1921",
                                                "text": "He found it hard to duplicate the skills of his wife."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "duplicate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "352ee26f-da5c-309d-87b1-8287ceb17006",
                                        "entry_id": "4f2dcf9f-06fb-3a13-bed4-dcbc6063235a",
                                        "glosses": [
                                            "One that resembles or corresponds to another; an identical copy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "772473f1-3898-43e7-888e-5d0247e54026",
                                                "sense_id": "352ee26f-da5c-309d-87b1-8287ceb17006",
                                                "text": "This is a duplicate, but a very good replica."
                                            },
                                            {
                                                "example_id": "5e24063f-577b-4e25-a09d-ff97c855b9fc",
                                                "sense_id": "352ee26f-da5c-309d-87b1-8287ceb17006",
                                                "text": "July 20, 1678, William Temple, letter to the Lord Treasurer\nI send a duplicate both of it and my last dispatch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e4e839-b987-3119-929b-6a99e2c03fcb",
                                        "entry_id": "4f2dcf9f-06fb-3a13-bed4-dcbc6063235a",
                                        "glosses": [
                                            "An original instrument repeated; a document which is the same as another in all essential particulars, and differing from a mere copy in having all the validity of an original"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2f8cf30-2288-351d-8dae-310cd0c55100",
                                        "entry_id": "4f2dcf9f-06fb-3a13-bed4-dcbc6063235a",
                                        "glosses": [
                                            "A pawnbroker's ticket, which must be shown when redeeming a pledged item."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8607b87-ef98-460a-b37c-d97e2046cfac",
                                                "sense_id": "f2f8cf30-2288-351d-8dae-310cd0c55100",
                                                "text": "\"Sir, I hope you will excuse what I am going to say; but having observed that you frequently pledge similar goods to these at our shop, which are afterwards taken out by other persons, I take for granted you are in the habit of selling the duplicates;[…]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d70988a-271d-3f7a-ad66-602cb4fb5ad3",
                                        "entry_id": "4f2dcf9f-06fb-3a13-bed4-dcbc6063235a",
                                        "glosses": [
                                            "The game of duplicate bridge."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52aa5015-bd6f-48e2-94c7-babff7bfa017",
                                                "sense_id": "5d70988a-271d-3f7a-ad66-602cb4fb5ad3",
                                                "text": "The momentary madness which infects bridge players occurs frequently at rubber bridge and duplicate; and though it rarely results in murder, it often terminates marriages and close friendships[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d37137a-171e-3282-a20f-7f13f153568e",
                                        "entry_id": "4f2dcf9f-06fb-3a13-bed4-dcbc6063235a",
                                        "glosses": [
                                            "The game of duplicate Scrabble."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e351f6b1-8cd3-36dd-b72d-8d35be70dc17",
                                        "entry_id": "4f2dcf9f-06fb-3a13-bed4-dcbc6063235a",
                                        "glosses": [
                                            "A biological specimen that was gathered alongside another specimen and represents the same species."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9abe4f46-7458-439b-bb8f-fe500659bcf4",
                                                "sense_id": "e351f6b1-8cd3-36dd-b72d-8d35be70dc17",
                                                "text": "Each collection, which may be a unicate or several specimens as duplicates in several herbaria, constitutes a record in the Conifer Database."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
