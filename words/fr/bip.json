            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ab42a97b-22ab-3060-983a-1cabe6ba023a",
                    "sense_definition": "Signal ou avertissement sonore bref, généralement émis par un appareil électronique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veuillez laisser votre message après le <w>bip</w> sonore."
                        },
                        {
                            "text": "L'appareil médical émet un <w>bip</w> régulier pour indiquer que tout fonctionne bien."
                        }
                    ],
                    "synonyms": [
                        "signal sonore"
                    ],
                    "common_phrases": [
                        "après le bip sonore",
                        "émettre un bip"
                    ]
                },
                {
                    "sense_id": "c3ab1b6c-9c60-3b7c-b134-888439202c9a",
                    "sense_definition": "Boîtier électronique de télécommande servant notamment à commander l'ouverture d'une porte ou d'un portail.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dispositif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai oublié le <w>bip</w> du garage sur la commode de l'entrée."
                        },
                        {
                            "text": "Il appuie sur son <w>bip</w> pour ouvrir la barrière du parking de la résidence."
                        }
                    ],
                    "synonyms": [
                        "télécommande"
                    ],
                    "common_phrases": [
                        "bip du garage"
                    ]
                },
                {
                    "sense_id": "945041e5-e2e5-3573-a0f0-d83e3932fb6f",
                    "sense_definition": "Dans un tournoi au système suisse, adversaire fictif attribuant automatiquement une victoire à un participant sans opposant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Comme nous étions en nombre impair, un joueur a remporté sa manche contre un <w>bip</w>."
                        },
                        {
                            "text": "L'attribution d'un <w>bip</w> permet d'équilibrer le tableau des rencontres sportives."
                        }
                    ],
                    "synonyms": [
                        "bye"
                    ]
                },
                {
                    "sense_id": "d52a9338-33e0-31f5-88df-83e3345009e8",
                    "sense_definition": "Projectile à impact destiné à neutraliser une cible sans perforation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les forces de l'ordre ont testé un <w>bip</w> pour maîtriser un individu dangereux."
                        },
                        {
                            "text": "Ce type de munition utilise un <w>bip</w> afin de réduire les risques de blessures graves."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "dbc5d3df-b514-3303-b8e1-6653812aca34",
                    "sense_definition": "Onomatopée imitant un son bref et aigu, le plus souvent électronique.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
