                "senses": [
                    {
                        "sense_id": "2ec51667-91e5-317d-b8f1-bb4ac666b2c2",
                        "entry_id": "378e5a48-11f7-3bc4-a44a-eea349d2a5eb",
                        "glosses": [
                            "To signify beforehand; predict."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "34f8dd8a-6f92-4d7c-b08f-f9ce324423ba",
                                "sense_id": "2ec51667-91e5-317d-b8f1-bb4ac666b2c2",
                                "text": "She feels that she could \"foreread the future and its mystery\" if she could divine the meaning of the \"burdened sea.\""
                            },
                            {
                                "example_id": "76480c4d-d589-47d0-92fd-8334def7f1ad",
                                "sense_id": "2ec51667-91e5-317d-b8f1-bb4ac666b2c2",
                                "text": "He foreread like a placard Jeanne d'Etoiles' magnificent scheme: it would convulse all Europe, while England would remain supine, simply because Neweastle was a fool and Ormskirk would be dead."
                            }
                        ]
                    },
                    {
                        "sense_id": "48b339da-f605-3b57-be29-646c6c00d6bb",
                        "entry_id": "378e5a48-11f7-3bc4-a44a-eea349d2a5eb",
                        "glosses": [
                            "To read beforehand or ahead of time."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2dcf7378-9b12-441a-92e4-75734f6a771d",
                                "sense_id": "48b339da-f605-3b57-be29-646c6c00d6bb",
                                "text": "I can readily imagine what Pushkin might have said to his trembling paraphrasts; but I also know how pleased and excited I would have been in 1935 had I been able to foreread this 1965 version."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ec00a8f-c2e5-3c67-84ff-26f5fffff2a4",
                        "entry_id": "378e5a48-11f7-3bc4-a44a-eea349d2a5eb",
                        "glosses": [
                            "To perceive, interpret or figure out in advance."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4103e835-e38d-4129-93f7-636c5e163eb3",
                                "sense_id": "9ec00a8f-c2e5-3c67-84ff-26f5fffff2a4",
                                "text": "He foreread like a placard Jeanne d'Etoiles' magnificent scheme: it would convulse all Europe."
                            }
                        ]
                    }
