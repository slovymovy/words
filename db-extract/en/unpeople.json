                ],
                "senses": [
                    {
                        "sense_id": "002b64bf-9904-3515-afe8-b69892e918bb",
                        "entry_id": "dfd1474c-58bf-3988-84dd-4a86cc5957f5",
                        "glosses": [
                            "To deprive of inhabitants; to depopulate."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5cb27f54-f324-49fd-a2a3-6bfcff2c718c",
                                "sense_id": "002b64bf-9904-3515-afe8-b69892e918bb",
                                "text": "Let him bring millions infinite of men,\nUnpeopling weſterne Affrica and Greece:\nYet we aſſure vs of the victorie."
                            },
                            {
                                "example_id": "c2ce723f-b4a9-4e05-a2f9-9f38cb5d9beb",
                                "sense_id": "002b64bf-9904-3515-afe8-b69892e918bb",
                                "text": "He shall have every day a several greeting, / Or I'll unpeople Egypt."
                            },
                            {
                                "example_id": "613c2c16-d9d1-4683-a5f4-793778b35000",
                                "sense_id": "002b64bf-9904-3515-afe8-b69892e918bb",
                                "text": "This / ungenitured agent will unpeople the province with / continency."
                            },
                            {
                                "example_id": "61ca210c-00c6-49b7-9c30-b5fefa0527ba",
                                "sense_id": "002b64bf-9904-3515-afe8-b69892e918bb",
                                "text": "'Tis the cruel gripe, / That lean hard-handed poverty inflicts, / The hope of better things, the chance to win, / The wiſh to ſhine, the thirſt to be amus'd, / That at the found of Winter's hoary wing, / Unpeople all our counties, of ſuch herds, / Of flutt'ring, loit'ring, cringing, begging, looſe, / And wanton vagrants, as make London, vaſt / And boundless as it is, a crowded coop."
                            }
                        ]
                    }
