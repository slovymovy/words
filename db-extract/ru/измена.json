                                "sense_id": "610b0602-8aa7-3486-9a76-3fb18541258c",
                                "text": "супру́жеская изме́на",
                                "translation": "unfaithfulness, (conjugal) infidelity",
                                "english": "unfaithfulness, (conjugal) infidelity"
                            }
                        ]
                    }
