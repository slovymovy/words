                    {
                        "sense_id": "3f9e7473-75b1-3db9-ab3a-b88c26655a8b",
                        "entry_id": "878132d3-db41-3529-87b5-998a3ec2a728",
                        "glosses": [
                            "eine mittelalterliche Hafenstadt auf der ehemaligen Insel Strand im nordfriesischen Wattenmeer, die am 16. Januar 1362 in einer Sturmflut untergegangen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aab941c-b346-4f6d-840d-027178129872",
                                "sense_id": "3f9e7473-75b1-3db9-ab3a-b88c26655a8b",
                                "text": "Rungholt war der bedeutendste Handelsplatz Nordfrieslands und ging in der Sturmflut 1362 unter."
                            },
                            {
                                "example_id": "49af2586-1701-4767-a85a-599d11dc38f0",
                                "sense_id": "3f9e7473-75b1-3db9-ab3a-b88c26655a8b",
                                "text": "„Bei Ebbe wurden im Watt bei Rungholt Pflugfurchen und andere Siedlungsspuren sichtbar.“"
                            },
                            {
                                "example_id": "9a42e81b-79dd-4aed-b58f-136a6f5ad8bb",
                                "sense_id": "3f9e7473-75b1-3db9-ab3a-b88c26655a8b",
                                "text": "Der Reichtum Rungholts wurde nach seinem Untergang verklärt dargestellt."
                            }
