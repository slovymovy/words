                    {
                        "sense_id": "744cc1aa-a6fb-3f15-9457-b35399a84640",
                        "entry_id": "84225fa2-0d26-346e-a2c0-2a51d31f53ee",
                        "glosses": [
                            "iemand die van een dierenhuid leer maakt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "2cf40fb7-73d0-40d5-b42f-60e4b79c1247",
                                "sense_id": "744cc1aa-a6fb-3f15-9457-b35399a84640",
                                "text": "Honfleur met zijn smalle geplaveide straatjes en hoge oude huizen is in de zomer heel toeristisch. Het stadje is buitengewoon schilderachtig. Maar de impressionisten vonden er ook nog iets anders: het alledaagse leven van handwerklieden als vissers en leerlooiers."
                            },
                            {
                                "example_id": "4bb74229-f908-4eb6-a4a0-eed4f2c823d0",
                                "sense_id": "744cc1aa-a6fb-3f15-9457-b35399a84640",
                                "text": "Het Oude Ambachten & Speelgoed Museum stond eerst in Barneveld, maar groeide al snel uit zijn jasje en verhuisde in 1995 naar het plaatsje Terschuur, een kilometer verderop. „We zijn in de loop der jaren flink uitgebreid: van 40 kamertjes naar 160, waar onder meer een drogisterij, een schoolklasje, een leerlooier, een slagerij, een drukkerij te zien zijn.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "426af255-2a78-4b29-842f-eb003cecb140",
                        "source_entry_id": "84225fa2-0d26-346e-a2c0-2a51d31f53ee",
                        "source_sense_id": "744cc1aa-a6fb-3f15-9457-b35399a84640",
