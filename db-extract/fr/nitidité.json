                        "glosses": [
                            "Fait d’être brillant ou lumineux."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "54cf913b-fcf5-4aee-a982-6ee48cc7f02a",
                                "sense_id": "cd7f9245-a444-3394-a5cd-9f226ac3d621",
                                "text": "Un pus grisâtre et de mauvaise odeur s’échappe de l’endroit affecté ; l’ongle perd son éclat, sa nitidité ordinaire ; sa couleur s’altère."
                            },
                            {
                                "example_id": "f7f405c3-30b8-4cbd-9d1b-5f013b98cf0e",
                                "sense_id": "cd7f9245-a444-3394-a5cd-9f226ac3d621",
                                "text": "Ils en sont troublés, perdent leur nitidité et leur transparence, et en conséquence l’âme ne voit plus les objets que confusément, comme dans un miroir terni ou à travers d’une eau bourbeuse."
                            }
                        ]
