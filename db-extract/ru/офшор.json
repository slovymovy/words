                "senses": [
                    {
                        "sense_id": "e239f854-801b-3fae-991a-d84519906d16",
                        "entry_id": "0a788d9b-37e4-3600-8ca8-f31f4ef9b565",
                        "glosses": [
                            "неол., экон. страна или регион с низкими ставками налогов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46717686-060f-4483-99cf-66d4a605d845",
                                "sense_id": "e239f854-801b-3fae-991a-d84519906d16",
                                "text": "Большая часть доходов оседает в офшорах, где зарегистрированы наши крупные сырьевые компании."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2387db2-1f61-3867-a876-7ed24c3377d0",
                        "entry_id": "0a788d9b-37e4-3600-8ca8-f31f4ef9b565",
                        "glosses": [
                            "неол., экон. коммерческая компания, с целью уменьшения налогового бремени зарегистрированная в стране или регионе с низкими ставками налогов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3c38112-1cc4-445f-8fb8-68df32ade2cf",
                                "sense_id": "d2387db2-1f61-3867-a876-7ed24c3377d0",
                                "text": "Смысл в том, что предел ответственности офшоров ― несколько тысяч долларов."
                            }
                        ]
                    }
