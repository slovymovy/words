                "forms": [],
                "senses": [
                    {
                        "sense_id": "9b86b853-0cb6-32d7-9438-00884103f9ea",
                        "entry_id": "cddea75f-f857-3eff-8d01-a11b138306cf",
                        "glosses": [
                            "Not shown in full, but cut off at point it touches the edge of the shield, an ordinary, etc, as if retreating or withdrawn into that edge, ordinary, etc. (Compare issuant, naissant.)"
                        ],
                        "tags": [
                            "not-comparable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "31d0e376-2576-4060-a9fa-50e5e4379fd1",
                                "sense_id": "9b86b853-0cb6-32d7-9438-00884103f9ea",
                                "text": "KETHEL in Holland uses, Azure, a pale retrait in chief (i.e., a demi-pal) soutenu by a chevron between three cauldrons or."
                            },
                            {
                                "example_id": "3e643207-3660-48fe-94b6-10b0f952351d",
                                "sense_id": "9b86b853-0cb6-32d7-9438-00884103f9ea",
                                "text": "The blazon : Arms : Per Saltire Gules and Or in fess two pellets pierced and in pale many plates also pierced on a chief Argent issuant as in chief seven pallets retrait two three and two Sable."
                            },
                            {
                                "example_id": "ffb098de-88e3-4be0-816a-7b431e39a922",
                                "sense_id": "9b86b853-0cb6-32d7-9438-00884103f9ea",
                                "text": "The upper margin is bordered by a low quality frieze bearing the coat of arms of Pope Gregory XV (r. 1621-1623) : gules, three bendlets retrait per fess […]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
