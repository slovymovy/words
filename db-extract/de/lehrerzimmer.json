                "senses": [
                    {
                        "sense_id": "cf8ffc94-ecfa-3567-b081-4c6352ef8381",
                        "entry_id": "d804222e-486a-3b3d-ba47-3b120a1a7783",
                        "glosses": [
                            "Zimmer zumeist in einer Schule, das als Aufenthaltsraum für Lehrkräfte vorgesehen ist"
                        ],
                        "tags": [
                            "Schulwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "65fd2995-c4e0-41f0-85a9-c353c124d5f9",
                                "sense_id": "cf8ffc94-ecfa-3567-b081-4c6352ef8381",
                                "text": "Die Konferenz findet morgen Abend im Lehrerzimmer statt."
                            },
                            {
                                "example_id": "209a856a-70eb-4796-b200-e9e2b2638d0e",
                                "sense_id": "cf8ffc94-ecfa-3567-b081-4c6352ef8381",
                                "text": "Das Lehrerzimmer befindet sich links am Ende des Gangs."
                            },
                            {
                                "example_id": "41e88bc3-96bd-4ba3-aec1-14fc138a9814",
                                "sense_id": "cf8ffc94-ecfa-3567-b081-4c6352ef8381",
                                "text": "„Später sagte man mir, er habe im Lehrerzimmer auf mich gewartet, bis der Hausmeister das Schulgebäude abschließen wollte.“"
                            },
                            {
                                "example_id": "6b586d03-d1a3-461e-9ef0-925f21b9531e",
                                "sense_id": "cf8ffc94-ecfa-3567-b081-4c6352ef8381",
                                "text": "„Von seinem Küchenfenster aus kann Mollenhauer direkt in das Lehrerzimmer auf die dort versammelten Lehrerinnen blicken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
