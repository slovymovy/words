                "senses": [
                    {
                        "sense_id": "40c51e57-4605-3585-bfc1-5a84f9b619ba",
                        "entry_id": "58bdb7a0-9747-39e7-82c3-8580bb9e69d1",
                        "glosses": [
                            "The act of refurbishing"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "ee057775-0014-445e-8121-6bb22cb3b6fa",
                                "sense_id": "40c51e57-4605-3585-bfc1-5a84f9b619ba",
                                "text": "The refurb program is progressing on schedule"
                            },
                            {
                                "example_id": "8a9162e7-bf53-4db8-8bb2-505f2a67dca7",
                                "sense_id": "40c51e57-4605-3585-bfc1-5a84f9b619ba",
                                "text": "Whatever happens long-term, we are going to have phase III, the refurb, the modernisation of Bury-Altrincham, and all that does need to happen and happen soon."
                            },
                            {
                                "example_id": "a090494f-ac78-4500-a205-71f072beb0c2",
                                "sense_id": "40c51e57-4605-3585-bfc1-5a84f9b619ba",
                                "text": "A redent refurb means that there is now a larger play area for children, with a table and crayons to amuse them while you flex Daddy's Amex."
                            },
                            {
                                "example_id": "ef1c2afc-537b-4954-a96d-88f61c024c34",
                                "sense_id": "40c51e57-4605-3585-bfc1-5a84f9b619ba",
                                "text": "At the time of writing, Ambleside YHA was due to close for a refurb and planning to reopen in April 2009"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
