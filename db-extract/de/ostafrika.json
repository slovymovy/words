                "senses": [
                    {
                        "sense_id": "51d6b18c-1949-3116-9a01-62080ba30aef",
                        "entry_id": "6a357ced-805d-379d-ad7a-e546b167d2c6",
                        "glosses": [
                            "der östliche Teil des Kontinents Afrika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ea585da-6aa2-478f-83bc-620e3351cdda",
                                "sense_id": "51d6b18c-1949-3116-9a01-62080ba30aef",
                                "text": "„Reiseveranstalter beziehen sich bei Ostafrika aufgrund touristischen Interesses oft nur auf die Safari-Gebiete Kenia, Uganda und Tansania.“"
                            },
                            {
                                "example_id": "43aa1d69-24b5-4073-b5cc-0d19ca5c289d",
                                "sense_id": "51d6b18c-1949-3116-9a01-62080ba30aef",
                                "text": "„Er hatte viel von den Völkern Ostafrikas gelernt, doch so etwas zu unterscheiden, benötigte einige Erfahrung.“"
                            },
                            {
                                "example_id": "7c90aea6-ca8e-4bf8-b61c-f1fcb109367c",
                                "sense_id": "51d6b18c-1949-3116-9a01-62080ba30aef",
                                "text": "„In Ostafrika ist er der einzig halbwegs wirksame Schutz gegen die Tsetsefliege.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
