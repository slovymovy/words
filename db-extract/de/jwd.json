                        "examples": [
                            {
                                "example_id": "28ce3ad2-3e4d-4a54-9a68-51154396eefb",
                                "sense_id": "1357e3d0-9de1-308c-9be4-231cdfba58de",
                                "text": "Dit is ja jwd!",
                                "translation": "That's in the boonies!",
                                "english": "That's in the boonies!"
                            },
                            {
                                "example_id": "445f5097-0b4e-4dd2-83f9-a25bc999c0cd",
                                "sense_id": "1357e3d0-9de1-308c-9be4-231cdfba58de",
                                "text": "Locations wie die ehemalige Bärenquell-Brauerei, in der nun die Griessmühle residiert, die 20 Jahre lang leer stand und nur drauf zu warten schien, dass sich mal jemand um sie kümmert, gibt es in Friedrichshain oder Kreuzberg ja gar nicht mehr. Da bleibt dann nur noch der Weg nach jwd."
                            },
                            {
                                "example_id": "2b2fcc69-37c6-4890-9bff-7ca56393130b",
                                "sense_id": "1357e3d0-9de1-308c-9be4-231cdfba58de",
                                "text": "Ich lächle wegen Hintertupfingen. Bei uns zu Hause hieß solch ein fiktiver Ort früher immer „jwd“ für janz weit draußen oder auch „hinter Buxtehude“. Als ich viel später von der realen Existenz Buxtehudes erfuhr, fragte ich mich, wie die Buxtehuder es finden, wenn sie immer jwd verortet werden."
                            }
                        ]
                    }
