                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84575ba9-4801-3e8a-824a-3d5d337473b2",
                                        "entry_id": "a3cd9aaa-96e7-38b2-b649-aecbd6f7fa73",
                                        "glosses": [
                                            "An acrid taste or smell."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10337277-63d2-3051-b18c-b6c515dee1d3",
                                        "entry_id": "a3cd9aaa-96e7-38b2-b649-aecbd6f7fa73",
                                        "glosses": [
                                            "Bitterness in speech or behavior; causticness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "058d6885-557f-4c7d-84de-56d0ae7bac47",
                                                "sense_id": "10337277-63d2-3051-b18c-b6c515dee1d3",
                                                "text": "She was not safe from the acridity of his tongue but at least she need not fear physical violence, which was well within the possibilities for others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bca8197f-588d-4709-b9c3-c0849b02e376",
                        "source_entry_id": "7bcac96c-82fd-359b-876a-d4d029ad9043",
                        "source_sense_id": "9f00ff35-d5b7-37ea-b477-61e39f06885c",
                        "source_sense_description": "zuur of bitter smakend",
                        "target_lang_word": "acerbity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acerbity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc53eada-3da9-3dab-9758-1271c5578a09",
                                        "entry_id": "0dd8ab83-39c5-32f3-a9ca-36c6e0131d82",
                                        "glosses": [
                                            "Sourness of taste, with bitterness and astringency, like that of unripe fruit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b82cdad-6920-3684-81f6-754808c15bba",
                                        "entry_id": "0dd8ab83-39c5-32f3-a9ca-36c6e0131d82",
                                        "glosses": [
                                            "Harshness, bitterness, or severity"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f92e51c8-e32f-4df8-9733-9207d224593f",
                                                "sense_id": "2b82cdad-6920-3684-81f6-754808c15bba",
                                                "text": "acerbity of temper, of language, of pain"
                                            },
                                            {
                                                "example_id": "a53e5f6d-9f0a-40d9-b5c6-2678de8ba287",
                                                "sense_id": "2b82cdad-6920-3684-81f6-754808c15bba",
                                                "text": "“Well ?” I repeated with some acerbity. I had been wondering for the last ten minutes how many more knots he would manage to make in that same bit of string before he actually started undoing them again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd87b7cd-e103-3d9d-ada6-ff343322d494",
                                        "entry_id": "0dd8ab83-39c5-32f3-a9ca-36c6e0131d82",
                                        "glosses": [
                                            "Something harsh (e.g. a remark, act or experience)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b0d67dd-2320-4e22-b4ac-c27d88597ce9",
                                                "sense_id": "fd87b7cd-e103-3d9d-ada6-ff343322d494",
                                                "text": "[…] the recollection of that yesterday […] made him bear with the meekness and patience of a true-hearted man all the worrying little acerbities of to-day;"
                                            },
                                            {
                                                "example_id": "57c4facd-f6c2-4413-9f39-c712c701f6aa",
                                                "sense_id": "fd87b7cd-e103-3d9d-ada6-ff343322d494",
                                                "text": "This opera was mainly in the style of late Puccini, with acerbities stolen from Stravinsky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d6dac18-a451-41b5-a2ee-8509e2c93531",
                        "source_entry_id": "7bcac96c-82fd-359b-876a-d4d029ad9043",
                        "source_sense_id": "9f00ff35-d5b7-37ea-b477-61e39f06885c",
                        "source_sense_description": "zuur of bitter smakend",
                        "target_lang_word": "bitterness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bitterness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "262637ea-a4ca-36c6-842f-50e595fbaaa0",
                                        "entry_id": "5bed7d5c-8321-3898-abe5-529bf9142503",
                                        "glosses": [
                                            "The quality of having a bitter taste."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4348d8d-4f56-3c10-ae6a-1303665434e2",
                                        "entry_id": "5bed7d5c-8321-3898-abe5-529bf9142503",
                                        "glosses": [
                                            "The quality of feeling bitter; acrimony, resentment; the quality of exhibiting such feelings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a76c4eb6-fae0-49ce-99b3-7304010645df",
                                                "sense_id": "f4348d8d-4f56-3c10-ae6a-1303665434e2",
                                                "text": "the bitterness of his words"
                                            },
                                            {
                                                "example_id": "5d5fda39-9513-4dc5-be90-559c55f29a9d",
                                                "sense_id": "f4348d8d-4f56-3c10-ae6a-1303665434e2",
                                                "text": "She kept her bitterness about her mistreatment for the rest of her life."
                                            },
                                            {
                                                "example_id": "1028238e-3d98-47f8-b89e-cf24952a33a2",
                                                "sense_id": "f4348d8d-4f56-3c10-ae6a-1303665434e2",
                                                "text": "She suspected that during the summer her father had mentioned Brian’s windfall to Billy and that father and son had then traded snidenesses and bitternesses about the W—— Corporation and bourgeois Robin and leisure-class Brian."
                                            },
                                            {
                                                "example_id": "98ab27dc-0393-4fbc-832c-7fdfa9a6de0f",
                                                "sense_id": "f4348d8d-4f56-3c10-ae6a-1303665434e2",
                                                "text": "Speaking of the guest list, though, it is most disappointing to find some of the third tier European princelings unable to hide their bitterness at being NFI."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c220d33-943f-301f-b76b-2ab5603e53e0",
                                        "entry_id": "5bed7d5c-8321-3898-abe5-529bf9142503",
                                        "glosses": [
                                            "The quality of eliciting a bitter, humiliating or harsh feeling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "589138e1-db42-480a-b868-a8ab0cbb4222",
                                                "sense_id": "0c220d33-943f-301f-b76b-2ab5603e53e0",
                                                "text": "Nothing could assuage the bitterness of their defeat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c273bb5-b057-3d8a-ad8d-c74ec7dfeef7",
                                        "entry_id": "5bed7d5c-8321-3898-abe5-529bf9142503",
                                        "glosses": [
                                            "Harsh cold."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94851eed-625f-493b-bf77-384be2295c3e",
                                                "sense_id": "7c273bb5-b057-3d8a-ad8d-c74ec7dfeef7",
                                                "text": "The bitterness of the winter caught us all by surprise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
