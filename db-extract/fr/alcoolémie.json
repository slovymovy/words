                "senses": [
                    {
                        "sense_id": "a545e499-7016-3c49-8d1b-4fe642bfeab2",
                        "entry_id": "1cf27808-235a-30f3-909f-8f43906ad309",
                        "glosses": [
                            "Teneur d’alcool éthylique dans le sang."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4753e1aa-4e7f-4de1-b274-491822c8f010",
                                "sense_id": "a545e499-7016-3c49-8d1b-4fe642bfeab2",
                                "text": "L’alcoolémie atteint son maximum en 30 minutes si l’on est à jeun ou en 60 minutes si l’on a pris un repas."
                            },
                            {
                                "example_id": "5c2828a3-384f-40ca-8008-0f84eac34201",
                                "sense_id": "a545e499-7016-3c49-8d1b-4fe642bfeab2",
                                "text": "L'accident n'est que matériel, aucun blessé à déplorer. Lorsque les policiers ont contrôlé le taux d’alcoolémie du conducteur, il s'est avéré qu'il avait beaucoup trop bu."
                            },
                            {
                                "example_id": "11857e8a-4b19-49be-9328-055bfb899328",
                                "sense_id": "a545e499-7016-3c49-8d1b-4fe642bfeab2",
                                "text": "Une autre mesure de sécurité routière consiste en un dispositif anti-démarrage (EAD) relié à un éthylotest électronique qui bloque le moteur si le chauffeur qui a soufflé dans l’appareil présente un taux d’alcoolémie supérieur à la limité légale."
                            }
                        ]
                    }
                ],
