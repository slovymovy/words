                                        "entry_id": "c9273d16-1f9b-323f-a870-5a6e30352203",
                                        "glosses": [
                                            "in der Art eines Bischofs; wie ein Bischof oder einem Bischof gehörig"
                                        ],
                                        "tags": [],
