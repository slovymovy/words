                "senses": [
                    {
                        "sense_id": "9cd4ebba-13a4-3bf7-a381-2fd2b085643f",
                        "entry_id": "5a125734-f39f-3508-a9b2-5e7f24de4317",
                        "glosses": [
                            "(Ermittlung der) Darstellung einer positiven ganzen Zahl als Produkt (Multiplikation) möglichst kleiner positiver ganzer Zahlen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11457139-32c4-4b2f-b5a1-ed249e5ca1eb",
                                "sense_id": "9cd4ebba-13a4-3bf7-a381-2fd2b085643f",
                                "text": "Er berechnete das kleinste gemeinsame Vielfache mit Hilfe der Primfaktorzerlegung."
                            },
                            {
                                "example_id": "0bc396de-f613-4742-9bec-7c09e821b390",
                                "sense_id": "9cd4ebba-13a4-3bf7-a381-2fd2b085643f",
                                "text": "„Die Primfaktorzerlegung großer Zahlen ist ein seit langem sehr intensiv untersuchtes Problem.“"
                            },
                            {
                                "example_id": "046f2a8e-0249-4d06-a8eb-c0147ddc45f3",
                                "sense_id": "9cd4ebba-13a4-3bf7-a381-2fd2b085643f",
                                "text": "„Für die weitere Untersuchung der Eigenschaften natürlicher Zahlen war es wichtig, Methoden für diese Primfaktorzerlegung zu finden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
