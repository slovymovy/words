            {
                "entry_id": "25dcc7bc-9647-3bb1-bac9-d79d731ba36f",
                "word": "scribouillard",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "69943cde-4481-42c5-8164-230838599e03",
                        "entry_id": "25dcc7bc-9647-3bb1-bac9-d79d731ba36f",
                        "tags": [
                            "plural"
                        ],
                        "form": "scribouillards"
                    },
                    {
                        "form_id": "ee0cf3f7-04d1-42aa-b3ba-97ee692d6570",
                        "entry_id": "25dcc7bc-9647-3bb1-bac9-d79d731ba36f",
                        "tags": [
                            "feminine"
                        ],
                        "form": "scribouillarde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff7eb6cb-0a74-3205-8ed0-de250af149d8",
                        "entry_id": "25dcc7bc-9647-3bb1-bac9-d79d731ba36f",
                        "glosses": [
                            "Préposé aux écritures, notamment dans l’armée."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "49f2a649-a1de-42e8-9aaf-f99e50bae8fc",
                                "sense_id": "ff7eb6cb-0a74-3205-8ed0-de250af149d8",
                                "text": "Le scribouillard de service a enregistré ma déposition."
                            },
                            {
                                "example_id": "738601e4-912f-4e5f-b216-2190f7ca71f5",
                                "sense_id": "ff7eb6cb-0a74-3205-8ed0-de250af149d8",
                                "text": "Mais non, ma pauvre amie : Mathieu est scribouillard dans un vague état-major ; il est aussi tranquille qu’à l’arrière ; peut-être même plus que nous ne le sommes en ce moment."
                            }
                        ]
                    },
                    {
                        "sense_id": "81c0d053-5e88-30ab-bbf7-56d4a197957a",
                        "entry_id": "25dcc7bc-9647-3bb1-bac9-d79d731ba36f",
                        "glosses": [
                            "Employé de bureau."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d246ae96-914c-353d-856c-c08abd84a906",
                        "entry_id": "25dcc7bc-9647-3bb1-bac9-d79d731ba36f",
                        "glosses": [
                            "Mauvais journaliste."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c0a329ea-1924-4ec9-937e-a03c2ed3c415",
                                "sense_id": "d246ae96-914c-353d-856c-c08abd84a906",
                                "text": "Enfin, tout ce que peuvent dire des scribouillards qui nagent complètement et attendent une indication de la police pour présenter une thèse à peu près correcte."
                            }
                        ]
                    },
                    {
                        "sense_id": "79e6b84c-3526-3d2f-8bf6-48fd8722b121",
                        "entry_id": "25dcc7bc-9647-3bb1-bac9-d79d731ba36f",
                        "glosses": [
                            "Mauvais écrivain."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "fa86ae48-58f9-4c75-8545-d501d8898149",
                                "sense_id": "79e6b84c-3526-3d2f-8bf6-48fd8722b121",
                                "text": "Du charmant Poète qu'il eût pu être, par une œuvre restreinte, il est devenu un surabondant scribouillard, par 20 ou 30 volumes de verbiage rythmé."
                            },
                            {
                                "example_id": "8674f311-14cc-483a-ab4c-b3279c6d6897",
                                "sense_id": "79e6b84c-3526-3d2f-8bf6-48fd8722b121",
                                "text": "Un peu plus loin, je suis intercepté par Sid Lankabout, le scribouillard de l’ancien régime. Dieu que je le déteste. Pas plus de talent qu’une pantoufle n’a de talon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de77d4b4-2c53-4105-9b43-9a21506f0985",
                        "source_entry_id": "25dcc7bc-9647-3bb1-bac9-d79d731ba36f",
                        "target_lang_word": "escribidor",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escribidor",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e201fb65-f5f8-371e-9e3c-ce55bf927ef3",
                                        "entry_id": "b809fd8b-d3ed-3e22-ba3c-f49a7ca9c874",
                                        "glosses": [
                                            "Escritor de escaso o nulo talento."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb35b817-a555-466f-8384-d65138eb0248",
                                                "sense_id": "e201fb65-f5f8-371e-9e3c-ce55bf927ef3",
                                                "text": "Los visionarios influyentes, que oyen voces celestiales, defienden utopías nacidas algunos años antes en el cerebro de algún escribidor de facultad."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "519f8f14-f219-361c-a34c-8a528772fa23",
                                        "entry_id": "b809fd8b-d3ed-3e22-ba3c-f49a7ca9c874",
                                        "glosses": [
                                            "Escritor. Persona que antiguamente cuando el analfabetismo estaba muy extendido ponía a disposición de los demás su capacidad de escribir."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32b31191-a75b-4d6d-bf41-ed7f5c5efe96",
                                                "sense_id": "519f8f14-f219-361c-a34c-8a528772fa23",
                                                "text": "Aunque, se tranquilizó, había tiempo: por el momento no pensaba aplicarse al noble arte de darse muerte -como había leído que habían hecho muchos de los más insignes poetas de la historia-, sino al discreto, aunque meritorio, quehacer de escribidor de cartas."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62f02104-4621-4ae6-bfbd-602b0dc3c56b",
                        "source_entry_id": "25dcc7bc-9647-3bb1-bac9-d79d731ba36f",
                        "target_lang_word": "juntaletras",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "juntaletras",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "6f74704d-7eac-39e4-b6b4-bf0d29021e19",
                                        "entry_id": "744f41f0-73a6-3a79-9595-7caf69ea5357",
                                        "glosses": [
                                            "Escritor de poca importancia."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00cc215e-11e1-4a55-9eda-d326df004029",
                                                "sense_id": "6f74704d-7eac-39e4-b6b4-bf0d29021e19",
                                                "text": "En la Segunda Bis, también, controlábamos los movimientos de periodistas, poetas, dramaturgos, pintores, marchantes, catedráticos de Instituto o Universidad, juntaletras de medio pelo y filósofos de pacotilla."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
