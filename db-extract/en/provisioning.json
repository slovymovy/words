    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "33cb9852-954c-35d6-b3a6-81f96e0c4988",
                "word": "provisioning",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "52bdf2ba-b4b5-4e83-8fd4-22cb11e633e0",
                        "entry_id": "33cb9852-954c-35d6-b3a6-81f96e0c4988",
                        "tags": [
                            "plural"
                        ],
                        "form": "provisionings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "81f892eb-85fb-3843-8ed6-23249e443216",
                        "entry_id": "33cb9852-954c-35d6-b3a6-81f96e0c4988",
                        "glosses": [
                            "An act of supplying with provisions."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ba2f2a3e-fc5c-3393-a129-38aa1bc99757",
                        "entry_id": "33cb9852-954c-35d6-b3a6-81f96e0c4988",
                        "glosses": [
                            "The feeding of wild animals."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c394ea52-b899-4e2d-b6cf-0e8dbe2e4fe0",
                                "sense_id": "ba2f2a3e-fc5c-3393-a129-38aa1bc99757",
                                "text": "Feeding wildlife is a very popular tourist activity, largely because it facilitates the close observation of animals in their natural habitat. Such provisioning may benefit animals by improving their survival and reproductive success, especially during periods of natural food shortage. However, provisioning by tourists may also have negative impacts on the health of the animals involved; to date such impacts are poorly understood."
                            }
                        ]
                    },
                    {
                        "sense_id": "16f5bde6-db9e-396f-ab77-6608a3db5d5d",
                        "entry_id": "33cb9852-954c-35d6-b3a6-81f96e0c4988",
                        "glosses": [
                            "The installation of software on a system, especially when automated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcf6f0b9-d81f-423b-b827-5a04177742e0",
                                "sense_id": "16f5bde6-db9e-396f-ab77-6608a3db5d5d",
                                "text": "The problem of installing software on a booted system is known as provisioning, and is often the job of shell scripts, configuration management systems, or manual command-line entry."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5d6096e-5314-45f3-8d4d-0828e8662dbb",
                        "source_entry_id": "33cb9852-954c-35d6-b3a6-81f96e0c4988",
                        "source_sense_description": "act of supplying with provisions",
                        "target_lang_word": "approvisionnement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "approvisionnement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9710c8a7-e51b-3c5b-9618-2b6e2bd1a345",
                                        "entry_id": "dbd27bf4-e82a-379f-813c-4c966115e5e4",
                                        "glosses": [
                                            "Action d’approvisionner, de rassembler les choses nécessaires à la subsistance d’une ville, d’une armée, d’une flotte ; ou résultat de cette action."
                                        ],
                                        "tags": [
                                            "Logistique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdae5451-c9d7-43f6-a4d1-21d51d95fcb7",
                                                "sense_id": "9710c8a7-e51b-3c5b-9618-2b6e2bd1a345",
                                                "text": "Dans Plaisance, il alla tout droit chez sa mère. Elle vivait dans une boutique d’épicerie une vie sage et encombrée. Elle ne vendait guère que pour deux sous à cause des « magasins d’approvisionnement » qui prennent tout l’argent des quartiers. Elle restait à côté de son comptoir, servait et causait, avec l’allure familière et bavarde du petit commerce."
                                            },
                                            {
                                                "example_id": "b75d39e4-8148-4c68-86c6-600ad76c708b",
                                                "sense_id": "9710c8a7-e51b-3c5b-9618-2b6e2bd1a345",
                                                "text": "La variante sur le Hodna, baptisée Etincelle, visait à couper l’approvisionnement des katibas de Kabylie en provenance de Tunisie par le Hodna et les Aurès."
                                            },
                                            {
                                                "example_id": "7d6cf828-8b3e-47e3-a41e-2edc000de81c",
                                                "sense_id": "9710c8a7-e51b-3c5b-9618-2b6e2bd1a345",
                                                "text": "Si l'on prend comme exemple l'approvisionnement alimentaire, on entend par autosuffisance une complète indépendance à l'égard des importations pour répondre aux besoins alimentaires d'une collectivité ou d'une ville, un objectif difficilement atteignable même en vertu du scénario le plus optimiste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c78bbec-20ac-48e7-aee6-40a7f9f13940",
                        "source_entry_id": "33cb9852-954c-35d6-b3a6-81f96e0c4988",
                        "source_sense_description": "act of supplying with provisions",
                        "target_lang_word": "Bereitstellung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bereitstellung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35e173cf-fc30-37d5-858e-0676dfb451b6",
                                        "entry_id": "1aff6f5c-664c-31d0-a423-2d67e524f68b",
                                        "glosses": [
                                            "die Sorge oder Gewährleistung dafür, dass eine Sache vorhanden/verfügbar ist"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecc8b6c8-e8f2-4fa4-9997-7c6dd60c154d",
                                                "sense_id": "35e173cf-fc30-37d5-858e-0676dfb451b6",
                                                "text": "„Die Sicherung der Wasserversorgung, die Bereitstellung von Trinkwasser ist in Kibera in vielen Fällen ein mafiöses Geschäft.“"
                                            },
                                            {
                                                "example_id": "da008b2f-3996-4885-8737-58f763fe17d6",
                                                "sense_id": "35e173cf-fc30-37d5-858e-0676dfb451b6",
                                                "text": "Das flächendeckende Flugverbot brachte die Produktion zum Halten, da die Bereitstellung entscheidender Komponenten abriss."
                                            },
                                            {
                                                "example_id": "6a7ee26a-b782-44ee-b10f-7786b4f8ed64",
                                                "sense_id": "35e173cf-fc30-37d5-858e-0676dfb451b6",
                                                "text": "„Als Kardinal Anton Gruscha die Initiative ergriff, ordnete Franz Joseph I. am 18. April 1896 dem Kultusministerium die Bereitstellung der Geldmittel an; die Grundsteinlegung erfolgte am 10. Oktober 1896 in seiner Anwesenheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a70e18c1-4b9d-4657-8103-0d2075ceab22",
                        "source_entry_id": "33cb9852-954c-35d6-b3a6-81f96e0c4988",
                        "source_sense_description": "act of supplying with provisions",
                        "target_lang_word": "Beschaffung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beschaffung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c58e29a1-787f-3307-95b2-abadd6aaeb1c",
                                        "entry_id": "524bd57e-c8ea-3b20-b7f7-e83b5f9a8c1d",
                                        "glosses": [
                                            "Beschaffen oder Besorgen von materiellen oder ideellen Gütern"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cb12998-f8ba-4497-8c37-f77a641b210d",
                                                "sense_id": "c58e29a1-787f-3307-95b2-abadd6aaeb1c",
                                                "text": "Für die Beschaffung dieser Informationen ist der Datenschutzbeauftragte zuständig."
                                            },
                                            {
                                                "example_id": "be8bd045-b4e5-441d-b91c-cb4f83dc123b",
                                                "sense_id": "c58e29a1-787f-3307-95b2-abadd6aaeb1c",
                                                "text": "Die Beschaffung von Geldern ist noch das geringste Problem bei diesem Projekt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "649a7670-bdcf-3ac5-8a68-6a10d174f496",
                                        "entry_id": "524bd57e-c8ea-3b20-b7f7-e83b5f9a8c1d",
                                        "glosses": [
                                            "neben der Produktion und dem Absatz die dritte betriebliche Grundfunktion; Grundvorgang des Besorgens von Roh-, Hilfs- und Betriebsstoffen sowie von Dienstleistungen für die Produktion von Gütern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1f552f0-1055-4ad4-8083-4e5ecbf66fe8",
                                                "sense_id": "649a7670-bdcf-3ac5-8a68-6a10d174f496",
                                                "text": "In der Betriebswirtschaftslehre kennzeichnet Beschaffung eine der leistungswirtschaftlichen Grundfunktionen."
                                            },
                                            {
                                                "example_id": "a8f077c9-b2b1-48e3-b77c-472d73c1aa80",
                                                "sense_id": "649a7670-bdcf-3ac5-8a68-6a10d174f496",
                                                "text": "Bundesamt für Wehrtechnik und Beschaffung ( BWB )"
                                            },
                                            {
                                                "example_id": "dbb07300-9781-4aaa-8ea6-b4c1198152bc",
                                                "sense_id": "649a7670-bdcf-3ac5-8a68-6a10d174f496",
                                                "text": "Die Beschaffung ist das betriebswirtschaftliche Grenzsystem eines Unternehmens, das zwischen den externen Anforderungen der Lieferanten und den internen Anforderungen der Bedarfsträger vermittelt."
                                            },
                                            {
                                                "example_id": "d447b8dc-4d69-4340-8afe-70a782699c77",
                                                "sense_id": "649a7670-bdcf-3ac5-8a68-6a10d174f496",
                                                "text": "Ich habe mich auf die Personalwirtschaft spezialisiert: erst habe ich ein Praktikum in der Beschaffung gemacht und jetzt bin ich in der Weiterbildung und Personalentwicklung tätig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "66cd867e-15af-3eed-b3fc-7afc1a720219",
                                        "entry_id": "524bd57e-c8ea-3b20-b7f7-e83b5f9a8c1d",
                                        "glosses": [
                                            "im Sinne von Beschaffenheit"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ab1724b-f4af-4d88-8da8-134ad78a518a",
                                                "sense_id": "66cd867e-15af-3eed-b3fc-7afc1a720219",
                                                "text": "Die Beschaffung der Sache machte eine Trennung unmöglich."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08173783-fd5a-4a0f-a85c-030d740b5d7c",
                        "source_entry_id": "33cb9852-954c-35d6-b3a6-81f96e0c4988",
                        "source_sense_description": "act of supplying with provisions",
                        "target_lang_word": "Versorgung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Versorgung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4465bfb7-7f68-38ea-a805-02e3e3be6b05",
                                        "entry_id": "637b5771-b48b-3848-9e4a-44611e252938",
                                        "glosses": [
                                            "Bereitstellung von etwas Fehlendem oder dringend Gebrauchtem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc80d600-f93c-46d8-9d0f-5984a3ae65f9",
                                                "sense_id": "4465bfb7-7f68-38ea-a805-02e3e3be6b05",
                                                "text": "Die Versorgung mit Lebensmitteln war stark rationiert."
                                            },
                                            {
                                                "example_id": "7fc82bb6-1db7-4400-8d77-6c41f576c7b1",
                                                "sense_id": "4465bfb7-7f68-38ea-a805-02e3e3be6b05",
                                                "text": "„In den Bundeswehrkrankenhäusern und bei Bedarf auch in zivilen Kliniken wird die Behandlung mit der weitergehenden klinischen Versorgung und Rehabilitation abgeschlossen.“"
                                            },
                                            {
                                                "example_id": "298508f3-b3d5-4b78-99f2-1b5a9e60238c",
                                                "sense_id": "4465bfb7-7f68-38ea-a805-02e3e3be6b05",
                                                "text": "„Viele Zeitungen bemühten sich, den Hausfrauen praktische Tipps zu geben, wie sie der schlechten Versorgung zum Trotz schmackhaft und nahrhaft kochen konnten.“"
                                            },
                                            {
                                                "example_id": "ea029f5c-147b-4ff1-a24c-9153df10027c",
                                                "sense_id": "4465bfb7-7f68-38ea-a805-02e3e3be6b05",
                                                "text": "„Das Spiel mit der Doppeldeutigkeit von Wörtern funktionierte gerade im Themenbereich der wirtschaftlichen Versorgung gut.“"
                                            },
                                            {
                                                "example_id": "61ac3f81-1379-46d6-be52-4d4d9eccff0d",
                                                "sense_id": "4465bfb7-7f68-38ea-a805-02e3e3be6b05",
                                                "text": "„Ohne Flößerei wäre die Versorgung der Städte mit Bauholz gar nicht möglich gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
