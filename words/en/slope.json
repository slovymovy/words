{
    "word_family": [
        "sloping",
        "sloped",
        "slopingly",
        "aslope"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f573c260-30b1-3a91-9e49-fdc08df46db3",
                    "sense_definition": "An area of ground that tends evenly upward or downward.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inclination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had to climb a small <w>slope</w> to get to the site.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось подняться на небольшой <w>склон</w>, чтобы добраться до места."
                            }
                        },
                        {
                            "text": "The children enjoyed sledding down the steep <w>slope</w> behind their house.",
                            "target_lang_translations": {
                                "ru": "Детям нравилось кататься на санках с крутого <w>склона</w> за их домом."
                            }
                        }
                    ],
                    "synonyms": [
                        "bank",
                        "embankment",
                        "hill",
                        "incline"
                    ],
                    "antonyms": [
                        "flat",
                        "plain"
                    ],
                    "common_phrases": [
                        "steep slope",
                        "gentle slope",
                        "grassy slope",
                        "mountain slope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок земли, который равномерно поднимается или опускается."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склон",
                                "target_lang_sense_clarification": "наклонная поверхность горы или холма"
                            },
                            {
                                "target_lang_word": "скат",
                                "target_lang_sense_clarification": "ровная наклонная поверхность"
                            },
                            {
                                "target_lang_word": "откос",
                                "target_lang_sense_clarification": "наклонный бок насыпи или горы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac0e8c70-8dc0-316c-8993-5d8d0db7cadc",
                    "sense_definition": "The degree to which a surface tends upward or downward.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inclination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The road has a very sharp downward <w>slope</w> at that point.",
                            "target_lang_translations": {
                                "ru": "В этом месте у дороги очень резкий <w>уклон</w> вниз."
                            }
                        },
                        {
                            "text": "Engineers must calculate the <w>slope</w> of the land before starting the construction.",
                            "target_lang_translations": {
                                "ru": "Инженеры должны рассчитать <w>наклон</w> участка перед началом строительства."
                            }
                        }
                    ],
                    "synonyms": [
                        "gradient",
                        "grade",
                        "incline",
                        "cant",
                        "slant",
                        "pitch"
                    ],
                    "common_phrases": [
                        "downward slope",
                        "upward slope",
                        "degree of slope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Степень отклонения поверхности от горизонтали."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уклон",
                                "target_lang_sense_clarification": "показатель крутизны поверхности"
                            },
                            {
                                "target_lang_word": "наклон",
                                "target_lang_sense_clarification": "положение под углом к горизонту"
                            },
                            {
                                "target_lang_word": "градиент",
                                "target_lang_sense_clarification": "величина изменения высоты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f0e8189-8d15-3387-868c-24b7885cbbfc",
                    "sense_definition": "The ratio of the vertical and horizontal distances between two points lying on a line.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>slope</w> of this line is 0.5 in the coordinate system.",
                            "target_lang_translations": {
                                "ru": "<w>Угловой коэффициент</w> этой прямой в системе координат равен 0,5."
                            }
                        },
                        {
                            "text": "To find the <w>slope</w>, you must divide the rise by the run.",
                            "target_lang_translations": {
                                "ru": "Чтобы найти <w>наклон</w>, нужно разделить подъем на прогон."
                            }
                        }
                    ],
                    "synonyms": [
                        "gradient"
                    ],
                    "common_phrases": [
                        "calculate the slope",
                        "positive slope",
                        "negative slope"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отношение вертикального расстояния к горизонтальному между двумя точками на прямой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угловой коэффициент",
                                "target_lang_sense_clarification": "математический параметр прямой"
                            },
                            {
                                "target_lang_word": "наклон",
                                "target_lang_sense_clarification": "в контексте графиков функций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e425983-9892-30f7-8330-133f9a062a7f",
                    "sense_definition": "The slope of the line tangent to a curve at a given point.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>slope</w> of a parabola increases linearly with x.",
                            "target_lang_translations": {
                                "ru": "<w>Крутизна</w> параболы увеличивается линейно в зависимости от x."
                            }
                        },
                        {
                            "text": "At that point, the <w>slope</w> of the curve changes from positive to negative.",
                            "target_lang_translations": {
                                "ru": "В этой точке <w>наклон</w> кривой меняется с положительного на отрицательный."
                            }
                        }
                    ],
                    "synonyms": [
                        "first derivative",
                        "gradient"
                    ],
                    "common_phrases": [
                        "tangent slope"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наклон касательной к кривой в данной точке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "производная",
                                "target_lang_sense_clarification": "значение тангенса угла касательной"
                            },
                            {
                                "target_lang_word": "крутизна",
                                "target_lang_sense_clarification": "технический термин для графиков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "580df1df-0225-3386-8c3f-29e540c4a4e6",
                    "sense_definition": "The angle a roof surface makes with the horizontal, expressed as a ratio of vertical rise to horizontal length.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>slope</w> of an asphalt shingle roof system should be 4:12 or greater.",
                            "target_lang_translations": {
                                "ru": "<w>Уклон</w> кровельной системы из битумной черепицы должен составлять 4:12 или более."
                            }
                        },
                        {
                            "text": "A roof with a high <w>slope</w> is necessary in areas with heavy snowfall.",
                            "target_lang_translations": {
                                "ru": "Крыша с большим <w>скатом</w> необходима в районах с сильными снегопадами."
                            }
                        }
                    ],
                    "synonyms": [
                        "grade",
                        "incline"
                    ],
                    "common_phrases": [
                        "roof slope"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Угол, который поверхность крыши образует с горизонталью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скат",
                                "target_lang_sense_clarification": "наклонная плоскость крыши"
                            },
                            {
                                "target_lang_word": "уклон кровли",
                                "target_lang_sense_clarification": "строительный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53ae0a96-0e71-30ee-b023-36b84f5cbaf1",
                    "sense_definition": "A person of Chinese or other East Asian descent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The use of the word <w>slope</w> in this context is highly offensive and derogatory.",
                            "target_lang_translations": {
                                "ru": "Использование слова <w>узкоглазый</w> в этом контексте крайне оскорбительно и унизительно."
                            }
                        },
                        {
                            "text": "He was criticized for using a racial slur like <w>slope</w> during the argument.",
                            "target_lang_translations": {
                                "ru": "Его критиковали за использование такого расового оскорбления, как <w>косоглазый</w>, во время спора."
                            }
                        }
                    ],
                    "synonyms": [
                        "Chinaman",
                        "Chink"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "offensive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оскорбительное прозвище для выходцев из Восточной Азии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "узкоглазый",
                                "target_lang_sense_clarification": "крайне грубое расистское ругательство"
                            },
                            {
                                "target_lang_word": "косоглазый",
                                "target_lang_sense_clarification": "оскорбительный сленг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0e975ec2-f147-36ce-9f66-390d4fd25bed",
                    "sense_definition": "To tend steadily upward or downward.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inclination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The road <w>slopes</w> sharply down at that point.",
                            "target_lang_translations": {
                                "ru": "В этом месте дорога резко <w>идет под уклон</w>."
                            }
                        },
                        {
                            "text": "The lush vegetation of the Undercliff was <w>sloping</w> down to the sea on the right.",
                            "target_lang_translations": {
                                "ru": "Пышная растительность Андерклиффа справа <w>спускалась</w> к морю."
                            }
                        }
                    ],
                    "synonyms": [
                        "incline",
                        "slant"
                    ],
                    "common_phrases": [
                        "slope down",
                        "slope upward",
                        "slope away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь постоянное направление вверх или вниз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идти под уклон",
                                "target_lang_sense_clarification": "о дороге или местности"
                            },
                            {
                                "target_lang_word": "снижаться",
                                "target_lang_sense_clarification": "постепенно опускаться"
                            },
                            {
                                "target_lang_word": "наклоняться",
                                "target_lang_sense_clarification": "располагаться под углом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "234f158c-43dc-3ca2-bf3f-399a941f2c02",
                    "sense_definition": "To form with a slope; to give an oblique or slanting direction to.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "inclination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener decided to <w>slope</w> the ground to improve water drainage.",
                            "target_lang_translations": {
                                "ru": "Садовник решил <w>сделать уклон</w> почвы, чтобы улучшить отвод воды."
                            }
                        },
                        {
                            "text": "You need to <w>slope</w> the fabric slightly when cutting the shoulder of the garment.",
                            "target_lang_translations": {
                                "ru": "При раскрое плеча изделия нужно слегка <w>скосить</w> ткань."
                            }
                        }
                    ],
                    "synonyms": [
                        "incline",
                        "cant"
                    ],
                    "common_phrases": [
                        "slope the ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать поверхности наклонную форму."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скашивать",
                                "target_lang_sense_clarification": "делать косым или наклонным"
                            },
                            {
                                "target_lang_word": "делать пологим",
                                "target_lang_sense_clarification": "изменять угол поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7098cdd9-b9fc-34b2-ad91-10da1619c99a",
                    "sense_definition": "To try to move surreptitiously or sneak away.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>sloped</w> in through the back door, hoping my boss wouldn't see me.",
                            "target_lang_translations": {
                                "ru": "Я <w>улизнул</w> через заднюю дверь, надеясь, что босс меня не увидит."
                            }
                        },
                        {
                            "text": "She watched him disappear before <w>sloping</w> back to her room quietly.",
                            "target_lang_translations": {
                                "ru": "Она смотрела, как он исчезает, прежде чем тихо <w>вернуться</w> в свою комнату."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slope off",
                        "slope back"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пытаться незаметно уйти или ускользнуть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улизнуть",
                                "target_lang_sense_clarification": "незаметно уйти"
                            },
                            {
                                "target_lang_word": "смыться",
                                "target_lang_sense_clarification": "разговорное: быстро уйти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36b4f20a-0b66-321f-ad14-ec19cd1cfbab",
                    "sense_definition": "To hold a rifle at a slope resting on the shoulder.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sergeant gave the order to <w>slope</w> arms before the march began.",
                            "target_lang_translations": {
                                "ru": "Сержант отдал команду «на <w>плечо</w>» перед началом марша."
                            }
                        },
                        {
                            "text": "The soldiers were trained to <w>slope</w> their rifles uniformly during the parade.",
                            "target_lang_translations": {
                                "ru": "Солдат учили единообразно <w>держать</w> винтовки на плече во время парада."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slope arms"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "military"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Держать винтовку на плече под наклоном."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "держать на плечо",
                                "target_lang_sense_clarification": "военная команда"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "88e30f72-1a44-320b-9cab-ff0699965ae1",
                    "sense_definition": "Sloping; inclined.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inclination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river bank was not steep, but gently <w>slope</w>.",
                            "target_lang_translations": {
                                "ru": "Берег реки был не крутым, а <w>пологим</w>."
                            }
                        },
                        {
                            "text": "They walked down the <w>slope</w> hills as the sun began to set.",
                            "target_lang_translations": {
                                "ru": "Они спускались по <w>наклонным</w> холмам, когда солнце начало садиться."
                            }
                        }
                    ],
                    "synonyms": [],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an adjective today"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наклонный; имеющий уклон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покатый",
                                "target_lang_sense_clarification": "имеющий пологий наклон"
                            },
                            {
                                "target_lang_word": "наклонный",
                                "target_lang_sense_clarification": "расположенный под углом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e8330a02-b5ad-3ad0-922b-c860f35743ab",
                    "sense_definition": "In a sloping manner; <w>slopingly</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inclination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beam bore him <w>slope</w> downward toward the horizon.",
                            "target_lang_translations": {
                                "ru": "Луч нес его <w>наклонно</w> вниз к горизонту."
                            }
                        },
                        {
                            "text": "The light fell <w>slope</w> across the floor in the late afternoon.",
                            "target_lang_translations": {
                                "ru": "В предвечерний час свет падал на пол <w>наискось</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В наклонном положении; наискосок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклонно",
                                "target_lang_sense_clarification": "под углом"
                            },
                            {
                                "target_lang_word": "наискось",
                                "target_lang_sense_clarification": "по диагонали"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}