                                                "example_id": "16a0de52-1d4d-42bf-9a4a-4a8ad487cea4",
                                                "sense_id": "d533172d-ab46-39f9-a036-08a4d4385483",
                                                "text": "„Hausdörfer lachte nervös. Ach, du Schätzchen, ich bin doch nicht bloß so’n Fachsimpel?“"
                                            },
                                            {
                                                "example_id": "a83dd781-3231-43f3-9c00-1ccf98dc705a",
                                                "sense_id": "d533172d-ab46-39f9-a036-08a4d4385483",
                                                "text": "Klar, in der Stunde vor Bekanntgabe der Prüfungsergebnisse ist jeder nervös!"
                                            },
                                            {
                                                "example_id": "e3b9fcaa-d146-4d49-b264-d5687a0d30b3",
                                                "sense_id": "d533172d-ab46-39f9-a036-08a4d4385483",
                                                "text": "Sie hat schon so eine nervöse Ader, die einen verrückt machen kann."
                                            },
                                            {
                                                "example_id": "09f9ce25-798e-44ec-99c2-010e85edc6a2",
                                                "sense_id": "d533172d-ab46-39f9-a036-08a4d4385483",
                                                "text": "Beruhige dich, sei doch nicht so nervös."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9ba38d8a-a9e0-3288-a673-9eb9d470bde1",
                                        "entry_id": "081fd549-7798-3159-b1e2-03fcce36556f",
                                        "glosses": [
                                            "durch Nerven ausgelöst, nervlich"
                                        ],
                                        "tags": [
                                            "eine körperliche Verfassung beschreibend"
                                        ],
                                        "examples": [
