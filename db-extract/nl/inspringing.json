                                    {
                                        "sense_id": "ee3b6616-56d9-3a30-b209-9e7201804d11",
                                        "entry_id": "1c3b0e65-497d-3c3b-9045-4b53f8d2bdc3",
                                        "glosses": [
                                            "An obstacle, delay, disadvantage, or blow (an adverse event which slows down, or prevents progress towards a desired outcome)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c1320dd-505f-4766-8c7c-e74505066fde",
                                                "sense_id": "ee3b6616-56d9-3a30-b209-9e7201804d11",
                                                "text": "After some initial setbacks, the expedition went safely on its way."
                                            },
                                            {
                                                "example_id": "cbca7d98-84dc-4441-8426-595d032b902c",
                                                "sense_id": "ee3b6616-56d9-3a30-b209-9e7201804d11",
                                                "text": "DUKAT: I blame no one but myself. I was indiscreet. I compromised myself and have been punished accordingly. If someone under my command had behaved so outrageously, I would do the same thing to him. Besides, I assure you, this is only a temporary setback. Everything I have lost, I will regain. It's only a matter of time."
                                            },
                                            {
                                                "example_id": "5d1613d7-6d1f-42a3-8e5d-3e58c5d1ba1c",
                                                "sense_id": "ee3b6616-56d9-3a30-b209-9e7201804d11",
                                                "text": "The Constitutional Court has ruled today, November 17th, that Section 1448 of the Thai Civil and Commercial, stating that “a marriage can take place only between a man and a woman”, is constitutional under the Thai constitutional law. This decision could be a major setback for many Thai LGBTQ activist groups’ continued journey of what they call basic human rights to legally allow same-sex marriages in Thailand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8286dc9f-aaea-339f-979d-d151f6e45a06",
                                        "entry_id": "1c3b0e65-497d-3c3b-9045-4b53f8d2bdc3",
                                        "glosses": [
                                            "Any adverse event, defeat, or impediment of progress."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b873526f-4c6f-37ad-94f8-6da9df810b3f",
                                        "entry_id": "1c3b0e65-497d-3c3b-9045-4b53f8d2bdc3",
                                        "glosses": [
                                            "The required distance between a structure and a road."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23b78388-e8de-3b4f-b18a-e69ff4021c95",
                                        "entry_id": "1c3b0e65-497d-3c3b-9045-4b53f8d2bdc3",
                                        "glosses": [
                                            "A step-like recession in a wall."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec1b5262-b0a6-43c5-9a65-9e016f80db1f",
                                                "sense_id": "23b78388-e8de-3b4f-b18a-e69ff4021c95",
                                                "text": "Setbacks were initially used for structural reasons, but now are often mandated by land use codes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d9fbbe6-3624-31f1-b0fd-9df5e38de1b4",
                                        "entry_id": "1c3b0e65-497d-3c3b-9045-4b53f8d2bdc3",
                                        "glosses": [
                                            "An offset to the temperature setting of a thermostat to cover a period when more or less heating is required than usual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c11b7d21-2a33-43db-a6e7-c9a0242dbf64",
                                                "sense_id": "6d9fbbe6-3624-31f1-b0fd-9df5e38de1b4",
                                                "text": "Fuel savings from thermostat setbacks have long been accepted as fact, but little documentation existed to support it."
                                            }
                                        ]
                                    },
