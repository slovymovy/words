                                                "example_id": "a24427f0-a456-4453-927d-ef7fc6cf2087",
                                                "sense_id": "9590df9c-81e7-3c51-ab56-42d9c8889a53",
                                                "text": "„Die am häufigsten angewendete giftfreie Bekämpfungsmethode ist der Fang von Hausmäusen mit Fallen.“"
                                            },
                                            {
                                                "example_id": "0dc87045-7da1-4fc9-a14c-07ff4fed9807",
                                                "sense_id": "9590df9c-81e7-3c51-ab56-42d9c8889a53",
                                                "text": "„Junge Hausmäuse kommen nach nur 20 Tagen Tragzeit als Nesthocker zur Welt; schon nach 2–3 Monaten sind sie geschlechtsreif und danach das ganze Jahr über fortpflanzungsfähig.“"
                                            }
