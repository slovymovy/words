                "senses": [
                    {
                        "sense_id": "4783bfa7-c455-3e19-849e-a712b531b587",
                        "entry_id": "50647e85-424a-3cd4-868a-973986f6acb2",
                        "glosses": [
                            "Faire subir des dommages corporels."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "19ab4ded-12b3-414a-a3f3-26b7503b75c8",
                                "sense_id": "4783bfa7-c455-3e19-849e-a712b531b587",
                                "text": "Le mec qui me fait face n’est pas un bad boy inconséquent, un mec qui se fout de tout et fonce tête baissée. Pas pour Zukaï Motors, pas pour Jack – qui préférait fermer les yeux quand son poulain se ruait sur les pistes alors qu’il venait de se tauler."
                            },
                            {
                                "example_id": "8e807363-791d-4bff-86ce-aaeb20870f84",
                                "sense_id": "4783bfa7-c455-3e19-849e-a712b531b587",
                                "text": "Voilà pourquoi Yann regardait son XV se faire tauler du banc des remplaçants."
                            }
                        ]
                    }
                ],
