    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fdbbfde7-c7e0-3a6d-b0b4-7436c8e0c63d",
                "word": "coterminous",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "85491552-57e0-33b1-b3f1-6ef1fdbc40ea",
                        "entry_id": "fdbbfde7-c7e0-3a6d-b0b4-7436c8e0c63d",
                        "glosses": [
                            "Meeting end to end or at the ends."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1a96455d-e730-39e2-8415-9fffb2909c03",
                        "entry_id": "fdbbfde7-c7e0-3a6d-b0b4-7436c8e0c63d",
                        "glosses": [
                            "Having matching boundaries; or, adjoining and sharing a boundary."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8372e4b1-c965-4908-b131-e6ad8ccbfdad",
                                "sense_id": "1a96455d-e730-39e2-8415-9fffb2909c03",
                                "text": "New York's borough of Brooklyn and Kings County are coterminous."
                            },
                            {
                                "example_id": "da59b536-8994-4d73-af4e-972d7fc3341c",
                                "sense_id": "1a96455d-e730-39e2-8415-9fffb2909c03",
                                "text": "To get a building warrant he had to show the plans to \"coterminous proprietors\", neighbours with whom his property shared a boundary."
                            },
                            {
                                "example_id": "5b1079fb-3577-4191-8baa-bb4e048072e0",
                                "sense_id": "1a96455d-e730-39e2-8415-9fffb2909c03",
                                "text": "It has been the close vicinity of slave-owners to each other, the fact that their lands have been coterminous, that theirs was especially a cotton district, which has tempted them to secession."
                            },
                            {
                                "example_id": "4b24579b-73c9-4b0e-85f3-44c57204de26",
                                "sense_id": "1a96455d-e730-39e2-8415-9fffb2909c03",
                                "text": "These eighty-two parishes were roughly coterminous with the existing seigneuries, but not always so."
                            }
                        ]
                    },
                    {
                        "sense_id": "781040cb-83ba-3fe4-b11b-106171791c29",
                        "entry_id": "fdbbfde7-c7e0-3a6d-b0b4-7436c8e0c63d",
                        "glosses": [
                            "Having the same scope, range of meaning, or extent in time."
                        ],
                        "tags": [
                            "broadly",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b88f0988-1813-4940-a83e-cd91f2d04679",
                                "sense_id": "781040cb-83ba-3fe4-b11b-106171791c29",
                                "text": "But it is purely fantastic unless we bear in mind that the governing class has been continually compelled to enlarge itself, and that its tendency is reluctantly to go on doing so until in the end it will be coterminous with the \"governed class.\""
                            },
                            {
                                "example_id": "29f00f8d-0280-45a0-b1da-e0da1386a3d5",
                                "sense_id": "781040cb-83ba-3fe4-b11b-106171791c29",
                                "text": "From this it follows at once that language and thought are not strictly coterminous."
                            },
                            {
                                "example_id": "55596559-d1c0-4516-b664-6f22e3071bda",
                                "sense_id": "781040cb-83ba-3fe4-b11b-106171791c29",
                                "text": "The elision of moral and moralising arguments is common, but the two aren't coterminous."
                            }
                        ]
                    },
                    {
                        "sense_id": "68e841b9-c6de-3947-b153-eac23be350e4",
                        "entry_id": "fdbbfde7-c7e0-3a6d-b0b4-7436c8e0c63d",
                        "glosses": [
                            "Said of linked or related property leases that expire together."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
