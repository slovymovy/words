                    {
                        "sense_id": "7389f081-5c15-3d4a-937c-6a5078688d78",
                        "entry_id": "df0844af-50d6-3bc6-a022-3c463ecfb16a",
                        "glosses": [
                            "The regular throbbing of the heart, an artery etc. in a living body; the pulse."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b33f9445-4d12-47d0-b469-e4f88266e1ce",
                                "sense_id": "7389f081-5c15-3d4a-937c-6a5078688d78",
                                "text": "Pulsation had ceased. For three days the body was preserved unburied, during which it had acquired a stony rigidity."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c4f23ae-a307-3e67-b939-da6afdf93a06",
                        "entry_id": "df0844af-50d6-3bc6-a022-3c463ecfb16a",
                        "glosses": [
                            "Any rhythmic beating, throbbing etc."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c0ed2c79-12c3-41ca-95cc-6d34a9ee610e",
                                "sense_id": "1c4f23ae-a307-3e67-b939-da6afdf93a06",
                                "text": "Lo! as a dove when up she springs\n⁠To bear thro’ Heaven a tale of woe,\n⁠Some dolorous message knit below\nThe wild pulsation of her wings;\nLike her I go; I cannot stay;\n⁠I leave this mortal ark behind […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "8648d0e6-acbd-3fdb-8f10-9baab90eb6b5",
                        "entry_id": "df0844af-50d6-3bc6-a022-3c463ecfb16a",
                        "glosses": [
                            "The rhythmic increase and decrease of size in naked zoospores and plasmodia."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c2091119-9961-31e1-b7b5-cc6b84e31646",
                        "entry_id": "df0844af-50d6-3bc6-a022-3c463ecfb16a",
                        "glosses": [
                            "Physical striking; a blow."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cd9bb4b9-81c9-4c0d-ab00-08b496e40c33",
                                "sense_id": "c2091119-9961-31e1-b7b5-cc6b84e31646",
                                "text": "By the Cornelian law, pulsation as well as verberation is prohibited."
                            }
                        ]
                    },
