                ],
                "senses": [
                    {
                        "sense_id": "0eb3241a-74d0-30f9-9d7f-71015ea28c17",
                        "entry_id": "a2bff3f2-6cc4-302c-a2c0-c3ee847f4d70",
                        "glosses": [
                            "Spielform, die von älteren Personen bevorzugt wird und meist höhere Ansprüche stellt oder für Minderjährige verboten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19b4df2d-cccf-4437-a4ca-bc35a4165823",
                                "sense_id": "0eb3241a-74d0-30f9-9d7f-71015ea28c17",
                                "text": "„Auch erlauben die Funde nicht immer eine exakte Trennung zwischen Kinder- und Erwachsenenspiel.“"
                            },
                            {
                                "example_id": "48ea736f-1967-4b6e-bec8-adcc4321351b",
                                "sense_id": "0eb3241a-74d0-30f9-9d7f-71015ea28c17",
                                "text": "„Die charakteristischen Erwachsenenspiele stellen sich im wesentlichen als Kulturprodukte dar, die sich –häufig mit hohen Ansprüchen an die technischen Fertigkeiten – auf speziell präparierten Anlagen betreiben lassen.“"
                            },
                            {
                                "example_id": "2b0bd71e-77f2-408e-95f4-fca6c7c5755f",
                                "sense_id": "0eb3241a-74d0-30f9-9d7f-71015ea28c17",
                                "text": "„Und deshalb ist das Erwachsenenspiel ein Stiefkind, das nur selten über eine erste Auflage hinauswächst.“"
                            },
                            {
                                "example_id": "f2f0aa24-4aac-4ffc-8fde-40515d6c3969",
                                "sense_id": "0eb3241a-74d0-30f9-9d7f-71015ea28c17",
                                "text": "„Das ist eigentlich ein Kinderspiel, das aber von der Jury für das ‚Spiel des Jahres’ in der Rubrik Erwachsenenspiele nominiert wurde.“"
                            },
                            {
                                "example_id": "b5616a4b-c6e7-450c-8704-e26c864607f9",
                                "sense_id": "0eb3241a-74d0-30f9-9d7f-71015ea28c17",
                                "text": "„Erwachsenenspiele, heimlich, schamvoll, resigniert; Manipulationen, Missachtungen kindlicher Intimsphären – all das, weil die zuständigen Erwachsenen die geraden Wege zu ihren eigenen Bedürfnissen verlernt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
