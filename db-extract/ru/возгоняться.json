                "translations": [
                    {
                        "translation_id": "2d03c847-e447-4509-9484-c9e549fcb0e0",
                        "source_entry_id": "cf61afe3-3118-3260-8f73-cdae52a918de",
                        "target_lang_word": "sublimate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sublimate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06400f86-45b4-3ec4-be2c-e7e9db179458",
                                        "entry_id": "5d4c88dd-80fd-3769-802e-d3221f1a7c04",
                                        "glosses": [
                                            "To heat (a substance) in a container so as to convert it into a gas which then condenses in solid form on cooler parts of the container.",
                                            "To change (a solid substance) into a gas without breaking down or passing through the liquid state by heating it gently."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75ee614b-ce41-3300-9ddb-94989d12392f",
                                        "entry_id": "5d4c88dd-80fd-3769-802e-d3221f1a7c04",
                                        "glosses": [
                                            "To heat (a substance) in a container so as to convert it into a gas which then condenses in solid form on cooler parts of the container.",
                                            "To change (a substance) from a gas into a solid through sublimation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f82fc32c-c987-3f0d-9ebd-fe6f35e44007",
                                        "entry_id": "5d4c88dd-80fd-3769-802e-d3221f1a7c04",
                                        "glosses": [
                                            "To refine (something) until it disappears or loses all meaning."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07239ed7-a6ba-3d99-9513-e8505669923e",
                                        "entry_id": "5d4c88dd-80fd-3769-802e-d3221f1a7c04",
                                        "glosses": [
                                            "To modify (the natural expression of a sexual or primitive instinct) in a socially acceptable manner; to divert the energy of (such an instinct) into some acceptable activity."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "440a139b-e4cf-400b-96d1-e309b9ac7658",
                                                "sense_id": "07239ed7-a6ba-3d99-9513-e8505669923e",
                                                "text": "Foreigners extol the American \"energy\" […] Basically it is the energy of violence, of free-floating resentment and anxiety unleashed by chronic cultural dislocations which must be, for the most part, ferociously sublimated. This energy has mainly been sublimated into crude materialism and acquisitiveness."
                                            },
                                            {
                                                "example_id": "a0f234af-c23f-4ea5-9589-b04127e5b005",
                                                "sense_id": "07239ed7-a6ba-3d99-9513-e8505669923e",
                                                "text": "When he got home from the parade, however, Professor Solanka was seized by melancholy, his usual secret sadness, which he sublimated into the public sphere. Something was amiss with the world. The optimistic peace-and-love philosophy of his youth having given him up, he no longer knew how to reconcile himself to an increasingly phoney […] reality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02f3fbb6-d4be-322a-954a-29f90f944ea5",
                                        "entry_id": "5d4c88dd-80fd-3769-802e-d3221f1a7c04",
                                        "glosses": [
                                            "To obtain (something) through, or as if through, sublimation."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25b8e421-ff8a-3fdf-8890-84233b575ef4",
                                        "entry_id": "5d4c88dd-80fd-3769-802e-d3221f1a7c04",
                                        "glosses": [
                                            "To purify or refine (a substance)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2aa429c-cc71-4e92-b6fe-2443af786686",
                                                "sense_id": "25b8e421-ff8a-3fdf-8890-84233b575ef4",
                                                "text": "The precepts of Christianity are […] so apt […] to cleanse and sublimate the more gross and corrupt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf183a19-4610-3254-a1de-45af87d997bb",
                                        "entry_id": "5d4c88dd-80fd-3769-802e-d3221f1a7c04",
                                        "glosses": [
                                            "Synonym of sublime.",
                                            "To raise (someone) to a high office or status; to dignify, to elevate, to exalt."
                                        ],
                                        "tags": [
                                            "also",
                                            "broadly",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
