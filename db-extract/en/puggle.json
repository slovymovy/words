                ],
                "senses": [
                    {
                        "sense_id": "d39148da-6076-3f2b-9d82-23fefae8b831",
                        "entry_id": "44c5ac92-149e-3aac-9cfa-b6265d39f4e9",
                        "glosses": [
                            "A small mixed breed of dog created by mating a pug and beagle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1c7897e-c11f-4fc3-8856-47b6036acd9a",
                                "sense_id": "d39148da-6076-3f2b-9d82-23fefae8b831",
                                "text": "2007 May, Vicki Constantine Croke, The Problem With Puggles, Prevention, page 208,\nJake Gyllenhaal and Sylvester Stallone are among the puggle lovers, but so are a slew of regular people who want in on the tawny, fawny, puppy-faced action and will pay hundreds or thousands of dollars for the pleasure."
                            },
                            {
                                "example_id": "25cc66d7-2112-4cd0-9b5c-6e49bbff9809",
                                "sense_id": "d39148da-6076-3f2b-9d82-23fefae8b831",
                                "text": "Puggle proponents say these dogs have the very best qualities of both Beagles and Pugs: the Beagle′s cheerful friendliness, and the Pug′s lower activity level and laid-back attitude."
                            },
                            {
                                "example_id": "ae483cc8-7979-4427-8e09-ece13b69bf96",
                                "sense_id": "d39148da-6076-3f2b-9d82-23fefae8b831",
                                "text": "2009, Milwaukee Magazine, Volume 34, Issues 1-6, page 67,\nThe menagerie for sale at this auction included two black puggles with hernias, a French bulldog with one ear, a 3-month old Yorkshire terrier with only one testicle and a badly bow-legged bulldog."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
