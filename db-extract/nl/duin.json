                        ],
                        "examples": [
                            {
                                "example_id": "b116efda-854c-4c6e-a333-7e360faa2764",
                                "sense_id": "3e29fc55-5a04-399a-bb58-8935aaa0978e",
                                "text": "Jullie moeten de duinen ontzien, want ze zijn de beste zeewering die we hebben."
                            }
                        ]
                    },
                    {
                        "sense_id": "35ce6012-33d9-38d8-b55e-d86b6c7acbf9",
                        "entry_id": "4c4b09c1-1ca6-39a5-ac04-2b255220a729",
                        "glosses": [
                            "; het stelsel van zandheuvels aan de kust"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "4b3630ec-2d24-417e-9b2b-add1eea80766",
                                "sense_id": "35ce6012-33d9-38d8-b55e-d86b6c7acbf9",
                                "text": "Hij ging graag voor een wandeling het duin in."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e31619f-7e8e-49fd-b856-67bff28d5592",
                        "source_entry_id": "4c4b09c1-1ca6-39a5-ac04-2b255220a729",
                        "target_lang_word": "沙丘",
