                },
                {
                    "sense_id": "880f5a62-d142-35a6-a9ee-c741a9fa56a0",
                    "sense_definition": "Im religiösen Glauben der Aufenthaltsort Gottes und der Seligen nach dem Tod",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "jenseits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Manche Menschen glauben fest daran, dass die Seelen nach dem Tod in den <w>Himmel</w> kommen."
                        },
                        {
                            "text": "Für die Gläubigen ist der <w>Himmel</w> ein Ort des ewigen Friedens."
                        }
                    ],
                    "synonyms": [
