                    {
                        "sense_id": "93dc97cc-eb76-3bb0-b6f2-94872040c4b0",
                        "entry_id": "4f047583-3597-3d11-9ca1-c206e269cbc8",
                        "glosses": [
                            "Polymer mit Esterfunktionen –[–CO–O–]– in seiner Hauptkette"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf7ad490-1808-46bf-a33f-94e6267b24d5",
                                "sense_id": "93dc97cc-eb76-3bb0-b6f2-94872040c4b0",
                                "text": "„Wer sich gegen die Sonne schützen möchte, sollte etwas Passendes anziehen. Am besten ist dunkle Kleidung aus Polyester.“"
                            },
                            {
                                "example_id": "e3e3ca4c-fb89-4f15-8a15-4f784e12963d",
                                "sense_id": "93dc97cc-eb76-3bb0-b6f2-94872040c4b0",
                                "text": "„Viele Hannoveraner waren überfordert mit den überdimensionierten, farbenfrohen Frauenkörpern aus Polyester.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
