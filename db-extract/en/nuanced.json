                                                "sense_id": "47074b38-3608-391c-9e53-95744b7f5414",
                                                "text": "Les élégantes composaient les rosés de leur teint à l'aide d'un vermillon habilement nuancé; …."
                                            },
                                            {
                                                "example_id": "87c31895-f287-4612-83d8-d0f9141db446",
                                                "sense_id": "47074b38-3608-391c-9e53-95744b7f5414",
                                                "text": "[…] mais vous avez la peau si nuancée autour de la ceinture, et si fine entre les seins que je peux vous donner raison au moins pendant cinq minutes."
                                            }
                                        ]
                                    }
