                ],
                "senses": [
                    {
                        "sense_id": "82200bdb-757a-3d85-aeca-7cabd3bed3a0",
                        "entry_id": "ff17e497-a2bf-3efe-af0c-e596a2a289fd",
                        "glosses": [
                            "Teil eines Bereiches, der am Übergang zu einem anderen Bereich liegt"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "40dd1956-dc90-4fe6-aeb5-8bd1096a57dc",
                                "sense_id": "82200bdb-757a-3d85-aeca-7cabd3bed3a0",
                                "text": "„Im Randbereich der Meere fielen schließlich die Salze aufgrund der hohen Konzentrationen aus.“"
                            },
                            {
                                "example_id": "82fd1c84-6c17-4ad6-888c-1d333d2e6f0e",
                                "sense_id": "82200bdb-757a-3d85-aeca-7cabd3bed3a0",
                                "text": "„So werden Chrom-, Titan- und Nickelerze bereits bei sehr hohen Temperaturen noch im Innern des Magmenherdes abgeschieden, Zinn und Wolfram dagegen erst bei kühleren Temperaturen in dessen Randbereich.“"
                            },
                            {
                                "example_id": "94ffa539-e778-4556-9e61-75a517979c9d",
                                "sense_id": "82200bdb-757a-3d85-aeca-7cabd3bed3a0",
                                "text": "„Der Arzt entfernt dabei Hautstreifen im Randbereich des Gesichts, um Falten oder schlaffe Haut beispielsweise unter den Augen, am Kinn oder am Mund zu spannen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "30f458ab-2082-3583-9423-508d67be639f",
                        "entry_id": "ff17e497-a2bf-3efe-af0c-e596a2a289fd",
                        "glosses": [
                            "Bereich, der weniger wichtig ist"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "d9699e07-9ead-45f2-b57a-c19688734e8b",
                                "sense_id": "30f458ab-2082-3583-9423-508d67be639f",
                                "text": "„Da für die Philosophie in der Regel der unbeschädigte Logos (womit sinnvolle Sprache und Vernunft gemeint sind) das den Menschen auszeichnende Merkmal darstellt, wird der Behinderte in einen Randbereich verwiesen – außerhalb des Spektrums von Normalität.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
