                ],
                "translations": [
                    {
                        "translation_id": "d837b86e-bcc2-4f1c-a87a-e4e4a2522333",
                        "source_entry_id": "41d79cf3-c86b-34b8-b4a1-29ea64703d9f",
                        "source_sense_id": "d76fc592-2d49-3902-a219-70baa4375447",
                        "target_lang_word": "Tankstelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tankstelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1696dec6-3fc3-3c05-b90f-31becbf926fa",
                                        "entry_id": "8180fe04-71af-3a8d-86c4-c1497fd1db3d",
                                        "glosses": [
                                            "Station zum Betanken von Fahrzeugen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa8f0689-c857-47a8-a3c9-0b2bcef72fd2",
                                                "sense_id": "1696dec6-3fc3-3c05-b90f-31becbf926fa",
                                                "text": "Auf deutschen Autobahnen befindet sich etwa alle 50 Kilometer eine Tankstelle."
                                            },
                                            {
                                                "example_id": "aba2bc9a-4439-4ce0-ac00-eb88b03a20db",
                                                "sense_id": "1696dec6-3fc3-3c05-b90f-31becbf926fa",
                                                "text": "Fahr zur nächsten Tankstelle, der Tank ist fast leer."
                                            },
                                            {
                                                "example_id": "a05ffd7f-bbf1-40ec-8a53-b808de56f289",
                                                "sense_id": "1696dec6-3fc3-3c05-b90f-31becbf926fa",
                                                "text": "„An der nächsten Tankstelle lässt sie sich von uns absetzen und tritt den Rückweg an.“"
                                            },
                                            {
                                                "example_id": "1282438d-704a-4d34-84b5-19d95ce12680",
                                                "sense_id": "1696dec6-3fc3-3c05-b90f-31becbf926fa",
                                                "text": "„Kein Zweifel, Anrath hat ihre Tankstelle im Telefonbuch nachgeschlagen und ihre Nummer gewählt.“"
                                            },
                                            {
                                                "example_id": "ec70b497-7549-4462-864b-cfd9428f6f08",
                                                "sense_id": "1696dec6-3fc3-3c05-b90f-31becbf926fa",
                                                "text": "„Nach wenigen Metern erreichte ich die noch im Bau befindliche Auffahrt der Tankstelle.“"
                                            },
                                            {
                                                "example_id": "857fab05-21ad-44f3-ab09-1536e5e10a04",
                                                "sense_id": "1696dec6-3fc3-3c05-b90f-31becbf926fa",
                                                "text": "„Außer Schokokeksen hatte die Tankstelle dem hungrigen Reisenden nicht viel zu bieten, dafür aber einen Geldwechsel-Service.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
