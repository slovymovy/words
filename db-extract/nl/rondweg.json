            {
                "entry_id": "58e925c5-deaa-343c-8e26-659b0c442d2e",
                "word": "rondweg",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dd15f00c-a73c-390e-947f-8e0f9d626141",
                        "entry_id": "58e925c5-deaa-343c-8e26-659b0c442d2e",
                        "glosses": [
                            "verharde route die verkeer rond een plaats leidt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9a07b3a-b053-4172-82c3-59579f607618",
                                "sense_id": "dd15f00c-a73c-390e-947f-8e0f9d626141",
                                "text": "Een deel van de N367, de oostelijke rondweg om Winschoten, is dinsdagochtend rond 07.00 uur weer opengesteld na een urenlange afsluiting wegens een brand. In de nacht lagen brandslangen over de weg die werden gebruikt bij de bestrijding van een brand op het industrieterrein aan de Kartonbaan, waar bij recyclingbedrijf Virol een berg met schroot in lichterlaaie stond."
                            },
                            {
                                "example_id": "e622d53a-895b-47b9-b834-bf56563f31bf",
                                "sense_id": "dd15f00c-a73c-390e-947f-8e0f9d626141",
                                "text": "De blikvanger komt pal langs de nieuwe rondweg Badhoevedorp. Corendon heeft het voormalig hoofdkantoor van Sony gekocht en verbouwt het nu tot viersterren hotel, zo schrijft het Leidsch Dagblad."
                            },
                            {
                                "example_id": "0da90f63-b0f9-4e13-a19b-e1db90ba9f5f",
                                "sense_id": "dd15f00c-a73c-390e-947f-8e0f9d626141",
                                "text": "Er was al een donkerbruin vermoeden in Bornerbroek, maar nu weten ze het zeker: de tracékeuze voor de rondweg om Zenderen is vooraf bekokstoofd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c1903af-3771-497b-8f65-c4fafb65d794",
                        "source_entry_id": "58e925c5-deaa-343c-8e26-659b0c442d2e",
                        "source_sense_id": "dd15f00c-a73c-390e-947f-8e0f9d626141",
                        "source_sense_description": "verharde route die verkeer rond een plaats leidt",
                        "target_lang_word": "by-pass highway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "87f6abf7-74e8-4915-be23-9522f511413c",
                        "source_entry_id": "58e925c5-deaa-343c-8e26-659b0c442d2e",
                        "source_sense_id": "dd15f00c-a73c-390e-947f-8e0f9d626141",
                        "source_sense_description": "verharde route die verkeer rond een plaats leidt",
                        "target_lang_word": "by-pass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "by-pass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7a32a99-ca85-393d-af2b-984edbca9917",
                                        "entry_id": "b2bd8e80-1494-30d9-9654-17132e79c82e",
                                        "glosses": [
                                            "Alternative form of bypass."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a32589a9-d9fb-4dd3-9f17-f5a1883f2bcb",
                                                "sense_id": "c7a32a99-ca85-393d-af2b-984edbca9917",
                                                "text": "the Colnbrook By-Pass on the A4"
                                            },
                                            {
                                                "example_id": "55ddbe6b-4c53-4b5b-a835-5117ea2934b5",
                                                "sense_id": "c7a32a99-ca85-393d-af2b-984edbca9917",
                                                "text": "The railway was in fact shifted in 1937 a little to the west, over a distance of a quarter-mile, to make room for the by-pass at this point, but complete abandonment was firmly vetoed because of the proved strategic value of the line."
                                            },
                                            {
                                                "example_id": "1fee4ccd-15de-4973-b6e5-3ad7552b2d34",
                                                "sense_id": "c7a32a99-ca85-393d-af2b-984edbca9917",
                                                "text": "In The Bus We Loved (2005) Travis Elborough describes the New Road [now named Euston Road and Marylebone Road] as 'London's first by-pass ... a kind of perimeter fence, a here be yokels boundary line between the burgeoning town and the country'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e4fbd4e-7310-41e2-b913-6beeac845e09",
                        "source_entry_id": "58e925c5-deaa-343c-8e26-659b0c442d2e",
                        "source_sense_id": "dd15f00c-a73c-390e-947f-8e0f9d626141",
                        "source_sense_description": "verharde route die verkeer rond een plaats leidt",
                        "target_lang_word": "ring road",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ring road",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c69be3db-ee7b-3be2-9b7c-1727bcc7f3a8",
                                        "entry_id": "8db0a9ed-1b38-3b51-acbe-51344457018e",
                                        "glosses": [
                                            "A circumferential highway around a town, city, or other conurbation."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0ad72e1-dde4-44b7-9014-cdb7eeb3dcab",
                                                "sense_id": "c69be3db-ee7b-3be2-9b7c-1727bcc7f3a8",
                                                "text": "Underground stations were also slated for closure, and there were plans for massive ring roads to cater for the ever-growing numbers of people commuting into town by car. […] However, it soon dawned on politicians that this was unsustainable. Much of London would have had to be demolished to make way for the ring roads, and parking was becoming an insuperable difficulty."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c1027f3-c25c-4771-836d-39395d5579bf",
