                                "target_senses": [
                                    {
                                        "sense_id": "235410b6-81ba-3ed9-872c-50822c403bbd",
                                        "entry_id": "31abf51b-bcd6-3ab5-86f6-22be5d889c43",
                                        "glosses": [
                                            "Petit fricandeau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ce6772e-2d08-436e-b10d-a1373e17fc37",
                                                "sense_id": "235410b6-81ba-3ed9-872c-50822c403bbd",
                                                "text": "Un plat de grenadins de veau au jus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d03f1fd5-c0e2-3065-9e2d-61e2e5e283a5",
                                        "entry_id": "31abf51b-bcd6-3ab5-86f6-22be5d889c43",
                                        "glosses": [
                                            "Variété de l’œillet commun (Dianthus caryophyllus) aux fleurs parfumées rouges rose ou blanches, que l’on utilise pour la confiserie et en parfumerie, également employée autrefois lors des célébrations pour aromatiser bières ou vins, connue aussi sous le nom d’œillet ratafia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b0a4d61-2380-48a4-ad3a-95db859f1318",
                                                "sense_id": "d03f1fd5-c0e2-3065-9e2d-61e2e5e283a5",
                                                "text": "Cette espèce présente de nombreuses variétés; la seule qui nous intéresse ici est l'œillet grenadin ou à ratafia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60fbd4eb-4361-363e-acb7-8c0423c7df0a",
                                        "entry_id": "31abf51b-bcd6-3ab5-86f6-22be5d889c43",
                                        "glosses": [
                                            "Nom donné à des passereaux africains, du genre Uraeginthus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "767bc22a-099f-414f-abd2-d3b347d30e7a",
                                                "sense_id": "60fbd4eb-4361-363e-acb7-8c0423c7df0a",
                                                "text": "Ensuite, il sera bon de placer dans la volière un couple de cordons-bleus à qui l’on pourra confier les œufs si le grenadin refuse de les couver."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grenadin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a0add34-0ac0-3976-8eee-d11abbcb7a47",
                                        "entry_id": "aee2d960-b07d-3a80-8855-d3122c0ea7e2",
                                        "glosses": [
                                            "Relatif à Grenade, ville espagnole, à ses habitants ou à leur culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caed0109-3368-47c9-a34b-1b0803fdb951",
                                                "sense_id": "6a0add34-0ac0-3976-8eee-d11abbcb7a47",
                                                "text": "[…] nous avions une lettre de recommandation d’un de nos amis grenadins pour son père, riche marchand de vin à Jérès, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93ce04b6-7893-3e80-bf3f-79725b527367",
                                        "entry_id": "aee2d960-b07d-3a80-8855-d3122c0ea7e2",
                                        "glosses": [
                                            "Relatif à la Grenade, pays des Antilles"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d8e904e-4d63-4bc4-9b44-2835708b2f90",
                                                "sense_id": "93ce04b6-7893-3e80-bf3f-79725b527367",
                                                "text": "Aujourd’hui, Kirani James concentre sur lui tous les espoirs grenadins de médailles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd8c9926-c28b-3a71-9067-d28a004d237c",
                                        "entry_id": "aee2d960-b07d-3a80-8855-d3122c0ea7e2",
                                        "glosses": [
                                            "Relatif au Royaume de Grenade"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b320387-d0b7-4c63-87a1-9f363809e33c",
                                                "sense_id": "bd8c9926-c28b-3a71-9067-d28a004d237c",
                                                "text": "Le célèbre polygraphe grenadin, Lisān al-dīn Ibn al-K_h_aṭib, qui fut mêlé de très près à la vie politique du royaume naṣride dans la seconde partie du XIVᵉ siècle, ne nous a livré ni dans sa Lamḥa ni dans son Iḥāṭa aucun élément d’information sur les rapports qui purent exister entre les deux souverains naṣrides dont il fut le vizir et les Sultans du Caire."
                                            },
                                            {
                                                "example_id": "8154b5d3-affe-4b97-8fd1-31f32f3bb5cd",
                                                "sense_id": "bd8c9926-c28b-3a71-9067-d28a004d237c",
                                                "text": "Dans ce village, pendant que nous savourions un dîner à base de poisson et d’oignon, j’écoutai l’histoire d’Abdou Ishaq es-Sahéli, l’architecte grenadin que l’empereur mandingue avait appelé à sa cour pour bâtir mosquées et palais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
