                        "entry_id": "d0614a26-3e85-313a-9918-8322cac9f1f6",
                        "glosses": [
                            "een halve toon verhoogde toon \\\"a\\"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c6cd70a-1ace-439c-9737-003825d956b8",
                                "sense_id": "4ad0bee3-28ee-33bc-adc9-de1fe1adaba0",
                                "text": "De toon “aïs” klinkt in de getempereerde stemming gelijk aan de toon “bes”."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff5124fe-3097-36cd-921d-ce8ff666b9ac",
                        "entry_id": "d0614a26-3e85-313a-9918-8322cac9f1f6",
                        "glosses": [
                            "de grondtoon (tonica) van de “aïs-mineurtoonladder”, tevens een korte aanduiding van die toonladder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4ff5779-a135-4f21-99d9-0c6eb4d9522d",
                                "sense_id": "ff5124fe-3097-36cd-921d-ce8ff666b9ac",
                                "text": "Op de notenbalk van een fluitsonate in aïs, staan zeven kruisen als voortekens."
                            }
                        ]
                    },
                    {
                        "sense_id": "11545e52-9e92-329e-9dc4-f05eb12d3008",
                        "entry_id": "d0614a26-3e85-313a-9918-8322cac9f1f6",
                        "glosses": [
                            "de grondtoon van het “aïs-mineurakkoord”, de kleine drieklank op de eerste trap (tonica-akkoord) van de kleinetertstoonladder op die toon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57d67311-430b-4866-b5ca-d342d11998a1",
                                "sense_id": "11545e52-9e92-329e-9dc4-f05eb12d3008",
                                "text": "De drie tonen van het aïs-mineurakkoord (symbool: A#m) in grondligging, zijn: aïs - cis - eis."
                            }
                        ]
                    }
                ],
