                "senses": [
                    {
                        "sense_id": "936b36d0-1b9a-3c29-8375-812a5845400a",
                        "entry_id": "871a1c33-d793-39f7-9ecc-643cb1250d46",
                        "glosses": [
                            "степенный, важный, соблюдающий определённый порядок"
                        ],
                        "tags": [
                            "о человеке, поведении"
                        ],
                        "examples": [
                            {
                                "example_id": "b649c677-4137-4bb9-9007-c7d3367036d8",
                                "sense_id": "936b36d0-1b9a-3c29-8375-812a5845400a",
                                "text": "И, шествуя важно, в спокойствии чинном, // Лошадку ведёт под уздцы мужичок…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1e62362-97b1-456a-8496-a217de07d01f",
                        "source_entry_id": "871a1c33-d793-39f7-9ecc-643cb1250d46",
                        "source_sense_id": "936b36d0-1b9a-3c29-8375-812a5845400a",
                        "target_lang_word": "anständig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anständig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81e7135b-3fbd-3b9b-ac05-cd355c26d0ef",
                                        "entry_id": "a7d3b367-c354-3ec0-9007-19582205d18f",
                                        "glosses": [
                                            "im Einklang mit der (eher prüden) Sexualmoral"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56aae0ca-6951-435b-a801-8a2acbcbb4cf",
                                                "sense_id": "81e7135b-3fbd-3b9b-ac05-cd355c26d0ef",
                                                "text": "Zieh dir was Anständiges an!"
                                            },
                                            {
                                                "example_id": "bb266f17-826e-47de-9055-3034edeac7d3",
                                                "sense_id": "81e7135b-3fbd-3b9b-ac05-cd355c26d0ef",
                                                "text": "Eine anständige Frau tut so etwas nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "292f01d2-648f-3c81-846e-2c72b2c6fb94",
                                        "entry_id": "a7d3b367-c354-3ec0-9007-19582205d18f",
                                        "glosses": [
                                            "den Benimmregeln entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c9f1c13-9c8f-4fcc-99ab-e363ac5f8ac2",
                                                "sense_id": "292f01d2-648f-3c81-846e-2c72b2c6fb94",
                                                "text": "Benimm dich ja anständig!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bd1491dd-3f8f-37ea-9b14-b9fcf8858f13",
                                        "entry_id": "a7d3b367-c354-3ec0-9007-19582205d18f",
                                        "glosses": [
                                            "moralisch integer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d72e710f-dd90-4300-a865-e4de2ffcc64d",
                                                "sense_id": "bd1491dd-3f8f-37ea-9b14-b9fcf8858f13",
                                                "text": "Trotz allem ist er ein anständiger Kerl geblieben."
                                            },
                                            {
                                                "example_id": "a920066e-3e2c-4788-a3c4-722587998419",
                                                "sense_id": "bd1491dd-3f8f-37ea-9b14-b9fcf8858f13",
                                                "text": "Das war aber anständig von ihm!"
                                            },
                                            {
                                                "example_id": "7f34af93-1675-4938-b89a-52f345fd3a54",
                                                "sense_id": "bd1491dd-3f8f-37ea-9b14-b9fcf8858f13",
                                                "text": "„Seine Gläubiger waren so anständig gewesen, ihn im Besitz eines kleinen Restes seines väterlichen Vermögens zu lassen, dessen Zinsen bei äußerster Sparsamkeit zu einem sehr bescheidenen Leben hinreichten, ihm jedoch auch nicht den kleinsten Luxus gestatteten.“"
                                            },
                                            {
                                                "example_id": "64ef0018-d115-4f8d-adc1-803071391fa8",
                                                "sense_id": "bd1491dd-3f8f-37ea-9b14-b9fcf8858f13",
                                                "text": "Hier gibt es anständige Portionen zu anständigen Preisen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "64d08cbf-e2ad-3a5c-80c1-6d7e87ac01ad",
                                        "entry_id": "a7d3b367-c354-3ec0-9007-19582205d18f",
                                        "glosses": [
                                            "vollwertig, gut"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92322c18-37e0-4c72-8526-39f50fec7b3d",
                                                "sense_id": "64d08cbf-e2ad-3a5c-80c1-6d7e87ac01ad",
                                                "text": "Du brauchst mal wieder was Anständiges in den Magen!"
                                            },
                                            {
                                                "example_id": "fdc42ea3-6e4c-43ee-8d82-81e0a2545ab8",
                                                "sense_id": "64d08cbf-e2ad-3a5c-80c1-6d7e87ac01ad",
                                                "text": "Wollt ihr mal einen anständigen unanständigen Witz hören?"
                                            },
                                            {
                                                "example_id": "ff5616b9-3fab-4715-95c5-9d3d22f92c72",
                                                "sense_id": "64d08cbf-e2ad-3a5c-80c1-6d7e87ac01ad",
                                                "text": "Hier gibt es anständige Portionen zu anständigen Preisen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
