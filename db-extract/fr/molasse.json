                                        "entry_id": "65630a51-1092-354b-8590-e2361135bf21",
                                        "glosses": [
                                            "A shallow deposit of sandstone, shale and conglomerate in front of a rising mountain chain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1423299c-433a-4e30-9582-9102f67e8125",
                                                "sense_id": "ec81d247-cfdc-3476-b026-f5c5dec49553",
                                                "text": "The molasse provides a record of the wearing down of the Alpine range at a late stage; unlike the Flysch, it is largely non-marine."
                                            }
                                        ]
                                    }
                                ]
