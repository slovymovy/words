                        "examples": [
                            {
                                "example_id": "bcb65d26-9deb-474b-b89e-8ecec5be99ea",
                                "sense_id": "48b99921-db0a-3b5f-a448-ee2dbafd4df7",
                                "text": "Malchus de Carthage, (VIᵉ siècle av. J.-C.), général carthaginois."
                            },
                            {
                                "example_id": "4967ed22-a022-47b6-8a8d-ebb8640d46e0",
                                "sense_id": "48b99921-db0a-3b5f-a448-ee2dbafd4df7",
                                "text": "Malchus, serviteur de Caïphe dont Pierre l’apôtre coupa l’oreille au Jardin des Oliviers."
                            },
                            {
                                "example_id": "30d8f5ae-e8eb-40a0-a4cd-f9e12f2bebb6",
                                "sense_id": "48b99921-db0a-3b5f-a448-ee2dbafd4df7",
                                "text": "Malchus de Maronie, dit le moine captif (IVᵉ siècle), saint syrien dont la vie a été racontée par Jérôme de Stridon."
                            },
                            {
                                "example_id": "8b951e71-804c-4853-8c45-3c2f35a19b60",
                                "sense_id": "48b99921-db0a-3b5f-a448-ee2dbafd4df7",
                                "text": "Malchus de Philadelphie, historien grec du Vᵉ siècle."
                            },
                            {
                                "example_id": "567fd0c8-c25a-44f8-9653-491849da66bb",
                                "sense_id": "48b99921-db0a-3b5f-a448-ee2dbafd4df7",
                                "text": "Malchus de Lismore, évêque-abbé de Lismore, saint de l’Église catholique romaine."
                            },
                            {
                                "example_id": "7bcd001c-a467-4b9a-ba44-1e2ca3624dfe",
                                "sense_id": "48b99921-db0a-3b5f-a448-ee2dbafd4df7",
                                "text": "Malchus de Césarée, († 260), avec Prisque et Alexandre, martyrs de Césarée de Palestine."
                            }
                        ]
                    }
