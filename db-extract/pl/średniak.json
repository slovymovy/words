                "translations": [
                    {
                        "translation_id": "e42ef29a-1ed9-409b-8d18-f66d4fd8632d",
                        "source_entry_id": "72375840-88ef-3ca2-89e2-21d5e4c683b1",
                        "source_sense_id": "324b32dd-6cc9-3788-9275-93a39fd7b023",
                        "target_lang_word": "Kindergartenkind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kindergartenkind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                                        "entry_id": "d7276746-22d6-3c58-bedc-4f7444ea6ca5",
                                        "glosses": [
                                            "Kind, das einen Kindergarten besucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "799b6b7f-97b9-4e1c-966f-e35a9b932f14",
                                                "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                                                "text": "Die Kindergartenkinder stehen vor dem Affengehege und beobachten das Gorillamännchen."
                                            },
                                            {
                                                "example_id": "1b67cce1-3da9-43de-959d-54aee88dff27",
                                                "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                                                "text": "Ein Kindergartenkind spielt im Sand, ein anderes schaukelt."
                                            },
                                            {
                                                "example_id": "f9850a83-c610-4a56-b37a-b0fb705e4970",
                                                "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                                                "text": "„Ich habe mich schon als Kindergartenkind auf die Schule gefreut.“"
                                            },
                                            {
                                                "example_id": "bf7249fd-8b56-4ae2-a979-c88cbd8285f7",
                                                "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                                                "text": "„Kindergartenkinder lernten schneller, die waren in sechs Monaten fertig.“"
                                            },
                                            {
                                                "example_id": "26f4c2a1-3c3d-4c72-a85e-e4187985dc31",
                                                "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                                                "text": "„Auch die Untersuchung von Shields (1976) befaßt sich mit konversationellen Fähigkeiten, vor allem mit der Entwicklung des Dialogs bei drei- bis fünfjährigen Kindergartenkindern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56b91ca0-6d82-4b9b-843d-c7c4fe4939e8",
                        "source_entry_id": "72375840-88ef-3ca2-89e2-21d5e4c683b1",
                        "source_sense_id": "324b32dd-6cc9-3788-9275-93a39fd7b023",
                        "target_lang_word": "von",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "von",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db1ab0d4-56a3-3f11-aaf7-0a24ee19ae59",
                                        "entry_id": "fdefa5c5-462d-37a4-ba3e-75b9cb691923",
                                        "glosses": [
                                            "Ursprung räumlicher oder zeitlicher Veränderung, Herkunft, Gegenstand der Betrachtung, Ursache, sonstige Verhältnisse"
                                        ],
                                        "tags": [
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32a46da5-d363-4e56-a13f-dbe554403709",
                                                "sense_id": "db1ab0d4-56a3-3f11-aaf7-0a24ee19ae59",
                                                "text": "Der Zug fährt vom (von dem) Gleis 1."
                                            },
                                            {
                                                "example_id": "596dcc80-c841-449a-94a3-929b5f0ded47",
                                                "sense_id": "db1ab0d4-56a3-3f11-aaf7-0a24ee19ae59",
                                                "text": "Die Woche geht von Montag bis Sonntag."
                                            },
                                            {
                                                "example_id": "bc83b6ce-970a-4e67-a5c9-a0c5973f2de8",
                                                "sense_id": "db1ab0d4-56a3-3f11-aaf7-0a24ee19ae59",
                                                "text": "Das Schärfen von Messern ist eine Kunst."
                                            },
                                            {
                                                "example_id": "7e497437-b9c8-4ac7-855a-d3943e90d508",
                                                "sense_id": "db1ab0d4-56a3-3f11-aaf7-0a24ee19ae59",
                                                "text": "Der Vater vom Vater ist der Großvater."
                                            },
                                            {
                                                "example_id": "f0eb7119-dfa7-44ab-b595-d7c7ccdb9a0e",
                                                "sense_id": "db1ab0d4-56a3-3f11-aaf7-0a24ee19ae59",
                                                "text": "(1674) „Was ein Casus seye, wie viel ihrer sind, welche sie sind, auf was Weise sie entweder Expressè oder Subintellectivè, mit oder ohne Articulo formirt werden, ist aus obiger Lehre von dem Nomine gnugsam am Tage.“"
                                            },
                                            {
                                                "example_id": "0e14ce98-ab37-46e1-8ced-a077ec040c76",
                                                "sense_id": "db1ab0d4-56a3-3f11-aaf7-0a24ee19ae59",
                                                "text": "(1719) „Maynaldus: Ein Corpus dringet nicht durch ein Corpus; Diejenige Subtilheit aber, die in dem Corpore der Magnesiae ist, dringet durch und tingiert. Und eben an dem Orte: Die verborgene Natur wird von dem Corpore der Magnesiae extrahirt, durch welche die Corpora coloriret werden.“"
                                            },
                                            {
                                                "example_id": "98fa3759-c138-4449-b90c-8908ba6f91ba",
                                                "sense_id": "db1ab0d4-56a3-3f11-aaf7-0a24ee19ae59",
                                                "text": "(1796) „Von dem Nomine Substantivo, oder dem Hauptworte.“ (Überschrift)"
                                            },
                                            {
                                                "example_id": "660d57bd-3ba7-47e9-811b-8f614a44e2fb",
                                                "sense_id": "db1ab0d4-56a3-3f11-aaf7-0a24ee19ae59",
                                                "text": "(1814) „Von dem Nomine Substantivo oder der Grundbenennung. […] Von den Numeralibus und Pronominibus. […] Von den Verbis oder Aussagewörtern. […] Von den Participiis od. Verbalbenennungen.“ (Überschriften)"
                                            },
                                            {
                                                "example_id": "34d1a698-3d6d-4369-8cdc-df526eaf2dac",
                                                "sense_id": "db1ab0d4-56a3-3f11-aaf7-0a24ee19ae59",
                                                "text": "„Von gehört zwar zur historisch älteren Schicht der Präpositionen im Deutschen; es ist aber ausschließlich auf das deutsche, friesische und niederländische Sprachgebiet beschränkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f909ad6b-0f33-32f8-b481-d799e8820876",
                                        "entry_id": "fdefa5c5-462d-37a4-ba3e-75b9cb691923",
                                        "glosses": [
                                            "getrennt stehender Namenszusatz vor Familiennamen (insbesondere des ehemaligen Adels) und Adelsprädikat (bei Namen adeliger Personen)"
                                        ],
                                        "tags": [
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7be8228-b81f-4984-9c5a-fa6785eebbe7",
                                                "sense_id": "f909ad6b-0f33-32f8-b481-d799e8820876",
                                                "text": "Herr von Knigge lässt bitten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
