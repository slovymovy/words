                        ],
                        "form": "die Ångström"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "647dfcb4-d2ef-32ac-b7c0-22e3cf2e9a79",
                        "entry_id": "dc863825-66bc-3017-8f62-3586802116d5",
                        "glosses": [
                            "hundert Billionstel der Maßeinheit Meter (= 0,000 000 000 1 Meter)"
                        ],
                        "tags": [
                            "veraltende Einheit der Licht- und Röntgenwellenlänge"
                        ],
                        "examples": [
                            {
                                "example_id": "cbd183b7-564b-4d7e-9184-7ae3b718b1a2",
                                "sense_id": "647dfcb4-d2ef-32ac-b7c0-22e3cf2e9a79",
                                "text": "Ein Zehntel eines milliardstel Meters oder 0,1 Nanometer entsprechen einem Ångström."
                            },
                            {
                                "example_id": "6f2acb2c-a130-4ec0-9f0f-69741e08ffcd",
                                "sense_id": "647dfcb4-d2ef-32ac-b7c0-22e3cf2e9a79",
                                "text": "Sowohl Pikometer als auch Ångström werden häufig für die Angabe von Atom- und Molekülgrößen verwendet."
                            },
                            {
                                "example_id": "f731a349-4f72-458a-9365-d930f303c4b6",
                                "sense_id": "647dfcb4-d2ef-32ac-b7c0-22e3cf2e9a79",
                                "text": "Jedes menschliche Wesen, das gesund ist, sendet Strahlen zwischen 6200 und 7100 Ångström aus."
                            },
                            {
                                "example_id": "f518104e-ab99-4ade-ae89-319fa1121a66",
                                "sense_id": "647dfcb4-d2ef-32ac-b7c0-22e3cf2e9a79",
                                "text": "Aufgrund anderer technischer Grenzen […] lässt sich die Elektronenmikroskopie oft nicht bis zur Beugungsgrenze ausreizen. Auflösungen von einem Nanometer oder sogar einem Angström (einem zehntel Nanometer) lassen sich mit einigen technischen und physikalischen Tricks jedoch erreichen."
                            },
                            {
                                "example_id": "099297eb-b79d-46d5-8776-165ffd83cca3",
                                "sense_id": "647dfcb4-d2ef-32ac-b7c0-22e3cf2e9a79",
                                "text": "Der wesentliche Unterschied liegt darin, dass in der Kristallstruktur die Translation als wichtige Deckoperation dazukommt. Diese tritt wegen der geringen Größe der Translationsbeträge im Ångström-Bereich (1 Å = 10⁻⁸ cm) kristallomorphisch nicht in Erscheinung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
