                ],
                "senses": [
                    {
                        "sense_id": "bb4d396e-32d9-3c73-b06a-5cf0d8964af3",
                        "entry_id": "a5ff34fc-aad1-3b2c-b5e3-c46fd154b088",
                        "glosses": [
                            "feestelijke herdenking van de dag waarop iets gebeurde of begon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59be5d69-3eb1-4ae1-b6b5-99a8e8b2a627",
                                "sense_id": "bb4d396e-32d9-3c73-b06a-5cf0d8964af3",
                                "text": "Een jubileum waar niemand bij stil staat, verdient die naam misschien niet. Een herdenking met één deelnemer, dat klinkt niet koosjer. Toch grijp ik de gelegenheid, omdat het kinderboek dat precies 25 jaar geleden verscheen, met elke verhuizing mee mocht: Plinius Pinguïn (1990) van Boudewijn Büch (1948-2002), met tekeningen van Pauline Drost."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9345863d-99fd-48db-9a87-0220e1034f81",
                        "source_entry_id": "a5ff34fc-aad1-3b2c-b5e3-c46fd154b088",
                        "source_sense_id": "bb4d396e-32d9-3c73-b06a-5cf0d8964af3",
                        "source_sense_description": "feestelijke herdenking van de dag waarop iets gebeurde of begon",
                        "target_lang_word": "Jubiläum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jubiläum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5eb8c171-753f-34ec-8923-9a9ab554aafd",
                                        "entry_id": "56ca7ea0-6dc1-391d-a3bb-b9e9e4975f8e",
                                        "glosses": [
                                            "Feier zum Gedenken an ein bestimmtes Ereignis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d63fa2a4-c09b-4fa8-8c70-293ab1daa66a",
                                                "sense_id": "5eb8c171-753f-34ec-8923-9a9ab554aafd",
                                                "text": "Die Stadt hat am Wochenende ihr 500. Jubiläum gefeiert."
                                            },
                                            {
                                                "example_id": "2fba6fca-77c6-4804-a331-96d984217951",
                                                "sense_id": "5eb8c171-753f-34ec-8923-9a9ab554aafd",
                                                "text": "„Nun ist Horst Bosetzky, einer der erfolgreichsten deutschen Krimiautoren, ein halbes Jahr nach seinem runden Jubiläum gestorben.“"
                                            },
                                            {
                                                "example_id": "6f75ed33-70be-495c-8b43-47c52b1f1217",
                                                "sense_id": "5eb8c171-753f-34ec-8923-9a9ab554aafd",
                                                "text": "„Zum fünfzigjährigen Jubiläum will der Gefängnisdirektor ein Fest veranstalten.“"
                                            },
                                            {
                                                "example_id": "9ebc4864-708a-4cbf-94c0-723bbd332a11",
                                                "sense_id": "5eb8c171-753f-34ec-8923-9a9ab554aafd",
                                                "text": "„Aus Anlass des aktuellen Jubiläums lancierten die Hersteller nun ein Herrenparfüm, über das wir, so hofften sie, dann schreiben würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "635b18a2-a5d4-484b-b19a-937bcae00d31",
                        "source_entry_id": "a5ff34fc-aad1-3b2c-b5e3-c46fd154b088",
                        "source_sense_id": "bb4d396e-32d9-3c73-b06a-5cf0d8964af3",
                        "source_sense_description": "feestelijke herdenking van de dag waarop iets gebeurde of begon",
                        "target_lang_word": "jubilee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jubilee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7925022f-af91-3e16-9f71-f1281e861d99",
                                        "entry_id": "cd1638ef-0582-30d5-81fe-5d446708f301",
                                        "glosses": [
                                            "A special year of emancipation supposed to be observed every fifty years, when farming was temporarily stopped, certain houses and land which had been sold could be redeemed by the original owners or their relatives, and Hebrew slaves set free."
                                        ],
                                        "tags": [
                                            "Jewish",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fde2f35-4bac-4142-af97-b9352799983d",
                                                "sense_id": "7925022f-af91-3e16-9f71-f1281e861d99",
                                                "text": "And thou ſhalt number ſeuen Sabbaths of yeeres vnto thee, ſeuen times ſeuen yeeres, and the ſpace of the ſeuen Sabbaths of yeeres, ſhall be vnto thee fourtie and nine yeeres. Then ſhalt thou cauſe the trumpet of the Jubile to ſound, on the tenth day of the ſeuenth moneth, in the day of atonement ſhall ye make the trumpet ſound throughout all your land. And ye ſhall hallow the fiftieth yeere, and proclaime libertie throughout all the land, vnto al the inhabitants thereof: It ſhalbe a Jubile vnto you, and ye ſhall returne euery man vnto his poſſeſſion, and ye ſhall returne euery man vnto his family."
                                            },
                                            {
                                                "example_id": "33f1763e-2d28-414d-a523-0fc595dde453",
                                                "sense_id": "7925022f-af91-3e16-9f71-f1281e861d99",
                                                "text": "Touching this yeere of Iubilee is much controverſie. The ancient Authors account it the fiftieth yeere. […] Culuiſius hath at large diſputed this queſtion againſt Creutzhemius and Bucholcerus, by diuers arguments prouing that the Iubilee vvas but fortie nine yeeres complete, and that the fiftieth yeere vvas the firſt onvvards of another Iubilee or Sabbath of yeeres: […]"
                                            },
                                            {
                                                "example_id": "812bda8b-0eff-49fd-9964-ef5296f783da",
                                                "sense_id": "7925022f-af91-3e16-9f71-f1281e861d99",
                                                "text": "[I]n the old Israel, there had supposedly been a system of ‘Jubilee’, a year in which all land should go back to the family to which it had originally belonged and during which all slaves should be released."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "092a1750-c601-3d5d-b1cf-688222f1b115",
                                        "entry_id": "cd1638ef-0582-30d5-81fe-5d446708f301",
                                        "glosses": [
                                            "A special year (originally held every hundred years, then at more frequent intervals, and now declarable by the Pope at any time and also for periods less than a year) in which plenary indulgences and remission from sin can be granted upon making a pilgrimage to Rome or other designated churches."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d603e9f-9820-3f6f-8649-88e29e7c7588",
                                        "entry_id": "cd1638ef-0582-30d5-81fe-5d446708f301",
                                        "glosses": [
                                            "A major anniversary of an event, particularly the fiftieth (50th) anniversary of a coronation or marriage."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "332d3975-9ae2-44da-87bd-ccdfd5026eee",
                                                "sense_id": "8d603e9f-9820-3f6f-8649-88e29e7c7588",
                                                "text": "[A] married couple, when celebrating the fiftieth anniversary of their marriage-day, are said to keep their golden jubilee, but on the 25th anniversary they have credit only for a silver jubilee."
                                            },
                                            {
                                                "example_id": "e513b616-193e-4cff-b809-bd132ec80162",
                                                "sense_id": "8d603e9f-9820-3f6f-8649-88e29e7c7588",
                                                "text": "The 70th anniversary of Queen Elizabeth II’s accession to the throne will be a good deal more earthbound: The 95-year-old monarch plans to spend a quiet Sunday at her country estate, Sandringham, where her father died on Feb. 6, 1952. Four days of festivities to celebrate her Platinum Jubilee are scheduled for June."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e90edf9-a460-374c-bb1d-3a78ef596b6d",
                                        "entry_id": "cd1638ef-0582-30d5-81fe-5d446708f301",
                                        "glosses": [
                                            "A time for release or restitution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "210d6833-1913-4d53-b8bf-bc50393795cf",
                                                "sense_id": "5e90edf9-a460-374c-bb1d-3a78ef596b6d",
                                                "text": "[T]hough it be in the povver of the vveakeſt arme to take avvay life, it is not in the ſtrongeſt to deprive us of death: […] the firſt day of our Jubilee is death; the Devill hath therefore failed of his deſires; vvee are happier vvith death than vve ſhould have been vvithout it: there is no miſery but in himſelfe vvhere there is no end of miſery: […]"
                                            },
                                            {
                                                "example_id": "1f14ba58-c464-4e18-a957-c5e3262b0f1b",
                                                "sense_id": "5e90edf9-a460-374c-bb1d-3a78ef596b6d",
                                                "text": "\"Hurrah! hurrah! we bring the Jubilee! / Hurrah! Hurrah! the flag that makes you free!\" / So we sung the chorus from Atlanta to the sea, / While we were marching through Georgia."
                                            },
                                            {
                                                "example_id": "13eea153-7fb1-41fc-8735-ccb88fc8b50f",
                                                "sense_id": "5e90edf9-a460-374c-bb1d-3a78ef596b6d",
                                                "text": "The chains of that great power we broke; / The burdened captives were set free, / For Lincoln held the pen, whose stroke / Proclaimed, the year of jubilee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94115044-183c-33fc-9e5f-5adb13361873",
                                        "entry_id": "cd1638ef-0582-30d5-81fe-5d446708f301",
                                        "glosses": [
                                            "A time of celebration or rejoicing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c9779a8-12c5-4d84-a384-83c5d58bc83d",
                                                "sense_id": "94115044-183c-33fc-9e5f-5adb13361873",
                                                "text": "But you firſt ſhall taſte / The bounty of our Court, with royall Preſents / Both to the Duke your maſter, and the Princeſſe; / It done, prepare we for this great ſolemnity, / Of Hymeneall Iubilies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fab0bc3-9c2c-340f-b3f5-955b5c3d0462",
                                        "entry_id": "cd1638ef-0582-30d5-81fe-5d446708f301",
                                        "glosses": [
                                            "Exultation, rejoicing; jubilation."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb30ae26-63dc-4fac-bd14-fdf4b7de99a9",
                                                "sense_id": "4fab0bc3-9c2c-340f-b3f5-955b5c3d0462",
                                                "text": "Hee cauſed his little Sonne to goe vvith great State to Sandai to the Dairi, that is, to bovv the head thrice before him dovvne to the Mats, vvho entertayned him vvith a ſolemne feaſt, vvith great Iubilee in alteration of names and titles of honour to the Nobles."
                                            },
                                            {
                                                "example_id": "6a3bfe59-5684-4008-acf4-199b3fd56f6d",
                                                "sense_id": "4fab0bc3-9c2c-340f-b3f5-955b5c3d0462",
                                                "text": "The peoples joy to knovv us reconcild, / Is added to the Iubile of the day, / VVe have no more a faction but one heart, / Peace flovv in every boſome."
                                            },
                                            {
                                                "example_id": "a8d24560-6297-4d5f-92fe-86fe5e6e79cb",
                                                "sense_id": "4fab0bc3-9c2c-340f-b3f5-955b5c3d0462",
                                                "text": "Was it for Peveril of the Peak, in the jubilee of his spirits, to consider how his wife was to find beef and mutton to feast his neighbours?"
                                            },
                                            {
                                                "example_id": "eae62d84-336c-4506-b09f-eef6ddfdbc4e",
                                                "sense_id": "4fab0bc3-9c2c-340f-b3f5-955b5c3d0462",
                                                "text": "The Mexicans, elated with their success, meanwhile, abandoned themselves to jubilee; singing, dancing, and feasting on the mangled relics of their wretched victims."
                                            },
                                            {
                                                "example_id": "6b8b47f8-d602-45fa-bb10-f55f2f9513ad",
                                                "sense_id": "4fab0bc3-9c2c-340f-b3f5-955b5c3d0462",
                                                "text": "We will kiss sweet kisses, and speak sweet words: / O listen, listen, your eyes shall glisten / With pleasure and love and jubilee: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "165bff8d-604c-3c86-94d8-09dbcf2166bd",
                                        "entry_id": "cd1638ef-0582-30d5-81fe-5d446708f301",
                                        "glosses": [
                                            "The sound of celebration or rejoicing; shouts of joy."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ad12052-3fee-4621-88b4-2af399cac9c6",
                                                "sense_id": "165bff8d-604c-3c86-94d8-09dbcf2166bd",
                                                "text": "[…] Heav'n rung / VVith Jubilee, and loud Hoſanna's fill'd / Th' eternal Regions: […]"
                                            },
                                            {
                                                "example_id": "55209b28-19b3-4daf-9070-e3d4f40be2f9",
                                                "sense_id": "165bff8d-604c-3c86-94d8-09dbcf2166bd",
                                                "text": "[S]lowly down the steep descent / Fair Scotland's King and nobles went, / While all along the crowded way / Was jubilee and loud huzza."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8fb422b-8fc8-3a54-bf0d-d3e117edcbf4",
                                        "entry_id": "cd1638ef-0582-30d5-81fe-5d446708f301",
                                        "glosses": [
                                            "A joyful African-American (usually Christian) folk song."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "figuratively",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9433d781-e0cc-3cf9-9477-858957020cec",
                                        "entry_id": "cd1638ef-0582-30d5-81fe-5d446708f301",
                                        "glosses": [
                                            "A period of fifty years; a half-century."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "facfe80d-e868-45fa-bd9f-d518b80be1c6",
                                                "sense_id": "9433d781-e0cc-3cf9-9477-858957020cec",
                                                "text": "Hovv their faiths could decline ſo low, as to concede their generations in heaven, to be made by the ſmell of a citron, or that the felicity of their Paradiſe ſhould conſiſt in a Jubile of conjunction, that is a coition of one act prolonged unto fifty years."
                                            },
                                            {
                                                "example_id": "08e12dc7-33c2-4578-a7fa-0eed7d972561",
                                                "sense_id": "9433d781-e0cc-3cf9-9477-858957020cec",
                                                "text": "And now, being on this subject, once to dispatch [Thomas] Becket out of our way, just a jubilee of years after his death, Stephen Langton, his mediate successor, removed his body from the Under-croft in Christ-church, where first he was buried, and laid him, at his own charge, in a most sumptuous shrine, at the east end of the church."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be6206f9-5ab2-3625-bbe3-497bf352f3c6",
                                        "entry_id": "cd1638ef-0582-30d5-81fe-5d446708f301",
                                        "glosses": [
                                            "A fiftieth year."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f34343e-ef5d-4a80-8ed3-1c22f0091026",
                                                "sense_id": "be6206f9-5ab2-3625-bbe3-497bf352f3c6",
                                                "text": "But is't poſſible he ſhould believe he is not of age? vvhy / He is 50, man, in's Jubile I vvarrant: s'light, he / Looks older then a groat, the very ſtamp on's face is / VVorne out vvith handling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22e64516-79d9-44f8-8358-0b9935710402",
                        "source_entry_id": "a5ff34fc-aad1-3b2c-b5e3-c46fd154b088",
                        "source_sense_id": "bb4d396e-32d9-3c73-b06a-5cf0d8964af3",
                        "source_sense_description": "feestelijke herdenking van de dag waarop iets gebeurde of begon",
                        "target_lang_word": "jubilé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jubilé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61ff59bc-9df8-3ed0-b694-7468d21a55d5",
                                        "entry_id": "33619fdb-50f5-3edf-835a-e8cc4b0e9c60",
                                        "glosses": [
                                            "Solennité publique de la loi mosaïque qui se célébrait de cinquante ans en cinquante ans, et lors de laquelle toutes sortes de dettes étaient remises, tous les héritages restitués aux anciens propriétaires, et tous les esclaves rendus à la liberté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a13c4492-432a-4e28-a1d1-86e4a76a4d33",
                                                "sense_id": "61ff59bc-9df8-3ed0-b694-7468d21a55d5",
                                                "text": "Les juifs ne vendaient pas leurs biens et leurs terres à perpétuité, mais seulement jusqu’à l’année du jubilé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "357bb64f-cde6-3e2a-b3e7-7514c61469a8",
                                        "entry_id": "33619fdb-50f5-3edf-835a-e8cc4b0e9c60",
                                        "glosses": [
                                            "Indulgence plénière, solennelle et générale, accordée par le pape en certains temps et en certaines occasions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d2d005c-9865-4dab-9a0f-d5593350d392",
                                                "sense_id": "357bb64f-cde6-3e2a-b3e7-7514c61469a8",
                                                "text": "Jubilé universel."
                                            },
                                            {
                                                "example_id": "e85bdc09-34cc-4632-bfe5-bbfd4739e7e1",
                                                "sense_id": "357bb64f-cde6-3e2a-b3e7-7514c61469a8",
                                                "text": "La bulle du jubilé."
                                            },
                                            {
                                                "example_id": "31cb4738-58c9-4608-afa5-6b948b8c22d1",
                                                "sense_id": "357bb64f-cde6-3e2a-b3e7-7514c61469a8",
                                                "text": "Recevoir, publier, ouvrir le jubilé."
                                            },
                                            {
                                                "example_id": "b7c6b898-7960-4fd2-b195-c8577147297e",
                                                "sense_id": "357bb64f-cde6-3e2a-b3e7-7514c61469a8",
                                                "text": "Les stations, les prières du jubilé."
                                            },
                                            {
                                                "example_id": "51b37997-3017-4427-b88f-8a85d26843e5",
                                                "sense_id": "357bb64f-cde6-3e2a-b3e7-7514c61469a8",
                                                "text": "Jubilé pour la paix."
                                            },
                                            {
                                                "example_id": "68806d05-b02a-4811-8761-8acfd1d96fc5",
                                                "sense_id": "357bb64f-cde6-3e2a-b3e7-7514c61469a8",
                                                "text": "Le grand jubilé est maintenant de vingt-cinq ans en vingt-cinq ans."
                                            },
                                            {
                                                "example_id": "dfc7fc8b-960d-4ad6-b8ec-8e43b521beef",
                                                "sense_id": "357bb64f-cde6-3e2a-b3e7-7514c61469a8",
                                                "text": "Faire son jubilé, Faire toutes les pratiques de dévotion ordonnées par la bulle du jubilé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b2dafc4-72ee-3312-9602-393010306aa6",
                                        "entry_id": "33619fdb-50f5-3edf-835a-e8cc4b0e9c60",
                                        "glosses": [
                                            "Anniversaire de l’entrée dans une fonction, une profession."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73b42b47-ab5d-4250-a770-19eefad34a11",
                                                "sense_id": "7b2dafc4-72ee-3312-9602-393010306aa6",
                                                "text": "À mon arrivée à Téhéran, en avril 1896, ce monarque s’apprêtait à fêter son jubilé, sa cinquantième année au pouvoir."
                                            },
                                            {
                                                "example_id": "7732fbb5-ff47-4a94-a76a-1531f3234e4d",
                                                "sense_id": "7b2dafc4-72ee-3312-9602-393010306aa6",
                                                "text": "Défilés, concerts et concours de pudding: le palais de Buckingham a dévoilé lundi le contenu des festivités prévues du 2 au 5 juin pour célébrer le jubilé de platine — soit 70 ans de règne — de la reine Elizabeth II."
                                            },
                                            {
                                                "example_id": "c05c3f34-55fd-4a9f-821b-7fddfd945a9b",
                                                "sense_id": "7b2dafc4-72ee-3312-9602-393010306aa6",
                                                "text": "Célébrer son jubilé."
                                            }
                                        ]
                                    }
                                ]
                            },
