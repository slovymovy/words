                ],
                "senses": [
                    {
                        "sense_id": "b719263b-15a9-3f84-9b16-34c0659428b3",
                        "entry_id": "d95f6745-323e-3efc-bd6b-b96e56ff893f",
                        "glosses": [
                            "такой, который можно представить себе; мыслимый, вообразимый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5e7b6c3-5346-41e2-8e46-bd44b8a54706",
                                "sense_id": "b719263b-15a9-3f84-9b16-34c0659428b3",
                                "text": "Вместе с нашими космическими достижениями стремительно сужался представимый ареал нашей деятельности в нем."
                            }
                        ]
                    },
                    {
                        "sense_id": "2797ba0a-6ed7-35af-8c4b-51bf6cd91fa2",
                        "entry_id": "d95f6745-323e-3efc-bd6b-b96e56ff893f",
                        "glosses": [
                            "такой, который можно представить, показать, отобразить в каком-либо виде"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40648856-2260-44f0-b34f-79f2feb0a35c",
                                "sense_id": "2797ba0a-6ed7-35af-8c4b-51bf6cd91fa2",
                                "text": "После теоремы Ферма — Эйлера мы описали все числа, представимые в виде суммы двух квадратов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cd25996-6301-4f3e-9f2a-d8f0d036a9c1",
                        "source_entry_id": "d95f6745-323e-3efc-bd6b-b96e56ff893f",
                        "source_sense_description": "мыслимый, вообразимый",
                        "target_lang_word": "imaginable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imaginable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87f04c07-febc-3744-833e-99c897e96f18",
                                        "entry_id": "292e9ebb-331e-3427-abcd-721ebfef4425",
                                        "glosses": [
                                            "Able to be imagined; conceivable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6937a28-93e5-4d96-9d7a-f4183905f9ab",
                                                "sense_id": "87f04c07-febc-3744-833e-99c897e96f18",
                                                "text": "While running, they were exposed to the most hideous bespawling imaginable."
                                            },
                                            {
                                                "example_id": "2d1e449c-1047-4a57-962d-bbf6782ee3dd",
                                                "sense_id": "87f04c07-febc-3744-833e-99c897e96f18",
                                                "text": "By the early 1980s, Gucci was overlicensed, with its logo on every product imaginable from headscarves to key rings to lighters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2d853c3-c4b0-38a9-b0d9-6b1fd252aa74",
                                        "entry_id": "292e9ebb-331e-3427-abcd-721ebfef4425",
                                        "glosses": [
                                            "Able to be imagined; conceivable.",
                                            "Within the realm of consideration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e480eac8-343d-4988-8362-2f754047bae5",
                                                "sense_id": "b2d853c3-c4b0-38a9-b0d9-6b1fd252aa74",
                                                "text": "Nevertheless, even if these forms do not directly go back to Lat. autumnus, influence of this word is imaginable."
                                            }
                                        ]
