                        "source_sense_id": "35a57b8a-857a-3378-b272-4ff8f4042c57",
                        "source_sense_description": "Holz, das zum Heizen oder Kochen genutzt wird",
                        "target_lang_word": "bois de chauffage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bois de chauffage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91783f41-0ba9-3be5-b4f0-b2224f457c99",
                                        "entry_id": "53347ea6-1fa3-31ca-af19-42b49c314a0b",
                                        "glosses": [
                                            "Bois destiné à être brûlé pour le chauffage d’une habitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eba00c2-26ac-470e-9bca-048881f6739b",
                                                "sense_id": "91783f41-0ba9-3be5-b4f0-b2224f457c99",
                                                "text": "Il n'était plus exilé dans la petite maison en ruines du Rialto, réduit à transporter du bois de chauffage dans sa gondole rapiécée, en danger perpétuel de pécher seul par la faute des rouées qui ne sont même pas encore filles mais qui coquinent comme si elles l'étaient."
                                            },
                                            {
                                                "example_id": "85c6a464-f862-429d-af89-18e13f0ac986",
                                                "sense_id": "91783f41-0ba9-3be5-b4f0-b2224f457c99",
                                                "text": "Cela peut donc ensuite servir de bois de chauffage, d’agro-carburant ou encore de matériau de construction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
