                        "glosses": [
                            "weibliche Person, die Pferde züchtet, die eine Pferdezucht betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ce10c73-fa81-41c3-b158-cc606da8d432",
                                "sense_id": "436c1228-c6c8-328f-87c3-0521641a02fd",
                                "text": "„Die Pferdezüchterin Martina Herrlich-Gryzan mit ihrer Tochter Marie-Louise und ihrem Sohn Phillip auf ihrem kleinen Pferdehof in Neulietzegöricke.“"
                            },
                            {
                                "example_id": "719050c9-3be8-4ba8-8a85-12a2cd64cd96",
                                "sense_id": "436c1228-c6c8-328f-87c3-0521641a02fd",
                                "text": "„An diesem Abend kehrten Pferdezüchterin Anita B.* und ihr Freund, Transportunternehmer Robert W.* (58), im Gasthof Adler in Gipf-Oberfrick AG ein.“"
                            }
                        ],
