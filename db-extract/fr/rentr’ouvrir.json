                ],
                "senses": [
                    {
                        "sense_id": "9353d930-b805-3fb1-adcc-ce584e9885e4",
                        "entry_id": "26a397b3-84ec-34e5-aee3-16b585743dea",
                        "glosses": [
                            "Entr’ouvrir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c48b765e-70c0-49b9-bbbe-eb8d034f16ca",
                                "sense_id": "9353d930-b805-3fb1-adcc-ce584e9885e4",
                                "text": "Mais comme La Fayette est l'homme du jour, et que ses moindres apparitions font florès, elle a profité de la circonstance pour rentr’ouvrir ses beaux salons, fermés depuis de longues semaines."
                            },
                            {
                                "example_id": "5a03648c-beb7-41cb-91cb-08a930b30b46",
                                "sense_id": "9353d930-b805-3fb1-adcc-ce584e9885e4",
                                "text": "Si votre voile se soulève, Fermez-le, pour le rentr’ouvrir : La jouissance qu’il enlève Se remplace par le désir."
                            }
                        ]
                    }
                ],
