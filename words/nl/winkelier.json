                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vraag het anders even aan die <w>winkelier</w>, dan weet je het zeker.",
                            "target_lang_translations": {
                                "en": "Otherwise, just ask that <w>shopkeeper</w>, then you'll know for sure.",
                                "ru": "Иначе просто спроси у того <w>владельца магазина</w>, тогда будешь знать наверняка.",
                                "pl": "W przeciwnym razie zapytaj tego <w>sklepikarza</w>, wtedy będziesz mieć pewność.",
                                "de": "Frag doch einfach mal diesen <w>Ladenbesitzer</w>, dann weißt du es ganz sicher.",
                                "fr": "Sinon, demande à ce <w>commerçant</w>, comme ça tu en seras sûr.",
                                "it": "Altrimenti chiedi a quel <w>negoziante</w>, così sarai sicuro.",
                                "cs": "Zeptej se raději tamtoho <w>obchodníka</w>, pak to budeš vědět jistě.",
                                "tr": "İstersen o <w>esnafa</w> bir sor, o zaman kesin olarak öğrenirsin.",
                                "es": "Si no, pregúntale a ese <w>tendero</w>, así te asegurarás."
                            }
                        },
                        {
                            "text": "De vriendelijke <w>winkelier</w> helpt de klanten altijd met een glimlach.",
                            "target_lang_translations": {
                                "en": "The friendly <w>shopkeeper</w> always helps the customers with a smile.",
                                "ru": "Дружелюбный <w>торговец</w> всегда помогает клиентам с улыбкой.",
                                "pl": "Przyjazny <w>sklepikarz</w> zawsze pomaga klientom z uśmiechem.",
                                "de": "Der freundliche <w>Ladenbesitzer</w> hilft den Kunden immer mit einem Lächeln.",
                                "fr": "Le sympathique <w>commerçant</w> aide toujours les clients avec le sourire.",
                                "it": "Il gentile <w>negoziante</w> aiuta sempre i clienti con un sorriso.",
                                "cs": "Milý <w>obchodník</w> pomáhá zákazníkům vždy s úsměvem.",
                                "tr": "Güler yüzlü <w>dükkancı</w> müşterilere her zaman gülümseyerek yardımcı olur.",
                                "es": "El amable <w>tendero</w> siempre ayuda a los clientes con una sonrisa."
                            }
                        }
