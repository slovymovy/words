                "senses": [
                    {
                        "sense_id": "11554aaa-58d3-3078-b1f5-c7064f83c719",
                        "entry_id": "17ddc47a-87d8-33b9-8e25-b02646aa1d3a",
                        "glosses": [
                            "Antikörper, der körpereigene Antigene bindet, der gegen körpereigene Substanzen/Proteine wirkt und damit die normale körpereigene Abwehrkraft herabsetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "712fd6c8-a739-4c3a-8733-aa6379e8cc6a",
                                "sense_id": "11554aaa-58d3-3078-b1f5-c7064f83c719",
                                "text": "„Als Marker für die allmähliche Heilung gilt der graduelle Abfall bestimmter Autoantikörper im Blut, die bei Patienten mit dieser Form der Kardiomyopathie anfangs in großer Menge vorhanden sind.“"
                            },
                            {
                                "example_id": "f4268ce9-7b39-41fb-83b1-c93f4547dbd4",
                                "sense_id": "11554aaa-58d3-3078-b1f5-c7064f83c719",
                                "text": "„In der Regel führt die Bildung von Autoantikörpern zu einer Autoimmunerkrankung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "248e3a9a-ead6-4c71-bcd2-8db9627c33a1",
