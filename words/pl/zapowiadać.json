{
    "word_family": [
        "zapowiedź",
        "zapowiedni",
        "zapowiedzialny"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "86ffc4e2-19ee-3915-a48f-6b22d7565703",
                    "sense_definition": "informować o czymś, co ma nastąpić w przyszłości",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ogłaszanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kobieta <w>zapowiadająca</w> pociągi na tym dworcu ma bardzo wyraźny głos.",
                            "target_lang_translations": {
                                "ru": "Женщина, <w>объявляющая</w> поезда на этом вокзале, имеет очень четкий голос."
                            }
                        },
                        {
                            "text": "Konferansjer <w>zapowiada</w> kolejny występ na scenie.",
                            "target_lang_translations": {
                                "ru": "Конферансье <w>анонсирует</w> следующее выступление на сцене."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zapowiadać pociągi",
                        "zapowiadać gości"
                    ],
                    "target_lang_definitions": {
                        "ru": "сообщать о чем-либо, что должно произойти в будущем"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объявлять",
                                "target_lang_sense_clarification": "официально сообщать о предстоящем событии или прибытии"
                            },
                            {
                                "target_lang_word": "анонсировать",
                                "target_lang_sense_clarification": "делать анонс, заранее сообщать о программе или выступлении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbd8df05-6c4e-31a5-a643-dfe8d5829f3d",
                    "sense_definition": "być znakiem lub zwiastunem nadchodzącego zdarzenia",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zwiastowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ciemne chmury na niebie <w>zapowiadają</w> silną burzę.",
                            "target_lang_translations": {
                                "ru": "Темные тучи на небе <w>предвещают</w> сильную грозу."
                            }
                        },
                        {
                            "text": "Wysokie temperatury w marcu <w>zapowiadają</w> bardzo gorące lato.",
                            "target_lang_translations": {
                                "ru": "Высокие температуры в марте <w>обещают</w> очень жаркое лето."
                            }
                        }
                    ],
                    "synonyms": [
                        "rokować",
                        "wróżyć"
                    ],
                    "common_phrases": [
                        "zapowiadać deszcz",
                        "zapowiadać zmiany"
                    ],
                    "target_lang_definitions": {
                        "ru": "быть признаком или предвестником грядущего события"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвещать",
                                "target_lang_sense_clarification": "служить признаком чего-либо, обычно неприятного или значительного"
                            },
                            {
                                "target_lang_word": "обещать",
                                "target_lang_sense_clarification": "внушать надежду или ожидания относительно чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa874aa5-10ee-3c1e-a759-8ba6bb98b2e5",
                    "sense_definition": "informować kogoś o swoim przybyciu",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ogłaszanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musisz <w>zapowiadać</w> się przed każdą wizytą u dyrektora.",
                            "target_lang_translations": {
                                "ru": "Ты должен <w>предупреждать о своем визите</w> перед каждым посещением директора."
                            }
                        },
                        {
                            "text": "Goście <w>zapowiadali</w> się telefonicznie już tydzień temu.",
                            "target_lang_translations": {
                                "ru": "Гости <w>предупреждали о своем визите</w> по телефону еще неделю назад."
                            }
                        }
                    ],
                    "synonyms": [
                        "anonsować się"
                    ],
                    "common_phrases": [
                        "zapowiadać się z wizytą"
                    ],
                    "target_lang_definitions": {
                        "ru": "заранее сообщать кому-либо о своем визите"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предупреждать о визите",
                                "target_lang_sense_clarification": "сообщать о своем приходе заранее"
                            },
                            {
                                "target_lang_word": "заявлять о себе",
                                "target_lang_sense_clarification": "официально уведомлять о своем прибытии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6834f2ec-6dca-36f7-a808-d5aa894a8e5d",
                    "sense_definition": "mieć się ku czemuś, być oczekiwanym w określony sposób",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oczekiwanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Zapowiada</w> się kolejny bardzo skwarny dzień w mieście.",
                            "target_lang_translations": {
                                "ru": "<w>Обещает быть</w> еще один очень знойный день в городе."
                            }
                        },
                        {
                            "text": "Spotkanie <w>zapowiada</w> się niezwykle interesująco dla wszystkich uczestników.",
                            "target_lang_translations": {
                                "ru": "Встреча <w>обещает быть</w> чрезвычайно интересной для всех участников."
                            }
                        }
                    ],
                    "synonyms": [
                        "kroić się",
                        "rysować się",
                        "szykować się",
                        "zarysowywać się"
                    ],
                    "common_phrases": [
                        "zapowiada się dobrze",
                        "zapowiada się ciekawie"
                    ],
                    "target_lang_definitions": {
                        "ru": "иметь признаки того, что что-то произойдет определенным образом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обещать быть",
                                "target_lang_sense_clarification": "ожидаться в каком-либо качестве"
                            },
                            {
                                "target_lang_word": "предвещать",
                                "target_lang_sense_clarification": "иметь предпосылки к определенному развитию событий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfa747d4-85a3-300c-a9af-fd5c37161693",
                    "sense_definition": "wykazywać cechy wskazujące na przyszły rozwój lub sukces",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "oczekiwanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młody sportowiec <w>zapowiada</w> się na prawdziwego mistrza olimpijskiego.",
                            "target_lang_translations": {
                                "ru": "Молодой спортсмен <w>подает надежды</w> стать настоящим олимпийским чемпионом."
                            }
                        },
                        {
                            "text": "Ten uczeń <w>zapowiada</w> się na wybitnego matematyka w przyszłości.",
                            "target_lang_translations": {
                                "ru": "Этот ученик <w>подает надежды</w> стать выдающимся математиком в будущем."
                            }
                        }
                    ],
                    "synonyms": [
                        "rokować"
                    ],
                    "common_phrases": [
                        "zapowiadać się na kogoś"
                    ],
                    "target_lang_definitions": {
                        "ru": "подавать надежды на будущий успех или развитие"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавать надежды",
                                "target_lang_sense_clarification": "демонстрировать потенциал для будущего успеха"
                            },
                            {
                                "target_lang_word": "обещать стать",
                                "target_lang_sense_clarification": "иметь задатки для достижения определенного статуса"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}