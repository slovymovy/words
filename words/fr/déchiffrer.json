                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle fixait son interlocuteur pour tenter de <w>déchiffrer</w> ses véritables intentions.",
                            "target_lang_translations": {
                                "en": "She stared hard at the person she was talking to, trying to <w>read</w> their true intentions.",
                                "ru": "Она пристально смотрела на собеседника, пытаясь <w>разгадать</w> его истинные намерения.",
                                "de": "Sie musterte ihren Gesprächspartner eindringlich, um dessen wahre Absichten zu <w>durchschauen</w>.",
                                "es": "Fijaba la mirada en su interlocutor para intentar <w>descifrar</w> sus verdaderas intenciones.",
                                "zh": "她目不转睛地盯着对方，试图<w>看透</w>他的真实意图。"
                            }
                        },
                        {
                            "text": "Il est tellement impassible qu'il est impossible de <w>déchiffrer</w> la moindre émotion.",
                            "target_lang_translations": {
                                "en": "He is so impassive that it is impossible to <w>read</w> even the slightest emotion.",
                                "ru": "Он настолько невозмутим, что по его лицу невозможно <w>прочесть</w> ни малейшей эмоции.",
                                "de": "Er ist so unbewegt, dass man ihm keine einzige Gefühlsregung <w>ablesen</w> kann.",
                                "es": "Es tan impasible que resulta imposible <w>descifrar</w> la más mínima emoción.",
                                "zh": "他面无表情，根本无法<w>读懂</w>他的任何一丝情绪。"
                            }
                        }
