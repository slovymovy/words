        "fr-extract.jsonl": [
            {
                "entry_id": "3c29a8a7-6b2f-30c1-b346-2c7c2f89a3ce",
                "word": "fondamentaliste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f8e9f167-83b2-4816-b229-e589b862fe26",
                        "entry_id": "3c29a8a7-6b2f-30c1-b346-2c7c2f89a3ce",
                        "tags": [
                            "plural"
                        ],
                        "form": "fondamentalistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "25c784fb-81ba-3319-b57e-9254de7d3440",
                        "entry_id": "3c29a8a7-6b2f-30c1-b346-2c7c2f89a3ce",
                        "glosses": [
                            "Relatif au fondamentalisme, au retour aux fondements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "522faf64-7e1b-4e4c-a595-78865c3427bd",
                                "sense_id": "25c784fb-81ba-3319-b57e-9254de7d3440",
                                "text": "Le monde fondamentaliste est un monde polarisé : bien ou mal, vérité ou mensonge, position vaine ou situation authentique, nous ou eux, un de nous ou l’ennemi."
                            },
                            {
                                "example_id": "ddfb07a4-658e-4a0d-b133-74397ac26244",
                                "sense_id": "25c784fb-81ba-3319-b57e-9254de7d3440",
                                "text": "D'une façon intéressante, les néoconservateurs, poursuivant une quête digne de Moby Dick pour trouver un monstre à occire — […] — sont, de par leur tempérament et leur point de vue philosophique, bien plus « fondamentalistes » que ceux qu'ils perçoivent comme leurs ennemis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "000ef6f5-dd3e-4ba1-8e77-38e30f1114a5",
                        "source_entry_id": "3c29a8a7-6b2f-30c1-b346-2c7c2f89a3ce",
                        "source_sense_id": "25c784fb-81ba-3319-b57e-9254de7d3440",
                        "target_lang_word": "fundamentalist",
                        "target_lang_code": "en",
