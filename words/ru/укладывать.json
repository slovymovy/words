                {
                    "sense_id": "5022d3cb-207c-3273-add7-ffe5a76cb1a5",
                    "sense_definition": "собирать и помещать вещи во что-либо для хранения или поездки",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "packing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед поездкой она аккуратно <w>укладывала</w> одежду в большой чемодан.",
                            "target_lang_translations": {
                                "en": "Before the trip, she was neatly <w>packing</w> her clothes into a large suitcase."
                            }
                        },
                        {
                            "text": "Мы долго <w>укладывали</w> вещи перед отъездом на вокзал.",
                            "target_lang_translations": {
                                "en": "We spent a long time <w>packing</w> our things before leaving for the train station."
                            }
                        }
                    ],
                    "synonyms": [
                        "паковать",
                        "складывать"
                    ],
                    "antonyms": [
                        "распаковывать"
                    ],
                    "common_phrases": [
                        "укладывать вещи",
                        "укладывать чемодан"
                    ],
                    "target_lang_definitions": {
                        "en": "to pack or stow things into a container or bag for storage or travel"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pack",
                                "target_lang_sense_clarification": "belongings into luggage or boxes"
                            },
                            {
                                "target_lang_word": "stow",
                                "target_lang_sense_clarification": "items neatly away"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e96e8252-52ef-3b2d-ba3c-b980cadf2eb3",
                    "sense_definition": "помогать кому-либо лечь, отправлять ко сну",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "putting_to_bed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждый вечер мама читает сказку и <w>укладывает</w> ребёнка спать.",
                            "target_lang_translations": {
                                "en": "Every evening mom reads a fairy tale and <w>puts</w> the child <w>to bed</w>."
                            }
                        },
                        {
                            "text": "Отец бережно <w>укладывал</w> сына в постель после долгой прогулки.",
                            "target_lang_translations": {
                                "en": "The father gently <w>put</w> his son <w>to bed</w> after a long walk."
                            }
                        }
                    ],
                    "antonyms": [
                        "будить",
                        "поднимать"
                    ],
                    "common_phrases": [
                        "укладывать спать",
                        "укладывать в постель"
                    ],
                    "target_lang_definitions": {
                        "en": "to help someone lie down, tuck someone in, or put someone to sleep"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "put to bed",
                                "target_lang_sense_clarification": "a child or someone needing rest"
                            },
                            {
                                "target_lang_word": "tuck in",
                                "target_lang_sense_clarification": "bedding around someone lying down"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a6d217b-e5a7-3e5b-ba80-6c5d10ecf749",
