                "senses": [
                    {
                        "sense_id": "4d20bff7-7768-3359-8799-bc9dc3d290e1",
                        "entry_id": "6323fbce-2b8f-362c-b684-f9981e94096f",
                        "glosses": [
                            "женское имя еврейского происхождения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c7034ee-985a-4a9d-8ddb-120c7fd35113",
                                "sense_id": "4d20bff7-7768-3359-8799-bc9dc3d290e1",
                                "text": "А Мирра, внушившая итальянскому поэту одну из лучших его трагедий?.."
                            },
                            {
                                "example_id": "2019dae7-54ff-467d-8a1b-44c82c749f96",
                                "sense_id": "4d20bff7-7768-3359-8799-bc9dc3d290e1",
                                "text": "Вечером был у Каратыгина, были: Верховский, Конради, Дюклу и Мирра Бородина .."
                            },
                            {
                                "example_id": "424ac0f0-ef60-436e-96d7-328c8dad2ef4",
                                "sense_id": "4d20bff7-7768-3359-8799-bc9dc3d290e1",
                                "text": "И вот пришла Мирра Борисовна [Штак], полная, жизнерадостная еврейка."
                            },
                            {
                                "example_id": "6ffe2200-0e91-4a9e-87f3-5069397d1ddc",
                                "sense_id": "4d20bff7-7768-3359-8799-bc9dc3d290e1",
                                "text": "Одно из самых приятных литературных воспоминаний — о Мирре [Марии] Александровне Лохвицкой."
                            },
                            {
                                "example_id": "07380574-e5c6-459a-84c1-5b42dd79e164",
                                "sense_id": "4d20bff7-7768-3359-8799-bc9dc3d290e1",
                                "text": "Воскресенье. Приходила Мирра Сергеевна Куссис. Рассказывала о Риме, коронации папы Иоанна XXIII."
                            }
                        ]
                    }
