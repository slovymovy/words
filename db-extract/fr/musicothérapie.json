                "senses": [
                    {
                        "sense_id": "2adf0563-bea7-3876-9b11-3f51381755b8",
                        "entry_id": "65838ae1-7186-3958-b591-9072d926f5ce",
                        "glosses": [
                            "Fait de soigner à l’aide de la musique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c995ad46-4084-49f5-a211-e531d0492e7d",
                                "sense_id": "2adf0563-bea7-3876-9b11-3f51381755b8",
                                "text": "La musicothérapie est beaucoup utilisée dans les soins aux personnes atteintes de troubles mentaux, dans le cadre d’activités."
                            },
                            {
                                "example_id": "9a0801e3-2fa0-4d47-9830-83b9e7379082",
                                "sense_id": "2adf0563-bea7-3876-9b11-3f51381755b8",
                                "text": "La musicothérapie est donc l’utilisation holistique des éléments constitutifs de la musique (les timbres, les sons, les modes, les rythmes, les harmonies) pour permettre soit l’ouverture de canaux de communication, soit la mise en résonance de l’extérieur sonore avec l’intérieur instable."
                            },
                            {
                                "example_id": "43e1c194-de54-4988-8baa-b0e385094db7",
                                "sense_id": "2adf0563-bea7-3876-9b11-3f51381755b8",
                                "text": "Barbara Souffir est une conteuse hors pair, formée au chant et à la musicothérapie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ea02e2d-491e-4b2f-9e06-a746999d73b9",
                        "source_entry_id": "65838ae1-7186-3958-b591-9072d926f5ce",
