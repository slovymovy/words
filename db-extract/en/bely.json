                "senses": [
                    {
                        "sense_id": "f8664784-58da-3c2d-b708-98a21843d25c",
                        "entry_id": "89f5d28c-82fa-3546-ba2f-6bcf727f380b",
                        "glosses": [
                            "Obsolete spelling of belie."
                        ],
                        "tags": [
                            "alt-of",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "dc1d4780-c774-4122-97ce-fc7c59a0c2a2",
                                "sense_id": "f8664784-58da-3c2d-b708-98a21843d25c",
                                "text": "This woman of whom he writes—whoever she be—or any one, in short, but your own dear self, mama, and Edward, may have been so barbarous to bely me."
                            },
                            {
                                "example_id": "52ee6e3c-6a43-4085-ac8c-87fe4b6ee635",
                                "sense_id": "f8664784-58da-3c2d-b708-98a21843d25c",
                                "text": "So he'll quickly devour the way, if only He's no booby; for all a snowy maiden Chide imperious, and her hands around him Both in jealousy clasp'd, refuse departure. 10 She, if only report the truth bely not, Doats, as hardly within her own possession. 3."
                            },
                            {
                                "example_id": "ec48ec77-e870-4b72-aa62-419edc41876c",
                                "sense_id": "f8664784-58da-3c2d-b708-98a21843d25c",
                                "text": "And here it may be said that Tom Peregrine's name did not bely him."
                            },
                            {
                                "example_id": "1994abe0-5980-437d-a82e-028d9a4b36af",
                                "sense_id": "f8664784-58da-3c2d-b708-98a21843d25c",
                                "text": "... the cool grey calm of his eyes belying... belying? She found the dictionary under the telephone book, sought for bely and could not find it."
                            }
                        ]
                    }
