                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "564896a5-6c3b-44c2-a683-c476d2620ed2",
                                "sense_id": "d30430a5-db77-30fb-acd4-1573f34f6f9a",
                                "text": "Among a variety of specimens, we collected some fine plants of the Tonquin bean, the Souwarrow nut, the wild orange, and a species of medlar."
                            },
                            {
                                "example_id": "1872e2bc-5670-4747-9d6e-64dafe5363ab",
                                "sense_id": "d30430a5-db77-30fb-acd4-1573f34f6f9a",
                                "text": "Souari nut, or butternut.—This nut, like the last, is a native of British Guiana, and is the fruit of the Caryocar nuciferum, a noble tree, growing a hundred feet high, having large, broad, trifoliate leaves, resembling those of our common horse-chestnut, but not quite as broad."
                            }
