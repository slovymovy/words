            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b2db078-8555-3302-9741-2f1539bc68ac",
                    "sense_definition": "Prendre possession de quelque chose par la force, la ruse ou l'autorité ; se rendre maître de.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "prise_de_possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats ont réussi à s'<w>emparer</w> du pouvoir après une longue bataille nocturne."
                        },
                        {
                            "text": "Une vive inquiétude s'<w>empare</w> des habitants lorsque la sirène retentit dans la vallée."
                        }
                    ],
                    "synonyms": [
                        "saisir",
                        "conquérir",
                        "prendre"
                    ],
                    "antonyms": [
                        "abandonner",
                        "céder",
                        "restituer"
                    ],
                    "common_phrases": [
                        "s'emparer du pouvoir",
                        "s'emparer d'une ville"
                    ]
                },
                {
                    "sense_id": "f473650f-26b0-3769-90b7-1f381f3ccebe",
                    "sense_definition": "Accaparer quelqu'un en monopolisant son attention ou sa présence, ne pas lui laisser de liberté.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "accaparement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet invité bavard s'<w>empare</w> de chaque nouvel arrivant dès le début de la soirée."
                        },
                        {
                            "text": "Elle s'est <w>emparée</w> de son collègue pendant toute la réunion pour défendre son projet."
                        }
                    ],
                    "synonyms": [
                        "accaparer",
                        "monopoliser"
                    ],
                    "antonyms": [
                        "libérer",
                        "délivrer"
                    ]
                },
                {
                    "sense_id": "77bfd440-25dc-372d-aa27-8f82dd54d37f",
                    "sense_definition": "Fortifier un lieu, le mettre en état de défense.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fortification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouverneur avait ordonné d'<w>emparer</w> la ville avant l'arrivée imminente de l'armée ennemie."
                        },
                        {
                            "text": "Les ouvriers commencèrent à <w>emparer</w> les remparts pour résister aux attaques prolongées."
                        }
                    ],
                    "synonyms": [
                        "fortifier",
                        "défendre"
                    ],
                    "antonyms": [
                        "démanteler",
                        "désarmer"
                    ],
                    "traits": [
