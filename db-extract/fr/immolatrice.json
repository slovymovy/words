                        "examples": [
                            {
                                "example_id": "5bca147d-01c5-4a3e-926b-379e762b4a8b",
                                "sense_id": "36d5f242-96c2-342d-88f3-7f0a0fea07a4",
                                "text": "O Père éternel ! Étendez votre main du haut des cieux, et recevez cette hostie vivante que vous présente sainte Anne, vraie immolatrice de ses entrailles."
                            },
                            {
                                "example_id": "5e508675-b41c-4bcb-979e-b8e4a8b7a2cd",
                                "sense_id": "36d5f242-96c2-342d-88f3-7f0a0fea07a4",
                                "text": "Les siècles écoulés avaient probablement vu les arrière-aïeules de ces immolatrices s’acharner ainsi sur des naufragés, danser autour d’un bûcher d’épaves."
                            }
                        ]
                    }
