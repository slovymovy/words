                            }
                        },
                        {
                            "text": "Fabuła nowej powieści kryminalnej jest tak <w>zawiła</w>, że trudno przewidzieć zakończenie.",
                            "target_lang_translations": {
                                "ru": "Сюжет нового детективного романа настолько <w>замысловат</w>, что трудно предугадать финал."
                            }
                        }
                    ],
                    "synonyms": [
