                                                "example_id": "4be7ae03-b2a0-485b-85fd-2a02f5a94aa5",
                                                "sense_id": "cc6e0fb9-ddd2-3943-a820-6b95fc10aa01",
                                                "text": "Nach den morgendlichen Gymnastikübungen bereitet sich mein Freund ein Frühstück aus Obst und Haferflocken."
                                            },
                                            {
                                                "example_id": "1ac4cbf5-790f-49b0-936a-7c0d5c48c112",
                                                "sense_id": "cc6e0fb9-ddd2-3943-a820-6b95fc10aa01",
                                                "text": "Das morgendliche Aufstehen fällt nach einer ausgelassenen Feier besonders schwer."
                                            }
                                        ],
