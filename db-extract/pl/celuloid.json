                "senses": [
                    {
                        "sense_id": "a0b20028-c522-33a4-9ca0-d6c895854aeb",
                        "entry_id": "4cb6be12-7af2-3602-bea1-c01ed398af28",
                        "glosses": [
                            "przezroczyste, dające się barwić na różne kolory, łatwopalne tworzywo sztuczne; termoplastyczny materiał organiczny powstający przez uplastycznienie azotanu celulozy kamforą, stosowany m.in. do wyrobu taśm filmowych, zabawek, grzebieni, guzików i wielu innych przedmiotów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd99c6b9-48e5-482f-9614-c9682cd13a09",
                                "sense_id": "a0b20028-c522-33a4-9ca0-d6c895854aeb",
                                "text": "Fellini natchnął kino najczystszą poezją, Godard zaś pokazał, że film to tylko film, pasek celuloidu pokryty materiałem światłoczułym"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d3562c8-8f19-4f4d-a8a3-a9a091fc1ae3",
                        "source_entry_id": "4cb6be12-7af2-3602-bea1-c01ed398af28",
                        "source_sense_id": "a0b20028-c522-33a4-9ca0-d6c895854aeb",
                        "target_lang_word": "celluloid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "celluloid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00a6f9d7-6cf3-3027-806f-2ecd138d56e5",
                                        "entry_id": "57ee7cea-ffc0-3dab-bc4b-099b370d2bf2",
                                        "glosses": [
                                            "Any of a variety of thermoplastics created from nitrocellulose and camphor, once used as photographic film."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "584d65b2-7567-4176-b6eb-d590a40fd367",
                                                "sense_id": "00a6f9d7-6cf3-3027-806f-2ecd138d56e5",
                                                "text": "1894 June, Antonia Dickson, W. K. L. Dickson, Edison's Invention of the Kineto-Phonograph: Account of the Invention, article in Century Magazine, Volume 48, Issue 2,\nThen followed some experiments with drums, over which sheets of sensitized celluloid film were drawn, the edges being pressed into a narrow slot in the surface, similar in construction to the old tin-foil phonograph."
                                            },
                                            {
                                                "example_id": "2ae29710-2bad-4bc9-968f-f37285d3c7c2",
                                                "sense_id": "00a6f9d7-6cf3-3027-806f-2ecd138d56e5",
                                                "text": "\"And will you now, sir, take off your celluloid collar and permit me to burn it in the candle? Thank you, sir. And will you allow me to smash your spectacles for you with my hammer? Thank you.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e093a0a-0983-3430-9542-26173a924d6c",
                                        "entry_id": "57ee7cea-ffc0-3dab-bc4b-099b370d2bf2",
                                        "glosses": [
                                            "The genre of cinema; film."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "figuratively",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44b1c3a9-7b33-4127-9ee4-027859e96c25",
                                                "sense_id": "6e093a0a-0983-3430-9542-26173a924d6c",
                                                "text": "Celluloid railway comedy was hardly to appear again until the mid-thirties and, later, in Britain."
                                            },
                                            {
                                                "example_id": "3ddec937-0e34-4c3c-8fba-c624c6240b2d",
                                                "sense_id": "6e093a0a-0983-3430-9542-26173a924d6c",
                                                "text": "In particular, they set Kerouac and Ginsberg to the specifications of an emergent superficial form—celluloid antiheroes—attractive to those in want of adventure and who would soon be reading On the Road (1957)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8c3c802-b7b8-367e-a80c-2bd7786e2ff8",
                                        "entry_id": "57ee7cea-ffc0-3dab-bc4b-099b370d2bf2",
                                        "glosses": [
                                            "An item, such as a jacket, made from celluloid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b2b346f-d803-47c6-95f0-c3546ca8de85",
                                                "sense_id": "e8c3c802-b7b8-367e-a80c-2bd7786e2ff8",
                                                "text": "'What with that bearded Assyrian bull in London, and this Thug down here, who has ruined my clean celluloid, you seem to be keeping queer company, Ted Malone.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a04f950-2277-41b3-8960-80fc04b7f205",
                        "source_entry_id": "4cb6be12-7af2-3602-bea1-c01ed398af28",
                        "source_sense_id": "a0b20028-c522-33a4-9ca0-d6c895854aeb",
                        "target_lang_word": "celluloïd",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "celluloïd",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bffb024e-78b5-3597-b813-a5aa8472236e",
                                        "entry_id": "cdd7c1c9-bbb3-3f3f-adda-2bda7d33d0fc",
                                        "glosses": [
                                            "Thermoplastique ressemblant à la corne et à l’ivoire, formé par un mélange de nitrocellulose et de camphre, parfois associé avec des matières pulvérulentes diversement colorées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3672efb5-a781-441f-9db2-6a26f1e04978",
                                                "sense_id": "bffb024e-78b5-3597-b813-a5aa8472236e",
                                                "text": "Le vernis pour ongles est préparé avec de l’acétone, de l’acétate d'amyle, du celluloïd blanc et de l’isoeugénol, que l’on colore avec de la teinture d’éosine."
                                            },
                                            {
                                                "example_id": "46ddb7bb-be82-47c0-821e-95a67f6a3e06",
                                                "sense_id": "bffb024e-78b5-3597-b813-a5aa8472236e",
                                                "text": "C’est le dimanche du carnaval. […] ; les jeunes aspergent les femmes de parfum. Elles répondent à coup de petites boules en celluloïd."
                                            },
                                            {
                                                "example_id": "7f902622-4c26-4e65-a3af-33fec90a4785",
                                                "sense_id": "bffb024e-78b5-3597-b813-a5aa8472236e",
                                                "text": "Son pantalon était retroussé sur ses bottines comme pour une longue marche ; au-dessus du veston noir, très étroit, s’entrebâillait un col de celluloïd sans cravate."
                                            },
                                            {
                                                "example_id": "112ab80d-490d-4dff-8edb-9ce912ca9280",
                                                "sense_id": "bffb024e-78b5-3597-b813-a5aa8472236e",
                                                "text": "Les deux femmes vivaient seules, le père ayant été tué par une presse à celluloïd qui lui avait basculé sur la tête."
                                            },
                                            {
                                                "example_id": "461d684a-2ccb-4823-99df-f751c08dcf56",
                                                "sense_id": "bffb024e-78b5-3597-b813-a5aa8472236e",
                                                "text": "– Bon, tu as raison… mais pour ce qui est des clochettes, des sonnettes, ça non, je les entends… et aussi des bruits de crécelle, le crépitement des fleurs de celluloïd rouges, roses, mauves, tournant au vent…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb849a6a-4589-31c6-b80e-c7ef5157eda2",
                                        "entry_id": "cdd7c1c9-bbb3-3f3f-adda-2bda7d33d0fc",
                                        "glosses": [
                                            "Feuille transparente d'acétate de cellulose servant à créer les dessins animés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "665c2094-0fd2-4b28-8fac-4f5822a44b92",
                                                "sense_id": "bb849a6a-4589-31c6-b80e-c7ef5157eda2",
                                                "text": "Bray s’associe à Earl Hurd, l’inventeur du celluloïd, qui permet d’animer les personnages sur des feuilles transparentes tandis que le décor reste identique."
                                            },
                                            {
                                                "example_id": "3f678903-6fd6-4930-8097-dd7a3f0f47b8",
                                                "sense_id": "bb849a6a-4589-31c6-b80e-c7ef5157eda2",
                                                "text": "En France, où le modèle industriel américain ne prend pas, il existe tout de même des exemples de productions classiques en celluloïd, tels les films de Jean Image, Jeannot l’intrépide (1950) et Bonjour Paris ! (1953)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e68d2707-e45d-48a6-8556-c3275702de83",
                        "source_entry_id": "4cb6be12-7af2-3602-bea1-c01ed398af28",
                        "source_sense_id": "a0b20028-c522-33a4-9ca0-d6c895854aeb",
                        "target_lang_word": "celuloide",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "celuloide",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "5a36a560-c996-324d-8e39-d9f6e132e179",
                                        "entry_id": "08a7e20b-78dc-3514-baf1-79130bf44c20",
                                        "glosses": [
                                            "Sólido translúcido y elástico fabricado con fulmicotón y alcanfor. Es uno de los componentes principales de la película fotográfica y con él se pueden hacer imitaciones de diversos materiales."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6f0ac44-2986-4bdf-96d3-cabba2fea853",
                        "source_entry_id": "4cb6be12-7af2-3602-bea1-c01ed398af28",
                        "source_sense_id": "a0b20028-c522-33a4-9ca0-d6c895854aeb",
                        "target_lang_word": "Zelluloid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zelluloid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0185ef64-1cb3-3ded-8a2e-54c278eab30d",
                                        "entry_id": "e2537cfc-7305-3d13-9ad4-1914413a2f58",
                                        "glosses": [
                                            "durchsichtiger, elastischer Kunststoff, der, da man ihn einfach schmelzen und formen kann, eine Massenfertigung ermöglichte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa89a688-92a3-45e2-a87b-4112ab0a06f1",
                                                "sense_id": "0185ef64-1cb3-3ded-8a2e-54c278eab30d",
                                                "text": "„Fritz Klatte untersuchte [Vinylchlorid] genauer und erkannte Vielversprechendes: Es verhielt sich nämlich ganz ähnlich wie Zelluloid. Das war damals der letzte Schrei - Filme wurden aus Zelluloid hergestellt, Knöpfe, Brillen und Spielzeugpuppen. Und das trotz eines fatalen Nachteils: Wird Zelluloid zu trocken, geht es in Flammen auf.“"
                                            },
                                            {
                                                "example_id": "51d9eb02-b16f-40ec-9a35-59a2ab1257a8",
                                                "sense_id": "0185ef64-1cb3-3ded-8a2e-54c278eab30d",
                                                "text": "„[…] zwischen den modernen Plastiksorten führt das Kunstharz aus Milchproteinen [Kasein] nur ein Nischendasein. Dasselbe gilt für die anderen Vorgänger der heutigen Plastikprodukte: das Ebonit und den Schellack, das Zelluloid und die Vulkanfiber.“"
                                            },
                                            {
                                                "example_id": "538988eb-0fc7-42c1-8c64-75ad065bc09c",
                                                "sense_id": "0185ef64-1cb3-3ded-8a2e-54c278eab30d",
                                                "text": "„Zelluloid gefährdet die Gesundheit und ist leicht entflammbar. Die in China oder Japan hergestellten [Zelluloid-]Bälle gelten als Gefahrengut. […] Seit 1891 wird im Tischtennis mit Zelluloid gespielt. […] Doch wie in der Filmindustrie hat das Zelluloid auch im Tischtennis ausgedient.“"
                                            },
                                            {
                                                "example_id": "65af2f13-70a0-43e4-ae2e-240b9425db75",
                                                "sense_id": "0185ef64-1cb3-3ded-8a2e-54c278eab30d",
                                                "text": "„Die Gabo-Skulptur war aus Zelluloseazetat, einer der ersten Kunststoffe überhaupt und ähnlich anfällig wie das chemisch verwandte Zelluloid.“"
                                            },
                                            {
                                                "example_id": "ac5033d0-1bae-43b3-b218-cf61323e3317",
                                                "sense_id": "0185ef64-1cb3-3ded-8a2e-54c278eab30d",
                                                "text": "„Zwischen Zelluloiden amerikanischer Firmen und solchen europäischen Ursprunges konnte weder nach Zusammensetzung noch Verhalten ein erheblicher Unterschied festgestellt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "50cb9568-4b61-37a9-8bf8-a7873837a11d",
                                        "entry_id": "e2537cfc-7305-3d13-9ad4-1914413a2f58",
                                        "glosses": [
                                            "Träger aus [1] für die chemischen Substanzen auf einem Film"
                                        ],
                                        "tags": [
                                            "Film"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e84dff71-876e-4d25-93e6-a498f1cd8eb1",
                                                "sense_id": "50cb9568-4b61-37a9-8bf8-a7873837a11d",
                                                "text": "„Beim Fernsehen hat die Digitaltechnik schon längst das Zelluloid ins Abseits gedrängt.“"
                                            },
                                            {
                                                "example_id": "5d25f666-f0c1-47e9-9df0-b2e0ea0428a4",
                                                "sense_id": "50cb9568-4b61-37a9-8bf8-a7873837a11d",
                                                "text": "„Die Brüder Diehl, Wegbereiter des Puppentrickfilms, bannten die Geschichte 1936/37 in ihren Gräfelfinger Studios auf Zelluloid.“"
                                            },
                                            {
                                                "example_id": "1e722a9f-b01e-42fb-9fd6-bac2f5530c63",
                                                "sense_id": "50cb9568-4b61-37a9-8bf8-a7873837a11d",
                                                "text": "„Die Ausstellung im \"BELvue\"-Museum zeigt unter anderem Filmaufnahmen der zwei Kamerateams, die den Einzug des Königs für die Nachwelt auf Zelluloid festhielten.“"
                                            },
                                            {
                                                "example_id": "35be065d-13af-4b6b-81b1-90b5732851a6",
                                                "sense_id": "50cb9568-4b61-37a9-8bf8-a7873837a11d",
                                                "text": "„Das […] Zelluloid wurde dann langsam durch den „Sicherheitsfilm“ aus Celluloseacetat ersetzt, der höchstens mal im Projektor durchschmorte, wenn er steckenblieb.“"
                                            },
                                            {
                                                "example_id": "22269794-6a8b-4fef-9cd0-0f2ae35aaf9e",
                                                "sense_id": "50cb9568-4b61-37a9-8bf8-a7873837a11d",
                                                "text": "[Liv Ullmann:] „'Wissen Sie, ich musste so darum kämpfen, diesen Film noch auf Zelluloid drehen zu dürfen. Ich hatte keine Lust auf dieses Digitale, obwohl meine Produzenten versuchten, mich davon zu überzeugen. […]'“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20777ec8-d419-4561-8cdb-7939a8956ccc",
