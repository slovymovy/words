    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a77c9781-627f-3e08-ac92-01fef39824e8",
                    "sense_definition": "A person who rides a bicycle or habitually engages in the sport of cycling.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bicycle rider",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A solitary <w>cyclist</w> was coming towards us, pedaling hard against the wind.",
                            "target_lang_translations": {
                                "ru": "Одинокий <w>велосипедист</w> ехал нам навстречу, с трудом крутя педали против ветра."
                            }
                        },
                        {
                            "text": "The city is building new lanes to ensure every <w>keen</w> <w>cyclist</w> can commute safely.",
                            "target_lang_translations": {
                                "ru": "Город строит новые дорожки, чтобы каждый <w>заядлый</w> <w>велосипедист</w> мог безопасно добираться до работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "bicyclist",
                        "cycler",
                        "pedaller"
                    ],
                    "common_phrases": [
                        "keen cyclist",
                        "professional cyclist",
                        "amateur cyclist",
                        "road cyclist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ездит на велосипеде или регулярно занимается велоспортом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "велосипедист",
                                "target_lang_sense_clarification": "мужской род или общее обозначение"
                            },
                            {
                                "target_lang_word": "велосипедистка",
                                "target_lang_sense_clarification": "женский род"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9a0e9d0-82a9-3827-9d42-2dee0701ff30",
                    "sense_definition": "A person who rides a motorcycle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "motorcycle rider",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most of the <w>cyclists</w> were members of a local motorcycle club gathering for the rally.",
                            "target_lang_translations": {
                                "ru": "Большинство <w>мотоциклистов</w> были членами местного мотоклуба, собравшимися на ралли."
                            }
                        },
                        {
                            "text": "The <w>cyclist</w> wore a heavy leather jacket and a helmet for protection on the highway.",
                            "target_lang_translations": {
                                "ru": "<w>Мотоциклист</w> был одет в тяжелую кожаную куртку и шлем для защиты на шоссе."
                            }
                        }
                    ],
                    "synonyms": [
                        "biker"
                    ],
                    "common_phrases": [
                        "motorcycle cyclist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ездит на мотоцикле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мотоциклист",
                                "target_lang_sense_clarification": "водитель мотоцикла"
                            },
                            {
                                "target_lang_word": "байкер",
                                "target_lang_sense_clarification": "разговорное, участник мотоклуба"
                            }
                        ]
                    }
                }
            ]
        }
    ]
