                ],
                "senses": [
                    {
                        "sense_id": "def5a432-b59f-3323-859c-2a9e9e08de70",
                        "entry_id": "61a1b346-dfe4-3f91-9d75-5734563e515f",
                        "glosses": [
                            "Qualifie les composés organiques comportant au moins un atome de chlore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8bb69e3-8183-4f49-95cf-b2eb6fef901a",
                                "sense_id": "def5a432-b59f-3323-859c-2a9e9e08de70",
                                "text": "La chlordécone est un pesticide organochloré polluant et persistant."
                            },
                            {
                                "example_id": "f437dd21-4576-47e3-ad9e-8cc3fae9c38e",
                                "sense_id": "def5a432-b59f-3323-859c-2a9e9e08de70",
                                "text": "L’endosulfan a été homologué dans les années 1950, ce qui en faisait jusqu’ici un produit acceptable, malgré les critiques des écologistes, même si d’autres molécules organochlorées semblables comme le DDT, le dieldrin et le chlordane ont été bannies dans les années 1970 et 1980."
                            },
                            {
                                "example_id": "854e5b9f-804a-417e-99c0-fdb223717e33",
                                "sense_id": "def5a432-b59f-3323-859c-2a9e9e08de70",
                                "text": "La contamination de la Martinique et de la Guadeloupe par une molécule organochlorée appelée chlordécone (C₁₀Cl₁₀O) raconte aussi l’histoire globale de la condition toxique du Plantationocène et de sa chimie des maîtres."
                            },
                            {
                                "example_id": "f4d4911b-f8ca-4109-9dc8-82d5918e6f65",
                                "sense_id": "def5a432-b59f-3323-859c-2a9e9e08de70",
                                "text": "Les terres agricoles contaminées par des pesticides organochlorées sont-elles condamnées ?"
                            }
                        ]
                    }
                ],
