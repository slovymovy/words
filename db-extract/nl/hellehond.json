            {
                "entry_id": "81fbc569-caa6-3206-8c00-c31ca9117830",
                "word": "Hellehond",
                "pos": "name",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "33ff3ff5-7381-305e-961c-a0a6557a9c5f",
                        "entry_id": "81fbc569-caa6-3206-8c00-c31ca9117830",
                        "glosses": [
                            "bij de oude Grieken de driekoppige bewaker van de toegang tot Hades"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb8ac044-efef-4403-af1f-201b0e5c5764",
                                "sense_id": "33ff3ff5-7381-305e-961c-a0a6557a9c5f",
                                "text": "Van verre ziet Europa toe. Zij spoort de admiraal aan, Karel Gustaaf in boeien te slaan en hem, gelijk Hercules deed met de Hellehond, aan iedereen als afschrikwekkend voorbeeld te laten zien, vooral ook aan kardinaal Mazarin."
                            }
                        ]
                    },
                    {
                        "sense_id": "e189d03a-fd59-38be-ad33-3a5c33b11d78",
                        "entry_id": "81fbc569-caa6-3206-8c00-c31ca9117830",
                        "glosses": [
                            "bij de oude Germanen de hond die de oppergod Wodan vergezelde als hij de jacht door de hemel leidde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9e27492-1918-4dd4-9ee7-05d7e8afc950",
                                "sense_id": "e189d03a-fd59-38be-ad33-3a5c33b11d78",
                                "text": "Tyr, de god van de oorlog, vocht met Garm, de Hellehond van de godin van de onderwereld, en ook zij verwondden elkaar zo hevig, dat geen van beiden het overleefde."
                            }
                        ]
                    }
                ],
