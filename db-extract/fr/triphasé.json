                "forms": [
                    {
                        "form_id": "25057e1c-9a9c-41cc-aa66-9315be0fcd7f",
                        "entry_id": "5be28161-d557-3953-ade7-d5b37e5a0bf9",
                        "tags": [
                            "plural"
                        ],
                        "form": "triphasés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0e31ae14-2586-3505-88e0-94d1d73d62dd",
                        "entry_id": "5be28161-d557-3953-ade7-d5b37e5a0bf9",
                        "glosses": [
                            "Système de distribution de l’électricité utilisant trois conducteurs actifs (phases), plus éventuellement un neutre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "563db434-1de4-43f4-a9e4-e88b4c87246e",
                                "sense_id": "0e31ae14-2586-3505-88e0-94d1d73d62dd",
                                "text": "Trois fusibles basculèrent sur la position coupée. Ils correspondent au moteur de la chasse d'eau des toilettes situées à l'arrière. Comme celui-ci fonctionne au triphasé, chaque phase doit être protégée par son propre breaker."
                            },
                            {
                                "example_id": "656778e4-36b6-41c2-9c63-20d3a8cc123a",
                                "sense_id": "0e31ae14-2586-3505-88e0-94d1d73d62dd",
                                "text": "On note une prédominance à l'emploi des réseaux alternatifs et à l'usage généralisé du triphasé 200 V/400 Hz."
                            },
                            {
                                "example_id": "975ada8b-1aa8-4439-b4c4-efe7c5b4b493",
                                "sense_id": "0e31ae14-2586-3505-88e0-94d1d73d62dd",
                                "text": "Un générateur hydroélectrique produit un courant alternatif à tension adaptée à sa puissance. Sur les petites productions, il peut s'agir du 220V monophasé mais plus souvent du triphasé 380 V."
                            }
                        ]
                    }
                ],
