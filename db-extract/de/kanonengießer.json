                "senses": [
                    {
                        "sense_id": "db7e961a-2c51-304d-9b6a-670dcadca511",
                        "entry_id": "89a3c665-c1a8-3fe1-a2ff-7bc43108334c",
                        "glosses": [
                            "Person, die Kanonen mithilfe von Gussformen herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ab81371-2b9b-4f0f-acf8-73a72e004ab4",
                                "sense_id": "db7e961a-2c51-304d-9b6a-670dcadca511",
                                "text": "„Er hatte einen türkischen Kanonengießer in seinen Diensten, der es verstand, vor Ort Kanonen herzustellen.“"
                            },
                            {
                                "example_id": "49e2027e-6235-475f-be4c-4cd37a5d6e86",
                                "sense_id": "db7e961a-2c51-304d-9b6a-670dcadca511",
                                "text": "„Besucher erleben ein Gespräch zwischen dem Kurfürsten und seinem Architekten, finden sie sich in den Wächterstuben wieder, lauschen Fachsimpeleien der Kanonengießer, sehen bei der Erfindung des europäischen Porzellans zu, begegnen in einer Gefängniszelle dem berüchtigten Räuber Lips Tullian und sind Beobachter barocker Feste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
