                                "example_id": "ee1f05d7-4b36-4b9e-acf8-f8c5a360c384",
                                "sense_id": "8b8915c8-83a5-3efb-8bcb-5b5e4a9edffe",
                                "text": "Judge Merrilee Ehrlich was seen in video of the April 15 court appearance yelling at Sandra Faye Twiggs. The 59-year-old was in court on a simple battery charge after a dispute over a fan at her home in Lauderhill."
                            },
                            {
                                "example_id": "f816b3e6-40bc-4c91-abe6-cf081961da8a",
                                "sense_id": "8b8915c8-83a5-3efb-8bcb-5b5e4a9edffe",
                                "text": "Ten years ago, shortly before her sister married her husband, Bobby Gow, she announced to the family that she did not want to be known as Faith any longer; henceforward her name was to be Faye."
                            }
