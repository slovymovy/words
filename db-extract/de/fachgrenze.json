                ],
                "senses": [
                    {
                        "sense_id": "0598a26c-1cc1-30a5-a91c-a00675b6e1e3",
                        "entry_id": "782cc959-dfb4-31e9-af2c-f7bfc1199886",
                        "glosses": [
                            "Ende der sachlichen Zuständigkeit eines kodifizierten Arbeitsbereichs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0951168-51ea-47a1-87a2-ae1fb74e6f84",
                                "sense_id": "0598a26c-1cc1-30a5-a91c-a00675b6e1e3",
                                "text": "„Die Fachgrenzen sind fließend und hängen von der stimmlichen Entwicklung ab.“"
                            },
                            {
                                "example_id": "a40c83f5-a20b-4ff3-b977-50f707f9e917",
                                "sense_id": "0598a26c-1cc1-30a5-a91c-a00675b6e1e3",
                                "text": "„Die Überwindung der Fachgrenzen sei, so verkündete etwa Reichsdozentenführer Schultze, ‚das radikale Mittel im Kampf gegen jüdischen Geist und für deutsches Wesen’.“"
                            },
                            {
                                "example_id": "4d0d9852-ff53-44d8-b1cb-763e8c9a0a21",
                                "sense_id": "0598a26c-1cc1-30a5-a91c-a00675b6e1e3",
                                "text": "„Der Ausdruck interdisziplinäre Kooperation bezeichnet das die engen Fachgrenzen überwindende konstruktive Interagieren mehrerer Fachexperten im Sinne einer größeren Ökonomie, Effektivität, Lebens- und Sachnähe bei der Bewältigung komplizierterer Aufgaben.“"
                            },
                            {
                                "example_id": "46f1b024-9c87-4c3c-a19b-ee9c8c2b3276",
                                "sense_id": "0598a26c-1cc1-30a5-a91c-a00675b6e1e3",
                                "text": "„Gerade die außeruniversitäre Forschung böte jedoch nach wie vor die Möglichkeit, hohe geistige Kreativität zu entwickeln, da Fachgrenzen leichter als in den Hochschulen zu überwinden seien.“"
                            },
                            {
                                "example_id": "4c61f302-c997-4c76-9455-2065243461cf",
                                "sense_id": "0598a26c-1cc1-30a5-a91c-a00675b6e1e3",
                                "text": "„Man muss Peter Sloterdijk unbedingt zugutehalten, dass er jener seltenen Spezies von Intellektuellen angehört, die ihre Fachgrenzen immer wieder mit Lust sprengen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
