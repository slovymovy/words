                                        "examples": [
                                            {
                                                "example_id": "b8d85661-72ed-482b-868a-b7d0f6bd3a44",
                                                "sense_id": "94111ecc-b507-3643-8fe7-bf27772c32d4",
                                                "text": "As the train approached Welshpool on the return journey, an unexpected incident was provided by a baker's delivery van, which had been drawn up across the track. Some skilful manoeuvring of the vehicle was necessary before the train could pass."
