                                        "entry_id": "1e9ee4c9-2faf-37c3-90bd-3c476fcdb479",
                                        "glosses": [
                                            "weibliche Person, die übertrieben genau, pingelig, kleinlich, geizig ist"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "pejorative"
