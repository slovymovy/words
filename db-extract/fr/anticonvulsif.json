                ],
                "senses": [
                    {
                        "sense_id": "8e7151d8-a8a1-318a-9c47-d16dca1cec24",
                        "entry_id": "d68b21f7-7ff6-3d0c-aa3f-fa717efe07c7",
                        "glosses": [
                            "Médicament qui lutte contre les convulsions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8c4be36-397d-4fde-992d-4fb52ef76479",
                                "sense_id": "8e7151d8-a8a1-318a-9c47-d16dca1cec24",
                                "text": "Après l’administration d’un anticonvulsif, on détermine de nouveau la quantité minimale de pentétrazole produisant une convulsion."
                            },
                            {
                                "example_id": "a85e4556-6b99-40d2-98b5-ef54009bfafb",
                                "sense_id": "8e7151d8-a8a1-318a-9c47-d16dca1cec24",
                                "text": "Dès lors il [le médecin traitant] ne cherchera plus, dans une classe de prétendus anticonvulsifs ou antispasmodiques, les remèdes à toute espèce de convulsions, pour lui les seuls moyens antispasmodiques seront ceux qui conviennent au traitement des affections dont les convulsions ne sont que les symptômes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3d01c69-c928-4bce-9eea-dbef7f1413f4",
                        "source_entry_id": "d68b21f7-7ff6-3d0c-aa3f-fa717efe07c7",
                        "source_sense_id": "8e7151d8-a8a1-318a-9c47-d16dca1cec24",
