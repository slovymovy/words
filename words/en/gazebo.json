{
    "word_family": [
        "belvedere",
        "gaze"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "76a0c38f-38ea-3caa-bd97-7ecabe03089b",
                    "sense_definition": "A permanent, roofed, detached structure in a garden or park, typically used for sitting and enjoying the view.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "garden structures",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the afternoon reading books in the wooden <w>gazebo</w> at the edge of the lawn.",
                            "target_lang_translations": {
                                "ru": "Мы провели вторую половину дня за чтением книг в деревянной <w>беседке</w> на краю лужайки."
                            }
                        },
                        {
                            "text": "The couple decided to have their wedding ceremony inside a beautiful garden <w>gazebo</w> surrounded by flowers.",
                            "target_lang_translations": {
                                "ru": "Пара решила провести свадебную церемонию в красивой садовой <w>беседке</w>, окруженной цветами."
                            }
                        }
                    ],
                    "synonyms": [
                        "belvedere",
                        "summerhouse",
                        "pavilion"
                    ],
                    "common_phrases": [
                        "garden gazebo",
                        "wooden gazebo",
                        "octagonal gazebo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянная крытая отдельно стоящая постройка в саду или парке, обычно используемая для отдыха и созерцания вида."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беседка",
                                "target_lang_sense_clarification": "садовая постройка"
                            },
                            {
                                "target_lang_word": "павильон",
                                "target_lang_sense_clarification": "небольшое здание в парке"
                            },
                            {
                                "target_lang_word": "бельведер",
                                "target_lang_sense_clarification": "постройка на возвышении для обзора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2075b257-11bd-398e-8d6d-3fdf1c42b930",
                    "sense_definition": "A portable, lightweight shelter consisting of a roof supported by poles, often used for outdoor events.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temporary shelters",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They set up a pop-up <w>gazebo</w> in the backyard to protect the food from the rain during the party.",
                            "target_lang_translations": {
                                "ru": "На заднем дворе установили разборный <w>шатер</w>, чтобы защитить еду от дождя во время вечеринки."
                            }
                        },
                        {
                            "text": "The market vendors were busy assembling a <w>gazebo</w> to display their handmade crafts.",
                            "target_lang_translations": {
                                "ru": "Рыночные торговцы были заняты сборкой <w>павильона</w> для демонстрации своих изделий ручной работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "canopy tent",
                        "marquee",
                        "pavilion",
                        "pop-up tent",
                        "sunshade"
                    ],
                    "common_phrases": [
                        "pop-up gazebo",
                        "folding gazebo",
                        "portable gazebo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переносное легкое укрытие, состоящее из крыши на опорах, часто используемое для мероприятий на открытом воздухе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шатер",
                                "target_lang_sense_clarification": "временное укрытие"
                            },
                            {
                                "target_lang_word": "тент",
                                "target_lang_sense_clarification": "навес из ткани"
                            },
                            {
                                "target_lang_word": "павильон",
                                "target_lang_sense_clarification": "сборно-разборная конструкция"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ca2f762-15c3-3b73-80d6-84bdd7949b1a",
                    "sense_definition": "A structure or object that is considered gaudy, flimsy, or ridiculous in appearance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ridiculous objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked at the strange hat and asked what kind of <w>gazebo</w> her friend was wearing on her head.",
                            "target_lang_translations": {
                                "ru": "Она посмотрела на странную шляпу и спросила, что за <w>нелепицу</w> ее подруга нацепила на голову."
                            }
                        },
                        {
                            "text": "The critics described the new monument as a shaky <w>gazebo</w> that did not fit the city's architecture.",
                            "target_lang_translations": {
                                "ru": "Критики описали новый монумент как шаткое <w>сооружение</w>, которое не вписывалось в архитектуру города."
                            }
                        }
                    ],
                    "synonyms": [
                        "monstrosity",
                        "eyesore",
                        "rattle-trap"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in Irish English to describe something absurd or poorly made."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сооружение или предмет, который выглядит безвкусно, хлипко или нелепо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нелепица",
                                "target_lang_sense_clarification": "абсурдный предмет"
                            },
                            {
                                "target_lang_word": "убожество",
                                "target_lang_sense_clarification": "плохо сделанная вещь"
                            },
                            {
                                "target_lang_word": "сооружение",
                                "target_lang_sense_clarification": "иронично о чем-то странном"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}