                "senses": [
                    {
                        "sense_id": "d66e8cc2-5a26-3131-b2f3-fd638a2aab71",
                        "entry_id": "b5ff8b4b-9977-3d13-a9a9-dfd09bd5e8cf",
                        "glosses": [
                            "Wirbeltier, das an Land lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5804decd-66be-4cd6-b2d3-23064c76a511",
                                "sense_id": "d66e8cc2-5a26-3131-b2f3-fd638a2aab71",
                                "text": "Fast alle erwachsenen Landwirbeltiere atmen Luft, auch die sekundär im Wasser lebenden Wale und Seekühe."
                            },
                            {
                                "example_id": "12af4c79-e748-4f53-9ad4-091b67c9aa91",
                                "sense_id": "d66e8cc2-5a26-3131-b2f3-fd638a2aab71",
                                "text": "„Man hat herausgerechnet, daß es im Verhältnis zur Größe des Gesamttiers das kleinste Hirn ist, das überhaupt je bei einem Landwirbeltier beobachtet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
