                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caa8c639-8dee-41f3-b94a-c1aef536a6af",
                                                "sense_id": "d15a0ba6-bad6-3df1-8820-42fe802be77a",
                                                "text": "Das Debian-System baut auf einem Linux(-Kernel) auf."
                                            },
                                            {
                                                "example_id": "0f07e23d-950c-4e5f-8ee4-f3d0bebabcba",
                                                "sense_id": "d15a0ba6-bad6-3df1-8820-42fe802be77a",
                                                "text": "„Nutzer von Chrome und dessen freiem Pendant Chromium werden künftig Schwierigkeiten haben, den Browser auf älteren Linux-Versionen zu nutzen. Denn die Google-Entwickler planen, künftig eine Sicherheitsfunktion des Linux-Kernels zu nutzen, die erst seit Kurzem zur Verfügung steht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7f6c7e32-ccd8-3900-b59e-23b48008debe",
                                        "entry_id": "865bf672-dfa3-35f1-a5f9-4b1377e527b9",
                                        "glosses": [
                                            "ein auf dem Linux-Kernel aufbauendes Betriebssystem"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46ab97fa-e016-46ad-9bfa-7851fea0b972",
                                                "sense_id": "7f6c7e32-ccd8-3900-b59e-23b48008debe",
                                                "text": "Auf dem PC läuft ein Linux-System."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "404c402b-b81e-3f46-b2dd-78fdf0f1e92c",
                                        "entry_id": "865bf672-dfa3-35f1-a5f9-4b1377e527b9",
                                        "glosses": [
                                            "der Name eines Asteroiden, genaue Bezeichnung: „(9885) Linux“"
                                        ],
