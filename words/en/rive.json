{
    "word_family": [
        "riven",
        "river"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "68d4a0a2-cf5d-38ad-806e-1c6fe4fc2aec",
                    "sense_definition": "To break or split apart, often used figuratively to describe a group or entity divided by conflict.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "split",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political party was <w>riven</w> by internal disputes over the new economic policy.",
                            "target_lang_translations": {
                                "ru": "Политическая партия была <w>расколота</w> внутренними спорами по поводу новой экономической политики."
                            }
                        },
                        {
                            "text": "The country has been <w>riven</w> by civil war for more than a decade.",
                            "target_lang_translations": {
                                "ru": "Страна была <w>раздираема</w> гражданской войной более десяти лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "split"
                    ],
                    "antonyms": [
                        "unify",
                        "unite"
                    ],
                    "common_phrases": [
                        "riven by conflict",
                        "riven by strikes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раскалывать или разделять на части, часто используется в переносном смысле для описания группы или организации, раздираемой конфликтами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздирать",
                                "target_lang_sense_clarification": "о конфликтах или противоречиях"
                            },
                            {
                                "target_lang_word": "раскалывать",
                                "target_lang_sense_clarification": "о единстве группы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3154a87-d903-3f93-9a5d-d64ecbb01f82",
                    "sense_definition": "To tear apart by force or to split something solid like wood or rock.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "split",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The powerful storm winds <w>rived</w> the ancient oak tree right down the middle.",
                            "target_lang_translations": {
                                "ru": "Мощные штормовые ветры <w>раскололи</w> древний дуб прямо посередине."
                            }
                        },
                        {
                            "text": "He watched the lightning <w>rive</w> the dark sky during the summer tempest.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал, как молния <w>разрезает</w> темное небо во время летней бури."
                            }
                        }
                    ],
                    "synonyms": [
                        "cleave",
                        "rend",
                        "split"
                    ],
                    "common_phrases": [
                        "rive the wood"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in literary or older contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрывать силой или раскалывать что-то твердое, например дерево или камень."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскалывать",
                                "target_lang_sense_clarification": "дерево или камень"
                            },
                            {
                                "target_lang_word": "расщеплять",
                                "target_lang_sense_clarification": "вдоль волокон"
                            },
                            {
                                "target_lang_word": "раздирать",
                                "target_lang_sense_clarification": "силой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eadd181e-7bc2-33b6-85f1-1536697b46f5",
                    "sense_definition": "To split or saw wood radially from a log to create boards.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "woodworking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The craftsman began to <w>rive</w> the cedar logs to make shingles for the roof.",
                            "target_lang_translations": {
                                "ru": "Мастер начал <w>колоть</w> кедровые бревна, чтобы сделать дранку для крыши."
                            }
                        },
                        {
                            "text": "Traditional methods require you to <w>rive</w> the timber along its natural grain.",
                            "target_lang_translations": {
                                "ru": "Традиционные методы требуют <w>расщеплять</w> древесину вдоль ее естественных волокон."
                            }
