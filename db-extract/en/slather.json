                                        "sense_id": "0495ff8a-3e7d-3c3f-9a2b-432052ab3988",
                                        "entry_id": "be3caa20-9d17-30da-ae25-58ec08c2aace",
                                        "glosses": [
                                            "jemandem schmeicheln, um Vorteile zu gewinnen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "533ba204-a76e-4ae2-92c8-94dafe6f8d8c",
                                                "sense_id": "0495ff8a-3e7d-3c3f-9a2b-432052ab3988",
                                                "text": "Kannst dich doch bei ihm wieder einschmieren, dann gibt er dir vielleicht doch noch wieder was."
                                            }
