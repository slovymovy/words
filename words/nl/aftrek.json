{
    "word_family": [
        "aftrekken",
        "aftrekpost",
        "aftrekbaar"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e72d7a4f-f449-33d6-9d23-6664973daae8",
                    "sense_definition": "De mate waarin er vraag is naar een product of hoe snel het verkocht wordt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "populariteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe smartphones vonden direct na de lancering gretig <w>aftrek</w> bij het publiek.",
                            "target_lang_translations": {
                                "en": "The new smartphones were in great <w>demand</w> by the public immediately after the launch."
                            }
                        },
                        {
                            "text": "Tijdens de warme zomerdagen vond het ijs in de kleine winkel veel <w>aftrek</w>.",
                            "target_lang_translations": {
                                "en": "During the warm summer days, the ice cream in the small shop <w>sold</w> very well."
                            }
                        }
                    ],
                    "synonyms": [
                        "vraag",
                        "afzet"
                    ],
                    "common_phrases": [
                        "gretig aftrek vinden",
                        "veel aftrek vinden"
                    ],
                    "target_lang_definitions": {
                        "en": "The extent to which there is demand for a product or how quickly it is sold."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "demand",
                                "target_lang_sense_clarification": "market interest"
                            },
                            {
                                "target_lang_word": "sale",
                                "target_lang_sense_clarification": "the act of selling goods"
                            },
                            {
                                "target_lang_word": "market",
                                "target_lang_sense_clarification": "commercial demand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd78233f-0206-37db-a35b-1284afbe1e07",
                    "sense_definition": "Een bedrag dat van een totaal wordt afgehaald, vaak in de context van belastingen of kosten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vermindering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De belastingaangifte biedt verschillende mogelijkheden voor <w>aftrek</w> van bepaalde zakelijke kosten.",
                            "target_lang_translations": {
                                "en": "The tax return offers various possibilities for the <w>deduction</w> of certain business expenses."
                            }
                        },
                        {
                            "text": "Na <w>aftrek</w> van de gemaakte onkosten bleef er helaas weinig winst over voor de ondernemer.",
                            "target_lang_translations": {
                                "en": "After <w>deducting</w> the incurred expenses, unfortunately little profit remained for the entrepreneur."
                            }
                        }
                    ],
                    "synonyms": [
                        "korting",
                        "reductie",
                        "inhouding"
                    ],
                    "antonyms": [
                        "bijtelling",
                        "toeslag"
                    ],
                    "common_phrases": [
                        "na aftrek van",
                        "aftrek van kosten"
                    ],
                    "target_lang_definitions": {
                        "en": "An amount that is taken off a total, often in the context of taxes or costs."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deduction",
                                "target_lang_sense_clarification": "amount subtracted from a total"
                            },
                            {
                                "target_lang_word": "allowance",
                                "target_lang_sense_clarification": "tax-deductible amount"
                            },
                            {
                                "target_lang_word": "discount",
                                "target_lang_sense_clarification": "reduction in price"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1181baa1-4a82-3fe6-900d-e2f47b289f32",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>aftrekken</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>trek</w> de gemaakte kosten direct <w>aftrek</w> van het totale bedrag op de factuur.",
                            "target_lang_translations": {
                                "en": "I <w>deduct</w> the incurred costs directly from the total amount on the invoice."
                            }
                        },
                        {
                            "text": "Het is belangrijk dat ik dit bedrag <w>aftrek</w> voordat ik de definitieve berekening maak.",
                            "target_lang_translations": {
                                "en": "It is important that I <w>subtract</w> this amount before I make the final calculation."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of the verb 'aftrekken' (to subtract/deduct)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deduct",
                                "target_lang_sense_clarification": "to subtract an amount"
                            },
                            {
                                "target_lang_word": "subtract",
                                "target_lang_sense_clarification": "to take away from a total"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}