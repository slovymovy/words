                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "363f5de6-8304-432b-b176-14de3296844d",
                                "sense_id": "53c6f1b5-77a2-3dde-8778-b04a4076e56a",
                                "text": "Maak een samenvatting van dit boek en lever het volgende week in."
