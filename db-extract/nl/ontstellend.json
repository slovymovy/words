        "nl-extract.jsonl": [
            {
                "entry_id": "a204c897-3d6c-3082-a33e-72d37ac3511b",
                "word": "ontstellend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "022b3eab-616e-3351-8eec-b390fbecd4bb",
                        "entry_id": "a204c897-3d6c-3082-a33e-72d37ac3511b",
                        "glosses": [
                            "vreselijk op een manier die je nauwelijks kunt geloven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d232ddee-c57e-4d63-882d-4e5e38d01ea2",
                                "sense_id": "022b3eab-616e-3351-8eec-b390fbecd4bb",
                                "text": "Zijn vrouw June barstte in tranen uit tijdens een telefonisch interview. 'Alles wat ons rest, is deze ontstellende moord waarmee me in het reine moeten komen."
                            },
                            {
                                "example_id": "3ce3c6de-2adf-4556-bfec-4260e0291848",
                                "sense_id": "022b3eab-616e-3351-8eec-b390fbecd4bb",
                                "text": "De ontstellende resultaten van het onderzoek moeten er volgens wetenschappers toe leiden dat de perceptie over hoe vaak er geweld tegen vrouwen wordt gebruikt wordt bijgesteld en dat er maatregelen worden genomen om seksueel geweld en verkrachtingen te voorkomen."
                            },
                            {
                                "example_id": "d9e686e9-9e0f-40cc-af70-8b40e94126af",
                                "sense_id": "022b3eab-616e-3351-8eec-b390fbecd4bb",
                                "text": "Pillay veroordeelde de 'ontstellende, wijdverspreide en systematische schending van de mensenrechten in Irak door IS en verwante groeperingen'."
                            }
                        ]
                    }
                ],
