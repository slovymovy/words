                        "sense_id": "45609bf2-ebcc-3b2b-9bd5-0d0cda4e50f1",
                        "entry_id": "6f6cb4f0-2d6f-3c5f-a1f2-ec5139f8a7a4",
                        "glosses": [
                            "A tax rate on property, expressed in mills of the property's value."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ed288e64-97ab-4e4b-9b2f-d44d3ce58baf",
                                "sense_id": "45609bf2-ebcc-3b2b-9bd5-0d0cda4e50f1",
                                "text": "Charter townships are able to levy millage on the residents without a vote of the people."
                            },
                            {
                                "example_id": "9a5ea2a7-e3ec-4ce4-b318-575e0ec98c3d",
                                "sense_id": "45609bf2-ebcc-3b2b-9bd5-0d0cda4e50f1",
                                "text": "In another victory for the DIA [Detroit Institute of Arts], the state legislature rejected a bill yesterday that would have prevented the museum from seeking renewal of an innovative property tax that supports its operations. The millage, which was approved by voters in 2012, is expected to contribute over $23m to the museum over ten years. “We felt strongly that if the DIA decides to go back for a millage at the end of this one, it should be up to the voters to decide, not the state legislature,” [Annmarie] Erickson says."
                            }
                        ]
                    }
