                "senses": [
                    {
                        "sense_id": "157b032b-220a-3e46-a843-11a9a1fcfeba",
                        "entry_id": "53c37cca-40f9-35e3-a32c-f27bd2838fa5",
                        "glosses": [
                            "volstrekt gebruikelijk; niets bijzonders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c35d3925-2b94-4670-ab46-d0d07461d106",
                                "sense_id": "157b032b-220a-3e46-a843-11a9a1fcfeba",
                                "text": "In de VS is het doodnormaal om stagiairs niet te betalen."
                            },
                            {
                                "example_id": "d571796c-5657-4599-b215-58fec609b461",
                                "sense_id": "157b032b-220a-3e46-a843-11a9a1fcfeba",
                                "text": "Hij vertelde me dat dit soort taalgebruik doodnormaal in internetverkeer was."
                            },
                            {
                                "example_id": "371e682a-6e39-4a39-aad6-53c26f016379",
                                "sense_id": "157b032b-220a-3e46-a843-11a9a1fcfeba",
                                "text": "En ik die dacht dat ik iets belangrijks te vertellen had, zei ze op een doodnormale, grappige toon."
                            },
                            {
                                "example_id": "5c1e3ebf-bc7a-44cb-a8ec-851d4f363145",
                                "sense_id": "157b032b-220a-3e46-a843-11a9a1fcfeba",
                                "text": "Dat is geen gemakkelijke opgave, zegt gedragswetenschapper Merkelbach. \"Verandering leidt altijd tot weerstand.\" Zeker bij ingesleten gewoontes zijn veranderingen volgens haar lastig, en fietsen zonder helm is voor Nederlanders doodnormaal."
                            }
                        ]
                    }
