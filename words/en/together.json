                                "nl": "We gingen vele jaren <w>samen</w> naar school.",
                                "pl": "Chodziliśmy <w>razem</w> do szkoły przez wiele lat.",
                                "de": "Wir gingen viele Jahre lang <w>zusammen</w> zur Schule.",
                                "fr": "Nous sommes allés à l'école <w>ensemble</w> pendant de nombreuses années.",
                                "it": "Siamo andati a scuola <w>insieme</w> per molti anni.",
                                "cs": "Chodili jsme do školy <w>spolu</w> po mnoho let.",
                                "tr": "Uzun yıllar okula <w>birlikte</w> gittik.",
                                "es": "Fuimos a la escuela <w>juntos</w> durante muchos años.",
                                "zh": "我们<w>一起</w>上学很多年了。"
                            }
                        },
                        {
                            "text": "The whole family ate dinner <w>together</w> at the table.",
                            "target_lang_translations": {
                                "ru": "Вся семья ужинала <w>вместе</w> за столом.",
                                "nl": "Het hele gezin at <w>samen</w> aan tafel.",
                                "pl": "Cała rodzina jadła obiad <w>razem</w> przy stole.",
                                "de": "Die ganze Familie aß <w>gemeinsam</w> am Tisch zu Abend.",
                                "fr": "Toute la famille a dîné <w>ensemble</w> à table.",
                                "it": "Tutta la famiglia ha cenato <w>insieme</w> a tavola.",
                                "cs": "Celá rodina večeřela <w>společně</w> u stolu.",
                                "tr": "Bütün aile masada <w>beraber</w> akşam yemeği yedi.",
                                "es": "Toda la familia cenó <w>junta</w> en la mesa.",
                                "zh": "全家人<w>一起</w>在桌边吃晚饭。"
                            }
                        }
