                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "We went hiking in the <w>Dandy</w> over the long weekend.",
                            "target_lang_translations": {
