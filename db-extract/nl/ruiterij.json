                    }
                ],
                "senses": [
                    {
                        "sense_id": "837968bd-03e6-3ddc-8710-f8a2b9ff1b1b",
                        "entry_id": "d2fa3220-d988-3bae-8bdb-e12f299d7770",
                        "glosses": [
                            "een bereden legereenheid"
                        ],
                        "tags": [
                            "paardrijden"
                        ],
                        "examples": [
                            {
                                "example_id": "1c9dee62-c602-48ae-8592-a8ccf72e3277",
                                "sense_id": "837968bd-03e6-3ddc-8710-f8a2b9ff1b1b",
                                "text": "Het aantrekkelijke in de Drentsche geschiedenis is, dat de oude Landschap Drenthe steeds een eigen wereldje heeft gevormd, ingesloten tusschen de paludes inaccessibiles, den rand van zóó ontoegankelijke veenen, dat naar men zegt vóór Prins Maurits geen ruiterij erin geslaagd is, Drenthe buiten de ‘passen’ binnen te rukken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6708bfa3-31ed-4e6d-b95b-d8aeeb99dc4c",
                        "source_entry_id": "d2fa3220-d988-3bae-8bdb-e12f299d7770",
                        "source_sense_id": "837968bd-03e6-3ddc-8710-f8a2b9ff1b1b",
                        "target_lang_word": "Kavallerie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kavallerie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4cc6c3c5-77fc-3673-9774-3bd77846074c",
                                        "entry_id": "2e9e6066-e02a-34d0-a977-7c1f862e71a0",
                                        "glosses": [
                                            "auf Reittieren (meist Pferden) kämpfende Truppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc08a0e2-0f71-4976-9bf1-c2bb7b420976",
                                                "sense_id": "4cc6c3c5-77fc-3673-9774-3bd77846074c",
                                                "text": "Tapfere Ritter, die schwer gepanzerte Kavallerie des Mittelalters, beherrschten die Schlachtfelder Europas bis ins 15. Jahrhundert hinein."
                                            },
                                            {
                                                "example_id": "5451e5ec-a404-4a77-a767-2a402705011f",
                                                "sense_id": "4cc6c3c5-77fc-3673-9774-3bd77846074c",
                                                "text": "„Die Kasernen sind mit Freiwilligen überfüllt, bei der Infanterie und Kavallerie werde ich abgewiesen, ich soll warten, Freiwillige werden nicht mehr eingestellt.“"
                                            },
                                            {
                                                "example_id": "2e521757-56d3-4a2e-8910-ea2723049fcf",
                                                "sense_id": "4cc6c3c5-77fc-3673-9774-3bd77846074c",
                                                "text": "„In der Mitte dieser Ebene erhob sich eine riesige Staubwolke, wie sie nur von einer großen Truppe Kavallerie stammen konnte!“"
                                            },
                                            {
                                                "example_id": "4003e2d0-09ef-45fe-8929-bc29425857c9",
                                                "sense_id": "4cc6c3c5-77fc-3673-9774-3bd77846074c",
                                                "text": "„Es war lange vor dem Ersten Weltkrieg, zu der Zeit, als es noch Kavallerie gab.“"
                                            },
                                            {
                                                "example_id": "8e7200c7-5890-4013-aeb4-27140de8b55d",
                                                "sense_id": "4cc6c3c5-77fc-3673-9774-3bd77846074c",
                                                "text": "„Da kam unter gleichmässigem Hufgetrappel und Waffengeklirr die stattlich anzusehende Kavallerie in ihren gestickten blauen, roten und grünen Uniformen, an der Spitze die farbenleuchtende Regimentsmusik, dann Offiziere und Mannschaften auf Rappen, Füchsen und Schimmeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6962295-a1da-42ea-869b-5fb96309a8ba",
                        "source_entry_id": "d2fa3220-d988-3bae-8bdb-e12f299d7770",
                        "source_sense_id": "837968bd-03e6-3ddc-8710-f8a2b9ff1b1b",
                        "target_lang_word": "Reiterei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reiterei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b50939ad-68e7-3464-ad35-3f73d061fdd0",
                                        "entry_id": "88c3f3c9-96ab-3532-ab87-78fa8ab56355",
                                        "glosses": [
                                            "Militär: berittene Truppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "470af574-82f3-40c3-a8ac-5243c02f4a80",
                                                "sense_id": "b50939ad-68e7-3464-ad35-3f73d061fdd0",
                                                "text": "„Die Pferde seiner Reiterei waren verstreut in der Umgebung untergebracht.“"
                                            },
                                            {
                                                "example_id": "fb9cffa2-b09a-4f70-ae01-614dffe2454d",
                                                "sense_id": "b50939ad-68e7-3464-ad35-3f73d061fdd0",
                                                "text": "„Die Truppen werden wieder aufgestellt, aber nur, um ein Manöver auszuführen: unter Musik und Trommelwirbel zieht das Fußvolk sich zurück und macht den viertausend Mann Reiterei Platz.“"
                                            },
                                            {
                                                "example_id": "db15b6b3-cd5b-4163-bc5c-af2e696a0581",
                                                "sense_id": "b50939ad-68e7-3464-ad35-3f73d061fdd0",
                                                "text": "„Bei den Kämpfen in Italien begegnete er dem Reitergeneral Murat und erreichte es, vom Fußvolk in die Reiterei aufzusteigen.“"
                                            },
                                            {
                                                "example_id": "1182810f-d0c8-41a9-a9f9-881a4bbe50e9",
                                                "sense_id": "b50939ad-68e7-3464-ad35-3f73d061fdd0",
                                                "text": "„Der Bauernkrieg hat bewiesen, dass die Reiterei den meistens bloß mit kurzen Sauspießen bewaffneten aufständischen Fußtruppen weit überlegen war, solange die Reiter diszipliniert operierten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "adfaf296-6cf2-3106-afef-c09a19b2dc0b",
                                        "entry_id": "88c3f3c9-96ab-3532-ab87-78fa8ab56355",
                                        "glosses": [
                                            "ohne Plural: gewohnheitsmäßiges Reiten, vielfaches Reiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa33d6b3-bea6-4993-8efc-8dd81f3057b6",
                                                "sense_id": "adfaf296-6cf2-3106-afef-c09a19b2dc0b",
                                                "text": "Sie hatte schon immer Spaß an der Reiterei."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53b88474-9010-489b-8869-78a6df8cae6a",
                        "source_entry_id": "d2fa3220-d988-3bae-8bdb-e12f299d7770",
                        "source_sense_id": "837968bd-03e6-3ddc-8710-f8a2b9ff1b1b",
                        "target_lang_word": "cavalry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cavalry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41b64dbf-67d3-3447-a1b0-d5de41143717",
                                        "entry_id": "a8713a68-bd74-309a-ad7a-c5b638a1d8dc",
                                        "glosses": [
                                            "The military arm of service that fights while riding horses."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "303b8217-de9a-4521-a564-c74f9b3772c3",
                                                "sense_id": "41b64dbf-67d3-3447-a1b0-d5de41143717",
                                                "text": "Two hundred heavily-armed cavalry rode behind the Audley standard, while close at their heels came the Duke of Lancaster with a glittering train, heralds tabarded with the royal arms riding three deep upon cream-colored chargers in front of him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9290c470-9b0f-33b8-be8e-24dfdf5cf82e",
                                        "entry_id": "a8713a68-bd74-309a-ad7a-c5b638a1d8dc",
                                        "glosses": [
                                            "An individual unit of this arm of service."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "734744b5-846f-3b06-8022-069a18874778",
                                        "entry_id": "a8713a68-bd74-309a-ad7a-c5b638a1d8dc",
                                        "glosses": [
                                            "The branch of the military transported by fast light vehicles, also known as mechanized cavalry."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
