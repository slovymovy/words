                    {
                        "form_id": "90eed019-af1d-4564-938b-566161ee5424",
                        "entry_id": "21d6a259-9aa0-3490-9b56-fdc41e088737",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Löwinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0728b571-c97c-3895-aeb9-9b997d62d548",
                        "entry_id": "21d6a259-9aa0-3490-9b56-fdc41e088737",
                        "glosses": [
                            "weiblicher Löwe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4592a306-22d7-4c56-b4c4-fe1bb21676f8",
                                "sense_id": "0728b571-c97c-3895-aeb9-9b997d62d548",
                                "text": "Die Beute wird meistens von den Löwinnen erlegt."
                            },
                            {
                                "example_id": "eff94353-1b89-417e-8230-4afdd361242f",
                                "sense_id": "0728b571-c97c-3895-aeb9-9b997d62d548",
                                "text": "„Im Wiener Tiergarten Schönbrunn setzt man bei den Löwen auf dauerhafte Geburtenkontrolle. Dies teilte Zoodirektorin Dagmar Schratter am Montag auf APA-Nachfrage mit: Die drei Löwinnen seien kastriert, den letzten Nachwuchs habe es 2008 gegeben.“"
                            },
                            {
                                "example_id": "1c56fae9-811f-4691-bd18-7667931c7a70",
                                "sense_id": "0728b571-c97c-3895-aeb9-9b997d62d548",
                                "text": "„Der Zoo ließ nach eigenen Angaben nichts unversucht, um die Löwin dennoch an die neuen Babys zu gewöhnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d47bad18-3154-4881-a1bc-c6b2fb0c61c2",
                        "source_entry_id": "21d6a259-9aa0-3490-9b56-fdc41e088737",
                        "source_sense_id": "0728b571-c97c-3895-aeb9-9b997d62d548",
                        "source_sense_description": "weiblicher Löwe",
                        "target_lang_word": "lioness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lioness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96b08dcc-9b0f-387e-a0a1-ba6771eea4d4",
                                        "entry_id": "4cacadcf-f7e2-3b09-ba43-2346f88a44a5",
                                        "glosses": [
                                            "A female lion (animal)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e98ee9-119c-43b9-83ea-6dcc74aa42c3",
                                                "sense_id": "96b08dcc-9b0f-387e-a0a1-ba6771eea4d4",
                                                "text": "Residents on the south-western outskirts of Berlin are being urged to stay indoors after overnight sightings of a “loose, dangerous animal”, suspected to be an escaped lioness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91b599a2-9e52-379a-86f2-27e7ca31cbd1",
                                        "entry_id": "4cacadcf-f7e2-3b09-ba43-2346f88a44a5",
                                        "glosses": [
                                            "A female lion (famous person regarded with interest and curiosity)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14aa7a90-5a7a-40cc-81de-a9002a2661ed",
                                                "sense_id": "91b599a2-9e52-379a-86f2-27e7ca31cbd1",
                                                "text": "The stories were a tremendous success; she was one of the leading lionesses of London literary society."
                                            },
                                            {
                                                "example_id": "21699d92-59c2-448f-ba24-a7e1d7062873",
                                                "sense_id": "91b599a2-9e52-379a-86f2-27e7ca31cbd1",
                                                "text": "The Middlesbrough Labour MP, Stuart Bell, a political and personal friend, said: \"Mo was a lioness both in terms of the Labour party and politics nationally. She cut to the quick with any issue and proved herself a stateswoman of the highest order when seeking to negotiate the Northern Ireland Good Friday agreement."
                                            },
                                            {
                                                "example_id": "2bd164e5-1a8e-488b-84d9-ab4cea4657db",
                                                "sense_id": "91b599a2-9e52-379a-86f2-27e7ca31cbd1",
                                                "text": "The social worker said she talked to her 28-year-old daughter about the battles Feinstein fought so that younger generations of women could dream bigger. “She was a lioness.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d3c7235-89b8-3ce8-bb55-645c5fe8f3c8",
                                        "entry_id": "4cacadcf-f7e2-3b09-ba43-2346f88a44a5",
                                        "glosses": [
                                            "A female visitor to a student at Oxford, especially during commemoration week."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58f22621-31af-4038-9bc9-fd9328394ae4",
                                                "sense_id": "5d3c7235-89b8-3ce8-bb55-645c5fe8f3c8",
                                                "text": "When \"lionesses\" visiting Oxford for the gay doings of commemoration week spend a morning at Merton, they should look out for Antony Wood's mural tablet in the chapel, […]"
                                            },
                                            {
                                                "example_id": "3da21808-e617-4512-bd53-f84ae78b5621",
                                                "sense_id": "5d3c7235-89b8-3ce8-bb55-645c5fe8f3c8",
                                                "text": "\"Now, boys, keep your eyes open, there must be plenty of lionesses about;\" and thus warned, the whole load, including the cornopean player, were on the look-out for lady visitors, profanely called lionesses, all the way up the street."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b887677-535b-48fe-8e3e-b3184a6ccb0f",
                        "source_entry_id": "21d6a259-9aa0-3490-9b56-fdc41e088737",
                        "source_sense_id": "0728b571-c97c-3895-aeb9-9b997d62d548",
                        "source_sense_description": "weiblicher Löwe",
                        "target_lang_word": "lionne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lionne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ce20a61-05a9-3706-8efc-4339ecba48ba",
                                        "entry_id": "8164c3f3-5f87-3082-aca3-c6aa3c52da6c",
                                        "glosses": [
                                            "Femelle du lion (Panthera leo sur Wikispecies )."
                                        ],
                                        "tags": [
                                            "Félinologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "472ba3f0-4db9-4d29-b9aa-bf569d3cb23b",
                                                "sense_id": "1ce20a61-05a9-3706-8efc-4339ecba48ba",
                                                "text": "Une lionne qui défend ses petits est redoutable."
                                            },
                                            {
                                                "example_id": "cd22330a-d849-4d20-94a5-ffcd6fd80caa",
                                                "sense_id": "1ce20a61-05a9-3706-8efc-4339ecba48ba",
                                                "text": "Chère Dʳ Tatiana,\nMa lionne est nymphomane. Chaque fois qu’elle est en chaleur, elle veut faire l’amour au moins toutes les demi-heures, pendant quatre ou cinq jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d763d87b-518c-3e90-8016-e1bc0153cab7",
                                        "entry_id": "8164c3f3-5f87-3082-aca3-c6aa3c52da6c",
                                        "glosses": [
                                            "Femme admirable, voire redoutable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "987e25d8-2318-44ad-a17d-fa9d229e2727",
                                                "sense_id": "d763d87b-518c-3e90-8016-e1bc0153cab7",
                                                "text": "Denise retrouva chez lui, sur une plus grande échelle, ses succès d’amour-propre de la pension ; le monde l’accueillit, l’admira, la vanta, et, grâce à son admirable talent de musicienne, elle fut, dès le premier hiver, la lionne de tous les salons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeda2532-7200-3cb1-a994-2034c56941fd",
                                        "entry_id": "8164c3f3-5f87-3082-aca3-c6aa3c52da6c",
                                        "glosses": [
                                            "Membre féminin du Lions Clubs, d’un Lions club."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc7f50ea-3ca5-37e0-a728-9a46f89749a6",
                                        "entry_id": "8164c3f3-5f87-3082-aca3-c6aa3c52da6c",
                                        "glosses": [
                                            "Meuble représentant l’animal du même nom dans les armoiries. Elle se blasonne comme le lion dont elle se distingue par le manque de vilenie. À rapprocher de léopard et lion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd6ef04f-796a-4099-afe2-4b417f2068aa",
                                                "sense_id": "fc7f50ea-3ca5-37e0-a728-9a46f89749a6",
                                                "text": "De gueules à la bande d’argent chargée d’une lionne bondissante de sable, accompagnée d’un soleil mouvant de l’angle senestre du chef et d’une roue de six rayons en pointe, le tout d’or, qui est de Saint-vit → voir illustration « armoiries avec une lionne »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
