                                "example_id": "d3a19d72-1365-4b02-aed3-5bc9631485cc",
                                "sense_id": "36f23663-44a9-37cd-ac94-2f3cd43761ce",
                                "text": "Yon ribaudred Nagge of Egypt, (Whom Leprosie o're-take) i'th'midst o'th'fight,[…]"
                            },
                            {
                                "example_id": "58a2c115-8bb6-44e1-8235-83a522e02a9d",
                                "sense_id": "36f23663-44a9-37cd-ac94-2f3cd43761ce",
                                "text": "The Censor of Plays, who has a kindly feeling for the inanities of musical comedy and the ribaudred revelries of revue."
                            },
                            {
                                "example_id": "35c7b837-58db-4f5c-95a2-afbc49f21e28",
                                "sense_id": "36f23663-44a9-37cd-ac94-2f3cd43761ce",
                                "text": "We escape from the prison house of Puritanism and hurry to riot with the ribaudred rabble of Comus."
                            }
                        ]
                    }
