                            },
                            {
                                "target_lang_word": "бирюзовый цвет",
                                "target_lang_sense_clarification": "ярко-голубой с зеленым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c70f083a-725c-3283-80fa-94f0e1b30e15",
                    "sense_definition": "The liquid compound <w>water</w>, often used in scientific or pharmaceutical contexts.",
