                        "glosses": [
                            "Any of the various bulbous or cormous flowering plants of the genus Tigridia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e93ec0b-7328-4719-af79-b85354c9b456",
                                "sense_id": "1d06f9bc-254c-3482-bcad-1a7d196ae6ff",
                                "text": "Then there is a corner for tigridias, which are left in through the winter and attached to them, and to the box, back and front."
                            },
                            {
                                "example_id": "097d994c-aa7d-4693-ac9e-9be76a8df7f3",
                                "sense_id": "1d06f9bc-254c-3482-bcad-1a7d196ae6ff",
                                "text": "Plant cannas, tigridias, daylilies, dahlias, glads and lilies, all in shades of red, orange and yellow."
                            },
                            {
                                "example_id": "b1111d46-8a1e-4d9e-8c17-9c2000a4220f",
                                "sense_id": "1d06f9bc-254c-3482-bcad-1a7d196ae6ff",
                                "text": "In the wild, tigridias tend to grow at between 6,000ft and 9,000ft, which makes them relatively hardy."
                            }
                        ]
                    }
