                "senses": [
                    {
                        "sense_id": "7daca785-e3b2-3e69-87a7-62e4709c6969",
                        "entry_id": "68f8c89b-2241-3117-ab6c-94a06e10dec9",
                        "glosses": [
                            "Eigenschaft, spaßig/albern zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d261587-e92f-4b75-96bb-9baf5089aaa6",
                                "sense_id": "7daca785-e3b2-3e69-87a7-62e4709c6969",
                                "text": "In geselliger Runde kann Albernheit gut ankommen."
                            },
                            {
                                "example_id": "60ac1fe0-5afe-47e1-9873-3779a27512d2",
                                "sense_id": "7daca785-e3b2-3e69-87a7-62e4709c6969",
                                "text": "„Die Ruchlosigkeit der Hausmeier empörte sie keineswegs – und sie legten Anquetil beiseite, von der Albernheit seiner Betrachtungen abgestoßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "72c5c84b-639f-379f-bcb4-0c6442bae3a1",
                        "entry_id": "68f8c89b-2241-3117-ab6c-94a06e10dec9",
                        "glosses": [
                            "etwas, das die Eigenschaft [1] aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d83c470b-a18e-4ddd-b52f-ecf771c6a37b",
                                "sense_id": "72c5c84b-639f-379f-bcb4-0c6442bae3a1",
                                "text": "„Wenn ich Albernheiten schwatzte, hörte sie mir aufmerksam zu, und um nicht für dumm zu gelten, lachte sie jedesmal übermäßig.“"
                            },
                            {
                                "example_id": "3f22afbe-0de9-423b-9541-19e6a17fd880",
                                "sense_id": "72c5c84b-639f-379f-bcb4-0c6442bae3a1",
                                "text": "„Solche Albernheiten haben meist mit dem Englischen zu tun.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a802960-6bde-4440-acb0-49473fd391b2",
                        "source_entry_id": "68f8c89b-2241-3117-ab6c-94a06e10dec9",
                        "source_sense_id": "7daca785-e3b2-3e69-87a7-62e4709c6969",
                        "source_sense_description": "Eigenschaft, spaßig/albern zu sein",
                        "target_lang_word": "absurdity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absurdity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a13f5940-913c-319d-b520-c4ef12a05a55",
                                        "entry_id": "ffb13de2-d49a-3675-87c7-7bb3a75a844e",
                                        "glosses": [
                                            "That which is absurd; an absurd action; a logical contradiction."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dcfca8a-036e-4e59-824c-dda6d9b59b65",
                                                "sense_id": "a13f5940-913c-319d-b520-c4ef12a05a55",
                                                "text": "And it is a fact that in these two days the boy had almost talked over his mother, too; had parried all her objections one after another with that indignant good sense which is often the perfection of absurdity …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9cf13f4-52d2-3508-86e6-38759888442e",
                                        "entry_id": "ffb13de2-d49a-3675-87c7-7bb3a75a844e",
                                        "glosses": [
                                            "The quality of being absurd or inconsistent with obvious truth, reason, or sound judgment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50cfa07f-5d19-41ed-aeb3-205547cf21d2",
                                                "sense_id": "c9cf13f4-52d2-3508-86e6-38759888442e",
                                                "text": "The absurdity of the actual idea of an infinite number"
                                            },
                                            {
                                                "example_id": "9dfe674a-42b5-4b6b-bbe3-d7b1df62b52c",
                                                "sense_id": "c9cf13f4-52d2-3508-86e6-38759888442e",
                                                "text": "Neither [Jones][…] nor I (in 1966) could conceive of reducing our \"science\" to the ultimate absurdity of reading Finnish newspapers almost a century and a half old in order to establish \"priority.\""
                                            },
                                            {
                                                "example_id": "5608cf08-f9b8-48e2-abb3-abe60feabfc6",
                                                "sense_id": "c9cf13f4-52d2-3508-86e6-38759888442e",
                                                "text": "There's credit too for highlighting the problems of Manchester's Castlefield Corridor, where he showed the absurdity of building Ordsall Chord to feed more trains into the congested corridor without upgrading the corridor itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bfe2b79-ddea-3a1d-a88e-f999e4669313",
                                        "entry_id": "ffb13de2-d49a-3675-87c7-7bb3a75a844e",
                                        "glosses": [
                                            "Dissonance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a4821ff-2f98-4baa-8fb6-cab8a9946c5d",
                        "source_entry_id": "68f8c89b-2241-3117-ab6c-94a06e10dec9",
