                        "examples": [
                            {
                                "example_id": "6ee65cb0-14a1-456d-9c6a-4973cfcc97d2",
                                "sense_id": "1821fe62-651f-30ed-9c16-7fbadc63b2ee",
                                "text": "Ze schakelde haar karretje wild naar alle hoeken van de gladde vloer... in de achteruit....in een slingerbeweging: alles zo goed mogelijk op het ritme van de muziek."
                            },
                            {
                                "example_id": "93f0961d-3547-4e42-9794-e169233a03f4",
                                "sense_id": "1821fe62-651f-30ed-9c16-7fbadc63b2ee",
                                "text": "Rijbewijzen worden ook ingenomen van mensen die zijn betrapt bij een flits- of trajectcontrole, maar deze cijfers gaan alleen over mensen die door de politie staande zijn gehouden. \"Het gaat dus niet om één slingerbeweging\", zegt Remmerswaal, \"maar om een grote overtreding, waarbij de verkeersveiligheid behoorlijk in gevaar is gekomen. Dan loop je grote kans dat je rijbewijs wordt ingevorderd.\""
                            }
                        ]
                    }
