                        "entry_id": "ad46eb8a-9e24-3068-8c35-5c66382d486d",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "блокба́стерах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8ae78e3-81a7-3529-9dff-8101b990907e",
                        "entry_id": "ad46eb8a-9e24-3068-8c35-5c66382d486d",
                        "glosses": [
                            "крайне популярное и доходное произведение, как правило, фильм или книга"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82556341-0195-447c-ad6d-6295b4eb4982",
                                "sense_id": "d8ae78e3-81a7-3529-9dff-8101b990907e",
                                "text": "В последние годы на студии «Парамаунт» он запустил подряд три блокбастера. ❬…❭ .. первый же фильм «Намёк», престраннейшая лента, принесла .. огромные проценты всем участникам .. Последующие два фильма «Проказа» и «Эвридика, трэйд марк» — новый успех, новые деньги .."
                            },
                            {
                                "example_id": "0caa1d63-dc6e-437f-88eb-51ee8ad18215",
                                "sense_id": "d8ae78e3-81a7-3529-9dff-8101b990907e",
                                "text": "В прежние годы в СССР высокобюджетные западные фильмы, такие, как «Клеопатра», называли боевиками независимо от жанра. После выхода в 1975 году фильма Стивена Спилберга «Челюсти» подобные фильмы, на производство которых потрачены огромные суммы, на Западе .. стали называть блокбастерами, что в буквальном переводе с английского означает «мощная бомба»."
                            },
                            {
                                "example_id": "04b5c700-1e17-49f1-9a66-0aef54c68d2f",
                                "sense_id": "d8ae78e3-81a7-3529-9dff-8101b990907e",
                                "text": ".. в очередной раз Спилберг доказал, что может снимать не только высокобюджетные блокбастеры, но и сделать хорошее, качественное кино за малые деньги."
                            },
                            {
                                "example_id": "f3fb3c63-485f-4777-ae09-9d35cd257a2b",
                                "sense_id": "d8ae78e3-81a7-3529-9dff-8101b990907e",
                                "text": "В 1993 году доля корейских фильмов в итоговых сборах составила всего 15 %. Но в том же году вышел «Сопхенчже» Им Квон Тхэка — первый официальный корейский блокбастер, на который было продано больше миллиона билетов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f72cb47-fa7b-4c3d-a3b9-f72baa1caeba",
