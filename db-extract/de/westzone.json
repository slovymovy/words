                ],
                "senses": [
                    {
                        "sense_id": "6a1f78c4-8269-3f87-84c1-ba83984f98ee",
                        "entry_id": "8bc65d1b-6952-3ed4-b547-c9d2444d3069",
                        "glosses": [
                            "Besatzungszone einer der drei westlichen Besatzungsmächte"
                        ],
                        "tags": [
                            "historisch (nach dem Zweiten Weltkrieg)"
                        ],
                        "examples": [
                            {
                                "example_id": "8eaec8e6-6c81-495c-a72d-c79203d9bbf7",
                                "sense_id": "6a1f78c4-8269-3f87-84c1-ba83984f98ee",
                                "text": "„Statistischer Trost verfing nicht: dass ja die Reparationen aus den Westzonen nur fünf Prozent der gesamten Industriekapazität ausmachten.“"
                            },
                            {
                                "example_id": "32160c1c-7827-4f5a-885d-140ce29a97cc",
                                "sense_id": "6a1f78c4-8269-3f87-84c1-ba83984f98ee",
                                "text": "„Nach der am 21.6.1948 in den drei Westzonen durchgeführten Währungsreform, die zu einem Bruch zwischen der sowjetischen Militäradministration und den übrigen Alliierten führte, setzte die SMA für den 24.6.1948 eine eigene Währungsreform fest, die sowohl die SBZ als auch das gesamte Gebiet von Groß-Berlin einschloss.“"
                            },
                            {
                                "example_id": "244ead98-83d0-4762-a163-e9a7402a0caf",
                                "sense_id": "6a1f78c4-8269-3f87-84c1-ba83984f98ee",
                                "text": "„Denn als Thomas Mann seine Rede in leicht abgeänderter Form ein paar Tage später in Weimar wiederholt, wird er in den Westzonen dafür angefeindet, während die Funktionäre in der Sowjetisch Besetzten Zone alles tun, ihn für sich zu vereinnahmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5c09fd8a-6e0a-3788-bb8d-b187b6ddb886",
                        "entry_id": "8bc65d1b-6952-3ed4-b547-c9d2444d3069",
                        "glosses": [
                            "speziell die französische Besatzungszone"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "71ae4e7a-8698-3146-bfac-f8b995186dd4",
                        "entry_id": "8bc65d1b-6952-3ed4-b547-c9d2444d3069",
                        "glosses": [
                            "westlicher Teilbereich (zum Beispiel eines Landes, einer Insel)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "617819b8-4522-4ca6-bd0a-209e876d2636",
                                "sense_id": "71ae4e7a-8698-3146-bfac-f8b995186dd4",
                                "text": "„In der Westzone der Stadt fanden Wettbewerbe im Kanu, Hockey und Schießen statt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
