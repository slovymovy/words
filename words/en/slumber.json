{
    "word_family": [
        "slumberer",
        "slumberous",
        "slumbery",
        "slumber-party"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "566231f5-6595-3104-83d7-9753798ba987",
                    "sense_definition": "To sleep lightly or to be in a state of quiet rest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sleep_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat would often <w>slumber</w> in the warm patch of sunlight on the living room floor.",
                            "target_lang_translations": {
                                "ru": "Кот часто любил <w>дремать</w> в теплом солнечном пятне на полу в гостиной."
                            }
                        },
                        {
                            "text": "While the city began to <w>slumber</w> peacefully, the night watchman started his long shift.",
                            "target_lang_translations": {
                                "ru": "Пока город начинал мирно <w>почивать</w>, ночной сторож заступил на свою долгую смену."
                            }
                        }
                    ],
                    "synonyms": [
                        "doze",
                        "snooze",
                        "nap"
                    ],
                    "antonyms": [
                        "wake"
                    ],
                    "common_phrases": [
                        "slumber peacefully",
                        "begin to slumber"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Спать легким сном или находиться в состоянии спокойного отдыха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дремать",
                                "target_lang_sense_clarification": "находиться в полусне"
                            },
                            {
                                "target_lang_word": "почивать",
                                "target_lang_sense_clarification": "книжный или поэтический вариант слова 'спать'"
                            },
                            {
                                "target_lang_word": "спать",
                                "target_lang_sense_clarification": "находиться в состоянии сна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fce2b80-b174-3ef3-b0bd-634d89532b6a",
                    "sense_definition": "To be in a state of inactivity, dormancy, or negligence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inactivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient volcano had <w>slumbered</w> for centuries before suddenly showing signs of renewed activity.",
                            "target_lang_translations": {
                                "ru": "Древний вулкан <w>дремал</w> веками, прежде чем внезапно проявил признаки новой активности."
                            }
                        },
                        {
                            "text": "We cannot afford to let our defenses <w>slumber</w> while the threat remains so high.",
                            "target_lang_translations": {
                                "ru": "Мы не можем позволить нашей обороне <w>бездействовать</w>, пока угроза остается столь высокой."
                            }
                        }
                    ],
                    "synonyms": [
                        "dormant",
                        "stagnate"
                    ],
                    "antonyms": [
                        "flourish"
                    ],
                    "common_phrases": [
                        "slumber for centuries"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находиться в состоянии бездействия, покоя или небрежения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дремать",
                                "target_lang_sense_clarification": "переносно: быть в бездействии"
                            },
                            {
                                "target_lang_word": "бездействовать",
                                "target_lang_sense_clarification": "не проявлять активности"
                            },
                            {
                                "target_lang_word": "пребывать в спячке",
                                "target_lang_sense_clarification": "о вулканах или силах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6fd72147-5aa8-3e9e-a3df-2e03179f3417",
                    "sense_definition": "A light, often peaceful sleep.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sleep_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He fell into a deep <w>slumber</w> after the exhausting hike through the mountains.",
                            "target_lang_translations": {
                                "ru": "Он погрузился в глубокий <w>сон</w> после изнурительного похода по горам."
                            }
                        },
                        {
                            "text": "The baby finally drifted into a quiet <w>slumber</w> in her mother's arms.",
                            "target_lang_translations": {
                                "ru": "Младенец наконец погрузился в тихую <w>дремоту</w> на руках у матери."
                            }
                        }
                    ],
                    "synonyms": [
                        "sleep",
                        "nap",
                        "doze"
                    ],
                    "antonyms": [
                        "wakefulness"
                    ],
                    "common_phrases": [
                        "deep slumber",
                        "peaceful slumber",
                        "quiet slumber"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий, часто мирный сон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сон",
                                "target_lang_sense_clarification": "состояние покоя и отдыха"
                            },
                            {
                                "target_lang_word": "дрёма",
                                "target_lang_sense_clarification": "состояние полусна"
                            },
                            {
                                "target_lang_word": "дремота",
                                "target_lang_sense_clarification": "легкий сон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a10a2fd7-f4e3-313d-988f-09eb704d9fb9",
                    "sense_definition": "A period or state of inactivity or lack of awareness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inactivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden economic crisis served to awaken the nation from its long <w>slumber</w>.",
                            "target_lang_translations": {
                                "ru": "Внезапный экономический кризис послужил толчком к пробуждению нации от долгой <w>спячки</w>."
                            }
                        },
                        {
                            "text": "The artist's creativity emerged from a decade-long <w>slumber</w> with a brilliant new collection.",
                            "target_lang_translations": {
                                "ru": "Творческий потенциал художника пробудился после десятилетнего <w>застоя</w> с блестящей новой коллекцией."
                            }
                        }
                    ],
                    "synonyms": [
                        "dormancy",
                        "lethargy"
                    ],
                    "antonyms": [
                        "activity",
                        "awareness"
                    ],
                    "common_phrases": [
                        "awaken from slumber",
                        "aesthetic slumbers"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Период или состояние бездействия или отсутствия осознанности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спячка",
                                "target_lang_sense_clarification": "состояние застоя или покоя"
                            },
                            {
                                "target_lang_word": "сон",
                                "target_lang_sense_clarification": "переносно: застой, отсутствие движения"
                            },
                            {
                                "target_lang_word": "оцепенение",
                                "target_lang_sense_clarification": "состояние неподвижности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}