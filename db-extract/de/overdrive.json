                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overdrive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d74fc7e-fd84-33b8-8dd0-f6e9c51e0040",
                                        "entry_id": "877121b1-fc53-396a-8f49-6dd740dd001e",
                                        "glosses": [
                                            "To drive too hard, or far, or beyond strength."
                                        ],
