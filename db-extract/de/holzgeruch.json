                "senses": [
                    {
                        "sense_id": "af8f626c-1b9c-3f6e-9d48-9636779a7606",
                        "entry_id": "5c9fb75c-a068-3b9a-8d04-e0c8561c8514",
                        "glosses": [
                            "Wahrnehmung des Geruchs, der von geschlagen Holz stammt; veränderlicher natürlicher Eigengeruch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd9b8800-f817-4102-b7a8-35b820dbf9d7",
                                "sense_id": "af8f626c-1b9c-3f6e-9d48-9636779a7606",
                                "text": "„Am Beispiel der Linde stellen wir fest, dass eine Baumart zusätzlich zum nach aussen verströmten, auch einen inneren Duft besitzt, nämlich einen Holzduft - einen Holzgeruch.“"
                            },
                            {
                                "example_id": "b4019ce3-493d-4bc7-bd06-279a1aed9337",
                                "sense_id": "af8f626c-1b9c-3f6e-9d48-9636779a7606",
                                "text": "„ Diese Stoffe werden vom Holz in die Raumluft abgegeben und sind Ursache des typischen Holzgeruchs.“"
                            },
                            {
                                "example_id": "a67c519f-5e3f-494d-9c24-ab207e95e772",
                                "sense_id": "af8f626c-1b9c-3f6e-9d48-9636779a7606",
                                "text": "„In der Werkstatt staubt es und es riecht nach Holz. \"Einige Kunden freuen sich über den Holzgeruch, wenn sie bei uns eine Rodel bestellen\", berichtet Bernhard Lederwasch.“"
                            },
                            {
                                "example_id": "3d62c1b6-7c3c-4861-94a8-ab6a6508e7b4",
                                "sense_id": "af8f626c-1b9c-3f6e-9d48-9636779a7606",
                                "text": "„Damit wurde wissenschaftlich bewiesen, dass der im Allgemeinen als angenehm empfundene Holzgeruch nicht gesundheitsschädlich ist, teilte die HAWK mit, an deren Göttinger Fakultät Naturwissenschaften und Technik Plasmaforscher Viöl seit 1994 tätig ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
