                "senses": [
                    {
                        "sense_id": "c04ab899-2f7a-3b46-8ddf-c638371b6b3b",
                        "entry_id": "b1570d71-7739-3f66-9355-734ff3da2a18",
                        "glosses": [
                            "Arbre de la famille des Rubiacées, dont la fleur a de la ressemblance avec celle du jasmin et dont le fruit, rouge et de la grosseur d’une cerise, contient des grains ou semences qui sont le café."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "256d5e2c-2a41-4f84-8c67-5d8672cac370",
                                "sense_id": "c04ab899-2f7a-3b46-8ddf-c638371b6b3b",
                                "text": "Cela lui avait coûté quatre cent mille francs et plus, car il faut cinq ans pour que les caféiers soient en plein rendement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a5c64ef-0c4d-4e37-846f-fc02d079bb8c",
                        "source_entry_id": "b1570d71-7739-3f66-9355-734ff3da2a18",
                        "source_sense_id": "c04ab899-2f7a-3b46-8ddf-c638371b6b3b",
                        "target_lang_word": "Kaffee",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaffee",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "400df872-bdf3-330d-931d-074fea83cc1d",
                                        "entry_id": "09e5ad62-7aa7-3911-a64b-9926989779a2",
                                        "glosses": [
                                            "anregendes schwarzes Aufgussgetränk"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32530a39-f58f-422b-bae0-a46dd72f6ff0",
                                                "sense_id": "400df872-bdf3-330d-931d-074fea83cc1d",
                                                "text": "Ich trinke eine Tasse Kaffee."
                                            },
                                            {
                                                "example_id": "0bc05716-be1c-4fbf-81c1-58c807c051f9",
                                                "sense_id": "400df872-bdf3-330d-931d-074fea83cc1d",
                                                "text": "„Manchmal setzten wir uns, und dann wurden uns Kaffee und Zigaretten angeboten.“"
                                            },
                                            {
                                                "example_id": "384498a3-ff60-4e66-9ef8-16b15d80e553",
                                                "sense_id": "400df872-bdf3-330d-931d-074fea83cc1d",
                                                "text": "„Mein Kellner bringt Kaffee, Buttersemmeln und Marmelade.“"
                                            },
                                            {
                                                "example_id": "c1bde296-5112-4f93-9548-9e764cc3a32c",
                                                "sense_id": "400df872-bdf3-330d-931d-074fea83cc1d",
                                                "text": "„Der Kaffee war in einer Kanne und der Zucker daneben.“"
                                            },
                                            {
                                                "example_id": "8ff07271-cad2-4833-a0ef-e92b816aac4b",
                                                "sense_id": "400df872-bdf3-330d-931d-074fea83cc1d",
                                                "text": "„Da der schwarze Kaffee die Nerven aufregt, wollte Bouvard auf sein Täßchen verzichten; doch schlief er nach den Mahlzeiten ein, und beim Erwachen bekam er Angst, denn verlängerter Schlaf kündigt den Schlagfluß an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7f814609-9546-3663-aa6f-4a000a977319",
                                        "entry_id": "09e5ad62-7aa7-3911-a64b-9926989779a2",
                                        "glosses": [
                                            "der Kaffeestrauch"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a189a068-ce32-4c5e-a1da-89666d3cf63f",
                                                "sense_id": "7f814609-9546-3663-aa6f-4a000a977319",
                                                "text": "Kaffee wächst in Arabien."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7ffc5789-9513-3811-a08e-b8aef6091440",
                                        "entry_id": "09e5ad62-7aa7-3911-a64b-9926989779a2",
                                        "glosses": [
                                            "Gattungsname des Kaffeestrauchs^([2])"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bf98542-3e4e-49a2-88fd-29781c82cf3f",
                                                "sense_id": "7ffc5789-9513-3811-a08e-b8aef6091440",
                                                "text": "Kaffee wird geerntet."
                                            },
                                            {
                                                "example_id": "8c8b9eb0-4787-4898-97dc-540368e9045d",
                                                "sense_id": "7ffc5789-9513-3811-a08e-b8aef6091440",
                                                "text": "„Eine weiße Oberschicht profitierte vom Handel mit Kaffee, Zucker, Baumwolle und Diamanten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c0e19dcb-3aca-3b98-9f97-05cea28781a2",
                                        "entry_id": "09e5ad62-7aa7-3911-a64b-9926989779a2",
                                        "glosses": [
                                            "Kaffeebohne"
                                        ],
                                        "tags": [
                                            "bohnenförmiger Samen des Kaffeestrauchs^([2]); elliptisch für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4235db96-eea5-4183-9173-22cff31aeb4d",
                                                "sense_id": "c0e19dcb-3aca-3b98-9f97-05cea28781a2",
                                                "text": "Kaffee wird geröstet."
                                            },
                                            {
                                                "example_id": "6a0bc925-759b-4bbd-9d12-5059b62b0b95",
                                                "sense_id": "c0e19dcb-3aca-3b98-9f97-05cea28781a2",
                                                "text": "„Kaffee-Extrakt in fester Form oder in Pastenform darf keine anderen als die durch Extraktion aus Kaffee gewonnenen Bestandteile enthalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1a7ba4f4-561c-3605-8798-184f2f7048fc",
                                        "entry_id": "09e5ad62-7aa7-3911-a64b-9926989779a2",
                                        "glosses": [
                                            "Röstkaffee, Kaffeepulver"
                                        ],
                                        "tags": [
                                            "elliptisch für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8c4c7c5-47ea-4bd4-8a1b-819477463533",
                                                "sense_id": "1a7ba4f4-561c-3605-8798-184f2f7048fc",
                                                "text": "Ich lade zum Kaffee ein."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "37ca45aa-96db-3ed0-9fea-a2dbb133fa6e",
                                        "entry_id": "09e5ad62-7aa7-3911-a64b-9926989779a2",
                                        "glosses": [
                                            "eine zumeist nachmittägliche Zwischenmahlzeit"
                                        ],
