                    {
                        "translation_id": "458f5f57-9632-4fa8-a08c-aae143e35898",
                        "source_entry_id": "066b0394-ce23-3878-800f-61c82876292a",
                        "source_sense_description": "religious disbelief",
                        "target_lang_word": "ongelovigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ongelovigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "43e28a99-dd13-3315-850c-40bb1c82d3be",
                                        "entry_id": "c2b6fef0-06ea-33a1-b7eb-d33a96bd0ccb",
                                        "glosses": [
                                            "het denken en vermoeden dat iets niet kan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29f22418-5224-43eb-b0f5-3686c5ce3578",
                                                "sense_id": "43e28a99-dd13-3315-850c-40bb1c82d3be",
                                                "text": "`Gaat u die aan anderen laten zien?'Richard Anning knikte naar mijn mand, en zijn ongelovigheid gaf de doorslag: ik zou naar iemand op zoek gaan in Axminster, of als het moest zelfs in Exeter. Alles liever dan deze man mijn klandizie te gunnen. Ik wist dat ik hem niet zou mogen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1d4a660-8122-3c3d-8fc9-19121dee9fb4",
                                        "entry_id": "c2b6fef0-06ea-33a1-b7eb-d33a96bd0ccb",
                                        "glosses": [
                                            "het niet geloven in een bepaald opperwezen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b33132e0-b68f-4e56-8a0b-9c81da2ab2b8",
                                                "sense_id": "f1d4a660-8122-3c3d-8fc9-19121dee9fb4",
                                                "text": "“Integratie is een daad van kufr (ongelovigheid, MT) broeder, dus weerhoudt je ervan inshallah. Integratie is namelijk zeggen dat de Nederlandse normen en waarden beter zijn dan die van Allah de Enige Legitieme Wetgever.”"
                                            },
                                            {
                                                "example_id": "e936dac7-d9ca-460b-831d-dabe166eb26c",
                                                "sense_id": "f1d4a660-8122-3c3d-8fc9-19121dee9fb4",
                                                "text": "De invloed van de kerken neemt af, nieuwe Nederlanders komen uit gebieden waar op ongelovigheid een straf staat, ja zelfs de doodstraf, en als je dan omringd wordt door atheïsten met een decadente levenswandel (korte rokken, homoliefde, vrouwenemancipatie), wil je dat kwaad met wortel en tak uitroeien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
