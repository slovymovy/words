                                    },
                                    {
                                        "sense_id": "3a0d66b4-abf8-370e-a2b4-ae3b04779b7f",
                                        "entry_id": "e107856d-aa32-3b6b-aba8-99c50518809c",
                                        "glosses": [
                                            "To name in, or as, a proverb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0add0dcc-14af-4f1a-b2b5-a4a28c2564b1",
                                                "sense_id": "3a0d66b4-abf8-370e-a2b4-ae3b04779b7f",
                                                "text": "Am I not sung and proverbed for a fool / In every street, do they not say, \"How well / Are come upon him his deserts?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ff08357-6186-311c-9fd5-041d6c5e464c",
                                        "entry_id": "e107856d-aa32-3b6b-aba8-99c50518809c",
                                        "glosses": [
                                            "To provide with a proverb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a47f99d-e630-4118-aa17-2d770f7d306e",
                                                "sense_id": "1ff08357-6186-311c-9fd5-041d6c5e464c",
                                                "text": "I am proverbed with a grandsire phrase."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
