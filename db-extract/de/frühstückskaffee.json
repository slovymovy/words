                        "sense_id": "5ca5234a-f4dd-3b93-898b-fb876e072d4e",
                        "entry_id": "64dc567f-093d-3bc5-bd35-c59aa73b9a9e",
                        "glosses": [
                            "Kaffee, der zum Frühstück getrunken wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da9695de-3a4c-47e0-8ad4-639065e53969",
                                "sense_id": "5ca5234a-f4dd-3b93-898b-fb876e072d4e",
                                "text": "„Zum ersten Mal tranken wir unseren Frühstückskaffee ohne Milch und die Jungs mussten auf ihre Nuss-Nugat-Creme verzichten.“"
                            },
                            {
                                "example_id": "e5652d83-6a13-45dc-b2ed-cd791a2a761c",
                                "sense_id": "5ca5234a-f4dd-3b93-898b-fb876e072d4e",
                                "text": "„Das Zimmer ist warm, und in der Luft liegt der Duft von meinem Frühstückskaffee, wahrscheinlich weil ich die Hälfte davon aus Versehen über meinen Schreibtisch geschüttet habe.“"
                            }
                        ],
