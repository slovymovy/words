                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a725ddd-3d4b-4e3a-91e8-e744540d7343",
                                "sense_id": "c19b5c8e-45e0-324a-ae75-202c1c0a56c8",
                                "text": "Dostałem zaproszenie na premierę jakiejś farsy, tytułu jednak nie pamiętam."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "124ff75a-2792-3637-a11f-1dc254b4e1e9",
                        "entry_id": "552554aa-8d51-31d8-b7ff-3be623b186c6",
