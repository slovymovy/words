                            {
                                "target_lang_word": "рези́нка",
                                "target_lang_sense_clarification": "эластичная петля"
                            },
                            {
                                "target_lang_word": "повя́зка",
                                "target_lang_sense_clarification": "на голову или руку"
                            },
                            {
                                "target_lang_word": "кольцо́",
                                "target_lang_sense_clarification": "обручальное"
                            }
