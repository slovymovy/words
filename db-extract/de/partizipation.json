                                        "glosses": [
                                            "Action de participer à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5e54133-93f8-4694-bdbf-c1379b9b10b4",
                                                "sense_id": "2f49f51c-d539-3a79-a099-7c93cf35c223",
                                                "text": "Cela veut précisément dire que des participations ne sont pas réalisées et que des non-participations, en revanche, sont manifestes et déterminantes pour l’objet considéré."
                                            },
                                            {
                                                "example_id": "73086d75-511a-4da9-98ea-c3884bc89b17",
                                                "sense_id": "2f49f51c-d539-3a79-a099-7c93cf35c223",
                                                "text": "Ainsi, même le musicien qui recevait un cachet pour sa participation au bal de la rosière de Trifouilly les Oies, cotisait à la CARBALAS avec son employeur d'un jour."
                                            },
                                            {
                                                "example_id": "3d3777ab-e688-4df0-9622-e2383cd952f6",
                                                "sense_id": "2f49f51c-d539-3a79-a099-7c93cf35c223",
                                                "text": "Cela s’est fait sans ma participation, sans sa participation."
                                            }
                                        ]
