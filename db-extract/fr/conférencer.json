                "senses": [
                    {
                        "sense_id": "0d227c8d-94d1-3977-9d70-f7faef7fe348",
                        "entry_id": "b504cbb2-3ed2-3690-8d4b-c9bae0bc2429",
                        "glosses": [
                            "Faire une conférence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e86f742-2098-4534-9a47-ca3aebeb3f59",
                                "sense_id": "0d227c8d-94d1-3977-9d70-f7faef7fe348",
                                "text": "Mais tout à fait par hasard je me trouvais dans la salle, vendredi soir, et je vous ai entendu conférencer sur ce que vous appelez « l’ortografiә lojikә »."
                            },
                            {
                                "example_id": "b2da5ed7-e0f3-4302-b4d6-736feadab573",
                                "sense_id": "0d227c8d-94d1-3977-9d70-f7faef7fe348",
                                "text": "À écrire une pièce de théâtre ou un livre, à conférencer, à partir en voyage, à répondre à un client, à faire de la musique, à chanter, à travailler, à tout ce que vous faites qui mobilise votre capacité d’invention."
                            }
                        ]
                    }
                ],
