                "senses": [
                    {
                        "sense_id": "26542165-295f-3b64-a0b8-a774db030f31",
                        "entry_id": "7131bcbb-4f50-32cb-8bed-43c863c31afa",
                        "glosses": [
                            "osoba dokonująca recenzji, także zawodowo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc77062d-433b-4222-8d31-bb1f9c2988c0",
                                "sense_id": "26542165-295f-3b64-a0b8-a774db030f31",
                                "text": "Dla mnie jako dla recenzenta bardziej interesujący wydaje się spór niźli pochwały, tym bardziej, że jest się o co spierać."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0b0cacd-f2af-4e9a-a8d0-b489ffed8219",
                        "source_entry_id": "7131bcbb-4f50-32cb-8bed-43c863c31afa",
                        "source_sense_id": "26542165-295f-3b64-a0b8-a774db030f31",
                        "target_lang_word": "critic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "critic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f26c421e-65fb-375a-b8ea-31c7ea1fd7e0",
                                        "entry_id": "418bfa4d-4caa-3823-8cc5-5f81b76c49a6",
                                        "glosses": [
                                            "A person who appraises the works of others."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45c190dc-b515-4540-99e5-6a70612abd9c",
                                                "sense_id": "f26c421e-65fb-375a-b8ea-31c7ea1fd7e0",
                                                "text": "Following its publication, the novel received widespread acclaim from literary critics."
                                            },
                                            {
                                                "example_id": "c3543f8d-5c4f-4545-804d-9b640526baa0",
                                                "sense_id": "f26c421e-65fb-375a-b8ea-31c7ea1fd7e0",
                                                "text": "The opinion of the most skilful critics was, that nothing finer [than Goldsmith's Traveller] had appeared in verse since the fourth book of the Dunciad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c95f868-70cf-384b-8b5d-0de3cab8ae31",
                                        "entry_id": "418bfa4d-4caa-3823-8cc5-5f81b76c49a6",
                                        "glosses": [
                                            "A specialist in judging works of art."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a6141c8-8569-35a0-ab53-76c5fd4293b4",
                                        "entry_id": "418bfa4d-4caa-3823-8cc5-5f81b76c49a6",
                                        "glosses": [
                                            "One who criticizes; a person who finds fault."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df6a32e6-16c2-4fbe-af94-2edb782f9d1f",
                                                "sense_id": "1a6141c8-8569-35a0-ab53-76c5fd4293b4",
                                                "text": "When an author has many beauties consistent with virtue, piety, and truth, let not little critics exalt themselves, and shower down their ill nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33ca416b-ea96-3248-a734-66d6c648ceed",
                                        "entry_id": "418bfa4d-4caa-3823-8cc5-5f81b76c49a6",
                                        "glosses": [
                                            "An opponent."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60ce05a1-535d-3ef2-b874-be6b7dc0d37b",
                                        "entry_id": "418bfa4d-4caa-3823-8cc5-5f81b76c49a6",
                                        "glosses": [
                                            "Obsolete form of critique (“an act of criticism”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cf6e0ba-08dd-4533-868e-87c1cb7e6c6a",
                                                "sense_id": "60ce05a1-535d-3ef2-b874-be6b7dc0d37b",
                                                "text": "Make each day a Critick on the last."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3b15257-5f91-32d2-a607-792cbc75fa00",
                                        "entry_id": "418bfa4d-4caa-3823-8cc5-5f81b76c49a6",
                                        "glosses": [
                                            "Obsolete form of critique (“the art of criticism”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b690dd2-3401-4864-80e1-b0cecf44c07b",
                                                "sense_id": "a3b15257-5f91-32d2-a607-792cbc75fa00",
                                                "text": "And, perhaps, if they were distinctly weighed, and duly considered, they would afford us another sort of logic and critic, than what we have been hitherto acquainted with."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "critic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f7c5177-4c99-341a-b3bd-e36865bc7cf2",
                                        "entry_id": "595f2ee7-32b0-3c6a-97db-137d7a0ef025",
                                        "glosses": [
                                            "To criticise."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
