                        "examples": [
                            {
                                "example_id": "8a3ddc6c-0155-4a04-bafa-992f92e70966",
                                "sense_id": "23149969-d58e-3bb4-8642-90aaff4b439f",
                                "text": "„Holzsplitter flogen umher.“"
                            },
                            {
                                "example_id": "8e90298c-dd16-4be6-b716-fe7c9cf9fce0",
                                "sense_id": "23149969-d58e-3bb4-8642-90aaff4b439f",
                                "text": "„Man treibt ihm kleine Holzsplitter unter die Fingernägel.“"
                            },
                            {
                                "example_id": "ce7694ea-14ab-419a-8b5a-b890cd0fa2ab",
                                "sense_id": "23149969-d58e-3bb4-8642-90aaff4b439f",
                                "text": "„Ein Schuss schlug unweit von meiner Kanone ein und verstreute eine Menge Holzsplitter, die die Hängemattendecken zerfetzten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bca41ab-b59e-4cfb-9817-4a1c453c82f9",
