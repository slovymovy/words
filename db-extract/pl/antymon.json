                        "glosses": [
                            "pierwiastek chemiczny o symbolu Sb i liczbie atomowej 51"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adb82639-b40c-418e-a5cd-eba093460cc6",
                                "sense_id": "f70ae2d3-a958-34cb-bfc4-49547ac36bbe",
                                "text": "Jakie właściwości chemiczne ma antymon?"
                            }
                        ],
