{
    "word_family": [
        "tap",
        "tapper",
        "tapkast",
        "tapbier"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dd521cc2-c010-318f-8e35-f7469fe0ee52",
                    "sense_definition": "Vloeistof uit een vat of leiding laten stromen in een opvangbak zoals een glas of emmer.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vloeistof-verplaatsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kan ik hier een jerrycan water <w>tappen</w>?",
                            "target_lang_translations": {
                                "pl": "Czy mogę tutaj <w>spuścić</w> kanister wody?"
                            }
                        },
                        {
                            "text": "De monteur moest de oude olie uit de motor <w>tappen</w>.",
                            "target_lang_translations": {
                                "pl": "Mechanik musiał <w>spuścić</w> stary olej z silnika."
                            }
                        }
                    ],
                    "synonyms": [
                        "aftappen",
                        "schenken"
                    ],
                    "common_phrases": [
                        "water tappen",
                        "olie tappen"
                    ],
                    "target_lang_definitions": {
                        "pl": "Spuszczanie płynu z pojemnika lub przewodu do naczynia, np. szklanki lub wiadra."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "spuszczać",
                                "target_lang_sense_clarification": "ogólne określenie wypuszczania płynu z naczynia"
                            },
                            {
                                "target_lang_word": "nalewać",
                                "target_lang_sense_clarification": "w kontekście napełniania naczynia płynem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d953877-8180-3e08-9b9c-e9fc0fa3e5a2",
                    "sense_definition": "Een drank, meestal bier, inschenken vanuit een tapinstallatie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vloeistof-verplaatsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De barman kan heel snel een perfect biertje <w>tappen</w>.",
                            "target_lang_translations": {
                                "pl": "Barman potrafi bardzo szybko <w>nalać</w> idealne piwo."
                            }
                        },
                        {
                            "text": "De vrijwilligers hielpen bij het <w>tappen</w> achter de bar tijdens het festival.",
                            "target_lang_translations": {
                                "pl": "Wolontariusze pomagali przy <w>nalewaniu</w> za barem podczas festiwalu."
                            }
                        }
                    ],
                    "synonyms": [
                        "schenken"
                    ],
                    "common_phrases": [
                        "bier tappen",
                        "achter de bar tappen"
                    ],
                    "target_lang_definitions": {
                        "pl": "Nalewanie napoju, zazwyczaj piwa, z instalacji barowej (z kranu)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nalewać",
                                "target_lang_sense_clarification": "standardowe określenie serwowania piwa z kranu"
                            },
                            {
                                "target_lang_word": "lać",
                                "target_lang_sense_clarification": "potoczne określenie nalewania piwa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34c159fb-7f5b-3371-9f96-c472d6395095",
                    "sense_definition": "Het sap van bomen laten uitvloeien voor consumptie of verwerking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vloeistof-verplaatsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het voorjaar gaan de boeren in Canada esdoornsiroop <w>tappen</w>.",
                            "target_lang_translations": {
                                "pl": "Wiosną rolnicy w Kanadzie <w>pozyskują</w> syrop klonowy."
                            }
                        },
                        {
                            "text": "Het <w>tappen</w> van rubber uit bomen vereist veel ervaring en geduld.",
                            "target_lang_translations": {
                                "pl": "<w>Pozyskiwanie</w> kauczuku z drzew wymaga dużego doświadczenia i cierpliwości."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sap tappen"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pozyskiwanie soku z drzew poprzez nacinanie pnia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pozyskiwać",
                                "target_lang_sense_clarification": "w kontekście zbierania soku z drzew"
                            },
                            {
                                "target_lang_word": "spuszczać",
                                "target_lang_sense_clarification": "techniczny proces wypływu soku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71c04085-a707-3acb-94fb-510b5f48a140",
                    "sense_definition": "Met een draadtap binnenschroefdraad snijden in een materiaal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technisch-bewerken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gebruik bij het <w>tappen</w> van schroefdraad in aluminium wat spiritus als smeermiddel.",
                            "target_lang_translations": {
                                "pl": "Podczas <w>gwintowania</w> aluminium użyj trochę spirytusu jako środka smarnego."
                            }
                        },
                        {
                            "text": "De technicus moest in het stalen blok een nieuw gat <w>tappen</w>.",
                            "target_lang_translations": {
                                "pl": "Technik musiał <w>nagwintować</w> nowy otwór w stalowym bloku."
                            }
                        }
                    ],
                    "synonyms": [
                        "schroefdraad snijden"
                    ],
                    "common_phrases": [
                        "schroefdraad tappen"
                    ],
                    "target_lang_definitions": {
                        "pl": "Nacinanie gwintu wewnętrznego w materiale za pomocą gwintownika."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "gwintować",
                                "target_lang_sense_clarification": "techniczny termin oznaczający nacinanie gwintu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}