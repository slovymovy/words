{
    "word_family": [
        "abhor",
        "abhorrence",
        "abhorrently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "272ba986-efcf-3912-af94-1a60a9d3744e",
                    "sense_definition": "Inspiring disgust, loathing, or extreme repugnance; utterly detestable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "repugnant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator's actions were considered <w>abhorrent</w> by the international community.",
                            "target_lang_translations": {
                                "ru": "Действия диктатора были признаны международным сообществом <w>чудовищными</w>."
                            }
                        },
                        {
                            "text": "She found the idea of animal cruelty to be an <w>abhorrent</w> practice that must be stopped.",
                            "target_lang_translations": {
                                "ru": "Она считала жестокое обращение с животными <w>омерзительной</w> практикой, которую необходимо прекратить."
                            }
                        }
                    ],
                    "synonyms": [
                        "repugnant",
                        "detestable",
                        "loathsome",
                        "abominable",
                        "revolting"
                    ],
                    "antonyms": [
                        "nonabhorrent",
                        "unabhorrent"
                    ],
                    "common_phrases": [
                        "abhorrent practice",
                        "abhorrent crime",
                        "morally abhorrent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий отвращение, омерзение или крайнюю неприязнь; совершенно отвратительный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвратительный",
                                "target_lang_sense_clarification": "вызывающий отвращение, гадкий"
                            },
                            {
                                "target_lang_word": "омерзительный",
                                "target_lang_sense_clarification": "вызывающий глубокое омерзение"
                            },
                            {
                                "target_lang_word": "гнусный",
                                "target_lang_sense_clarification": "внушающий отвращение своими качествами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f9ccbd7-7a48-3927-bd4a-ffb202b84d11",
                    "sense_definition": "Contrary, discordant, or strongly opposed to something, such as principles or customs.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "opposed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Such a dishonest proposal is completely <w>abhorrent</w> to our company's core values.",
                            "target_lang_translations": {
                                "ru": "Подобное нечестное предложение совершенно <w>противоречит</w> ключевым ценностям нашей компании."
                            }
                        },
                        {
                            "text": "He expressed some opinions utterly <w>abhorrent</w> to our traditional ways of living.",
                            "target_lang_translations": {
                                "ru": "Он высказал мнения, абсолютно <w>чуждые</w> нашему традиционному укладу жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "contrary",
                        "discordant",
                        "incompatible"
                    ],
                    "common_phrases": [
                        "abhorrent to nature",
                        "abhorrent to reason"
                    ],
                    "target_lang_definitions": {
                        "ru": "Противоречащий, несовместимый или резко противоположный чему-либо (например, принципам или обычаям)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чуждый",
                                "target_lang_sense_clarification": "абсолютно несовместимый с чем-либо"
                            },
                            {
                                "target_lang_word": "противоречащий",
                                "target_lang_sense_clarification": "идущий вразрез с принципами"
                            },
                            {
                                "target_lang_word": "несовместимый",
                                "target_lang_sense_clarification": "не согласующийся с чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7bf6da5-58ae-367f-9014-e902e0730b94",
                    "sense_definition": "Feeling or showing strong dislike, aversion, or abhorrence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feeling_dislike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The citizens, <w>abhorrent</w> of further violence, remained silent during the protests.",
                            "target_lang_translations": {
                                "ru": "Граждане, <w>испытывавшие отвращение</w> к дальнейшему насилию, хранили молчание во время протестов."
                            }
                        },
                        {
                            "text": "He was deeply <w>abhorrent</w> of any form of political corruption.",
                            "target_lang_translations": {
                                "ru": "Он <w>глубоко презирал</w> любые формы политической коррупции."
                            }
                        }
                    ],
                    "synonyms": [
                        "abhorring",
                        "disdainful"
                    ],
                    "common_phrases": [
                        "abhorrent of violence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий или выражающий сильное отвращение, неприязнь или нетерпимость к чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испытывающий отвращение",
                                "target_lang_sense_clarification": "чувствующий глубокую неприязнь"
                            },
                            {
                                "target_lang_word": "питающий отвращение",
                                "target_lang_sense_clarification": "относящийся с крайним неприятием"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}