                        "examples": [
                            {
                                "example_id": "3dc82a59-2985-4ab7-ae05-92bb70da1fc6",
                                "sense_id": "ec111f2d-9802-3ae0-9891-3a790d71d1d6",
                                "text": "In Australien gibt es gute Surferinnen."
                            },
                            {
                                "example_id": "f812ddd0-c0be-4814-823c-b0f5d718fca7",
                                "sense_id": "ec111f2d-9802-3ae0-9891-3a790d71d1d6",
                                "text": "„Für Surferinnen in Marokko und ganz Afrika gibt es keinen Markt, das Leben als Profisportlerin ist schwer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bb56c2ff-278a-3944-9ccf-b7469d7c78d0",
                        "entry_id": "d9d5494a-942a-3937-ab22-9db681260d3d",
