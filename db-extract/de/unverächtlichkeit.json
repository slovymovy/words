                "senses": [
                    {
                        "sense_id": "91407e6b-204e-3e5b-ab44-67345e72ed2e",
                        "entry_id": "28d12a93-3900-3989-9134-6ae757d365a8",
                        "glosses": [
                            "Eigenschaft, Respekt zu verdienen, nicht zu verachten zu sein"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e9326a4c-fd97-41f2-aa8e-88a670bbd8cf",
                                "sense_id": "91407e6b-204e-3e5b-ab44-67345e72ed2e",
                                "text": "„In der Kunst bestand eine Unverächtlichkeit des Sinnlichen.“"
                            },
                            {
                                "example_id": "e88a27d1-a614-4c2d-8995-3f7ac6d6ddd7",
                                "sense_id": "91407e6b-204e-3e5b-ab44-67345e72ed2e",
                                "text": "„Die Eindeutigkeit, Bestimmtheit und die Unverächtlichkeit einer solchen Wahrheit und ihrer Verbreitung sind gerechtfertigt durch die Eindeutigkeit der politischen Frontstellung.“"
                            },
                            {
                                "example_id": "cc4281c6-c833-4863-b527-d4b887149db1",
                                "sense_id": "91407e6b-204e-3e5b-ab44-67345e72ed2e",
                                "text": "„Gleichwohl hält auch sie an der Zulässigkeit und Unverächtlichkeit der Metaphysik fest.“"
                            },
                            {
                                "example_id": "414f0e6e-e095-461b-90f9-f7cd97b35463",
                                "sense_id": "91407e6b-204e-3e5b-ab44-67345e72ed2e",
                                "text": "„In dieser Lage dürfen Vermutungen Unverächtlichkeit beanspruchen, eine ‚Kunst der Vermutung‘ im Sinne des Nikolaus von Kues wäre heute an ihrem Platze.“"
                            },
                            {
                                "example_id": "009005c1-3c94-42ea-a810-ced62e5a9f2f",
                                "sense_id": "91407e6b-204e-3e5b-ab44-67345e72ed2e",
                                "text": "„Daß er es tat, dafür waren Beweis genug seine Wiedergabe gewisser von Kretzschmar übernommener Lehren über die Unverächtlichkeit des Sinnlichen in der Kunst, und nicht nur in dieser […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
