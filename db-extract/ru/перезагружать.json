                        ]
                    },
                    {
                        "translation_id": "65fb4559-a8ca-44a8-a6ba-fbef4fe7b0a3",
                        "source_entry_id": "b1872bd4-168b-3896-bd8a-c95685d93edc",
                        "source_sense_id": "41032062-2fbc-326d-8770-93170399d069",
                        "target_lang_word": "recharger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recharger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb2dde1b-d11a-311e-98ad-b6d21b5e5ca7",
                                        "entry_id": "caa255c6-04a6-39fd-9395-c7ef2ad2c30c",
                                        "glosses": [
                                            "Charger à nouveau de biens ou de marchandises ; augmenter un chargement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3f42cc4-3ec7-4dbf-9c33-8c0b81f67e20",
                                                "sense_id": "bb2dde1b-d11a-311e-98ad-b6d21b5e5ca7",
                                                "text": "On a rechargé ces marchandises sur le même bâtiment."
                                            },
                                            {
                                                "example_id": "305a46c4-72d1-4701-9c1f-e1a6d03721ae",
                                                "sense_id": "bb2dde1b-d11a-311e-98ad-b6d21b5e5ca7",
                                                "text": "On avait déchargé les mulets, il fallut les recharger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c801518-7541-3520-96e1-2cf454120389",
                                        "entry_id": "caa255c6-04a6-39fd-9395-c7ef2ad2c30c",
                                        "glosses": [
                                            "Remettre des projectiles dans une arme à feu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04d962a4-920e-4ff8-a78f-6d3981facf8c",
                                                "sense_id": "7c801518-7541-3520-96e1-2cf454120389",
                                                "text": "Recharger un canon, un fusil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b551339-cc57-399f-9e03-86e866af0c41",
                                        "entry_id": "caa255c6-04a6-39fd-9395-c7ef2ad2c30c",
                                        "glosses": [
                                            "Remettre du combustible dans un foyer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cee95aed-77f2-4e0c-8a37-017c2ae83521",
                                                "sense_id": "7b551339-cc57-399f-9e03-86e866af0c41",
                                                "text": "Il retourna s’asseoir à sa place, roula une cigarette qu’il alluma en même temps qu’il rechargeait le feu, puis, s’étant installé, les deux pieds devant le foyer, il commença d’attendre."
                                            },
                                            {
                                                "example_id": "5346cf6c-ebdf-4411-86ce-9d04c21bc3ef",
                                                "sense_id": "7b551339-cc57-399f-9e03-86e866af0c41",
                                                "text": "Recharger un poêle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89ab33d5-eb47-30cd-b4dd-0675e31c23fe",
                                        "entry_id": "caa255c6-04a6-39fd-9395-c7ef2ad2c30c",
                                        "glosses": [
                                            "Charger à nouveau un appareil fonctionnant sur batterie, avec de l’électricité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5faa03e4-118c-48b9-a817-32c9171e0343",
                                                "sense_id": "89ab33d5-eb47-30cd-b4dd-0675e31c23fe",
                                                "text": "L’origine du sinistre serait liée à une trottinette électrique qui avait été mise à recharger sur une prise de secteur, durant la nuit, et qui a pris feu. L’incendie s’est propagé au véhicule stationné à côté, ainsi qu’à divers matériels et au garage."
                                            },
                                            {
                                                "example_id": "52cfc9b1-07d7-49c6-ac16-1c024bb3c871",
                                                "sense_id": "89ab33d5-eb47-30cd-b4dd-0675e31c23fe",
                                                "text": "Les spécialistes rappelaient aux habitants qu’ils n’avaient plus que quelques minutes pour recharger leurs smartphones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94c0815f-3842-31c7-8773-ba5ef9a6a3a8",
                                        "entry_id": "caa255c6-04a6-39fd-9395-c7ef2ad2c30c",
                                        "glosses": [
                                            "Remettre à niveau un contenu liquide qui manquait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fe2a3cc-efab-4e45-a0f6-27babbeb3772",
                                                "sense_id": "94c0815f-3842-31c7-8773-ba5ef9a6a3a8",
                                                "text": "Les lysimètres sont des dispositifs qui nous permettent d’observer l’infiltration des précipitations dans le sol, jusqu’à atteindre une profondeur où le flux d’eau ne peut plus être repris par la végétation et va donc recharger la nappe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e684252e-41a5-3dad-92e5-f529e5f2fc41",
                                        "entry_id": "caa255c6-04a6-39fd-9395-c7ef2ad2c30c",
                                        "glosses": [
                                            "Remettre de la matière à un objet, là où l'usure l'a faite disparaître."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07db8848-abea-4ce3-9726-59d7d44460dd",
                                                "sense_id": "e684252e-41a5-3dad-92e5-f529e5f2fc41",
                                                "text": "On attaquerait la roche à la masse afin d'épargner les burins, car il n'y avait pas de forge pour les recharger."
                                            },
                                            {
                                                "example_id": "24502f81-8454-45a5-a760-c8ccecc90bec",
                                                "sense_id": "e684252e-41a5-3dad-92e5-f529e5f2fc41",
                                                "text": "Recharger une route, en la rééquipant en pierres, gravier, etc."
                                            },
                                            {
                                                "example_id": "f69425e9-7200-431f-9179-90948b6de499",
                                                "sense_id": "e684252e-41a5-3dad-92e5-f529e5f2fc41",
                                                "text": "Recharger une pioche, un essieu, en y soudant le métal propre à réparer les parties usées, affaiblies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09f4108c-32cc-3a41-9c85-a1d9fc7884fb",
                                        "entry_id": "caa255c6-04a6-39fd-9395-c7ef2ad2c30c",
                                        "glosses": [
                                            "Donner un ordre encore plus pressant."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17c1d158-6c6f-4ba5-a20c-cf43fd159683",
                                                "sense_id": "09f4108c-32cc-3a41-9c85-a1d9fc7884fb",
                                                "text": "Je vous avais chargé et rechargé de l’avertir, et cependant vous n’en avez rien fait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b473b6f0-ec21-3a71-9845-161a58a7d3cb",
                                        "entry_id": "caa255c6-04a6-39fd-9395-c7ef2ad2c30c",
                                        "glosses": [
                                            "Reprendre son fardeau, sa charge."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d373a4d-2efa-4d52-82ae-b1f41b49d637",
                                                "sense_id": "b473b6f0-ec21-3a71-9845-161a58a7d3cb",
                                                "text": "Après s’être reposé un instant, il se rechargea et partit."
                                            },
                                            {
                                                "example_id": "9ba45a64-1fb1-45f3-a958-2668c02c1915",
                                                "sense_id": "b473b6f0-ec21-3a71-9845-161a58a7d3cb",
                                                "text": "Je ne comprends pas : elle aurait dû se recharger, puisque j’ai déjà roulé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
