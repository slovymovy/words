                        {
                            "text": "Мы, <скорее> всего, не успеем на этот поезд.",
                            "target_lang_translations": {
                                "en": "We will <most likely> not make it to this train.",
                                "de": "Wir werden diesen Zug <w>wahrscheinlich</w> nicht mehr erreichen.",
                                "zh": "我们<w>很可能</w>赶不上这趟火车了。",
                                "nl": "We zullen deze trein <w>waarschijnlijk</w> niet halen.",
                                "pl": "My, <w>najprawdopodobniej</w>, nie zdążymy na ten pociąg.",
                                "fr": "Nous n'aurons <w>probablement</w> pas ce train.",
                                "it": "Molto <w>probabilmente</w> non riusciremo a prendere questo treno.",
                                "cs": "My <w>pravděpodobně</w> tento vlak nestihneme.",
                                "tr": "Bu trene <w>büyük ihtimalle</w> yetişemeyeceğiz.",
                                "es": "Lo más <w>probable</w> es que no lleguemos a este tren."
                            }
