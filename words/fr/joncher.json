    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b6826c2-20b5-3c02-a375-c83ec44fae2c",
                    "sense_definition": "Couvrir une surface ou le sol en y étant dispersé en grand nombre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "couvrir_sol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des feuilles mortes <w>jonchaient</w> les allées humides du jardin public après le violent orage."
                        },
                        {
                            "text": "De nombreux débris de verre <w>jonchent</w> le sol à la suite de cet accident."
                        }
                    ],
                    "synonyms": [
                        "encombrer",
                        "parsemer",
                        "tapisser"
                    ],
                    "common_phrases": [
                        "joncher le sol"
                    ]
                },
                {
                    "sense_id": "af49d40a-b81a-35ce-a384-cf08f08abe07",
                    "sense_definition": "Répandre des fleurs, des feuilles ou des branchages sur le sol, particulièrement pour une célébration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "parsemer_fleurs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les villageois aiment <w>joncher</w> les ruelles de branchages pour célébrer cette fête traditionnelle."
                        },
                        {
                            "text": "Les enfants <w>jonchaient</w> l'allée de roses fraîches avant l'arrivée du cortège nuptial."
                        }
                    ],
                    "synonyms": [
                        "semer",
                        "parsemer"
                    ],
                    "common_phrases": [
                        "joncher de fleurs"
                    ]
                }
            ]
        }
    ]
