                    {
                        "translation_id": "2419f667-cc3b-48d3-806f-0ce7e409c430",
                        "source_entry_id": "daedd4dc-faf0-3bd3-a00d-8141aa343568",
                        "source_sense_id": "60c9f634-e1c0-3684-b91b-0d0529e25b8b",
