                        ],
                        "examples": [
                            {
                                "example_id": "b05009cc-161f-45e6-b8e5-b2e8c5dec97e",
                                "sense_id": "5aa17e66-ef54-3405-951c-ba6460b3e992",
                                "text": "He also had a room strewn with the toys of the trade and what-have-you: ropes and ironmongery, buoyancy aid and bagpipes, fetid socks and half-eaten haggises, dumbbells and ski-instructor sweaters."
                            },
                            {
                                "example_id": "428416b6-8c57-410c-a87c-01827d38e08a",
                                "sense_id": "5aa17e66-ef54-3405-951c-ba6460b3e992",
                                "text": "If, by using “ironmongery” – artificial climbing aids – you could overcome any challenge, where was the adventure?"
                            },
                            {
                                "example_id": "a15f27a2-16cc-4705-8a1c-813f086f93bf",
                                "sense_id": "5aa17e66-ef54-3405-951c-ba6460b3e992",
                                "text": "Bolts, pitons (pegs), slings and other assorted ironmongery were used for directly aided climbing."
                            }
                        ]
                    }
