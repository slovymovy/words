                ],
                "senses": [
                    {
                        "sense_id": "adbe9a4a-e88e-3976-9e0a-a5b4749af85d",
                        "entry_id": "de67b4cc-847a-3acf-a35d-84b06be91671",
                        "glosses": [
                            "A dry creek or streambed, a gulch which temporarily or seasonally fills and flows (after sufficient rain)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acc1512a-a11c-4864-9fde-db02515bd29a",
                                "sense_id": "adbe9a4a-e88e-3976-9e0a-a5b4749af85d",
                                "text": "Across the field were the tents, and beyond them the brown cottonfields that stretched out of sight to the brown arroyo foothills and then the snow-capped Sierras in the morning air."
                            }
                        ]
                    },
                    {
                        "sense_id": "145ff08c-4d9f-3f5d-909c-cdac24b7442e",
                        "entry_id": "de67b4cc-847a-3acf-a35d-84b06be91671",
                        "glosses": [
                            "Any watercourse; any rivulet (whether it flows year-round or only seasonally)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42b68739-81e7-4471-aa62-3895f330de58",
                        "source_entry_id": "de67b4cc-847a-3acf-a35d-84b06be91671",
                        "source_sense_description": "creek which only seasonally flows",
                        "target_lang_word": "cadereau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cadereau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64c748bc-e951-39c2-9035-79863f1e45b9",
                                        "entry_id": "f4fa75a4-59c4-34cf-bb93-c6462ae16831",
                                        "glosses": [
                                            "Ruisseau généralement à sec, et qui reçoit l’eau pluviale lors des orages."
                                        ],
                                        "tags": [
                                            "Provence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "846596f6-0869-49cc-8091-a9bfb39d628c",
                                                "sense_id": "64c748bc-e951-39c2-9035-79863f1e45b9",
                                                "text": "Or, dès sa sortie du bassin de réception, le cadereau d’Alès s’est trouvé bloqué par un premier obstacle : le remblai de chemin de fer, haut ici de 3 m."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d5c06de-93f5-4921-b6b0-57ac3dc3bf72",
                        "source_entry_id": "de67b4cc-847a-3acf-a35d-84b06be91671",
                        "source_sense_description": "creek which only seasonally flows",
                        "target_lang_word": "Rivier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rivier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5dd83d37-a6f4-3e88-b2a0-af13dc9eb703",
                                        "entry_id": "af960cb4-d8b6-301c-8a6d-fe77883e782d",
                                        "glosses": [
                                            "Fluss (zumeist Steppenfluss) / Trockenlauf mit sandigem Bett (und dessen Überschwemmungsgebiet), der während der Regenzeit Wasser sammelt und ableitet; Trockenfluss"
                                        ],
                                        "tags": [
                                            "Namibia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e7763a8-5e10-47e4-a858-1095ba024b1d",
                                                "sense_id": "5dd83d37-a6f4-3e88-b2a0-af13dc9eb703",
                                                "text": "„Noch größere Hindernisse bieten die Riviere, die z. T. mehrere Male in der Regenzeit Wasser führen und tagelang fließen, » abkommen «, wie der technische Ausdruck heißt.“"
                                            },
                                            {
                                                "example_id": "1ddd878c-da55-4899-9fba-c61799a7adb7",
                                                "sense_id": "5dd83d37-a6f4-3e88-b2a0-af13dc9eb703",
                                                "text": "„Wehe dem Autofahrer, der unvorsichtig in ein laufendes Rivier hineinfahrt! Das mit niegeahnter Schnelligkeit und Wucht heranbrausende Wasser reißt den losen Sand des Flußbettes mit, das Auto verliert jeden Halt, wird mitgerissen, und der Fahrer kann sich glücklich preisen, wenn es ihm gelungen ist, den Wagen noch rechtzeitig zu verlassen.“"
                                            },
                                            {
                                                "example_id": "3e0118e1-5363-440e-b7c1-57f77d42666f",
                                                "sense_id": "5dd83d37-a6f4-3e88-b2a0-af13dc9eb703",
                                                "text": "„Die Riviere Namibias gehören zum Abflusstyp ‚episodisch‘, wenn sie denn überhaupt in Existenz treten, dh, sie sind ausschließlich niederschlagsgespeist.“"
                                            },
                                            {
                                                "example_id": "84de2505-d441-4104-8d5f-e4d7125d23e7",
                                                "sense_id": "5dd83d37-a6f4-3e88-b2a0-af13dc9eb703",
                                                "text": "„Also das Rivier eignet sich nicht gerade zum Übernachten, obwohl keine Flutgefahr besteht, aber es kommt nachts nochall wüst kalte Luft ab.“"
                                            },
                                            {
                                                "example_id": "271febc5-c509-4025-8cba-b4c387d7d83d",
                                                "sense_id": "5dd83d37-a6f4-3e88-b2a0-af13dc9eb703",
                                                "text": "„Direkt am Rivier das durch Omaruru fließt, soll in unmittelbarer Nachbarschaft zum Gelände des Reitervereins Omaruru das geplante Sportzentrum entstehen.“"
                                            },
                                            {
                                                "example_id": "8b0fde41-441f-4d09-bedf-1b24f0a6cf76",
                                                "sense_id": "5dd83d37-a6f4-3e88-b2a0-af13dc9eb703",
                                                "text": "„Ihm zufolge ist das Grundwasser in den Rivieren der Erongo-Region eine dynamische Ressource, die durch Fluten über mehrere Jahrzehnte erneuert wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
