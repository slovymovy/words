                "senses": [
                    {
                        "sense_id": "f46dfcdf-d6f4-3fd0-8630-34bb9259b0e5",
                        "entry_id": "4b15c50e-2558-3a87-ad8d-956c2e934f81",
                        "glosses": [
                            "een wijk van een stad met laagbouwhuizen en relatief veel groen voorzieningen gebouwd voor arbeiders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2751656e-7ee6-4b12-843b-6b8403f2d0af",
                                "sense_id": "f46dfcdf-d6f4-3fd0-8630-34bb9259b0e5",
                                "text": "Initiatiefnemers zijn Reint Laan en Gerard Oude Aarninkhof. Zij vragen om een afgesloten hondenloosloopveld binnen de eigen wijk Tuindorp. Nu moeten zij uitwijken naar de 'drukke' Geerdinksweg, maar dat veldje is niet afgesloten."
                            },
                            {
                                "example_id": "2f6710d4-7034-4eb1-9948-79ff39657807",
                                "sense_id": "f46dfcdf-d6f4-3fd0-8630-34bb9259b0e5",
                                "text": "Speeltuin Tuindorp-Wesselerbrink aan de Vlierstraat heropent vandaag. Het binnenverblijf is fris geschilderd en de speeltuin is helemaal opgeknapt. De speeltuin is een tijdje dicht geweest en gaat zaterdag weer open met veel extra activiteiten. Zaterdag van 12.00 tot 17.00 uur is het feest!"
                            }
                        ]
                    }
