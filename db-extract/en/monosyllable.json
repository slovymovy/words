                "translations": [
                    {
                        "translation_id": "34494d6e-d123-461b-8f1e-eb60ff65d378",
                        "source_entry_id": "75edf806-5d3b-325c-b8cf-83626801faf3",
                        "source_sense_description": "a word of one syllable",
                        "target_lang_word": "monosyllabe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monosyllabe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6713acbb-c7f9-3973-8dc1-daf54142c70b",
                                        "entry_id": "8e2bc91a-3261-3449-9d88-613d23aea7f8",
                                        "glosses": [
                                            "Qui est composé d’une seule syllabe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58935dc4-8f89-4160-a136-0230e5073c98",
                                                "sense_id": "6713acbb-c7f9-3973-8dc1-daf54142c70b",
                                                "text": "C’est un mot monosyllabe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "monosyllabe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0c44f1a-d57d-3d0b-86c0-71ec2ffd68e1",
                                        "entry_id": "99429379-f4e6-3cbd-a597-f7e1ba43a6b7",
                                        "glosses": [
                                            "Mot qui a une seule syllabe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ef63f49-8a9e-4be1-ad96-423f41db34ac",
                                                "sense_id": "a0c44f1a-d57d-3d0b-86c0-71ec2ffd68e1",
                                                "text": "Non, lui dit à l’oreille le gros masque en lui rendant mille railleries pour une par la manière dont il accentua le monosyllabe."
                                            },
                                            {
                                                "example_id": "944d860d-9ade-4222-919e-977618934e1f",
                                                "sense_id": "a0c44f1a-d57d-3d0b-86c0-71ec2ffd68e1",
                                                "text": "Juliette me bouda toute la journée ; lorsque je lui adressais la parole, elle ne me répondait pas, ou se contentait d’articuler, d’une voix brève, des monosyllabes irritants."
                                            },
                                            {
                                                "example_id": "b42e87d3-a88a-43eb-b6c3-2ecc53f25244",
                                                "sense_id": "a0c44f1a-d57d-3d0b-86c0-71ec2ffd68e1",
                                                "text": "J’allais, sans doute, murmurer des paroles inutiles quand un monosyllabe rude rompit le charme :\n« Halte ! »"
                                            },
                                            {
                                                "example_id": "8fd311b4-c2de-4a05-84d3-a8dcc720127c",
                                                "sense_id": "a0c44f1a-d57d-3d0b-86c0-71ec2ffd68e1",
                                                "text": "Pour illustrer de façon spectaculaire ce phénomène, Damourette et Pichon, les illustres auteurs de L'Essai de grammaire de la langue française, observent que le titre du roman de George Sand Elle et lui ne peut être traduit littéralement en hongrois, car elle et lui s'y traduisent par le même mot, le monosyllabe ö."
                                            },
                                            {
                                                "example_id": "13a1015c-5456-4fe8-a4f9-61d12852e21f",
                                                "sense_id": "a0c44f1a-d57d-3d0b-86c0-71ec2ffd68e1",
                                                "text": "C’est un dialogue composé de répliques extrêmement brèves (parfois une monosyllabe) qui s’enchaînent très rapidement."
                                            },
                                            {
                                                "example_id": "dfcafadf-dc97-49e7-96d1-077be1ea9f5e",
                                                "sense_id": "a0c44f1a-d57d-3d0b-86c0-71ec2ffd68e1",
                                                "text": "Mais je ne suis pas un petit sauvage à la Rousseau moi, je suis plutôt du genre rustre qui ne tolère qu’un regard, un souffle ou une monosyllabe d’approbation quand il murmure ses injonctions."
                                            },
                                            {
                                                "example_id": "b1b5cd35-a7c5-4785-9761-f2647750dd42",
                                                "sense_id": "a0c44f1a-d57d-3d0b-86c0-71ec2ffd68e1",
                                                "text": "Selon lui, le premier mot prononcé par l'homme serait la monosyllabe tik («doigt») ou aq'wa («eau»), appartenant à 32 familles de langues et proto-langues reconnues par la majorité des linguistes."
                                            },
                                            {
                                                "example_id": "ae166b44-30e3-4a1c-8088-b9337c69a1e0",
                                                "sense_id": "a0c44f1a-d57d-3d0b-86c0-71ec2ffd68e1",
                                                "text": "Lorsqu'une monosyllabe est composée d'une Consonne initiale et d'une consonne finale sans voyelle la voyelle โ–ะ (au) lui est implicitement associée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5d19d63-b9c5-47aa-a9e8-3022e872dd7f",
                        "source_entry_id": "75edf806-5d3b-325c-b8cf-83626801faf3",
                        "source_sense_description": "a word of one syllable",
                        "target_lang_word": "Einsilbler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einsilbler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b2fbf29-e80b-3afe-bfb0-940f30893f59",
                                        "entry_id": "28cc3beb-d7a1-3a26-91c1-aae5041c9458",
                                        "glosses": [
                                            "Wort, das aus nur einer Silbe besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb18588b-bd03-47c2-a4bd-06c50afbe506",
                                                "sense_id": "1b2fbf29-e80b-3afe-bfb0-940f30893f59",
                                                "text": "Die Einsilbler machen den Kern des Wortschatzes aus."
                                            },
                                            {
                                                "example_id": "76e1cda2-98c6-46eb-b2f4-50f25b945d32",
                                                "sense_id": "1b2fbf29-e80b-3afe-bfb0-940f30893f59",
                                                "text": "Einsilbler sind im Deutschen und in vielen anderen Sprachen die Wörter, die in Texten am häufigsten vorkommen."
                                            },
                                            {
                                                "example_id": "e84e1bb3-c85d-4325-b3d9-e1411db12391",
                                                "sense_id": "1b2fbf29-e80b-3afe-bfb0-940f30893f59",
                                                "text": "„Einsilbler auf /r/ schieben nach dem neu entstandenen Diphthong und vor dem auslautenden /r/ aus Gründen der leichteren Aussprache ein /e/ als Bindevokal (Sproßvokal) ein…“"
                                            },
                                            {
                                                "example_id": "c7f097ac-cf6a-4f5e-a39c-dcaa80354514",
                                                "sense_id": "1b2fbf29-e80b-3afe-bfb0-940f30893f59",
                                                "text": "„Der Anteil der Zweisilbler ist im Gegensatz zum Anteil der Einsilbler relativ stabil.“"
                                            },
                                            {
                                                "example_id": "09b328bc-1bb6-4cd4-8af0-89922ea37e27",
                                                "sense_id": "1b2fbf29-e80b-3afe-bfb0-940f30893f59",
                                                "text": "„Die Luft erzitterte von Hurra-Rufen, eine Woge jener typisch amerikanischen Einsilbler wie hip!, gosh!, zounds!, wow! brach los und überschwemmte den Saal und die Gänge des Hauses.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0558b4c4-7dbe-4adb-8124-e21e49768480",
                        "source_entry_id": "75edf806-5d3b-325c-b8cf-83626801faf3",
                        "source_sense_description": "a word of one syllable",
                        "target_lang_word": "Einsilber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einsilber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dba99a94-9cea-398f-9474-ef9ac9f5e6de",
                                        "entry_id": "a4f4482a-c801-3761-86c3-0bc28093c1ff",
                                        "glosses": [
                                            "Wort, das aus nur einer Silbe besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4152c566-2d11-4584-9039-adb4f21b8f9f",
                                                "sense_id": "dba99a94-9cea-398f-9474-ef9ac9f5e6de",
                                                "text": "„Die kompliziertesten Einsilber ohne interne morphologische Grenze sind Formen wie Strumpf, Pflicht, ernst, Herbst mit drei Konsonanten im Anfangsrand und drei oder vier Konsonanten im Endrand.“"
                                            },
                                            {
                                                "example_id": "eb769253-910e-442c-96a8-0c565bff624a",
                                                "sense_id": "dba99a94-9cea-398f-9474-ef9ac9f5e6de",
                                                "text": "„Hat ein Einsilber nur ein Graphem im Endrand, so wird der Vokal lang gelesen…“"
                                            },
                                            {
                                                "example_id": "57a1e4af-97ce-4ed2-8ce7-e11735aca6e0",
                                                "sense_id": "dba99a94-9cea-398f-9474-ef9ac9f5e6de",
                                                "text": "„So beantwortet Abbildung 1 die Frage, mit wieviel Prozent die Einsilber, Zweisilber, Dreisilber undsoweiter in Werken von Goethe, Rilke, Cäsar und Sallust vorkommen.“"
                                            },
                                            {
                                                "example_id": "977a15c1-d5b4-413c-b2ea-103a28e1de5d",
                                                "sense_id": "dba99a94-9cea-398f-9474-ef9ac9f5e6de",
                                                "text": "„Janet fuhr im Bett hoch, und ihre Worte, lauter Einsilber, kamen ihm wie Streichhölzer vor, die in einer explosiven Umgebung aufflammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
