                        "sense_id": "ffdf5bff-66f5-3735-bfde-59cc3fac739d",
                        "entry_id": "a80a9ef5-43bd-3ed2-a6d9-48ed9906e3f6",
                        "glosses": [
                            "Sensibilisierung der Kamera auf die Farbtemperatur des Lichtes am Aufnahmeort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa230dd9-f066-4033-834e-e83ebdb639e8",
                                "sense_id": "ffdf5bff-66f5-3735-bfde-59cc3fac739d",
                                "text": "„Im Test hat zudem immer wieder der automatische Weißabgleich des Geräts versagt, dabei dürfte es sich aber wohl um ein mit einem Update zu bereinigendes Softwareproblem handeln.“"
                            },
                            {
                                "example_id": "0988e1dd-d648-4fcf-bdbf-4d6ee64972cb",
                                "sense_id": "ffdf5bff-66f5-3735-bfde-59cc3fac739d",
                                "text": "„Haben die eingesetzten Leuchten keine Tageslichttemperatur, muss der Weißabgleich manuell eingestellt werden, damit die Farben korrekt wiedergegeben werden.“"
                            }
                        ],
