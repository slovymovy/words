                        "examples": [
                            {
                                "example_id": "22010e1b-d45c-4aa8-a9a0-514769703687",
                                "sense_id": "5e992c98-5206-3e8e-a0fc-7a5a0120a440",
                                "text": "In den Forderungen der Christlich-Demokratischen Arbeitnehmerschaft (CDA) für das Wahlprogramm steht: „Wir wollen, dass die Familie die Tage nach der Geburt verlässlich gemeinsam verbringen kann. Deshalb werden wir für Väter drei Tage Vaterschaftsurlaub bei Geburt eines Kindes einführen.“"
                            }
                        ]
