                                    {
                                        "sense_id": "16c738c3-e634-3af7-942e-7ff054ab9164",
                                        "entry_id": "2e970d28-7478-3312-b98a-2f692010a328",
                                        "glosses": [
                                            "The time of the shaping of the physical and spiritual world by the ancestors; the events or beliefs connected to these times."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3838507-68bd-4326-ad24-b50571cb42e5",
                                                "sense_id": "16c738c3-e634-3af7-942e-7ff054ab9164",
                                                "text": "The men in this moving mirage of battered vehicles felt they had well and truly followed the Dreaming."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "237bf6d4-35ab-4326-b5d4-bc484408cc4a",
                        "source_entry_id": "67f13342-64c3-307c-8bea-cb4059e80cfd",
                        "source_sense_id": "9b775077-12a9-31a2-86eb-e89cbd050a46",
                        "source_sense_description": "zentraler Begriff/Konzept in der Mythologie der australischen Aborigines",
                        "target_lang_word": "Dreamtime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dreamtime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1518bb8-552d-37eb-99fa-afffd11ad7af",
                                        "entry_id": "3346b5cf-2f5b-358a-813f-1a94e86f558c",
                                        "glosses": [
                                            "The time of the creation of the world, by the ancestors out of their own essence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fa8ba28-5ef9-4e7a-bc0e-95c4cc29878d",
                                                "sense_id": "a1518bb8-552d-37eb-99fa-afffd11ad7af",
                                                "text": "No, Brian Elliott's hobby-horse is not the Jindyworobaks' political links—it is his conviction that they are to be remembered and well respected for their awareness of Aboriginal myth and legend and for their understanding and symbolic poetical use of the alcheringa concept (the Dreamtime myth of the creation of geological Australia and its flora and fauna with the related religious and moral connotations of site-worship and animism) ."
                                            },
                                            {
                                                "example_id": "4a6fd170-df78-4a2a-b300-98486dcf91b4",
                                                "sense_id": "a1518bb8-552d-37eb-99fa-afffd11ad7af",
                                                "text": "The tall slender birds were performing a legendary fight in the Dreamtime story – one that the old law had marked on them forever with a wattle of flaming red skin on the back of their heads."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
