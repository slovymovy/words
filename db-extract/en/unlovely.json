                        "entry_id": "9ebf6446-7452-3b87-bfd7-b9c23cbc1001",
                        "glosses": [
                            "unattractive, ugly"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f3163c3-aca5-4081-830b-9bbc1756f5a9",
                                "sense_id": "05518d3e-9a36-32df-9f5d-aa9cb68bc3d8",
                                "text": "[…] an ocean of dereliction, blackened tenements, public drunkenness, dozens of unlovely skyscrapers, featureless housing schemes. It was as if this was all that Glasgow deserved. And yet the city still had a lot of bazazz."
                            },
                            {
                                "example_id": "6d95a6e0-3208-4bc8-a861-084f18ba4efb",
                                "sense_id": "05518d3e-9a36-32df-9f5d-aa9cb68bc3d8",
                                "text": "Even today Lambeth is a singularly unlovely part of the British capital, jammed anonymously between the great fan of roads and railway lines that take commuters in and out of the city center from the southern counties."
                            },
                            {
                                "example_id": "c4c20acd-802a-46fd-b15c-2dda67b92980",
                                "sense_id": "05518d3e-9a36-32df-9f5d-aa9cb68bc3d8",
                                "text": "Francis's own unlovely tunic, and that of his female colleague Clare, foundress of parallel communities for women, are lovingly preserved and displayed by the nuns of St Clare in Assisi […]"
                            }
                        ]
                    }
                ],
