        "fr-extract.jsonl": [
            {
                "entry_id": "85c1c4e5-d101-3da3-b5cb-aec2c85506bf",
                "word": "Fortin",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7f92ead8-8abe-390a-8435-68c65fa7a39e",
                        "entry_id": "85c1c4e5-d101-3da3-b5cb-aec2c85506bf",
                        "glosses": [
                            "Nom de famille attesté notamment au Québec, en France et en Belgique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d76402e-9d1c-4837-969f-38abaf4f90f3",
                                "sense_id": "7f92ead8-8abe-390a-8435-68c65fa7a39e",
                                "text": "Près de l’embarcadère étaient restés MM. Philidor Blanché et Anatole Fortin, deux rivaux, également disposés à posséder Beauséjour, par contrat dotal s’entend.."
                            },
                            {
                                "example_id": "3427f5c5-d75f-4eaf-9706-b2caa3236b5a",
                                "sense_id": "7f92ead8-8abe-390a-8435-68c65fa7a39e",
                                "text": "Informés de la situation, l’agent Stéphane Fortin et le sergent Jean-Michel Juteau de la Régie intermunicipale de police Richelieu-Saint-Laurent se rendent à cet endroit pour commencer un ratissage."
                            },
                            {
                                "example_id": "e6cc8d20-284f-4c8d-a9d6-5e3761070419",
                                "sense_id": "7f92ead8-8abe-390a-8435-68c65fa7a39e",
                                "text": "Gabriel Fortin ne venait d’ailleurs plus aux fêtes de Noël."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "f43cc3cd-ecf9-3161-9587-d78cea5f277a",
                "word": "fortin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "27d6726f-b657-4c98-a137-c77b1ce710ed",
                        "entry_id": "f43cc3cd-ecf9-3161-9587-d78cea5f277a",
                        "tags": [
                            "plural"
                        ],
                        "form": "fortins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e41938c0-7f53-3ff2-9f4d-814fe27ea229",
                        "entry_id": "f43cc3cd-ecf9-3161-9587-d78cea5f277a",
                        "glosses": [
                            "Petit fort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "310f62d3-57a5-47a5-a552-0cbb8dc83585",
                                "sense_id": "e41938c0-7f53-3ff2-9f4d-814fe27ea229",
                                "text": "[…] et d’ailleurs rien ne serait plus facile que de protéger ces passages par quelques fortins préparés à l’avance."
                            },
                            {
                                "example_id": "3bde33b2-711e-4e10-83b7-3d04d6d2b6fe",
                                "sense_id": "e41938c0-7f53-3ff2-9f4d-814fe27ea229",
                                "text": "À midi, on dépassait le fort abandonné de Tapalquem, premier anneau de cette chaîne de fortins tendue sur la lisière du sud contre les indigènes pillards."
                            },
                            {
                                "example_id": "3af393ac-b85d-4920-85f6-9d1f157855de",
                                "sense_id": "e41938c0-7f53-3ff2-9f4d-814fe27ea229",
                                "text": "Agadem, qu'il ne faut pas confondre avec Agadès, capitale de l'Aïr, est un ancien fortin abandonné, du type classique à cour intérieure, avec bâtiments donnant sur le puits et arcades en forme de cloître ; le fort est en ruine, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1eba35f-8dce-4042-8ea1-dfaf2a9ecd6f",
                        "source_entry_id": "f43cc3cd-ecf9-3161-9587-d78cea5f277a",
                        "source_sense_id": "e41938c0-7f53-3ff2-9f4d-814fe27ea229",
                        "target_lang_word": "pillbox",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pillbox",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7319c4e8-1d16-3fb8-ae95-fa916020f15b",
                                        "entry_id": "efb73cd0-2de2-3cfd-ab27-3937c2530240",
                                        "glosses": [
                                            "A small box in which pills are kept."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7dff050-8402-475a-b00b-03c4e929525f",
                                                "sense_id": "7319c4e8-1d16-3fb8-ae95-fa916020f15b",
                                                "text": "There is a list of possessions auctioned after her death – her pillboxes and playing cards, two silver-mounted ivory lemon-squeezers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "702551f4-9007-3bf1-b818-c404876f6d44",
                                        "entry_id": "efb73cd0-2de2-3cfd-ab27-3937c2530240",
                                        "glosses": [
                                            "A flat, concrete gun emplacement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8bb94e9-4d7e-47f1-a8f4-25233eaa7f28",
                                                "sense_id": "702551f4-9007-3bf1-b818-c404876f6d44",
                                                "text": "It was reported that the Germans had established trench works in front of the pillboxes. The enemy was said to have taken refuge from American fire in the pillboxes, later emerging to take up the trench positions."
                                            },
                                            {
                                                "example_id": "9c78fcb2-44ef-4733-8ccc-773eb8929dae",
                                                "sense_id": "702551f4-9007-3bf1-b818-c404876f6d44",
                                                "text": "Beneath the wide steppe sky women in white kerchiefs were digging trenches and building small pillboxes, looking up now and again in case 'those vermin' were on the wing."
                                            },
                                            {
                                                "example_id": "d46eadfe-8af1-40c8-adca-14dc5caa7585",
                                                "sense_id": "702551f4-9007-3bf1-b818-c404876f6d44",
                                                "text": "\"For the first time in 125 years a powerful enemy was now established across the narrow waters of the English Channel. ... Many people must have been bewildered by the innumerable activities all around them. They could understand the necessity for wiring and mining the beaches, the anti-tank obstacles at the defiles, the concrete pillboxes at the cross-roads, the intrusions into their houses to fill an attic with sandbags, on to their golf-courses or most fertile fields and gardens to burrow out some wide anti-tank ditch.\" So wrote Winston Churchill in Their Finest Hour, published in 1949."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef5d863f-be67-3bc1-9d81-a0ee42239d5a",
                                        "entry_id": "efb73cd0-2de2-3cfd-ab27-3937c2530240",
                                        "glosses": [
                                            "A doctor's carriage."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc4b2222-16b1-4df9-96fb-3c0b950e5002",
                                                "sense_id": "ef5d863f-be67-3bc1-9d81-a0ee42239d5a",
                                                "text": "The doctor generously told him where he lived in a loud and audible manner, gave him half-a-crown, and was about ascending his pill-box, after bidding him call upon him, in a day or two, when a servant in a splendid livery stepped forward from the hotel […]"
                                            },
                                            {
                                                "example_id": "da40f13b-e266-4d27-b1bb-08a6c8740f64",
                                                "sense_id": "ef5d863f-be67-3bc1-9d81-a0ee42239d5a",
                                                "text": "[…] the commercial traveller cuts in and out of the line in the dog-cart that carries his samples; the doctor contrives to be seen there in his pill-box on wheels; the eminent tragedian airs himself in a buggy; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
