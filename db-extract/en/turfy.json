                    }
                ],
                "senses": [
                    {
                        "sense_id": "3ffc4030-e22d-3f25-8b18-473f6f24a09d",
                        "entry_id": "2e7cf876-0ebb-30d5-97dd-52507a9c1077",
                        "glosses": [
                            "Of, pertaining to, or constructed of turf."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b197bb7a-4feb-4a42-8978-d4547ecfe81e",
                                "sense_id": "3ffc4030-e22d-3f25-8b18-473f6f24a09d",
                                "text": "Thy turfy mountains, where live nibbling sheep,"
                            },
                            {
                                "example_id": "efc3ac03-5cc3-4e4f-bcee-89b95fe4295b",
                                "sense_id": "3ffc4030-e22d-3f25-8b18-473f6f24a09d",
                                "text": "The wind still sounds between the hills: and whistles through the grass of the rock. The firs fall from their place. The turfy hut is torn."
                            },
                            {
                                "example_id": "64582c9b-cbd4-400a-bfd2-5365bb6c1eea",
                                "sense_id": "3ffc4030-e22d-3f25-8b18-473f6f24a09d",
                                "text": "“Can you see many long weeds and nettles amongst the graves; or do they look turfy and flowery?”"
                            },
                            {
                                "example_id": "0a80d71d-36ce-4d95-8fe1-9b881513a658",
                                "sense_id": "3ffc4030-e22d-3f25-8b18-473f6f24a09d",
                                "text": "[…] the fields […] were brown, turfy and stiff, these fields where battles of the Hundred Years’ War had been fought,"
                            }
                        ]
                    },
                    {
                        "sense_id": "7e36b4cc-cdcc-324f-8429-a9fa08f9161d",
                        "entry_id": "2e7cf876-0ebb-30d5-97dd-52507a9c1077",
                        "glosses": [
                            "Relating to or involved with horses or horse-racing."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2b1911de-e9ee-4649-ac7a-7d1c599233ca",
                                "sense_id": "7e36b4cc-cdcc-324f-8429-a9fa08f9161d",
                                "text": "When a Frenchman is horsey he never runs the risk of being mistaken for a groom or a jockey, as do his turfy compeers in England."
                            },
                            {
                                "example_id": "1bdbca58-df1c-4f93-8033-5ef550b9b21c",
                                "sense_id": "7e36b4cc-cdcc-324f-8429-a9fa08f9161d",
                                "text": "Good and fearless horse-women themselves, their whole delight seemed to be in the discussion of matters pertaining to the stable; and when meeting any young lady friend from a distance, the first questions were not enquiries after parents, sisters, brothers, or friends: no, nor even the lady-beloved talk of weddings and dress; but the discourse almost invariably took a “turfy” turn, that was, to say the least, unfeminine in the extreme."
                            },
                            {
                                "example_id": "eef86132-9676-4884-b61b-f378648682ae",
                                "sense_id": "7e36b4cc-cdcc-324f-8429-a9fa08f9161d",
                                "text": "Made up with curls, wreaths, wings, white bismuth, and carmine, this hopeful young person soared into so pleasing a Cupid as to constitute the chief delight of the maternal part of the spectators; but, in private, where his characteristics were a precocious cutaway coat and an extremely gruff voice, he became of the Turf, turfy."
                            }
                        ]
                    }
                ],
