                                        "glosses": [
                                            "Schule inklusive Grundschule bis mindestens Klasse 10; weiterführende Schule nach der Grundschule bis mindestens Klasse 10, alternatives System zum dreigliedrigen Schulsystem, danach gymnasiale Oberstufe, Schule führt zu allen Schulabschlüssen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a10af3e4-51ed-4e96-9a0b-890d881b4f95",
                                                "sense_id": "0365c2bb-291c-38fe-96cd-635771d24211",
                                                "text": "Unser Sohn geht auf eine Gesamtschule."
                                            },
                                            {
                                                "example_id": "52e947de-4298-46c2-aa4c-219ba1a4b735",
                                                "sense_id": "0365c2bb-291c-38fe-96cd-635771d24211",
                                                "text": "Sie unterrichtet in der Primarstufe der Gesamtschule und er in der Sekundarstufe 1."
                                            },
                                            {
                                                "example_id": "c7adab0f-a77a-4d15-950d-8e769b36e466",
                                                "sense_id": "0365c2bb-291c-38fe-96cd-635771d24211",
                                                "text": "„Diese Rolle fällt eher den Gesamtschulen und Berufsschulen zu, wie noch zu zeigen sein wird.“"
                                            },
                                            {
                                                "example_id": "82cce056-32b8-4840-a592-9c92d2116d19",
                                                "sense_id": "0365c2bb-291c-38fe-96cd-635771d24211",
                                                "text": "„So sind einige Bundesländer dabei, die Hauptschule ganz abzuschaffen und auf Gesamtschulen zu setzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
