                    {
                        "sense_id": "06a6e567-49ac-3583-9e81-4d8dc259abb5",
                        "entry_id": "38dc8454-b273-3a80-b702-466409efe451",
                        "glosses": [
                            "oorspronkelijk model, eerste model van een product"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aa37aed-376a-4be5-a404-5257f31d3d71",
                                "sense_id": "06a6e567-49ac-3583-9e81-4d8dc259abb5",
                                "text": "Aan dat prototype van die nieuwe auto moest nog heel veel verbeterd worden."
                            },
                            {
                                "example_id": "c558fba6-b04c-47ed-8836-34dae306713b",
                                "sense_id": "06a6e567-49ac-3583-9e81-4d8dc259abb5",
                                "text": "Het zou nog een paar jaar duren voordat hij in gebruik werd genomen, voorlopig bestond hij alleen als prototype (en als bouwmodel bij Wentzels)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "905c6598-3ac6-4196-afc2-9ba068cd7d50",
