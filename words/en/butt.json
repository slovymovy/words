                {
                    "sense_id": "4bd15790-0742-383c-9cd5-ddbdf7b959fc",
                    "sense_definition": "A push, thrust, or sudden blow given with the head.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry goat gave the farmer a painful <w>butt</w> in the leg.",
                            "target_lang_translations": {
                                "ru": "Разозленный козел больно <w>боднул</w> фермера в ногу.",
                                "es": "La cabra enfadada le dio al granjero un doloroso <w>topetazo</w> en la pierna.",
                                "zh": "那只愤怒的山羊狠狠地用头<w>顶</w>了农夫的腿。"
                            }
                        },
                        {
                            "text": "He was disqualified from the match for delivering a head <w>butt</w>.",
                            "target_lang_translations": {
                                "ru": "Его дисквалифицировали с матча за <w>удар головой</w>.",
                                "es": "Fue descalificado del encuentro por dar un <w>cabezazo</w>.",
                                "zh": "他因为用头<w>撞</w>人而被取消了比赛资格。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "head butt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Толчок или резкий удар, нанесенный головой.",
                        "es": "Un empujón o golpe repentino dado con la cabeza.",
                        "zh": "用头撞击的动作。"
                    },
                    "translations": {
