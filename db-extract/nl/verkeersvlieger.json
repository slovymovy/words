                        "sense_id": "95201d4b-c289-3d0f-8844-32a887ef6790",
                        "entry_id": "5312089a-2f4d-3b69-9b83-0a84d206eabd",
                        "glosses": [
                            "piloot bij de burgerluchtvaart"
