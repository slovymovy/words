                        "source_entry_id": "e3124ae9-ffc9-3a27-b76b-e4ae34fbcc4f",
                        "source_sense_id": "5e6efdf0-d298-3a95-ad38-5b56e9d95a67",
                        "source_sense_description": "Musik: Tiefer Halteton zur Begleitung der Melodie",
                        "target_lang_word": "bourdon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bourdon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68ed87e9-cbde-3d6a-af18-69915d3b481c",
                                        "entry_id": "5c8a5449-0dca-3e3a-90b4-c883fbb5b728",
                                        "glosses": [
                                            "Long bâton de pèlerin surmonté d’une gourde, ou d’un ornement en forme de pomme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1ffce13-15e6-40bf-aaa7-137ace379577",
                                                "sense_id": "68ed87e9-cbde-3d6a-af18-69915d3b481c",
                                                "text": "Planter le bourdon quelque part.",
                                                "translation": "(Désuet) Arrêter le pèlerinage, rester sur place et s’installer."
                                            },
                                            {
                                                "example_id": "d3ae61ca-0219-447e-a427-61a73a103c18",
                                                "sense_id": "68ed87e9-cbde-3d6a-af18-69915d3b481c",
                                                "text": "Floris et Mardi-Gras passèrent le reste de la journée à rendre l'espace viable pour le campement. C'était la première fois depuis longtemps qu'ils allaient dormir à bourdon planté."
                                            },
                                            {
                                                "example_id": "e4e0d10f-710f-4db6-8116-4ab167d853c2",
                                                "sense_id": "68ed87e9-cbde-3d6a-af18-69915d3b481c",
                                                "text": "Eh ! lorsque nos pères s’acheminaient pieds nus vers le saint sépulcre, un bourdon à la main, s’informait-on du vœu secret qui les conduisait à la Terre sainte ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a264656f-dded-3219-94c0-60cff4ca6508",
                                        "entry_id": "5c8a5449-0dca-3e3a-90b4-c883fbb5b728",
                                        "glosses": [
                                            "Meuble représentant un bâton de pèlerin dans des armoiries. Il est généralement représenté en pal. Il est préférentiellement qualifié de bourdon de pèlerin dans les blasonnements. À rapprocher de bâton de prieur, bâton prieural, bourdon de pèlerin et crosse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fafe7d3-2677-41dd-968d-8921e8e41693",
                                                "sense_id": "a264656f-dded-3219-94c0-60cff4ca6508",
                                                "text": "De gueules au bourdon d’or, accosté de deux saumons adossés d’argent, qui est de la commune de Bourdonnay de Moselle"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cee4463-8080-374f-a853-a9a688d1e5e1",
                                        "entry_id": "5c8a5449-0dca-3e3a-90b4-c883fbb5b728",
                                        "glosses": [
                                            "Bâton de magicien."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ee98d78-0323-4580-86ee-b6691ef0540f",
                                                "sense_id": "2cee4463-8080-374f-a853-a9a688d1e5e1",
                                                "text": "En réalité, la remise d’un bourdon à un apprenti mage fait d’ordinaire l’objet d’une cérémonie très impressionnante, surtout si le bourdon a appartenu à un mage chevronné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "234cad42-3a5a-3f1b-8b3d-784c728df88c",
                                        "entry_id": "5c8a5449-0dca-3e3a-90b4-c883fbb5b728",
                                        "glosses": [
                                            "Grosse lance creuse utilisée par les chevaliers dans les tournois."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7340e87a-b9d3-374c-b1fd-361522f9376a",
                                        "entry_id": "5c8a5449-0dca-3e3a-90b4-c883fbb5b728",
                                        "glosses": [
                                            "Ganse ou bourrelet inséré dans un biais ou dans une couture formant une ligne brodée en relief."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f701e76a-c41a-40c3-9de4-7672f97d3191",
                                                "sense_id": "7340e87a-b9d3-374c-b1fd-361522f9376a",
                                                "text": "Point de bourdon",
                                                "translation": "point de broderie créant un relief sur le tissu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d0f9871-0c24-3e4f-bf0b-fce14d54c940",
                                        "entry_id": "5c8a5449-0dca-3e3a-90b4-c883fbb5b728",
                                        "glosses": [
                                            "Fil ou paire de fils, plus épais que les autres fils utilisés pour la réalisation de l’ouvrage, destinés à faire ressortir un motif."
                                        ],
                                        "tags": [
                                            "Dentelle"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7263c7f1-d50f-3e23-970a-10bd81481ab6",
                                        "entry_id": "5c8a5449-0dca-3e3a-90b4-c883fbb5b728",
                                        "glosses": [
                                            "Perche de bois faite d’une branche d’arbre dont on a ôté l’écorce."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bourdon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fd28470-d342-3bee-897b-7682bb247403",
                                        "entry_id": "978cc7f7-1c5e-308a-b65e-6550d1a1d3d0",
                                        "glosses": [
                                            "Insectes assez semblables aux abeilles et remarquables par le bourdonnement qu’ils font."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b30ad207-2462-40ed-bd6e-64d7f188bfdc",
                                                "sense_id": "2fd28470-d342-3bee-897b-7682bb247403",
                                                "text": "Un charme profond et tendre émanait des grands arbres, debout dans la lumière. À leurs pieds coulait une pièce de trèfle incarnat, où de gros bourdons bleus erraient, animant les rais de soleil de la vibration chantante de leurs ailes."
                                            },
                                            {
                                                "example_id": "98fa25e3-d973-41b6-a538-ca755e8ea7a7",
                                                "sense_id": "2fd28470-d342-3bee-897b-7682bb247403",
                                                "text": "Le mélampyre des champs a son insecte pollinisateur, un bourdon, le Bombus hortorum, seul en son genre à pénétrer dans l'étroit tube de la corolle pour y rechercher le nectar ; les autres bourdons perforent le tube à sa base."
                                            },
                                            {
                                                "example_id": "c62cfdb6-0116-46cf-8b63-1ff0ba096547",
                                                "sense_id": "2fd28470-d342-3bee-897b-7682bb247403",
                                                "text": "Dans la nature, il arrive que le bourdon porteur de très belles couleurs noires, jaunes et parfois blanches soit confondu avec l’abeille - tous deux sont des apidés - dont il est très proche, aussi bien par la morphologie que par le comportement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07845f86-a1fe-3390-a32a-9ba78c194277",
                                        "entry_id": "978cc7f7-1c5e-308a-b65e-6550d1a1d3d0",
                                        "glosses": [
                                            "Faux bourdon, abeille mâle que les abeilles ouvrières chassent dès que la reine est fécondée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31b4d985-865c-3425-8fc1-a04a19dcb63a",
                                        "entry_id": "978cc7f7-1c5e-308a-b65e-6550d1a1d3d0",
                                        "glosses": [
                                            "Ton qui sert de basse continue dans divers instruments, tels que la vielle, la musette, la cornemuse. → voir faux-bourdon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cecb23d-5d04-4c8e-9b4b-47d8e17b29e8",
                                                "sense_id": "31b4d985-865c-3425-8fc1-a04a19dcb63a",
                                                "text": "D’épaisses colonnes de mouches fumaient comme de la poussière de charbon de la crevasse des rues. Leur bourdon continu établissait une sorte de désert sonore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a71417df-2bd4-3500-a34d-88631aba3843",
                                        "entry_id": "978cc7f7-1c5e-308a-b65e-6550d1a1d3d0",
                                        "glosses": [
                                            "Corde, ou tuyau qui donne ce ton."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9df6dfb-1585-477b-a1a5-d965cdef8145",
                                                "sense_id": "a71417df-2bd4-3500-a34d-88631aba3843",
                                                "text": "Bourdon de vielle",
                                                "translation": "[corde donnant le son grave d’une vielle."
                                            },
                                            {
                                                "example_id": "457b86b6-1f55-4902-8e10-965b5e496a5e",
                                                "sense_id": "a71417df-2bd4-3500-a34d-88631aba3843",
                                                "text": "Bourdon de cornemuse",
                                                "translation": "[tuyau libre d’une cornemuse donnant le son grave."
                                            },
                                            {
                                                "example_id": "01aaf6f2-344e-49b6-b54a-07027f9e2112",
                                                "sense_id": "a71417df-2bd4-3500-a34d-88631aba3843",
                                                "text": "Bourdon d’orgue",
                                                "translation": "[jeu d’orgue à tuyaux bouchés, jouant l’octave inférieure à celle des jeux de même longueur ayant les tuyaux ouverts."
                                            },
                                            {
                                                "example_id": "ea1f5e25-a812-4d58-81f8-ed19beb6859d",
                                                "sense_id": "a71417df-2bd4-3500-a34d-88631aba3843",
                                                "text": "… rien ne lui paraissait plus harmonieux qu’un duo de bombardes soutenu par la ligne arrondie des bourdons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24e996f4-2cf7-3515-b8e8-5dc2f7d9c682",
                                        "entry_id": "978cc7f7-1c5e-308a-b65e-6550d1a1d3d0",
                                        "glosses": [
                                            "Grosse cloche au son très grave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd175bc-629c-42c6-859a-37617263bacd",
                                                "sense_id": "24e996f4-2cf7-3515-b8e8-5dc2f7d9c682",
                                                "text": "Alors ce n’était plus ni le bourdon de Notre-Dame ni Quasimodo, c’était un rêve, un tourbillon, une tempête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc58cf40-eae1-37a3-b15c-2a00962de7cb",
                                        "entry_id": "978cc7f7-1c5e-308a-b65e-6550d1a1d3d0",
                                        "glosses": [
                                            "Le son de cette cloche."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18a3a36c-c716-4879-87e9-4e6a737fd753",
                                                "sense_id": "bc58cf40-eae1-37a3-b15c-2a00962de7cb",
                                                "text": "Les jours de fête, quand le bourdon des cathédrales mettait en joie dès l’aurore le peuple entier, il regardait les habitants sortir de leurs maisons, […]"
                                            },
                                            {
                                                "example_id": "ad5fc442-10ad-48ef-9670-be689d640419",
                                                "sense_id": "bc58cf40-eae1-37a3-b15c-2a00962de7cb",
                                                "text": "Aux alentours et dans les lointains invisibles, les tintements joyeux des clochettes argentines et les bourdons graves des sonneaux indiquaient à Mimile que les autres petits bergers, ainsi que les bergères de son âge rapatriaient comme lui vers l’abreuvoir et vers l’étable leurs troupeaux repus."
                                            },
                                            {
                                                "example_id": "0ee3aaea-e9f9-432f-af99-e81ece820ef6",
                                                "sense_id": "bc58cf40-eae1-37a3-b15c-2a00962de7cb",
                                                "text": "Il s’arrêta au centre de la place Saint-Henri, une vaste zone sillonnée du chemin de fer et de deux voies de tramways, carrefour planté de poteaux noirs et blancs et de barrières de sûreté, clairière de bitume et de neige salie, ouverte entre les clochers, les dômes, à l’assaut des locomotives hurlantes, aux volées de bourdons, aux timbres éraillés des trams et à la circulation incessante de la rue Notre-Dame et de la rue Saint-Jacques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e6e227c-1ce4-3264-a1b8-850d819f0628",
                                        "entry_id": "978cc7f7-1c5e-308a-b65e-6550d1a1d3d0",
                                        "glosses": [
                                            "Mélancolie, idées noires, tristesse, cafard, déprime, spleen."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfe27eeb-2d77-49f8-86ab-3115faec4159",
                                                "sense_id": "8e6e227c-1ce4-3264-a1b8-850d819f0628",
                                                "text": "Seulement, ce soir, j’ai goût à rien. D’avoir parlé, ça m’a donné l’bourdon et j’aimerais mieux m’étourdir ailleurs."
                                            },
                                            {
                                                "example_id": "e0129435-2e08-4c9f-8e64-c830ebfa4efd",
                                                "sense_id": "8e6e227c-1ce4-3264-a1b8-850d819f0628",
                                                "text": "– C’est rien chouettos de passer le réveillon chez soi. À sa place, j’aurais un vache bourdon…"
                                            },
                                            {
                                                "example_id": "f4d1e6e5-031d-404d-ac34-b28b33e08407",
                                                "sense_id": "8e6e227c-1ce4-3264-a1b8-850d819f0628",
                                                "text": "Raymond regarde le ciel, la nuit est encore noire, l’idée que les jours raccourcissent lui fout le bourdon. Un seul remède : cheuler."
                                            },
                                            {
                                                "example_id": "c574bebd-3d21-427b-96aa-d0787a45e112",
                                                "sense_id": "8e6e227c-1ce4-3264-a1b8-850d819f0628",
                                                "text": "Les abeilles ont le bourdon. On sait à quel point le destin de l’humanité est lié a celui des abeilles, alors comment ne pas être inquiet quand on constate que la surmortalité des abeilles atteint en France 30 à 35 %."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bourdon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37409b90-21d0-3346-bd28-53e17082e4a7",
                                        "entry_id": "fb73ed5f-1ebb-3d91-b03b-088ed999b5b7",
                                        "glosses": [
                                            "Omission par un compositeur d’imprimerie d'un ou plusieurs mots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c90dad3-3b7e-444b-acde-ab2cc4843d7f",
                                                "sense_id": "37409b90-21d0-3346-bd28-53e17082e4a7",
                                                "text": "[…] partant, un bon compositeur fait rarement des bourdons, et le meilleur est sans contredit celui qui, outre qu’il ne laisse que peu de coquilles ou de fautes légères à corriger, n’est pas du tout bourdonniste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bourdon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ceb2c1a8-01b7-3764-8be3-265192f24998",
                                        "entry_id": "c2ae454a-9cdf-387e-b60a-b6e3899d7d49",
                                        "glosses": [
                                            "(Sarthe) Sorte de beignet aux pommes, spécialité sarthoise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd7bab2b-5183-4744-a720-875e4c3e2ef4",
                                                "sense_id": "ceb2c1a8-01b7-3764-8be3-265192f24998",
                                                "text": "Les Bourdons ou Douillons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a328e7cc-8597-37df-a38d-bfcb6e9efeed",
                                        "entry_id": "c2ae454a-9cdf-387e-b60a-b6e3899d7d49",
                                        "glosses": [
                                            "Poire qui se récolte en juillet. On dit aussi poire de bourdon ou bourdon musqué. (Note : ce nom est surtout mentionné que dans des ouvrages antérieurs au XXᵉ siècle)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6528f5b5-1f91-4b72-a408-a01f5f5472f1",
                                                "sense_id": "a328e7cc-8597-37df-a38d-bfcb6e9efeed",
                                                "text": "Le bourdon eſt une poire de la fin de Juillet, qui […] reſſemble à-peu-près au Muſcat Robert & n’en eſt guère différent que par la queue, qu’il a plus longue.",
                                                "translation": "Le bourdon est une poire de la fin de juillet qui […] ressemble à peu près au muscat Robert et n’en est guère différent que par la queue, qu’il a plus longue."
                                            }
                                        ]
                                    }
                                ]
