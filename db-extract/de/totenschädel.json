                ],
                "senses": [
                    {
                        "sense_id": "63b2651e-fc37-34c4-a5c2-099a88e56af4",
                        "entry_id": "9c76fea4-59db-346b-ad76-a018e3106d55",
                        "glosses": [
                            "Schädel eines Verstorbenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb0984eb-3a51-447c-b208-a5cdeee45a37",
                                "sense_id": "63b2651e-fc37-34c4-a5c2-099a88e56af4",
                                "text": "„Totenschädel blickten auf sie herab.“"
                            },
                            {
                                "example_id": "c181dead-41b2-49ca-814a-687daeb5aeb4",
                                "sense_id": "63b2651e-fc37-34c4-a5c2-099a88e56af4",
                                "text": "„Das sieht aus wie ein Totenschädel, ohne Fleisch.“"
                            },
                            {
                                "example_id": "ba220272-69d2-450d-8f07-f4c780cb28bf",
                                "sense_id": "63b2651e-fc37-34c4-a5c2-099a88e56af4",
                                "text": "„Umständlich hob Hohenstein den Deckel an und der Exkommissar starrte auf einen in offenbar noch feuchter Erde gebetteten Totenschädel.“"
                            },
                            {
                                "example_id": "3375156c-db18-40e5-91d9-24fafa31f98a",
                                "sense_id": "63b2651e-fc37-34c4-a5c2-099a88e56af4",
                                "text": "„In der Wand war ein leuchtender Stern eingelassen, auf der einen Seite des Tisches lag ein kleiner Teppich mit verschiedenen Emblemen, auf der anderen stand ein Art Altar mit einem Evangelienbuch und einem Totenschädel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16128112-8aa6-462a-9382-d3b99ca6afa0",
                        "source_entry_id": "9c76fea4-59db-346b-ad76-a018e3106d55",
                        "source_sense_id": "63b2651e-fc37-34c4-a5c2-099a88e56af4",
                        "source_sense_description": "Schädel eines Verstorbenen",
                        "target_lang_word": "skull",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skull",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b60129a-d49d-3e9a-87dd-5a7c4a684eb5",
                                        "entry_id": "43f99dd5-ba09-3faf-aa5f-d783e994026a",
                                        "glosses": [
                                            "The main bones of the head considered as a unit; including the cranium, facial bones, and mandible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61ddba08-6746-47d1-bd9e-a4df82cde616",
                                                "sense_id": "1b60129a-d49d-3e9a-87dd-5a7c4a684eb5",
                                                "text": "He was about to roar when, lying among the black sticks and straw under the cliff, he saw a whole skull—perhaps a cow's skull, a skull, perhaps, with the teeth in it. Sobbing, but absent-mindedly, he ran farther and farther away until he held the skull in his arms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11f7f40b-2e00-3484-8531-df2ddd1e4e5c",
                                        "entry_id": "43f99dd5-ba09-3faf-aa5f-d783e994026a",
                                        "glosses": [
                                            "These bones as a symbol for death; death's-head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e76180e-7c01-4f4d-bd1e-c116e05a42fe",
                                                "sense_id": "11f7f40b-2e00-3484-8531-df2ddd1e4e5c",
                                                "text": "Thine are these orbs of light and shade;\n⁠Thou madest Life in man and brute;\n⁠Thou madest Death; and lo, thy foot\nIs on the skull which thou hast made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "333a60ef-d794-3297-a690-424f553ea907",
                                        "entry_id": "43f99dd5-ba09-3faf-aa5f-d783e994026a",
                                        "glosses": [
                                            "The mind or brain."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50643c4a-58ec-4ce0-b163-828db6878dbb",
                                                "sense_id": "333a60ef-d794-3297-a690-424f553ea907",
                                                "text": "My thoughts are flying around in my skull like fireflies in a jar, but all of a sudden I'm unbearably tired and can't stay awake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0743e8f-99fe-3d6d-b1bd-6230ff2f782d",
                                        "entry_id": "43f99dd5-ba09-3faf-aa5f-d783e994026a",
                                        "glosses": [
                                            "A crust formed on the ladle, etc. by the partial cooling of molten metal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ccb8ec03-4db7-3765-8726-4a1ab0ab5c10",
                                        "entry_id": "43f99dd5-ba09-3faf-aa5f-d783e994026a",
                                        "glosses": [
                                            "The crown of the headpiece in armour."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "620faddd-00f8-3e64-a071-6866e9129e7e",
                                        "entry_id": "43f99dd5-ba09-3faf-aa5f-d783e994026a",
                                        "glosses": [
                                            "A shallow bow-handled basket."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f243f54-e467-3c3b-9cea-4c5d6c3d2f4f",
                                        "entry_id": "43f99dd5-ba09-3faf-aa5f-d783e994026a",
                                        "glosses": [
                                            "The head or master of a college."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "047c1cf9-8088-4740-8e92-f7c79cff6518",
                                                "sense_id": "3f243f54-e467-3c3b-9cea-4c5d6c3d2f4f",
                                                "text": "Graduates […] will never forget that majestic stature, that massive brow, that commanding look, as its possessor paced the ante-chapel of his college, or took his seat of presidence among the skulls of Golgotha."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "skull",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35b6c3c5-ad3c-3734-ad5e-f9b4c653e995",
                                        "entry_id": "d4a64dfb-797b-35e1-96f0-f1c5e66d36f9",
                                        "glosses": [
                                            "To hit in the head with a fist, a weapon, or a thrown object."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28e605ed-df01-3f6c-97c8-2657be3df550",
                                        "entry_id": "d4a64dfb-797b-35e1-96f0-f1c5e66d36f9",
                                        "glosses": [
                                            "To strike the top of (the ball)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7105baf6-1014-4e06-b697-862665cdfda6",
                                                "sense_id": "28e605ed-df01-3f6c-97c8-2657be3df550",
                                                "text": "Monte swung so hard at the next ball that he skulled it straight right, into the pond: 8 in, 9 out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fd06704-1caf-3d91-88f8-41ce307302de",
                                        "entry_id": "d4a64dfb-797b-35e1-96f0-f1c5e66d36f9",
                                        "glosses": [
                                            "To drink everything that remains in a glass by upending it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ca7d1dc-f0ed-46ff-b113-aaa377ed5bd4",
                                                "sense_id": "3fd06704-1caf-3d91-88f8-41ce307302de",
                                                "text": "She nearly skulled the next drink and, despite feeling a little woozy, she felt a lot better."
                                            },
                                            {
                                                "example_id": "969e69c8-4656-486e-9125-875321c011dd",
                                                "sense_id": "3fd06704-1caf-3d91-88f8-41ce307302de",
                                                "text": "That was at Jessica Eyre's sixteenth, and while nothing terrible had happened (I had skulled four Lemon Ruskis and fallen asleep in the garden), it was agreed by all that I had embarrassed myself."
                                            },
                                            {
                                                "example_id": "90eda995-fc3e-4b4b-b0ab-264625f2bc5c",
                                                "sense_id": "3fd06704-1caf-3d91-88f8-41ce307302de",
                                                "text": "He lifted his pint to skull what was left, but suddenly the whole thing— the smell of smoke and spilled beer, the flat Glasgow voices, the chiming of the cash register, the clatter of glasses— was somehow too much."
                                            },
                                            {
                                                "example_id": "d864ebb0-eea3-4ca6-a0de-13fa7eb711d6",
                                                "sense_id": "3fd06704-1caf-3d91-88f8-41ce307302de",
                                                "text": "He skulled his drink, set the glass down, then grabbed the bottle and ambled over to the other couch."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "skull",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c0ff191-c005-33fd-bce7-7290568b5675",
                                        "entry_id": "30578142-133a-3b45-bf5e-d67806efb909",
                                        "glosses": [
                                            "Obsolete form of school (“a multitude”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62a6e408-a1f0-4d58-8b6d-a0ba5e33cb63",
                                                "sense_id": "0c0ff191-c005-33fd-bce7-7290568b5675",
                                                "text": "A knavish skull of boys and girls did pelt at him."
                                            },
                                            {
                                                "example_id": "5d774f06-1778-4dde-8ee2-6e35b9a3ffb4",
                                                "sense_id": "0c0ff191-c005-33fd-bce7-7290568b5675",
                                                "text": "These fishs, togither with the old Tunies and the young, called Pelamides, enter in great flotes and skulls, into the sea Pontus, for the sweet food that they there find: and every companie of them hath their fever all leaders and captaines; and before them all, the Maquerels lead the way; which, while they be in the water, have a colour of brimstone; but without, like they be to the rest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
