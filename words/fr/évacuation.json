{
    "word_family": [
        "évacuable",
        "évacuateur",
        "évacuer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88723acf-79fd-30ba-895e-6d81bbc688f1",
                    "sense_definition": "Action de faire quitter un lieu à des personnes pour des raisons de sécurité ou d'urgence.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "securite_urgence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>évacuation</w> immédiate du bâtiment a été ordonnée suite au déclenchement de l'alarme incendie."
                        },
                        {
                            "text": "Les secours organisent l'<w>évacuation</w> sanitaire des blessés vers l'hôpital le plus proche."
                        }
                    ],
                    "synonyms": [
                        "exode",
                        "sortie",
                        "évac"
                    ],
                    "common_phrases": [
                        "évacuation immédiate",
                        "évacuation préventive",
                        "évacuation sanitaire"
                    ]
                },
                {
                    "sense_id": "f641d340-d5d5-31bc-97f9-a701b935168d",
                    "sense_definition": "Action d'enlever, de transporter ou de rejeter hors d'un endroit des matières, déchets ou décombres.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "evacuation_matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>évacuation</w> des déchets industriels doit respecter des normes environnementales très strictes."
                        },
                        {
                            "text": "Les ouvriers ont presque terminé l'<w>évacuation</w> des gravats accumulés sur le chantier."
                        }
                    ],
                    "synonyms": [
                        "élimination",
                        "rejet"
                    ],
                    "common_phrases": [
                        "évacuation des déchets",
                        "évacuation des gravats"
                    ]
                },
                {
                    "sense_id": "9627d84b-13f0-3646-9242-b69abb250cdb",
                    "sense_definition": "Conduit, tuyau ou orifice servant à l'écoulement des eaux usées ou d'autres liquides.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "evacuation_matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>évacuation</w> de la douche est complètement bouchée par des résidus de savon."
                        },
                        {
                            "text": "Il faut vérifier régulièrement l'<w>évacuation</w> des eaux pour éviter toute inondation dans le sous-sol."
                        }
                    ],
                    "synonyms": [
                        "écoulement"
                    ],
                    "common_phrases": [
                        "évacuation des eaux",
                        "évacuation des eaux usées"
                    ]
                },
                {
                    "sense_id": "684e48bc-73e8-37c3-9f2d-7c1b9db9ce9c",
                    "sense_definition": "Retrait militaire ordonné de troupes ou abandon d'une place forte, d'une ville ou d'un territoire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "securite_urgence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le traité de paix stipule l'<w>évacuation</w> des troupes étrangères dans un délai de trois mois."
                        },
                        {
                            "text": "Le général a supervisé l'<w>évacuation</w> de la garnison avant l'arrivée de l'armée ennemie."
                        }
                    ],
                    "synonyms": [
                        "abandon",
                        "départ",
                        "repli"
                    ],
                    "common_phrases": [
                        "évacuation des troupes",
                        "évacuation militaire"
                    ]
                },
                {
                    "sense_id": "a8c22133-7a95-30bf-b63d-b57b15547b13",
                    "sense_definition": "Expulsion ou décharge physiologique hors de l'organisme de matières fécales, d'humeurs ou de sécrétions.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physiologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin prescrit ce traitement pour faciliter l'<w>évacuation</w> intestinale chez le patient alité."
                        },
                        {
                            "text": "Une <w>évacuation</w> gastrique rapide a permis de limiter les effets de l'intoxication alimentaire."
                        }
                    ],
                    "synonyms": [
                        "défécation",
                        "élimination",
                        "expulsion"
                    ],
                    "common_phrases": [
                        "évacuation intestinale"
                    ]
                },
                {
                    "sense_id": "5efea0a7-67d2-3acd-b044-cbd0b903b921",
                    "sense_definition": "Matières organiques et sécrétions rejetées hors du corps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physiologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'infirmière examine attentivement les <w>évacuations</w> du patient pour déceler la présence de sang."
                        },
                        {
                            "text": "Le laboratoire a reçu un échantillon de ses <w>évacuations</w> afin d'effectuer des analyses approfondies."
                        }
                    ],
                    "synonyms": [
                        "déjection"
                    ]
                }
            ]
        }
    ]
}