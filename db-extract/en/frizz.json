                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e73f909a-7891-332a-9025-1baff2e430b2",
                        "entry_id": "fb1e6933-723f-377e-9d33-c52c9a08d9f7",
                        "glosses": [
                            "To curl; to make frizzy."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b9a8e17f-7d23-4ebe-9acc-616d7e991d62",
                                "sense_id": "e73f909a-7891-332a-9025-1baff2e430b2",
                                "text": "with her hair frized short up to her ears"
                            },
                            {
                                "example_id": "c3900ca0-a438-40bf-adea-6d0419ec4506",
                                "sense_id": "e73f909a-7891-332a-9025-1baff2e430b2",
                                "text": "In labour-saving homes, with care, / Their wives frizz out peroxide hair."
                            },
                            {
                                "example_id": "0b3cb2c2-b66f-4864-9dae-e562e75ad45e",
                                "sense_id": "e73f909a-7891-332a-9025-1baff2e430b2",
                                "text": "There was also hairdressing: hairdressing, too, really was hairdressing in those times — no running a comb through it and that was that. It was curled, frizzed, waved, put in curlers overnight, waved with hot tongs; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "606f79eb-6189-321a-8b4a-cba7ad11d09a",
                        "entry_id": "fb1e6933-723f-377e-9d33-c52c9a08d9f7",
                        "glosses": [
                            "To form into little burs, knobs, or tufts, as the nap of cloth."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "317af800-cfb8-3063-969b-be199d62470f",
                        "entry_id": "fb1e6933-723f-377e-9d33-c52c9a08d9f7",
                        "glosses": [
                            "To make (leather) soft and of even thickness by rubbing, as with pumice stone or a blunt instrument."
                        ],
                        "tags": [],
                        "examples": []
                    },
