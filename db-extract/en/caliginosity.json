                                "target_senses": [
                                    {
                                        "sense_id": "8fc2d246-fe82-3cdf-93c9-2b85101a6301",
                                        "entry_id": "4ed2fbcf-ae81-3176-9381-bb9f7444802a",
                                        "glosses": [
                                            "een toestand van weinig of geen verlichting"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07be84d2-2e68-48b3-ac4c-d1be139fa669",
                                                "sense_id": "8fc2d246-fe82-3cdf-93c9-2b85101a6301",
                                                "text": "Door de invallende duisternis werd het onmogelijk de zoektocht voort te zetten."
                                            },
                                            {
                                                "example_id": "c625a50a-68d1-4d85-b92e-92f873cbd25f",
                                                "sense_id": "8fc2d246-fe82-3cdf-93c9-2b85101a6301",
                                                "text": "Even was hij twintig jaar terug, in de commandotoren van een u-boot, die geruisloos Wilhelmshaven uit voer, met gedoofde lichten, de duisternis in."
                                            },
                                            {
                                                "example_id": "8d372329-ce21-4438-bd2f-d9a2432bc1e5",
                                                "sense_id": "8fc2d246-fe82-3cdf-93c9-2b85101a6301",
                                                "text": "De balustrade kraakt, en Maren trekt haastig de mantel van haar schouders en tuurt omhoog in de duisternis."
                                            },
                                            {
                                                "example_id": "3b8a5dba-5454-4302-8d4b-bdef791a774d",
                                                "sense_id": "8fc2d246-fe82-3cdf-93c9-2b85101a6301",
                                                "text": "De baardragers schuiven de nieuwe grafplaat op zijn plaats en een dienstmeid knielt bij de verdwijnende duisternis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a7925d3-9812-3acf-9f84-f06d1ef32e7d",
                                        "entry_id": "4ed2fbcf-ae81-3176-9381-bb9f7444802a",
                                        "glosses": [
                                            "een toestand van weinig of geen geestelijke verlichting"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5e86a11-4a5a-4845-ab12-80016aa1f931",
                                                "sense_id": "2a7925d3-9812-3acf-9f84-f06d1ef32e7d",
                                                "text": "Nixey begint haar boek \"Eeuwen van duisternis\" met de beschrijving van de onthoofding van Athena en de vernietiging van de tempel van deze godin door vroege geradicaliseerde christenen in 385 in Palmyra. U leest het goed: Palmyra!! Je kunt deze passages niet lezen zonder aan IS te denken!!"
                                            },
                                            {
                                                "example_id": "3f6995a6-2607-4f5b-a4f4-740e7bf735f4",
                                                "sense_id": "2a7925d3-9812-3acf-9f84-f06d1ef32e7d",
                                                "text": "Hoewel deze terugkeer naar de kou en de duisternis een nuttige halte in zijn leven was geworden, stond zijn trein in het station voor onderhoud en om na te denken."
                                            }
                                        ]
                                    }
