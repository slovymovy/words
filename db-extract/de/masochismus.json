                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd4577c3-954d-36c0-a4d9-43ad7a7c70ae",
                        "entry_id": "7e1d40a4-caa2-387d-b9d9-eba353d2bfa1",
                        "glosses": [
                            "Empfindung sexueller Lust durch zugefügten Schmerz körperlicher oder seelischer Art, auch übertragen auf die Bereitschaft, negative Gefühle und Erlebnisse freiwillig zu erdulden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ea4eace-ca51-4ac1-b522-c44a80bfa8b1",
                                "sense_id": "bd4577c3-954d-36c0-a4d9-43ad7a7c70ae",
                                "text": "Es ist ein Fall von Masochismus, wenn er nur durch Erleiden von Misshandlungen geschlechtliche Befriedigung erlangen kann."
                            },
                            {
                                "example_id": "33e43442-1f67-4945-81de-d0a2730dad8e",
                                "sense_id": "bd4577c3-954d-36c0-a4d9-43ad7a7c70ae",
                                "text": "Man braucht schon einen gewissen Grad an Masochismus, um im elterlichen Betrieb eine Lehre zu beginnen."
                            },
                            {
                                "example_id": "9858783c-3573-4b05-8d4e-d194dde21fe0",
                                "sense_id": "bd4577c3-954d-36c0-a4d9-43ad7a7c70ae",
                                "text": "„Die Darstellung von Grausamkeit ist eines der zentralen Themen, und damit verbunden werden Sadismus und Masochismus als Formen normabweichender Sexualität [verstanden].“"
                            },
                            {
                                "example_id": "a1794ada-0151-4297-9110-8c2ffc743c18",
                                "sense_id": "bd4577c3-954d-36c0-a4d9-43ad7a7c70ae",
                                "text": "„Man könnte übrigens die verbreitete Neigung zum Masochismus viel effektiver nutzen.“"
                            },
                            {
                                "example_id": "f928491b-1158-4d49-b9eb-98ab75a424d8",
                                "sense_id": "bd4577c3-954d-36c0-a4d9-43ad7a7c70ae",
                                "text": "„Der spezifische Begriff Sadismus wurde von Krafft-Ebing geprägt, zusammen mit dem Gegenbegriff Masochismus, abgeleitet vom Namen des Schriftstellers Sacher-Masoch, der Novellen der sexuellen Hörigkeit schrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70d42a30-8c15-4a23-bd52-25496e1556a8",
                        "source_entry_id": "7e1d40a4-caa2-387d-b9d9-eba353d2bfa1",
