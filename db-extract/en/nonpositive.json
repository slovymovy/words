                                                "sense_id": "0a606c88-7818-3e83-b50e-7db3471237fe",
                                                "text": "La disparition du négatif argentique au profit d’un stockage numérique sur carte a été une avancée majeure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c4a16fd-b213-3639-a18d-e8ea55084616",
                                        "entry_id": "5a0234e3-56d7-3795-8136-97812b7f1302",
                                        "glosses": [
                                            "L’original d’une photo."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfc88968-e168-44db-a16f-f4bd91ad16ef",
                                                "sense_id": "9c4a16fd-b213-3639-a18d-e8ea55084616",
                                                "text": "Il fut sommé de détruire tous ses négatifs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "négatif",
                                "target_lang_code": "fr",
