                        "glosses": [
                            "een sponsachtige, rode substantie die zich in het binnenste van beenderen bevindt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bd8189e-05e2-46c0-a3d2-ecc23cbc27d7",
                                "sense_id": "207c7b77-6231-37a3-8fb7-3dde4e63fae0",
                                "text": "Beenmerg speelt een belangrijke rol bij het vormen van botweefsel."
