                    },
                    {
                        "sense_id": "d38cab74-fcb0-37c9-9084-7358e6b7200f",
                        "entry_id": "e66ce3dd-913f-3bf9-bcd3-5e626f39d855",
                        "glosses": [
                            "Wortgruppe, rhythmische Sprecheinheit, die durch mögliche Atempausen charakterisiert ist und eine syntaktische oder semantische Einheit bildet"
                        ],
                        "tags": [
                            "Rhetorik",
                            "Metrik"
                        ],
                        "examples": [
                            {
                                "example_id": "8175d14e-225c-41fe-bd63-1f255f6325e0",
                                "sense_id": "d38cab74-fcb0-37c9-9084-7358e6b7200f",
                                "text": "Kola sind Sinneinheiten, Sinnabschnitte der Rede, die durch Sprechpausen markiert werden können."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
