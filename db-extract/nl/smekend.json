                "senses": [
                    {
                        "sense_id": "fc25b0b7-c4cd-3a0a-aeda-c0b8162bf9b5",
                        "entry_id": "caac40d8-2d71-3dc9-9744-a9eee37e8fd7",
                        "glosses": [
                            "nederig vragend om een gunst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48f71e2b-9ff2-4a51-858a-8f621d72279e",
                                "sense_id": "fc25b0b7-c4cd-3a0a-aeda-c0b8162bf9b5",
                                "text": "De 8-jarige Jackson McKie heeft de hersenaandoening Hydrocefalie, waarbij te veel vocht in de hersenen zich opstapelt. Het jongetje werd net naar de operatiezaal gevoerd voor een operatie toen hij met smekende oogjes naar zijn dokter keek. Of die ook even zijn beer Little Baby kon genezen?"
                            },
                            {
                                "example_id": "335d6fdb-ee07-4433-8f7f-ebc2adfd43eb",
                                "sense_id": "fc25b0b7-c4cd-3a0a-aeda-c0b8162bf9b5",
                                "text": "Van lieverlede werd hij echter beschouwd als de 'vriend der kinderen'. In Nederland leest men over het St. Nicolaasfeest voor het eerst in het jaar 1360. De koorknaapjes in Dordrecht kregen er vrij voor. In optocht trokken zij door de stad en bedelden, met een smekend gebaar, hun bisschopsgeld bij elkaar. Maar in de zeventiende eeuw werd dit verboden!"
                            }
                        ]
                    }
