                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "девственный",
                                "target_lang_sense_clarification": "нетронутый, о природе"
                            },
                            {
                                "target_lang_word": "первобытный",
                                "target_lang_sense_clarification": "дикий, не затронутый человеком"
                            },
                            {
                                "target_lang_word": "первозданный",
                                "target_lang_sense_clarification": "сохранившийся в исходном природном виде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ce2ad18-9e69-3bda-a66a-3044fddcf041",
                    "sense_definition": "w matematyce: funkcja, której pochodna jest równa danej funkcji",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nauka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na dzisiejszych ćwiczeniach z analizy student musiał wyznaczyć <w>funkcję</w> <w>pierwotną</w> zadanego wyrażenia.",
                            "target_lang_translations": {
                                "ru": "На сегодняшнем семинаре по анализу студент должен был найти <w>первообразную функцию</w> заданного выражения."
                            }
                        },
                        {
                            "text": "Obliczanie całki nieoznaczonej polega na znalezieniu rodziny funkcji <w>pierwotnych</w>.",
                            "target_lang_translations": {
                                "ru": "Вычисление неопределённого интеграла заключается в нахождении семейства <w>первообразных</w> функций."
                            }
                        }
                    ],
                    "common_phrases": [
                        "funkcja pierwotna"
                    ],
                    "target_lang_definitions": {
                        "ru": "в математике: функция, производная которой равна данной функции"
                    },
                    "translations": {
                        "ru": [
                            {
