                        ]
                    },
                    {
                        "translation_id": "dd6229a5-df00-415a-8d27-aabc3d98528f",
                        "source_entry_id": "abbb81e4-97e8-34f8-9051-afaeafd95ca1",
                        "source_sense_id": "5bb41098-91b8-3842-b5b3-e227179b4eec",
                        "target_lang_word": "cinza vulcânica",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cinza vulcânica",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "cfcdfe60-3d16-3f2a-861b-aa554ae86fae",
                                        "entry_id": "c7729182-b128-329a-ae8c-93a30104349f",
                                        "glosses": [
                                            "termo usado na vulcanologia para designar piroclastos muito pequenos (abaixo de 2 milímetros de tamanho) formados pela pulverização cristalizada do magma e rochas durante erupções explosivas; compõem a maior parte da chamada nuvem piroclástica que traz efeitos danosos ao clima, à saúde (de plantas e animais) e até na segurança do tráfego aéreo, embora seja positiva para a fertilidade do solo; seu formato depende da composição química do magma que a produziu e sua análise microscópica permite identificar com precisão de qual vulcão foi expelida"
                                        ],
                                        "tags": [
                                            "Geologia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ab0709e-afa0-4014-be6a-30432bf37a24",
                                                "sense_id": "cfcdfe60-3d16-3f2a-861b-aa554ae86fae",
                                                "text": "A cinza vulcânica é abrasiva e pode corroer superfícies aerodinâmicas e afetar motores, sistemas eletrônicos e para-brisas.",
                                                "translation": "com correção ortográfica aqui"
                                            },
                                            {
                                                "example_id": "dd3e5dcc-9363-44dc-93c4-dd6ada429c8c",
                                                "sense_id": "cfcdfe60-3d16-3f2a-861b-aa554ae86fae",
                                                "text": "Na verdade, a mágica está literalmente mais embaixo: numa finíssima camada de cinza vulcânica, com 50 milésimos de milímetro de espessura.",
                                                "translation": "com correção ortográfica aqui"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
