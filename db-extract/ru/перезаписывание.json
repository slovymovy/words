                        "glosses": [
                            "действие по значению гл. перезаписывать, перезаписываться, перезаписать, перезаписаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1ec31ea-91fe-498e-8b35-4417501cc37a",
                                "sense_id": "036a6669-4bd6-37e3-9635-cb7164ea6f2d",
                                "text": "Перезаписывание старых данных не удаляет все их следы."
                            },
                            {
                                "example_id": "72e832a7-0d4f-4876-8b42-345568096327",
                                "sense_id": "036a6669-4bd6-37e3-9635-cb7164ea6f2d",
                                "text": "Если записываемый ключ уже имеется в хеш-таблице, происходит перезаписывание значения."
                            },
                            {
                                "example_id": "ca2a9a70-d766-4181-8ad3-71d96ccc70b4",
                                "sense_id": "036a6669-4bd6-37e3-9635-cb7164ea6f2d",
                                "text": "Скоро весь СССР оказался вовлечен в перезаписывание торопиловских альбомов."
                            }
                        ]
                    }
