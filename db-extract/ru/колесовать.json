                        "source_sense_id": "26147150-13dc-310d-abab-eca3a70025a2",
                        "target_lang_word": "radebrechen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radebrechen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d6d415e3-e331-362b-8022-ca5eff53f34d",
                                        "entry_id": "f6a678e5-e4fe-3a87-8fc1-ec60df09e9bc",
                                        "glosses": [
                                            "eine Sprache nur recht fehlerhaft sprechen; eine Sprache nur lückenhaft beziehungsweise unvollständig beherrschen; gebrochen sprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd7d57a-5606-4edd-8aa0-fe4b77d5f5b8",
                                                "sense_id": "d6d415e3-e331-362b-8022-ca5eff53f34d",
                                                "text": "Ich konnte ihn nicht verstehen, denn er radebrechte das Deutsche lediglich."
                                            },
                                            {
                                                "example_id": "396eb1c4-7211-4197-994a-7c86421da3e7",
                                                "sense_id": "d6d415e3-e331-362b-8022-ca5eff53f34d",
                                                "text": "Mit dem Ausdruck „Lied des Datis“ war ein radebrechendes Griechisch gemeint."
                                            },
                                            {
                                                "example_id": "6c26e8b3-edd8-4ba4-9e42-dbe6bf007ac5",
                                                "sense_id": "d6d415e3-e331-362b-8022-ca5eff53f34d",
                                                "text": "„Wer auch nur ein paar Sätze radebrechen kann, wird von ihnen auf Händen getragen.“"
                                            },
                                            {
                                                "example_id": "d8cba8f3-4251-4b46-b8d5-c909d65a76fd",
                                                "sense_id": "d6d415e3-e331-362b-8022-ca5eff53f34d",
                                                "text": "„Die Bewohner sind sehr freundlich und hilfsbereit, wenn man ihnen mit Respekt und Freundlichkeit begegnet; es ist sehr hilfreich, wenn man ein paar Worte georgisch oder russisch radebrechen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "debc4c9b-a135-4954-870a-01fee6647f6e",
                        "source_entry_id": "5661ded5-4211-3cef-833a-2eaceddc1e0d",
                        "source_sense_id": "26147150-13dc-310d-abab-eca3a70025a2",
                        "target_lang_word": "rouer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rouer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79983eae-3fa2-3cdc-ae1d-83509e7ebee2",
                                        "entry_id": "61b2e89c-6be6-3a51-acd4-2c77619fe5d2",
                                        "glosses": [
                                            "Punir du supplice de la roue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "182b96c1-a231-4745-a16e-7ab655c531d2",
                                                "sense_id": "79983eae-3fa2-3cdc-ae1d-83509e7ebee2",
                                                "text": "Il fut condamné à être roué vif."
                                            },
                                            {
                                                "example_id": "df1501bf-7519-4e5e-94ae-6515a419b65c",
                                                "sense_id": "79983eae-3fa2-3cdc-ae1d-83509e7ebee2",
                                                "text": "Quand il est rétabli, Taillefer répète sans cesse qu’il aurait mieux aimé être roué, que de ressentir de pareilles douleurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9d6daa7-63ef-34a3-bca1-dc637c187480",
                                        "entry_id": "61b2e89c-6be6-3a51-acd4-2c77619fe5d2",
                                        "glosses": [
                                            "Était utilisé dans l’expression « il se fera rouer » pour caractériser quelqu’un qui a risqué de se faire écraser (rouler dessus) par un chariot ou une voiture."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "202b3a10-bc8a-4fbe-92bf-bf0b6ed0601f",
                                                "sense_id": "f9d6daa7-63ef-34a3-bca1-dc637c187480",
                                                "text": "J’avais pourtant promis à mon cocher vingt-cinq louis, s’il était assez adroit pour accrocher ce damné Sigognac et le rouer contre une borne comme par accident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a0dbcc9-b2f9-33f4-b9ff-38a083bcbeee",
                                        "entry_id": "61b2e89c-6be6-3a51-acd4-2c77619fe5d2",
                                        "glosses": [
                                            "Battre, dans l’expression rouer de coups."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6870bb45-dc0a-4433-ac07-dd8983b52e2c",
                                                "sense_id": "5a0dbcc9-b2f9-33f4-b9ff-38a083bcbeee",
                                                "text": "Mais c’est faisable, dit La Mole en se préparant comme son compagnon à rouer l’hôtelier de coups de fouet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c04ce755-faeb-3887-83a4-ca6dfba061c0",
                                        "entry_id": "61b2e89c-6be6-3a51-acd4-2c77619fe5d2",
                                        "glosses": [
                                            "Être rompu par la fatigue, comme quelqu’un qui aurait subi le supplice de la roue."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "note": "Il est, dans ce sens, à la voie passive et peut être employé absolument",
                                        "examples": [
                                            {
                                                "example_id": "3fcf7ed0-4e2f-46a0-9d6c-370522b27c67",
                                                "sense_id": "c04ce755-faeb-3887-83a4-ca6dfba061c0",
                                                "text": "Je suis roué de fatigue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rouer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ab55bb7-31ae-3dbf-ab13-9e51efa637ea",
                                        "entry_id": "fcc616b4-18b6-3f02-acc4-dcbc9d04e468",
                                        "glosses": [
                                            "Plier, en parlant d’un câble ou d’une manœuvre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c053128-eb05-400e-81d8-dd5b55ed361d",
                                                "sense_id": "9ab55bb7-31ae-3dbf-ab13-9e51efa637ea",
                                                "text": "Rouer une manœuvre en rond ou en cerceaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f167cbd-0e96-30c7-93b9-68f0c2dbead1",
                                        "entry_id": "fcc616b4-18b6-3f02-acc4-dcbc9d04e468",
                                        "glosses": [
                                            "Courber, en parlant de l’encolure du cheval ou de la mule."
                                        ],
                                        "tags": [
                                            "Hippologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75ff55df-8371-4b1f-873b-3d6c30f6bfee",
                                                "sense_id": "5f167cbd-0e96-30c7-93b9-68f0c2dbead1",
                                                "text": "Le marchand de mules, au contraire, a intérêt à laisser tout le poil des membres, à couper la crinière en brosse pour arrondir et élever l’encolure en la rouant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rouer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13f10fc0-fbb6-3d37-889e-2ac8dca223b6",
                                        "entry_id": "298a2c0b-f317-34d4-8d9b-054b54689894",
                                        "glosses": [
                                            "Faire la roue comme un paon, parader."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63e3599d-6683-4fc1-9c47-d9632e2e37ca",
                                                "sense_id": "13f10fc0-fbb6-3d37-889e-2ac8dca223b6",
                                                "text": "À mesure que les châteaux de nuages s’éloignaient l’un de l’autre découvrant de plus en plus du ciel, l’azur vira au bleu de gentiane et tout un ostensoir de rayons de soleil se mit à rouer à la pointe extrême des nuées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
