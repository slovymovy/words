                                        "glosses": [
                                            "Arzt mit Anästhesie als Fachgebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "796cfd4b-e2c5-4ff8-9a3f-e19de66db91e",
                                                "sense_id": "e12f2884-1f18-30a1-875a-6465c610b9ff",
                                                "text": "„Im Rahmen operativer Eingriffe müssen die Folgen des sog. Operationstraumas vom Anästhesisten behandelt werden.“"
                                            },
                                            {
                                                "example_id": "f8ba7650-00c2-4411-bdb1-14a468733953",
                                                "sense_id": "e12f2884-1f18-30a1-875a-6465c610b9ff",
                                                "text": "„Der Patient, der dem Anästhesisten Kai Zacharowski den Glauben an sein Lehrbuchwissen raubte, war Zeuge Jehovas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
