                        "sense_id": "05b04e58-0f77-3f12-8cdd-6bb6fee13228",
                        "entry_id": "380b3ed8-f47f-34bf-ae70-f958de21dd21",
                        "glosses": [
                            "Sportif pratiquant la gymnastique."
