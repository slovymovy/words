                "senses": [
                    {
                        "sense_id": "1e25f9d3-6f42-368d-a657-b06175088868",
                        "entry_id": "fbf9566a-e3bb-3fbc-bab3-d31e92567a38",
                        "glosses": [
                            "geistige Strömung der Aufklärung bei den Juden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f846cd4-20c0-4c4c-b729-56538f3bbc4d",
                                "sense_id": "1e25f9d3-6f42-368d-a657-b06175088868",
                                "text": "„War der Chassidismus eine Bewegung des einfachen Volkes, so gelang es umgekehrt der Haskala, der Aufklärung, nie richtig, an die Massen heranzukommen.“"
                            },
                            {
                                "example_id": "4929ed50-0748-42df-a67f-5fb955337cf6",
                                "sense_id": "1e25f9d3-6f42-368d-a657-b06175088868",
                                "text": "„Die polnisch-jüdische Gemeinschaft des 18. Jahrhunderts war gespalten in die mystische und volkstümliche Strömung der Chassidim und in jene der jüdischen Aufklärung, der Haskala.“"
                            },
                            {
                                "example_id": "8d43a655-43c5-49f2-9297-530529c0985e",
                                "sense_id": "1e25f9d3-6f42-368d-a657-b06175088868",
                                "text": "„Eines der ersten jiddischen Werke der osteuropäischen Haskala war denn auch ein Gesundheitsratgeber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
