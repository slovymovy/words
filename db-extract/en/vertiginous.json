                ],
                "translations": [
                    {
                        "translation_id": "42da631c-026d-40c4-8eae-c413dda73b05",
                        "source_entry_id": "d4fd699f-bf28-3d61-a325-7369e52c1b8e",
                        "source_sense_description": "Inducing giddiness or vertigo",
                        "target_lang_word": "schwindelerregend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schwindelerregend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f045a651-9b6c-3945-98e2-e05217fedce4",
                                        "entry_id": "4a399e84-09ce-37d7-9c14-6fdf4ee440a2",
                                        "glosses": [
                                            "das Gefühl von Schwindel (also nicht sicher zu stehen oder zu taumeln/zu schwanken) auslösend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4f1dfa8-f13f-4de4-aa6e-560bc9cc1c86",
                                                "sense_id": "f045a651-9b6c-3945-98e2-e05217fedce4",
                                                "text": "„Von Geiranger selbst geht es in zahlreichen Serpentinen schwindelerregend in die Höhe, wenn man den Ort über die Straße wieder verlassen will.“"
                                            },
                                            {
                                                "example_id": "a4ec1588-8999-44a3-bc77-5d822aedd361",
                                                "sense_id": "f045a651-9b6c-3945-98e2-e05217fedce4",
                                                "text": "„Cabo Girao bezeichnet die Aussichtsplattform auf der Klippe selbst. Sie wurde mittlerweile von einer durch Steinmauern bewehrte Terrasse zu einem modernen Skywalk umgebaut. Er wurde Ende 2012 eingeweiht und gewährt mit seinem Glasboden natürlich schwindelerregende Ausblicke in die Tiefe.“"
                                            },
                                            {
                                                "example_id": "e1b2ff25-5430-4d55-8e97-eef358777db2",
                                                "sense_id": "f045a651-9b6c-3945-98e2-e05217fedce4",
                                                "text": "„Wem die bei hier oft herrschenden, starken Winden durchaus schwindelerregende Abfahrt zu wackelig erscheint, kann auch den Fußweg über steil ausgesetzte Pfade wählen, der angesichts der Fotos nicht weniger spektakulär erscheint.“"
                                            },
                                            {
                                                "example_id": "55e1161b-f83a-4437-8564-d5f184a43b4b",
                                                "sense_id": "f045a651-9b6c-3945-98e2-e05217fedce4",
                                                "text": "„Sankt Helena besitzt einige markierte Wanderwege. Es ist aber nicht ganz einfach, von Jamestown auf diese zu gelangen (am besten mit Mietwagen auf die Hochfläche; eine andere Möglichkeit ist über die „Jakobsleiter“, eine schwindelerregende Treppe mit angeblich 699 Stufen).“"
                                            },
                                            {
                                                "example_id": "608fdcd2-eac2-4b53-9147-a3079cc06e9c",
                                                "sense_id": "f045a651-9b6c-3945-98e2-e05217fedce4",
                                                "text": "„Das römische Wegstück wurde saniert und anschliessend bis zur neuen Brücke ein kühner Weg teils aus dem Fels gehauen, teils auf Holzstegen über den schwindelerregenden Abgrund geführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dca595db-0450-304a-b889-30991567b291",
                                        "entry_id": "4a399e84-09ce-37d7-9c14-6fdf4ee440a2",
                                        "glosses": [
                                            "sehr beeindruckend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bb0d2ae-46e1-4bc6-8cab-10c8ec4e7629",
                                                "sense_id": "dca595db-0450-304a-b889-30991567b291",
                                                "text": "[…] „die Popularität der Carpenters stieg in Japan in schwindelerregende Höhen.“"
                                            },
                                            {
                                                "example_id": "528104b9-dc2e-4ebc-ae36-a13162819934",
                                                "sense_id": "dca595db-0450-304a-b889-30991567b291",
                                                "text": "„Die Temperaturen steigen im Sommer auf oft schwindelerregende Höhen“ […]."
                                            },
                                            {
                                                "example_id": "0b7aeb36-c86c-4690-b452-ff18eaa8a8bb",
                                                "sense_id": "dca595db-0450-304a-b889-30991567b291",
                                                "text": "[Coronapandemie 2022:] „Die Zahlen waren in schwindelerregende Höhen geschnellt. 240.172 Neuinfektionen pro Tag, eine Inzidenz von mehr als 1400;“ […]."
                                            },
                                            {
                                                "example_id": "cbf0ef0b-b211-46e4-bc91-48ae4ae31f07",
                                                "sense_id": "dca595db-0450-304a-b889-30991567b291",
                                                "text": "„Als der Aktienkurs des Konzerns schwindelerregende Höhen erreicht hat, nimmt sich der Firmengründer und Vorstandsvorsitzende Waring Hudsucker durch einen Sprung durch das geschlossene Fenster aus dem 44. Stock des Firmengebäudes das Leben.“"
                                            },
                                            {
                                                "example_id": "feaa0cfa-7064-4484-b744-4362f00f037c",
                                                "sense_id": "dca595db-0450-304a-b889-30991567b291",
                                                "text": "„Die Deutschen stöhnen unter schwindelerregend hohen Energiekosten“ […]."
                                            },
                                            {
                                                "example_id": "cb9b6aa0-6f2e-44c5-be1a-e43cdaa9ec54",
                                                "sense_id": "dca595db-0450-304a-b889-30991567b291",
                                                "text": "[…] „Jon Hendricks war ein Gesangsstar des Jazz. Er dichtete wie am Fließband Texte auf die schwindelerregend schnellen Soli von Bebop-Musikern und sang sie dann zusammen mit Dave Lambert und Annie Ross ein.“"
                                            },
                                            {
                                                "example_id": "e0913c9a-d0a1-4bd4-b80e-11bc4cab0076",
                                                "sense_id": "dca595db-0450-304a-b889-30991567b291",
                                                "text": "„Die Zahl ist schwindelerregend: Kredite im Wert von 360 Milliarden Euro gelten bei Italiens Banken als Problemkredite.“"
                                            },
                                            {
                                                "example_id": "f76508e4-92af-4bdc-b7f4-8b2f3e99bb75",
                                                "sense_id": "dca595db-0450-304a-b889-30991567b291",
                                                "text": "„Die Inflation erreichte im April schwindelerregende 12,4 Prozent.“"
                                            },
                                            {
                                                "example_id": "ca64123a-5273-4b17-9352-2501728e5250",
                                                "sense_id": "dca595db-0450-304a-b889-30991567b291",
                                                "text": "„Für die Energiewende und den Schutz vor Extremwetter benötigen ärmere Länder schwindelerregende Summen.“"
                                            },
                                            {
                                                "example_id": "23848ed9-2d94-4fc9-ba7d-1c99cd0107b2",
                                                "sense_id": "dca595db-0450-304a-b889-30991567b291",
                                                "text": "„Für einen Rekordpreis von 45 Millionen Euro (37.000.000 britische Pfund) haben \"Die Füchse\" des expressionistischen deutschen Malers Franz Marc den Besitzer gewechselt. Nicht nur diese schwindelerregende Summe für das Ölgemälde ist beachtlich. Sondern auch die Tatsache, dass es überhaupt zu einer Versteigerung des Meisterwerks kam.“"
                                            },
                                            {
                                                "example_id": "a02a4e65-dfae-4e0a-beac-19c632c43fab",
                                                "sense_id": "dca595db-0450-304a-b889-30991567b291",
                                                "text": "„Die kapitalistische Verwertungslogik hielt Einzug in das beliebte Spiel und Pelé wurde Paradebeispiel für schwindelerregenden sozialen Aufstieg, den der Fußball möglich machen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
