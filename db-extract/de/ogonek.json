                                "target_senses": [
                                    {
                                        "sense_id": "60152d54-f3ee-32ac-9654-f833afe83647",
                                        "entry_id": "1aaa8ac6-2450-33aa-b935-b1c410e73b2e",
                                        "glosses": [
                                            "A hook-shaped diacritical mark ⟨◌̨⟩ attached underneath a vowel, typically to indicate nasalization, as in Ąą, Ęę, Įį, Ǫǫ or Ųų."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c4a7444-368e-4fc6-ac61-409d8de02807",
                                                "sense_id": "60152d54-f3ee-32ac-9654-f833afe83647",
                                                "text": "The pangram “Pchnąć w tę łódź jeża lub ośm skrzyń fig” (To push a hedgehog or eight boxes of figs into that boat) highlights a few of the language-specific diacritical marks, such as L with stroke (ł) and ogoneks (ą, ę) necessary to write in Polish—demonstrating how a writing system can accommodate many languages with thorough character inclusion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02014f0a-4f43-482f-88af-6cef086c97fd",
                        "source_entry_id": "e5226187-ebf5-3eb8-ab8a-6640768446c4",
                        "source_sense_id": "095b0251-ec76-3638-997b-09e59832314a",
                        "source_sense_description": "Linguistik: diakritisches Zeichen zur Anzeige eines Nasallautes",
