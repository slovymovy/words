                                            {
                                                "example_id": "60e9232b-be48-4568-b45b-84d9c67f3a49",
                                                "sense_id": "820ddde4-6e94-3764-bf69-7db40fe71020",
                                                "text": "„Das natürliche Vorkommen der Kakteen ist auf den amerikanischen Kontinent beschränkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "de677ee0-4e09-3c5b-8842-3043ca382557",
                                        "entry_id": "e6648b12-e2bd-312f-9c5e-56a43de848a5",
                                        "glosses": [
                                            "beliebige exotische sukkulente, kugelförmige, scheibenförmige, säulenförmige Pflanze (die in der Lage ist, viel Wasser zu speichern und meist mit Dornen bestückt ist)"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1495c50-5e82-4098-a746-56652d65818c",
                                                "sense_id": "de677ee0-4e09-3c5b-8842-3043ca382557",
                                                "text": "Irgendwie witzig ist, dass man einen Kaktus Schwiegermutterstuhl nennt."
                                            },
                                            {
                                                "example_id": "b88e79f8-c264-4640-9cf6-5e3104d1203a",
                                                "sense_id": "de677ee0-4e09-3c5b-8842-3043ca382557",
                                                "text": "„Eine Gruppe von Kakteen wuchs am Abhang der Düne.“"
                                            },
                                            {
                                                "example_id": "13817536-0170-4a24-9791-4ca6615917ab",
                                                "sense_id": "de677ee0-4e09-3c5b-8842-3043ca382557",
                                                "text": "„Zwischen Kakteen und Blattpflanzen ohne Blüten, wie man sie in den Schaufenstern von Schlächtern findet, um ein totes Ferkel mit einer Zitrone im Maul zu garnieren, saßen etwa fünfzehn Personen auf unbequemen Stühlen herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
