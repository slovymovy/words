    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9ef1d28a-6bb8-3452-827e-1cdf8e4d7a8a",
                "word": "gabbro",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5384bf01-ea5c-4d14-943c-951b128cf4f0",
                        "entry_id": "9ef1d28a-6bb8-3452-827e-1cdf8e4d7a8a",
                        "tags": [
                            "plural"
                        ],
                        "form": "gabbros"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c30c7c3-6840-3968-8b70-ce140f64a9d5",
                        "entry_id": "9ef1d28a-6bb8-3452-827e-1cdf8e4d7a8a",
                        "glosses": [
                            "Originally, a kind of serpentine; now generally a coarsely crystalline, igneous rock consisting of lamellar pyroxene and labradorite."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a2476000-c5c7-4681-b3f0-4709d1ec4d07",
                                "sense_id": "9c30c7c3-6840-3968-8b70-ce140f64a9d5",
                                "text": "It is known as gabbro and is thought to form the lower layer of the oceanic crust at about four kilometres depth and to comprise a layer up to six kilometres thick, making it one of the most abundant, if least recognisable, materials on earth."
                            },
                            {
                                "example_id": "b2a65916-e4db-4964-9682-fd461bdef88c",
                                "sense_id": "9c30c7c3-6840-3968-8b70-ce140f64a9d5",
                                "text": "Against the dark Ordovician gabbro, the black volcanic base, Rhynie is a streak of technicolour."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1441bd8f-3ab8-4d92-b4e6-1f6e793c6a85",
                        "source_entry_id": "9ef1d28a-6bb8-3452-827e-1cdf8e4d7a8a",
                        "source_sense_id": "9c30c7c3-6840-3968-8b70-ce140f64a9d5",
                        "source_sense_description": "igneous rock",
                        "target_lang_word": "gabbro",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gabbro",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "657ed80e-8574-39c7-8f3c-9314dececafd",
                                        "entry_id": "0a26af84-0b34-3edb-bd99-2292c1d9e656",
                                        "glosses": [
                                            "Roche plutonique à texture grenue, composée essentiellement de pyroxène et de feldspath composant l’intérieur du manteau terrestre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b11c14e-c4df-498b-9580-4f5a73108b53",
                                                "sense_id": "657ed80e-8574-39c7-8f3c-9314dececafd",
                                                "text": "On distingue chez les gabbros, plusieurs variétés : l’euphotide, la norite, l’hypérite et la troctolite."
                                            },
                                            {
                                                "example_id": "5c95ad62-3d8a-441a-afbe-329bdf2674ea",
                                                "sense_id": "657ed80e-8574-39c7-8f3c-9314dececafd",
                                                "text": "Ainsi, le granit comprend environ 70 % de silice tandis qu’un gabbro n'en a que 45 % environ ; le granit est une roche acide, le gabbro une roche basique."
                                            },
                                            {
                                                "example_id": "75510cf8-1d88-4288-988a-b30be7fb5ceb",
                                                "sense_id": "657ed80e-8574-39c7-8f3c-9314dececafd",
                                                "text": "Enfin, d’autres gisements de surface résultent de l’altération plus ou moins récente de roches et de filons basiques tels que des dolérites, des gabbros ou même des schistes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db95f73f-5ac7-4205-be54-414599d5c673",
                        "source_entry_id": "9ef1d28a-6bb8-3452-827e-1cdf8e4d7a8a",
                        "source_sense_id": "9c30c7c3-6840-3968-8b70-ce140f64a9d5",
                        "source_sense_description": "igneous rock",
                        "target_lang_word": "Gabbro",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gabbro",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec33e3ba-a60e-35bd-a1bf-fbacaf3c7543",
                                        "entry_id": "0ef2a2c6-b9a3-32a5-82c9-fd0f3632427d",
                                        "glosses": [
                                            "körniges magmatisches Tiefengestein von schwarzer bis schwarzgrüner Farbe, das sich hauptsächlich aus Plagioklas und Pyroxen zusammensetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccf59b07-04ff-43fc-924f-f6a699751615",
                                                "sense_id": "ec33e3ba-a60e-35bd-a1bf-fbacaf3c7543",
                                                "text": "Diese Gebirgsformation besteht hauptsächlich aus Gabbro."
                                            },
                                            {
                                                "example_id": "ce8bccf0-bca4-43c9-9444-5ebcf930f036",
                                                "sense_id": "ec33e3ba-a60e-35bd-a1bf-fbacaf3c7543",
                                                "text": "„Der Stein in meiner Hand war noch eine Weile Hitze und Druck ausgesetzt, der Granit und Gabbro in die kleinsten Risse presste, jene Kristalle, hellroten Streifen und milchigen Einsprengsel in seinem monochromen Grau; aber er ragte weiter knapp über einen Ozean, in dem bereits das Leben entstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
