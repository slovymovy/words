                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police were <w>surrounding</w> the house to prevent anyone from escaping.",
                            "target_lang_translations": {
                                "ru": "Полиция <w>окружала</w> дом, чтобы никто не сбежал.",
                                "nl": "De politie was het huis aan het <w>omringen</w> om te voorkomen dat iemand zou ontsnappen.",
                                "pl": "Policja <w>otaczała</w> dom, aby uniemożliwić komukolwiek ucieczkę.",
                                "de": "Die Polizei <w>umzingelte</w> das Haus, um niemanden entkommen zu lassen.",
                                "fr": "La police était en train d'<w>entourer</w> la maison pour empêcher quiconque de s'échapper.",
                                "it": "La polizia stava <w>circondando</w> la casa per impedire a chiunque di scappare.",
                                "cs": "Policie <w>obklopovala</w> dům, aby zabránila komukoli v útěku.",
                                "tr": "Polis, kimsenin kaçmasını önlemek için evi <w>çevreliyordu</w>.",
                                "es": "La policía estaba <w>rodeando</w> la casa para evitar que alguien escapara.",
                                "zh": "警察正在<w>包围</w>那座房子，以防有人逃脱。"
                            }
                        },
                        {
                            "text": "Thick fog was <w>surrounding</w> the mountain peak.",
                            "target_lang_translations": {
                                "ru": "Густой туман <w>окружал</w> вершину горы.",
                                "nl": "Dichte mist <w>omringde</w> de bergtop.",
                                "pl": "Gęsta mgła <w>otaczała</w> szczyt góry.",
                                "de": "Dichter Nebel <w>umgab</w> den Berggipfel.",
                                "fr": "Un brouillard épais <w>entourait</w> le sommet de la montagne.",
                                "it": "Una fitta nebbia stava <w>circondando</w> la cima della montagna.",
                                "cs": "Hustá mlha <w>obklopovala</w> vrchol hory.",
                                "tr": "Yoğun sis dağın zirvesini <w>çevreliyordu</w>.",
                                "es": "Una espesa niebla estaba <w>rodeando</w> la cima de la montaña.",
                                "zh": "浓雾<w>环绕</w>着山顶。"
                            }
