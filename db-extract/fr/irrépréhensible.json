                "senses": [
                    {
                        "sense_id": "7b82e370-4e60-34e0-b71b-ead702a17f66",
                        "entry_id": "ef553eea-62b3-3c38-a5f6-506af6b2b37d",
                        "glosses": [
                            "Qu’on ne saurait reprendre, blâmer (se dit des personnes aussi bien que des choses)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6442b81d-e29b-4048-a846-b2b4a191c553",
                                "sense_id": "7b82e370-4e60-34e0-b71b-ead702a17f66",
                                "text": "Qu'un homme soit le plus accompli et le plus irrépréhensible, et qu'on le mette comme la lumière sur le chandelier, tout accompli et tout irrépréhensible qu'il peut être, on en jugera, et à force de l'observer, on y découvrira ou l'on croira y découvrir des taches."
                            },
                            {
                                "example_id": "195a927a-18a8-4ced-b770-5efee34472e5",
                                "sense_id": "7b82e370-4e60-34e0-b71b-ead702a17f66",
                                "text": "Il est irrépréhensible dans sa conduite."
                            },
                            {
                                "example_id": "02884d55-88db-4e98-8064-bc15b4cd3529",
                                "sense_id": "7b82e370-4e60-34e0-b71b-ead702a17f66",
                                "text": "C’est une action irrépréhensible."
                            }
                        ]
                    }
