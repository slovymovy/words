                        {
                            "text": "De timmerman heeft de kozijnen gisteren nog <w>geruit</w>.",
                            "target_lang_translations": {
                                "en": "The carpenter <w>glazed</w> the frames only yesterday.",
                                "ru": "Плотник только вчера <w>вставил стёкла</w> в рамы."
