                "senses": [
                    {
                        "sense_id": "509d1804-c30e-3ccd-b6cb-3f65ffa34b8f",
                        "entry_id": "92d8d1a5-3886-329e-b85d-323f01a7a093",
                        "glosses": [
                            "zentraler Teil eines Ortes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "661d8889-6fe6-439f-8c0a-0adf557d6aaa",
                                "sense_id": "509d1804-c30e-3ccd-b6cb-3f65ffa34b8f",
                                "text": "Die mittelalterlichen Fachwerkhäuser im Ortskern sind alle denkmalgeschützt."
                            },
                            {
                                "example_id": "94298456-c7b5-468d-91dc-052aa389bb05",
                                "sense_id": "509d1804-c30e-3ccd-b6cb-3f65ffa34b8f",
                                "text": "„Die Holzkirche von Joutsa hat fünfhundert Sitzplätze und befindet sich auf einem kleinen Hügel, nur wenige hundert Meter südlich des eigentlichen Ortskerns.“"
                            },
                            {
                                "example_id": "866728fe-93b8-41fa-a97c-fa6b2a3186a3",
                                "sense_id": "509d1804-c30e-3ccd-b6cb-3f65ffa34b8f",
                                "text": "„Der Ortskern ist nur noch mit Booten zu erreichen.“"
                            },
                            {
                                "example_id": "5113a565-371f-44be-8069-4cf281e358d8",
                                "sense_id": "509d1804-c30e-3ccd-b6cb-3f65ffa34b8f",
                                "text": "„Halldór fuhr nach Süden und kam so früh dort an, dass er nach Keflavík hineinfuhr, den Wagen an der Kirche abstellte und einen Spaziergang durch den alten Ortskern machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
