                                        "sense_id": "ba5b5e7d-77cb-351a-aef2-1dde8c46f863",
                                        "entry_id": "eaf340bd-0267-3993-9cc6-584624485715",
                                        "glosses": [
                                            "Any of the numerous species of birds belonging to several genera within the family Corvidae, including Garrulus, Cyanocitta, Aphelocoma, Perisoreus, Cyanocorax, Gymnorhinus, Cyanolyca, Ptilostomus, and Calocitta, allied to the crows, but smaller, more graceful in form, often handsomely coloured, usually having a crest, and often noisy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7755054-e1e5-332d-b53b-fa7abf6fcc01",
                                        "entry_id": "eaf340bd-0267-3993-9cc6-584624485715",
                                        "glosses": [
                                            "Any of various other birds of similar appearance and behaviour."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f5eeb9f-b246-3547-a009-ed35f5f1f507",
                                        "entry_id": "eaf340bd-0267-3993-9cc6-584624485715",
                                        "glosses": [
                                            "Any of various other birds of similar appearance and behaviour.",
                                            "The Indian roller, Coracias benghalensis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26aaf164-09f9-4171-a131-20c3e55aff13",
                                                "sense_id": "3f5eeb9f-b246-3547-a009-ed35f5f1f507",
                                                "text": "They are the commonality of birddom, who furnish forth the mobs which bewilder the drunken-flighted jay when he jerks, shrieking in a series of blue hyphen-flashes through the air […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b26ad044-7823-3869-bc45-4fb8cba17a8b",
                                        "entry_id": "eaf340bd-0267-3993-9cc6-584624485715",
                                        "glosses": [
                                            "Any of various large papilionid butterflies of the genus Graphium."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "304cee74-0e93-34be-93da-c55f3ec25d60",
                                        "entry_id": "eaf340bd-0267-3993-9cc6-584624485715",
                                        "glosses": [
                                            "A dull or ignorant person. It survives today in the term jaywalking."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b331b70-2ef3-4321-9ece-04ecccf9c665",
                                                "sense_id": "304cee74-0e93-34be-93da-c55f3ec25d60",
                                                "text": "Burlington Bertie's the latest young jay\nHe rents a swell flat somewhere Kensington way\nHe spends the good oof that his pater has made\nAlong with the Brandy and Soda Brigade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "502281f2-ddf8-3c56-a49d-42046bcc06d5",
                                        "entry_id": "eaf340bd-0267-3993-9cc6-584624485715",
                                        "glosses": [
                                            "Promiscuous woman; prostitute."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd2dcc72-24e6-4d76-a472-e5fab55cc211",
                                                "sense_id": "502281f2-ddf8-3c56-a49d-42046bcc06d5",
                                                "text": "Some jay of Italy, / Whose mother was her painting, hath betray'd him:"
                                            }
                                        ]
                                    }
                                ]
                            },
