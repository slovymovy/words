                    {
                        "sense_id": "2993530a-3aae-3335-9f3a-7242f62e7aa7",
                        "entry_id": "9659fe46-0583-3349-8a38-7d353ed2b437",
                        "glosses": [
                            "das freie Lernen um wissend zu werden"
