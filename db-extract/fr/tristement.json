                "forms": [],
                "senses": [
                    {
                        "sense_id": "552e19fb-35af-30f4-903b-38a426866a50",
                        "entry_id": "f6faecfb-38e8-3936-8cf6-2ee4d228897f",
                        "glosses": [
                            "sadly, gloomily, sorrowfully, miserably"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3645c800-395f-4dc7-a86f-3913b62a100a",
                                "sense_id": "552e19fb-35af-30f4-903b-38a426866a50",
                                "text": "tristement célèbre",
                                "translation": "infamous, sadly notorious",
                                "english": "infamous, sadly notorious"
                            },
                            {
                                "example_id": "3ca32e20-bbe9-43d0-96cf-af6bd143cf3d",
                                "sense_id": "552e19fb-35af-30f4-903b-38a426866a50",
                                "text": "Un mort s’en allait tristement s’emparer de son dernier gîte […]",
                                "translation": "A dead man was going sorrowfully to take possession of his final resting-place […]",
                                "english": "A dead man was going sorrowfully to take possession of his final resting-place […]"
                            },
                            {
                                "example_id": "b740f0c1-2363-4628-a2a1-2c37a026523d",
                                "sense_id": "552e19fb-35af-30f4-903b-38a426866a50",
                                "text": "Nous errons tristement dans les rues quand nous avisons une compagnie de la Wehrmacht en train de popoter à la roulante sur la place du village.",
                                "translation": "We're wandering miserably through the streets when we catch sight of a company of Wehrmacht in the process of making a meal at the mobile canteen in the village square.",
                                "english": "We're wandering miserably through the streets when we catch sight of a company of Wehrmacht in the process of making a meal at the mobile canteen in the village square."
                            }
                        ]
                    }
                ],
