                        "sense_id": "bd23b5bc-51ed-37dc-865d-96be50db6829",
                        "entry_id": "9e882959-b4c5-346e-9745-7f04a847785c",
                        "glosses": [
                            "Synonym of anteversion."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8dbad28f-9eef-4ff5-a6c4-73fd33795e40",
                                "sense_id": "bd23b5bc-51ed-37dc-865d-96be50db6829",
                                "text": "The symptoms of antroversion of the impregnated womb differ according to their degree, the period of its origin, and the sensibility of the patient."
                            },
                            {
                                "example_id": "5726b607-9b23-45d0-8eff-0421cb973313",
                                "sense_id": "bd23b5bc-51ed-37dc-865d-96be50db6829",
                                "text": "The chief points of similarity are : first, the subtriangular shape ; second, the same relative proportions between the fossae; third, the antroversion of the spine; fourth, the glenoid cavity looking directly down."
                            },
                            {
                                "example_id": "59e5ac7a-8522-4456-a705-7eb548907486",
                                "sense_id": "bd23b5bc-51ed-37dc-865d-96be50db6829",
                                "text": "In most cases it will be found that both arches are normal in form and size, that there is no antroversion or introversion either above or below, and that the superior teeth alone are at fault."
                            }
                        ]
                    }
