    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f60af153-5b83-3d4f-bd50-7854c87fef97",
                    "sense_definition": "A large-scale fight between organized armed forces, typically as part of a war.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers prepared for a fierce <w>battle</w> that would decide the fate of the city.",
                            "target_lang_translations": {
                                "ru": "Солдаты готовились к ожесточенной <w>битве</w>, которая должна была решить судьбу города."
                            }
                        },
                        {
                            "text": "Historians often study the <w>battle</w> field to understand the tactics used by the generals.",
                            "target_lang_translations": {
                                "ru": "Историки часто изучают поле <w>битвы</w>, чтобы понять тактику, которую использовали генералы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fierce battle",
                        "battle field",
                        "lose the battle",
                        "win the battle"
                    ],
                    "target_lang_definitions": {
