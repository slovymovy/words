                "senses": [
                    {
                        "sense_id": "7f735610-4f34-3cd1-ad13-daf89e5bdda2",
                        "entry_id": "964fcaf9-43c4-38cb-a2b5-de4a8e2db758",
                        "glosses": [
                            "8. (vorletzte) Klasse eines Gymnasiums, das heißt insgesamt 12. Schuljahr"
                        ],
                        "tags": [
                            "Germany",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "982e69f0-40d3-40c7-b25f-9243ddc6fd35",
                                "sense_id": "7f735610-4f34-3cd1-ad13-daf89e5bdda2",
                                "text": "„Aber Feo musste die Unterprima wiederholen und wurde seine Klassenkameradin, sie saß direkt neben ihm:…“"
                            },
                            {
                                "example_id": "c25b16e0-1c56-4319-9fa7-4abdaa86ed1a",
                                "sense_id": "7f735610-4f34-3cd1-ad13-daf89e5bdda2",
                                "text": "„Nun aber hatte der Obersekundaner Roman Bertini gleich drei Fünfen, die ihm undiskutierbar die Versetzung in die Unterprima verwehrten.“"
                            },
                            {
                                "example_id": "aea06014-5591-4dad-8870-c9ce504c2740",
                                "sense_id": "7f735610-4f34-3cd1-ad13-daf89e5bdda2",
                                "text": "„Selbst in den Schulbüchern auf dem wurmstichigen Brett über der Kommode, in der halbzerfetzten Ploetzschen Grammatik für den Gebrauch der Unterprima und in dem dicken lateinischen Handwörterbuch von Georges offenbarte sich eine heimische Anziehungskraft, ein Bann, der gar nicht so leicht zu brechen war.“"
                            },
                            {
                                "example_id": "7a7dddc6-26f8-4f76-b465-d3ca9658566d",
                                "sense_id": "7f735610-4f34-3cd1-ad13-daf89e5bdda2",
                                "text": "„Die Frage der Tante echote durch Fernsehen, Radio, die Zeitungen bis in die Klassenarbeit der Unterprima des Humboldt-Gymnasiums.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
