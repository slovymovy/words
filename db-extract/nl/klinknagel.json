                                "sense_id": "fecf8e2a-0135-3c50-a64b-1a475143e4ca",
                                "text": "De scheepshuid zat vroeger met klinknagels bevestigd."
                            },
                            {
                                "example_id": "1c5c83eb-8e19-479e-98be-8e400081d5b1",
                                "sense_id": "fecf8e2a-0135-3c50-a64b-1a475143e4ca",
                                "text": "Het houten hek was versterkt met ijzeren banden en klinknagels en was minstens twee keer zo hoog en drie keer zo breed als de kerkdeuren."
                            }
                        ]
