                        "glosses": [
                            "Modern, new-fangled."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "37dda651-6795-4c3d-9c79-de3ee9be057a",
                                "sense_id": "417a2f01-cf67-3411-8644-01ad384ccd81",
                                "text": "Among our neoteric verbs, those in -ize are exceedingly numerous."
                            }
                        ]
                    },
                    {
                        "sense_id": "77ef6dda-0cc8-3e63-b51e-e6da4f7619a7",
                        "entry_id": "489610bc-26ed-3972-80a3-e882d3967108",
                        "glosses": [
                            "New; recent."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d3d5207c-b7f7-4eaf-b2d6-bf822fd42d75",
                                "sense_id": "77ef6dda-0cc8-3e63-b51e-e6da4f7619a7",
                                "text": "Should it all come crashing in on us . . . will there be enough luddites, whose hands remember, to free us from the chains of neoteric technology?"
                            },
                            {
                                "example_id": "70672cef-5099-4716-a033-075532f2b8ec",
                                "sense_id": "77ef6dda-0cc8-3e63-b51e-e6da4f7619a7",
                                "text": "A few words on the two neoteric terms, cybertext and ergodic, are in order."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
