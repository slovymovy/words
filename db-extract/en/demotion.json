                        "entry_id": "373c2b3d-05f7-3e36-9384-adf0d9048c72",
                        "glosses": [
                            "An act of demoting; a lowering of rank or status."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4cb58ad6-e94f-4d15-889f-c383690c5303",
                                "sense_id": "8fcbb73b-6a60-3ec0-b13c-8de33c59d0c3",
                                "text": "Unlike other previous Prelates, who were swiftly anointed bishops, Francis did not follow suit. Ocáriz remained a Monsignor. In the eyes of many observers, it was a demotion of Opus Dei."
                            }
                        ]
                    }
                ],
