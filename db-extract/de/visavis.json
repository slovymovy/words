                        "examples": [
                            {
                                "example_id": "3c505aba-adab-4b7a-bd4a-6c8a397ed47c",
                                "sense_id": "82665db5-27ec-36ec-8cd4-95ca0bb9f0f1",
                                "text": "Mein Visavis im Café ging mir deutlich auf die Nerven."
                            },
                            {
                                "example_id": "1bce0210-ffa5-441f-8e0e-f10605d05f5a",
                                "sense_id": "82665db5-27ec-36ec-8cd4-95ca0bb9f0f1",
                                "text": "„Der Fremde gegenüber rührte und regte sich nicht, und der Kommerzienrat sah erst die Dame und dann sein Visavis etwas bestürzt an;…“"
                            }
                        ],
