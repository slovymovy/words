                                        "examples": [
                                            {
                                                "example_id": "7fcec143-a1f8-4216-9b75-6298e362f52c",
                                                "sense_id": "8f036141-68eb-37c2-9fe8-6b6edfcf8f3a",
                                                "text": "Die Europäer, insbesondere die Skandinavier, begrüßten die Rede des US-Präsidenten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
