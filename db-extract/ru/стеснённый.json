                "senses": [
                    {
                        "sense_id": "2f37d856-2233-3b31-9843-2408402f7377",
                        "entry_id": "2db0c027-611f-3d83-9f60-286921595cf3",
                        "glosses": [
                            "cramped, close-together"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27d97246-9a00-4143-a153-c57d70316693",
                                "sense_id": "2f37d856-2233-3b31-9843-2408402f7377",
                                "text": "В обоих почерках последние слова стеснённы, им не хватает места ...",
                                "translation": "In both hands the last words are cramped, there is not enough space for them ...",
                                "english": "In both hands the last words are cramped, there is not enough space for them ..."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b0b0b60-41b3-3be5-863b-279fb4a4a3ce",
                        "entry_id": "2db0c027-611f-3d83-9f60-286921595cf3",
                        "glosses": [
                            "constrained, straitened, pinched, difficult (of financial circumstances)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5304a91f-e128-4583-af8d-1f13e9984e0e",
                                "sense_id": "3b0b0b60-41b3-3be5-863b-279fb4a4a3ce",
                                "text": "В начале пятидесятых годов проживало в Москве, в весьма стеснённых обстоятельствах, чуть не в бедности, многочисленное семейство князей Осининых.",
                                "translation": "Early in the fifties, there was living in Moscow, in very straitened circumstances, almost in poverty, the numerous family of the Princes Osinin.",
                                "english": "Early in the fifties, there was living in Moscow, in very straitened circumstances, almost in poverty, the numerous family of the Princes Osinin."
                            }
                        ]
                    },
                    {
                        "sense_id": "44949cda-29e3-3eaf-b8e5-76af0c6d629c",
                        "entry_id": "2db0c027-611f-3d83-9f60-286921595cf3",
                        "glosses": [
                            "difficult, labored (of breathing, movements, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee7155cd-540a-4032-bae1-e8720e8e736f",
                                "sense_id": "44949cda-29e3-3eaf-b8e5-76af0c6d629c",
                                "text": "стеснённое дыха́ние",
                                "translation": "labored breathing",
                                "english": "labored breathing"
                            }
                        ]
                    },
                    {
                        "sense_id": "9bb47bb8-68bc-3108-b328-11f6942d8ccf",
