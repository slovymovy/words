                    {
                        "translation_id": "b9d31197-b459-4a9f-94a6-62a5536268da",
                        "source_entry_id": "a22be1e9-57d8-3a4b-9fc3-44f2a08d16f0",
                        "source_sense_id": "897cbe3c-c5c8-32da-a6e9-a097f271d28a",
