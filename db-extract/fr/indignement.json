                                                "sense_id": "2520d45e-c260-35df-96d4-cf813a1c3dc2",
                                                "text": "I looked shamefully at the floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03017235-86fd-389e-934e-1fef07486403",
                                        "entry_id": "6c62e93b-8b88-3079-ba39-65fccddcfc07",
                                        "glosses": [
