                        "glosses": [
                            "Se dit d’un liquide qui ne répond pas aux lois de Newton sur la viscosité des fluides."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "53c68d00-440f-4149-8aeb-a69903675201",
                                "sense_id": "251e1da8-9e2f-3d60-8b12-c03257305418",
                                "text": "Le miel et l’empois d’amidon sont des liquides non-newtonien."
                            },
                            {
                                "example_id": "1663db60-7e39-44c8-bc2c-9ffbf36af0f4",
                                "sense_id": "251e1da8-9e2f-3d60-8b12-c03257305418",
                                "text": "Par exemple, des boues concentrées de station d'épuration ou les matières grasses peuvent avoir un comportement non-newtonien."
                            }
                        ]
                    }
