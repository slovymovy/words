                                        "entry_id": "2432ef36-bf52-3134-ac8a-03245317ec40",
                                        "glosses": [
                                            "Fille de Zeus et de Déméter, épouse d'Hadès, déesse du renouveau de la végétation au printemps, qui est aussi nommée Coré, et Proserpine par les Romains."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6275a9c-3c8f-42ef-88f5-f2593e0961d0",
                                                "sense_id": "b1495473-3381-37cf-bcb2-ad93823d0b74",
                                                "text": "Il dépêcha son fidèle Hermès sous la terre, afin de convaincre cette fois Hadès de délivrer Perséphone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fcf6d06-0920-34d7-b2e3-b4b43ac2fcb9",
