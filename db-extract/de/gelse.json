                "translations": [
                    {
                        "translation_id": "1f9bc1e9-44a0-4fc9-aa86-f611448b1870",
                        "source_entry_id": "c5e0b734-9460-3a4d-8952-2c932973c8b4",
                        "source_sense_id": "5f3f1f78-f043-30ef-96e3-ea812f8e05b0",
                        "source_sense_description": "Österreich: Stechmücke",
                        "target_lang_word": "mosquito",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mosquito",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "daebbe8d-5023-3a75-98f0-40ad3242b93c",
                                        "entry_id": "0641a3f0-945b-3e3c-b68a-9349444c544f",
                                        "glosses": [
                                            "To fly close to the ground, seemingly without a course."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mosquito",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c99c24fc-75fe-3bd3-8347-a45c7b798e7d",
                                        "entry_id": "db97ecc5-598f-3199-8854-b1b3a1691aed",
                                        "glosses": [
                                            "A small flying insect of the family Culicidae, the females of which bite humans and animals and suck blood, leaving an itching bump on the skin, and sometimes carrying diseases like malaria, dengue and yellow fever."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82c80bc4-636d-41cb-b41d-e7df6846d646",
                                                "sense_id": "c99c24fc-75fe-3bd3-8347-a45c7b798e7d",
                                                "text": "I do not quite know what it was that made me poke my head out of the friendly shelter of the blanket, perhaps because I found that the mosquitoes were biting right through it."
                                            },
                                            {
                                                "example_id": "1ffbe514-ce4d-4c24-95c8-e400393c25e7",
                                                "sense_id": "c99c24fc-75fe-3bd3-8347-a45c7b798e7d",
                                                "text": "We lit a driftwood fire to help keep the mosquitoes away. It was partially successful."
                                            },
                                            {
                                                "example_id": "f04377cf-5fe7-4421-b4f6-35b3b58fce78",
                                                "sense_id": "c99c24fc-75fe-3bd3-8347-a45c7b798e7d",
                                                "text": "Nicaragua has been investigating the possibility that the 1985 outbreak of dengue fever along its Honduran border may have resulted from the release of infected mosquitos by U.S. reconnaissance overflights."
                                            },
                                            {
                                                "example_id": "dd8dab67-4b67-46fd-b934-7cfb5191d557",
                                                "sense_id": "c99c24fc-75fe-3bd3-8347-a45c7b798e7d",
                                                "text": "Sue had climbed up to the rafters and attached her mosquito netting over one of the exposed beams in the ceiling, and Edgar had climbed into the bed under it so no flying buzzies would mess with his ears."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f9f2dc1-1624-4189-8084-cb33165f2297",
                        "source_entry_id": "c5e0b734-9460-3a4d-8952-2c932973c8b4",
                        "source_sense_id": "5f3f1f78-f043-30ef-96e3-ea812f8e05b0",
                        "source_sense_description": "Österreich: Stechmücke",
                        "target_lang_word": "moustique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moustique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4b44d22-95d1-3bb8-97a7-0781639f5e02",
                                        "entry_id": "fe5652fb-a14a-3f20-8b10-afe9db2576c1",
                                        "glosses": [
                                            "Insecte diptère de la famille des culicidés dont la femelle pique les animaux dont l’humain et leur pompe du sang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "723102ca-dddc-410e-8f69-367ad912c580",
                                                "sense_id": "f4b44d22-95d1-3bb8-97a7-0781639f5e02",
                                                "text": "La neige en cristaux fins tombe en voltigeant comme une immense nuée de moustiques."
                                            },
                                            {
                                                "example_id": "5bf414dd-53a3-4396-b329-f3fee898d3cc",
                                                "sense_id": "f4b44d22-95d1-3bb8-97a7-0781639f5e02",
                                                "text": "Les nuits, pires que les jours, voyaient surgir l’armée innombrable des moustiques les plus gros, les plus venimeux qui aient jamais existé sous nos latitudes."
                                            },
                                            {
                                                "example_id": "032ebfe7-abcd-49b6-8472-ee9f9d2947d9",
                                                "sense_id": "f4b44d22-95d1-3bb8-97a7-0781639f5e02",
                                                "text": "Les moustiques transmettent la fièvre de trois jours, la cowdriose et la fièvre de la vallée du Rift."
                                            },
                                            {
                                                "example_id": "efed78a6-56e1-4473-9244-29e54d738975",
                                                "sense_id": "f4b44d22-95d1-3bb8-97a7-0781639f5e02",
                                                "text": "Un ciel grisailleux couvrait la mangrove à la grande joie des moustiques porteurs de fièvre qu’il avait fallu faire fuir vitement-pressé en allumant ici et là ces grands feux de bois que les anciens appelaient charibaudées."
                                            },
                                            {
                                                "example_id": "f421ae4a-be15-4937-afd4-37f8dad824e8",
                                                "sense_id": "f4b44d22-95d1-3bb8-97a7-0781639f5e02",
                                                "text": "Si je crie chaque fois que les moustiques me piquent, mon cri appartient aux moustiques. Une réaction appartient toujours à celui qui la provoque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ea60c27-4e8f-3ad0-b922-ed629f3f6d74",
                                        "entry_id": "fe5652fb-a14a-3f20-8b10-afe9db2576c1",
                                        "glosses": [
                                            "Enfant ou adulte de taille minuscule."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5b008be-cabe-4330-b6ed-aa4f767be9e9",
                        "source_entry_id": "c5e0b734-9460-3a4d-8952-2c932973c8b4",
