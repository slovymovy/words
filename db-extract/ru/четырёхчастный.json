                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e9d7698-9012-46be-b8d8-a5b8b9b26b6f",
                        "source_entry_id": "4a86966b-b884-3f0b-a8fa-33a1b532e35f",
                        "source_sense_id": "3146558a-f6d6-3969-b370-9ea26011cd58",
                        "target_lang_word": "quadruple",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quadruple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea13903c-6fa4-390a-a2e2-ce0f568038ed",
                                        "entry_id": "296759de-105b-3d26-a886-9227a8c73e1d",
                                        "glosses": [
                                            "Being four times as long, as big or as many of something."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f84b5791-7130-4b1d-a092-b1116e5e30f2",
                                                "sense_id": "ea13903c-6fa4-390a-a2e2-ce0f568038ed",
                                                "text": "He's quite an athlete and can do quadruple jumps with ease."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quadruple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03b58ab6-81a3-383c-aaa9-b96d2f786366",
                                        "entry_id": "b08ca444-79c6-38e2-a3f6-2db25217f3c5",
                                        "glosses": [
                                            "To multiply by four."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e5194d5-fb6a-4521-877e-0820b2d82197",
                                                "sense_id": "03b58ab6-81a3-383c-aaa9-b96d2f786366",
                                                "text": "Quadrupling four gives sixteen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "053058e3-7599-3539-966b-f7316be47199",
                                        "entry_id": "b08ca444-79c6-38e2-a3f6-2db25217f3c5",
                                        "glosses": [
                                            "To increase by a factor of four."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d29a56c-364a-412a-b1fd-3c93ca8ba9c4",
                                                "sense_id": "053058e3-7599-3539-966b-f7316be47199",
                                                "text": "Our profits quadrupled when we made the improvements."
                                            },
                                            {
                                                "example_id": "1bc6fd10-250d-454f-b67c-5d3adbef598c",
                                                "sense_id": "053058e3-7599-3539-966b-f7316be47199",
                                                "text": "Overall, consumer spending on fast tech has quadrupled to £11.6bn since 2023, surveys carried out for Material Focus suggested."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "041479dd-eb07-333a-9f93-511a7de99c80",
                                        "entry_id": "b08ca444-79c6-38e2-a3f6-2db25217f3c5",
                                        "glosses": [
                                            "To provide four parallel running lines on a given stretch of railway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e147b39e-6a9d-4364-97dd-a50ae7e2767e",
                                                "sense_id": "041479dd-eb07-333a-9f93-511a7de99c80",
                                                "text": "On June 8, 1872, the London & North Western Railway obtained powers to quadruple its main line, and a new tunnel was bored for the up and down slow lines."
                                            },
                                            {
                                                "example_id": "4531f997-a6a6-418a-b950-a655d3552d90",
                                                "sense_id": "041479dd-eb07-333a-9f93-511a7de99c80",
                                                "text": "Quadrupling the short remaining stretch of three-track railway north of Rugby, left over by the turn of the century modernisation, is a possibility that could be pursued."
                                            },
                                            {
                                                "example_id": "c1bce03f-cf36-4d27-a795-71967cc9df94",
                                                "sense_id": "041479dd-eb07-333a-9f93-511a7de99c80",
                                                "text": "A long-term aspiration is to quadruple the cross-country route between Peterborough and Werrington Junction, removing any conflict between trains on the Spalding and Leicester lines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quadruple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48712ba8-1a97-39e0-bed1-4c6750d1754e",
