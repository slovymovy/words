                        "glosses": [
                            "weibliche Person, die geistigen Diebstahl begeht oder begangen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f504020-7741-4d14-9a27-547e99d7cc77",
                                "sense_id": "781776e7-20aa-310b-b51f-116c81a669d8",
                                "text": "„In Zukunft wird die Plagiatorin Koch-Mehrin über die Förderung von Forschungsprojekten innerhalb der EU mitentscheiden dürfen.“"
                            },
                            {
                                "example_id": "fc7e6ccf-aa53-48f3-b034-1685b9b2b0e2",
                                "sense_id": "781776e7-20aa-310b-b51f-116c81a669d8",
                                "text": "„Der Deutsche Hochschulverband hält Schavan für eine \"überführte Plagiatorin\" und ihre Berufung in den Hochschulrat der LMU für einen \"Affront\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
