    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7795e306-310d-34ff-bbd2-01ad7203458e",
                    "sense_definition": "de eigenschap of toestand van het lelijk of onooglijk zijn",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De architectuur van dat oude gebouw viel vooral op door zijn enorme <w>lelijkheid</w>.",
                            "target_lang_translations": {
                                "de": "Die Architektur jenes alten Gebäudes fiel vor allem durch ihre enorme <w>Hässlichkeit</w> auf."
                            }
                        },
                        {
                            "text": "Hij zag ondanks alle <w>lelijkheid</w> van de grauwe stad toch nog iets moois.",
                            "target_lang_translations": {
                                "de": "Er sah trotz all der <w>Hässlichkeit</w> der grauen Stadt dennoch etwas Schönes."
                            }
                        }
                    ],
                    "synonyms": [
                        "lelijkte"
                    ],
                    "antonyms": [
                        "schoonheid"
                    ],
                    "target_lang_definitions": {
                        "de": "die Eigenschaft oder der Zustand, hässlich oder unansehnlich zu sein"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Hässlichkeit",
                                "target_lang_sense_clarification": "Eigenschaft des Unschönen"
                            },
                            {
                                "target_lang_word": "Unansehnlichkeit",
                                "target_lang_sense_clarification": "Mangel an Schönheit oder Reiz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20c66567-d59d-323a-9e09-d76782561579",
                    "sense_definition": "iets of iemand die buitengewoon onaantrekkelijk of lelijk is",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een afschuwelijke <w>lelijkheid</w> heeft de ontwerper daar nu neergezet?",
                            "target_lang_translations": {
                                "de": "Was für eine scheußliche <w>Hässlichkeit</w> hat der Designer da bloß hingesetzt?"
                            }
                        },
                        {
                            "text": "Ik vind die nieuwe vaas in de woonkamer echt een <w>lelijkheid</w>.",
                            "target_lang_translations": {
                                "de": "Ich finde die neue Vase im Wohnzimmer wirklich ein <w>Scheusal</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "etwas oder jemand, das bzw. der außergewöhnlich unattraktiv oder hässlich ist"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Scheusal",
                                "target_lang_sense_clarification": "sehr hässlicher Gegenstand oder Mensch"
                            },
                            {
                                "target_lang_word": "Missgeburt",
                                "target_lang_sense_clarification": "abwertend für ein misslungenes oder extrem hässliches Ding"
                            },
                            {
                                "target_lang_word": "Hässlichkeit",
                                "target_lang_sense_clarification": "ein hässliches Ding oder Wesen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3680b661-b35b-357e-a492-1fc3fa995607",
                    "sense_definition": "onaangenaam, gemeen of verwerpelijk gedrag of karaktertrek",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moreel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ruzie bracht alle verborgen <w>lelijkheid</w> van hun relatie naar boven.",
                            "target_lang_translations": {
                                "de": "Der Streit brachte all die verborgene <w>Hässlichkeit</w> ihrer Beziehung zum Vorschein."
                            }
                        },
                        {
                            "text": "Hij schrok van de morele <w>lelijkheid</w> waarmee de man over zijn buren sprak.",
                            "target_lang_translations": {
                                "de": "Er erschrak über die moralische <w>Hässlichkeit</w>, mit der der Mann über seine Nachbarn sprach."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "unangenehmes, gemeines oder verwerfliches Verhalten bzw. ein ebensolcher Charakterzug"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Hässlichkeit",
                                "target_lang_sense_clarification": "moralische oder charakterliche Verwerflichkeit"
                            },
                            {
                                "target_lang_word": "Gemeinheit",
                                "target_lang_sense_clarification": "boshaftes oder niederträchtiges Verhalten"
                            },
                            {
                                "target_lang_word": "Niedertracht",
                                "target_lang_sense_clarification": "niedere Gesinnung oder Verhaltensweise"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}