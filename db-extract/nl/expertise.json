                ],
                "senses": [
                    {
                        "sense_id": "8bf57dc7-ea99-3cfa-abd6-b55a4c70e394",
                        "entry_id": "3e5ce383-9285-3692-aa8e-3dd694ce93c1",
                        "glosses": [
                            "deskundigheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f854532-6bfa-43fe-a782-c12374bc9b86",
                                "sense_id": "8bf57dc7-ea99-3cfa-abd6-b55a4c70e394",
                                "text": "Het oudste gedeelte van het paleis heeft heel bijzondere facetten. Zo zijn er wanden geschilderd met de scagliola-techniek. Dat is een Italiaanse techniek waarbij stucwerk wordt geschilderd alsof het marmer is. Ook in die wanden zitten scheurtjes. Om dat te herstellen heb je een hele aparte aanpak nodig. Die expertise is in ons kleine landje niet makkelijk te vinden."
                            },
                            {
                                "example_id": "79528d18-a642-4d58-8d12-70f696f9e2f3",
                                "sense_id": "8bf57dc7-ea99-3cfa-abd6-b55a4c70e394",
                                "text": "Zo'n taalstudie zou ook op één plaats geconcentreerd moeten worden. \"We kunnen nu op vijf plaatsen Duits studeren. Het is beter om de expertise te bundelen en het op één plaats goed te geven.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "ce0ad73c-b86e-30fc-8c0c-c168c43b8f58",
                        "entry_id": "3e5ce383-9285-3692-aa8e-3dd694ce93c1",
                        "glosses": [
                            "onderzoek door deskundigen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b094ab94-62a2-413d-bbdc-bb2662464871",
                        "source_entry_id": "3e5ce383-9285-3692-aa8e-3dd694ce93c1",
                        "target_lang_word": "Expertise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Expertise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5040782f-8163-32dc-8bd1-305a918c7400",
                                        "entry_id": "9eaf0340-58d7-30cf-8bba-afa39bb402cf",
                                        "glosses": [
                                            "Eigenschaften, Fähigkeiten oder Wissen, das eine Person zu einem Experten auf einem Gebiet macht"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b89f8e1-21ed-41ed-8f4c-c85b64251ef1",
                                                "sense_id": "5040782f-8163-32dc-8bd1-305a918c7400",
                                                "text": "Nach der jahrelangen Ausbildung verfügt er über die nötige Expertise, um ein solches Vorhaben durchzuführen."
                                            },
                                            {
                                                "example_id": "15df3d45-4e58-4e29-81b1-a2d7cf953364",
                                                "sense_id": "5040782f-8163-32dc-8bd1-305a918c7400",
                                                "text": "„Zudem scheint die Expertise derer, die am meisten mit dem Thema befasst sind, nicht gefragt zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8cc08cd2-5d6a-3046-8608-11416ba03919",
                                        "entry_id": "9eaf0340-58d7-30cf-8bba-afa39bb402cf",
                                        "glosses": [
                                            "(schriftliches) Gutachten eines Fachmanns"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "444dae33-1b3f-4dcb-b55d-a1e161690637",
                                                "sense_id": "8cc08cd2-5d6a-3046-8608-11416ba03919",
                                                "text": "Eine Expertise kann nur ein vereidigter Sachverständiger erstellen."
                                            },
                                            {
                                                "example_id": "c4aabadb-aeb2-4902-8c23-5b4f171b9b38",
                                                "sense_id": "8cc08cd2-5d6a-3046-8608-11416ba03919",
                                                "text": "„Rudolf Schmengers Expertise in Steuerstrafsachen ist nach wie vor gefragt, wenn auch nicht gerade von der hessischen Landesregierung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "196eba36-3e55-4220-bffa-b96ff371cc58",
                        "source_entry_id": "3e5ce383-9285-3692-aa8e-3dd694ce93c1",
                        "target_lang_word": "expertise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expertise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f311914-04b3-3b6d-88e4-be2c3656583a",
                                        "entry_id": "ddf85587-62f9-3bdc-9635-1129e2bf826b",
                                        "glosses": [
                                            "Great skill or knowledge in a particular field or hobby."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb3588e1-9cb7-4066-a838-5d7a5f439856",
                                                "sense_id": "7f311914-04b3-3b6d-88e4-be2c3656583a",
                                                "text": "The scientist has expertise in the field of nuclear fusion."
                                            },
                                            {
                                                "example_id": "30102674-40bc-4984-bed0-da42f31bb88d",
                                                "sense_id": "7f311914-04b3-3b6d-88e4-be2c3656583a",
                                                "text": "He spoke of Scotland's hydroelectric projects in Africa, local expertise shared with the world's poor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75e8364a-5033-37d9-992e-43e8dccfb53c",
                                        "entry_id": "ddf85587-62f9-3bdc-9635-1129e2bf826b",
                                        "glosses": [
                                            "Advice, or opinion, of an expert."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "expertise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd04e261-693d-39e6-832e-af11254c9b9d",
                                        "entry_id": "b36247dd-27aa-3a33-b204-7b32d9202072",
                                        "glosses": [
                                            "To supply with expert knowledge or advice."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0efa1b9e-4425-4802-9130-3cd2d8132125",
                                                "sense_id": "dd04e261-693d-39e6-832e-af11254c9b9d",
                                                "text": "Since 1979, we have developed a method for expertising the design of the processes and improving them."
                                            },
                                            {
                                                "example_id": "194c4253-a0b4-41f6-ba81-64bf17e31296",
                                                "sense_id": "dd04e261-693d-39e6-832e-af11254c9b9d",
                                                "text": "Including a plurality of different expertise in the decision-making processes corresponds to expertising the democratic procedures."
                                            },
                                            {
                                                "example_id": "326b8146-d7c9-4040-a40e-2f4e65d14bda",
                                                "sense_id": "dd04e261-693d-39e6-832e-af11254c9b9d",
                                                "text": "If experts shall lose their expertise, wherewith shall they be expertised? The fact that only the rare economists can be entrusted with economics is not reason to discard economics, but to go and find the rare men."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9e7b9d4-6a6d-4f43-b196-83c9d7621442",
                        "source_entry_id": "3e5ce383-9285-3692-aa8e-3dd694ce93c1",
                        "target_lang_word": "expertise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
