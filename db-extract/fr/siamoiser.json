                "senses": [
                    {
                        "sense_id": "ebe08028-e5e2-342f-9008-f89f10eda2f8",
                        "entry_id": "34606af4-5e1f-30d6-a0ef-00bf174a2edf",
                        "glosses": [
                            "Donner un caractère siamois à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71d805cd-8148-4dc9-b5ac-e19f2c94d5a8",
                                "sense_id": "ebe08028-e5e2-342f-9008-f89f10eda2f8",
                                "text": "Agnès continue à coudre avec pour objectif de siamoiser les chats."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb202a27-d68a-3548-b34a-46f293f27dee",
                        "entry_id": "34606af4-5e1f-30d6-a0ef-00bf174a2edf",
                        "glosses": [
                            "Rendre siamois, inséparables."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a75a7bb-242c-43f2-87e9-dd32efcaa46c",
                                "sense_id": "bb202a27-d68a-3548-b34a-46f293f27dee",
                                "text": "Si je pouvais, on irait, on se ferait \"siamoiser\" de suite."
                            },
                            {
                                "example_id": "69c700e9-ab82-4c10-bc58-e4ae2c6d5e4e",
                                "sense_id": "bb202a27-d68a-3548-b34a-46f293f27dee",
                                "text": "Cette main dans le creux de l’autre qui élucide le sens de la vie. L’amour, c'est quoi au juste ? Peut-être juste ça. Très loin de l’idée de se siamoiser."
                            }
                        ]
                    },
                    {
                        "sense_id": "325e745e-dcc5-36f0-aba0-39e5e5f93caa",
                        "entry_id": "34606af4-5e1f-30d6-a0ef-00bf174a2edf",
                        "glosses": [
                            "Réaliser une greffe siamoise, une parabiose, entre deux organismes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f889b0c0-1978-49ff-a102-9f4778a2e0d0",
                                "sense_id": "325e745e-dcc5-36f0-aba0-39e5e5f93caa",
                                "text": "Mais le fait le plus important, c’est que M. Laurens est arrivé à « siamoiser » des animaux d’espèces différentes."
                            }
                        ]
                    }
                ],
