                "senses": [
                    {
                        "sense_id": "8f32566e-4c48-3853-9b60-d47569e66c3a",
                        "entry_id": "4a5f37d4-4539-3c26-84a3-21418011d410",
                        "glosses": [
                            "Berufsfeld sowie Forschungs- und Lehrdisziplin an Hochschulen, die sich mit kommunikativen Störungen von Menschen aller Altersstufen befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4457ee2-196a-4427-8a8d-b8eb35d6ef2a",
                                "sense_id": "8f32566e-4c48-3853-9b60-d47569e66c3a",
                                "text": "„Am Lehrstuhl für Sprachheilpädagogik (Sprachtherapie und Förderschwerpunkt Sprache) beschäftigen wir uns mit Menschen aller Altersstufen mit Sprach-, Sprech-, Rede-, Stimm- und Schluckstörungen.“"
                            },
                            {
                                "example_id": "ec4b985b-d7de-4228-8966-f97dd25f8b6c",
                                "sense_id": "8f32566e-4c48-3853-9b60-d47569e66c3a",
                                "text": "„Ist die Sprachheilpädagogik tatsächlich zu einer rein rationalistischen Wissenschaft geworden, in der um Ideen gerungen wird, die sich in Elfenbeintürmen, aber nicht mehr neben PatientInnen [sic] und SchülerInnen [sic] bewähren?“"
                            }
                        ],
