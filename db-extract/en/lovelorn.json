                        "tags": [
                            "comparative"
                        ],
                        "form": "more lovelorn"
                    },
                    {
                        "form_id": "6e4b4031-f90b-426b-8477-3d8cf81ffa1d",
                        "entry_id": "cb7ceac8-ca04-38a3-9142-ca11fa0d3dce",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most lovelorn"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "79173ad2-deb2-31ae-a3eb-999074142fed",
                        "entry_id": "cb7ceac8-ca04-38a3-9142-ca11fa0d3dce",
                        "glosses": [
                            "Abandoned or forsaken by one's lover; having constant bad luck in romance; desperate for love."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3ac5329-a2af-4e81-a857-795281722702",
                                "sense_id": "79173ad2-deb2-31ae-a3eb-999074142fed",
                                "text": "Ye lovesick bards! repay her scorn for scorn; / Ye artists lovelorn! madmen that ye are, / Make your best bow to her and bid adieu / Then, if she likes it, she will follow you."
                            },
                            {
                                "example_id": "cf6bc6a5-2ef9-46c2-a878-fb3ad8237eba",
                                "sense_id": "79173ad2-deb2-31ae-a3eb-999074142fed",
                                "text": "A soft-breasted bird from the sea / Fell in love with the light-house flame; / And it wheeled round the tower on its airiest wing, / And floated and cried like a lovelorn thing;"
                            }
                        ]
                    },
                    {
                        "sense_id": "02965caf-2766-3489-9677-11e28369d474",
                        "entry_id": "cb7ceac8-ca04-38a3-9142-ca11fa0d3dce",
                        "glosses": [
                            "Unloved, bereft of love."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02eb4738-6e1e-47a2-b71f-46f7807ffa6e",
                        "source_entry_id": "cb7ceac8-ca04-38a3-9142-ca11fa0d3dce",
                        "source_sense_description": "being lorn by love",
                        "target_lang_word": "liebeskrank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liebeskrank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2875a8c3-8dd8-3eb4-80b4-860dd5ae3643",
                                        "entry_id": "42befefa-ce95-37f8-b7e4-57d3ef9088c9",
                                        "glosses": [
                                            "so sehr auf das Objekt der (oft unerwiderten) Liebe fixiert, dass das tägliche Leben beeinträchtigt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "610a20c0-203b-4bb1-9934-0d3b37b4ef50",
                                                "sense_id": "2875a8c3-8dd8-3eb4-80b4-860dd5ae3643",
                                                "text": "Sie nennt sich Tamara, Gabriela oder Doratinka - und schröpft liebeskranke Frauen. Die „Hexe\" ist eine schwarzhaarige, auffällig kleine Frau, etwa 1,55 m groß."
                                            },
                                            {
                                                "example_id": "17e3aa51-2e0c-428e-afc3-63ffff01cc9f",
                                                "sense_id": "2875a8c3-8dd8-3eb4-80b4-860dd5ae3643",
                                                "text": "Ich habe mich zwischendurch aufgeführt wie ein liebeskranker Idiot."
                                            },
                                            {
                                                "example_id": "4be75ed5-ec33-4ff7-9a9e-50692bc8c678",
                                                "sense_id": "2875a8c3-8dd8-3eb4-80b4-860dd5ae3643",
                                                "text": "„Die liebeskranke Frau beschäftigt ihn nun schon so lange.“"
                                            },
                                            {
                                                "example_id": "7cb5a0c8-c80b-4c4c-9ed5-95a817639504",
                                                "sense_id": "2875a8c3-8dd8-3eb4-80b4-860dd5ae3643",
                                                "text": "„Sie ließ ihn mit seinem liebeskranken Grinsen an der Zimmertür stehen, schlüpfte schnell in ihr eigenes Zimmer und schloss die Tür hinter sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
