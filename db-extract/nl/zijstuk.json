                "senses": [
                    {
                        "sense_id": "2b0fcd9c-a60c-3749-b11e-3755d6db7103",
                        "entry_id": "241db393-67a8-331e-b1c8-e81644827bdc",
                        "glosses": [
                            "deel van een voorwerp dat de zijkant vormt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "963733ea-9683-441d-9943-96fe94082d85",
                                "sense_id": "2b0fcd9c-a60c-3749-b11e-3755d6db7103",
                                "text": "Kachel? Op een open boot? Net als bij de oerversie van de Landrover kun je een gesloten kajuit maken door losse zijstukken in het frame te ritsen. Zo ontstaat een vierpersoons cockpit die je kunt verwarmen."
                            },
                            {
                                "example_id": "62287c61-9d9f-4643-a3d4-a0e9909e4ebd",
                                "sense_id": "2b0fcd9c-a60c-3749-b11e-3755d6db7103",
                                "text": "De carbon monocoque van de Coupé bestaat uit drie componenten. Het geheel weegt nog geen 100 kilogram. Zowel de voor- als achterzijde en de zijstukken zijn versterkt zodat er bij een mogelijke botsing voldoende bescherming gegarandeerd kan worden. \"Vooral dat veiligheidsaspect is een lastige opgave omdat de Europese normen op een hoog niveau liggen\", aldus Tino."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "daaa31dc-d957-4442-b0ef-8b3789ca0733",
                        "source_entry_id": "241db393-67a8-331e-b1c8-e81644827bdc",
                        "source_sense_id": "2b0fcd9c-a60c-3749-b11e-3755d6db7103",
                        "target_lang_word": "side piece",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "side piece",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98928179-6a98-3a1e-b373-9416969da4e1",
                                        "entry_id": "8dc7ca34-2eeb-3f1f-92bd-5651a5be1eac",
                                        "glosses": [
                                            "A person with whom someone already in a relationship carries on a physical affair (not emotional affair) without having the intention of forming a serious relationship. Not gender specific."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63a2e1fe-8977-4fee-b8c2-b722e0bedc97",
                                                "sense_id": "98928179-6a98-3a1e-b373-9416969da4e1",
                                                "text": "I was already putting two and two together that I was just a side piece — a booty call."
                                            },
                                            {
                                                "example_id": "a9759947-0f01-4dd1-83f2-d0a0d261ec4b",
                                                "sense_id": "98928179-6a98-3a1e-b373-9416969da4e1",
                                                "text": "You basically told him you're cool with being his side piece as long you're number one."
                                            },
                                            {
                                                "example_id": "36831c99-f1fe-48c8-8969-ecba9bb7b330",
                                                "sense_id": "98928179-6a98-3a1e-b373-9416969da4e1",
                                                "text": "I'm just tired of being treated like a side piece and not a wife."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
