                                "example_id": "f3936e40-a387-46ee-8ddb-7ebeeb8820d8",
                                "sense_id": "97d44ecd-f5ef-32a5-acbe-39e150fac3f0",
                                "text": "Hij hield de zware zak op aan een unster om het gewicht te bepalen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d60fcbd-5541-30b6-9f1a-af51c4a845c6",
                        "entry_id": "baf100e2-a16c-3eb2-9f25-30071b28d191",
                        "glosses": [
                            "een eenvoudig weegtoestel gebaseerd op de rek van een veer"
