                        "entry_id": "1a62c29d-f05c-3f78-9d15-8a696f0f98a4",
                        "glosses": [
                            "Fahrzeug, das über keinen eigenen Antrieb verfügt und hinter Kraftfahrzeugen mitgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48e1d2e0-e4f5-4f06-b02b-578b276f0db7",
                                "sense_id": "01b16030-1d60-3e53-8798-f346e34623ea",
                                "text": "„Der Lastwagen kam schnell näher und wuchs sich mehr und mehr zu einem 18-rädrigen Monster aus mit einem Hänger im Schlepptau.“"
                            },
                            {
                                "example_id": "c2393ee4-358e-46be-b1d4-0e5e878e064b",
                                "sense_id": "01b16030-1d60-3e53-8798-f346e34623ea",
                                "text": "„Haraldur biegt auf den Platz vor dem Hof, sieht Aldís an der hohen Kirchenwand stehen, setzt den großen Hänger rückwärts an den Schuppen, stellt den Motor und Cohen ab und steigt vom Traktor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3cf3fc7b-2e93-394d-9906-96097d323b99",
                        "entry_id": "1a62c29d-f05c-3f78-9d15-8a696f0f98a4",
                        "glosses": [
                            "(oft vorübergehender) Zustand nicht zu wissen, wie es weitergeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cecf98f3-b2b0-4977-bf2b-264175caf4fc",
                                "sense_id": "3cf3fc7b-2e93-394d-9906-96097d323b99",
                                "text": "Vor lauter Nervosität hatte sie einen Hänger nach dem anderen."
                            }
                        ],
