                            {
                                "example_id": "130203e2-0dd9-4ddf-9676-5aaf41d2d4a9",
                                "sense_id": "3d33edb4-54e2-3f96-80a9-3bdb8d74954b",
                                "text": "Аль ни пот с лица посыплется, // Аль ни в грудь душа затукает, // Месяц в облака закроется, // Звёзды мелкие попрячутся…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d33cc3f-5ee0-4f7f-9b5b-7348394adb45",
                        "source_entry_id": "c8b4321e-9881-3cc4-b541-37433d235b70",
                        "source_sense_id": "3d33edb4-54e2-3f96-80a9-3bdb8d74954b",
