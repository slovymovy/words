                "senses": [
                    {
                        "sense_id": "bcd9674b-fc09-3e83-91d3-146b0d28d6d5",
                        "entry_id": "4bb70143-81e2-3ab2-9a48-56e7bdcbc50d",
                        "glosses": [
                            "Einrichtung zur Entsorgung und Verarbeitung tierischer Überreste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6102338-cd04-4be9-a641-dcd451af0df8",
                                "sense_id": "bcd9674b-fc09-3e83-91d3-146b0d28d6d5",
                                "text": "„Angehörige des Kreisveterinäramtes Vechta verfolgten die „tiergerechte Tötung“ vor Ort. Die Kadaver werden in der Tierkörperverwertungsanstalt Kampe (Kreis Cloppenburg) entsorgt.“"
                            },
                            {
                                "example_id": "3114a7f0-ea57-4100-a630-a0d16df21dd6",
                                "sense_id": "bcd9674b-fc09-3e83-91d3-146b0d28d6d5",
                                "text": "„Der Tod eines geliebten Hundes ist ein schmerzlicher Verlust. Tote Hunde kommen zumeist in die Tierkörperverwertungsanstalt.“"
                            },
                            {
                                "example_id": "cbcd1378-4f86-4468-8a01-004191b7b0c4",
                                "sense_id": "bcd9674b-fc09-3e83-91d3-146b0d28d6d5",
                                "text": "„Mittels Seilwinde und Kran lud das THW das Pferd auf und transportierte es von der Hinterseite des Hofes an eine Stelle, die für die verständigte Tierkörperverwertungsanstalt zum Abtransport geeignet erschien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
