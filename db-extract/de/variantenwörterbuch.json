                "senses": [
                    {
                        "sense_id": "893b08db-eb61-328b-ba01-3fc7e7b28b9a",
                        "entry_id": "868a2f89-fe37-3280-8053-50bf5d1efdd4",
                        "glosses": [
                            "Wörterbuch, in dem der unterschiedliche Wortschatz in den verschiedenen Sprachregionen einer Sprache dargestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbaf457d-bf84-4ff6-9ef4-2eab5aec15ac",
                                "sense_id": "893b08db-eb61-328b-ba01-3fc7e7b28b9a",
                                "text": "Variantenwörterbücher sind bei allen plurizentrischen Sprachen wie Deutsch sinnvoll und wünschenswert."
                            },
                            {
                                "example_id": "a8d8aca0-5300-4e1d-8b2e-73cd52cc45d5",
                                "sense_id": "893b08db-eb61-328b-ba01-3fc7e7b28b9a",
                                "text": "„Diese „Arroganz der Deutschen gegenüber allem Deutsch, das nicht dem Norddeutschen entspricht“ ließ in Prof. Dr. Ulrich Ammon die Idee zu einem Variantenwörterbuch reifen.“"
                            },
                            {
                                "example_id": "c213e716-3dc3-42aa-a292-a80c14e9acb8",
                                "sense_id": "893b08db-eb61-328b-ba01-3fc7e7b28b9a",
                                "text": "„Aber damit wäre schon der Plan eines neuen \"Variantenwörterbuchs\" skizziert, das als \"Wörterbuch der deutschsprachigen Varianten um 1900\" noch zu schreiben wäre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
