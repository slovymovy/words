                        "sense_id": "5636c2f5-0b6e-3109-8c82-33dfc19408dc",
                        "entry_id": "a435ada7-2849-37e7-bbcf-70eca3dc0549",
                        "glosses": [
                            "Relatif aux Bédouins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "637b12fc-b901-4d25-ad1f-78d5bbed9352",
                                "sense_id": "5636c2f5-0b6e-3109-8c82-33dfc19408dc",
                                "text": "[…] Yasmina jouait distraitement avec des brindilles vertes et chantait une complainte bédouine où, comme dans la vie, l’amour et la mort se côtoient."
                            },
                            {
                                "example_id": "3b671b07-e2a6-4dc8-844d-4dcd9b0fef3b",
                                "sense_id": "5636c2f5-0b6e-3109-8c82-33dfc19408dc",
                                "text": "Casablanca est une ville bédouine. Le gros de sa population se recrute parmi les tribus voisines."
                            },
                            {
                                "example_id": "9fbd96c6-1bc8-4f76-afe3-6bdd409896d5",
                                "sense_id": "5636c2f5-0b6e-3109-8c82-33dfc19408dc",
                                "text": "Sous la tente maure, une petite loge de tissus isole parfois la couche conjugale, tandis que sous la tente bédouine , une cloison de roseau circonscrit le horma (pluriel : harem), l'espace intime réservé à une épouse et à ses jeunes enfants."
                            }
                        ]
                    },
                    {
                        "sense_id": "175e9eda-e763-34d7-a280-d7d50c300457",
                        "entry_id": "a435ada7-2849-37e7-bbcf-70eca3dc0549",
                        "glosses": [
                            "Relatif aux communautés nomades, tribales."
                        ],
