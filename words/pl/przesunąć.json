    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e6abcdfd-991f-3b8c-9b2e-001b5b64fee9",
                    "sense_definition": "zmienić położenie czegoś, ciągnąc lub pchając po jakiejś powierzchni w inne miejsce",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zmiana_pozycji",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy <w>przesunąć</w> tę ciężką szafę, żeby pomalować ścianę za nią.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>передвинуть</w> этот тяжёлый шкаф, чтобы покрасить стену за ним."
                            }
                        },
                        {
                            "text": "Wydobyła płytę z koperty i ostrożnie <w>przesunęła</w> ramię gramofonu na brzeg.",
                            "target_lang_translations": {
                                "ru": "Она достала пластинку из конверта и осторожно <w>передвинула</w> тонарм проигрывателя на край."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przesunąć szafę",
                        "przesunąć krzesło"
                    ],
                    "target_lang_definitions": {
                        "ru": "изменить положение предмета, передвигая или толкая его по поверхности в другое место"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передвинуть",
                                "target_lang_sense_clarification": "сдвинуть предмет на другое место"
                            },
                            {
                                "target_lang_word": "подвинуть",
                                "target_lang_sense_clarification": "переместить немного в сторону"
                            },
                            {
                                "target_lang_word": "сдвинуть",
                                "target_lang_sense_clarification": "сместить с прежнего места"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0c802c2-9ebe-37ce-af4c-07376b8da73d",
                    "sense_definition": "wyznaczyć inny, późniejszy termin jakiegoś wydarzenia",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "zmiana_czasu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z powodu choroby szefa musieliśmy <w>przesunąć</w> nasze spotkanie na przyszły piątek.",
                            "target_lang_translations": {
                                "ru": "Из-за болезни начальника нам пришлось <w>перенести</w> нашу встречу на следующую пятницу."
                            }
                        },
                        {
                            "text": "Nauczyciel zdecydował się <w>przesunąć</w> trudny egzamin o cały tydzień.",
                            "target_lang_translations": {
                                "ru": "Учитель решил <w>перенести</w> сложный экзамен на целую неделю."
                            }
                        }
                    ],
                    "synonyms": [
                        "przełożyć",
                        "odłożyć"
                    ],
                    "common_phrases": [
                        "przesunąć termin",
                        "przesunąć spotkanie"
                    ],
                    "target_lang_definitions": {
                        "ru": "назначить другой, более поздний срок какого-либо события"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перенести",
                                "target_lang_sense_clarification": "изменить дату или время мероприятия"
                            },
                            {
                                "target_lang_word": "отложить",
                                "target_lang_sense_clarification": "перенести на более поздний срок"
                            },
                            {
                                "target_lang_word": "сдвинуть",
                                "target_lang_sense_clarification": "изменить срок или график"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47407f74-494c-34ad-91ef-343b1dffe56e",
                    "sense_definition": "zmienić swoją pozycję, ustępując komuś miejsca",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zmiana_pozycji",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy mógłbyś się trochę <w>przesunąć</w>, aby ta starsza pani mogła usiąść?",
                            "target_lang_translations": {
                                "ru": "Не мог бы ты немного <w>подвинуться</w>, чтобы эта пожилая дама могла сесть?"
                            }
                        },
                        {
                            "text": "Pasażer na ławce <w>przesunął</w> się w stronę okna, robiąc mi wolne miejsce.",
                            "target_lang_translations": {
                                "ru": "Пассажир на скамейке <w>подвинулся</w> к окну, освобождая мне место."
                            }
                        }
                    ],
                    "synonyms": [
                        "posunąć się"
                    ],
                    "common_phrases": [
                        "przesunąć się w bok",
                        "przesunąć się na ławce"
                    ],
                    "target_lang_definitions": {
                        "ru": "изменить свое положение, освобождая или уступая кому-то место"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подвинуться",
                                "target_lang_sense_clarification": "переместиться немного, освобождая место"
                            },
                            {
                                "target_lang_word": "потесниться",
                                "target_lang_sense_clarification": "сжаться или сместиться, чтобы дать место другому"
                            },
                            {
                                "target_lang_word": "отодвинуться",
                                "target_lang_sense_clarification": "переместиться дальше от кого-либо или чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f52c788a-303d-3bd5-ad66-510ba72c7a9e",
                    "sense_definition": "przeciągnąć przedmiotem, na przykład kartą płatniczą lub palcem, po powierzchni urządzenia",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kasjerka poprosiła klienta, aby ponownie <w>przesunął</w> kartę przez czytnik terminala.",
                            "target_lang_translations": {
                                "ru": "Кассир попросила клиента снова <w>провести</w> картой через считыватель терминала."
                            }
                        },
                        {
                            "text": "Aby odblokować ekran telefonu, należy <w>przesunąć</w> palcem z dołu do góry.",
                            "target_lang_translations": {
                                "ru": "Чтобы разблокировать экран телефона, нужно <w>провести</w> пальцем снизу вверх."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przesunąć kartę",
                        "przesunąć palcem po ekranie"
                    ],
                    "target_lang_definitions": {
                        "ru": "провести предметом (например, банковской картой или пальцем) по поверхности устройства"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провести",
                                "target_lang_sense_clarification": "провести картой или пальцем по экрану/терминалу"
                            },
                            {
                                "target_lang_word": "смахнуть",
                                "target_lang_sense_clarification": "сделать свайп пальцем по экрану"
                            }
                        ]
                    }
                }
            ]
        }
