                "senses": [
                    {
                        "sense_id": "8eb02818-565c-3f0b-abd9-eff22fd03b3a",
                        "entry_id": "f29d6791-4b0f-33ae-90ee-a7abe15b0f96",
                        "glosses": [
                            "Projekt, das auf die Verbesserung der Lage von Flüchtlingen abzielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf225d13-28db-473f-a0a4-9ab4605461d2",
                                "sense_id": "8eb02818-565c-3f0b-abd9-eff22fd03b3a",
                                "text": "„Kinder führten einen Tanz in asiatischen Drachenkostümen auf. Ein Sprecher der Vietnamesen bedankte sich für das Engagement des Flüchtlingsprojekts. In einer Schweigeminute wurde der auf der Flucht ums Leben gekommenen Menschen gedacht.“"
                            },
                            {
                                "example_id": "2dd9d473-8148-41d7-b2ca-e3b97e6a70d9",
                                "sense_id": "8eb02818-565c-3f0b-abd9-eff22fd03b3a",
                                "text": "„2009 erzielte der Verein Einnahmen von knapp drei Millionen Euro und konnte somit fast 2,2 Millionen Euro für die weltweite Projektförderung sowie für Aktivitäten zur Verfügung stellen, die in der Öffentlichkeit Verständnis für Flüchtlinge schaffen sollen. Der größte Anteil (fast 1,3 Millionen Euro) kam erneut der UNHCR-Nothilfe zugute. Insgesamt wurden 2009 67 Flüchtlingsprojekte im In- und Ausland gefördert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
