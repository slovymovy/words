{
    "word_family": [
        "strange",
        "strangely",
        "strangeness",
        "estrange",
        "estrangement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "71470f70-2877-3d1d-9a99-22c588221bfb",
                    "sense_definition": "A person whom one does not know; someone who is neither a friend nor an acquaintance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "unknown_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She told her children never to accept gifts from a <w>stranger</w>.",
                            "target_lang_translations": {
                                "ru": "Она велела своим детям никогда не принимать подарки от <w>незнакомца</w>.",
                                "zh": "她告诉孩子们永远不要接受<w>陌生人</w>的礼物。"
                            }
                        },
                        {
                            "text": "I felt shy because everyone at the party was a complete <w>stranger</w> to me.",
                            "target_lang_translations": {
                                "ru": "Я стеснялся, потому что все на вечеринке были мне совершенно <w>незнакомы</w>.",
                                "zh": "我感到很害羞，因为聚会上的每个人对我来说都是完全的<w>陌生人</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "friend",
                        "acquaintance"
                    ],
                    "common_phrases": [
                        "total stranger",
                        "perfect stranger",
                        "talk to strangers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, которого вы не знаете; тот, кто не является ни другом, ни знакомым.",
                        "zh": "指不认识的人；既非朋友也非熟人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незнакомец",
                                "target_lang_sense_clarification": "человек, с которым вы не знакомы"
                            },
                            {
                                "target_lang_word": "посторонний",
                                "target_lang_sense_clarification": "чужой, не близкий человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陌生人",
                                "target_lang_sense_clarification": "指彼此不认识的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d8cdd05-8c7c-303d-9ae5-42aace57c8bc",
                    "sense_definition": "An outsider or foreigner who is not from a specific place or community.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "unknown_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He arrived in the village as a <w>stranger</w>, but soon made many friends.",
                            "target_lang_translations": {
                                "ru": "Он приехал в деревню <w>чужаком</w>, но вскоре завел много друзей.",
                                "zh": "他刚到村子时还是个<w>外地人</w>，但很快就交到了许多朋友。"
                            }
                        },
                        {
                            "text": "I am a <w>stranger</w> in this city and do not know my way around.",
                            "target_lang_translations": {
                                "ru": "Я <w>чужой</w> в этом городе и не знаю дороги.",
                                "zh": "我是这个城市的<w>外来者</w>，不熟悉这里的路。"
                            }
                        }
                    ],
                    "antonyms": [
                        "resident",
                        "compatriot",
                        "countryman",
                        "national"
                    ],
                    "common_phrases": [
                        "stranger to these parts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чужак или иностранец, не принадлежащий к данному месту или сообществу.",
                        "zh": "指来自外地或不属于特定社区的局外人或外来者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чужак",
                                "target_lang_sense_clarification": "человек из другой среды или местности"
                            },
                            {
                                "target_lang_word": "чужой",
                                "target_lang_sense_clarification": "не свой, посторонний в данной группе"
                            },
                            {
                                "target_lang_word": "приезжий",
                                "target_lang_sense_clarification": "человек, приехавший из другого места"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外地人",
                                "target_lang_sense_clarification": "指从外地来的人"
                            },
                            {
                                "target_lang_word": "外来者",
                                "target_lang_sense_clarification": "指进入某地或某群体的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4229b64b-15c3-3362-abf7-9c9e26777de3",
                    "sense_definition": "A newcomer to a place, activity, or experience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unknown_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a <w>stranger</w> to the game of golf, I had to learn the rules from scratch.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>новичком</w> в гольфе, мне пришлось учить правила с нуля.",
                                "zh": "作为高尔夫球的<w>新手</w>，我不得不从零开始学习规则。"
                            }
                        },
                        {
                            "text": "The manager is no <w>stranger</w> to hard work and expects the same from his team.",
                            "target_lang_translations": {
                                "ru": "Менеджеру не <w>в новинку</w> тяжелая работа, и он ожидает того же от своей команды.",
                                "zh": "经理对辛苦工作并不<w>陌生</w>，他也同样要求他的团队。"
                            }
                        }
                    ],
                    "synonyms": [
                        "newcomer",
                        "beginner",
                        "newbie"
                    ],
                    "common_phrases": [
                        "no stranger to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Новичок в каком-либо месте, деятельности или опыте.",
                        "zh": "指对某地、某项活动或某种经历缺乏经验的新手。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новичок",
                                "target_lang_sense_clarification": "тот, кто недавно начал заниматься чем-либо"
                            },
                            {
                                "target_lang_word": "незнакомый",
                                "target_lang_sense_clarification": "не имеющий опыта в чем-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新手",
                                "target_lang_sense_clarification": "指刚开始接触某事的人"
                            },
                            {
                                "target_lang_word": "门外汉",
                                "target_lang_sense_clarification": "指对某领域缺乏了解的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a46ac7f-577b-3209-a3b0-7447ac2d1f4b",
                    "sense_definition": "A term of address used ironically or affectionately for a friend or acquaintance one has not seen for a long time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hello, <w>stranger</w>! I haven't seen you in ages.",
                            "target_lang_translations": {
                                "ru": "Привет, <w>пропажа</w>! Я не видел тебя целую вечность.",
                                "zh": "嘿，<w>稀客</w>！好久不见了。"
                            }
                        },
                        {
                            "text": "Look who decided to show up; hello <w>stranger</w>.",
                            "target_lang_translations": {
                                "ru": "Смотрите, кто решил появиться; привет, <w>пропажа</w>.",
                                "zh": "看看是谁来了；你好啊，<w>稀客</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hello stranger"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "ironic or affectionate"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ироничное или ласковое обращение к другу или знакомому, которого давно не видели.",
                        "zh": "用于称呼久未谋面的朋友或熟人，带有讽刺或亲昵的意味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропажа",
                                "target_lang_sense_clarification": "разговорное обращение к тому, кто долго отсутствовал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "稀客",
                                "target_lang_sense_clarification": "指久未见面的客人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd731a08-2cd4-3ad9-8f93-019204238a76",
                    "sense_definition": "One not privy or party to an act, contract, or title; a third party.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>stranger</w> to the contract cannot normally enforce its terms.",
                            "target_lang_translations": {
                                "ru": "<w>Постороннее лицо</w> в договоре обычно не может требовать исполнения его условий.",
                                "zh": "合同的<w>第三方</w>通常无法强制执行其条款。"
                            }
                        },
                        {
                            "text": "Possession of the land gives a good title against a <w>stranger</w>.",
                            "target_lang_translations": {
                                "ru": "Владение землей дает правовой титул против <w>третьих лиц</w>.",
                                "zh": "对土地的占有权在对抗<w>局外人</w>时具有合法的权利。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, не являющееся стороной в акте, договоре или правовом титуле; третья сторона.",
                        "zh": "指未参与某项行为、合同或权利的人；第三方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "постороннее лицо",
                                "target_lang_sense_clarification": "юридический термин"
                            },
                            {
                                "target_lang_word": "третье лицо",
                                "target_lang_sense_clarification": "лицо, не участвующее в договоре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "第三方",
                                "target_lang_sense_clarification": "法律术语，指合同之外的人"
                            },
                            {
                                "target_lang_word": "局外人",
                                "target_lang_sense_clarification": "指不参与某事的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cc69b93b-2e94-37a7-94a7-15b8f2968c54",
                    "sense_definition": "Comparative form of <w>strange</w>: more strange.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The situation became <w>stranger</w> and more confusing as the night went on.",
                            "target_lang_translations": {
                                "ru": "С наступлением ночи ситуация становилась всё <w>более странной</w> и запутанной.",
                                "zh": "随着夜色渐深，情况变得越来越<w>奇怪</w>且令人困惑。"
                            }
                        },
                        {
                            "text": "Truth is often <w>stranger</w> than fiction.",
                            "target_lang_translations": {
                                "ru": "Правда часто <w>удивительнее</w> вымысла.",
                                "zh": "事实往往比虚构更<w>奇怪</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stranger than fiction"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная степень прилагательного strange: более странный.",
                        "zh": "strange的比较级：更奇怪的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "более странный",
                                "target_lang_sense_clarification": "сравнительная степень"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更奇怪",
                                "target_lang_sense_clarification": "形容词比较级"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "355ceeb9-7e7a-378b-924e-48c62772bbb5",
                    "sense_definition": "To estrange; to alienate someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt <w>strangered</w> from his own family after the argument.",
                            "target_lang_translations": {
                                "ru": "После ссоры он чувствовал себя <w>отчужденным</w> от собственной семьи.",
                                "zh": "争吵过后，他感到与自己的家人<w>疏远</w>了。"
                            }
                        },
                        {
                            "text": "The long war had <w>strangered</w> the two nations.",
                            "target_lang_translations": {
                                "ru": "Долгая война <w>сделала чужими</w> две нации.",
                                "zh": "长期的战争使这两个国家变得<w>疏远</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отчуждать; делать чужим.",
                        "zh": "使疏远；使变得生疏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчуждать",
                                "target_lang_sense_clarification": "делать далеким, чужим"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "疏远",
                                "target_lang_sense_clarification": "使关系变得冷淡"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}