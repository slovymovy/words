                "senses": [
                    {
                        "sense_id": "0c3b53aa-74a5-3c20-959c-05f0abd457db",
                        "entry_id": "a93bcf8b-ff5c-37da-9ab5-4e1f13bc5a7d",
                        "glosses": [
                            "Prozess der Umwandlung einer Industriegesellschaft hin zu einer Dienstleistungsgesellschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a810c3c-99bf-4d72-8c69-d97be81f67fc",
                                "sense_id": "0c3b53aa-74a5-3c20-959c-05f0abd457db",
                                "text": "„Im Prozess der Tertiärisierung schrumpfte der industrielle Sektor, während der Servicesektor wuchs.“"
                            },
                            {
                                "example_id": "cde1a290-1f71-4d86-b437-04d073765a45",
                                "sense_id": "0c3b53aa-74a5-3c20-959c-05f0abd457db",
                                "text": "„Die Tertiärisierung trug auch dazu bei, dass sich das sozioökonomische Profil der in der Schweiz lebenden Ausländer veränderte.“"
                            },
                            {
                                "example_id": "017f7178-af2e-46c9-a226-a649f46594b6",
                                "sense_id": "0c3b53aa-74a5-3c20-959c-05f0abd457db",
                                "text": "„Der Trend zur Tertiärisierung und zur Wissensgesellschaft wird außerdem auch zu einer Zunahme von Immobiliendienstleistungen führen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
