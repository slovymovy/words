                    },
                    {
                        "sense_id": "f4222f4d-6b08-305c-ace6-91f41896506f",
                        "entry_id": "07ce673c-3e4e-33cf-944c-5dc6f307b9fc",
                        "glosses": [
                            "A small cloth bag filled with dry beans, used as a toy or for exercising the hands."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57025830-77a1-4d8e-873c-5679a2fbb539",
                                "sense_id": "f4222f4d-6b08-305c-ace6-91f41896506f",
                                "text": "Does it bounce around like a superball in a hollow cavity? Or does it rapidly lose its force, like a beanbag hitting a pillow?"
                            }
                        ]
                    },
                    {
                        "sense_id": "a1dc5086-0038-38f7-946f-dceb523cec83",
