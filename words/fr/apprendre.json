    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "58856ebc-c5b3-31c8-9ef9-e7f2e8747416",
                    "sense_definition": "Acquérir une connaissance, une technique ou un savoir-faire par l'étude ou l'expérience.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "acquisition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants vont à l'école tous les jours pour <w>apprendre</w> à lire et à écrire."
                        },
                        {
                            "text": "Elle souhaite <w>apprendre</w> une langue étrangère avant son prochain voyage en Italie."
                        }
                    ],
                    "common_phrases": [
                        "apprendre une langue",
                        "apprendre par cœur",
                        "apprendre à lire"
                    ]
                },
                {
                    "sense_id": "048d1b17-1221-3bc1-be4b-53124bc01d79",
                    "sense_definition": "Être informé d'une nouvelle, prendre connaissance d'un fait.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai <w>appris</w> la nouvelle ce matin en ouvrant mon courrier électronique."
                        },
                        {
                            "text": "Nous venons d'<w>apprendre</w> son départ précipité pour l'étranger."
                        }
                    ],
                    "common_phrases": [
                        "apprendre la nouvelle",
                        "apprendre par hasard"
                    ]
                },
                {
                    "sense_id": "c7c254d8-f220-3533-8298-fcfb8cc80241",
                    "sense_definition": "Enseigner un savoir, faire acquérir une compétence à quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "enseignement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon grand-père m'a <w>appris</w> à jouer aux échecs durant les vacances."
                        },
                        {
                            "text": "Ce professeur dévoué aime <w>apprendre</w> les mathématiques aux jeunes élèves."
                        }
                    ],
                    "synonyms": [
                        "enseigner",
                        "instruire"
                    ],
                    "common_phrases": [
                        "apprendre la politesse",
                        "apprendre les bases"
                    ]
                },
                {
                    "sense_id": "af3d8e71-d6a3-3118-af7a-b2de269d7420",
                    "sense_definition": "Servir de leçon, constituer une punition pour dissuader d'un comportement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "punition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a raté son train à cause de son retard, cela lui <w>apprendra</w> à être ponctuel."
                        },
                        {
                            "text": "Tu as reçu une amende pour excès de vitesse, ça t'<w>apprendra</w> à rouler trop vite."
                        }
                    ],
                    "common_phrases": [
                        "ça lui apprendra",
                        "ça t'apprendra"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé dans l'expression familière « ça lui apprendra »"
                        }
                    ]
                }
            ]
        }
    ]
