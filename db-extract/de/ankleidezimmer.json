                                        "sense_id": "880a6a88-65b4-3885-8050-fbaa0646c537",
                                        "entry_id": "db78029c-de85-34cf-b103-87c8d588ba3b",
                                        "glosses": [
                                            "Penderie ; garde-robe."
                                        ],
