                        "glosses": [
                            "Chinees hondenras van kleine honden met een stompe snuit waarvan de fok in Nederland verboden is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22fb64c2-58eb-44e8-a2a1-ebbf979764e4",
                                "sense_id": "986538b1-275d-3c78-b4a5-2418eec8bb5e",
                                "text": "Wat het ras betreft lijkt het erop dat een mopshond, een Franse buldog en misschien ook nog een chihuahua aan Jochies verschijning hebben bijgedragen."
                            },
                            {
                                "example_id": "9d1bd0b1-5763-4a31-ade7-0edc9f730d41",
                                "sense_id": "986538b1-275d-3c78-b4a5-2418eec8bb5e",
                                "text": "Een zwart mopshondje met de naam Edda is de inzet van een relletje in de Duitse stad Ahlen. Het dier werd in beslag genomen bij een gezin met schulden en verkocht via eBay, maar blijkt ziek te zijn. De nieuwe eigenaresse eist daarom geld van de stad."
                            }
                        ]
