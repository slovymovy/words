                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W bibliotece nie <w>można</w> głośno rozmawiać.",
                            "target_lang_translations": {
                                "ru": "В библиотеке не <w>разрешается</w> громко разговаривать.",
                                "en": "In the library, you <w>are not allowed</w> to talk loudly.",
                                "nl": "In de bibliotheek <w>mag men</w> niet hardop praten.",
                                "de": "In der Bibliothek <w>darf man</w> nicht laut sprechen.",
                                "fr": "À la bibliothèque, il n'est pas <w>permis de</w> parler fort.",
                                "it": "In biblioteca non <w>è consentito</w> parlare ad alta voce.",
                                "cs": "V knihovně se <w>nesmí</w> nahlas mluvit.",
                                "tr": "Kütüphanede yüksek sesle konuşmak <w>yasaktır</w>.",
                                "es": "En la biblioteca no <w>se permite</w> hablar en voz alta.",
                                "zh": "在图书馆里不<w>允许</w>大声喧哗。"
                            }
                        },
                        {
                            "text": "Czy <w>można</w> tutaj robić zdjęcia z fleszem?",
                            "target_lang_translations": {
                                "ru": "<w>Можно</w> ли здесь фотографировать со вспышкой?",
                                "en": "<w>May</w> I take photos with a flash here?",
                                "nl": "<w>Mag men</w> hier foto's maken met flitser?",
                                "de": "<w>Darf man</w> hier mit Blitz fotografieren?",
                                "fr": "<w>Peut-on</w> prendre des photos avec flash ici ?",
                                "it": "<w>Si possono</w> fare foto con il flash qui?",
                                "cs": "<w>Smí</w> se zde fotit s bleskem?",
                                "tr": "Burada flaşlı fotoğraf çekmek <w>serbest mi</w>?",
                                "es": "¿<w>Se puede</w> tomar fotos con flash aquí?",
                                "zh": "这里<w>可以</w>开闪光灯拍照吗？"
                            }
                        }
