                ],
                "senses": [
                    {
                        "sense_id": "dfca0942-fdcf-3a46-b55b-e865bc21591a",
                        "entry_id": "94288f0f-c5fd-3ff0-a053-f58f1610c4e8",
                        "glosses": [
                            "Convertisseur de fonte en acier reposant sur le procédé Bessemer (injection d’oxygène dans le métal en fusion)."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "669cea9b-770d-4b1e-baba-18ed432ee70e",
                                "sense_id": "dfca0942-fdcf-3a46-b55b-e865bc21591a",
                                "text": "Cet établissement est pourvu des moyens de fabrication les plus récents ; il se compose de deux hauts fourneaux, d’un Bessemer et d’un four Siemens Martin, d’une fonderie et d’un atelier de construction."
                            },
                            {
                                "example_id": "5dc89270-390f-456f-b027-fdb42f806ef3",
                                "sense_id": "dfca0942-fdcf-3a46-b55b-e865bc21591a",
                                "text": "Cette matte en fusion est alors introduite dans des Bessemers, qui permettent d’éliminer le fer par soufflage."
                            }
                        ]
                    },
                    {
                        "sense_id": "2bd8a422-fa13-3f78-8375-68674d809868",
                        "entry_id": "94288f0f-c5fd-3ff0-a053-f58f1610c4e8",
                        "glosses": [
                            "Acier obtenu par le procédé Bessemer."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "cd296bc7-d54c-4fb2-a8b4-8cc2e75ea71c",
                                "sense_id": "2bd8a422-fa13-3f78-8375-68674d809868",
                                "text": "En un mot, aujourd’hui l’on fabrique couramment et sur la plus grande échelle, à des prix très-modérés, un acier qui satisfait à un grand nombre d’usages ; c’est ainsi qu'en France, à la fin de 1867, on vendait le Bessemer et l’acier puddlé de 310 à 330 francs, pendant que le fer courant était à 200 ou à 190 francs."
                            }
                        ]
                    }
                ],
