                "translations": [
                    {
                        "translation_id": "92dd0262-2e50-4c6d-8a3c-b9aab732c5a2",
                        "source_entry_id": "11ea5150-13fa-34cb-9f47-3ca792ddb7ec",
                        "target_lang_word": "sip",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ad670d6-e83f-3889-8e24-f14509d14e2d",
                                        "entry_id": "c81432c3-114f-3dde-8d58-d1f54f8937d1",
                                        "glosses": [
                                            "A small mouthful of drink"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aae78c81-14f7-3483-83fa-3d4e743a0932",
                                        "entry_id": "c81432c3-114f-3dde-8d58-d1f54f8937d1",
                                        "glosses": [
                                            "An event at which people drink alcohol in small, usually sub-intoxicating amounts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032f0ece-304d-414e-b623-17e500a1d78d",
                                                "sense_id": "aae78c81-14f7-3483-83fa-3d4e743a0932",
                                                "text": "Earl is always a good time. His appearance at parties, whether it's a smart cocktail sip or a basement gig, is mandatory."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb055a1a-39c6-3886-a664-84d6e68c6939",
                                        "entry_id": "59f58eb5-b993-3ce6-b864-cb96eb113f51",
                                        "glosses": [
                                            "To drink slowly, small mouthfuls at a time."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "877298a1-01f5-4628-ba03-2b60acd9f3c8",
                                                "sense_id": "bb055a1a-39c6-3886-a664-84d6e68c6939",
                                                "text": "He held out to me a bowl of steaming broth, that filled the room with a savour sweeter, ten thousand times, to me than every rose and lily of the world; yet would not let me drink it at a gulp, but made me sip it with a spoon like any baby."
                                            },
                                            {
                                                "example_id": "ce6dcc2c-ca1a-4283-988b-9008ebe7b9a0",
                                                "sense_id": "bb055a1a-39c6-3886-a664-84d6e68c6939",
                                                "text": "A waiter brought his aperitif, which was a small scotch and soda, and as he sipped it gratefully he sighed."
                                            },
                                            {
                                                "example_id": "6a6071e0-e63a-44e3-8132-d6e58a04ed7a",
                                                "sense_id": "bb055a1a-39c6-3886-a664-84d6e68c6939",
                                                "text": "bright young things in jeans and T-shirts huddle around laptops, sipping lattes or munching on free food."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "843666e0-61fa-3b28-a68b-00a708e19fd3",
                                        "entry_id": "59f58eb5-b993-3ce6-b864-cb96eb113f51",
                                        "glosses": [
                                            "To drink a small quantity."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06c41bf7-df3f-448d-b8bb-4a52db9f4c3e",
                                                "sense_id": "843666e0-61fa-3b28-a68b-00a708e19fd3",
                                                "text": "[She] rais'd it to her mouth with sober grace; / Then, sipping, offered to the next in place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65121192-424c-31d4-b588-24bce6dfbea7",
                                        "entry_id": "59f58eb5-b993-3ce6-b864-cb96eb113f51",
                                        "glosses": [
                                            "To taste the liquor of; to drink out of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edaee708-df5f-4fd3-8423-8af44177a32c",
                                                "sense_id": "65121192-424c-31d4-b588-24bce6dfbea7",
                                                "text": "They skim the floods, and sip the purple flowers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "346f30a0-5bf9-3603-adf4-d2170d6af242",
                                        "entry_id": "59f58eb5-b993-3ce6-b864-cb96eb113f51",
                                        "glosses": [
                                            "Alternative form of seep."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "US",
                                            "alt-of",
                                            "alternative",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc5463ff-fef9-329b-9987-2db843605c2d",
                                        "entry_id": "59f58eb5-b993-3ce6-b864-cb96eb113f51",
                                        "glosses": [
                                            "To consume slowly."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a81283ea-566f-45bb-a3f9-da58b88a59c0",
                                                "sense_id": "dc5463ff-fef9-329b-9987-2db843605c2d",
                                                "text": "Sales of lightbulbs which sip electricity, and whose increased cost in the shops is easily paid for over their lifetime, used to double every year; in 1990/1991, they leapt sevenfold."
                                            },
                                            {
                                                "example_id": "99451b69-ee9f-4abb-b8e0-e6e0622e150c",
                                                "sense_id": "dc5463ff-fef9-329b-9987-2db843605c2d",
                                                "text": "It makes a small car, the Chevy Cobalt, which sips petrol in moderation and is therefore selling well."
                                            },
                                            {
                                                "example_id": "bf5f8d7b-432b-4d25-a645-8ad12db7d9eb",
                                                "sense_id": "dc5463ff-fef9-329b-9987-2db843605c2d",
                                                "text": "Even when turned off, these devices can idly sip electricity from your outlet costing you money."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19a0b605-1323-4d41-944e-57eac4af9351",
                        "source_entry_id": "11ea5150-13fa-34cb-9f47-3ca792ddb7ec",
                        "target_lang_word": "gulp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gulp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64068841-fefc-3306-a199-ad7902bba4a7",
                                        "entry_id": "a9e67ec4-ca9e-3930-ad2c-7b0ffae2b76b",
                                        "glosses": [
                                            "The usual amount swallowed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f405cfc-cd5a-492e-82b0-b657f0b152d3",
                                                "sense_id": "64068841-fefc-3306-a199-ad7902bba4a7",
                                                "text": "What the liquor was I do not know, but it was not so strong but that I could swallow it in great gulps and found it less burning than my burning throat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8caaab5-3716-3d10-a0d3-3b438e9fed58",
                                        "entry_id": "a9e67ec4-ca9e-3930-ad2c-7b0ffae2b76b",
                                        "glosses": [
                                            "The sound of swallowing, sometimes indicating fear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c613f005-786f-4dfb-85da-c52c417e4562",
                                                "sense_id": "d8caaab5-3716-3d10-a0d3-3b438e9fed58",
                                                "text": "Little Stanislovas was also trembling, and all but too frightened to speak. \"They — they sent me to tell you — \" he said, with a gulp."
                                            },
                                            {
                                                "example_id": "d513c17a-eaea-4994-96c0-d35b074d4eb6",
                                                "sense_id": "d8caaab5-3716-3d10-a0d3-3b438e9fed58",
                                                "text": "Indeed, the envisioned future should produce a bit of \"the gulp factor\" […], there should be an almost audible \"gulp\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26202ca9-4557-3a4d-a72a-e293fb99bc9d",
                                        "entry_id": "a9e67ec4-ca9e-3930-ad2c-7b0ffae2b76b",
                                        "glosses": [
                                            "An unspecified small number of bytes, often two."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gulp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0523ae4c-dc59-39e0-9c95-ace55bfa1b5c",
                                        "entry_id": "5a20514b-3a45-3db3-9bc3-3f85071c592e",
                                        "glosses": [
                                            "To swallow eagerly, or in large draughts; to swallow up; to take down in one swallow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e70f64c1-7299-4e06-b2a6-3307f35c77b4",
                                                "sense_id": "0523ae4c-dc59-39e0-9c95-ace55bfa1b5c",
                                                "text": "He does not swallow, but he gulps it down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11675e07-3cc3-3bf4-8bca-f5bbb4c6a6cd",
                                        "entry_id": "5a20514b-3a45-3db3-9bc3-3f85071c592e",
                                        "glosses": [
                                            "To react nervously by swallowing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f50f5aa-22c8-4a1a-851c-0276b6be31da",
                                                "sense_id": "11675e07-3cc3-3bf4-8bca-f5bbb4c6a6cd",
                                                "text": "The man eyed Percy with a chilly eye. \"Well,\" he said, \"What's troublin you?\" Percy gulped. The man's mere appearance was a sedative. \"Er-nothing! […]\""
                                            },
                                            {
                                                "example_id": "91fadc4c-d878-411f-9cce-c7d5c2c28e2e",
                                                "sense_id": "11675e07-3cc3-3bf4-8bca-f5bbb4c6a6cd",
                                                "text": "I'd always been nervous-excited; this was nervous-terrified. When I finished puking, I sat down gulping air for a while, trying to pull myself together."
                                            },
                                            {
                                                "example_id": "045a5fe5-5047-480b-a52f-884790e939cb",
                                                "sense_id": "11675e07-3cc3-3bf4-8bca-f5bbb4c6a6cd",
                                                "text": "My heart was beating madly and I was gulping nervous energy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gulp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55d40674-1859-36ea-b4ff-741e6dbbbccd",
                                        "entry_id": "57825afd-8189-3055-8d6f-7ec2bbc21f08",
                                        "glosses": [
                                            "An indication of (the sound of) an involuntary fear reaction in the form of a swallowing motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbeaf1d5-d88e-470a-ab67-1c286817f58f",
                                                "sense_id": "55d40674-1859-36ea-b4ff-741e6dbbbccd",
                                                "text": "\"Honey, I know you want to go to their home next week, but there's one thing that keeps happening when we're together that really drives me away from social gatherings in general. (Oh, what is it … gulp.) Well, I'm not sure I can really explain it without offending you. (Gulp, gulp.) Do you really want to talk about it? (Yes.) […]\""
                                            },
                                            {
                                                "example_id": "9762408c-ec66-4149-90ba-ed0f545935b2",
                                                "sense_id": "55d40674-1859-36ea-b4ff-741e6dbbbccd",
                                                "text": "I wonder: if it had not been for GCN, would I now be the one who settles for the semi-closeted, factionalized world that Bay Windows and its ilk define as Shangri-la? Perhaps. What is certain, however, is that you have never jettisoned concern fror anybody for the sake of popularity and (gulp) assimilationist marketability."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
