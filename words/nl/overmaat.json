                    "frequency": "Middle",
                    "semantic_group_id": "overvloed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De plafondverlichting was verschrikkelijk, tot <w>overmaat</w> van ramp versterkt met een blauwglanzende tl-buis boven de deur.",
                            "target_lang_translations": {
                                "en": "The ceiling lighting was terrible, and to make <w>matters</w> worse, it was reinforced by a blue-glowing fluorescent tube above the door."
                            }
                        },
                        {
                            "text": "Munitie voor de Mauser was in <w>overmaat</w> aanwezig, die werd geleverd door de Reichswehr.",
                            "target_lang_translations": {
                                "en": "Ammunition for the Mauser was present in <w>excess</w>, supplied by the Reichswehr."
                            }
                        }
                    ],
