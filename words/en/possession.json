                    "target_lang_definitions": {
                        "ru": "Состояние фактического обладания, владения или контроля над чем-либо.",
                        "zh": "拥有、持有或控制某物的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "владе́ние",
                                "target_lang_sense_clarification": "факт обладания чем-либо"
                            },
                            {
                                "target_lang_word": "облада́ние",
                                "target_lang_sense_clarification": "наличие чего-либо в собственности или под контролем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拥有",
                                "target_lang_sense_clarification": "指持有或占有某物"
                            },
                            {
                                "target_lang_word": "占有",
                                "target_lang_sense_clarification": "指处于控制状态"
                            }
                        ]
