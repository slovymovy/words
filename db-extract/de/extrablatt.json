                "senses": [
                    {
                        "sense_id": "37490428-ac4b-3b73-9080-2a1e23d2cf8d",
                        "entry_id": "55e32a5e-dd02-30e2-ae12-2f0aed2c8d20",
                        "glosses": [
                            "Sonderausgabe einer Zeitung aus aktuellem Anlass"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3de2d89-dee4-4c98-8a63-9f84fdc250a8",
                                "sense_id": "37490428-ac4b-3b73-9080-2a1e23d2cf8d",
                                "text": "„Am Nachmittag verteilten Zeitungsjungen erste Extrablätter.“"
                            },
                            {
                                "example_id": "10b8b6ed-2261-416f-a419-3dc6c2fff451",
                                "sense_id": "37490428-ac4b-3b73-9080-2a1e23d2cf8d",
                                "text": "„Vor dem Savoy Plaza Hotel kaufte ich mir ein anderes Extrablatt, das von einem Zwerg mit einem fadendünnen Schnurrbart ausgeschrien wurde.“"
                            },
                            {
                                "example_id": "ca17a06f-213f-47b9-a19d-e96232cbc2f4",
                                "sense_id": "37490428-ac4b-3b73-9080-2a1e23d2cf8d",
                                "text": "„Die Straßen entlang rannten atemlos Jungen, die Extrablätter verkauften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
