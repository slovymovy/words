                        "source_sense_id": "a8a1f4be-c2cd-3929-b0e0-8d939ad0e49a",
                        "source_sense_description": "characteristic of being brazen",
                        "target_lang_word": "Dreistigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dreistigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                                        "entry_id": "07ea6311-6a7a-37e6-bda9-037e5cf9e3b4",
                                        "glosses": [
                                            "dreiste Art; das Dreistsein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd23e683-910d-4659-84ad-23387ca453da",
                                                "sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                                                "text": "Dreistigkeit siegt."
                                            },
                                            {
                                                "example_id": "3884112a-adbc-4a2e-955d-186d91a08dd1",
                                                "sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                                                "text": "Sie trat mit einer Dreistigkeit ohnegleichen auf."
                                            },
                                            {
                                                "example_id": "de5d9047-5178-4e28-9282-695a0636f2a8",
                                                "sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                                                "text": "Er besaß die Dreistigkeit, einfach den Raum zu verlassen."
                                            },
                                            {
                                                "example_id": "e6c52bef-6e72-4ff4-89f5-e3d4f6c4a9c6",
                                                "sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                                                "text": "„Ihre Dreistigkeit und ihr Selbstvertrauen gingen schließlich so weit, daß sie nicht mehr warteten, bis die Eltern die Wohnung verlassen hatten.“"
                                            },
                                            {
                                                "example_id": "431e2393-96e8-47c9-a82b-8a6f034ca7c3",
                                                "sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                                                "text": "„Bei der Erinnerung daran fing Jay laut an zu lachen über Sabinas Dreistigkeit.“"
                                            },
                                            {
                                                "example_id": "2dacb5bf-f11a-424a-9a44-fb993c983bce",
                                                "sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                                                "text": "„Die Bedeckung, die bei Tuchins Kanonen gestanden hatte, war auf irgendeinen von irgend jemand gegebenen Befehl hin zur Verwendung im Brennpunkt des Gefechts abmarschiert; aber die Batterie feuerte trotzdem weiter und wurde nur deshalb nicht von den Franzosen genommen, weil der Feind es sich nicht vorstellen konnte, dass vier gänzlich ungeschützte Kanonen die Dreistigkeit haben sollten, ihn in dieser Weise zu beschiessen.“"
                                            },
                                            {
                                                "example_id": "0a8b2bb1-4c0c-46dd-bc3b-d4913e145e57",
                                                "sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                                                "text": "„Er lud mich ein, jeden Donnerstag bei ihm zu Mittag zu speisen, und versprach mir, einen Janitscharen zu schicken, der mich vor der Dreistigkeit der Menge schützen und mir alles Sehenswerte zeigen würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fd17be70-5574-3e0d-95d1-0b33007a3648",
                                        "entry_id": "07ea6311-6a7a-37e6-bda9-037e5cf9e3b4",
                                        "glosses": [
                                            "dreiste Aussage oder Handlung; etwas Dreistes"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ff7d0bf-ce73-4f17-af18-9fc5b2fe60f5",
                        "source_entry_id": "1bf262e6-32bb-3ed7-aa8b-6a12c957100c",
                        "source_sense_id": "a8a1f4be-c2cd-3929-b0e0-8d939ad0e49a",
                        "source_sense_description": "characteristic of being brazen",
                        "target_lang_word": "Schamlosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schamlosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbd53ec5-5034-3447-8b59-79452c791750",
                                        "entry_id": "245371d9-57d0-3ad8-a986-684c17b3aa6e",
                                        "glosses": [
                                            "schamlose Art; das Schamlossein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed2b4e5d-45f2-4c45-8ec6-43217faeb661",
                                                "sense_id": "dbd53ec5-5034-3447-8b59-79452c791750",
                                                "text": "„Die Geringschätzung eines guten Rufs heißt Schamlosigkeit.“"
                                            },
                                            {
                                                "example_id": "7c4bc613-6392-4c26-910a-ff5e2d3fe474",
                                                "sense_id": "dbd53ec5-5034-3447-8b59-79452c791750",
                                                "text": "„Er umarmte mich, nannte mich seinen lieben Freund und stellte mir der Reihe nach die ganzen Leute vor, aus denen sich seine hübsche Gesellschaft zusammensetzte, sieben oder acht Mädchen, eines hübscher als das andere, drei oder vier Kastraten, die auf den römischen Theatern Frauenrollen spielten, und fünf oder sechs Abati, die sich sowohl mit Frauen wie auch mit Männern einließen, sich dessen noch rühmten und an Schamlosigkeit die Mädchen zu übertreffen bemüht waren.“"
                                            },
                                            {
                                                "example_id": "5480be85-11ce-4305-9f79-b5d94813022f",
                                                "sense_id": "dbd53ec5-5034-3447-8b59-79452c791750",
                                                "text": "„In diesem Augenblick, wo sie den Gipfel der Schamlosigkeit zu erreichen glaubte, würde ihre Naivität alle Mütter entzückt haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "83ac68a3-e0c7-3d53-8069-f68773051b48",
