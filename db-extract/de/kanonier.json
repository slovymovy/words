                    {
                        "form_id": "5c63308d-191f-44f6-ae3f-795605b5cf62",
                        "entry_id": "fbbc5e04-00a5-3a9a-b2a4-3b2db8eaed2a",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Kanonier"
                    },
                    {
                        "form_id": "bd84502e-7a6c-4679-b521-49f0f0e66e79",
                        "entry_id": "fbbc5e04-00a5-3a9a-b2a4-3b2db8eaed2a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kanoniere"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44c00847-d1cb-3f49-aacc-c42331454b4f",
                        "entry_id": "fbbc5e04-00a5-3a9a-b2a4-3b2db8eaed2a",
                        "glosses": [
                            "Soldat, der eine Kanone bedient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27071741-a3aa-463e-864e-4cc54f07face",
                                "sense_id": "44c00847-d1cb-3f49-aacc-c42331454b4f",
                                "text": "„Sigismund Ludwig Borkheim - Vom königlich-preußischen Kanonier zum Russland-Experten an der Seiten von Marx und Engels.“"
                            },
                            {
                                "example_id": "7becb0ad-d8b9-4bf4-8d35-d5607624304a",
                                "sense_id": "44c00847-d1cb-3f49-aacc-c42331454b4f",
                                "text": "„Eine ovale Photographie erklärte, daß es einmal einen jungen Kanonier Jepsen gegeben hatte, der neben einer leichten Haubitze kniete wie vor einem Altar, derselbe Kanonier trug in Galizien einen Mantel und sang mit anderen Kanonieren einen Weihnachtsbaum an.“"
                            },
                            {
                                "example_id": "254ae1c2-5399-42d2-a334-d8953e768edc",
                                "sense_id": "44c00847-d1cb-3f49-aacc-c42331454b4f",
                                "text": "„Draußen auf dem See hatten wir uns eine Zielscheibe errichtet, an der wir regelmäßig übten, sodass wir ziemlich professionelle Kanoniere wurden.“"
                            },
                            {
                                "example_id": "b307398c-2e4e-4f8f-9fb4-bf058fa03b41",
                                "sense_id": "44c00847-d1cb-3f49-aacc-c42331454b4f",
                                "text": "„Den Alkohol tranken die Kanoniere auf der Stelle aus, was sie in heitere Stimmung versetzte.“"
                            },
                            {
                                "example_id": "62c59f46-6239-4bd9-bf67-0d65f4432f67",
                                "sense_id": "44c00847-d1cb-3f49-aacc-c42331454b4f",
                                "text": "„Als er so glanzvoll an einem abgelegenen Feldgeschütz vorüberkam, überraschte er einen schnauzbärtigen Kanonier, der zwischen Bierflaschen und Schweinshaxen umsichtig Brotzeit machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fd4edc22-3f69-364e-a801-b86634352849",
                        "entry_id": "fbbc5e04-00a5-3a9a-b2a4-3b2db8eaed2a",
                        "glosses": [
                            "unterster Dienstgrad in der Artillerietruppe"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1811aed4-2c37-4f02-9f62-1186fee8123f",
                        "source_entry_id": "fbbc5e04-00a5-3a9a-b2a4-3b2db8eaed2a",
                        "source_sense_id": "44c00847-d1cb-3f49-aacc-c42331454b4f",
                        "source_sense_description": "Militär: Soldat, der eine Kanone bedient",
                        "target_lang_word": "canonnier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canonnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f22090d-4462-323f-a83b-773dbb050ced",
                                        "entry_id": "46fc3111-7459-3e25-aac4-56f6664fa142",
                                        "glosses": [
                                            "Soldat ou marin qui est chargé de servir une pièce de canon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1147af2-5e65-4e52-9395-3b9ae28f8fbd",
                                                "sense_id": "5f22090d-4462-323f-a83b-773dbb050ced",
                                                "text": "Les canonniers allemands ne se gêneront pas pour tirer sur eux du haut du plateau... et sur nous en même temps..."
                                            },
                                            {
                                                "example_id": "63479b98-8cfd-4b4d-91cd-9a961f751878",
                                                "sense_id": "5f22090d-4462-323f-a83b-773dbb050ced",
                                                "text": "Chaque canonnier était à sa place : l'un tenait une longue louche, un autre un boutefeu en bois et une grande bougie incandescente, prêt à allumer la poudre, […]."
                                            },
                                            {
                                                "example_id": "55de454f-a184-400c-8706-98502e0c9921",
                                                "sense_id": "5f22090d-4462-323f-a83b-773dbb050ced",
                                                "text": "[…] ; presque en même un canonnier, dont la pièce battait le long du fossé, tire, et, d’un premier coup, renverse et brise toutes les échelles."
                                            },
                                            {
                                                "example_id": "149dd9ae-3b5f-4565-811e-3a9f2a3d1f37",
                                                "sense_id": "5f22090d-4462-323f-a83b-773dbb050ced",
                                                "text": "Les canonniers qui gardaient l'Hôtel de Ville se dispersèrent en apprenant que les troupes conventionnelles avançaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad1d81e4-dd42-35a3-8ae4-55a364bb7649",
                                        "entry_id": "46fc3111-7459-3e25-aac4-56f6664fa142",
                                        "glosses": [
                                            "Préposé au tir des mines ; boutefeu."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8839126-1515-473b-b308-68da2d779260",
                                                "sense_id": "ad1d81e4-dd42-35a3-8ae4-55a364bb7649",
                                                "text": "Attendu que les enquêtes ont établi que, dans certains charbonnages, il existe un employé spécial, dit boutefeu ou vulgairement canonnier, à qui incombent les obligations ci-dessus désignées ; […]."
                                            },
                                            {
                                                "example_id": "204ffbde-9f86-44a9-b20e-9a2e8ecc1f5f",
                                                "sense_id": "ad1d81e4-dd42-35a3-8ae4-55a364bb7649",
                                                "text": "Résumé des circonstances de l'accident. Un « canonnier » ou « boute-feu » examinait, dans l'aise des surveillants, un détonateur électrique qui avait raté ; il tenait l'engin de la main gauche, tandis que de la main droite il tâchait d'enlever par traction les fils d'amorce, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee0aabfe-2232-3901-bcaa-3b13d70aaeaa",
                                        "entry_id": "46fc3111-7459-3e25-aac4-56f6664fa142",
                                        "glosses": [
                                            "Jouer de football qui tire très fort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd5925d-f8db-41d1-9220-13546fdd7408",
                                                "sense_id": "ee0aabfe-2232-3901-bcaa-3b13d70aaeaa",
                                                "text": "La finesse de coup franc de Lionel Messi à la demi-heure de jeu face à Nice, samedi, a rappelé aux plus anciens les frappes tout en finesse de Maradona, Platini, Zico ; par opposition aux canonniers modernes que sont Juninho et Cristiano Ronaldo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
