                "senses": [
                    {
                        "sense_id": "181185de-f8de-32de-a50d-8944f1f89fb6",
                        "entry_id": "2ec9458a-9f4a-3e4a-b25a-d6a10c0d4969",
                        "glosses": [
                            "Genre de singe d’Amérique, de la famille des cébidés, qui a la queue prenante et qui est fort petit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2355b1e0-3b62-4676-9565-dd2e47fe81db",
                                "sense_id": "181185de-f8de-32de-a50d-8944f1f89fb6",
                                "text": "Il était donc une fois une pauvre jeune fille qui, à cette époque, n’avait ni pages, ni voiture, ni nègre, ni perruche, ni sapajou."
                            },
                            {
                                "example_id": "df71762e-351b-455b-bbbd-8c4a0768319e",
                                "sense_id": "181185de-f8de-32de-a50d-8944f1f89fb6",
                                "text": "Elle s’est acheté dans une foire un sapajou gros comme le poing que son joueur d’orgue de Barbarie maltraitait."
                            }
                        ]
                    },
                    {
                        "sense_id": "30947e09-399e-355c-a716-c53967991f5e",
                        "entry_id": "2ec9458a-9f4a-3e4a-b25a-d6a10c0d4969",
                        "glosses": [
                            "Petit homme laid et ridicule."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8eec4a45-a07f-46de-b7c8-60ad47390049",
                                "sense_id": "30947e09-399e-355c-a716-c53967991f5e",
                                "text": "C’est un vrai sapajou."
                            },
                            {
                                "example_id": "a5602355-4922-4534-aaa7-cb038da84729",
                                "sense_id": "30947e09-399e-355c-a716-c53967991f5e",
                                "text": "Alors pourquoi donc avez-vous épousé ce sapajou à lunettes ?"
                            },
                            {
                                "example_id": "0c00c184-0312-4440-8965-d462ce99bf15",
                                "sense_id": "30947e09-399e-355c-a716-c53967991f5e",
                                "text": "Viens viens ma Célimène ! Ah viens viens je t'amène (Allez viens va)\n Laisse ces sapajous faire ensemble joujou (Ils dansent le jerk)"
                            },
                            {
                                "example_id": "bcef7cf3-94c8-4d4f-a569-f33e3cc58b39",
                                "sense_id": "30947e09-399e-355c-a716-c53967991f5e",
                                "text": "Elles m’ont d’abord rendu libertin comme un sapajou, puis dévot comme un ange (…)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
