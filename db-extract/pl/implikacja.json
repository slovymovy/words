                    {
                        "translation_id": "397f3cc9-5ff2-4f02-99a3-763f5949b84e",
                        "source_entry_id": "ff53ad3d-3017-3140-bec8-bd72dc71fb98",
                        "source_sense_id": "2d7f4922-42a1-318e-8d5e-b8bfb2728aab",
                        "target_lang_word": "следствие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "следствие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aa1da2b9-edac-3e7c-a24a-0c0dee4dbee8",
                                        "entry_id": "3b4b322c-6eda-32fa-8676-14310163fa73",
                                        "glosses": [
                                            "то, что произошло как результат чего-либо произошедшего ранее"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f48ee68a-3740-4159-bb0e-9b58ba520f73",
                                                "sense_id": "aa1da2b9-edac-3e7c-a24a-0c0dee4dbee8",
                                                "text": "Извините, прелестные, что я осмелился сравнить вас с Софиею: трудно противиться сердцу, а оно руководствует мною при сочинении сей повести; притом же ваши достоинства сделались виднее и следствие доказало их превосходство."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26f106a1-487c-3a8e-bfed-42d218a6c525",
                                        "entry_id": "3b4b322c-6eda-32fa-8676-14310163fa73",
                                        "glosses": [
                                            "филос. то, что следует, вытекает из чего-либо; вывод, заключение"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "следствие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b0d506cd-939f-3a11-9637-42e640c77182",
                                        "entry_id": "1dcae872-1f97-3e5e-8559-02ab4d15290f",
                                        "glosses": [
                                            "юр. процесс, направленный на выяснение обстоятельств чего-либо (обычно преступления), доказательств и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ecccdc6-c980-4187-8f74-93502ed16d36",
                                                "sense_id": "b0d506cd-939f-3a11-9637-42e640c77182",
                                                "text": "Я хотел бы отметить, что мы закончили следствие в рекордные сроки ― за 29 дней, хотя там было назначено 183 экспертизы, а потерпевшими были признаны 172 человека."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c01dbe28-e632-4b9b-93ed-e1c891811e69",
                        "source_entry_id": "ff53ad3d-3017-3140-bec8-bd72dc71fb98",
                        "source_sense_id": "2d7f4922-42a1-318e-8d5e-b8bfb2728aab",
                        "target_lang_word": "последствие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "последствие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "47bbafb5-66f4-3e05-abba-9a97fc340d61",
                                        "entry_id": "bf1de616-d70c-3951-af10-3453b3ecc720",
                                        "glosses": [
                                            "результат, следствие чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "857bc26f-8e13-4dc8-b5d8-77fce3b657b2",
                                                "sense_id": "47bbafb5-66f4-3e05-abba-9a97fc340d61",
                                                "text": "Я помню одну из этих ошибок, которая имела весьма грустные последствия."
                                            },
                                            {
                                                "example_id": "35a58e5e-5b1c-47de-9dd8-5fd2367b006e",
                                                "sense_id": "47bbafb5-66f4-3e05-abba-9a97fc340d61",
                                                "text": "К счастью, ушиб не оставил никаких последствий."
                                            },
                                            {
                                                "example_id": "7d2cfc92-fe88-4206-8a2c-3af21fa01b18",
                                                "sense_id": "47bbafb5-66f4-3e05-abba-9a97fc340d61",
                                                "text": "Заимка пруда, или, лучше сказать, последствие заимки, потому что на пруд меня мать не пустила, — также представило мне много нового, никогда мною не виданного."
                                            },
                                            {
                                                "example_id": "d9a727b0-560e-4bff-9a73-f4150519b83d",
                                                "sense_id": "47bbafb5-66f4-3e05-abba-9a97fc340d61",
                                                "text": "А если так, то само собою разумеется, что, вероятно, какая-нибудь строгая, суровая необходимость принуждала начальство к такой вредной по своим последствиям мере."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
