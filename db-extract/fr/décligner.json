                "senses": [
                    {
                        "sense_id": "8a2a75ad-be46-38bd-96ed-e6ebf285836a",
                        "entry_id": "ac111847-33ae-3442-917a-0386350ec116",
                        "glosses": [
                            "Arrêter de cligner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75c391f0-b821-41c5-9f06-31700a500e57",
                                "sense_id": "8a2a75ad-be46-38bd-96ed-e6ebf285836a",
                                "text": "(…) et dans le ciel la nuit ce que je vois est loin de moi et sur la terre la nuit et dans le ciel le jour ce que je vois est près de moi et comme s’il y avait sans cesse recul et approche le jour et comme s’il y avait sans cesse recul et approche la nuit et comme s’il n’y avait jamais totalement loin et totalement près et comme si le jour la terre reculait et le ciel avançait devant nos yeux et comme si la nuit la terre avançait pour reculer le jour et comme quand on cligne des yeux l’image semble s’éloigner et le contenu s’approcher et comme quand on décligne des yeux l’image semble s’approcher et le contenu s’éloigner et comme si sur la terre du matin au soir on déclignait des yeux et comme si plus passait le jour plus les images s’approchaient et leur contenu s’éloignait (…)"
                            },
                            {
                                "example_id": "7266335f-50a9-4a22-86c5-7e5e1ec5b7c0",
                                "sense_id": "8a2a75ad-be46-38bd-96ed-e6ebf285836a",
                                "text": "Ouais franchement, repos, je tiens à peine debout là, dès que je cligne des yeux il me faut une force mentale absolument incroyable pour les décligner"
                            },
                            {
                                "example_id": "4a3227e5-1f9e-42c2-a2f7-1cb1c54b82c9",
                                "sense_id": "8a2a75ad-be46-38bd-96ed-e6ebf285836a",
                                "text": "Elle prend comme les 5 secondes qui restent, même pas le temps de décligner des yeux"
                            }
                        ]
                    }
