{
    "word_family": [
        "propping",
        "propped"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dba7cf80-3f43-38b2-892e-3469aaa5b61e",
                    "sense_definition": "To support or shore up something, often by placing an object underneath or against it.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "support_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Try using a phone book to <w>prop</w> up the table where the foot is missing.",
                            "target_lang_translations": {
                                "ru": "Попробуй использовать телефонную книгу, чтобы <w>подпереть</w> стол в том месте, где не хватает ножки."
                            }
                        },
                        {
                            "text": "She had to <w>prop</w> open the heavy wooden door with a brick.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>подпереть</w> тяжелую деревянную дверь кирпичом, чтобы она не закрывалась."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prop up",
                        "prop open"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подпирать или поддерживать что-либо, часто помещая предмет под него или прислоняя к нему."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подпирать",
                                "target_lang_sense_clarification": "снизу или сбоку"
                            },
                            {
                                "target_lang_word": "подставлять",
                                "target_lang_sense_clarification": "что-то в качестве опоры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fe4d296-9a1d-32ae-9144-f31f4e0d56eb",
                    "sense_definition": "To play rugby in the prop position.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rugby_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been selected to <w>prop</w> for the national team in the upcoming tournament.",
                            "target_lang_translations": {
                                "ru": "Его выбрали <w>играть столбом</w> за национальную сборную на предстоящем турнире."
                            }
                        },
                        {
                            "text": "Learning how to <w>prop</w> safely requires years of specialized training.",
                            "target_lang_translations": {
                                "ru": "Обучение тому, как безопасно <w>играть в первой линии схватки</w>, требует лет специализированных тренировок."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used primarily within rugby contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть в регби на позиции столба (пропа)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "играть столбом",
                                "target_lang_sense_clarification": "в регби"
                            },
                            {
                                "target_lang_word": "быть столбом",
                                "target_lang_sense_clarification": "в схватке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ffc5d87-dcab-35f9-883d-7120995b1122",
                    "sense_definition": "To position the feet of a person while sitting, lying down, or reclining so that the knees are elevated at a higher level.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "support_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse helped to <w>prop</w> the patient's legs on a soft pillow.",
                            "target_lang_translations": {
                                "ru": "Медсестра помогла <w>положить</w> ноги пациента на мягкую подушку."
                            }
                        },
                        {
                            "text": "You should <w>prop</w> your feet up to reduce the swelling.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>приподнять</w> ноги, чтобы уменьшить отек."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Класть ноги человека в положении сидя или лёжа так, чтобы колени были приподняты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "класть на возвышение",
                                "target_lang_sense_clarification": "ноги"
                            },
                            {
                                "target_lang_word": "приподнимать",
                                "target_lang_sense_clarification": "ноги с помощью опоры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8f53377-a0f7-38b2-a822-dded61043eec",
                    "sense_definition": "To stop suddenly or unexpectedly, especially of a horse digging its front hooves into the ground.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stop_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse began to <w>prop</w> suddenly, nearly throwing the rider over its head.",
                            "target_lang_translations": {
                                "ru": "Лошадь внезапно начала <w>упираться</w>, едва не сбросив всадника через голову."
                            }
                        },
                        {
                            "text": "If the animal decides to <w>prop</w> at the fence, hold on tight.",
                            "target_lang_translations": {
                                "ru": "Если животное решит резко <w>затормозить</w> перед забором, держитесь крепче."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly Australian equestrian usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно или неожиданно останавливаться (особенно о лошади, упирающейся передними копытами в землю)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упираться",
                                "target_lang_sense_clarification": "о лошади при резкой остановке"
                            },
                            {
                                "target_lang_word": "резко тормозить",
                                "target_lang_sense_clarification": "о лошади"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3aa356c-bc91-370c-bed4-0985d9ec9749",
                    "sense_definition": "To knock a person down.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "strike_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief threatened to <w>prop</w> him if he did not hand over his wallet.",
                            "target_lang_translations": {
                                "ru": "Вор пригрозил <w>вырубить</w> его, если он не отдаст кошелек."
                            }
                        },
                        {
                            "text": "They used to go out and <w>prop</w> unsuspecting travelers on the road.",
                            "target_lang_translations": {
                                "ru": "Раньше они выходили на дорогу и <w>сбивали с ног</w> ничего не подозревающих путников."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Historical criminal slang"
                        },
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбить человека с ног ударом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбивать с ног",
                                "target_lang_sense_clarification": "ударом"
                            },
                            {
                                "target_lang_word": "вырубать",
                                "target_lang_sense_clarification": "ударом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2df81a17-0185-3825-8951-ba2402f7a72f",
                    "sense_definition": "To manually start the engine of a propeller-driven aircraft with no electric starter by pulling vigorously on one of the propeller blades using the hands.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aviation_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>prop</w> the old biplane by hand on the cold morning.",
                            "target_lang_translations": {
                                "ru": "Холодным утром ему пришлось вручную <w>проворачивать винт</w> старого биплана для запуска."
                            }
                        },
                        {
                            "text": "Never attempt to <w>prop</w> an aircraft engine without proper training.",
                            "target_lang_translations": {
                                "ru": "Никогда не пытайтесь <w>заводить вручную</w> двигатель самолета без надлежащей подготовки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Aviation jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вручную запускать двигатель винтового самолета, энергично проворачивая лопасть пропеллера руками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заводить вручную",
                                "target_lang_sense_clarification": "пропеллер самолета"
                            },
                            {
                                "target_lang_word": "проворачивать винт",
                                "target_lang_sense_clarification": "для запуска двигателя"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9ada4b64-dc17-3b6c-957e-f14c9ecf7e30",
