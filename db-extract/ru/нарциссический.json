                "senses": [
                    {
                        "sense_id": "18e5202b-3b06-3810-8a4e-916fd8ed3604",
                        "entry_id": "c3b0da82-0159-3a2e-892a-060557851257",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным нарциссизм"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f6e47cc-e832-4039-a531-af647e5111a3",
                                "sense_id": "18e5202b-3b06-3810-8a4e-916fd8ed3604",
                                "text": "Обычно объекты агрессии носят заменительный характер и отражают психологическую защиту смещения: поведение находится в границах, обеспечивающих безопасность нарциссического пациента ..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31765579-b575-4173-bd66-6b0186939e36",
                        "source_entry_id": "c3b0da82-0159-3a2e-892a-060557851257",
                        "source_sense_id": "18e5202b-3b06-3810-8a4e-916fd8ed3604",
                        "target_lang_word": "narzisstisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "narzisstisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b188b30-6f48-3ee8-a369-696e0032dd0a",
                                        "entry_id": "38cdc98e-8166-39e1-ba54-f5442eb4f8cc",
                                        "glosses": [
                                            "übersteigert in sich selbst verliebt, auf sich selbst bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fba7a2e7-d5cb-4b02-ab79-86be55ee921f",
                                                "sense_id": "9b188b30-6f48-3ee8-a369-696e0032dd0a",
                                                "text": "„Die Dame ist zu 99,9 Prozent ein Fake oder die narzisstischste, egomanischste (dümmste sorry) Person, die ich kennen lernen durfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8621502b-616a-36d8-8da6-ed32306924e8",
                                        "entry_id": "38cdc98e-8166-39e1-ba54-f5442eb4f8cc",
                                        "glosses": [
                                            "den Narzissmus betreffend oder auf dem Narzissmus beruhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0094d12c-fe86-4752-9f83-d34294e92056",
                                                "sense_id": "8621502b-616a-36d8-8da6-ed32306924e8",
                                                "text": "„Eine narzisstische Störung entsteht laut Miller, wenn ein Kind seine eigenen Gefühle und Interessen nicht artikulieren durfte und später dafür ein ‚Ventil‘ braucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
