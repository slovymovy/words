                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern email filters are designed to automatically block <w>ube</w> before it reaches your inbox.",
                            "target_lang_translations": {
