                                            {
                                                "example_id": "fb98933e-ec39-4e04-a30c-0b95fe342c94",
                                                "sense_id": "08446af3-f3f4-3bbf-bd9e-e0cd3ea061ef",
                                                "text": "Jan was vergeten nieuwe lampjes te kopen en fietste dus zonder verlichting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44c7be6a-8459-3481-b57b-5bbcb9624fbb",
                                        "entry_id": "d3ff48d5-884d-3cf5-97e6-1199886c15dd",
                                        "glosses": [
                                            "verruiming van het bewustzijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c8d2c6f-931c-4241-86eb-8bdbd9aaf313",
                                                "sense_id": "44c7be6a-8459-3481-b57b-5bbcb9624fbb",
                                                "text": "Die schreeuw, die bleek de kinderen wakker gemaakt te hebben, bracht hem verlichting..."
                                            },
                                            {
                                                "example_id": "dc10f5eb-307e-4ba9-a438-7b3f26275d30",
                                                "sense_id": "44c7be6a-8459-3481-b57b-5bbcb9624fbb",
                                                "text": "De fles was gelukkig groot genoeg en uiteindelijk kon ik met een zucht van verlichting de dop erop draaien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae2d4b25-7a6d-3bdc-abd8-8e6473db64f3",
                                        "entry_id": "d3ff48d5-884d-3cf5-97e6-1199886c15dd",
                                        "glosses": [
                                            "minder zwaar (dus dragelijker) makend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6518b3a-e086-421a-82d1-11d5231328f2",
                                                "sense_id": "ae2d4b25-7a6d-3bdc-abd8-8e6473db64f3",
                                                "text": "Je zou je voor kunnen stellen dat de Amerikanen een zucht van verlichting slaakten toen het Sovjetleger de opstand neersloeg en de rust en het afschrikkingsevenwicht werden hersteld."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6c54567-7ed5-301a-9543-0c45c3c56cc3",
                                        "entry_id": "d3ff48d5-884d-3cf5-97e6-1199886c15dd",
                                        "glosses": [
                                            "periode van het rationalisme in de 18e eeuw (binnen de westerse wereld) die het denken grondig wijzigde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b8b03e3-7a6e-4a28-908e-979ac1874832",
                                                "sense_id": "a6c54567-7ed5-301a-9543-0c45c3c56cc3",
                                                "text": "Zonder de verlichting zouden we ook hier nog steeds worden geregeerd door (bij)geloof en onredelijkheid"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8837d42f-e888-4bd4-abb8-3a9c498e9f20",
