                "senses": [
                    {
                        "sense_id": "099cf1d3-3e37-3932-ac52-b7b07e5dbc9c",
                        "entry_id": "c01f8f30-934e-36d6-b672-dfeb2e8886e0",
                        "glosses": [
                            "To confide to someone new.",
                            "To communicate information that was told in confidence to a third person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49799f5b-20f9-4420-a8a8-532c125249ec",
                                "sense_id": "099cf1d3-3e37-3932-ac52-b7b07e5dbc9c",
                                "text": "After this confidence, of which Muriel was very proud, and only condescended, upon gaining express permission, to reconfide it to me, she talked incessantly of the sister that was coming, until “little Maud”—the name she chose for her—became an absolute entity in the household."
                            },
                            {
                                "example_id": "b0cdacef-6ac6-41cb-9f96-801c70d0fc6c",
                                "sense_id": "099cf1d3-3e37-3932-ac52-b7b07e5dbc9c",
                                "text": "'“I do not think,” Christine confided afterwards to a friend, who reconfided it to Bertie van Tahn, “that I shall ever be able to touch pâté de foie gras again."
                            },
                            {
                                "example_id": "14a29950-84c5-4410-946c-fe18c4a3b1c7",
                                "sense_id": "099cf1d3-3e37-3932-ac52-b7b07e5dbc9c",
                                "text": "For Mrs Blythe had confided once to Ann, and Ann had ultimately reconfided to Halloran, the story of how her husband had walked disorderly with a domestic in Portsmouth."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef8cf4e5-4067-34d1-91a6-6450a8fa60fb",
                        "entry_id": "c01f8f30-934e-36d6-b672-dfeb2e8886e0",
                        "glosses": [
                            "To confide to someone new.",
                            "To entrust responsibility or authority to someone else."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce6aa3f8-87bb-48c1-bf55-5138a6abae76",
                                "sense_id": "ef8cf4e5-4067-34d1-91a6-6450a8fa60fb",
                                "text": "If you confide it to the Secretary of the Treasury, then why go on and reconfide the same power in the President?"
                            },
                            {
                                "example_id": "12ff55c1-608a-4d00-8640-90a86d3016e0",
                                "sense_id": "ef8cf4e5-4067-34d1-91a6-6450a8fa60fb",
                                "text": "Is there any simple way by which the Speaker may be relieved of his now dangerous authority and the power reconfided to the representatives of the people ?"
                            },
                            {
                                "example_id": "9330f8c0-c0c5-4741-bc36-19e9c6c9aa49",
                                "sense_id": "ef8cf4e5-4067-34d1-91a6-6450a8fa60fb",
                                "text": "The insurrection in Milan in favor of war, the strong feelings of the same flavor in Rome, Padua, Genoa and Naples, decided His Majesty Victor Emmanuel III to exclude Giovanni Giolitti and to reconfide to Salandra, who had tendered his resignation, the task of reconstituting a new ministry."
                            }
                        ]
                    }
