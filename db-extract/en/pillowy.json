                                                "sense_id": "1165f491-f01c-3316-a695-20805d8cc843",
                                                "text": "Ihm wurde weich ums Herz."
                                            },
                                            {
                                                "example_id": "7612fd44-69cb-4007-a72c-fd5be5212e98",
                                                "sense_id": "1165f491-f01c-3316-a695-20805d8cc843",
