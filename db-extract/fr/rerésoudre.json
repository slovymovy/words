                "senses": [
                    {
                        "sense_id": "3b53fe16-32b6-3f11-8efd-eaf0cacf7a76",
                        "entry_id": "d0c98e44-8d7a-3995-946c-fb335d21da85",
                        "glosses": [
                            "Résoudre de nouveau, trouver encore une fois la solution à un problème."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a1d5ccc-b4cf-43f0-8da2-4f93928d750b",
                                "sense_id": "3b53fe16-32b6-3f11-8efd-eaf0cacf7a76",
                                "text": "Il ne s'agit plus tant d'apprendre à rerésoudre les problèmes que d'autres ont résolus avant nous mais de donner aux élèves, par l'enseignement de la démarche modélisante, les méthodes et les moyens de reconnaître, de formuler correctement et de résoudre les problèmes nouveaux que pose tous les jours un monde en évolution de plus en plus rapide."
                            },
                            {
                                "example_id": "fe3776de-a0b4-40ea-8a8a-a6f2c5965665",
                                "sense_id": "3b53fe16-32b6-3f11-8efd-eaf0cacf7a76",
                                "text": "De nombreux historiens ont tenté de rerésoudre le mystère de la construction des grandes pyramides."
                            }
                        ]
                    }
