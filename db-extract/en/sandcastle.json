                    {
                        "translation_id": "06b7c4e7-e2a4-462a-95ab-45f8e21ff272",
                        "source_entry_id": "51d90604-e5d9-319f-9af6-99297f58b9c3",
                        "source_sense_id": "c8259d50-8d64-3f2d-9be3-cc15277f4ccd",
                        "source_sense_description": "a sculpture made of sand and resembling a miniature castle",
                        "target_lang_word": "zandkasteel",
