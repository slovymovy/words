                },
                {
                    "sense_id": "cbb3f1d6-1245-3f77-83dd-3c4a080785cb",
                    "sense_definition": "Vertrauen in die eigenen Fähigkeiten oder Kräfte haben, eine Aufgabe bewältigen zu können",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>traut</w> sich die schwierige Führungsaufgabe im neuen Projekt vollkommen <w>zu</w>."
                        },
                        {
                            "text": "Wenn du dich gut vorbereitest, kannst du dir die Prüfung ohne Sorgen <w>zutrauen</w>."
                        }
                    ],
                    "common_phrases": [
