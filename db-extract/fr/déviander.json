                ],
                "senses": [
                    {
                        "sense_id": "db61b023-3ad2-3b22-b4e3-af21adea3cc0",
                        "entry_id": "c35cbbac-5259-3d57-b424-dfd4b549ae64",
                        "glosses": [
                            "Enlever la viande."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb5bf543-aedb-4260-9cd9-84c02f815b8f",
                                "sense_id": "db61b023-3ad2-3b22-b4e3-af21adea3cc0",
                                "text": "Ensuite, ils « déviandaient » la pièce pour créer la très délicieuse tête fromagée."
                            }
                        ]
                    },
                    {
                        "sense_id": "fea04b26-c6d7-3ca5-8fcd-090f589c6b63",
                        "entry_id": "c35cbbac-5259-3d57-b424-dfd4b549ae64",
                        "glosses": [
                            "Maigrir."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a9e0a67c-5b20-3058-a8c6-325f432df77a",
                        "entry_id": "c35cbbac-5259-3d57-b424-dfd4b549ae64",
                        "glosses": [
                            "S'amaigrir."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "399def45-cdb0-49fe-8268-d3748e8034ac",
                                "sense_id": "a9e0a67c-5b20-3058-a8c6-325f432df77a",
                                "text": "Maintenant soixante-quinze à peine. Une grande carcasse où la peau tombait flasque. — Je me déviande, tu comprends."
                            },
                            {
                                "example_id": "7fd93fa5-d29e-4b02-872b-37596b7473cd",
                                "sense_id": "a9e0a67c-5b20-3058-a8c6-325f432df77a",
                                "text": "À cette bonne laitière, je donne un peu de tourteau pour qu’elle ne se déviande pas après son vêlage."
                            },
                            {
                                "example_id": "38fb7c47-b6b3-484e-a80d-aabfea2c48ad",
                                "sense_id": "a9e0a67c-5b20-3058-a8c6-325f432df77a",
                                "text": "Le normand, au contraire, se « déviande » vers neuf ans, et tel qui était rond et peu plaisant dans sa jeunesse devient plus tard un très beau cheval, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "ac1f284f-aea3-361d-9364-68fdc204b41e",
                        "entry_id": "c35cbbac-5259-3d57-b424-dfd4b549ae64",
                        "glosses": [
                            "Enlever ce qui parait superflu, dégraisser."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "85917b12-5925-4c17-a8e8-5cb61508385a",
                                "sense_id": "ac1f284f-aea3-361d-9364-68fdc204b41e",
                                "text": "… d’ici là, je continuerai la lecture de Merlin de Quinet (un chef d’œuvre) et je vais déviander un peu le restant du 2ᵉ acte du Roi."
                            }
                        ]
                    },
                    {
                        "sense_id": "e14b05c6-d6d7-31a5-89ef-178b04d89a5a",
                        "entry_id": "c35cbbac-5259-3d57-b424-dfd4b549ae64",
                        "glosses": [
                            "tuer."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a08f3be4-f3a4-4171-b46a-0144018e7066",
                                "sense_id": "e14b05c6-d6d7-31a5-89ef-178b04d89a5a",
                                "text": "Se viander (1950), « se tuer accidentellement » ou « s’entre-tuer », est parfois transformé aujourd’hui en se déviander ou même déviander, « tuer »."
                            }
                        ]
                    }
                ],
