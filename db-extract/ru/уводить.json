                "translations": [
                    {
                        "translation_id": "67c4263b-cd9c-4580-b5d2-3f4cdddde679",
                        "source_entry_id": "9c74bfc4-f199-3893-a976-8e2d7a259947",
                        "target_lang_word": "walk away",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "walk away",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b035bb6a-789a-36bc-ba4a-6bfe905e1615",
                                        "entry_id": "bdf6c31f-2433-32bf-9225-e9e642007662",
                                        "glosses": [
                                            "To withdraw from a problematic situation."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45068696-b58b-4bc0-a52b-cd4c1ce11c5b",
                                                "sense_id": "b035bb6a-789a-36bc-ba4a-6bfe905e1615",
                                                "text": "Company lawyers told him to walk away from the deal."
                                            },
                                            {
                                                "example_id": "e2265df6-eecc-42c5-bb33-074c4df02482",
                                                "sense_id": "b035bb6a-789a-36bc-ba4a-6bfe905e1615",
                                                "text": "Green adds: \"Luckily, nobody did walk away. Railtrack stayed with it, so did the government, so did the Strategic Rail Authority."
                                            },
                                            {
                                                "example_id": "93a7f2eb-f53f-4784-93c3-2bff8ac153e4",
                                                "sense_id": "b035bb6a-789a-36bc-ba4a-6bfe905e1615",
                                                "text": "When John Lithgow was announced as Dumbledore, he revealed that a friend had sent him a link to an article entitled: “An open letter to John Lithgow: Please walk away from Harry Potter.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a7bc0ec-b36a-3fe1-a35d-78c546ef0d47",
                                        "entry_id": "bdf6c31f-2433-32bf-9225-e9e642007662",
                                        "glosses": [
                                            "Of an object, to go missing or be stolen."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "euphemistic",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f9b4d1c-f680-3844-9eda-df50ec78c457",
                                        "entry_id": "bdf6c31f-2433-32bf-9225-e9e642007662",
                                        "glosses": [
                                            "To free oneself from a debt such as a mortgage by abandoning the collateral to the lender. To make a strategic default."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb3deca9-92d3-3f24-b7f0-112e8dad9a92",
                                        "entry_id": "bdf6c31f-2433-32bf-9225-e9e642007662",
                                        "glosses": [
                                            "To survive a challenging or dangerous situation without harm."
                                        ],
                                        "tags": [
                                            "idiomatic"
