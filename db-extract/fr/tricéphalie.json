                "word": "tricéphalie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "36ecca91-ea1f-4251-b48f-bbdfa84acc6e",
                        "entry_id": "c7fed8b4-5e92-3eb9-ad3d-c7bb27bb7c7b",
                        "tags": [
