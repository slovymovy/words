                        "glosses": [
                            "Forêt de bambous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0ea1915-2bfd-4414-b04a-11ebdacad056",
                                "sense_id": "533d4cd9-13e2-36bf-8b9a-292e91718cc5",
                                "text": "Les montagnes abruptes se dressent en muraille coupée par de profondes entailles. A la base, des bambousaies et jungles épaisses, retraite des tigres, ours et sangliers."
                            },
                            {
                                "example_id": "dfb6780c-5a9a-45d2-9602-76e37fb5eb66",
                                "sense_id": "533d4cd9-13e2-36bf-8b9a-292e91718cc5",
                                "text": "A onze heures entrée dans la Bambousaie, de plus en plus épaisse. L’air devient sensiblement plus frais et pur. Aussi avançons nous gaiement, les Zanzibaristes se taquinent et parient entre eux à qui rapportera la plus grosse charge de la chose blanche qui se trouve au sommet de la montagne."
                            }
                        ]
                    }
