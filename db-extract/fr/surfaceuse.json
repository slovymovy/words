                "senses": [
                    {
                        "sense_id": "78073e7d-5e11-31f4-b0c6-5872ba3ba199",
                        "entry_id": "d8e567d5-df7a-32ea-b443-316af8b470f1",
                        "glosses": [
                            "Véhicule qui refait et lisse la glace d’une patinoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cba7adcc-3e5e-46ca-86d3-709bc362863d",
                                "sense_id": "78073e7d-5e11-31f4-b0c6-5872ba3ba199",
                                "text": "La famille Theriault a transformé une laveuse en surfaceuse de glace pour confectionner une patinoire dans sa cour arrière, à Winnipeg."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a21d1b4-a499-31f7-9757-b51c85a50c3c",
                        "entry_id": "d8e567d5-df7a-32ea-b443-316af8b470f1",
                        "glosses": [
                            "Véhicule qui refait les sentiers de motoneige et les laisse sans trous ni bosses."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "f3a5f1d7-39de-40f9-8fb0-89bedae6bf54",
                                "sense_id": "1a21d1b4-a499-31f7-9757-b51c85a50c3c",
                                "text": "Il y a des centaines de motoneigistes qui suivent de près la surfaceuse, alors les sentiers, ils ne peuvent pas durer», a raconté le président du club de motoneige Caribou-Conscrits, Joachim Simard."
                            }
                        ]
                    },
                    {
                        "sense_id": "292e9339-360a-3016-a2bd-2d9ee72032fd",
                        "entry_id": "d8e567d5-df7a-32ea-b443-316af8b470f1",
                        "glosses": [
                            "Ponceuse de grande taille, utilisant des disques abrasifs et destinée à poncer finement les parquets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1604e38-e2ee-47a7-ab01-11e4dd077466",
                                "sense_id": "292e9339-360a-3016-a2bd-2d9ee72032fd",
                                "text": "Pour le ponçage des sols, parquets et terrasses, la bordureuse : à utiliser en complément de la ponceuse à parquet et de la surfaceuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "fed55c7b-c51f-3175-8e7b-abc400cf4ae9",
                        "entry_id": "d8e567d5-df7a-32ea-b443-316af8b470f1",
                        "glosses": [
                            "Machine utilisant un disque abrasif, destinée à lisser, à égaliser la surface d'un sol en béton ou en pierre."
