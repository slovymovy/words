                    {
                        "sense_id": "12fbcd88-992c-324c-96fc-7c92769ae123",
                        "entry_id": "600e529a-a405-3832-a9b8-3ee870a01be9",
                        "glosses": [
                            "Kernfusion von drei Helium-Kernen (Alphateilchen) zu Kohlenstoff im Inneren von Sternen"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "a3899858-bdb5-4ded-b228-59b5282a39b8",
                                "sense_id": "12fbcd88-992c-324c-96fc-7c92769ae123",
                                "text": "„Das Heliumbrennen verbringt der Rote Riese mit relativ gleichbleibender Leuchtkraft und Oberflächentemperatur.“"
                            },
                            {
                                "example_id": "c0d1eeca-3227-4900-a841-2d2bf30111ef",
                                "sense_id": "12fbcd88-992c-324c-96fc-7c92769ae123",
                                "text": "„Das Zünden des Heliumbrennens ist aber nur für Sterne hinreichender Masse möglich, leichtere Sterne glühen nach Abschluss des Wasserstoffbrennens aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
