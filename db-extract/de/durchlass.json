                        "sense_id": "3294af00-b3d1-357a-a0fd-619b89ef2e5b",
                        "entry_id": "145f8964-1b31-31ef-a44a-aa82463149ce",
                        "glosses": [
                            "Möglichkeit an einer bestimmten Stelle etwas zu passieren, zu durchdringen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "22963904-bc3c-31e7-8b83-c351754a1fc0",
                        "entry_id": "145f8964-1b31-31ef-a44a-aa82463149ce",
                        "glosses": [
                            "Stelle, an der etwas durch ein Hindernis gelangt, hindurchgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fc364f8-14bc-49e7-8fc7-f7408558bdf4",
                                "sense_id": "22963904-bc3c-31e7-8b83-c351754a1fc0",
                                "text": "„Durchlässe, auch Schleusen, Dohlen oder Drummen genannt, haben den Zweck, kleinere Wasserläufe durch die Erdkörper von Straßen oder Eisenbahnen zu führen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d0ac8f0-1ac3-40a0-95d9-83cd24fafd88",
                        "source_entry_id": "145f8964-1b31-31ef-a44a-aa82463149ce",
                        "source_sense_id": "3294af00-b3d1-357a-a0fd-619b89ef2e5b",
                        "source_sense_description": "Möglichkeit an einer bestimmten Stelle etwas zu passieren, zu durchdringen",
                        "target_lang_word": "culvert",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "culvert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "463357a8-6ed9-3b5e-96b4-ca5fca2d91ea",
                                        "entry_id": "030485ad-9bee-3808-91bd-1b9a5040d4c9",
                                        "glosses": [
                                            "A channel crossing under a road or railway for the draining of water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14c08b22-c70f-4ea0-99c7-764ebe0e0f48",
                                                "sense_id": "463357a8-6ed9-3b5e-96b4-ca5fca2d91ea",
                                                "text": "A raft of twigs stayed upon a stone, suddenly detached itself, and floated towards the culvert."
                                            },
                                            {
                                                "example_id": "73dba568-4945-4722-977e-37b0be59e223",
                                                "sense_id": "463357a8-6ed9-3b5e-96b4-ca5fca2d91ea",
                                                "text": "After she left, I ran away for a day, and hid myself, solitary, in a culvert under the railway lines."
                                            },
                                            {
                                                "example_id": "4e4d65e3-ce85-43ad-8ad4-88b971bc03f3",
                                                "sense_id": "463357a8-6ed9-3b5e-96b4-ca5fca2d91ea",
                                                "text": "It was on the leisurely upswing when, 16 years after we bought our house, a woman driving a fancy S.U.V. jumped the culvert, plowed through the hedge, jumped the culvert again and sped off."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "culvert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c7e2513-3b34-3def-84d0-d30d885a2033",
                                        "entry_id": "70642627-12f2-3747-8fee-922c3656f036",
                                        "glosses": [
                                            "To channel (a stream of water) through a culvert."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09a83eab-06ad-47e9-8d99-90b6405a511e",
                                                "sense_id": "9c7e2513-3b34-3def-84d0-d30d885a2033",
                                                "text": "This led to a great deal of straightening and culverting, which in turn led to a massive loss of biodiversity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
