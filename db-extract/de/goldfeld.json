                        "sense_id": "2a78a626-7866-3ad6-a11d-8b8622f61a08",
                        "entry_id": "daf10bcf-3371-3be1-8e57-5b6d5bdf9ed7",
                        "glosses": [
                            "Areal, in dem sich förderbare Goldvorkommen befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60fa82ed-c41f-46bc-a843-29cde7384dc5",
                                "sense_id": "2a78a626-7866-3ad6-a11d-8b8622f61a08",
                                "text": "„Ich muss wohl nicht erwähnen, wie sehr mich der Anblick der flachen, sandigen Küste Westaustraliens deprimierte und wie sehr ich die grobschlächtigen Bergwerksstädte und öden Goldfelder verabscheute, wo man die Lastwagen belud.“"
                            },
                            {
                                "example_id": "7b939cd5-5acf-4be2-b61b-37cb4051b0bf",
                                "sense_id": "2a78a626-7866-3ad6-a11d-8b8622f61a08",
                                "text": "„Glanton kehrte alleine nach Yuma zurück, seine Männer waren fort zu den Goldfeldern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
