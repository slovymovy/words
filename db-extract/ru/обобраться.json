                "senses": [
                    {
                        "sense_id": "ebd72aa1-6156-3222-b8b8-43b81bc9f75f",
                        "entry_id": "eedaa951-e747-311f-ba4c-4fd8fc6f8fd5",
                        "glosses": [
                            "разг., получить, испытать и т. п. во множестве, в полной мере"
                        ],
                        "tags": [
                            "(в сочетании с не)"
                        ],
                        "examples": [
                            {
                                "example_id": "1cfa5925-8415-4fa3-9a20-ac8816a4040b",
                                "sense_id": "ebd72aa1-6156-3222-b8b8-43b81bc9f75f",
                                "text": "То-то бы тебя за отчетностью смотреть поставить, одного крику не обобрался бы."
                            },
                            {
                                "example_id": "4f285ee9-041d-417a-86fa-f0a2812570a4",
                                "sense_id": "ebd72aa1-6156-3222-b8b8-43b81bc9f75f",
                                "text": "Непременно обратно банку забирала, один раз разбили, греха не обобрались."
                            }
                        ]
                    }
