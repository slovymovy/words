                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She passed the driving test <w>easily</w> on her first try.",
                            "target_lang_translations": {
                                "ru": "Она <w>легко</w> сдала экзамен на права с первой попытки.",
                                "zh": "她第一次参加驾照考试就<w>轻松</w>通过了。",
                                "nl": "Ze haalde haar rijexamen <w>makkelijk</w> bij de eerste poging.",
                                "pl": "Zdała egzamin na prawo jazdy <w>łatwo</w> za pierwszym podejściem.",
                                "de": "Sie hat die Fahrprüfung beim ersten Versuch <w>leicht</w> bestanden.",
                                "fr": "Elle a <w>facilement</w> réussi son examen de conduite dès la première tentative.",
                                "it": "Ha superato l'esame di guida <w>facilmente</w> al primo tentativo.",
                                "cs": "Řidičské zkoušky udělala na první pokus <w>snadno</w>.",
                                "tr": "Sürücü sınavını ilk denemesinde <w>kolayca</w> geçti.",
                                "es": "Ella aprobó el examen de conducir <w>fácilmente</w> en su primer intento."
                            }
                        },
                        {
                            "text": "Information is <w>easily</w> accessible on the internet.",
                            "target_lang_translations": {
                                "ru": "Информация <w>легко</w> доступна в интернете.",
                                "zh": "在互联网上可以<w>容易</w>地获取信息。",
                                "nl": "Informatie is <w>makkelijk</w> toegankelijk op het internet.",
                                "pl": "Informacje są <w>łatwo</w> dostępne w internecie.",
                                "de": "Informationen sind im Internet <w>leicht</w> zugänglich.",
                                "fr": "L'information est <w>facilement</w> accessible sur Internet.",
                                "it": "Le informazioni sono <w>facilmente</w> accessibili su internet.",
                                "cs": "Informace jsou na internetu <w>snadno</w> dostupné.",
                                "tr": "İnternette bilgiye <w>kolaylıkla</w> ulaşılabilir.",
                                "es": "La información es <w>fácilmente</w> accesible en internet."
                            }
