                "senses": [
                    {
                        "sense_id": "05f9dc45-755e-3814-964a-ba253679c9fc",
                        "entry_id": "6ac1b1c7-406a-38fa-a2f2-b6d0a2faa209",
                        "glosses": [
                            "porowata skała osadowa, odmiana aragonitu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab94ba44-4fec-44c8-80ea-298bc1cba670",
                                "sense_id": "05f9dc45-755e-3814-964a-ba253679c9fc",
                                "text": "Oczy widziały znowu ukochaną glebę ogrodu, gdzie motyka, roztrącając bryły zeschniętego wapniaka, naloty piaskowe i grudy trawertynu, dźwięczała uderzając o ruiny pogańskie"
                            },
                            {
                                "example_id": "d903d22a-f7c8-4519-b146-d6a54ea87b05",
                                "sense_id": "05f9dc45-755e-3814-964a-ba253679c9fc",
                                "text": "Do wystroju użyto różnokolorowych marmurów, porowatego trawertynu i betonu o zróżnicowanej fakturze, kawiarnię ozdobiła abstrakcyjna mozaika"
                            },
                            {
                                "example_id": "51a42745-711a-4ac6-a215-d64fbe069a06",
                                "sense_id": "05f9dc45-755e-3814-964a-ba253679c9fc",
                                "text": "Na tle ciepłych barw rzymskiego trawertynu martwą bielą rysuje się zimny pizański marmur"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38c18c6b-7778-4884-896e-4a8db57ade6c",
                        "source_entry_id": "6ac1b1c7-406a-38fa-a2f2-b6d0a2faa209",
                        "source_sense_id": "05f9dc45-755e-3814-964a-ba253679c9fc",
                        "target_lang_word": "travertine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "travertine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27896400-783a-3044-8f82-10ae1ab62efc",
                                        "entry_id": "8baa6ac9-68b5-3ab4-a42c-e149ac0b7797",
                                        "glosses": [
                                            "A light, porous form of concretionary limestone (or calcite) deposited from solution, and sometimes quarried for building."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2b5081c-7cad-4d7d-887e-ff0a6f0ec19a",
                                                "sense_id": "27896400-783a-3044-8f82-10ae1ab62efc",
                                                "text": "Halder stopped outside a seven-storey building sheathed in pale travertine marble."
                                            },
                                            {
                                                "example_id": "b699cd3b-4253-46c4-870f-9d9dbdc93f90",
                                                "sense_id": "27896400-783a-3044-8f82-10ae1ab62efc",
                                                "text": "[...] imitation travertine, resembling marble, has been used to cover the station exterior, [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8776bf60-f798-43f9-a52a-7ac530641b90",
                        "source_entry_id": "6ac1b1c7-406a-38fa-a2f2-b6d0a2faa209",
                        "source_sense_id": "05f9dc45-755e-3814-964a-ba253679c9fc",
                        "target_lang_word": "travertin",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4fd0b195-afe2-45fc-a78e-b1b899a1df0c",
                        "source_entry_id": "6ac1b1c7-406a-38fa-a2f2-b6d0a2faa209",
                        "source_sense_id": "05f9dc45-755e-3814-964a-ba253679c9fc",
                        "target_lang_word": "travertin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "travertin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ef3ee3d-0fdd-3e78-be26-b0d261870c0f",
                                        "entry_id": "b98d8d60-e56b-3009-b221-9469246fa2ef",
                                        "glosses": [
                                            "Roche sédimentaire calcaire composée de dépôts précipités par des eaux de source; blanche quand pure (mais tirant vers le gris ou jaunâtre ou rougeâtre ou marron, selon les impuretés) caractérisée par de petites vacuoles inégalement réparties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41dd51f8-0574-4622-ad8a-eb3bde208206",
                                                "sense_id": "2ef3ee3d-0fdd-3e78-be26-b0d261870c0f",
                                                "text": "Les spectaculaires vasques de travertin blanc de Pamukkale, près de Hiérapolis, sont depuis longtemps l’une des curiosités les plus connues de Turquie."
                                            },
                                            {
                                                "example_id": "f1c14d04-7c2c-4277-a7f2-31b3ace3680b",
                                                "sense_id": "2ef3ee3d-0fdd-3e78-be26-b0d261870c0f",
                                                "text": "Ses murs longs, indestructibles, étaient bâtis d’un sombre travertin, une corniche colossale, magnifiquement assemblée, couronnait le sommet, des linteaux de marbre encadraient le portail et les fenêtres étaient grandioses, chargées de magnifiques ornements architecturaux ; […]."
                                            },
                                            {
                                                "example_id": "3eee62c4-3a27-4152-bb06-89689e89a75e",
                                                "sense_id": "2ef3ee3d-0fdd-3e78-be26-b0d261870c0f",
                                                "text": "Les édifices de Rome sont pour la plupart construits en travertin."
                                            },
                                            {
                                                "example_id": "2d2379f2-2bbf-4cd3-ad8e-1ce4ea46b9ae",
                                                "sense_id": "2ef3ee3d-0fdd-3e78-be26-b0d261870c0f",
                                                "text": "La réaction peut être inverse (par ex. lorsque l’eau se réchauffe, qu’il y a baisse de la teneur en CO2) et dans ce cas, il y a précipitation de la calcite (ou carbonate de calcium), à l’origine des dépôts de tufs et travertins en milieu calcaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
