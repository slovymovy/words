{
    "word_family": [
        "promiscuous",
        "promiscuously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a9a24b2c-56b3-34da-bf0f-be408e055cf5",
                    "sense_definition": "The practice of having casual sexual relations with multiple partners frequency or indiscriminately.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The health campaign aims to educate young adults about the risks associated with sexual <w>promiscuity</w>. ",
                            "target_lang_translations": {
                                "de": "Die Gesundheitskampagne zielt darauf ab, junge Erwachsene über die Risiken sexueller <w>Promiskuität</w> aufzuklären."
                            }
                        },
                        {
                            "text": "He decided to avoid sexual <w>promiscuity</w> and commit to a single monogamous relationship.",
                            "target_lang_translations": {
                                "de": "Er beschloss, sexuelle <w>Promiskuität</w> zu vermeiden und sich auf eine einzige monogame Beziehung festzulegen."
                            }
                        }
                    ],
                    "synonyms": [
                        "promiscuousness",
                        "looseness"
                    ],
                    "antonyms": [
                        "chastity",
                        "celibacy",
                        "monogamy"
                    ],
                    "common_phrases": [
                        "sexual promiscuity"
                    ],
                    "target_lang_definitions": {
                        "de": "Die Praxis des Geschlechtsverkehrs mit häufig wechselnden Partnern."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Promiskuität",
                                "target_lang_sense_clarification": "häufig wechselnder Geschlechtsverkehr"
                            },
                            {
                                "target_lang_word": "Freizügigkeit",
                                "target_lang_sense_clarification": "sexuelle Ungebundenheit oder Offenheit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67cf4775-e219-370a-be8d-89f2b3204854",
                    "sense_definition": "The state or quality of being indiscriminate or lacking selectivity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>promiscuity</w> of his reading habits meant he would read literally any book he found. ",
                            "target_lang_translations": {
                                "de": "Die <w>Wahllosigkeit</w> seiner Lesegewohnheiten führte dazu, dass er buchstäblich jedes Buch las, das er fand."
                            }
                        },
                        {
                            "text": "Her intellectual <w>promiscuity</w> allowed her to draw inspiration from widely varying fields of study.",
                            "target_lang_translations": {
                                "de": "Ihre intellektuelle <w>Wahllosigkeit</w> ermöglichte es ihr, Inspiration aus ganz unterschiedlichen Fachbereichen zu schöpfen."
                            }
                        }
                    ],
                    "synonyms": [
                        "indiscriminateness",
                        "indiscrimination"
                    ],
                    "antonyms": [
                        "selectivity",
                        "discrimination"
                    ],
                    "common_phrases": [
                        "intellectual promiscuity"
                    ],
                    "target_lang_definitions": {
                        "de": "Die Eigenschaft, wahllos zu sein oder keine Selektivität zu zeigen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Wahllosigkeit",
                                "target_lang_sense_clarification": "Fehlen von Unterscheidung oder Auswahl"
                            },
                            {
                                "target_lang_word": "Regellosigkeit",
                                "target_lang_sense_clarification": "Mangel an Systematik oder Selektion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d714904-57fe-381d-bf1d-3cf3943cc5b4",
                    "sense_definition": "A state of being mixed together without order, system, or distinction; a confused mixture.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wished to spare his sick wife the sordid <w>promiscuity</w> of a crowded hospital ward. ",
                            "target_lang_translations": {
                                "de": "Er wollte seiner kranken Frau das elende <w>Durcheinander</w> eines überfüllten Krankenhaussaals ersparen."
                            }
                        },
                        {
                            "text": "The room was characterized by a chaotic <w>promiscuity</w> of styles from different centuries.",
                            "target_lang_translations": {
                                "de": "Der Raum war geprägt von einem chaotischen <w>Sammelsurium</w> an Stilen aus verschiedenen Jahrhunderten."
                            }
                        }
                    ],
                    "synonyms": [
                        "heterogeneity",
                        "miscellaneousness",
                        "mixture"
                    ],
                    "antonyms": [
                        "homogeneity",
                        "orderliness"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used in modern contexts outside literary descriptions"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Zustand des ungeordneten oder verwirrten Durcheinanders ohne klare Unterscheidung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Durcheinander",
                                "target_lang_sense_clarification": "chaotische Vermischung"
                            },
                            {
                                "target_lang_word": "Sammelsurium",
                                "target_lang_sense_clarification": "bunte, ungeordnete Mischung"
                            },
                            {
                                "target_lang_word": "Gemenge",
                                "target_lang_sense_clarification": "ungeordnete Anhäufung oder Mischung"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}