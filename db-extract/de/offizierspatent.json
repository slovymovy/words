                                        "sense_id": "9fcecfc9-3a70-3ac9-8ba1-fd328d92184d",
                                        "entry_id": "f4b5ef68-24d0-3724-95e5-0d5a0a1f435e",
                                        "glosses": [
                                            "An official charge or authority to do something, often used of military officers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7410ba1d-4998-41be-b3d4-e60011c9583f",
                                                "sense_id": "9fcecfc9-3a70-3ac9-8ba1-fd328d92184d",
                                                "text": "David received his commission after graduating from West Point."
                                            },
                                            {
                                                "example_id": "b6a94110-ac14-4cf9-8460-3a95d5fd89a1",
                                                "sense_id": "9fcecfc9-3a70-3ac9-8ba1-fd328d92184d",
                                                "text": "Let him see our commission."
                                            },
                                            {
                                                "example_id": "4b638caa-1c76-41ba-ab9c-86902c4f8ccb",
                                                "sense_id": "9fcecfc9-3a70-3ac9-8ba1-fd328d92184d",
                                                "text": "This is an exact Inventory of what we found about the Body of the Man-Mountain, who uſed us with great Civility, and due Reſpect to your Majefty's Commiſſion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7c3306a-b9e3-36b9-b945-fcb0358a96b3",
                                        "entry_id": "f4b5ef68-24d0-3724-95e5-0d5a0a1f435e",
                                        "glosses": [
                                            "The thing to be done as agent for another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2af99a6e-d252-41c1-9fa0-3dd5f90d8a6e",
                                                "sense_id": "a7c3306a-b9e3-36b9-b945-fcb0358a96b3",
                                                "text": "I have three commissions for the city."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b48e7f6f-72e3-3e0c-abf7-7e3da8437785",
                                        "entry_id": "f4b5ef68-24d0-3724-95e5-0d5a0a1f435e",
                                        "glosses": [
                                            "A body or group of people, officially tasked with carrying out a particular function."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5709bc50-0760-4d2a-9a53-a3af3c9fb1a0",
                                                "sense_id": "b48e7f6f-72e3-3e0c-abf7-7e3da8437785",
                                                "text": "the European Commission"
                                            },
                                            {
                                                "example_id": "91a28e0f-641d-4a28-8e4a-a13ba0efbdd3",
                                                "sense_id": "b48e7f6f-72e3-3e0c-abf7-7e3da8437785",
                                                "text": "the Electoral Commission"
                                            },
                                            {
                                                "example_id": "7dbdcd4a-8f79-4f10-ad00-69787e2307e3",
                                                "sense_id": "b48e7f6f-72e3-3e0c-abf7-7e3da8437785",
                                                "text": "the Federal Communications Commission"
                                            },
                                            {
                                                "example_id": "7a7fbbf3-9162-447f-ac13-8c4d07c4a3c7",
                                                "sense_id": "b48e7f6f-72e3-3e0c-abf7-7e3da8437785",
                                                "text": "The company's sexual harassment commission made sure that every employee completed the on-line course."
                                            },
                                            {
                                                "example_id": "46993f86-f8e0-4d8e-81db-8c59cd12802f",
                                                "sense_id": "b48e7f6f-72e3-3e0c-abf7-7e3da8437785",
                                                "text": "A commission was at once appointed to examine into the matter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3322aa99-55c3-3f39-a48f-88fb3ef266ca",
                                        "entry_id": "f4b5ef68-24d0-3724-95e5-0d5a0a1f435e",
                                        "glosses": [
                                            "A fee charged by an agent or broker for carrying out a transaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c1fc252-8223-44f2-b12c-3c13babef185",
                                                "sense_id": "3322aa99-55c3-3f39-a48f-88fb3ef266ca",
                                                "text": "a reseller's commission"
                                            },
                                            {
                                                "example_id": "8810a329-1bfe-4e69-9443-89a45f850436",
                                                "sense_id": "3322aa99-55c3-3f39-a48f-88fb3ef266ca",
                                                "text": "The real-estate broker charged a four percent commission for their knowledge on bidding for commercial properties; for their intellectual perspective on making a formal offer and the strategy to obtain a mutually satisfying deal with the seller in favour of the buyer."
                                            },
                                            {
                                                "example_id": "ff1352a5-3a4d-4cb8-b4c5-514c538856ba",
                                                "sense_id": "3322aa99-55c3-3f39-a48f-88fb3ef266ca",
                                                "text": "[T]he scandal was the pretty common one of a corrupt agreement between hotel proprietors and a salesman who took and gave secret commissions, so that his business had a monopoly of all the drink sold in the place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdd346c8-d271-3451-bb43-8477b200be7d",
                                        "entry_id": "f4b5ef68-24d0-3724-95e5-0d5a0a1f435e",
                                        "glosses": [
                                            "The act of committing (e.g. a crime or error)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57dbca61-b858-4bf4-b97f-feea2fdf59f5",
                                                "sense_id": "bdd346c8-d271-3451-bb43-8477b200be7d",
                                                "text": "the commission, preparation or instigation of an act of terrorism"
                                            },
                                            {
                                                "example_id": "82302c5a-7b86-48fd-a888-9d71fca8f2a2",
                                                "sense_id": "bdd346c8-d271-3451-bb43-8477b200be7d",
                                                "text": "Every commission of sin introduces into the soul a certain degree of hardness."
                                            },
                                            {
                                                "example_id": "de53066c-fb52-47f4-921a-e952125f5640",
                                                "sense_id": "bdd346c8-d271-3451-bb43-8477b200be7d",
                                                "text": "Two witnesses to the assault, both patrons of the bar at the time of the incident, were also subpoenaed, but they were requested to sign a waiver of immunity, which would allow their prosecution in the event that their testimony indicated their involvement in the commission of a crime."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "commission",
