                                        "glosses": [
                                            "Commune et ville de la région de Frioul-Vénétie julienne en Italie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da7f17fe-8c5d-4799-9a7b-40edfa453993",
                                                "sense_id": "03004815-1e88-32a8-9180-69ea83023e2f",
                                                "text": "Le patriarche était fort endetté vis-à-vis de certains bourgeois d’Udine, et cette ville s’efforçait de maintenir intacts les droits des siens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00823651-4d36-3760-a4d7-87890ddcb57b",
                                        "entry_id": "6745f87c-93ba-3d8a-9983-4b219ef17363",
                                        "glosses": [
                                            "Province autour de cette ville."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eb77333-720a-484f-b194-0ac0f9503a48",
                                                "sense_id": "00823651-4d36-3760-a4d7-87890ddcb57b",
                                                "text": "Pordenone , petite ville industrielle de la province d’Udine et patrie du peintre surnommé le Pordenone (1484-1539) qui travailla notamment à Trieste et à Venise . Voir le Palais communal gothique et le Dôme avec son clocher du XVIe siècle"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
