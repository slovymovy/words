                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47498fc9-e02e-43d8-b9fe-0a757bdda820",
                                "sense_id": "81407e8d-5ed9-3c3e-bc1f-16eb79e5addc",
                                "text": "Кто тебя, драгая шея, // Мощной дланью обоймёт? // Кто тебя, дыханьем грея, // Поцелуем пропечёт? // Кто тебя, крутая выя, // До косы от самых плеч, // В дни июля огневые // Будет с зоркостью беречь…"
                            }
                        ]
                    }
