                ],
                "senses": [
                    {
                        "sense_id": "25406031-7c42-3d47-b204-0e86f7476a37",
                        "entry_id": "81b5f5c1-2fd8-3122-b0a8-27dde45bb2d5",
                        "glosses": [
                            "Gerät zum Befüllen eines geschlossenen Behälters (z. B. eines Reifens) mit Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce03c343-6843-4c86-9a34-dcb2b9f64b4a",
                                "sense_id": "25406031-7c42-3d47-b204-0e86f7476a37",
                                "text": "Luftpumpen bestehen meistens aus einem Zylinder und einem darin beweglichen Kolben."
                            },
                            {
                                "example_id": "252fac73-f0d6-4f33-b669-658c2f9ca376",
                                "sense_id": "25406031-7c42-3d47-b204-0e86f7476a37",
                                "text": "„Mangels geeigneter Luftpumpen mußten wir das Schlauchboot mit dem Mund aufpusten, wobei einem der Schweiß nur so runterlief.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b8971fd5-46e1-3553-ad45-7854f81324c6",
                        "entry_id": "81b5f5c1-2fd8-3122-b0a8-27dde45bb2d5",
                        "glosses": [
                            "ein Sternbild des südlichen Sternenhimmels"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "384b89ad-2e71-4775-a5ea-d03f8c9b6ffc",
                                "sense_id": "b8971fd5-46e1-3553-ad45-7854f81324c6",
                                "text": "Der französische Astronom Abbé Nicolas Louis de Lacaille benannte das Sternbild Luftpumpe, um an die Verbesserung der Luftpumpe ^([1]) durch den englischen Physiker Robert Boyle zu erinnern."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
