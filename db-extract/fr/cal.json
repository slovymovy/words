                "senses": [
                    {
                        "sense_id": "8b4ac065-7dba-3fd8-8a60-5d71ca57e3fc",
                        "entry_id": "1344c3e8-026c-34f9-8d35-de9d6e2db5ca",
                        "glosses": [
                            "Durillon, dureté cutanée, qui vient à la plante des pieds, à la paume de la main ou au genou par suite d’un frottement répété."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35fa5258-e075-4f0d-abc8-a2fb8cb32a9a",
                                "sense_id": "8b4ac065-7dba-3fd8-8a60-5d71ca57e3fc",
                                "text": "Ce sont de vieux outils qui se placent tout naturellement à l’aise dans les cals de la main qui les manipule habituellement."
                            },
                            {
                                "example_id": "96047b7a-7dc3-4445-addb-a004a4a73470",
                                "sense_id": "8b4ac065-7dba-3fd8-8a60-5d71ca57e3fc",
                                "text": "Il vient des cals aux mains à force de travailler et aux pieds à force de marcher."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfcc9f87-4f55-3305-b654-63695b891c67",
                        "entry_id": "1344c3e8-026c-34f9-8d35-de9d6e2db5ca",
                        "glosses": [
                            "Soudure naturelle qui rejoint les fragments d’un os rompu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65391bc7-e454-4e31-82b7-9031ee9dc180",
                                "sense_id": "bfcc9f87-4f55-3305-b654-63695b891c67",
                                "text": "« Il n’y a pas de dérangement dans la position du membre… tout gonflement a disparu… le cal se fait normalement… et ces nuits sont toujours mauvaises, dites-vous ?… il n’y a plus de fièvre cependant… voyons, puisque vous le désirez, je vais toujours vous donner quelque chose pour le faire dormir. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "41663519-8874-3609-8ef5-163ce64745a3",
                        "entry_id": "1344c3e8-026c-34f9-8d35-de9d6e2db5ca",
                        "glosses": [
                            "Amas de cellules indifférenciées produites à la suite d'une blessure. C’est le facteur de transcription WIND1 qui est responsable de ce phénomène. Ne pas confondre avec le bourrelet de recouvrement produit par la suite par les deux méristèmes secondaires : cambium et phellogène (chez les dicotylédones et gymnospermes)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "131dba19-7e13-4e1f-8373-d30a4b8ad62d",
                        "source_entry_id": "1344c3e8-026c-34f9-8d35-de9d6e2db5ca",
                        "target_lang_word": "Schwiele",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwiele",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7da34cbe-55dc-310a-ba62-5cc6c5607258",
                                        "entry_id": "6df3864a-421d-3253-ac72-e3c56c3f3c40",
                                        "glosses": [
                                            "durch Druck, große mechanische Belastung verursachte Verdickung der äußeren Hautschicht (besonders an der Innenseite der Hand)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b80d219d-7fc3-42cc-82d9-c92f7684db2a",
                                                "sense_id": "7da34cbe-55dc-310a-ba62-5cc6c5607258",
                                                "text": "„An meiner linken Hand hatte ich Schwielen vom Tanzen an der Stange, an meiner rechten hatte ich Schwielen von der Gitarre.“"
                                            },
                                            {
                                                "example_id": "641aed58-6d25-4ff8-88c5-c24cdd730a03",
                                                "sense_id": "7da34cbe-55dc-310a-ba62-5cc6c5607258",
                                                "text": "„Sie würde zusehen, wie er die Beine eines wackligen Tisches absägte, den Madam gekauft hatte, und sie würde sich darüber wundern, dass er keine Schwielen an den Händen hatte.“"
                                            },
                                            {
                                                "example_id": "38c7c893-dd72-4843-9336-02de411eb9e2",
                                                "sense_id": "7da34cbe-55dc-310a-ba62-5cc6c5607258",
                                                "text": "„Abgesehen von den Schwielen sind sie feingliedrig, die langen Finger halten locker die Zügel der gutmütigen Stute.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d659300-b9d0-3ec6-b9d3-e3fe89a87e66",
                                        "entry_id": "6df3864a-421d-3253-ac72-e3c56c3f3c40",
                                        "glosses": [
                                            "durch Entzündungen verursachte Verdickung von Gewebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03bdb3a8-2e4f-4a2c-b56a-0c01fe79e539",
                                                "sense_id": "4d659300-b9d0-3ec6-b9d3-e3fe89a87e66",
                                                "text": "„Nach einer Entzündung des Rippenfells (Pleuritis) kann es zu einer Schwielenbildung des Rippenfells kommen. Das Rippenfell umgibt die Lunge. Die Schwielen verhindern durch ihre Härte eine vollständige Ausdehnung der Lunge bei tiefer Einatmung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
