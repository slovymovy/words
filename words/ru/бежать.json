{
    "word_family": [
        "бег",
        "бегун",
        "бегунья",
        "беговой",
        "беглый",
        "беготня"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a908d0a-a25b-376a-bf8b-95f9a19d8069",
                    "sense_definition": "Быстро перемещаться на ногах, периодически отрываясь от опоры.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "движение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Теперь Фандорин уже не идёт, а <w>бежит</w> вприпрыжку, из-под его ног разлетаются потревоженные голуби."
                        },
                        {
                            "text": "Маленький мальчик быстро <w>бежит</w> по парку к своей маме."
                        }
                    ],
                    "synonyms": [
                        "мчаться",
                        "лететь"
                    ],
                    "antonyms": [
                        "стоять"
                    ],
                    "common_phrases": [
                        "бежать быстро",
                        "бежать домой"
                    ]
                },
                {
                    "sense_id": "26f046a5-ff58-309d-a556-a6e998cec5e8",
                    "sense_definition": "Быстро идти, торопиться куда-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "движение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мама <w>бежит</w> за чем-то в кухню и натыкается на Витеньку."
                        },
                        {
                            "text": "Я <w>бегу</w> в поликлинику к врачу."
                        }
                    ],
                    "synonyms": [
                        "торопиться",
                        "спешить"
                    ],
                    "common_phrases": [
                        "бежать на работу",
                        "бежать по делам"
                    ]
                },
                {
                    "sense_id": "dbc30762-305d-32cc-9d3a-15ee29546748",
                    "sense_definition": "Быстро проходить, протекать (о времени или событиях).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "время",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Время <w>бежит</w> очень быстро, когда мы заняты интересным делом."
                        },
                        {
                            "text": "Годы <w>бегут</w> незаметно для каждого человека."
                        }
                    ],
                    "common_phrases": [
                        "время бежит"
                    ]
                },
                {
                    "sense_id": "3c73975e-2496-3158-ab95-1e393b790d86",
                    "sense_definition": "Течь, струиться (о жидкостях).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "движение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Всюду <w>бежали</w> ручьи, уходя местами под серые крупитчатые сугробы."
                        },
                        {
                            "text": "По лицу его <w>бежал</w> пот от сильной жары."
                        }
                    ],
                    "synonyms": [
                        "течь",
                        "струиться"
                    ],
                    "common_phrases": [
                        "ручьи бегут",
                        "слёзы бегут"
                    ]
                },
                {
                    "sense_id": "f17615de-0764-3a82-a84f-8e7ba17332b0",
                    "sense_definition": "В панике отступать, покидать поле боя.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "бегство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Появление наших солдат было столь неожиданным, что противник <w>бежал</w>."
                        },
                        {
                            "text": "Враг <w>бежит</w> с поля боя, бросая оружие."
                        }
                    ],
                    "synonyms": [
                        "отступать",
                        "ретироваться"
                    ],
                    "common_phrases": [
                        "враг бежит"
                    ]
                },
                {
                    "sense_id": "438199b0-0132-302a-b55e-2d3891f4463d",
                    "sense_definition": "Избегать, сторониться кого-либо или чего-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "избегание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я мрачен, дик, людей <w>бегу</w>, хотел бы иногда их видеть."
                        },
                        {
                            "text": "Не стоит <w>бежать</w> своих проблем, лучше попытаться их решить."
                        }
                    ],
                    "synonyms": [
                        "избега́ть"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "часто встречается в классической литературе"
                        }
                    ]
                }
            ]
        }
    ]
}