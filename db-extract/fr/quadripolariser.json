                "senses": [
                    {
                        "sense_id": "18465060-2c87-341d-9e8f-30ec8c81f2f9",
                        "entry_id": "f217c745-b889-315a-bd38-1526912605e0",
                        "glosses": [
                            "Rendre quadripolaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a16c66d6-4708-4355-820a-7694bd77209b",
                                "sense_id": "18465060-2c87-341d-9e8f-30ec8c81f2f9",
                                "text": "Ou encore la tentative des « petits médias » de quadripolariser le débat: il y a foultitude de petits partis."
                            },
                            {
                                "example_id": "ceeb2986-19e3-4d3c-a6fb-3760bb568863",
                                "sense_id": "18465060-2c87-341d-9e8f-30ec8c81f2f9",
                                "text": "Cette conjoncture quadripolarisée où le protagoniste se montre en quelque sorte crucifié n'est que le prélude à la passion qu'il lui reste à connaître les yeux ouverts."
                            }
                        ]
                    }
