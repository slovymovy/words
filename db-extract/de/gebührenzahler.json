                    {
                        "sense_id": "415fe13f-8b1d-3f81-94dc-3e167cae9ef6",
                        "entry_id": "6e20af13-0286-35f9-9439-615352dd4585",
                        "glosses": [
                            "Person, die eine bestimmte Geldsumme für eine Dienstleistung oder die Benutzung einer Sache entrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3545b923-3019-4e25-94ba-e059147580c0",
                                "sense_id": "415fe13f-8b1d-3f81-94dc-3e167cae9ef6",
                                "text": "„Ebenso werden die Gebührenzahler die mehr als 150 Millionen Euro verkraften, die ARD und ZDF für die Übertragungsrechte für alle 64 WM-Spiele auf den Tisch blättern mussten.“"
                            },
                            {
                                "example_id": "c20d26d0-d524-491c-8840-59eb55002072",
                                "sense_id": "415fe13f-8b1d-3f81-94dc-3e167cae9ef6",
                                "text": "„Bis 2013 mussten Gebührenzahler, die nur ein Radio oder einen internetfähigen Computer besaßen, 5,76 Euro pro Monat zahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
