                    {
                        "sense_id": "6123a897-15a6-3087-bb41-60299d6369a4",
                        "entry_id": "42a705e1-99ae-3c95-b50a-17d33b4b8650",
                        "glosses": [
                            "een vrouwelijke monarch van de allerhoogste rang, oorspronkelijk die van het Romeinse rijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d88638f3-7422-49ed-ba04-5e2ced80036c",
                                "sense_id": "6123a897-15a6-3087-bb41-60299d6369a4",
                                "text": "Een keizerin was een stuk minder gebruikelijk dan een keizer."
                            }
                        ]
                    },
                    {
                        "sense_id": "ccae0b30-4a7d-3074-9f60-33b8c85fc210",
                        "entry_id": "42a705e1-99ae-3c95-b50a-17d33b4b8650",
                        "glosses": [
                            "de vrouw van een keizer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67f07b89-55d8-4671-b461-1901ab01ab16",
                                "sense_id": "ccae0b30-4a7d-3074-9f60-33b8c85fc210",
                                "text": "De keizerin mocht naast haar man staan, maar verder niets zeggen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "644a3f66-c465-463a-9d3a-b3d07616ee13",
                        "source_entry_id": "42a705e1-99ae-3c95-b50a-17d33b4b8650",
                        "source_sense_id": "6123a897-15a6-3087-bb41-60299d6369a4",
                        "source_sense_description": "een vrouwelijke monarch van de allerhoogste rang, oorspronkelijk die van het Romeinse rijk",
                        "target_lang_word": "Kaiserin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaiserin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3692ebe-040a-31bc-9ee6-02519dfe02ea",
                                        "entry_id": "31581382-ba6a-3aaf-b805-06030e515589",
                                        "glosses": [
                                            "Herrscherin eines Staates (Kaiserreichs)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "738c7255-492e-476f-bbbb-526dd92ab25a",
                                                "sense_id": "a3692ebe-040a-31bc-9ee6-02519dfe02ea",
                                                "text": "„Zusammen mit Rostows sollte Marja Ignatjewna Peronskaja auf den Ball gehen, eine Freundin und Verwandte der Gräfin, eine dürre und gelbliche Person, ehemals Hofdame der alten Kaiserin, die jetzt die Rostows als Provizialen in der großen Welt Petersburgs unter ihre Fittiche nahm.“"
                                            },
                                            {
                                                "example_id": "dc1bbe42-4aa4-4d72-a613-44b1a6c26b33",
                                                "sense_id": "a3692ebe-040a-31bc-9ee6-02519dfe02ea",
                                                "text": "„Wir haben ja gelesen, dass der »Agathon« (von dessen Neuausgabe die Kaiserin Katharina von Russland 20 Exemplare bestellt hatte) in Wien unter Zensurverbot stand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f5a782b1-4729-3174-b5a2-34ace98f50de",
                                        "entry_id": "31581382-ba6a-3aaf-b805-06030e515589",
                                        "glosses": [
                                            "Gattin eines Kaisers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0debf3a5-e4cd-4981-a142-17d0290d2537",
                                                "sense_id": "f5a782b1-4729-3174-b5a2-34ace98f50de",
                                                "text": "„Doch teils mit Waffengewalt, teils über öffentlichen Druck seiner Anhänger auf die Kaiserin bringt der Regent sie zum Schweigen.“"
                                            },
                                            {
                                                "example_id": "60a4eacb-f7cc-47e1-8fc2-c5d8f1ce3800",
                                                "sense_id": "f5a782b1-4729-3174-b5a2-34ace98f50de",
                                                "text": "Die Kaiserin Sisi von Österreich-Ungarn war für ihre Schönheit berühmt."
                                            },
                                            {
                                                "example_id": "b7a00eed-6c69-4351-914a-f289c50957be",
                                                "sense_id": "f5a782b1-4729-3174-b5a2-34ace98f50de",
                                                "text": "„Er sitzt neben der Kaiserin.“"
                                            },
                                            {
                                                "example_id": "5c5e4cb5-7e39-419a-8e8e-9958de535bb8",
                                                "sense_id": "f5a782b1-4729-3174-b5a2-34ace98f50de",
                                                "text": "„Ein Kammerherr der Kaiserin überbrachte ihm eine Einladung zu Ihrer Majestät.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
