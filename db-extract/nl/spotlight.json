                ],
                "senses": [
                    {
                        "sense_id": "6128c431-5d8a-3e53-98c1-aeb8ef1ca4a2",
                        "entry_id": "25c3e88b-8d26-3fc6-8c92-8264a2f26c4c",
                        "glosses": [
                            "een lamp die een gericht licht laat schijnen op één optredend persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16e5ae00-d65a-41cb-a671-dfef30a01e4c",
                                "sense_id": "6128c431-5d8a-3e53-98c1-aeb8ef1ca4a2",
                                "text": "Mijn ouders, mijn broer en zijn gezin, mijn verstandige en sterke vriendin Annelou. Snel daarna slaat de emotie om in geluk. Het podium en de spotlights, daar is mijn plek."
                            },
                            {
                                "example_id": "f51d483d-7e2c-4335-a8f2-aa7e4fff7b90",
                                "sense_id": "6128c431-5d8a-3e53-98c1-aeb8ef1ca4a2",
                                "text": "Een eindje verderop was turbulentie in de menigte. Iemand riep boven alles uit: 'Opzij! Aan de kant!' Isebrand signaleerde tussen de door elkaar en heen en weer bewegende benen een gebogen gestalte met een kale kop die een trolley beladen met computers in de richting van de spotlights duwde: Sylvio."
                            },
                            {
                                "example_id": "e81c05bf-144f-4a18-9df1-fcefdd8f176a",
                                "sense_id": "6128c431-5d8a-3e53-98c1-aeb8ef1ca4a2",
                                "text": "Van der Paal zelf schuwt de spotlights. Letterlijk. Het filmpje dat nieuwssite Apache online zette van het verjaardagsfeestje van vorige maand bevat een van de weinige, en dan nog wazige, publieke beelden van de man."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
