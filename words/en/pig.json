                                "target_lang_word": "条子",
                                "target_lang_sense_clarification": "俚语，指警察"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95645760-be7a-3d80-b37c-bd01b195d2d6",
                    "sense_definition": "A difficult or unpleasant problem or task.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This math problem is a real <w>pig</w> to solve.",
                            "target_lang_translations": {
                                "ru": "Эту математическую задачу решить — настоящая <w>морока</w>.",
                                "zh": "这道数学题真是个棘手的<w>麻烦事</w>。"
                            }
                        },
                        {
                            "text": "Removing the chewing gum from the carpet was a <w>pig</w> of a job.",
                            "target_lang_translations": {
                                "ru": "Отдирать жвачку от ковра было <w>адской</w> работой.",
                                "zh": "从地毯上清除口香糖是一项非常<w>麻烦</w>的工作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "a real pig",
                        "pig of a job"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудная или неприятная задача; проблема.",
                        "zh": "困难或令人不快的任务或问题。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морока",
                                "target_lang_sense_clarification": "хлопотное дело"
                            },
                            {
                                "target_lang_word": "геморрой",
                                "target_lang_sense_clarification": "сленг: сложная проблема"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "麻烦事",
                                "target_lang_sense_clarification": "指棘手的问题"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5aa676b-cee4-3bc0-9347-2f55ce3fc385",
                    "sense_definition": "An oblong block of cast metal, usually iron or lead.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical_object",
                    "name_type": "no",
