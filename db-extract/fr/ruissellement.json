                            {
                                "target_word": "streaming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "778f8d33-2bdb-336e-a3e5-492ec736f181",
                                        "entry_id": "ebc13478-d5cd-3c98-a83b-d02c7c9c4e6f",
                                        "glosses": [
                                            "Movement as a stream."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c36b97e4-ffe2-3fdb-829a-ae2d5f0f4fdc",
                                        "entry_id": "ebc13478-d5cd-3c98-a83b-d02c7c9c4e6f",
                                        "glosses": [
                                            "The transmission of digital audio or video, or the reception or playback of such data without first storing it."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7deecdd-de5b-4a35-937e-1ce1f92e7faa",
                                                "sense_id": "c36b97e4-ffe2-3fdb-829a-ae2d5f0f4fdc",
                                                "text": "Streaming has a dirty secret. The carbon footprint produced by fans watching a month of Netflix’s top 10 global TV hits is equivalent to driving a car a hefty distance beyond Saturn."
                                            },
                                            {
                                                "example_id": "9ea70fed-6111-4f9a-af10-f43455c64f64",
                                                "sense_id": "c36b97e4-ffe2-3fdb-829a-ae2d5f0f4fdc",
                                                "text": "The entertainment industry is trying to figure out the economics of streaming. It’s also facing angst over a tech-powered future and fighting to stay culturally dominant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31e9952f-b1ca-3d18-9961-15b538b2b4b7",
                                        "entry_id": "ebc13478-d5cd-3c98-a83b-d02c7c9c4e6f",
                                        "glosses": [
                                            "Synonym of livestreaming."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5bfc9be-9af5-3ff8-8595-9bfce8001c59",
                                        "entry_id": "ebc13478-d5cd-3c98-a83b-d02c7c9c4e6f",
                                        "glosses": [
                                            "Division of classes into academic streams."
                                        ],
                                        "tags": [
                                            "UK",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e48786e9-e72e-478a-a5e1-ed857b933c43",
                                                "sense_id": "c5bfc9be-9af5-3ff8-8595-9bfce8001c59",
                                                "text": "Imagine a country where children do nothing but play until they start compulsory schooling at age seven. Then, without exception, they attend comprehensives until the age of 16. Charging school fees is illegal, and so is sorting pupils into ability groups by streaming or setting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "609d97b0-000f-3f06-8a03-a5ca658a5939",
                                        "entry_id": "ebc13478-d5cd-3c98-a83b-d02c7c9c4e6f",
                                        "glosses": [
                                            "The working of alluvial deposits to obtain ore."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f34a39a-7f83-46a1-aad3-7566928edab2",
                        "source_entry_id": "6ea9e024-9c3d-3ec3-bde8-36ac5d9bf648",
                        "target_lang_word": "runoff",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "runoff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e63ec7d-b544-3694-980f-f56b8badc612",
                                        "entry_id": "a5566a77-3e17-3542-ab4e-4c545770f12f",
                                        "glosses": [
                                            "That portion of precipitation or irrigation on an area which does not infiltrate or evaporate, but instead is discharged from the area."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "482d5d3d-3354-43e0-a529-45a6464549eb",
                                                "sense_id": "6e63ec7d-b544-3694-980f-f56b8badc612",
                                                "text": "The next series of high tides or large waves will tend to rebuild the berm and redam the stream. Ultimately, increased runoff due to fall or winter rains will raise the stream level to the point where it breaks through."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebe74e6a-3c9a-3846-a53e-8fcc2ccfacfa",
                                        "entry_id": "a5566a77-3e17-3542-ab4e-4c545770f12f",
                                        "glosses": [
                                            "Dissolved chemicals, etc, included in such water."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2f8470e-cb85-4fd9-8348-3fbd337b7c01",
                                                "sense_id": "ebe74e6a-3c9a-3846-a53e-8fcc2ccfacfa",
                                                "text": "The runoff of nitrates is poisoning the lake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9923bc59-fe90-3da2-8895-2376b278aa94",
                                        "entry_id": "a5566a77-3e17-3542-ab4e-4c545770f12f",
                                        "glosses": [
                                            "A second or further round of a competition, after other competitors (often all but the last two) have been eliminated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68bfc832-58f8-39a3-9267-73b65abe6dc6",
                                        "entry_id": "a5566a77-3e17-3542-ab4e-4c545770f12f",
                                        "glosses": [
                                            "A second or further round of an indecisive election, after other candidates (often all but the last two) have been eliminated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82c9ef35-ba94-4dbc-ae0f-3e57360536cb",
                                                "sense_id": "68bfc832-58f8-39a3-9267-73b65abe6dc6",
                                                "text": "There will now be a runoff as neither front runner received more than 50% of the vote."
                                            },
                                            {
                                                "example_id": "937ca253-352a-43f3-9127-4be38d84b797",
                                                "sense_id": "68bfc832-58f8-39a3-9267-73b65abe6dc6",
                                                "text": "It is one of the left's best ever results and will raise momentum for next month's final runoff where only the two candidates will compete against each other."
                                            },
                                            {
                                                "example_id": "145a112b-c47e-41f2-a919-9df7510646fd",
                                                "sense_id": "68bfc832-58f8-39a3-9267-73b65abe6dc6",
                                                "text": "Mr. Macron was unable to command more than a small plurality of support against several opponents in the first round of voting on April 10. Ms. Le Pen, who finished second, is his opponent in the runoff election on Sunday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f96c018d-24e6-4ca5-8f8a-738f44b3578f",
                        "source_entry_id": "6ea9e024-9c3d-3ec3-bde8-36ac5d9bf648",
                        "target_lang_word": "trickle-down",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trickle-down",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62d15f59-0c39-3ed8-931d-e6b2b72f9da8",
                                        "entry_id": "41dbf1a5-3ac3-3721-b4d3-be99838f2c7f",
                                        "glosses": [
                                            "That flows, especially in limited quantity, from the highly placed to others."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8400952-a867-44f1-bf14-8e69743a6ef1",
                                                "sense_id": "62d15f59-0c39-3ed8-931d-e6b2b72f9da8",
                                                "text": "His name is Harry E Thompson and his Trickle-Down solar heating system is the basis for this book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d84de8b2-8f01-3a35-9c84-412c2433b8f8",
                                        "entry_id": "41dbf1a5-3ac3-3721-b4d3-be99838f2c7f",
                                        "glosses": [
                                            "Describing the theory that financial benefits given to the wealthy will somehow be passed down to the poor."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d95af03-cf2f-4a7e-8fe3-4fac88febc45",
                                                "sense_id": "d84de8b2-8f01-3a35-9c84-412c2433b8f8",
                                                "text": "In addition, it examines the trickle-down effects of economic development as espoused by market theorists in the urban economic development literature. Policymakers in Rockford used the trickle-down logic of market theory to justify a […]"
                                            },
                                            {
                                                "example_id": "a6dee11d-749c-4df6-a587-9df6b3f68b94",
                                                "sense_id": "d84de8b2-8f01-3a35-9c84-412c2433b8f8",
                                                "text": "While the trickle-down mechanism is based on market optimism (in a well-functioning economy, the poor will benefit automatically from any growth), proponents of direct and indirect policies targeting the poor are market-pessimists, in which […]"
                                            },
                                            {
                                                "example_id": "e6c2d1a8-cfa5-42c1-acb8-15946795d9bb",
                                                "sense_id": "d84de8b2-8f01-3a35-9c84-412c2433b8f8",
                                                "text": "On the surface, the Kuznets curve seems to justify laissez-faire economics and trickle-down policies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dab6bac-143b-3452-b072-b49ced41a70f",
                                        "entry_id": "41dbf1a5-3ac3-3721-b4d3-be99838f2c7f",
                                        "glosses": [
                                            "Describing a model of product adoption that flows vertically from the upper classes to the lower classes within society."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72d1588a-10e4-4c73-b597-aa8511677124",
                                                "sense_id": "0dab6bac-143b-3452-b072-b49ced41a70f",
                                                "text": "Trickle-down patterns are very common for technological innovations, especially when new gadgets come to market with high price tags. The first black-and-white televisions cost more than some automobiles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
