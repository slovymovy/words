                    {
                        "translation_id": "49912090-be97-403e-b5b0-4d86aa64be24",
                        "source_entry_id": "72df81ac-cc2e-3201-881a-e6ffc4c6ef05",
                        "source_sense_id": "de2401c9-1634-3046-a316-388b7a7ff37c",
                        "target_lang_word": "capsaïcine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capsaïcine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2ea724b-8ab5-3030-a2d4-93966bbd4c7d",
                                        "entry_id": "da0dab65-8217-3530-8ecb-6ba35f33523b",
                                        "glosses": [
                                            "Alcaloïde de saveur brûlante extrait du piment et de nombreuses autres plantes. Le poivre sec en contient un gramme par kilogramme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d3111d-2911-487d-82de-ddecefdddb0c",
                                                "sense_id": "c2ea724b-8ab5-3030-a2d4-93966bbd4c7d",
                                                "text": "Le piquant vient surtout de la capsaicine dont on mesure la concentration pour déterminer le degré de piquant du produit."
                                            },
                                            {
                                                "example_id": "9be968c9-c6ee-4ac9-b8a6-08c93db7ff29",
                                                "sense_id": "c2ea724b-8ab5-3030-a2d4-93966bbd4c7d",
                                                "text": "Boire de l’eau pour faire cesser la brûlure du piment est inutile. La capsaïcine n’est en effet pas soluble dans l’eau, mais dans les graisses : mieux vaut se rincer la bouche avec de l’huile ou du lait, qui contient de la matière grasse émulsionnée."
                                            },
                                            {
                                                "example_id": "ce020b0a-5718-4315-bd58-16f601e29cb4",
                                                "sense_id": "c2ea724b-8ab5-3030-a2d4-93966bbd4c7d",
                                                "text": "Sur l’échelle de 1 à 10 de Scoville, qui mesure la teneur en capsaïcine responsable de la force des piments, les poivrons obtiennent 0 et les piments explosifs 10."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37b0f72c-2829-4627-ac42-ec5363b408e9",
                        "source_entry_id": "72df81ac-cc2e-3201-881a-e6ffc4c6ef05",
