                ],
                "senses": [
                    {
                        "sense_id": "8505d5a2-a82a-3be4-b99a-2486538e4ccc",
                        "entry_id": "67226bfe-11c4-3ea6-8547-d8078b2b4de3",
                        "glosses": [
                            "in einem Farbton, der so bleich ist, dass er an Tote erinnert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6b29423-9040-4788-8d45-80d42578877e",
                                "sense_id": "8505d5a2-a82a-3be4-b99a-2486538e4ccc",
                                "text": "„Aus totenbleichem Marmor waren ihre Mauern und Türme, ihre Säulen, Kuppeln und Pflaster.“"
                            },
                            {
                                "example_id": "7234812b-29f0-4a6a-93f9-cf7d6d69ede1",
                                "sense_id": "8505d5a2-a82a-3be4-b99a-2486538e4ccc",
                                "text": "„Sein totenbleiches Gesicht glänzte unter der Schicht aus Blut.“"
                            },
                            {
