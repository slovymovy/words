                    },
                    {
                        "translation_id": "35b76724-19d1-46a0-9896-c45ad3ed3ea6",
                        "source_entry_id": "482aca05-c9ca-36ab-88c6-5b3c71b4294b",
                        "target_lang_word": "三角測量",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cacccc38-67f7-4ed5-a235-c23b066b50f6",
                        "source_entry_id": "482aca05-c9ca-36ab-88c6-5b3c71b4294b",
                        "target_lang_word": "Dreiecksmessung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cccd1d52-db96-481f-93ad-ccefc9e7a909",
                        "source_entry_id": "482aca05-c9ca-36ab-88c6-5b3c71b4294b",
                        "target_lang_word": "Dreiecksaufnahme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ef2ae052-fa90-459e-9954-f9a3947d3a98",
                        "source_entry_id": "482aca05-c9ca-36ab-88c6-5b3c71b4294b",
                        "target_lang_word": "Triangulation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Triangulation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef393dec-07c1-34d3-b17d-4e7205bdb090",
                                        "entry_id": "0c915d81-5f66-34fc-8e1b-07dfc97bece1",
                                        "glosses": [
                                            "Festlegung eines Netzes aus Dreiecken zur Landvermessung"
                                        ],
                                        "tags": [
                                            "Geodäsie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5aee90f7-3335-4dac-80f8-057d1f86cbd9",
                                                "sense_id": "ef393dec-07c1-34d3-b17d-4e7205bdb090",
                                                "text": "Seit Gemma Frisius 1533 die Zerlegung der zu vermessenden Gegenden in Dreiecke lehrte, welche sich aneinander anschließen und sich gegenseitig sichern, hatte die Triangulation große Fortschritte gemacht."
                                            },
                                            {
                                                "example_id": "554b96c9-bf36-475d-9d79-1af437c3a9fe",
                                                "sense_id": "ef393dec-07c1-34d3-b17d-4e7205bdb090",
                                                "text": "1824 zur trigonometrischen Abtheilung des Generalstabes commandirt, war er in dieser Stellung mehrere Jahre bei der Triangulation von Schlesien und Posen thätig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "07d4c230-f854-32ea-9ca6-15db280cede2",
                                        "entry_id": "0c915d81-5f66-34fc-8e1b-07dfc97bece1",
                                        "glosses": [
                                            "historische Bestimmung von Größenverhältnissen bei Bauwerken mithilfe von gleichseitigen Dreiecken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6900df7-4574-4bc4-8b25-2d4ea64ae852",
                                                "sense_id": "07d4c230-f854-32ea-9ca6-15db280cede2",
                                                "text": "Die frühere Baukunst hat ihre Abmessungen hauptsächlich aus Quadrat und gleichseitigem Dreieck entwickelt - also aus Quadratur und Triangulation."
                                            },
                                            {
                                                "example_id": "3f07f347-b8c4-473c-84d4-8ed47ab3ddbd",
                                                "sense_id": "07d4c230-f854-32ea-9ca6-15db280cede2",
                                                "text": "Die bei weitem wichtigste Anwendung des gleichseitigen Dreiecks für die mittelalterliche Architektur bestand aber in der Herstellung von triangulierten Rechtecken. Neben dem Triangel kommt als bedeutendste Figur das Quadrat in Betracht, und daher neben der Triangulation die Quadratur."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f9873b21-1d34-3777-89de-994b3e192801",
                                        "entry_id": "0c915d81-5f66-34fc-8e1b-07dfc97bece1",
                                        "glosses": [
                                            "Veredelung von Zierbäumen und Obstbäumen durch eine dreieckige Form der Pfropfung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52bfea44-f72b-4317-bddc-a46a6eca1cc4",
                                                "sense_id": "f9873b21-1d34-3777-89de-994b3e192801",
                                                "text": "Bei der Triangulation wird im Wildling ein dreieckiger Ausschnitt mit dem Geißfuß gekerbt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1c855b94-676a-3afa-a159-2a060546cb08",
                                        "entry_id": "0c915d81-5f66-34fc-8e1b-07dfc97bece1",
                                        "glosses": [
                                            "Zerlegung eines Polygons in Dreiecke zur Ermittlung der Innenwinkelsumme"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aba64317-d3a9-41ff-96c5-ab5697043c71",
                                                "sense_id": "1c855b94-676a-3afa-a159-2a060546cb08",
                                                "text": "„Dreiecke sind diejenigen einfachen Polygone mit geringstmöglicher Eckenanzahl. Offenbar kann man in Dreiecke keine Diagonale mehr einsetzen. Ziel ist es, durch iteratives Einfügen von Diagonalen in die jeweiligen Teilpolygone eine Zerlegung in Dreiecke zu erzeugen. Solch eine Zerlegung nennt man Triangulation.“"
                                            },
                                            {
                                                "example_id": "f707d456-eef1-49d0-a735-056a71ad7148",
                                                "sense_id": "1c855b94-676a-3afa-a159-2a060546cb08",
                                                "text": "„Durch Triangulation lassen sich Vielecke in Dreiecke zerlegen (n Eck in n-2 Dreiecke)“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "348e13e2-d6d3-4991-9778-c99898cb0e3e",
                        "source_entry_id": "482aca05-c9ca-36ab-88c6-5b3c71b4294b",
