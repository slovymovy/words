                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pszczółka",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "6b5ff8ed-6afa-317e-b9d1-f1a69048d2a9",
                                        "entry_id": "4683af7b-0dec-3a64-af40-f2abd2bd8a91",
                                        "glosses": [
                                            "od: pszczoła"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1704fba5-0dac-4eb0-b22e-099b88af87fa",
                                                "sense_id": "6b5ff8ed-6afa-317e-b9d1-f1a69048d2a9",
                                                "text": "Pszczółki były patronem grupy przedszkolnej mojej córki."
                                            },
                                            {
                                                "example_id": "5b1639f9-d19a-41e5-97b6-80c1b6711b09",
                                                "sense_id": "6b5ff8ed-6afa-317e-b9d1-f1a69048d2a9",
                                                "text": "Złoto promieni słonecznych stawało się coraz czerwieńsze, pszczółki wróciły do ula, śpiew ptasząt począł milknąć"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
