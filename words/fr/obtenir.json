                        {
                            "text": "Elle espère <w>obtenir</w> une bourse pour financer ses études à l'étranger.",
                            "target_lang_translations": {
                                "en": "She hopes to <w>get</w> a scholarship to fund her studies abroad.",
                                "ru": "Она надеется <w>получить</w> стипендию для оплаты учёбы за границей.",
                                "nl": "Zij hoopt een beurs <w>te krijgen</w> om haar studie in het buitenland te financieren.",
                                "de": "Sie hofft, ein Stipendium <w>zu bekommen</w>, um ihr Studium im Ausland zu finanzieren.",
                                "pl": "Ma nadzieję <w>uzyskać</w> stypendium na sfinansowanie studiów za granicą.",
                                "it": "Lei spera di <w>ottenere</w> una borsa di studio per finanziare i suoi studi all'estero.",
                                "cs": "Doufá, že <w>získá</w> stipendium na financování studií v zahraničí.",
                                "tr": "Yurt dışındaki eğitimini finanse edebilmek için bir burs <w>almayı</w> umuyor.",
                                "es": "Ella espera <w>conseguir</w> una beca para financiar sus estudios en el extranjero.",
                                "zh": "她希望能<w>获得</w>一笔奖学金，用来资助她在国外的学业。"
                            }
                        },
                        {
                            "text": "Après plusieurs appels, il a enfin réussi à <w>obtenir</w> un rendez-vous chez le médecin.",
                            "target_lang_translations": {
                                "en": "After several calls, he finally managed to <w>get</w> an appointment with the doctor.",
                                "ru": "После нескольких звонков ему наконец удалось <w>записаться</w> на приём к врачу.",
                                "nl": "Na meerdere telefoontjes is hij er eindelijk in geslaagd om een afspraak bij de arts <w>te krijgen</w>.",
                                "de": "Nach mehreren Anrufen gelang es ihm endlich, einen Arzttermin <w>zu bekommen</w>.",
                                "pl": "Po kilku telefonach w końcu udało mu się <w>dostać</w> termin do lekarza.",
                                "it": "Dopo diverse telefonate, è riuscito finalmente a <w>ottenere</w> un appuntamento dal medico.",
                                "cs": "Po několika telefonátech se mu konečně podařilo <w>dostat</w> termín u lékaře.",
                                "tr": "Birkaç kez aradıktan sonra sonunda doktordan bir randevu <w>almayı</w> başardı.",
                                "es": "Tras varias llamadas, por fin <w>consiguió</w> una cita con el médico.",
                                "zh": "经过几次电话联系，他终于<w>得到</w>了一个看医生的预约。"
                            }
                        }
