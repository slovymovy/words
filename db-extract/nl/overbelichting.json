                                        "sense_id": "63c234d3-12f9-39ad-8e92-c005dae30201",
                                        "entry_id": "0b73f911-b9c6-3dc3-a12c-2f7bb7e8e286",
                                        "glosses": [
                                            "Alternative spelling of overillumination."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "474079ed-d08e-46d1-a96e-eddf19a601f8",
                                                "sense_id": "63c234d3-12f9-39ad-8e92-c005dae30201",
                                                "text": "Borough President Marcus M. Marks of the Borough of Manhattan, who observed the demonstration, is at present having a study made on the question of over-illumination and believes that with a lesser quantity of light, the driver of the motor car will have a better vision of the road than with over-illumination."
                                            },
                                            {
                                                "example_id": "75e4889d-a8b3-48ee-9b60-c03c97bc34e0",
                                                "sense_id": "63c234d3-12f9-39ad-8e92-c005dae30201",
                                                "text": "He had referred to the danger of over-illumination when speaking on an earlier paper in the Congress, and he felt sure that the greater use of spectacles on the other side of the Atlantic was in some measure due to the intense illumination in factories and offices, from which we in this country had been saved to some extent by the greater prevalence of older methods of lighting."
                                            },
                                            {
                                                "example_id": "5631525a-852c-45b1-9a7d-902dc9a7aae2",
                                                "sense_id": "63c234d3-12f9-39ad-8e92-c005dae30201",
                                                "text": "Usually, in conventional office buildings, over-illumination tends to occur at the perimeter of the building, causing occupants in those areas to close blinds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
