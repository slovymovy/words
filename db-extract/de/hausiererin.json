                "senses": [
                    {
                        "sense_id": "4ce3b59b-a6c9-3042-96b2-ad9073ab5f1a",
                        "entry_id": "9db8d3c1-8207-3cbe-92f3-1a76b0d5f258",
                        "glosses": [
                            "von Haus zu Haus gehende Händlerin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a327460-0c17-4eda-9a91-ac342c9fec2e",
                                "sense_id": "4ce3b59b-a6c9-3042-96b2-ad9073ab5f1a",
                                "text": "Die Hausiererin versuchte, uns eine Waschmaschine anzudrehen."
                            },
                            {
                                "example_id": "44c03a22-5b06-46ac-a218-2ca6cc2ee2ed",
                                "sense_id": "4ce3b59b-a6c9-3042-96b2-ad9073ab5f1a",
                                "text": "„Mit ihrem Bündel sah sie aus wie eine Hausiererin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19e49fcd-8eb4-4137-825c-d54aa862fefb",
