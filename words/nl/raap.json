                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging_rapen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elke herfst <w>raap</w> ik kastanjes en eikels in het bos.",
                            "target_lang_translations": {
