                        ]
                    },
                    {
                        "translation_id": "9ae0b6d3-221d-4d9d-ae81-812b3bc23487",
                        "source_entry_id": "3bb943d0-7487-3ded-a024-d22151519379",
                        "source_sense_id": "7f157472-37ad-33c9-92b4-8dfcee20a357",
