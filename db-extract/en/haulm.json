                "translations": [
                    {
                        "translation_id": "6a3cd4fe-db44-4bbe-9fb4-a91a22b42876",
                        "source_entry_id": "9807d42d-b13f-3a96-b626-63c6672fb689",
                        "source_sense_description": "stems of cultivated plants left after harvesting",
                        "target_lang_word": "stro",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stro",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f67c01d8-0a7c-3ca6-aff2-01b003d317fc",
                                        "entry_id": "a3c4c5f0-0de7-3c0d-96ce-46224371f794",
                                        "glosses": [
                                            "droge bloeistengels van graangewassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db1c649e-c726-45a0-9bae-355b14615111",
                                                "sense_id": "f67c01d8-0a7c-3ca6-aff2-01b003d317fc",
                                                "text": "' Nella kijkt naar de hoek van de cel, waar pasgeboren muizen in het stro ritselen en blindelings over de andere vertrouwde lijfjes in het nestje krioelen."
                                            },
                                            {
                                                "example_id": "802b0b96-49af-4eea-9f46-c03c818d40ed",
                                                "sense_id": "f67c01d8-0a7c-3ca6-aff2-01b003d317fc",
                                                "text": "Iedere avond sloop hij stilletjes naar de stal, rolde zich in een paardedeken en sliep lekker in het stro."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0475e4ea-99bf-4fb6-b46b-759cef033277",
                        "source_entry_id": "9807d42d-b13f-3a96-b626-63c6672fb689",
                        "source_sense_description": "stems of cultivated plants left after harvesting",
                        "target_lang_word": "Stroh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stroh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a98ed13-6aa3-30c3-b09e-8a3f3bde76fb",
                                        "entry_id": "b5cbfeeb-256b-3b43-b94d-60706ac8d242",
                                        "glosses": [
                                            "abgedroschene Getreidehalme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f756cf7-b8b7-4ad6-b3a5-8a9c0c4ab6f0",
                                                "sense_id": "0a98ed13-6aa3-30c3-b09e-8a3f3bde76fb",
                                                "text": "Da liegt es, das Kindlein, auf Heu und auf Stroh - (Weihnachtslied)"
                                            },
                                            {
                                                "example_id": "49f571b3-abd6-417c-89ba-55bbc61c118e",
                                                "sense_id": "0a98ed13-6aa3-30c3-b09e-8a3f3bde76fb",
                                                "text": "„Er hatte keinen Blick mehr für die Gehöfte zu beiden Seiten der Dorfstraße, für die mit Stroh gedeckten Stallungen, die Lindenbäume, die in unregelmäßigen Abständen den Weg säumten.“"
                                            },
                                            {
                                                "example_id": "744da2ff-90d8-4d22-80a0-b69ce081a50e",
                                                "sense_id": "0a98ed13-6aa3-30c3-b09e-8a3f3bde76fb",
                                                "text": "„Andere lassen ihre Tiere stundenlang über das auf einem runden Platz zusammengetragene Getreide trampeln, während sie das Stroh immer wieder mit der aus einer Astgabel geschnitzten Forke in die Luft werfen.“"
                                            },
                                            {
                                                "example_id": "625dbe3a-7fba-4c85-8052-66ac1c47f7e3",
                                                "sense_id": "0a98ed13-6aa3-30c3-b09e-8a3f3bde76fb",
                                                "text": "„Der überdachte Teil des Lastwagens war mit Stroh ausgelegt.“"
                                            },
                                            {
                                                "example_id": "5a42decd-5f50-4197-a76f-caf8cd760692",
                                                "sense_id": "0a98ed13-6aa3-30c3-b09e-8a3f3bde76fb",
                                                "text": "„Die Landstraße führt zuerst durch Olivenhaine, gelbes Stroh liegt zwischen den Bäumen und Steinmauern, Straßenkatzen und -hunde streunen umher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e083fd77-4161-4b52-9bb7-c0bbfefca3dd",
                        "source_entry_id": "9807d42d-b13f-3a96-b626-63c6672fb689",
                        "source_sense_description": "stems of cultivated plants left after harvesting",
                        "target_lang_word": "соло́ма",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "соло́ма",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dda91106-0d32-340f-8000-be0ca1749b29",
                                        "entry_id": "2c1408f1-6880-351b-b780-0153854f0949",
                                        "glosses": [
                                            "стебли хлебных злаков без зерен, остающиеся после обмолота"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73b43a48-ffeb-401d-b13c-1cd1c93ce098",
                                                "sense_id": "dda91106-0d32-340f-8000-be0ca1749b29",
                                                "text": "Кое-где во дворах молотили, пахло ржаною соломой."
                                            },
                                            {
                                                "example_id": "c342680e-fd8f-4504-b19b-ada87635a1db",
                                                "sense_id": "dda91106-0d32-340f-8000-be0ca1749b29",
                                                "text": "У ворот увидел я старую чугунную пушку; улицы были тесны и кривы; избы низки и большею частию покрыты соломою."
                                            },
                                            {
                                                "example_id": "099fc736-6a05-4300-a4e6-ff912e620028",
                                                "sense_id": "dda91106-0d32-340f-8000-be0ca1749b29",
                                                "text": "Иногда это уважение невыгодно для меня: в нынешнем году у нас урожай трав и ярового очень плох, уже с осени было видно, что корму будет недостаточно и придется пустить в корм ржаную солому, вследствие чего не хватит подстилки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
