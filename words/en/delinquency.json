{
    "word_family": [
        "delinquent"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f520fae-46a7-3e2e-8c13-8087b9a1c008",
                    "sense_definition": "Minor crime or antisocial behavior, especially that committed by young people.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "misconduct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school implemented new programs to address the rising rates of juvenile <w>delinquency</w> among students.",
                            "target_lang_translations": {
                                "ru": "Школа внедрила новые программы для борьбы с ростом подростковой <w>преступности</w> среди учащихся."
                            }
                        },
                        {
                            "text": "Parents were concerned that the lack of supervision would lead their children into <w>delinquency</w>.",
                            "target_lang_translations": {
                                "ru": "Родители беспокоились, что отсутствие присмотра подтолкнет их детей к <w>правонарушениям</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "misconduct",
                        "misbehavior"
                    ],
                    "common_phrases": [
                        "juvenile delinquency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незначительное правонарушение или антиобщественное поведение, особенно совершаемое молодыми людьми или подростками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правонарушение",
                                "target_lang_sense_clarification": "незначительное противоправное деяние"
                            },
                            {
                                "target_lang_word": "проступок",
                                "target_lang_sense_clarification": "нарушение правил или норм поведения"
                            },
                            {
                                "target_lang_word": "преступность",
                                "target_lang_sense_clarification": "обычно в контексте малолетней или подростковой преступности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "232b0f6e-1e44-3de5-9c1c-8aec9dbc2aa6",
                    "sense_definition": "A criminal offense or failure to fulfill a duty.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "misconduct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report documented every <w>delinquency</w> committed by the official during his time in office.",
                            "target_lang_translations": {
                                "ru": "В отчете был задокументирован каждый <w>проступок</w>, совершенный чиновником за время пребывания в должности."
                            }
                        },
                        {
                            "text": "He was fired for his repeated <w>delinquency</w> in completing his assigned tasks on time.",
                            "target_lang_translations": {
                                "ru": "Его уволили за постоянную <w>халатность</w> и неспособность вовремя выполнять поставленные задачи."
                            }
                        }
                    ],
                    "synonyms": [
                        "offense",
                        "neglect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Правонарушение, преступление или невыполнение своих прямых обязанностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проступок",
                                "target_lang_sense_clarification": "нарушение служебных или этических обязанностей"
                            },
                            {
                                "target_lang_word": "халатность",
                                "target_lang_sense_clarification": "недобросовестное выполнение долга или обязанностей"
                            },
                            {
                                "target_lang_word": "правонарушение",
                                "target_lang_sense_clarification": "нарушение закона или регламента"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6be04360-1df8-35e8-a07e-c1d229b733f1",
                    "sense_definition": "The state of being late in paying a debt or fulfilling a financial obligation.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank sent a notice regarding the <w>delinquency</w> on his mortgage payments.",
                            "target_lang_translations": {
                                "ru": "Банк направил уведомление о <w>просрочке</w> платежей по его ипотеке."
                            }
                        },
                        {
                            "text": "High interest rates have caused a significant increase in loan <w>delinquency</w> across the country.",
                            "target_lang_translations": {
                                "ru": "Высокие процентные ставки вызвали значительный рост <w>просроченной задолженности</w> по кредитам по всей стране."
                            }
                        }
                    ],
                    "synonyms": [
                        "arrears",
                        "default"
                    ],
                    "common_phrases": [
                        "loan delinquency",
                        "mortgage delinquency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задержка выплат по долгу или несвоевременное выполнение финансовых обязательств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просрочка",
                                "target_lang_sense_clarification": "нарушение сроков платежа"
                            },
                            {
                                "target_lang_word": "задолженность",
                                "target_lang_sense_clarification": "неуплаченный вовремя долг"
                            },
                            {
                                "target_lang_word": "просроченный долг",
                                "target_lang_sense_clarification": "долг с истекшим сроком оплаты"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}