                            {
                                "example_id": "4e339603-41b9-4b94-be1d-32aa72f26bbe",
                                "sense_id": "2c2ebcbd-06f4-3c35-a3a1-aff0dd8a3907",
                                "text": "Mais ça s’est bien passé, c’était la neuille, c’est plus franco qu’au soleil…"
                            },
                            {
                                "example_id": "5ab4b47b-3f8f-495a-9bab-2971904e76a1",
                                "sense_id": "2c2ebcbd-06f4-3c35-a3a1-aff0dd8a3907",
                                "text": "Les copains d’la neuille\nLes frangins d’la night\nCeux qu’ont l’portefeuille\nPlus ou moins all right"
                            },
                            {
                                "example_id": "92cc2bd9-a7fa-431c-b2a6-69f898ddb4d5",
                                "sense_id": "2c2ebcbd-06f4-3c35-a3a1-aff0dd8a3907",
                                "text": "Il a cauchemardé toute la neuille, à se tourner et retourner dans le pajot."
                            }
                        ]
