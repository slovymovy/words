                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43bbafc2-6dfd-41bc-88ab-33be0c1bca68",
                                "sense_id": "48be717a-2981-3646-b4a0-47dd27805387",
                                "text": "Изюминку цветникам придавал особый подбор растений: они контрастировали меж собой по форме и размерам цветков и листьев, по габитусу."
                            }
                        ]
