                        "entry_id": "68055794-329f-313e-8e01-cd290b6e6899",
                        "glosses": [
                            "właściwy psychozie, charakteryzujący się psychozą"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdbca7e9-97d9-4e50-afee-5fe9f2b57db5",
                        "source_entry_id": "68055794-329f-313e-8e01-cd290b6e6899",
                        "source_sense_id": "24d9b0dd-6562-33f0-a275-fc3ce9763dd7",
                        "target_lang_word": "psychotic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d45dbd4-1251-3e5d-95c6-7a52250c8e04",
                                        "entry_id": "ee6b7f7e-5373-3378-9c6f-b42f73a0ad0a",
                                        "glosses": [
                                            "Of, related to, or suffering from psychosis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "049b0390-d0e0-49e8-b3dc-4eea6bb88fbb",
                                                "sense_id": "0d45dbd4-1251-3e5d-95c6-7a52250c8e04",
                                                "text": "Direct evidence on psychotic behavior is the presence of either delusions or hallucinations (without insight into their pathological nature)."
                                            },
                                            {
                                                "example_id": "101927af-cc9f-409d-9044-8be0ca7fbc06",
                                                "sense_id": "0d45dbd4-1251-3e5d-95c6-7a52250c8e04",
                                                "text": "Increasing data suggests that regular marijuana use in adolescence may also be a risk factor for developing very serious psychotic disorders, especially schizophrenia."
                                            },
                                            {
                                                "example_id": "d47698e3-69cd-4baf-abca-ad72e3a58c63",
                                                "sense_id": "0d45dbd4-1251-3e5d-95c6-7a52250c8e04",
                                                "text": "She suffered psychotic episodes during which she believed herself to be spied upon by light bulbs."
                                            },
                                            {
                                                "example_id": "2ee3c15b-af07-493a-9a1f-999091df1171",
                                                "sense_id": "0d45dbd4-1251-3e5d-95c6-7a52250c8e04",
                                                "text": "She couldn't possibly know that I was parking in the same spot to visit my psychotic wife on the third floor of the hospital, the floor that needed a special elevator for access."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faae1411-d39f-31fa-8b6e-aca98901e312",
                                        "entry_id": "ee6b7f7e-5373-3378-9c6f-b42f73a0ad0a",
                                        "glosses": [
                                            "Out of control, bizarre, or crazy."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c14dbfc1-f481-407d-9905-ea83cb9aab1a",
                                                "sense_id": "faae1411-d39f-31fa-8b6e-aca98901e312",
                                                "text": "Full-bodied tribal rhythms, weird bendy bass lines, screechy high-end guitar melodies, and more psychotic lyrics about \"Tension,\" \"Butchers,\" and \"Madness.\""
                                            },
                                            {
                                                "example_id": "a375649e-d143-4df3-9a55-e583183f34b9",
                                                "sense_id": "faae1411-d39f-31fa-8b6e-aca98901e312",
                                                "text": "This had left the mother feeling \"psychotic\" and \"helpless\" because she could not change the family, the school, and society that she said had all caused the son harm."
                                            },
                                            {
                                                "example_id": "86d88025-b3f4-418c-a6f1-2ff6067eb3bd",
                                                "sense_id": "faae1411-d39f-31fa-8b6e-aca98901e312",
                                                "text": "And if you ever try to record one of our conversations again, I'll set the dogs on you and your psychotic friends, and let them tear you all apart."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "psychotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cad9ed5-c1e0-3f2f-aed8-8b7b52de9627",
                                        "entry_id": "c5a7ff53-b1f4-3b5d-be08-2a3a5ec07a06",
                                        "glosses": [
                                            "A person affected by psychosis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "045bbb17-ce3f-41b0-8b9d-02ba22c10361",
                        "source_entry_id": "68055794-329f-313e-8e01-cd290b6e6899",
                        "source_sense_id": "24d9b0dd-6562-33f0-a275-fc3ce9763dd7",
                        "target_lang_word": "psychotique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychotique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1aae285d-86e1-3ff1-9459-78aa52d7a846",
                                        "entry_id": "8b9800bf-ec70-3c1a-aa66-db45a14b1513",
                                        "glosses": [
                                            "Relatif à la psychose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f8f221d-879d-4d64-97ca-4e91c9c62752",
                                                "sense_id": "1aae285d-86e1-3ff1-9459-78aa52d7a846",
                                                "text": "Les psychoses sont un ensemble de psychopathologies caractérisées par l'existence d'épisodes psychotiques : idées délirantes, hallucinations, etc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "psychotique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f80245f-320a-34aa-89bc-345bcd931a1e",
                                        "entry_id": "6ead8d5a-25d2-39b1-bd8d-b2748674c81e",
                                        "glosses": [
                                            "Personne souffrant de psychose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f88b06ae-1a14-48fd-ab81-4722e3f74beb",
                                                "sense_id": "7f80245f-320a-34aa-89bc-345bcd931a1e",
                                                "text": "Il survient aussi des moments où un psychotique semble cesser d’être « fou »."
                                            },
                                            {
                                                "example_id": "211e5bbb-0bb0-4119-af7d-ecdbf3b4a129",
                                                "sense_id": "7f80245f-320a-34aa-89bc-345bcd931a1e",
                                                "text": "Dans les rituels magiques des psychotiques, nous sommes en présence d'une ritualité d'un autre ordre. Les rituels des psychotiques ont souvent des fonctions de protection contre les hallucinations. L'oreille coupée de Van Gogh est probablement l'effet d'un rituel qui devait le protéger contre des hallucinations auditives."
                                            },
                                            {
                                                "example_id": "e3ce88ba-a9d0-4cf1-90f9-2cdb63ceb042",
                                                "sense_id": "7f80245f-320a-34aa-89bc-345bcd931a1e",
                                                "text": "Ce ne sont pas des psychotiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24c6c600-6280-4fcf-aab1-976919d4cca2",
                        "source_entry_id": "68055794-329f-313e-8e01-cd290b6e6899",
