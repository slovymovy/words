    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "38ca6a17-4a38-30f3-a180-617d7f7f4b00",
                "word": "gingham",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "94f74ae1-3b3a-419c-bf0c-9cae1c395a83",
                        "entry_id": "38ca6a17-4a38-30f3-a180-617d7f7f4b00",
                        "tags": [
                            "plural"
                        ],
                        "form": "ginghams"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d1acaef-84ce-35e3-b413-18b9e7fa19a3",
                        "entry_id": "38ca6a17-4a38-30f3-a180-617d7f7f4b00",
                        "glosses": [
                            "A cotton fabric made from dyed and white yarn woven in checks."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d1cd4ed1-429d-4dc8-9d56-f1462dff7c45",
                                "sense_id": "5d1acaef-84ce-35e3-b413-18b9e7fa19a3",
                                "text": "And she found that she was not wearing a despised muslin frock! Her dress was gingham!—an adorable plaid with long sleeves, and a patch-pocket low down on the right side!"
                            },
                            {
                                "example_id": "be9bf87e-dbfd-4700-aa41-6b034b98c366",
                                "sense_id": "5d1acaef-84ce-35e3-b413-18b9e7fa19a3",
                                "text": "Aunt Elizabeth had produced a terrible gingham apron and an equally terrible gingham sunbonnet from somewhere in the New Moon garret, and made Emily put them on. The apron was a long sack-like garment, high in the neck, with sleeves."
                            },
                            {
                                "example_id": "13f0d6fb-f39f-43d1-935b-f5d7e6f38da9",
                                "sense_id": "5d1acaef-84ce-35e3-b413-18b9e7fa19a3",
                                "text": "Always, the relentless bass of hip-hop blasting in rooms of nautical-themed furnishings, faded driftwood, gingham upholstery, linen and chambray."
                            },
                            {
                                "example_id": "4fbd86fe-0a3b-4854-9db5-fddd0406ac7d",
                                "sense_id": "5d1acaef-84ce-35e3-b413-18b9e7fa19a3",
                                "text": "Tradwifedom, the meekly old-fashioned vision of domesticity served up on Instagram by a bunch of submissive influencers in aprons, is a gingham-lined trap visible from space […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "d080c25c-0403-399a-b717-8129460d4d0f",
                        "entry_id": "38ca6a17-4a38-30f3-a180-617d7f7f4b00",
                        "glosses": [
                            "A dress made from that material."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "49305f88-3d98-4eed-b6ea-020304e1216d",
                                "sense_id": "d080c25c-0403-399a-b717-8129460d4d0f",
                                "text": "\"We have put on the pale blue silks that we wore at Isabella's wedding; that, however, was Georgiana's thought,\" continued Helen; \"she said it would be impossible to go to church in our pink ginghams.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "65b57ee5-7cc0-3c2d-9226-15588b3e4ba6",
                        "entry_id": "38ca6a17-4a38-30f3-a180-617d7f7f4b00",
                        "glosses": [
                            "An umbrella."
                        ],
                        "tags": [
                            "UK",
                            "archaic",
                            "countable",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "82861570-6fbf-4af7-b1a0-24232769711d",
                                "sense_id": "65b57ee5-7cc0-3c2d-9226-15588b3e4ba6",
                                "text": "[…] their ginghams stuck under their arms at right angles to their back-bones […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a5f23ee-0852-467c-abd1-fa408e67e514",
                        "source_entry_id": "38ca6a17-4a38-30f3-a180-617d7f7f4b00",
                        "source_sense_description": "a cotton fabric made from dyed and white yarn woven in checks",
                        "target_lang_word": "vichy",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vichy",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ce557f9-d43b-374c-b16a-292ef25c04d8",
                                        "entry_id": "4155d25f-af00-346e-8c1a-3143548d4c35",
                                        "glosses": [
                                            "Sorte de toile de coton à petits carreaux de couleur sur fond blanc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44eb4312-f1ed-44a0-a0ea-731b958ae649",
                                                "sense_id": "5ce557f9-d43b-374c-b16a-292ef25c04d8",
                                                "text": "Ça l’amusait plutôt, Aimery, de vivre dans une image, avec des petits rideaux de vichy blanc et bleu."
                                            },
                                            {
                                                "example_id": "1f6111be-0cc0-43a2-8db4-20c106e99e96",
                                                "sense_id": "5ce557f9-d43b-374c-b16a-292ef25c04d8",
                                                "text": "Ses cuisse disparaissaient sous sa robe en vichy."
                                            },
                                            {
                                                "example_id": "333c24cc-f0d1-46ad-adde-365a668bf13f",
                                                "sense_id": "5ce557f9-d43b-374c-b16a-292ef25c04d8",
                                                "text": "Je me souviens […] de la nappe vichy et des cercles grenat qu'y dessinaient nos verres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "898b5533-3ceb-3be0-ba8d-2ab6178510a5",
                                        "entry_id": "4155d25f-af00-346e-8c1a-3143548d4c35",
                                        "glosses": [
                                            "Tout type de toile et tissu qui dispose du même motif."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fed782af-11d3-453c-8ac1-f81fc4e2c609",
                                                "sense_id": "898b5533-3ceb-3be0-ba8d-2ab6178510a5",
                                                "text": "À ma gauche : en vichy rose des pieds à la tête, baskets et socquettes blanches, un mètre soixante de haut sur la pointe des pieds, soixante ans, couettes blondes à la Brigitte Bardot, dont elle a le total look d'ailleurs : Lucette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b47b8b9a-34a9-3f1c-9a57-80e4d8c11317",
                                        "entry_id": "4155d25f-af00-346e-8c1a-3143548d4c35",
                                        "glosses": [
                                            "Verre d’eau de Vichy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c89ffc27-e29f-449d-ae94-eab367eabec1",
                                                "sense_id": "b47b8b9a-34a9-3f1c-9a57-80e4d8c11317",
                                                "text": "« Qu'est-ce que tu prends ?\n− Un vichy.\n− Pourquoi toujours du vichy ?\n− À cause du foie, expliqua-t-elle d'un air triste. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vichy",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b2110fe-dbd7-3110-9c0e-55dddcb57a13",
                                        "entry_id": "4a3db9c7-90aa-3ace-8dac-56357f019cc8",
                                        "glosses": [
                                            "Eau de Vichy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1b44a84-7969-4c94-a3f8-56a5f8028248",
                                                "sense_id": "7b2110fe-dbd7-3110-9c0e-55dddcb57a13",
                                                "text": "Une vichy Célestins."
                                            },
                                            {
                                                "example_id": "97caf79e-cc26-4fa1-b3f2-e3b2877cf82a",
                                                "sense_id": "7b2110fe-dbd7-3110-9c0e-55dddcb57a13",
                                                "text": "Ces messieurs étaient attablés autour de vichy-fraise et de vittel-cassis, innocents breuvages qui, […], jouissent d'une rassurante vertu, laissant le cerveau lucide quand on se voit obligé de boire souvent et qu'on ne veut pas courir le risque de s'enivrer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
