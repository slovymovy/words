                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modesto",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "141b5356-7534-3c87-8945-f619ce534210",
                                        "entry_id": "6b0d7b92-c090-3f1f-9802-26dca8a7518f",
                                        "glosses": [
                                            "Que tiene modestia."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb5bff49-fdb5-347d-a025-e985726527ff",
                                        "entry_id": "6b0d7b92-c090-3f1f-9802-26dca8a7518f",
                                        "glosses": [
                                            "Sencillo, sin extravagancias."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79b55092-22f1-42ad-9769-f2026016f5b1",
                                                "sense_id": "bb5bff49-fdb5-347d-a025-e985726527ff",
                                                "text": "El primero de los dos iba vestido con una falda de lana, una manteleta y un gorro bordado. El otro debía de ser un marinero o un ciervo, porque su aspecto era más modesto."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6af1d94-c0c7-4baa-ad8e-7fafcb00dd9f",
                        "source_entry_id": "aaa6d56d-5125-3aab-9a6a-510ba72bf302",
                        "source_sense_id": "95194713-15a8-3af9-b1e0-76d23c457531",
                        "target_lang_word": "Bescheidene",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "73935835-c87a-48db-bfa5-c5908bffc7fd",
                        "source_entry_id": "aaa6d56d-5125-3aab-9a6a-510ba72bf302",
                        "source_sense_id": "95194713-15a8-3af9-b1e0-76d23c457531",
                        "target_lang_word": "modeste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modeste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "489c0224-3ff0-3389-898a-2088c77f3412",
                                        "entry_id": "bac700a0-20b1-3d12-a76d-b8c03e1398ac",
                                        "glosses": [
                                            "Qui a de la retenue, de la modération, qui ne donne dans aucun excès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46f5d8b2-a824-4354-9ca1-d5aadca394f1",
                                                "sense_id": "489c0224-3ff0-3389-898a-2088c77f3412",
                                                "text": "Il est modeste dans sa dépense, dans toute sa conduite. Par extension,"
                                            },
                                            {
                                                "example_id": "f312627c-3e62-4888-978f-ef51fdce3fc2",
                                                "sense_id": "489c0224-3ff0-3389-898a-2088c77f3412",
                                                "text": "Former des vœux modestes."
                                            },
                                            {
                                                "example_id": "3eb86f93-6580-41dc-a64c-392008ae93f1",
                                                "sense_id": "489c0224-3ff0-3389-898a-2088c77f3412",
                                                "text": "Avoir des ambitions, des goûts modestes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84d4d47f-54dd-3dd9-95d4-ab01417674d8",
                                        "entry_id": "bac700a0-20b1-3d12-a76d-b8c03e1398ac",
                                        "glosses": [
                                            "Qui est modéré, simple, sans éclat, en parlant d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f132b44e-e3a1-4bb5-9292-2a370e25d876",
                                                "sense_id": "84d4d47f-54dd-3dd9-95d4-ab01417674d8",
                                                "text": "Or, la modicité des sommes en cause ne fait-elle pas obstacle à la qualification de libéralité ? Ce caractère modeste est bien sûr relatif car tributaire des ressources de chacun, mais la modicité des sommes en cause reste avant tout un élément de définition de l’argent de poche."
                                            },
                                            {
                                                "example_id": "e146393a-ffb8-4600-b666-82d2e639fd36",
                                                "sense_id": "84d4d47f-54dd-3dd9-95d4-ab01417674d8",
                                                "text": "Je suis un petit V.R.P. Avec mes modestes semblables, je hante de modestes hôtels incroyables de cambrousse, à Ciron, à Scoury, à Migné et j'en passe !"
                                            },
                                            {
                                                "example_id": "cae7e099-7d4d-40b8-8133-b00afa0964b7",
                                                "sense_id": "84d4d47f-54dd-3dd9-95d4-ab01417674d8",
                                                "text": "Modestes cayennes en bordure d'un chenal ou villages sauniers autour d’un ruisson, l’habitat dispersé correspondait aux villages de gens de mer."
                                            },
                                            {
                                                "example_id": "349b5117-05af-4fa4-9cfa-20caca4cdf4c",
                                                "sense_id": "84d4d47f-54dd-3dd9-95d4-ab01417674d8",
                                                "text": "L’utopie n’a toutefois pas forcément besoin de se parer des guirlandes lumineuses des grands lendemains qui chantent, elle peut se pencher sur un registre plus modeste, celui de l’intime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba7da6d0-8818-33c4-83a4-5e3f6c1d3b60",
                                        "entry_id": "bac700a0-20b1-3d12-a76d-b8c03e1398ac",
                                        "glosses": [
                                            "Subalterne."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fd8a339-6394-46e1-97c6-7e2dde343c60",
                                                "sense_id": "ba7da6d0-8818-33c4-83a4-5e3f6c1d3b60",
                                                "text": "J'ai rencontré, parmi mes camarades de réserve, de hauts fonctionnaires, des chefs de grandes entreprises privées. Tous , comme moi, s’effaraient d’être contraints à des besognes paperassières que, dans le civil, ils auraient abandonnées aux plus modestes de leurs sous-ordres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8d6079c-fda3-320c-a71d-81befc48a07b",
                                        "entry_id": "bac700a0-20b1-3d12-a76d-b8c03e1398ac",
                                        "glosses": [
                                            "Qui est réservé dans la manière de penser et de parler de soi, qui a une opinion modérée de son mérite, humble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49d1bdcc-aef2-449c-b0b0-fc3159d861b1",
                                                "sense_id": "c8d6079c-fda3-320c-a71d-81befc48a07b",
                                                "text": "On se précipitait avec ardeur vers les jouissances matérielles : […]. Les hommes utiles et modestes vivaient dans l’oubli, tandis que les histrions et les courtisanes attiraient les regards."
                                            },
                                            {
                                                "example_id": "29acbd84-3b46-42f7-97a8-1eef5c216526",
                                                "sense_id": "c8d6079c-fda3-320c-a71d-81befc48a07b",
                                                "text": "Il y a 100 ans cette année, un modeste commis aux brevets de Berne, en Suisse, publiait les principaux éléments de sa théorie dite de la relativité."
                                            },
                                            {
                                                "example_id": "e326d24f-1e3c-4f0c-9ff3-9cb665bfc0a5",
                                                "sense_id": "c8d6079c-fda3-320c-a71d-81befc48a07b",
                                                "text": "Avoir un maintien modeste, une contenance modeste, un air modeste, un ton modeste."
                                            },
                                            {
                                                "example_id": "ba2b21dc-b84c-47e0-ade4-9937290ad693",
                                                "sense_id": "c8d6079c-fda3-320c-a71d-81befc48a07b",
                                                "text": "Garder un silence modeste. — Avoir une opinion modeste de soi-même."
                                            },
                                            {
                                                "example_id": "60dbe64c-1058-47f0-b63d-6adb81695efc",
                                                "sense_id": "c8d6079c-fda3-320c-a71d-81befc48a07b",
                                                "text": "Substantivement: Faire le modeste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10a72c66-4b74-31d5-977d-1d0e657b9823",
                                        "entry_id": "bac700a0-20b1-3d12-a76d-b8c03e1398ac",
                                        "glosses": [
                                            "Petit en taille ou en valeur, peu nombreux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a91f3a9-7fe2-485e-9d67-47f753ebebad",
                                                "sense_id": "10a72c66-4b74-31d5-977d-1d0e657b9823",
                                                "text": "M. Hippolyte Brichet était ferronnier à Levrézy avant d'installer une modeste pension pour les ouvriers qui lui laissait le temps de s'adonner à un petit commerce de quincaillerie pour une clientèle strictement locale."
                                            },
                                            {
                                                "example_id": "872166bc-f759-49c4-9c85-28ead33abe62",
                                                "sense_id": "10a72c66-4b74-31d5-977d-1d0e657b9823",
                                                "text": "Pour des valeurs modestes de n′, disons n′ < 50, le calcul exhaustif des probabilités binomiales reste abordable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c4c6a99-5f75-3b25-a98f-3e729913c87c",
                                        "entry_id": "bac700a0-20b1-3d12-a76d-b8c03e1398ac",
                                        "glosses": [
                                            "Qui a de la pudeur, qui observe la décence, en parlant des personnes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "823940f0-6c47-4940-afc3-3eb106010be7",
                                                "sense_id": "4c4c6a99-5f75-3b25-a98f-3e729913c87c",
                                                "text": "Une jeune fille modeste."
                                            }
                                        ]
                                    }
                                ]
                            },
