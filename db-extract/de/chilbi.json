                "senses": [
                    {
                        "sense_id": "332d5789-42b7-3b8f-9d04-b467aa8b8339",
                        "entry_id": "7c8f6e2f-35b1-369f-a0f3-e4664deb9951",
                        "glosses": [
                            "jährliches Gedächtnisfest der Weihe einer Kirche"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "7e40efa4-baec-4a6a-b0d8-48b12c1e8f08",
                                "sense_id": "332d5789-42b7-3b8f-9d04-b467aa8b8339",
                                "text": "„Zieger und Honig waren auch herkömmliche Speise an den Chilbenen (Kirchweihen) des Luzernerbiets.“"
                            },
                            {
                                "example_id": "bc4ec8e7-6e9b-4001-bcc5-054155874a85",
                                "sense_id": "332d5789-42b7-3b8f-9d04-b467aa8b8339",
                                "text": "„In die Herbstzeit fallen auch die Chilbenen, die Kirchweihfeste. Besonders in der Innerschweiz reiht sich eine an die andere. Im Wallis haben sie noch am ehesten den kirchlichen Charakter behalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6b259b65-85cb-3161-ae3b-5f1ba59f5e8d",
                        "entry_id": "7c8f6e2f-35b1-369f-a0f3-e4664deb9951",
                        "glosses": [
                            "weltliches, auf einem Rummelplatz stattfindendes Volksfest, Kirchweih, Jahrmarkt"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "6f5a059c-962f-4abc-a947-c289ecfb7227",
                                "sense_id": "6b259b65-85cb-3161-ae3b-5f1ba59f5e8d",
                                "text": "„In die Herbstzeit fallen auch die Chilbenen, die Kirchweihfeste. Besonders in der Innerschweiz reiht sich eine an die andere. Im Wallis haben sie noch am ehesten den kirchlichen Charakter behalten.“"
                            },
                            {
                                "example_id": "f3883fca-2ab9-4a47-9be4-abd4dd1a996d",
                                "sense_id": "6b259b65-85cb-3161-ae3b-5f1ba59f5e8d",
                                "text": "„Für viele Besucher war die Chilbi die Hauptattraktion des Zürcher Knabenschiessens.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
