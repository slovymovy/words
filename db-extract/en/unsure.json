                "senses": [
                    {
                        "sense_id": "8854d9e9-3fd1-35fd-9fcd-3d69d81363a6",
                        "entry_id": "4aef0299-6598-343f-a5e7-403db306d657",
                        "glosses": [
                            "uncertain, ambivalent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "483090c3-af7e-4a52-92fa-59904f3d3aeb",
                                "sense_id": "8854d9e9-3fd1-35fd-9fcd-3d69d81363a6",
                                "text": "I'm still unsure whether to attend the wedding."
                            }
                        ]
                    },
                    {
                        "sense_id": "72c218e9-74d4-3001-8c9f-c2ce0e113cd1",
                        "entry_id": "4aef0299-6598-343f-a5e7-403db306d657",
                        "glosses": [
                            "unstable or precarious"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c01f5c0b-e02c-434e-8520-f249422d8c4a",
                                "sense_id": "72c218e9-74d4-3001-8c9f-c2ce0e113cd1",
                                "text": "unsure footing"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab15cf32-2225-4740-8200-d71124b61168",
                        "source_entry_id": "4aef0299-6598-343f-a5e7-403db306d657",
                        "source_sense_description": "uncertain",
                        "target_lang_word": "incertain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incertain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e1b5631-3001-3775-9eba-b953100ebe75",
                                        "entry_id": "17586961-d9dd-34e6-8827-c35540634c6c",
                                        "glosses": [
                                            "Qui n’est pas certain, pas assuré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "079ff1e5-c501-4fa1-8a9e-565cd625cde2",
                                                "sense_id": "8e1b5631-3001-3775-9eba-b953100ebe75",
                                                "text": "Je semble défier la mort et pourtant je ne peux protéger les corps meurtris. Les soldats vont encore être obligés de faire des sacrifices pour un résultat plus qu’incertain, probablement un échec."
                                            },
                                            {
                                                "example_id": "35d514ed-a6c2-4856-ad01-658b64a854a9",
                                                "sense_id": "8e1b5631-3001-3775-9eba-b953100ebe75",
                                                "text": "La victoire fut longtemps incertaine."
                                            },
                                            {
                                                "example_id": "dd7ffd69-260b-4338-a256-2f6557012f57",
                                                "sense_id": "8e1b5631-3001-3775-9eba-b953100ebe75",
                                                "text": "Nouvelle incertaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c3beb1d-2450-3b73-8d65-8702269d3cba",
                                        "entry_id": "17586961-d9dd-34e6-8827-c35540634c6c",
                                        "glosses": [
                                            "Qui n’est pas fixé, pas déterminé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b69456db-8339-4681-abd0-dea26adba9e0",
                                                "sense_id": "4c3beb1d-2450-3b73-8d65-8702269d3cba",
                                                "text": "L’heure de la mort est incertaine."
                                            },
                                            {
                                                "example_id": "3d72403d-c364-449b-a006-869477367060",
                                                "sense_id": "4c3beb1d-2450-3b73-8d65-8702269d3cba",
                                                "text": "à une époque incertaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c17b676-d25c-3f75-9d92-e3264fa9deaa",
                                        "entry_id": "17586961-d9dd-34e6-8827-c35540634c6c",
                                        "glosses": [
                                            "Qui est variable, mal assuré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "801b09eb-7ed9-44cf-a0dc-65898fb125ed",
                                                "sense_id": "1c17b676-d25c-3f75-9d92-e3264fa9deaa",
                                                "text": "Mais tous font état d'un système d'une complexité inouïe. Dans les faits, sa mise en œuvre se révèle coûteuse, incertaine, voire même ubuesque."
                                            },
                                            {
                                                "example_id": "f4e55cf9-3d59-469d-91fd-11e50e0b32b4",
                                                "sense_id": "1c17b676-d25c-3f75-9d92-e3264fa9deaa",
                                                "text": "Le temps est bien incertain."
                                            },
                                            {
                                                "example_id": "fb67a929-2c44-40d0-a7d5-2bb4e69061db",
                                                "sense_id": "1c17b676-d25c-3f75-9d92-e3264fa9deaa",
                                                "text": "Le succès de cette entreprise resta longtemps incertain."
                                            },
                                            {
                                                "example_id": "83b5d84c-2051-4220-b257-b9a9fca2cc64",
                                                "sense_id": "1c17b676-d25c-3f75-9d92-e3264fa9deaa",
                                                "text": "Il répond d’un ton incertain, avec une voix mal assurée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0cc6fae-584c-39a5-b2ce-8f290310b494",
                                        "entry_id": "17586961-d9dd-34e6-8827-c35540634c6c",
                                        "glosses": [
                                            "Qui n’a pas une forme ou une nature bien arrêtée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85d83b8f-ef49-41bd-9bcd-cae5e502f7e4",
                                                "sense_id": "d0cc6fae-584c-39a5-b2ce-8f290310b494",
                                                "text": "Cette panoplie de données objectives et quantifiées permet de dépasser largement l’approche intuitive, pifométrique et incertaine qui reste la plus souvent celle de la psychologie historique."
                                            },
                                            {
                                                "example_id": "83cea0d3-e486-481c-8b36-00ed0157086b",
                                                "sense_id": "d0cc6fae-584c-39a5-b2ce-8f290310b494",
                                                "text": "Une démarche incertaine."
                                            },
                                            {
                                                "example_id": "2b117ca9-09d2-40c7-8488-078f396c72d9",
                                                "sense_id": "d0cc6fae-584c-39a5-b2ce-8f290310b494",
                                                "text": "Des mouvements incertains."
                                            },
                                            {
                                                "example_id": "a3e9da0d-264f-450b-a3d9-0104a138f4d3",
                                                "sense_id": "d0cc6fae-584c-39a5-b2ce-8f290310b494",
                                                "text": "Une lueur incertaine."
                                            },
                                            {
                                                "example_id": "c01dea7d-ebad-4d2e-9b0e-900d56b5cade",
                                                "sense_id": "d0cc6fae-584c-39a5-b2ce-8f290310b494",
                                                "text": "Des regards incertains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31ab4d9d-98c0-3aba-895f-6243ca48e50c",
                                        "entry_id": "17586961-d9dd-34e6-8827-c35540634c6c",
                                        "glosses": [
                                            "En parlant des personnes, qui manque de certitude ou de résolution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b47e1d4e-3a08-4124-ab4a-dd522a372b4a",
                                                "sense_id": "31ab4d9d-98c0-3aba-895f-6243ca48e50c",
                                                "text": "Je suis incertain de ce que je dois faire."
                                            },
                                            {
                                                "example_id": "58af8794-f8c4-41d8-8361-a4722dc4eb25",
                                                "sense_id": "31ab4d9d-98c0-3aba-895f-6243ca48e50c",
                                                "text": "Je suis incertain de ce qui pourra m’arriver."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incertain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bf85f9f-43c2-31c9-bec9-de74e748c288",
                                        "entry_id": "d8a0e5cc-9b41-30ee-88a5-9e936274e678",
                                        "glosses": [
                                            "Ce qui n’est pas sûr, pas assuré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ce167f6-af89-41d3-9075-f8a46b2c541e",
                                                "sense_id": "1bf85f9f-43c2-31c9-bec9-de74e748c288",
                                                "text": "Quitter le certain pour l’incertain."
                                            },
                                            {
                                                "example_id": "629f8c33-1288-43d3-b061-fc0ab000ddf0",
                                                "sense_id": "1bf85f9f-43c2-31c9-bec9-de74e748c288",
                                                "text": "L’incertain est une notion qui, a priori, pose plus de questions qu’elle n’offre de réponses."
                                            },
                                            {
                                                "example_id": "8fe79bff-4adb-4944-b792-f948edf37047",
                                                "sense_id": "1bf85f9f-43c2-31c9-bec9-de74e748c288",
                                                "text": "Rien ne garantissait que la neige tienne : une avalanche pouvait partir. C’était notre seul commerce avec l’incertain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95da1b94-97d7-4faa-aa4c-741dcdd51c3d",
                        "source_entry_id": "4aef0299-6598-343f-a5e7-403db306d657",
                        "source_sense_description": "uncertain",
