                ],
                "senses": [
                    {
                        "sense_id": "eb23d8f7-dda0-32bb-9bd0-52b067f715a0",
                        "entry_id": "dc447143-cf5a-3c1f-b2f1-904cde5052a1",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5726d384-1e3b-49d5-967e-30ea1e7e00fb",
                                "sense_id": "eb23d8f7-dda0-32bb-9bd0-52b067f715a0",
                                "text": "Frau Marzin ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f5abda52-fc4a-4483-82ec-7109b2c291dd",
                                "sense_id": "eb23d8f7-dda0-32bb-9bd0-52b067f715a0",
                                "text": "Herr Marzin wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "306df51d-3818-4078-88a6-8baf0970d059",
                                "sense_id": "eb23d8f7-dda0-32bb-9bd0-52b067f715a0",
                                "text": "Die Marzins fahren heute ins Münsterland."
                            },
                            {
                                "example_id": "67c4bacb-0ffd-4ab9-a31a-d98f917018b5",
                                "sense_id": "eb23d8f7-dda0-32bb-9bd0-52b067f715a0",
                                "text": "Der Marzin trägt nie die Schals, die die Marzin ihm strickt."
                            },
                            {
                                "example_id": "2d20468b-6af4-46be-8f38-4d2fe206a736",
                                "sense_id": "eb23d8f7-dda0-32bb-9bd0-52b067f715a0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Marzin kommt, geht der Herr Marzin.“"
                            },
                            {
                                "example_id": "6579cc22-ac96-4a33-b0c2-3433ab96b686",
                                "sense_id": "eb23d8f7-dda0-32bb-9bd0-52b067f715a0",
                                "text": "Marzin kommt und geht."
                            },
                            {
                                "example_id": "9d0329af-0fce-4e8d-9d91-85fa73e0786d",
                                "sense_id": "eb23d8f7-dda0-32bb-9bd0-52b067f715a0",
                                "text": "Marzins kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
