                        "glosses": [
                            "Spécialiste dans la collecte des empruntes digitales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a7c6072-9d56-463c-8e13-4df4a249924a",
                                "sense_id": "e618a9ac-7c60-34b9-b464-67bca4d65ba0",
                                "text": "La définition officielle de mon poste est dactylo-technicienne spécialiste de l’identification par les empreintes digitales."
                            },
                            {
                                "example_id": "ef976cec-e076-4612-93d6-6671fa9f109d",
                                "sense_id": "e618a9ac-7c60-34b9-b464-67bca4d65ba0",
                                "text": "“L'illuminateur” effectua son balayage laser, la dactylo-technicienne passa son pinceau tout autour de la cavité abdominale, le photographe multiplia les prises. Le plus insoutenable fut de récupérer les viscères."
                            },
                            {
                                "example_id": "5de5ad65-b7bf-425e-98b0-38c5dcc0d227",
                                "sense_id": "e618a9ac-7c60-34b9-b464-67bca4d65ba0",
                                "text": "« Oui, j'ai bien un pouce ici », confirme la dactylo-technicienne. Elle repose poudre et pinceau pour saisir un carré de transfert transparent qu'elle vient appliquer avec soin sur l’empreinte à relever."
                            }
                        ]
                    }
