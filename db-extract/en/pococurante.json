                                                "sense_id": "9a3c4e12-0fe9-3e9e-8a87-63f197522894",
                                                "text": "Jej fochy są mi zupełnie obojętne."
                                            },
                                            {
                                                "example_id": "95673b0e-e229-4499-97c6-6370a4e6bf39",
                                                "sense_id": "9a3c4e12-0fe9-3e9e-8a87-63f197522894",
                                                "text": "Nieszczęścia innych są nam obojętne, chyba że sprawiają nam przyjemność"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
