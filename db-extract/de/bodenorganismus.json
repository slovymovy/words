                ],
                "senses": [
                    {
                        "sense_id": "f76c000f-1074-335e-b65c-93cdc2253daa",
                        "entry_id": "66a291fa-8b87-3424-bcb8-f5baccf350a5",
                        "glosses": [
                            "kleines Lebewesen, das in und auf der obersten Schicht der Erde lebt (beispielsweise aus den Gruppen der Pilze, Bakterien, Amöben, Milben, Spinnen, Würmer)"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "e20ea25a-fde3-455d-b4e9-24f986039b8e",
                                "sense_id": "f76c000f-1074-335e-b65c-93cdc2253daa",
                                "text": "„Der nährstoffreiche Humus - eine lockere, meist etwas dunklere obere Erdschicht - entsteht natürlich aus abgestorbenen Pflanzenteilen, zersetzt von Bodenorganismen wie Bakterien, Pilzen und Würmern.“"
                            },
                            {
                                "example_id": "cdf8d1a9-7613-4a88-a37f-2980d347bfc0",
                                "sense_id": "f76c000f-1074-335e-b65c-93cdc2253daa",
                                "text": "„[Humus] unterliegt vor allem der Aktivität der Bodenorganismen (Edaphon), die durch ihren Stoffwechsel laufend zum Auf-, Um- oder Abbau des Humus beitragen.“"
                            },
                            {
                                "example_id": "7d419fea-d6ce-4225-8350-f8bd30a8205c",
                                "sense_id": "f76c000f-1074-335e-b65c-93cdc2253daa",
                                "text": "„Nach dem Absterben wird organische Materie freigesetzt und sowohl mechanisch als auch enzymatisch durch Bodenorganismen umgewandelt.“"
                            },
                            {
                                "example_id": "5c780650-26d0-4711-888d-977e8e932b68",
                                "sense_id": "f76c000f-1074-335e-b65c-93cdc2253daa",
                                "text": "[Humus:] „Zum Großteil besteht diese Substanz aus Pflanzenresten, die von Bodenorganismen in mikroskopisch kleine Teile zerlegt werden.“"
                            },
                            {
                                "example_id": "b9ecfa28-6d50-4c1a-9706-4e7686204815",
                                "sense_id": "f76c000f-1074-335e-b65c-93cdc2253daa",
                                "text": "„Der Boden ist gleichzeitig Lebensraum für zahlreiche Bodenorganismen, die wesentlich an der Bodenbildung beteiligt sind (Bioturbation, Lebendverbauung).“"
                            },
                            {
                                "example_id": "15d92ced-0a74-4eae-8654-5818e4799ea5",
                                "sense_id": "f76c000f-1074-335e-b65c-93cdc2253daa",
                                "text": "„Regenwürmer, Termiten und andere Bodenorganismen verbessern die Produktivität des Bodens, indem sie die oberen Schichten durchwühlen und mischen.“"
                            },
                            {
                                "example_id": "fd4371ea-777b-416d-8cb9-478d12e19f82",
                                "sense_id": "f76c000f-1074-335e-b65c-93cdc2253daa",
                                "text": "„[Zu den Substratfressern] gehören Bodenorganismen (wie der Regenwurm), Blattminierer, Borkenkäfer (wie der Buchdrucker), Saprobionten und Koprophagen (wie der Mistkäfer).“"
                            },
                            {
                                "example_id": "c988d60c-cb6b-40d9-9738-50d411f4a60a",
                                "sense_id": "f76c000f-1074-335e-b65c-93cdc2253daa",
                                "text": "„Hierbei sorgen die Bodenorganismen auch gleichzeitig für günstige bodenphysikalische Bedingungen.“"
                            },
                            {
                                "example_id": "71d1f312-45fd-4073-a669-721e36fd4d15",
                                "sense_id": "f76c000f-1074-335e-b65c-93cdc2253daa",
                                "text": "„Bodenorganismen kommen in unterschiedlicher Dichte im Boden vor, […].“"
                            },
                            {
                                "example_id": "c18c940d-eac2-4f7c-afa8-614f7589df37",
                                "sense_id": "f76c000f-1074-335e-b65c-93cdc2253daa",
                                "text": "„Die Wechselwirkungen zwischen Böden, Pflanzen und Bodenorganismen sind besonders eng in der Rhizosphäre, also im Wurzelraum der Pflanzen.“"
                            },
                            {
                                "example_id": "1a36b987-709b-4020-84cc-5d27fccf7739",
                                "sense_id": "f76c000f-1074-335e-b65c-93cdc2253daa",
                                "text": "„Bodenorganismen sind wesentlich an den Abbau-, Aufbau- und Umbauvorgängen im Boden und damit an den Stoffkreisläufen, indirekt auch am Wasserkreislauf, beteiligt.“"
                            },
                            {
                                "example_id": "f688c9e6-edab-4294-b9d8-2f7b35b3b693",
                                "sense_id": "f76c000f-1074-335e-b65c-93cdc2253daa",
                                "text": "„[Pflanzenschutzmittel können] mit ihren unerwünschten Nebenwirkungen auch nützliche Bodenorganismen schädigen.“"
                            },
                            {
                                "example_id": "06f8b56d-a018-4a80-8e85-62bc1920ebfe",
                                "sense_id": "f76c000f-1074-335e-b65c-93cdc2253daa",
                                "text": "„Acetamiprid verweilt nur kurz im Boden (Tabelle 3) und birgt ein geringes Risiko für Bodenorganismen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
