                    {
                        "sense_id": "e64a8ff4-92de-3117-b650-2235851ae4fc",
                        "entry_id": "cf6f854b-8231-3226-a267-0a02659989a1",
                        "glosses": [
                            "Obsolete spelling of Britain."
                        ],
                        "tags": [
                            "alt-of",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "553fa06e-a1ea-4ad9-8925-45f4c0a963cf",
                                "sense_id": "e64a8ff4-92de-3117-b650-2235851ae4fc",
                                "text": "Sixtly, That this Realme was diuided into Shires and Counties, and thoſe Shires into Cities, Burroughs, and Townes, by the Bꝛittains."
                            },
                            {
                                "example_id": "aff9f01d-4c40-4107-b642-3ccc497bca8a",
                                "sense_id": "e64a8ff4-92de-3117-b650-2235851ae4fc",
                                "text": "But since this custome was probably disused before their Invasion or Conquest, and the Romanes confessedly practised the same, since their possession of this Island, the most assured account will fall upon the Romanes, or Brittains Romanized."
                            },
                            {
                                "example_id": "d19631e3-c5e3-42f7-aacd-c1545f38188f",
                                "sense_id": "e64a8ff4-92de-3117-b650-2235851ae4fc",
                                "text": "This is the same Claudia Ruffina which the Poet Martial afterward so highly commended for her illustrious birth, beauty and exquisite perfection both in the Grecian and Roman literature, expressly declaring that she was a Brittain."
                            }
                        ]
                    }
