                "entry_id": "6c6d18b9-de61-303c-a065-90cc9b5b54c7",
                "word": "convaincu",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b5cfd33c-a020-4b58-9594-fda44560b2b5",
                        "entry_id": "6c6d18b9-de61-303c-a065-90cc9b5b54c7",
                        "tags": [
