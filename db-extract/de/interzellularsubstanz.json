                        "entry_id": "e98b51c0-cb07-35e9-abc4-2aae60fef0b7",
                        "glosses": [
                            "Substanz, die sich zwischen den Zellen befindet, sie netzartig umhüllt und sowohl eine stützende als auch eine regulierende Funktion übernimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63867642-cd50-41ae-b47d-2539a4d44417",
                                "sense_id": "7e1c554e-0ee0-38b9-b7c2-053ccf019c0d",
                                "text": "Die Interzellularsubstanz spielt eine wichtige Rolle bei der Stabilität des Gewebes."
                            },
                            {
                                "example_id": "75f14c02-8508-44e0-85f0-10a2d82649a0",
                                "sense_id": "7e1c554e-0ee0-38b9-b7c2-053ccf019c0d",
                                "text": "Veränderungen in der Interzellularsubstanz können auf Erkrankungen hinweisen."
                            }
                        ],
