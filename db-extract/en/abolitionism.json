                "senses": [
                    {
                        "sense_id": "8e13596d-c088-35da-ab1c-d8e1b84ae6ec",
                        "entry_id": "8dde79c1-2e3f-365a-ba64-3347fe66b656",
                        "glosses": [
                            "Support for the abolition of something; the tenets of abolitionists."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "810a3bf8-2bcf-4f41-8edc-321a0133ac77",
                                "sense_id": "8e13596d-c088-35da-ab1c-d8e1b84ae6ec",
                                "text": "Abolitionism is based on the moral conviction that social life should not and, in fact, cannot be regulated effectively by criminal law …. As a social movement committed to the abolition of the prison or even the entire penal system, abolitionism originated in campaigns for prisoners' rights and penal reform."
                            },
                            {
                                "example_id": "d191f0ac-aff3-4d43-ae3a-7ca5422a5752",
                                "sense_id": "8e13596d-c088-35da-ab1c-d8e1b84ae6ec",
                                "text": "Abolitionism is still a powerful philosophy among contemporary feminists, both in the West and in the developing world."
                            }
                        ]
                    },
                    {
                        "sense_id": "dca3dbad-696e-3c46-85cb-8139c633b43d",
                        "entry_id": "8dde79c1-2e3f-365a-ba64-3347fe66b656",
                        "glosses": [
                            "Support for the abolition of something; the tenets of abolitionists.",
                            "Support for the abolition of prisons."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b3337670-a5d9-46fd-982c-1ff660bb46f1",
                                "sense_id": "dca3dbad-696e-3c46-85cb-8139c633b43d",
                                "text": "ABOLITIONISM\nPrisons and jails have been condemned, at least by some, for as long as they have existed.[…] In the United States, the most profound statement of support for abolitionism is the document Instead of Prisons […] Abolitionism has also given emphasis to didferent strategies for change, ranging from simply abolishing prisons to abolishing the entire criminal justice apparatus, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "865e404c-0c63-373b-9e72-2e93782f1643",
                        "entry_id": "8dde79c1-2e3f-365a-ba64-3347fe66b656",
                        "glosses": [
                            "Support for the abolition of something; the tenets of abolitionists.",
                            "Support for the abolition (banning) of sex work."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "997b70c6-6cb0-4433-a58c-3de439345077",
                                "sense_id": "865e404c-0c63-373b-9e72-2e93782f1643",
                                "text": "Abolitionism is a term that refers to a particular ideological and legal approach to prostitution. The approach has its roots in 19th-century feminism and is still a potent force […] Thus abolitionism arose as a movement against the state regulation of prostitution. The leader of the abolitionist movement was Josephine Butler, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "3d18035c-8654-3dd0-bed6-da94c7baf155",
                        "entry_id": "8dde79c1-2e3f-365a-ba64-3347fe66b656",
                        "glosses": [
                            "Support for the abolition of something; the tenets of abolitionists.",
                            "Support for the abolition (banning) of abortion."
