                        "examples": [
                            {
                                "example_id": "be0da1c2-a7bd-4a03-b9bf-373d705bfa07",
                                "sense_id": "27996814-9cf5-3a3b-a8fd-6903a3de6236",
                                "text": "Le pralin possède une saveur très délicate. Il est d'usage fréquent en pâtisserie et en confiserie."
                            }
                        ]
                    },
                    {
                        "sense_id": "89506311-bdd3-37b0-8eed-d22e65decbac",
                        "entry_id": "f4aaed9b-c5cc-3f1a-bbb8-a584807350b5",
                        "glosses": [
                            "preparation using mud and fertilizer used to coat young roots prior to plantation"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "2977db05-dc71-41f4-ad45-af93216de1fb",
                                "sense_id": "89506311-bdd3-37b0-8eed-d22e65decbac",
                                "text": "Le pralin est un mélange de terre du jardin, de bouse de vache et d'eau pour former une boue liquide dont on enduit les racines des arbres, arbustes ou rosiers."
                            }
                        ]
                    }
