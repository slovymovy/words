                        "sense_id": "f26f07ec-0158-31d3-a22b-dfa15d61eca3",
                        "entry_id": "2b0e0cc0-073f-3d70-9f90-6348fb9e2d11",
                        "glosses": [
                            "A watch (timepiece)."
                        ],
                        "tags": [
