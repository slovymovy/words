                    "sense_id": "74927e4e-f01e-34dd-bab9-f93fbcd628f0",
                    "sense_definition": "D'une manière polie, avec courtoisie, civilité et respect.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant a salué <w>poliment</w> la voisine avant d'entrer dans l'immeuble.",
                            "target_lang_translations": {
                                "en": "The child <w>politely</w> greeted the neighbour before going into the building.",
                                "ru": "Ребёнок <w>вежливо</w> поздоровался с соседкой, прежде чем войти в дом.",
                                "de": "Das Kind grüßte die Nachbarin <w>höflich</w>, bevor es ins Haus ging.",
                                "es": "El niño saludó <w>educadamente</w> a la vecina antes de entrar en el edificio.",
                                "zh": "孩子进楼前，<w>礼貌地</w>跟邻居打了个招呼。"
                            }
                        },
                        {
                            "text": "Elle a préféré refuser <w>poliment</w> cette invitation pour pouvoir se reposer.",
                            "target_lang_translations": {
                                "en": "She preferred to decline this invitation <w>politely</w> so that she could rest.",
                                "ru": "Она предпочла <w>вежливо</w> отказаться от этого приглашения, чтобы иметь возможность отдохнуть.",
                                "de": "Sie zog es vor, diese Einladung <w>höflich</w> abzulehnen, um sich ausruhen zu können.",
                                "es": "Ella prefirió declinar <w>cortésmente</w> esta invitación para poder descansar.",
                                "zh": "她宁可<w>礼貌地</w>谢绝这次邀请，以便好好休息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "courtoisement",
                        "respectueusement",
                        "civilement"
                    ],
                    "antonyms": [
                        "impoliment",
                        "grossièrement"
