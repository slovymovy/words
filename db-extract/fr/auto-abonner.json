                        "glosses": [
                            "Abonner tout seul ou automatiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e462088a-6485-47e3-b9ec-ff20e8142dc8",
                                "sense_id": "e92a58df-cf43-3669-a07e-1a88058c13a5",
                                "text": "Les membres ont la possibilité ou non de s'auto-abonner."
                            },
                            {
                                "example_id": "6ce54f06-5406-409d-bf32-af41d9ed2671",
                                "sense_id": "e92a58df-cf43-3669-a07e-1a88058c13a5",
                                "text": "Remarque, je ne suis abonnée à aucun kit, je peux peut-être m'auto-abonner à tes sets de tampons?"
                            },
                            {
                                "example_id": "9014f43b-0391-4872-ab9f-49b1c6e74d81",
                                "sense_id": "e92a58df-cf43-3669-a07e-1a88058c13a5",
                                "text": "Ca me fait halluciner qu'il faille se désabonner, comment ils peuvent nous auto-abonner à un service de cette manière.... c'est légal ?"
                            }
                        ]
                    }
