                                    {
                                        "sense_id": "772ff99c-5283-3d18-950e-b02bdbd2ba3c",
                                        "entry_id": "dd1e3eaf-ad71-3e44-98ec-14d608a96f70",
                                        "glosses": [
                                            "To dent; to stamp or to press in; to impress"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1109631-8fe5-44b0-98e7-92379ef701ea",
                                                "sense_id": "772ff99c-5283-3d18-950e-b02bdbd2ba3c",
