                                "target_senses": [
                                    {
                                        "sense_id": "27f35146-8715-331a-9135-4d62e8310aad",
                                        "entry_id": "ca58375f-0d9e-3d57-9b1c-db3269567616",
                                        "glosses": [
                                            "A challenge, trial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0ce8614-befb-4b90-8c21-9c53cf9ced46",
                                                "sense_id": "27f35146-8715-331a-9135-4d62e8310aad",
                                                "text": "Numerous experimental tests and other observations have been offered in favor of animal mind reading, and although many scientists are skeptical, others assert that humans are not the only species capable of representing what others do and don’t perceive and know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a89dc94-b4e7-35d6-be7f-aa6e8adb3f62",
                                        "entry_id": "ca58375f-0d9e-3d57-9b1c-db3269567616",
                                        "glosses": [
                                            "A cupel or cupelling hearth in which precious metals are melted for trial and refinement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c386f92-a31a-39c7-85c8-fab81e5008bf",
                                        "entry_id": "ca58375f-0d9e-3d57-9b1c-db3269567616",
                                        "glosses": [
                                            "An examination, given often during the academic term."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75ee7d60-84a3-3a05-8395-aa43445f5733",
                                        "entry_id": "ca58375f-0d9e-3d57-9b1c-db3269567616",
                                        "glosses": [
                                            "A session in which a product, piece of equipment, or system is examined under everyday or extreme conditions to evaluate its durability, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61ec10e9-ba9a-4cfb-8c90-5ccad86f55c2",
                                                "sense_id": "75ee7d60-84a3-3a05-8395-aa43445f5733",
                                                "text": "It's Christmas at ground zero / The button has been pressed / The radio / Just let us know / That this is not a test"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cfb4e3e-3983-3b2b-ae32-1826e373fbd5",
                                        "entry_id": "ca58375f-0d9e-3d57-9b1c-db3269567616",
                                        "glosses": [
                                            "A Test match."
                                        ],
                                        "tags": [
                                            "normally \\\"Test\\"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9116bdd-c64b-3e91-8e2b-c126a97e7ffb",
                                        "entry_id": "ca58375f-0d9e-3d57-9b1c-db3269567616",
                                        "glosses": [
                                            "The external calciferous shell, or endoskeleton, of an echinoderm, e.g. sand dollars and sea urchins; testa."
