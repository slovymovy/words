                    },
                    {
                        "translation_id": "b1c33044-6460-4559-8420-ab8309ff65b8",
                        "source_entry_id": "45468137-31ca-38fd-ad92-ee4e3bd56f66",
                        "source_sense_id": "a840503a-5979-3552-a541-2d583197f085",
                        "target_lang_word": "чревовещание",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чревовещание",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "76a8cbad-41f3-355c-8db1-318524c26c6b",
                                        "entry_id": "ac98d7bd-726a-3b85-9ef9-acebf2c25697",
                                        "glosses": [
                                            "навык, умение говорить «внутренним голосом»: не шевеля губами и не открывая рта, так что звуки кажутся исходящими из чрева"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "accbb66b-0b49-488c-98e0-db2ddc163efa",
                                                "sense_id": "76a8cbad-41f3-355c-8db1-318524c26c6b",
                                                "text": "Аттракцион этот хорошо известен среди эстрадных иллюзионистов и называется чревовещанием. Так что же такое чревовещание? Чревовещание (научное название — вентрилоквия) — это способность говорить, не шевеля губами, вследствие чего произносимые слова кажутся исходящими от других лиц."
                                            },
                                            {
                                                "example_id": "d3c871a6-0fea-4780-a7ba-1dd1577602e1",
                                                "sense_id": "76a8cbad-41f3-355c-8db1-318524c26c6b",
                                                "text": "Опытным сыщикам стало ясно, что англичанина «обработал» ловкий жулик, обладающий навыками чревовещания: он говорил за себя тенором, а за собаку басом."
                                            },
                                            {
                                                "example_id": "caac3f53-e6a4-4c98-856e-6bb0ed4d7c0c",
                                                "sense_id": "76a8cbad-41f3-355c-8db1-318524c26c6b",
                                                "text": "На арену чревовещание вышло в конце восемнадцатого века, вместе с Чарльзом Эльворти и его знаменитой куклой Мистером Боксом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8215419-faf5-337f-bf97-cfe0396d2a66",
                                        "entry_id": "ac98d7bd-726a-3b85-9ef9-acebf2c25697",
                                        "glosses": [
                                            "перен. пророчество"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43654f6c-3c2d-36bf-be99-6d0538f8b469",
                                        "entry_id": "ac98d7bd-726a-3b85-9ef9-acebf2c25697",
                                        "glosses": [
                                            "перен. предчувствие, предощущение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d32e3b7-1e01-4b9a-a564-eff0ff7c8e18",
                                                "sense_id": "43654f6c-3c2d-36bf-be99-6d0538f8b469",
                                                "text": "Вместо мыслей — чревовещания какие-то, от праздных слов — претит, воздух напоён предательством, чувства заменились ощущениями и… глупость, глупость повсюду!.."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
