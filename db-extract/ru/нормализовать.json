                "translations": [
                    {
                        "translation_id": "41878afd-20bd-4c84-be6c-b9c3fa5a9e6f",
                        "source_entry_id": "e5c4c948-f9ae-320e-b695-3dc95df8ac40",
                        "source_sense_id": "721d046b-3ee3-36bd-95ee-3b059759ca5e",
                        "target_lang_word": "normalisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "normalisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f49cbbf9-08de-3779-a848-364f34ce6c71",
                                        "entry_id": "f41a439f-358b-3303-8ea6-08132ada434d",
                                        "glosses": [
                                            "in den Zustand zurückkehren, der als der normale, ursprüngliche angesehen wird"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14f9423b-9033-488b-ade7-db881d5082c7",
                                                "sense_id": "f49cbbf9-08de-3779-a848-364f34ce6c71",
                                                "text": "Der Herzschlag hatte sich wieder normalisiert."
                                            },
                                            {
                                                "example_id": "9523bda8-86cf-4f96-be84-64feba948f4a",
                                                "sense_id": "f49cbbf9-08de-3779-a848-364f34ce6c71",
                                                "text": "„Seit Sommer 1985 normalisierte sich die Beziehung zwischen Westeuropa und der Türkei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "071e4381-b1f8-3a04-94c9-8f2b785e8766",
                                        "entry_id": "f41a439f-358b-3303-8ea6-08132ada434d",
                                        "glosses": [
                                            "wieder so handeln, dass normale, zivile Umgangsformen gelten; wieder normal gestalten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e74f3e76-b2ea-4e9e-ae71-e2cbbb7d29b8",
                                                "sense_id": "071e4381-b1f8-3a04-94c9-8f2b785e8766",
                                                "text": "Lange versuchte sie, die Beziehung zu ihren Schwiegereltern zu normalisieren."
                                            },
                                            {
                                                "example_id": "2a73b31b-7652-4a6f-9c87-baaecf923b92",
                                                "sense_id": "071e4381-b1f8-3a04-94c9-8f2b785e8766",
                                                "text": "„Erst die Annahme des Londoner Vertrags über den Dawes-Plan im August 1924 normalisierte die Reparationsleistungen.“"
                                            },
                                            {
                                                "example_id": "7c4f64c3-9586-4487-834f-0736b85a94b2",
                                                "sense_id": "071e4381-b1f8-3a04-94c9-8f2b785e8766",
                                                "text": "„Bier am Abend unter den Kastanien normalisierte den Schlafrhythmus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b8f6504c-3acd-31de-bc96-d594827c5750",
                                        "entry_id": "f41a439f-358b-3303-8ea6-08132ada434d",
                                        "glosses": [
                                            "die Lautstärke einer Tonaufnahme auf eine bestimmte Höhe bringen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c79e4de2-f8ff-45cf-9b24-1329ac4c9bac",
                                                "sense_id": "b8f6504c-3acd-31de-bc96-d594827c5750",
                                                "text": "„In Audacity können Sie einzelne Audiospuren oder Kanäle normalisieren.“"
                                            },
                                            {
                                                "example_id": "ffbd1d0f-2995-4d66-9d8a-75f2994a1ee4",
                                                "sense_id": "b8f6504c-3acd-31de-bc96-d594827c5750",
                                                "text": "„Geben sie einen noch negativeren Wert ein (zum Beispiel, -3 dB), um mit weniger Aussteuerung zu normalisieren.“"
                                            },
                                            {
                                                "example_id": "dcee1d6c-473a-450c-963b-5431ceb01b39",
                                                "sense_id": "b8f6504c-3acd-31de-bc96-d594827c5750",
                                                "text": "„Es gibt im Wesentlichen zwei Gründe, warum normalisiert wird – zum einen technische Rahmenbedingungen bei der Übertragung bzw. Speicherung des Audiomaterials, zum anderen die Anpassung der Lautheit (vom Menschen empfundene Lautstärke) des Materials.“"
                                            },
                                            {
                                                "example_id": "bcdc933f-10e0-4da6-aba0-377a97fc31cc",
                                                "sense_id": "b8f6504c-3acd-31de-bc96-d594827c5750",
                                                "text": "„Die neue libebur128 ist eine freie Implementation der Lautstärken-Empfehlung der European Broadcasting Union (EBU R128), die eine Alternative zu ReplayGain darstellt. Sie ermöglicht es, Audio zu analysieren und beim Abspielen die Lautstärke zu normalisieren.“"
                                            },
                                            {
                                                "example_id": "7b5f7aa3-3c57-42b7-899d-39dde8e0ffc3",
                                                "sense_id": "b8f6504c-3acd-31de-bc96-d594827c5750",
                                                "text": "„Mit Wavelab können Sie in wenigen Schritten den Pegel von ganzen Audiodateien oder Ausschnitten normalisieren.“"
                                            },
                                            {
                                                "example_id": "a3c9f17e-0a74-4474-8028-99f9daea80a0",
                                                "sense_id": "b8f6504c-3acd-31de-bc96-d594827c5750",
                                                "text": "„Wenn ich eine Audiospur normalisiere, geraten manchmal nur diejenigen Bereiche meiner Audiospur lauter, die eh schon ausreichend laut waren. Der Rest bleibt hingegen weiterhin zu leise. Woran liegt das?“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
