                "senses": [
                    {
                        "sense_id": "8dba3c34-60b3-3989-9674-b616346137af",
                        "entry_id": "8e88e123-e021-3c52-b159-9035d4702141",
                        "glosses": [
                            "Donner un caractère de tabloïd à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d742916-a672-4618-9670-402a7547419d",
                                "sense_id": "8dba3c34-60b3-3989-9674-b616346137af",
                                "text": "Ce Fabrice Jouhaud (rédac en chef) est en train de \"tabloïdiser\" de plus en plus le journal."
                            },
                            {
                                "example_id": "746b2a82-d42b-4979-8771-be33d3b07d43",
                                "sense_id": "8dba3c34-60b3-3989-9674-b616346137af",
                                "text": "l'\"Affaire Lambert\" : et si vous cessiez de parler de cette famille, et si vous cessiez de \"tabloïdiser\" Le Figaro, d'emplir vos pages de foot ad nauseam on aurait peut-être un Quotidien à acheter."
                            },
                            {
                                "example_id": "280928f1-525b-468a-8b7c-961b2cdc27c4",
                                "sense_id": "8dba3c34-60b3-3989-9674-b616346137af",
                                "text": "Par cette sélection des thèmes, et par leur vocabulaire, les médias ont tendance à se « tabloïdiser »."
                            }
                        ]
                    }
