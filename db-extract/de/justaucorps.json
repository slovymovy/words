                        "sense_id": "0e69be92-0138-3e30-9cc6-5434d1a2be62",
                        "entry_id": "e8a337b3-ed8c-3f6a-b1ca-088ce28a4eb1",
                        "glosses": [
                            "Kleidungsstück für Männer, das eng am Körper liegt, bis zu den Knien reicht"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "fa25262c-36e4-43eb-81ae-d723fbb97778",
                                "sense_id": "0e69be92-0138-3e30-9cc6-5434d1a2be62",
                                "text": "„Das Kniestück zeigt den jungen Kronprinzen Friedrich II, über seine rechte Schulter blickend, in einem reich verzierten Justaucorps aus Samt mit schräg geöffneten Dreiviertelärmeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
