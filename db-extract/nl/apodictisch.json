                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d34edbde-0147-4957-8d3b-8b720cb1e648",
                                "sense_id": "ae9d4a1f-e478-3038-93e6-549b414304b4",
                                "text": "Een apodictisch bewijs."
                            }
                        ]
                    },
                    {
                        "sense_id": "ecff9468-bec0-3945-aea5-72b74ad1ff1d",
                        "entry_id": "2d7f1e43-7c41-3172-9f54-1c65e46470e3",
                        "glosses": [
                            "geponeerd met al te grote stelligheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdf2d7ca-c4af-4175-a7eb-481911d46e36",
                                "sense_id": "ecff9468-bec0-3945-aea5-72b74ad1ff1d",
                                "text": "Met gemak verbond hij de Beach Boys met Balkenende en verkondigde hij de ene apodictische stelling na de andere: \"Geëngageerde dichters zijn slechte dichters. Nee, ik weet zo snel geen voorbeeld.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bddde2a-cc5f-465f-8f35-ead2043fd39c",
                        "source_entry_id": "2d7f1e43-7c41-3172-9f54-1c65e46470e3",
                        "target_lang_word": "apodeictic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apodeictic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26670cb6-1350-34f9-be59-6ffd1ce3b379",
                                        "entry_id": "781a7cbf-8334-369c-80b8-9d33f52aef01",
                                        "glosses": [
                                            "Affording proof; demonstrative."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9423e1f-f2e7-3542-a334-a88dfb84babd",
                                        "entry_id": "781a7cbf-8334-369c-80b8-9d33f52aef01",
                                        "glosses": [
                                            "Incontrovertible; demonstrably true or certain."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62eeae35-7356-35f2-a4bc-b87e49c14f18",
                                        "entry_id": "781a7cbf-8334-369c-80b8-9d33f52aef01",
                                        "glosses": [
                                            "Of the characteristic feature of a proposition that is necessary (or impossible): perfectly certain (or inconceivable) or incontrovertibly true (or false); self-evident."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cbe08b1-810d-4e85-8c2b-80df75819ac0",
                                                "sense_id": "62eeae35-7356-35f2-a4bc-b87e49c14f18",
                                                "text": "1855, John Miller Dow Meiklejohn (translator), 1787, Immanuel Kant, Critique of Pure Reason, 2nd Edition,\nThus, moreover, the principles of geometry- for example, that \"in a triangle, two sides together are greater than the third,\" are never deduced from general conceptions of line and triangle, but from intuition, and this a priori, with apodeictic certainty."
                                            },
                                            {
                                                "example_id": "392a5b04-4f3c-4d38-8bd6-8f6f9eee775f",
                                                "sense_id": "62eeae35-7356-35f2-a4bc-b87e49c14f18",
                                                "text": "Aristotle does, indeed, distinguish between (1) Logic, or Analytic, as the theory or method of arriving at true or apodeictic conclusions; and (2) Dialectic as the method of arriving at conclusions that are accepted or pass current[ly] as true,..."
                                            },
                                            {
                                                "example_id": "04f7aa16-7294-4a43-aad6-17b53c4adfc1",
                                                "sense_id": "62eeae35-7356-35f2-a4bc-b87e49c14f18",
                                                "text": "Descartes sought certainty in the existence of God grounded in apodeictic demonstrations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a86514cd-832b-46ef-917e-2bbcbbbaa4bf",
                        "source_entry_id": "2d7f1e43-7c41-3172-9f54-1c65e46470e3",
                        "target_lang_word": "apodictique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apodictique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e80aa24-abd6-3b62-9930-d4338a42f3f9",
                                        "entry_id": "67a0967d-32f9-347f-88a6-76bf0ff7b3a7",
                                        "glosses": [
                                            "Qui est démonstratif, évident."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "237f12e0-de40-49c7-84ee-2f757d979bcc",
                                                "sense_id": "7e80aa24-abd6-3b62-9930-d4338a42f3f9",
                                                "text": "Un jugement apodictique présente un caractère d’universalité et de nécessité absolue."
                                            },
                                            {
                                                "example_id": "3f64a3c5-1238-42e3-9d54-76c2867b077c",
                                                "sense_id": "7e80aa24-abd6-3b62-9930-d4338a42f3f9",
                                                "text": "Le caractère « apodictique » de la modalité du jugement consiste en ce que celui-ci est affirmé « comme lié de façon indissociable à l’entendement », et, en cela même, comme « nécessaire » et a priori."
                                            },
                                            {
                                                "example_id": "4744e442-ad05-410e-a59c-132fac0c1cd1",
                                                "sense_id": "7e80aa24-abd6-3b62-9930-d4338a42f3f9",
                                                "text": "Le caractère abstrait de la langue, les formes presque mathématiques du style ancien, sont singulièrement favorables, chez Confucius et ses disciples, à l’expression nue et tranchée de l’obligation morale, proclamée dans sa rigueur impérative ou apodictique, pour parler le langage de Kant."
                                            },
                                            {
                                                "example_id": "835676a4-48f7-4293-b98d-abab323f60b7",
                                                "sense_id": "7e80aa24-abd6-3b62-9930-d4338a42f3f9",
                                                "text": "Mes rêves devinrent une certitude, comprenez moi bien : une certitude apodictique, une certitude démontrable, réelle, et ma vie quotidienne devint un rêve."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apodictique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d4931a0-34a8-328a-807d-2aa2db471eff",
                                        "entry_id": "f2226395-6beb-3149-a07d-7d17df37a7fb",
                                        "glosses": [
                                            "Ce qui est énoncé comme une vérité de fait et comme une nécessité absolue."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3163a324-72da-44e7-935a-ec06671f6d7c",
                                                "sense_id": "4d4931a0-34a8-328a-807d-2aa2db471eff",
                                                "text": "Les sciences passent ainsi de l’assertorique (la simple constatation des faits) à l’apodictique (l’établissement des relations nécessaires)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
