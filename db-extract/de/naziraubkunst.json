                    {
                        "sense_id": "ff1df8be-39c0-388d-9bd0-1a241a2bfed1",
                        "entry_id": "769928a4-ce6d-3d0d-9079-83d64500fec7",
                        "glosses": [
                            "von den Nazis unrechtmäßig in Besitz genommene Kunstwerke"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "8a547638-11a7-4201-b724-c4afae21d2f3",
                                "sense_id": "ff1df8be-39c0-388d-9bd0-1a241a2bfed1",
                                "text": "„Museum Wiesbaden kann Naziraubkunst ankaufen“"
                            },
                            {
                                "example_id": "1893e42c-a3b5-4f10-beaf-8657a8cf1150",
                                "sense_id": "ff1df8be-39c0-388d-9bd0-1a241a2bfed1",
                                "text": "„Museum Wiesbaden kauft Naziraubkunst von Erben der Opfer zurück“"
                            },
                            {
                                "example_id": "b520592a-2322-4053-a6f7-7383cfae5173",
                                "sense_id": "ff1df8be-39c0-388d-9bd0-1a241a2bfed1",
                                "text": "„Museum will Naziraubkunst zurückkaufen“"
                            },
                            {
                                "example_id": "bb4f678c-4ca0-450f-a608-e040145b4d53",
                                "sense_id": "ff1df8be-39c0-388d-9bd0-1a241a2bfed1",
                                "text": "„Obwohl sich aufgrund dieser Recherchen schon sehr bald eindeutig herausstellte, daß das Aquarell sogenannte »Naziraubkunst« und damit illegal erworben worden war, […]“"
                            },
                            {
                                "example_id": "c1d2ecae-51c5-4a0b-a49c-88bb2afa7b56",
                                "sense_id": "ff1df8be-39c0-388d-9bd0-1a241a2bfed1",
                                "text": "„Die vom Propagandaministerium beschlagnahmten Kunstwerke wurden vor allem in die neutrale Schweiz, die sich bald zur Drehscheibe des Handels mit Naziraubkunst entwickelte, verschickt und dort verkauft.“"
                            },
                            {
                                "example_id": "e7be08bb-c0a6-4c64-ba73-8dc1b04428fc",
                                "sense_id": "ff1df8be-39c0-388d-9bd0-1a241a2bfed1",
                                "text": "„Die Geschichte warf Schatten auf die Schweizer Galerie und ihren Besitzer, denn Gurlitt war nicht die einzige Verbindung zu Naziraubkunst.“"
                            },
                            {
                                "example_id": "14c5e518-3794-4776-8700-92abeb8071bc",
                                "sense_id": "ff1df8be-39c0-388d-9bd0-1a241a2bfed1",
                                "text": "„Ohne es zu wissen, schmuggelt sie für ihren Geliebten Franz Microfilme von Naziraubkunst über die Grenze.“"
                            },
                            {
                                "example_id": "3e847da2-f3b5-4d70-9445-e3b41a7089da",
                                "sense_id": "ff1df8be-39c0-388d-9bd0-1a241a2bfed1",
                                "text": "„Hollywood hat eine Geschichte über die deutsche Naziraubkunst verfilmt“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
