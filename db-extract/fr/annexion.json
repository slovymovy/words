        "fr-extract.jsonl": [
            {
                "entry_id": "82b92cda-69d6-3d9d-ad9f-4541a8e13a70",
                "word": "annexion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "94b60b87-5775-4ef8-8f1f-5551c9e80a58",
                        "entry_id": "82b92cda-69d6-3d9d-ad9f-4541a8e13a70",
                        "tags": [
                            "plural"
                        ],
                        "form": "annexions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ab732516-a664-330f-b7db-919d3779830d",
                        "entry_id": "82b92cda-69d6-3d9d-ad9f-4541a8e13a70",
                        "glosses": [
                            "Action d’annexer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ae5c56b-cc26-4e0b-867f-ee8e03cd3a42",
                                "sense_id": "ab732516-a664-330f-b7db-919d3779830d",
                                "text": "On ne peut méconnaître la gravité de la notification par laquelle lord John Russell, le secrétaire d’État de sa majesté britannique, le chef du parti whig, a répondu a l’annexion de la Savoie."
                            },
                            {
                                "example_id": "0e9a0622-d608-4797-9703-2d72b0de7054",
                                "sense_id": "ab732516-a664-330f-b7db-919d3779830d",
                                "text": "Né à Puget-Théniers (Alpes-Maritimes), Blanqui est d'origine italienne, sa famille avait été francisée par l’annexion du comté de Nice en 1792."
                            },
                            {
                                "example_id": "3e09ff97-95d9-4160-9700-ee7eb2966568",
                                "sense_id": "ab732516-a664-330f-b7db-919d3779830d",
                                "text": "Depuis l’annexion du Transvaal par les Britanniques en avril 1877, ces derniers n’avaient eu de cesse de s’inquiéter des risques de rébellion des Boers. Mais une autre menace, qui les préoccupait tout autant, était celle que représentait l’armée zouloue aux portes du Natal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f49e28bb-fad2-4fed-86c4-08338880a093",
                        "source_entry_id": "82b92cda-69d6-3d9d-ad9f-4541a8e13a70",
                        "source_sense_id": "ab732516-a664-330f-b7db-919d3779830d",
                        "target_lang_word": "Annexion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Annexion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a9c2294-3795-3e57-8a89-7f90501b7294",
                                        "entry_id": "099137f1-d244-36f2-8c50-bfd8ea8b0ff6",
                                        "glosses": [
                                            "gewaltsame, widerrechtliche Besetzung, Aneignung, Inbesitznahme eines Staatsgebietes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd9e113d-03b1-45ce-922c-6573d958f565",
                                                "sense_id": "8a9c2294-3795-3e57-8a89-7f90501b7294",
                                                "text": "„Der unleugbare Jubel der Massen und das peinliche Fehlen jedweder Gegenwehr durch das Militär ändert insofern nichts an der Tatsache, dass der Einmarsch und die Annexion Österreichs ein deutscher Gewaltakt war.“"
                                            },
                                            {
                                                "example_id": "f1c9de26-44f1-4ba7-8885-1371808a5bcd",
                                                "sense_id": "8a9c2294-3795-3e57-8a89-7f90501b7294",
                                                "text": "„Die direkte oder indirekte Annexion Belgiens war 1916 ein unverzichtbares Ziel, die Wiederherstellung Belgiens eine indiskutable Zumutung geworden.“"
                                            },
                                            {
                                                "example_id": "7871f61f-84e7-492e-baef-871648333da0",
                                                "sense_id": "8a9c2294-3795-3e57-8a89-7f90501b7294",
                                                "text": "„Die Kolonisation als Annexion eines fremden Territoriums, das im Interesse der eigenen Nation erschlossen werden sollte, hat die Lebensformen der Deutschen im Kaiserreich mit geprägt.“"
                                            },
                                            {
                                                "example_id": "2b92582a-ce64-4ce6-bc2a-b72fbe7909b6",
                                                "sense_id": "8a9c2294-3795-3e57-8a89-7f90501b7294",
                                                "text": "„Gut drei Jahrzehnte nach der Annexion Algeriens beginnt ein Wettlauf der Europäer um Afrikas restliche Territorien.“"
                                            },
                                            {
                                                "example_id": "0190bbbf-c6f0-480a-9cd5-2ed2176f4950",
                                                "sense_id": "8a9c2294-3795-3e57-8a89-7f90501b7294",
                                                "text": "„Sie hatten in den Kriegen gegen die Sikhs, die zur Unterwerfung des Panjabs führten, große Erfolge erzielt, ebenso 1852 in dem Krieg, der mit der Annexion Unter-Birmas endete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "365730b2-bf99-4382-817c-921d63d69a30",
                        "source_entry_id": "82b92cda-69d6-3d9d-ad9f-4541a8e13a70",
                        "source_sense_id": "ab732516-a664-330f-b7db-919d3779830d",
                        "target_lang_word": "Annektierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Annektierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0a21acd-45a0-3e15-9526-df4a99e1c6f7",
                                        "entry_id": "5c3683b1-bae1-3498-b0c6-7320f8aaf5cc",
                                        "glosses": [
                                            "gewaltsame Aneignung von etwas; Inbesitznahme, beispielsweise eines Gebietes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "028811dc-aa79-4f6b-ac07-26f60c2c9c55",
                                                "sense_id": "f0a21acd-45a0-3e15-9526-df4a99e1c6f7",
                                                "text": "„Seit der Annektierung der Krim hat sich die Lage jedoch zugespitzt – und Russland die Kontrolle in dem Binnenmeer ausgeweitet.“"
                                            },
                                            {
                                                "example_id": "d16b9a01-1163-405f-8e30-64d28e844704",
                                                "sense_id": "f0a21acd-45a0-3e15-9526-df4a99e1c6f7",
                                                "text": "„Die russische Regierung habe mit der Annektierung der Krim und dem Einmarsch in die Ostukraine Völkerrecht verletzt.“"
                                            },
                                            {
                                                "example_id": "dee0074e-8bdd-40c3-85da-fc9a57ffcfa3",
                                                "sense_id": "f0a21acd-45a0-3e15-9526-df4a99e1c6f7",
                                                "text": "„Als Siebenjähriger erlebte Emiliano 1898 die Annektierung des Inselstaates durch die Vereinigten Staaten in Folge des spanisch-amerikanischen Krieges.“"
                                            },
                                            {
                                                "example_id": "49a463bb-d31d-49f6-a926-fa1f09631297",
                                                "sense_id": "f0a21acd-45a0-3e15-9526-df4a99e1c6f7",
                                                "text": "„Die Autonomiebehörde in Ramallah reagierte zornig auf einen Vorstoß rechtsorientierter Koalitionsmitglieder zur Annektierung des Jordantals.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a0a602a-0033-4360-a2d4-63420b421a03",
                        "source_entry_id": "82b92cda-69d6-3d9d-ad9f-4541a8e13a70",
                        "source_sense_id": "ab732516-a664-330f-b7db-919d3779830d",
                        "target_lang_word": "Anschluss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anschluss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55cfd1c5-f327-3803-a8e0-6dae48658c2b",
                                        "entry_id": "40dc2eda-5756-3f9b-9ee0-8f94317b2887",
                                        "glosses": [
                                            "die Verbindung eines Teilnehmers mit einem Versorgungs- oder Leitungsnetz (zum Beispiel einem Telefon-, Gas-, oder Wassernetz)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6c41e43-6d44-428d-afca-5b4eb8103194",
                                                "sense_id": "55cfd1c5-f327-3803-a8e0-6dae48658c2b",
                                                "text": "Habt ihr schon euren Anschluss für das Telefon bekommen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "06d6b52f-e5c1-3d22-a016-e7c0816f6517",
                                        "entry_id": "40dc2eda-5756-3f9b-9ee0-8f94317b2887",
                                        "glosses": [
                                            "der Wechsel von einem Verkehrsmittel zum Anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b5d588a-1193-43e5-9dae-82c027c6de3d",
                                                "sense_id": "06d6b52f-e5c1-3d22-a016-e7c0816f6517",
                                                "text": "Sie haben Anschluss an den Zug nach Frankfurt von Gleis 6."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bad0fc3e-78a5-30ce-bdcf-5de9d244aa5f",
                                        "entry_id": "40dc2eda-5756-3f9b-9ee0-8f94317b2887",
                                        "glosses": [
                                            "Kontakt zu Menschen oder Gruppen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74ee3221-595f-430b-b431-35945f6fcb88",
                                                "sense_id": "bad0fc3e-78a5-30ce-bdcf-5de9d244aa5f",
                                                "text": "Du solltest den Anschluss suchen und nicht zu Hause vor dem Fernseher sitzen!"
                                            },
                                            {
                                                "example_id": "95687770-1623-404d-9040-588362d20461",
                                                "sense_id": "bad0fc3e-78a5-30ce-bdcf-5de9d244aa5f",
                                                "text": "„Seit 1920 in Berlin, fand Moholy-Nagy schnell Anschluss an die einschlägigen Künstlerkreise.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "35dd73a7-e9bc-36f6-aba3-2ceec27399f3",
                                        "entry_id": "40dc2eda-5756-3f9b-9ee0-8f94317b2887",
                                        "glosses": [
                                            "Vereinigung von Gebieten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0af3e0f-547c-4f33-8ac8-758e24ab011c",
                                                "sense_id": "35dd73a7-e9bc-36f6-aba3-2ceec27399f3",
                                                "text": "„Nach dem Anschluss an die preußische Provinz Hessen-Nassau 1929 bestanden die drei verbliebenen Kreise zunächst weiter.“"
                                            },
                                            {
                                                "example_id": "d4a9efbc-a48a-4dd4-9797-18f6467477da",
                                                "sense_id": "35dd73a7-e9bc-36f6-aba3-2ceec27399f3",
                                                "text": "„Am folgenden Tag, dem 11. März 1938, übernahm Hermann Göring per Telefon und Telegraph die Regie bei der Vorbereitung zum ‚Anschluss‘ Österreichs.“"
                                            },
                                            {
                                                "example_id": "d9e6af5e-5524-4a8b-90e5-ef0d0d365e6b",
                                                "sense_id": "35dd73a7-e9bc-36f6-aba3-2ceec27399f3",
                                                "text": "„Das größte Problem, das auf die Regierung zukam, war der Konflikt, der sich durch den Anschluss Kashmirs an Indien ergab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a62bb168-7410-31e7-b1d2-f7cb377f5c82",
                                        "entry_id": "40dc2eda-5756-3f9b-9ee0-8f94317b2887",
                                        "glosses": [
                                            "im Anschluss an: unmittelbar auf etwas folgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c6363de-5f78-4872-863f-02f7033f0959",
                                                "sense_id": "a62bb168-7410-31e7-b1d2-f7cb377f5c82",
                                                "text": "Im Anschluss an die Nachrichtensendung folgte der Wetterbericht."
                                            },
                                            {
                                                "example_id": "9b476e92-016b-4fa2-a632-6033e1ac70c1",
                                                "sense_id": "a62bb168-7410-31e7-b1d2-f7cb377f5c82",
                                                "text": "„Im Anschluss an die Tour nach Siglunes hatte Ari den Nachmittag mit Stefnir im Skigebiet verbracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
