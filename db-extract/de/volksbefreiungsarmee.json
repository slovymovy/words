                "senses": [
                    {
                        "sense_id": "835b2572-92f3-30ae-9551-266e20d78d1d",
                        "entry_id": "088c76a6-bc3c-38e0-85ea-73229c48fb18",
                        "glosses": [
                            "reguläre Streitkräfte der Volksrepublik China und das bewaffnete Organ der Kommunistischen Partei Chinas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ff1c7c2-9b67-47f8-82a6-587c4d35dbba",
                                "sense_id": "835b2572-92f3-30ae-9551-266e20d78d1d",
                                "text": "„Bei ihm waren Wu, Peng und zwei Soldaten der Volksbefreiungsarmee.“"
                            },
                            {
                                "example_id": "51836e0a-f298-46f3-9361-cd30ddb771be",
                                "sense_id": "835b2572-92f3-30ae-9551-266e20d78d1d",
                                "text": "„Vor einigen Wochen bekam ich die Information, dass das zweite Artilleriekorps der Volksbefreiungsarmee - das ist der Teil des chinesischen Militärs, der die Kontrolle über die Nuklearwaffen und die potenteren konventionellen Waffen hat - drei 6,5 Tonnen schwere thermobare Bomben zu dem Militärflughafen, der an diesen Zoo angrenzt, geschickt hat.“"
                            },
                            {
                                "example_id": "7b65e060-1465-4d26-83e6-aa69349380f1",
                                "sense_id": "835b2572-92f3-30ae-9551-266e20d78d1d",
                                "text": "„Fan besaß den Rang eines Sergeants der chinesischen Volksbefreiungsarmee, arbeitete jedoch als Computerprogrammierer und als einer von Chinas führenden Spezialisten für Cyberattacken.“"
                            },
                            {
                                "example_id": "5b99a0d5-570a-497e-b138-d981de0799ee",
                                "sense_id": "835b2572-92f3-30ae-9551-266e20d78d1d",
                                "text": "„‹Das Ministerium überlässt technische Details normalerweise der Volksbefreiungsarmee.›“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
