                                "sense_id": "f3a93227-96e3-3da6-9e6c-c531fababfcb",
                                "text": "Franchement, j'pourrais pas trop m'autonoter."
                            },
                            {
                                "example_id": "72017fae-ad29-4d3e-9e9d-b643f1deb7a9",
                                "sense_id": "f3a93227-96e3-3da6-9e6c-c531fababfcb",
                                "text": "Viens autonoter ton pseudo toi même"
