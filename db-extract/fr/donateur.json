                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "43a5ff69-ee43-454d-b722-a8cc6d82029e",
                        "entry_id": "32ffa88a-4667-3e5a-8e19-a27039131d79",
                        "tags": [
