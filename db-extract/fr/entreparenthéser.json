                "senses": [
                    {
                        "sense_id": "0cc0f2a0-9c22-367c-82a5-7396c14d027e",
                        "entry_id": "6b1cc6b9-b7a6-3e89-a257-f92c9e3897f4",
                        "glosses": [
                            "Mettre entre parenthèses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6a0f346-e9d1-4a71-9d10-2ca630bea5dd",
                                "sense_id": "0cc0f2a0-9c22-367c-82a5-7396c14d027e",
                                "text": "Le jour elle pèse, mais la nuit, elle entreparenthèse nos rêves d’un « je t’aime »."
                            },
                            {
                                "example_id": "f81daf09-0791-4e52-95d4-3ef4e7c3919d",
                                "sense_id": "0cc0f2a0-9c22-367c-82a5-7396c14d027e",
                                "text": "Panzer a décrit cette stupide bestiole dans le genre Carabus (comme c’était la mode à l'époque), il faut donc entreparenthéser son patronyme."
                            },
                            {
                                "example_id": "128bee7a-d46d-49ed-874c-72039cda0975",
                                "sense_id": "0cc0f2a0-9c22-367c-82a5-7396c14d027e",
                                "text": "Atila, dans un excès d’humour qui ne sied guère au sage à barbe blanche de cerclosophie, a cru bon d’entreparenthéser une réflexion blessante envers Manu : Manu rêverait de Verdâne....."
                            }
                        ]
                    }
                ],
