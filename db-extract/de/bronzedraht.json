                "senses": [
                    {
                        "sense_id": "a6160e46-2ff5-3967-8101-4d9700c6fae2",
                        "entry_id": "3889d0e7-e0ca-3d1c-bac7-c63321bf7888",
                        "glosses": [
                            "aus Bronze hergestellter Draht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35756f3b-79f4-4ffb-a479-93962879fb8d",
                                "sense_id": "a6160e46-2ff5-3967-8101-4d9700c6fae2",
                                "text": "Telefonmasten mit echten Bronzedrähten und Porzellanisolatoren können mittels Steigeisen bestiegen werden."
                            },
                            {
                                "example_id": "f74454ce-8e47-445a-abcd-32b046d0a1c8",
                                "sense_id": "a6160e46-2ff5-3967-8101-4d9700c6fae2",
                                "text": "„Gefragt sind Nickelanoden und Kupferlack, Chrom-Nickel- und Bronzedraht, Messingband sowie Messing-, Kupfer- und Alu-Schrott.“"
                            },
                            {
                                "example_id": "c0af7ee4-8f3f-4687-86d7-f79fe48885cd",
                                "sense_id": "a6160e46-2ff5-3967-8101-4d9700c6fae2",
                                "text": "„Reste eines frühmittelalterlichen Ohr- oder Haarrings aus Bronzedraht aus dem Grab eines Kindes.“"
                            },
                            {
                                "example_id": "134c6d26-2f60-4518-914c-5bc53dfee640",
                                "sense_id": "a6160e46-2ff5-3967-8101-4d9700c6fae2",
                                "text": "„Schuppenpanzer waren einfach und billig herzustellen, indem die einzelnen Schuppen aus Bronze- oder Eisenblech ausgeschnitten und mehrfach gelocht, überlappend mit Bronzedraht verbunden auf eine textile Unterlage aufgenäht wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
