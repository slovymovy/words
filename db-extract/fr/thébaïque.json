                                "sense_id": "f8807bce-6712-320a-a704-2a42dfcde6fb",
                                "text": "Pilules thébaïques."
                            },
                            {
                                "example_id": "bb5904c1-73e2-4963-b25b-43e2bf41caad",
                                "sense_id": "f8807bce-6712-320a-a704-2a42dfcde6fb",
                                "text": "L’usage, de plus en plus fréquent, des poisons chroniques, cocaïne, morphine, laudanum, extrait thébaïque, l’effrayait pour l’avenir."
                            },
                            {
                                "example_id": "1b618b20-819d-46bf-83ca-e3a84423a51d",
                                "sense_id": "f8807bce-6712-320a-a704-2a42dfcde6fb",
                                "text": "Il préparait de petites fioles de laudanum pur, et sous forme d’extrait thébaïque de morphine, d’acétate d’ammoniaque, d’éther."
                            }
                        ]
