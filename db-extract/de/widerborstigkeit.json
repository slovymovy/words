                "senses": [
                    {
                        "sense_id": "8b483611-92d7-3ce1-9b75-ac51eacfc853",
                        "entry_id": "604aadab-3335-39d3-9b0a-a5f9be28213f",
                        "glosses": [
                            "Eigenschaft oder Einstellung, nicht zu folgen, nicht bereit zu, sich zu fügen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "208334b1-d236-4a0b-bd66-4159d0656b50",
                                "sense_id": "8b483611-92d7-3ce1-9b75-ac51eacfc853",
                                "text": "„Warum ich mir diese Widerborstigkeit und Sturheit nicht abgewöhnt hatte, wusste ich nicht.“"
                            },
                            {
                                "example_id": "899ef430-9293-456a-81b7-d4259beebf73",
                                "sense_id": "8b483611-92d7-3ce1-9b75-ac51eacfc853",
                                "text": "„Ich war von ihrer Widerborstigkeit eher verärgert, als dass ich mir Sorgen machte.“"
                            },
                            {
                                "example_id": "e246dd6c-f569-4ec6-9d8f-f587711a8536",
                                "sense_id": "8b483611-92d7-3ce1-9b75-ac51eacfc853",
                                "text": "„Erst stolperte sie wegen ihrer Widerborstigkeit, aber weil er nicht nachgab, fügte sie sich schließlich.“"
                            },
                            {
                                "example_id": "c3970514-a2d9-48bd-bfc3-905a57125cc5",
                                "sense_id": "8b483611-92d7-3ce1-9b75-ac51eacfc853",
                                "text": "„Holz ist ein sehr schönes Material, aber bis es seine zärtliche Glätte erreicht hat, muß man sich und es durch alle Widerwärtigkeiten und Widerborstigkeiten quälen, da wird einem nichts geschenkt.“"
                            },
                            {
                                "example_id": "a439c3f0-3d97-4b31-a01a-b36f471a769f",
                                "sense_id": "8b483611-92d7-3ce1-9b75-ac51eacfc853",
                                "text": "„Sie allerdings habe sich kleinere Widerborstigkeiten durchaus »leisten können«, ohne ernsthafte Folgen befürchten zu müssen.“"
                            }
                        ],
