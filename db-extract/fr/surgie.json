                        ],
                        "examples": [
                            {
                                "example_id": "a5f49ae1-f7ec-4c05-bc11-c15fa78c2941",
                                "sense_id": "ca8edc85-1dd6-3e8e-bb17-682cab607c4d",
                                "text": "Il y avait une telle surgie d’amour et de respect chez ce petit être que Durtal béa d’admiration et gémit de peur."
                            },
                            {
                                "example_id": "3425e2df-94f4-4a99-bee6-de5b7e4b3f67",
                                "sense_id": "ca8edc85-1dd6-3e8e-bb17-682cab607c4d",
                                "text": "Ainsi s’explique probablement que la parodie, un genre textuel scientifiquement inadmissible, fasse une surgie dans des contrées dans lesquelles les guignols de l’information n’ont pas de pastiches."
                            },
                            {
                                "example_id": "e80121c7-f404-4fd2-805d-ee02aede729d",
                                "sense_id": "ca8edc85-1dd6-3e8e-bb17-682cab607c4d",
                                "text": "[…], toutes deux dramatisées par le discours polémique qui tente de faire vivre l’imminence eschatologique à travers la prise de conscience d'une surgie de la Bête remplie d'ordure et d’impiété, […]."
                            }
                        ]
                    }
