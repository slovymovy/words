                                "pl": "Pilot został uznany za <w>zaginionego w akcji</w>, gdy jego samolot zniknął z radaru."
                            }
                        },
                        {
                            "text": "Families of <w>MIA</w> soldiers gathered to honor their memory.",
                            "target_lang_translations": {
                                "ru": "Семьи солдат, <w>пропавших без вести</w>, собрались, чтобы почтить их память.",
                                "pl": "Rodziny żołnierzy <w>zaginionych w akcji</w> zebrały się, by uczcić ich pamięć."
                            }
                        }
                    ],
                    "common_phrases": [
                        "listed as MIA",
                        "reported MIA"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "initialism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пропавший без вести (военный термин).",
                        "pl": "Zaginiony w akcji (termin wojskowy)."
