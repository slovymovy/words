                "senses": [
                    {
                        "sense_id": "ddd2a42e-aea7-37ef-8ff7-edb43ebc55b3",
                        "entry_id": "97e4caf8-7e6c-3a37-8df1-b3cdcaea4308",
                        "glosses": [
                            "een Europees land ter hoogte van Wit-Rusland met de buurlanden Letland, Wit-Rusland, Polen en Rusland en de officiële naam de Republiek Litouwen (Lietuvos Respublika)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f8fee32-dbba-45c1-b1dc-0b63a281673c",
                                "sense_id": "ddd2a42e-aea7-37ef-8ff7-edb43ebc55b3",
                                "text": "Litouwen heeft de toelevering van gas uit Rusland volledig stopgezet. Daarmee is Litouwen het eerste EU-land dat niet langer Russisch gas importeert."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4783e71f-bdf9-4921-85d2-738c7222789c",
                        "source_entry_id": "97e4caf8-7e6c-3a37-8df1-b3cdcaea4308",
                        "source_sense_id": "ddd2a42e-aea7-37ef-8ff7-edb43ebc55b3",
                        "source_sense_description": "een Europees land ter hoogte van Wit-Rusland",
                        "target_lang_word": "Litauen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Litauen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9daacb47-fe0d-3c0f-822f-0c858b4153cd",
                                        "entry_id": "b0a589ba-c803-3e8d-b594-86b9daecc552",
                                        "glosses": [
                                            "zum Baltikum gehörender Staat in Nordeuropa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71f424ba-c02a-4564-8f40-f0da3dc31296",
                                                "sense_id": "9daacb47-fe0d-3c0f-822f-0c858b4153cd",
                                                "text": "Vilnius ist die Hauptstadt von Litauen."
                                            },
                                            {
                                                "example_id": "2222df5b-f58c-4464-905b-1e39085fee91",
                                                "sense_id": "9daacb47-fe0d-3c0f-822f-0c858b4153cd",
                                                "text": "„Das Klima in Litauen ist ein gemäßigtes Kontinentalklima.“"
                                            },
                                            {
                                                "example_id": "3c9c20e9-8f8b-4db9-8ed0-441f7e3a103a",
                                                "sense_id": "9daacb47-fe0d-3c0f-822f-0c858b4153cd",
                                                "text": "Mittlerweile zählt Ivanauskaite zu den bedeutendsten Stimmen der litauischen Gegenwartsliteratur, […] dessen gerade auf deutsch erschienener Roman \"Mobile Röntgenstation\" in das Litauen der 1960er Jahre zurückblendet."
                                            },
                                            {
                                                "example_id": "8a88ccc4-bc80-4af0-9b0d-07768a4f2729",
                                                "sense_id": "9daacb47-fe0d-3c0f-822f-0c858b4153cd",
                                                "text": "„Im Sommer 1944 eroberte die Rote Armee dann die von der Wehrmacht besetzten Teile Litauens zurück.“"
                                            },
                                            {
                                                "example_id": "c72bbebc-7d5c-4b85-bf8c-85d40a14152c",
                                                "sense_id": "9daacb47-fe0d-3c0f-822f-0c858b4153cd",
                                                "text": "„In Estland und Litauen entstanden auch Lokalposten: echte Bedarfsbriefe sind jedoch nur wenige bekannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f0983b1-6460-4117-935e-c724a273741d",
                        "source_entry_id": "97e4caf8-7e6c-3a37-8df1-b3cdcaea4308",
                        "source_sense_id": "ddd2a42e-aea7-37ef-8ff7-edb43ebc55b3",
