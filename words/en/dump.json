{
    "word_family": [
        "dumpy",
        "dumpster",
        "dumper",
        "dumping"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3b654b8d-f200-3d7e-91a3-73ec335afe9b",
                    "sense_definition": "To discard or get rid of something that is no longer wanted or needed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "discard_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was fined because they <w>dumped</w> toxic waste into the river.",
                            "target_lang_translations": {
                                "ru": "Компанию оштрафовали, потому что они <w>сбросили</w> токсичные отходы в реку.",
                                "zh": "该公司因向河中<w>倾倒</w>有毒废料而被罚款。"
                            }
                        },
                        {
                            "text": "You should <w>dump</w> the trash before it starts to smell.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит <w>выбросить</w> мусор, пока он не начал пахнуть.",
                                "zh": "你应该在垃圾发臭前把它<w>丢弃</w>掉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "discard",
                        "throw away",
                        "dispose of",
                        "chuck",
                        "toss",
                        "ditch",
                        "get rid of"
                    ],
                    "antonyms": [
                        "keep",
                        "retain"
                    ],
                    "common_phrases": [
                        "dump trash",
                        "dump waste",
                        "illegal dumping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Избавляться от чего-либо ненужного или выбрасывать это.",
                        "zh": "丢弃或处理掉不再需要的东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбрасывать",
                                "target_lang_sense_clarification": "избавляться от мусора или ненужных вещей"
                            },
                            {
                                "target_lang_word": "сваливать",
                                "target_lang_sense_clarification": "сбрасывать в кучу (часто о мусоре или отходах)"
                            },
                            {
                                "target_lang_word": "выкидывать",
                                "target_lang_sense_clarification": "разговорный синоним слова выбрасывать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "丢弃",
                                "target_lang_sense_clarification": "扔掉不需要的物品"
                            },
                            {
                                "target_lang_word": "倾倒",
                                "target_lang_sense_clarification": "大量地倒出垃圾或废弃物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "524b8e1a-8163-387e-8a8c-a2cd87f6f486",
                    "sense_definition": "To put something down or unload it in a careless or hurried way.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "place_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He came home tired and <w>dumped</w> his bag on the sofa.",
                            "target_lang_translations": {
                                "ru": "Он пришел домой уставшим и <w>бросил</w> сумку на диван.",
                                "zh": "他疲惫地回到家，把包<w>扔</w>在沙发上。"
                            }
                        },
                        {
                            "text": "The truck <w>dumped</w> a load of sand in the driveway.",
                            "target_lang_translations": {
                                "ru": "Грузовик <w>свалил</w> кучу песка на подъездной дорожке.",
                                "zh": "卡车在车道上<w>卸下</w>了一车沙子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drop",
                        "unload",
                        "deposit"
                    ],
                    "antonyms": [
                        "pick up"
                    ],
                    "common_phrases": [
                        "dump on the floor",
                        "dump a load"
                    ],
                    "target_lang_definitions": {
                        "ru": "Класть или сгружать что-либо небрежно или в спешке.",
                        "zh": "草率或匆忙地放下或卸下某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "класть что-то резко и небрежно"
                            },
                            {
                                "target_lang_word": "сваливать",
                                "target_lang_sense_clarification": "сгружать тяжелый груз или кучу вещей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扔",
                                "target_lang_sense_clarification": "随手放下或抛掷"
                            },
                            {
                                "target_lang_word": "卸下",
                                "target_lang_sense_clarification": "将货物或重物从车上卸下"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf17d0d3-d3ec-3774-8953-13b63b0d79c3",
                    "sense_definition": "To end a romantic relationship with someone, often abruptly.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "relationship_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>dumped</w> her boyfriend because he never listened to her.",
                            "target_lang_translations": {
                                "ru": "Она <w>бросила</w> своего парня, потому что он никогда её не слушал.",
                                "zh": "她<w>甩</w>了她的男朋友，因为他从不听她说话。"
                            }
                        },
                        {
                            "text": "I cannot believe he <w>dumped</w> me over a text message.",
                            "target_lang_translations": {
                                "ru": "Я не могу поверить, что он <w>бросил</w> меня через смс.",
                                "zh": "我真不敢相信他竟然通过短信把我<w>甩</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "break up with",
                        "leave",
                        "ditch"
                    ],
                    "common_phrases": [
                        "get dumped",
                        "dump a boyfriend",
                        "dump a girlfriend"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекратить романтические отношения с кем-либо, часто внезапно.",
                        "zh": "突然结束与某人的恋爱关系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "разрывать отношения с партнером"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "甩",
                                "target_lang_sense_clarification": "口语中指抛弃恋人"
                            },
                            {
                                "target_lang_word": "抛弃",
                                "target_lang_sense_clarification": "断绝关系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4d087c7-73cc-32f9-a08f-4bba359e65cf",
                    "sense_definition": "To sell goods in a foreign market at a price below their cost of production.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "business_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government accused the foreign manufacturer of <w>dumping</w> cheap steel.",
                            "target_lang_translations": {
                                "ru": "Правительство обвинило иностранного производителя в <w>демпинге</w> дешевой стали.",
                                "zh": "政府指控该外国制造商<w>倾销</w>廉价钢铁。"
                            }
                        },
                        {
                            "text": "Laws exist to prevent companies from <w>dumping</w> products to kill competition.",
                            "target_lang_translations": {
                                "ru": "Существуют законы, запрещающие компаниям <w>демпинговать</w> продукцией, чтобы уничтожить конкуренцию.",
                                "zh": "现行法律旨在防止公司通过<w>倾销</w>产品来扼杀竞争。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "anti dumping laws",
                        "dumping prices"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business/economics context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продавать товары на внешнем рынке по цене ниже себестоимости.",
                        "zh": "以低于生产成本的价格在国外市场销售商品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демпинговать",
                                "target_lang_sense_clarification": "искусственно занижать цены"
                            },
                            {
                                "target_lang_word": "сбрасывать",
                                "target_lang_sense_clarification": "быстро продавать товар по низкой цене"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倾销",
                                "target_lang_sense_clarification": "经济学中指低价抛售商品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dc629b4-5f41-34dc-b08b-72f8f6def469",
                    "sense_definition": "To copy or output data from a computer system's memory to another storage location.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician <w>dumped</w> the system logs to analyze the error.",
                            "target_lang_translations": {
                                "ru": "Техник <w>выгрузил</w> системные журналы для анализа ошибки.",
                                "zh": "技术员<w>转储</w>了系统日志以分析错误。"
                            }
                        },
                        {
                            "text": "You need to <w>dump</w> the database before running the update.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>сделать дамп</w> базы данных перед запуском обновления.",
                                "zh": "在运行更新之前，你需要对数据库进行<w>转储</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dump memory",
                        "dump data"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Копировать или выводить данные из памяти компьютерной системы в другое место хранения.",
                        "zh": "将计算机内存中的数据复制或输出到其他存储位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выгружать",
                                "target_lang_sense_clarification": "сохранять данные из памяти в файл"
                            },
                            {
                                "target_lang_word": "делать дамп",
                                "target_lang_sense_clarification": "создавать копию содержимого памяти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "转储",
                                "target_lang_sense_clarification": "计算机术语，指将内存数据导出"
                            },
                            {
                                "target_lang_word": "导出",
                                "target_lang_sense_clarification": "将数据从系统内存中保存出来"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "870b23ea-a5c0-3342-a593-94b46fcf5263",
                    "sense_definition": "A place where waste, garbage, or unwanted material is left.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "location_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We loaded the old furniture into the truck and took it to the <w>dump</w>.",
                            "target_lang_translations": {
                                "ru": "Мы погрузили старую мебель в грузовик и отвезли её на <w>свалку</w>.",
                                "zh": "我们把旧家具装上卡车，运到了<w>垃圾场</w>。"
                            }
                        },
                        {
                            "text": "The smell from the city <w>dump</w> can be awful in the summer.",
                            "target_lang_translations": {
                                "ru": "Запах с городской <w>свалки</w> летом может быть ужасным.",
                                "zh": "夏天城市<w>垃圾场</w>散发出的气味非常难闻。"
                            }
                        }
                    ],
                    "synonyms": [
                        "landfill",
                        "tip",
                        "rubbish heap"
                    ],
                    "common_phrases": [
                        "garbage dump",
                        "city dump",
                        "take to the dump"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, куда свозят отходы, мусор или ненужные материалы.",
                        "zh": "堆放垃圾或废弃物的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свалка",
                                "target_lang_sense_clarification": "специальное место для сбора мусора"
                            },
                            {
                                "target_lang_word": "помойка",
                                "target_lang_sense_clarification": "разговорное название места для мусора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "垃圾场",
                                "target_lang_sense_clarification": "专门处理垃圾的场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9c1c752-b8b7-3806-b4f8-10ed53fa1e35",
                    "sense_definition": "An unpleasant, dirty, or disreputable place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "location_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I refuse to stay in this hotel because it is a complete <w>dump</w>.",
                            "target_lang_translations": {
                                "ru": "Я отказываюсь оставаться в этом отеле, потому что это полная <w>дыра</w>.",
                                "zh": "我拒绝住在这家酒店，因为它简直是个<w>破烂地方</w>。"
                            }
                        },
                        {
                            "text": "Their old apartment was a <w>dump</w>, but they made it look nice.",
                            "target_lang_translations": {
                                "ru": "Их старая квартира была <w>помойкой</w>, но они привели её в порядок.",
                                "zh": "他们以前的公寓简直是个<w>破烂地方</w>，但他们把它收拾得很漂亮。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hovel",
                        "hole",
                        "pigsty"
                    ],
                    "antonyms": [
                        "palace"
                    ],
                    "common_phrases": [
                        "what a dump",
                        "live in a dump"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal and derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неприятное, грязное или пользующееся дурной славой место.",
                        "zh": "令人不快、肮脏或名声不好的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дыра",
                                "target_lang_sense_clarification": "плохое, убогое место (разговорное)"
                            },
                            {
                                "target_lang_word": "помойка",
                                "target_lang_sense_clarification": "очень грязное место (пренебрежительное)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "破烂地方",
                                "target_lang_sense_clarification": "形容环境极差的场所"
                            },
                            {
                                "target_lang_word": "脏乱差的地方",
                                "target_lang_sense_clarification": "形容环境恶劣"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e400e3d-2581-3f05-b737-348c8688597f",
                    "sense_definition": "An act of defecation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been in the bathroom taking a <w>dump</w> for twenty minutes.",
                            "target_lang_translations": {
                                "ru": "Он сидит в туалете и <w>срёт</w> уже двадцать минут.",
                                "zh": "他在厕所里<w>拉屎</w>已经二十分钟了。"
                            }
                        },
                        {
                            "text": "The dog took a <w>dump</w> right in the middle of the sidewalk.",
                            "target_lang_translations": {
                                "ru": "Собака наложила <w>кучу</w> прямо посреди тротуара.",
                                "zh": "那条狗直接在人行道中间<w>拉屎</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "take a dump"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт дефекации.",
                        "zh": "排便的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куча",
                                "target_lang_sense_clarification": "результат дефекации (грубое/разговорное)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉屎",
                                "target_lang_sense_clarification": "粗俗的排便表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a39ff46f-a240-339d-b275-a097e4ef0c3a",
                    "sense_definition": "A state of sadness or melancholy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has been down in the <w>dumps</w> since she lost her job.",
                            "target_lang_translations": {
                                "ru": "Она пребывает в <w>унынии</w> с тех пор, как потеряла работу.",
                                "zh": "自从失业后，她一直很<w>沮丧</w>。"
                            }
                        },
                        {
                            "text": "A sunny day usually helps to pull him out of the <w>dumps</w>.",
                            "target_lang_translations": {
                                "ru": "Солнечный день обычно помогает вытащить его из <w>тоски</w>.",
                                "zh": "晴朗的天气通常能帮他摆脱<w>郁闷</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "depression",
                        "blues",
                        "gloom"
                    ],
                    "common_phrases": [
                        "down in the dumps",
                        "in the dumps"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually used in the plural phrase 'in the dumps'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние грусти или меланхолии.",
                        "zh": "悲伤或忧郁的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уныние",
                                "target_lang_sense_clarification": "подавленное настроение"
                            },
                            {
                                "target_lang_word": "хандра",
                                "target_lang_sense_clarification": "скука и тоска"
                            },
                            {
                                "target_lang_word": "тоска",
                                "target_lang_sense_clarification": "глубокая грусть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沮丧",
                                "target_lang_sense_clarification": "情绪低落"
                            },
                            {
                                "target_lang_word": "郁闷",
                                "target_lang_sense_clarification": "心情不舒畅"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37e766a5-76ec-3baf-9afa-b20f8be04544",
                    "sense_definition": "A storage place for military supplies, such as ammunition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "location_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers were ordered to guard the ammunition <w>dump</w>.",
                            "target_lang_translations": {
                                "ru": "Солдатам приказали охранять <w>склад</w> боеприпасов.",
                                "zh": "士兵们奉命守卫弹药<w>仓库</w>。"
                            }
                        },
                        {
                            "text": "An explosion at the fuel <w>dump</w> destroyed several vehicles.",
                            "target_lang_translations": {
                                "ru": "Взрыв на топливном <w>складе</w> уничтожил несколько машин.",
                                "zh": "燃料<w>仓库</w>发生爆炸，摧毁了几辆车。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ammo dump",
                        "munitions dump",
                        "fuel dump"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "military context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Место хранения военных припасов, например, боеприпасов.",
                        "zh": "军事物资（如弹药）的储存地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склад",
                                "target_lang_sense_clarification": "место хранения припасов"
                            }
                        ],
                        "zh": [
