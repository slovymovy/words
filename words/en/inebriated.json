{
    "word_family": [
        "inebriate",
        "inebriation",
        "inebriety"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "687084f8-cea1-374f-9d54-1119d4276662",
                    "sense_definition": "Affected by alcohol to the point of losing control of physical or mental faculties",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer noticed that the driver appeared slightly <w>inebriated</w> after he failed the roadside sobriety test.",
                            "target_lang_translations": {
                                "ru": "Полицейский заметил, что водитель выглядел слегка <w>нетрезвым</w> после того, как тот провалил дорожный тест на трезвость."
                            }
                        },
                        {
                            "text": "He became visibly <w>inebriated</w> after drinking several glasses of strong wine during the wedding reception.",
                            "target_lang_translations": {
                                "ru": "Он стал заметно <w>пьян</w> после того, как выпил несколько бокалов крепкого вина во время свадебного приема."
                            }
                        }
                    ],
                    "synonyms": [
                        "drunk",
                        "intoxicated"
                    ],
                    "antonyms": [
                        "sober"
                    ],
                    "common_phrases": [
                        "visibly inebriated",
                        "slightly inebriated",
                        "highly inebriated"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся под воздействием алкоголя до такой степени, что теряется контроль над физическими или умственными способностями"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нетрезвый",
                                "target_lang_sense_clarification": "официальный или вежливый термин"
                            },
                            {
                                "target_lang_word": "пьяный",
                                "target_lang_sense_clarification": "общее состояние опьянения"
                            },
                            {
                                "target_lang_word": "в состоянии опьянения",
                                "target_lang_sense_clarification": "юридический или формальный контекст"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a5c6f417-f935-3649-925b-3a6a14c18ea6",
                    "sense_definition": "past tense and past participle of <w>inebriate</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong fumes from the chemical spill <w>inebriated</w> the workers before they could reach the safety exit.",
                            "target_lang_translations": {
                                "ru": "Сильные испарения от разлива химикатов <w>одурманили</w> рабочих прежде, чем они успели добраться до аварийного выхода."
                            }
                        },
                        {
                            "text": "The sudden success and fame <w>inebriated</w> the young artist, making him feel invincible for a short time.",
                            "target_lang_translations": {
                                "ru": "Внезапный успех и слава <w>опьянили</w> молодого художника, заставив его на короткое время почувствовать себя непобедимым."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени глагола «inebriate» — одурманивать, опьянять или приводить в состояние эйфории"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одурманил",
                                "target_lang_sense_clarification": "о воздействии паров или веществ"
                            },
                            {
                                "target_lang_word": "опьянил",
                                "target_lang_sense_clarification": "в переносном смысле (успехом, чувствами)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
