                "senses": [
                    {
                        "sense_id": "a79a864e-90f0-3a09-a524-db0c9906b503",
                        "entry_id": "00d7b8a0-6faf-3b06-8508-a1ee951a418a",
                        "glosses": [
                            "устар. небольшой диван с приподнятым изголовьем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a507cfa-2a99-49f7-bd5b-7114d2ef844e",
                                "sense_id": "a79a864e-90f0-3a09-a524-db0c9906b503",
                                "text": "Княгиня сидит на канапе, на которой стоит картон с лентами."
                            },
                            {
                                "example_id": "2e6311f4-94c4-4ebd-b6e1-4c10ec9fd7ee",
                                "sense_id": "a79a864e-90f0-3a09-a524-db0c9906b503",
                                "text": "Палицын взошёл в дом; .. в гостиной стояла свеча; эта комната была совершенно отделана во вкусе 18-го века: разноцветные обои, три круглые стола; перед каждым небольшое канапе .."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e287dea-6ad0-4b2b-8e06-849e89354f87",
                        "source_entry_id": "00d7b8a0-6faf-3b06-8508-a1ee951a418a",
                        "source_sense_id": "a79a864e-90f0-3a09-a524-db0c9906b503",
                        "source_sense_description": "небольшой диван",
                        "target_lang_word": "settee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "settee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba2502fb-2bca-3867-902f-e3bd7ee7ddc5",
                                        "entry_id": "5bf0c527-3719-3fbb-9e28-9f39fc629d64",
                                        "glosses": [
                                            "A long seat with a back, made to accommodate several persons at once; a sofa."
                                        ],
                                        "tags": [
                                            "Texas",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c92f380-e8f9-4f21-96cd-f7ef0bcf31a1",
                                                "sense_id": "ba2502fb-2bca-3867-902f-e3bd7ee7ddc5",
                                                "text": "The lounge was furnished in old English oak and big Knole settees. There were rugs from Tabriz and Kerman on the highly polished floor. […] A table lamp was fashioned from a silver Egyptian hookah."
                                            },
                                            {
                                                "example_id": "66ec73f5-7e73-4a50-aaf4-2975c445a21c",
                                                "sense_id": "ba2502fb-2bca-3867-902f-e3bd7ee7ddc5",
                                                "text": "“You might have to calm this down, my darling. I'm not sure this settee can take it.” “This settee has taken centuries of our love.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "settee",
                                "target_lang_code": "en",
                                "target_senses": [
