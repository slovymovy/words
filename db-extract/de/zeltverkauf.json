                "senses": [
                    {
                        "sense_id": "f1ed9130-c40c-35ec-a694-0918439c0c31",
                        "entry_id": "c78b398b-176b-3e95-8d07-56497ea934db",
                        "glosses": [
                            "temporäre Überdachung einer Fläche auf einem Firmengelände zum Zwecke des Angebots zu veräußernder Waren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc1c09ac-acb2-429c-9bdf-35c64bc91d12",
                                "sense_id": "f1ed9130-c40c-35ec-a694-0918439c0c31",
                                "text": "„Neu ist ein Zeltverkauf während der Monate März bis Juni.“"
                            },
                            {
                                "example_id": "4cd71340-b92f-4506-a099-91b70b99fc6c",
                                "sense_id": "f1ed9130-c40c-35ec-a694-0918439c0c31",
                                "text": "„Vom 6. bis 8. Juni ist ein Zeltverkauf vor dem Geschäft am Schweinemarkt.“"
                            },
                            {
                                "example_id": "cdabeef6-bede-4c84-972c-14dde2a8c5ec",
                                "sense_id": "f1ed9130-c40c-35ec-a694-0918439c0c31",
                                "text": "„Während der gesamten Zeitspanne der Aktion war eine stetig wachsende Schlange von Kunden zu beobachten, die den Zeltverkauf nutzten, um schnell, bequem und preisgünstig einzukaufen.“"
                            },
                            {
                                "example_id": "e924b6fc-887c-45c8-bf42-27f58e6fb3f8",
                                "sense_id": "f1ed9130-c40c-35ec-a694-0918439c0c31",
                                "text": "„Der Betrieb führte einen Zeltverkauf durch, bei dem nur Altbestände angeboten wurden.“"
                            },
                            {
                                "example_id": "0032212f-6037-4bf7-b843-bfbf18f48d02",
                                "sense_id": "f1ed9130-c40c-35ec-a694-0918439c0c31",
                                "text": "„Der Zeltverkauf wird einmalig sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
