                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be88347e-974b-418f-8a64-c08c2f6cf5d4",
                                "sense_id": "5985b40f-2389-3159-894a-11a44985da17",
                                "text": "Zaangażowanie w europejskie wojny religijne zahamowało rozwój anabaptyzmu"
