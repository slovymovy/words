                        "examples": [
                            {
                                "example_id": "5ef79dbc-0e7b-4fb9-b8e5-80c0d6e78791",
                                "sense_id": "c0c0f2b8-2e25-355a-8ebc-c42e28ddff4f",
                                "text": "Pete Coleman war 22 Jahre lang Bernhard Langers Caddie."
                            }
                        ],
                        "sense_index_json": "\"1\""
