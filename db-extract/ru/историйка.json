                    {
                        "translation_id": "26de43af-b352-4312-b112-e1a55f5fca9b",
                        "source_entry_id": "1484a6e5-99a1-342c-b6bc-a63e6865bf70",
                        "source_sense_description": "ласк. к сущ. история в значении «рассказ, повествование»",
                        "target_lang_word": "short story",
