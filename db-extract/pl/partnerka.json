                "translations": [
                    {
                        "translation_id": "4771521f-46bd-4800-a85b-ddd0fb47df14",
                        "source_entry_id": "3d148e0e-e9b4-3ddd-8eeb-a3c86c984373",
                        "source_sense_id": "bb7d5d52-973e-3684-862b-f5e6a8b69f76",
                        "source_sense_description": "Partnerin",
                        "target_lang_word": "Partnerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Partnerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c5c159b-4a7f-3b7c-b4ac-f2688c4e9bcf",
                                        "entry_id": "e0bc6390-f5eb-3fef-adde-cd7b2f6068e9",
                                        "glosses": [
                                            "weibliche Person oder Institution, die gemeinsam mit anderen ein Ziel verfolgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f141c6be-8001-4c82-aecc-50963e70c9a5",
                                                "sense_id": "0c5c159b-4a7f-3b7c-b4ac-f2688c4e9bcf",
                                                "text": "Sie betreibt ihr Geschäft gemeinsam mit einer Partnerin."
                                            },
                                            {
                                                "example_id": "9da136de-9ba7-4290-ac40-ba51eb5b05c8",
                                                "sense_id": "0c5c159b-4a7f-3b7c-b4ac-f2688c4e9bcf",
                                                "text": "„Helga Stier ist vom Charakter her weder naiv noch sentimental, sie ist eine clevere, als Partnerin ihres Mannes sogar eine harte Geschäftsfrau.“"
                                            },
                                            {
                                                "example_id": "4f16acc4-190e-4e69-b0ec-36796eca33f9",
                                                "sense_id": "0c5c159b-4a7f-3b7c-b4ac-f2688c4e9bcf",
                                                "text": "„Im letzten Jahr auf der Highschool gingen Philip und Marty Weich mit Betty Rogow und Joan Gelfman, zwei hübschen Cousinen, aus; die beiden waren auch ihre Partnerinnen beim Abschlussball.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "06f510bd-5c4c-3967-b36f-cef15806404f",
                                        "entry_id": "e0bc6390-f5eb-3fef-adde-cd7b2f6068e9",
                                        "glosses": [
                                            "weibliche Person, die in einer festen Beziehung ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e4a651d-0350-40ad-ae72-2acb7f4b4f89",
                                                "sense_id": "06f510bd-5c4c-3967-b36f-cef15806404f",
                                                "text": "Er ist kürzlich in die Wohnung seiner neuen Partnerin umgezogen."
                                            },
                                            {
                                                "example_id": "570b15ca-aa78-4f00-882d-08d49146ae9b",
                                                "sense_id": "06f510bd-5c4c-3967-b36f-cef15806404f",
                                                "text": "„Demnach ist eine robuste Person beim Liebeskampf entschieden einem zarten, zierlichen, ängstlichen Geschöpf als Partnerin vorzuziehen.“"
                                            },
                                            {
                                                "example_id": "c070bd6a-58df-444c-8212-a400e9992612",
                                                "sense_id": "06f510bd-5c4c-3967-b36f-cef15806404f",
                                                "text": "„Remarque fühlt sich häufig in diesen Beziehungen gedemütigt und kann doch nicht loslassen, bleibt Jahre an seine Partnerinnen gefesselt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
