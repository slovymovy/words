        "fr-extract.jsonl": [
            {
                "entry_id": "d6c25930-4010-3eb6-804f-77bfab2d753f",
                "word": "solipsisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cffbca41-b9c8-4bb8-8661-2bbb1b2b5f87",
                        "entry_id": "d6c25930-4010-3eb6-804f-77bfab2d753f",
                        "tags": [
                            "plural"
                        ],
                        "form": "solipsismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99e927ae-c8c0-3ffd-8955-e7458036e201",
                        "entry_id": "d6c25930-4010-3eb6-804f-77bfab2d753f",
                        "glosses": [
                            "Attitude du sujet pensant pour qui sa conscience propre est l’unique réalité, les autres consciences, le monde extérieur n’étant que des représentations."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ae423db7-174c-39ca-9537-cd5603d985ed",
                        "entry_id": "d6c25930-4010-3eb6-804f-77bfab2d753f",
                        "glosses": [
                            "Idéalisme limite d’après lequel il n’y aurait, pour le sujet pensant, d’autre réalité que lui-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f869d479-437e-4a4b-8083-85f195d773d3",
                                "sense_id": "ae423db7-174c-39ca-9537-cd5603d985ed",
                                "text": "Les notions de souverainité de l'individu et de propriété de soi semblent exclure tout rapport à autrui et devoir conduire à un solipsisme radical ou à un individualisme atomiste."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e06f053-aaab-36f6-8ca0-82d8abd992f1",
                        "entry_id": "d6c25930-4010-3eb6-804f-77bfab2d753f",
                        "glosses": [
                            "Caractère d’une personne, d’un univers de pensée qui est entièrement centré sur soi, hors de toute décision philosophique."
                        ],
                        "tags": [
                            "broadly",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "ab3c6cfc-777f-4c9e-942d-1bc83b7909d8",
                                "sense_id": "1e06f053-aaab-36f6-8ca0-82d8abd992f1",
                                "text": "Très tôt j’ai souffert de solipsisme, c’est dire que j’ai perdu dès l’âge de douze ans toute croyance en la réalité du monde extérieur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "738db091-942c-4645-a09a-517279a6e840",
                        "source_entry_id": "d6c25930-4010-3eb6-804f-77bfab2d753f",
                        "source_sense_description": "Philosophie",
                        "target_lang_word": "solipsism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
