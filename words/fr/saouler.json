                {
                    "sense_id": "ee312f2b-3c06-3fa3-ac9c-f3790b9eb372",
                    "sense_definition": "Rendre ivre par une consommation excessive de boissons alcoolisées.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la fête, ils ont bu beaucoup de bière jusqu'à se <w>saouler</w>.",
                            "target_lang_translations": {
                                "en": "During the party, they drank a lot of beer until they <w>got</w> <w>drunk</w>.",
                                "ru": "Во время праздника они выпили много пива, пока не <w>напились</w>.",
                                "de": "Während der Feier tranken sie viel Bier, bis sie <w>sich betranken</w>.",
                                "es": "Durante la fiesta bebieron mucha cerveza hasta <w>emborracharse</w>.",
                                "zh": "聚会期间，他们喝了很多啤酒，直到把自己<w>灌醉</w>为止。"
                            }
                        },
                        {
                            "text": "Ce vin rouge est très fort et risque de te <w>saouler</w> rapidement.",
                            "target_lang_translations": {
                                "en": "This red wine is very strong and could <w>make</w> you <w>drunk</w> quickly.",
                                "ru": "Это красное вино очень крепкое и может быстро тебя <w>опьянить</w>.",
                                "de": "Dieser Rotwein ist sehr stark und könnte dich schnell <w>berauschen</w>.",
                                "es": "Este vino tinto es muy fuerte y te podría <w>emborrachar</w> rápidamente.",
                                "zh": "这种红酒很烈，可能很快就会把你<w>灌醉</w>。"
                            }
                        }
