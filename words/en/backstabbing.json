{
    "word_family": [
        "backstab",
        "backstabber"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc030f65-7127-3acb-8a13-384f48e11d5f",
                    "sense_definition": "The act of betraying someone who trusts you, especially by speaking ill of them behind their back.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "betrayal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The office environment was toxic due to constant <w>backstabbing</w> among the employees.",
                            "target_lang_translations": {
                                "es": "El ambiente de la oficina era tóxico debido a las constantes <w>puñaladas por la espalda</w> entre los empleados."
                            }
                        },
                        {
                            "text": "She was tired of the <w>backstabbing</w> and decided to find a new group of friends.",
                            "target_lang_translations": {
                                "es": "Estaba cansada de las <w>traiciones</w> y decidió buscar un nuevo grupo de amigos."
                            }
                        }
                    ],
                    "synonyms": [
                        "betrayal",
                        "treachery",
                        "double-crossing"
                    ],
                    "antonyms": [
                        "loyalty",
                        "faithfulness"
                    ],
                    "common_phrases": [
                        "office backstabbing",
                        "constant backstabbing"
                    ],
                    "target_lang_definitions": {
                        "es": "El acto de traicionar a alguien que confía en ti, especialmente hablando mal de esa persona a sus espaldas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "traición",
                                "target_lang_sense_clarification": "acto general de deslealtad"
                            },
                            {
                                "target_lang_word": "puñalada por la espalda",
                                "target_lang_sense_clarification": "expresión idiomática para una traición inesperada"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "193628e4-4458-37d6-8c83-6709aeff96ac",
                    "sense_definition": "Present participle and gerund of <w>backstab</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "betrayal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was caught <w>backstabbing</w> his business partner to gain a promotion.",
                            "target_lang_translations": {
                                "es": "Lo atraparon <w>traicionando</w> a su socio comercial para obtener un ascenso."
                            }
                        },
                        {
                            "text": "Stop <w>backstabbing</w> your colleagues if you want to build a good reputation.",
                            "target_lang_translations": {
                                "es": "Deja de <w>dar puñaladas por la espalda</w> a tus colegas si quieres construir una buena reputación."
                            }
                        }
                    ],
                    "synonyms": [
                        "betraying",
                        "double-crossing"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb backstab."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Forma verbal que indica la acción de traicionar a alguien de manera desleal."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "traicionando",
                                "target_lang_sense_clarification": "gerundio del verbo traicionar"
                            },
                            {
                                "target_lang_word": "dando puñaladas por la espalda",
                                "target_lang_sense_clarification": "expresión idiomática para el acto de traicionar"
                            }
                        ]
                    }
                }
            ]
        }
    ]
