                "entry_id": "db132b88-7989-3f28-87a0-e0c68a98928d",
                "word": "verkerven",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "76383794-058b-3ff7-9688-8818eb6bc8ec",
                        "entry_id": "db132b88-7989-3f28-87a0-e0c68a98928d",
                        "glosses": [
                            "ervoor zorgen dat iets wat aanvankelijk goed was, nu slecht en lelijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f7c75c3-c1c0-42c5-81ca-cbe8a8ecc961",
                                "sense_id": "76383794-058b-3ff7-9688-8818eb6bc8ec",
                                "text": "'Maar daar wou ik het nu niet over hebben' keert als een refrein gedurig terug in het eerste deel van de vertelling. Een schrijver die zo begint, moet al heel lelijk doen om het bij mij nog te verkerven"
                            },
                            {
                                "example_id": "e1aea0f5-4c5e-4100-83b6-c892b70b29ab",
                                "sense_id": "76383794-058b-3ff7-9688-8818eb6bc8ec",
                                "text": "Als je iemand goed behandelde, mocht je verwachten dat die persoon iets zou terugdoen. Maar wat, waar of wanneer, dat was nooit zeker. ,,Swijgen daarom op alles stil nam Willem Frederik zich voor ,,ende laeten sich alles welgevallen watter geschiedt, of men soll de kans verkerven."
                            }
                        ]
                    }
