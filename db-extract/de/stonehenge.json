                "senses": [
                    {
                        "sense_id": "2613ce9c-70c3-3319-aac9-e8a38a574899",
                        "entry_id": "a247dcee-4674-32f4-bbfa-b2e897faa73c",
                        "glosses": [
                            "jungsteinzeitliches Bauwerk in England, das aus einem ringförmigen Erdwall besteht, in dessen Innerem mehrere große, bearbeitete Steine stehen und das mutmaßlich als Kultstätte diente"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12800c4d-3668-4bb2-9426-629d33f2f149",
                                "sense_id": "2613ce9c-70c3-3319-aac9-e8a38a574899",
                                "text": "„Einst, so besagte die Legende, stand er in dem unheimlichen Monolithenkreis von Stonehenge, doch dann wurden seine Verehrer von den Pfeilen und Bogen der Pikten wie die Spreu im Wind in alle Richtungen verstreut.“"
                            },
                            {
                                "example_id": "60740a62-f9e5-465a-a671-1fe8577fad8c",
                                "sense_id": "2613ce9c-70c3-3319-aac9-e8a38a574899",
                                "text": "„So rätselhaft wie die Ursprünge von Stonehenge bleibt, wo sie solche Teile mit den Mustern jener längst vergangenen Zeit überhaupt auftreibt, noch dazu in ihrer Größe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
