    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "64f8e5bf-73f2-3680-bfcf-bac42b841b96",
                "word": "drüben",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9ed3959a-ab69-3db8-a56b-dd213245de0d",
                        "entry_id": "64f8e5bf-73f2-3680-bfcf-bac42b841b96",
                        "glosses": [
                            "over (implying some distance from the listener)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b51e773d-4f94-4cab-bd5a-ef6a677c072d",
                                "sense_id": "9ed3959a-ab69-3db8-a56b-dd213245de0d",
                                "text": "Ich bin's. Hier drüben!",
                                "translation": "It's me. Over here!",
                                "english": "It's me. Over here!"
                            }
                        ]
                    },
                    {
                        "sense_id": "382765ae-fb86-378a-b32d-de374915c177",
                        "entry_id": "64f8e5bf-73f2-3680-bfcf-bac42b841b96",
                        "glosses": [
                            "over there"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b24d243f-c864-4d8c-a6a8-f0c2f26d71d0",
                                "sense_id": "382765ae-fb86-378a-b32d-de374915c177",
                                "text": "Drüben auf dem Hügel möchte ich warten / Im nassen Gras in unserem Schrebergarten"
                            }
                        ]
                    },
                    {
                        "sense_id": "7d91835f-6a7f-335b-90e8-32a1f722931e",
                        "entry_id": "64f8e5bf-73f2-3680-bfcf-bac42b841b96",
                        "glosses": [
                            "beyond, on the other side (of some implied line)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae745352-9636-49f0-9cd8-e1375578cc6d",
                                "sense_id": "7d91835f-6a7f-335b-90e8-32a1f722931e",
                                "text": "Hier war das Niemandsland: drüben auf der Höhe lagen die Deutschen, hüben die Franzosen – dies war unbesetzt.\nHere was the no man's land; on that side on the height were the Germans, on the other side the French – this itself was unoccupied."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c72632f-9698-3210-b6d6-ef64f5a0fd0c",
                        "entry_id": "64f8e5bf-73f2-3680-bfcf-bac42b841b96",
                        "glosses": [
                            "on the other side of the Iron Curtain; (western perspective) in East Germany, (eastern perspective) in West Germany"
                        ],
                        "tags": [
                            "historical",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "aa739c0f-daab-4f42-8683-181f1f21b227",
                                "sense_id": "8c72632f-9698-3210-b6d6-ef64f5a0fd0c",
                                "text": "Guten Tag, ich bin Gerti aus der DDR / Drüben war ich ein großer Star / Jetzt hab ich ’nen westdeutschen Plattenvertrag / Denn drüben, da macht man ja doch keine Mark"
                            },
                            {
                                "example_id": "189c4faf-3b64-43f1-ae5b-32ca3b110b6e",
                                "sense_id": "8c72632f-9698-3210-b6d6-ef64f5a0fd0c",
                                "text": "Das zweite Soloprogramm „Ohne Proben nach oben“ folgt. Extra für seine Auftritte in den neuen Bundesländern trägt es den Alternativtitel „Ohne üben nach drüben“."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
