                {
                    "sense_id": "2ffcf6c5-815a-336c-80ce-b8cd431bdd3d",
                    "sense_definition": "The biological process by which the body breaks down food into substances that can be absorbed and used.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eating too quickly can cause poor <w>digestion</w> and stomach pain. ",
                            "target_lang_translations": {
                                "ru": "Слишком быстрая еда может привести к плохому <w>пищеварению</w> и боли в желудке."
                            }
                        },
                        {
                            "text": "Drinking a lot of water throughout the day aids in healthy <w>digestion</w>.",
                            "target_lang_translations": {
                                "ru": "Употребление большого количества воды в течение дня способствует здоровому <w>пищеварению</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "healthy digestion",
                        "aid digestion",
                        "poor digestion"
                    ],
                    "target_lang_definitions": {
