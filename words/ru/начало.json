    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63f6f827-4f99-3927-989c-af5e3f4954ce",
                    "sense_definition": "Первый момент или период времени, с которого начинается какое-либо действие, явление или существование.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "start_origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы опоздали на <w>начало</w> фильма из-за пробок.",
                            "target_lang_translations": {
                                "en": "We were late for the <w>beginning</w> of the movie because of traffic.",
                                "zh": "因为交通堵塞，我们错过了电影的<w>开始</w>。"
                            }
                        },
                        {
                            "text": "В самом <w>начале</w> года мы планируем поехать в отпуск.",
                            "target_lang_translations": {
                                "en": "At the very <w>beginning</w> of the year, we plan to go on vacation.",
                                "zh": "我们在年初<w>开始</w>的时候计划去度假。"
                            }
                        }
                    ],
                    "synonyms": [
                        "старт"
                    ],
                    "antonyms": [
                        "коне́ц",
                        "окончание"
                    ],
                    "common_phrases": [
                        "в самом начале",
                        "начало года",
                        "положить начало",
                        "хорошее начало"
                    ],
                    "target_lang_definitions": {
                        "en": "The first part or earliest stage of an event, action, or period of time.",
                        "zh": "某事、某动作或某段时间的最初部分或阶段。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beginning",
                                "target_lang_sense_clarification": "the initial part or time of something"
                            },
                            {
                                "target_lang_word": "start",
                                "target_lang_sense_clarification": "the point at which something begins"
                            },
                            {
                                "target_lang_word": "commencement",
                                "target_lang_sense_clarification": "formal term for beginning"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开始",
                                "target_lang_sense_clarification": "事物发展的起始阶段"
                            },
                            {
                                "target_lang_word": "开端",
                                "target_lang_sense_clarification": "事情的起头"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c71a1804-4038-37da-8387-a135d614ba1e",
                    "sense_definition": "Исходная точка, источник или первопричина чего-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "start_origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта горная река берёт своё <w>начало</w> в ледниках.",
                            "target_lang_translations": {
                                "en": "This mountain river has its <w>source</w> in the glaciers.",
                                "zh": "这条山河发源于冰川，是它的<w>源头</w>。"
                            }
                        },
                        {
                            "text": "Конфликт имеет давнее <w>начало</w>, уходящее в прошлое.",
                            "target_lang_translations": {
                                "en": "The conflict has an ancient <w>origin</w>, going back into the past.",
                                "zh": "这场冲突有着久远的<w>起源</w>，可以追溯到过去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "осно́ва",
                        "почи́н"
                    ],
                    "antonyms": [
                        "коне́ц"
                    ],
                    "common_phrases": [
                        "брать начало",
                        "вести начало"
                    ],
                    "target_lang_definitions": {
                        "en": "The point of origin, source, or primary cause from which something arises.",
                        "zh": "某事物的起源、源头或根本原因。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "source",
                                "target_lang_sense_clarification": "place where a river or stream begins"
                            },
                            {
                                "target_lang_word": "origin",
                                "target_lang_sense_clarification": "the point where something comes into existence"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "源头",
                                "target_lang_sense_clarification": "河流或事物的发源地"
                            },
                            {
                                "target_lang_word": "起源",
                                "target_lang_sense_clarification": "事物产生的根源"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d39b4d4-b0c6-37a7-895b-aaa81c22db8f",
                    "sense_definition": "Основные положения, принципы или теоретические основы какой-либо науки или деятельности (обычно во множественном числе).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "principles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студенты внимательно изучали <w>начала</w> термодинамики.",
                            "target_lang_translations": {
                                "en": "The students carefully studied the <w>principles</w> of thermodynamics.",
                                "zh": "学生们认真学习了热力学的基本<w>原理</w>。"
                            }
                        },
                        {
                            "text": "Он согласился работать в клубе на общественных <w>началах</w>.",
                            "target_lang_translations": {
                                "en": "He agreed to work at the club on a voluntary <w>basis</w>.",
                                "zh": "他同意以志愿者的<w>基础</w>在俱乐部工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "осно́ва"
                    ],
                    "common_phrases": [
                        "на общественных началах",
                        "начала геометрии"
                    ],
                    "target_lang_definitions": {
                        "en": "Fundamental rules, principles, or theoretical foundations of a subject or activity.",
                        "zh": "学科或活动的根本规则、原则或理论基础。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "principles",
                                "target_lang_sense_clarification": "fundamental truths or propositions"
                            },
                            {
                                "target_lang_word": "basis",
                                "target_lang_sense_clarification": "underlying support or terms of agreement"
                            },
                            {
                                "target_lang_word": "basics",
                                "target_lang_sense_clarification": "essential facts or principles"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "原理",
                                "target_lang_sense_clarification": "科学或活动的根本道理"
                            },
                            {
                                "target_lang_word": "基础",
                                "target_lang_sense_clarification": "事物发展的根基"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74946bc9-661d-389a-ac86-f8b2aca5e476",
                    "sense_definition": "Руководство, управление или главенство над кем-либо или чем-либо.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Молодые солдаты служили под <w>началом</w> опытного офицера.",
                            "target_lang_translations": {
                                "en": "The young soldiers served under the <w>command</w> of an experienced officer.",
                                "zh": "年轻的士兵们在一位经验丰富的军官<w>领导</w>下服役。"
                            }
                        },
                        {
                            "text": "Весь отдел перешёл под его непосредственное <w>начало</w>.",
                            "target_lang_translations": {
                                "en": "The entire department came under his direct <w>command</w>.",
                                "zh": "整个部门都转到了他的直接<w>指挥</w>之下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "руково́дство",
                        "главенство"
                    ],
                    "common_phrases": [
                        "под началом"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used to denote leadership or command context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Authority, control, or leadership over others.",
                        "zh": "对他人或事物的权威、控制或领导。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "command",
                                "target_lang_sense_clarification": "authority or control, especially military"
                            },
                            {
                                "target_lang_word": "leadership",
                                "target_lang_sense_clarification": "the action of leading a group"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "领导",
                                "target_lang_sense_clarification": "指挥或带领他人"
                            },
                            {
                                "target_lang_word": "指挥",
                                "target_lang_sense_clarification": "军事或组织上的统领"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc6fa374-f27f-3521-80de-62cada550b7e",
                    "sense_definition": "Форма прошедшего времени среднего рода единственного числа глагола <w>начать</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Яркое солнце <w>начало</w> медленно садиться за горизонт.",
                            "target_lang_translations": {
                                "en": "The bright sun <w>began</w> to set slowly behind the horizon.",
                                "zh": "明亮的太阳<w>开始</w>慢慢落入地平线。"
                            }
                        },
                        {
                            "text": "Всё вокруг <w>начало</w> меняться с приходом весны.",
                            "target_lang_translations": {
                                "en": "Everything around <w>started</w> to change with the arrival of spring.",
                                "zh": "随着春天的到来，周围的一切都<w>开始</w>发生变化。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past tense neuter singular form of the verb 'to begin' or 'to start'.",
                        "zh": "动词“开始”的过去式中性单数形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "began",
                                "target_lang_sense_clarification": "past tense of begin"
                            },
                            {
                                "target_lang_word": "started",
                                "target_lang_sense_clarification": "past tense of start"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开始",
                                "target_lang_sense_clarification": "动作的起始"
                            }
                        ]
                    }
                }
            ]
        }
    ]
