                        "sense_id": "8331e7da-02ee-3aed-8e2c-6ee75286ac10",
                        "entry_id": "23cb1f2f-da46-3ec5-b694-1b67136360d1",
                        "glosses": [
                            "emphatic (of or pertaining to a series of obstruent consonants in several Semitic languages, are distinguished from both voiced and voiceless consonants by a certain phonetic feature or features, either pharyngealised or ejective)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db627a2c-ce41-452c-8535-6b504be16cf6",
                                "sense_id": "8331e7da-02ee-3aed-8e2c-6ee75286ac10",
                                "text": "De emfatische medeklinkers vonden de leerlingen bijzonder lastig om uit te spreken.",
                                "translation": "The pupils thought that the emphatic consonants were particularly difficult to pronounce.",
                                "english": "The pupils thought that the emphatic consonants were particularly difficult to pronounce."
                            }
                        ]
                    }
