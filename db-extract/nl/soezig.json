                                "example_id": "c70b3747-b2e0-45a1-a7e9-d7beb3fe8468",
                                "sense_id": "8b781123-076b-359d-bfdf-71275118ff98",
                                "text": "Hij treft Schmidt aan in het souterrain van haar huis aan de Vossiusstraat in Amsterdam, ‘helemaal soezig van de witte wijn’, tevreden luisterend naar muziek."
                            }
                        ]
                    }
