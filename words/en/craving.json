                            },
                            {
                                "target_lang_word": "verlangend naar",
                                "target_lang_sense_clarification": "het hebben van een intens verlangen"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "toužící po",
                                "target_lang_sense_clarification": "vyjadřující silnou touhu"
                            },
                            {
                                "target_lang_word": "bažící po",
                                "target_lang_sense_clarification": "vyjadřující intenzivní potřebu"
