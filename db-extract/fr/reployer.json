                ],
                "senses": [
                    {
                        "sense_id": "456fa269-28a2-3c1f-b0c5-584260b80fd4",
                        "entry_id": "27d0bafd-3dd3-3f07-acaf-2359c35d5c89",
                        "glosses": [
                            "Ployer de nouveau."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0f3bb86a-e40a-31ca-9b33-2a1297a8cf7b",
                        "entry_id": "27d0bafd-3dd3-3f07-acaf-2359c35d5c89",
                        "glosses": [
                            "Replier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff86cd79-58a4-45e6-a28e-ddc035d8478c",
                                "sense_id": "0f3bb86a-e40a-31ca-9b33-2a1297a8cf7b",
                                "text": "Elle avait reployé ses talons sous elle et se tenait accroupie sur le bord de la couchette dans une position pleine de coquetterie nonchalante."
                            },
                            {
                                "example_id": "0c468935-618e-4c61-9198-52c0df221abd",
                                "sense_id": "0f3bb86a-e40a-31ca-9b33-2a1297a8cf7b",
                                "text": "Le bras gauche de Galswinthe, reployé, serrait les longues tiges des iris mauves qu’elle venait de cueillir."
                            },
                            {
                                "example_id": "20c52bde-14b7-4e31-b565-cce14372038f",
                                "sense_id": "0f3bb86a-e40a-31ca-9b33-2a1297a8cf7b",
                                "text": "Il considéra, stupide, le ciré qui se levait lentement, étendait les bras : elle le tenait droit avant de le reployer."
                            },
                            {
                                "example_id": "5a81549e-fed5-4f5d-857c-6c129bacc9a4",
                                "sense_id": "0f3bb86a-e40a-31ca-9b33-2a1297a8cf7b",
                                "text": "Maman dormait, assise devant la table, la tête dans son bras reployé."
                            }
                        ]
                    }
                ],
