{
    "word": "skivvy",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8635b32a-ac5b-366f-94ec-2543c452058b",
                "word": "skivvy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "75b2e929-083e-4ba8-8537-f6f0b8079684",
                        "entry_id": "8635b32a-ac5b-366f-94ec-2543c452058b",
                        "tags": [
                            "plural"
                        ],
                        "form": "skivvies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "85c6cee8-f89f-3512-8010-edac4ed880c5",
                        "entry_id": "8635b32a-ac5b-366f-94ec-2543c452058b",
                        "glosses": [
                            "A female domestic servant, especially one employed for menial work."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "106be4bb-4cec-4d31-8358-99ec6d8a733c",
                                "sense_id": "85c6cee8-f89f-3512-8010-edac4ed880c5",
                                "text": "And then Somerset looked at the boys′ skivvy, and saw a well set up young woman with a red round face, an angry face just then but underneath the anger a pleasant one."
                            },
                            {
                                "example_id": "9b612f19-7ffc-40e4-ab64-d987cad7a79e",
                                "sense_id": "85c6cee8-f89f-3512-8010-edac4ed880c5",
                                "text": "2002, Krzysztof Miklaszewski, George M. Hyde (translator, editor), Encounters with Tadeusz Kantor, page 143,\nThe common skivvy from the mortuary clings immoveably to the priest′s bed, which is just as immoveably guarded by the grandmother, who drives her off with a chamberpot. The skivvy is the photographer′s widow, trying to take a picture."
                            },
                            {
                                "example_id": "9764aec3-688e-4cb8-b477-08d2197a24fc",
                                "sense_id": "85c6cee8-f89f-3512-8010-edac4ed880c5",
                                "text": "“[…]Yes, that was Mac′s Restaurant and I was a kitchen skivvy there, but amazingly, a kitchen skivvy who had actually written a poem. Oh it′s all a very long time ago, Theresa, and so much has happened since then.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "bffdc04b-736c-3a95-9fce-c2abb90b9fb5",
                        "entry_id": "8635b32a-ac5b-366f-94ec-2543c452058b",
                        "glosses": [
                            "A prostitute."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ca109f8d-195c-309d-8635-2324faccf9b5",
                        "entry_id": "8635b32a-ac5b-366f-94ec-2543c452058b",
                        "glosses": [
                            "A close-fitting, long-sleeved T-shirt with a rolled collar."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "a01bd777-83c8-4e01-9d5d-a5cee606c5cb",
                                "sense_id": "ca109f8d-195c-309d-8635-2324faccf9b5",
                                "text": "The button-down shirts and plain coloured skivvies were replaced by beads, fringed shawls and loose fitting Asian-style tops."
                            },
                            {
                                "example_id": "5dcd8a78-34ab-4753-8d12-456c10f23324",
                                "sense_id": "ca109f8d-195c-309d-8635-2324faccf9b5",
                                "text": "I put my wetsuit and skivvy on a tree to dry, and laid out my other gear on some grass."
                            },
                            {
                                "example_id": "cc886915-9eae-485d-bd75-fd11eaac0d51",
                                "sense_id": "ca109f8d-195c-309d-8635-2324faccf9b5",
                                "text": "‘He looks so good. He shouldn′t be allowed to wear a black skivvy. Doesn′t he have the most amazing muscles?’"
                            },
                            {
                                "example_id": "a2e20720-bae9-4f4b-ba10-3969f635dacc",
                                "sense_id": "ca109f8d-195c-309d-8635-2324faccf9b5",
                                "text": "Then dark blood squirts from a little hole in Sergeant Gerheim's chest. The red blood blossoms into his white skivvy shirt like a beautiful flower."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bec805ce-9989-4bd7-8e65-c79689bf449d",
                        "source_entry_id": "8635b32a-ac5b-366f-94ec-2543c452058b",
                        "source_sense_description": "domestic servant",
                        "target_lang_word": "služka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
