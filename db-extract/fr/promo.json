                                    },
                                    {
                                        "sense_id": "3ffcda70-0fe7-34ba-b298-41430ca70747",
                                        "entry_id": "1b87ca47-dd7f-3f17-85ae-b08ea686d797",
                                        "glosses": [
                                            "A period of time akin to the time taken for the Earth to undergo a full cycle of seasons.",
                                            "The time taken for the Earth to orbit the Sun with respect to the fixed stars; a sidereal year."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de8f98ac-ba9b-3d09-82cb-7aaf07668fd1",
                                        "entry_id": "1b87ca47-dd7f-3f17-85ae-b08ea686d797",
                                        "glosses": [
                                            "A period of time akin to the time taken for the Earth to undergo a full cycle of seasons.",
                                            "The length of twelve lunations; the time taken for any moon phase to happen twelve times; a lunar year."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a95d555e-367e-345b-b02c-98b3eb1319b5",
                                        "entry_id": "1b87ca47-dd7f-3f17-85ae-b08ea686d797",
                                        "glosses": [
                                            "A period of time akin to the time taken for the Earth to undergo a full cycle of seasons.",
                                            "The length of a year as marked by a calendar, 365 or 366 days in the Gregorian calendar; a calendar year."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "394e8b61-a57b-36bf-9c5f-2e28c95c6503",
                                        "entry_id": "1b87ca47-dd7f-3f17-85ae-b08ea686d797",
                                        "glosses": [
                                            "A period of time akin to the time taken for the Earth to undergo a full cycle of seasons.",
                                            "The mean length of a calendar year in the Julian calendar, that is, 365.25 solar days; a Julian year."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b0237de-3d17-31a0-b9c2-443dc2ec1368",
                                        "entry_id": "1b87ca47-dd7f-3f17-85ae-b08ea686d797",
                                        "glosses": [
                                            "An orbital period: the period of one revolution in any particular orbit: The time it takes for any astronomical object (such as a planet, dwarf planet, small Solar System body, or comet) in direct orbit around a star (such as the Sun) to make one revolution around the star."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff40ed16-ad54-498c-8dd7-37787dc3e990",
                                                "sense_id": "6b0237de-3d17-31a0-b9c2-443dc2ec1368",
                                                "text": "Mars goes around the sun once in a Martian year, or 1.88 Earth years."
                                            },
                                            {
                                                "example_id": "76cf8598-6bb9-424e-a288-2adde43e497c",
                                                "sense_id": "6b0237de-3d17-31a0-b9c2-443dc2ec1368",
                                                "text": "Shepard: What can you tell me about the Citadel Council?\nAvina: Originally, the Council consisted of representatives from the asari and salarians, the two dominant species in Citadel space.\nRoughly 1,304 galactic standard years ago, turians were invited to join the Council in recognition of the role they played during the Krogan Rebellion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e74f79b-d5a8-312c-b8a9-af8759d8b026",
                                        "entry_id": "1b87ca47-dd7f-3f17-85ae-b08ea686d797",
                                        "glosses": [
                                            "A period between set dates that mark a year, such as from January 1 to December 31 by the Gregorian calendar, from Tishri 1 to Elul 29 by the Jewish calendar, and from Muharram 1 to Dhu al-Hijjah 29 or 30 by the Islamic calendar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b1fef46-8f1f-4fe4-9b6a-75e8af91bc05",
                                                "sense_id": "5e74f79b-d5a8-312c-b8a9-af8759d8b026",
                                                "text": "A normal year has 365 full days, but there are 366 days in a leap year."
                                            },
                                            {
                                                "example_id": "84584122-d4bf-4634-ad3c-c168d38e524b",
                                                "sense_id": "5e74f79b-d5a8-312c-b8a9-af8759d8b026",
                                                "text": "I was born in the year 1950."
                                            },
                                            {
                                                "example_id": "4784638e-47fb-4ebf-bdbd-4a2704a75b67",
                                                "sense_id": "5e74f79b-d5a8-312c-b8a9-af8759d8b026",
                                                "text": "This Chinese year is the year of the Ox."
                                            },
                                            {
                                                "example_id": "952f9f47-65fc-49d1-814c-2cd6cadb022c",
                                                "sense_id": "5e74f79b-d5a8-312c-b8a9-af8759d8b026",
                                                "text": "Dotcom mania was slow in coming to higher education, but now it has the venerable industry firmly in its grip. Since the launch early last year of Udacity and Coursera, two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations."
                                            },
                                            {
                                                "example_id": "5c7d0416-ec5a-4acb-aa29-282f95cae7e1",
                                                "sense_id": "5e74f79b-d5a8-312c-b8a9-af8759d8b026",
                                                "text": "Construction of the world’s tallest unoccupied skyscraper may resume as early as next week, almost 10 years after work ground to a halt, according to Chinese state media."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c14f8c0-0bcd-32a0-947f-08ad9f47f94f",
                                        "entry_id": "1b87ca47-dd7f-3f17-85ae-b08ea686d797",
                                        "glosses": [
                                            "A scheduled part of a calendar year spent in a specific activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "526839e9-7e1f-4d30-a426-e787b8e2d3aa",
                                                "sense_id": "1c14f8c0-0bcd-32a0-947f-08ad9f47f94f",
                                                "text": "During this school year I have to get up at 6:30 to catch the bus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85b8a42c-70e8-3ac9-bd76-74b23a6cda5c",
                                        "entry_id": "1b87ca47-dd7f-3f17-85ae-b08ea686d797",
                                        "glosses": [
                                            "A scheduled part of a calendar year spent in a specific activity.",
                                            "A level or grade in school or college."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b8a68b3-3fde-4f3c-8d99-620ccf61f2ed",
                                                "sense_id": "85b8a42c-70e8-3ac9-bd76-74b23a6cda5c",
                                                "text": "Every second-year student must select an area of specialization."
                                            },
                                            {
                                                "example_id": "4b44125c-ab4d-4c1f-a5a2-92c1a5001bcc",
                                                "sense_id": "85b8a42c-70e8-3ac9-bd76-74b23a6cda5c",
                                                "text": "The exams in year 12 at high school are the most difficult."
                                            },
                                            {
                                                "example_id": "81f72ac1-22ef-4b0c-9305-7747d30c9747",
                                                "sense_id": "85b8a42c-70e8-3ac9-bd76-74b23a6cda5c",
                                                "text": "I'm the oldest student in my year because I've repeated twice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b76480fb-f626-3097-b567-075d93c5320a",
                                        "entry_id": "1b87ca47-dd7f-3f17-85ae-b08ea686d797",
                                        "glosses": [
                                            "The proportion of a creature's lifespan equivalent to one year of an average human lifespan (see also dog year)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "197ad617-4c1f-407f-a6d1-913a0e7f3de7",
                                                "sense_id": "b76480fb-f626-3097-b567-075d93c5320a",
                                                "text": "Geneticists have created baker's yeast that can live to 800 in yeast years."
                                            }
                                        ]
                                    }
                                ]
                            },
