        "nl-extract.jsonl": [
            {
                "entry_id": "8d443db6-6b0f-3f9c-a477-62824d473272",
                "word": "zomertijd",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4d8aa495-f47b-3195-afeb-b79099a0ae0a",
                        "entry_id": "8d443db6-6b0f-3f9c-a477-62824d473272",
                        "glosses": [
                            "regeling waarbij de klok vanaf een moment in de lente tot een moment in de herfst een uur vooruit wordt gezet, met als hoofddoel meer van het daglicht te profiteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bec86834-fc8e-4da2-93f9-447d7856b3cc",
                                "sense_id": "4d8aa495-f47b-3195-afeb-b79099a0ae0a",
                                "text": "Er zijn verschillende onderzoeken gedaan naar de effecten van de zomertijd op ons lichaam."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c00973c-ea1a-3c77-9720-eb191ef7d414",
                        "entry_id": "8d443db6-6b0f-3f9c-a477-62824d473272",
                        "glosses": [
                            "deel van het jaar waarin de zon langer schijnt en het warmer is, vaak gebruikt voor een ruimere periode dan de meteorologische zomer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "888d50c7-655c-4922-ac12-c5d6c8fdb504",
                                "sense_id": "5c00973c-ea1a-3c77-9720-eb191ef7d414",
                                "text": "Op de zomertijd volgt onherroepelijk de wintertijd. Dat is een oud gegeven, maar daarom niet minder waar. Is het in de wintertijd vaak koud, in de zomertijd is het meestal warm. Alles groeit en bloeit. De bomen zijn vol groene bladeren en het water in de vijvers of in de beken en bergstromen is helder en sprankelend schoon in de schittering van de zon. Ja, dat is de zomertijd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "297123a5-0432-41fe-9d56-13f7d647e9b6",
                        "source_entry_id": "8d443db6-6b0f-3f9c-a477-62824d473272",
                        "source_sense_id": "4d8aa495-f47b-3195-afeb-b79099a0ae0a",
                        "source_sense_description": "regeling waarbij de klok gedurende de lente- en zomermaanden een uur vooruit wordt gezet",
                        "target_lang_word": "Sommerzeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sommerzeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a4a1800-eb00-3260-a986-7506ec4fe9a7",
                                        "entry_id": "db970d4e-2295-3c42-b191-abe5302c83ae",
                                        "glosses": [
                                            "die Zeit des Sommers; die Zeit, in der die Tage länger als die Nächte sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67d3a8a8-aba0-43aa-bb99-a2744ef8b577",
                                                "sense_id": "2a4a1800-eb00-3260-a986-7506ec4fe9a7",
                                                "text": "„Einmal zur Sommerzeit, als das Wetter sehr heiß gewesen sei, wäre ein Fuchs längs des Flußufers (‚weiter‘) geschlendert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5964c2e3-d5ad-3f68-b1ae-113a5ff21874",
                                        "entry_id": "db970d4e-2295-3c42-b191-abe5302c83ae",
                                        "glosses": [
                                            "die im Sommerhalbjahr (meist) um eine Stunde, gegenüber der jeweiligen Zonenzeit (der dort sonst geltenden Normalzeit), vorverlegte Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08189a54-689c-4236-a65f-85cf416227a6",
                                                "sense_id": "5964c2e3-d5ad-3f68-b1ae-113a5ff21874",
                                                "text": "Die Sommerzeit wird in Deutschland jedes Jahr am letzten Sonntag im März eingeführt und am letzten Sonntag im Oktober wieder außer Kraft gesetzt."
                                            },
                                            {
                                                "example_id": "492bed1f-9ca4-468f-9fcd-bf6e44dc9eb5",
                                                "sense_id": "5964c2e3-d5ad-3f68-b1ae-113a5ff21874",
                                                "text": "Wegen der Umstellung auf die Sommerzeit werde ich eine Stunde zu früh geweckt."
                                            },
                                            {
                                                "example_id": "e3e6e15b-6b8a-45f7-828d-8ed47b1b8609",
                                                "sense_id": "5964c2e3-d5ad-3f68-b1ae-113a5ff21874",
                                                "text": "„Um das Tageslicht besser auszunutzen und damit den Verbrauch an künstlichem Licht zu senken, führte die Reichsregierung zum ersten Mal die Sommerzeit in Deutschland ein: Die Uhren wurden eine Stunde vorgestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8decac14-e93c-49a5-a4f4-7b2850b6efed",
                        "source_entry_id": "8d443db6-6b0f-3f9c-a477-62824d473272",
                        "source_sense_id": "4d8aa495-f47b-3195-afeb-b79099a0ae0a",
                        "source_sense_description": "regeling waarbij de klok gedurende de lente- en zomermaanden een uur vooruit wordt gezet",
                        "target_lang_word": "daylight saving time",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daylight saving time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f013e2d-9503-305d-a686-9b202514c8f1",
                                        "entry_id": "d1aee907-a5c1-3830-ad12-36705946030f",
                                        "glosses": [
                                            "The practice in some places of adjusting clocks forward in the spring and back in the fall, usually by one hour, so that the adjustment causes the time to coincide with the greatest period of illumination by the sun over the course of the day."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b525f879-4ac4-4017-9c3e-b997a9b9de58",
                                                "sense_id": "9f013e2d-9503-305d-a686-9b202514c8f1",
                                                "text": "2005: answers.firstgov.gov -- Daylight Saving Time is a change in the standard time of each time zone. ... The American law by which we turn our clock forward in the spring and back in the fall is known as the Uniform Time Act of 1966. The law does not require that anyone observe Daylight Saving Time; all the law requires is that if we are going to observe Daylight Saving Time, it must be done uniformly. http://answers.firstgov.gov/cgi-bin/gsa_ict.cfg/php/enduser/std_adp.php?p_faqid=6880"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1623f369-8590-4a93-b5ab-fdc26c32494c",
                        "source_entry_id": "8d443db6-6b0f-3f9c-a477-62824d473272",
                        "source_sense_id": "4d8aa495-f47b-3195-afeb-b79099a0ae0a",
                        "source_sense_description": "regeling waarbij de klok gedurende de lente- en zomermaanden een uur vooruit wordt gezet",
                        "target_lang_word": "heure d’été",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heure d’été",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cca10e01-3cf2-3e89-869f-741cfa137f23",
                                        "entry_id": "5ed1958c-19de-3896-95af-4f0147ba1a20",
                                        "glosses": [
                                            "Système horaire consistant à ajuster l’heure officielle en ajoutant généralement une heure à l’heure locale (heure d’hiver) pour une période allant du printemps jusqu’à la fin de l’été ou le début de l’automne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bc2fad3-68d7-46c6-a58e-db5d28f13b86",
                                                "sense_id": "cca10e01-3cf2-3e89-869f-741cfa137f23",
                                                "text": "Il ne faut pas chercher très loin l’acharnement mis par Alain Juppé à obtenir la suppression de l’heure d’été - acharnement hélas, jusqu’ici, inefficace puisque la commission de Bruxelles a rejeté la demande du gouvernement français."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b61cfb9d-c071-36da-97c0-4dc9f110fe01",
                                        "entry_id": "5ed1958c-19de-3896-95af-4f0147ba1a20",
                                        "glosses": [
                                            "Heure utilisée en été, par opposition à l’heure d’hiver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84cd9549-91b5-47a5-8cce-f7cd4dd0e819",
                                                "sense_id": "b61cfb9d-c071-36da-97c0-4dc9f110fe01",
                                                "text": "Le référendum de lundi portera aussi sur la question du changement d’heure, à savoir si l’Alberta doit adopter l’heure d’été toute l’année et mettre alors fin à l’heure d’hiver."
                                            },
                                            {
                                                "example_id": "046479ed-2404-4a25-af83-6f9ed968f0b8",
                                                "sense_id": "b61cfb9d-c071-36da-97c0-4dc9f110fe01",
                                                "text": "Dans la nuit du jour du passage de l’heure d’hiver à l’heure d’été, à 2 heures il est alors 3 heures, et on perd une heure de sommeil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
