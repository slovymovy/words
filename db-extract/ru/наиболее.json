                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "876d83a6-1337-3293-aa08-5badb2bbf957",
                        "entry_id": "d35f46d3-f040-3068-8d79-8f9e1e73ded9",
                        "glosses": [
                            "более всего, более всех, в самой большой степени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8edd362c-8af8-409e-85a9-7e0c0c96b806",
                                "sense_id": "876d83a6-1337-3293-aa08-5badb2bbf957",
                                "text": "Наиболее важным стало назначение на пост председателя Комитета по экономической политике."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e2a93cb-fb74-46af-aed7-ed9d7573da2d",
                        "source_entry_id": "d35f46d3-f040-3068-8d79-8f9e1e73ded9",
                        "source_sense_id": "876d83a6-1337-3293-aa08-5badb2bbf957",
                        "target_lang_word": "most",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "most",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41c7ee4e-b7cb-35d9-abe4-617e94c2a2e6",
                                        "entry_id": "c90d3faa-4de9-3b77-83f8-3b50e68bde5c",
                                        "glosses": [
                                            "superlative degree of much."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "superlative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc70fbb6-ebbc-4f3a-9a63-b0d13e6c1fc1",
                                                "sense_id": "41c7ee4e-b7cb-35d9-abe4-617e94c2a2e6",
                                                "text": "The teams competed to see who could collect (the) most money."
                                            },
                                            {
                                                "example_id": "5d0a7c50-ae8b-45f6-91d2-ad792045a726",
                                                "sense_id": "41c7ee4e-b7cb-35d9-abe4-617e94c2a2e6",
                                                "text": "I spent most time in Rome because most of Venice is flooded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36fca9bb-6f6c-3fd0-b304-4d13a8867c8d",
                                        "entry_id": "c90d3faa-4de9-3b77-83f8-3b50e68bde5c",
                                        "glosses": [
                                            "superlative degree of many: the comparatively largest number of (construed with the definite article)"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "superlative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aac4441-5775-4ac5-a902-874cc02985ea",
                                                "sense_id": "36fca9bb-6f6c-3fd0-b304-4d13a8867c8d",
                                                "text": "The team with the most points wins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebcd2cf3-3a7a-3bc8-a0c9-547d8ff53b7b",
                                        "entry_id": "c90d3faa-4de9-3b77-83f8-3b50e68bde5c",
                                        "glosses": [
                                            "superlative degree of many: the majority of; more than half of (construed without the definite article)"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "superlative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a782c3e4-7d30-4d06-9c70-9a1bbf7d0b26",
                                                "sense_id": "ebcd2cf3-3a7a-3bc8-a0c9-547d8ff53b7b",
                                                "text": "Most bakers and dairy farmers have to get up early."
                                            },
                                            {
                                                "example_id": "f889133e-c76c-43c7-83c9-48c871d54045",
                                                "sense_id": "ebcd2cf3-3a7a-3bc8-a0c9-547d8ff53b7b",
                                                "text": "Winning was not important for most participants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "most",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02c228c7-0402-3463-9b24-0eb674facbed",
                                        "entry_id": "44011230-3104-39a5-bc7d-cbe998197951",
                                        "glosses": [
                                            "Forms the superlative of many adjectives."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65469884-8bd7-49de-a90a-b526277a67d1",
                                                "sense_id": "02c228c7-0402-3463-9b24-0eb674facbed",
                                                "text": "This is the most important example."
                                            },
                                            {
                                                "example_id": "dd4a27d6-90b5-46cd-aeb2-289bafcc3eb4",
                                                "sense_id": "02c228c7-0402-3463-9b24-0eb674facbed",
                                                "text": "Correctness is most important."
                                            },
                                            {
                                                "example_id": "46d25001-a708-4cfc-8a4f-d85779618774",
                                                "sense_id": "02c228c7-0402-3463-9b24-0eb674facbed",
                                                "text": "With some of it on the south and more of it on the north of the great main thoroughfare that connects Aldgate and the East India Docks, St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London."
                                            },
                                            {
                                                "example_id": "24d41d35-8e00-4f09-b2d7-11fe5942211c",
                                                "sense_id": "02c228c7-0402-3463-9b24-0eb674facbed",
                                                "text": "“[…] the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. You know. The kind that have mottoes[…]. And then, when you see [the senders], you probably find that they are the most melancholy old folk with malignant diseases. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aa210a1-867c-3ece-b5b0-c307a5fc1316",
                                        "entry_id": "44011230-3104-39a5-bc7d-cbe998197951",
                                        "glosses": [
                                            "To a great extent or degree; highly; very."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ac4eb21-20cc-4b35-8cc8-eb441ce4734c",
                                                "sense_id": "5aa210a1-867c-3ece-b5b0-c307a5fc1316",
                                                "text": "This is a most unusual specimen."
                                            },
                                            {
                                                "example_id": "420f049e-6314-4d66-b2b8-5942ed3a74b1",
                                                "sense_id": "5aa210a1-867c-3ece-b5b0-c307a5fc1316",
                                                "text": "Most cruel edict! Sure, thy generous soul, Septimius, abhors the dreadful task of persecution."
                                            },
                                            {
                                                "example_id": "544ef550-0969-409f-9760-9e583bd04ca0",
                                                "sense_id": "5aa210a1-867c-3ece-b5b0-c307a5fc1316",
                                                "text": "A noble craft, but somehow a most melancholy!"
                                            },
                                            {
                                                "example_id": "35e20dd4-f201-4180-8ead-ce44cf2021ee",
                                                "sense_id": "5aa210a1-867c-3ece-b5b0-c307a5fc1316",
                                                "text": "Now, I still think that for this box of matches to have escaped the wear of time for immemorial years was a most strange, as for me it was a most fortunate, thing."
                                            },
                                            {
                                                "example_id": "17901316-2f57-4241-935b-d7dffdcfcb37",
                                                "sense_id": "5aa210a1-867c-3ece-b5b0-c307a5fc1316",
                                                "text": "“His song is most unpleasant,” said the King rubbing his head, “pray bid him cease,” and off went the secretary to argue with the wind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f45bc71a-2d97-3da7-bbc3-13c5ed03b65f",
                                        "entry_id": "44011230-3104-39a5-bc7d-cbe998197951",
                                        "glosses": [
                                            "superlative degree of much"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "not-comparable",
                                            "superlative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d361494e-a2e7-4556-9628-4795252c76a3",
                                                "sense_id": "f45bc71a-2d97-3da7-bbc3-13c5ed03b65f",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "most",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dca93d06-1724-3fdd-b66b-07790e52bade",
                                        "entry_id": "55cc8144-0e7f-3f51-8641-e3bfd54c377e",
                                        "glosses": [
                                            "The greatest; the best."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2c56e8b-96bc-49a8-ada3-2b554e4b616f",
                                                "sense_id": "dca93d06-1724-3fdd-b66b-07790e52bade",
                                                "text": "PATTY:They announced this year's nominees for student council. And guess who's up for vice-president? Me! Isn't that the most to say the least?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "most",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ebc3483-00a7-3e4f-996d-8b4c2adbec1b",
                                        "entry_id": "a12651f8-b6f6-35d2-9fe6-a7b3c6241a30",
                                        "glosses": [
                                            "The greater part of a group, especially a group of people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "509733ad-ce24-4b81-aaa5-b53d62179182",
                                                "sense_id": "6ebc3483-00a7-3e4f-996d-8b4c2adbec1b",
                                                "text": "Most want the best for their children."
                                            },
                                            {
                                                "example_id": "22403d2c-5763-4917-b8a2-6a603f2d5b79",
                                                "sense_id": "6ebc3483-00a7-3e4f-996d-8b4c2adbec1b",
                                                "text": "The peach was juicier and more flavourful than most."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "most",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f934fcd2-8db2-36c0-afe6-9b84bf6c7f2e",
                                        "entry_id": "f4dc7179-ec36-3bcf-b433-a36a321a4366",
                                        "glosses": [
                                            "The greatest amount."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "613e54cc-b15f-4b8c-9c7a-9e500eea6999",
                                                "sense_id": "f934fcd2-8db2-36c0-afe6-9b84bf6c7f2e",
                                                "text": "The most I can offer for the house is $150,000."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecc2fa1f-88d3-3d70-a67e-aeabb8627f99",
                                        "entry_id": "f4dc7179-ec36-3bcf-b433-a36a321a4366",
                                        "glosses": [
                                            "The greater part."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0ad6d10-0bb8-4f7c-9273-ddd40b0e46f5",
                                                "sense_id": "ecc2fa1f-88d3-3d70-a67e-aeabb8627f99",
                                                "text": "Most of the penguins were friendly and curious."
                                            },
                                            {
                                                "example_id": "0cb923a8-387f-44dc-be27-b4948565cae7",
                                                "sense_id": "ecc2fa1f-88d3-3d70-a67e-aeabb8627f99",
                                                "text": "Most of the rice was spoiled."
                                            },
                                            {
                                                "example_id": "f15f4c1f-f7d4-46af-8fbe-fa4364c6f5ff",
                                                "sense_id": "ecc2fa1f-88d3-3d70-a67e-aeabb8627f99",
                                                "text": "At half-past nine on this Saturday evening the parlor of the Salutation Inn, High Holborn, contained most of its customary visitors.[…]In former days every tavern of repute kept such a room for the select circle—a club, or society, of habitués, who met every evening for a pipe and a cheerful glass."
                                            },
                                            {
                                                "example_id": "ad144b4e-2559-48e3-85a9-c6a3e9c9c8f0",
                                                "sense_id": "ecc2fa1f-88d3-3d70-a67e-aeabb8627f99",
                                                "text": "The story struck the depressingly familiar note with which true stories ring in the tried ears of experienced policemen.[…]The second note, the high alarum, not so familiar and always important since it indicates the paramount sin in Man's private calendar, took most of them by surprise although they had been well prepared."
                                            },
                                            {
                                                "example_id": "d22f1c10-49ee-4ef2-856f-cac9fcc9f8c9",
                                                "sense_id": "ecc2fa1f-88d3-3d70-a67e-aeabb8627f99",
                                                "text": "Most of the Himalayan rivers have been relatively untouched by dams near their sources. Now the two great Asian powers, India and China, are rushing to harness them as they cut through some of the world's deepest valleys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "633b7e69-6ffb-37b8-9356-a354ef92a2a3",
                                        "entry_id": "f4dc7179-ec36-3bcf-b433-a36a321a4366",
                                        "glosses": [
                                            "A record-setting amount."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45c36781-a228-41d2-9180-ab140605a16b",
                                                "sense_id": "633b7e69-6ffb-37b8-9356-a354ef92a2a3",
                                                "text": "Along with their massive size will come other “mosts”: they will likely be the longest living, the best educated, the wealthiest and the most wired/ wireless."
                                            },
                                            {
                                                "example_id": "64c5f051-eaba-4191-99ff-9d1d10b8c611",
                                                "sense_id": "633b7e69-6ffb-37b8-9356-a354ef92a2a3",
                                                "text": "Virginia had a number of \"mosts” that made it appealing, if not representative of all Confederate states: the most citizens among the Southern states; the most slaves; the most men under arms; the most famous Southern generals; the most fighting within its borders; the most divided by the war (what other Southern state lost a quarter of its territory and saw a new state created out of that former territory?); and the most damaged by the war."
                                            },
                                            {
                                                "example_id": "522e6727-755c-4f49-992e-0350b23b94df",
                                                "sense_id": "633b7e69-6ffb-37b8-9356-a354ef92a2a3",
                                                "text": "The record of Elvis' achievement is truly remarkable; his list of “firsts” and “mosts” is probably without parallel in music and entertainment history."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "most",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4becdcf-b788-3e2a-a34e-bb56267ea3eb",
                                        "entry_id": "b8567c52-4cd6-364c-893f-9532cd0afbea",
                                        "glosses": [
                                            "Almost."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e97946af-7ace-401f-8738-f204a1251694",
                                                "sense_id": "d4becdcf-b788-3e2a-a34e-bb56267ea3eb",
                                                "text": "A well-daiquiried redhead eyed him from across the room at Jilly's one night in 1963 — although it could have been most any night ever […]"
                                            },
                                            {
                                                "example_id": "2682085c-6564-4b84-98ac-7600e5f0c8bb",
                                                "sense_id": "d4becdcf-b788-3e2a-a34e-bb56267ea3eb",
                                                "text": "\"We walked there most every day after school.\""
                                            },
                                            {
                                                "example_id": "611adc1b-dfe0-4996-b0fa-c1a21f5f8f14",
                                                "sense_id": "d4becdcf-b788-3e2a-a34e-bb56267ea3eb",
                                                "text": "“Can't be all that bad if Luke likes it. Most everywhere has air-conditioning, he says.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
