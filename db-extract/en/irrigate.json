                                            {
                                                "example_id": "6377240e-e041-4b62-9804-528ac55cdeb1",
                                                "sense_id": "f0ac0ca7-6589-3d11-9612-68e8db70cb77",
                                                "text": "Ces plantations sont irriguées au moyen de canaux dérivés des sources ou des cours d'eau, ou de norias, de machines mises en mouvement par un chameau ou une mule et servant à élever les eaux de la nappe souterraine."
                                            },
                                            {
                                                "example_id": "5b074295-0efe-4470-af43-72d055508bb5",
                                                "sense_id": "f0ac0ca7-6589-3d11-9612-68e8db70cb77",
                                                "text": "Dans la seconde moitié du XXᵉ siècle, les Américains avaient détourné le cours du fleuve Colorado ; ce dernier ne se déversait plus dans la mer de Cortez, mais servait à irriguer les États du Nouveau-Mexique et du Texas. Côté États-Unis, on voyait des champs verdoyants ; côté Mexique, tout était aride."
                                            }
                                        ]
                                    }
                                ]
                            }
