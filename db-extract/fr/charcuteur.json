                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c1592c3-8c80-4815-9f00-84ad9bf377c2",
                                "sense_id": "616f43f3-c4a0-34fe-ae8d-4afb08f35a9a",
                                "text": "Ah ! Ce fil dentaire est une charcuteuse de gencive !"
                            },
                            {
                                "example_id": "09ad5c8f-8c5c-409e-aba5-c370fb1923c2",
                                "sense_id": "616f43f3-c4a0-34fe-ae8d-4afb08f35a9a",
                                "text": "Pour mon opération, j’ai eu affaires à un charcuteur, y’a pas d’autres mots."
                            },
                            {
                                "example_id": "8cf85ab0-da9f-4b03-b610-9a0d24e2d19c",
                                "sense_id": "616f43f3-c4a0-34fe-ae8d-4afb08f35a9a",
                                "text": "Et encore, vous ne connaissez pas tante Simone, la redoutable Linette et son cidre fermier sans parler de ce charcuteur de médecin."
                            }
                        ]
