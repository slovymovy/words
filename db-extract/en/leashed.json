                        "glosses": [
                            "Having a leash of a specified color."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "478fba36-0463-4353-b583-07d639891c13",
                                "sense_id": "6202edee-729d-352b-ae1a-1551d10b221c",
                                "text": "In the registration for William, Earl of Dundonald, 1672-78, the same person, the boars' heads are armed and langued of the field, and the supporters are collared or and leashed gules."
                            },
                            {
                                "example_id": "4cbf7728-7808-4100-90c8-e5669fba9de1",
                                "sense_id": "6202edee-729d-352b-ae1a-1551d10b221c",
                                "text": "[...] a sleuthhound proper, collared and leashed gules."
                            },
                            {
                                "example_id": "df311ddb-e75b-4461-bae1-045cae608825",
                                "sense_id": "6202edee-729d-352b-ae1a-1551d10b221c",
                                "text": "[...] on the dexter a greyhound proper collared and leashed gules, on the sinister an ostrich proper, in its beak a horse shoe azure."
                            },
                            {
                                "example_id": "c1ac616f-b973-4451-8c5a-519f7bbcc128",
                                "sense_id": "6202edee-729d-352b-ae1a-1551d10b221c",
                                "text": "Supporters; Two greyhounds per fess argent and or, collared and leashed gules, suspended from the collar, a shield azure , charged with the Speaker's Mace in pale or; and each charged on the flank with a thistle proper."
                            }
                        ]
                    }
