{
    "word_family": [
        "fistful",
        "fisticuffs"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f3c7b786-0c3a-3bde-afd4-d19e5c4d90e4",
                    "sense_definition": "A hand with the fingers clenched or curled inward.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hand_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer raised his <w>fist</w> in the air after winning the match.",
                            "target_lang_translations": {
                                "ru": "Боксер поднял <w>кулак</w> в воздух после победы в матче.",
                                "zh": "拳击手在赢得比赛后向空中举起了<w>拳头</w>。"
                            }
                        },
                        {
                            "text": "She slammed her <w>fist</w> on the table to demand silence.",
                            "target_lang_translations": {
                                "ru": "Она ударила <w>кулаком</w> по столу, требуя тишины.",
                                "zh": "她用<w>拳头</w>猛击桌面，要求大家安静。"
                            }
                        }
                    ],
                    "antonyms": [
                        "open hand",
                        "palm"
                    ],
                    "common_phrases": [
                        "make a fist",
                        "shake one's fist",
                        "iron fist",
                        "fist bump"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кисть руки с пальцами, сжатыми или загнутыми внутрь.",
                        "zh": "手指紧握或向内弯曲形成的拳头。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кулак",
                                "target_lang_sense_clarification": "сжатая кисть руки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拳头",
                                "target_lang_sense_clarification": "紧握的拳头"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6209b37-b314-3028-b2a8-5465d6f18b7c",
                    "sense_definition": "An attempt at doing something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a poor <w>fist</w> of explaining why he was late.",
                            "target_lang_translations": {
                                "ru": "Он сделал жалкую <w>попытку</w> объяснить, почему опоздал.",
                                "zh": "他对于迟到原因的解释做了一次糟糕的<w>尝试</w>。"
                            }
                        },
                        {
                            "text": "We can make a reasonable <w>fist</w> of fixing the engine ourselves.",
                            "target_lang_translations": {
                                "ru": "Мы можем предпринять неплохую <w>попытку</w> починить двигатель самостоятельно.",
                                "zh": "我们可以对自行修理引擎做一次合理的<w>尝试</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "make a fist of"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "idiomatic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Попытка сделать что-либо (обычно в составе идиомы).",
                        "zh": "尝试做某事（通常用于习语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попытка",
                                "target_lang_sense_clarification": "проба сил"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尝试",
                                "target_lang_sense_clarification": "做某事的努力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c61afe8a-71d7-3317-bb5a-0f87feb8f34e",
                    "sense_definition": "A symbol in the shape of a pointing hand, used in printing to draw attention to a section of text.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor added a <w>fist</w> in the margin to highlight the important paragraph.",
                            "target_lang_translations": {
                                "ru": "Редактор добавил <w>мани́кулу</w> на полях, чтобы выделить важный абзац.",
                                "zh": "编辑在页边空白处添加了一个<w>指引符号</w>以突出重要段落。"
                            }
                        },
                        {
                            "text": "Old manuscripts often use a <w>fist</w> to guide the reader's eye.",
                            "target_lang_translations": {
                                "ru": "В старинных рукописях часто используется <w>мани́кула</w>, чтобы направить взгляд читателя.",
                                "zh": "古老的手稿常使用<w>指引符号</w>来引导读者的视线。"
                            }
                        }
                    ],
                    "synonyms": [
                        "manicule"
                    ],
                    "target_lang_definitions": {
                        "ru": "Символ в форме указывающей руки, используемый в печати для привлечения внимания к разделу текста.",
                        "zh": "印刷中用于引起对文本段落注意的指向性手形符号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мани́кула",
                                "target_lang_sense_clarification": "типографский знак"
                            },
                            {
                                "target_lang_word": "указатель",
                                "target_lang_sense_clarification": "знак в виде руки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指引符号",
                                "target_lang_sense_clarification": "印刷中的手形标记"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac5b2f18-4c3d-323c-b9bb-e0e942db7afc",
                    "sense_definition": "To strike or hit something with the fist.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The goalkeeper <w>fisted</w> the ball away from the goal.",
                            "target_lang_translations": {
                                "ru": "Вратарь <w>отбил кулаками</w> мяч от ворот.",
                                "zh": "守门员将球<w>挥拳击出</w>球门区。"
                            }
                        },
                        {
                            "text": "He <w>fisted</w> the door in frustration when it wouldn't open.",
                            "target_lang_translations": {
                                "ru": "Он <w>ударил кулаком</w> в дверь от разочарования, когда она не открылась.",
                                "zh": "门打不开时，他沮丧地<w>用拳击打</w>门。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударять или бить по чему-либо кулаком.",
                        "zh": "用拳头击打某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бить кулаком",
                                "target_lang_sense_clarification": "наносить удар"
                            },
                            {
                                "target_lang_word": "отбивать кулаком",
                                "target_lang_sense_clarification": "в спорте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用拳击打",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "挥拳击出",
                                "target_lang_sense_clarification": "体育运动中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0ea9659-165b-36dc-b960-4eb594e225a9",
                    "sense_definition": "To close the hand into a fist.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>fisted</w> her hands at her sides, trying to control her anger.",
                            "target_lang_translations": {
                                "ru": "Она <w>сжала</w> руки в кулаки по бокам, пытаясь сдержать гнев.",
                                "zh": "她双手垂在身侧<w>握紧</w>，试图控制自己的愤怒。"
                            }
                        },
                        {
                            "text": "The baby <w>fisted</w> his tiny fingers around the toy.",
                            "target_lang_translations": {
                                "ru": "Малыш <w>сжал</w> свои крошечные пальчики вокруг игрушки.",
                                "zh": "婴儿用小手<w>握紧</w>了玩具。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unclench",
                        "open"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сжимать кисть в кулак.",
                        "zh": "将手握成拳头。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжимать",
                                "target_lang_sense_clarification": "пальцы или руку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "握紧",
                                "target_lang_sense_clarification": "指手或手指"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d90f5ad7-0e07-30c4-a7c8-a1205effb864",
                    "sense_definition": "Acronym of Future Infantry Soldier Technology.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "The army is testing the new <w>FIST</w> program to improve soldier capabilities.",
                            "target_lang_translations": {
                                "ru": "Армия тестирует новую программу <w>FIST</w> для улучшения возможностей солдат.",
                                "zh": "军队正在测试新的<w>FIST</w>项目以提升士兵的能力。"
                            }
                        },
                        {
                            "text": "Developments in <w>FIST</w> aim to integrate better communication tools for infantry.",
                            "target_lang_translations": {
                                "ru": "Разработки в рамках <w>FIST</w> направлены на интеграцию лучших средств связи для пехоты.",
                                "zh": "<w>FIST</w>的发展旨在为步兵整合更好的通信工具。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от Future Infantry Soldier Technology (Технологии будущего для пехотинцев).",
                        "zh": "“未来步兵士兵技术”的缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "FIST",
                                "target_lang_sense_clarification": "название программы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "FIST",
                                "target_lang_sense_clarification": "项目名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}