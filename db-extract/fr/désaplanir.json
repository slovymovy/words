                        "sense_id": "ff94efd6-008b-31b8-8cac-c2b07f43efa8",
                        "entry_id": "826c4cfe-9c52-37b5-921a-5a553dd0e790",
                        "glosses": [
                            "Faire perdre son caractère plan à."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "546070c5-fce3-4d02-aafb-7f82e0cbe4c9",
                                "sense_id": "ff94efd6-008b-31b8-8cac-c2b07f43efa8",
                                "text": "Nous avions la volonté de désaplanir la gourmette et d’en transcender l’architecture à travers une approche en volume."
                            },
                            {
                                "example_id": "3fe45c71-dfb7-49a2-b22b-346e3143a09a",
                                "sense_id": "ff94efd6-008b-31b8-8cac-c2b07f43efa8",
                                "text": "j'ai aussi essayé de virer l'étain, mais ca a tendance a désaplanir la surface, et il en reste toujours un peu."
                            },
                            {
                                "example_id": "b8886694-f087-46a7-ab5c-c6fb21ea48e4",
                                "sense_id": "ff94efd6-008b-31b8-8cac-c2b07f43efa8",
                                "text": "soudain le monde va se désaplanir le mystère dressera son chemin vertical"
                            }
                        ]
                    }
