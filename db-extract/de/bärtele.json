                "senses": [
                    {
                        "sense_id": "056ff50e-86ad-3164-8619-17cad5db9797",
                        "entry_id": "c1cf5b64-57d4-3744-adef-2978fe1664bf",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44de1810-928d-4046-8b9d-dfbee3915e17",
                                "sense_id": "056ff50e-86ad-3164-8619-17cad5db9797",
                                "text": "Frau Bärtele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bf027169-7d27-4099-9cd3-9b45eff4ce5b",
                                "sense_id": "056ff50e-86ad-3164-8619-17cad5db9797",
                                "text": "Herr Bärtele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9aa89223-27f6-4d3b-bbfc-c09aef793f6b",
                                "sense_id": "056ff50e-86ad-3164-8619-17cad5db9797",
                                "text": "Die Bärteles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d53b7626-109b-488c-9f93-60484aab42a3",
                                "sense_id": "056ff50e-86ad-3164-8619-17cad5db9797",
                                "text": "Der Bärtele trägt nie die Schals, die die Bärtele ihm strickt."
                            },
                            {
                                "example_id": "6101cee1-6015-4c22-93a3-8106a422388e",
                                "sense_id": "056ff50e-86ad-3164-8619-17cad5db9797",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bärtele kommt, geht der Herr Bärtele.“"
                            },
                            {
                                "example_id": "094d4bcd-5d7e-41ab-9655-a8e26808cbc2",
                                "sense_id": "056ff50e-86ad-3164-8619-17cad5db9797",
                                "text": "Bärtele kommt und geht."
                            },
                            {
                                "example_id": "97ce64b0-e058-4392-8ec7-263efd5784ca",
                                "sense_id": "056ff50e-86ad-3164-8619-17cad5db9797",
                                "text": "Bärteles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
