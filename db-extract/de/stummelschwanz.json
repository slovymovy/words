                        "source_sense_id": "ca622572-a3f2-3d0f-b66d-d9507ebfb771",
                        "source_sense_description": "Anatomie: kurzer Schwanz, natürlich oder kupiert",
                        "target_lang_word": "scut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0de70d11-27db-3e06-b7ab-c5408be73c82",
                                        "entry_id": "b384d72f-c023-3651-a875-18a3d6fe9005",
                                        "glosses": [
                                            "A hare; (hunting, also figuratively) a hare as the game in a hunt."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa01bae4-d039-3fdc-82d3-785126028bfd",
                                        "entry_id": "b384d72f-c023-3651-a875-18a3d6fe9005",
                                        "glosses": [
                                            "A short, erect tail, as of a hare, rabbit, or deer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fb9dc42-c233-4745-b7d3-6a25d51d1fd4",
                                                "sense_id": "aa01bae4-d039-3fdc-82d3-785126028bfd",
                                                "text": "Shakespeare's use of the word scut may be a sly reference to Mistress Ford's pudenda: see sense 3."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ebc97ef-3bee-33d4-9dab-a7060cdbb40f",
                                        "entry_id": "b384d72f-c023-3651-a875-18a3d6fe9005",
                                        "glosses": [
                                            "The buttocks or rump; also, the female pudenda, the vulva."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed9e61cd-dbf2-4a69-b32f-a48cfd586b83",
                                                "sense_id": "4ebc97ef-3bee-33d4-9dab-a7060cdbb40f",
                                                "text": "I rumpled her Feathers, and tickled her Scut, / And play'd the round Rubbers at two handed Put."
                                            },
                                            {
                                                "example_id": "c5501e0a-5e56-4e0d-a2f5-4ff985aacad0",
                                                "sense_id": "4ebc97ef-3bee-33d4-9dab-a7060cdbb40f",
                                                "text": "Put on your dress, ye shameless witch, standin' there in your pelt I'll take a strap to, for havin' the conceit out of you, for by your idling had lost me the sup of gin to keep the breath of life in me. Cover your scut, or I'll welt the skin off it."
                                            },
                                            {
                                                "example_id": "c763ae8b-f02c-4fa9-a11a-d5e76cdba1fa",
                                                "sense_id": "4ebc97ef-3bee-33d4-9dab-a7060cdbb40f",
                                                "text": "So … so she show you her pretty li'l scut, he? Jesse, you are a lad; when will you learn?"
                                            },
                                            {
                                                "example_id": "dae45776-3b28-435d-803d-d112653a39bb",
                                                "sense_id": "4ebc97ef-3bee-33d4-9dab-a7060cdbb40f",
                                                "text": "One of the sisters backed up to the fire and hiked up the tail of her dress and bent over and thrust out her scut to it and stared at Inman with a look of glazed pleasure in her blue eyes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0aa06f8-b8ed-37ac-8d54-31f35f2ca636",
                                        "entry_id": "5ffc538b-efc4-3d68-b17c-ba2f4e60573a",
                                        "glosses": [
                                            "A contemptible person."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23a9a8af-ad37-48a2-bc7d-5ab9200856d3",
                                                "sense_id": "f0aa06f8-b8ed-37ac-8d54-31f35f2ca636",
                                                "text": "\"I'll have no more of it. I'll have no more Dinny Ryans handlin' flesh and blood of my gettin'. Ye'd see me dyin' for a sup of drink to give me peace, and you philanderin' and danderin' with yon scut of a fellow, and worse doin's behind that, if the truth is told.\""
                                            },
                                            {
                                                "example_id": "7a0dd5df-2dbb-42a3-ab18-83d4a25e610b",
                                                "sense_id": "f0aa06f8-b8ed-37ac-8d54-31f35f2ca636",
                                                "text": "She didn't need a new dress! Me money! Me hard earned three hundred that I scraped and scrimped for. Me scut of a daughter puttin' it on her back in finery."
                                            },
                                            {
                                                "example_id": "16545876-f2d2-43bf-816b-2bddfbc8f62b",
                                                "sense_id": "f0aa06f8-b8ed-37ac-8d54-31f35f2ca636",
                                                "text": "I dreamt that Ruairi Quinn was smokin' marijuana in the Dail. Barry Desmond handing Frenchies out to scuts in Fianna Fail."
                                            },
                                            {
                                                "example_id": "1d63453c-b945-42ea-a8ef-41a23ddba9d2",
                                                "sense_id": "f0aa06f8-b8ed-37ac-8d54-31f35f2ca636",
                                                "text": "CHRIS. Danny Bradley is a scut, Rose. / ROSE. I never said it was Danny Bradley! / CHRIS. He's a married man with three young children."
                                            },
                                            {
                                                "example_id": "9a1a268f-c4d5-408a-8dd2-83b1c1cf5784",
                                                "sense_id": "f0aa06f8-b8ed-37ac-8d54-31f35f2ca636",
                                                "text": "Ruth had snapped open her purse and pulled out a small gun. I grabbed her arm and yanked her into the car; she squawked and her shot went wide. [...] \"You scut,\" she said as we hit the entrance ramp of the interstate. \"You're a scut-pumping Conservative. You made me miss.\""
                                            },
                                            {
                                                "example_id": "c0b60128-56ce-428a-bf2d-40bc4fc1f98d",
                                                "sense_id": "f0aa06f8-b8ed-37ac-8d54-31f35f2ca636",
                                                "text": "Fat-headed scut. That's what he is, scut. Thinks he runs the whole river."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a37fd56-29bd-3622-acb9-4f8d66fb02c6",
                                        "entry_id": "f9abf47c-89cd-3431-b8f9-cff6302be540",
                                        "glosses": [
                                            "Distasteful work; drudgery"
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62e463b2-7da6-4529-bb94-975ebb83f106",
                                                "sense_id": "3a37fd56-29bd-3622-acb9-4f8d66fb02c6",
                                                "text": "Let's devote mornings to the scut, do real work in the afternoon."
                                            },
                                            {
                                                "example_id": "253b5576-af31-41a6-8233-7e21fd45cd2e",
                                                "sense_id": "3a37fd56-29bd-3622-acb9-4f8d66fb02c6",
                                                "text": "And the scut of weeding or washing clothes or waiting in the dentist's waiting room or the soccer field parking lot is actually far less brutalizing than the scut of grading freshman essays [...]"
                                            },
                                            {
                                                "example_id": "14088d84-d0f6-4b1c-8211-10269321a0db",
                                                "sense_id": "3a37fd56-29bd-3622-acb9-4f8d66fb02c6",
                                                "text": "\"What if you were called a scut puppy?\" / \"When I first started I was one. A scut puppy is usually a medical student or a nurse who does menial tasks. That's how a person learns in the beginning. We are under others who will teach us and work our tails off.\""
                                            },
                                            {
                                                "example_id": "94149ff6-264e-4476-bbe2-e8d3407049c9",
                                                "sense_id": "3a37fd56-29bd-3622-acb9-4f8d66fb02c6",
                                                "text": "So they give the people assigned to the Probation Squad every scut case that other squads don't want to handle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a507ddc1-8127-35d5-835a-99b811057a92",
                                        "entry_id": "f9abf47c-89cd-3431-b8f9-cff6302be540",
                                        "glosses": [
                                            "Some menial procedure left for a doctor or medical student to complete, sometimes for training purposes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ace57e8-c024-4937-9de9-9fc572b62e06",
                                                "sense_id": "a507ddc1-8127-35d5-835a-99b811057a92",
                                                "text": "There's no question that it's sexist. [Female residents] are berated more on rounds, given more scut to do."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c11b7cc4-babe-3601-af62-a152670eac89",
                                        "entry_id": "b2e178c7-1a71-3e90-af50-1ba571e24473",
                                        "glosses": [
                                            "To scamper off."
                                        ],
                                        "tags": [
                                            "East-Anglia",
