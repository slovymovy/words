                "senses": [
                    {
                        "sense_id": "f6d15921-653a-3599-9d9d-6b668294e89d",
                        "entry_id": "0d8c5ccb-a1de-3265-8ead-c3fccf13ff67",
                        "glosses": [
                            "Donner un caractère torride à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b33f082c-ca79-4e2f-a510-c2891c14946e",
                                "sense_id": "f6d15921-653a-3599-9d9d-6b668294e89d",
                                "text": "Il y a des points forts dans ce film inhabituellement long (1h26), le rythme soutenu, la qualité de certaines scènes (il arrive même à renouveler et à « torridifier » les scènes sous la douche), le très bon choix des actrices."
                            },
                            {
                                "example_id": "36f416a4-b8c5-4f79-8e17-6ddbc0c90e60",
                                "sense_id": "f6d15921-653a-3599-9d9d-6b668294e89d",
                                "text": "Chez Tauer, moi c'est Une Rose chyprée qui torridifie ma peau."
                            },
                            {
                                "example_id": "4bd11293-9aa3-48ec-bde5-f1413afce50a",
                                "sense_id": "f6d15921-653a-3599-9d9d-6b668294e89d",
                                "text": "Il se relève, trébuche sur Karouk à son tour, se re-relève et fuit finalement à ses obligations. (Non sans un adieu à son ami un peu torridifié par l'état dans lequel l'a mis caCtus)"
                            }
                        ]
                    }
