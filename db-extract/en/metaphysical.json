                        ],
                        "examples": [
                            {
                                "example_id": "e9b99da1-1ac3-4153-9fa5-1e69d75a535a",
                                "sense_id": "4bd98c27-2bfb-3fc9-9ab5-0c20819018c3",
                                "text": "The roots of authority, on the contrary, always had a metaphysical character."
                            }
                        ]
