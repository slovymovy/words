                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58ea2a75-ba55-4000-97bd-ee16cb100a29",
                                "sense_id": "301a2376-8905-30a9-91a9-21e869f70d16",
                                "text": "Vue son origine et sa fonction, on a pu écrire que l’albumen était un « frère jumeau anthropophagisé » par l’embryon."
                            },
                            {
                                "example_id": "a5ed467f-05b2-4814-b7ad-0ae394430e02",
                                "sense_id": "301a2376-8905-30a9-91a9-21e869f70d16",
                                "text": "Mais JJV va plus loin, il anthropophagise la fin de ce chapitre, dans le sens où il procède à une non-traduction, ne mentionnant pas les plantes, ainsi qu’il le fera à diverses reprises (notamment p. 367)."
                            }
                        ]
                    }
