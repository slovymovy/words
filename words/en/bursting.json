{
    "word_family": [
        "burst",
        "outburst"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ff45313-5851-395f-bf37-724eed1083e9",
                    "sense_definition": "present participle and gerund of <w>burst</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "burst_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The balloon was suddenly <w>bursting</w> from too much air pressure.",
                            "target_lang_translations": {
                                "pl": "Balon nagle <w>pękał</w> od zbyt wysokiego ciśnienia powietrza."
                            }
                        },
                        {
                            "text": "He entered the room after <w>bursting</w> through the heavy wooden door.",
                            "target_lang_translations": {
                                "pl": "Wszedł do pokoju po tym, jak <w>wparował</w> przez ciężkie drewniane drzwi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "imiesłów czynny (czasownik) od czasownika burst: pękać, wybuchać, wdzierać się"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pękający",
                                "target_lang_sense_clarification": "o przedmiocie ulegającym rozerwaniu"
                            },
                            {
                                "target_lang_word": "wdzierający się",
                                "target_lang_sense_clarification": "nagle wchodzący do pomieszczenia"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b900d355-c2a5-376b-91a6-48f216e4016b",
                    "sense_definition": "Extremely full, crowded, or packed to the point of breaking or overflowing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fullness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newly stocked refrigerator is <w>bursting</w> with fresh vegetables and drinks.",
                            "target_lang_translations": {
                                "pl": "Świeżo zaopatrzona lodówka <w>pęka w szwach</w> od świeżych warzyw i napojów."
                            }
                        },
                        {
                            "text": "Her heart was <w>bursting</w> with pride as she watched her son graduate.",
                            "target_lang_translations": {
                                "pl": "Jej serce <w>było przepełnione</w> dumą, gdy patrzyła, jak jej syn kończy szkołę."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bursting at the seams",
                        "bursting with energy",
                        "bursting with pride"
                    ],
                    "target_lang_definitions": {
                        "pl": "przepełniony, pękający w szwach (np. od nadmiaru rzeczy lub emocji)"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pękający w szwach",
                                "target_lang_sense_clarification": "np. o lodówce, pokoju, walizce"
                            },
                            {
                                "target_lang_word": "przepełniony",
                                "target_lang_sense_clarification": "wypełniony po brzegi, np. dumą lub energią"
                            },
                            {
                                "target_lang_word": "kipiący",
                                "target_lang_sense_clarification": "np. kipiący energią lub emocjami"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ab928f9-bd6a-39ab-9ef2-215d39198b1c",
                    "sense_definition": "Extremely eager, excited, or unable to restrain oneself from doing something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eager",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was <w>bursting</w> to tell everyone the exciting secret all morning.",
                            "target_lang_translations": {
                                "pl": "Przez cały poranek <w>paliłem się</w>, by wyjawić wszystkim tę ekscytującą tajemnicę."
                            }
                        },
                        {
                            "text": "The children were <w>bursting</w> with excitement to open their presents.",
                            "target_lang_translations": {
                                "pl": "Dzieci <w>aż kipiały</w> z ekscytacji, żeby otworzyć prezenty."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bursting to tell"
                    ],
                    "target_lang_definitions": {
                        "pl": "niecierpliwiący się, palący się do zrobienia czegoś"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "palący się do",
                                "target_lang_sense_clarification": "nie mogący się doczekać, by coś zrobić"
                            },
                            {
                                "target_lang_word": "umierający z ciekawości",
                                "target_lang_sense_clarification": "przenośnie o silnej potrzebie powiedzenia lub dowiedzenia się czegoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac497b23-6a96-31d4-9d34-f63e59e1c001",
                    "sense_definition": "Urgently and uncomfortably needing to urinate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "urination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you please tell me where the restrooms are because I am <w>bursting</w>?",
                            "target_lang_translations": {
                                "pl": "Czy możesz mi powiedzieć, gdzie są toalety, bo zaraz <w>pęknę</w>?"
                            }
                        },
                        {
                            "text": "The child was <w>bursting</w> to go to the toilet after the long bus journey.",
                            "target_lang_translations": {
                                "pl": "Dziecku po długiej podróży autobusem strasznie <w>chciało się</w> do toalety."
                            }
                        }
                    ],
                    "synonyms": [
                        "busting"
                    ],
                    "common_phrases": [
                        "bursting for a pee"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used casually to express strong physical urgency"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "potocznie: mający ogromną potrzebę skorzystania z toalety, pękający (z pęcherzem)"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pękać",
                                "target_lang_sense_clarification": "potocznie o pęcherzu / potrzebie oddania moczu"
                            },
                            {
                                "target_lang_word": "zaraz się posikać",
                                "target_lang_sense_clarification": "bardzo potoczne określenie silnej potrzeby fizjologicznej"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ef5914e4-d669-3ce3-97fb-ac616efe52e9",
                    "sense_definition": "The act, process, or instance of breaking open or rupturing suddenly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rupture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>bursting</w> of the water pipe flooded the entire basement.",
                            "target_lang_translations": {
                                "pl": "Nagłe <w>pęknięcie</w> rury z wodą zalało całą piwnicę."
                            }
                        },
                        {
                            "text": "Engineers feared that the continuous <w>bursting</w> of dykes would inundate the valley.",
                            "target_lang_translations": {
                                "pl": "Inżynierowie obawiali się, że ciągłe <w>przerywanie</w> wałów przeciwpowodziowych zatopi dolinę."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bursting of the dam"
                    ],
                    "target_lang_definitions": {
                        "pl": "pęknięcie, pękanie, rozerwanie się"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pęknięcie",
                                "target_lang_sense_clarification": "nagłe rozerwanie np. rury, tamy"
                            },
                            {
                                "target_lang_word": "rozerwanie",
                                "target_lang_sense_clarification": "zniszczenie pod wpływem ciśnienia"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}