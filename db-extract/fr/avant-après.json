                        "glosses": [
                            "Photomontage composé de deux photographies illustrant une chose, un lieu ou une personne avant puis après un événement pour mettre en évidence une transformation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8377f48a-3174-4302-bcf2-d653881cc142",
                                "sense_id": "524cbbee-8805-30fb-b810-e4a4e1c69be6",
                                "text": "Sur son compte Instagram, la chanteuse Lily Allen a fêté son année de sobriété en postant un avant/après déroutant."
                            },
                            {
                                "example_id": "58ebabcc-dbd3-4c1e-a837-14ca833f2a93",
                                "sense_id": "524cbbee-8805-30fb-b810-e4a4e1c69be6",
                                "text": "« Je t’ai apporté quelque chose, continue-t-il en fouraillant dans sa poche pour en sortir des photos, format carte postale, siglées du nom de son agence, qu’il dirige avec Sophie Denissof. Tu vois, c’est des “avant-après”. » Comprendre : des bâtiments avant la réhabilitation par ses soins."
                            }
                        ]
