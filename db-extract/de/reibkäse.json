                "senses": [
                    {
                        "sense_id": "3a1e5cd9-5745-3b66-bc2f-519d7045f6bb",
                        "entry_id": "3b34def6-a5b8-35a8-a3cb-df0784526b15",
                        "glosses": [
                            "(harter, trockener) Käse, der zum Reiben geeignet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66d92a80-1a5a-4227-8c0c-f059357603b6",
                                "sense_id": "3a1e5cd9-5745-3b66-bc2f-519d7045f6bb",
                                "text": "„Wenn man die Milch in die Molkerei brachte, erhielt man Stracchino, den Frischkäse. Der Montasio-Käse wurde in der Molkerei sechs Monate gelagert. Zuhause lagerte man die Hälfte nochmals sechs Monate, um Reibkäse herzustellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5ace9fe1-eca3-3767-b5aa-cae98217e209",
                        "entry_id": "3b34def6-a5b8-35a8-a3cb-df0784526b15",
                        "glosses": [
                            "geriebener Käse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d79637d6-05bc-42c4-aa65-f1fa69c225e7",
                                "sense_id": "5ace9fe1-eca3-3767-b5aa-cae98217e209",
                                "text": "„Der Belag besteht aus geräuchertem Speck und einer Mischung aus Reibkäse, Zwiebeln, Eiern und Milch oder einer Royale mit Sauerrahm.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
