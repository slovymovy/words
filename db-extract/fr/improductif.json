                                    {
                                        "sense_id": "179434e7-f0bb-374d-87c8-f9b0655ca642",
                                        "entry_id": "acc9d1c8-8e87-35bb-8791-ffbe204e1aa7",
                                        "glosses": [
                                            "Not productive; useless; fruitless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
