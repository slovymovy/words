                "senses": [
                    {
                        "sense_id": "b0b617d3-d595-35c4-902a-e52b64dd3863",
                        "entry_id": "1c5d5535-9ea0-34af-b255-835e360d5d12",
                        "glosses": [
                            "Christ, der ein Angehöriger der Syrisch-Maronitischen Kirche von Antiochien ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfff3dfc-2e5c-4f4d-9b35-4495ab1d5ed4",
                                "sense_id": "b0b617d3-d595-35c4-902a-e52b64dd3863",
                                "text": "„Die Einwohner ergaben sich kampflos – als Maroniten erwarteten sie, in dem neuen jüdischen Staat willkommen zu sein.“"
                            },
                            {
                                "example_id": "5d278564-40e6-4595-b851-82e51f44d0cd",
                                "sense_id": "b0b617d3-d595-35c4-902a-e52b64dd3863",
                                "text": "„Es befand sich im Osten Beiruts, im Vorort Dekwaneh, der größtenteils von libanesischen Maroniten bewohnt wurde, die mit der rechtsgerichteten antipalästinensischen Phalangistischen Partei sympathisierten.“"
                            },
                            {
                                "example_id": "d3376eb5-489d-42e2-94b9-852794b46173",
                                "sense_id": "b0b617d3-d595-35c4-902a-e52b64dd3863",
                                "text": "„Da der Waffenstillstand ausnahmsweise Bestand zu haben schien, hatten diese verfluchten Maroniten beschlossen, sich weiteres Land unter den Nagel zu reißen.“"
                            },
                            {
                                "example_id": "cea94457-786e-45af-95d3-cf538bf8d5ad",
                                "sense_id": "b0b617d3-d595-35c4-902a-e52b64dd3863",
                                "text": "„Ich bin ein katholischer Maronit.“"
                            },
                            {
                                "example_id": "74e7fe20-2d70-40a8-831d-5831a2328ea9",
                                "sense_id": "b0b617d3-d595-35c4-902a-e52b64dd3863",
                                "text": "„Bereits in der frühen Phase der islamischen Herrschaft wurden die aus dem Gebiet des heutigen Syriens eingewanderten christlichen Maroniten zu einer der bedeutendsten Bevölkerungsgruppen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
