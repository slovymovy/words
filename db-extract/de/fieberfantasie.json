                        "entry_id": "241cb94d-f6e9-396d-b5ca-df472270c084",
                        "glosses": [
                            "Wahnvorstellungen und gestörte Sinneswahrnehmung, die im Fieber auftreten können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b79f059-28da-45c9-8c38-d9ccf5a600c9",
                                "sense_id": "c79d4e3b-428d-370c-baa7-d3d3e9e579fc",
                                "text": "„Aber es konnte auch ein Traum gewesen sein, wie die Fieberfantasie während dieser Tage ihr so manchen vorgegaukelt.“"
                            },
                            {
                                "example_id": "da18bef9-5a3f-4fb8-8770-7063572bc178",
                                "sense_id": "c79d4e3b-428d-370c-baa7-d3d3e9e579fc",
                                "text": "„Felix wusste nicht mehr, ob er wachte oder schlief oder in Fieberfantasien wegträumte.“"
                            }
                        ],
