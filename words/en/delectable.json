                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pleasing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bakery display was filled with various <w>delectables</w>.",
                            "target_lang_translations": {
