                    },
                    {
                        "translation_id": "a31d6d07-b20b-4012-a393-6bd5147a5ad0",
                        "source_entry_id": "708b6d82-967c-3b9c-8449-a711835560ac",
                        "source_sense_description": "something that is instrumental; an instrument",
                        "target_lang_word": "Mittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2997a0a-de70-3cf3-93c7-4cf92cb886b9",
                                        "entry_id": "ccf53ee9-5c3f-3e0f-8b64-3c51e8736d1c",
                                        "glosses": [
                                            "etwas (eine Maßnahme, Gegenstand, Stoff und so weiter) mit einem bestimmten Zweck/einer gewissen Funktion, um etwas zu erreichen oder zu erzielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab5e418b-7890-459b-957e-ece817cdb7e3",
                                                "sense_id": "c2997a0a-de70-3cf3-93c7-4cf92cb886b9",
                                                "text": "Diese Salbe ist das richtige Mittel für dich."
                                            },
                                            {
                                                "example_id": "fe3c9bb6-f666-4188-95f2-14a839c4af65",
                                                "sense_id": "c2997a0a-de70-3cf3-93c7-4cf92cb886b9",
                                                "text": "Wir müssen ein gutes und sicheres Mittel finden, um das Problem zu lösen."
                                            },
                                            {
                                                "example_id": "80d275f7-5c99-4199-8144-29e0c6fa7bde",
                                                "sense_id": "c2997a0a-de70-3cf3-93c7-4cf92cb886b9",
                                                "text": "Dieses Mittel dient dazu, Unkraut abzutöten."
                                            },
                                            {
                                                "example_id": "54e8fb5f-c86e-4cd3-8dc4-0439bc81c2b7",
                                                "sense_id": "c2997a0a-de70-3cf3-93c7-4cf92cb886b9",
                                                "text": "Sprachliche Mittel sind sinnvoll, um etwas Bestimmtes zum Ausdruck zu bringen."
                                            },
                                            {
                                                "example_id": "8303461e-f950-4b12-a212-244a904266c8",
                                                "sense_id": "c2997a0a-de70-3cf3-93c7-4cf92cb886b9",
                                                "text": "„In einer solchen Zwangslage kann ein Unternehmen versuchen, mit technologischen Mitteln den Einsatz von Rohstoffen zu vermindern. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3b6318f3-65f8-32d6-927e-ab4c58e290b1",
                                        "entry_id": "ccf53ee9-5c3f-3e0f-8b64-3c51e8736d1c",
                                        "glosses": [
                                            "Geldmittel oder andere Werte"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae11aeed-addb-4703-9660-acdecbbecca8",
                                                "sense_id": "3b6318f3-65f8-32d6-927e-ab4c58e290b1",
                                                "text": "Mir fehlen die Mittel, um in den Urlaub zu fahren."
                                            },
                                            {
                                                "example_id": "63c7e1f2-e89c-40c3-806c-4fd1e429bf08",
                                                "sense_id": "3b6318f3-65f8-32d6-927e-ab4c58e290b1",
                                                "text": "„Auch die Herkunft der Mittel ist restlos aufgeklärt. Wir haben lückenlos recherchiert, woher das Geld kam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
