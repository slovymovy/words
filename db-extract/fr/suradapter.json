                ],
                "senses": [
                    {
                        "sense_id": "c00ba1a1-e500-32df-ac8f-a5cbe6f59edb",
                        "entry_id": "5f530ccf-9310-3dc6-938d-f3bfe4c1e951",
                        "glosses": [
                            "S'adapter de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eeba7d2-cefc-4bd4-bfc3-6764190b85d3",
                                "sense_id": "c00ba1a1-e500-32df-ac8f-a5cbe6f59edb",
                                "text": "Si je fais pression sur eux pour qu’ils rentrent dans le rang, ils vont se suradapter ou ils vont s’en aller."
                            },
                            {
                                "example_id": "cc602706-8052-4948-a321-fad1702885d8",
                                "sense_id": "c00ba1a1-e500-32df-ac8f-a5cbe6f59edb",
                                "text": "Si on ne s’autorise pas à être triste, on va également se suradapter en pensant que, quoi qu’il arrive, il faut toujours faire bonne figure et sourire."
                            },
                            {
                                "example_id": "3431feee-0fad-448f-8109-17d6436d3fc4",
                                "sense_id": "c00ba1a1-e500-32df-ac8f-a5cbe6f59edb",
                                "text": "Il faut être de bon compte : se dépasser, ce n’est pas systématiquement se suradapter."
                            }
                        ]
                    }
                ],
