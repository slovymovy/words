                ],
                "senses": [
                    {
                        "sense_id": "a926791d-4496-3673-9b91-3c6c948fd6c3",
                        "entry_id": "105ba852-34df-3df1-998c-aa601838432d",
                        "glosses": [
                            "Donner un caractère socinien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "019ffe20-3453-438c-8b75-7dddf28f9cdd",
                                "sense_id": "a926791d-4496-3673-9b91-3c6c948fd6c3",
                                "text": "Or vous croyez, vous enseignez, vous soutenez tout cela, & d’ailleurs vous n’avez nullement cette soumission aveugle. Donc que vous êtes un Socinien, que vous favorisez le Socinianisme, & que vous induisez à socinianiser ceux qui vous écoutent & qui lisent vos livres."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf66262c-cd3f-36d1-90e7-3e61d8ea737f",
                        "entry_id": "105ba852-34df-3df1-998c-aa601838432d",
                        "glosses": [
                            "Avoir des opinions sociniennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c581f1a-6d0d-4506-bea4-593052cd52df",
                                "sense_id": "bf66262c-cd3f-36d1-90e7-3e61d8ea737f",
                                "text": "Un homme qui n’est pas des sentimens particuliers des Sociniens, c’est ainsi que M. le Clerc s’exprime, peut être accusé de Socinianiser, lorsqu’il a des sentimens, qui favorisent le gros des opinions Sociniennes."
                            }
                        ]
                    }
                ],
