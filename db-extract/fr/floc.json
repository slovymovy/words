                            {
                                "example_id": "6a57e075-3932-451e-8e27-1f39671f2cec",
                                "sense_id": "ed98ec9d-0307-39cc-aaff-d23b2fa82a09",
                                "text": "Trempant en huile bouillante un floc de laine attachée au bout d’une esprouvette."
