                        "examples": [
                            {
                                "example_id": "39869650-ddba-4b30-814c-8eb85d7c2832",
                                "sense_id": "140fd41e-a263-3efd-b94f-6b372def49a7",
                                "text": "Scheringa gebruikte DSB Bank als een soort investeringsvehikel voor onder meer de voetbalclub AZ, het Scheringa-museum, sponsoring van een schaatsploeg en twee zakenvliegtuigen. De financiëel directeur had gewaarschuwd dat daar geen geld voor was."
                            },
                            {
                                "example_id": "b565cbc5-2940-4338-8e90-a24a8ef99f12",
                                "sense_id": "140fd41e-a263-3efd-b94f-6b372def49a7",
                                "text": "Elliott, het investeringsvehikel van miljardair Paul Singer, is boos op AkzoNobel omdat het vindt dat het genegeerd wordt. Maar Singer en zijn mensen laten zich niet zomaar wegsturen en dreigen al weken met actie tegen de bestuurders."
                            }
