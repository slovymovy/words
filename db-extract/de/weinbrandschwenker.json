                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cfa56dd-c998-48f0-8c63-8ed023b199ee",
                                "sense_id": "4bdb9c24-88f1-30a5-a86b-354032f36cea",
                                "text": "„Aus der Kommode nahm sie Likörgläser und Weinbrandschwenker und stellte diese auf ein Tablett.“"
                            },
                            {
                                "example_id": "052cfec7-da5c-4233-bcf8-596c29ab69e6",
                                "sense_id": "4bdb9c24-88f1-30a5-a86b-354032f36cea",
                                "text": "„Gino schob Herrn Karwendel ein schön gezapftes, mit einer Schaumspitze gekröntes Pils in einem kleinen Weinbrandschwenker hin.“"
                            },
                            {
                                "example_id": "40f89902-137e-462f-8009-20423aaea295",
                                "sense_id": "4bdb9c24-88f1-30a5-a86b-354032f36cea",
                                "text": "„Zu Hause habe sie einen großen Weinbrandschwenker, vertraut mir eine braungebrannte Mitsiebzigerin an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
