                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7221d0d-b710-4f24-9417-90e1b56ae402",
                                                "sense_id": "48e47717-b0a4-3ec6-bc9f-40701b87a94e",
                                                "text": "The oldest explicit information concerning a Nomado-Slavic State on the lower Danube is to be found in Pseudo-Caesarius of the Nazianzus of the sixth – probably even the fourth – century A.D., viz. that of the galactophagous Phisonitae or Danubians […] and the vegetarian Slavs."
                                            },
                                            {
                                                "example_id": "c091d2d3-d3a4-4502-8111-59eb9d867665",
                                                "sense_id": "48e47717-b0a4-3ec6-bc9f-40701b87a94e",
                                                "text": "I am reading Herodotus, who describes in detail and with great fidelity these same galactophagous Scythians among whom I am living."
                                            },
                                            {
                                                "example_id": "27be011a-6222-4740-839a-90522d4ab33d",
                                                "sense_id": "48e47717-b0a4-3ec6-bc9f-40701b87a94e",
                                                "text": "Of course, we may not have the same taste in teas, as I am one of the few (the proud, the galactophagous) that adds milk to tea."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
