                "senses": [
                    {
                        "sense_id": "4bef32b1-00f2-3b0c-8cdc-bbea3bab50e7",
                        "entry_id": "820cd932-9013-3a0c-bed6-3694adc65b39",
                        "glosses": [
                            "in de lengte gemeten"
