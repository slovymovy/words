                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "88bc83ce-5ae9-408f-8401-b836bec6188b",
                        "entry_id": "c7b34d0c-b7d3-399e-9fa7-2320fdde8ce4",
                        "tags": [
                            "plural",
