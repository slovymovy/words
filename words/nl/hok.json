                {
                    "sense_id": "ea1e9848-989c-3e3f-b26e-79265295f47a",
                    "sense_definition": "Een armoedige, kleine of vieze woning",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dwelling_pejorative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is schandalig dat ze zoveel huur vragen voor dat tochtige <w>hok</w>.",
                            "target_lang_translations": {
                                "en": "It is scandalous that they charge so much rent for that drafty <w>hovel</w>.",
                                "ru": "Возмутительно, что они просят такую высокую аренду за эту сквозящую <w>халупу</w>.",
                                "pl": "To skandaliczne, że żądają tak wysokiego czynszu za tę przewiewną <w>norę</w>.",
                                "de": "Es ist unverschämt, dass sie so viel Miete für diese zugige <w>Bruchbude</w> verlangen.",
                                "fr": "C'est scandaleux qu'ils demandent un tel loyer pour ce <w>taudis</w> plein de courants d'air.",
                                "it": "È scandaloso che chiedano così tanto affitto per quella <w>stamberga</w> piena di spifferi.",
                                "cs": "Je skandální, že chtějí tak vysoké nájemné za tu profukující <w>barabiznu</w>.",
                                "tr": "O rüzgar alan döküntü <w>delik</w> için bu kadar çok kira istemeleri skandal.",
                                "es": "Es escandaloso que pidan tanto alquiler por ese <w>tugurio</w> con corrientes de aire."
                            }
                        },
                        {
                            "text": "Ik weiger om met mijn gezin in zo'n vies <w>hok</w> te gaan wonen.",
                            "target_lang_translations": {
                                "en": "I refuse to go live in such a dirty <w>dump</w> with my family.",
                                "ru": "Я отказываюсь жить с семьей в такой грязной <w>дыре</w>.",
                                "pl": "Omawiam mieszkania z moją rodziną w takim brudnym <w>chlewie</w>.",
                                "de": "Ich weigere mich, mit meiner Familie in so einem dreckigen <w>Loch</w> zu wohnen.",
                                "fr": "Je refuse d'aller vivre avec ma famille dans un <w>trou</w> aussi sale.",
                                "it": "Mi rifiuto di andare a vivere con la mia famiglia in una <w>topaia</w> così sporca.",
                                "cs": "Odmítám jít se svou rodinou bydlet do takové špinavé <w>díry</w>.",
                                "tr": "Ailemle birlikte böyle kirli bir <w>ahırda</w> yaşamayı reddediyorum.",
                                "es": "Me niego a ir a vivir con mi familia a una <w>pocilga</w> tan sucia."
                            }
