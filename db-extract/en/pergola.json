                        "cross_references": [
                            {
                                "target_word": "pergola",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6fd0e288-7d15-3ace-acc9-b4ff3d82c638",
                                        "entry_id": "8a1c111b-b6ca-3025-85b8-294b17c41601",
                                        "glosses": [
                                            "een constructie van horizontale latten op hoge palen, waarlangs allerlei planten kunnen groeien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea6df0b9-0a81-4b77-97de-b50f6106e361",
                                                "sense_id": "6fd0e288-7d15-3ace-acc9-b4ff3d82c638",
                                                "text": "Ross en Fanjul waren zo goed bevriend dat de huidige minister samen met zijn vrouw in 2009 te gast was in Casa de Campo, een luxeresort in de Dominicaanse Republiek dat eigendom is van Fanjul. Ross’ echtgenote Hillary hield een verslag van de trip bij op de website New York Social Diary - inclusief kiekjes. Dineren al fresco, verse bloemen bij het ontbijt, boottochtjes naar verlaten stranden, en dan weer een yummy lunch onder de pergola. ‘De Fanjuls wonen in het paradijs’, concludeert Hilary Geary Ross in haar verslag, dat nog steeds online staat."
                                            },
                                            {
                                                "example_id": "13643786-6d3f-40e8-8049-de2816abd76d",
                                                "sense_id": "6fd0e288-7d15-3ace-acc9-b4ff3d82c638",
                                                "text": "Bij aankomst in Den Bosch woensdag kregen de jongens direct het ontwerp van Emiel Versluis onder ogen. \"Een uitdagend ontwerp, waarbij vooral de houtconstructie een lastig onderdeel was\", zegt Schoolderman. \"Een oase in de woestijn als ontwerp met zeer technische elementen zoals een pergola waar veel zaagtechniek aan te pas komt.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "383aaf86-ba55-4874-acc9-1da104c36fcc",
                        "source_entry_id": "a52a70b4-2565-3922-89f0-7c67846b710f",
                        "source_sense_description": "framework",
                        "target_lang_word": "pergola",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pergola",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df31fc7a-cc35-3498-8231-6512ad1fd26b",
                                        "entry_id": "1fec8e98-d4fa-3bb0-a0ec-1484031d45b4",
                                        "glosses": [
                                            "Construction généralement en bois, très ajourée, sur laquelle on laisse souvent pousser des plantes grimpantes, des arbustes."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30a5f494-a87f-44af-bb1b-6706f6072766",
                                                "sense_id": "df31fc7a-cc35-3498-8231-6512ad1fd26b",
                                                "text": "Nous passions nos après-midi d'été à l’ombre de la pergola."
                                            },
                                            {
                                                "example_id": "b0fe0e3b-b9b4-46b7-a91a-f588ccf4df1a",
                                                "sense_id": "df31fc7a-cc35-3498-8231-6512ad1fd26b",
                                                "text": "La pergola peut aussi prolonger la façade de la maison (arrière ou avant) et constituer un cadre architecturé pour la terrasse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af13874d-82b5-4656-94e6-d3f9cee380e4",
                        "source_entry_id": "a52a70b4-2565-3922-89f0-7c67846b710f",
                        "source_sense_description": "framework",
                        "target_lang_word": "Pergola",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pergola",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f336dd1-ea29-3b3d-b188-8936d3063a41",
                                        "entry_id": "8430643e-1eb9-313e-80f1-df88f9d4c123",
                                        "glosses": [
                                            "raumbildender Säulen- oder Pfeilergang, typischerweise mit Rankpflanzen wie zum Beispiel Wein oder Efeu bewachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04f14546-8a70-4784-a228-61d5e5c7eac7",
                                                "sense_id": "0f336dd1-ea29-3b3d-b188-8936d3063a41",
                                                "text": "Wir haben uns für die Terrasse eine Pergola gebaut."
                                            },
                                            {
                                                "example_id": "ba07a2ca-be9f-4c19-acd5-ca32e4af509a",
                                                "sense_id": "0f336dd1-ea29-3b3d-b188-8936d3063a41",
                                                "text": "„Vor dem Eingang des Restaurants gab es eine Pergola, unter der man im Freien essen konnte; Lärm, Staub und Gestank des Straßenverkehrs ließen sie aber das Innere aufsuchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
