                "senses": [
                    {
                        "sense_id": "57d8da5d-41af-31f3-b97d-b64e15bbc7c8",
                        "entry_id": "29002106-8760-3bce-bb16-053685d9de6b",
                        "glosses": [
                            "Drucker, bei dem Tinte (Druckertinte) durch feine Düsen gepresst wird um die zu druckenden Zeichen zu Papier zu bringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a86a29f3-1fd5-4b71-b633-68a4a22f2546",
                                "sense_id": "57d8da5d-41af-31f3-b97d-b64e15bbc7c8",
                                "text": "„Dazu braucht es eine Lösung aus Eisennitrat, die mit einem handelsüblichen Tintenstrahldrucker aufgetragen wird.“"
                            },
                            {
                                "example_id": "aaef23fc-7df6-46a5-8323-8acb4e92e309",
                                "sense_id": "57d8da5d-41af-31f3-b97d-b64e15bbc7c8",
                                "text": "„Tintenstrahldrucker blockieren, wenn Patronen nicht aus Deutschland kommen, zu lange im Schrank lagen oder ein vorab definiertes Limit erreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
