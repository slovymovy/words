                        "form": "die Kiefernwälder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a6b7cf54-48e2-3d02-8027-808c0c7ad3b8",
                        "entry_id": "4996e0cb-fa07-363d-a1af-1354dffa5984",
                        "glosses": [
                            "Wald, der vorwiegend oder ausschließlich aus Kiefernbäumen besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb7e8acb-b891-48c5-b0ad-b2a47a806947",
                                "sense_id": "a6b7cf54-48e2-3d02-8027-808c0c7ad3b8",
                                "text": "Oben im Kiefernwald gibt es eine alte Holzhütte."
                            },
                            {
                                "example_id": "7d5dfd3c-4122-485c-80d5-002e78e50b41",
                                "sense_id": "a6b7cf54-48e2-3d02-8027-808c0c7ad3b8",
                                "text": "„Ein Team mit österreichischer Beteiligung hat diese Verbindungen nun in einem fast unberührten Kiefernwald erfasst.“"
                            },
                            {
                                "example_id": "828ba1a9-6cf7-4b3a-9053-a10d9638ffc1",
                                "sense_id": "a6b7cf54-48e2-3d02-8027-808c0c7ad3b8",
                                "text": "„Er blickt hinüber zu den Nudisten, die in den Dünen am Rand des Kiefernwaldes liegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c5bda12-74c9-4294-93a8-eedf5b831a6c",
                        "source_entry_id": "4996e0cb-fa07-363d-a1af-1354dffa5984",
                        "source_sense_id": "a6b7cf54-48e2-3d02-8027-808c0c7ad3b8",
                        "source_sense_description": "Wald, der vorwiegend oder ausschließlich aus Kiefernbäumen besteht",
                        "target_lang_word": "pinewood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pinewood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfaeee09-dd9c-35e9-a16d-6788dbb3fc7f",
                                        "entry_id": "b193d753-8e7f-3b9a-9164-ad8150dcee0f",
                                        "glosses": [
                                            "The wood of a pine."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e3614ef-8759-420b-b3ef-3d117aac682f",
                                                "sense_id": "cfaeee09-dd9c-35e9-a16d-6788dbb3fc7f",
                                                "text": "pinewood furniture"
                                            },
                                            {
                                                "example_id": "12709677-570b-4b9a-bc97-5d65b85ebe72",
                                                "sense_id": "cfaeee09-dd9c-35e9-a16d-6788dbb3fc7f",
                                                "text": "pinewood derby"
                                            },
                                            {
                                                "example_id": "2646368a-19cb-4b87-9226-709ebf591e87",
                                                "sense_id": "cfaeee09-dd9c-35e9-a16d-6788dbb3fc7f",
                                                "text": "On the floor in dry parts of the cave, the researchers found two hearths. They also picked up charcoal from crevices and ledges, which they believe are from pinewood torches that the Stone Age visitors carried."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "150127c7-e6e6-3c2f-995b-95cc5769e587",
                                        "entry_id": "b193d753-8e7f-3b9a-9164-ad8150dcee0f",
                                        "glosses": [
                                            "A forest or grove of pine trees, either natural or as a plantation."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "911d5ab5-c1e7-46d7-9803-ae7ad213694f",
                                                "sense_id": "150127c7-e6e6-3c2f-995b-95cc5769e587",
                                                "text": "Near-synonyms: pinery, pinetum; pineland"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5bf8785c-b2e3-458c-a095-26ca414abaa8",
                        "source_entry_id": "4996e0cb-fa07-363d-a1af-1354dffa5984",
                        "source_sense_id": "a6b7cf54-48e2-3d02-8027-808c0c7ad3b8",
                        "source_sense_description": "Wald, der vorwiegend oder ausschließlich aus Kiefernbäumen besteht",
                        "target_lang_word": "pinède",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pinède",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d8dfd37-c1d6-310c-869c-c41603907f5a",
                                        "entry_id": "bb752f79-684b-398c-80d9-e6d2aa5f07ec",
                                        "glosses": [
                                            "Lieu planté de pins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74bde980-fe7b-43d7-8709-387b36816a7c",
                                                "sense_id": "4d8dfd37-c1d6-310c-869c-c41603907f5a",
                                                "text": "Les pinèdes, ainsi que les massifs de bruyères et de chênes kermès deviennent particulièrement inflammables."
                                            },
                                            {
                                                "example_id": "2b86b709-ed0a-479c-b12a-94facda0bc4e",
                                                "sense_id": "4d8dfd37-c1d6-310c-869c-c41603907f5a",
                                                "text": "Ce mot était aussi chaque été la source d'une peur démesurée : celle d'être aspiré par un Canadair alors que je nageais en Méditerranée et d'être jeté, à quelques kilomètre de là, dans les flammes d'une pinède dévastée."
                                            },
                                            {
                                                "example_id": "254031f2-3ba5-4e50-92f7-83c24fed94cc",
                                                "sense_id": "4d8dfd37-c1d6-310c-869c-c41603907f5a",
                                                "text": "S’il y songeait depuis un moment, voilà que le Conseil Mohawk de Kanesatake a décidé d’aller de l’avant : il poursuit devant les tribunaux la Ville d’Oka et le gouvernement du Québec, à qui il reproche l’adoption récente d’un règlement qui fait de la pinède un site patrimonial municipal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
