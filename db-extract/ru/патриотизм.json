                    {
                        "form_id": "f4c9d021-53e9-4bdb-94d3-ba4077a70bc0",
                        "entry_id": "8886e69f-7d18-324e-a2e2-4c6a31b0eae2",
                        "tags": [
                            "singular",
                            "prepositional"
                        ],
                        "form": "патриоти́зме"
                    },
                    {
                        "form_id": "83ae343a-c0dc-4bda-a7ec-8429e2cd1583",
                        "entry_id": "8886e69f-7d18-324e-a2e2-4c6a31b0eae2",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "патриоти́змах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "98b683fd-8276-3449-9b2b-1f0877e35d4e",
                        "entry_id": "8886e69f-7d18-324e-a2e2-4c6a31b0eae2",
                        "glosses": [
                            "чувство любви к родине, идея, сознание гражданской ответственности за судьбы отечества, выражающиеся в стремлении своими действиями служить ради своего народа, ради защиты его интересов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8f7990c-082d-4d00-99db-80b04d8afb46",
                                "sense_id": "98b683fd-8276-3449-9b2b-1f0877e35d4e",
                                "text": "Ненависть немцев к французам, англичан к янки и русских к японцам и т. п. и обратно считается добродетелью патриотизма."
                            },
                            {
                                "example_id": "7b1c0694-f6ad-4a5c-a064-40c7c54ee95d",
                                "sense_id": "98b683fd-8276-3449-9b2b-1f0877e35d4e",
                                "text": "Патриотизм — одно из наиболее глубоких чувств, закреплённых веками и тысячелетиями обособленных отечеств."
                            },
                            {
                                "example_id": "c4d38ca8-99d8-4414-bf44-fbc432770a01",
                                "sense_id": "98b683fd-8276-3449-9b2b-1f0877e35d4e",
                                "text": "Общеизвестно, что большой патриотизм начинается с малого, — с любви к тому месту, где живёшь."
                            }
                        ]
                    },
                    {
                        "sense_id": "f547d7cf-13cb-3df1-8895-412f31473026",
                        "entry_id": "8886e69f-7d18-324e-a2e2-4c6a31b0eae2",
                        "glosses": [
                            "разг. преданность, приверженность чему-либо, привязанность к чему-либо (например, к месту своего рождения, к месту жительства, к работе, службе и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8480ace1-ee1d-4ae8-b488-62274b522f1e",
                                "sense_id": "f547d7cf-13cb-3df1-8895-412f31473026",
                                "text": "Местный патриотизм."
                            },
                            {
                                "example_id": "08d4e597-e8b5-400f-a82c-9bcef3cf4fc9",
                                "sense_id": "f547d7cf-13cb-3df1-8895-412f31473026",
                                "text": "Заводской патриотизм."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3bbf7a4a-807b-4b0e-86d7-9064a8a1e89f",
                        "source_entry_id": "8886e69f-7d18-324e-a2e2-4c6a31b0eae2",
                        "source_sense_description": "чувство любви к родине, идея, сознание гражданской ответственности за судьбы отечества, выражающиеся в стремлении своими действиями служить ради своего народа, ради защиты его интересов",
                        "target_lang_word": "patriotism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patriotism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7a251c0-1d4a-37d5-84d1-e799fed4477d",
                                        "entry_id": "ea8c17d4-b6f5-3901-b45b-ee78874d1a0d",
                                        "glosses": [
                                            "Love of one's country; devotion to the welfare of one's compatriots; passion which inspires one to serve one's country."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6430e1f-d8bb-4edf-a754-b6196b912e74",
                                                "sense_id": "f7a251c0-1d4a-37d5-84d1-e799fed4477d",
                                                "text": "That public virtue, which among the ancients was denominated patriotism, is derived from a strong sense of our own interest in the preservation and prosperity of the free government of which we are members."
                                            },
                                            {
                                                "example_id": "e7e8bb5d-7372-468a-a39d-e5489a833472",
                                                "sense_id": "f7a251c0-1d4a-37d5-84d1-e799fed4477d",
                                                "text": "In the hour of death we shall have the consolation to see established in the land of our fathers the most wonderful work of wisdom and disinterested patriotism that has ever yet appeared on the globe."
                                            },
                                            {
                                                "example_id": "56cfa0b0-5909-44c9-bba5-a3b05e96a617",
                                                "sense_id": "f7a251c0-1d4a-37d5-84d1-e799fed4477d",
                                                "text": "The subject of his play was the fate of Agis, the young and heroic King of Sparta: it gave the ideal of patriotism, relieved by the tenderness of sorrow, and the fidelity of love."
                                            },
                                            {
                                                "example_id": "6f431755-f7c7-4c22-b709-9efdb09d586e",
                                                "sense_id": "f7a251c0-1d4a-37d5-84d1-e799fed4477d",
                                                "text": "Both Blimps and highbrows took for granted, as though it were a law of nature, the divorce between patriotism and intelligence. If you were a patriot you read Blackwood's Magazine and publicly thanked God that you were \"not brainy\". If you were an intellectual you sniggered at the Union Jack and regarded physical courage as barbarous. It is obvious that this preposterous convention cannot continue... Patriotism and intelligence will have to come together again."
                                            },
                                            {
                                                "example_id": "7e9d8675-b045-4348-a507-9410e2460008",
                                                "sense_id": "f7a251c0-1d4a-37d5-84d1-e799fed4477d",
                                                "text": "I told the Governors that I had never questioned the capacity or the sincerity or the ability of a man because he belonged to a different political party. No party had an overriding claim to patriotism. The times, I said, demanded that we put away our differences and close ranks in a determined effort to make our system of government function."
                                            },
                                            {
                                                "example_id": "83ff260e-797e-4d07-9164-0cd5e705e2e4",
                                                "sense_id": "f7a251c0-1d4a-37d5-84d1-e799fed4477d",
                                                "text": "The most extraordinary positive development in Czechoslovakia since its creation in 1918, the tumultuous outpouring of patriotism and protest was dared by students and intellectuals and soon embraced steel-workers and elderly pensioners."
                                            },
                                            {
                                                "example_id": "38d42a8a-0eeb-48f6-b515-c1ab579c8ff2",
                                                "sense_id": "f7a251c0-1d4a-37d5-84d1-e799fed4477d",
                                                "text": "In Europe's capital, Brussels, technocrats, strategists and legislators increasingly see their role as being the global balancer between America and China. Jorgo Chatzimarkakis, a German member of the European Parliament, calls it 'European patriotism.' The Europeans play both sides, and if they do it well, they profit handsomely"
                                            },
                                            {
                                                "example_id": "c6624f81-b6bd-48ea-a7e6-bd61328db198",
                                                "sense_id": "f7a251c0-1d4a-37d5-84d1-e799fed4477d",
                                                "text": "\"I have the intense patriotism of an immigrant,\" says Ferguson"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "207570b4-21eb-3319-a0ac-463d9cf6f8ae",
                                        "entry_id": "ea8c17d4-b6f5-3901-b45b-ee78874d1a0d",
                                        "glosses": [
                                            "The actions of a patriot"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6450f79-c7c3-3e69-afcb-50eca699b0b1",
                                        "entry_id": "ea8c17d4-b6f5-3901-b45b-ee78874d1a0d",
                                        "glosses": [
                                            "The desire to compete sharply with, and perhaps also dominate, other nations; nationalism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03ef2d8b-137d-4905-9dfd-c6040d48acab",
                                                "sense_id": "b6450f79-c7c3-3e69-afcb-50eca699b0b1",
                                                "text": "Near-synonyms: chauvinism, superpatriotism"
                                            },
                                            {
                                                "example_id": "9874c5f3-ed2d-4d0e-958f-4c70fd938c6f",
                                                "sense_id": "b6450f79-c7c3-3e69-afcb-50eca699b0b1",
                                                "text": "Patriotism cannot be good. What produces war is the desire for an exclusive good for one’s own nation – that is called patriotism. And so to abolish war, it is necessary to abolish patriotism, and to abolish patriotism, it is necessary first to become convinced that it is an evil."
                                            },
                                            {
                                                "example_id": "2b7b1109-0d37-4917-9439-56621a54e507",
                                                "sense_id": "b6450f79-c7c3-3e69-afcb-50eca699b0b1",
                                                "text": "Economic protectionism within the older member states has, in fact, increased in the past year. Calls for economic patriotism have given rise to efforts to create national champions designed to protect key strategic industries from foreign competition."
                                            },
                                            {
                                                "example_id": "d1456c40-7946-414c-8646-3c39dfd12673",
                                                "sense_id": "b6450f79-c7c3-3e69-afcb-50eca699b0b1",
                                                "text": "The idea that Ireland's rugby and soccer fans would have to go to England to follow their teams was intrinsically unpalatable, Kelly said, but he was also motivated by common sense: \"That would have been an immense cost to the economy, it would have been a major drain on the fans, but the prestige and image of the country would also have been affected badly.\" / His pragmatic patriotism paid off."
                                            },
                                            {
                                                "example_id": "818d1438-81a4-48e6-917e-9418ae23104a",
                                                "sense_id": "b6450f79-c7c3-3e69-afcb-50eca699b0b1",
                                                "text": "\"It is not only an international sports event, but also a very important political mission,\" stated a 2006 opinion article in the People's Daily. \"It is not only an Olympic feast for the Chinese people, it can also arouse Chinese patriotism.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "828b451d-0a86-4901-b5a0-c32dadcfa7d5",
                        "source_entry_id": "8886e69f-7d18-324e-a2e2-4c6a31b0eae2",
                        "source_sense_description": "чувство любви к родине, идея, сознание гражданской ответственности за судьбы отечества, выражающиеся в стремлении своими действиями служить ради своего народа, ради защиты его интересов",
                        "target_lang_word": "patriotyzm",
