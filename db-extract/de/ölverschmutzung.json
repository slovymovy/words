                "senses": [
                    {
                        "sense_id": "7415ec83-28b5-3cf9-87e9-5ca8f6d464ab",
                        "entry_id": "2d2515bd-2e91-358d-9d4a-44837d352fe8",
                        "glosses": [
                            "Verunreinigung eines Gewässers oder Bodens durch Rohöl oder ein Erdölprodukt"
                        ],
                        "tags": [
                            "Umwelt"
                        ],
                        "examples": [
                            {
                                "example_id": "0e54c965-4688-47e9-b63e-2ed44e99b215",
                                "sense_id": "7415ec83-28b5-3cf9-87e9-5ca8f6d464ab",
                                "text": "[Magellanpinguine:] „Eine Gefährdung des Bestands geht besonders von Ölverschmutzung des Meerwassers aus,“ […]."
                            },
                            {
                                "example_id": "615a4639-b3c8-4af3-809a-5dfc56eee6b9",
                                "sense_id": "7415ec83-28b5-3cf9-87e9-5ca8f6d464ab",
                                "text": "„Die Quelle der Ölverschmutzung war also nicht versiegt.“"
                            },
                            {
                                "example_id": "ef64e746-0055-44eb-a36b-9eec4e43af12",
                                "sense_id": "7415ec83-28b5-3cf9-87e9-5ca8f6d464ab",
                                "text": "„Während der Fahrt wurden Ölverschmutzungen im Atlantik dokumentiert, die man schon auf der ersten Fahrt entdeckt hatte.“"
                            },
                            {
                                "example_id": "8572569a-6b3a-4285-9634-c66f7a486a9e",
                                "sense_id": "7415ec83-28b5-3cf9-87e9-5ca8f6d464ab",
                                "text": "„Bei der Ölkatastrophe im Nigerdelta handelt es sich um eine anhaltende Ölverschmutzung, bei der in den letzten 50 Jahren nach Expertenschätzungen mehr als zwei Millionen Tonnen Rohöl das Ökosystem des Nigerdeltas verschmutzt haben.“"
                            },
                            {
                                "example_id": "0f0b0f9b-26e1-46b0-8e1a-74449d78b1dd",
                                "sense_id": "7415ec83-28b5-3cf9-87e9-5ca8f6d464ab",
                                "text": "„Vögel sind die auffälligsten Opfer von Ölverschmutzungen auf See und zuverlässige Bioindikatoren insbesondere für das Ausmaß der chronischen Ölverschmutzung.“"
                            },
                            {
                                "example_id": "9428f4c0-f22e-4437-9d02-52780031eba8",
                                "sense_id": "7415ec83-28b5-3cf9-87e9-5ca8f6d464ab",
                                "text": "„Der Tanker hatte fast 10.000 Tonnen Rohöl an Bord, von denen bis zu 2.000 ins Meer flossen. Noch 19 Jahre danach galt auf der Insel de Sein ein Fischfangverbot wegen der Ölverschmutzung.“"
                            },
                            {
                                "example_id": "11041f0a-58eb-421a-a057-217ce2467199",
                                "sense_id": "7415ec83-28b5-3cf9-87e9-5ca8f6d464ab",
                                "text": "„In der kanadischen Provinz Alberta kämpfen Einsatzkräfte gegen eine gigantische Ölverschmutzung. Etwa 4,5 Millionen Liter Öl belasten den Boden, nach dem grössten Leck einer Ölpipeline seit Jahrzehnten.“"
                            },
                            {
                                "example_id": "d9bd9beb-7680-4182-9cb9-e65e385fc65f",
                                "sense_id": "7415ec83-28b5-3cf9-87e9-5ca8f6d464ab",
                                "text": "„In der Schweiz kommt es durchschnittlich jeden zweiten Tag zu einem Fischsterben.“ […] „Häufige Ursachen sind Gülle, schädliche Abwasser sowie Ölverschmutzungen.“"
                            },
                            {
                                "example_id": "640789de-f0bc-4cf7-933b-74164fffc88b",
                                "sense_id": "7415ec83-28b5-3cf9-87e9-5ca8f6d464ab",
                                "text": "„»In Mexiko haben wir Jahre damit verbracht, unzählige Ölverschmutzungen an unseren Küsten zu beseitigen.«“"
                            },
                            {
                                "example_id": "13f85549-c8cc-4ad3-908c-9aa03052da9a",
                                "sense_id": "7415ec83-28b5-3cf9-87e9-5ca8f6d464ab",
                                "text": "„An der Beseitigung der Ölverschmutzung hatten sich tausende Einwohner von Mauritius beteiligt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
