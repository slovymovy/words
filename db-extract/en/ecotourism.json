                        "target_lang_word": "duurzaam toerisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6df163d8-093f-4ed6-ae3b-dee70b56ac4e",
                        "source_entry_id": "49e02808-76f2-31c0-a3f9-525070bd8873",
                        "source_sense_id": "6c93316a-2f58-3fe7-835a-9f1958e94c03",
                        "source_sense_description": "responsible travel",
                        "target_lang_word": "écotourisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écotourisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af8af7b1-38f3-3e44-87d2-82c85ba4c1e5",
                                        "entry_id": "0f4d143c-72be-335b-84e8-dd04e69858f0",
                                        "glosses": [
                                            "Tourisme centré sur la découverte de la nature, dans le respect de l'environnement et des populations locales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cffb51c-75dd-4648-b019-b4142d1a26af",
                                                "sense_id": "af8af7b1-38f3-3e44-87d2-82c85ba4c1e5",
                                                "text": "Découvrez l’écotourisme en Cévennes grâce à notre réseau de membres engagés pour réduire leur impact sur l’environnement tout en redonnant du sens au voyage."
                                            },
                                            {
                                                "example_id": "f1b45ef1-85bf-464b-b6d4-848e430a793b",
                                                "sense_id": "af8af7b1-38f3-3e44-87d2-82c85ba4c1e5",
                                                "text": "L’Organisation mondiale du tourisme (OMT) fait de l’écotourisme l'une des branches du \"tourisme durable\" : l’écotourisme tend à minimiser l'impact sur l'environnement pour le préserver à long terme."
                                            },
                                            {
                                                "example_id": "9771fa11-7997-4871-808b-2264c205a3cc",
                                                "sense_id": "af8af7b1-38f3-3e44-87d2-82c85ba4c1e5",
                                                "text": "Les premiers concepts d’écotourisme sont apparus au début des années 80, en phase avec le début de la prise de conscience collective lié à l’environnement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
