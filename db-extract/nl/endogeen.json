                                            "odborně"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4df2c3e9-d2c6-4060-afdf-089ca2328c2e",
                                                "sense_id": "d6695af1-9458-3486-a715-815dd7dc6ef7",
                                                "text": "Horečku vyvolávají endogenní pyrogeny (IL-1, IL-2, TNF-alfa a IFN gama), které stimulují termoregulační centrum v hypothalamu."
                                            },
                                            {
                                                "example_id": "600afdc2-64d0-4d12-b711-819285a38429",
                                                "sense_id": "d6695af1-9458-3486-a715-815dd7dc6ef7",
                                                "text": "Dojde k přemnožení rezistentních klonů vlastní mikrobiální flory, která se tak může uplatnit jako patogen. Mluvíme pak o endogenní infekci."
                                            },
                                            {
                                                "example_id": "d224be0b-9d38-49c7-b857-be5c32ece839",
                                                "sense_id": "d6695af1-9458-3486-a715-815dd7dc6ef7",
                                                "text": "První škola tvrdí, že existuje endogenní kauzalita postupného ochromení systému (kupříkladu Marxova teorie, zákon relativního snižování míry zisku)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e46082a9-ff55-328e-a84c-4fb9dd89bf81",
                                        "entry_id": "ceb19404-34d5-344d-bf56-b93083082462",
                                        "glosses": [
                                            "týkající se vnitřních geologických procesů"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0afb63d9-fb63-48bf-89f6-f8f33a87762a",
                                                "sense_id": "e46082a9-ff55-328e-a84c-4fb9dd89bf81",
                                                "text": "Buď se jedná o dosud neznámé útvary, jež jsou výsledkem endogenních (povrchových či těsně podpovrchových) procesů, nebo to mohou být erodované tzv. sekundární krátery."
                                            }
