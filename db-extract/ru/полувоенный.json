                        "cross_references": [
                            {
                                "target_word": "paramilitary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71a084ef-d2be-3bd0-bc55-8d69f2b5aeeb",
                                        "entry_id": "decf4729-23b6-361b-9c7f-cf8c0171195d",
                                        "glosses": [
                                            "A group of civilians trained and organized in a military fashion, but which do not represent the formal forces of a sovereign power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c120a27f-f89e-41c8-b17f-16c09419f580",
                                                "sense_id": "71a084ef-d2be-3bd0-bc55-8d69f2b5aeeb",
                                                "text": "From the start of its operations in Colombia, the company was on guard against the decadeslong civil strife in the country between left-wing guerrilla and right-wing paramilitary groups, witnesses have testified."
                                            },
                                            {
                                                "example_id": "f2ffd6ab-e5c3-48a6-be9a-ff6283d48fe8",
                                                "sense_id": "71a084ef-d2be-3bd0-bc55-8d69f2b5aeeb",
                                                "text": "Cossack paramilitaries operate in Ukraine and southern Russia. […] Before he entered eastern Ukraine, Girkin led paramilitary groups in Crimea and negotiated with Ukrainian military officers in attempts to induce them to defect to Russia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63856ec9-8ef0-34dc-b99c-16d58ef6c8f6",
                                        "entry_id": "decf4729-23b6-361b-9c7f-cf8c0171195d",
                                        "glosses": [
                                            "A member of a paramilitary group."
                                        ],
