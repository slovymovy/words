                                        ]
                                    },
                                    {
                                        "sense_id": "8acc4fb6-2ef3-3e03-a744-da122925fc99",
                                        "entry_id": "ab254279-e1f7-3fb2-bd11-7309faec8761",
                                        "glosses": [
                                            "Stabling."
                                        ],
                                        "tags": [
