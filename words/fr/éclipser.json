{
    "word_family": [
        "éclipse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "94c38b75-03ce-314d-9099-5ac349583f0d",
                    "sense_definition": "Disparaître discrètement ou rapidement d'un lieu sans se faire remarquer, s'en aller furtivement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "disparition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fatigué par cette longue réunion, Marc a préféré s'<w>éclipser</w> discrètement par la porte arrière."
                        },
                        {
                            "text": "Elle a attendu que tout le monde danse pour s'<w>éclipser</w> sans bruit de la fête."
                        }
                    ],
                    "synonyms": [
                        "disparaître",
                        "s'esquiver"
                    ],
                    "antonyms": [
                        "apparaître",
                        "surgir"
                    ],
                    "common_phrases": [
                        "s'éclipser discrètement",
                        "s'éclipser sans bruit"
                    ]
                },
                {
                    "sense_id": "ff7b839c-6eee-32dc-9f8b-208548c3dd73",
                    "sense_definition": "Faire oublier ou reléguer au second plan par une supériorité éclatante, surpasser.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surpasser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La performance remarquable de la jeune pianiste a réussi à <w>éclipser</w> tous ses rivaux."
                        },
                        {
                            "text": "Son talent extraordinaire finit par <w>éclipser</w> la réputation de ses prédécesseurs."
                        }
                    ],
                    "synonyms": [
                        "surpasser",
                        "ombrager"
                    ],
                    "common_phrases": [
                        "éclipser ses rivaux",
                        "éclipser la concurrence"
                    ]
                },
                {
                    "sense_id": "6cc22727-d251-3812-b517-502b76c28660",
                    "sense_definition": "Occulter totalement ou partiellement un astre ou un corps céleste en s'interposant devant lui.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "astronomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lors de cet événement astronomique rare, la Lune vient <w>éclipser</w> le Soleil pendant quelques minutes."
                        },
                        {
                            "text": "Les nuages denses menacent d'<w>éclipser</w> complètement la lumière de la Lune ce soir."
                        }
                    ],
                    "synonyms": [
                        "masquer",
                        "occulter"
                    ],
                    "common_phrases": [
                        "éclipser le soleil",
                        "éclipser un astre"
                    ]
                }
            ]
        }
    ]
}