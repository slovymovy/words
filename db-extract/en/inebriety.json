                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "820bf185-b1c0-46fa-b1b8-568e9b6db8f2",
                        "entry_id": "10605a26-13c6-32b1-95f8-c20fbded6d55",
                        "tags": [
                            "plural"
