                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stealing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Złodziej sprytnie wykorzystał tłum w sklepie i bez trudu <w>zasunął</w> drogi zegarek.",
                            "target_lang_translations": {
                                "ru": "Вор ловко воспользовался толпой в магазине и без труда <w>стащил</w> дорогие часы."
                            }
