                "senses": [
                    {
                        "sense_id": "550aba25-82de-33c0-9f28-619723011a19",
                        "entry_id": "20040a89-28ae-3bc0-83ac-facc56db2c15",
                        "glosses": [
                            "Voraussetzung oder Vermutung, welche die Basis, Grundlage für etwas bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4db7643b-593b-4317-9e8f-20f9bc9350f3",
                                "sense_id": "550aba25-82de-33c0-9f28-619723011a19",
                                "text": "„Das Gehirn, so lautet die Grundannahme, ist durch die Geschichte seiner Entstehung geprägt.“"
                            },
                            {
                                "example_id": "27f5478a-b369-4edc-8469-a5b6d5aa95c9",
                                "sense_id": "550aba25-82de-33c0-9f28-619723011a19",
                                "text": "„Dabei sind sie von der Grundannahme ausgegangen, dass der Schaugarten ein Ort in der Stadt sein soll, an dem sich Pflanze, Natur und Mensch begegnen.“"
                            },
                            {
                                "example_id": "65b578de-d631-472f-b934-90de6174a89e",
                                "sense_id": "550aba25-82de-33c0-9f28-619723011a19",
                                "text": "„Grundannahme muss sein, dass jede Kultur durch viele Kulturen, Staaten, Völker, Gruppen und unendlich viele Individuen gestaltet wurde und nicht auf einen Grundzug verengt werden darf, zum Beispiel hier die böse weiße, dort die guten indigenen Kulturen.“"
                            },
                            {
                                "example_id": "f3566fd4-8f88-44dc-a422-772c900fbd74",
                                "sense_id": "550aba25-82de-33c0-9f28-619723011a19",
                                "text": "„Frau Merkels erste Grundannahme, gut erkennbar während der Krim-Krise, lautet, Großmächte führen untereinander keine Kriege.“"
                            },
                            {
                                "example_id": "5df68742-308b-4b2b-8a7c-cbfb86541ddf",
                                "sense_id": "550aba25-82de-33c0-9f28-619723011a19",
                                "text": "„Das beruht auf der Grundannahme, dass die Daten der Produktion das tatsächliche Volumen der von Fabriken produzierten Waren widerspiegeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
