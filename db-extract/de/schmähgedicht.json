                "senses": [
                    {
                        "sense_id": "dc2f4c90-d897-3867-b10b-0f9109aa7e0c",
                        "entry_id": "20a5dc38-e1b0-323a-a5bc-9eb8468b9aa1",
                        "glosses": [
                            "bewusst verhöhnendes, verletzendes und/oder verspottendes Gedicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98727551-6169-4cc2-b3a4-738244fa0567",
                                "sense_id": "dc2f4c90-d897-3867-b10b-0f9109aa7e0c",
                                "text": "„Bundeskanzlerin Angela Merkel hat ein im ZDF ausgestrahltes und dann wieder gestrichenes Schmähgedicht Jan Böhmermanns über den türkischen Präsidenten Recep Tayyip Erdogan als \"bewusst verletzend\" kritisiert.“"
                            },
                            {
                                "example_id": "8aa670a6-6586-446c-9ae2-e02908951df5",
                                "sense_id": "dc2f4c90-d897-3867-b10b-0f9109aa7e0c",
                                "text": "Jedes Mal, wenn ich, selten genug, etwas Feminismuskritisches schreibe, kriege ich von einer Leserin ein Schmähgedicht geschickt."
                            },
                            {
                                "example_id": "727b060e-36a7-476c-bed9-5813dbbb8607",
                                "sense_id": "dc2f4c90-d897-3867-b10b-0f9109aa7e0c",
                                "text": "Die Gesetzgebung der Insel verbietet beides, Lob- und Schmähgedicht."
                            },
                            {
                                "example_id": "913c8e3d-0416-4503-8a1c-c99c876f35b2",
                                "sense_id": "dc2f4c90-d897-3867-b10b-0f9109aa7e0c",
                                "text": "„Es muss wohl angenommen werden, dass Jan Böhmermann mit seinem Schmähgedicht nicht in erster Linie bösartige Unterstellungen und Beleidigungen in seiner Sendung unterbringen wollte, sondern sie als Mittel zum Zweck nutzte, seinen Beruf als Satiriker auszuüben: indem er Personen, Ereignisse oder Zustände kritisiert, verspottet oder anprangert.“"
                            },
                            {
                                "example_id": "8903f753-c237-4aa7-ab8e-7ff5e0bbdf07",
                                "sense_id": "dc2f4c90-d897-3867-b10b-0f9109aa7e0c",
                                "text": "„Nicht ganz überraschend hatte ein Schelm ein Schmähgedicht auf Gregor verfasst, und wenn Kristensa ihrem Sohn von den Visionen seines Urgroßvaters erzählte, gab sie normalerweise zwei Strophen des Gedichtes wieder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
