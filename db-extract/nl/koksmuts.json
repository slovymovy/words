                    {
                        "translation_id": "bd6c8c0d-1cbe-4ed8-aeb0-6d04c0b962de",
                        "source_entry_id": "b9fbb742-cb81-3d55-888c-0c13e98c0e4d",
                        "source_sense_id": "d21d464b-d1d4-3733-97d7-0bd72bf6336d",
                        "source_sense_description": "hoge witte muts",
                        "target_lang_word": "Kochmütze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kochmütze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef51da40-c503-37be-84b2-914840acb4df",
                                        "entry_id": "56d9c4b8-e1d6-3089-808e-dc526b1c0e1c",
                                        "glosses": [
                                            "zur Berufskleidung gehörende Kopfbedeckung für Berufsköche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ae17fed-06bd-45d7-84bd-ea98e9ecdb90",
                                                "sense_id": "ef51da40-c503-37be-84b2-914840acb4df",
                                                "text": "Gerne würde ich auch mal so eine schöne weiße, ganz hohe Kochmütze tragen."
                                            },
                                            {
                                                "example_id": "98ded5eb-76f1-4641-80c2-7d215acc8c35",
                                                "sense_id": "ef51da40-c503-37be-84b2-914840acb4df",
                                                "text": "„Unter der weißen Kochmütze bilden sich Schweißperlen auf der Stirn von Olivier Demol. Mit einem Plastikschaber rührt er in einem großen Bottich voll flüssiger Schokolade.“"
                                            },
                                            {
                                                "example_id": "59ce4864-d2d5-4436-8ea9-35c5b56cbfa4",
                                                "sense_id": "ef51da40-c503-37be-84b2-914840acb4df",
                                                "text": "„Du liebe Scheiße, er hatte eine so riesige Kochmütze auf dem Kopf, dass die Deckenlampen klirrten, wenn er von einem Zimmer ins andere ging. Ich erwartete irgendeinen Aperitif, aber Kristian servierte uns selbstgemachten Möhrensaft.“"
                                            },
                                            {
                                                "example_id": "b92a3997-2c46-40e4-9ce6-f7bf7464c709",
                                                "sense_id": "ef51da40-c503-37be-84b2-914840acb4df",
                                                "text": "„[…] und hinter dem Eisengitter einer rauchgeschwärzten Höhle des Erdgeschosses, welche die Küche vorstellte, lehnte eine dicke Figur in vormals weißer Jacke und Kochmütze und schlief trotz der zahllosen Fliegen, die das breite, weinrothe Gesicht umschwärmten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
