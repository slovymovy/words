                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затишье",
                                "target_lang_sense_clarification": "период низкой деловой активности"
                            },
                            {
                                "target_lang_word": "медленный",
                                "target_lang_sense_clarification": "о темпе работы или бизнеса"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "váznoucí",
                                "target_lang_sense_clarification": "málo aktivní, s nízkým odbytem"
                            },
                            {
                                "target_lang_word": "slabý",
                                "target_lang_sense_clarification": "o nízké intenzitě či objemu"
                            },
                            {
                                "target_lang_word": "pomalý",
                                "target_lang_sense_clarification": "probíhající mírným tempem"
                            }
                        ]
