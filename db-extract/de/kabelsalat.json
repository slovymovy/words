                    {
                        "sense_id": "79f105cd-9fab-3ff9-ba34-731920a57f8f",
                        "entry_id": "8d712ac8-3dbc-370a-9a1e-0666de5baeb1",
                        "glosses": [
                            "Tas de câbles emmêlés."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "0889ebe5-f86e-453f-9280-21cfff3a78fe",
                                "sense_id": "79f105cd-9fab-3ff9-ba34-731920a57f8f",
                                "text": "Hinter der HiFi-Anlage ist ein riesiger Kabelsalat.",
                                "translation": "Derrière cette chaîne hi-fi siège un imposant tas de câbles enchevêtrés."
                            },
                            {
                                "example_id": "e983af60-b91a-456f-b698-b06037f608bd",
                                "sense_id": "79f105cd-9fab-3ff9-ba34-731920a57f8f",
                                "text": "Der Praktikant war unerfahren und hat im Serverraum einen Kabelsalat verursacht.",
                                "translation": "Le stagiaire était inexpérimenté et a causé un enchevêtrement de câbles dans la salle de serveurs."
                            }
                        ]
                    }
