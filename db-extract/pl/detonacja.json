                    {
                        "translation_id": "ef1d940c-2d7d-458a-870f-af8edf1404f8",
                        "source_entry_id": "0261e3ae-a359-348c-a283-c1d57bcd1149",
                        "source_sense_id": "fc78f845-cb08-326e-9734-3ca067752387",
                        "target_lang_word": "détonation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détonation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce431b9e-5314-30e4-afb0-23edb159c9aa",
                                        "entry_id": "c6fe62fb-f510-3a4d-a923-d22f319c53d5",
                                        "glosses": [
                                            "Explosion violente et subite accompagnée de bruit, telle que celle de la poudre à canon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e90a754b-d724-4d3a-9e06-90044bd6eb6a",
                                                "sense_id": "ce431b9e-5314-30e4-afb0-23edb159c9aa",
                                                "text": "Il épaula d'un air délibéré, un éclair jaillit, la forêt répercuta sourdement la détonation. L'aigle battit des ailes, un instant il parut encore soulevé par l'air, puis il tomba lourdement comme une pierre."
                                            },
                                            {
                                                "example_id": "7cfca5e4-b4e9-4b17-b070-5e7ad978670e",
                                                "sense_id": "ce431b9e-5314-30e4-afb0-23edb159c9aa",
                                                "text": "Des détonations retentissaient incessamment, comparables aux décharges continues d'une formidable artillerie."
                                            },
                                            {
                                                "example_id": "a95d1f4e-3ece-49c7-abd1-80c9f270b8a9",
                                                "sense_id": "ce431b9e-5314-30e4-afb0-23edb159c9aa",
                                                "text": "Je chassais dans la montagne lorsque j'entendis des détonations irrégulières et continues; je compris qu'il s'agissait de quelque attaque à main armée, […]."
                                            },
                                            {
                                                "example_id": "bc914c29-2ee9-47db-8c08-cad46bc6688c",
                                                "sense_id": "ce431b9e-5314-30e4-afb0-23edb159c9aa",
                                                "text": "Et il ajusta le chien, le pauvre chien, le lamentable chien qui avait délaissé son os, […] ; les femmes se bouchaient les oreilles pour ne pas entendre la détonation ; […]."
                                            },
                                            {
                                                "example_id": "7fc4f114-4650-4f43-8dbb-bcdaab1a3565",
                                                "sense_id": "ce431b9e-5314-30e4-afb0-23edb159c9aa",
                                                "text": "Une assourdissante détonation partit du zénith, et l’aéronat décrivit une terrible embardée."
                                            },
                                            {
                                                "example_id": "e5d48669-77bd-44c2-a6e3-111f7fc614d1",
                                                "sense_id": "ce431b9e-5314-30e4-afb0-23edb159c9aa",
                                                "text": "Un adolescent est retiré de la file. Juste avant qu'une forte détonation venue d'une tour militaire l’envoie bouler sur l’asphalte, la tête broyée par une balle de mitrailleuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7566982f-d946-404d-a4f4-84894a15ac0d",
                        "source_entry_id": "0261e3ae-a359-348c-a283-c1d57bcd1149",
                        "source_sense_id": "fc78f845-cb08-326e-9734-3ca067752387",
