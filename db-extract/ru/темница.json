                                    {
                                        "sense_id": "879ad21d-0f1f-3351-8314-5e400fe96d6e",
                                        "entry_id": "5b87d48b-f849-3d24-ae8c-50514c03e42c",
                                        "glosses": [
                                            "Prison."
                                        ],
                                        "tags": [
                                            "dated",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afceefa6-5a8d-4ae6-9e20-c0da7a36c997",
                                                "sense_id": "879ad21d-0f1f-3351-8314-5e400fe96d6e",
                                                "text": "… et, un beau soir, il jura ses grands dieux qu’il le fourrerait en geôle à la première escapade."
                                            },
                                            {
                                                "example_id": "452f8bbc-d38e-4c2a-83a1-547cdf882b59",
                                                "sense_id": "879ad21d-0f1f-3351-8314-5e400fe96d6e",
                                                "text": "Cette nouvelle geôle n’était guère moins fâcheuse que la précédente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e28ac177-7c46-33af-bb87-671cb778244e",
                                        "entry_id": "5b87d48b-f849-3d24-ae8c-50514c03e42c",
                                        "glosses": [
                                            "Endroit comparable à une prison par certains aspects, avec plus ou moins d'exagération."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76127649-b44f-4112-9c6a-54067543add5",
                                                "sense_id": "e28ac177-7c46-33af-bb87-671cb778244e",
                                                "text": "Je veux revoir jusqu’à l'étroite geôle [l’école] où […]"
                                            },
                                            {
                                                "example_id": "99b851d6-562d-4661-adfa-452c94d6f20d",
                                                "sense_id": "e28ac177-7c46-33af-bb87-671cb778244e",
                                                "text": "Tu m’as fait sortir de ma geôle, c’est vrai. Pourquoi ?"
                                            }
                                        ]
                                    },
