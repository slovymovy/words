                        "entry_id": "0242d56f-dc56-3942-b0f5-8c8ef324dcd6",
                        "glosses": [
                            "alternative Schreibweise für die Picardie (Region im Norden Frankreichs)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c624ab74-21f5-4330-ae90-bfcfdc34beb1",
                                "sense_id": "6e0c856c-5398-3057-9ed5-b61f2c0937f6",
                                "text": "Die Regionalhauptstadt der Pikardie ist Amiens."
                            },
                            {
                                "example_id": "a5cb7146-da0c-465e-8cce-1b49a1e31224",
                                "sense_id": "6e0c856c-5398-3057-9ed5-b61f2c0937f6",
                                "text": "„Er war ein Taugenichts, ein Trunkenbold und Weiberheld, entstammte einer Bauernfamilie aus der Pikardie und konnte nur sehr schlecht schreiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
