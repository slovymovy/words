                "senses": [
                    {
                        "sense_id": "f0ea4ed6-2359-3b2f-a2b4-0995871e073a",
                        "entry_id": "54dfb538-5cec-3ba9-8022-022efec8a817",
                        "glosses": [
                            "Arbeitsstelle, bei der die volle Wochenarbeitszeit gearbeitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "732b3702-9104-4f8d-9c0f-cc997304c32c",
                                "sense_id": "f0ea4ed6-2359-3b2f-a2b4-0995871e073a",
                                "text": "Ich suche eine Vollzeitstelle."
                            },
                            {
                                "example_id": "ee832f66-60cb-487f-88c0-dddba2d84898",
                                "sense_id": "f0ea4ed6-2359-3b2f-a2b4-0995871e073a",
                                "text": "„Bei gut 3000 Vollzeitjobs im ORF selbst und fast 4000 Vollzeitstellen im ORF-Konzern samt Tochterunternehmen klingt das recht überschaubar.“"
                            },
                            {
                                "example_id": "4d19cb17-eeb1-4d8e-a3f0-79ef784a6b74",
                                "sense_id": "f0ea4ed6-2359-3b2f-a2b4-0995871e073a",
                                "text": "„Sie hatte nach langem Hin und Her endlich ihre Vollzeitstelle im Aluminiumwerk in Grundartangi gekündigt und sich wieder an der Uni eingeschrieben, während sie nebenbei im Laden um die Ecke jobbte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
