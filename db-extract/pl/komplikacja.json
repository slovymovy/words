                    {
                        "translation_id": "1c127ebc-f48d-42fb-b8be-54e141b46736",
                        "source_entry_id": "c894fc50-b77a-361a-8156-a7959146643c",
                        "source_sense_id": "323d9c43-8636-3f4f-9af6-ff4e15fb4b6c",
                        "target_lang_word": "complication",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "complication",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a12cc290-ba0c-3662-aaee-3c2b858b3dee",
                                        "entry_id": "56258408-df7a-3400-9769-6082c43dbf71",
                                        "glosses": [
                                            "Assemblage, concours d’éléments, de circonstances ou d’incidents multiples susceptibles de créer des embarras, ou d’augmenter la difficulté ou le danger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4acf07f-66ba-448e-9533-18dfa90fbae7",
                                                "sense_id": "a12cc290-ba0c-3662-aaee-3c2b858b3dee",
                                                "text": "Ce coin perdu de Jan-Mayen n’est pas à l’abri des cancans, des mystères, des intrigues et même des complications diplomatiques."
                                            },
                                            {
                                                "example_id": "87d05aa8-7b28-442d-9bc4-cc944e67d69e",
                                                "sense_id": "a12cc290-ba0c-3662-aaee-3c2b858b3dee",
                                                "text": "Jolie somme ! Mais restait à la toucher… Or, ici, commence un procès aux complications inénarrables, et qui dura dix ans."
                                            },
                                            {
                                                "example_id": "76bb9288-5ceb-46eb-abc0-4d35974b1683",
                                                "sense_id": "a12cc290-ba0c-3662-aaee-3c2b858b3dee",
                                                "text": "Bien que souffrant d'une néphrite chronique avec complications cardiaques, il ne voulut pas consentir à prendre le moindre repos, […]."
                                            },
                                            {
                                                "example_id": "717b16d1-63cc-4801-9b9e-4998e729106f",
                                                "sense_id": "a12cc290-ba0c-3662-aaee-3c2b858b3dee",
                                                "text": "Nous considérons en effet que contraindre les clients à aller payer leur péage dans des bureaux de tabac dans un délai court après leur voyage constitue une vraie régression et une forte complication en matière d’expérience client"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03f58f89-d6e1-3b41-9a22-20d2c7a526f8",
                                        "entry_id": "56258408-df7a-3400-9769-6082c43dbf71",
                                        "glosses": [
                                            "Propension à considérer les événements, les êtres ou les choses, plus complexes qu’ils le sont."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "914fe24a-baa2-4a71-8f98-a6a47ddb902c",
                                                "sense_id": "03f58f89-d6e1-3b41-9a22-20d2c7a526f8",
                                                "text": "L’abstraction devient la puissance de réflexion, l’inaction une capacité à formuler les problèmes, l’inadaptation une polyvalence, l’indécision la certitude de l'incertain, la rhétorique un agir communicationnel, la complication la conscience de la complexité et l’achiffrisme s'évanouit dans l'usage commune d'une règle de trois appliquée à une langue des affaires qu'on apprend comme n'importe quelle langue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "698091c0-58c6-3e0a-aed2-123717d6d240",
                                        "entry_id": "56258408-df7a-3400-9769-6082c43dbf71",
                                        "glosses": [
                                            "Fonctions supplémentaires ajoutées au mécanisme de base comme par exemple le tourbillon ou le quantième perpétuel."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4012a33c-5f10-4bc4-a944-7e60ffe54e1b",
                                                "sense_id": "698091c0-58c6-3e0a-aed2-123717d6d240",
                                                "text": "Cette montre est à la fois un bijou et une merveille de technologie : une complication affiche le cycle lunaire."
                                            },
                                            {
                                                "example_id": "cd8be227-f825-4738-b980-f364ecda69e6",
                                                "sense_id": "698091c0-58c6-3e0a-aed2-123717d6d240",
                                                "text": "Sortie pour commémorer les 175 ans de la maison [Patek], la Grandmaster Chime réunit pour la première fois sur une montre-bracelet vingt complications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3554a79-ac1a-364d-bbbc-853192aa66ce",
                                        "entry_id": "56258408-df7a-3400-9769-6082c43dbf71",
                                        "glosses": [
                                            "Montre ou garde-temps comportant une ou plusieurs complications."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
