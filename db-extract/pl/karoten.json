                        "entry_id": "abcb2d9d-7d3a-3ca0-ba01-443dd0f96d14",
                        "glosses": [
                            "jeden ze związków organicznych z grupy węglowodorów nienasyconych stanowiących barwniki fotosyntetyczne o barwach od żółtej do czerwonej i prowitaminy witaminy A, występujących w wielu roślinach, m.in. marchwi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e7c9403-cd49-4404-9ee0-16282c50fa52",
                                "sense_id": "107681ed-9bbd-37a1-b2d1-e13bb55e2096",
                                "text": "Pomidory są składnikiem diet zapobiegających nowotworom, głównie z racji dużej zawartości karotenów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
