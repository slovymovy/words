                ],
                "senses": [
                    {
                        "sense_id": "72995e70-5c65-3f21-aca2-9b1eb9d92fc2",
                        "entry_id": "a60aeba7-741c-317a-9db6-8f62983dfc92",
                        "glosses": [
                            "sommergrüne Pflanze mit großen, duftenden Blüten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72556dd8-7f17-4c00-8f83-a2523556bc6b",
                                "sense_id": "72995e70-5c65-3f21-aca2-9b1eb9d92fc2",
                                "text": "Im Park sahen sie viele Pfingstrosen."
                            },
                            {
                                "example_id": "ec345834-845c-4af3-bdaa-6098b6af674c",
                                "sense_id": "72995e70-5c65-3f21-aca2-9b1eb9d92fc2",
                                "text": "„[…] Neben ihrem Schreibtisch steht ein Strauß mit blassrosa Pfingstrosen. Eine Dame im Bleistiftrock bringt ein Schälchen Obstsalat, akkurat gestapelt.“"
                            },
                            {
                                "example_id": "6d8204ba-91b0-48ba-ab94-0c0899c26b96",
                                "sense_id": "72995e70-5c65-3f21-aca2-9b1eb9d92fc2",
                                "text": "„Eleanors Lieblingsblumen waren rosa Pfingstrosen gewesen, die es normalerweise nur im späten Frühling gab, nicht mitten im Sommer, aber wie durch ein Wunder hatte Louise an diesem Abend einen Strauß davon da.“"
                            },
                            {
                                "example_id": "f97d869b-8b0e-4872-a90c-395e731c2ada",
                                "sense_id": "72995e70-5c65-3f21-aca2-9b1eb9d92fc2",
                                "text": "„Bouvard pflanzte mitten auf dem Rasen eine Pfingstrose und unter den Bogen des Laubenganges Tomaten, die wie Kronleuchter herabhängen sollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa9a74a3-b920-47f9-9de5-79aab4183dbe",
                        "source_entry_id": "a60aeba7-741c-317a-9db6-8f62983dfc92",
                        "source_sense_id": "72995e70-5c65-3f21-aca2-9b1eb9d92fc2",
                        "source_sense_description": "Botanik: sommergrüne Pflanze mit großen, duftenden Blüten",
                        "target_lang_word": "peony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51266a5e-5875-317a-a687-910efaf32886",
                                        "entry_id": "b3b1cd7c-8b44-35f9-9fed-a8183e5e7c56",
                                        "glosses": [
                                            "A flowering plant of the genus Paeonia with large fragrant flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85fe77b5-9d5c-4914-8724-40f9006be665",
                                                "sense_id": "51266a5e-5875-317a-a687-910efaf32886",
                                                "text": "The root of the Male Peony fresh gathered has been found by experience to cure the falling-sickness."
                                            },
                                            {
                                                "example_id": "04bce55d-7c33-46d3-a588-081da0ab8751",
                                                "sense_id": "51266a5e-5875-317a-a687-910efaf32886",
                                                "text": "There might ye ſee the pioney ſpread vvide, / The full-blovvn roſe, the ſhepherd and his laſs, / Lap-dog and lambkin vvith black ſtaring eyes, / And parrots vvith tvvin cherries in their beak."
                                            },
                                            {
                                                "example_id": "ef62c7a5-36b0-4f8f-beb3-58cbcf81f04a",
                                                "sense_id": "51266a5e-5875-317a-a687-910efaf32886",
                                                "text": "'Twas early June, the new grass was flourishing everywheres, the posies in the yard—peonies and such—in full bloom, the sun was shining, and the water of the bay was blue, with light green streaks where the shoal showed."
                                            },
                                            {
                                                "example_id": "64c6328c-1291-4a85-b856-ba6c37964924",
                                                "sense_id": "51266a5e-5875-317a-a687-910efaf32886",
                                                "text": "Peony would keep away any kind of storms. Mugwort hung over doorways on Midsummer's Day, June 24, would keep off lightning, as St. John's-Wort would if gathered before sunrise on that day."
                                            },
                                            {
                                                "example_id": "835610cc-83b7-41de-a254-1a1b9d4d5a22",
                                                "sense_id": "51266a5e-5875-317a-a687-910efaf32886",
                                                "text": "Mr. Farzan’s narrow backyard in Brooklyn’s South Slope neighborhood is a lush, if slightly chaotic, oasis. There are Fuji apples, Meyer lemons, figs, peonies and avocados — although that’s far from a complete census of all that grows there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e8953d8-81f4-35d8-adeb-347caf47d9df",
                                        "entry_id": "b3b1cd7c-8b44-35f9-9fed-a8183e5e7c56",
                                        "glosses": [
                                            "A dark red colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbe16cbb-177a-4882-a071-5cc47efb5172",
                                                "sense_id": "6e8953d8-81f4-35d8-adeb-347caf47d9df",
                                                "text": "She was a fine and handsome girl—not handsomer than some others, possibly—but her mobile peony mouth and large innocent eyes added eloquence to colour and shape."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7f75714-5112-491d-ba72-4381dfbb36c4",
                        "source_entry_id": "a60aeba7-741c-317a-9db6-8f62983dfc92",
                        "source_sense_id": "72995e70-5c65-3f21-aca2-9b1eb9d92fc2",
                        "source_sense_description": "Botanik: sommergrüne Pflanze mit großen, duftenden Blüten",
                        "target_lang_word": "пион",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пион",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e363b0d1-f552-3c3f-bfe7-67642bc38601",
                                        "entry_id": "f6ed0df6-2f04-3e69-9b84-0ceb0a2ce1c5",
                                        "glosses": [
                                            "травянистое многолетнее кустарниковое растение с крупными цветками; род растений семейства пионовых"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40700d6b-b11f-41fd-adb5-11d5bccf53af",
                                                "sense_id": "e363b0d1-f552-3c3f-bfe7-67642bc38601",
                                                "text": "Распускались рябины, черёмухи и смородина в нашем садике, где у нас были свои любимцы, как пион, принесённый Николаем Матвеичем с гор."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ea1baf2-2f4e-3440-8452-6b2cb16d9a3f",
                                        "entry_id": "f6ed0df6-2f04-3e69-9b84-0ceb0a2ce1c5",
                                        "glosses": [
                                            "цветок такого растения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba3c035b-da77-4e2c-89e5-59a25bc3456a",
                                                "sense_id": "1ea1baf2-2f4e-3440-8452-6b2cb16d9a3f",
                                                "text": "Для этого свидания Консуэло выбрала белую блузку с отложным воротником и яркую, как пион, юбку…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "пион",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "94eae275-524f-3b79-afd2-3f9d9cf5b2c2",
                                        "entry_id": "58e0defd-c710-3b1a-9dc6-5dc5c155aef2",
                                        "glosses": [
                                            "физ. то же, что пи-мезон"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12291a8b-032b-42cb-b2bf-cfd75a3b629d",
                                                "sense_id": "94eae275-524f-3b79-afd2-3f9d9cf5b2c2",
                                                "text": "Алла полюбила даже пионы, хотя раньше никогда не ценила эти цветы за их вечно расхристанный вид, но теперь она узнала, что «пион» для физика означает частицу пи-мезон, и это в корне меняло её отношение."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
