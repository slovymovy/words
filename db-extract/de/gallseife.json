                ],
                "senses": [
                    {
                        "sense_id": "dd70bcc0-4012-3f88-a1b6-2866666b74c6",
                        "entry_id": "bad8b752-cb9e-3af4-af00-2c63572689b2",
                        "glosses": [
                            "mit Rindergalle gemischte Kernseife, die vor allem zur Entfernung von Flecken aus Textilien verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba599f81-d917-447b-ac99-d6b2eebbe001",
                                "sense_id": "dd70bcc0-4012-3f88-a1b6-2866666b74c6",
                                "text": "Das wirksame Prinzip der Gallseifen ist ihr Kolloidgehalt."
                            },
                            {
                                "example_id": "98c804b4-dbc4-4bb2-a13d-0223914ba0c0",
                                "sense_id": "dd70bcc0-4012-3f88-a1b6-2866666b74c6",
                                "text": "Gallseifen sind Gemische von kaltgerührter Cocosfettseife und frischer Ochsengalle oder haltbaren Gallenpräparaten."
                            },
                            {
                                "example_id": "68d1070e-ba8f-4d19-ac5a-af7fc0bbd281",
                                "sense_id": "dd70bcc0-4012-3f88-a1b6-2866666b74c6",
                                "text": "Wie jedoch die genaue Rezeptur einer Gallseife lautet, wird von den Herstellern natürlich nicht verraten."
                            },
                            {
                                "example_id": "19d7ba59-0b1b-44f8-b245-b0f6c1548112",
                                "sense_id": "dd70bcc0-4012-3f88-a1b6-2866666b74c6",
                                "text": "Egal ob du flüssige oder feste Gallseife verwendest, gib die Seife mit etwas Wasser auf den zu behandelnden Fleck, reibe sie vorsichtig ein und lasse sie einige Minuten einwirken."
                            },
                            {
                                "example_id": "d95695d6-84b4-4218-953c-10f0b3e3aa74",
                                "sense_id": "dd70bcc0-4012-3f88-a1b6-2866666b74c6",
                                "text": "Vegane Gallseife bildet die Molekülverbindungen der Stoffe aus der Rindergalle mit pflanzlichen Stoffen nach und überzeugt durch eine ebenso gute Reinigungsleistung – und das ganz ohne Tierprodukte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
