                        "glosses": [
                            "alles en iedereen die te maken heeft met het buitenshuis vermaak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7600465-8179-4ff6-abc8-f3d739c1ee40",
                                "sense_id": "ac59add6-b5e8-3452-851f-f808b083f3e9",
                                "text": "Dan hoeven we Marja niet in de uitgaanswereld te introduceren, de kandidaten komen zelf hiernaartoe, zei de kleine vorstin onvoorzichtig, toen ze het nieuws hoorde."
                            },
                            {
                                "example_id": "4f0cce9d-01a3-405f-8c22-fa321c54628d",
                                "sense_id": "ac59add6-b5e8-3452-851f-f808b083f3e9",
                                "text": "Ondanks alle maatregelen is het volgens de hoogleraar nog lang niet genoeg. Willemsen vindt dat andere landen al een stuk verder zijn in het verbieden van roken in openbare plaatsen. \"Denk aan de rookpaal op stations, de terrassen in de uitgaanswereld, zelfs voor de ingang van ziekenhuizen wordt gerookt. Dat zie je in veel andere landen niet.\""
                            }
                        ]
