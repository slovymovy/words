                ],
                "senses": [
                    {
                        "sense_id": "80913f64-b7b4-3929-84a9-b2cc59488656",
                        "entry_id": "0fda8ca8-79be-3cc5-8595-514cef0525da",
                        "glosses": [
                            "議會反對派"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de1d16d3-d2c8-4b1c-939c-55d6ee069fb4",
                                "sense_id": "80913f64-b7b4-3929-84a9-b2cc59488656",
                                "text": "De oppositie heeft zich tegen het wetsvoorstel uitgesproken tijdens het debat.",
                                "translation": "议会反对派在辩论中表达了对该法案的反对。"
                            },
                            {
                                "example_id": "01994452-ace2-44f2-bf02-80af901b899e",
                                "sense_id": "80913f64-b7b4-3929-84a9-b2cc59488656",
                                "text": "De partijleider van de oppositie kondigde aan dat ze een motie zullen indienen.",
                                "translation": "反对党领袖宣布他们将提交动议。"
                            },
                            {
                                "example_id": "b7d311f8-d10c-42f2-a2d5-f70b46e82122",
                                "sense_id": "80913f64-b7b4-3929-84a9-b2cc59488656",
                                "text": "De stemmen van de oppositie waren unaniem tegen het besluit.",
                                "translation": "议会反对派一致投票反对这一决定。"
                            }
                        ]
                    },
                    {
                        "sense_id": "3d23805a-fc57-38ff-977d-be26bd6bf03c",
                        "entry_id": "0fda8ca8-79be-3cc5-8595-514cef0525da",
                        "glosses": [
                            "反對；反抗"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eebedcbf-c34b-420c-90e8-44d91f208d1f",
                                "sense_id": "3d23805a-fc57-38ff-977d-be26bd6bf03c",
                                "text": "De oppositie groeit onder de bevolking vanwege de verslechterende economie.",
                                "translation": "由于经济恶化，民众的反对情绪日益高涨。"
                            },
                            {
                                "example_id": "aa3f84e9-77dd-4787-9019-b4d7d4e41a0f",
                                "sense_id": "3d23805a-fc57-38ff-977d-be26bd6bf03c",
                                "text": "De vakbonden voeren actie om hun oppositie tegen de nieuwe arbeidswet te laten zien.",
                                "translation": "工会正在采取行动表达对新劳动法的反对。"
                            },
                            {
                                "example_id": "2253db3e-706c-4aae-8e97-d37128513da1",
                                "sense_id": "3d23805a-fc57-38ff-977d-be26bd6bf03c",
                                "text": "Er is veel oppositie vanuit de oppositiepartijen tegen het voorstel.",
                                "translation": "这项提议遭到了反对党的激烈反对。"
                            }
                        ]
                    }
