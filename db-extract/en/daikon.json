                    {
                        "sense_id": "58901249-1517-398c-9de0-60a379ed5b08",
                        "entry_id": "882340a8-6475-34ab-8891-b6c421e81595",
                        "glosses": [
                            "An East Asian cultivar or subspecies of garden radish (Raphanus raphanistrum subsp. sativus, syn. Raphanus sativus) bearing a large, white, carrot-shaped taproot consumed throughout East and South Asia but grown in North America primarily as a fallow crop for its fast-growing leaves (used as animal fodder) and as a soil ripper."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ec3528a6-c013-3f12-98d0-2d5dedac7cc7",
                        "entry_id": "882340a8-6475-34ab-8891-b6c421e81595",
                        "glosses": [
                            "An East Asian cultivar or subspecies of garden radish (Raphanus raphanistrum subsp. sativus, syn. Raphanus sativus) bearing a large, white, carrot-shaped taproot consumed throughout East and South Asia but grown in North America primarily as a fallow crop for its fast-growing leaves (used as animal fodder) and as a soil ripper.",
                            "The usual Japanese cultivar, Japanese radish."
                        ],
                        "tags": [
                            "Japanese"
                        ],
                        "examples": [
                            {
                                "example_id": "4749a16a-5d66-4525-b98e-17ab3226e8f3",
                                "sense_id": "ec3528a6-c013-3f12-98d0-2d5dedac7cc7",
                                "text": "Jiko was washing these big white daikons, and I was cutting them up and salting them and putting them into plastic freezer bags."
                            }
                        ]
                    },
                    {
                        "sense_id": "9105da51-a317-330e-869a-cc79579daa7e",
                        "entry_id": "882340a8-6475-34ab-8891-b6c421e81595",
                        "glosses": [
                            "Closely-related cultivars such as the enormous turnip-shaped Sakurajima or green-and-red watermelon radish."
                        ],
                        "tags": [],
                        "examples": []
                    }
