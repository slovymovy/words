                        "glosses": [
                            "To take hold of; to grasp, hold."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "eae43aac-afd3-4706-b7ac-31b0e4dfc5a0",
                                "sense_id": "8bda906d-6d0c-3f44-a7d2-f78d5be7e694",
                                "text": "She flew at him like to an hellish feend,\nAnd on his shield tooke hold with all her might,\nAs if that it she would in peeces rend,\nOr reave out of the hand that did it hend"
                            },
                            {
                                "example_id": "39802afe-8e4c-46b7-a783-a67ff2f00d19",
                                "sense_id": "8bda906d-6d0c-3f44-a7d2-f78d5be7e694",
                                "text": "Presently the cloud opened and behold, within it was that Jinni hending in hand a drawn sword, while his eyes were shooting fire sparks of rage."
                            }
                        ]
                    }
