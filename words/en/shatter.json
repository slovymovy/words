{
    "word_family": [
        "shattered",
        "shattering",
        "shatterproof"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a46594c1-0122-3846-b896-a4a7153652f6",
                    "sense_definition": "To violently break something into many small pieces.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "breakage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners used dynamite to <w>shatter</w> rocks into tiny fragments.",
                            "target_lang_translations": {
                                "ru": "Шахтеры использовали динамит, чтобы <w>раздробить</w> камни на мелкие фрагменты."
                            }
                        },
                        {
                            "text": "The high-pitched voice was so powerful it could <w>shatter</w> glass instantly.",
                            "target_lang_translations": {
                                "ru": "Высокий голос был настолько мощным, что мог мгновенно <w>разбить</w> стекло вдребезги."
                            }
                        }
                    ],
                    "synonyms": [
                        "shiver"
                    ],
                    "antonyms": [
                        "mend",
                        "repair"
                    ],
                    "common_phrases": [
                        "shatter glass",
                        "shatter into pieces"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно разбить что-либо на множество мелких осколков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбивать",
                                "target_lang_sense_clarification": "на мелкие кусочки"
                            },
                            {
                                "target_lang_word": "раздробить",
                                "target_lang_sense_clarification": "на фрагменты"
                            },
                            {
                                "target_lang_word": "разбить вдребезги",
                                "target_lang_sense_clarification": "полностью уничтожить целостность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f634b50d-ef28-3d60-9c50-a677d878137e",
                    "sense_definition": "To emotionally defeat or deeply upset someone, often by destroying their hopes or confidence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news of the accident will <w>shatter</w> his mother when she hears it.",
                            "target_lang_translations": {
                                "ru": "Известие об аварии <w>сокрушит</w> его мать, когда она его услышит."
                            }
                        },
                        {
                            "text": "I do not mean to <w>shatter</w> your ego, but you are not the first person to try this.",
                            "target_lang_translations": {
                                "ru": "Я не хочу <w>уязвить</w> твое самолюбие, но ты не первый, кто это пробует."
                            }
                        }
                    ],
                    "antonyms": [
                        "encourage",
                        "uplift"
                    ],
                    "common_phrases": [
                        "shatter your ego",
                        "shatter someone's hopes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эмоционально сокрушить или глубоко расстроить кого-либо, часто разрушая надежды или уверенность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокрушить",
                                "target_lang_sense_clarification": "эмоционально подавить"
                            },
                            {
                                "target_lang_word": "разбить",
                                "target_lang_sense_clarification": "надежды или сердце"
                            },
                            {
                                "target_lang_word": "потрясти",
                                "target_lang_sense_clarification": "сильно расстроить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b1cbafb-b178-307f-8fa5-3c4476686633",
                    "sense_definition": "To completely destroy or disable a system, plan, or state of being.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden economic crisis served to <w>shatter</w> the peace of the small nation.",
                            "target_lang_translations": {
                                "ru": "Внезапный экономический кризис <w>разрушил</w> покой маленькой нации."
                            }
                        },
                        {
                            "text": "A single mistake was enough to <w>shatter</w> their carefully laid plans for the weekend.",
                            "target_lang_translations": {
                                "ru": "Одной ошибки было достаточно, чтобы <w>разбить</w> их тщательно продуманные планы на выходные."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shatter the peace",
                        "shatter a dream"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью разрушить или вывести из строя систему, план или состояние бытия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрушить",
                                "target_lang_sense_clarification": "планы или мир"
                            },
                            {
                                "target_lang_word": "разбить",
                                "target_lang_sense_clarification": "мечты или тишину"
                            },
                            {
                                "target_lang_word": "нарушить",
                                "target_lang_sense_clarification": "покой или систему"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1847e64b-310c-3b8b-b4e0-ef7f549be54e",
                    "sense_definition": "To fall heavily or in a dispersed manner, often used to describe rain or light.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "falling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain <w>shattered</w> down on the pub windows throughout the night.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь всю ночь <w>барабанил</w> по окнам паба."
                            }
                        },
                        {
                            "text": "The sleeting rain <w>shattered</w> down like diamonds from the brim of his hat.",
                            "target_lang_translations": {
                                "ru": "Дождь со снегом <w>осыпался</w> вниз, словно бриллианты, с полей его шляпы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rain shattered down"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжело или рассеянно падать (о дожде или свете)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "барабанить",
                                "target_lang_sense_clarification": "о дожде по поверхности"
                            },
                            {
                                "target_lang_word": "разбиваться",
                                "target_lang_sense_clarification": "о каплях, падающих вниз"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dbdfc88-a819-3228-a5a5-b0b53bba4f13",
                    "sense_definition": "Of seeds: to fall out or become dispersed naturally upon reaching maturity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seed is very small and <w>shatters</w> if the plant is not handled carefully during harvest.",
                            "target_lang_translations": {
                                "ru": "Семена очень мелкие и <w>осыпаются</w>, если с растением не обращаться осторожно во время сбора урожая."
                            }
                        },
                        {
                            "text": "Farmers must harvest the crop early so the grain does not <w>shatter</w> in the field.",
                            "target_lang_translations": {
                                "ru": "Фермеры должны собирать урожай рано, чтобы зерно не <w>рассыпалось</w> в поле."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О семенах: естественным образом выпадать или рассеиваться при созревании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осыпаться",
                                "target_lang_sense_clarification": "о зерне или семенах"
                            },
                            {
                                "target_lang_word": "рассыпаться",
                                "target_lang_sense_clarification": "при созревании"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fde69537-6d39-37d2-a4c2-03979a7f3bdd",
                    "sense_definition": "A fragment or small piece of something that has been broken.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fragments",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The impact caused the vase to break into <w>shatters</w> across the floor.",
                            "target_lang_translations": {
                                "ru": "От удара ваза разлетелась на <w>осколки</w> по всему полу."
                            }
                        },
                        {
                            "text": "It will fall upon the glass and break it into <w>shatters</w>.",
                            "target_lang_translations": {
                                "ru": "Оно упадет на стекло и разобьет его в <w>дребезги</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "shat"
                    ],
                    "common_phrases": [
                        "break into shatters"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осколок или маленькая часть чего-то разбитого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осколок",
                                "target_lang_sense_clarification": "часть разбитого предмета"
                            },
                            {
                                "target_lang_word": "дребезги",
                                "target_lang_sense_clarification": "мелкие части (обычно во фразе)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb7c7f78-e9ce-350e-8c86-61b4497ca967",
                    "sense_definition": "A highly concentrated form of cannabis that is brittle and glass-like.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "substances",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The user preferred <w>shatter</w> over other forms of concentrates due to its potency.",
                            "target_lang_translations": {
                                "ru": "Пользователь предпочитал <w>шаттер</w> другим видам концентратов из-за его крепости."
                            }
                        },
                        {
                            "text": "He explained that <w>shatter</w> gets its name from its tendency to break like glass.",
                            "target_lang_translations": {
                                "ru": "Он объяснил, что <w>шаттер</w> получил свое название из-за свойства ломаться подобно стеклу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "drug culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высококонцентрированная форма каннабиса, хрупкая и похожая на стекло."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шаттер",
                                "target_lang_sense_clarification": "вид концентрата"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dff2c616-ba73-3928-b176-dc352c7aa01f",
                    "sense_definition": "A needle from a pine tree.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were asked to gather some smelly pine <w>shatters</w> from the forest floor.",
                            "target_lang_translations": {
                                "ru": "Детей попросили собрать пахучую сосновую <w>хвою</w> с лесной подстилки."
                            }
                        },
                        {
                            "text": "He decided to litter his farm yard with leaves and pine <w>shatters</w> for insulation.",
                            "target_lang_translations": {
                                "ru": "Он решил засыпать двор фермы листьями и сосновыми <w>иголками</w> для утепления."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pine shatters"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Southern US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иголка соснового дерева."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвоя",
                                "target_lang_sense_clarification": "сосновые иголки"
                            },
                            {
                                "target_lang_word": "иголка",
                                "target_lang_sense_clarification": "хвойного дерева"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "65b21221-e02c-3b00-8776-fc99620baf40",
                    "sense_definition": "A <w>surname</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local directory listed a family with the last name <w>Shatter</w>.",
                            "target_lang_translations": {
                                "ru": "В местном справочнике значилась семья по фамилии <w>Шаттер</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Shatter</w> was known in the community for his work at the library.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Шаттер</w> был известен в округе благодаря своей работе в библиотеке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "rare"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Шаттер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}