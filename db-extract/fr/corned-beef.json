                    {
                        "translation_id": "a44f7e97-f114-4238-bde4-522dfd33ee64",
                        "source_entry_id": "ad7a22db-e0a3-3c68-a55f-c08b8e395456",
                        "source_sense_id": "35ce5635-ef9e-3233-ae7e-d0f5bbe26827",
                        "target_lang_word": "Rindfleisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rindfleisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90b5f3b3-3f04-3450-9b46-2eb6000b873e",
                                        "entry_id": "2d863fbb-4736-3fa4-bf05-a4c4a6b8e6a0",
                                        "glosses": [
                                            "das zubereitete oder zur Zubereitung vorgesehene Fleisch vom Rind"
                                        ],
                                        "tags": [
                                            "Nahrungsmittel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd06320a-5369-4173-b333-c21beb76e6c7",
                                                "sense_id": "90b5f3b3-3f04-3450-9b46-2eb6000b873e",
                                                "text": "Rindfleisch ist nach wie vor sehr beliebt."
                                            },
                                            {
                                                "example_id": "6ce4c376-395f-420f-a8da-dc9ce5b8e3b4",
                                                "sense_id": "90b5f3b3-3f04-3450-9b46-2eb6000b873e",
                                                "text": "„Rindfleisch war billig, das konnten sich viele Muslime leisten, Wasserbüffel ist fettig und schmeckt nicht.“"
                                            },
                                            {
                                                "example_id": "a7ed76e4-d0ff-46bf-89a2-68f33a7a6009",
                                                "sense_id": "90b5f3b3-3f04-3450-9b46-2eb6000b873e",
                                                "text": "„Zu Mittag kam die Feldküche mit Rindfleisch.“"
                                            },
                                            {
                                                "example_id": "38b240e2-ab85-4dcb-98b2-8bb2f206dadd",
                                                "sense_id": "90b5f3b3-3f04-3450-9b46-2eb6000b873e",
                                                "text": "„In der Bucht von Biskaya trafen wir einen Amerikaner, der uns ein Fass Rindfleisch verkaufte, das für den Rest der Fahrt reichte.“"
                                            },
                                            {
                                                "example_id": "47d65f75-f1e0-4910-9176-a5ff180b9c36",
                                                "sense_id": "90b5f3b3-3f04-3450-9b46-2eb6000b873e",
                                                "text": "„Gott gab den Menschen mageres Rindfleisch, mit dem sie weniger Kalorien zu sich nahmen und doch ihren Appetit stillen konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Rindfleisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e7dd944-6b5f-3890-8cd5-9dc19d58f2cd",
                                        "entry_id": "22b9bc7a-0b9d-37df-9801-7371fb36b275",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "249aaab2-2c81-4e05-a8d6-12ecee705298",
                                                "sense_id": "9e7dd944-6b5f-3890-8cd5-9dc19d58f2cd",
                                                "text": "Frau Rindfleisch ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "34089eba-eb12-4c6c-b7db-2506f40745cd",
                                                "sense_id": "9e7dd944-6b5f-3890-8cd5-9dc19d58f2cd",
                                                "text": "Herr Rindfleisch wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "9c1c4c2c-1814-48c8-b02d-a639dce44fa0",
                                                "sense_id": "9e7dd944-6b5f-3890-8cd5-9dc19d58f2cd",
                                                "text": "Die Rindfleischs fahren heute nach Köln."
                                            },
                                            {
                                                "example_id": "de8c9476-9459-472c-883b-05c72648e97a",
                                                "sense_id": "9e7dd944-6b5f-3890-8cd5-9dc19d58f2cd",
                                                "text": "Der Rindfleisch trägt nie die Pullover, die die Rindfleisch ihm strickt."
                                            },
                                            {
                                                "example_id": "182780f4-0778-4f52-a168-f15684459231",
                                                "sense_id": "9e7dd944-6b5f-3890-8cd5-9dc19d58f2cd",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rindfleisch kommt, geht der Herr Rindfleisch.“"
                                            },
                                            {
                                                "example_id": "e559388b-5658-4fb6-9e3e-d9c3de7470e9",
                                                "sense_id": "9e7dd944-6b5f-3890-8cd5-9dc19d58f2cd",
                                                "text": "Rindfleisch kommt und geht."
                                            },
                                            {
                                                "example_id": "48d23c88-7a57-49cc-968d-addcc95658f7",
                                                "sense_id": "9e7dd944-6b5f-3890-8cd5-9dc19d58f2cd",
                                                "text": "Rindfleischs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
