                "senses": [
                    {
                        "sense_id": "fc79687f-9f55-3bf8-abb9-d13ae8d78fac",
                        "entry_id": "b681dbfa-673f-3868-8d81-dfdac03dd5b4",
                        "glosses": [
                            "Produire une ritournelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c98efbfd-ab2d-4aaf-840b-affb21c2109d",
                                "sense_id": "fc79687f-9f55-3bf8-abb9-d13ae8d78fac",
                                "text": "Il caracole sur les ondes, investit l’ipodsphère, donne dans le photomaton pour ritourneller sous arrangements électronique votre quotidien so XXI et s’impose comme l’une des réjouissantes sécotines musicales de l’année avec la sortie de son nouvel album « Lunar Lane ».’' — (site strasbourg.curieux.net, 30 octobre 2015)"
                            },
                            {
                                "example_id": "8c40b2bd-2165-4201-aea8-a43c76cbaf9d",
                                "sense_id": "fc79687f-9f55-3bf8-abb9-d13ae8d78fac",
                                "text": "Moi aussi j'y vas, même que j'y amène des amis et que comme je vois que certains d'entre vous y seront, on va tous farandoler, chanter, rire, ritourneller et se bisouter tout encostumés."
                            },
                            {
                                "example_id": "1236032c-26b3-4cbf-adf8-993000faf57e",
                                "sense_id": "fc79687f-9f55-3bf8-abb9-d13ae8d78fac",
                                "text": "Arrêter de blablater, de se raconter aux autres sans arrêt, particulièrement au téléphone, de \"ritourneller\"."
                            },
                            {
                                "example_id": "fd40bde4-b2f7-40b2-b965-75a4f57db595",
                                "sense_id": "fc79687f-9f55-3bf8-abb9-d13ae8d78fac",
                                "text": "Le Boléro doit se ritourneller dans ses portées !!"
                            }
                        ]
                    }
                ],
