                "translations": [
                    {
                        "translation_id": "ecf3a78d-2048-4ccb-a1e4-9a17f5e9b640",
                        "source_entry_id": "8dff9183-f0c7-359d-9077-df2e668e859d",
                        "source_sense_id": "bc923ecb-92d4-3504-92c0-3d2eae7de362",
                        "target_lang_word": "lose one's way",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lose one's way",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6513765-d394-379d-b1b3-52e8b8ffb624",
                                        "entry_id": "2574dfd6-1a11-3055-8a97-732d2eb3f088",
                                        "glosses": [
                                            "To become lost; to lose one's bearings, or idea of where one is."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b82a137-f61a-494b-a0ff-dca54e8ffccf",
                                                "sense_id": "b6513765-d394-379d-b1b3-52e8b8ffb624",
                                                "text": "It was certainly rare to see a Juventus team lose their way so badly bearing in mind it was 1-1 at the break and, if anything, Massimiliano Allegri’s players had looked the more rounded side."
                                            },
                                            {
                                                "example_id": "8b02aa24-6a2e-41c3-a0fe-26ec23d46a60",
                                                "sense_id": "b6513765-d394-379d-b1b3-52e8b8ffb624",
                                                "text": "This was a wonderful advert for the Premier League, with both Chelsea and United intent on all-out attack - but Ferguson will be concerned at how his side lost their way after imperiously controlling much of the first period."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74910187-27f4-3fca-bc52-f6641621f65d",
                                        "entry_id": "2574dfd6-1a11-3055-8a97-732d2eb3f088",
                                        "glosses": [
                                            "To cease to succeed or to follow the right path; to fail."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c1184f0-d674-4520-bdfb-df240f3960e8",
                                                "sense_id": "74910187-27f4-3fca-bc52-f6641621f65d",
                                                "text": "The band lost their way after their second album, and split up after a string of failures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bbe6fe8-32bb-47ed-9792-0c2a46f59d56",
                        "source_entry_id": "8dff9183-f0c7-359d-9077-df2e668e859d",
                        "source_sense_id": "bc923ecb-92d4-3504-92c0-3d2eae7de362",
                        "target_lang_word": "descarriarse",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "descarriarse",
