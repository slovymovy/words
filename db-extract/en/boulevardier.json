                ],
                "senses": [
                    {
                        "sense_id": "e0bdbc99-d04d-3de0-bfa5-e5267a062232",
                        "entry_id": "b2412361-c273-33a0-98ad-edfb2c4113d9",
                        "glosses": [
                            "To strut or show off like a boulevardier."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2ff98989-89d0-4725-a2eb-b6dcddf52035",
                                "sense_id": "e0bdbc99-d04d-3de0-bfa5-e5267a062232",
                                "text": "One spectacular being clothed liked a boulevardiering cavalier and having the mein of a finished chesterfieldian gentleman was noted seated in an oak near the cabin one day. ... It was a northern butcher-bird, the aggressive shrike ...."
                            },
                            {
                                "example_id": "acc26cd7-c17d-4614-a6dd-66b6dc7c2780",
                                "sense_id": "e0bdbc99-d04d-3de0-bfa5-e5267a062232",
                                "text": "It's safe to say that the baby boom generation is the most self-obsessed group of people ever to have boulevardiered the planet."
                            },
                            {
                                "example_id": "5f83c203-b98f-416d-b743-07d5aaa0f85f",
                                "sense_id": "e0bdbc99-d04d-3de0-bfa5-e5267a062232",
                                "text": "For that quick romantic getaway, a weekend in the city of love, especially in spring or autumn, still delivers in terms of candlelit bistros, afternoons in cafés and boulevardiering in the Marais."
                            }
                        ]
                    }
