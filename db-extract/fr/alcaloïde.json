        "fr-extract.jsonl": [
            {
                "entry_id": "870cb20b-5cc5-3494-8a41-0c1297926330",
                "word": "alcaloïde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "36aaf7db-e87e-4893-a8f7-4c7ec3ad2e48",
                        "entry_id": "870cb20b-5cc5-3494-8a41-0c1297926330",
                        "tags": [
                            "plural"
                        ],
                        "form": "alcaloïdes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "811f375a-f325-327b-92d0-b8df25a9fbb4",
                        "entry_id": "870cb20b-5cc5-3494-8a41-0c1297926330",
                        "glosses": [
                            "Composé organique azoté, le plus souvent hétérocyclique, produit par des êtres vivants, en particulier les plantes, et souvent doté d’une activité pharmacologique ou toxique."
                        ],
                        "tags": [
                            "Pharmacognosie"
                        ],
                        "examples": [
                            {
                                "example_id": "6b4cfe34-bafd-43ee-9779-0de106024d48",
                                "sense_id": "811f375a-f325-327b-92d0-b8df25a9fbb4",
                                "text": "La stovaïne est un alcaloïde artificiel préparé par des procédés purement chimiques."
                            },
                            {
                                "example_id": "a2dc570f-88b8-4471-939c-d4831fabc2cb",
                                "sense_id": "811f375a-f325-327b-92d0-b8df25a9fbb4",
                                "text": "Ces dévastateurs de l'humanité, les explosifs, les avions de bombardement, les gaz mortifères, font partie de la plus haute science, au même titre que la chaise à électrocuter et que les alcaloïdes hypertoxiques."
                            },
                            {
                                "example_id": "56035f62-293d-4226-9c7d-57f51daa06ca",
                                "sense_id": "811f375a-f325-327b-92d0-b8df25a9fbb4",
                                "text": "En ce qui concerne les alcaloïdes contenus dans les daturas, l’EFSA a conclu, dans son avis du 9 avril 2008, que les alcaloïdes tropaniques étaient présents dans toutes les espèces du genre Datura …."
                            },
                            {
                                "example_id": "74eba767-ee5e-443b-bff9-dd9abc277769",
                                "sense_id": "811f375a-f325-327b-92d0-b8df25a9fbb4",
                                "text": "La plupart des alcaloïdes sont synthétisés à partir d'un petit nombre d’acides aminés ordinaires (tyrosine, tryptophane, ornithine ou arginine et lysine)."
                            },
                            {
                                "example_id": "d8b06d1d-2679-4a4b-8a8f-1c208cae37f1",
                                "sense_id": "811f375a-f325-327b-92d0-b8df25a9fbb4",
                                "text": "— Le pétrole nicotineux est régénéré par contact avec de l’acide sulfurique concentré, produit se combinant avec la nicotine, pour donner un sulfate titrant environ 500 grammes de nicotine alcaloïde par litre de solution."
                            }
                        ]
                    },
                    {
                        "sense_id": "19500342-0018-3120-ae53-3af2fbf2ac79",
                        "entry_id": "870cb20b-5cc5-3494-8a41-0c1297926330",
                        "glosses": [
                            "Composé organique azoté dont les propriétés basiques évoquent celles des alcalis, capable de neutraliser les acides."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8ee49cb8-d783-4d90-8fed-92203d031678",
                                "sense_id": "19500342-0018-3120-ae53-3af2fbf2ac79",
                                "text": "Les alcaloïdes végétaux."
                            },
                            {
                                "example_id": "8fbcc507-0780-4e5d-abe5-bf1d4ae09c35",
                                "sense_id": "19500342-0018-3120-ae53-3af2fbf2ac79",
                                "text": "Les alcaloïdes animaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ee0abeb-1586-4586-9932-2189dd0e1151",
                        "source_entry_id": "870cb20b-5cc5-3494-8a41-0c1297926330",
