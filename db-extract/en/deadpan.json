                                            {
                                                "example_id": "dbfd849f-af70-41f1-bc56-cb76bed2dc25",
                                                "sense_id": "a6e66586-008e-38f8-b1ed-8ea17fad7b5f",
                                                "text": "« Ohabolana » est un mot couramment traduit en français par « proverbe ». Un « ohabolana » français nous assure que «la plus belle fille du monde ne peut donner que ce qu’elle a», à quoi Valéry répondit pince-sans-rire : « Mieux vaut souvent qu’elle le garde ! », […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pince-sans-rire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40c1105d-7c73-3223-8b3a-f113096ea1d5",
                                        "entry_id": "d4ee7819-7217-3a14-b147-1e15ee394e6e",
                                        "glosses": [
                                            "Se dit d’une personne qui raille et plaisante en restant froid et impassible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "997c6536-b025-4b49-9aff-b1a14e77bee0",
                                                "sense_id": "40c1105d-7c73-3223-8b3a-f113096ea1d5",
                                                "text": "Je conseille toutefois à ce lecteur de ne pas oublier que M. Sabahu est un pince-sans-rire qui frétille secrètement de plaisir lorsqu’il trouve l’occasion de dire ou d’écrire sérieusement une naïveté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
