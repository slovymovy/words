                "senses": [
                    {
                        "sense_id": "998dbc1a-26b9-3700-90f5-6bcaa08290f8",
                        "entry_id": "a01f7bf4-ba46-32c3-8bf9-dde238026973",
                        "glosses": [
                            "Stadt mit sehr vielen Einwohnern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50fbf572-69c0-4047-b3f9-4392697645cf",
                                "sense_id": "998dbc1a-26b9-3700-90f5-6bcaa08290f8",
                                "text": "„Von dieser Riesenstadt sind nur spärliche Reste bei den heutigen Dörfern Bedreschëin und Mitrahenneh übrig geblieben.“"
                            },
                            {
                                "example_id": "7efa1409-a29d-4b47-9383-aac6c0ec5e05",
                                "sense_id": "998dbc1a-26b9-3700-90f5-6bcaa08290f8",
                                "text": "„Die Eindrücke der Riesenstadt Tokio sind sehr vielfältig. Darüber ließe sich manches erzählen: drei übereinander liegende Autobahnen mitten in der Stadt, Tennisplätze auf dem Dach der Hochhäuser und was weiß ich nicht alles.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
