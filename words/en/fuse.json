    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "05406042-a0ae-36ef-8632-5a6686b41304",
                    "sense_definition": "A cord that is lit to ignite an explosive device.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "explosives",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier lit the <w>fuse</w> and ran for cover before the charge exploded."
                        },
                        {
                            "text": "He carefully cut the <w>fuse</w> to prevent the bomb from detonating."
                        }
                    ],
                    "synonyms": [
                        "fuze"
                    ],
                    "common_phrases": [
                        "light the fuse"
                    ]
                },
                {
                    "sense_id": "f769ead2-b534-3b55-a156-f8e913909508",
                    "sense_definition": "A safety device in an electrical circuit that melts to stop the current if it becomes too high.",
