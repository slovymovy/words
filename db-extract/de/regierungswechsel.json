                "senses": [
                    {
                        "sense_id": "1541bdbb-9264-3a0b-b30b-1dd9b25857f9",
                        "entry_id": "340b314d-e6a4-3bea-9704-934e007d8110",
                        "glosses": [
                            "Neubesetzung der Regierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1ac7aa9-7afb-4c4b-9b97-3e043aba0466",
                                "sense_id": "1541bdbb-9264-3a0b-b30b-1dd9b25857f9",
                                "text": "„Mit dem Regierungswechsel regte sich neue Hoffnung in Jericho, und die setzte sich in sparsame Aktivität um.“"
                            },
                            {
                                "example_id": "f1d880db-26d0-4ae3-bde6-66b70ac7258b",
                                "sense_id": "1541bdbb-9264-3a0b-b30b-1dd9b25857f9",
                                "text": "„In dieser Zeit fanden zwei weitere Regierungswechsel statt, nicht infolge von Neuwahlen, sondern durch Koalitionswechsel.“"
                            },
                            {
                                "example_id": "a5cb7e64-0199-44c3-8fa9-aced51e11b90",
                                "sense_id": "1541bdbb-9264-3a0b-b30b-1dd9b25857f9",
                                "text": "„Während Italien seit 1946 sage und schreibe 62 Regierungswechsel durchlitt, erfreute sich Deutschland einer großen politischen Stabilität.“"
                            },
                            {
                                "example_id": "7b85a7bf-f0a6-4663-a275-b2d95665d9c1",
                                "sense_id": "1541bdbb-9264-3a0b-b30b-1dd9b25857f9",
                                "text": "„Nach dem Regierungswechsel (1786) war die preußische Regierung dem Königsberger Philosophen mit seiner europäischen Reputation zunächst überaus wohlgesinnt, hatte sein Gehalt um die Hälfte erhöht und sein Amt als Rektor bei den Huldigungsfeierlichkeiten geehrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "575a149b-45c5-49bf-9713-813f35208e17",
                        "source_entry_id": "340b314d-e6a4-3bea-9704-934e007d8110",
                        "source_sense_id": "1541bdbb-9264-3a0b-b30b-1dd9b25857f9",
                        "source_sense_description": "Neubesetzung der Regierung",
                        "target_lang_word": "government",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "government",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1af638f7-02e2-3681-be25-b18be74da387",
                                        "entry_id": "642372bf-d99d-3531-8d29-0f1dfe17f837",
                                        "glosses": [
                                            "The body with the power to make and/or enforce laws to control a country, land area, people or organization."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "901f95ca-22f6-4612-b55c-0dd046c00a24",
                                                "sense_id": "1af638f7-02e2-3681-be25-b18be74da387",
                                                "text": "British government has historically centred exclusively on London."
                                            },
                                            {
                                                "example_id": "c7162a78-4781-405a-8d6f-b54bbd68c996",
                                                "sense_id": "1af638f7-02e2-3681-be25-b18be74da387",
                                                "text": "[…]and that government of the people, by the people, for the people, shall not perish from the earth."
                                            },
                                            {
                                                "example_id": "7c962d50-f2b0-412a-b3ce-041d2a4a1aaa",
                                                "sense_id": "1af638f7-02e2-3681-be25-b18be74da387",
                                                "text": "Investors face a quandary. Cash offers a return of virtually zero in many developed countries; government-bond yields may have risen in recent weeks but they are still unattractive. Equities have suffered two big bear markets since 2000 and are wobbling again. It is hardly surprising that pension funds, insurers and endowments are searching for new sources of return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8a34b48-5e6b-3f58-895d-47b0273e3ea5",
                                        "entry_id": "642372bf-d99d-3531-8d29-0f1dfe17f837",
                                        "glosses": [
                                            "The relationship between a word and its dependents."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87120746-e4a9-3d6d-864a-7b5b2b963902",
                                        "entry_id": "642372bf-d99d-3531-8d29-0f1dfe17f837",
                                        "glosses": [
                                            "The state and its administration viewed as the ruling political power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abd64ec1-5cc2-4c8c-ac53-823a6c221af7",
                                                "sense_id": "87120746-e4a9-3d6d-864a-7b5b2b963902",
                                                "text": "Near-synonyms: state, administration"
                                            },
                                            {
                                                "example_id": "718ce41a-aa52-47ad-84e1-83b843f34b00",
                                                "sense_id": "87120746-e4a9-3d6d-864a-7b5b2b963902",
                                                "text": "If the citizens must follow the law, then the government must follow the constitution."
                                            },
                                            {
                                                "example_id": "07a310fc-77c6-441c-b938-062a235a25e9",
                                                "sense_id": "87120746-e4a9-3d6d-864a-7b5b2b963902",
                                                "text": "Risk is everywhere. From tabloid headlines insisting that coffee causes cancer (yesterday, of course, it cured it) to stern government warnings about alcohol and driving, the world is teeming with goblins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "909c1986-31af-3ce3-bf03-b3270a114ee7",
                                        "entry_id": "642372bf-d99d-3531-8d29-0f1dfe17f837",
                                        "glosses": [
                                            "The management or control of a system."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9811273b-a1bd-4a6f-94d4-c7c0b01d235a",
                                                "sense_id": "909c1986-31af-3ce3-bf03-b3270a114ee7",
                                                "text": "The government of the Church is maintained without material alteration in a settled hierarchical form."
                                            },
                                            {
                                                "example_id": "9821cbca-4d13-4952-bf9a-a4802611cd72",
                                                "sense_id": "909c1986-31af-3ce3-bf03-b3270a114ee7",
                                                "text": "Whereas it is expedient to amend the law relating to the government of Her Majesty's Navy, whereon, under the good Providence of God, the wealth, safety and strength of the Kingdom so much depend:"
                                            },
                                            {
                                                "example_id": "e7772250-6079-4468-a62b-783f6bc64ea9",
                                                "sense_id": "909c1986-31af-3ce3-bf03-b3270a114ee7",
                                                "text": "Ainsi, dans une société donnée, l’autorité de l’homme sur l’homme est en raison inverse du développement intellectuel auquel cette société est parvenue, et la durée probable de cette autorité peut être calculée sur le désir plus ou moins général d’un gouvernement vrai, c’est-à-dire, d’un gouvernement selon la science."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "254bcfe7-58ac-3899-9fe4-d3f8b26b3264",
                                        "entry_id": "642372bf-d99d-3531-8d29-0f1dfe17f837",
                                        "glosses": [
                                            "The tenure of a head of government; the ministry or administration led by a specified individual."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f4e4092-7171-4eef-8c66-255302a22463",
                                                "sense_id": "254bcfe7-58ac-3899-9fe4-d3f8b26b3264",
                                                "text": "The Sunak government announced plans to stem the flow of migrants coming into Great Britain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32393519-3581-386c-94ac-ac501c35c943",
                                        "entry_id": "642372bf-d99d-3531-8d29-0f1dfe17f837",
                                        "glosses": [
                                            "In a parliamentary system, the political party or coalition in power; its condition of being in power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c74b74a6-f570-34d5-9723-54ff9f51010a",
                                        "entry_id": "642372bf-d99d-3531-8d29-0f1dfe17f837",
                                        "glosses": [
                                            "The team tasked with presenting and speaking in favour of a resolution, as opposed to the opposition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
