                        "entry_id": "ef74e16d-b216-3777-9d07-f0e0df128154",
                        "glosses": [
                            "einzelliges Lebewesen, welches sich von Bakterien ernährt und sich mithilfe seiner zahlreichen Wimpern fortbewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a7c8c5c-5c35-40ee-84c2-0bd9735df33a",
                                "sense_id": "1e75b417-a03c-3aa2-a8a0-60f785e6e2d3",
                                "text": "„Pantoffeltierchen sind frei lebende, sich aktiv bewegende Einzeller mit einer Länge zwischen 50 und 300 Mikrometern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52558feb-c69c-4764-aa1e-3d3391f67550",
                        "source_entry_id": "ef74e16d-b216-3777-9d07-f0e0df128154",
                        "source_sense_id": "1e75b417-a03c-3aa2-a8a0-60f785e6e2d3",
                        "target_lang_word": "paramecium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paramecium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7861d20f-40f7-3f20-9025-87e4596a259c",
                                        "entry_id": "9042c727-59f6-3207-adb8-9341eb5069dd",
                                        "glosses": [
                                            "An oval-shaped protozoan organism of the genus Paramecium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e54da7ba-01a9-4d8d-a968-7002e277ae24",
                                                "sense_id": "7861d20f-40f7-3f20-9025-87e4596a259c",
                                                "text": "The sun beats on his eyelids; inside them a paramecium revolves. A blink and it changes pattern like a kaleidoscope."
                                            },
                                            {
                                                "example_id": "de9956f6-d9f6-4994-96bd-fa3e9b66b5dc",
                                                "sense_id": "7861d20f-40f7-3f20-9025-87e4596a259c",
                                                "text": "Edgar noticed that Clyde was wearing a necktie with a driblet design. The little figures made him think of paramecia, sinister organisms with gullets and feeding grooves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9be9908-5fe3-4542-a270-6bc21fd7a7f3",
                        "source_entry_id": "ef74e16d-b216-3777-9d07-f0e0df128154",
                        "source_sense_id": "1e75b417-a03c-3aa2-a8a0-60f785e6e2d3",
