{
    "word_family": [
        "gimmickry",
        "gimmicky"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d906d38-7fc7-366f-91e1-d880fbf89f5f",
                    "sense_definition": "A ploy, strategy, or device used to attract attention, publicity, or business, often lacking intrinsic value.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "marketing-trick",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The free gift was just a clever <w>gimmick</w> to get people to sign up for their mailing list.",
                            "target_lang_translations": {
                                "ru": "Бесплатный подарок был всего лишь умной <w>уловкой</w>, чтобы заставить людей подписаться на их рассылку."
                            }
                        },
                        {
                            "text": "Many consumers are tired of every cheap <w>gimmick</w> used by companies to boost their sales.",
                            "target_lang_translations": {
                                "ru": "Многие потребители устали от дешевых <w>трюков</w>, которые компании используют для увеличения продаж."
                            }
                        }
                    ],
                    "synonyms": [
                        "stunt",
                        "ploy",
                        "trick"
                    ],
                    "common_phrases": [
                        "marketing gimmick",
                        "cheap gimmick",
                        "publicity gimmick"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прием, стратегия или устройство, используемые для привлечения внимания, рекламы или бизнеса, часто не имеющие реальной ценности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уловка",
                                "target_lang_sense_clarification": "хитрый прием для привлечения внимания или обмана покупателей"
                            },
                            {
                                "target_lang_word": "трюк",
                                "target_lang_sense_clarification": "маркетинговый или рекламный ход"
                            },
                            {
                                "target_lang_word": "ухищрение",
                                "target_lang_sense_clarification": "изобретательный прием для достижения коммерческой цели"
                            },
                            {
                                "target_lang_word": "завлекалочка",
                                "target_lang_sense_clarification": "разговорное обозначение дешевого приема для привлечения клиентов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "999318c1-5944-362d-8ee6-4dc46e64e170",
                    "sense_definition": "A secret device, trick, or mechanism used to make something work or to create an illusion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mechanism-trick",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician's box had a hidden <w>gimmick</w> to make the coin appear to vanish.",
                            "target_lang_translations": {
                                "ru": "В коробке фокусника было скрытое <w>приспособление</w>, благодаря которому монета исчезала."
                            }
                        },
                        {
                            "text": "He explained the mechanical <w>gimmick</w> that allowed the stage door to open automatically.",
                            "target_lang_translations": {
                                "ru": "Он объяснил механическую <w>хитрость</w>, которая позволяла двери сцены открываться автоматически."
                            }
                        }
                    ],
                    "synonyms": [
                        "device",
                        "contraption",
                        "gadget"
                    ],
                    "common_phrases": [
                        "hidden gimmick"
                    ],
                    "target_lang_definitions": {
                        "ru": "Секретное устройство, трюк или механизм, используемый для обеспечения работы чего-либо или создания иллюзии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приспособление",
                                "target_lang_sense_clarification": "скрытый механизм или деталь"
                            },
                            {
                                "target_lang_word": "трюк",
                                "target_lang_sense_clarification": "секрет фокуса или иллюзии"
                            },
                            {
                                "target_lang_word": "хитрость",
                                "target_lang_sense_clarification": "скрытая особенность конструкции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e52cae1d-cb50-3229-be1a-1c7845870629",
                    "sense_definition": "A night out with one's friends.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are planning a wild <w>gimmick</w> in the city center this weekend.",
                            "target_lang_translations": {
                                "ru": "Мы планируем безумную <w>вылазку</w> в центр города на этих выходных."
                            }
                        },
                        {
                            "text": "After a long week of hard work, they all went out for a proper <w>gimmick</w>.",
                            "target_lang_translations": {
                                "ru": "После долгой недели тяжелой работы они все отправились на хорошую <w>тусовку</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "outing",
                        "night out"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly used in Irish slang"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "Informal social usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вечерний выход в свет или прогулка с друзьями (ирландский сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вылазка",
                                "target_lang_sense_clarification": "совместный выход или прогулка с друзьями"
                            },
                            {
                                "target_lang_word": "тусовка",
                                "target_lang_sense_clarification": "неформальная вечеринка или встреча"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed802865-c14b-3967-b868-2768784648e3",
                    "sense_definition": "A capacitor formed by twisting together two insulated wires.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician adjusted the homemade <w>gimmick</w> to fine-tune the radio frequency.",
                            "target_lang_translations": {
                                "ru": "Техник отрегулировал самодельный <w>конденсатор-скрутку</w>, чтобы точно настроить радиочастоту."
                            }
                        },
                        {
                            "text": "Using a twisted-wire <w>gimmick</w> is a classic way to add a tiny amount of capacitance.",
                            "target_lang_translations": {
                                "ru": "Использование <w>скрутки</w> из двух проводов — классический способ добавить крошечную емкость."
                            }
                        }
                    ],
                    "synonyms": [
                        "gimmick capacitor"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Short for gimmick capacitor"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конденсатор, образованный скручиванием двух изолированных проводов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конденсатор из скрутки",
                                "target_lang_sense_clarification": "самодельный емкостный элемент в радиотехнике"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "99a45a37-df8a-35fa-a142-e628aabbb360",
                    "sense_definition": "To alter, rig, or equip something with a trick, device, or deceptive feature.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician had <w>gimmicked</w> the deck of cards to ensure he always drew an ace.",
                            "target_lang_translations": {
                                "ru": "Фокусник <w>подстроил</w> колоду карт так, чтобы всегда вытягивать туза."
                            }
                        },
                        {
                            "text": "If you <w>gimmick</w> the scale, the measurements will no longer be honest.",
                            "target_lang_translations": {
                                "ru": "Если вы <w>подкрутите</w> весы, измерения больше не будут честными."
                            }
                        }
                    ],
                    "synonyms": [
                        "rig",
                        "doctor",
                        "manipulate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять, подстраивать или оснащать что-либо скрытым механизмом или обманным элементом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подстраивать",
                                "target_lang_sense_clarification": "оснащать скрытым приспособлением для обмана"
                            },
                            {
                                "target_lang_word": "фальсифицировать",
                                "target_lang_sense_clarification": "изменять показания приборов с помощью уловок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}