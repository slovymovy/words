                    },
                    {
                        "translation_id": "07cafe40-81dd-45dc-9a49-6102d349ce24",
                        "source_entry_id": "e0472045-bca5-3276-9bb2-cc3e7d4bdf89",
                        "target_lang_word": "surcharge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surcharge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57565c57-2b14-30f8-9558-7373fcbdf03b",
                                        "entry_id": "a1518a21-f77d-3240-ba98-edb77b6064bf",
                                        "glosses": [
                                            "An addition of extra charge on the agreed, stated, or baseline price."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adf1074a-a19d-4d2a-b176-55e03015a25a",
                                                "sense_id": "57565c57-2b14-30f8-9558-7373fcbdf03b",
                                                "text": "Our airline tickets cost twenty dollars more than we expected because we had to pay a fuel surcharge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95653fec-a252-3097-b88e-81c2e2e1c936",
                                        "entry_id": "a1518a21-f77d-3240-ba98-edb77b6064bf",
                                        "glosses": [
                                            "The part of the price of a subsidized good or service that is not covered by the subsidy and so must be paid by the consumer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b925a03d-ee7a-30fc-be53-2aab7c81975d",
                                        "entry_id": "a1518a21-f77d-3240-ba98-edb77b6064bf",
                                        "glosses": [
                                            "An excessive price charged e.g. to an unsuspecting customer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "adaae4d2-b90b-3799-9724-0388546c6cbf",
                                        "entry_id": "a1518a21-f77d-3240-ba98-edb77b6064bf",
                                        "glosses": [
                                            "An overprint on a stamp that alters (usually raises) the original nominal value of the stamp; used especially in times of hyperinflation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f50da3f-3eef-32a2-b8e7-f95d7acb7661",
                                        "entry_id": "a1518a21-f77d-3240-ba98-edb77b6064bf",
                                        "glosses": [
                                            "A painting in lighter enamel over a darker one that serves as the ground."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b02e4bf-2276-3030-bc55-2bd776d32808",
                                        "entry_id": "a1518a21-f77d-3240-ba98-edb77b6064bf",
                                        "glosses": [
                                            "A charge that has been omitted from an account as payment of a credit to the charged party"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3443a3b6-95a2-31ca-abbb-ef0d2178ed98",
                                        "entry_id": "a1518a21-f77d-3240-ba98-edb77b6064bf",
                                        "glosses": [
                                            "A penalty for failure to exercise common prudence and skill in the performance of a fiduciary's duties."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6285abdd-419c-310a-88a1-6fcaf7e1e0ff",
                                        "entry_id": "a1518a21-f77d-3240-ba98-edb77b6064bf",
                                        "glosses": [
                                            "An excessive load or burden."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54413e90-7898-4e69-bae6-5ac2bcc06529",
                                                "sense_id": "6285abdd-419c-310a-88a1-6fcaf7e1e0ff",
                                                "text": "A Numerous Nobility, cauſet Pouerty, and Inconuenience in a State: For it is a Surcharge of Expence;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad1f73af-ce4c-314b-bdbf-3dae1b61dc38",
                                        "entry_id": "a1518a21-f77d-3240-ba98-edb77b6064bf",
                                        "glosses": [
                                            "The putting, by a commoner, of more animals on the common than he is entitled to."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "surcharge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f13b9c77-5587-3728-90b8-1d864aaea7cf",
                                        "entry_id": "4dc12748-d202-3c92-bf4a-88237e4ebd27",
                                        "glosses": [
                                            "To apply a surcharge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "103e88f7-1e92-3ecc-9746-23aec9191216",
                                        "entry_id": "4dc12748-d202-3c92-bf4a-88237e4ebd27",
                                        "glosses": [
                                            "To overload; to overburden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eadfffb-2f46-44d5-bb4c-5b9ef2823b13",
                                                "sense_id": "103e88f7-1e92-3ecc-9746-23aec9191216",
                                                "text": "to surcharge an animal or a ship; to surcharge a cannon"
                                            },
                                            {
                                                "example_id": "e942e4dd-c9c5-4947-ae67-51de7713c88f",
                                                "sense_id": "103e88f7-1e92-3ecc-9746-23aec9191216",
                                                "text": "My heauy hart I feare will breake in twaine,\nSurcharged with a heauie loade of thoughts."
                                            },
                                            {
                                                "example_id": "b3d880e6-ebc2-4880-b967-a15150e39860",
                                                "sense_id": "103e88f7-1e92-3ecc-9746-23aec9191216",
                                                "text": "Your head reclin’d, (as hiding grief from view,) / Droops, like a Roſe ſurcharg’d with morning Dew."
                                            },
                                            {
                                                "example_id": "cba6303f-c9eb-412f-9d67-640053146c5d",
                                                "sense_id": "103e88f7-1e92-3ecc-9746-23aec9191216",
                                                "text": "The threat was soon fulfilled; the evening came on, prematurely darkened by clouds that seemed surcharged with a deluge."
                                            },
                                            {
                                                "example_id": "c1122856-9269-4cc6-9486-3edc266d07c6",
                                                "sense_id": "103e88f7-1e92-3ecc-9746-23aec9191216",
                                                "text": "The first, on January 1, 1883, was attributed to the overlay becoming surcharged with water, due to insufficient drainage, and causing a slip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc5d94e9-d735-32f2-82d9-467854a8d9c0",
                                        "entry_id": "4dc12748-d202-3c92-bf4a-88237e4ebd27",
                                        "glosses": [
                                            "To overstock; especially, to put more cattle into (e.g. a common) than one has a right to do, or more than the herbage will sustain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79b1dc73-77e6-4863-b404-68900b6a5321",
                                                "sense_id": "fc5d94e9-d735-32f2-82d9-467854a8d9c0",
                                                "text": "Another diſturbance of common is by ſurcharging it; or putting more cattle therein than the paſture and herbage will ſuſtain, or the party hath a right to do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceb53bcd-c976-3abd-9233-bd5e267d66b1",
                                        "entry_id": "4dc12748-d202-3c92-bf4a-88237e4ebd27",
                                        "glosses": [
                                            "To show an omission in (an account) for which credit ought to have been given."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc94bbba-b5c9-4623-956e-c584f573f96c",
                                                "sense_id": "ceb53bcd-c976-3abd-9233-bd5e267d66b1",
                                                "text": "The Idle multitude surcharge their laies"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8966dd05-fd99-4596-9d5b-a8ee56338242",
                        "source_entry_id": "e0472045-bca5-3276-9bb2-cc3e7d4bdf89",
                        "target_lang_word": "Zuschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa66d76c-bef4-3cc0-90eb-0a5a4cbe10aa",
                                        "entry_id": "6f4d7b83-2b0b-36b9-a792-03b763dfe006",
                                        "glosses": [
                                            "(erhöhtes) Entgelt, das man für Sonderleistungen oder in bestimmten Situationen bezahlen muss oder bekommt"
                                        ],
                                        "tags": [
                                            "Finanzen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24ab3769-b15b-4be9-888b-32857597d6df",
                                                "sense_id": "aa66d76c-bef4-3cc0-90eb-0a5a4cbe10aa",
                                                "text": "Der Zuschlag durch erhöhte Transportkosten wird laufend angepasst."
                                            },
                                            {
                                                "example_id": "9cf9d8ca-1d97-44fc-a97a-2010d8181340",
                                                "sense_id": "aa66d76c-bef4-3cc0-90eb-0a5a4cbe10aa",
                                                "text": "Der Zuschlag für die Schnellzugverbindung kann auch beim Schaffner gelöst werden."
                                            },
                                            {
                                                "example_id": "65a17a1c-1780-4fba-985f-b252e478b9aa",
                                                "sense_id": "aa66d76c-bef4-3cc0-90eb-0a5a4cbe10aa",
                                                "text": "Der inoffizielle und illegale Zuschlag für Touristen beträgt mindestens 20 %."
                                            },
                                            {
                                                "example_id": "06f82a97-5a03-421a-a003-a9699e1fd300",
                                                "sense_id": "aa66d76c-bef4-3cc0-90eb-0a5a4cbe10aa",
                                                "text": "Die Zuschläge zum Arbeitslohn für Sonntags-, Feiertags- und Nachtarbeit bewegen sich zwischen 25 und 190 % und sind zusätzlich sozialversicherungsfrei und steuerfrei."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b8e60380-4074-3a40-83db-e5a44e4d47f7",
                                        "entry_id": "6f4d7b83-2b0b-36b9-a792-03b763dfe006",
                                        "glosses": [
                                            "Auftragserteilung, Geschäftsabschluss, Versteigerungsentscheidung (traditionell bzw. meist durch einen Schlag besiegelt)"
                                        ],
                                        "tags": [
                                            "Handel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46db6166-f5cd-4593-bbd3-947670495cd0",
                                                "sense_id": "b8e60380-4074-3a40-83db-e5a44e4d47f7",
                                                "text": "Bei der Versteigerung erhielt ein telefonisches Angebot den Zuschlag."
                                            },
                                            {
                                                "example_id": "02e81db3-090c-432b-a24f-50b068efe20e",
                                                "sense_id": "b8e60380-4074-3a40-83db-e5a44e4d47f7",
                                                "text": "Nachdem Istanbul den Zuschlag erhalten hatte, hat Serhan Ada bei der Gestaltung des Kulturhauptstadt-Programmes mitgearbeitet."
                                            },
                                            {
                                                "example_id": "edcad24d-130c-4717-a142-7ac410d116f9",
                                                "sense_id": "b8e60380-4074-3a40-83db-e5a44e4d47f7",
                                                "text": "„Die Bundesnetzagentur hat den Zuschlag für den Bau von 79 neuen Windrädern erteilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "487eb97b-b751-3a91-9644-d2663b89b6a1",
                                        "entry_id": "6f4d7b83-2b0b-36b9-a792-03b763dfe006",
                                        "glosses": [
                                            "Zusätze bei Mischungen wie Legierungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b321258-316d-4606-af1a-aa80f9e48c62",
                                                "sense_id": "487eb97b-b751-3a91-9644-d2663b89b6a1",
                                                "text": "Durch Zuschlag von Mangan soll Stahl widerstandsfähiger gemacht werden."
                                            },
                                            {
                                                "example_id": "d664f3b7-48f5-4370-9969-3c01f4dee5c5",
                                                "sense_id": "487eb97b-b751-3a91-9644-d2663b89b6a1",
                                                "text": "„Der Hochofen wird abwechselnd mit Koks und dem Gemisch aus Eisenerz und Zuschlägen, dem Möller, beschickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
