                ],
                "senses": [
                    {
                        "sense_id": "cc06d3c2-aff6-3d06-93e4-cf5fac79f2de",
                        "entry_id": "b455dd6c-5c3e-3dad-acfd-30886f60ea89",
                        "glosses": [
                            "derjenige Teil des sprachlichen Zeichens, der seine Bedeutung ausmacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "605b2d1f-4cc7-431d-ba29-2ac7147c22a8",
                                "sense_id": "cc06d3c2-aff6-3d06-93e4-cf5fac79f2de",
                                "text": "„Syntax, Morphologie und Phonologie beschreiben die Ausdrucksseite der Sprache, die Semantik beschäftigt sich mit der Inhaltsseite, mit den Inhalten der sprachlichen Zeichen, mit ihren Bedeutungen.“"
                            },
                            {
                                "example_id": "1f016c58-6426-422b-b47c-1c1f8c1f4fad",
                                "sense_id": "cc06d3c2-aff6-3d06-93e4-cf5fac79f2de",
                                "text": "„Ausdrückliches Ziel ist es dabei, keinerlei Kenntnis der Inhaltsseite zu benutzen.“"
                            },
                            {
                                "example_id": "f43baddf-eb67-47eb-b74b-3fc66ace4a75",
                                "sense_id": "cc06d3c2-aff6-3d06-93e4-cf5fac79f2de",
                                "text": "„Jedes Zeichen hat zwei Seiten, eine Ausdrucks- und eine Inhaltsseite.“"
                            },
                            {
                                "example_id": "6c313664-9cf1-4232-9d07-791821714b9e",
                                "sense_id": "cc06d3c2-aff6-3d06-93e4-cf5fac79f2de",
                                "text": "„In einer nächsten Schicht umfassen die EN sowohl auf der Ausdrucksseite als auf der Inhaltsseite Konnotationen.“"
                            },
                            {
                                "example_id": "bd462940-13f4-46d5-a56f-756b1d0222b4",
                                "sense_id": "cc06d3c2-aff6-3d06-93e4-cf5fac79f2de",
                                "text": "„Unabhängig von der Weite oder Enge der Ausdrucksparadigmen ist ihr Bezug auf die Inhaltsseite der Sprache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "13f55245-21f0-3146-a0e8-c85ce676a786",
                        "entry_id": "b455dd6c-5c3e-3dad-acfd-30886f60ea89",
                        "glosses": [
                            "Buch- oder Internetseite mit thematischen Inhalten"
                        ],
                        "tags": [
                            "Medien"
                        ],
                        "examples": [
                            {
                                "example_id": "0cdd5c12-f9d4-43b1-af76-7ed3ecb80041",
                                "sense_id": "13f55245-21f0-3146-a0e8-c85ce676a786",
                                "text": "Mithilfe der Inhaltsseite findet man viele Themen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
