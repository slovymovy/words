{
    "word_family": [
        "messenger"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "45add5f5-db27-33c5-8b4b-73ea704ee623",
                    "sense_definition": "A communication (spoken, written, or electronic) that is sent to someone; the information that is communicated.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication sent or received",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I got a <w>message</w> from my manager about tomorrow’s meeting.",
                            "target_lang_translations": {
                                "ru": "Я получил <w>сообщение</w> от своего менеджера по поводу завтрашней встречи."
                            }
                        },
                        {
                            "text": "Please leave a <w>message</w> after the beep if nobody answers.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, оставьте <w>сообщение</w> после звукового сигнала, если никто не ответит."
                            }
                        }
                    ],
                    "synonyms": [
                        "text",
                        "text",
                        "text",
                        "text"
                    ],
                    "common_phrases": [
                        "send a message",
                        "leave a message",
                        "get a message",
                        "text message"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сообщение (устное, письменное или электронное), отправленное кому-либо; передаваемая информация."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сообщение",
                                "target_lang_sense_clarification": "общий термин для любой информации"
                            },
                            {
                                "target_lang_word": "послание",
                                "target_lang_sense_clarification": "более формальное или длинное сообщение"
                            },
                            {
                                "target_lang_word": "СМС",
                                "target_lang_sense_clarification": "короткое текстовое сообщение на телефон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "370d526b-91b6-3e74-982b-6e5dcac95f18",
                    "sense_definition": "The main idea, lesson, or meaning that something (such as a story, speech, or event) is intended to express.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meaning or moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie’s <w>message</w> is that friends should help each other.",
                            "target_lang_translations": {
                                "ru": "Основная <w>мысль</w> фильма в том, что друзья должны помогать друг другу."
                            }
                        },
                        {
                            "text": "The teacher explained the <w>message</w> of the story in simple words.",
                            "target_lang_translations": {
                                "ru": "Учитель простыми словами объяснил <w>послание</w> этого рассказа."
                            }
                        }
                    ],
                    "synonyms": [
                        "text",
                        "text"
                    ],
                    "common_phrases": [
                        "message of the story",
                        "clear message",
                        "main message"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основная идея, урок или смысл, который что-либо (например, история, речь или событие) призвано выразить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "послание",
                                "target_lang_sense_clarification": "идейное содержание произведения"
                            },
                            {
                                "target_lang_word": "месседж",
                                "target_lang_sense_clarification": "современный термин для обозначения ключевой идеи"
                            },
                            {
                                "target_lang_word": "смысл",
                                "target_lang_sense_clarification": "основная суть или значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89dbe6df-16b5-320a-b376-8952a49a1526",
                    "sense_definition": "A short errand; a small task done by going somewhere for someone else.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "errand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She went on a <w>message</w> to the village to buy medicine.",
                            "target_lang_translations": {
                                "ru": "Она отправилась с <w>поручением</w> в деревню, чтобы купить лекарства."
                            }
                        },
                        {
                            "text": "He was on a <w>message</w> for his mother when the rain started.",
                            "target_lang_translations": {
                                "ru": "Он выполнял <w>просьбу</w> матери, когда пошёл дождь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "run a message",
                        "go on a message"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Older use meaning a short errand."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое поручение; небольшое задание, связанное с походом куда-либо для другого человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поручение",
                                "target_lang_sense_clarification": "задание сходить куда-либо"
                            },
                            {
                                "target_lang_word": "дело",
                                "target_lang_sense_clarification": "небольшая задача вне дома"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ea9da29-4b62-3b6d-affb-cc7ccde8c69d",
                    "sense_definition": "(Usually plural, dialectal) Groceries; shopping items bought at a shop.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shopping groceries",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some places, people say they are going for <w>messages</w> instead of shopping.",
                            "target_lang_translations": {
                                "ru": "В некоторых местах люди говорят, что идут за <w>покупками</w>, а не по магазинам."
                            }
                        },
                        {
                            "text": "He carried the <w>messages</w> home from the shop in two heavy bags.",
                            "target_lang_translations": {
                                "ru": "Он нёс <w>продукты</w> домой из магазина в двух тяжёлых сумках."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go for messages",
                        "carry messages",
                        "do the messages"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used mainly in Scotland, usually in the plural: messages."
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "Dialectal use meaning groceries or shopping."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продукты питания; покупки, сделанные в магазине (диалектное употребление)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покупки",
                                "target_lang_sense_clarification": "товары из магазина"
                            },
                            {
                                "target_lang_word": "продукты",
                                "target_lang_sense_clarification": "еда, купленная в лавке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fabbdc4e-f1d1-3969-9cbf-c048015de074",
                    "sense_definition": "To send a message to someone, especially electronically (for example, by text or chat).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "send a message electronically",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>message</w> me when you arrive at the station.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>напиши</w> мне, когда приедешь на вокзал."
                            }
                        },
                        {
                            "text": "I <w>messaged</w> my cousin the address, and he found the place easily.",
                            "target_lang_translations": {
                                "ru": "Я <w>отправил</w> кузену адрес сообщением, и он легко нашёл это место."
                            }
                        }
                    ],
                    "synonyms": [
                        "text"
                    ],
                    "common_phrases": [
                        "message someone",
                        "message back",
                        "message for details"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправить кому-либо сообщение, особенно в электронном виде (например, текстом или в чате)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "написать",
                                "target_lang_sense_clarification": "отправить текстовое сообщение"
                            },
                            {
                                "target_lang_word": "сообщить",
                                "target_lang_sense_clarification": "передать информацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1211b5ea-5c1f-3154-87f2-a3835b8a1fcc",
                    "sense_definition": "To send something (information, a file, or words) as a message, usually by an electronic system.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "send content as a message",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>messaged</w> the details to the whole team after the call.",
                            "target_lang_translations": {
                                "ru": "После звонка она <w>разослала</w> детали всей команде."
                            }
                        },
                        {
                            "text": "Please <w>message</w> the file link to me so I can download it.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>скинь</w> мне ссылку на файл, чтобы я мог его скачать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "message the details",
                        "message the link",
                        "message the report"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправить что-либо (информацию, файл или слова) в виде сообщения через электронную систему."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скинуть",
                                "target_lang_sense_clarification": "разговорное: отправить файл или ссылку"
                            },
                            {
                                "target_lang_word": "переслать",
                                "target_lang_sense_clarification": "отправить полученные данные дальше"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc2d9224-c0f0-325a-99c1-d6ab9a90c3bb",
                    "sense_definition": "To send messages; to exchange messages; to have the ability to send messages.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "send messages in general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The app can <w>message</w> even when the phone has a weak signal.",
                            "target_lang_translations": {
                                "ru": "Приложение может <w>отправлять сообщения</w> даже при слабом сигнале телефона."
                            }
                        },
                        {
                            "text": "His old tablet still <w>messages</w>, but it is very slow.",
                            "target_lang_translations": {
                                "ru": "Его старый планшет всё ещё позволяет <w>переписываться</w>, но работает очень медленно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "message online",
                        "message with friends"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправлять сообщения; обмениваться сообщениями; иметь техническую возможность отправки сообщений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переписываться",
                                "target_lang_sense_clarification": "обмениваться сообщениями"
                            },
                            {
                                "target_lang_word": "отправлять сообщения",
                                "target_lang_sense_clarification": "выполнять функцию рассылки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cff74f92-c59d-34ff-981d-b227e08a757f",
                    "sense_definition": "To convey or bear something as a message.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "convey as a message",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet <w>messaged</w> hope to readers living through hard times.",
                            "target_lang_translations": {
                                "ru": "Поэт <w>нес</w> надежду читателям, переживающим трудные времена."
                            }
                        },
                        {
                            "text": "With simple words, the song <w>messages</w> peace to the world.",
                            "target_lang_translations": {
                                "ru": "Простыми словами эта песня <w>проповедует</w> мир во всём мире."
                            }
                        }
                    ],
                    "common_phrases": [
                        "message hope",
                        "message peace"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Literary or older use."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать или нести что-либо в качестве послания (устаревшее или литературное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нести",
                                "target_lang_sense_clarification": "передавать идею или чувство"
                            },
                            {
                                "target_lang_word": "вещать",
                                "target_lang_sense_clarification": "торжественно провозглашать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}