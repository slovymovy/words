                        "sense_id": "c7010257-2836-3489-9537-78a2b9ac9199",
                        "entry_id": "92d37a43-b619-3fa6-9b6c-9954deb4131f",
                        "glosses": [
                            "Celui qui est chanceux."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5e1f5732-89ca-48bb-a24c-de37fffb07c7",
                                "sense_id": "c7010257-2836-3489-9537-78a2b9ac9199",
                                "text": "C’est un vrai chançard !"
                            },
                            {
                                "example_id": "881c96de-8198-47a1-bd0f-eae95fe99e5a",
                                "sense_id": "c7010257-2836-3489-9537-78a2b9ac9199",
                                "text": "On ne me fuyait pas, on me traitait comme un camarade moins chançard qu’un autre et meilleur que beaucoup, puisque jamais je ne répondais : « ça n’est pas moi. »"
                            }
                        ]
                    }
