                        "examples": [
                            {
                                "example_id": "ecd76337-5fca-4f5e-95e2-9f0ef2fe552a",
                                "sense_id": "27fa9416-0032-35ce-9605-38bbf94b617f",
                                "text": "Le plasmalemme joue le rôle de barrière physique, intervenant dans la communication cellulaire et ayant un rôle dans la croissance de la cellule."
                            },
                            {
                                "example_id": "669b66f4-a26a-4998-a991-c2672e4b9c8d",
                                "sense_id": "27fa9416-0032-35ce-9605-38bbf94b617f",
                                "text": "Ces vésicules contiennent des précurseurs de parois et lorsque leur membrane s’anastomose avec le plasmalemme, elles déversent leur contenu à l’extérieur du cytoplasme."
                            }
                        ]
                    }
