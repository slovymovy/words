            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47cc8827-1121-3ae9-82c2-00814d49bae7",
                    "sense_definition": "Een spraakklank waarbij de luchtstroom bij het uitspreken wordt onderbroken of vernauwd.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "taalkunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De letter b is een voorbeeld van een <w>medeklinker</w> die met de lippen wordt gevormd.",
                            "target_lang_translations": {
                                "en": "The letter b is an example of a <w>consonant</w> that is formed with the lips.",
                                "ru": "Буква b — это пример <w>согласного звука</w>, который образуется губами."
                            }
                        },
                        {
                            "text": "In het Nederlands spreken we een <w>medeklinker</w> aan het einde van een woord vaak hard uit.",
                            "target_lang_translations": {
                                "en": "In Dutch, we often pronounce a <w>consonant</w> at the end of a word forcefully.",
                                "ru": "В нидерландском языке мы часто произносим <w>согласный</w> в конце слова глухо."
                            }
                        }
                    ],
                    "synonyms": [
                        "consonant"
                    ],
                    "antonyms": [
                        "klinker"
                    ],
                    "common_phrases": [
                        "stemloze medeklinker",
                        "stemhebbende medeklinker"
                    ],
                    "target_lang_definitions": {
                        "en": "A speech sound produced by a partial or complete obstruction of the airflow.",
                        "ru": "Звук речи, при произнесении которого поток воздуха прерывается или сужается."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consonant",
                                "target_lang_sense_clarification": "a speech sound"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "согласный звук",
                                "target_lang_sense_clarification": "фонетическая единица"
                            },
                            {
                                "target_lang_word": "согласный",
                                "target_lang_sense_clarification": "краткая форма термина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1506bd48-366e-369c-b521-c03d37834d26",
                    "sense_definition": "Een letter in het alfabet die een medeklinkerklank representeert.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "taalkunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het Nederlandse alfabet heeft meer letters voor een <w>medeklinker</w> dan voor een klinker.",
                            "target_lang_translations": {
                                "en": "The Dutch alphabet has more letters for a <w>consonant</w> than for a vowel.",
                                "ru": "В нидерландском алфавите больше букв для <w>согласных</w>, чем для гласных."
                            }
                        },
                        {
                            "text": "In dit woord staat elke <w>medeklinker</w> tussen twee verschillende klinkers.",
                            "target_lang_translations": {
                                "en": "In this word, every <w>consonant</w> is placed between two different vowels.",
                                "ru": "В этом слове каждая <w>согласная буква</w> стоит между двумя разными гласными."
                            }
                        }
                    ],
                    "synonyms": [
                        "medeklinkerletter"
                    ],
                    "antonyms": [
                        "klinker"
                    ],
                    "common_phrases": [
                        "dubbele medeklinker"
                    ],
                    "target_lang_definitions": {
                        "en": "A letter of the alphabet that represents a consonant sound.",
                        "ru": "Буква алфавита, представляющая согласный звук."
                    },
                    "translations": {
                        "en": [
                            {
