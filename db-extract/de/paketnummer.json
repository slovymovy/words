                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf6e88d8-862a-4e4a-82f3-d88ae92862fb",
                                "sense_id": "82994a75-2442-30a6-8ba3-9ba6ea6ab962",
                                "text": "„Er blickte kurz von seinem Notizblock auf und vermerkte Alice Wyndham, Paketnummer 326 auf einer leeren Seite.“"
                            },
                            {
                                "example_id": "0257e48f-1b24-4e76-a5fa-5354762d5aa5",
                                "sense_id": "82994a75-2442-30a6-8ba3-9ba6ea6ab962",
                                "text": "„Betrübt trat er durch die Drehtür auf die Straße und steckte den Zettel mit der Paketnummer wieder in die Tasche.“"
                            },
                            {
                                "example_id": "7059aef9-2dec-4891-9126-2af0db23ef34",
                                "sense_id": "82994a75-2442-30a6-8ba3-9ba6ea6ab962",
                                "text": "„Bestimmt haben sie anhand der Paketnummer gesehen, wo die Lieferung gelandet ist.“"
                            },
                            {
                                "example_id": "7546934c-7beb-4564-841e-2e8ad21c43b8",
                                "sense_id": "82994a75-2442-30a6-8ba3-9ba6ea6ab962",
                                "text": "„Der Auftraggeber gibt die Paketnummer ein und erhält dann über das Internet einen Statusbericht.“"
                            },
                            {
                                "example_id": "6545ceba-760b-4f25-ac9a-837a98f97f37",
                                "sense_id": "82994a75-2442-30a6-8ba3-9ba6ea6ab962",
                                "text": "„Der neue Barcode verbindet Paketnummer und Routing miteinander und ersetzt die beiden getrennten Barcodes durch einen einheitlichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
