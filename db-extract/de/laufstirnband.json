                "senses": [
                    {
                        "sense_id": "41b9b922-24b8-37bb-a83b-2cd1c7721ebd",
                        "entry_id": "72dd12a1-0bee-3034-8b82-7294644d1ff5",
                        "glosses": [
                            "Stirnband, das speziell für das Laufen bestimmt ist"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "76835e25-ab09-431a-849b-fa40702de0a8",
                                "sense_id": "41b9b922-24b8-37bb-a83b-2cd1c7721ebd",
                                "text": "„Ein Laufstirnband ist Dein treuer Begleiter beim Joggen.“"
                            },
                            {
                                "example_id": "b09f5a6d-d063-4d86-9fe2-a271f4232231",
                                "sense_id": "41b9b922-24b8-37bb-a83b-2cd1c7721ebd",
                                "text": "„Dieses klassische schwarze Laufstirnband vereint sorgfältig durchdachte Details mit einem luftig, leichten Design, damit Du in allen Situationen einen kühlen und klaren Kopf bewahrst.“"
                            },
                            {
                                "example_id": "3d588b47-48be-4c17-abfa-925d959985cc",
                                "sense_id": "41b9b922-24b8-37bb-a83b-2cd1c7721ebd",
                                "text": "„Das Thin Headband On/Off ist ein elegantes, schmales Laufstirnband und bietet optimale Belüftung.“"
                            },
                            {
                                "example_id": "ed3197f7-3c6d-49c1-898f-12f327c411fd",
                                "sense_id": "41b9b922-24b8-37bb-a83b-2cd1c7721ebd",
                                "text": "„Unter anderem winkt ein Urlaub in den Kinderhotels, einen Jahresvorrat von Gasteiner Mineralwasser, sowie Buff Laufstirnbänder für die gesamte Klasse.“"
                            },
                            {
                                "example_id": "980ed63c-6397-4f3c-a534-3328dff4d449",
                                "sense_id": "41b9b922-24b8-37bb-a83b-2cd1c7721ebd",
                                "text": "„Dieses Laufstirnband vereint sorgfältig durchdachte Details mit einem luftig, leichten Design, damit Du in allen Situationen einen kühlen und klaren Kopf bewahrst.“"
                            }
                        ],
