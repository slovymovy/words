                                            {
                                                "example_id": "811ffcec-6886-41b4-b6cc-f992d788d4b7",
                                                "sense_id": "276c877b-0c40-3fd8-afd4-21f0941ade47",
                                                "text": "„Ich beabsichtige hier keine Abhandlung über die Gründe zu schreiben, warum Menschen ihre vierbeinigen Freunde verlassen, aber dürfte ich mich erdreisten zu fragen, woher Momo wissen will, was das Beste für mich ist?“"
                                            },
                                            {
                                                "example_id": "389e7a17-74e2-4f58-b135-408a1ab0a427",
                                                "sense_id": "276c877b-0c40-3fd8-afd4-21f0941ade47",
                                                "text": "„Sie war alt und gebrechlich und hielt sich an einer vierbeinigen Gehhilfe fest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
