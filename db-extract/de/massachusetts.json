                                    {
                                        "sense_id": "83761f01-52a9-3a38-8be1-ece6896d4ac2",
                                        "entry_id": "dcb88542-4844-3e93-a09e-6b1ff0f42ca8",
                                        "glosses": [
                                            "A state of the United States. Capital and largest city: Boston."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da452b3a-df83-4703-82fd-1d3d7f4763ad",
                                                "sense_id": "83761f01-52a9-3a38-8be1-ece6896d4ac2",
                                                "text": "So last summer, when the Massachusetts State Legislature became one of the first in the nation to consider a bill to add an “X” option for nonbinary genders to the “M” and “F” on the state driver’s license, El, 17, was less surprised than some at the maneuver that effectively killed it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5584dbb5-ee56-42d1-9579-8c96f7e90659",
                        "source_entry_id": "89ce213b-6e27-36e0-a419-eb501545412a",
                        "source_sense_id": "50425eb6-4a0b-3b4b-a076-5c0ddfb97412",
                        "source_sense_description": "Bundesstaat an der Ostküste der USA",
                        "target_lang_word": "Massachusetts",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Massachusetts",
