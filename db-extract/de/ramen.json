                ],
                "senses": [
                    {
                        "sense_id": "3d75a249-81fd-3d39-9a24-0040b52e577e",
                        "entry_id": "f88e8d8b-35a9-3fa7-a46c-f7f6caece933",
                        "glosses": [
                            "eine eigene Art von japanischen Nudeln"
                        ],
                        "tags": [
                            "Japan"
                        ],
                        "examples": [
                            {
                                "example_id": "df1c1a0d-d6f8-4a31-ad7e-745dc6e70378",
                                "sense_id": "3d75a249-81fd-3d39-9a24-0040b52e577e",
                                "text": "Ramen sind Nudeln mit einer dickeren Textur, die in Asien für herzhaftere Gerichte verwendet werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "167203fa-a9a3-3e73-9961-ad4bdc868b11",
                        "entry_id": "f88e8d8b-35a9-3fa7-a46c-f7f6caece933",
                        "glosses": [
                            "die aus [1] hergestellte Nudelsuppe"
                        ],
                        "tags": [
                            "Japan"
                        ],
                        "examples": [
                            {
                                "example_id": "cea33cd5-cf50-49c7-95bb-92a556b80cd8",
                                "sense_id": "167203fa-a9a3-3e73-9961-ad4bdc868b11",
                                "text": "Ramen ist eine Nudelsuppe aus schmackhafter Brühe, besonderen Nudeln und unterschiedlichen Toppings."
                            },
                            {
                                "example_id": "c062a07e-6543-4c5f-b455-c216f5ba4a7f",
                                "sense_id": "167203fa-a9a3-3e73-9961-ad4bdc868b11",
                                "text": "„Es war Mittagspause und witzigerweise war bereits die halbe Mannschaft der vorher erwähnten Firma hier zum Mittagessen versammelt. Wenig überraschend, denn das Ramen hier ist super!“"
                            },
                            {
                                "example_id": "4ea41c1e-cda1-46f3-9f45-db6c43510791",
                                "sense_id": "167203fa-a9a3-3e73-9961-ad4bdc868b11",
                                "text": "„Warum eigentlich schlürfen? So verhindert man am effektivsten, dass das Ramen durch die Gegend spritzt, kühlt die Nudeln ab, verstärkt das Aroma, und bezeugt dem Koch nebenbei noch, wie köstlich sein Gericht ist – eine Eigenheit der japanischen Kultur.“"
                            },
                            {
                                "example_id": "fe55f188-79ef-4e7a-99c4-26f0b65e54e0",
                                "sense_id": "167203fa-a9a3-3e73-9961-ad4bdc868b11",
                                "text": "„Zu guter Letzt, Shrimps, Pak Choi, Shiitake-Pilze, Tofu und frische Frühlingszwiebelröllchen ansprechend auf das Ramen schichten.“"
                            },
                            {
                                "example_id": "03d9b61f-62ec-4e76-aa46-ab964dca24e5",
                                "sense_id": "167203fa-a9a3-3e73-9961-ad4bdc868b11",
                                "text": "„Zusammen mit Sake können Sie die Essenz des Ramens erleben… eine kulinarische Verwöhnung!“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "564f41e8-b17d-4f51-8ac3-eb95c7e27e2c",
                        "source_entry_id": "f88e8d8b-35a9-3fa7-a46c-f7f6caece933",
                        "source_sense_id": "3d75a249-81fd-3d39-9a24-0040b52e577e",
