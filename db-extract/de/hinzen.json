                ],
                "senses": [
                    {
                        "sense_id": "08a5edd6-40f5-3309-82f3-ae614a8d1a0b",
                        "entry_id": "7e1c115d-494e-3a51-9062-6c990d18d88a",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c5c0942-6bd2-4d62-ba69-e301c50e57ed",
                                "sense_id": "08a5edd6-40f5-3309-82f3-ae614a8d1a0b",
                                "text": "Frau Hinzen ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d4a6ddee-b398-4794-b436-eac8f2492f46",
                                "sense_id": "08a5edd6-40f5-3309-82f3-ae614a8d1a0b",
                                "text": "Herr Hinzen wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d511ba3c-7040-4880-9b00-a49cb7434895",
                                "sense_id": "08a5edd6-40f5-3309-82f3-ae614a8d1a0b",
                                "text": "Die Hinzens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3b1b5e09-3455-491f-86b5-3c59fbc23b1d",
                                "sense_id": "08a5edd6-40f5-3309-82f3-ae614a8d1a0b",
                                "text": "Der Hinzen trägt nie die Schals, die die Hinzen ihm strickt."
                            },
                            {
                                "example_id": "19433403-ed05-4f29-bc07-39b8f0fa1751",
                                "sense_id": "08a5edd6-40f5-3309-82f3-ae614a8d1a0b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hinzen kommt, geht der Herr Hinzen.“"
                            },
                            {
                                "example_id": "d4ffceb1-bf97-450e-92d2-afeedcca9a50",
                                "sense_id": "08a5edd6-40f5-3309-82f3-ae614a8d1a0b",
                                "text": "Hinzen kommt und geht."
                            },
                            {
                                "example_id": "58c322b5-f44a-491b-a5c3-2931b30cbc78",
                                "sense_id": "08a5edd6-40f5-3309-82f3-ae614a8d1a0b",
                                "text": "Hinzens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
