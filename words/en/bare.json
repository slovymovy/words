{
    "word_family": [
        "barely",
        "bareness",
        "barefaced",
        "barefoot",
        "bareheaded",
        "unbare"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "14c7e2e1-516a-3d92-8b80-2c12c2cc4dd6",
                    "sense_definition": "Not covered by clothing or any other protection; naked.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "uncovered",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children ran across the beach with <w>bare</w> feet and messy hair.",
                            "target_lang_translations": {
                                "ru": "Дети бегали по пляжу с <w>босыми</w> ногами и растрепанными волосами.",
                                "zh": "孩子们<w>赤着</w>脚，头发凌乱地跑过沙滩。"
                            }
                        },
                        {
                            "text": "He walked into the cold room with his <w>bare</w> chest exposed to the air.",
                            "target_lang_translations": {
                                "ru": "Он вошел в холодную комнату с <w>обнаженной</w> грудью.",
                                "zh": "他<w>赤着</w>上身走进寒冷的房间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "naked",
                        "nude",
                        "uncovered",
                        "undressed"
                    ],
                    "antonyms": [
                        "covered",
                        "dressed"
                    ],
                    "common_phrases": [
                        "bare feet",
                        "bare hands",
                        "bare skin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не покрытый одеждой или какой-либо другой защитой; обнаженный.",
                        "zh": "未被衣服或任何其他保护物覆盖的；赤裸的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голый",
                                "target_lang_sense_clarification": "о частях тела"
                            },
                            {
                                "target_lang_word": "обнаженный",
                                "target_lang_sense_clarification": "без одежды"
                            },
                            {
                                "target_lang_word": "босой",
                                "target_lang_sense_clarification": "о ногах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赤裸的",
                                "target_lang_sense_clarification": "指身体部位未被遮盖"
                            },
                            {
                                "target_lang_word": "光着的",
                                "target_lang_sense_clarification": "口语中指身体部位未被遮盖"
                            },
                            {
                                "target_lang_word": "赤脚的",
                                "target_lang_sense_clarification": "专指脚部未穿鞋袜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8b6af0c-523e-3f3a-b060-f28f6f4b0c5b",
                    "sense_definition": "Lacking decoration, furniture, or equipment; plain and empty.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "empty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The apartment looked very <w>bare</w> before they moved their furniture inside.",
                            "target_lang_translations": {
                                "ru": "Квартира выглядела очень <w>пустой</w>, пока они не завезли мебель.",
                                "zh": "在搬进家具之前，这间公寓看起来非常<w>空荡</w>。"
                            }
                        },
                        {
                            "text": "She stared at the <w>bare</w> walls of her new office, wondering where to hang the pictures.",
                            "target_lang_translations": {
                                "ru": "Она смотрела на <w>голые</w> стены своего нового офиса, думая, куда повесить картины.",
                                "zh": "她盯着新办公室<w>光秃秃的</w>墙壁，琢磨着把画挂在哪里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plain",
                        "unadorned",
                        "empty",
                        "austere"
                    ],
                    "antonyms": [
                        "decorated",
                        "ornate",
                        "furnished"
                    ],
                    "common_phrases": [
                        "bare walls",
                        "bare room",
                        "bare floor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный украшений, мебели или оборудования; простой и пустой.",
                        "zh": "缺乏装饰、家具或设备的；简陋且空荡的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "о комнате или помещении"
                            },
                            {
                                "target_lang_word": "голый",
                                "target_lang_sense_clarification": "о стенах или полах"
                            },
                            {
                                "target_lang_word": "необставленный",
                                "target_lang_sense_clarification": "без мебели"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空荡的",
                                "target_lang_sense_clarification": "指房间内没有家具"
                            },
                            {
                                "target_lang_word": "简陋的",
                                "target_lang_sense_clarification": "指缺乏装饰或陈设"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "924a9a21-dbf1-3bf8-8223-9a84c5de8c4b",
                    "sense_definition": "Having had the natural or usual covering removed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uncovered",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the middle of winter, the <w>bare</w> branches of the trees looked like skeletons.",
                            "target_lang_translations": {
                                "ru": "Посреди зимы <w>голые</w> ветви деревьев были похожи на скелеты.",
                                "zh": "隆冬时节，树木<w>光秃秃的</w>枝干看起来就像骷髅一样。"
                            }
                        },
                        {
                            "text": "The hillside was <w>bare</w> after the forest fire destroyed all the vegetation.",
                            "target_lang_translations": {
                                "ru": "Склон холма остался <w>голым</w> после того, как лесной пожар уничтожил всю растительность.",
                                "zh": "森林大火烧毁了所有植被后，山坡变得<w>光秃秃的</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stripped",
                        "uncovered",
                        "despoiled"
                    ],
                    "antonyms": [
                        "covered"
                    ],
                    "common_phrases": [
                        "bare branches",
                        "bare trees",
                        "bare earth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный естественного или привычного покрова.",
                        "zh": "失去了自然或通常覆盖物的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голый",
                                "target_lang_sense_clarification": "о ветвях или земле"
                            },
                            {
                                "target_lang_word": "оголенный",
                                "target_lang_sense_clarification": "лишенный растительности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "光秃的",
                                "target_lang_sense_clarification": "指树木或山坡没有植被"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfbed508-aec4-3fba-9e58-fb608d216fb1",
                    "sense_definition": "Minimal; being only just enough or sufficient.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "minimal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate won the election by a <w>bare</w> majority of only three votes.",
                            "target_lang_translations": {
                                "ru": "Кандидат победил на выборах с <w>минимальным</w> преимуществом всего в три голоса.",
                                "zh": "这位候选人以仅三票的<w>微弱</w>多数赢得了选举。"
                            }
                        },
                        {
                            "text": "They survived the winter with only the <w>bare</w> necessities of life.",
                            "target_lang_translations": {
                                "ru": "Они пережили зиму, имея лишь <w>самое необходимое</w> для жизни.",
                                "zh": "他们仅靠<w>最基本</w>的生活必需品度过了冬天。"
                            }
                        }
                    ],
                    "synonyms": [
                        "minimal",
                        "mere"
                    ],
                    "antonyms": [
                        "ample",
                        "plentiful",
                        "sufficient"
                    ],
                    "common_phrases": [
                        "bare majority",
                        "bare minimum",
                        "bare necessities"
                    ],
                    "target_lang_definitions": {
                        "ru": "Минимальный; являющийся лишь самым необходимым или достаточным.",
                        "zh": "极少的；仅够或勉强足够的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "едва достаточный",
                                "target_lang_sense_clarification": "о количестве или большинстве"
                            },
                            {
                                "target_lang_word": "минимальный",
                                "target_lang_sense_clarification": "самый необходимый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "勉强的",
                                "target_lang_sense_clarification": "指数量刚好达到门槛"
                            },
                            {
                                "target_lang_word": "最基本的",
                                "target_lang_sense_clarification": "指维持生存所需的最低限度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f215e441-48f2-3268-956c-1d2ecfe06ecc",
                    "sense_definition": "Basic and without any extra details or embellishments.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "minimal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I only have time to give you the <w>bare</w> facts of the situation right now.",
                            "target_lang_translations": {
                                "ru": "У меня есть время только на то, чтобы изложить вам <w>сухие</w> факты ситуации.",
                                "zh": "我现在只有时间告诉你这件事<w>干巴巴的</w>事实。"
                            }
                        },
                        {
                            "text": "The report provided the <w>bare</w> essentials without explaining the background.",
                            "target_lang_translations": {
                                "ru": "В отчете были представлены только <w>основные сведения</w> без объяснения предыстории.",
                                "zh": "这份报告只提供了最<w>基本的</w>内容，没有解释背景。"
                            }
                        }
                    ],
                    "synonyms": [
                        "simple",
                        "unembellished",
                        "basic"
                    ],
                    "antonyms": [
                        "ornate"
                    ],
                    "common_phrases": [
                        "bare essentials",
                        "bare facts",
                        "bare truth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Базовый, без каких-либо дополнительных деталей или прикрас.",
                        "zh": "基础的，没有任何额外细节或修饰的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сухой",
                                "target_lang_sense_clarification": "о фактах"
                            },
                            {
                                "target_lang_word": "самый необходимый",
                                "target_lang_sense_clarification": "об основах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "干巴巴的",
                                "target_lang_sense_clarification": "指事实缺乏修饰"
                            },
                            {
                                "target_lang_word": "基本的",
                                "target_lang_sense_clarification": "指核心要素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d00626e4-1754-3dcb-a040-3a275fe5fb2e",
                    "sense_definition": "Completely empty of supplies or contents.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "empty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cupboard was <w>bare</w>, so we had to go to the grocery store immediately.",
                            "target_lang_translations": {
                                "ru": "Шкаф был <w>пуст</w>, поэтому нам пришлось немедленно идти в магазин.",
                                "zh": "橱柜里<w>空空的</w>，所以我们不得不立刻去杂货店。"
                            }
                        },
                        {
                            "text": "After the storm, the supermarket shelves were stripped <w>bare</w> by worried customers.",
                            "target_lang_translations": {
                                "ru": "После шторма полки супермаркетов были <w>опустошены</w> обеспокоенными покупателями.",
                                "zh": "暴风雨过后，超市货架被焦虑的顾客<w>抢购一空</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "empty",
                        "unstocked",
                        "unsupplied"
                    ],
                    "antonyms": [
                        "full",
                        "stocked",
                        "well-stocked"
                    ],
                    "common_phrases": [
                        "stripped bare",
                        "cupboard was bare"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершенно пустой, без запасов или содержимого.",
                        "zh": "完全没有供应品或内容的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "о полках или шкафах"
                            },
                            {
                                "target_lang_word": "опустошенный",
                                "target_lang_sense_clarification": "полностью очищенный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空空的",
                                "target_lang_sense_clarification": "指容器或货架内无物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37d4f8d3-3f56-38df-8490-a085cc522f78",
                    "sense_definition": "A large amount or many of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have <w>bare</w> work to finish before I can go out tonight.",
                            "target_lang_translations": {
                                "ru": "Мне нужно закончить <w>кучу</w> работы, прежде чем я смогу куда-то пойти вечером.",
                                "zh": "今晚出门前，我还有<w>一大堆</w>工作要完成。"
                            }
                        },
                        {
                            "text": "He has <w>bare</w> money in his pocket after winning the lottery.",
                            "target_lang_translations": {
                                "ru": "У него в кармане <w>полно</w> денег после выигрыша в лотерею.",
                                "zh": "中了彩票后，他口袋里有<w>一大把</w>钱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lots of",
                        "plenty of"
                    ],
                    "common_phrases": [
                        "bare money",
                        "bare time"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Multicultural London English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество или много чего-либо (сленг).",
                        "zh": "大量的（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куча",
                                "target_lang_sense_clarification": "много чего-либо"
                            },
                            {
                                "target_lang_word": "полно",
                                "target_lang_sense_clarification": "в избытке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一大堆",
                                "target_lang_sense_clarification": "指数量很多"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "982187b0-a2fd-3fb8-a14c-d253b1ab1627",
                    "sense_definition": "Very worn out or thin from use.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "worn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old carpet had become <w>bare</w> in the areas where people walked the most.",
                            "target_lang_translations": {
                                "ru": "Старый ковер <w>протерся</w> в тех местах, где люди ходили больше всего.",
                                "zh": "旧地毯在人们走动最多的地方已经<w>磨损</w>了。"
                            }
                        },
                        {
                            "text": "He wore a <w>bare</w> coat that had seen many years of hard service.",
                            "target_lang_translations": {
                                "ru": "На нем было <w>поношенное</w> пальто, прослужившее много лет.",
                                "zh": "他穿着一件<w>磨损的</w>外套，这件衣服已经穿了很多年了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "threadbare",
                        "shabby",
                        "worn-out"
                    ],
                    "common_phrases": [
                        "bare patches"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень изношенный или истончившийся от использования.",
                        "zh": "因使用而磨损或变薄的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протертый",
                                "target_lang_sense_clarification": "о ковре или ткани"
                            },
                            {
                                "target_lang_word": "поношенный",
                                "target_lang_sense_clarification": "об одежде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磨损的",
                                "target_lang_sense_clarification": "指地毯或衣物因长期使用而变薄"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95ef5e8d-542c-35df-a170-46ffcf286c62",
                    "sense_definition": "Operating without insurance coverage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medical practice decided to go <w>bare</w> because the insurance premiums were too high.",
                            "target_lang_translations": {
                                "ru": "Медицинская практика решила работать <w>без страховки</w>, так как страховые взносы были слишком высоки.",
                                "zh": "由于保险费太高，这家诊所决定<w>不投保</w>。"
                            }
                        },
                        {
                            "text": "Going <w>bare</w> is a significant financial risk for any small business owner.",
                            "target_lang_translations": {
                                "ru": "Работа <w>без страховки</w> — это значительный финансовый риск для любого владельца малого бизнеса.",
                                "zh": "对于任何小企业主来说，<w>不投保</w>都是巨大的财务风险。"
                            }
                        }
                    ],
                    "synonyms": [
                        "uninsured",
                        "noninsured"
                    ],
                    "common_phrases": [
                        "go bare"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Работающий без страхового покрытия.",
                        "zh": "在没有保险覆盖的情况下运营的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "без страховки",
                                "target_lang_sense_clarification": "о бизнесе или практике"
                            },
                            {
                                "target_lang_word": "незастрахованный",
                                "target_lang_sense_clarification": "не имеющий полиса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无保险的",
                                "target_lang_sense_clarification": "指未购买保险"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9534d0f-55af-3a6a-8485-d530f64c1103",
                    "sense_definition": "To remove the covering from something so that it can be seen.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "reveal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog began <w>baring</w> its teeth and growling at the stranger.",
                            "target_lang_translations": {
                                "ru": "Собака начала <w>оскаливать</w> зубы и рычать на незнакомца.",
                                "zh": "那条狗开始向陌生人<w>露出</w>牙齿并发出低吼。"
                            }
                        },
                        {
                            "text": "The investigation helped to <w>bare</w> the truth about the corruption scandal.",
                            "target_lang_translations": {
                                "ru": "Расследование помогло <w>раскрыть</w> правду о коррупционном скандале.",
                                "zh": "调查有助于<w>揭露</w>腐败丑闻的真相。"
                            }
                        }
                    ],
                    "synonyms": [
                        "uncover",
                        "reveal",
                        "expose",
                        "show"
                    ],
                    "antonyms": [
                        "cover",
                        "hide",
                        "concealed"
                    ],
                    "common_phrases": [
                        "bare your teeth",
                        "bare your soul",
                        "lay bare"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снять покров с чего-либо, чтобы это стало видимым.",
                        "zh": "除去某物的覆盖物使其可见。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обнажить",
