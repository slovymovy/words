                                        "entry_id": "6c3518be-b5fb-3b25-a379-baa87312cdcd",
                                        "glosses": [
                                            "A person who advocates populism (a movement against ruling elites who are presumed not to act in the interests of the ordinary citizen)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c0da469-667a-443d-abcd-5bd22e3ab4a8",
                                                "sense_id": "f5e5b4f3-25ca-3144-9e57-8e60bfdb3364",
                                                "text": "Critics suggest that Fernández, an unashamed populist and nationalist, is seeking to deflect attention from social disharmony at home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2632fd15-f135-3e9d-b2e2-990e0c618f8b",
                                        "entry_id": "6c3518be-b5fb-3b25-a379-baa87312cdcd",
                                        "glosses": [
                                            "A politician who advocates specific policies just because they are popular."
