                        "examples": [
                            {
                                "example_id": "a5526cc8-d4ec-402e-8dcd-3120976f4622",
                                "sense_id": "0faa75dc-55ad-3237-b319-23186500a13b",
                                "text": "Uit het onderzoek blijkt dat de belastingparadijzen geen of lage tarieven voor vennootschapsbelasting hebben, oneerlijke fiscale prikkels geven aan bedrijven en niet meewerken aan internationale maatregelen tegen belastingontwijking."
                            },
                            {
                                "example_id": "0d707c1d-08ab-4bad-bb5f-374bfbd10901",
                                "sense_id": "0faa75dc-55ad-3237-b319-23186500a13b",
                                "text": "Maar haar vader bijvoorbeeld? Hij had zijn hele leven op de rechtse Hôgerpartiet gestemd, en niet alleen omdat hij voor een verlaging van de successierechten en de vennootschapsbelasting was."
                            }
                        ]
                    }
