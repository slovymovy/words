                    {
                        "translation_id": "e6e44b74-266e-40af-9f79-3e0efd51d127",
                        "source_entry_id": "bfdbc01e-789b-3c4d-94a2-23a07d7f99ff",
                        "source_sense_description": "financial transaction",
                        "target_lang_word": "affacturage",
                        "target_lang_code": "fr",
