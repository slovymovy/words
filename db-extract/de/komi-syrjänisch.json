                ],
                "senses": [
                    {
                        "sense_id": "020e350c-38db-3d3b-9f31-a0ddf72e792a",
                        "entry_id": "ca928ea4-a0e0-3a46-b1dd-2882b4fbaa0a",
                        "glosses": [
                            "eine Sprache, die in Nordwestrussland gesprochen wird; wird teilweise gemeinsam mit dem Komi-Permjakischen als Varietät des Komi betrachtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a955ce84-83ac-48f6-ba77-7988b6a68d47",
                                "sense_id": "020e350c-38db-3d3b-9f31-a0ddf72e792a",
                                "text": "„Auffallend ist, daß, im Vergleich mit dem Komi-Syrjänischen, die koordinierten Zusammenrückungen in dem viel weiter russifizierten Komi-Permjakischen seltener sind.“"
                            },
                            {
                                "example_id": "037b046e-5741-4fb6-91d1-b253d5b525dc",
                                "sense_id": "020e350c-38db-3d3b-9f31-a0ddf72e792a",
                                "text": "„Dies steht in systematischem Gegensatz zum Vorgehen bei den permischen Sprachen, unter welchen Komi-Syrjänisch und Komi-Permjakisch stets getrennt aufgeführt sind.“"
                            },
                            {
                                "example_id": "3041a001-ac8b-4811-9746-a40eb48248ef",
                                "sense_id": "020e350c-38db-3d3b-9f31-a0ddf72e792a",
                                "text": "„Bis in die jüngste Zeit hinein ließen sich beim Komi drei große Dialektgruppen unterscheiden, nämlich das Komi-Syrjänische“, das Komi-Permjakische und das Jazvinische (oder Ostpermjakische, jetzt wohl im Aussterben begriffen)."
                            },
                            {
                                "example_id": "9ab267b4-e423-4e6d-8cae-8d090123c070",
                                "sense_id": "020e350c-38db-3d3b-9f31-a0ddf72e792a",
                                "text": "„Die kyrillische Schrift wurde für Sprachen verwendet, deren Sprachgemeinschaften zum russisch-orthodoxen Glauben bekehrt worden waren […]. Dies galt ebenfalls für das Komi-Syrjänische, das schon seit Ende des 14. Jahrhunderts in einer Lokalschrift, dem Abur-Alphabet, geschrieben worden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
