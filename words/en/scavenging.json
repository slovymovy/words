                    "sense_id": "8adf5b04-1019-311a-babf-72260f92203f",
                    "sense_definition": "present participle and gerund of <w>scavenge</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scavenge_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stray dog was <w>scavenging</w> for scraps behind the local restaurant.",
                            "target_lang_translations": {
                                "ru": "Бродячая собака <w>искала объедки</w> за местным рестораном."
                            }
                        },
                        {
                            "text": "They survived by <w>scavenging</w> useful discarded materials from the city dump.",
                            "target_lang_translations": {
                                "ru": "Они выживали, <w>собирая</w> полезные выброшенные материалы на городской свалке."
                            }
                        }
                    ],
                    "synonyms": [
                        "foraging",
                        "rummaging"
                    ],
                    "common_phrases": [
                        "scavenging for food"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола scavenge (рыться в отходах, искать съестное или полезные вещи среди мусора, питаться падалью)."
                    },
                    "translations": {
                        "ru": [
                            {
