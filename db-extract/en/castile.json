                                    {
                                        "sense_id": "a03f54dd-4ff0-39a6-a70b-d985c784cbfc",
                                        "entry_id": "550b57b3-fa08-335d-b93f-77b599e1c61d",
                                        "glosses": [
                                            "landstreek in Spanje en met Aragon historisch een van de beide koninkrijken waaruit Spanje opgebouwd is. Aan het eind van de 15e eeuw waren er drie koninkrijken op het Iberisch Schiereiland: Portugal, Castilië en Aragon"
                                        ],
