                        "examples": [
                            {
                                "example_id": "78b418e6-a4c8-403a-bb4b-b04d618664f3",
                                "sense_id": "cad6e341-abd0-3372-85a1-9fafd33477ea",
                                "text": "À cet excès de nature, les miséreux à leur habitude payèrent le prix fort : les cherche-pain saisis par la mort blanche au creux d’un fossé ou dans un baraquement de fortune, les vieillards isolés et les enfants chétifs, les chiens errants et les mésanges."
                            },
                            {
                                "example_id": "8ff0a947-37fe-434d-9611-9eec0dcac1fc",
                                "sense_id": "cad6e341-abd0-3372-85a1-9fafd33477ea",
                                "text": "Quand, dans un hiver de granges vides, passent les cherche-pain, si la Mathilde donne quelques châtaignes, une poignée de noix, elle espère vaguement que son geste sera vu du ciel."
                            }
                        ]
                    }
