                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b7b1167-894b-4479-b839-095a720c0404",
                                                "sense_id": "9899b238-3b21-36ed-8460-6551cf08e925",
                                                "text": "Louis XVI, […], fit son entrée, […], revêtu du grand manteau royal et portant un chapeau à plumes, dont la ganse étincelait de diamants."
                                            },
                                            {
                                                "example_id": "d5bce1f4-fa5f-4322-a3b0-28b6f515f2de",
                                                "sense_id": "9899b238-3b21-36ed-8460-6551cf08e925",
                                                "text": "En outre, tous les cafés, tous les mastroquets étincelaient de lumière, ce qui est rare dans ce quartier éloigné de Paris, surtout à une heure si tardive."
                                            },
                                            {
                                                "example_id": "3c9ed203-6200-45e3-b442-90ab2ca1a776",
                                                "sense_id": "9899b238-3b21-36ed-8460-6551cf08e925",
                                                "text": "[…]: sur toute l’Ardenne, le temps s’était levé. Le ciel était bleu éblouissant, la neige étincelait au soleil."
                                            },
                                            {
                                                "example_id": "dfa43eb5-e71b-4027-9a38-46c0d68d910c",
                                                "sense_id": "9899b238-3b21-36ed-8460-6551cf08e925",
                                                "text": "— Ses yeux étincelaient de fureur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11322f10-aa6a-3cfb-9bb3-49fbd4136ff5",
                                        "entry_id": "5641081d-2047-3d5a-a7e9-c8470b357975",
                                        "glosses": [
