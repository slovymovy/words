                ],
                "senses": [
                    {
                        "sense_id": "f1b53898-0aff-3b2e-99d6-fd7976f94796",
                        "entry_id": "1b6ba9af-ccd5-3623-aefe-a786bb2f291a",
                        "glosses": [
                            "wie eine Kiste (massives Behältnis) aussehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "961e75ae-7bcf-4aa9-8034-7f12823e81cb",
                                "sense_id": "f1b53898-0aff-3b2e-99d6-fd7976f94796",
                                "text": "Eine Cajón ist ein kistenartiges Perkussionsinstrument, das ursprünglich aus Peru stammt."
                            },
                            {
                                "example_id": "63026717-a6cd-455c-befb-3e403d77a44e",
                                "sense_id": "f1b53898-0aff-3b2e-99d6-fd7976f94796",
                                "text": "„Es sind schlichte, kistenartige Aufbewahrungsschränke aus Zedernholz.“"
                            },
                            {
                                "example_id": "12f83b8b-7342-4d0d-9c3c-74f0df0fb43c",
                                "sense_id": "f1b53898-0aff-3b2e-99d6-fd7976f94796",
                                "text": "„Durch seine kistenartige Kompaktheit grenzt es sich scharf von der Nachbarbebauung ab.“"
                            },
                            {
                                "example_id": "7c96b2e0-09e9-4a61-ad4d-140390b1fa61",
                                "sense_id": "f1b53898-0aff-3b2e-99d6-fd7976f94796",
                                "text": "„Die kistenartigen Einzelteile vereinen sich senkrecht aufeinandergestellt zu einer Wand, nebeneinandergestellt hingegen zu einem Tresen oder Präsentationsmöbel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
