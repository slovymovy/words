                                        "sense_id": "f93aa5ba-41f2-3b39-be39-8fe84be2907d",
                                        "entry_id": "1babc527-6283-35fd-b0af-90bea24b68e4",
                                        "glosses": [
                                            "A male given name from Latin."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "989018de-69af-442e-988a-02df69d66b75",
                                                "sense_id": "f93aa5ba-41f2-3b39-be39-8fe84be2907d",
                                                "text": "Starry starry night.\nFlaming flowers that brightly blaze\nSwirling clouds in violet haze\nReflect in Vincent's eyes of china blue."
                                            },
                                            {
                                                "example_id": "a139e830-3e1d-44e1-a1be-88cebd96583f",
                                                "sense_id": "f93aa5ba-41f2-3b39-be39-8fe84be2907d",
                                                "text": "Even their names hinted at a childishness they would never grow out of. When Vincent himself was grown-up, he wondered if this was why they had given their unlooked-for son such a mature name - although later still Vincent suspected that he might have been named for the Vincent Rapide motorbike. As with most things to do with Billy and Georgie, it was too late to ask."
                                            }
                                        ]
                                    },
