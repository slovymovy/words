                ],
                "senses": [
                    {
                        "sense_id": "c035c0f7-ce4f-315a-a7ea-a32d25a1d7a7",
                        "entry_id": "ce13d855-1233-3b6c-89fa-c0d7a5fa34d6",
                        "glosses": [
                            "пропитывать (пропитать) тело умершего специальными веществами с целью предотвращения его гниения, разложения и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78cc043d-1c00-48be-bced-65df238dff2a",
                                "sense_id": "c035c0f7-ce4f-315a-a7ea-a32d25a1d7a7",
                                "text": "Этот чумазый докторишка отказался бальзамировать тело прокурора, говорит, что нечем."
                            },
                            {
                                "example_id": "50a503df-c2bc-431b-8974-d1fa0dc0609b",
                                "sense_id": "c035c0f7-ce4f-315a-a7ea-a32d25a1d7a7",
                                "text": "Грубер всех царственных покойников бальзамировал, за что и получал соответствующий гонорар, кажется 5000 р."
                            },
                            {
                                "example_id": "d3a729e6-111c-459d-9f27-9d99529ea6d3",
                                "sense_id": "c035c0f7-ce4f-315a-a7ea-a32d25a1d7a7",
                                "text": "Тело молодого человека бальзамировали, а сердце, закупоренное в серебрянном ковчеге, несчастная виновница сыновней смерти повезла с собою в карете в Москву."
                            },
                            {
                                "example_id": "73e67315-a58e-4a30-a803-6680690e9d5b",
                                "sense_id": "c035c0f7-ce4f-315a-a7ea-a32d25a1d7a7",
                                "text": "Труп государя вскрыли и бальзамировали. Сняли с него гипсовую маску."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2b8456b-5ab4-44fd-9ba6-e4ac4cb7502c",
                        "source_entry_id": "ce13d855-1233-3b6c-89fa-c0d7a5fa34d6",
                        "source_sense_id": "c035c0f7-ce4f-315a-a7ea-a32d25a1d7a7",
                        "target_lang_word": "embalm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embalm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e94a8c4-f4a4-39f3-b964-22f7d63dc3b0",
                                        "entry_id": "934a16fa-9796-3802-8b8d-59a5d198c181",
                                        "glosses": [
                                            "To treat a corpse with preservatives in order to prevent decomposition."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efe1aecd-5175-40ed-9843-cf86dd44bf1d",
                                                "sense_id": "5e94a8c4-f4a4-39f3-b964-22f7d63dc3b0",
                                                "text": "And Joseph commanded his servants the physicians to embalm his father."
                                            },
                                            {
                                                "example_id": "8785d8e4-a1c9-45f8-a97f-9d6ac0efe6fd",
                                                "sense_id": "5e94a8c4-f4a4-39f3-b964-22f7d63dc3b0",
                                                "text": "`Yea. The people of Kôr ever embalmed their dead, as did the Egyptians, but their art was greater than the art of the Egyptians, for, whereas the Egyptians disembowelled and drew the brain, the people of Kôr injected fluid into the veins, and thus reached every part.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f40bb61-fc9f-32c8-96a5-4dd61d97786a",
                                        "entry_id": "934a16fa-9796-3802-8b8d-59a5d198c181",
                                        "glosses": [
                                            "To preserve."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47d46901-2060-4dbb-a04a-7dc465c8c134",
                                                "sense_id": "5f40bb61-fc9f-32c8-96a5-4dd61d97786a",
                                                "text": "It is very curious to observe how the idea of revenge, inspired by an Egyptian who lived before the time of Christ, is thus, as it were, embalmed in an English family name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cde6e37d-fc9d-3b5e-8de9-f0aa68f28b58",
                                        "entry_id": "934a16fa-9796-3802-8b8d-59a5d198c181",
                                        "glosses": [
                                            "To perfume or add fragrance to something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
