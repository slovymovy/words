                "senses": [
                    {
                        "sense_id": "5390f146-f761-32b2-bdee-e758107680ea",
                        "entry_id": "92b2771b-42b8-3a25-8c62-be25cc4ae248",
                        "glosses": [
                            "związek organiczny będący pochodną glicyny, występuje m.in. w burakach cukrowych, szpinaku czy pszenicy i stanowi produkt uboczny przemysłu cukrowniczego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76c5deb2-35f3-4ac3-8b6a-94d7e918a6a2",
                                "sense_id": "5390f146-f761-32b2-bdee-e758107680ea",
                                "text": "W hodowli zwierząt betaina jest stosowana jako dodatek do paszy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "104c4635-cb71-3a26-87a5-0b0c3a5bd3c3",
                        "entry_id": "92b2771b-42b8-3a25-8c62-be25cc4ae248",
                        "glosses": [
                            "związek organiczny będący jonem obojnaczym, w którym ładunek dodatni nie sąsiaduje z ładunkiem ujemnym i zlokalizowany jest na atomie oniowym niepołączonym z żadnym atomem wodoru"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87697a91-8948-4abc-973f-973d040addbe",
                                "sense_id": "104c4635-cb71-3a26-87a5-0b0c3a5bd3c3",
                                "text": "Niektóre betainy wykorzystywane są w detergentach."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
