                        "entry_id": "ad72f0c0-7a3e-3f1f-985d-594f23f7c60f",
                        "glosses": [
                            "constant or excessive eating"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "3f12bf38-5117-4b2b-85be-7a08879699bc",
                                "sense_id": "c267bba5-0989-3210-9b84-e4195ea15f4b",
                                "text": "Na al die eterij moesten we eerst een kleine wandeling doen.",
                                "translation": "After all this eating we had to take a little walk first.",
                                "english": "After all this eating we had to take a little walk first."
                            }
                        ]
                    },
                    {
                        "sense_id": "d614d1ee-bc88-3363-a912-f7dcc3546caf",
                        "entry_id": "ad72f0c0-7a3e-3f1f-985d-594f23f7c60f",
                        "glosses": [
                            "a snackbar; bistro; small restaurant"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "272b6ad1-dc29-4f44-9845-aba8ee54a002",
                                "sense_id": "d614d1ee-bc88-3363-a912-f7dcc3546caf",
                                "text": "Als je niet veel honger hebt, kunnen we ook maar ergens naar een eterij toe.",
                                "translation": "If you’re not very hungry, we could just go to some snackbar.",
                                "english": "If you’re not very hungry, we could just go to some snackbar."
                            }
                        ]
                    }
