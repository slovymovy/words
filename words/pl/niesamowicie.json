{
    "word_family": [
        "niesamowity",
        "niesamowitość"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8846a348-14ef-3e6d-8238-0ce898089bf5",
                    "sense_definition": "Bardzo, w stopniu wyjątkowym, trudnym do uwierzenia; słowo używane do wzmocnienia znaczenia przymiotnika lub innego przysłówka.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten film był <w>niesamowicie</w> ciekawy i trzymał w napięciu do samego końca.",
                            "target_lang_translations": {
                                "ru": "Этот фильм был <w>невероятно</w> интересным и держал в напряжении до самого конца.",
                                "en": "This movie was <w>incredibly</w> interesting and kept us in suspense until the very end."
                            }
                        },
                        {
                            "text": "Jestem <w>niesamowicie</w> wdzięczny za twoją pomoc w tej trudnej sytuacji.",
                            "target_lang_translations": {
                                "ru": "Я <w>безумно</w> благодарен за твою помощь в этой трудной ситуации.",
                                "en": "I am <w>incredibly</w> grateful for your help in this difficult situation."
                            }
                        }
                    ],
                    "synonyms": [
                        "niezwykle",
                        "niesłychanie"
                    ],
                    "common_phrases": [
                        "niesamowicie szybko",
                        "niesamowicie ważny",
                        "niesamowicie trudne"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень, в исключительной степени, невероятно; слово используется для усиления значения прилагательного или другого наречия.",
                        "en": "Very, to an exceptional or hard-to-believe degree; used as an intensifier for adjectives or other adverbs."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невероятно",
                                "target_lang_sense_clarification": "в значении очень сильно, неправдоподобно"
                            },
                            {
                                "target_lang_word": "потрясающе",
                                "target_lang_sense_clarification": "в значении восхитительно"
                            },
                            {
                                "target_lang_word": "безумно",
                                "target_lang_sense_clarification": "разговорное усиление (очень)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "incredibly",
                                "target_lang_sense_clarification": "to an extraordinary degree"
                            },
                            {
                                "target_lang_word": "amazingly",
                                "target_lang_sense_clarification": "in an astonishing or wonderful manner"
                            },
                            {
                                "target_lang_word": "extremely",
                                "target_lang_sense_clarification": "to a very high degree"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84e28d89-4eb1-3375-b9cd-01ade2053fab",
                    "sense_definition": "W sposób tajemniczy, dziwny, budzący niepokój, lęk lub zdumienie swoją niezwykłością.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Opuszczony dom na wzgórzu wyglądał <w>niesamowicie</w> w świetle księżyca.",
                            "target_lang_translations": {
                                "ru": "Заброшенный дом на холме выглядел <w>жутко</w> в лунном свете.",
                                "en": "The abandoned house on the hill looked <w>eerie</w> in the moonlight."
                            }
                        },
                        {
                            "text": "Wiatr wył <w>niesamowicie</w>, sprawiając, że wszyscy czuliśmy dreszcze.",
                            "target_lang_translations": {
                                "ru": "Ветер выл <w>зловеще</w>, заставляя всех нас дрожать.",
                                "en": "The wind howled <w>eerily</w>, sending shivers down our spines."
                            }
                        }
                    ],
                    "synonyms": [
                        "przedziwnie",
                        "upiornie"
                    ],
                    "common_phrases": [
                        "wyglądać niesamowicie",
                        "brzmieć niesamowicie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Таинственно, странно, вызывая беспокойство, страх или изумление своей необычностью.",
                        "en": "In a mysterious, strange, or eerie manner that evokes unease, fear, or astonishment."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жутко",
                                "target_lang_sense_clarification": "страшно, пугающе"
                            },
                            {
                                "target_lang_word": "зловеще",
                                "target_lang_sense_clarification": "угрожающе, недобро"
                            },
                            {
                                "target_lang_word": "таинственно",
                                "target_lang_sense_clarification": "загадочно"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "eerily",
                                "target_lang_sense_clarification": "in a strange, frightening, or mysterious way"
                            },
                            {
                                "target_lang_word": "unnaturally",
                                "target_lang_sense_clarification": "in a bizarre, unsettling manner"
                            },
                            {
                                "target_lang_word": "uncannily",
                                "target_lang_sense_clarification": "in an unsettlingly strange or mysterious way"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}