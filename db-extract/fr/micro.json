        "fr-extract.jsonl": [
            {
                "entry_id": "dcb76373-d27e-3d9d-a36d-5de176ea7bf8",
                "word": "micro",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5ed37df6-930e-4299-840f-1dd95639effe",
                        "entry_id": "dcb76373-d27e-3d9d-a36d-5de176ea7bf8",
                        "tags": [
                            "plural"
                        ],
                        "form": "micros"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9970721b-a74b-39f1-9e9f-3c32c9047fc2",
                        "entry_id": "dcb76373-d27e-3d9d-a36d-5de176ea7bf8",
                        "glosses": [
                            "Microphone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49ac2a52-934d-4169-8842-d315ea939246",
                                "sense_id": "9970721b-a74b-39f1-9e9f-3c32c9047fc2",
                                "text": "Entre le bar à tacos « Les Pâques à Juarez » et celui à souchis « Le Mifouné », Choppard se présenta au guichet du kébabiste. Ce guichet n'est pas une image : Nourri en avait réellement installé un à sa devanture, un de récup’, complet avec hygiaphone et micro crachotant […]."
                            },
                            {
                                "example_id": "d89f7508-a318-4cdd-a1b9-2a7d0db6db77",
                                "sense_id": "9970721b-a74b-39f1-9e9f-3c32c9047fc2",
                                "text": "La foule, nombreuse, s'agglutinait le long des avenues, voyait passer en fanfare la caravane publicitaire, tentait d'attraper un gadget lancé depuis les chars qui chauffaient les spectateurs par des annonces au micro et des coups de Klaxon."
                            }
                        ]
                    },
                    {
                        "sense_id": "9363b961-a610-3c64-a81c-00112453ecbf",
                        "entry_id": "dcb76373-d27e-3d9d-a36d-5de176ea7bf8",
                        "glosses": [
                            "Microphone d’un journaliste qui pose des questions."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "ce018abc-3afc-4632-b952-b72cdef01712",
                                "sense_id": "9363b961-a610-3c64-a81c-00112453ecbf",
                                "text": "28 novembre 44 – J’ai l’impression que je perds cinq cents grammes chaque fois que je suis devant un micro, ce tonneau des Danaïdes qu’il faut remplir de mots et qui en redemande."
                            },
                            {
                                "example_id": "d82482ac-0852-4847-87ed-cc1ef3fdd2bc",
                                "sense_id": "9363b961-a610-3c64-a81c-00112453ecbf",
                                "text": "« Justice en danger, avocats en colère », « magistrats avec nous », « justice nulle part », scandait un avocat au micro."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32ecbc95-26fb-42cc-b1a4-7a75396b176e",
                        "source_entry_id": "dcb76373-d27e-3d9d-a36d-5de176ea7bf8",
                        "target_lang_word": "mike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a717a4b7-f4af-3b2d-9651-823adc247c1b",
                                        "entry_id": "ddfedc08-737b-386e-bf83-3bf244456301",
                                        "glosses": [
                                            "Clipping of microgram."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "642c09c7-915f-4a88-8b60-258b787a5c80",
                                                "sense_id": "a717a4b7-f4af-3b2d-9651-823adc247c1b",
                                                "text": "The beginner's dose may be anywhere from 100 to 250 mikes — micrograms, or millionths of a gram. Most hardened heads need 600 to 800 mikes, and some as many as 1,400 mikes, before they experience any sensation of getting off."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4a9abdf-196d-3c43-b276-fac25302ff3d",
                                        "entry_id": "4be1bc41-d3dd-372a-b03f-36b438f98717",
                                        "glosses": [
                                            "A microphone."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0917689-41c2-491d-9738-f83dabb3bd90",
                                                "sense_id": "e4a9abdf-196d-3c43-b276-fac25302ff3d",
                                                "text": "1970, Theodore Sturgeon and Edward H. Waldo, \"The Pod in the Barrier\", in A Touch of Strange, Ayer Publishing, →ISBN, page 28,\n\"Then I say to the recording, for the record,\" I barked, right into the mike, […]"
                                            },
                                            {
                                                "example_id": "b47b6cbd-e2ca-48b1-9272-55d453e6a319",
                                                "sense_id": "e4a9abdf-196d-3c43-b276-fac25302ff3d",
                                                "text": "1981, John Swaigen, How to Fight for What’s Right: The Guide to Public Interest Law, James Lorimer & Company, →ISBN, pages 118–119,\nObviously, one must watch what one says in the vicinity of a microphone. More than one person has made a “private” statement in the presence of an open mike."
                                            },
                                            {
                                                "example_id": "21a7d29b-72c9-4453-9ff9-3c7c62082b91",
                                                "sense_id": "e4a9abdf-196d-3c43-b276-fac25302ff3d",
                                                "text": "2007, John Sellers, Perfect from Now On: How Indie Rock Saved My Life, Simon and Schuster, →ISBN, page 85,\nWhen the haggard bartender informed us that there would be an open-mike event later in the evening, I got my first sense that not everyone in Manchester cared about the music the city has produced."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ca863fa-d97c-355a-8b51-43ef05416d8e",
                                        "entry_id": "f32824ab-7182-313e-8ad7-ee8d4ff29ef8",
                                        "glosses": [
                                            "To microphone; to place one or more microphones (mikes) on."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91b0333c-6c32-4cf9-a08f-91aa524afe4e",
                                                "sense_id": "3ca863fa-d97c-355a-8b51-43ef05416d8e",
                                                "text": "1994 September, Jim Gaines, transcribed in Alan di Perna, \"Step Lively: Recalling the recording process of SRV’s IN STEP with album producer Jim Gaines\", in Guitar World Magazine, reprinted in Guitar World Presents Stevie Ray Vaughan: Stevie Ray In His Own Words, Hal Leonard (1997), →ISBN, page 81,\n“And sometimes I’d just have to mike the room. You could run into some weird phasing problems with the individual mics because the speakers were all reacting differently.”"
                                            },
                                            {
                                                "example_id": "2635ad83-c6d3-4e9d-930e-f51ea9109453",
                                                "sense_id": "3ca863fa-d97c-355a-8b51-43ef05416d8e",
                                                "text": "1996, J.R. Robinson, quoted in Mark Huntly Parsons, The Drummer’s Studio Survival Guide: How to get the best possible drum tracks on any recording project, Hal Leonard, →ISBN, page 72,\nHe knows me, I know him, and I know how he’s going to mike the drums and what selection of mic’s he's going to use."
                                            },
                                            {
                                                "example_id": "42672d92-0ea6-4a3f-b5db-8f0cb7bd85b3",
                                                "sense_id": "3ca863fa-d97c-355a-8b51-43ef05416d8e",
                                                "text": "2006, Glenn Haertlein, Project Vectus, Lulu, →ISBN, page 108,\n“Zeb, is everything go on the AV equipment?” I heard Jim ask. ¶ “Yep,” Zeb replied. “I just need to mike him up.” […] “All set,” he said once he clipped the wireless microphone to my shirtfront."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "002dd410-ae77-3f33-97e8-164f3dfe4a2e",
                                        "entry_id": "f32824ab-7182-313e-8ad7-ee8d4ff29ef8",
                                        "glosses": [
                                            "To measure using a micrometer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcc65567-65e0-4810-b237-9c035c7f9786",
                                                "sense_id": "002dd410-ae77-3f33-97e8-164f3dfe4a2e",
                                                "text": "1983, Tom S. Wilson, How to Rebuild Your Big-block Chevy, HPBooks, →ISBN, page 98,\nMeasure Valve-Stem Diameter—To be positive about it you’ll have to mike the valve stem with a 1-in. micrometer as explained on pages 100 and 101."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05740c42-f94f-384d-8aed-619c1a2a6a35",
                                        "entry_id": "2dec2d16-c370-3d3d-8bbd-0a529ac160bd",
                                        "glosses": [
                                            "Alternative letter-case form of Mike from the NATO/ICAO Phonetic Alphabet."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f52e783-eb0c-30db-a94f-f2e92d35ba0e",
                                        "entry_id": "2dec2d16-c370-3d3d-8bbd-0a529ac160bd",
                                        "glosses": [
                                            "A minute."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dbce98d-fa1e-4b84-8d50-87334d0812f5",
                                                "sense_id": "3f52e783-eb0c-30db-a94f-f2e92d35ba0e",
                                                "text": "We'll be there in one zero mikes [i.e. ten minutes]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d002a2c-7ad9-405b-adb1-1e61b425f6e2",
                        "source_entry_id": "dcb76373-d27e-3d9d-a36d-5de176ea7bf8",
                        "target_lang_word": "mic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d62aadc7-c326-39e1-bfd2-998c2113c3b6",
                                        "entry_id": "a7f29e02-75bd-36ed-81a2-dc451f5fff81",
                                        "glosses": [
                                            "Alternative form of mike (“microphone”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12f13c76-50d7-4048-9105-6995456a693e",
                                                "sense_id": "d62aadc7-c326-39e1-bfd2-998c2113c3b6",
                                                "text": "Picture a mic, the stage is empty\nA beat like this might tempt me\nTo pose, show my rings and my fat gold chain\nGrab the mic like I'm on Soul Train"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fc3edcc-1f90-33ad-9026-6a8f5e67fe47",
                                        "entry_id": "44ec786a-68ec-3b6d-981f-f0cb89352ff4",
                                        "glosses": [
                                            "Alternative form of mike."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eca99306-eaf6-4813-aae5-46a32fdaa2e8",
                                                "sense_id": "5fc3edcc-1f90-33ad-9026-6a8f5e67fe47",
                                                "text": "If we add the drum kit, we'll have to mic the orchestra."
                                            },
                                            {
                                                "example_id": "6f31d2a2-422a-4cf1-a691-ed98a31d0d4b",
                                                "sense_id": "5fc3edcc-1f90-33ad-9026-6a8f5e67fe47",
                                                "text": "At 11:00 am, Doug mics up with me on the radio, and I advise him to go back to camp to get a quad, that we have a monster down."
                                            },
                                            {
                                                "example_id": "f1c6efbd-25f7-4158-bc78-dbc8c6a711ab",
                                                "sense_id": "5fc3edcc-1f90-33ad-9026-6a8f5e67fe47",
                                                "text": "Imagine playing a venue the size of an aircraft hangar without your tiny amps miced up through the PA!"
                                            },
                                            {
                                                "example_id": "aea9a762-a62a-4e7f-a97c-2c9ef98eddbc",
                                                "sense_id": "5fc3edcc-1f90-33ad-9026-6a8f5e67fe47",
                                                "text": "This lacks the gut-punch of miced-up bass but hopefully the player can rise to the challenge and give his or her take extra energy to make up for it."
                                            },
                                            {
                                                "example_id": "b79eda17-e4dd-4156-8773-ff1624d2ce5d",
                                                "sense_id": "5fc3edcc-1f90-33ad-9026-6a8f5e67fe47",
                                                "text": "Dynamics are used extensively for vocals, drums, and 'micing up' amplifiers such as guitar amps but they can be used for almost any application."
                                            },
                                            {
                                                "example_id": "07d58555-4105-43fd-95db-d258d4efb3c4",
                                                "sense_id": "5fc3edcc-1f90-33ad-9026-6a8f5e67fe47",
                                                "text": "but it is extremely useful in applications such as vocals, drums, and the micing-up of guitar amplifiers."
                                            }
                                        ]
                                    }
                                ]
                            },
