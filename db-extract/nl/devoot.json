                "senses": [
                    {
                        "sense_id": "e001b714-35ba-3136-8f4c-18543ca5f2b5",
                        "entry_id": "a4bffcd1-b0c8-32e4-88c8-e0d234981653",
                        "glosses": [
                            "met toewijding en eerbied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5942b46-363a-4d25-818c-3da117260f85",
                                "sense_id": "e001b714-35ba-3136-8f4c-18543ca5f2b5",
                                "text": "Gau Mata, Moeder Koe, is volgens hem meer dan ooit politiek geworden. Ze is het symbool waar devote hindoes zich omheen scharen. „In de koe komen religie en nationalisme samen. Zij is de ziel van de natie die moet worden beschermd tegen ‘anti-nationalen’, waarmee vrijwel altijd moslims worden bedoeld.”"
                            },
                            {
                                "example_id": "33b65aaa-a92e-4c06-8c6b-d2f2bfa72dce",
                                "sense_id": "e001b714-35ba-3136-8f4c-18543ca5f2b5",
                                "text": "De stoelen zijn smal, de armleuningen enkelvoudig en dun. Wil je niet arm in arm met je buurman zitten, dan moet je je handen devoot in de schoot leggen. Dan buigen je schouders naar binnen en vermijd je fysiek contact. Maar dat zit vrij verkrampt. Dat is ook wat vliegreizigers kunnen ervaren: het ‘economy class syndroom’. In het theater krijg je geen vliegtrombose, maar er zijn vliegtuigen waarin je comfortabeler zit dan in sommige theaters."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32260685-5708-4352-8c48-5387126aaeb1",
                        "source_entry_id": "a4bffcd1-b0c8-32e4-88c8-e0d234981653",
                        "source_sense_id": "e001b714-35ba-3136-8f4c-18543ca5f2b5",
                        "source_sense_description": "met toewijding en eerbied",
                        "target_lang_word": "pious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eabc9db7-2c84-3997-a8e0-b50e3a8be39f",
                                        "entry_id": "e0aed5d2-b1f3-3f56-86e1-8a1b50203d86",
                                        "glosses": [
                                            "Of or pertaining to piety, exhibiting piety, devout, god-fearing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94fae5c2-ec45-4edb-87b8-70df418e3af3",
                                                "sense_id": "eabc9db7-2c84-3997-a8e0-b50e3a8be39f",
                                                "text": "Old Deacon Smith was quick to see the impression made by Abby Howard upon the mind of his son, and he was wonderfully pleased thereat, for Abby was the oldest daughter of the good Deacon Howard, and was herself a church member, and pious. He had more hope for his son now, than he had felt for years."
                                            },
                                            {
                                                "example_id": "49f47377-7055-4b90-a5bd-ada7e633f38c",
                                                "sense_id": "eabc9db7-2c84-3997-a8e0-b50e3a8be39f",
                                                "text": "Its male residents dress like crows: heavy black suits, black Borsalino hats, the old grandfathers hugely whiskered and the boys in peot, the curled sidelocks of the pious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1eeca9a4-7923-3cec-91fa-ef634e197d2c",
                                        "entry_id": "e0aed5d2-b1f3-3f56-86e1-8a1b50203d86",
                                        "glosses": [
                                            "Relating to religion or religious works."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae9b5ae3-8696-4d00-af1e-20c40fb33b18",
                                                "sense_id": "1eeca9a4-7923-3cec-91fa-ef634e197d2c",
                                                "text": "A pious cause."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d5adde3-9b63-3754-a5cb-1630ae54d47a",
                                        "entry_id": "e0aed5d2-b1f3-3f56-86e1-8a1b50203d86",
                                        "glosses": [
                                            "Insisting on or making a show of one's own virtue, especially in comparison to others; sanctimonious, condescending, judgmental."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
