                "senses": [
                    {
                        "sense_id": "f6332e43-83a7-325c-8bcd-726c21cd08e8",
                        "entry_id": "374f3c40-90c4-3966-9d61-5f9ac2232cc4",
                        "glosses": [
                            "Angehöriger einer Völkergruppe in Südafrika und Namibia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c6d4bc9-bb33-4029-ae44-a0d3c402aa62",
                                "sense_id": "f6332e43-83a7-325c-8bcd-726c21cd08e8",
                                "text": "„Als der Sarg ins Grab gesenkt wurde, stimmten ganz unerwartet die Hottentotten, als ob es verabredet gewesen wäre, ein Holländisches Lied, welches Pacalt gemacht und sie gelehrt hatte, an […]“"
                            },
                            {
                                "example_id": "b0e05b80-321f-425a-9276-b8e7cf51ce6c",
                                "sense_id": "f6332e43-83a7-325c-8bcd-726c21cd08e8",
                                "text": "„Die deutschen Soldaten wurden zudem gebraucht, um die weiter südlich lebenden Nama - von den Deutschen abschätzig »Hottentotten« genannt - zu bekämpfen.“"
                            },
                            {
                                "example_id": "d6813b28-3aae-428a-8ab9-54732742436c",
                                "sense_id": "f6332e43-83a7-325c-8bcd-726c21cd08e8",
                                "text": "„Der Gesichtswinkel der Orang-Utans ähnelte dem der Australier und Hottentotten, man rechne sie deshalb zu den Menschenaffen.“"
                            },
                            {
                                "example_id": "b457db5f-fa88-4d10-bc6f-805d7baa9e3d",
                                "sense_id": "f6332e43-83a7-325c-8bcd-726c21cd08e8",
                                "text": "„Wer wollte nicht vermeinen, daß ich um der mit dem Adjutanten und den Hottenttoten gehabten Händel halber in Arrest kommen wäre, ich zum wenigsten hatte mich dessen in meinem Hertzen völlig überredet, jedoch an der Haupt-Ursache weit gefehlet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82381613-c146-4bcd-a41f-e1954b0b9d2d",
                        "source_entry_id": "374f3c40-90c4-3966-9d61-5f9ac2232cc4",
                        "source_sense_id": "f6332e43-83a7-325c-8bcd-726c21cd08e8",
                        "source_sense_description": "Angehöriger einer Völkergruppe in Südafrika und Namibia",
                        "target_lang_word": "Hottentot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hottentot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bc5875a-afbb-3d5c-9d4a-55532e3f4285",
                                        "entry_id": "3693d9e2-3668-33e0-8d56-b130f9e3837b",
                                        "glosses": [
                                            "A member of the Khoekhoe group of peoples."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c53ab5b-89d7-4b82-a2b6-3a6fecbeb4b2",
                                                "sense_id": "3bc5875a-afbb-3d5c-9d4a-55532e3f4285",
                                                "text": "1798-1801, Lady Ann Barnard, Letters and Journals\nI was told that the Hottentots were uncommonly ugly and disgusting, but I do not think them so bad. Their features are small and their cheekbones immense, but they have a kind expression and countenance."
                                            },
                                            {
                                                "example_id": "f380abc1-d5c3-4273-95ba-310f856390c6",
                                                "sense_id": "3bc5875a-afbb-3d5c-9d4a-55532e3f4285",
                                                "text": "They were called \"Bushmen\" because they led a nomadic life based on hunting and gathering in bushveld. The first written appearance of the Khoisan people, represented by the Bushmen and the Hottentots, dates back to the tenth century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1254486-dcce-373b-ad89-f42b331fbdfe",
                                        "entry_id": "3693d9e2-3668-33e0-8d56-b130f9e3837b",
                                        "glosses": [
                                            "A member of the broader Khoisan group of peoples."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fd0e8cb-413f-46e2-8691-bc3113674902",
                                                "sense_id": "b1254486-dcce-373b-ad89-f42b331fbdfe",
                                                "text": "The Hottentots (Khoisan) of either sex, young and old, who were in the boor's service, always choose to sleep in the fireplace."
                                            },
                                            {
                                                "example_id": "90a79409-eaef-48f1-b4d7-595c92653c45",
                                                "sense_id": "b1254486-dcce-373b-ad89-f42b331fbdfe",
                                                "text": "The Hottentots (Khoisan peoples) once an independent nation but whose simple tribal system had disintegrated rapidly as they were relentlessly displaced from their traditional grazing grounds and driven deep into the still uninhabited interior […]"
                                            },
                                            {
                                                "example_id": "bdf03697-df58-48a7-b68c-349a28abbd03",
                                                "sense_id": "b1254486-dcce-373b-ad89-f42b331fbdfe",
                                                "text": "The Dutch colonists in this frontier district, two years after an uprising of the Khoisan (“Hottentots”), were wary of the newly installed British regime at the Cape of Good Hope."
                                            },
                                            {
                                                "example_id": "ba8f62c5-43ad-4639-a29d-a3977551d65e",
                                                "sense_id": "b1254486-dcce-373b-ad89-f42b331fbdfe",
                                                "text": "First, in 1828, all legal disabilities on the free people of colour, particularly the Khoisan [Hottentots], were removed by Ordinance 50."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97ed31c4-f84a-3cc7-a09c-6a51d4bc8f8d",
                                        "entry_id": "3693d9e2-3668-33e0-8d56-b130f9e3837b",
                                        "glosses": [
                                            "Any of several fish of the genus Pachymetopon, in the family Sparidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Hottentot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "424d25a5-c93b-391e-abe0-25b309af7711",
                                        "entry_id": "d51810a8-8fe0-30f1-a36e-8a758f72c489",
                                        "glosses": [
                                            "The language of the Khoekhoe, remarkable for its clicks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "387a0d34-fd55-4f19-97d4-99581551e4b1",
                                                "sense_id": "424d25a5-c93b-391e-abe0-25b309af7711",
                                                "text": "Ive tried her with every […] possible sort of sound that a human being can make— […] Continental dialects, African dialects, Hottentot […] clicks, things it took me years to get hold of; and […] she picks them up like a shot, right away, as if she had […] been at it all her life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
