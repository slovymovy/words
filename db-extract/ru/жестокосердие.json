                "senses": [
                    {
                        "sense_id": "be2c07b4-6e39-3834-8fd4-ae66d59c6521",
                        "entry_id": "65908483-3383-3f96-bbf6-5026b1cdc58d",
                        "glosses": [
                            "книжн. жестокость, бессердечие, отсутствие чувства сострадания, жалости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "979ba276-8629-429e-a752-922cf912d230",
                                "sense_id": "be2c07b4-6e39-3834-8fd4-ae66d59c6521",
                                "text": "Он говорит им: Моисей по жестокосердию вашему позволил вам разводиться с женами вашими, а сначала не было так; но Я говорю вам: кто разведётся с женою своею не за прелюбодеяние и женится на другой, [тот] прелюбодействует; и женившийся на разведённой прелюбодействует."
                            },
                            {
                                "example_id": "033d606f-eb70-45fb-9b80-802d6f5a8e75",
                                "sense_id": "be2c07b4-6e39-3834-8fd4-ae66d59c6521",
                                "text": "Родители остались одни, и потом, скукой и одиночеством, всю жизнь платили за свое жестокосердие."
                            },
                            {
                                "example_id": "24399700-72fc-4db6-a8bc-16aa457dbacf",
                                "sense_id": "be2c07b4-6e39-3834-8fd4-ae66d59c6521",
                                "text": "Жестокосердия, вот чего боюсь. Жестокий убьёт, а жестокосердный в помощи откажет."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96aff453-8ffd-438d-a028-3cd01da589f9",
                        "source_entry_id": "65908483-3383-3f96-bbf6-5026b1cdc58d",
                        "source_sense_id": "be2c07b4-6e39-3834-8fd4-ae66d59c6521",
                        "target_lang_word": "hard-heartedness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hard-heartedness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d1b11d1-1c96-354d-9f2f-abc92739372b",
                                        "entry_id": "1550b49e-3bf6-37f3-94fe-6e5718a4ac34",
                                        "glosses": [
                                            "Alternative form of hardheartedness."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d58d25d-384c-4d69-b5a8-58d270ff58f9",
                                                "sense_id": "6d1b11d1-1c96-354d-9f2f-abc92739372b",
                                                "text": "It was precisely the hard-heartedness of these economic doctrines that the nineteenth-century English novelist Charles Dickens had satirized in Hard Times."
                                            },
                                            {
                                                "example_id": "5229e55b-4424-41ad-907a-cac70c945319",
                                                "sense_id": "6d1b11d1-1c96-354d-9f2f-abc92739372b",
                                                "text": "For where is the hard-heartedness in sending away honorably and freely a woman who, through her own fault, you cannot love?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
