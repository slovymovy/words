                ],
                "senses": [
                    {
                        "sense_id": "d7de765d-b31c-3cf4-a901-7830732395e6",
                        "entry_id": "253fc0cc-d8f4-31fc-a29f-37ca3a1b718f",
                        "glosses": [
                            "Jahr, in dem Krieg geführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "560aa11a-20a8-4309-b3a9-abe2c92fe287",
                                "sense_id": "d7de765d-b31c-3cf4-a901-7830732395e6",
                                "text": "„Erstaunlich, was Warschau im vierten Kriegsjahr noch zu bieten hat.“"
                            },
                            {
                                "example_id": "386a558b-52a2-464e-a7ae-b04c8d917a67",
                                "sense_id": "d7de765d-b31c-3cf4-a901-7830732395e6",
                                "text": "„Bis auf die letzten Kriegsjahre verlebte er dort wohl eine weitgehend positive Kindheit.“"
                            },
                            {
                                "example_id": "3a6b5450-0a1b-44e3-a1df-24b517b36632",
                                "sense_id": "d7de765d-b31c-3cf4-a901-7830732395e6",
                                "text": "„Ich kannte noch zwei andere Nachbarn, beide waren im Kriegsjahr 1941 geboren: Sergej, eine Kriegswaise aus Ossetien, und Wadim, der bei Partisanen in Polesien aufgewachsen war.“"
                            },
                            {
                                "example_id": "ddca5fdb-1cb0-4865-81b4-7b45609c03cb",
                                "sense_id": "d7de765d-b31c-3cf4-a901-7830732395e6",
                                "text": "„Fordert das fünfte Kriegsjahr nicht die bittere Beschränkung – und darum die unauffällige, stille Hochzeit nur im kleinsten Kreis?“"
                            },
                            {
                                "example_id": "de4871f3-3898-401e-8889-d9a3efbe97c3",
                                "sense_id": "d7de765d-b31c-3cf4-a901-7830732395e6",
                                "text": "„General Zaitzew erhielt die Order, mit einem aggressiven Militäreinsatz den Krieg binnen eines Jahres zu beenden – es sollte das schlimmste Kriegsjahr werden.“"
                            },
                            {
                                "example_id": "810d6edc-61c0-4ede-a4fa-c72d719ed653",
                                "sense_id": "d7de765d-b31c-3cf4-a901-7830732395e6",
                                "text": "„Heinz Erhardt wird zur Marine eingezogen; er muss zur Truppenbetreuung und dort seine Chansons und Gedichte vortragen. Auf diese Weise kommt er relativ gut durch die Kriegsjahre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
