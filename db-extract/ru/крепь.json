                                "example_id": "d7a4fe7b-5411-4ab1-8580-dbc0c745a296",
                                "sense_id": "23aadadf-4cfc-3c46-a999-c97a30c4f3dd",
                                "text": "А крепь — грехи помещика, грех Якова-несчастного, грех Глеба родила!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a56d1f75-2e21-4eaa-8b53-25d74c1a10d9",
                        "source_entry_id": "dc3e8070-97ec-37eb-a472-cb11511136fd",
                        "source_sense_id": "23aadadf-4cfc-3c46-a999-c97a30c4f3dd",
                        "target_lang_word": "servage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "servage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bec6415b-6e5f-3916-af28-4ccf13571ae8",
                                        "entry_id": "9a406c44-0534-31d5-9d9f-7a26fe8a5fb1",
                                        "glosses": [
                                            "Condition du serf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "621f585d-315c-4dd5-9332-279ea15d7e82",
                                                "sense_id": "bec6415b-6e5f-3916-af28-4ccf13571ae8",
                                                "text": "La forme d’assujettissement désignée sous le nom de « servage », considérée comme caractéristique de l’époque médiévale, se distingue en effet de l’esclavage en ce qu’elle désigne un statut d’infériorité sociale vécue dans le cadre d’une seigneurie."
                                            },
                                            {
                                                "example_id": "ebd55418-eb6a-48d2-928d-7f01ff2a387b",
                                                "sense_id": "bec6415b-6e5f-3916-af28-4ccf13571ae8",
                                                "text": "Les contrevenants aux lois du servage et les criminels encouraient de sévères punitions : de 100 à 1000 coups de fouet, selon l’offense ; amputation de main, de jambe ou des yeux pour les crimes les plus graves."
                                            },
                                            {
                                                "example_id": "6d91dd91-d1d6-446d-b8e4-887239f42928",
                                                "sense_id": "bec6415b-6e5f-3916-af28-4ccf13571ae8",
                                                "text": "Le laboureur, lui, restait dans le servage; il pliait sous le joug de son seigneur ou de son créancier."
                                            },
                                            {
                                                "example_id": "0d6e1276-97e9-43cb-b23b-1ce2db33f03a",
                                                "sense_id": "bec6415b-6e5f-3916-af28-4ccf13571ae8",
                                                "text": "Ravi d’être sorti de servage, enchanté de se trouver homme libre et propriétaire, Gurth sauta sur ses pieds et bondit deux fois presque à la hauteur de sa tête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "656f1721-740f-3eb5-a9c2-ed3a834789c8",
                                        "entry_id": "9a406c44-0534-31d5-9d9f-7a26fe8a5fb1",
                                        "glosses": [
                                            "Esclavage ; servitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0995d57-65ef-4a16-8421-d757c2bd08cd",
                                                "sense_id": "656f1721-740f-3eb5-a9c2-ed3a834789c8",
                                                "text": "Ensuite - lorsque, avec la découverte de l’élevage et de l’agriculture, un homme sut produire davantage qu’il ne lui fallait pour vivre - les vainqueurs trouvèrent plus commode de réduire les vaincus au servage et de les faire travailler pour eux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9b49303-1274-31a4-98c6-d0f9427d007a",
                                        "entry_id": "9a406c44-0534-31d5-9d9f-7a26fe8a5fb1",
                                        "glosses": [
                                            "Soumission."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e75f9ff1-6b6f-4918-991a-8985a231f1ba",
                                                "sense_id": "b9b49303-1274-31a4-98c6-d0f9427d007a",
                                                "text": "Je vous dois un guerdon, car vous êtes demeuré longtemps près de moi en amoureux servage, répondit Valérie en rougissant ; approchez, gentil troubadour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
