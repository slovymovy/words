                                "target_senses": [
                                    {
                                        "sense_id": "89923546-0847-3108-8c2f-921c9f1156b4",
                                        "entry_id": "eef8a6f9-656e-3b79-ba40-494119e7b984",
                                        "glosses": [
                                            "The monetary unit of Russia, Belarus and Transnistria equal to 100 kopeks (Russian: копе́йка (kopéjka), Belarusian: капе́йка (kapjéjka)). The Russian ruble's symbol is ₽."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a2d911c-d99c-4666-850b-6a5f04d526ba",
                                                "sense_id": "89923546-0847-3108-8c2f-921c9f1156b4",
                                                "text": "While the local currency is the manat, the Russian ruble is in circulation and prices are often confusingly quoted in manats and rubles. […] The currency is the manat with a hundred gopik […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f05b9779-eb2c-4be6-941f-0431ea48bf50",
                        "source_entry_id": "3495b14d-39ec-38ad-a457-87949b21c3dc",
