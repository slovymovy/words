                        "entry_id": "21f62ce8-fe14-3a8b-8b76-6245a070ab54",
                        "glosses": [
                            "sytuacja w partii szachowej, kiedy jednemu lub obydwojgu graczom grozi przegrana z powodu przekroczenia limitu czasu"
                        ],
                        "tags": [],
                        "examples": [
