                        "glosses": [
                            "Soumettre à un black-out."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffcbc17f-1f54-4d21-9be5-50b3f1d6541e",
                                "sense_id": "42c489f7-0067-37fb-a875-aafdeef181af",
                                "text": "La presse locale a black-outé l’information lors des incidents de Longwy en avril 84 et fait le silence sur l’ensemble des mouvements sociaux à la même époque."
                            },
                            {
                                "example_id": "151fb8ee-cf2d-4414-be65-5b62f5b9ae05",
                                "sense_id": "42c489f7-0067-37fb-a875-aafdeef181af",
                                "text": "La Sénégambie, la CEDEAO, l'Afrique et les APE : « Black-outé » au Sénégal, motif d’un coup d’Etat en Gambie."
                            },
                            {
                                "example_id": "eb4065b9-5039-4b80-a953-ae5a2703faca",
                                "sense_id": "42c489f7-0067-37fb-a875-aafdeef181af",
                                "text": "Cela a commencé par la version tronquée de l’homélie prononcée ce matin, le paragraphe d’hommage à Benoît ayant été carrément black-outé sur le site officiel en français (cf. Curieux oubli... )."
                            }
                        ]
                    }
