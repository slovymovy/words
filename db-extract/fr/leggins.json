                        "glosses": [
                            "Variante orthographique de leggings."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cae7d2b9-58f1-4542-9c21-e414b3ef1972",
                                "sense_id": "eba408fc-09cc-303e-9c57-15ce646637ab",
                                "text": "Le Sigisbée moderne porte le sambrown belt et les leggins en cuir de simili-porc."
                            },
                            {
                                "example_id": "bfec757c-4278-4478-9cb9-c52189a47244",
                                "sense_id": "eba408fc-09cc-303e-9c57-15ce646637ab",
                                "text": "Un quart d’heure plus tard, revêtu d’un uniforme immaculé, guêtré de beaux leggins d’acajou sombre, il était redevenu pareil à lui-même."
                            },
                            {
                                "example_id": "3525afc2-58d3-410e-8327-d191bd962f80",
                                "sense_id": "eba408fc-09cc-303e-9c57-15ce646637ab",
                                "text": "Fait comme un gorille dont il avait la carrure, le faciès et les longs bras pendant à hauteur des genoux, il était chaussé de pantoufles et portait des leggins dépareillés."
                            },
                            {
                                "example_id": "4727ea31-7af2-4143-9a37-393653e774c5",
                                "sense_id": "eba408fc-09cc-303e-9c57-15ce646637ab",
                                "text": "Mais pendant que d’Arrast buvait, près de la fenêtre, un grand escogriffe, en culotte de cheval et leggins, vient lui tenir, en chancelant un peu, un discours rapide et obscur où l’ingénieur reconnut seulement le mot « passeport »."
                            }
                        ]
                    }
