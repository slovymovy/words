                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e997bff2-b7c8-44c6-a61f-8418fe5ba313",
                                                "sense_id": "35481ee2-a2d7-342a-99ac-cf853f41c652",
                                                "text": "Incubation in the vicinity of burial places, cremation grounds, holy wells and sacred streams was common. The ancient Hebrews visited vaults or slept among tombs to get meaningful dreams."
                                            }
