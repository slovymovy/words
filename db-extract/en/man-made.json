                    {
                        "translation_id": "6fa4a59c-668e-4c3c-a131-68d80d1f326c",
                        "source_entry_id": "29097def-b1a1-375a-b3e0-e251f6426566",
                        "source_sense_id": "b15b11cc-5123-3a0c-91ec-5de97cf6c475",
                        "source_sense_description": "created by a human",
                        "target_lang_word": "menschengemacht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menschengemacht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b0291f6-db2a-341e-ac1d-8b7f833bdbb5",
                                        "entry_id": "e28fb62a-76bc-3068-ae3c-b79f51c576cd",
                                        "glosses": [
                                            "von Menschen erschaffen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "669ffc1e-ef65-44df-b9ed-dab80fa35cf2",
                                                "sense_id": "4b0291f6-db2a-341e-ac1d-8b7f833bdbb5",
                                                "text": "„Die zerklüftete Kraterlandschaft der ehemaligen Braunkohletagebaus ist eine faszinierende, menschengemachte Landschaft.“"
                                            },
                                            {
                                                "example_id": "d490c5c2-926a-47a6-98a1-5099b7399804",
                                                "sense_id": "4b0291f6-db2a-341e-ac1d-8b7f833bdbb5",
                                                "text": "„Die Wissenschaft ist sich einig: Solche Wetterlagen werden unter dem Einfluss des menschengemachten Klimawandels künftig nicht nur wahrscheinlicher, sondern auch intensiver.“"
                                            },
                                            {
                                                "example_id": "b142331f-4780-4b78-b653-921972da48d7",
                                                "sense_id": "4b0291f6-db2a-341e-ac1d-8b7f833bdbb5",
                                                "text": "„Er wird als […] Leugner des menschengemachten Klimawandels und als Verbreiter von Falschinformationen zur COVID-19-Pandemie rezipiert.“"
                                            },
                                            {
                                                "example_id": "ba902e6e-d3df-40f4-9419-7d2315dc1122",
                                                "sense_id": "4b0291f6-db2a-341e-ac1d-8b7f833bdbb5",
                                                "text": "„Tatsächlich weiß nicht einmal die Hälfte der US-amerikanischen Erwachsenen von dem wissenschaftlichen Konsens zur menschengemachten globalen Erwärmung.“"
                                            },
                                            {
                                                "example_id": "9eac28dc-4884-4564-8039-8a7424e5add1",
                                                "sense_id": "4b0291f6-db2a-341e-ac1d-8b7f833bdbb5",
                                                "text": "„Dann wäre eventuell deutlicher, dass nicht ein halluzinierter Migrationsnotstand, sondern die menschengemachte Klimakatastrophe die wichtigste Herausforderung unserer Generation ist.“"
                                            },
                                            {
                                                "example_id": "210f88d4-d476-41b8-963e-13720435e040",
                                                "sense_id": "4b0291f6-db2a-341e-ac1d-8b7f833bdbb5",
                                                "text": "„»Die menschengemachten Naturkatastrophen überschlagen sich seit geraumer Zeit geradezu.«“"
                                            },
                                            {
                                                "example_id": "93b050c4-0455-4865-8151-acfaab3f3232",
                                                "sense_id": "4b0291f6-db2a-341e-ac1d-8b7f833bdbb5",
                                                "text": "[2025:] „[…] Nach zwei Monaten Blockade durch Israel droht den rund zwei Millionen Bewohnern Gazas eine menschengemachte Hungersnot.“"
                                            },
                                            {
                                                "example_id": "1a9e3597-0a16-46a1-93c3-eb9e173e1c7d",
                                                "sense_id": "4b0291f6-db2a-341e-ac1d-8b7f833bdbb5",
                                                "text": "„›[…] Und alle Religionen sind menschengemacht‹, sagte der 70-jährige Südtiroler in der Talkshow ›3nach9‹ von Radio Bremen am Samstag. Er respektiere grundsätzlich alle Glaubensrichtungen, wolle ihnen aber nicht anhängen, weil es sich um ›menschengemachte Machtinstrumente‹ handele.“"
                                            },
                                            {
                                                "example_id": "f4b1fc55-4fe5-486b-80fa-991fdc1fbb41",
                                                "sense_id": "4b0291f6-db2a-341e-ac1d-8b7f833bdbb5",
                                                "text": "„Die aktuelle Erderwärmung ist menschengemacht. Die Daten hinter dieser Erkenntnis sind vielfach überprüft und bestätigt – sogar von Zweiflern.“"
                                            },
                                            {
                                                "example_id": "37d0bb07-f3c9-4d14-b19a-413546429573",
                                                "sense_id": "4b0291f6-db2a-341e-ac1d-8b7f833bdbb5",
                                                "text": "„97 Prozent der Klimaforschenden sagen, die Krise sei menschengemacht. Sie haben Beweise angehäuft, die diese These stützen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
