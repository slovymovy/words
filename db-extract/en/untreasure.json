                        "glosses": [
                            "To despoil of treasure."
                        ],
                        "tags": [
                            "obsolete",
                            "poetic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "81f6b941-fd80-4ad7-a7a2-787cbfe130c9",
                                "sense_id": "c1ae4c58-7c8d-3c9e-a3f7-f61c7d285151",
                                "text": "When Cluffe […] returned to the drawing-room, […] he was a good deal chagrined to find the drawing-room 'untreasured of its mistress.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "1eb33477-70d0-3ce5-bbf5-54f0a4b0e0e7",
                        "entry_id": "4c451757-8b58-3472-b3b3-e179fdf5dc14",
                        "glosses": [
                            "To display or set forth."
                        ],
                        "tags": [
                            "obsolete",
                            "poetic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d6f12e3e-24a1-49f8-a830-d41640a42760",
                                "sense_id": "1eb33477-70d0-3ce5-bbf5-54f0a4b0e0e7",
                                "text": "J. Mitford\nthe quaintness with which he untreasured, as by rote, the stores of his memory"
                            },
                            {
                                "example_id": "62fe933b-c1ee-4d6a-ab86-30d93fb7a707",
                                "sense_id": "1eb33477-70d0-3ce5-bbf5-54f0a4b0e0e7",
                                "text": "Before me, careless lying,\nYoung Love his ware comes crying\nFull soon the elf untreasures\nHis pack of pains and pleasures."
                            }
                        ]
                    }
