                "senses": [
                    {
                        "sense_id": "0d4c0e46-b849-3332-bb02-a4d2ac0712da",
                        "entry_id": "54622558-d903-3b4b-8262-de62a3e5f307",
                        "glosses": [
                            "Action de réanimer, de rendre vivant de nouveau."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6863b616-47bf-334f-bb06-249c64fe898a",
                        "entry_id": "54622558-d903-3b4b-8262-de62a3e5f307",
                        "glosses": [
                            "Service hospitalier où s’exerce un ensemble de techniques visant à maintenir les fonctions vitales abolies ou perturbées (respiration, fonction rénale, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4bfea96-36f1-4f7e-aed9-a4bfdb6eb9cf",
                                "sense_id": "6863b616-47bf-334f-bb06-249c64fe898a",
                                "text": "Selon moi, si je m’en suis sortie – et sans séquelles –, c’est parce que la maternité dans laquelle j’ai eu la chance de naître était dotée de moyens de réanimation conséquents et d’un personnel en nombre suffisant. L’hôpital public n’était pas encore passé par la thérapie de choc que lui imposèrent les idéologues du “New Public Management”. ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "487f00b4-a614-4c69-829b-d28b5446ec70",
                        "source_entry_id": "54622558-d903-3b4b-8262-de62a3e5f307",
                        "target_lang_word": "Wiederbelebung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wiederbelebung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29851f36-efa2-365d-878a-5f19e4d0597c",
                                        "entry_id": "589415c7-7292-39fe-bc26-68fd69182b90",
                                        "glosses": [
                                            "das Ingangbringen von zum Erliegen gekommenen Lebensfunktionen durch gezielte Maßnahmen wie Defibrillation, künstliche Beatmung etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cb29bb7-e91a-4c5d-bb3a-8668decbcc26",
                                                "sense_id": "29851f36-efa2-365d-878a-5f19e4d0597c",
                                                "text": "„Zwei britische Rettungssanitäter haben offenbar einen Mann für tot erklärt, weil sie sich die Mühe einer Wiederbelebung sparen wollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1167eef0-764e-352f-8c72-13d3f8b61436",
                                        "entry_id": "589415c7-7292-39fe-bc26-68fd69182b90",
                                        "glosses": [
                                            "die Wiederkehr, das Wiederaufleben einer alten Mode, eines alten Stils oder von Ähnlichem"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec098fb6-dde1-4309-911e-b75d66641241",
                                                "sense_id": "1167eef0-764e-352f-8c72-13d3f8b61436",
                                                "text": "„El-Nawabs Buch ist zu entnehmen, dass sich ‚Rockabilly‘ als Name des Genres erst im Zuge einer ersten Wiederbelebung in den 70er Jahren durchsetzte und sich vorher nur in diversen Songs angedeutet hatte.“"
                                            },
                                            {
                                                "example_id": "b2a68589-edff-49b6-8fdc-b324488d63c9",
                                                "sense_id": "1167eef0-764e-352f-8c72-13d3f8b61436",
                                                "text": "„Sie fand ihren Ausdruck in einer Wiederbelebung der ungarischen Kultur und Sprache.“"
                                            },
                                            {
                                                "example_id": "36b58c20-f967-469c-bf64-deb729753357",
                                                "sense_id": "1167eef0-764e-352f-8c72-13d3f8b61436",
                                                "text": "„In der Sprachenfrage nahm der »Bund« nun eine radikale Haltung ein: Jiddisch sollte die einzige Nationalsprache der Juden werden, eine Wiederbelebung des Hebräischen wurde ebenso abgelehnt wie die gesamte religiöse Tradition des Judentums.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a885e690-ea96-46a6-8dff-ea728fccb003",
                        "source_entry_id": "54622558-d903-3b4b-8262-de62a3e5f307",
                        "target_lang_word": "resuscitation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resuscitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9e77414-b13b-3c1b-bad6-89b9a0fed63b",
                                        "entry_id": "8c141a0f-a50a-3837-8bdc-9d41dadb5971",
                                        "glosses": [
                                            "The act of resuscitating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4c3634a-5c66-4285-a21c-e37acad18ee3",
                                                "sense_id": "e9e77414-b13b-3c1b-bad6-89b9a0fed63b",
                                                "text": "If the depletion had cured a bad cold, or averted a slight fever, and the patient came down declaring she was well, yet looking very ill, and an officious caller recommended \"beef-tea, calves' foot jellies, or a glass of old port,\" Lady Anne, who well knew the value of such nutriments, seeing she constantly used them, would observe in reply, \"at her time of life there is an innate power of resuscitation, which operates better without such stimulants, in my opinion;\"..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "066d7e7e-56f1-4d69-86c1-96bc14281096",
                        "source_entry_id": "54622558-d903-3b4b-8262-de62a3e5f307",
                        "target_lang_word": "rianimazione",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rianimazione",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "60ae275d-a575-305f-beea-bf8364a50504",
                                        "entry_id": "b9eb4927-619d-336f-a86e-d94df13edea8",
                                        "glosses": [
                                            "sequenza di azioni atte a riavviare l'apparato cardio-circolatorio, dopo un suo arresto, annullando la condizione di morte apparente"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f8769ff-677a-4707-b4ea-260b55260968",
                                                "sense_id": "60ae275d-a575-305f-beea-bf8364a50504",
                                                "text": "la rianimazione cardiopolmonare è una tecnica di primo soccorso"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa7f6ed9-2b23-44fc-876f-1dd70d956858",
                        "source_entry_id": "54622558-d903-3b4b-8262-de62a3e5f307",
                        "target_lang_word": "реанимация",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "реанимация",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "46e9a627-ab29-34ce-b065-c4bf162b61f9",
                                        "entry_id": "e3008130-62bb-3704-b5c5-5d70906928e5",
                                        "glosses": [
                                            "мед. комплекс неотложных медицинских мероприятий, направленных на восстановление резко нарушенных или утраченных жизненно важных функций организма, находящегося в предсмертном состоянии; оживление организма после клинической смерти"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dda1c5f-449e-4de9-a803-2a6c7996a469",
                                                "sense_id": "46e9a627-ab29-34ce-b065-c4bf162b61f9",
                                                "text": "На выходе из здания не было координатора-медика, а также площадки, где людям могли бы провести реанимацию прямо на месте."
                                            },
                                            {
                                                "example_id": "182a0ab6-68d3-4d08-856c-69a2a5f172d7",
                                                "sense_id": "46e9a627-ab29-34ce-b065-c4bf162b61f9",
                                                "text": "Если пульс не появился и после этого, начинайте делать искусственное дыхание и непрямой массаж сердца. О них написано в любом пособии по неотложной помощи и реанимации."
                                            },
                                            {
                                                "example_id": "c704cfcb-1e9a-46fa-9331-3d0209f9168c",
                                                "sense_id": "46e9a627-ab29-34ce-b065-c4bf162b61f9",
                                                "text": "Доставишь в травмпункт ― там и без тебя вправят. Сердечно-лёгочная реанимация. Ну и наконец, что делать с человеком, если он просто лежит и молчит?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b4e3ba0-ff27-30e8-af58-a6d2874f8313",
                                        "entry_id": "e3008130-62bb-3704-b5c5-5d70906928e5",
                                        "glosses": [
                                            "разг. специально оборудованное помещение больницы для проведения таких мероприятий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29e05096-6e57-49ec-aff6-0d0c49fd85ed",
                                                "sense_id": "2b4e3ba0-ff27-30e8-af58-a6d2874f8313",
                                                "text": "За все время нахождения в реанимации он почти не приходил в сознание, а когда приходил, то ничего вразумительного о происшедшем сказать не мог."
                                            },
                                            {
                                                "example_id": "225c1401-59ba-48aa-bf92-59d3d7e062de",
                                                "sense_id": "2b4e3ba0-ff27-30e8-af58-a6d2874f8313",
                                                "text": "Ещё двое с тяжёлыми ранениями были найдены на лестнице и в холле ― один из них скончался, второй в критическом состоянии находится в реанимации."
                                            },
                                            {
                                                "example_id": "d070c423-0c96-47ad-a1b5-c7c28876704e",
                                                "sense_id": "2b4e3ba0-ff27-30e8-af58-a6d2874f8313",
                                                "text": "С проникающими ранениями грудной и брюшной полостей он был доставлен «скорой помощью» в центральную районную больницу, где через сутки скончался в реанимации."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24fa5311-4ea4-3752-98a5-c1853bf2afb5",
                                        "entry_id": "e3008130-62bb-3704-b5c5-5d70906928e5",
                                        "glosses": [
                                            "разг. машина скорой помощи для реанимации [1] на догоспитальном этапе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37747594-5af5-4c78-a486-31447f69629a",
                                                "sense_id": "24fa5311-4ea4-3752-98a5-c1853bf2afb5",
                                                "text": "Прибыла реанимация, но отец уже не приходил в себя."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0385663a-e678-3bd3-9a94-d1b4e9ceb5b8",
                                        "entry_id": "e3008130-62bb-3704-b5c5-5d70906928e5",
                                        "glosses": [
                                            "перен. восстановление, возвращение, оживление чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7834ddcb-36f0-418a-a4d3-d78e5ae636b6",
                                                "sense_id": "0385663a-e678-3bd3-9a94-d1b4e9ceb5b8",
                                                "text": "В отдельных случаях произошла даже реанимация прежних антигерманских настроений."
                                            },
                                            {
                                                "example_id": "f7d87194-0228-4cb5-b911-42f7513b7289",
                                                "sense_id": "0385663a-e678-3bd3-9a94-d1b4e9ceb5b8",
                                                "text": "В первый раз я потратила на реанимацию компьютера три долгих дня."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
