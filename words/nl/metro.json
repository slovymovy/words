                    "sense_id": "8240fc91-525a-3f3f-be03-99fc3566aabd",
                    "sense_definition": "Een systeem voor openbaar vervoer in grote steden dat geheel of gedeeltelijk onder de grond loopt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ga elke ochtend met de <w>metro</w> naar mijn werk.",
                            "target_lang_translations": {
                                "en": "I go to work by <w>subway</w> every morning.",
                                "ru": "Каждое утро я езжу на работу на <w>метро</w>.",
                                "de": "Ich fahre jeden Morgen mit der <w>U-Bahn</w> zur Arbeit."
                            }
                        },
                        {
                            "text": "In Parijs is de <w>metro</w> een heel populair vervoermiddel.",
                            "target_lang_translations": {
                                "en": "In Paris, the <w>metro</w> is a very popular means of transport.",
                                "ru": "В Париже <w>метро</w> — очень популярное средство передвижения.",
                                "de": "In Paris ist die <w>Metro</w> ein sehr beliebtes Verkehrsmittel."
                            }
                        }
                    ],
                    "synonyms": [
                        "ondergrondse"
                    ],
                    "common_phrases": [
                        "met de metro",
                        "de metro nemen",
                        "het metrostation"
                    ],
                    "target_lang_definitions": {
                        "en": "A public transport system in large cities that runs wholly or partly underground.",
                        "ru": "Система общественного транспорта в крупных городах, проходящая полностью или частично под землей.",
                        "de": "Ein öffentliches Verkehrssystem in Großstädten, das ganz oder teilweise unterirdisch verläuft."
                    },
