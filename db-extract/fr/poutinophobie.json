                        "entry_id": "23b81db1-bf13-317b-b803-edaf0af4f036",
                        "glosses": [
                            "Répulsion instinctive ressentie à l'égard de l’homme politique russe, Vladimir Vladimirovitch Poutine et de ses partisans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7375d753-c446-4e61-89ef-6ff6c6550713",
                                "sense_id": "9466db7a-73e0-362d-a28c-6809351e56f5",
                                "text": "Poutine n’a rien à voir avec l'assassinat de la journaliste Estemirovna, mais cette poutinophobie pathologique empêche ses détracteurs d’admettre la réalité."
                            },
                            {
                                "example_id": "90a2db0a-f37c-4d1b-8a20-d6546a4fd81a",
                                "sense_id": "9466db7a-73e0-362d-a28c-6809351e56f5",
                                "text": "À l’approche des élections présidentielles du 4 mars en Russie, les médias occidentaux font de la poutinophobie compulsionnelle et ne reculent pas devant la désinformation."
                            }
                        ]
                    }
