                                        "entry_id": "6c3fe43c-fd6d-35f0-a539-bbd21df3392b",
                                        "glosses": [
                                            "A non-SI unit of energy equal to 1,000 calories (small calories), used (now rare) in chemistry or physics; equal to 1 calorie as used in nutrition. Symbol kcal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35dc0ccc-27d7-467b-8f05-bb2ff55454a0",
                                                "sense_id": "47c12c66-686b-31dc-bee6-e1b54c678a66",
                                                "text": "Holonyms: megacalorie < gigacalorie"
                                            },
                                            {
                                                "example_id": "070f115a-009c-4577-aeac-0ae0ee765d23",
                                                "sense_id": "47c12c66-686b-31dc-bee6-e1b54c678a66",
                                                "text": "Meronyms: calorie (small-calorie sense), small calorie, gram calorie, thermochemical calorie"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ca54bca-d5bc-4087-bf17-6859d0532a77",
