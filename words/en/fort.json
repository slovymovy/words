                },
                {
                    "sense_id": "bc55b769-bcad-3ad2-965e-7f67484fc1a2",
                    "sense_definition": "A permanent military base where soldiers live and train.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military_base",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was stationed at a remote <w>fort</w> in the desert for six months.",
                            "target_lang_translations": {
                                "ru": "Он служил в отдаленном <w>форте</w> в пустыне шесть месяцев.",
                                "zh": "他在沙漠中一个偏远的<w>军事基地</w>驻扎了六个月。"
                            }
                        },
                        {
                            "text": "The general visited the army <w>fort</w> to inspect the new recruits.",
                            "target_lang_translations": {
                                "ru": "Генерал посетил армейский <w>форт</w>, чтобы проинспектировать новобранцев.",
                                "zh": "将军视察了军队<w>驻地</w>以检阅新兵。"
                            }
                        }
                    ],
                    "synonyms": [
                        "base",
                        "camp"
                    ],
                    "common_phrases": [
                        "army fort"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянная военная база, где живут и тренируются солдаты.",
                        "zh": "士兵居住和训练的永久性军事基地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "форт",
                                "target_lang_sense_clarification": "военная база"
                            },
                            {
                                "target_lang_word": "гарнизон",
                                "target_lang_sense_clarification": "место дислокации войск"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "军事基地",
