                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68b823d4-1d53-4ab9-bc84-aa865605569d",
                                "sense_id": "6c0d2db0-30f6-38b6-b880-aa5caf470b65",
                                "text": "„Es war Nacht, aber in McGraws Billardsalon war die Uhrzeit kein Thema.“"
                            },
                            {
                                "example_id": "7a2d4430-6adf-446a-a4ab-9a1a01eea1db",
                                "sense_id": "6c0d2db0-30f6-38b6-b880-aa5caf470b65",
                                "text": "„Sowohl Brewer als auch Dai hatten ihn über die besondere Bedeutung dieses Gebäudes für die Wilden Tiger informiert, und beiden war kein weiteres Hauptquartier der Organisation bekannt; beide hatten ihn lediglich mit den Adressen einiger Nachtklubs, Bars und Billardsalons versorgt, wo Mitglieder der Bande sich trafen.“"
                            }
                        ],
