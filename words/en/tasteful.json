{
    "word_family": [
        "taste",
        "tastefully",
        "tastefulness",
        "tasteless",
        "distaste",
        "distasteful"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e6946370-e2ef-34ff-99d7-e1dc7597b42a",
                    "sense_definition": "Having or showing good judgment in what is attractive, elegant, or aesthetically pleasing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aesthetic_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire house was furnished in a quiet and <w>tasteful</w> manner.",
                            "target_lang_translations": {
                                "ru": "Весь дом был обставлен сдержанно и <w>со вкусом</w>."
                            }
                        },
                        {
                            "text": "She wore a <w>tasteful</w> outfit that was perfectly appropriate for the formal dinner.",
                            "target_lang_translations": {
                                "ru": "На ней был <w>изящный</w> наряд, идеально подходящий для официального ужина."
                            }
                        }
                    ],
                    "synonyms": [
                        "elegant"
                    ],
                    "antonyms": [
                        "garish",
                        "gaudy",
                        "tasteless"
                    ],
                    "common_phrases": [
                        "tasteful decor",
                        "tasteful choice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий хорошим эстетическим вкусом или сделанный с тонким вкусом, изящный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "со вкусом",
                                "target_lang_sense_clarification": "сделанный, подобранный с эстетическим вкусом"
                            },
                            {
                                "target_lang_word": "со вкусом сделанный",
                                "target_lang_sense_clarification": "характеризующий оформление или внешний вид"
                            },
                            {
                                "target_lang_word": "изящный",
                                "target_lang_sense_clarification": "элегантный, гармоничный"
                            },
                            {
                                "target_lang_word": "тонкий",
                                "target_lang_sense_clarification": "о вкусе, манере исполнения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48fb94b7-ea31-3b7d-b876-6ec5aa300e17",
                    "sense_definition": "Stylish, attractive, and conforming to current trends or fashion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aesthetic_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer showcased a range of <w>tasteful</w> evening dresses at the gala.",
                            "target_lang_translations": {
                                "ru": "На гала-вечере дизайнер представил коллекцию <w>стильных</w> вечерних платьев."
                            }
                        },
                        {
                            "text": "Guests admired the host's <w>tasteful</w> and modern clothing line.",
                            "target_lang_translations": {
                                "ru": "Гости восхищались <w>элегантной</w> и современной линией одежды ведущего."
                            }
                        }
                    ],
                    "synonyms": [
                        "chic",
                        "fashionable",
                        "trendy"
                    ],
                    "antonyms": [
                        "outmoded",
                        "unfashionable",
                        "untrendy"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used historically to mean fashionable or gay"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стильный, модный, привлекательный и соответствующий эстетическим стандартам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стильный",
                                "target_lang_sense_clarification": "модный, элегантный"
                            },
                            {
                                "target_lang_word": "элегантный",
                                "target_lang_sense_clarification": "изысканный в плане стиля или моды"
                            },
                            {
                                "target_lang_word": "модный",
                                "target_lang_sense_clarification": "соответствующий трендам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "755d0528-1bcb-3a85-9660-69853f171c6b",
                    "sense_definition": "Pleasing to the sense of taste; savory or delicious.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flavor_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soup was prepared with a variety of fresh and <w>tasteful</w> garden herbs.",
                            "target_lang_translations": {
                                "ru": "Суп был приготовлен с добавлением разнообразных свежих и <w>вкусных</w> огородных трав."
                            }
                        },
                        {
                            "text": "They gathered berries to create a <w>tasteful</w> dessert for the evening banquet.",
                            "target_lang_translations": {
                                "ru": "Они собрали ягоды, чтобы приготовить <w>аппетитный</w> десерт для вечернего банкета."
                            }
                        }
                    ],
                    "synonyms": [
                        "appetizing",
                        "delectable",
                        "delicious",
                        "tasty"
                    ],
                    "antonyms": [
                        "distasteful",
                        "unpalatable",
                        "yucky"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English for food flavor; replaced by tasty"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приятный на вкус; аппетитный, вкусный (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вкусный",
                                "target_lang_sense_clarification": "приятный на вкус"
                            },
                            {
                                "target_lang_word": "аппетитный",
                                "target_lang_sense_clarification": "вызывающий аппетит"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}