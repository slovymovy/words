                "senses": [
                    {
                        "sense_id": "ab29684c-57c1-395c-af08-a1ce5ae120b7",
                        "entry_id": "01ffbb56-9b6c-3b80-8f7d-e3a96b1a32c4",
                        "glosses": [
                            "Gebäude mit der Dienstwohnung des Kirchendieners"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c14e8a31-6e1d-494b-a676-13470239222a",
                                "sense_id": "ab29684c-57c1-395c-af08-a1ce5ae120b7",
                                "text": "„Im Mesnerhaus, einem zierlichen Anbau an der Südwand, beginnt die Turmtreppe (die Türmerstube liegt 72 Meter hoch).“"
                            },
                            {
                                "example_id": "e4005a0a-6732-455d-ad95-174e0704ffd2",
                                "sense_id": "ab29684c-57c1-395c-af08-a1ce5ae120b7",
                                "text": "„Es ist ein Schock für die Neufahrner und ein schwerer Rückschlag für die Ortsplanung: In der Nacht zum Mittwoch hat es im denkmalgeschützten Mesnerhaus an der Dietersheimer Straße gebrannt.“"
                            },
                            {
                                "example_id": "4b86ed4b-dcd0-4bd5-8d89-fb0f2b89ac80",
                                "sense_id": "ab29684c-57c1-395c-af08-a1ce5ae120b7",
                                "text": "„Beide haben nach Hausdurchsuchungen in Klausen mit ihren Knechten, wie zwischen König Ferdinand dem Landesfürsten und Bischof Georg von Brixen vereinbart, noch das landesfürstliche Gufidaun durchsucht, sind dort in das Mesnerhaus eingedrungen und haben die drei festgenommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
