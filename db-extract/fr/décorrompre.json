                "senses": [
                    {
                        "sense_id": "a2c25bfa-1143-3a2e-a814-d486d6540501",
                        "entry_id": "74044adb-ec60-303e-84d1-6963a8d76e8f",
                        "glosses": [
                            "Faire perdre son caractère corrompu à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caf03109-b062-4aee-a67b-d6f4374ee5e4",
                                "sense_id": "a2c25bfa-1143-3a2e-a814-d486d6540501",
                                "text": "J'imagine qu'il n'y a rien a faire pour \"décorrompre\" la sauvegarde ?"
                            },
                            {
                                "example_id": "b59a8b05-5210-42d7-b77d-6f6d8cab20b2",
                                "sense_id": "a2c25bfa-1143-3a2e-a814-d486d6540501",
                                "text": "Une astuce pour décorrompre vos sauvegardes suite à un bannissement."
                            },
                            {
                                "example_id": "566d5135-0f25-43cb-be60-dc9c0b6b1d50",
                                "sense_id": "a2c25bfa-1143-3a2e-a814-d486d6540501",
                                "text": "Les techniques ci-dessous décrivent comme décorrompre un profil mais il en est de même pour vos saves."
                            },
                            {
                                "example_id": "72f9ae53-772b-48f2-b9fd-3b0ecfec85ee",
                                "sense_id": "a2c25bfa-1143-3a2e-a814-d486d6540501",
                                "text": "Une astuce pour décorrompre vos sauvegardes suite à un bannissement"
                            },
                            {
                                "example_id": "7dcd0e81-ac44-492e-a83f-caca41b7fa4d",
                                "sense_id": "a2c25bfa-1143-3a2e-a814-d486d6540501",
                                "text": "Comme ça nous aurons des camarades dans toute la France pour tracter et faire d'autres actions pour \"décorrompre\" la jeunesse française."
                            },
                            {
                                "example_id": "59e1364a-e0dd-479b-b291-b63ee7c27ac0",
                                "sense_id": "a2c25bfa-1143-3a2e-a814-d486d6540501",
                                "text": "Comment décorrompre un corrompu ?"
                            }
                        ]
                    }
