                "senses": [
                    {
                        "sense_id": "79714a5c-b90e-32f0-a58b-fae795e623de",
                        "entry_id": "67c67a98-3a15-342a-b7af-9303b82d8196",
                        "glosses": [
                            "Faire se stabiliser par ses propres moyens."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "da85ca10-3963-3ba8-8492-e43ccca83641",
                        "entry_id": "67c67a98-3a15-342a-b7af-9303b82d8196",
                        "glosses": [
                            "Se stabiliser de soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "d7cbe5e9-27ea-4cb2-842d-16e881307ba5",
                                "sense_id": "da85ca10-3963-3ba8-8492-e43ccca83641",
                                "text": "La conviction profonde des économistes contemporains, c'est que l'économie est un système capable de s'auto-stabiliser."
                            },
                            {
                                "example_id": "c1332618-3e0a-4e4f-8811-f3db99ab8d7a",
                                "sense_id": "da85ca10-3963-3ba8-8492-e43ccca83641",
                                "text": "Il s'agit de molécules instables d'oxygène qui prennent les électrons d'autres molécules pour s'auto-stabiliser."
                            },
                            {
                                "example_id": "d0d79717-0f4e-42ec-92f2-d45c09873e87",
                                "sense_id": "da85ca10-3963-3ba8-8492-e43ccca83641",
                                "text": "Ce Quadri sait s'auto-stabiliser dès qu'on lève les pouces de l'écran tactile de l'Ibidule (iphone, ipod ou ipad)."
                            }
                        ]
                    }
