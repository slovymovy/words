                                            {
                                                "example_id": "53aa1082-3812-4a99-8aa8-7f3bc7ef68c2",
                                                "sense_id": "832d4e09-1d5e-33c0-976b-1419ee36b4f4",
                                                "text": "From what I vaguely saw earlier this morning, when I had just woken up and was tidying my bed, a tall, bulky person left an unfamiliar box at my front door."
                                            },
                                            {
                                                "example_id": "66617a2a-9a22-4aec-ae4c-851b321c76f9",
                                                "sense_id": "832d4e09-1d5e-33c0-976b-1419ee36b4f4",
                                                "text": "I shall be late because I didn't start earlier."
                                            },
                                            {
                                                "example_id": "c56ed45a-6db7-4dab-b6b6-4bfdbdac64a2",
                                                "sense_id": "832d4e09-1d5e-33c0-976b-1419ee36b4f4",
                                                "text": "They were looking for some measuring equipment they had placed in the ice earlier."
                                            }
