                        "examples": [
                            {
                                "example_id": "8e1217aa-05b9-4d8a-a0b0-e1b74569f72e",
                                "sense_id": "dca15d12-929c-3ce8-ae9a-007341b2f7ee",
                                "text": "Um das Ziel zu erreichen, ist die Bündelung aller Kräfte vonnöten."
                            },
                            {
                                "example_id": "6139531a-3956-461a-99f2-da4b2f8e35d7",
                                "sense_id": "dca15d12-929c-3ce8-ae9a-007341b2f7ee",
                                "text": "„Bei der reinen Bündelung bietet das Unternehmen ausschließlich das Paket an, so dass der Erwerb der einzelnen Bündelkomponenten nicht möglich ist. Der Konsument kann lediglich zwischen Kauf und Nichtkauf entscheiden.“"
                            }
                        ],
