                "senses": [
                    {
                        "sense_id": "c112ac7a-caef-36be-a084-9f6ebe7c6fe3",
                        "entry_id": "642855dc-d90b-3109-92c2-8375f3b91336",
                        "glosses": [
                            "Having lots of oof (money); rich, wealthy."
                        ],
                        "tags": [
                            "British",
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e4da7d8e-d1cd-4315-b354-84c5e48c27e5",
                                "sense_id": "c112ac7a-caef-36be-a084-9f6ebe7c6fe3",
                                "text": "How lucky for me she never can have heard of the glorious Tinman, or my oofy maiden-aunt; wouldn't she have jumped at me, if she had?"
                            },
                            {
                                "example_id": "2ed425e4-3d2d-4e9a-b5e4-6622d1e0809a",
                                "sense_id": "c112ac7a-caef-36be-a084-9f6ebe7c6fe3",
                                "text": "Money isn't everything in this world. Youth and love and pluck are the main things. Hang it, what if you do get into debt occasionally? You've got a pretty oofy father-in-law."
                            },
                            {
                                "example_id": "75ddd140-fe1e-42a4-a349-31c53204cf18",
                                "sense_id": "c112ac7a-caef-36be-a084-9f6ebe7c6fe3",
                                "text": "This Tom has a peculiarity I've noticed in other very oofy men. Nick him for the paltriest sum, and he lets out a squawk you can hear at Land's End. He has the stuff in gobs, but he hates giving up."
                            }
                        ]
                    }
                ],
