                "senses": [
                    {
                        "sense_id": "0b12576d-64c2-3d96-9ddc-5327747a65e9",
                        "entry_id": "edaff21c-07d9-3946-bf91-f8aff0071a59",
                        "glosses": [
                            "A question mark."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "14b4ebed-14fe-4982-b857-19f01cb44437",
                                "sense_id": "0b12576d-64c2-3d96-9ddc-5327747a65e9",
                                "text": "1858, Goold Brown, The Grammar of English Grammars, fourth edition, Samuel S. and William Wood, page 798,\nThe value of the eroteme as a sign of pause, is stated very differently by different grammarians.... J.S. Hart avers, that, \"A question is reckoned as equal to a complete sentence, and the mark of interrogation as equal to a period.\""
                            },
                            {
                                "example_id": "979c6cb3-9e1e-46fa-8e8f-f17782267a0d",
                                "sense_id": "0b12576d-64c2-3d96-9ddc-5327747a65e9",
                                "text": "The note of interrogation or eroteme is used at the end of a sentence to designate (1) a single question or (2) more, and (3) is sometimes written in parentheses to express a doubt or challenge the accuracy of a statement."
                            },
                            {
                                "example_id": "b7c76c8f-606d-4943-8d09-4dcf2bface8a",
                                "sense_id": "0b12576d-64c2-3d96-9ddc-5327747a65e9",
                                "text": "On the typewriter keyboard, just below the question mark (the eroteme, note of interrogation, or uncertainty sign), there appears a short, slanting stroke […]"
                            }
                        ]
                    }
                ],
