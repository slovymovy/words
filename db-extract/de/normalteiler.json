                                "sense_id": "7c368f5b-1637-3dc3-a4ee-216eba17b991",
                                "text": "Das Zentrum und die Kommutatorgruppe einer Gruppe sind stets Normalteiler von ihr."
                            },
                            {
                                "example_id": "2d6ac124-2cc9-4a1d-9a19-7b2a7a960fbc",
                                "sense_id": "7c368f5b-1637-3dc3-a4ee-216eba17b991",
                                "text": "Die Untergruppen einer kommutativen Gruppe sind trivialerweise stets zugleich Normalteiler."
                            }
                        ],
                        "sense_index_json": "\"1\""
