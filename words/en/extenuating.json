{
    "word_family": [
        "extenuate",
        "extenuation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c58ca8cb-e9bd-300c-9fc9-0545fabea414",
                    "sense_definition": "Lessening the seriousness of a fault or crime by providing a partial excuse or justification.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mitigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge considered the <w>extenuating</w> circumstances before deciding on a lighter sentence for the defendant.",
                            "target_lang_translations": {
                                "de": "Der Richter berücksichtigte die <w>mildernden</w> Umstände, bevor er sich für ein geringeres Strafmaß für den Angeklagten entschied."
                            }
                        },
                        {
                            "text": "Poverty is often cited as an <w>extenuating</w> factor in cases of petty theft.",
                            "target_lang_translations": {
                                "de": "Armut wird bei kleineren Diebstählen oft als ein <w>strafmildernder</w> Faktor angeführt."
                            }
                        }
                    ],
                    "synonyms": [
                        "mitigating"
                    ],
                    "antonyms": [
                        "aggravating"
                    ],
                    "common_phrases": [
                        "extenuating circumstances",
                        "extenuating factors"
                    ],
                    "target_lang_definitions": {
                        "de": "Die Schwere einer Verfehlung oder Straftat durch eine teilweise Entschuldigung oder Rechtfertigung mindernd."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "mildernd",
                                "target_lang_sense_clarification": "besonders vor Gericht bezüglich Umständen oder Faktoren"
                            },
                            {
                                "target_lang_word": "strafmildernd",
                                "target_lang_sense_clarification": "juristisch, das Strafmaß verringernd"
                            },
                            {
                                "target_lang_word": "entlastend",
                                "target_lang_sense_clarification": "die Schuld verringernd oder mildernd"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "75813739-c007-3f6e-820c-7d903a6a3e73",
                    "sense_definition": "Present participle and gerund of <w>extenuate</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mitigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire afternoon <w>extenuating</w> his poor performance by blaming the lack of proper equipment.",
                            "target_lang_translations": {
                                "de": "Er verbrachte den ganzen Nachmittag damit, seine schlechte Leistung zu <w>beschönigen</w>, indem er dem Mangel an geeigneter Ausrüstung die Schuld gab."
                            }
                        },
                        {
                            "text": "There is no point in <w>extenuating</w> the gravity of the situation when the facts are so clear.",
                            "target_lang_translations": {
                                "de": "Es hat keinen Sinn, den Ernst der Lage <w>herunterzuspielen</w>, wenn die Fakten so eindeutig sind."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb extenuate."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von „extenuate“ (beschönigen, mildern, herunterspielen)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "beschönigend",
                                "target_lang_sense_clarification": "etwas weniger schlimm darstellend"
                            },
                            {
                                "target_lang_word": "mildernd",
                                "target_lang_sense_clarification": "die Schwere verringernd"
                            },
                            {
                                "target_lang_word": "herunterspielend",
                                "target_lang_sense_clarification": "die Bedeutung oder Ernsthaftigkeit verkleinernd"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}