                        "glosses": [
                            "Qui peut être désarmé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dd306b8-1539-4a02-9b1f-8d3b08d23fd8",
                                "sense_id": "d4540b60-8218-30dd-8af7-eea572fa9f66",
                                "text": "Abdas avoit des ennemis par le fond, Moursa s’en faisoit par les formes.\nLe premier ne leur pardonnoit jamais, le second étoit accessible à une parole du cœur, ou à une attention de la politesse : l’un implacable, l’autre, en tout ce qui ne lésoit pas l’honneur, désarmable par une avance."
                            },
                            {
                                "example_id": "a606f717-a685-43d2-b35b-2c0946568c5f",
                                "sense_id": "d4540b60-8218-30dd-8af7-eea572fa9f66",
                                "text": "Il fallait que la résistance soit armée pour qu’elle existe. Mais pas trop. Et désarmable, par de Gaulle — ce que seul il pouvait faire au moindre risque — dans l’acte même de sa prise de pouvoir."
                            },
                            {
                                "example_id": "0636679e-bfb4-4822-b8c1-8a4c7697df12",
                                "sense_id": "d4540b60-8218-30dd-8af7-eea572fa9f66",
                                "text": "Le système est armable et désarmable à partir du clavier, de badge RFID (pour les animaux de compagnie par exemple), d’une télécommande, d’un smartphone."
                            }
                        ]
                    }
