                                                "example_id": "1b048632-1d3e-4601-b7b6-bd48f6179f62",
                                                "sense_id": "e20d94a9-b670-3db7-bce1-77026373d808",
                                                "text": "For then their late Attracts decline,\nAnd turn as eager as prick'd Wine"
                                            }
