                                "example_id": "bb50e225-ee6d-4f2d-80ab-81ff690c63af",
                                "sense_id": "891ca6bf-687a-3d5e-9b23-dfbf7e6bdfff",
                                "text": "„Wegen dieses Bisses hat sich nun eine 46-jährige Hundehalterin vor einer Einzelrichterin des Bezirksgerichts Zürich verantworten müssen.“"
                            },
                            {
                                "example_id": "72708b83-201e-40e4-ab49-65665b8a4341",
                                "sense_id": "891ca6bf-687a-3d5e-9b23-dfbf7e6bdfff",
                                "text": "„Gegen die Hundehalterin wurde ein Strafverfahren wegen eines Vergehens nach dem Tierschutzgesetz eingeleitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
