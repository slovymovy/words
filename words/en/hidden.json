    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a4126ec0-bbf5-3972-9962-4f2ce30e5bf8",
                    "sense_definition": "Located or positioned out of sight; not visually apparent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pirates buried their <w>hidden</w> treasure on a remote island.",
                            "target_lang_translations": {
                                "ru": "Пираты закопали своё <w>спрятанное</w> сокровище на отдалённом острове.",
                                "zh": "海盗们把他们<w>隐藏的</w>财宝埋在了一个偏远的岛上。"
                            }
                        },
                        {
                            "text": "She discovered a <w>hidden</w> talent for painting after taking a casual art class.",
                            "target_lang_translations": {
                                "ru": "Она обнаружила у себя <w>скрытый</w> талант к живописи после посещения любительского урока рисования.",
                                "zh": "在参加了一门随意的艺术课后，她发现了自己<w>潜在的</w>绘画天赋。"
                            }
                        }
                    ],
                    "synonyms": [
                        "concealed",
                        "invisible",
                        "obscured",
                        "secret",
                        "veiled",
                        "unseen",
                        "covered."
                    ],
                    "antonyms": [
                        "visible",
                        "apparent",
                        "open",
                        "overt"
                    ],
                    "common_phrases": [
                        "hidden treasure",
                        "hidden agenda",
                        "hidden talent",
                        "hidden meaning",
                        "hidden camera"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся вне поля зрения; невидимый или скрытый от глаз.",
                        "zh": "位于视线之外；不显眼或难以察觉的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрытый",
                                "target_lang_sense_clarification": "невидимый, тайный"
                            },
                            {
                                "target_lang_word": "спрятанный",
                                "target_lang_sense_clarification": "убранный с глаз"
                            },
                            {
                                "target_lang_word": "потаённый",
                                "target_lang_sense_clarification": "секретный, сокровенный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "隐藏的",
                                "target_lang_sense_clarification": "处于被遮盖或不明显的状态"
                            },
                            {
                                "target_lang_word": "隐蔽的",
                                "target_lang_sense_clarification": "难以发现的，常指位置"
                            },
                            {
                                "target_lang_word": "潜在的",
                                "target_lang_sense_clarification": "指能力或意义等不显露的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "07e5c8a8-fef2-3bfc-adac-7d9f890b6d10",
                    "sense_definition": "The past participle of <w>hide</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has <w>hidden</w> the birthday gifts in the closet so the children won't find them.",
                            "target_lang_translations": {
                                "ru": "Он <w>спрятал</w> подарки на день рождения в шкаф, чтобы дети их не нашли.",
                                "zh": "他把生日礼物<w>藏</w>在衣柜里，这样孩子们就找不到了。"
                            }
                        },
                        {
                            "text": "The sun was <w>hidden</w> behind the thick grey clouds all afternoon.",
                            "target_lang_translations": {
                                "ru": "Солнце было <w>скрыто</w> за густыми серыми тучами всю вторую половину дня.",
                                "zh": "整个下午太阳都<w>隐藏</w>在厚厚的灰云后面。"
                            }
                        }
                    ],
                    "synonyms": [
                        "concealed",
                        "covered"
                    ],
                    "common_phrases": [
                        "hidden away"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола hide (прятать, скрывать).",
                        "zh": "动词 hide 的过去分词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спрятанный",
                                "target_lang_sense_clarification": "причастие от «прятать»"
                            },
                            {
                                "target_lang_word": "скрытый",
                                "target_lang_sense_clarification": "причастие от «скрывать»"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "藏",
                                "target_lang_sense_clarification": "动作的完成状态"
                            },
                            {
                                "target_lang_word": "隐藏",
                                "target_lang_sense_clarification": "动作的完成状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cb55d64b-f9ac-36db-b218-1d9d1fc240b2",
                    "sense_definition": "A crossword puzzle clue in which the answer is spelled out consecutively within the words of the clue.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crossword setter included several <w>hiddens</w> in today's puzzle that were tricky to spot.",
                            "target_lang_translations": {
                                "ru": "Составитель кроссворда включил в сегодняшнюю головоломку несколько <w>спрятанных слов</w>, которые было трудно заметить.",
                                "zh": "填字游戏设计者在今天的谜题中加入了一些很难发现的<w>隐藏词</w>。"
                            }
                        },
                        {
                            "text": "I usually solve anagrams quickly, but <w>hiddens</w> often take me a bit longer to identify.",
                            "target_lang_translations": {
                                "ru": "Я обычно быстро разгадываю анаграммы, но <w>спрятанные слова</w> часто требуют у меня немного больше времени для поиска.",
                                "zh": "我通常很快就能解开变位词，但识别<w>隐藏词</w>往往需要我更长的时间。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подсказка в кроссворде, в которой ответ зашифрован последовательностью букв внутри слов самой подсказки.",
                        "zh": "一种填字游戏线索，答案按顺序隐藏在提示词语中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спрятанное слово",
                                "target_lang_sense_clarification": "кроссворд: ответ скрыт внутри слов подсказки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "隐藏词",
                                "target_lang_sense_clarification": "填字游戏中嵌入在提示语里的答案"
                            }
                        ]
                    }
                }
            ]
        },
