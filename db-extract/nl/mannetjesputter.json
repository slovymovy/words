                    {
                        "sense_id": "8b3d8ed4-544c-3b9b-bbb6-a6ba09048b9f",
                        "entry_id": "a77f391d-cf75-3fed-8860-18de5e442beb",
                        "glosses": [
                            "een flinke, grote, stoere man"
