{
    "word_family": [
        "transcribe",
        "transcriber",
        "transcriptional",
        "transcript",
        "transcriptase"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "390c0ce1-1b7e-37ef-a0f7-2176b0a8484a",
                    "sense_definition": "The act or process of putting something into written or printed form, such as speech, data, or a different script.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>transcription</w> of the interview took several hours to complete accurately.",
                            "target_lang_translations": {
                                "ru": "<w>Расшифровка</w> интервью заняла несколько часов, чтобы выполнить её точно."
                            }
                        },
                        {
                            "text": "Errors in the <w>transcription</w> process can lead to significant misunderstandings of the original data.",
                            "target_lang_translations": {
                                "ru": "Ошибки в процессе <w>переписывания</w> данных могут привести к серьезному неправильному пониманию оригинала."
                            }
                        }
                    ],
                    "synonyms": [
                        "copying",
                        "recording"
                    ],
                    "common_phrases": [
                        "accurate transcription",
                        "process of transcription",
                        "verbatim transcription"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс перевода чего-либо в письменную или печатную форму, например, речи, данных или другого шрифта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расшифровка",
                                "target_lang_sense_clarification": "процесс перевода аудио в текст"
                            },
                            {
                                "target_lang_word": "стенограмма",
                                "target_lang_sense_clarification": "результат записи речи"
                            },
                            {
                                "target_lang_word": "переписывание",
                                "target_lang_sense_clarification": "процесс копирования текста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cda6546-8db9-3aa7-8831-97ffec7b1f32",
                    "sense_definition": "A representation of speech sounds using a specific system of phonetic symbols.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictionary provides a phonetic <w>transcription</w> for every entry to help with pronunciation.",
                            "target_lang_translations": {
                                "ru": "Словарь предоставляет фонетическую <w>транскрипцию</w> для каждого слова, чтобы помочь с произношением."
                            }
                        },
                        {
                            "text": "Linguists use a standard <w>transcription</w> to document the unique sounds of endangered languages.",
                            "target_lang_translations": {
                                "ru": "Лингвисты используют стандартную <w>транскрипцию</w> для документирования уникальных звуков исчезающих языков."
                            }
                        }
                    ],
                    "synonyms": [
                        "notation"
                    ],
                    "common_phrases": [
                        "phonetic transcription",
                        "broad transcription",
                        "narrow transcription"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Представление звуков речи с использованием специальной системы фонетических символов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "транскрипция",
                                "target_lang_sense_clarification": "фонетическая запись звуков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40ddc562-69da-3d38-9713-f147cc12df7c",
                    "sense_definition": "An arrangement or adaptation of a musical composition for a different instrument or voice than originally intended.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pianist performed a beautiful <w>transcription</w> of the orchestral symphony.",
                            "target_lang_translations": {
                                "ru": "Пианист исполнил прекрасную <w>транскрипцию</w> оркестровой симфонии."
                            }
                        },
                        {
                            "text": "A musical <w>transcription</w> allows a solo instrument to play complex pieces written for a full band.",
                            "target_lang_translations": {
                                "ru": "Музыкальное <w>переложение</w> позволяет сольному инструменту исполнять сложные произведения, написанные для целого оркестра."
                            }
                        }
                    ],
                    "synonyms": [
                        "arrangement",
                        "adaptation"
                    ],
                    "common_phrases": [
                        "musical transcription",
                        "piano transcription"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аранжировка или адаптация музыкального произведения для инструмента или голоса, отличных от первоначально задуманных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "транскрипция",
                                "target_lang_sense_clarification": "музыкальное переложение"
                            },
                            {
                                "target_lang_word": "переложение",
                                "target_lang_sense_clarification": "адаптация для другого инструмента"
                            },
                            {
                                "target_lang_word": "аранжировка",
                                "target_lang_sense_clarification": "обработка музыкального произведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2fd0560-d2ff-3d18-ab4a-862bac5f29a4",
                    "sense_definition": "The biological process by which the information in a strand of DNA is copied into a new molecule of messenger RNA.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During <w>transcription</w>, the DNA sequence is read by an enzyme to produce a complementary RNA strand.",
                            "target_lang_translations": {
                                "ru": "Во время <w>транскрипции</w> последовательность ДНК считывается ферментом для создания комплементарной цепи РНК."
                            }
                        },
                        {
                            "text": "The regulation of gene <w>transcription</w> is a fundamental aspect of cellular function.",
                            "target_lang_translations": {
                                "ru": "Регуляция <w>транскрипции</w> генов является фундаментальным аспектом функционирования клетки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gene transcription",
                        "DNA transcription"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Биологический процесс, при котором информация из цепи ДНК копируется в новую молекулу информационной РНК."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "транскрипция",
                                "target_lang_sense_clarification": "синтез РНК на матрице ДНК"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e11c2df6-ed0d-3d2b-bdc8-5c6147f5c4ed",
                    "sense_definition": "A recorded radio or television program intended for later broadcast.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the early days of radio, many shows were distributed to local stations via electrical <w>transcription</w> discs.",
                            "target_lang_translations": {
                                "ru": "На заре радиовещания многие шоу распространялись по местным станциям на дисках для электрической <w>записи</w>."
                            }
                        },
                        {
                            "text": "The archive contains a rare <w>transcription</w> of the 1940s broadcast.",
                            "target_lang_translations": {
                                "ru": "В архиве хранится редкая <w>запись</w> эфира 1940-х годов."
                            }
                        }
                    ],
                    "synonyms": [
                        "recording"
                    ],
                    "common_phrases": [
                        "radio transcription",
                        "electrical transcription"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "referring to older media formats"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Записанная радио- или телепрограмма, предназначенная для последующей трансляции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запись",
                                "target_lang_sense_clarification": "архивная радиопередача"
                            },
                            {
                                "target_lang_word": "транскрипция",
                                "target_lang_sense_clarification": "электрическая запись для радио"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}