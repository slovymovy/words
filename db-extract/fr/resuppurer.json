                        "entry_id": "c0ffc9e1-29c1-354f-9c16-5a8ad70d8c0c",
                        "glosses": [
                            "Suppurer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "718bc20c-149b-482d-8739-f91c2b0083c7",
                                "sense_id": "c58b2f2f-9e4f-372f-b013-300cc7121e1a",
                                "text": "A l'intérieur de la France, il existe des frontières qui sont pour le moment des cicatrices qui ne suppurent pas mais qui pourraient resuppurer demain si la France se défait."
                            },
                            {
                                "example_id": "8d439e55-8f96-4da6-8039-632a40f95ad4",
                                "sense_id": "c58b2f2f-9e4f-372f-b013-300cc7121e1a",
                                "text": "Que dalle, ça fait un mois que ça suppure, se referme, regonfle, resuppure, c'est franchement crade."
                            }
                        ]
                    }
