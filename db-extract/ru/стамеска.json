                                    },
                                    {
                                        "sense_id": "a27361eb-683c-3bc1-8866-2d738c6fccef",
                                        "entry_id": "adcb45ba-b608-3ac0-9a7a-cfd805c5d382",
                                        "glosses": [
                                            "To make small changes to (something), bit by bit, resulting in change over time."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
