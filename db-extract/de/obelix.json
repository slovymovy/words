                "senses": [
                    {
                        "sense_id": "f3d81cfc-c38b-32dd-b81a-f52a9e102c9b",
                        "entry_id": "a7cb73d3-4f08-36b1-9dd3-70a573188251",
                        "glosses": [
                            "Figur aus der Comicserie Asterix und Obelix von René Goscinny und Albert Uderzo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4304d4a-9cfc-4ed7-a529-d776a486723b",
                                "sense_id": "f3d81cfc-c38b-32dd-b81a-f52a9e102c9b",
                                "text": "Obelix ist als Kind in einen Kessel mit Zaubertrank gefallen."
                            },
                            {
                                "example_id": "ab6bc879-49b8-4567-8d0c-b23a00114e8e",
                                "sense_id": "f3d81cfc-c38b-32dd-b81a-f52a9e102c9b",
                                "text": "„Was ein Hinkelstein ist, das weiß noch jeder, der in seiner Jugend (oder auch später) „Asterix und Obelix“ gelesen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
