                                "example_id": "2d44913e-0821-459c-94c8-0251a5d10832",
                                "sense_id": "97cb198c-a53c-3873-9525-ab833160af10",
                                "text": "Je clarinette un peu … le dimanche."
                            },
                            {
                                "example_id": "20c6015b-6c9f-4349-b987-c80c0736a3c8",
                                "sense_id": "97cb198c-a53c-3873-9525-ab833160af10",
                                "text": "Je clarinette depuis quelques années après avoir voyagé sur moults instruments et là je jubile d'une Selmer basse qui descend au do !!"
                            },
                            {
                                "example_id": "068770de-3365-42f6-8b6a-569a3f950c40",
                                "sense_id": "97cb198c-a53c-3873-9525-ab833160af10",
                                "text": "Elle trompette, elle claironne, elle clarinette, elle tambourine sur tous les tons et elle est vraiment dans le ton la bougresse."
                            }
                        ]
                    }
