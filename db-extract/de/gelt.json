            {
                "entry_id": "94960dc4-96fb-3c83-b499-e7c402d088bf",
                "word": "gelt",
                "pos": "particle",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a71fbcc5-e9db-3adb-8d66-f32814ebb8a6",
                        "entry_id": "94960dc4-96fb-3c83-b499-e7c402d088bf",
                        "glosses": [
                            "süddeutsch, verschliffene Floskel für die eingeschobene, rhetorische Frage „gelt es?“, „gilt es?“, „habe ich recht?“ oder „nicht wahr?“, „stimmt es?“, um sich der (vorausgesetzten) Zustimmung zu versichern. Die Frage wird nicht oder nur mit der gleichen Floskel beantwortet."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "caf29966-d549-4774-bf78-5bc72f268553",
                                "sense_id": "a71fbcc5-e9db-3adb-8d66-f32814ebb8a6",
                                "text": "„Schönes Wetter heute, gelt?“ „Draußen, gelt?“"
                            },
                            {
                                "example_id": "3da42b1c-3c6e-4c87-adca-d7d2467892eb",
                                "sense_id": "a71fbcc5-e9db-3adb-8d66-f32814ebb8a6",
                                "text": "„Gelt, mein Schatz, es tut dich kränken“ (Titel eines Volksliedes aus dem Raum Thüringen/Franken)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
