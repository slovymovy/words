                                        "entry_id": "c01b2bd8-c5a6-366e-8710-d79e0be1900b",
                                        "glosses": [
                                            "Participe présent de ruminer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
