                "translations": [
                    {
                        "translation_id": "c2e54b34-ddc6-4f75-ac87-d52e33d16e0d",
                        "source_entry_id": "4000358a-e454-39ef-af76-b6571b68a422",
                        "source_sense_id": "5928fba3-66c8-3b67-8dfc-e31d8dc6052c",
                        "source_sense_description": "veraltete Bedeutung, Biochemie: Enzym, Ferment",
                        "target_lang_word": "Enzym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Enzym",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b691f8c1-a498-34e3-9dae-00c656208e90",
                                        "entry_id": "f2db8abd-3814-3fc6-a789-433cde82ddeb",
                                        "glosses": [
                                            "ein Protein, das als Katalysator fungiert, also chemische Reaktionen beschleunigt oder überhaupt erst ermöglicht"
                                        ],
                                        "tags": [
                                            "Biochemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c07065a-d119-48e4-85a3-3978d67c83eb",
                                                "sense_id": "b691f8c1-a498-34e3-9dae-00c656208e90",
                                                "text": "Das Enzym Pepsin ist für die Spaltung von mit der Nahrung aufgenommenen Eiweißen verantwortlich."
                                            },
                                            {
                                                "example_id": "c38256fe-6a7d-415e-99af-4af74c61e484",
                                                "sense_id": "b691f8c1-a498-34e3-9dae-00c656208e90",
                                                "text": "„Hofmeister, obwohl im kleinen Kreis kommunikativ und lieberal im Labor … suchte eher die Einsamkeit und betrachtete die menschliche Gesellschaft skeptisch ja verachtend, nur selten ließ er sich auf Tagungen blicken. So wird sein wissenschaftlicher Beitrag eher unterschätzt, und es ist wohl nicht verfehlt, hier hervorzuheben, daß Hofmeister der erste war, der – im Gegensatz zu Fischer Proteine als verschiedenartige, chemisch genau definierte Substanzen betrachtete und ihre entscheidende Funktion als Enzyme wenigstens ahnte. So prophezeite er, daß alle biochemischen Reaktionen der Zelle durch jeweils für sie spezifische Enzyme kontrolliert würden. “"
                                            },
                                            {
                                                "example_id": "23817135-eb6e-4829-b3c3-cc7431f5d16f",
                                                "sense_id": "b691f8c1-a498-34e3-9dae-00c656208e90",
                                                "text": "„Seit Jahrtausenden nutzen Menschen die Wirkung von Enzymen: Ohne sie gäbe es keinen Joghurt, keinen Wein, kein Bier.“"
                                            },
                                            {
                                                "example_id": "89674ab4-82ec-430b-a89a-6e2918e3775d",
                                                "sense_id": "b691f8c1-a498-34e3-9dae-00c656208e90",
                                                "text": "„Mein Vater extrahierte Enzyme aus Pflanzen, und meine Mutter vergiftete Frösche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbd6821f-fcb2-4f0d-bab8-dd8c4ecb40c2",
                        "source_entry_id": "4000358a-e454-39ef-af76-b6571b68a422",
                        "source_sense_id": "5928fba3-66c8-3b67-8dfc-e31d8dc6052c",
                        "source_sense_description": "veraltete Bedeutung, Biochemie: Enzym, Ferment",
                        "target_lang_word": "Ferment",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ferment",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89b1ad30-8980-35fc-9050-7b84d830a87e",
                                        "entry_id": "473f7e2e-9d0d-3de2-96dc-e40358710e38",
                                        "glosses": [
                                            "Substanz, die im pflanzlichen, tierischen und menschlichen Organismus gebildet wird und bestimmte chemische Umwandlungen im Körper beschleunigt"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75e28055-9451-4ea2-8ea1-fd0d5df50620",
                                                "sense_id": "89b1ad30-8980-35fc-9050-7b84d830a87e",
                                                "text": "„Bei der Käseherstellung wirkt das Labferment mit, ein Enzym, das aus Kälbermägen gewonnen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "690ea4a7-02f5-3931-abf6-9eb7fbc5e8b6",
                                        "entry_id": "473f7e2e-9d0d-3de2-96dc-e40358710e38",
                                        "glosses": [
                                            "vorwärtstreibendes, beschleunigendes, gärendes Element"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26adfab7-f79b-4fbe-bafd-b6a1812c3490",
                                                "sense_id": "690ea4a7-02f5-3931-abf6-9eb7fbc5e8b6",
                                                "text": "„aber wo »politische Öffentlichkeit« entsteht, verliert man im dissonanten Vielerlei fast aus dem Blick. Sie aber ist das Ferment aller Demokratie.“"
                                            },
                                            {
                                                "example_id": "b24feb65-e130-46fb-bb6c-f05e70e7606d",
                                                "sense_id": "690ea4a7-02f5-3931-abf6-9eb7fbc5e8b6",
                                                "text": "„Kultur ist ein wesentliches Ferment dessen, was Dilthey die Ichwerdung nannte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
