                "senses": [
                    {
                        "sense_id": "a3edd597-6cd0-3b92-86b7-224f02a84dea",
                        "entry_id": "ede89f44-891e-39dd-ab34-b2d32a315d54",
                        "glosses": [
                            "To free from pauperism, or from paupers."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "083b9e3c-620f-497b-b528-b72bfd92785d",
                                "sense_id": "a3edd597-6cd0-3b92-86b7-224f02a84dea",
                                "text": "Thomas Whately, of Cookham, a clergyman, to whom the country is much indebted for the example he has set in dispauperizing that parish, gave me a list of books, forming a tolerable library, which were in circulation amongst his parishioners of the labouring classes, by whom they are eagerly read […]"
                            },
                            {
                                "example_id": "76f6fcf9-e489-4524-87a2-f72db669a3bc",
                                "sense_id": "a3edd597-6cd0-3b92-86b7-224f02a84dea",
                                "text": "In all our more recent reports from the dispauperized parishes, it is stated that the wages are improved, and that the amount paid is greater than in the adjacent pauperized parishes."
                            },
                            {
                                "example_id": "89916ea4-fdd2-4d57-9d41-184523674c88",
                                "sense_id": "a3edd597-6cd0-3b92-86b7-224f02a84dea",
                                "text": "How unsatisfactory would have been that attempt to dispauperize the labourer, if the operation of the Act had been limited to some of the worst regulated parishes!"
                            }
                        ]
                    }
                ],
