                                "target_senses": [
                                    {
                                        "sense_id": "ef8f4cf9-9c2f-30c2-8a6e-679751577c94",
                                        "entry_id": "962cfc27-c067-3c5e-8d38-f720739748b3",
                                        "glosses": [
                                            "A public square, especially in Italian cities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dc7a20e-35df-4d61-b95b-d264e37a3024",
                                                "sense_id": "ef8f4cf9-9c2f-30c2-8a6e-679751577c94",
                                                "text": "Incidentally, the yard in front of the Granary, now a lovely piazza, was once a canal basin that had been filled in decades before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a64cf07-76ed-319a-8fda-512ce907f159",
                                        "entry_id": "962cfc27-c067-3c5e-8d38-f720739748b3",
                                        "glosses": [
                                            "A veranda; a porch."
                                        ],
                                        "tags": [
                                            "New-England",
                                            "US",
                                            "dated",
                                            "dialectal",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "295eea2c-e2c5-41f4-ac7a-3ddbfa5a36c9",
                                                "sense_id": "2a64cf07-76ed-319a-8fda-512ce907f159",
                                                "text": "Pretty soon I struck into a sort of path[…]. It twisted and turned,[…]and opened out into a big clear space like a lawn. And, back of the lawn, was a big, old-fashioned house, with piazzas stretching in front of it, and all blazing with lights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83e349fb-e69f-3fa7-9049-217bdf727249",
                                        "entry_id": "962cfc27-c067-3c5e-8d38-f720739748b3",
                                        "glosses": [
                                            "A roofed gallery or arcade (for example around a public square or in front of a building)."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
