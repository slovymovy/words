                        "entry_id": "4bb60e33-ead0-38ba-89a5-37d4b4749395",
                        "glosses": [
                            "Capable of being pulled or stretched into thin wire by mechanical force without breaking."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3dc36cd-e0c9-4210-8b82-015a563d5d12",
                                "sense_id": "4d0e85f7-95b6-3850-85bf-f0fea0c003f7",
                                "text": "ductile material"
                            },
                            {
                                "example_id": "0d011bee-3e80-4d56-a6c7-bd7b83876fc6",
                                "sense_id": "4d0e85f7-95b6-3850-85bf-f0fea0c003f7",
                                "text": "ductile shape"
                            },
                            {
                                "example_id": "9ad3d941-8470-4be1-815e-bc89c5202058",
                                "sense_id": "4d0e85f7-95b6-3850-85bf-f0fea0c003f7",
                                "text": "ductile alloy"
                            },
                            {
                                "example_id": "ac366059-4e61-4159-8b5f-c1d2c696b1c9",
                                "sense_id": "4d0e85f7-95b6-3850-85bf-f0fea0c003f7",
                                "text": "ductile state"
                            },
                            {
                                "example_id": "4d03ae73-e0d9-4c3a-bf88-fb322a0325a7",
                                "sense_id": "4d0e85f7-95b6-3850-85bf-f0fea0c003f7",
                                "text": "Gold is highly ductile, allowing it to be drawn into very fine wires."
                            },
                            {
                                "example_id": "97321fc2-c635-4eac-8684-dbb39182de89",
                                "sense_id": "4d0e85f7-95b6-3850-85bf-f0fea0c003f7",
                                "text": "The ductile nature of copper makes it essential in electrical wiring."
                            }
                        ]
                    },
                    {
                        "sense_id": "a34095e7-b3b9-3ba6-9b27-7fb1f92baba2",
                        "entry_id": "4bb60e33-ead0-38ba-89a5-37d4b4749395",
                        "glosses": [
                            "Molded easily into a new form."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88082d32-646d-45f6-a08e-ad044f628a99",
                                "sense_id": "a34095e7-b3b9-3ba6-9b27-7fb1f92baba2",
                                "text": "their organisation was, by hereditary culture, much more ductile and more readily capable of acquiring knowledge than mine."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6cb6943-dbc7-3c1f-aefa-1d09665a2ca2",
                        "entry_id": "4bb60e33-ead0-38ba-89a5-37d4b4749395",
                        "glosses": [
                            "Led easily; prone to follow."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e8af91f-f0f8-4154-b78e-0955851fc41e",
                        "source_entry_id": "4bb60e33-ead0-38ba-89a5-37d4b4749395",
                        "source_sense_description": "capable of being pulled or stretched into thin wire",
                        "target_lang_word": "ductile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ductile",
