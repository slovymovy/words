                "senses": [
                    {
                        "sense_id": "28a9e941-6b06-3a7b-9572-dafd603f5c52",
                        "entry_id": "37c988c4-d3ac-347c-8968-dc1cb03b3aff",
                        "glosses": [
                            "panikartiger Verkauf von Wertpapieren aus Angst vor stark fallenden Kursen"
                        ],
                        "tags": [
                            "Börsenwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "f5af942b-2bf5-4691-a405-aefef971380c",
                                "sense_id": "28a9e941-6b06-3a7b-9572-dafd603f5c52",
                                "text": "Panikverkäufe drückten den Dax erstmals seit 2016 unter die Marke von 10.000 Punkten. Auch in den USA kam es zu Panikverkäufen."
                            },
                            {
                                "example_id": "95e7a0d8-bda5-49ec-bd63-0a38e889bed4",
                                "sense_id": "28a9e941-6b06-3a7b-9572-dafd603f5c52",
                                "text": "Die Turbulenzen an den Börsen machen viele Anleger nervös. Panikverkäufe sind aber die falsche Reaktion."
                            },
                            {
                                "example_id": "7e3920f4-4dc1-4fbc-9580-98fc76fac37b",
                                "sense_id": "28a9e941-6b06-3a7b-9572-dafd603f5c52",
                                "text": "Im Gegensatz zur Baisse fallen die Kurse schneller und plötzlicher, ein Ausdruck von Panikverkäufen."
                            },
                            {
                                "example_id": "c33929d7-6950-4598-ae2d-1110c1987215",
                                "sense_id": "28a9e941-6b06-3a7b-9572-dafd603f5c52",
                                "text": "Um Panikverkäufe zu verhindern, mussten die Börsen am 30. Juli 1914 schließen."
                            },
                            {
                                "example_id": "2dbd29e5-76bc-4a0c-91fb-f120d53d60fe",
                                "sense_id": "28a9e941-6b06-3a7b-9572-dafd603f5c52",
                                "text": "Schnäppchenjäger halten auch nach Fehleinschätzungen Ausschau, und da Panikverkäufe Hand in Hand mit einem überwältigenden Gefühl der Angst gehen, sind sie quasi der Gipfel der Fehleinschätzung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
