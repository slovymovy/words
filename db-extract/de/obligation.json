                ],
                "senses": [
                    {
                        "sense_id": "294577bb-23c5-31b0-b02d-99645fefc24b",
                        "entry_id": "33408976-55eb-37c8-987d-3c55cdc2551f",
                        "glosses": [
                            "(finanzielle, vertragliche) Verpflichtung"
                        ],
                        "tags": [
                            "noch besonders im Schweizer Recht"
                        ],
                        "examples": [
                            {
                                "example_id": "8d346c3c-f443-405f-bc7e-e19a52f2cbde",
                                "sense_id": "294577bb-23c5-31b0-b02d-99645fefc24b",
                                "text": "„Die meisten Obligationen entstehen aus einem Rechtsgeschäft und die mit Abstand bedeutendste Obligation ist der Vertrag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a415f316-b320-310e-ae98-f0a53e1cdfb3",
                        "entry_id": "33408976-55eb-37c8-987d-3c55cdc2551f",
                        "glosses": [
                            "verzinsliches Wertpapier, meist mit festem Zinssatz"
                        ],
                        "tags": [
                            "finance"
                        ],
                        "examples": [
                            {
                                "example_id": "3330a30e-023f-4731-a251-4de8ca3a17f6",
                                "sense_id": "a415f316-b320-310e-ae98-f0a53e1cdfb3",
                                "text": "„Will der Staat sein »gewöhnliches« Defizit finanzieren, verkauft er Obligationen mit einer Laufzeit von 2, 5, 10 oder 30 Jahren.“"
                            },
                            {
                                "example_id": "057e6aa5-7cf2-4a93-80e1-34cedb9eb916",
                                "sense_id": "a415f316-b320-310e-ae98-f0a53e1cdfb3",
                                "text": "„Am gleichen Nachmittag werden im Bankhaus Wetzel Obligationen gegen eintausend Louisdor eingetauscht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1afd3cf-83e8-44e9-8ac8-8000f6899f22",
                        "source_entry_id": "33408976-55eb-37c8-987d-3c55cdc2551f",
                        "source_sense_id": "294577bb-23c5-31b0-b02d-99645fefc24b",
                        "source_sense_description": "noch besonders im Schweizer Recht: (finanzielle, vertragliche) Verpflichtung",
                        "target_lang_word": "verplichting",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verplichting",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b78322fd-038f-3762-94ee-e1bb887b5738",
                                        "entry_id": "9fd8a863-cf0f-370a-8c74-d8cbec3e023f",
                                        "glosses": [
                                            "iets dat moet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d524a534-5786-42ba-9ca5-e1b48fb94d1e",
                                                "sense_id": "b78322fd-038f-3762-94ee-e1bb887b5738",
                                                "text": "Hij was een verplichting aangegaan om het geld binnen 30 dagen te betalen."
                                            },
                                            {
                                                "example_id": "185c7fc3-96f5-43c7-b7a0-d863ca597191",
                                                "sense_id": "b78322fd-038f-3762-94ee-e1bb887b5738",
                                                "text": "Hoewel boeren in beide regelingen geld ontvangen om met hun bedrijf te stoppen, verschillen de doelen, middelen en de uitvoerder van de regeling. Wel is er één belangrijke overeenkomst: uitkopen gaat altijd vrijwillig. \"Er zal nooit een zweem van verplichting aan zitten\", verduidelijkt een woordvoerder van het Interprovinciaal Overleg (IPO)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73a37c80-1e8c-471a-a013-9f87e9de64cc",
                        "source_entry_id": "33408976-55eb-37c8-987d-3c55cdc2551f",
