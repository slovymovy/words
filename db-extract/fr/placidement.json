                                            {
                                                "example_id": "58ea65cd-b5b4-425b-b328-f76f2c04a7ba",
                                                "sense_id": "47f0a6be-b887-3208-92f2-5b074f32b83e",
                                                "text": "He was a big chubby man, in his middle thirties, the muscle of his rugger days now settling placidly to reminiscent fat."
                                            }
                                        ]
                                    }
                                ]
