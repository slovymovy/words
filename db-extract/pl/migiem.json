                                        "glosses": [
                                            "разг. очень быстро, тотчас"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75455988-15ac-407c-8177-6476ae294069",
                                                "sense_id": "320b8516-8641-3a43-a7d5-1ef34d9ce29c",
                                                "text": "Вмиг руки вцепились в гардину и сорвали её вместе с карнизом, отчего солнце хлынуло в затенённую комнату."
                                            }
                                        ]
                                    }
                                ]
