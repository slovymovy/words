                                    {
                                        "sense_id": "25cf39aa-1866-32d5-9d7d-fcf7994f2316",
                                        "entry_id": "b760eca9-be49-3926-99e2-ef84a14fc273",
                                        "glosses": [
                                            "Employer de manière militaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7c65c49-81d2-41f4-b76e-c1f9062ee7e7",
                                                "sense_id": "25cf39aa-1866-32d5-9d7d-fcf7994f2316",
                                                "text": "Le Pentagone accuse Moscou d'avoir arsenalisé l'espace"
                                            },
                                            {
                                                "example_id": "3d4de6f7-e3b0-4e5a-937b-6a844fa8f403",
                                                "sense_id": "25cf39aa-1866-32d5-9d7d-fcf7994f2316",
                                                "text": "Dans un nouveau décret, Trump cherche à arsenaliser l'espace en créant un système de défense reposant sur les technologies satellites"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1514414a-b47c-3804-9d2a-f0772edbe602",
                                        "entry_id": "b760eca9-be49-3926-99e2-ef84a14fc273",
                                        "glosses": [
                                            "Utiliser à la façon d’une arme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55dc0d48-3558-4aef-98ff-9a47269cdd3a",
                                                "sense_id": "1514414a-b47c-3804-9d2a-f0772edbe602",
                                                "text": "USA : comment le pays a arsenalisé l'économie mondiale"
                                            },
                                            {
                                                "example_id": "b5f13555-242d-45ad-b7f8-be4abedd84c6",
                                                "sense_id": "1514414a-b47c-3804-9d2a-f0772edbe602",
                                                "text": "Le « fardeau » de l'homme russe : la doctrine Lavrov pour arsenaliser l'ONU."
                                            },
                                            {
                                                "example_id": "601c1d46-74c1-4bac-a281-f5a57d7f5bb2",
                                                "sense_id": "1514414a-b47c-3804-9d2a-f0772edbe602",
                                                "text": "Arsenaliser le sport mondial : un plan quinquennal athlétique dans la Russie de Poutine."
                                            },
                                            {
                                                "example_id": "f04171e6-b6c8-4716-8dd1-4262c83e939d",
                                                "sense_id": "1514414a-b47c-3804-9d2a-f0772edbe602",
                                                "text": "il est bien sûr impossible d’arsenaliser la totalité de la production de chaque ministère."
                                            },
                                            {
                                                "example_id": "298e9371-4855-4eff-9cd1-3ff8ff67ed0c",
                                                "sense_id": "1514414a-b47c-3804-9d2a-f0772edbe602",
                                                "text": "La crainte se renforce en observant le Kremlin arsenaliser le pouvoir agricole du pays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
