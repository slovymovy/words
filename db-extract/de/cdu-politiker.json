                                "example_id": "ec1f83e4-22ad-415b-91f3-caeab56f3dd6",
                                "sense_id": "b20dfde6-0cab-3c75-a0da-3e5f96cdf1dc",
                                "text": "Von den sächsischen Wählern wird der CDU-Politiker in den Landtag gewählt."
                            },
                            {
                                "example_id": "541153f6-2ebd-4fab-a59d-1e5bccc0b44b",
                                "sense_id": "b20dfde6-0cab-3c75-a0da-3e5f96cdf1dc",
                                "text": "Er schätzt, dass der 50 Jahre alte CDU-Politiker mindestens noch vier bis sechs Wochen in der Klinik behandelt werden muss."
                            }
                        ],
