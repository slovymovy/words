                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beredsamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f180905c-e519-3a3e-8427-486893f32f7a",
                                        "entry_id": "ebb35165-6dcd-3317-86f1-d9186b4b700e",
                                        "glosses": [
                                            "hervorragende sprachliche Ausdrucksfähigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "198113b9-3ec0-44d1-8636-a6709f463a20",
                                                "sense_id": "f180905c-e519-3a3e-8427-486893f32f7a",
                                                "text": "Eine stark ausgeprägte Beredsamkeit kommt Politikern zugute."
                                            },
                                            {
                                                "example_id": "532a100a-ea71-44a9-92fc-186775a6d979",
                                                "sense_id": "f180905c-e519-3a3e-8427-486893f32f7a",
                                                "text": "„Die Poesie als Dienerin der Beredsamkeit: dies war auch der didaktische Grundsatz von Christian Weise, der als Rektor des Gymnasiums zu Zittau und als Verfasser von Schauspielen, Romanen und zahlreichen Lehrbüchern gleichzeitig mit Thomasius und vielleicht wirkungsvoller noch als dieser der deutschen Stilbildung im 18. Jahrhundert den Weg gewiesen hat.“"
                                            },
                                            {
                                                "example_id": "cc1dca8c-7dfb-4833-bc75-1b8e379dc03a",
                                                "sense_id": "f180905c-e519-3a3e-8427-486893f32f7a",
                                                "text": "„Ich konnte mir gut vorstellen, wie das gebieterische Männlein die biederen Pratts mit seiner Beredsamkeit und seinem Ernst gefangen genommen hatte.“"
                                            },
                                            {
                                                "example_id": "25a981f4-be32-48aa-b3b2-771f0375c2c8",
                                                "sense_id": "f180905c-e519-3a3e-8427-486893f32f7a",
                                                "text": "„Seine verliebte Beredsamkeit wuchs in dem Maß, wie er seine Kehle mit Champagner, Zyperwein und Likör befeuchtete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
