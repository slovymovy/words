                "forms": [
                    {
                        "form_id": "59f13f74-e8f3-442a-b07a-d90a31f334e5",
                        "entry_id": "85de8bc1-9ea0-3e34-a8f9-950e0863c473",
                        "tags": [
                            "plural"
                        ],
                        "form": "banlieusards"
                    },
                    {
                        "form_id": "c5114a4b-d6f5-41f4-b41a-fc14c3d6e0eb",
                        "entry_id": "85de8bc1-9ea0-3e34-a8f9-950e0863c473",
                        "tags": [
                            "feminine"
                        ],
                        "form": "banlieusarde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7df28a6d-2b52-39b8-9222-534a4bfb5b0c",
                        "entry_id": "85de8bc1-9ea0-3e34-a8f9-950e0863c473",
                        "glosses": [
                            "Habitant d’une banlieue de ville."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa6ab7f9-6378-4e15-b97c-c8867df694da",
                                "sense_id": "7df28a6d-2b52-39b8-9222-534a4bfb5b0c",
                                "text": "Plus précisément, 3 % des actifs de la Région sont des banlieusards qui rejoignent Paris en automobile, et 9 % sont des banlieusards qui rejoignent Paris en chemin de fer de banlieue ou en RER."
                            },
                            {
                                "example_id": "202170eb-2839-4a92-9dcd-6fd95cb8278e",
                                "sense_id": "7df28a6d-2b52-39b8-9222-534a4bfb5b0c",
                                "text": "En passant, Baudrillard associe les décadents ayant voté Non à la Constitution européenne aux banlieusards qui niquent leur mère."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0213b31-aa4e-4413-8eb4-e631426d263c",
                        "source_entry_id": "85de8bc1-9ea0-3e34-a8f9-950e0863c473",
                        "source_sense_id": "7df28a6d-2b52-39b8-9222-534a4bfb5b0c",
                        "target_lang_word": "Vorstädter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e7a3d6e2-73ac-48a4-b044-c96b703bc8ef",
                        "source_entry_id": "85de8bc1-9ea0-3e34-a8f9-950e0863c473",
                        "source_sense_id": "7df28a6d-2b52-39b8-9222-534a4bfb5b0c",
                        "target_lang_word": "suburbanite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suburbanite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28773780-e95e-3323-9be3-2962d5e73dae",
                                        "entry_id": "cdce897b-1579-38c1-83a3-929788a0325d",
                                        "glosses": [
                                            "Someone who lives in the suburbs."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93dc60b6-c3f2-4d61-9eb7-c96c950af84f",
                                                "sense_id": "28773780-e95e-3323-9be3-2962d5e73dae",
                                                "text": "Don't call me a suburbanite just because I live in Oak Grove!"
                                            },
                                            {
                                                "example_id": "c7aea8ba-f9ec-45b3-8b25-5c9d38a6df00",
                                                "sense_id": "28773780-e95e-3323-9be3-2962d5e73dae",
                                                "text": "I would suggest that we give the Brooklyn Rapid Transit Company a chance to correct the existing faults before condemning the scheme. A SUBURBANITE."
                                            },
                                            {
                                                "example_id": "d38e3439-3b59-4f75-9e89-7d6ff869b23c",
                                                "sense_id": "28773780-e95e-3323-9be3-2962d5e73dae",
                                                "text": "The line was doubled in the nineties and Hillfoot station added for suburbanites in 1900."
                                            },
                                            {
                                                "example_id": "5c37f0fd-2d32-4df0-acb4-b7fcec731a78",
                                                "sense_id": "28773780-e95e-3323-9be3-2962d5e73dae",
                                                "text": "Today’s affluent suburbanites might resent the suggestion that they’re guilty of racial animus, but they’re entirely comfortable with being accused of colorblind class prejudice."
                                            },
                                            {
                                                "example_id": "a0006d17-650c-4324-96d8-c2bf195cebfa",
                                                "sense_id": "28773780-e95e-3323-9be3-2962d5e73dae",
                                                "text": "Then there’s the problem of charging EVs. Suburbanites with home garages can install chargers, but the lack of public chargers on city streets hasn’t become a major issue yet only because so few people own EVs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
