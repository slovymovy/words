                        "source_sense_id": "0b81eadb-8f19-3bc3-8388-d5abdc721050",
                        "target_lang_word": "unbelievable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbelievable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cf5035f-0674-321c-8d01-1ade63132314",
                                        "entry_id": "ebd87b68-094d-3d70-b1de-a89a04d8f6a6",
                                        "glosses": [
                                            "Not to be believed."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3807c7c3-d090-4bf4-b36a-c2e9cc86d208",
                                                "sense_id": "3cf5035f-0674-321c-8d01-1ade63132314",
                                                "text": "‘Come on, girls,’ said Steve, ‘be honest, we won.’ / ‘Yeah,’ said Raymond, ‘we let you off because you’re girls.’ / ‘You’re unbelievable,’ said Liz. / ‘Well, if we’re unbelievable,’ said Steve, ‘then you’re unbelievabler.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57de7325-1cec-3288-8fd5-048565a825b6",
                                        "entry_id": "ebd87b68-094d-3d70-b1de-a89a04d8f6a6",
                                        "glosses": [
                                            "Amazing, astonishing; so surprising that one is almost, or figuratively, unable to believe."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20bf1047-0c50-42d2-ae41-e0ac64fcb94d",
                                                "sense_id": "57de7325-1cec-3288-8fd5-048565a825b6",
                                                "text": "The most unbelievable thing happened to me today!"
                                            },
                                            {
                                                "example_id": "aac1b181-dda3-4bd1-9015-a5371e283632",
                                                "sense_id": "57de7325-1cec-3288-8fd5-048565a825b6",
                                                "text": "This restaurant makes unbelievable pizza!"
                                            },
                                            {
                                                "example_id": "759964e3-f9ae-4943-9679-351041918016",
                                                "sense_id": "57de7325-1cec-3288-8fd5-048565a825b6",
                                                "text": "Whether you want the unbelievablest sheer of chiffon . . . or the most durable of service weight . . . I’ve concluded, after a round of looking, that these stores give you a real money’s worth!"
                                            },
                                            {
                                                "example_id": "4bd774ca-c6ed-4c80-8202-f75fe9900a31",
                                                "sense_id": "57de7325-1cec-3288-8fd5-048565a825b6",
                                                "text": "In other words—join the gpo and hear the world; have fun; talk to the wildest, craziest, simply unbelievablest people."
                                            },
                                            {
                                                "example_id": "2068d628-579c-47d3-b1ef-f2784d3aae21",
                                                "sense_id": "57de7325-1cec-3288-8fd5-048565a825b6",
                                                "text": "The unbelievablest (to coin a word) thing about this animation is the fact that it is generated in real time, like a video game!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf071e21-4396-3ea9-b5db-afb43200e1bc",
                                        "entry_id": "ebd87b68-094d-3d70-b1de-a89a04d8f6a6",
                                        "glosses": [
                                            "Implausible or improbable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9059b9e7-8938-4767-b4ef-2c6382910f18",
                                                "sense_id": "bf071e21-4396-3ea9-b5db-afb43200e1bc",
                                                "text": "His excuse seems rather unbelievable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
