        "fr-extract.jsonl": [
            {
                "entry_id": "f70f0344-72a3-34b5-b8a7-ec3cfdbb0300",
                "word": "relâche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4459d104-6d74-43ea-aa7d-ff3a5ba29316",
                        "entry_id": "f70f0344-72a3-34b5-b8a7-ec3cfdbb0300",
                        "tags": [
                            "plural"
                        ],
                        "form": "relâches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1985dc8c-59a6-33ba-bde2-b322b79378a2",
                        "entry_id": "f70f0344-72a3-34b5-b8a7-ec3cfdbb0300",
                        "glosses": [
                            "Interruption d'un travail, d'une étude, d'un exercice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9453ae7-7de7-41ff-9aa1-4c7af5405339",
                                "sense_id": "1985dc8c-59a6-33ba-bde2-b322b79378a2",
                                "text": "Le chevalier des Grieux ayant employé plus d’une heure à ce récit, je le priai de prendre un peu de relâche, et de nous tenir compagnie à souper."
                            }
                        ]
                    },
                    {
                        "sense_id": "971a9cdc-8e4f-39b0-8719-823408d9d414",
                        "entry_id": "f70f0344-72a3-34b5-b8a7-ec3cfdbb0300",
                        "glosses": [
                            "Repos, rémission, dans un état douloureux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9761ee4-d080-410a-b8f8-f0a8cd809bb0",
                                "sense_id": "971a9cdc-8e4f-39b0-8719-823408d9d414",
                                "text": "Les passions les plus violentes nous laissent quelquefois du relâche, mais la vanité nous agite toujours."
                            }
                        ]
                    },
                    {
                        "sense_id": "bac50f69-67da-38d4-b954-e23b72b8517f",
                        "entry_id": "f70f0344-72a3-34b5-b8a7-ec3cfdbb0300",
                        "glosses": [
                            "Suspension des représentations d’une pièce ou fermeture du théâtre pour quelque raison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6ff8a95-c36e-4270-9af7-0b4c2d144905",
                                "sense_id": "bac50f69-67da-38d4-b954-e23b72b8517f",
                                "text": "En temps ordinaire, ces deux événements eussent fait à Carentan le même effet que produit à Paris un relâche à tous les théâtres.' — (Honoré de Balzac, Le Réquisitionnaire, 1831)"
                            },
                            {
                                "example_id": "50cc1a81-3bbe-4a92-ab79-1443455075a3",
                                "sense_id": "bac50f69-67da-38d4-b954-e23b72b8517f",
                                "text": "Demain il y aura relâche au théâtre ; nous avons la chance qu’on ne trouve pas un chat dans les rues à cette heure-là."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "d827adf1-6918-3bdf-9c2a-284b954a49ba",
                "word": "relâche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b8a49b49-ca50-455d-a942-e387451a013c",
                        "entry_id": "d827adf1-6918-3bdf-9c2a-284b954a49ba",
                        "tags": [
                            "plural"
                        ],
                        "form": "relâches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df63c754-02e6-3625-a519-33098adfd286",
                        "entry_id": "d827adf1-6918-3bdf-9c2a-284b954a49ba",
                        "glosses": [
                            "Lieu propre pour relâcher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65435bff-5b93-4e01-b60e-27d743cddf24",
                                "sense_id": "df63c754-02e6-3625-a519-33098adfd286",
                                "text": "Une bonne relâche."
                            }
                        ]
                    },
                    {
                        "sense_id": "497ccc23-f142-3174-bb7e-34ac27e5c595",
                        "entry_id": "d827adf1-6918-3bdf-9c2a-284b954a49ba",
                        "glosses": [
                            "Action de relâcher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90c243ed-6afd-433e-a5c9-344a586cc052",
                                "sense_id": "497ccc23-f142-3174-bb7e-34ac27e5c595",
                                "text": "A l'égard des interlopes qui demandent à entrer dans les ports sur le prétexte d'une relâche forcée, il faudroit les assujettir à une visite préalable de la part des officiers de la patache, dont il seroit dressé un procès-verbal signé par eux & par les officiers des vaisseaux."
                            },
                            {
                                "example_id": "8d4dcd97-6dda-4972-aac5-db2fac7fd579",
                                "sense_id": "497ccc23-f142-3174-bb7e-34ac27e5c595",
                                "text": "Nous eûmes dans la matinée une audience publique du vice-roi. […]. Il nous reçut poliment , accorda au capitaine la relâche , et aux passagers la permission de se promener en ville. Après l'audience nous fîmes des visites militaires et nous revîmes dîner à bord."
                            },
                            {
                                "example_id": "e710d429-ba72-4c29-825e-cd2cab444c92",
                                "sense_id": "497ccc23-f142-3174-bb7e-34ac27e5c595",
                                "text": "Après une courte relâche au port Jackson, où il s’était rendu de la terre de Van Diémen, le Research fit voile pour la Nouvelle-Zélande […]."
                            },
                            {
                                "example_id": "472b117d-c4f7-43e5-bd47-ef1dc23e61a0",
                                "sense_id": "497ccc23-f142-3174-bb7e-34ac27e5c595",
                                "text": "À Mogador, nouvelle relâche, mais la barque envoyée à terre pour rapporter de l’eau fraîche faillit être capturée par les Arabes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
