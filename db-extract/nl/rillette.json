                        "examples": [
                            {
                                "example_id": "d0a8a516-97ce-4dcb-9937-1bc5e29b463b",
                                "sense_id": "db4274df-3486-36dc-9494-29291004895f",
                                "text": "Eigenaar Huub Wolferink en chef-kok Jeroen van den Barg stelden een lezersmenu samen, dat begint met een voorgerecht van rillette eend, hierbij eendenlever, uitjes monagask en een vadouvan specerijenmelange."
                            },
                            {
                                "example_id": "2956d750-b91f-4ca2-b584-b01ceb605e52",
                                "sense_id": "db4274df-3486-36dc-9494-29291004895f",
                                "text": "Alleen al om de Kaaskramer op de Runstraat zou Amsterdam moeten blijven bestaan. Daar ga ik dan speciaal naartoe om de beste truffelkaas te halen. Dan haal ik nog een fles witte wijn, Livarworst en ganzenrillette."
                            }
                        ]
