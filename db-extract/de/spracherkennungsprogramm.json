                "senses": [
                    {
                        "sense_id": "766c8997-5bdb-368d-bce0-fd7ddd7d02bd",
                        "entry_id": "72a37107-78c0-3998-ad1f-9a6d985dca55",
                        "glosses": [
                            "Computerprogramm zur Erfassung sprachlicher Äußerungen einschließlich ihrer semantischen (bedeutungsmäßigen) und syntaktischen Strukturen"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "e3d60290-3c55-48d0-bc79-9667a2ecb5fc",
                                "sense_id": "766c8997-5bdb-368d-bce0-fd7ddd7d02bd",
                                "text": "„Mit \"Hello Barbie\" kann die Puppe durch ein Spracherkennungsprogramm zum Reden gebracht werden.“"
                            },
                            {
                                "example_id": "d5581dca-70cc-4403-b245-4a52049f4659",
                                "sense_id": "766c8997-5bdb-368d-bce0-fd7ddd7d02bd",
                                "text": "„Dank einem Spracherkennungsprogramm kann Hitchbot sprechen – Englisch und ein paar Sätze Französisch –, und er hat ein von einem LED-Display dargestelltes Gesicht, das ihm eine Art von emotionalem Ausdruck ermöglicht.“"
                            },
                            {
                                "example_id": "0b9a46ca-a00b-453e-8dc7-91e28c35352c",
                                "sense_id": "766c8997-5bdb-368d-bce0-fd7ddd7d02bd",
                                "text": "„Ich benutze deshalb zum Beispiel auch kein Spracherkennungsprogramm, sondern diktiere alles meiner Sekretärin; noch so ein Privileg.“"
                            },
                            {
                                "example_id": "88faf355-221c-47c3-af85-7fa1922076ad",
                                "sense_id": "766c8997-5bdb-368d-bce0-fd7ddd7d02bd",
                                "text": "„Das Spracherkennungsprogramm enthält ein Wörterbuch mit 150.000 bis 180.000 Wörtern, die in einem weiteren Arbeitsschritt mit neuen Worten ergänzt werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
