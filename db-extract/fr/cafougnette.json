                        ],
                        "examples": [
                            {
                                "example_id": "f36478c1-4a85-4acc-96aa-b115d749eb60",
                                "sense_id": "bd5577c5-1432-3538-ad27-ebf46ffb7637",
                                "text": "Prendre un peu l'air, au calme, loin de tout ce tintamarre. Voilà qui ne pouvait que me faire du bien. Henri me raconte des cafougnettes toutes plus idiotes les unes que les autres. Moi je ris."
                            }
                        ]
