                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "062bbd8f-7cf8-47f2-b846-e5d9c3b627dd",
                                "sense_id": "aa8938fd-c6d3-3041-87e4-ce840145af56",
                                "text": "Ik heb kiespijn en moet misschien een wortelkanaalbehandeling ondergaan.",
                                "translation": "I have a molar toothache and may need to undergo a root canal treatment.",
                                "english": "I have a molar toothache and may need to undergo a root canal treatment."
                            },
                            {
                                "example_id": "750745eb-e32b-4fc5-8dac-2d2d4d363afa",
                                "sense_id": "aa8938fd-c6d3-3041-87e4-ce840145af56",
                                "text": "De kiespijn hield haar de hele nacht wakker.",
                                "translation": "The molar toothache kept her awake all night.",
                                "english": "The molar toothache kept her awake all night."
                            },
                            {
                                "example_id": "7cf2c7a8-a314-4e77-8b14-078d4b4d9faf",
                                "sense_id": "aa8938fd-c6d3-3041-87e4-ce840145af56",
                                "text": "Heb je ooit kiespijn gehad in je achterste kies?",
                                "translation": "Have you ever had a toothache in your back molar?",
                                "english": "Have you ever had a toothache in your back molar?"
                            }
                        ]
                    }
