                "senses": [
                    {
                        "sense_id": "cd04ce57-036b-31ba-92be-8431a303f3de",
                        "entry_id": "d8b1d4c2-507e-3f1e-bbfa-576e44f0035f",
                        "glosses": [
                            "Os du bras, depuis l’épaule jusqu’au coude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca11ed30-6921-4536-b407-96a69a6c9d87",
                                "sense_id": "cd04ce57-036b-31ba-92be-8431a303f3de",
                                "text": "Voyons ça ! dit l’interne. Bon ! une fracture du bras droit […] on le raccommodera tantôt, cet humérus... Pour le moment, nous allons le suspendre à une écharpe, tout bonnement…"
                            },
                            {
                                "example_id": "822c571e-d0d3-4bd5-b73f-c012d6054f03",
                                "sense_id": "cd04ce57-036b-31ba-92be-8431a303f3de",
                                "text": "Pièce de l’avant, la raquette a comme base osseuse les carpes, le radius, le cubitus, l’humérus, le scapulum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
