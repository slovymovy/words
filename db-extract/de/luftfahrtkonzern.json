                ],
                "senses": [
                    {
                        "sense_id": "da857a24-ba84-3f00-bdc9-d5f7d73ecd83",
                        "entry_id": "96557156-e72b-3ba6-b0c1-eb12d50fead1",
                        "glosses": [
                            "Großunternehmen, das Flugzeuge, Hubschrauber oder Raketen herstellt und verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1605b8d3-af3d-45ac-9f6b-645b3e3d7abd",
                                "sense_id": "da857a24-ba84-3f00-bdc9-d5f7d73ecd83",
                                "text": "„Zuvor hatte es Berichte über Rivalitäten zwischen dem französische Luftfahrtkonzern Dassault und Airbus gegeben.“"
                            },
                            {
                                "example_id": "dc548aa3-fc3d-4b3b-a3a0-1f7a57ef73a1",
                                "sense_id": "da857a24-ba84-3f00-bdc9-d5f7d73ecd83",
                                "text": "„Ärger für den Flugzeugbauer Airbus: Die britische Anti-Korruptionsbehörde ermittelt bei dem europäischen Luftfahrtkonzern wegen Korruptionsvorwürfen.“"
                            },
                            {
                                "example_id": "0e52db86-ddb8-4e53-8cc3-500a0cc97577",
                                "sense_id": "da857a24-ba84-3f00-bdc9-d5f7d73ecd83",
                                "text": "„Die \"Starliner\"-Raumkapsel des US-Luftfahrtkonzerns Boeing hat auf ihrem Testflug zum ersten Mal an der Internationalen Raumstation ISS angedockt.“"
                            },
                            {
                                "example_id": "621acdb2-6372-4f2d-89a4-62e2005958e5",
                                "sense_id": "da857a24-ba84-3f00-bdc9-d5f7d73ecd83",
                                "text": "„Neben SpaceX hat die NASA auch den Luftfahrtkonzern Boeing damit beauftragt, Weltraumfähren für Astronauten zu bauen.“"
                            },
                            {
                                "example_id": "dd030172-1b59-4371-a737-14c089938a4c",
                                "sense_id": "da857a24-ba84-3f00-bdc9-d5f7d73ecd83",
                                "text": "[Boing:] „Amerikas größter Luftfahrtkonzern ist wegen der 737 MAX bereits in größten Nöten.“"
                            },
                            {
                                "example_id": "7b7aff22-fd58-4b0b-86f9-596acf28dd86",
                                "sense_id": "da857a24-ba84-3f00-bdc9-d5f7d73ecd83",
                                "text": "„Boeing setzt die Produktion des Flugzeugs 737 Max ab Januar vorübergehend aus. Das teilte der US-Luftfahrtkonzern am Montag mit.“"
                            },
                            {
                                "example_id": "e1ff5e03-988b-40e7-911a-d61d98acdb02",
                                "sense_id": "da857a24-ba84-3f00-bdc9-d5f7d73ecd83",
                                "text": "[Flugzeugteile-Hersteller Premium Aerotec GmbH:] „Der neu formierte Luftfahrtkonzern beschäftigt in Deutschland und Rumänien mehr als 10.000 Mitarbeiter, davon etwa 4.500 in Nordenham und Varel.“"
                            },
                            {
                                "example_id": "471e4360-21bd-4c70-b0df-e93eebc2a291",
                                "sense_id": "da857a24-ba84-3f00-bdc9-d5f7d73ecd83",
                                "text": "„Im Mittelpunkt der Affäre um den Luftfahrtkonzern EADS und das Großraumflugzeug Airbus A 380 stand Noël Forgeard, der den Skandal auslöste.“"
                            },
                            {
                                "example_id": "9967c42e-7d99-4585-a6de-cc1322a2d0e1",
                                "sense_id": "da857a24-ba84-3f00-bdc9-d5f7d73ecd83",
                                "text": "„Ab September 2006 hielt OAK einen Kapitalanteil von fünf Prozent am europäischen Luftfahrtkonzern Airbus Group.“"
                            },
                            {
                                "example_id": "af985c5f-36b7-4b8f-a40b-3bdb2a9e2746",
                                "sense_id": "da857a24-ba84-3f00-bdc9-d5f7d73ecd83",
                                "text": "[Airbus A400M:] „Trotz der hohen Mehrkosten einigten sich die Staaten und der Luftfahrtkonzern EADS Anfang März 2010 auf den Bau des Flugzeugs.“"
                            },
                            {
                                "example_id": "132b49cd-c4f8-4889-ae95-0c91d032b0ec",
                                "sense_id": "da857a24-ba84-3f00-bdc9-d5f7d73ecd83",
                                "text": "„Nach der Insolvenz von Chrysler 2009 wechselte Schell zu dem früheren amerikanischen Luftfahrtkonzern UTC und war dort für die Digitalstrategie verantwortlich.“"
                            },
                            {
                                "example_id": "5056daef-1cab-4700-b82a-b6d0b7a09e15",
                                "sense_id": "da857a24-ba84-3f00-bdc9-d5f7d73ecd83",
                                "text": "„Letzte Woche hat der Bundesrat beschlossen, das bundeseigene Unternehmen Ruag aufzuspalten. In eine Firma, die für die Armee Panzer und Flieger wartet und in einen Raum- und Luftfahrtkonzern «Ruag International», der an die Börse soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a85b6ffc-e4a6-3ea7-b3c0-93bcc9607cd9",
                        "entry_id": "96557156-e72b-3ba6-b0c1-eb12d50fead1",
                        "glosses": [
                            "Großunternehmen, dessen Geschäft der Transport von Waren und/oder Menschen mit Hilfe von Flugzeugen ist"
                        ],
                        "tags": [
                            "Logistik"
                        ],
                        "examples": [
                            {
                                "example_id": "2a624947-82b5-4e9a-863c-deb6ecc3195b",
                                "sense_id": "a85b6ffc-e4a6-3ea7-b3c0-93bcc9607cd9",
                                "text": "„An der Londoner Börse legten die Aktien der Konzerne am Dienstag kräftig zu. Der britisch-spanische Luftfahrtkonzern IAG und TUI stiegen um sechs Prozent, Easyjet gewann mehr als neun Prozent.“"
                            },
                            {
                                "example_id": "a600bfc6-6142-458d-952d-9f209f846d3f",
                                "sense_id": "a85b6ffc-e4a6-3ea7-b3c0-93bcc9607cd9",
                                "text": "„Der größte europäische Luftfahrtkonzern Air France- KLM steckt weiter tief in den roten Zahlen.“"
                            },
                            {
                                "example_id": "447ef8ba-f1b6-4ea4-b220-b289e51a79ba",
                                "sense_id": "a85b6ffc-e4a6-3ea7-b3c0-93bcc9607cd9",
                                "text": "„Der französisch-niederländische Luftfahrtkonzern, zu dem auch KLM gehört, sprach am Donnerstag von einem nahezu völligen Geschäftseinbruchs durch die Pandemie.“"
                            },
                            {
                                "example_id": "8e991d41-5a47-4859-8212-34b7351db6df",
                                "sense_id": "a85b6ffc-e4a6-3ea7-b3c0-93bcc9607cd9",
                                "text": "[Coronapandemie 2020:] „Unterdessen plant die Lufthansa, Europas umsatzstärkster Luftfahrtkonzern, zusätzlich Frachtflüge nach China.“"
                            },
                            {
                                "example_id": "47901390-358e-4e2b-8e11-a8d0211b20b7",
                                "sense_id": "a85b6ffc-e4a6-3ea7-b3c0-93bcc9607cd9",
                                "text": "[Schlagzeile:] „Bodenpersonal der Lufthansa erkämpft spürbar höhere Löhne – Von der Tarifeinigung des Luftfahrtkonzerns mit Verdi profitieren vor allem untere Einkommensgruppen“"
                            },
                            {
                                "example_id": "9ab52f2e-8a24-4182-90cd-185c6c759ef5",
                                "sense_id": "a85b6ffc-e4a6-3ea7-b3c0-93bcc9607cd9",
                                "text": "„Die Lufthansa hat mit steigenden Fluggastzahlen und Kostensenkungen den Verlust in der Corona-Krise verringert. Im zweiten Quartal habe sich das bereinigte Betriebsergebnis auf minus 952 Millionen Euro belaufen, teilte der Luftfahrtkonzern am Donnerstag mit.“"
                            },
                            {
                                "example_id": "ecd6836e-545c-44f2-acb1-38989f984000",
                                "sense_id": "a85b6ffc-e4a6-3ea7-b3c0-93bcc9607cd9",
                                "text": "„Der Luftfahrtkonzern wirbt mit einer Vielzahl von Arbeitszeitmodellen, damit Pilotinnen Beruf und Familie besser vereinbaren können.“"
                            },
                            {
                                "example_id": "3afff800-066f-43a6-884c-d423d0acf2c6",
                                "sense_id": "a85b6ffc-e4a6-3ea7-b3c0-93bcc9607cd9",
                                "text": "„Die Luftfahrtkonzerne entwickelten in den 1980er Jahren Dachmarken wie American Eagle, Continental Connection, Delta Connection, Northwest Airlink, United Express und USAir Express, unter denen die zu einer Unternehmensgruppe gehörenden Regionalpartner den Betrieb fortsetzten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
