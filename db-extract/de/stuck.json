                ],
                "senses": [
                    {
                        "sense_id": "a1974f49-d4ab-3a3f-a149-9120a8aee37d",
                        "entry_id": "25a4a42e-3f49-33d6-b922-98c43d4a9b1e",
                        "glosses": [
                            "Werkstoff aus Mörtel, Sand, Kalk und/oder Gips"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54f5f68e-5505-4fa8-a33e-0bbbf54364f2",
                                "sense_id": "a1974f49-d4ab-3a3f-a149-9120a8aee37d",
                                "text": "Der Gehilfe rührte den Stuck an."
                            },
                            {
                                "example_id": "68d7f48b-33cb-4292-8876-9fc401a40619",
                                "sense_id": "a1974f49-d4ab-3a3f-a149-9120a8aee37d",
                                "text": "„An den Giebeln freilich, die oft mit spielerischen Türmchen und Figuren aus Stuck verziert waren, zeigten sich Bruchstellen und Löcher, auch fehlten häufig die Butzenscheiben in den schmalen Fenstern, die im Erdgeschoß vergittert waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6f0a1a7a-daae-3cf5-a5d0-50a784817cc6",
                        "entry_id": "25a4a42e-3f49-33d6-b922-98c43d4a9b1e",
                        "glosses": [
                            "Wand- oder Deckenverzierung aus Stuck^([1])"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23e1e12b-3bb2-49ae-a28a-e0707dc5f290",
                                "sense_id": "6f0a1a7a-daae-3cf5-a5d0-50a784817cc6",
                                "text": "Der Saal war reichlich mit Stuck verziert."
                            },
                            {
                                "example_id": "e32748d9-6e92-458b-a8a5-5976e2fa55e6",
                                "sense_id": "6f0a1a7a-daae-3cf5-a5d0-50a784817cc6",
                                "text": "„In den Wohnungen gab es ein Badezimmer, Stuck an den Decken und Kachelöfen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de8cb10f-cb95-42f0-8377-6a6047f08b68",
                        "source_entry_id": "25a4a42e-3f49-33d6-b922-98c43d4a9b1e",
                        "source_sense_id": "a1974f49-d4ab-3a3f-a149-9120a8aee37d",
                        "source_sense_description": "Werkstoff aus Mörtel, Sand, Kalk und/oder Gips",
                        "target_lang_word": "stucco",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stucco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cfb3ed6-af55-3450-b65d-7328b7b06260",
                                        "entry_id": "f0da0ba3-8152-32d9-aeec-669a30c7db12",
                                        "glosses": [
                                            "A plaster that is used to coat interior or exterior walls, or used for mouldings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbf4d522-0424-48b9-9ef0-c9b5b883365b",
                                                "sense_id": "0cfb3ed6-af55-3450-b65d-7328b7b06260",
                                                "text": "The intervals having been filled with stucco, after the manner described under that head, each is sprinkled with water, and well rubbed with the float until the surface becomes perfectly smooth. This stucco must be thoroughly dry before the paint or other finishing is applied."
                                            },
                                            {
                                                "example_id": "c08b2bcd-2cca-4f99-a51a-b7a1d96b6a11",
                                                "sense_id": "0cfb3ed6-af55-3450-b65d-7328b7b06260",
                                                "text": "The writer Juan Rulfo, whose 1955 novel, “Pedro Páramo,” still stands as the central monument of modern Mexican literature, grew up in Jalisco and vividly depicted its arid, sun-blasted landscapes in his writing, while the architect Luis Barragán, who moved from Guadalajara to Mexico City in the 1930s, carried with him an appreciation for his home state’s cloisters, haciendas and humble country buildings, which he translated in his own work as austere, inscrutable volumes of stucco."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a8f6a2a-b8ba-3f58-8b87-4d1fff0e45ed",
                                        "entry_id": "f0da0ba3-8152-32d9-aeec-669a30c7db12",
                                        "glosses": [
                                            "Work made of stucco; stuccowork."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e0d9970-2ba3-4368-81d3-8879ea8219a9",
                                                "sense_id": "0a8f6a2a-b8ba-3f58-8b87-4d1fff0e45ed",
                                                "text": "A stone staircase ‘well furnished with stucco’ led to Dr. Delany’s panelled but otherwise undecorated library, Mrs. Delany’s boudoir or bedroom opening through an arched doorway on her painting closet and a fine drawing room about 30 ft. by 25 ft. which gave a splendid view over the city – fastigia despicit urbis."
                                            },
                                            {
                                                "example_id": "22c8c090-f9eb-4357-b7d3-71ac4c9bbd3e",
                                                "sense_id": "0a8f6a2a-b8ba-3f58-8b87-4d1fff0e45ed",
                                                "text": "Many stuccos and paintings were also found on the mosaic floor of the presbyterium and choir; most of these are now in the Bardo Museum in Tunis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stucco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52f54d73-84f0-3d3a-b022-8419207d7de0",
                                        "entry_id": "b674ef6c-0bbb-3bb7-a911-77f6f35d84e1",
                                        "glosses": [
                                            "To coat or decorate with stucco."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6105b106-d5c0-46f0-bc37-13d898640fa2",
                        "source_entry_id": "25a4a42e-3f49-33d6-b922-98c43d4a9b1e",
                        "source_sense_id": "a1974f49-d4ab-3a3f-a149-9120a8aee37d",
                        "source_sense_description": "Werkstoff aus Mörtel, Sand, Kalk und/oder Gips",
                        "target_lang_word": "stuc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stuc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "651193f4-3fbd-301e-8c24-047889337b56",
                                        "entry_id": "a876108d-302c-30d2-8d91-bcb5d9d81cc7",
                                        "glosses": [
                                            "Enduit à base de marbre blanc pulvérisé, mêlé avec de la chaux et de la craie, dont on fait des ornements d’architecture et qu’on emploie aussi pour imiter le marbre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab36b1fe-8ce3-4af6-ab24-d7e17151521f",
                                                "sense_id": "651193f4-3fbd-301e-8c24-047889337b56",
                                                "text": "Un double escalier droit, avec un tapis rouge à baguettes de cuivre, s’appuyait contre les hautes murailles en stuc luisant."
                                            },
                                            {
                                                "example_id": "c59f0023-d7c4-45bf-ad15-7ff7341de31c",
                                                "sense_id": "651193f4-3fbd-301e-8c24-047889337b56",
                                                "text": "[…] les parois en sont revêtues d’une espèce de stuc si bien gâché et si proprement appliqué, qu’il semble que la main de l’homme y ait passé, aussi la queue leur sert-elle de truelle pour appliquer ce mortier qu’ils gâchent avec leurs pieds."
                                            },
                                            {
                                                "example_id": "ad73b7f0-6933-4812-94d8-efb6223c3559",
                                                "sense_id": "651193f4-3fbd-301e-8c24-047889337b56",
                                                "text": "Il n’y a pas un seul morceau de marbre employé dans la construction intérieure de l’Alhambra. Il en est de même du Généralife : nul peuple d’ailleurs n’a poussé plus loin que les Arabes l’art de mouler, de durcir et de ciseler le plâtre, qui acquiert entre leurs mains la dureté du stuc sans en avoir le luisant désagréable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b65fefd5-df9a-39c0-a3b2-aade879d0610",
                                        "entry_id": "a876108d-302c-30d2-8d91-bcb5d9d81cc7",
                                        "glosses": [
                                            "Décoration de cette matière."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b92f3c1-8c41-4dd8-8afc-72f19efce669",
                                                "sense_id": "b65fefd5-df9a-39c0-a3b2-aade879d0610",
                                                "text": "Le soleil du matin […] lèche et réchauffe les stucs livides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
