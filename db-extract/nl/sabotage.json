                        "glosses": [
                            "een ingreep op zaken om deze te laten mislukken of te vernielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a11542f-83fe-45fb-8878-84e5fd5047c4",
                                "sense_id": "4f9312a2-6229-3425-b219-0744524b8f03",
                                "text": "De geheime agenten zorgden voor de sabotage van de bommen van de terroristische organisatie."
                            },
                            {
                                "example_id": "b8d5e87a-04df-4041-9719-d87b6844680d",
                                "sense_id": "4f9312a2-6229-3425-b219-0744524b8f03",
                                "text": "Meerdere treinstellen waren verwoest. De oorzaak was waarschijnlijk sabotage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e2969e4-752c-481f-bc10-79db4361e5a1",
                        "source_entry_id": "4216f581-a8d1-3b7a-86c3-ae33359fb854",
                        "source_sense_id": "4f9312a2-6229-3425-b219-0744524b8f03",
                        "source_sense_description": "een vijandige ingreep op zaken om deze te laten mislukken of te vernielen",
                        "target_lang_word": "陰謀破壞",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "43718f29-fc31-429e-8e04-229464efbc13",
                        "source_entry_id": "4216f581-a8d1-3b7a-86c3-ae33359fb854",
                        "source_sense_id": "4f9312a2-6229-3425-b219-0744524b8f03",
                        "source_sense_description": "een vijandige ingreep op zaken om deze te laten mislukken of te vernielen",
                        "target_lang_word": "Sabotage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sabotage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "439b3f8f-19c6-3f46-bfa7-9b76019cbde4",
                                        "entry_id": "8e8e0507-d2ce-3266-9237-64645f51af1a",
                                        "glosses": [
                                            "im Verborgenen betriebene, planmäßige Beschädigung, Wegnahme oder Zerstörung von Gegenständen und/oder Bestandteilen einer Infrastruktur, die der Aufrechterhaltung dieser Ordnung dienen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17a04f16-7638-4e79-98c4-ae6c67aeb9d2",
                                                "sense_id": "439b3f8f-19c6-3f46-bfa7-9b76019cbde4",
                                                "text": "Als Sabotage bezeichnet man einen Vorgang, der die Störung eines wirtschaftlichen oder militärischen Ablaufs hervorruft."
                                            },
                                            {
                                                "example_id": "acf4191c-9e82-4d22-9437-fc5ca4823afd",
                                                "sense_id": "439b3f8f-19c6-3f46-bfa7-9b76019cbde4",
                                                "text": "Derart weit soll die Paranoia gediehen sein, dass LeMond abends allein auf dem Zimmer aß und auch sein Rennrad dorthin mitnahm – aus Furcht vor Sabotage."
                                            },
                                            {
                                                "example_id": "f597aa65-3b26-4c28-94d8-ad054af24808",
                                                "sense_id": "439b3f8f-19c6-3f46-bfa7-9b76019cbde4",
                                                "text": "Die Opposition solle „die Sabotage und die aufrührerischen Aktivitäten“ einstellen, hieß es auf der Internetseite der Elitetruppe."
                                            },
                                            {
                                                "example_id": "298726cf-4efe-41aa-9ad0-d023773d348c",
                                                "sense_id": "439b3f8f-19c6-3f46-bfa7-9b76019cbde4",
                                                "text": "Der Bürgerblock ist längst da. Kabinett Marx mit Sabotage des Volksentscheides, mit Republikabbau und neuen Brotzöllen, das ist der Bürgerblock."
                                            },
                                            {
                                                "example_id": "5a668e79-b8c9-4cf5-b461-f0a3e12e3d2f",
                                                "sense_id": "439b3f8f-19c6-3f46-bfa7-9b76019cbde4",
                                                "text": "Er [= Stundenlohn des Handarbeiters] wird vom Parteiführer bestimmt, nicht vom Wirtschaftsführer errechnet, und er wird, wenn er von diesem nicht bewilligt wird und werden kann, durch Streik, Sabotage und den Druck auf die parlamentarischen Regierungen erzwungen."
                                            },
                                            {
                                                "example_id": "120edec8-6b5c-41bc-a771-319ae6032d18",
                                                "sense_id": "439b3f8f-19c6-3f46-bfa7-9b76019cbde4",
                                                "text": "Der verantwortliche Minister sprach von Sabotage, doch das stellte sich als falsch heraus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af375101-6f8b-4eeb-8f5d-2cfb8f29154e",
                        "source_entry_id": "4216f581-a8d1-3b7a-86c3-ae33359fb854",
                        "source_sense_id": "4f9312a2-6229-3425-b219-0744524b8f03",
                        "source_sense_description": "een vijandige ingreep op zaken om deze te laten mislukken of te vernielen",
                        "target_lang_word": "sabotage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sabotage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "563b16c9-054d-3d84-bd1f-501ff03802b4",
                                        "entry_id": "1e88585d-719f-30ec-8321-76a94d2800db",
                                        "glosses": [
                                            "A deliberate action aimed at weakening someone (or something, a nation, etc) or preventing them from being successful, through subversion, obstruction, disruption, and/or destruction."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sabotage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3fc01f9-5bf6-3cc6-acb8-0a607d02f9f8",
                                        "entry_id": "843e1cbb-f708-35a0-9edc-a0ef301c8af2",
                                        "glosses": [
                                            "To deliberately destroy or damage something in order to prevent it from being successful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf3ce875-a167-4dc2-9531-7c030b299c9a",
                                                "sense_id": "b3fc01f9-5bf6-3cc6-acb8-0a607d02f9f8",
                                                "text": "The railway line had been sabotaged by enemy commandos."
                                            },
                                            {
                                                "example_id": "392fa10d-cb29-40af-ae71-6832ac915143",
                                                "sense_id": "b3fc01f9-5bf6-3cc6-acb8-0a607d02f9f8",
                                                "text": "Our plans were sabotaged."
                                            },
                                            {
                                                "example_id": "f6d4329b-454d-4b51-a362-0e35de053a68",
                                                "sense_id": "b3fc01f9-5bf6-3cc6-acb8-0a607d02f9f8",
                                                "text": "The Hedjaz Railway is best known for its connections to T. E. Lawrence, whose fame as \"El Orens\", the railway wrecker, spread quickly throughout Arabia. He arrived at Yenbo in December, 1916, and immediately started his campaign to sabotage the railway, but to keep it sufficiently in working order to allow supplies to reach Medina."
                                            },
                                            {
                                                "example_id": "e4cc99b9-0ffe-4766-a730-21208fe49c5f",
                                                "sense_id": "b3fc01f9-5bf6-3cc6-acb8-0a607d02f9f8",
                                                "text": "Five minutes later, Southampton tried to mount their first attack, but Wickham sabotaged the move by tripping the rampaging Nathaniel Clyne, prompting the referee, Andre Marriner, to issue a yellow card. That was a lone blemish on an otherwise tidy start by Poyet’s team – until, that is, the 12th minute, when Vergini produced a candidate for the most ludicrous own goal in Premier League history."
                                            },
                                            {
                                                "example_id": "a8594f32-c4e3-48e1-be07-d83b0b95b55d",
                                                "sense_id": "b3fc01f9-5bf6-3cc6-acb8-0a607d02f9f8",
                                                "text": "The only amusing highlight was Gudgeon having managed to exploit U.S. codebreaking efforts to ambush and destroy the submarine I-173, albeit not for the lack of the Mark 14's trying to sabotage the effort, as the torpedo that had hit the sub had refused to detonate; it seemed, however, that the car-crash levels of kinetic energy involved in the dud simply ramming the sub had nonetheless done enough to fatally damage it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03078f69-cb64-49a9-9b46-6dcc3cd35707",
                        "source_entry_id": "4216f581-a8d1-3b7a-86c3-ae33359fb854",
                        "source_sense_id": "4f9312a2-6229-3425-b219-0744524b8f03",
