                    {
                        "sense_id": "f6cadcc7-f1e2-3766-ba5d-a536b2f07c16",
                        "entry_id": "635aa6e6-a500-37fe-9a34-b2aec327cff3",
                        "glosses": [
                            "gebied op het vasteland dat helemaal buiten de staatkundige eenheid ligt waar het toe behoort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70224c34-85ca-4599-9fd3-bf971727a001",
                                "sense_id": "f6cadcc7-f1e2-3766-ba5d-a536b2f07c16",
                                "text": "De exclave, die tussen Polen en Litouwen ligt ingeklemd, heeft geen directe landverbinding met Rusland."
                            },
                            {
                                "example_id": "42416b0c-034f-4832-b7a1-1e79bc720fde",
                                "sense_id": "f6cadcc7-f1e2-3766-ba5d-a536b2f07c16",
                                "text": "Spanje heeft nog een tweede exclave aan de Noord-Afrikaanse kust, het oostelijker gelegen Melilla. Marokko claimt beide gebieden, waar tienduizenden straatarme Afrikanen uit landen ten zuiden van de Sahara wachten op een kans de grensversperringen te doorbreken."
                            },
                            {
                                "example_id": "c63f1530-ff79-42cc-a086-30bf8d6c0b93",
                                "sense_id": "f6cadcc7-f1e2-3766-ba5d-a536b2f07c16",
                                "text": "Vrijdag zijn in Ceuta, een Spaanse exclave in Marokko, nog twee terreurverdachten aangehouden. Zij waren in het bezit van wapens."
                            }
                        ]
                    }
                ],
