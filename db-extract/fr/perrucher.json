                "senses": [
                    {
                        "sense_id": "4cf3b55b-ad38-34b7-9078-aa4142128735",
                        "entry_id": "62735c1f-d869-32f3-a03c-893d5a31c39d",
                        "glosses": [
                            "Babiller comme une perruche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d155560e-3a37-4468-a5ae-d195b4468c49",
                                "sense_id": "4cf3b55b-ad38-34b7-9078-aa4142128735",
                                "text": "On y peut désormais goguenarder et perrucher à loisir, cela ne tire plus à conséquence, et les gens qu’elle mord se portent à merveille."
                            },
                            {
                                "example_id": "a1dd3af4-53a4-4c44-b7a4-397c4db800c0",
                                "sense_id": "4cf3b55b-ad38-34b7-9078-aa4142128735",
                                "text": "Elle a rien senti et ne s’est pas arrêtée de perrucher malgré mes stalactites qui déguisaient son bada en chapeau breton."
                            }
                        ]
                    }
