                ],
                "senses": [
                    {
                        "sense_id": "05ed955f-398c-32fe-bace-c23a7939c82a",
                        "entry_id": "e7d9d2d0-a9b6-35c1-919c-71e215795de7",
                        "glosses": [
                            "Abandonner la priorité qui avait été donnée à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "146357b9-3d97-4289-8ae3-c4b7d7d537f3",
                                "sense_id": "05ed955f-398c-32fe-bace-c23a7939c82a",
                                "text": "Le Forum Jeunesse estime qu'en dépit de certains défis rencontrés dans la mise en oeuvre, le temps est venu de déprioritiser le financement pour la Garantie pour la Jeunesse."
                            },
                            {
                                "example_id": "a15c2626-8bfa-4434-b644-b41af49d5f78",
                                "sense_id": "05ed955f-398c-32fe-bace-c23a7939c82a",
                                "text": "Le patronat allemand a d’ailleurs demandé à Merkel de déprioritiser les énergies renouvelables dans le réseau afin que les usines de l’industrie lourde ne subissent les effets des micro coupures (plusieurs fours se sont arretés^([sic]) avec des centaines de milliers d’euro de nettoyage et remise en état par four)."
                            }
                        ]
                    }
                ],
