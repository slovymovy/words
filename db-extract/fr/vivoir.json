                        ]
                    },
                    {
                        "translation_id": "c9acaa52-0296-4ee7-8702-6a271030d2d9",
                        "source_entry_id": "e7379d43-1fb7-3973-b0ee-bbec68d03ca7",
                        "source_sense_id": "bee1aae3-3999-333e-b75f-0908583e339e",
                        "target_lang_word": "woonkamer",
