                                            {
                                                "example_id": "0b973432-550e-41f8-883f-bcb18de5a390",
                                                "sense_id": "ad4ab993-56d0-31b1-972f-24c9c8bd6437",
                                                "text": "W głębi komnaty stała złocista otomana, a na niej spoczywała piękna królewna, która właśnie paląc nargile ziewała tak czarownie, że nie mogłem oderwać oczu od jej wdzięcznych i porywająco słodkich poziewań"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a3abdde-0f68-4ae0-baed-870944fa4636",
