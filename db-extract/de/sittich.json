                "senses": [
                    {
                        "sense_id": "c5d5e2d7-1c6d-33d0-a7f9-25c64eb450d4",
                        "entry_id": "03409460-64c8-35ba-b7f6-8e4423eee58b",
                        "glosses": [
                            "ein kleiner Vogel mit langem Schwanz, der zu den Papageien (Ordnung Psittaciformes) gehört"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "15210fc5-a6bc-452d-8282-5ba2939ecdeb",
                                "sense_id": "c5d5e2d7-1c6d-33d0-a7f9-25c64eb450d4",
                                "text": "Meyers haben sich einen Sittich angeschafft."
                            },
                            {
                                "example_id": "b651b1ca-99ac-4683-9653-5680cb680a96",
                                "sense_id": "c5d5e2d7-1c6d-33d0-a7f9-25c64eb450d4",
                                "text": "„Er geht behutsam vor, fängt aber nur den gelben Sittich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad726e29-867b-4aee-b880-4171ce077321",
                        "source_entry_id": "03409460-64c8-35ba-b7f6-8e4423eee58b",
                        "source_sense_id": "c5d5e2d7-1c6d-33d0-a7f9-25c64eb450d4",
                        "target_lang_word": "parakeet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parakeet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc3dcfa9-447d-3b93-b2d9-5fa6fe3cef31",
                                        "entry_id": "e5bcbeb3-dd5f-3b56-ad39-d1aed526033f",
                                        "glosses": [
                                            "Any of various species of small parrot primarily of tropical regions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "120bfd37-841b-45b4-b0b1-cb6d4e42d5eb",
                                                "sense_id": "dc3dcfa9-447d-3b93-b2d9-5fa6fe3cef31",
                                                "text": "we had loved them for our pastimes, as we do apes, monkies, or perokitoes, and not as man."
                                            },
                                            {
                                                "example_id": "f6a6e5bc-f9d6-464e-99bf-5e8255be57e0",
                                                "sense_id": "dc3dcfa9-447d-3b93-b2d9-5fa6fe3cef31",
                                                "text": "'Is it that it talks?' asked the lady. And the Phoenix replied in excellent French. It said, 'Parfaitement, madame!' 'Oh, the pretty parrakeet,' said the lady."
                                            },
                                            {
                                                "example_id": "3b8e3932-ef38-4a69-9736-1b4677c95954",
                                                "sense_id": "dc3dcfa9-447d-3b93-b2d9-5fa6fe3cef31",
                                                "text": "According to one legend, the parakeets escaped from the set of The African Queen, John Huston's 1951 film made at Shepperton studios."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91329fd4-7c83-493c-a4b8-78c9ec8c2b07",
                        "source_entry_id": "03409460-64c8-35ba-b7f6-8e4423eee58b",
                        "source_sense_id": "c5d5e2d7-1c6d-33d0-a7f9-25c64eb450d4",
                        "target_lang_word": "perruche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perruche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfe6d104-f4ab-3741-9c71-632d9fbdcaaa",
                                        "entry_id": "037318e0-b6ad-3b36-afd8-43d1f7780fe7",
                                        "glosses": [
                                            "Nom normalisé donné à 24 genres d'oiseaux granivores de la famille des psittaculidés (e.g. inséparables, loris, etc.), de taille plus petite que celle des perroquets « vrais » et que l’on distingue généralement par leur queue fine et allongée, et que l’on rencontre dans les régions paléotropicales d’Afrique centrale et du sud, d’Asie et d’Australasie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cba2051e-912c-4f5c-9515-ae9ea113dbf0",
                                                "sense_id": "cfe6d104-f4ab-3741-9c71-632d9fbdcaaa",
                                                "text": "Dans le cas d’une perruche bleue, il n’y a pas de caroténoïde et l’on a seulement du gris."
                                            },
                                            {
                                                "example_id": "90b0fcc5-1bc0-46b0-bfcf-9dfab3507533",
                                                "sense_id": "cfe6d104-f4ab-3741-9c71-632d9fbdcaaa",
                                                "text": "Moricet.— Vous souvenez-vous de votre perruche ?… Elle venait de mourir, votre pauvre petite perruche qui disait si gentiment : (Avec des larmes dans la voix.) “Donnez-moi du tafia, chameau, chameau, chameau !…”"
                                            },
                                            {
                                                "example_id": "d718446a-3267-4b95-a70a-8d240d6a4f7c",
                                                "sense_id": "cfe6d104-f4ab-3741-9c71-632d9fbdcaaa",
                                                "text": "Je ne vous demande pas d'extirper de ma poche une perruche vivante, opération classique, paraît-il, chez les esprits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7b33e02-af5e-3ed8-9b77-3a61bba72ffb",
                                        "entry_id": "037318e0-b6ad-3b36-afd8-43d1f7780fe7",
                                        "glosses": [
                                            "Femelle du perroquet, perroquette."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b62884c-706d-333c-bf85-7eb490b85eea",
                                        "entry_id": "037318e0-b6ad-3b36-afd8-43d1f7780fe7",
                                        "glosses": [
                                            "Femme prétentieuse et parlant à tort et à travers."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07bf4da9-5f7c-4497-8e8a-6232f5a0fa53",
                                                "sense_id": "8b62884c-706d-333c-bf85-7eb490b85eea",
                                                "text": "Oubliant sa parfaite éducation, Jan l’avait traitée de vieille perruche et le comte lui faisait une mine affreusement renfrognée."
                                            },
                                            {
                                                "example_id": "08ffbd30-f1c4-4d30-a4bf-dffb702f6c12",
                                                "sense_id": "8b62884c-706d-333c-bf85-7eb490b85eea",
                                                "text": "Voir le commandant Jean-Marie Le Ster, mon père, lui aussi sapé en pingouin, au bras de Sonia Rimbermin, perruche emperlousée, déguisée en belle-mère, et jacassant en permanence, remonter l'allée centrale de la cathédrale de Rennes n'aurait pas manqué de sel !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b0f1fc7-8d29-39fa-9de1-7343656d865d",
                                        "entry_id": "037318e0-b6ad-3b36-afd8-43d1f7780fe7",
                                        "glosses": [
                                            "Mât, la vergue et la voile qui se trouvent au-dessus du perroquet d’artimon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "169a0a68-53a7-4b85-9f81-ff51d9c99cef",
                                                "sense_id": "3b0f1fc7-8d29-39fa-9de1-7343656d865d",
                                                "text": "Mât de perruche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "perruche",
                                "target_lang_code": "fr",
                                "target_senses": [
