                "senses": [
                    {
                        "sense_id": "2d7f5c92-050f-3e1e-b0bb-0c4018b59e14",
                        "entry_id": "03654b16-a624-3386-bd61-d8ddf7ad24a3",
                        "glosses": [
                            "an einer altersgemäß zu besuchenden Lehranstalt Unterrichtende"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c39b575c-d578-456c-881c-79b926469d1a",
                                "sense_id": "2d7f5c92-050f-3e1e-b0bb-0c4018b59e14",
                                "text": "„Die Autorin ist in der Lehrerausbildung tätig und war über 25 Jahre als Pflichtschullehrerin in Schulversuchen und Schulentwicklungsprojekten eingebunden.“"
                            },
                            {
                                "example_id": "3c518697-f7db-4ecc-9f42-bde9094a3778",
                                "sense_id": "2d7f5c92-050f-3e1e-b0bb-0c4018b59e14",
                                "text": "„Der Streifenpolizist und die Pflichtschullehrerin werden sich über die 70 bis 80 Euro im Monat mehr zurecht freuen […] .“"
                            },
                            {
                                "example_id": "cb7c7fce-b56e-41ec-bcf1-796e061cf7b0",
                                "sense_id": "2d7f5c92-050f-3e1e-b0bb-0c4018b59e14",
                                "text": "„Ihr dunkelblaues Kostüm mit dem neckischen weißen Seidenschal sah nicht nach Pflichtschullehrerin in einer Provinzhauptstadt, sondern eher nach Diplomatischem Korps aus.“"
                            },
                            {
                                "example_id": "508ff035-3d0d-4fc3-b5e4-5561e87907f9",
                                "sense_id": "2d7f5c92-050f-3e1e-b0bb-0c4018b59e14",
                                "text": "„Als Wiener Pflichtschullehrerin hast Du zu diesem Thema nicht mehr viel zu sagen: Ostösterreichs Eltern haben den Skisport abgewählt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
