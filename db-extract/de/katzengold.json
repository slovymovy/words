                    {
                        "sense_id": "90f723c8-a915-365f-93f3-574167e30691",
                        "entry_id": "61c1db22-53fa-3de9-898d-e67a3c060b12",
                        "glosses": [
                            "Pyrit, ein Schwefelmineral"
                        ],
