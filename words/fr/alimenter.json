                    "frequency": "High",
                    "semantic_group_id": "nourriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fermier doit <w>alimenter</w> le bétail deux fois par jour pendant tout l'hiver."
                        },
                        {
                            "text": "Les médecins expliquent comment bien <w>alimenter</w> un jeune enfant afin de préserver ses forces."
                        }
                    ],
                    "synonyms": [
                        "nourrir",
                        "donner à manger",
                        "sustenter",
                        "repaître"
                    ],
                    "antonyms": [
                        "affamer"
                    ],
                    "common_phrases": [
                        "alimenter le bétail",
                        "bien alimenter"
                    ]
                },
                {
                    "sense_id": "0842e719-b6d7-3f9a-af3f-7d60ac27591c",
                    "sense_definition": "Fournir à une machine, un lieu ou un système les ressources nécessaires à son fonctionnement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce grand barrage hydraulique permet d'<w>alimenter</w> en électricité des milliers de foyers de la région."
                        },
                        {
                            "text": "Une source naturelle continue d'<w>alimenter</w> le réseau d'eau potable de tout le village."
                        }
                    ],
                    "synonyms": [
                        "approvisionner",
                        "nourrir"
                    ],
                    "common_phrases": [
