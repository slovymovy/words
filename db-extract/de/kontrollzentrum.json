                ],
                "senses": [
                    {
                        "sense_id": "051acacb-1015-34e3-bbef-187290a9cbbb",
                        "entry_id": "aaaaf9c9-b86b-3a95-a314-8e8438627a2e",
                        "glosses": [
                            "Zentrum, die die Kontrolle und Koordination technischer Abläufe (wie z. B. Raumflüge) ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7ba5f91-7cf4-4cd0-b968-5cee3bb35922",
                                "sense_id": "051acacb-1015-34e3-bbef-187290a9cbbb",
                                "text": "„Das Mikrowellen-System der CENTO ist voll in Betrieb genommen, und seine Leistungsfähigkeit wurde noch gesteigert durch die Anlage eine Kontrollzentrums in Teheran, das durch Techniker aus allen drei beteiligten Ländern betrieben wird.“"
                            },
                            {
                                "example_id": "fe5047eb-170b-4d1f-92b9-d8a3596e99b0",
                                "sense_id": "051acacb-1015-34e3-bbef-187290a9cbbb",
                                "text": "„Die Sicherheitskontrollen am Berliner Reichstag sollen in ein Kontrollzentrum verlagert werden, so Bundestagsvizepräsident Thierse.“"
                            },
                            {
                                "example_id": "d761f460-0d36-4cc8-867e-49622e43e086",
                                "sense_id": "051acacb-1015-34e3-bbef-187290a9cbbb",
                                "text": "„Die Sojus dockte einige Minuten früher als geplant an, wie das russische Kontrollzentrum mitteilte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c6bf977a-40d3-3e99-bfbf-a4e445978727",
                        "entry_id": "aaaaf9c9-b86b-3a95-a314-8e8438627a2e",
                        "glosses": [
                            "zentrales Menü einer Software"
                        ],
                        "tags": [
                            "Software"
                        ],
                        "examples": [
                            {
                                "example_id": "da7bcd7f-e502-4eb3-8df3-8d02ccfcc703",
                                "sense_id": "c6bf977a-40d3-3e99-bfbf-a4e445978727",
                                "text": "„Direkt nach der Anmeldung zeigt das Backend das Kontrollzentrum an, wie Sie es auch in der Abbildung auf der linken Seite sehen.“"
                            },
                            {
                                "example_id": "31d0e49b-cdb1-4835-a98b-af74b793a056",
                                "sense_id": "c6bf977a-40d3-3e99-bfbf-a4e445978727",
                                "text": "„Mit dem Kontrollzentrum können wir überprüfen, ob der EV3-Stein tatsächlich mit dem Computer verbunden ist.“"
                            },
                            {
                                "example_id": "bfb5ecfd-f880-44b7-ad2e-77b72f145e5d",
                                "sense_id": "c6bf977a-40d3-3e99-bfbf-a4e445978727",
                                "text": "„Gleich der nächste Punkt im Kontrollzentrum befaßt sich mit dem Erscheinungsbild.“"
                            },
                            {
                                "example_id": "54763448-9b46-4447-a0c5-379ecdd6c1ba",
                                "sense_id": "c6bf977a-40d3-3e99-bfbf-a4e445978727",
                                "text": "„Das Kontrollzentrum besteht aus mehreren Modulen, die separate Anwendungen darstellen, aber vom Kontrollzentrum geordnet und einheitlich dargestellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
