                ],
                "senses": [
                    {
                        "sense_id": "629855ef-053f-3f34-9358-dc63f5c98417",
                        "entry_id": "14e0a3f6-0c78-32f8-b1cf-bf65d84b9b43",
                        "glosses": [
                            "S’explorer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d66fbbf6-beaf-4463-b7cc-d97b57e4a12b",
                                "sense_id": "629855ef-053f-3f34-9358-dc63f5c98417",
                                "text": "Malheureusement, je le répète, quand on essaie de s'introvertir pour s'autoexplorer et se connaître soi-même, surgit immédiatement le contre-transfert."
                            },
                            {
                                "example_id": "e78266b3-1d93-48e0-85f5-eb723b7f2ce5",
                                "sense_id": "629855ef-053f-3f34-9358-dc63f5c98417",
                                "text": "S'autoexplorer intimement est certainement quelque chose de très sérieux ; l'Ego est, réellement, un livre à plusieurs tomes."
                            },
                            {
                                "example_id": "6db24226-715e-403c-a9f1-46fa67966ab7",
                                "sense_id": "629855ef-053f-3f34-9358-dc63f5c98417",
                                "text": "Avec cette approche, l'accent est mis sur le présent et sur la capacité du client à s'autoexplorer, à se comprendre et à changer sa façon d'être ou d'agir."
                            }
                        ]
                    }
