                        "examples": [
                            {
                                "example_id": "57b5c76f-d6ca-4c42-adbe-006b53ebc60b",
                                "sense_id": "9aade0c2-10d2-33ae-9366-b74b90ff2afd",
                                "text": "Im Foyer des Schlosses hängt ein Zinnleuchter."
                            },
                            {
                                "example_id": "8fce45d9-b5e9-45e1-b350-b800a6ac5c88",
                                "sense_id": "9aade0c2-10d2-33ae-9366-b74b90ff2afd",
                                "text": "Beim Abriss des alten Anwesens wurden mehrere alte Zinnleuchter gefunden."
                            },
                            {
                                "example_id": "9ccdb022-9c99-44ab-ae2e-b601da9b2ac3",
                                "sense_id": "9aade0c2-10d2-33ae-9366-b74b90ff2afd",
                                "text": "Bei meinem letzten Museumsbesuch haben mir die erzgebirgischen Zinnleuchter, die auch heute noch als kostbarer Tischschmuck in den Familien weitergegeben werden, besonders gut gefallen."
                            }
                        ],
