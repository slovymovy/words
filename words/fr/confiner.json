{
    "word_family": [
        "confin",
        "confinement",
        "déconfiner",
        "déconfinement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4dee4e50-e525-39e2-be1e-fc068f5008c6",
                    "sense_definition": "Enfermer ou contraindre une personne à rester dans un espace limité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "enfermement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant l'épidémie, les autorités ont décidé de <w>confiner</w> la population pour freiner les contagions."
                        },
                        {
                            "text": "Malade depuis plusieurs jours, il préfère se <w>confiner</w> chez lui pour éviter de contaminer ses collègues."
                        }
                    ],
                    "synonyms": [
                        "enfermer",
                        "cloîtrer",
                        "isoler"
                    ],
                    "antonyms": [
                        "déconfiner"
                    ],
                    "common_phrases": [
                        "se confiner chez soi",
                        "confiner la population"
                    ]
                },
                {
                    "sense_id": "2b96d893-1f93-3c6c-9c23-09512205375c",
                    "sense_definition": "Restreindre ou limiter quelqu'un ou quelque chose à un domaine, une fonction ou une tâche.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "limitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune avocat refuse de se <w>confiner</w> aux affaires de droit immobilier."
                        },
                        {
                            "text": "La direction a <w>confiné</w> cet employé dans des fonctions purement administratives."
                        }
                    ],
                    "synonyms": [
                        "cantonner",
                        "restreindre",
                        "limiter"
                    ],
                    "common_phrases": [
                        "se confiner à un rôle",
                        "confiner dans une tâche"
                    ]
                },
                {
                    "sense_id": "62b68120-2a6a-34ca-b0ab-7f01f51adfd0",
                    "sense_definition": "Être tout proche d'une attitude, d'un état ou d'une situation extrême ; frôler.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "proximite_abstraite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son entêtement aveugle dans cette négociation <w>confine</w> véritablement à l'absurde."
                        },
                        {
                            "text": "L'audace extraordinaire de ce projet architectural <w>confine</w> parfois à la folie."
                        }
                    ],
                    "synonyms": [
                        "frôler",
                        "avoisiner"
                    ],
                    "common_phrases": [
                        "confiner à l'absurde",
                        "confiner à la folie"
                    ]
                },
                {
                    "sense_id": "990ce5ed-30e0-3604-ab43-9214107ab0e6",
                    "sense_definition": "Être adjacent ou contigu aux limites d'un pays, d'une région ou d'un domaine géographique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "proximite_spatiale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vaste domaine seigneurial <w>confine</w> aux collines boisées de la vallée voisine."
                        },
                        {
                            "text": "Cette petite principauté historique <w>confinait</w> autrefois à deux grands empires rivaux."
                        }
                    ],
                    "synonyms": [
                        "avoisiner",
                        "border",
                        "jouxter"
                    ],
                    "common_phrases": [
                        "confiner à la frontière",
                        "confiner avec un pays"
                    ]
                }
            ]
        }
    ]
}