                "senses": [
                    {
                        "sense_id": "19868bb7-d738-377f-9971-4c313f955137",
                        "entry_id": "9278e7b0-f58d-3740-8a8d-f3d17d8103ad",
                        "glosses": [
                            "Dokument eines Auftragnehmers, das beschreibt, wie er die Anforderungen, die ein Gerät oder ein technisches System erfüllen muss, umsetzen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ba4c4e6-4ce6-47c6-9afc-245b41e8e0dc",
                                "sense_id": "19868bb7-d738-377f-9971-4c313f955137",
                                "text": "Das Pflichtenheft ist die Grundlage für die Abrechnung aller erbrachten Leistungen."
                            },
                            {
                                "example_id": "312ca3f1-8a2e-4758-9017-bfbbe40a29f2",
                                "sense_id": "19868bb7-d738-377f-9971-4c313f955137",
                                "text": "Sie sollten sich genauestens an das Pflichtenheft halten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
