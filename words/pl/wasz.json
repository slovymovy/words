    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "406085cd-f88e-320a-9bd3-04e18c0bcb22",
                    "sense_definition": "zaimek dzierżawczy oznaczający, że coś należy do osób, do których się zwracamy (liczba mnoga), lub jest z nimi związane",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy to jest <w>wasz</w> nowy samochód?",
                            "target_lang_translations": {
                                "ru": "Это <w>ваша</w> новая машина?",
                                "en": "Is this <w>your</w> new car?"
                            }
                        },
                        {
                            "text": "To nie jest <w>wasza</w> wina, że pociąg się spóźnił.",
                            "target_lang_translations": {
                                "ru": "Это не <w>ваша</w> вина, что поезд опоздал.",
                                "en": "It is not <w>your</w> fault that the train was late."
                            }
                        },
                        {
                            "text": "<w>Wasi</w> rodzice na pewno będą z was dumni.",
                            "target_lang_translations": {
                                "ru": "<w>Ваши</w> родители наверняка будут вами гордиться.",
                                "en": "<w>Your</w> parents will surely be proud of you."
                            }
                        }
                    ],
                    "antonyms": [
                        "nasz",
                        "twój"
                    ],
                    "common_phrases": [
                        "wasze zdrowie",
                        "wasza sprawa",
                        "wasz problem",
                        "cały wasz"
                    ],
                    "target_lang_definitions": {
                        "ru": "притяжательное местоимение, указывающее на принадлежность группе лиц, к которым обращаются, или связь с ними",
                        "en": "a possessive determiner/pronoun indicating that something belongs to or is associated with the group of people being addressed (plural)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ваш",
                                "target_lang_sense_clarification": "притяжательное местоимение (множественное число)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "your",
                                "target_lang_sense_clarification": "possessive determiner (plural)"
                            },
                            {
                                "target_lang_word": "yours",
                                "target_lang_sense_clarification": "possessive pronoun (plural)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "014b8354-7497-33a2-81b7-11e9e3003909",
                    "sense_definition": "dawna lub uroczysta forma zwracania się do jednej osoby, stosowana obecnie głównie w tytułach honorowych lub stylizacji historycznej",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wasza</w> Królewska Mość, posłowie czekają w sali tronowej.",
                            "target_lang_translations": {
                                "ru": "<w>Ваше</w> Величество, послы ждут в тронном зале.",
                                "en": "<w>Your</w> Royal Majesty, the envoys are waiting in the throne room."
                            }
                        },
                        {
                            "text": "Niech <w>wasza</w> mądrość, panie, wskaże nam drogę.",
                            "target_lang_translations": {
                                "ru": "Пусть <w>ваша</w> мудрость, господин, укажет нам путь.",
                                "en": "May <w>your</w> wisdom, my lord, show us the way."
                            }
                        }
                    ],
                    "synonyms": [
                        "pański",
                        "pana",
                        "pani"
                    ],
                    "common_phrases": [
                        "Wasza Wysokość",
                        "Wasza Królewska Mość",
                        "Wasza Miłość"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "używane w tytułach i dawnej polszczyźnie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "устаревшая или торжественная форма обращения к одному лицу, используемая в титулах и историческом контексте",
                        "en": "an archaic or formal way of addressing a single person, nowadays used mainly in honorific titles or historical styling"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ваш",
                                "target_lang_sense_clarification": "в титулах и почтительных обращениях"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "Your",
                                "target_lang_sense_clarification": "used in titles such as Your Majesty, Your Highness"
                            },
                            {
                                "target_lang_word": "thou",
                                "target_lang_sense_clarification": "archaic singular address (contextual equivalent: thy/your)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
