                        "sense_id": "337a5faf-b8bc-372b-b4ef-733f2b7d0dde",
                        "entry_id": "e4b5e415-3928-31d3-9b45-8459547ea7bf",
                        "glosses": [
                            "Wohngebiet, errichtet für Arbeiter und auch von diesen bewohnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09947ddb-a41a-40d4-b9d0-6b3943b5d8ae",
                                "sense_id": "337a5faf-b8bc-372b-b4ef-733f2b7d0dde",
                                "text": "„Vor allem Horst, der ja Indianer und Förster werden wollte, war hingerissen von der wilden Natur, voller Sümpfe und Moore, die so anders war als seine alte Heimat mit den Arbeitersiedlungen und Bergwerken.“"
                            },
                            {
                                "example_id": "96ec2796-2b98-4ea1-9518-de6c7216093c",
                                "sense_id": "337a5faf-b8bc-372b-b4ef-733f2b7d0dde",
                                "text": "„Frau N. wohnt in einem Hinterhaus einer Arbeitersiedlung, die zufällig nicht von Bomben zerstört war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
