                    "sense_definition": "Personne qui a un goût très vif et un dévouement marqué pour un domaine ou une activité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "amateur_fervent",
                    "name_type": "no",
                    "examples": [
