        "fr-extract.jsonl": [
            {
                "entry_id": "6489b434-98de-3ca9-9f13-ad06d96caf9e",
                "word": "salopard",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ac89919f-ec22-4cfb-86ad-e858252f1e1c",
                        "entry_id": "6489b434-98de-3ca9-9f13-ad06d96caf9e",
                        "tags": [
                            "plural"
                        ],
                        "form": "salopards"
                    },
                    {
                        "form_id": "fa5ab1fe-e349-46ce-821e-3e2dc1a2d1ab",
                        "entry_id": "6489b434-98de-3ca9-9f13-ad06d96caf9e",
                        "tags": [],
                        "form": "salaupard"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8472849-825c-3ec1-9a64-45cd08f50812",
                        "entry_id": "6489b434-98de-3ca9-9f13-ad06d96caf9e",
                        "glosses": [
                            "Salaud, homme abject, vil, sans scrupules."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "035a2d19-4a09-452c-9df8-11196b27c745",
                                "sense_id": "d8472849-825c-3ec1-9a64-45cd08f50812",
                                "text": "– Eh bien, en voilà des manières ! Est-ce que tu ne peux pas faire attention, petit salopard ?"
                            },
                            {
                                "example_id": "a7f2462a-7e41-46c0-b79b-d05ed49bfe69",
                                "sense_id": "d8472849-825c-3ec1-9a64-45cd08f50812",
                                "text": "— Vous avez tout fait, petit salopard, pour vous attirer la réprobation de vos chefs et de vos professeurs."
                            },
                            {
                                "example_id": "428c98d8-cf7b-4101-92bf-f24d325fde8b",
                                "sense_id": "d8472849-825c-3ec1-9a64-45cd08f50812",
                                "text": "Voleur ! Gredin ! Filou ! Bandit ! Salopard ! Elle trouve encore une quatorzaine d'autres épithètes du même tonneau. Tout en vitupérant, elle ramasse le gallinacé et l’ausculte."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1930139-8fc1-3902-9d9a-3e0ffdc4a9fb",
                        "entry_id": "6489b434-98de-3ca9-9f13-ad06d96caf9e",
                        "glosses": [
                            "Autochtone insurgé dans les anciennes colonies françaises."
                        ],
                        "tags": [
                            "dated",
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "dab48435-06d1-40ad-aeec-e32bde148fb1",
                                "sense_id": "b1930139-8fc1-3902-9d9a-3e0ffdc4a9fb",
                                "text": "C'est le fanion de la légion !\nLes salopards tiennent la plaine,\nLà-haut, dans le petit fortin.\nDepuis une longue semaine,\nLa mort en prend chaque matin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8db8f96-dbfe-4ba7-8170-4bada4f4b854",
                        "source_entry_id": "6489b434-98de-3ca9-9f13-ad06d96caf9e",
                        "target_lang_word": "Dreckskerl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dreckskerl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e977dfc-4ebe-325d-a102-56bbff8caee1",
                                        "entry_id": "9df3fa87-5038-3f18-a569-457d02475187",
                                        "glosses": [
                                            "widerlicher, hinterhältiger Mann"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b62ce5fc-7b48-4f89-b3ff-6e75add7e02d",
                                                "sense_id": "5e977dfc-4ebe-325d-a102-56bbff8caee1",
                                                "text": "„Dávila war nach einer halben Stunde mit Germán fertig, der ernst und gefaßt herauskam und sich zurückhielt, bis wir auf der Straße angelangt waren, wo er mir leise und verstört mitteilte, daß Dávila ein Dreckskerl sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fd83ec4-6e7f-4a9d-9b6c-320d4d6550d6",
                        "source_entry_id": "6489b434-98de-3ca9-9f13-ad06d96caf9e",
                        "target_lang_word": "Schwein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8b06745-abc3-3367-af1d-418fffc0d890",
                                        "entry_id": "9f9504f3-b53e-3f40-97ef-1ff34deec286",
                                        "glosses": [
                                            "Säugetier und Paarhufer mit kurzen Beinen, verlängerter rüsselartiger Schnauze, Borsten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff79d57c-ac36-49d4-afa4-6c074b5a41ec",
                                                "sense_id": "e8b06745-abc3-3367-af1d-418fffc0d890",
                                                "text": "Hast du die Schweine schon gefüttert?"
                                            },
                                            {
                                                "example_id": "170f7cae-9957-4bd8-9605-3df56d975cb2",
                                                "sense_id": "e8b06745-abc3-3367-af1d-418fffc0d890",
                                                "text": "„Doch zu einem geringen Maße bauen sie auch Kartoffeln an und halten Kleinvieh wie Hühner und Schweine, landwirtschaftliche Techniken, die sie von ihren Nachbarn, den Aymará übernommen haben“."
                                            },
                                            {
                                                "example_id": "72250262-2b5f-486d-9331-b78cfad10ca0",
                                                "sense_id": "e8b06745-abc3-3367-af1d-418fffc0d890",
                                                "text": "„Ja, das Schreiben und das Lesen",
                                                "translation": "poetisch war ich nie!“"
                                            },
                                            {
                                                "example_id": "ca5b4ae9-172c-4e8b-8fba-1fbf8d801da4",
                                                "sense_id": "e8b06745-abc3-3367-af1d-418fffc0d890",
                                                "text": "„Die Ausgräber deckten rund 275000 Tierknochen auf, den größten Anteil bildeten Reste von Schweinen, Rindern, Schafen, Ziegen, Hunden, Pferden und Hühnern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3bdf1c89-4d3a-3ed4-bf82-71b608ce88ea",
                                        "entry_id": "9f9504f3-b53e-3f40-97ef-1ff34deec286",
                                        "glosses": [
                                            "Schweinefleisch, Schweinernes"
                                        ],
                                        "tags": [
                                            "kurz und synonym für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eacaa299-c608-44f7-b814-33a579710f5b",
                                                "sense_id": "3bdf1c89-4d3a-3ed4-bf82-71b608ce88ea",
                                                "text": "Nein danke, ich esse kein Schwein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a515874a-7bc7-3eef-9464-382225da4d9c",
                                        "entry_id": "9f9504f3-b53e-3f40-97ef-1ff34deec286",
                                        "glosses": [
                                            "Schimpfwort für einen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "501dc9fa-51e4-4177-b9c1-1d7b3f861244",
                                                "sense_id": "a515874a-7bc7-3eef-9464-382225da4d9c",
                                                "text": "ein richtiges Schwein, er ist voll wie ein Schwein, du dummes Schwein!"
                                            },
                                            {
                                                "example_id": "ecc5e1bb-6235-48d4-9d40-c5221f000c88",
                                                "sense_id": "a515874a-7bc7-3eef-9464-382225da4d9c",
                                                "text": "Das Leben ist grausam und Gabi ein Schwein (Die Prinzen)"
                                            },
                                            {
                                                "example_id": "54ec02be-416a-49f5-9aae-c86d7b137403",
                                                "sense_id": "a515874a-7bc7-3eef-9464-382225da4d9c",
                                                "text": "„Während ich das Loblied von Paris fang, betrat eine mit Edelsteinen bedeckte, riesige Dame die Loge nebenan. Ihr ungeheuerer Umfang verblüffte mich, und ich sagte dummerweise zu dem Herrn: »Was ist denn das für ein dickes Schwein?« »Die Frau dieses dicken Schweins.« »Oh, mein Herr, ich bitte Sie eine Million mal um Entschuldigung!«“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6bc494f6-b569-34e3-92b6-8d368626e72f",
                                        "entry_id": "9f9504f3-b53e-3f40-97ef-1ff34deec286",
                                        "glosses": [
                                            "Schimpfwort für einen",
                                            "gemeinen Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3a\""
                                    },
                                    {
                                        "sense_id": "1173752a-71ea-320c-b759-f74a58554bbb",
                                        "entry_id": "9f9504f3-b53e-3f40-97ef-1ff34deec286",
                                        "glosses": [
                                            "Schimpfwort für einen",
                                            "schmutzigen oder obszönen Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3b\""
                                    },
                                    {
                                        "sense_id": "8bf24711-0825-3c4f-96d0-f752dfd9fd82",
                                        "entry_id": "9f9504f3-b53e-3f40-97ef-1ff34deec286",
                                        "glosses": [
                                            "„schweine-, Schweine-“ (unbetont): Übertreibung, Steigerung (meist negativ: Schimpfwort)"
                                        ],
                                        "tags": [
                                            "Präfixoid"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9abe7be-46fb-4a1f-8ad9-45f1b31b169f",
                                                "sense_id": "8bf24711-0825-3c4f-96d0-f752dfd9fd82",
                                                "text": "Das Wetter ist heute mal wieder schweinegeil."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c827e33b-d9c7-39ef-862a-f29add504ec8",
                                        "entry_id": "9f9504f3-b53e-3f40-97ef-1ff34deec286",
                                        "glosses": [
                                            "(meist in Verbindung mit haben und ohne Artikel) Glück; positiver Situationszufall (siehe auch Redewendung: Schwein haben)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f691b3c8-d299-4ac3-8bde-afb0c46c2351",
                                                "sense_id": "c827e33b-d9c7-39ef-862a-f29add504ec8",
                                                "text": "Da hast du aber Schwein gehabt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
