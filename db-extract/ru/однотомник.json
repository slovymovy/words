                                        "entry_id": "465bd2e8-6056-35b5-b58d-f7867bbb171c",
                                        "glosses": [
                                            "Band zum Sammeln verschiedener Sammelobjekte wie einzelne Texte, Schriften, Gesetzesblätter, Briefmarken, Münzen und deren Abbildungen; eingebundenes Sammelwerk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58a5ca14-d63d-4f23-9ec2-3574dc07447b",
                                                "sense_id": "66a6d137-213a-3d7e-b280-3edaea08638a",
                                                "text": "Das Regal ist angefüllt mit Sammelbänden."
                                            },
                                            {
                                                "example_id": "4659c8e3-d58d-4ca2-8f16-8d865caa11cf",
                                                "sense_id": "66a6d137-213a-3d7e-b280-3edaea08638a",
                                                "text": "„Von den drei hier zu einem Sammelband vereinigten Frühdrucken können die beiden nachgebundenen Inkunabeldrucke bislang weder abschließend datiert, noch gesichert einer Druckwerkstatt zugewiesen werden.“"
                                            },
                                            {
                                                "example_id": "a48a0e3c-cd41-4b94-a8d7-1f61788d0a9e",
                                                "sense_id": "66a6d137-213a-3d7e-b280-3edaea08638a",
                                                "text": "„Es ist aufschlussreich, dass bei einer erneuten Veröffentlichung dieses Vortrages in einem 1949 erschienen Sammelband die zitierte Textpassage fehlt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
