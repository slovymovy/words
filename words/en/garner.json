        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8d007ed3-ba65-33be-93ab-4d41cb6da4f1",
                    "sense_definition": "To accumulate, acquire, or earn something through effort, achievement, or reputation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "acquire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new independent film managed to <w>garner</w> praise from critics across the globe.",
                            "target_lang_translations": {
                                "ru": "Новому независимому фильму удалось <w>снискать</w> похвалу критиков со всего мира."
                            }
                        },
                        {
                            "text": "The politician worked tirelessly to <w>garner</w> support from local community leaders.",
                            "target_lang_translations": {
                                "ru": "Политик неустанно работал, чтобы <w>заручиться</w> поддержкой лидеров местных сообществ."
                            }
