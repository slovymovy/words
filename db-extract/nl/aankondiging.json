                ],
                "senses": [
                    {
                        "sense_id": "1743a61f-f872-3f0f-938e-3f15bcf4a90b",
                        "entry_id": "c2247680-06d8-31e8-94b9-1e4ea2098bc8",
                        "glosses": [
                            "bekendmaking, verklaring"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ffc2e6b-4777-40c3-a083-5c83332d498d",
                                "sense_id": "1743a61f-f872-3f0f-938e-3f15bcf4a90b",
                                "text": "\"Miljardair Russell Pickett, directeur en stichter van Pickett Engineering, bezorgde gisteravond bij de bekendmaking van de Indianapolis Prize zijn in avondkleding gestoken gehoor een schok met de aankondiging dat hij zijn volledige bezit nalaat aan zijn huisdier, een tuatara."
                            },
                            {
                                "example_id": "5a4d6464-2dcf-49d2-bdce-cee6ce26931d",
                                "sense_id": "1743a61f-f872-3f0f-938e-3f15bcf4a90b",
                                "text": "Over de hele wereld wordt bedroefd gereageerd op het overlijden van paus Franciscus. Na de aankondiging vanochtend luidden de kerkklokken in heel Rome. Kort na het nieuws stroomden de reacties binnen, via X en (internationale) media. Wereldleiders en politici zeggen verdrietig te zijn en prijzen de paus voor zijn inzet voor kwetsbare mensen in de samenleving."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "320ea4c5-74f7-436a-99ea-2ed62cd3b5b9",
                        "source_entry_id": "c2247680-06d8-31e8-94b9-1e4ea2098bc8",
                        "source_sense_id": "1743a61f-f872-3f0f-938e-3f15bcf4a90b",
                        "target_lang_word": "Ankündigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ankündigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9566b36-6c54-34c4-9b61-ed963f04f689",
                                        "entry_id": "ddfe11a5-aa50-32f9-a54a-8f6155b987d7",
                                        "glosses": [
                                            "das Ankündigen; Bekanntgabe, die im Voraus getätigt wird; vorherige Benachrichtigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "964ffc7c-de59-4fb1-90ce-4b1281af6212",
                                                "sense_id": "c9566b36-6c54-34c4-9b61-ed963f04f689",
                                                "text": "Durch die Ankündigung der Geschäftseröffnung werden mehr Kunden erwartet."
                                            },
                                            {
                                                "example_id": "d6e3c157-fdb2-4cc9-b37a-70a5fec2aa64",
                                                "sense_id": "c9566b36-6c54-34c4-9b61-ed963f04f689",
                                                "text": "„Ihre großspurigen Ankündigungen zerplatzten wie Seifenblasen.“"
                                            },
                                            {
                                                "example_id": "a85344cb-06b1-47f0-a477-2623e7b205f7",
                                                "sense_id": "c9566b36-6c54-34c4-9b61-ed963f04f689",
                                                "text": "„Ohne Ankündigung stellte der ORF am Dienstag ein lang geplantes Projekt online: Sendungen von Ö1, Ö3, FM4 und den neun ORF-Regionalradios findet man nun auf einem Portal.“"
                                            },
                                            {
                                                "example_id": "97c493b1-eda1-4dbb-9dc5-49db3bd5112d",
                                                "sense_id": "c9566b36-6c54-34c4-9b61-ed963f04f689",
                                                "text": "„Sie liebte Schnäppchen, gepresste Blumen und vergessene Schätze, mich und Milena, und sie liebte es, Ankündigungen von Haushaltsauflösungen in der Zeitung zu finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6169885e-9052-423f-9480-01028876399b",
                        "source_entry_id": "c2247680-06d8-31e8-94b9-1e4ea2098bc8",
                        "source_sense_id": "1743a61f-f872-3f0f-938e-3f15bcf4a90b",
                        "target_lang_word": "announcement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "announcement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "270cd55b-a471-3a9c-9ec5-c712222d05d2",
                                        "entry_id": "6b19a5ec-3949-37b6-a792-7bc57f21940b",
                                        "glosses": [
                                            "An act of announcing, or giving notice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4db82f24-0394-4e90-af27-f15c15170461",
                                                "sense_id": "270cd55b-a471-3a9c-9ec5-c712222d05d2",
                                                "text": "He raised his hand to make his announcement and said, \"Excuse me everyone, I have an announcement to make.\""
                                            },
                                            {
                                                "example_id": "cc69f6df-c7ea-44ac-8eea-6ea76f41a500",
                                                "sense_id": "270cd55b-a471-3a9c-9ec5-c712222d05d2",
                                                "text": "Where else in the world can you pre-order sushi and fondue on some of the trains, travel in family carriages equipped with mini-playgrounds, or use a request stop button at some small stations? Where else can you hear the announcement: \"The train at Platform 4 is ten minutes late due to an incident in another country,\" as I did once at the Swiss station of Spiez?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb782c23-2cfc-320c-8507-74b7bdf55019",
                                        "entry_id": "6b19a5ec-3949-37b6-a792-7bc57f21940b",
                                        "glosses": [
                                            "That which conveys what is announced."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fed345d-aad2-411c-8c5c-4e12133a1063",
                                                "sense_id": "fb782c23-2cfc-320c-8507-74b7bdf55019",
                                                "text": "This announcement was made during the first training session."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdfd8ebc-9aed-38a2-a8b1-e56754ae36e9",
                                        "entry_id": "6b19a5ec-3949-37b6-a792-7bc57f21940b",
                                        "glosses": [
                                            "The content which is announced."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd1c62a1-7956-43bf-bc25-3df056a43231",
                                                "sense_id": "cdfd8ebc-9aed-38a2-a8b1-e56754ae36e9",
                                                "text": "The announcement implied that somebody needed a spare Toshiba charger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5920f47-3066-4ca4-8d80-90952d1b3ef3",
                        "source_entry_id": "c2247680-06d8-31e8-94b9-1e4ea2098bc8",
                        "source_sense_id": "1743a61f-f872-3f0f-938e-3f15bcf4a90b",
                        "target_lang_word": "annonce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "annonce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f12ec19-3932-3d3e-b154-981107196497",
                                        "entry_id": "83bb25cf-693a-3c17-9610-d35da4c0d59a",
                                        "glosses": [
                                            "Avis par lequel on fait savoir quelque chose au public, verbalement ou par écrit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fea00602-8a91-4c62-97a6-857f65067ae5",
                                                "sense_id": "2f12ec19-3932-3d3e-b154-981107196497",
                                                "text": "Il est conseillé de personnaliser votre messagerie par une annonce d’accueil qui vous est propre et de la protéger par un code d’accès. Ainsi, vous serez en mesure de l’interroger depuis un autre téléphone et ce, même lorsque vous vous trouvez à l’étranger."
                                            },
                                            {
                                                "example_id": "66fba05b-23fc-459a-8a48-6413cc523790",
                                                "sense_id": "2f12ec19-3932-3d3e-b154-981107196497",
                                                "text": "Le radiodiffuseur doit être autorisé à signaler que la suppression d’un programme ou la diffusion d’un message d’annonce est le fruit d’une instruction ministérielle."
                                            },
                                            {
                                                "example_id": "c183aae0-1b0a-4665-82c4-1097a4626643",
                                                "sense_id": "2f12ec19-3932-3d3e-b154-981107196497",
                                                "text": "Cette maison n’est pas la résidence secondaire de l’un d’entre nous : on nous l’a prêtée. Et nous nous y sommes installés avant l’annonce du confinement, qui nous a pris de court alors que nous randonnions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97d275f9-c4cc-3e44-ac2b-253ca52ef110",
                                        "entry_id": "83bb25cf-693a-3c17-9610-d35da4c0d59a",
                                        "glosses": [
                                            "Pause publicitaire."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db92e3a2-f366-40bf-95bd-e98a15b79f35",
                                                "sense_id": "97d275f9-c4cc-3e44-ac2b-253ca52ef110",
                                                "text": "On pense souvent que s’il n’y avait jamais d’annonces à la TV il n’y aurait pas de révolutions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "annonce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66b87713-679a-387a-8fdc-42082854678b",
                                        "entry_id": "b3e34b17-0388-3b45-8393-6f82920ff2a4",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent de annoncer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b610c495-ad8c-4dfd-ad0d-a3b14aafaa65",
                                                "sense_id": "66b87713-679a-387a-8fdc-42082854678b",
                                                "text": "Je vous annonce donc le naufrage de cette demi-vertu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c130d08-aa25-3447-89c4-48231761e29f",
                                        "entry_id": "b3e34b17-0388-3b45-8393-6f82920ff2a4",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent de annoncer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec86a28b-5f76-4b78-b6ec-59af5d517a40",
                                                "sense_id": "9c130d08-aa25-3447-89c4-48231761e29f",
                                                "text": "Ce qu’il y a de particulier et qui annonce la force de tempérament de cette demoiselle, c’est qu’elle aimait M. Fontaine qui était jeune et cependant se laissait guerluchonner par M. de Montamand beaucoup plus vieux et moins fait pour plaire ;"
                                            },
                                            {
                                                "example_id": "886f255e-a870-4168-a703-a5c88a06e4ed",
                                                "sense_id": "9c130d08-aa25-3447-89c4-48231761e29f",
                                                "text": "Ici, s’annonce le second travail : la prise en compte des objets, des hypothèses, des dépositions, des théories, et des discours eux-mêmes, pour les rectifier, les dé-falsifier, les corriger, leur donner une attestation historique et une validité scientifique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf428c60-3101-31af-b7a8-f745775ef2c5",
                                        "entry_id": "b3e34b17-0388-3b45-8393-6f82920ff2a4",
                                        "glosses": [
                                            "Première personne du singulier du subjonctif présent de annoncer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9745ffd6-290b-301f-9588-a7cc071d34fc",
                                        "entry_id": "b3e34b17-0388-3b45-8393-6f82920ff2a4",
                                        "glosses": [
                                            "Troisième personne du singulier du subjonctif présent de annoncer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13bcac06-ef0b-3f41-b724-3327c7f5ef59",
                                        "entry_id": "b3e34b17-0388-3b45-8393-6f82920ff2a4",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif de annoncer."
                                        ],
