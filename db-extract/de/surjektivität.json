                "senses": [
                    {
                        "sense_id": "a0bcd993-2c00-3524-a17f-810f4cae5024",
                        "entry_id": "9de32026-affa-30cb-8c09-0c572dbcc779",
                        "glosses": [
                            "Eigenschaft einer Funktion, dass Werte- und Zielmenge übereinstimmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ae6c2dd-f2c8-421c-956c-983f5f55c75b",
                                "sense_id": "a0bcd993-2c00-3524-a17f-810f4cae5024",
                                "text": "„Wohingegen die Frage der Injektivität einer Abbildung durch die Zuordnungsvorschrift x ↦ f(x) beantwortet wird, kommt es für die Surjektivität (von lat. subicere = unterordnen, unterwerfen) nur darauf an, ob der Wertebereich N so ‚klein‘ gewählt wurde, dass jedes y ∈ N als Bild mindestens eines x ∈ M auftritt.“"
                            },
                            {
                                "example_id": "1d8ed919-7f34-4398-92e3-565d66fcf31d",
                                "sense_id": "a0bcd993-2c00-3524-a17f-810f4cae5024",
                                "text": "„Da f_2 keine negativen Werte annimmt, hat zum Beispiel -42∈ R kein Urbild, was die Surjektivität widerlegt.“"
                            },
                            {
                                "example_id": "5d7c2923-6e6c-41ec-9fb6-5142e032c4f2",
                                "sense_id": "a0bcd993-2c00-3524-a17f-810f4cae5024",
                                "text": "„Die Surjektivität folgt damit aus der Stetigkeit der Exponentialfunktion und dem Zwischenwertsatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
