{
    "word_family": [
        "pursue",
        "pursuit",
        "pursuable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f4096683-32e3-3722-89fb-b17bfba1a2e6",
                    "sense_definition": "A person or thing that chases, follows, or seeks to catch someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chaser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fugitive looked back constantly to see if any <w>pursuer</w> was gaining on him.",
                            "target_lang_translations": {
                                "de": "Der Flüchtige blickte ständig zurück, um zu sehen, ob ein <w>Verfolger</w> ihm näher kam."
                            }
                        },
                        {
                            "text": "She managed to elude her relentless <w>pursuers</w> by ducking into a crowded subway station.",
                            "target_lang_translations": {
                                "de": "Es gelang ihr, ihren unerbittlichen <w>Verfolgern</w> zu entkommen, indem sie in eine überfüllte U-Bahn-Station schlüpfte."
                            }
                        }
                    ],
                    "synonyms": [
                        "chaser",
                        "follower",
                        "hunter"
                    ],
                    "antonyms": [
                        "quarry",
                        "prey"
                    ],
                    "common_phrases": [
                        "relentless pursuer",
                        "escape pursuers",
                        "elude pursuers"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person oder Sache, die jemanden oder etwas jagt, verfolgt oder einzuholen versucht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Verfolger",
                                "target_lang_sense_clarification": "männlich oder allgemein"
                            },
                            {
                                "target_lang_word": "Verfolgerin",
                                "target_lang_sense_clarification": "weiblich"
                            },
                            {
                                "target_lang_word": "Jäger",
                                "target_lang_sense_clarification": "figurativ oder bei der Jagd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c12a5824-5556-3150-a784-397a0df3f63a",
                    "sense_definition": "The person or party who initiates a lawsuit; a plaintiff.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court decided in favor of the <w>pursuer</w> after reviewing all the documented evidence.",
                            "target_lang_translations": {
                                "de": "Das Gericht entschied nach Prüfung aller dokumentierten Beweise zugunsten des <w>Klägers</w>."
                            }
                        },
                        {
                            "text": "Counsel for the <w>pursuer</w> argued that the contract had been breached intentionally.",
                            "target_lang_translations": {
                                "de": "Der Anwalt des <w>Klägers</w> argumentierte, dass der Vertrag vorsätzlich gebrochen worden sei."
                            }
                        }
                    ],
                    "synonyms": [
                        "plaintiff",
                        "claimant"
                    ],
                    "antonyms": [
                        "defender",
                        "defendant"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used primarily in Scots law"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Die klagende Partei in einem Gerichtsverfahren; der Kläger (besonders im schottischen Recht)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kläger",
                                "target_lang_sense_clarification": "Rechtssprache, männlich oder allgemein"
                            },
                            {
                                "target_lang_word": "Klägerin",
                                "target_lang_sense_clarification": "Rechtssprache, weiblich"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}