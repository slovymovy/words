                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67509b2d-b7eb-3c3b-868d-02a64d0949a4",
                                        "entry_id": "cc2b931a-d20b-3b85-8fbe-c9cae554de0d",
                                        "glosses": [
                                            "One of the portions of a curve that extends outwards to an indefinitely great distance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65e64a3a-c8a4-47f9-805f-366271f5a16c",
