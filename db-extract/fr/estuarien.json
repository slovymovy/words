                                "target_senses": [
                                    {
                                        "sense_id": "4fc607ab-d872-3478-aa9e-6268e80f315a",
                                        "entry_id": "51036805-6440-3b34-842b-0e7e55edfe44",
                                        "glosses": [
                                            "Of or pertaining to an estuary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6ed6087-1b7c-4f4f-b5ac-3dd8e232896b",
                                                "sense_id": "4fc607ab-d872-3478-aa9e-6268e80f315a",
                                                "text": "1977, Sewell H. Hopkins, Sam R. Petrocelli, Limiting Factors Affecting the Commercial Fisheries in the Gulf of Mexico, U.S. Environmental Protection Agency, Estuarine Pollution Control and Assessment: Proceedings of a Conference, Volume 1, page 179,\nThe shellfishes, by far the most valuable part of gulf coast commercial fisheries, are even more estuarine than the finfishes."
                                            },
                                            {
                                                "example_id": "a9d0add1-6590-45de-b5ea-a8845ee5d506",
                                                "sense_id": "4fc607ab-d872-3478-aa9e-6268e80f315a",
                                                "text": "The small lagoons of southern New Jersey receive an insignificant input of freshwater from watersheds of Cape May Peninsula compared to larger, more estuarine bays to the north (Kran 1975)."
                                            },
                                            {
                                                "example_id": "f1f83292-b24e-407d-b0e3-1cc0c61c679e",
                                                "sense_id": "4fc607ab-d872-3478-aa9e-6268e80f315a",
                                                "text": "Some species are more estuarine than others, for example Pseudotolithus typus replaces P. senegalensis as conditions become more estuarine and Pentanemus quinquarius replaces Galeoides decadactylus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ce65f25-8ffb-37d2-aa8c-3bfb3adb9580",
                                        "entry_id": "51036805-6440-3b34-842b-0e7e55edfe44",
                                        "glosses": [
                                            "Formed in an estuary by alluvial deposition."
                                        ],
