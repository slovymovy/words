{
    "word_family": [
        "conspiracy",
        "conspirator",
        "conspiratorial",
        "conspiratorially"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "56fc1df2-8e69-3d74-92ff-d71c013e716f",
                    "sense_definition": "To secretly plot or make plans together, often with the intention to bring about harmful or illegal results.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plotting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group of rebels met in the basement to <w>conspire</w> against the corrupt government.",
                            "target_lang_translations": {
                                "ru": "Группа повстанцев встретилась в подвале, чтобы <w>сговориться</w> против коррумпированного правительства."
                            }
                        },
                        {
                            "text": "They began to <w>conspire</w> together in secret to steal the valuable documents from the office.",
                            "target_lang_translations": {
                                "ru": "Они начали тайно <w>замышлять</w> кражу ценных документов из офиса."
                            }
                        }
                    ],
                    "synonyms": [
                        "collogue"
                    ],
                    "common_phrases": [
                        "conspire together",
                        "conspire against"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тайно планировать или вступать в сговор, часто с целью совершения вредных или незаконных действий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сговариваться",
                                "target_lang_sense_clarification": "вступать в тайный сговор"
                            },
                            {
                                "target_lang_word": "замышлять",
                                "target_lang_sense_clarification": "планировать что-то предосудительное"
                            },
                            {
                                "target_lang_word": "плести заговор",
                                "target_lang_sense_clarification": "организовывать тайный план"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9756c45e-4791-394a-9920-ee5eee90a124",
                    "sense_definition": "To act or work together toward a particular result, often used for circumstances or inanimate forces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "working together",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain and strong winds <w>conspired</w> to ruin our outdoor wedding plans.",
                            "target_lang_translations": {
                                "ru": "Проливной дождь и сильный ветер словно <w>ополчились</w> против нас, чтобы разрушить планы свадьбы на открытом воздухе."
                            }
                        },
                        {
                            "text": "Everything seemed to <w>conspire</w> to make him late for the most important interview of his life.",
                            "target_lang_translations": {
                                "ru": "Казалось, всё <w>способствовало</w> тому, чтобы он опоздал на самое важное интервью в своей жизни."
                            }
                        }
                    ],
                    "common_phrases": [
                        "conspire to make",
                        "circumstances conspire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действовать или работать сообща для достижения определенного результата, часто используется применительно к обстоятельствам или неодушевленным силам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ополчаться",
                                "target_lang_sense_clarification": "об обстоятельствах, мешающих чему-либо"
                            },
                            {
                                "target_lang_word": "способствовать",
                                "target_lang_sense_clarification": "совместно приводить к результату"
                            },
                            {
                                "target_lang_word": "сговариваться",
                                "target_lang_sense_clarification": "метафорически об обстоятельствах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd590f3a-b051-37a2-be94-aa77180af00e",
                    "sense_definition": "To agree or concur toward a single end or purpose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "working together",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The different departments must <w>conspire</w> to achieve the company's ambitious goals for the new year.",
                            "target_lang_translations": {
                                "ru": "Различные отделы должны <w>объединить усилия</w>, чтобы достичь амбициозных целей компании в новом году."
                            }
                        },
                        {
                            "text": "All elements of the production <w>conspire</w> to create a truly breathtaking theatrical experience.",
                            "target_lang_translations": {
                                "ru": "Все элементы постановки <w>сливаются</w> воедино, чтобы создать поистине захватывающее театральное зрелище."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Согласовываться или объединяться ради единой цели или намерения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объединяться",
                                "target_lang_sense_clarification": "действовать согласованно"
                            },
                            {
                                "target_lang_word": "содействовать",
                                "target_lang_sense_clarification": "работать на общую цель"
                            },
                            {
                                "target_lang_word": "сливаться",
                                "target_lang_sense_clarification": "гармонично сочетаться для эффекта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}