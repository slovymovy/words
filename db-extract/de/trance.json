                                "target_senses": [
                                    {
                                        "sense_id": "d0cc5263-9813-3937-a225-a5e241815888",
                                        "entry_id": "a96ff9ef-71d6-33e5-ae74-425225febde5",
                                        "glosses": [
                                            "A dazed or unconscious condition."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
