                                "target_senses": [
                                    {
                                        "sense_id": "dfb69b7c-8d4e-3750-9feb-db4f7fe53422",
                                        "entry_id": "1c8f35dc-1c5a-3521-ae1a-5445753d9ba0",
                                        "glosses": [
                                            "Not noble; plebeian; common."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c0b19ca-c1e3-411c-8dc9-fa237b9ba305",
                                                "sense_id": "dfb69b7c-8d4e-3750-9feb-db4f7fe53422",
                                                "text": "I was not ignoble of descent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9c84946-4f0c-32fc-ae03-ceb04a3f4f69",
                                        "entry_id": "1c8f35dc-1c5a-3521-ae1a-5445753d9ba0",
                                        "glosses": [
                                            "Not honorable; base."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38e8b9a7-b462-4cde-9784-4592ec5c19f7",
                                                "sense_id": "d9c84946-4f0c-32fc-ae03-ceb04a3f4f69",
                                                "text": "A base, ignoble mind, / That mounts no higher than a bird can soar."
                                            },
                                            {
                                                "example_id": "7465f84b-69f4-4346-841a-117f69745cb1",
                                                "sense_id": "d9c84946-4f0c-32fc-ae03-ceb04a3f4f69",
                                                "text": "far from the madding crowd's ignoble strife"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73c321e6-3992-384d-97c0-c8c78935a9ed",
                                        "entry_id": "1c8f35dc-1c5a-3521-ae1a-5445753d9ba0",
                                        "glosses": [
                                            "Not a true or \\\"noble\\\" falcon; said of certain hawks, such as the goshawk."
