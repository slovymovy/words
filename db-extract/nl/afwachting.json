        "nl-extract.jsonl": [
            {
                "entry_id": "4f80ed0a-bcc6-37cc-9958-02bdbe420969",
                "word": "afwachting",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9234f6a1-8824-364c-bffa-7b90df7b7917",
                        "entry_id": "4f80ed0a-bcc6-37cc-9958-02bdbe420969",
                        "glosses": [
                            "in de veronderstelling zijnde dat bepaalde dingen gaan gebeuren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "493ec79c-5d8a-40a0-be28-4f55016d849c",
                                "sense_id": "9234f6a1-8824-364c-bffa-7b90df7b7917",
                                "text": "De kinderen waren in afwachting van Sinterklaas."
                            },
                            {
                                "example_id": "87d08b25-b581-4313-bb21-321b95ec82c2",
                                "sense_id": "9234f6a1-8824-364c-bffa-7b90df7b7917",
                                "text": "Hoewel de laatste dagen in afwachting van de wapenstilstand vrij rustig verliepen, kwam alles onverhoeds in een stroomversnelling."
                            },
                            {
                                "example_id": "aa87ddfc-6265-4bc4-88b5-c729e91dfac7",
                                "sense_id": "9234f6a1-8824-364c-bffa-7b90df7b7917",
                                "text": "Ik heb ze gevonden, señor Schloss, en ze zitten allemaal in het gevang, in afwachting van hun straf."
                            },
                            {
                                "example_id": "0e4eaa92-89d9-4297-b398-d7e551269640",
                                "sense_id": "9234f6a1-8824-364c-bffa-7b90df7b7917",
                                "text": "Want ik was niet naar Grand Hotel Europa gekomen om de tijd weemoedig te laten verglijden te midden van afgebladderde luxe en krakende glorie in passieve afwachting van een of ander inzicht, dat mij op een gegeven moment zou toevallen als een bloemblad uit een vergeeld boeket. Dat inzicht wilde ik afdwingen en daarom moest ik aan het werk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "708dcfd2-2974-42f6-93d5-47dc1dbba314",
                        "source_entry_id": "4f80ed0a-bcc6-37cc-9958-02bdbe420969",
                        "source_sense_id": "9234f6a1-8824-364c-bffa-7b90df7b7917",
                        "target_lang_word": "Erwartung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erwartung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7519fcec-a309-350d-a0d5-c3b631f07221",
                                        "entry_id": "5f72d0c6-896e-3fb9-97eb-6c854565a93a",
                                        "glosses": [
                                            "Zustand der Spannung, des Wartens, der Ungeduld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c02058e-a99c-4a37-bbf3-9ab0ec4921f2",
                                                "sense_id": "7519fcec-a309-350d-a0d5-c3b631f07221",
                                                "text": "Ich verbrachte den Abend voller Erwartung."
                                            },
                                            {
                                                "example_id": "334daae0-f400-4583-b8f2-291c57e38467",
                                                "sense_id": "7519fcec-a309-350d-a0d5-c3b631f07221",
                                                "text": "„In Erwartung des Kaisers standen die Gäste an der Eingangstür zusammengedrängt im Saal.“"
                                            },
                                            {
                                                "example_id": "8c9e9eb4-c450-4ecc-ae51-8d49b85a651e",
                                                "sense_id": "7519fcec-a309-350d-a0d5-c3b631f07221",
                                                "text": "„Das Ehepaar wurde verhaftet, der Mann geköpft, die Frau in Erwartung ihrer Hinrichtung bei einem Bombenangriff im Gefängnis getötet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ddd59ed3-01f4-33f8-8a85-fb958d300157",
                                        "entry_id": "5f72d0c6-896e-3fb9-97eb-6c854565a93a",
                                        "glosses": [
                                            "Vorstellung von dem, was geschehen wird; etwas, was erwartet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "064c4c26-21cd-4773-a4dc-d5e58eb69a32",
                                                "sense_id": "ddd59ed3-01f4-33f8-8a85-fb958d300157",
                                                "text": "Die Erwartungen an sein Können wurden nicht erfüllt."
                                            },
                                            {
                                                "example_id": "60df03fa-1b61-4184-9124-e0dce7e7ef4a",
                                                "sense_id": "ddd59ed3-01f4-33f8-8a85-fb958d300157",
                                                "text": "„Beide Bergnamen sind auch in der Neuzeit als Symbolbegriffe hochgesteckter Ziele und Erwartungen geläufig geblieben.“"
                                            },
                                            {
                                                "example_id": "15bfdfb0-8482-4b25-92c4-8c74da720dfb",
                                                "sense_id": "ddd59ed3-01f4-33f8-8a85-fb958d300157",
                                                "text": "„Hainstock hatte ihm seine Erwartung bestätigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0f24f2a-c555-4ab8-81c2-e04660553a56",
                        "source_entry_id": "4f80ed0a-bcc6-37cc-9958-02bdbe420969",
                        "source_sense_id": "9234f6a1-8824-364c-bffa-7b90df7b7917",
                        "target_lang_word": "expectation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expectation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b07d05c-22e6-342a-a32f-8328005f6095",
                                        "entry_id": "90cd9e02-a26f-3bdc-b464-8de549dc154c",
                                        "glosses": [
                                            "The act or state of expecting or looking forward to an event as about to happen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77caaa6d-80b2-4b58-8b31-2d0ed9d029e7",
                                                "sense_id": "0b07d05c-22e6-342a-a32f-8328005f6095",
                                                "text": "“A tight little craft,” was Austin’s invariable comment on the matron;[…]. ¶ Near her wandered her husband, orientally bland, invariably affable, and from time to time squinting sideways, as usual, in the ever-renewed expectation that he might catch a glimpse of his stiff, retroussé moustache."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eed155a-e01f-34ba-b60a-61111db4a6d2",
                                        "entry_id": "90cd9e02-a26f-3bdc-b464-8de549dc154c",
                                        "glosses": [
                                            "That which is expected or looked for."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0746614-c137-4d97-9383-bf9f5646bbdd",
                                                "sense_id": "4eed155a-e01f-34ba-b60a-61111db4a6d2",
                                                "text": "And so it had always pleased M. Stutz to expect great things from the dark young man whom he had first seen in his early twenties ; and his expectations had waxed rather than waned on hearing the faint bruit of the love of Ivor and Virginia—for Virginia, M. Stutz thought, would bring fineness to a point in a man like Ivor Marlay,[…]."
                                            },
                                            {
                                                "example_id": "4761f60f-7f40-43b4-baf8-3b765bfe1ab0",
                                                "sense_id": "4eed155a-e01f-34ba-b60a-61111db4a6d2",
                                                "text": "Thus the B.R. diesel fleet today is composed of a rather assorted collection of designs. Some have proved to be remarkably satisfactory in service; others have so far not come up to expectations and I suppose it is doubtful whether any more orders for some types will be forthcoming."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e991af7c-4d2d-3ab6-a692-08e3340a8063",
                                        "entry_id": "90cd9e02-a26f-3bdc-b464-8de549dc154c",
                                        "glosses": [
                                            "That which is expected or looked for.",
                                            "An implicit obligation or duty held by another in someone's view."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f108f80d-5787-420d-b4a2-00fafeb12339",
                                                "sense_id": "e991af7c-4d2d-3ab6-a692-08e3340a8063",
                                                "text": "He struggled with his parents' expectations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "964e5f31-3f3b-36cb-bf05-8f10bf6b50a4",
                                        "entry_id": "90cd9e02-a26f-3bdc-b464-8de549dc154c",
                                        "glosses": [
                                            "The prospect of the future; grounds upon which something excellent is expected to occur; prospect of anything good to come, especially of property or rank."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d99c0184-4721-4fd5-917c-51e64f314ec8",
                                                "sense_id": "964e5f31-3f3b-36cb-bf05-8f10bf6b50a4",
                                                "text": "Emma was not sorry to be pressed. She read, and was surprized. The style of the letter was much above her expectation. There were not merely no grammatical errors, but as a composition it would not have disgraced a gentleman; the language, though plain, was strong and unaffected, and the sentiments it conveyed very much to the credit of the writer. It was short, but expressed good sense, warm attachment, liberality, propriety, even delicacy of feeling. She paused over it, while Harriet stood anxiously watching for her opinion, with a \"Well, well,\" and was at last forced to add, \"Is it a good letter? or is it too short?\""
                                            },
                                            {
                                                "example_id": "d881f01f-51b3-4c65-aec1-cb7708937dd9",
                                                "sense_id": "964e5f31-3f3b-36cb-bf05-8f10bf6b50a4",
                                                "text": "Charles Penrhyn, for he was the object of Louisa's preference, had expectations—that term, so vague when those expectations depend upon others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "608d8b2d-9b71-3b8b-94f7-2ad861d5c174",
                                        "entry_id": "90cd9e02-a26f-3bdc-b464-8de549dc154c",
                                        "glosses": [
                                            "The value of any chance (as the prospect of prize or property) which depends upon some contingent event."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88c7956a-fbb5-3b54-95a1-2fad2b4f8a33",
                                        "entry_id": "90cd9e02-a26f-3bdc-b464-8de549dc154c",
                                        "glosses": [
                                            "The first moment; the expected value; the long-run average value of a variable over many independent repetitions of an experiment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f8a91f6-8026-30f1-ba0f-0b5ab1e41f1b",
                                        "entry_id": "90cd9e02-a26f-3bdc-b464-8de549dc154c",
                                        "glosses": [
                                            "The arithmetic mean."
                                        ],
