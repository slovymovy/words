                "senses": [
                    {
                        "sense_id": "88a29784-8bb4-3510-837c-359d0a6558c0",
                        "entry_id": "268e37f2-0f02-3c53-878e-24450d89d68c",
                        "glosses": [
                            "Oberfläche des oder eines Mondes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcbea8ed-7fbb-4006-8afa-15dcc4392695",
                                "sense_id": "88a29784-8bb4-3510-837c-359d0a6558c0",
                                "text": "1969 wurde zum ersten Male die Mondoberfläche betreten."
                            },
                            {
                                "example_id": "1cc0ef62-ae5c-465a-badf-2f37bf1bc31e",
                                "sense_id": "88a29784-8bb4-3510-837c-359d0a6558c0",
                                "text": "„Im Gegensatz zur pockennarbigen Mondoberfläche erscheint die Erde als eine vollkommene Kugel – die messbare Abplattung an den Polen beeinträchtigt ihren optischen Eindruck nicht.“"
                            },
                            {
                                "example_id": "b0283e08-ffdb-4e2f-a249-291aea781bde",
                                "sense_id": "88a29784-8bb4-3510-837c-359d0a6558c0",
                                "text": "„Die Mondlandefähre, ein 15 Meter hohes spinnenartiges Ungetüm mit nur millimeterdicker Aluminiumhaut, sollte zwei Astronauten sicher vom Mondorbit zur Mondoberfläche und zurück bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
