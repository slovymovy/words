                                "sense_id": "cb071515-10ee-36d2-b392-3607e8b2c799",
                                "text": "De beroemde ontdekkingsreiziger Marco Polo reisde naar Azië.",
                                "translation": "The famous explorer Marco Polo traveled to Asia.",
                                "english": "The famous explorer Marco Polo traveled to Asia."
                            },
                            {
                                "example_id": "c0c2b6ce-61d6-4764-b245-d956379e41f3",
                                "sense_id": "cb071515-10ee-36d2-b392-3607e8b2c799",
                                "text": "In de 15e eeuw waren er veel Portugese ontdekkingsreizigers die de wereld verkenden.",
                                "translation": "In the 15th century, there were many Portuguese explorers who explored the world.",
                                "english": "In the 15th century, there were many Portuguese explorers who explored the world."
                            },
                            {
                                "example_id": "f7beeab1-0b13-4f8c-a3f3-140624c370c7",
                                "sense_id": "cb071515-10ee-36d2-b392-3607e8b2c799",
                                "text": "De Nederlandse ontdekkingsreiziger Willem Barentsz zocht een noordoostelijke doorgang naar Azië.",
                                "translation": "The Dutch explorer Willem Barentsz sought a northeastern passage to Asia.",
                                "english": "The Dutch explorer Willem Barentsz sought a northeastern passage to Asia."
