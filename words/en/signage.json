                    "frequency": "Low",
                    "semantic_group_id": "visual_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We arrived at a place which has a <w>signage</w> with archaic lettering above the door.",
                            "target_lang_translations": {
                                "ru": "Мы прибыли в место, где над дверью висела <w>вывеска</w> с архаичными буквами."
                            }
                        },
                        {
                            "text": "The shop owner installed a new storefront <w>signage</w> to attract more customers from the street.",
                            "target_lang_translations": {
                                "ru": "Владелец магазина установил новую фасадную <w>вывеску</w>, чтобы привлечь больше покупателей с улицы."
                            }
                        }
                    ],
