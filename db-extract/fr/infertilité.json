                                "target_senses": [
                                    {
                                        "sense_id": "97f08c2d-36f8-38c9-bb1f-e1446ce21eef",
                                        "entry_id": "f683f1b3-5e8e-3af5-85a3-7f50cd0c290a",
                                        "glosses": [
                                            "The condition of being infertile; of having poor fertility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "058f18e8-a4cc-4b2e-bdb4-73423fee1b1b",
                                                "sense_id": "97f08c2d-36f8-38c9-bb1f-e1446ce21eef",
                                                "text": "Soil infertility is a major problem for farmers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f92262e-664e-313a-b98a-d12af127414f",
                                        "entry_id": "f683f1b3-5e8e-3af5-85a3-7f50cd0c290a",
                                        "glosses": [
                                            "The inability to conceive children."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19cec0c7-b74f-4d3f-bfa2-8e4123b5ab8b",
                                                "sense_id": "7f92262e-664e-313a-b98a-d12af127414f",
                                                "text": "Infertility is a considerable obstacle for women wishing to make a family."
                                            }
                                        ]
                                    }
                                ]
                            }
