        "fr-extract.jsonl": [
            {
                "entry_id": "51dadafd-1d84-30f0-8f0a-796f056b3a62",
                "word": "campanile",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7863e22b-ada7-4e8f-a18f-079da8286a23",
                        "entry_id": "51dadafd-1d84-30f0-8f0a-796f056b3a62",
                        "tags": [
                            "plural"
                        ],
                        "form": "campaniles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc3ff776-3bbe-3ae0-b8a4-649c6162eb4f",
                        "entry_id": "51dadafd-1d84-30f0-8f0a-796f056b3a62",
                        "glosses": [
                            "Clocher à jour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0388bec7-9468-4ce6-8aff-0b911991cf1a",
                                "sense_id": "dc3ff776-3bbe-3ae0-b8a4-649c6162eb4f",
                                "text": "Il découvrirait un campanile de tuiles rongées par la mousse, douze maisonnettes éparses, entourées de leurs vergers et de leurs chenevières."
                            },
                            {
                                "example_id": "b55d5fa0-182c-41f4-8ab6-cfe26bf18cbf",
                                "sense_id": "dc3ff776-3bbe-3ae0-b8a4-649c6162eb4f",
                                "text": "Les campaniles de sa vieille cathédrale s’élancent dans les airs, où ils se confondaient alors avec les créations fantastiques de quelques nuages blanchâtres."
                            }
                        ]
                    },
                    {
                        "sense_id": "81d4263c-36d7-34da-8882-12646da74bcd",
                        "entry_id": "51dadafd-1d84-30f0-8f0a-796f056b3a62",
                        "glosses": [
                            "Tour ouverte, haute et généralement isolée, dans laquelle sont suspendues des cloches."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6ffdda44-6eb3-4f6d-84e7-05f0b0de6700",
                                "sense_id": "81d4263c-36d7-34da-8882-12646da74bcd",
                                "text": "Le campanile de la cathédrale Notre-Dame de l’Assomption de Pise, plus connu sous le nom de Tour penchée de Pise, a cessé de s’affaisser doucement, et s’est même redressé d’un soupçon."
                            },
                            {
                                "example_id": "96a03097-3608-4082-a99f-15ef6d5356e0",
                                "sense_id": "81d4263c-36d7-34da-8882-12646da74bcd",
                                "text": "Le coup d’envoi est donné par le « vol de l’ange », quand une jeune fille accrochée à un filin s’élance du campanile de la place Saint-Marc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a33ea6d8-a6ca-48b8-b7cf-0779d1a1b409",
                        "source_entry_id": "51dadafd-1d84-30f0-8f0a-796f056b3a62",
                        "target_lang_word": "campanil",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "campanil",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "ceb483a7-8c36-3c27-bff3-2ff8dfcb53de",
                                        "entry_id": "4b59577e-7f1a-347d-97d7-7f999f38930a",
