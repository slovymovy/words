        "ru-extract.jsonl": [
            {
                "entry_id": "535e084b-16c8-3fb6-a4b8-918d2b4d3248",
                "word": "врозь",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "71b5647b-0f82-356a-aa5d-2b5aebd3ff99",
                        "entry_id": "535e084b-16c8-3fb6-a4b8-918d2b4d3248",
                        "glosses": [
                            "не вместе; отдельно, порознь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2e16d88-17cd-4d41-8285-77cb485ff853",
                                "sense_id": "71b5647b-0f82-356a-aa5d-2b5aebd3ff99",
                                "text": "И лишь бы врозь, и льну. // Мне скажут: да ты что? // Вот так, однако, — // и это пытка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0213e170-423b-4050-94fa-a4a83d2f916a",
                        "source_entry_id": "535e084b-16c8-3fb6-a4b8-918d2b4d3248",
                        "source_sense_id": "71b5647b-0f82-356a-aa5d-2b5aebd3ff99",
                        "target_lang_word": "separately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "separately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "623ab334-ec3d-3360-98a5-0b5405d8a525",
                                        "entry_id": "6d79f43d-7663-39c6-b170-6b669790abc9",
                                        "glosses": [
                                            "In a separate manner; not together; apart."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d646aec0-0b63-405d-bd71-4a846f2292fe",
                                                "sense_id": "623ab334-ec3d-3360-98a5-0b5405d8a525",
                                                "text": "We've been living separately for three years."
                                            },
                                            {
                                                "example_id": "38aa640a-d3e7-4fc9-9857-800499f91652",
                                                "sense_id": "623ab334-ec3d-3360-98a5-0b5405d8a525",
                                                "text": "Tackle the different parts of the climb separately before attempting the whole thing in one go."
                                            },
                                            {
                                                "example_id": "904ab24f-6900-44ca-8bf8-57a35c569e68",
                                                "sense_id": "623ab334-ec3d-3360-98a5-0b5405d8a525",
                                                "text": "Syntactically, hendiadic constructions differ from synthetonic sequences in that the latter are separate clauses, and hence are separately negatable and may have different tenses and aspects and different subjects."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a95166a1-8d8d-423e-b8fa-4742760e0545",
                        "source_entry_id": "535e084b-16c8-3fb6-a4b8-918d2b4d3248",
                        "source_sense_id": "71b5647b-0f82-356a-aa5d-2b5aebd3ff99",
                        "target_lang_word": "apart",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac66ecc3-972a-3378-bf9f-cf9b0808bacd",
                                        "entry_id": "e5ad034e-6540-389e-859e-317453ba4ad5",
                                        "glosses": [
                                            "Placed separately (in regard to space or time)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd9f25f7-d05e-4a3f-a4a5-87fb17b9e837",
                                                "sense_id": "ac66ecc3-972a-3378-bf9f-cf9b0808bacd",
                                                "text": "We had a large bus and I had two of them at the front and two at the back, and I had to sit in the middle and keep them apart."
                                            },
                                            {
                                                "example_id": "0c0f1261-8dac-4ca8-b0dc-33b7fff430ee",
                                                "sense_id": "ac66ecc3-972a-3378-bf9f-cf9b0808bacd",
                                                "text": "Others apart sat on a hill retired."
                                            },
                                            {
                                                "example_id": "bfaf5b8b-b46e-465d-b727-d180cf3723d2",
                                                "sense_id": "ac66ecc3-972a-3378-bf9f-cf9b0808bacd",
                                                "text": "But know that the Lord hath set apart him that is godly for himself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f17437a4-e5ca-3fcb-9b0e-cd78ea7377cf",
                                        "entry_id": "e5ad034e-6540-389e-859e-317453ba4ad5",
                                        "glosses": [
                                            "Separately, exclusively, not together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef00808e-8386-4852-ba5a-dc7d9269743e",
                                                "sense_id": "f17437a4-e5ca-3fcb-9b0e-cd78ea7377cf",
                                                "text": "Consider the two propositions apart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b32fe38d-3f2a-3381-8c9f-5383394dd55f",
                                        "entry_id": "e5ad034e-6540-389e-859e-317453ba4ad5",
                                        "glosses": [
                                            "In or into two or more parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b43f65bc-4747-473e-b7c3-2bcbda025fd2",
                                                "sense_id": "b32fe38d-3f2a-3381-8c9f-5383394dd55f",
                                                "text": "We took the computer apart and put it back together."
                                            },
                                            {
                                                "example_id": "7c0f7c90-951b-4537-9cfc-1147e059bc88",
                                                "sense_id": "b32fe38d-3f2a-3381-8c9f-5383394dd55f",
                                                "text": "Love, love will tear us apart, again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65c915ed-b0dc-36ff-befe-42dcc666029b",
                                        "entry_id": "e5ad034e-6540-389e-859e-317453ba4ad5",
                                        "glosses": [
                                            "To the side; aside."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fb48e25-c567-4871-bdff-704f193ee08b",
                                                "sense_id": "65c915ed-b0dc-36ff-befe-42dcc666029b",
                                                "text": "Wherefore lay apart all filthiness and superfluity of naughtiness, and receive with meekness the engrafted word, which is able to save your souls."
                                            },
                                            {
                                                "example_id": "726b1d8d-344b-46a1-adc5-7176932b3bf6",
                                                "sense_id": "65c915ed-b0dc-36ff-befe-42dcc666029b",
                                                "text": "Let Pleasure go, put Care apart."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5101279-c3a8-3798-b3fd-01666d23308c",
                                        "entry_id": "6da584e2-a741-3bd9-b30d-9d404f8193b1",
                                        "glosses": [
                                            "Excluded from consideration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cd05644-9601-4d76-8792-f2ffce592c7c",
                                                "sense_id": "f5101279-c3a8-3798-b3fd-01666d23308c",
                                                "text": "Joking apart, what do you think?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6355cbb9-c235-34a7-93b0-3cd3173db4e9",
                                        "entry_id": "c7c2c296-fba7-3a98-9940-18a91704313a",
                                        "glosses": [
                                            "Exceptional, distinct."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f7bc263-da59-4761-935e-02fc8875457b",
                                                "sense_id": "6355cbb9-c235-34a7-93b0-3cd3173db4e9",
                                                "text": "in a class apart"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6baefc49-85f1-38fb-94e0-575cd2e9a9bc",
                                        "entry_id": "c7c2c296-fba7-3a98-9940-18a91704313a",
                                        "glosses": [
                                            "Having been taken apart; disassembled, in pieces."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa9b0231-2dde-397f-b9ae-0c9e63023483",
                                        "entry_id": "c7c2c296-fba7-3a98-9940-18a91704313a",
                                        "glosses": [
                                            "Separate, on the side."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0486102c-37fc-47a1-9290-8968e283ab0f",
                                                "sense_id": "fa9b0231-2dde-397f-b9ae-0c9e63023483",
                                                "text": "The young lover was in waiting, to hand them out of the large substantial carriage, and the first quiet moment that he could find for an apart whisper, said, \"What can be the reason that your mother has never taken the slightest notice of my letter?\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb0a2a29-5329-3d5f-8978-35fc28d0f59c",
                                        "entry_id": "3b5d344a-90ae-3e77-b532-755e772dd8e1",
                                        "glosses": [
                                            "Misspelling of a part."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "misspelling"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "215e0e28-091a-4234-86ab-b2a26df304c2",
                                                "sense_id": "cb0a2a29-5329-3d5f-8978-35fc28d0f59c",
                                                "text": "I killed a man. This was never apart^([sic – meaning a part]) of the plan, Tracy was supposed to do all of the dirty work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
