                        "examples": [
                            {
                                "example_id": "4c60fed2-7615-47d1-aefe-082317f05bae",
                                "sense_id": "a4e32604-52ea-3074-8d88-13ca4b33234b",
                                "text": "Men twijfelde echter sterk of het de vijand was of niet, geen paardenvolk erbij zijnde."
                            },
                            {
                                "example_id": "3bf97174-29ab-4638-bd09-1242243ab567",
                                "sense_id": "a4e32604-52ea-3074-8d88-13ca4b33234b",
                                "text": "Het was voor de luitenant Tavelinck geen moeilijke taak om met een vendel paardenvolk een paar honderd van die arme drommels klein te krijgen, bij het naderen van hoefgetrappel en het blikkeren van getrokken sabels gooiden de meesten hun moordtuig weg en renden voor hun leven."
                            }
                        ]
