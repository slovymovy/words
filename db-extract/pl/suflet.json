                "senses": [
                    {
                        "sense_id": "562433ef-3220-315a-9bdf-ecf7c4907018",
                        "entry_id": "d388b946-2039-33d8-83ea-166ce66035ee",
                        "glosses": [
                            "lekka pieczona potrawa przyrządzana na bazie żółtek utartych z cukrem lub masłem oraz piany ubitej z białek, podawana na gorąco"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6b1164d-53d7-4887-befd-17b848b454f3",
                                "sense_id": "562433ef-3220-315a-9bdf-ecf7c4907018",
                                "text": "Po wyjęciu z piekarnika suflet szybko opada, należy go więc zapiekać tuż przed podaniem"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76d81927-7418-4790-9958-edf25e5bbe66",
                        "source_entry_id": "d388b946-2039-33d8-83ea-166ce66035ee",
                        "source_sense_id": "562433ef-3220-315a-9bdf-ecf7c4907018",
                        "target_lang_word": "soufflé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soufflé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eae7555d-5c44-3a14-a313-964a352aa8bd",
                                        "entry_id": "6e6cf843-2060-3e9b-826e-fe514c79fd3b",
                                        "glosses": [
                                            "Qui est exagéré, surestimé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a735228-b267-40f5-bfc0-4169408d63b1",
                                                "sense_id": "eae7555d-5c44-3a14-a313-964a352aa8bd",
                                                "text": "Un discours soufflé : Un discours emphatique."
                                            },
                                            {
                                                "example_id": "810abf75-5351-44cb-80f2-c2150b73137b",
                                                "sense_id": "eae7555d-5c44-3a14-a313-964a352aa8bd",
                                                "text": "Une réputation soufflée : Une réputation exagérée."
                                            },
                                            {
                                                "example_id": "ff41a439-e591-4c37-838f-704179e5cbd7",
                                                "sense_id": "eae7555d-5c44-3a14-a313-964a352aa8bd",
                                                "text": "Un succès soufflé : Un succès grossi artificiellement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80f68db9-eab0-3df9-aadf-c911fde445cf",
                                        "entry_id": "6e6cf843-2060-3e9b-826e-fe514c79fd3b",
                                        "glosses": [
                                            "Surpris, étonné."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5cbd0c7-59b1-44b2-bc5b-c5c9b1e83f26",
                                                "sense_id": "80f68db9-eab0-3df9-aadf-c911fde445cf",
                                                "text": "— Et vous, vous n’êtes pas gai, sans doute ? dit le capitaine-major, soufflé par tant de franchise et de candeur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "soufflé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d39f1e3e-d2c1-3e42-8081-eaae24165db1",
                                        "entry_id": "e5fa90c3-995b-387f-b8ef-1c31b2363f18",
                                        "glosses": [
                                            "S’emploie pour désigner une crème, une purée, etc., qui se gonfle à la cuisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9363209-4e24-4dcf-a2f0-59e264a49826",
                                                "sense_id": "d39f1e3e-d2c1-3e42-8081-eaae24165db1",
                                                "text": "Justement il y avait du soufflé au fromage qui se mange en sortant du four. Madeleine avait dû s’en souvenir, – campagnarde élevée dans le culte du repas domestique et dans le respect de la nourriture, car avant que Jean-Louis eût déplié sa serviette, elle était déjà là."
                                            },
                                            {
                                                "example_id": "64398d9c-5adb-4ee2-9a54-a68a6d93f6ed",
                                                "sense_id": "d39f1e3e-d2c1-3e42-8081-eaae24165db1",
                                                "text": "Tu avais raison, ton soufflé le regonfle…"
                                            },
                                            {
                                                "example_id": "db7f586d-c13d-40d1-a1eb-ac193bd70058",
                                                "sense_id": "d39f1e3e-d2c1-3e42-8081-eaae24165db1",
                                                "text": "Un soufflé de pommes de terre."
                                            },
                                            {
                                                "example_id": "6f23015c-69d9-49d2-b948-5044010fdc0b",
                                                "sense_id": "d39f1e3e-d2c1-3e42-8081-eaae24165db1",
                                                "text": "Un soufflé au fromage, au chocolat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f700a28d-409b-3eb0-b4a9-92f14929dce4",
                                        "entry_id": "e5fa90c3-995b-387f-b8ef-1c31b2363f18",
                                        "glosses": [
                                            "Bulle spéculative."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "628c4205-b2fd-48f4-8d69-63e85a3a8b77",
                                                "sense_id": "f700a28d-409b-3eb0-b4a9-92f14929dce4",
                                                "text": "Pour essayer de sortir de ce panurgisme intellectuel, il nous a semblé utile de nous pencher sur le passé pour y observer quelques soufflés technologiques ayant gonflé rapidement et s’étant affaissés plus vite encore."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "soufflé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7d54880-8384-3bcd-bb8e-c261a3277078",
                                        "entry_id": "0101bf0d-9434-32bb-a278-6701c5923657",
                                        "glosses": [
                                            "Participe passé masculin singulier de souffler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45e1d1a6-5305-4e79-b441-a1d0269a3431",
                                                "sense_id": "e7d54880-8384-3bcd-bb8e-c261a3277078",
                                                "text": "Le 19 de ce mois, un vent du sud ayant soufflé, nous arrivâmes à Maassah de Zélach, où le peu d’eau fit engraver nos barques à l’exception de deux ; à force de bras nous parvînmes à les désengraver."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "804a0305-b40c-4585-a91c-a26dec41acc9",
                        "source_entry_id": "d388b946-2039-33d8-83ea-166ce66035ee",
                        "source_sense_id": "562433ef-3220-315a-9bdf-ecf7c4907018",
                        "target_lang_word": "Soufflé",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Soufflé",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92581ae4-3c21-3654-b282-cc3633e8db36",
                                        "entry_id": "cb13054f-e35e-3a9c-9e90-bd42c1669657",
                                        "glosses": [
                                            "eine Art luftiger, lockerer Auflauf mit steif geschlagenem Eiweiß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9909c51-c73a-4195-9ae8-b429814731d4",
                                                "sense_id": "92581ae4-3c21-3654-b282-cc3633e8db36",
                                                "text": "Soufflés gibt es in süßen wie in pikanten Varianten."
                                            },
                                            {
                                                "example_id": "863e3285-2bb8-4beb-9063-651751d72bc5",
                                                "sense_id": "92581ae4-3c21-3654-b282-cc3633e8db36",
                                                "text": "Ein kalter Luftzug lässt ein Soufflé schnell zusammenfallen, deshalb darf man die Backofentür nicht zu früh öffnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
