                        "glosses": [
                            "Kraftfahrzeug mit breitgliedrigen, über Antriebs- und Leiträder oder über Tragrollen laufenden Gleisketten als Fahrwerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07209161-fec5-40a8-a1bc-96fa1ae1d00f",
                                "sense_id": "31a16ff1-4087-325c-aeb8-55ef1790df6a",
                                "text": "„Alte Kräne, Bagger und sogar Flugzeuge und Schiffe rosten vor sich hin. Hier braucht kein Traktor, kein Raupenschlepper Angst zu haben, im Schmelzofen zu landen. Denn Heinz und Fred hauchen von morgens früh bis abends spät dem Ausgebrauchten neues Leben ein.“"
                            }
                        ],
