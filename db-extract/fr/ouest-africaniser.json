                "senses": [
                    {
                        "sense_id": "ac8d8f63-9136-38fb-b2aa-2a04ed97fa15",
                        "entry_id": "92ab9969-a44a-3037-8452-32faacccd1a7",
                        "glosses": [
                            "Donner un caractère ouest-africain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ddb4b2a-34d3-41c7-ad82-8a079e95cf21",
                                "sense_id": "ac8d8f63-9136-38fb-b2aa-2a04ed97fa15",
                                "text": "Je ne pense pas qu'ils faille sortir du CFA mais ouest-africaniser le CFA et le rendre indépendant de l'euro."
                            },
                            {
                                "example_id": "7046cc37-8417-4478-a845-b6561e15bdbd",
                                "sense_id": "ac8d8f63-9136-38fb-b2aa-2a04ed97fa15",
                                "text": "La solution est de ouest-africaniser l'Afrique Centrale."
                            },
                            {
                                "example_id": "2288812a-c7a3-414d-8ac2-9e2b1a2d76df",
                                "sense_id": "ac8d8f63-9136-38fb-b2aa-2a04ed97fa15",
                                "text": "Puis, le 17 septembre 1977, à Liverpool, le Conseil de NOS, voulant étendre l’influence de la société, invita des ornithologistes francophones (dont Claude Chappuis) à en discuter et finalement décida d’ «ouest-africaniser » la société en couvrant tout l’Ouest africain."
                            }
                        ]
                    }
