                "senses": [
                    {
                        "sense_id": "f3ff084d-b15c-338d-bb39-87a41d67502a",
                        "entry_id": "070fe3d6-5547-3f36-8d46-42d0f6b557be",
                        "glosses": [
                            "Faire perdre son caractère confédéral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "294b2b5a-3114-4553-bf5b-ee2663ace78f",
                                "sense_id": "f3ff084d-b15c-338d-bb39-87a41d67502a",
                                "text": "Il arrive même que certains syndicats se voient déconfédéraliser et l'on a même pu constater la collusion entre la Confédération et le Patronat pour certains syndicats !"
                            },
                            {
                                "example_id": "0b79fe01-5e1e-422c-9fec-fcecb055cac3",
                                "sense_id": "f3ff084d-b15c-338d-bb39-87a41d67502a",
                                "text": "on pourrait commencer par \"déconfédéraliser\" les conséquences d'un Brexit dur."
                            },
                            {
                                "example_id": "1ca21ece-dd9f-403e-a02d-8db784f9e82f",
                                "sense_id": "f3ff084d-b15c-338d-bb39-87a41d67502a",
                                "text": "On pourra toujours objecter, et en partie avec raison, que ces structures ont été édifiées par certains leaders des coordinations, et non par l’ensemble de leurs participants, tous déjà syndicalistes de longue date, ou par certaines équipes syndicales qui ont fait le choix, poussé en cela par leur organisation mère, de se déconfédéraliser."
                            }
                        ]
                    }
