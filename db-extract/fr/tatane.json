                    {
                        "sense_id": "1a18cc51-4cf9-3a0c-8209-0726cd2ee04a",
                        "entry_id": "bc105b84-6460-3c90-80f2-7f6123bac0df",
                        "glosses": [
                            "Douzième mois de l’année du calendrier pataphysique, qui compte vingt-huit jours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43dd24a9-21c2-4b8b-832f-77367b3e2cc3",
                                "sense_id": "1a18cc51-4cf9-3a0c-8209-0726cd2ee04a",
                                "text": "Henri Thomas se sert d’une toile de fond : le 8 août 1954 (ou, suivant le calendrier pataphysique, le 26 Tatane 81) — on note qu’H.T. bouscule la chronologie en romancier de plein droit — eurent lieu à Honfleur les Festivités allaisiennes sous l’impulsion du Satrape Henri Jeanson, citoyen de la ville, dans le but de commémorer le centenaire d’Alphonse Allais, natif d’Honfleur."
                            }
                        ]
                    }
