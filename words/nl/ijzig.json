            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "31f0b549-4c91-37c8-a551-14c038cabccd",
                    "sense_definition": "Met een zeer lage temperatuur, ijskoud of met ijs bedekt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temperatuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wandelaars moesten vechten tegen een <w>ijzige</w> wind op de bergtop.",
                            "target_lang_translations": {
                                "en": "The hikers had to fight against an <w>icy</w> wind on the mountain peak."
                            }
                        },
                        {
                            "text": "Hij gleed uit over een <w>ijzig</w> stuk sneeuw op de stoep.",
                            "target_lang_translations": {
                                "en": "He slipped on an <w>icy</w> patch of snow on the sidewalk."
                            }
                        }
                    ],
                    "synonyms": [
                        "ijskoud",
                        "steenkoud",
                        "guur"
                    ],
                    "antonyms": [
                        "bloedheet",
                        "warm"
                    ],
                    "common_phrases": [
                        "ijzige wind",
                        "ijzig koud"
                    ],
                    "target_lang_definitions": {
                        "en": "With a very low temperature, freezing cold, or covered with ice"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "icy",
                                "target_lang_sense_clarification": "extremely cold or covered with ice"
                            },
                            {
                                "target_lang_word": "freezing",
                                "target_lang_sense_clarification": "very cold"
                            },
                            {
                                "target_lang_word": "glacial",
                                "target_lang_sense_clarification": "extremely cold, like ice"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f165b60d-b688-32ef-993b-7898ce987950",
                    "sense_definition": "Zeer kil, onvriendelijk en zonder enige warmte of gevoel",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sfeer in de vergaderzaal werd plotseling gekenmerkt door een <w>ijzige</w> stilte.",
                            "target_lang_translations": {
                                "en": "The atmosphere in the meeting room was suddenly characterized by an <w>icy</w> silence."
                            }
                        },
                        {
                            "text": "De <w>ijzige</w> hoofdzuster kon niet lachen om de grappen van de jonge dokter.",
                            "target_lang_translations": {
                                "en": "The <w>frosty</w> head nurse could not laugh at the young doctor's jokes."
                            }
                        }
                    ],
                    "synonyms": [
                        "kil",
                        "onvriendelijk",
                        "harteloos",
                        "ijskoud"
                    ],
                    "antonyms": [
                        "hartelijk",
                        "warm",
                        "vriendelijk"
                    ],
                    "common_phrases": [
                        "ijzige stilte",
                        "ijzige blik"
                    ],
                    "target_lang_definitions": {
                        "en": "Very cold, unfriendly, and without any warmth or feeling"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "icy",
                                "target_lang_sense_clarification": "unfriendly and cold in manner"
                            },
                            {
                                "target_lang_word": "frigid",
                                "target_lang_sense_clarification": "lacking warmth or emotional response"
                            },
                            {
                                "target_lang_word": "frosty",
                                "target_lang_sense_clarification": "unfriendly or cold in behavior"
                            }
                        ]
                    }
                }
            ]
        }
