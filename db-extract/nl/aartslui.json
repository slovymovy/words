                            {
                                "example_id": "e1a8e18c-ef99-4045-b36c-bc23e74227be",
                                "sense_id": "93918e72-31d7-3d43-b656-e9b15f8a38ac",
                                "text": "Topshow is een heerlijk, vlot geschreven boek over televisie maken en ego-management. Onthullend is het vooral in details, voor wie het programma een beetje kent. Zo blijken de drie hoofdrolspelers – Genee, Van der Gijp en Derksen – financieel binnen te lopen met het programma. De aartsluie Van der Gijp verdient vier ton per jaar met de show. Hij heeft vijf auto’s; één daarvan gebruikt hij om zijn hond te vervoeren, zodat hij niet al zijn auto’s hoeft te stofzuigen."
                            },
                            {
                                "example_id": "3bdcbd1f-5193-4708-9e01-f56abe851df0",
                                "sense_id": "93918e72-31d7-3d43-b656-e9b15f8a38ac",
                                "text": "Met een beetje geluk kwamen deze aartsluie wezens over een dag of drie."
                            }
                        ]
                    }
