                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd7c6cdc-5cf1-4ed9-bedc-c74b1e94d832",
                                "sense_id": "e447ac09-9860-32b6-9cb3-2c8e1d0a6368",
                                "text": "Priegelige trappen, fijnbesneden hekwerken en sierlijke kruisconstructies. In één oogopslag is in de woonkamer van Quist in Kaatsheuvel te zien dat er talloze uren noeste knutselarbeid staan uitgestald."
                            }
                        ]
                    },
                    {
                        "sense_id": "accd7521-8315-3821-b0c9-4598d32a105c",
                        "entry_id": "0af7fddb-161c-305c-9480-555cd4d068f2",
                        "glosses": [
                            "hele mooie, fijne, tere gelaatstrekken hebbend"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "887dd99d-0cc5-47d7-b4a6-d0bc3f40ecbd",
                                "sense_id": "accd7521-8315-3821-b0c9-4598d32a105c",
                                "text": "Pierre keek nog eens naar het bleke, fijnbesneden gezicht van de dame, met de donkere ogen en de bijzonder gevormde mond. Iets vertrouwds, lang vergetene en meer dan dierbaars keek hem uit die aandachtige ogen aan."
                            }
                        ]
                    }
