                                "sense_id": "7b06ba17-ba0e-3cc9-a917-000970c89c13",
                                "text": "The duck escaped into the children's party, and hilarity ensued."
                            }
                        ]
                    },
                    {
                        "sense_id": "95be5942-360d-3d04-9654-3188eded4f0a",
                        "entry_id": "02abd6f7-e53c-38cd-b412-cec2812228b6",
                        "glosses": [
