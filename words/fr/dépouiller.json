{
    "word_family": [
        "dépouille",
        "dépouillement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c6b9c3dc-26c4-37c9-ad36-e9c4eb22e904",
                    "sense_definition": "Compter et enregistrer les bulletins de vote lors d'une élection.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "examen_analyse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès la fermeture des bureaux de vote, les assesseurs commencent à <w>dépouiller</w> les bulletins."
                        },
                        {
                            "text": "Il faut plusieurs heures pour <w>dépouiller</w> l'ensemble des suffrages exprimés dans cette commune."
                        }
                    ],
                    "common_phrases": [
                        "dépouiller les bulletins",
                        "dépouiller le scrutin",
                        "dépouiller les votes"
                    ]
                },
                {
                    "sense_id": "a86c6c82-2501-3037-b209-2541f2802518",
                    "sense_definition": "Priver quelqu'un de ses biens, de ses vêtements ou de ses richesses, souvent par la force ou la ruse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vol_spoliation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des voleurs l'ont agressé dans la ruelle sombre pour le <w>dépouiller</w> de son portefeuille."
                        },
                        {
                            "text": "L'escroc a réussi à <w>dépouiller</w> cette vieille dame de toutes ses économies."
                        }
                    ],
                    "synonyms": [
                        "détrousser"
                    ],
                    "common_phrases": [
                        "dépouiller de ses biens"
                    ]
                },
                {
                    "sense_id": "8fd9faca-2bf7-32ad-a4ca-9b6863726389",
                    "sense_definition": "Examiner de manière méthodique des documents, un dossier ou une correspondance pour en extraire les informations utiles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "examen_analyse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'historien passe ses journées à <w>dépouiller</w> les archives municipales pour son prochain livre."
                        },
                        {
                            "text": "Le secrétariat doit <w>dépouiller</w> le courrier reçu avant de le transmettre à la direction."
                        }
                    ],
                    "common_phrases": [
                        "dépouiller des archives",
                        "dépouiller le courrier",
                        "dépouiller un dossier"
                    ]
                },
                {
                    "sense_id": "ff05f2db-c451-3b55-ad07-7375fac7c92a",
                    "sense_definition": "Retirer la peau d'un animal mort.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "decoupe_peau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chasseur a suspendu le gibier pour le <w>dépouiller</w> avec précaution."
                        },
                        {
                            "text": "Le boucher s'apprête à <w>dépouiller</w> le lapin avant de le découper pour la vente."
                        }
                    ],
                    "common_phrases": [
                        "dépouiller un lapin",
                        "dépouiller un lièvre"
                    ]
                },
                {
                    "sense_id": "b7f15b9b-d502-32b7-b018-b6cb03178b60",
                    "sense_definition": "Retirer à quelque chose ce qui le recouvre ou, au sens pronominal, renoncer à un bien, un statut ou une habitude.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "retirer_couverture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent violent a fini par <w>dépouiller</w> les arbres de leurs dernières feuilles d'automne."
                        },
                        {
                            "text": "En entrant dans cet ordre religieux, il a choisi de se <w>dépouiller</w> de tout luxe matériel."
                        }
                    ],
                    "common_phrases": [
                        "se dépouiller de"
                    ]
                }
            ]
        }
    ]
}