                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13fadc17-1b9b-44b8-b780-f297660a9a56",
                                                "sense_id": "6f0507d3-4212-318b-9e4f-297b747784c3",
                                                "text": "In view of this biochemical diversity, the possibilities of interspecies hybridization in this genus are very interesting and worthy of attention."
