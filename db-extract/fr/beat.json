                                ]
                            },
                            {
                                "target_word": "бит",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2df79749-d330-367d-a850-fd6c95fc880a",
                                        "entry_id": "72f19d58-9558-35b0-bb2f-8fee625628d3",
                                        "glosses": [
                                            "муз. элементарная единица музыкального метра"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2992fbaa-f8cb-49a5-9063-7f77b5b504ae",
                                                "sense_id": "2df79749-d330-367d-a850-fd6c95fc880a",
                                                "text": "Любая музыка разбита на фразы. Их можно распознать слушая исполнение песни (обычно между фразами певцы вдыхают в грудь воздух). Фразы разбиты на такты, которые в свою очередь, делятся на биты, или доли (им соответствуют щелчки метронома)."
                                            },
                                            {
                                                "example_id": "6d61a882-3209-41fc-ae63-4f3eeb1f1bd9",
                                                "sense_id": "2df79749-d330-367d-a850-fd6c95fc880a",
                                                "text": "Жёсткость и однообразие бита позволили остальным музыкантам играть чуть-чуть не в такт, иначе говоря, то торопиться, то опаздывать относительно основного бита: это офф-бит (off-beat)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b103e772-b0ab-3177-bede-bf5de05c9cdf",
                                        "entry_id": "72f19d58-9558-35b0-bb2f-8fee625628d3",
                                        "glosses": [
                                            "муз. музыкальное течение, зародившийся в Великобритании в начале 60-х годов XX века"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35f73241-131d-4bfb-8786-81510dcd7fab",
                                                "sense_id": "b103e772-b0ab-3177-bede-bf5de05c9cdf",
                                                "text": "Кроме того, широко представлен всякий недурной лаунж (Beanfield, Jazzanova, Shantel, особенно Boozoo Bajou), много типичного тевтонского бита (техно, хаус и пр)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0551671e-614b-32b5-a603-391a4cda7f52",
                                        "entry_id": "72f19d58-9558-35b0-bb2f-8fee625628d3",
                                        "glosses": [
                                            "театр. небольшой промежуток времени между репликами или действиями"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
