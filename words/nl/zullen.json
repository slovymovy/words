                {
                    "sense_id": "e1d7e208-9f2e-3b33-bd72-6f26cfaf4922",
                    "sense_definition": "Hulpwerkwoord om een voorwaarde, wens of mogelijkheid uit te drukken (in de vorm 'zou' of 'zouden').",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als ik meer tijd had, <w>zou</w> ik vaker sporten.",
                            "target_lang_translations": {
                                "en": "If I had more time, I <w>would</w> exercise more often.",
                                "ru": "Если бы у меня было больше времени, я <w>бы</w> чаще занимался спортом.",
                                "pl": "Gdybym miał więcej czasu, częściej <w>byłbym</w> aktywny fizycznie.",
                                "de": "Wenn ich mehr Zeit hätte, <w>würde</w> ich öfter Sport treiben.",
                                "fr": "Si j'avais plus de temps, je <w>ferais</w> du sport plus souvent.",
                                "it": "Se avessi più tempo, <w>farei</w> sport più spesso.",
                                "cs": "Kdybych měl víc času, sportoval <w>bych</w> častěji.",
                                "tr": "Daha fazla zamanım olsaydı, daha sık spor <w>yapardım</w>.",
                                "es": "Si tuviera más tiempo, <w>haría</w> deporte más a menudo."
                            }
                        },
                        {
                            "text": "Dat <w>zou</w> ik nooit doen als ik jou was.",
                            "target_lang_translations": {
                                "en": "I <w>would</w> never do that if I were you.",
                                "ru": "Я <w>бы</w> никогда этого не сделал на твоем месте.",
                                "pl": "Na twoim miejscu nigdy <w>bych</w> tego nie zrobił.",
                                "de": "Das <w>würde</w> ich an deiner Stelle niemals tun.",
                                "fr": "Je ne <w>ferais</w> jamais ça si j'étais toi.",
                                "it": "Non lo <w>farei</w> mai se fossi in te.",
                                "cs": "Být tebou, tohle <w>bych</w> nikdy neudělal.",
                                "tr": "Senin yerinde olsaydım bunu asla <w>yapmazdım</w>.",
                                "es": "Yo nunca <w>haría</w> eso si fuera tú."
                            }
                        },
                        {
                            "text": "Ik <w>zou</w> graag een kopje koffie willen.",
                            "target_lang_translations": {
                                "en": "I <w>would</w> like a cup of coffee.",
                                "ru": "Я <w>бы</w> хотел чашечку кофе.",
                                "pl": "Chciał<w>bym</w> filiżankę kawy.",
                                "de": "Ich <w>hätte</w> gerne eine Tasse Kaffee.",
                                "fr": "Je <w>voudrais</w> bien une tasse de café.",
                                "it": "Mi <w>piacerebbe</w> avere una tazza di caffè.",
                                "cs": "Dal <w>bych</w> si šálek kávy.",
                                "tr": "Bir fincan kahve <w>almak isterdim</w>.",
                                "es": "Me <w>gustaría</w> tomar una taza de café."
                            }
                        }
