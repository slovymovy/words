                        "examples": [
                            {
                                "example_id": "74a13feb-b6d7-451f-8a94-46c07234d58d",
                                "sense_id": "8318b2da-c0b9-37e3-aada-7a5d86094854",
                                "text": "Les minerais de fer manganésifères."
                            },
                            {
                                "example_id": "110b7c17-26d9-4403-ba10-40764ba1df17",
                                "sense_id": "8318b2da-c0b9-37e3-aada-7a5d86094854",
                                "text": "Cette roche, dolomitique sur plusieurs points, griotteuse sur d'autres, a certainement fourni aux eaux métallisantes les éléments propres aux concentrations manganésifères."
                            },
                            {
                                "example_id": "0e30509c-c7fd-4a33-a431-28cabcf4216b",
                                "sense_id": "8318b2da-c0b9-37e3-aada-7a5d86094854",
                                "text": "Il a bien fallu abandonner les puits les plus manganésifères et en revenir provisoirement à l’eau de rivière filtrée, en attendant de pouvoir démanganiser pratiquement ces eaux."
                            }
                        ]
                    }
