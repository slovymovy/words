                "senses": [
                    {
                        "sense_id": "1b61812b-5308-30e7-8984-c090855289c3",
                        "entry_id": "31557410-f0b3-3c19-9f65-7de53b199abd",
                        "glosses": [
                            "kapavka, tripl, gonorrhoea"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ff68f2a-0e33-41ed-a670-6b3d929e193d",
                                "sense_id": "1b61812b-5308-30e7-8984-c090855289c3",
                                "text": "Główną przyczyną zakażenia rzeżączką są kontakty płciowe (genitalne, oralne, analne) z osobami chorymi oraz używanie wspólnych przedmiotów do codziennej higieny, np. ręczników albo pościeli.",
                                "translation": "Hlavní příčinou nákazy kapavkou jsou pohlavní styky (genitální, orální, anální) s nemocnými osobami a také používání společných potřeb každodenní hygieny, např. ručníků či lůžka."
                            },
                            {
                                "example_id": "f92c5396-3cd3-42b6-b6d0-396d6479af7b",
                                "sense_id": "1b61812b-5308-30e7-8984-c090855289c3",
                                "text": "Rzeżączka energicznie chlusnęła wodą na zabłoconą posadzkę.",
                                "translation": "Kapavka energicky chlístla vodu na zablácenou podlahu."
                            }
                        ]
                    }
