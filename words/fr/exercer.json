            "senses": [
                {
                    "sense_id": "87902354-1281-3e2f-a599-24f54eaffc57",
                    "sense_definition": "Pratiquer un métier, remplir une charge ou une profession.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après de longues études, ma sœur commence enfin à <w>exercer</w> son métier de vétérinaire."
                        },
                        {
                            "text": "Ce médecin généraliste a décidé d'<w>exercer</w> dans un petit village de campagne."
                        }
                    ],
                    "synonyms": [
                        "pratiquer"
                    ],
                    "common_phrases": [
                        "exercer un métier",
                        "exercer une profession"
                    ]
                },
                {
                    "sense_id": "460fd414-158e-3dfe-bd1d-2ded0164e6a7",
                    "sense_definition": "Entraîner quelqu'un ou développer une compétence par des exercices répétés.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "entrainement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur tente d'<w>exercer</w> ses élèves à la prise de parole en public."
                        },
                        {
                            "text": "L'instructeur militaire prend le temps d'<w>exercer</w> les nouvelles recrues sur le terrain."
                        }
                    ],
                    "synonyms": [
                        "entraîner",
                        "former"
                    ],
                    "common_phrases": [
                        "exercer des élèves"
                    ]
                },
                {
                    "sense_id": "65062cae-da45-3b38-a94e-26ba6dddb969",
                    "sense_definition": "Avoir ou produire une action continue, une pression ou un effet sur quelqu'un ou quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce mentor continue d'<w>exercer</w> une influence très positive sur le travail de ses collègues."
                        },
                        {
                            "text": "Les journalistes refusent de céder quand on cherche à <w>exercer</w> une pression sur eux."
                        }
                    ],
                    "synonyms": [
                        "appliquer"
                    ],
                    "common_phrases": [
                        "exercer une influence",
                        "exercer une pression"
                    ]
                },
                {
                    "sense_id": "770f723f-4f63-3275-8400-74e9005ab673",
                    "sense_definition": "Faire usage d'un droit, appliquer un pouvoir ou une autorité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque citoyen majeur doit pouvoir <w>exercer</w> son droit de vote librement."
                        },
                        {
                            "text": "Le directeur a choisi d'<w>exercer</w> son autorité pour calmer les tensions au sein du groupe."
                        }
                    ],
                    "synonyms": [
                        "appliquer"
                    ],
                    "common_phrases": [
                        "exercer un droit",
                        "exercer le pouvoir"
                    ]
                },
                {
                    "sense_id": "25bdf653-6642-3fe1-8ecc-5e7f0799a60f",
                    "sense_definition": "Faire fonctionner ou stimuler un organe, un membre ou une faculté intellectuelle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "capacite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Faire des mots croisés tous les matins aide à <w>exercer</w> sa mémoire et son esprit."
                        },
                        {
                            "text": "La chanteuse fait des vocalises quotidiennes afin d'<w>exercer</w> sa voix sans se fatiguer."
                        }
                    ],
                    "synonyms": [
                        "stimuler",
                        "travailler"
                    ],
                    "common_phrases": [
