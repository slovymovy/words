                        "entry_id": "60964566-b45a-3000-9d9a-4446c149b9b1",
                        "glosses": [
                            "Celui qui a l’habitude de faire des remontrances ennuyeuses et hors de propos."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "40f9d54e-2a4a-4e83-80af-188d830540ea",
                                "sense_id": "d2ddf6f7-93be-31ef-a72f-9c1391df5b28",
                                "text": "C’est un impitoyable, un éternel sermonneur, un ennuyeux sermonneur. Il est familier."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c28f507-9f1d-3466-a853-0eb5de8735e9",
                        "entry_id": "60964566-b45a-3000-9d9a-4446c149b9b1",
                        "glosses": [
                            "Celui qui rédige et dit des sermons."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a9164b36-16fa-43cd-b9c4-ae7a000ab02d",
                                "sense_id": "1c28f507-9f1d-3466-a853-0eb5de8735e9",
                                "text": "Dieu, dit le sermonneur, fait après le déluge une alliance avec Noé et tous les animaux, et pour confirmer cette alliance, il institue l’arc-en-ciel."
                            }
                        ]
                    }
