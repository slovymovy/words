                        "examples": [
                            {
                                "example_id": "cca390b0-4ddf-4192-83f3-3ad25da1a71c",
                                "sense_id": "af16b20c-8231-3bdf-9f37-06c620b6d652",
                                "text": "Стала рассказывать о своей жизни в обидах и терпеливом страдании, рассказывала беззлобно, с усмешкой сожаления на губах."
                            },
                            {
                                "example_id": "4133bf2a-bf9b-471e-9558-f3770c2a70a4",
                                "sense_id": "af16b20c-8231-3bdf-9f37-06c620b6d652",
                                "text": "Где-то на другом конце деревни, как нанялась, гавкала давно и безостановочно собака ― устало, беззлобно, лишь бы не дать о себе забыть."
                            }
                        ]
                    }
