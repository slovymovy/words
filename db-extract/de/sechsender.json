                "senses": [
                    {
                        "sense_id": "48cdd3d2-b818-3f9b-8147-0aae7642808f",
                        "entry_id": "00e7083f-5390-3639-87fe-c3bfe0fb607e",
                        "glosses": [
                            "Hirsch mit in sechs Enden auslaufendem Geweih beziehungsweise dieses selbst"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "9f23fb96-4c2f-4585-898f-ebdb4d9119e3",
                                "sense_id": "48cdd3d2-b818-3f9b-8147-0aae7642808f",
                                "text": "„Eine spektakuläre Hirschjagd durch das Zentrum der Südtiroler Landeshauptstadt Bozen hat am Montag für das Tier mit einem Kopfschuss geendet. Der nahezu 150 Kilo schwere Sechsender war in einem Stiegenaufgang eines Parkhauses steckengeblieben und hatte sich dabei an den Knien schwer verletzt.“"
                            },
                            {
                                "example_id": "d66773ed-88e5-4330-8273-c95761aeafd2",
                                "sense_id": "48cdd3d2-b818-3f9b-8147-0aae7642808f",
                                "text": "„Die Viertklässler einer Schule im US-Staat Minnesota kamen mit dem Schrecken davon, als ein Sechsender durch das Fenster in ihren Klassenraum einbrach und mit seinem Geweih Stühle, Tische und Bücher herumwirbelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
