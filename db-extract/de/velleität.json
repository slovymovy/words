                        ],
                        "examples": [
                            {
                                "example_id": "923dc175-891e-4dca-8a12-d2a6bb03ea2f",
                                "sense_id": "c91b4fda-7ca2-3c45-a738-9a5648edac7c",
                                "text": "Wie wäre die berühmte Erzählung vom »Elenden« wohl anders zu deuten denn als Ausbruch des Ekels gegen den unanständigen Psychologismus der Zeit, verkörpert in der Figur jenes weichen und albernen Halbschurken, der sich ein Schicksal erschleicht, indem er sein Weib, aus Ohnmacht, aus Lasterhaftigkeit, aus ethischer Velleität, in die Arme eines Unbärtigen treibt und aus Tiefe Nichtswürdigkeiten begehen zu dürfen glaubt?",
                                "translation": "Death in Venice",
                                "english": "Death in Venice"
                            }
                        ]
                    }
                ],
