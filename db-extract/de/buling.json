                "senses": [
                    {
                        "sense_id": "c99aafbf-368a-32de-8faf-3d3807f9d230",
                        "entry_id": "f4672291-e097-301f-baa6-b286f0647fe2",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01d8913f-2d4f-4043-ad23-27882cfa316b",
                                "sense_id": "c99aafbf-368a-32de-8faf-3d3807f9d230",
                                "text": "Frau Buling ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "97c4e060-605d-4f9a-8085-3f3ce202acf4",
                                "sense_id": "c99aafbf-368a-32de-8faf-3d3807f9d230",
                                "text": "Herr Buling wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ba29cffc-5670-465f-a5ca-97a12e3061ec",
                                "sense_id": "c99aafbf-368a-32de-8faf-3d3807f9d230",
                                "text": "Die Bulings fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e3afae0b-0127-4fbc-94a0-c70e5fe2106d",
                                "sense_id": "c99aafbf-368a-32de-8faf-3d3807f9d230",
                                "text": "Der Buling trägt nie die Schals, die die Buling ihm strickt."
                            },
                            {
                                "example_id": "ab9abf06-fdca-4c10-8229-8d3dede02cd0",
                                "sense_id": "c99aafbf-368a-32de-8faf-3d3807f9d230",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Buling kommt, geht der Herr Buling.“"
                            },
                            {
                                "example_id": "309ba5ed-97ea-45b3-88e1-1ac885105219",
                                "sense_id": "c99aafbf-368a-32de-8faf-3d3807f9d230",
                                "text": "Buling kommt und geht."
                            },
                            {
                                "example_id": "7c5c5a44-0ed2-4d3a-881b-7d27dac09111",
                                "sense_id": "c99aafbf-368a-32de-8faf-3d3807f9d230",
                                "text": "Bulings kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
