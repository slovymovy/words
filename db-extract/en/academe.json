                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "45ed637c-71a1-41f1-9e5f-f67a52f47068",
                                "sense_id": "589c1aae-fd6e-35c2-a3e8-e689a2dda2a2",
                                "text": "If it did nothing else, Homosexuality: Social, Psychological, and Biological Issues shows that the basic tenet of gay liberation—that is, viewing gayness as having an intrinsic validity—has finally entered and taken root in the groves of academe."
                            },
                            {
                                "example_id": "7f36626a-2b6f-4c55-8d81-de7fb499791b",
                                "sense_id": "589c1aae-fd6e-35c2-a3e8-e689a2dda2a2",
                                "text": "His father expected him to enter the government or a major corporation upon graduation from the university, but Noboru Wataya chose to remain in academe and become a scholar."
                            }
                        ]
                    },
                    {
                        "sense_id": "4858b885-7e57-3878-b070-4d71e553c068",
