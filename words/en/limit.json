{
    "word_family": [
        "limitation",
        "limitless",
        "limited",
        "limiter",
        "delimitation",
        "delimit"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eeba64d0-9624-3720-a371-0fd61ec7f310",
                    "sense_definition": "A restriction or a point beyond which one may not go or something may not extend.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "restriction_bound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speed <w>limit</w> in this residential area is strictly enforced.",
                            "target_lang_translations": {
                                "ru": "В этом жилом районе строго соблюдается <w>ограничение</w> скорости.",
                                "zh": "这个居民区的速度<w>限制</w>执行得非常严格。"
                            }
                        },
                        {
                            "text": "There is a <w>limit</w> to how much patience I have with this situation.",
                            "target_lang_translations": {
                                "ru": "Моему терпению в этой ситуации есть <w>предел</w>.",
                                "zh": "我对这种情况的耐心是有<w>限度</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "restriction",
                        "limitation",
                        "bound",
                        "threshold",
                        "boundary",
                        "cap"
                    ],
                    "common_phrases": [
                        "speed limit",
                        "time limit",
                        "age limit",
                        "within limits",
                        "push the limit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ограничение или точка, за которую нельзя выходить или распространяться.",
                        "zh": "一种限制或不可逾越的界限。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ограничение",
                                "target_lang_sense_clarification": "правило или норма"
                            },
                            {
                                "target_lang_word": "предел",
                                "target_lang_sense_clarification": "крайняя степень или точка"
                            },
                            {
                                "target_lang_word": "лимит",
                                "target_lang_sense_clarification": "предельная норма потребления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "限制",
                                "target_lang_sense_clarification": "规则或约束"
                            },
                            {
                                "target_lang_word": "限度",
                                "target_lang_sense_clarification": "容忍或能力的极限"
                            },
                            {
                                "target_lang_word": "额度",
                                "target_lang_sense_clarification": "数量上的上限"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dad3c78-b16a-371e-90e3-14880d300096",
                    "sense_definition": "The furthest point, edge, or border of a place or area.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "boundary_edge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We walked to the <w>limits</w> of the forest before turning back.",
                            "target_lang_translations": {
                                "ru": "Мы дошли до <w>границы</w> леса, прежде чем повернуть назад.",
                                "zh": "我们走到森林的<w>边界</w>才折返。"
                            }
                        },
                        {
                            "text": "They live just outside the city <w>limits</w> in a quiet suburb.",
                            "target_lang_translations": {
                                "ru": "Они живут сразу за городской <w>чертой</w> в тихом пригороде.",
                                "zh": "他们住在城市<w>界限</w>外的一个安静郊区。"
                            }
                        }
                    ],
                    "synonyms": [
                        "boundary"
                    ],
                    "common_phrases": [
                        "city limits",
                        "outer limits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самая дальняя точка, край или граница места или области.",
                        "zh": "某地或某区域的最远点、边缘或边界。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "граница",
                                "target_lang_sense_clarification": "линия раздела территории"
                            },
                            {
                                "target_lang_word": "пределы",
                                "target_lang_sense_clarification": "территория, пространство (обычно мн.ч.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "边界",
                                "target_lang_sense_clarification": "地理区域的界线"
                            },
                            {
                                "target_lang_word": "界限",
                                "target_lang_sense_clarification": "范围的边缘"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7aad46c9-029c-3ebe-8d09-278b876b6218",
                    "sense_definition": "A value to which a sequence or function converges as the input approaches a certain point.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "math_limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In calculus, students learn how to calculate the <w>limit</w> of a function.",
                            "target_lang_translations": {
                                "ru": "В матанализе студенты учатся вычислять <w>предел</w> функции.",
                                "zh": "在微积分中，学生学习如何计算函数的<w>极限</w>。"
                            }
                        },
                        {
                            "text": "The sequence of numbers approaches zero as its <w>limit</w>.",
                            "target_lang_translations": {
                                "ru": "Числовая последовательность стремится к нулю как к своему <w>пределу</w>.",
                                "zh": "该数列趋近于零，即其<w>极限</w>为零。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Значение, к которому стремится последовательность или функция при приближении аргумента к определенной точке.",
                        "zh": "数学中，当自变量趋近于某一点时，函数或序列所趋近的值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предел",
                                "target_lang_sense_clarification": "математическое понятие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极限",
                                "target_lang_sense_clarification": "数学概念"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f2e0c17-7dff-31ae-8081-1cbd3970ca8d",
                    "sense_definition": "A person or thing that is intolerable, exasperating, or astounding.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "colloquial_exasperation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You really are the <w>limit</w> with your constant complaining.",
                            "target_lang_translations": {
                                "ru": "Ты со своими постоянными жалобами просто <w>невыносим</w>.",
                                "zh": "你没完没了地抱怨，真是让人<w>受够了</w>。"
                            }
                        },
                        {
                            "text": "My brother is the <w>limit</w>; he never cleans up after himself.",
                            "target_lang_translations": {
                                "ru": "Мой брат — это <w>нечто</w>; он никогда не убирает за собой.",
                                "zh": "我弟弟真是让人<w>受够了</w>，他从不清理自己的东西。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "be the limit"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe an exasperating person"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или вещь, которые становятся невыносимыми или вызывают крайнее раздражение.",
                        "zh": "指令人无法忍受、极其恼人或令人震惊的人或事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нечто невыносимое",
                                "target_lang_sense_clarification": "тот, кто или то, что выводит из себя или поражает (you're the limit)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "受够了",
                                "target_lang_sense_clarification": "形容某人行为令人无法忍受"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b36b229-bb8d-39cd-a97e-3d8a849ba808",
                    "sense_definition": "To restrict or keep something within a certain bound or amount.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "restriction_bound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>limit</w> my sugar intake for health reasons.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>ограничить</w> потребление сахара по состоянию здоровья.",
                                "zh": "出于健康考虑，我需要<w>限制</w>糖分的摄入。"
                            }
                        },
                        {
                            "text": "Please <w>limit</w> your answers to two sentences each.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>ограничьте</w> свои ответы двумя предложениями.",
                                "zh": "请将你的回答<w>限制</w>在每题两句话以内。"
                            }
                        }
                    ],
                    "synonyms": [
                        "restrict",
                        "curb",
                        "restrain",
                        "check",
                        "curtail",
                        "hold back",
                        "cap",
                        "confine"
                    ],
                    "antonyms": [
                        "expand"
                    ],
                    "common_phrases": [
                        "limit yourself",
                        "limit access",
                        "limit the number"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ограничивать или удерживать что-либо в определенных границах или количестве.",
                        "zh": "将某事物控制在一定范围或数量之内。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ограничивать",
                                "target_lang_sense_clarification": "ставить в рамки (несов. вид)"
                            },
                            {
                                "target_lang_word": "ограничить",
                                "target_lang_sense_clarification": "поставить в рамки (сов. вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "限制",
                                "target_lang_sense_clarification": "约束范围或数量"
                            },
                            {
                                "target_lang_word": "限定",
                                "target_lang_sense_clarification": "规定范围"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}