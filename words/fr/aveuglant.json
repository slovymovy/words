                        "soleil aveuglant"
                    ]
                },
                {
                    "sense_id": "b0a9b8a6-48bf-331c-a132-eb4e7de20ea0",
                    "sense_definition": "Qui empêche momentanément de voir en obstruant ou en troublant la vue.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une fumée noire et <w>aveuglante</w> s'est rapidement propagée dans toute la cage d'escalier."
                        },
                        {
                            "text": "Les marins devaient affronter une pluie <w>aveuglante</w> poussée par des vents violents."
                        }
                    ],
                    "common_phrases": [
                        "fumée aveuglante",
                        "pluie aveuglante"
                    ]
                },
                {
                    "sense_id": "3926c568-5df2-3e95-aa6d-3da8cd9461ab",
                    "sense_definition": "Qui provoque la perte durable ou définitive de la vision, la cécité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sans protection adaptée, les rayons ultraviolets en haute montagne peuvent devenir <w>aveuglants</w>."
                        },
                        {
                            "text": "Les traités internationaux interdisent l'usage militaire de toute arme à rayon laser <w>aveuglant</w>."
                        }
                    ],
                    "common_phrases": [
                        "gaz aveuglant"
                    ]
