{
    "word_family": [
        "beck"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4059b306-e4ce-32bf-a55b-08a2fbe15542",
                    "sense_definition": "To signal someone to come closer by waving or nodding.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gesture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher <w>beckoned</w> the student to come to the front of the class.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>подзвал</w> ученика к доске."
                            }
                        },
                        {
                            "text": "He <w>beckoned</w> her over with a quick wave of his hand.",
                            "target_lang_translations": {
                                "ru": "Он <w>поманил</w> её к себе быстрым взмахом руки."
                            }
                        }
                    ],
                    "synonyms": [
                        "summon",
                        "signal"
                    ],
                    "common_phrases": [
                        "beckon over",
                        "beckon closer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жестом или кивком головы призывать кого-либо подойти ближе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подзыва́ть",
                                "target_lang_sense_clarification": "призывать кого-либо подойти жестом или голосом"
                            },
                            {
                                "target_lang_word": "манить",
                                "target_lang_sense_clarification": "призывать жестом, приглашать подойти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cc2ddfd-6d48-3a8a-8cc4-ce104fcdf9c8",
                    "sense_definition": "To appear attractive or inviting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warm, sunny beach <w>beckons</w> to tourists every summer.",
                            "target_lang_translations": {
                                "ru": "Тёплый солнечный пляж <w>манит</w> туристов каждое лето."
                            }
                        },
                        {
                            "text": "The quiet library <w>beckons</w> those who need a peaceful place to study.",
                            "target_lang_translations": {
                                "ru": "Тихая библиотека <w>притягивает</w> тех, кому нужно спокойное место для учёбы."
                            }
                        }
                    ],
                    "synonyms": [
                        "entice",
                        "allure",
                        "tempt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выглядеть привлекательно или заманчиво, притягивать к себе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манить",
                                "target_lang_sense_clarification": "привлекать, притягивать к себе"
                            },
                            {
                                "target_lang_word": "притягивать",
                                "target_lang_sense_clarification": "вызывать интерес, влечь к себе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9a65fbc1-c299-3693-9bdd-1fdeb7f654ea",
                    "sense_definition": "A silent gesture or signal made to someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gesture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She followed his <w>beckon</w> toward the exit.",
                            "target_lang_translations": {
                                "ru": "Она последовала за его <w>жестом</w> в сторону выхода."
                            }
                        },
                        {
                            "text": "He waited for a <w>beckon</w> before entering the room.",
                            "target_lang_translations": {
                                "ru": "Он ждал <w>знака</w>, прежде чем войти в комнату."
                            }
                        }
                    ],
                    "synonyms": [
                        "signal",
                        "gesture"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English as a noun."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Безмолвный жест или сигнал, сделанный кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жест",
                                "target_lang_sense_clarification": "движение рукой или головой, призывающее к действию"
                            },
                            {
                                "target_lang_word": "знак",
                                "target_lang_sense_clarification": "сигнал, подаваемый кому-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "247eabd6-6cdf-3133-a1ed-14db1911f52a",
                    "sense_definition": "A children's game where caught players can be freed by a signal from another player.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children played <w>beckon</w> in the park all afternoon.",
                            "target_lang_translations": {
                                "ru": "Дети весь день играли в «бекон» в парке."
                            }
                        },
                        {
                            "text": "Learning the rules of <w>beckon</w> was part of their childhood.",
                            "target_lang_translations": {
                                "ru": "Изучение правил игры в «бекон» было частью их детства."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Детская игра, в которой пойманные игроки могут быть освобождены по сигналу другого игрока."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        }
    ]
}