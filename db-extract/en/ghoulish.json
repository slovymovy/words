                "senses": [
                    {
                        "sense_id": "6e7148f5-0bc3-3d40-a2f2-3e01220df4d4",
                        "entry_id": "d8284f96-3838-396c-84f1-33abfe42af0f",
                        "glosses": [
                            "Of or pertaining to ghouls."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dadefd89-63cc-40b2-9f25-c6367dbec4b9",
                                "sense_id": "6e7148f5-0bc3-3d40-a2f2-3e01220df4d4",
                                "text": "Ay, even the droll humour and solidity of Khalid, are shaken, aroused, by the ghoulish greed, the fell inhumanity of these sharpers."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b943ec6-a642-3eae-8583-9bb0ba3872bf",
                        "entry_id": "d8284f96-3838-396c-84f1-33abfe42af0f",
                        "glosses": [
                            "Of or pertaining to corpses and graverobbing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2feea448-5754-4b2a-ab1e-f6ae756d619c",
                                "sense_id": "3b943ec6-a642-3eae-8583-9bb0ba3872bf",
                                "text": "We had that afternoon dug a grave in the cellar, and would have to fill it by dawn -- for although we had fixed a lock on the house, we wished to shun even the remotest risk of a ghoulish discovery."
                            }
                        ]
                    },
                    {
                        "sense_id": "b63d27e9-a980-3355-9928-6a8b5c9c764a",
                        "entry_id": "d8284f96-3838-396c-84f1-33abfe42af0f",
                        "glosses": [
                            "Fascinated by corpses; morbid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d74806af-e8b1-452d-9796-bd5ac4fabcbf",
                                "sense_id": "b63d27e9-a980-3355-9928-6a8b5c9c764a",
                                "text": "At times it seemed almost an afterthought, during an extended trial subject to ghoulish fascination, that Don Patterson, Gail Patterson and Heather Wilkinson died terrible deaths."
                            },
                            {
                                "example_id": "ecfce242-0fef-4bbf-8660-20e0193e5d85",
                                "sense_id": "b63d27e9-a980-3355-9928-6a8b5c9c764a",
                                "text": "We’ll be neither ghoulish nor squeamish about death; it happens, the chances increase with age, and we need to take the possibility into consideration."
                            }
                        ]
                    }
                ],
