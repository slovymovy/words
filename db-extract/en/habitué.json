                                        "glosses": [
                                            "ο μόνιμος, αυτός που παραμένει πάγιος και σταθερός σε μια θέση για την εκπλήρωση των καθηκόντων του, που κατέχει οργανική σχέση"
                                        ],
                                        "tags": [
                                            "σταθερότητα"
                                        ],
                                        "examples": [
