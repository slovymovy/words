                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After much <w>trying</w>, he finally managed to open the locked door.",
                            "target_lang_translations": {
                                "ru": "После долгих <w>попыток</w> ему наконец удалось открыть запертую дверь.",
                                "pl": "Po wielu <w>próbach</w> w końcu udało mu się otworzyć zamknięte drzwi."
                            }
                        },
                        {
                            "text": "The <w>trying</w> of new methods is essential for scientific progress.",
                            "target_lang_translations": {
