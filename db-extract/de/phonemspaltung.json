                "senses": [
                    {
                        "sense_id": "0a55c406-2db6-3451-b9d4-5474351d97b1",
                        "entry_id": "d6b47037-dd52-3b86-b335-c9cb5ed0b085",
                        "glosses": [
                            "Entwicklung von Allophonen zu Phonemen, das heißt, Einheiten (Allophone), die zuvor verschiedene Realisierungen ein und desselben Phonems waren, werden zu unterschiedlichen Phonemen"
                        ],
                        "tags": [
                            "Phonologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d5449f7f-6b7a-4da1-92fe-5d509c010404",
                                "sense_id": "0a55c406-2db6-3451-b9d4-5474351d97b1",
                                "text": "„Die Phonemspaltung läuft immer in zwei Phasen ab.“"
                            },
                            {
                                "example_id": "dd2e57e4-bd3f-4ae2-be08-f37029a655f4",
                                "sense_id": "0a55c406-2db6-3451-b9d4-5474351d97b1",
                                "text": "„Trotzdem ist die Bezeichnung ›Verschiebung‹ für die althochdeutsche Konsonantenverschiebung nicht ganz korrekt, weil dieser Vorgang eine Kombination einer Lautverschiebung mit einer Mehrung des Phonembestands aufgrund einer Phonemspaltung (…) ist.“"
                            },
                            {
                                "example_id": "8b8b611c-2399-44ce-856e-b0e295fe832a",
                                "sense_id": "0a55c406-2db6-3451-b9d4-5474351d97b1",
                                "text": "„Zurückzuführen ist dieser Variantenreichtum auf die Phonemspaltung des germanischen eu.“"
                            },
                            {
                                "example_id": "8656b01d-ffea-4e32-988b-34e133b7a055",
                                "sense_id": "0a55c406-2db6-3451-b9d4-5474351d97b1",
                                "text": "„Im Zuge der Verschiebung der einfachen Tenues kam es zu Phonemspaltungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
