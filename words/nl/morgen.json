        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "98d15906-1908-3d06-8cea-98dd6e6e6ddf",
                    "sense_definition": "Een begroeting die men gebruikt in de ochtend; verkorting van goedemorgen.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "greeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Morgen</w>! Heb je lekker geslapen?",
                            "target_lang_translations": {
                                "en": "<w>Morning</w>! Did you sleep well?",
                                "ru": "<w>Доброе утро</w>! Ты хорошо спал?",
                                "pl": "<w>Dzień dobry</w>! Dobrze spałeś?",
                                "de": "<w>Morgen</w>! Hast du gut geschlafen?",
                                "fr": "<w>Salut</w> ! Tu as bien dormi ?",
                                "it": "<w>Giorno</w>! Hai dormito bene?",
                                "cs": "<w>Dobré ráno</w>! Vyspal ses dobře?",
                                "tr": "<w>Günaydın</w>! İyi uyudun mu?",
                                "es": "¡<w>Buenos días</w>! ¿Has dormido bien?"
                            }
                        },
                        {
                            "text": "<w>Morgen</w> allemaal, laten we beginnen.",
                            "target_lang_translations": {
                                "en": "<w>Morning</w> everyone, let's start.",
                                "ru": "<w>Доброе утро</w> всем, давайте начнем.",
                                "pl": "<w>Dzień dobry</w> wszystkim, zaczynajmy.",
                                "de": "<w>Morgen</w> zusammen, lasst uns anfangen.",
                                "fr": "<w>Bonjour</w> tout le monde, commençons.",
                                "it": "<w>Buongiorno</w> a tutti, cominciamo.",
                                "cs": "<w>Dobré ráno</w> všem, pojďme začít.",
                                "tr": "Herkese <w>günaydın</w>, hadi başlayalım.",
                                "es": "¡<w>Buenos días</w> a todos, empecemos!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for goedemorgen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A greeting used in the morning; short for 'good morning'.",
                        "ru": "Приветствие, используемое утром; сокращение от «доброе утро».",
                        "pl": "Powitanie używane rano; skrócona forma od „dzień dobry”.",
                        "de": "Ein Gruß, den man am Morgen verwendet; Kurzform von „Guten Morgen“.",
                        "fr": "Salutation utilisée le matin ; abréviation de bonjour.",
                        "it": "Un saluto usato al mattino; abbreviazione di 'buongiorno'.",
                        "cs": "Pozdrav používaný ráno; zkrácená verze pozdravu 'dobré ráno'.",
                        "tr": "Sabahları kullanılan bir selamlama; 'günaydın' sözünün kısaltması.",
                        "es": "Saludo que se utiliza por la mañana; acortamiento de buenos días."
                    },
