                ],
                "senses": [
                    {
                        "sense_id": "d9f80113-fe21-3acd-a2b2-addf2a04b066",
                        "entry_id": "0ba1e26e-d7cf-332e-a708-b9807c45075d",
                        "glosses": [
                            "Messwert, mit dem die Konzentration eines bestimmten Stoffes im Blut bestimmt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f4baa9c-b7fe-469d-8f24-ac038b1fd91a",
                                "sense_id": "d9f80113-fe21-3acd-a2b2-addf2a04b066",
                                "text": "„Malaria verändert zwar bestimmte Blutwerte wie etwa die Zahl der Blutplättchen, aber das trifft auch auf andere Krankheiten zu.“"
                            },
                            {
                                "example_id": "05e42e9b-cf1d-499a-8943-8262226b6c4f",
                                "sense_id": "d9f80113-fe21-3acd-a2b2-addf2a04b066",
                                "text": "„Wenn nun am Ende eines langen Weges wieder über Blutwerte verhandelt würde, kämen auch jene Fragen auf den Tisch eines staatlichen Richters, die den Fall zum Sport-Krimi machen.“"
                            },
                            {
                                "example_id": "1b9d7f49-8a9e-488c-9a7b-6e40927ae915",
                                "sense_id": "d9f80113-fe21-3acd-a2b2-addf2a04b066",
                                "text": "„Seine Blutwerte zeigen eine Eisenmangel-Anämie, die häufigste Form der Blutarmut.“"
                            },
                            {
                                "example_id": "90c974b1-279a-4181-8515-e8893bcf4be4",
                                "sense_id": "d9f80113-fe21-3acd-a2b2-addf2a04b066",
                                "text": "Die Bestimmung von Blutwerten und Urinwerten sind wichtige und vor allem wenig aufwendige diagnostische Methoden um Ungleichgewichte und dahintersteckende Krankheiten zu identifizieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
