                    },
                    {
                        "translation_id": "4e9b38c8-043e-42aa-987f-d83e436f7dac",
                        "source_entry_id": "2ccf7b63-4fbf-3406-8324-e0e04286d87c",
                        "target_lang_word": "Grönländer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grönländer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                                        "entry_id": "aef88037-629a-3abf-a88b-095240f9aad4",
                                        "glosses": [
                                            "Einwohner von Grönland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ad8af41-e1b2-4b77-a6b7-9231225c0e79",
                                                "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                                                "text": "Zudem werden die Grönländer als eigenes Volk und Grönländisch als Landessprache anerkannt."
                                            },
                                            {
                                                "example_id": "a47a7908-1911-48c4-811a-9f1d1621efd7",
                                                "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                                                "text": "Dem Entwurf zufolge soll Grönland pro Jahr die ersten 75 Millionen Kronen (rund 100 Millionen Euro) aus künftigen Öleinnahmen behalten dürfen. Was darüber hinaus geht, wollen sich Grönländer und Dänen je zur Hälfte teilen."
                                            },
                                            {
                                                "example_id": "5bcf8937-7919-42bf-9f15-052228217006",
                                                "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                                                "text": "Doch hoffen die Grönländer immer noch auf Wohlstand durch den Fund von Öl oder Mineralien."
                                            },
                                            {
                                                "example_id": "3facfc29-ccd0-42df-9eac-5cca399360ad",
                                                "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                                                "text": "„Bald nach dem Massaker stürmen Indianer auf die Grönländer zu, schwingen steinerne Tomahawks und schießen mit Pfeil und Bogen - steinzeitliche Waffen, die den eisernen Schwertern und Streitäxten der Wikinger aber kaum unterlegen sind.“"
                                            },
                                            {
                                                "example_id": "b85716b6-7851-46ce-9bc2-5f031f5c2ef9",
                                                "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                                                "text": "„Sie waren die ersten Grönländer, die eine Universitätsausbildung erhielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
