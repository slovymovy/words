            {
                "entry_id": "3f4fb27a-ffc5-3c11-bad0-184fda19c6a0",
                "word": "kelvin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1f8dc016-67b3-42b9-81ad-7ded1a50009f",
                        "entry_id": "3f4fb27a-ffc5-3c11-bad0-184fda19c6a0",
                        "tags": [
                            "plural"
                        ],
                        "form": "kelvins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4c348eb6-cbf8-323b-8ade-e700b3afe490",
                        "entry_id": "3f4fb27a-ffc5-3c11-bad0-184fda19c6a0",
                        "glosses": [
                            "Unité de mesure de la température du Système international, dont le symbole est K. Contrairement aux autres unités de température, le symbole du kelvin ne prend pas de « ° »."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "129e1429-378c-4a62-ac1d-fbb040e86c0e",
                                "sense_id": "4c348eb6-cbf8-323b-8ade-e700b3afe490",
                                "text": "Toutefois, à la différence du degré Celsius, le kelvin est une mesure absolue de la température qui a été introduite grâce au troisième principe de la thermodynamique."
                            },
                            {
                                "example_id": "91301dcd-53f7-4ebe-8c52-f9364550a514",
                                "sense_id": "4c348eb6-cbf8-323b-8ade-e700b3afe490",
                                "text": "Ainsi, au lieu de geler à 0 degré Celsius, l’eau gèle à 273 kelvins et bout à 373 kelvins (qui équivalent à 100 degrés Celsius)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97163e02-c7b8-446e-9d18-5b1b6f62ecd0",
                        "source_entry_id": "3f4fb27a-ffc5-3c11-bad0-184fda19c6a0",
                        "source_sense_id": "4c348eb6-cbf8-323b-8ade-e700b3afe490",
                        "source_sense_description": "Unité de mesure de température",
                        "target_lang_word": "Kelvin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kelvin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7812eb8d-240b-3bfc-88f4-f1a21ff9c517",
                                        "entry_id": "d38abfca-2ea1-32ec-80af-f57b4453d5e6",
                                        "glosses": [
                                            "SI-Basiseinheit der absoluten Temperatur und zugleich gesetzliche Temperatureinheit, die auch zur Angabe von Temperaturdifferenzen verwendet wird und am absoluten Nullpunkt beginnt"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00b4dc67-df26-471b-8086-c257071ff0d8",
                                                "sense_id": "7812eb8d-240b-3bfc-88f4-f1a21ff9c517",
                                                "text": "Der absolute Nullpunkt ist per definitionem bei 0 Kelvin."
                                            },
                                            {
                                                "example_id": "932db8e8-9fda-4063-9d3a-97693e1ef274",
                                                "sense_id": "7812eb8d-240b-3bfc-88f4-f1a21ff9c517",
                                                "text": "„Der Schmelzpunkt des Eises entspricht 273.15 (Grad) Kelvin. Der Siedepunkt des Wassers ist also bei 373.15 (Grad) Kelvin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5bbcc16-c167-48f6-ad03-f524bf7932ed",
                        "source_entry_id": "3f4fb27a-ffc5-3c11-bad0-184fda19c6a0",
                        "source_sense_id": "4c348eb6-cbf8-323b-8ade-e700b3afe490",
                        "source_sense_description": "Unité de mesure de température",
