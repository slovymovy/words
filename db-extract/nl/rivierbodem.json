                        "sense_id": "d64eb79b-cdb9-3a15-b83f-71ea5ed6830d",
                        "entry_id": "8ce37141-f170-327a-bab7-7f08dafdb872",
                        "glosses": [
                            "grond waarover het water van de rivier stroomt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90e3b86f-a85e-4953-8fb5-2566cd22705a",
                                "sense_id": "d64eb79b-cdb9-3a15-b83f-71ea5ed6830d",
                                "text": "Ook wij kinderen gaan vaak naar de overkant, varend of zwemmend, om slangen te zoeken, fossielen uit de rots te rammen met de scherpste stenen die we op de rivierbodem kunnen vinden, of om Indiana Jones na te spelen, al heeft niemand van ons de films gezien."
                            },
                            {
                                "example_id": "9fb0668a-64ac-4544-b452-bb9fe0527e1e",
                                "sense_id": "d64eb79b-cdb9-3a15-b83f-71ea5ed6830d",
                                "text": "De dam wordt in lagen gebouwd. Naarmate de bouw vordert, laat Rijkswaterstaat het waterpeil alvast stijgen. Dat moet geleidelijk gebeuren, zodat woonboten en jachten rustig kunnen loskomen van de rivierbodem."
                            }
                        ]
                    }
