                "senses": [
                    {
                        "sense_id": "eafc0c26-e42e-30e2-99e3-cbeabd5dc7ca",
                        "entry_id": "8da5d170-7f47-3788-9c13-988b9eaaf476",
                        "glosses": [
                            "A monster sent by (and sometimes the progeny of) the goddess Hecate; when imagined as the first or only empusa, or as a species of monster."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "b4d87768-8b77-4a84-83f2-14c8314a25ca",
                                "sense_id": "eafc0c26-e42e-30e2-99e3-cbeabd5dc7ca",
                                "text": "Hobbes compares this hybrid school divinity to Empusa, a female specter in ancient Greek mythology who was supposed to have been sent by the goddess Hecate[…]."
                            },
                            {
                                "example_id": "4c8e51ab-ce78-4f4f-a839-a39865600b9a",
                                "sense_id": "eafc0c26-e42e-30e2-99e3-cbeabd5dc7ca",
                                "text": "The Empusa was a female vampire from Greek mythology that feasted on the blood of men."
                            }
                        ]
                    }
                ],
