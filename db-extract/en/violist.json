                            {
                                "example_id": "263411c3-4d92-4b82-821d-76df5c8773e7",
                                "sense_id": "4eefa14c-db6d-3376-86e3-fbc53d216798",
                                "text": "But those who attack violists shouldn't throw resin. Once the ergonomic viola catches on what instrument will be immune?"
                            },
                            {
                                "example_id": "a7d2f123-1e4e-4c3d-a4da-9481643925a6",
                                "sense_id": "4eefa14c-db6d-3376-86e3-fbc53d216798",
                                "text": "[…] on Sunday four more violinists, a second violist and a harpsichordist were added to give the ripieno sections of the fast movements a heftier punch than the smaller group delivered."
                            }
                        ]
                    }
