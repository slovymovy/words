                        "entry_id": "ebabc792-14f2-3bab-8e1b-a191d4dfde7e",
                        "glosses": [
                            "An act or an instance of kissing that involves the use of one's tongue."
                        ],
                        "tags": [
                            "Australia",
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "1124063e-75b6-4f45-a86e-d32cdc3aeae3",
                                "sense_id": "1bb89da5-2e71-3ee2-989f-89a735af051e",
                                "text": "Give me a kiss. No, open your mouth, I want a tonguey."
                            },
                            {
                                "example_id": "a95c875e-066e-4c48-b670-f0471f52c3b8",
                                "sense_id": "1bb89da5-2e71-3ee2-989f-89a735af051e",
                                "text": "He walked her to her house and received one last lingering Christmas tonguey under the mistletoe that hung above the door."
                            }
                        ]
                    }
