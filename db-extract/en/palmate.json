                "senses": [
                    {
                        "sense_id": "f9fe7c19-9715-32e9-b23b-4aa9dd963089",
                        "entry_id": "f258d1a3-503d-3469-bf87-5bbf068a6028",
                        "glosses": [
                            "Having three or more lobes or veins arising from a common point."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4acce106-c5bd-460c-ab4f-0a674b1803c4",
                                "sense_id": "f9fe7c19-9715-32e9-b23b-4aa9dd963089",
                                "text": "Although palmate leaves are typical of most Western maples, a number of species have leaves without lobes."
                            }
                        ]
                    },
                    {
                        "sense_id": "adb4b171-875e-3338-9e66-f3744a9b3f68",
                        "entry_id": "f258d1a3-503d-3469-bf87-5bbf068a6028",
                        "glosses": [
                            "Having more than three leaflets arising from a common point, often in the form of a fan."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "65835def-ecb7-4ed4-be98-be3ef6b3fe33",
                                "sense_id": "adb4b171-875e-3338-9e66-f3744a9b3f68",
                                "text": "The horse chestnut, buckeye and hickory trees have palmate leaves. That is, the broad oval leaflets are all set around the tip of a common leaf stem, spreading in a circle, like the ribs of a palm leaf fan."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a4bd66c-054a-3b1e-83bb-371cc98303b2",
                        "entry_id": "f258d1a3-503d-3469-bf87-5bbf068a6028",
                        "glosses": [
                            "Having webbed appendage; palmated."
                        ],
                        "tags": [
                            "not-comparable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3086aa45-fbc6-46b5-88ed-dbecb926e356",
                                "sense_id": "5a4bd66c-054a-3b1e-83bb-371cc98303b2",
                                "text": "The Palmate Newt is a common Western European amphibian."
                            }
                        ]
                    },
