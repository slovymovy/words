                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3969875-d95f-3ab3-a4b2-384ec00128dc",
                                        "entry_id": "2e8839e4-78b9-327e-a80e-263520ec6678",
                                        "glosses": [
                                            "Boisson codéinée à visée psychotrope, considérée comme une drogue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c78c793e-905c-4b64-bf11-6f23a14acf1a",
                                                "sense_id": "e3969875-d95f-3ab3-a4b2-384ec00128dc",
                                                "text": "J'mixe le lin dans l’Fanta shokata, pas d'concu c'est désert comme au Qatar"
