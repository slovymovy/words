                        ],
                        "form": "ceremonietjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a5e660d-5f57-3ca5-8fc9-a529d685107e",
                        "entry_id": "e68504cf-358a-333b-8526-8100bb2306a5",
                        "glosses": [
                            "een plechtige bijeenkomst om bijvoorbeeld iets te vieren, te herdenken of in te wijden, dan wel als religieus ritueel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e31e9fdf-3f82-470d-abf7-e981d9f324b0",
                                "sense_id": "7a5e660d-5f57-3ca5-8fc9-a529d685107e",
                                "text": "- Het vuur werd tijdens een feestelijke ceremonie op 21 april ontstoken bij de ruïnes in het Griekse stadje Olympia."
                            },
                            {
                                "example_id": "28bf5224-d7c2-4c0b-82f7-27356f05381f",
                                "sense_id": "7a5e660d-5f57-3ca5-8fc9-a529d685107e",
                                "text": "- De Duitse bondskanselier Angela Merkel en de Franse president François Hollande herdenken tijdens een ceremonie de slag bij Verdun, precies een eeuw geleden, in 1916. In de strijd om de Noord-Franse stad vielen tijdens de Eerste Wereldoorlog in 300 dagen tijd ruim 300.000 doden, zonder dat de strijdende partijen terreinwinst boekten."
                            },
                            {
                                "example_id": "64038d47-4be8-4826-9c61-5bf38163f00a",
                                "sense_id": "7a5e660d-5f57-3ca5-8fc9-a529d685107e",
                                "text": "- \"Een zweethut is een van oorsprong indiaans reinigingsritueel. Je kunt het vergelijken met een natuursauna\", vertelt Huib Beerda, die zweethutceremonies in de buurt van Nijmegen organiseert. „Al heeft het naast het fysieke ook een spiritueel element.” Bijna elk weekend is er wel ergens in Nederland een ceremonie te volgen (zoals die van ‘Helemaal Mona’ in Amsterdam, ‘Big Dipper’ bij Nijmegen of ‘Zilverlicht’ in het Gooi). Kosten: rond de 70 euro."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4162ebc7-7a73-4e2a-9bcf-a0b91950a4b3",
                        "source_entry_id": "e68504cf-358a-333b-8526-8100bb2306a5",
                        "source_sense_id": "7a5e660d-5f57-3ca5-8fc9-a529d685107e",
                        "source_sense_description": "een plechtige aangelegenheid",
                        "target_lang_word": "Zeremonie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeremonie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c5e610de-9c06-3a81-9b7a-410b45560ed0",
                                        "entry_id": "73c0b3ee-dc1c-3833-918d-df5738882367",
                                        "glosses": [
                                            "feierliche, rituelle Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8f1b353-9f38-4ba0-9019-21cf59660503",
                                                "sense_id": "c5e610de-9c06-3a81-9b7a-410b45560ed0",
                                                "text": "„Wenn man darüber nachdenkt, wie die Demokratie Zeremonien und Rituale entwickeln kann, die ihren Bürgern die Möglichkeit geben, sich mit ihr zu identifizieren, sollte eines nicht vergessen werden: Stil läßt sich schwerlich verordnen.“"
                                            },
                                            {
                                                "example_id": "40f72674-d120-4050-890c-76780e251e00",
                                                "sense_id": "c5e610de-9c06-3a81-9b7a-410b45560ed0",
                                                "text": "„Sie leiht sich einen anderen, verliert den Anschluss an den Leichenwagen, verfährt sich in der Stadt und kommt erst nach dem Ende der Zeremonie an.“"
                                            },
                                            {
                                                "example_id": "d17bbe0e-8d47-485f-bd2f-2c8b4a1db4cb",
                                                "sense_id": "c5e610de-9c06-3a81-9b7a-410b45560ed0",
                                                "text": "„Denn die geschlossene Badezimmertür signalisiert auch dem Partner, dass er während der Zeremonie nichts im Bad zu suchen hat.“"
                                            },
                                            {
                                                "example_id": "d5b42d6d-8b17-45b2-aeb0-ea7534e281b5",
                                                "sense_id": "c5e610de-9c06-3a81-9b7a-410b45560ed0",
                                                "text": "„In einer Zeremonie zerstören sie die Trophäen, brechen die Schwerter entzwei und zerschlagen die Schilde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edff6ee4-e9e4-46c0-a25a-8632b7f6b1f2",
                        "source_entry_id": "e68504cf-358a-333b-8526-8100bb2306a5",
                        "source_sense_id": "7a5e660d-5f57-3ca5-8fc9-a529d685107e",
                        "source_sense_description": "een plechtige aangelegenheid",
                        "target_lang_word": "ceremony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceremony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03c4d9e5-3e65-3690-844d-9f79d25ddb4c",
                                        "entry_id": "4ec2e67a-067b-31bc-b764-f50e0c273c7e",
                                        "glosses": [
                                            "A ritual, with religious or cultural significance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbdf40a0-ceec-46fc-9a16-440d97e646c4",
                                                "sense_id": "03c4d9e5-3e65-3690-844d-9f79d25ddb4c",
                                                "text": "To whom the Priest with naked armes full net\nApproching nigh, and murdrous knife well whet,\nGan mutter close a certaine secret charme,\nWith other diuelish ceremonies met:"
                                            },
                                            {
                                                "example_id": "f0aef294-73db-4712-b5d9-2dc8499b6935",
                                                "sense_id": "03c4d9e5-3e65-3690-844d-9f79d25ddb4c",
                                                "text": "In the fourteenth day of this month, at even, ye shall keep [the passover] in his appointed season: according to all the rites of it, and according to all the ceremonies thereof, shall ye keep it."
                                            },
                                            {
                                                "example_id": "639838ce-703b-400f-bcd8-ef61d237503d",
                                                "sense_id": "03c4d9e5-3e65-3690-844d-9f79d25ddb4c",
                                                "text": "Under certain circumstances there are few hours in life more agreeable than the hour dedicated to the ceremony known as afternoon tea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c7897cf-e0e9-3005-b1d0-f9056330acf8",
                                        "entry_id": "4ec2e67a-067b-31bc-b764-f50e0c273c7e",
                                        "glosses": [
                                            "An official gathering to celebrate, commemorate, or otherwise mark some event."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6c050af-06d2-4dde-8534-76fdd6aa3b34",
                                                "sense_id": "1c7897cf-e0e9-3005-b1d0-f9056330acf8",
                                                "text": "a graduation ceremony, an opening ceremony"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb506653-d0d3-33a3-8c05-29d0c04d8967",
                                        "entry_id": "4ec2e67a-067b-31bc-b764-f50e0c273c7e",
                                        "glosses": [
                                            "A formal socially established behaviour, often in relation to people of different ranks; formality."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f29fa82e-a18b-4a30-8ad2-7f91f14f983b",
                                                "sense_id": "cb506653-d0d3-33a3-8c05-29d0c04d8967",
                                                "text": "[…] to feed were best at home;\nFrom thence the sauce to meat is ceremony;\nMeeting were bare without it."
                                            },
                                            {
                                                "example_id": "2b26a942-b673-4881-ac09-377d04a4e3bb",
                                                "sense_id": "cb506653-d0d3-33a3-8c05-29d0c04d8967",
                                                "text": "Monsieur Bridet, notwithstanding his costume and his evident harrassment [sic], found in himself the presence of mind to remain the attentive manager, and with ceremony effected the proper introduction."
                                            },
                                            {
                                                "example_id": "0343120c-4da6-488c-b25b-43e914a80957",
                                                "sense_id": "cb506653-d0d3-33a3-8c05-29d0c04d8967",
                                                "text": "They went into the bars and interrupted the drinking, hustling the men out without ceremony."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fa5faa9-8f27-3f7f-8ee2-b4fbbb3960cc",
                                        "entry_id": "4ec2e67a-067b-31bc-b764-f50e0c273c7e",
                                        "glosses": [
                                            "Show of magnificence, display, ostentation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef994f1d-814e-4832-9275-4c1cf2a3419c",
                                                "sense_id": "3fa5faa9-8f27-3f7f-8ee2-b4fbbb3960cc",
                                                "text": "Meanwhile the winged Heralds, by command\nOf sovereign power, with awful ceremony\nAnd trumpet’s sound, throughout the host proclaim\nA solemn council forthwith to be held\nAt Pandemonium […]"
                                            },
                                            {
                                                "example_id": "bab8bed6-0902-4328-a5d7-2df89e8dc368",
                                                "sense_id": "3fa5faa9-8f27-3f7f-8ee2-b4fbbb3960cc",
                                                "text": "Immediately after her arrival, the queen rode forth to survey the camp and its environs: wherever she went, she was attended by a splendid retinue; and all the commanders vied with each other, in the pomp and ceremony with which they received her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e52fc324-9c17-3123-bab1-ec33a84975fc",
                                        "entry_id": "4ec2e67a-067b-31bc-b764-f50e0c273c7e",
                                        "glosses": [
                                            "An accessory or object associated with a ritual."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aad2a539-e54f-4469-8353-f6e44bcda962",
                                                "sense_id": "e52fc324-9c17-3123-bab1-ec33a84975fc",
                                                "text": "[…] his ceremonies laid by, in his nakedness he appears but a man […]"
                                            },
                                            {
                                                "example_id": "125565d4-ea04-4a05-bb86-40b5d54de735",
                                                "sense_id": "e52fc324-9c17-3123-bab1-ec33a84975fc",
                                                "text": "[…] Well, believe this,\nNo ceremony that to great ones ’longs,\nNot the king’s crown, nor the deputed sword,\nThe marshal’s truncheon, nor the judge’s robe,\nBecome them with one half so good a grace\nAs mercy does."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51cf7fe1-7126-342c-9b81-cd63e8eec389",
                                        "entry_id": "4ec2e67a-067b-31bc-b764-f50e0c273c7e",
                                        "glosses": [
                                            "An omen or portent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6067495d-2386-4f3e-8d3a-2167a135f229",
                                                "sense_id": "51cf7fe1-7126-342c-9b81-cd63e8eec389",
                                                "text": "For he is superstitious grown of late,\nQuite from the main opinion he held once\nOf fantasy, of dreams, and ceremonies."
                                            },
                                            {
                                                "example_id": "0dec94c7-6157-4c4a-8018-3fad3f560d93",
                                                "sense_id": "51cf7fe1-7126-342c-9b81-cd63e8eec389",
                                                "text": "Caesar, I never stood on ceremonies,\nYet now they fright me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c66d8b9-681a-4d67-b48f-049c031acd85",
                        "source_entry_id": "e68504cf-358a-333b-8526-8100bb2306a5",
                        "source_sense_id": "7a5e660d-5f57-3ca5-8fc9-a529d685107e",
                        "source_sense_description": "een plechtige aangelegenheid",
                        "target_lang_word": "cérémonie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cérémonie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4741265e-ca48-3486-9211-aa010654fb13",
                                        "entry_id": "7bc9c7a5-47df-3aee-a8ec-c2300f539a80",
                                        "glosses": [
                                            "Ensemble des formes extérieures et régulières du culte religieux, des célébrations mystiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81ff4cef-7858-48f1-9ce3-80732636e974",
                                                "sense_id": "4741265e-ca48-3486-9211-aa010654fb13",
                                                "text": "L’encens, qui était une gomme résineuse, était exclusivement réservé aux cérémonies religieuses."
                                            },
                                            {
                                                "example_id": "33b0be99-c60f-4b74-ac11-31cecbaf6246",
                                                "sense_id": "4741265e-ca48-3486-9211-aa010654fb13",
                                                "text": "Le rihan (Myrtus communis) produit des baies comestibles; ses feuilles servent en médecine et dans les cérémonies religieuses juives."
                                            },
                                            {
                                                "example_id": "c8d69f3d-d229-42bd-8ba0-a7d177c3e6be",
                                                "sense_id": "4741265e-ca48-3486-9211-aa010654fb13",
                                                "text": "L’ordre des cérémonies."
                                            },
                                            {
                                                "example_id": "8ae50f13-45b9-4d9b-81ec-6e50d2ce85ac",
                                                "sense_id": "4741265e-ca48-3486-9211-aa010654fb13",
                                                "text": "Cérémonie funèbre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24834d30-4abd-3f33-9556-0f37b2db870f",
                                        "entry_id": "7bc9c7a5-47df-3aee-a8ec-c2300f539a80",
                                        "glosses": [
                                            "Formalités qu’on observe dans les actions solennelles pour les rendre plus éclatantes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce51a4f5-d12f-4e34-aea1-556636f691e2",
                                                "sense_id": "24834d30-4abd-3f33-9556-0f37b2db870f",
                                                "text": "C’est pour cela, assurait-il, que l’usage s’était introduit dans certaines villes du Midi qu’aux trois fêtes précitées, les chefs de la communauté juive soient giflés publiquement, au cours d’une cérémonie solennelle, par le seigneur du lieu. […]. Cette cérémonie portait le nom de colophisation."
                                            },
                                            {
                                                "example_id": "9702494d-3b2a-4b1c-981e-84fb425fb5bc",
                                                "sense_id": "24834d30-4abd-3f33-9556-0f37b2db870f",
                                                "text": "Avec Gasbieha, elle passa des heures à confectionner une robe de cérémonie pour son amie."
                                            },
                                            {
                                                "example_id": "44cba16a-a5ec-43ea-b730-e6195d5a238e",
                                                "sense_id": "24834d30-4abd-3f33-9556-0f37b2db870f",
                                                "text": "Ce fut en l’année 566 que la cérémonie des noces eut lieu, avec un grand appareil, dans la ville royale de Metz."
                                            },
                                            {
                                                "example_id": "cf673eef-2c30-468b-81a1-ad1d1d8fd9ad",
                                                "sense_id": "24834d30-4abd-3f33-9556-0f37b2db870f",
                                                "text": "La salle des fêtes était habillée pour une grande cérémonie, de somptueux rideaux blancs et pourpres qui tombaient du haut plafond jusqu’au bas des portes et des fenêtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e302d5c2-6c19-3907-abdc-64a8b84c7eb0",
                                        "entry_id": "7bc9c7a5-47df-3aee-a8ec-c2300f539a80",
                                        "glosses": [
                                            "Actes de civilité, témoignages convenus de déférence que les particuliers se donnent les uns aux autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "584f4108-763e-4c3a-9325-b62d02880ca2",
                                                "sense_id": "e302d5c2-6c19-3907-abdc-64a8b84c7eb0",
                                                "text": "Faire des visites de cérémonie."
                                            },
                                            {
                                                "example_id": "52bf173b-fb63-48df-a09b-92ce59cc93b8",
                                                "sense_id": "e302d5c2-6c19-3907-abdc-64a8b84c7eb0",
                                                "text": "Reconduire quelqu’un en cérémonie."
                                            },
                                            {
                                                "example_id": "44a69a63-1d87-44ad-854f-14aadd582964",
                                                "sense_id": "e302d5c2-6c19-3907-abdc-64a8b84c7eb0",
                                                "text": "Bannir la cérémonie."
                                            },
                                            {
                                                "example_id": "b7021555-7bcb-48e8-b7c7-a3db85301cab",
                                                "sense_id": "e302d5c2-6c19-3907-abdc-64a8b84c7eb0",
                                                "text": "Une visite ! Il faut faire de la cérémonie."
                                            },
                                            {
                                                "example_id": "4e703cc9-454d-4a4f-8989-dd9409d6c0a0",
                                                "sense_id": "e302d5c2-6c19-3907-abdc-64a8b84c7eb0",
                                                "text": "Ne faisons point de cérémonies."
                                            },
                                            {
                                                "example_id": "92f8beb7-3229-4c4b-ad2e-6b3fbdcba39d",
                                                "sense_id": "e302d5c2-6c19-3907-abdc-64a8b84c7eb0",
                                                "text": "Il est ennemi des cérémonies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cda21e5d-47a7-3bfe-bb1c-745147014405",
                                        "entry_id": "7bc9c7a5-47df-3aee-a8ec-c2300f539a80",
                                        "glosses": [
                                            "Forme, pharisianisme."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "423fefe7-95ee-4995-8b4d-0d62e448a9ac",
                                                "sense_id": "cda21e5d-47a7-3bfe-bb1c-745147014405",
                                                "text": "Faire une chose par cérémonie, faire une chose pour la forme."
                                            },
                                            {
                                                "example_id": "25a7ba74-d4bb-47a5-909a-17245ba07587",
                                                "sense_id": "cda21e5d-47a7-3bfe-bb1c-745147014405",
                                                "text": "Il paraît écouter vos conseils avec déférence, mais ce qu’il en fait c’est par pure cérémonie,"
                                            },
                                            {
                                                "example_id": "a86fa562-52c5-4b6d-b387-19d63f544c24",
                                                "sense_id": "cda21e5d-47a7-3bfe-bb1c-745147014405",
                                                "text": "C’est pure cérémonie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "203cc568-216d-34c9-adab-a89a849ef490",
                                        "entry_id": "7bc9c7a5-47df-3aee-a8ec-c2300f539a80",
                                        "glosses": [
                                            "Civilité gênante, importune."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47e45ba3-b08f-4192-aee8-386e7f6f70c6",
                                                "sense_id": "203cc568-216d-34c9-adab-a89a849ef490",
                                                "text": "Sans cérémonie, point de cérémonie, librement, sans contrainte, sans façons."
                                            },
                                            {
                                                "example_id": "bd3e09bf-1f40-40d9-9249-08d1e2822a03",
                                                "sense_id": "203cc568-216d-34c9-adab-a89a849ef490",
                                                "text": "Assez de cérémonies !"
                                            },
                                            {
                                                "example_id": "5fe27af3-5c7c-4bfc-bed6-c51b7f9426f9",
                                                "sense_id": "203cc568-216d-34c9-adab-a89a849ef490",
                                                "text": "Faire des cérémonies, faire des façons, des difficultés avant de consentir ou de se résoudre à quelque chose."
                                            },
                                            {
                                                "example_id": "b59be11d-7935-4f8c-8804-a9ef741889df",
                                                "sense_id": "203cc568-216d-34c9-adab-a89a849ef490",
                                                "text": "Il a fait bien des cérémonies pour en arriver là."
                                            },
                                            {
                                                "example_id": "82d59e09-a432-4e93-89fd-f9cca1da0658",
                                                "sense_id": "203cc568-216d-34c9-adab-a89a849ef490",
                                                "text": "Ses paquets déposés dans la salle, le petit homme prit lui-même sa valise et la garda près de lui, en s’asseyant sans cérémonie à table devant les deux sous-aides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
