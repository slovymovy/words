                "senses": [
                    {
                        "sense_id": "faf74c3c-919e-3b66-bd1c-f069a882c16c",
                        "entry_id": "70b831e2-221d-3ad9-be3f-3409514a4b22",
                        "glosses": [
                            "Flugzeug, bei dem ein Propeller für den Vortrieb sorgt; das über einen Propellerantrieb verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbadc38e-9ac8-4529-8344-693ba837af52",
                                "sense_id": "faf74c3c-919e-3b66-bd1c-f069a882c16c",
                                "text": "„Nach Angaben des Unternehmens hatte sich bei dem Propellerflugzeug vom Typ Bombardier Q400 ein weniger als ein Quadratmeter großes Stück der Verkleidung des linken Triebwerks gelöst.“"
                            },
                            {
                                "example_id": "1ab1ce47-1a4c-474b-a519-000687d394eb",
                                "sense_id": "faf74c3c-919e-3b66-bd1c-f069a882c16c",
                                "text": "„Der Ventilator hing nicht von der Decke, sondern an der Wand, als wäre ein Propellerflugzeug ins Haus gebrochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c8274be-76d7-4482-ab9b-ff6457448cc9",
                        "source_entry_id": "70b831e2-221d-3ad9-be3f-3409514a4b22",
                        "source_sense_id": "faf74c3c-919e-3b66-bd1c-f069a882c16c",
