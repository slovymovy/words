                                        "sense_id": "ac3fcca8-b755-348a-a274-6add1bce6e09",
                                        "entry_id": "266fd899-9aad-366a-8639-37b2d2d0b534",
                                        "glosses": [
                                            "lid van een Indo-Europees volk waarvan na de Romeinse tijd de meeste leden op de Britse eilanden en in Bretagne leven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "340095b1-16b5-41b7-b81f-2b3d17df144c",
                                                "sense_id": "ac3fcca8-b755-348a-a274-6add1bce6e09",
