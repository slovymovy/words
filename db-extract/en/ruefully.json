                        "source_sense_id": "6f2ebf48-72b3-3b01-b45a-1ae81f00eb03",
                        "source_sense_description": "in a rueful manner; causing, feeling or expressing regret or sorrow",
                        "target_lang_word": "печально",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
