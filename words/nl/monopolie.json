                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "monopolize",
                                "target_lang_sense_clarification": "imperative form"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5caabf19-bced-340a-8d38-11f815a30e5a",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>monopoliën</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Monopolie</w> je nu alweer de hele discussie?",
                            "target_lang_translations": {
                                "en": "Are you <w>monopolizing</w> the entire discussion again?"
                            }
                        },
                        {
                            "text": "Waarom <w>monopolie</w> je die middelen in plaats van ze te delen?",
                            "target_lang_translations": {
                                "en": "Why do you <w>monopolize</w> those resources instead of sharing them?"
                            }
