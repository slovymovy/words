                            {
                                "example_id": "c1648355-9e2b-40e2-9ff7-4b196b67b2ba",
                                "sense_id": "bbeb0df7-be6f-3307-819a-ec76d4e3a7f9",
                                "text": "De jongens konden gaan en staan waar ze wilden, blijkt dan. Zo kochten ze bivakmutsen in een dumpzaak, om een overval te plegen. Het kassabonnetje zit in het dossier."
                            },
                            {
                                "example_id": "6185a74d-5008-4cbd-a78f-b56fc11743c1",
                                "sense_id": "bbeb0df7-be6f-3307-819a-ec76d4e3a7f9",
                                "text": "De firma Karsten begon als dumpzaak aan huis, onder leiding van de broers Piet en Gerard Karsten. Ze verkochten alles wat los en vast zat, en langzaam rolden de twee de kampeerbranche binnen."
                            }
