                    },
                    {
                        "translation_id": "51cd1820-14eb-4611-99d7-42a446f1dd2b",
                        "source_entry_id": "83e9821e-fb4a-336c-a2ff-b53cb6def19f",
                        "source_sense_id": "bc73d3fe-aca5-325e-ad54-e4370a5459d9",
                        "target_lang_word": "Schneepflug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneepflug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "251b917e-5a78-308f-925b-6593b0e0e93d",
                                        "entry_id": "4b9d4903-51a5-3b47-9530-3e2b4962045f",
                                        "glosses": [
                                            "Gerät zum Entfernen des Schnees von Straßen, entweder motorisiert oder von Tieren gezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "373022ae-92e1-4b6d-ae0a-10cc97b1a137",
                                                "sense_id": "251b917e-5a78-308f-925b-6593b0e0e93d",
                                                "text": "In diesem Winter waren Schneepflüge noch wichtiger als früher."
                                            },
                                            {
                                                "example_id": "e0a7c2b7-8361-4d3c-b3b8-4812172110a1",
                                                "sense_id": "251b917e-5a78-308f-925b-6593b0e0e93d",
                                                "text": "„Wir werden auf unserem Drehkreis immer näher an das andere Boot herangetragen, schon treffen die Wellenberge, die von unserem Bug wie von einem Schneepflug zur Seite geworfen werden, mit taumelnden Dwarsseen zusammen, Wasserfetzen schießen senkrecht hoch, wie aus einem Geysir geschleudert.“"
                                            },
                                            {
                                                "example_id": "05627e92-f113-4a7a-989c-1970fc3ec8fb",
                                                "sense_id": "251b917e-5a78-308f-925b-6593b0e0e93d",
                                                "text": "„Mit zwei Schneepflügen, einem Radlader und einer Seilwinde bahnten sich die Einsatzkräfte einen Weg zu dem auf rund 1.300 Meter Seehöhe gelegenen Kloster.“"
                                            },
                                            {
                                                "example_id": "cc1edd84-d317-4c74-8d1e-c2d170afd408",
                                                "sense_id": "251b917e-5a78-308f-925b-6593b0e0e93d",
                                                "text": "„Die Scheune, in der das Brennholz bis zum Dach aufgestapelt war (wir verbrauchten fünfzehn bis zwanzig Klafter in einem Winter), konnte ich direkt durch die Küche erreichen, ich heizte die Öfen, wir hatten Vorräte im Haus und fanden uns damit ab, von der Welt abgeschnitten zu sein, bis der Schneepflug der Farmgemeinde durchkommen und unseren Weg freimachen würde.“"
                                            },
                                            {
                                                "example_id": "cb98cf09-50ca-4c17-a592-a7558df5ff0f",
                                                "sense_id": "251b917e-5a78-308f-925b-6593b0e0e93d",
                                                "text": "„Der Schneepflug wich zur Seite, und der Wagen Clerfayts glitt an ihm vorbei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6028c420-5a1b-4777-af2c-6e9c1cfc2e46",
                        "source_entry_id": "83e9821e-fb4a-336c-a2ff-b53cb6def19f",
                        "source_sense_id": "bc73d3fe-aca5-325e-ad54-e4370a5459d9",
