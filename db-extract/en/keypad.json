                    {
                        "sense_id": "fa45876d-bf2a-3058-9ac9-658584ace0cc",
                        "entry_id": "319f160c-a71e-3703-8612-2f0889fc3bc6",
                        "glosses": [
                            "A small board with keys primarily used for tactile input into a machine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45ad3992-cd4b-4642-a9c4-e45fd9b7050e",
                                "sense_id": "fa45876d-bf2a-3058-9ac9-658584ace0cc",
                                "text": "Many laptop computers have special function keys which turn part of the alphabetical keyboard into a numeric keypad."
                            },
                            {
                                "example_id": "6250b804-2154-4e74-beec-43fa72b583c9",
                                "sense_id": "fa45876d-bf2a-3058-9ac9-658584ace0cc",
                                "text": "He pulled a picture frame to one side, revealing a safe behind. Chang pressed four buttons on the keypad… …and the safe door whirred open."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7e145f5-3ce4-4eb5-b214-e648b9fced69",
                        "source_entry_id": "319f160c-a71e-3703-8612-2f0889fc3bc6",
                        "source_sense_id": "fa45876d-bf2a-3058-9ac9-658584ace0cc",
