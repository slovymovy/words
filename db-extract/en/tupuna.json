                    {
                        "sense_id": "b3c0141a-8504-3372-a8f7-604ef04deb0e",
                        "entry_id": "bdb9c714-2c2d-336f-9124-8b79d4c344f5",
                        "glosses": [
                            "An ancestor, especially a grandparent, in Maori culture."
                        ],
                        "tags": [
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "09b3b972-6a52-4bc6-8b2f-85e2cda9f247",
                                "sense_id": "b3c0141a-8504-3372-a8f7-604ef04deb0e",
                                "text": "We have carved the journeys of the adventures of our tūpuna, who were true navigators—venturing into the unknown—sailing towards the sun."
                            },
                            {
                                "example_id": "14cd5f67-b168-4306-b14b-2fb3639bd2ba",
                                "sense_id": "b3c0141a-8504-3372-a8f7-604ef04deb0e",
                                "text": "[…] tupunas are there, beside us, in the rain, and when the sun comes busting out."
                            },
                            {
                                "example_id": "1740137e-a1fe-43e1-b9bc-3a2b19423d44",
                                "sense_id": "b3c0141a-8504-3372-a8f7-604ef04deb0e",
                                "text": "The existence of our wairua in this realm allows us to connect with our tūpuna in the spirit world. The spiritual connection to our tūpuna also exists in certain portals of communication with them."
                            }
                        ]
                    }
