                "senses": [
                    {
                        "sense_id": "e1cf7b19-06bc-3141-b474-a3fa92d4e255",
                        "entry_id": "f8254725-7f71-39ec-a88d-5d2ece5ce78c",
                        "glosses": [
                            "Schmerz(en) im Leib"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "11d65b90-7a13-4187-b9b3-3ddb2f8f9e47",
                                "sense_id": "e1cf7b19-06bc-3141-b474-a3fa92d4e255",
                                "text": "„Wir haben uns alle am nämlichen Tische krank gegessen und haben Leibgrimmen; was haltet ihr euch die Servietten vor das Gesicht?“"
                            },
                            {
                                "example_id": "d15aa832-81d1-455f-8da1-2a85078b448a",
                                "sense_id": "e1cf7b19-06bc-3141-b474-a3fa92d4e255",
                                "text": "„Zu meiden sind natürlich zugige Abtritte, besonders von Hämorrhoidarien, Menstruirenden, zu Leibgrimmen und Durchfall Geneigten.“"
                            },
                            {
                                "example_id": "5998db5b-32e2-4f5b-93fd-55b5011c38fa",
                                "sense_id": "e1cf7b19-06bc-3141-b474-a3fa92d4e255",
                                "text": "„Leibgrimmen, Ausspucken, Schütteln, Schmerz, Aufstossen, Schwindel, Ekel vor Speisen, Röthe der Augen und Abmagerung können entstehen, wenn diese Krankheit von Würmern herrührt.“"
                            },
                            {
                                "example_id": "8e6fa369-4ca6-4351-a893-f8ba2547e290",
                                "sense_id": "e1cf7b19-06bc-3141-b474-a3fa92d4e255",
                                "text": "„Ich hatte davon gegessen, und sie schmeckten süß, aber hinterher kam das Leibgrimmen.“"
                            },
                            {
                                "example_id": "cf568f73-1632-4205-85bb-2c00e97772fa",
                                "sense_id": "e1cf7b19-06bc-3141-b474-a3fa92d4e255",
                                "text": "„Der Patientin war die Schwefelleber nicht mehr beizubringen, auch hatte sie nach jeder Dosis Leibgrimmen bekommen.“"
                            },
                            {
                                "example_id": "bbfd9dcb-89f6-4277-8f22-3b13d2c50494",
                                "sense_id": "e1cf7b19-06bc-3141-b474-a3fa92d4e255",
                                "text": "„Ist Diarrhoe vorhanden und Leibgrimmen, so müssen die Getränke schleimig und lauwarm sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
