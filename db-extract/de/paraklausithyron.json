                        "entry_id": "3666f1ee-f210-3d85-ba6c-6b0e4bf6ca72",
                        "glosses": [
                            "Klagelied, in dem ein Liebender vor einer geschlossenen Tür (oder anderem scheinbar unüberwindbarem Hindernis) seiner Geliebten steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bbcab33-49a7-467d-b906-7a940f73e5b9",
                                "sense_id": "c027cc04-f638-37b0-9b3d-57477c45120d",
                                "text": "Durch Pyramus' und Thisbes Liebesgeschichte zieht sich das Phänomen des Paraklausithyrons."
                            },
                            {
                                "example_id": "9ed9a0b2-a267-4b36-a506-8802a3283054",
                                "sense_id": "c027cc04-f638-37b0-9b3d-57477c45120d",
                                "text": "„Damit stehen die Heroides in der Grundsituation elegischer Liebe, der Situation des exclusus amator, sie sind gleichsam mythologische Paraklausithyra.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
