                        "glosses": [
                            "Méthaniseur industriel."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "584740ad-5af8-4eaf-a88c-67da2e6f601b",
                                "sense_id": "e15eb2b8-47f3-3b3c-b9d5-9e2000467e1a",
                                "text": "Le méthanisateur fournit de l'électricité principalement à partir du fumier et du lisier récoltés dans les exploitations agricoles ; il peut être alimenté par la culture de certaines céréales comme le maïs ; la loi française impose un quota de moins 15% de culture pouvant l'approvisionner."
                            },
                            {
                                "example_id": "b0cf1000-fe2e-4697-bf51-2f1e3baeadd5",
                                "sense_id": "e15eb2b8-47f3-3b3c-b9d5-9e2000467e1a",
                                "text": "La spécificité de MER est sa nature portuaire, mais aussi le fait d'aller sur tous les flux possibles : énergie, eau, déchets, services, et même un projet de méthanisateur."
                            },
                            {
                                "example_id": "fde3f6b5-80ff-4369-bd4a-6de7c650c74a",
                                "sense_id": "e15eb2b8-47f3-3b3c-b9d5-9e2000467e1a",
                                "text": "Les déchets organiques peuvent aussi produire du biogaz. La France va installer une trentaine de « méthanisateurs »."
                            }
                        ]
                    }
