                "senses": [
                    {
                        "sense_id": "d180f45c-0b00-3345-9abd-cdb9821679d2",
                        "entry_id": "3d1c84db-1a2b-3a37-934a-faf9bfc8b366",
                        "glosses": [
                            "разнообразно составленный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d287efef-bf7e-4170-9694-938294ebccff",
                                "sense_id": "d180f45c-0b00-3345-9abd-cdb9821679d2",
                                "text": "Интерсертальный калиевый полевой шпат обнаруживает неправильно-пятнистое полисинтетическое двойнникование."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82904432-edda-4235-8dc4-6932cf1b21ac",
                        "source_entry_id": "3d1c84db-1a2b-3a37-934a-faf9bfc8b366",
                        "source_sense_id": "d180f45c-0b00-3345-9abd-cdb9821679d2",
                        "target_lang_word": "polysynthetisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polysynthetisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bef0aa64-99ca-3b43-86bc-55dc49b9ff42",
                                        "entry_id": "2eb4ec44-3ecc-3809-ae92-b15b96ace945",
                                        "glosses": [
                                            "Eigenschaft von polysynthetischen Sprachen, die darin besteht, dass sie hochkomplexe Wörter aufweisen, wobei ein bestimmtes Lexem mit einer Reihe gebundener grammatischer und lexikalischer Morpheme angereichert wird. Oft können in diesen Sprachen Subjekt und Objekt im Verb integriert (inkorporiert) werden und dann im äußersten Fall Einwortsätze bilden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "985e8689-6d0b-4d8a-aaa7-145533b6d78e",
                                                "sense_id": "bef0aa64-99ca-3b43-86bc-55dc49b9ff42",
                                                "text": "Einen polysynthetischen Sprachbau haben Indianersprachen und das Eskimo."
                                            },
                                            {
                                                "example_id": "3c2ba8a5-bbaa-4e4b-baa3-d7de358a043a",
                                                "sense_id": "bef0aa64-99ca-3b43-86bc-55dc49b9ff42",
                                                "text": "Einverleibend und inkorporierend werden leicht mit polysynthetisch gleichgesetzt, meinen aber verschiedene morphologische Erscheinungen, die allerdings auch gleichzeitig auftreten können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
