                        ],
                        "form": "die Nacharbeit"
                    },
                    {
                        "form_id": "7ee75e34-a9a5-4020-a5a0-88f53d43544c",
                        "entry_id": "6e1a897e-0e28-342e-8737-8814ddef8901",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nacharbeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "898c6f21-e76a-3017-b8a2-63920f0d9457",
                        "entry_id": "6e1a897e-0e28-342e-8737-8814ddef8901",
                        "glosses": [
                            "Ausgleich für nicht erfolgte Tätigkeiten"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3c34b248-3bf7-3f14-81b8-c73f6b87f30d",
                        "entry_id": "6e1a897e-0e28-342e-8737-8814ddef8901",
                        "glosses": [
                            "Ausgleich für nicht erfolgte Tätigkeiten",
                            "im Einzelfall verordneter Aufenthalt am Nachmittag in der Schule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06810be5-628d-4207-b289-19fc846c181c",
                                "sense_id": "3c34b248-3bf7-3f14-81b8-c73f6b87f30d",
                                "text": "„Nachsitzen, Silentium oder Nacharbeit ist je nach Bundesland eine Erziehungs- oder Ordnungsmaßnahme, die gegen einen Schüler verhängt wird, beispielsweise wegen schlechten Betragens oder vergleichbarer schulischer Vergehen.“"
                            },
                            {
                                "example_id": "16cd3907-1fd3-478f-a8e1-c6145c789e3b",
                                "sense_id": "3c34b248-3bf7-3f14-81b8-c73f6b87f30d",
                                "text": "„Als Erziehungsmaßnahmen gelten vergleichsweise milde Reaktionen wie Ermahnungen, Zusatzaufgaben, Eintrag ins Klassenbuch, Nacharbeit am Nachmittag, Auszeiten in einem beaufsichtigten Raum, Hinweis an die Eltern.“"
                            },
                            {
                                "example_id": "ebceebde-a333-4cfb-9943-2f04537274a3",
                                "sense_id": "3c34b248-3bf7-3f14-81b8-c73f6b87f30d",
                                "text": "„Wer die Hausaufgabe nun zum dritten Mal nicht vorweisen kann, bleibt an einem festgelegten Nachmittag etwas länger in der Schule – zur sogenannten Nacharbeit.“"
                            },
                            {
                                "example_id": "b7e31338-eacd-4537-ba69-656895dd516f",
                                "sense_id": "3c34b248-3bf7-3f14-81b8-c73f6b87f30d",
                                "text": "„Eine Nacharbeit von verpassten Inhalten unter Aufsicht nach vorheriger Benachrichtigung der Eltern kann den Schülerinnnen ebenfalls auferlegt werden.“"
                            },
                            {
                                "example_id": "38d81c75-29a1-447e-ab2d-36cc34aa5d9d",
                                "sense_id": "3c34b248-3bf7-3f14-81b8-c73f6b87f30d",
                                "text": "„Schon nach wenigen Wochen hat das Mädchen wiederholt seine Hausaufgaben nicht erledigt und wird von Ihnen an einem Nachmittag zur Nacharbeit bestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "f27166b7-be2e-3f66-88e1-8eeba8efc621",
                        "entry_id": "6e1a897e-0e28-342e-8737-8814ddef8901",
                        "glosses": [
                            "Ausgleich für nicht erfolgte Tätigkeiten",
                            "nachträgliche Arbeitsleistung als Ersatz für entfallene solche (z. B. im Rahmen der Altersteilzeitregelung in Deutschland)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "320641c1-56dc-4235-a845-5677c07620e3",
                                "sense_id": "f27166b7-be2e-3f66-88e1-8eeba8efc621",
                                "text": "„Der Arbeitnehmer kann also durch Nacharbeit das Wertguthaben wieder aufbauen.“"
                            },
                            {
                                "example_id": "3d17446b-bba2-4184-96b4-a31a510f5c61",
                                "sense_id": "f27166b7-be2e-3f66-88e1-8eeba8efc621",
                                "text": "„Alternativ kann der Arbeitgeber auch auf die Nacharbeit verzichten und das Wertguthaben entsprechend erhöhen.“"
                            },
                            {
                                "example_id": "a268e2ac-dfac-401f-be9c-0cc959b2fb8c",
                                "sense_id": "f27166b7-be2e-3f66-88e1-8eeba8efc621",
                                "text": "„Wegen der vereinbarten Nacharbeit muss der Arbeitnehmer das fehlende Wertguthaben erarbeiten. Die Nacharbeit ist unmittelbar nach der Arbeitsphase zu leisten.“"
                            },
                            {
                                "example_id": "1ee6ab01-f255-42b0-b731-4343371a290b",
                                "sense_id": "f27166b7-be2e-3f66-88e1-8eeba8efc621",
                                "text": "„Für Ausfallzeiten in der Arbeitsphase, für die ein Anspruch auf Kurzarbeitergeld oder Winterausfallgeld besteht, ist der Arbeitnehmer nicht zur Nacharbeit verpflichtet.“"
                            },
                            {
                                "example_id": "44d6e0af-06a7-4988-9527-70f8012ed9b5",
                                "sense_id": "f27166b7-be2e-3f66-88e1-8eeba8efc621",
                                "text": "„Die Nacharbeit wird sich in der Mehrzahl der Fälle als unpraktikabel erweisen, sei es dass der Arbeitsplatz in der Freistellungsphase bereits wieder besetzt ist, sei es, dass er entfallen ist, sei es dass der Arbeitnehmer zu einer Nacharbeit nicht motiviert ist und den Betrieb im Zweifel nur stört.“"
                            },
                            {
                                "example_id": "c59b8762-5788-4bd9-acee-dfe72446d009",
                                "sense_id": "f27166b7-be2e-3f66-88e1-8eeba8efc621",
                                "text": "„Ist auf Ihr Arbeitsverhältnis ein Tarifvertrag anwendbar, überprüfen Sie, ob Sie hierdurch zur Nacharbeit der ausgefallenen Arbeit verpflichtet sind; das ist üblich.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "00fc047e-7296-345d-845c-beedc00d2d29",
                        "entry_id": "6e1a897e-0e28-342e-8737-8814ddef8901",
                        "glosses": [
                            "notwendiger Abschluss von Tätigkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89ceeeb1-1216-4a5f-b194-644c53cc6af1",
                                "sense_id": "00fc047e-7296-345d-845c-beedc00d2d29",
                                "text": "„Der vom Vermieter dem Mieter im Rahmen der §§ 3 Abs 1 und 3, 8 Abs 3 MRG zu ersetzende Aufwand für Vor‐ und Nacharbeiten umfasst auch das nach Art und Umfang der aufgetragenen Erhaltungsarbeiten notwendige Entfernen der Fahrnisse aus dem Objekt und deren nachfolgende Wiedereinbringung.“"
                            },
                            {
                                "example_id": "1b7c68ee-1d3d-475a-8e43-51768277af76",
                                "sense_id": "00fc047e-7296-345d-845c-beedc00d2d29",
                                "text": "„Voraussetzung sei allerdings, dass es eine entsprechende Regelung im Arbeitsvertrag gibt und die Nacharbeit in einem angemessenen Verhältnis zur Arbeitszeit steht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "38f2c4e7-ae6a-3d12-96cc-70ad4ec6ec81",
                        "entry_id": "6e1a897e-0e28-342e-8737-8814ddef8901",
                        "glosses": [
                            "notwendiger Abschluss von Tätigkeiten",
                            "abschließende Fertigungsschritte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "308cde56-5082-4495-ab2e-e2dd62c295c7",
                                "sense_id": "38f2c4e7-ae6a-3d12-96cc-70ad4ec6ec81",
                                "text": "„So werden aktuell mit Hilfe von künstlicher Intelligenz und maschinellem Lernen Lösungen erprobt, um die hohe manuelle Nacharbeit bei der automatischen Rechnungsprüfung zu verringern.“"
                            },
                            {
                                "example_id": "97574615-d52e-40ed-ae32-4c66adce1dca",
                                "sense_id": "38f2c4e7-ae6a-3d12-96cc-70ad4ec6ec81",
                                "text": "„Einbezogen sind hier neben den Arbeits- auch Rüst- und Kontrollzeiten sowie Nacharbeit.“"
                            },
                            {
                                "example_id": "4461eae2-53f2-41d7-9f54-951595661af4",
                                "sense_id": "38f2c4e7-ae6a-3d12-96cc-70ad4ec6ec81",
                                "text": "„Neben der allgemeinen Qualitätssicherung, die sich um kleinere Nacharbeiten kümmert, gibt es auch noch die Qualitätssicherung der Fachbereiche.“"
                            },
                            {
                                "example_id": "9af32ca4-307d-4ca6-852f-3d8f5905bb30",
                                "sense_id": "38f2c4e7-ae6a-3d12-96cc-70ad4ec6ec81",
                                "text": "„Zur Nahrungszubereitung werden im allgemeinen die Vor- und Zubereitung von kalten und warmen Speisen, von Backwaren sowie von Getränken gezählt. Ferner umfaßt dieser Bereich Vor- und Nacharbeiten wie etwa den den Tisch decken und abdecken, die Mahlzeiten anrichten und auftragen sowie die Vorratshaltung.“"
                            },
                            {
                                "example_id": "09114357-93ea-41dd-b4bb-c7856b5ebf20",
                                "sense_id": "38f2c4e7-ae6a-3d12-96cc-70ad4ec6ec81",
                                "text": "„Problematisch sind für den Verfassungsrechtler auch die ständigen Nacharbeiten an der Verfassung, die diese entwerten.“"
                            },
                            {
                                "example_id": "d435d0f6-1627-401a-b200-e22c426f5f89",
                                "sense_id": "38f2c4e7-ae6a-3d12-96cc-70ad4ec6ec81",
                                "text": "„Später, dank der Nacharbeit von Mitarbeitern, werden es neun Punkte sein.“"
                            },
                            {
                                "example_id": "f42e6376-e885-44bf-829b-f1ff502ee97f",
                                "sense_id": "38f2c4e7-ae6a-3d12-96cc-70ad4ec6ec81",
                                "text": "„Wird die Genauigkeit der Vorarbeit übertrieben, so wachsen ihre Kosten, ohne daß deshalb die Nacharbeit billiger wird; die Ausgaben für die Herstellung der Passung nehmen zu.“"
                            }
                        ],
                        "sense_index_json": "\"2a\""
                    },
                    {
                        "sense_id": "e8ecbfd6-93bf-33a1-8fc1-54137f1fae7f",
                        "entry_id": "6e1a897e-0e28-342e-8737-8814ddef8901",
                        "glosses": [
                            "notwendiger Abschluss von Tätigkeiten",
                            "abschließende Aufarbeitung eines Projektes oder einer Veranstaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fd65b95-b5de-4391-8574-02bf6e5ff8f8",
                                "sense_id": "e8ecbfd6-93bf-33a1-8fc1-54137f1fae7f",
                                "text": "„Zum anderen hätte eine sofortige Nacharbeit im Rahmen der Mitarbeiterveranstaltung aufgrund der hohen Teilnehmerzahl einen beträchtlichen zeitlichen und finanziellen Aufwand bedeutet.“"
                            },
                            {
                                "example_id": "ef028e10-6ce6-4cda-86e2-0a938df6b18b",
                                "sense_id": "e8ecbfd6-93bf-33a1-8fc1-54137f1fae7f",
                                "text": "„An eine biologische Exkursion mit darauffolgender Nacharbeit im Klassenzimmer schlossen wir zwei Einheiten aus dem Bereich Physik an.“"
                            },
                            {
                                "example_id": "a35fbddb-df97-4f63-9ff5-6a6fbe3b3967",
                                "sense_id": "e8ecbfd6-93bf-33a1-8fc1-54137f1fae7f",
                                "text": "„Es gilt die Nacharbeit unmittelbar nach der Messe anzugehen.“"
                            },
                            {
                                "example_id": "213fb61e-e8a3-4afd-9afc-879f5b3b9555",
                                "sense_id": "e8ecbfd6-93bf-33a1-8fc1-54137f1fae7f",
                                "text": "„Ein Blick auf die Regelung in den Sommerferien zeigt, dass Unterrichtende mindestens die erste Ferienwoche zur Nacharbeit brauchen.“"
                            },
                            {
                                "example_id": "55f7f9e8-fa9c-48d5-8ed4-f0edc187a0f0",
                                "sense_id": "e8ecbfd6-93bf-33a1-8fc1-54137f1fae7f",
                                "text": "„Welche offenen Fragen haben sich bei der Nacharbeit zum Seminar ergeben?“"
                            }
                        ],
                        "sense_index_json": "\"2b\""
                    },
                    {
                        "sense_id": "73ca8c73-b2b6-3242-a00d-23f97d03eea2",
                        "entry_id": "6e1a897e-0e28-342e-8737-8814ddef8901",
                        "glosses": [
                            "notwendiger Abschluss von Tätigkeiten",
                            "Reparatur von elektronischen Baugruppen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e567eab-19e9-41f2-87a1-40951f2857d6",
                                "sense_id": "73ca8c73-b2b6-3242-a00d-23f97d03eea2",
                                "text": "„Nacharbeit und Reparatur sind schwierig und das Leitkleben verursacht höhere Materialkosten.“"
                            }
                        ],
                        "sense_index_json": "\"2c\""
                    }
