                "senses": [
                    {
                        "sense_id": "4a7f8f3c-5d77-3d55-9053-2fa07c2f242b",
                        "entry_id": "72590ecd-c970-3200-994b-b265d7c7abb2",
                        "glosses": [
                            "Spiel, bei dem es auf das richtige Beantworten von Fragen ankommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcb2b238-eec9-4f0d-9960-01c502af7829",
                                "sense_id": "4a7f8f3c-5d77-3d55-9053-2fa07c2f242b",
                                "text": "„Beim öffentlichen Dienst, bei Banken, Industrie, Handel und auch Handwerk entscheiden Quizspiele mit pseudowissenschaftlichem Anstrich, fragwürdige Tests und Auswahlgespräche über die Vergabe der Ausbildungsplätze.“"
                            },
                            {
                                "example_id": "e79e8cd1-53c2-4406-a46c-9e9a2897511a",
                                "sense_id": "4a7f8f3c-5d77-3d55-9053-2fa07c2f242b",
                                "text": "„Hier könnten Tiergeräusche in Kinderbücher eingebaut werden, oder auch interaktive Quizspiele.“"
                            },
                            {
                                "example_id": "978e733c-1631-4e16-a1eb-3b9b9d3d33db",
                                "sense_id": "4a7f8f3c-5d77-3d55-9053-2fa07c2f242b",
                                "text": "„Das Fazit seiner Quizspiele der letzten dreißig Jahre zieht Kulenkampff frei von jedem Überschwang.“"
                            },
                            {
                                "example_id": "6e1cfce4-f3a2-46a8-a299-eb43aa90efe0",
                                "sense_id": "4a7f8f3c-5d77-3d55-9053-2fa07c2f242b",
                                "text": "„Neben den Standardangeboten wie Tanzabenden, Quizspielen oder Fitneßtraining gibt es interessante Hobbykurse: beispielsweise Wachs- oder Zinngießen, Acrylglas-, Bauern- oder Holzbrandmalerei und Basteln mit Draht und Lack.“"
                            },
                            {
                                "example_id": "bc56584b-6bfd-4108-87d9-a5fe23c933ab",
                                "sense_id": "4a7f8f3c-5d77-3d55-9053-2fa07c2f242b",
                                "text": "„Ein Quizspiel sollte eine vergnügliche Unterhaltung sein und kein todernster Wissenstest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
