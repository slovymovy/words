{
    "word_family": [
        "irritate",
        "irritation",
        "irritant",
        "irritable",
        "irritating"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "339e5c2e-5217-38aa-8a6a-f17e9ec4b080",
                    "sense_definition": "Experiencing a feeling of annoyance or slight anger.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt <w>irritated</w> by the constant noise in the library.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя <w>раздражённой</w> из-за постоянного шума в библиотеке."
                            }
                        },
                        {
                            "text": "His <w>irritated</w> tone made the difficult situation even worse.",
                            "target_lang_translations": {
                                "ru": "Его <w>раздражённый</w> тон сделал сложную ситуацию ещё хуже."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoyed"
                    ],
                    "common_phrases": [
                        "feel irritated",
                        "look irritated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий чувство досады, раздражения или лёгкого гнева."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражённый",
                                "target_lang_sense_clarification": "находящийся в состоянии раздражения, рассерженный"
                            },
                            {
                                "target_lang_word": "раздосадованный",
                                "target_lang_sense_clarification": "испытывающий досаду из-за чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7932505b-cc8b-35ca-9f4b-b79425fbe59f",
                    "sense_definition": "Inflamed, red, or painful, often referring to skin or body parts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cream helps to soothe <w>irritated</w> skin after shaving.",
                            "target_lang_translations": {
                                "ru": "Крем помогает успокоить <w>раздражённую</w> кожу после бритья."
                            }
                        },
                        {
                            "text": "Her eyes became <w>irritated</w> because of the smoke in the room.",
                            "target_lang_translations": {
                                "ru": "Её глаза стали <w>раздражёнными</w> из-за дыма в комнате."
                            }
                        }
                    ],
                    "common_phrases": [
                        "irritated skin",
                        "irritated eyes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Воспалённый, покрасневший или болезненный (обычно о коже или слизистых оболочках)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражённый",
                                "target_lang_sense_clarification": "ставший болезненным вследствие воздействия раздражителя"
                            },
                            {
                                "target_lang_word": "воспалённый",
                                "target_lang_sense_clarification": "имеющий признаки воспаления, покрасневший"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e9b388ec-629c-33fb-9ab6-431c227609a3",
                    "sense_definition": "Simple past and past participle of <w>irritate</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud music <w>irritated</w> the neighbors all night long.",
                            "target_lang_translations": {
                                "ru": "Громкая музыка <w>раздражала</w> соседей всю ночь напролёт."
                            }
                        },
                        {
                            "text": "He has <w>irritated</w> his boss by arriving late every day.",
                            "target_lang_translations": {
                                "ru": "Он <w>раздражал</w> своего начальника, опаздывая каждый день."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие от глагола «раздражать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражал",
                                "target_lang_sense_clarification": "глагол в прошедшем времени"
                            },
                            {
                                "target_lang_word": "раздражённый",
                                "target_lang_sense_clarification": "страдательное причастие прошедшего времени"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}