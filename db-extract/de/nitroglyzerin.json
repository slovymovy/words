                                                "sense_id": "83135708-ba60-3132-8ba2-51168c3f6047",
                                                "text": "Nitrogliceryna powoduje spadek ciśnienia tętniczego, nawet znaczny, gdy chory np. stoi."
                                            },
                                            {
                                                "example_id": "9125e6f8-a552-41db-b82e-c5ef4d9c531b",
                                                "sense_id": "83135708-ba60-3132-8ba2-51168c3f6047",
                                                "text": "Z tego powodu produkcja nitrogliceryny należy do najniebezpieczniejszych procesów technologicznych w przemyśle chemicznym."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
