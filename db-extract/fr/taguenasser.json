                        "sense_id": "95a44145-a53a-313c-bb42-648711f2b29f",
                        "entry_id": "41073142-a495-398d-93f2-5626d391805b",
                        "glosses": [
                            "Agir de façon complexe mais sans résultat, bricoler."
                        ],
                        "tags": [
                            "Savoie",
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "3f5f9b09-a3b5-4152-bafc-099a1fc33852",
                                "sense_id": "95a44145-a53a-313c-bb42-648711f2b29f",
                                "text": "Ah ! mais il y a, assez loin, un paysan occupé à taguenasser son tracteur, qui me gêne un peu."
                            },
                            {
                                "example_id": "e804501a-7a4a-464f-b590-202cf5baaba3",
                                "sense_id": "95a44145-a53a-313c-bb42-648711f2b29f",
                                "text": "Boudry se remit à taguenasser dans son foin, comme si là il tira du fond de sa poitrine son soupir le plus dévot."
                            }
                        ]
