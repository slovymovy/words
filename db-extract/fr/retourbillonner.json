                "senses": [
                    {
                        "sense_id": "6738d841-104f-3dfa-b410-2729b2e87881",
                        "entry_id": "5d6f0c15-3517-337e-957e-38e32c625f0a",
                        "glosses": [
                            "Tourbillonner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d04e734-8182-4008-a2c7-3f4cefa223fa",
                                "sense_id": "6738d841-104f-3dfa-b410-2729b2e87881",
                                "text": "Stupéfait, il remonte tant bien que mal, ressaute, retourbillonne, retombe, et se casse un bras, 4 dents, et se perfore l'estomac."
                            },
                            {
                                "example_id": "671a4cba-c793-49e7-8331-8e60d9cf9279",
                                "sense_id": "6738d841-104f-3dfa-b410-2729b2e87881",
                                "text": "Le plein fait, la voiture se met à retourbillonner de plus en plus vite."
                            },
                            {
                                "example_id": "83fc3a5e-097d-416c-861c-5b86c1f468cc",
                                "sense_id": "6738d841-104f-3dfa-b410-2729b2e87881",
                                "text": "Depuis quelques jours ce tourbillon qui fera partie de nos plus belles années retourbillonne."
                            }
                        ]
                    }
