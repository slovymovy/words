                    {
                        "sense_id": "2b01d236-f05e-3cad-bf9c-92140ec165b2",
                        "entry_id": "91a875d1-0f87-306c-ac55-299eeaa900c6",
                        "glosses": [
                            "Gesamteinheit aneinandergereihter Aktivitäten/Phasen im Rahmen einer Überprüfung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "153fb8c2-2de2-4fb3-8d20-bfea95e1a81c",
                                "sense_id": "2b01d236-f05e-3cad-bf9c-92140ec165b2",
                                "text": "„Ein definierter Testprozess dient dazu, die einzelnen Testaktivitäten voneinander abzugrenzen, Ablaufpläne zu verfeinern und inhaltliche und zeitliche Abhängigkeiten der einzelnen Testaktivitäten aufzuzeigen.“"
                            },
                            {
                                "example_id": "a03a6aa4-512f-416a-bcf4-a2ac820b2cd1",
                                "sense_id": "2b01d236-f05e-3cad-bf9c-92140ec165b2",
                                "text": "„Ein Testfall, der keiner Anforderung zugeordnet werden kann, ist für den Testprozess eines Projekts nicht notwendig und kann somit entfallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
