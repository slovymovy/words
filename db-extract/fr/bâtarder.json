                ],
                "senses": [
                    {
                        "sense_id": "3db54eb3-4fca-36ad-be8f-731b03acbc0d",
                        "entry_id": "9703d4b6-1346-3644-a84a-84165022900b",
                        "glosses": [
                            "Rendre bâtard, mélanger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fe3edb8-ccc6-4ebe-85fe-db1ce3a659c5",
                                "sense_id": "3db54eb3-4fca-36ad-be8f-731b03acbc0d",
                                "text": "Admiré de Baudelaire puis de Breton, cet humoriste frénétiquement noir sut bâtarder son cynisme de sentimentalisme, son égalitarisme de mascarade et son provençal de citations bibliques."
                            },
                            {
                                "example_id": "75d1f20d-6d02-47fa-8b05-da3eb77da39e",
                                "sense_id": "3db54eb3-4fca-36ad-be8f-731b03acbc0d",
                                "text": "Comme dans toute autre nation, les technocrates se font un devoir et un jeu d’étouffer les révolutions, de dénaturer les idéologies, de bâtarder l’éducation."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9b93164-1887-38ba-9aa8-fbca4a68535f",
                        "entry_id": "9703d4b6-1346-3644-a84a-84165022900b",
                        "glosses": [
                            "Mélanger de la chaux et du ciment."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1b33acdc-4c42-37c5-98e5-8352b31a3f12",
                        "entry_id": "9703d4b6-1346-3644-a84a-84165022900b",
                        "glosses": [
                            "Monter un batardeau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e914e8bd-be4b-4cf1-a78c-18bdf06dc471",
                                "sense_id": "1b33acdc-4c42-37c5-98e5-8352b31a3f12",
                                "text": "Tout le monde sur le pont pour bâtarder, vidanger, démonter, remonter, remplir, débâtarder et redémarrer le groupe."
                            }
                        ]
                    }
