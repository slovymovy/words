                            {
                                "example_id": "513f84e8-ec4e-453f-8c03-84d1af34b028",
                                "sense_id": "96620dba-5ab2-38f5-a2bf-a60cf099ca64",
                                "text": "„›Sie heißen Sandra, geborene Boshoff. Einzige Tochter von Jannie Boshoff, der in seiner Jugend für den Ost-Vrystaat Rugby gespielt hat. Hakler.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13b5ac56-965a-44e1-b105-48263a693042",
                        "source_entry_id": "1651096f-87df-3cc6-a177-e847b0fb1d2b",
                        "source_sense_id": "96620dba-5ab2-38f5-a2bf-a60cf099ca64",
                        "source_sense_description": "Rugby: Spieler, der im Gedränge versucht, den Ball mit seinen Füßen zurückzustoßen",
                        "target_lang_word": "hooker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hooker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7eb46590-3842-35de-a35d-df74e857e3cf",
                                        "entry_id": "f058ba44-cf4f-3883-90c2-e8af65df7897",
                                        "glosses": [
                                            "A small fishing boat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bac870b6-967e-4b93-b092-a64512ca53ba",
                                                "sense_id": "7eb46590-3842-35de-a35d-df74e857e3cf",
                                                "text": "In England there are Brighton Beach boats, Centre-board sloops, Pollywogs, Lough Erne yachts, Unas, New Brighton sailing-boats, yachts of the Norfolk Broads, Itchen, Clyde sailing and Keystone boats, Penzance luggers, Cobbles, Galways, Hookers and Pookhauns […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df89e789-4e14-3a6f-9817-006392b2a7ea",
                                        "entry_id": "f058ba44-cf4f-3883-90c2-e8af65df7897",
                                        "glosses": [
                                            "Any antiquated craft."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d4b26c6-8033-46ca-8cc8-594338d5e85d",
                                                "sense_id": "df89e789-4e14-3a6f-9817-006392b2a7ea",
                                                "text": "[T]he poor Flash is gone, and there is an end of it. Poor old hooker. Hey, Almayer? You made a voyage or two with me. Wasn’t she a sweet craft?"
                                            },
                                            {
                                                "example_id": "2ca771b1-6085-45bf-98b0-c95ef7a42501",
                                                "sense_id": "df89e789-4e14-3a6f-9817-006392b2a7ea",
                                                "text": "[…] for there was scarce one of us that thought the old hooker would weather so long and hard a blow. We were mighty fortunate to come through it so handily."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hooker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fcefc98-3d9b-3fbb-9818-c19c12f168b4",
                                        "entry_id": "e2ba8e98-70cb-3e2c-a16c-bd786401d2d6",
                                        "glosses": [
                                            "One who, or that which, hooks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "513f4bf3-62e3-3171-bf88-974a43f9afcb",
                                        "entry_id": "e2ba8e98-70cb-3e2c-a16c-bd786401d2d6",
                                        "glosses": [
                                            "A player who hooks the ball out of the scrum with his foot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3dc82e2-21ab-4518-bbc5-fe1be711e62c",
                                                "sense_id": "513f4bf3-62e3-3171-bf88-974a43f9afcb",
                                                "text": "Hooker Dylan Hartley was sent to the sin-bin after yet another infringement at the breakdown and, on the stroke of half-time, Georgia's territorial advantage finally told when number eight Basilaia surged over from the base of the scrum for a try next to the posts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42804dac-167d-39c1-b63c-795aee971ad2",
                                        "entry_id": "e2ba8e98-70cb-3e2c-a16c-bd786401d2d6",
                                        "glosses": [
                                            "A batsman or batswoman adept at or fond of playing hook shots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77795b36-796e-41af-939e-47aa25c616d8",
                                                "sense_id": "42804dac-167d-39c1-b63c-795aee971ad2",
                                                "text": "I once saw Hassett drop England opening batsman and compulsive hooker, Cyril Washbrook, twice in succession at deep fine leg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a98166f1-badd-3f22-9539-5f0854ef0f86",
                                        "entry_id": "e2ba8e98-70cb-3e2c-a16c-bd786401d2d6",
                                        "glosses": [
                                            "A crocheter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d32b8de-ac1c-3ab3-8e0c-1551c6043143",
                                        "entry_id": "e2ba8e98-70cb-3e2c-a16c-bd786401d2d6",
                                        "glosses": [
                                            "Synonym of hook (“attention-grabbing element of a creative work”)."
                                        ],
                                        "tags": [
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e13b6298-6053-4fd0-9d59-33ea47024815",
                                                "sense_id": "1d32b8de-ac1c-3ab3-8e0c-1551c6043143",
                                                "text": "We regard the first seven seconds of a television commercial as the most critical or crucial in the whole unit — the \"Do or Die Seven\" — the \"moment of decision\" or the \"hooker\", if you will, when we must capture the attention of the viewer, get him involved in the action, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ead6ca67-3dd4-3a58-895a-946bb5559f87",
                                        "entry_id": "e2ba8e98-70cb-3e2c-a16c-bd786401d2d6",
                                        "glosses": [
                                            "A thief who uses a pole with a hook on the end to steal goods."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa74a0c0-110b-4cd4-884c-6f72dd31838a",
                                                "sense_id": "ead6ca67-3dd4-3a58-895a-946bb5559f87",
                                                "text": "They are sure to be clyd in the night by the angler, or hooker, or such like pilferers that liue upon the spoyle of other poore people."
                                            },
                                            {
                                                "example_id": "fb7af2b4-1e2c-474b-b7b3-504ee5df8536",
                                                "sense_id": "ead6ca67-3dd4-3a58-895a-946bb5559f87",
                                                "text": "Suffer none, from far or near, / With their rights to interfere; / No strange Abram, Ruffler crack— / Hooker of another pack—"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hooker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42604f2e-02bf-3623-b116-161eb4784c12",
                                        "entry_id": "e82f9031-f7f4-3a38-afc9-48cdd75a11fb",
                                        "glosses": [
                                            "A prostitute."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8358af1-29d1-4660-9aef-43bacd0a5254",
                                                "sense_id": "42604f2e-02bf-3623-b116-161eb4784c12",
                                                "text": "All my life, been hustling / And tonight is my appraisal / 'Cause I'm a hooker selling songs / And my pimp's a record label"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2062a2f-4833-318e-91a3-c4b7da7ba538",
                                        "entry_id": "e82f9031-f7f4-3a38-afc9-48cdd75a11fb",
                                        "glosses": [
                                            "An imprecise measure of alcoholic drink; a \\\"slug\\\" (of gin), or an overlarge gulp."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0465d807-dbc5-4563-866a-cb5ef0dcc782",
                                                "sense_id": "e2062a2f-4833-318e-91a3-c4b7da7ba538",
                                                "text": "Emily had cut short these 3 A.M. glooms with a hooker of bourbon."
                                            }
                                        ]
                                    }
                                ]
                            },
