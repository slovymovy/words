                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afwijking",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f9aa6f4f-bb66-3e83-95c7-796b32812710",
                                        "entry_id": "309ee55b-5764-30e2-b039-f241ba7453c2",
                                        "glosses": [
                                            "het niet goed afgesteld staan en naar een bepaalde kant neigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ff62282-cdd8-46cc-ba73-5e991c5100ab",
                                                "sense_id": "f9aa6f4f-bb66-3e83-95c7-796b32812710",
                                                "text": "Het stuur had een afwijking naar links."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3aba13ea-62c1-3d50-aaca-f11b50982028",
                                        "entry_id": "309ee55b-5764-30e2-b039-f241ba7453c2",
                                        "glosses": [
                                            "lichamelijk of geestelijk gebrek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f19d796-426b-4843-bcf4-baa6af2ffc1b",
                                                "sense_id": "3aba13ea-62c1-3d50-aaca-f11b50982028",
                                                "text": "Een aangeboren afwijking aan de aortaklep."
                                            },
                                            {
                                                "example_id": "757162af-49af-4942-83af-65347a648007",
                                                "sense_id": "3aba13ea-62c1-3d50-aaca-f11b50982028",
                                                "text": "Het buurmeisje had een afwijking, maar was ook erg aardig."
                                            },
                                            {
                                                "example_id": "2735049c-67e1-4099-a536-ab62e5cf1732",
                                                "sense_id": "3aba13ea-62c1-3d50-aaca-f11b50982028",
                                                "text": "De moderne wereld behoorde uitdrukkelijk toe aan de extraverte mens, terwijl de introvert gestemden thuis aan hun lot werden overgelaten en het gevoel kregen opgedrongen dat datgene waar ze zich het prettigst bij voelden - alleen-zijn - een afwijking was."
                                            },
                                            {
                                                "example_id": "bbd927f9-7903-4d46-8ea9-b5517dea60d0",
                                                "sense_id": "3aba13ea-62c1-3d50-aaca-f11b50982028",
                                                "text": "Een afwijking die ik heb overgehouden aan mijn eerste twee maanden in Hohenschônhausen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d2bd3c9-a720-4dc0-9d98-c25aeea18d48",
                        "source_entry_id": "f3ccecf0-3dab-376e-bce4-d8ee2dd24066",
                        "source_sense_description": "variation from expected behavior or form",
                        "target_lang_word": "déviance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déviance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f6e677b-7ddf-3306-a50c-36fd361f8e29",
                                        "entry_id": "a1aad0eb-6e41-32eb-b921-2628a8d43064",
                                        "glosses": [
                                            "Transgression des normes sociales en vigueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5019d3dc-bd95-438a-a27a-0543f648e4e3",
                                                "sense_id": "0f6e677b-7ddf-3306-a50c-36fd361f8e29",
                                                "text": "Pour les tenants de la sociologie de la déviance, comme Albert Ogien, la notion de déviance est relative car elle diffère selon les sociétés étudiées et les époques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f2fd526-6842-3f54-ad91-64fe0d97473d",
                                        "entry_id": "a1aad0eb-6e41-32eb-b921-2628a8d43064",
                                        "glosses": [
                                            "Comportement, conduite qui manifeste cette transgression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e88803b-d49d-4f38-97d3-3cd8b3f01df6",
                                                "sense_id": "8f2fd526-6842-3f54-ad91-64fe0d97473d",
                                                "text": "Sartre et le Castor dévoraient dans les journaux ce qui avait trait aux passions humaines, lisaient des romans policiers, et la revue ne recula jamais devant la publication du récit des pires déviances, lorsque nous les jugions dévoilantes."
                                            },
                                            {
                                                "example_id": "87ae3eb7-2f54-4fa0-b0d0-f9cb935820d6",
                                                "sense_id": "8f2fd526-6842-3f54-ad91-64fe0d97473d",
                                                "text": "Propager au sein de sa base un rejet puissant des institutions dès qu’elles n’obéissent pas à ses diktats. Face à celles-ci, sa base a vite basculé de la confiance à la méfiance, puis à la défiance et au stade terminal, à une déviance sociétale parfois même violente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f32831e-96cf-3554-8227-d3a718c7dc06",
                                        "entry_id": "a1aad0eb-6e41-32eb-b921-2628a8d43064",
                                        "glosses": [
                                            "Écart statistique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d4f3445-546a-42dd-93da-b050b8e8a1be",
                                                "sense_id": "3f32831e-96cf-3554-8227-d3a718c7dc06",
                                                "text": "La Norvège a un taux d’athéisme entre 49% et 71%. Or 85% de la population est membre de l’Église protestante norvégienne. Cette déviance est due au fait que tous les Norvégiens non-affiliés ont été signés dans cette église quelques années auparavant (sans qu’on leur ait demandé), et que le désenregistrement serait une affaire longue et bureaucratique ne rapportant aucun gain immédiat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a46abd5-fff3-3baf-9b35-1af2af1a40c0",
                                        "entry_id": "a1aad0eb-6e41-32eb-b921-2628a8d43064",
                                        "glosses": [
                                            "Au sens strict, la déviance est définie à partir de la vraisemblance dans le cas d’un modèle paramétrique. Soit un ensemble de n observations et un modèle avec les paramètres β₀, β₁..βₙ ; alors L(β₀) est la vraisemblance du modèle n’utilisant que le paramètre β₀, tandis que L(βₙ) est la vraisemblance du modèle complètement paramétrisé (L(βₙ) = 1 parce que le modèle est parfaitement ajusté). La déviance pour k paramètres est D(βₖ) = –2[log L(βₖ) – log L(βₙ)] = log [L(βₙ)/ L(βₖ)]² = –2 log L(βₖ)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "612f8127-12cd-4d8c-bfc0-0b0e0ee8d281",
                                                "sense_id": "0a46abd5-fff3-3baf-9b35-1af2af1a40c0",
                                                "text": "L’adéquation du modèle obtenu par rapport au modèle de base est alors testée par calcul de la déviance (statistique du test du rapport de vraisemblance)."
                                            },
                                            {
                                                "example_id": "ef4d3a2a-cab2-492e-94dc-5526d4c19890",
                                                "sense_id": "0a46abd5-fff3-3baf-9b35-1af2af1a40c0",
                                                "text": "La déviance joue un rôle similaire à celui de la somme des carrés des résidus ; en fait, dans le cas particulier d’une distribution normale, la déviance est la somme des carrés des résidus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
