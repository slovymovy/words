                        "glosses": [
                            "Relating to expansions of the nasal septum."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "94a43433-bfbc-4081-b743-027995d2246b",
                                "sense_id": "39f210db-5f68-36f9-965c-644672cb462f",
                                "text": "The prenasal cartilage (Fig. 70, pn) still points downwards, and by this time are formed the alinasal cartilages (Fig. 70, aln) developed from the trabecular horns, and the aliseptal cartilages which enclose the inferior turbinals (Fig. 70)."
                            },
                            {
                                "example_id": "862cf198-d163-4280-a60e-a9da70153629",
                                "sense_id": "39f210db-5f68-36f9-965c-644672cb462f",
                                "text": "Such lateral developments of the ethmoid plate are the aliethmoid, aliseptal, and alinasal."
                            },
                            {
                                "example_id": "22fb7d7c-9095-4e8a-af81-48760cbc993c",
                                "sense_id": "39f210db-5f68-36f9-965c-644672cb462f",
                                "text": "This lower view (Plate 15, fib. 1) shows, behind the exposed part of the snout already described, that the double nasal canal, after narrowing in a little, enlarges only gradually in the aliseptal region (al.sp.)."
                            }
                        ]
                    }
