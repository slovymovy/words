                        "glosses": [
                            "Any of various palm-like plants in the genus Pandanus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e83c12cf-2bad-4c36-b39a-db67b8411177",
                                "sense_id": "bb115c7b-42f8-3b23-a97e-2bbf782c695e",
                                "text": "A girl of fifteen, perhaps, was plaiting pandanus-leaf to make a hat, and an old woman was sitting on her haunches smoking a pipe."
                            },
                            {
                                "example_id": "5b5dfd19-ab32-4006-9e05-31445fe4b1cd",
                                "sense_id": "bb115c7b-42f8-3b23-a97e-2bbf782c695e",
                                "text": "Cut the pandanus leaves to fit into the steamer, then place them over the tea towel or muslin cloth. If using pandanus essence, do not add at this stage. Spoon the rice onto the leaves and spread evenly. Steam, covered, over rapidly boiling water for 30 minutes."
                            }
                        ]
                    }
