{
    "word_family": [
        "caution",
        "cautious",
        "cautiously",
        "precautionary"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "788edfc3-1e61-37a2-8930-d5c287fbf45c",
                    "sense_definition": "A measure taken in advance to prevent something bad from happening or to ensure success.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "safety_measures",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We took every possible <w>precaution</w> to ensure the safety of the workers.",
                            "target_lang_translations": {
                                "pl": "Podjęliśmy wszelkie możliwe <w>środki ostrożności</w>, aby zapewnić bezpieczeństwo pracownikom."
                            }
                        },
                        {
                            "text": "As a safety <w>precaution</w>, please fasten your seatbelts before the plane takes off.",
                            "target_lang_translations": {
                                "pl": "W ramach <w>środka ostrożności</w>, proszę zapiąć pasy przed startem samolotu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "safety precaution",
                        "take precautions"
                    ],
                    "target_lang_definitions": {
                        "pl": "Działanie podjęte z wyprzedzeniem, aby zapobiec nieszczęściu lub zapewnić powodzenie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "środek ostrożności",
                                "target_lang_sense_clarification": "konkretne działanie lub zabezpieczenie"
                            },
                            {
                                "target_lang_word": "zabezpieczenie",
                                "target_lang_sense_clarification": "ochrona przed ryzykiem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "841f9cff-b439-3cc4-b68f-f76b83103e61",
                    "sense_definition": "The state of being careful or cautious in advance to avoid misfortune.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "safety_measures",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He acted with great <w>precaution</w> when handling the dangerous chemicals.",
                            "target_lang_translations": {
                                "pl": "Działał z wielką <w>ostrożnością</w> podczas obchodzenia się z niebezpiecznymi chemikaliami."
                            }
                        },
                        {
                            "text": "The decision was made with <w>precaution</w> to avoid any potential legal issues.",
                            "target_lang_translations": {
                                "pl": "Decyzję podjęto z <w>rozwagą</w>, aby uniknąć potencjalnych problemów prawnych."
                            }
                        }
                    ],
                    "synonyms": [
                        "forecaution"
                    ],
                    "target_lang_definitions": {
                        "pl": "Stan bycia ostrożnym z wyprzedzeniem w celu uniknięcia nieszczęścia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ostrożność",
                                "target_lang_sense_clarification": "postawa pełna rozwagi"
                            },
                            {
                                "target_lang_word": "rozwaga",
                                "target_lang_sense_clarification": "działanie przemyślane i ostrożne"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fb7ed4ee-e65d-3ef8-a2e1-4da19866b02a",
                    "sense_definition": "To give a warning to someone in advance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "warning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guide <w>precautioned</w> the hikers about the sudden changes in weather.",
                            "target_lang_translations": {
                                "pl": "Przewodnik <w>ostrzegł</w> wędrowców przed nagłymi zmianami pogody."
                            }
                        },
                        {
                            "text": "She <w>precautioned</w> him against trusting strangers with his personal information.",
                            "target_lang_translations": {
                                "pl": "Ona <w>przestrzegła</w> go przed powierzaniem nieznajomym swoich danych osobowych."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Udzielenie komuś ostrzeżenia z wyprzedzeniem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ostrzegać",
                                "target_lang_sense_clarification": "informować o niebezpieczeństwie"
                            },
                            {
                                "target_lang_word": "przestrzegać",
                                "target_lang_sense_clarification": "udzielać rady przed podjęciem ryzyka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f9ad374-7018-33e2-ac69-0b244c48c723",
                    "sense_definition": "To take measures to protect against a specific risk.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "safety_measures",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>precautioned</w> the building against potential fire hazards.",
                            "target_lang_translations": {
                                "pl": "Oni <w>zabezpieczyli</w> budynek przed potencjalnym zagrożeniem pożarowym."
                            }
                        },
                        {
                            "text": "The company <w>precautioned</w> its systems against cyber attacks.",
                            "target_lang_translations": {
                                "pl": "Firma <w>zabezpieczyła</w> swoje systemy przed cyberatakami."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Podjęcie środków w celu ochrony przed konkretnym ryzykiem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zabezpieczać",
                                "target_lang_sense_clarification": "chronić przed zagrożeniem"
                            },
                            {
                                "target_lang_word": "chronić",
                                "target_lang_sense_clarification": "podejmować działania ochronne"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}