                                "target_senses": [
                                    {
                                        "sense_id": "27519dde-ab61-34d4-ae61-e2aaeefddd5f",
                                        "entry_id": "db6918e1-eddd-308b-9e7d-0b83c9399501",
                                        "glosses": [
                                            "A Hindu monarch ranking above a raja, an emperor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8edc727-e7aa-4d59-a66e-3a3e09ecbf7a",
                                                "sense_id": "27519dde-ab61-34d4-ae61-e2aaeefddd5f",
                                                "text": "I speak from a very intimate knowledge of their ways and habits after having spent a very happy twenty years amongst them with friends in every degree, from the Maharaja himself to some of the humblest coolies."
                                            },
                                            {
                                                "example_id": "d9a7ac13-e53e-43aa-937f-33a49a172eb0",
                                                "sense_id": "27519dde-ab61-34d4-ae61-e2aaeefddd5f",
                                                "text": "Benny: Hey, T.C., what's a maharaja?\nTop Cat: What's a what?\nBenny: A maharaja.\nTop Cat: Oh, do I look like Daniel Webster? I didn't write no dictionary."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
