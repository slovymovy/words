                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3c67247-a8f2-43b8-b3cd-53e21995f858",
                                "sense_id": "44fcb300-f282-3ea6-9fa3-f65dffcbc58d",
                                "text": "Nan je plaisante et je garantirai, le jour venu, un espace entièrement désadolescentisé!"
                            },
                            {
                                "example_id": "0778aa0d-3c80-490c-b18f-6f8ef4afc887",
                                "sense_id": "44fcb300-f282-3ea6-9fa3-f65dffcbc58d",
                                "text": "Personnellement j’ai choisi : insomnies (« mais tu choisis toujours l’insomnie » ta gueule, on a le droit aussi de pas encore avoir fini de désadolescentiser !), cheveux gras et chocolat."
                            }
                        ]
