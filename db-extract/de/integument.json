                "senses": [
                    {
                        "sense_id": "a633348f-98d1-3d8d-b2df-43e4ba86bd80",
                        "entry_id": "fb19c591-83b2-3a45-9f4b-09f08934b0d2",
                        "glosses": [
                            "Gesamtheit der äußeren Haut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d774dbfd-7fb4-42e2-b2ba-1f5c42de9d61",
                                "sense_id": "a633348f-98d1-3d8d-b2df-43e4ba86bd80",
                                "text": "Die Skabies kann bei Kindern das gesamte Integument befallen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dbe6e6f7-9441-39e3-82ec-ee7ea5944f00",
                        "entry_id": "fb19c591-83b2-3a45-9f4b-09f08934b0d2",
                        "glosses": [
                            "Hülle der Samenanlage bei Pflanzen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae6eae0d-e84e-4edd-bf91-978b0cd28a9c",
                        "source_entry_id": "fb19c591-83b2-3a45-9f4b-09f08934b0d2",
                        "source_sense_id": "a633348f-98d1-3d8d-b2df-43e4ba86bd80",
                        "source_sense_description": "Biologie, Medizin: Gesamtheit der äußeren Haut",
                        "target_lang_word": "integument",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "integument",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c39cf245-25ab-3773-a510-51fddc36e28e",
                                        "entry_id": "100725e1-4968-31eb-bf07-6d3f6442c7de",
                                        "glosses": [
                                            "A shell or other outer protective layer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "163c70c3-5332-4e8a-8c84-aa39cbe6692b",
                                                "sense_id": "c39cf245-25ab-3773-a510-51fddc36e28e",
                                                "text": "The power of turning into an animal has this serious disadvantage that it lays you open to the chance of being wounded or even slain in your animal skin before you have the chance to put it off and scramble back into your human integument."
                                            },
                                            {
                                                "example_id": "3328ecdf-3235-43e9-b7e6-fe8c5480317b",
                                                "sense_id": "c39cf245-25ab-3773-a510-51fddc36e28e",
                                                "text": "[…] if we're moved by the book's condemnation of a world wounded by exploitation, where the drive for profit hobbles the mass of humanity, bolsters vast integuments of oppression and repression, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6236c0d-8026-3446-91c4-2bea80b30923",
                                        "entry_id": "100725e1-4968-31eb-bf07-6d3f6442c7de",
                                        "glosses": [
                                            "An outer protective covering such as the feathers or skin of an animal, a rind or shell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4111a99-7ad2-40fb-8f7f-7341a24ad252",
                                                "sense_id": "f6236c0d-8026-3446-91c4-2bea80b30923",
                                                "text": "Sarsem became a naked young epicene in an integument of lavender scales with puffs of purple hair like pom-poms growing down his back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8475d8aa-ed1e-38d7-914a-b3eb931cd3c3",
                                        "entry_id": "100725e1-4968-31eb-bf07-6d3f6442c7de",
                                        "glosses": [
                                            "The outer layer of an ovule, which develops into the seed coat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac9ddbd0-aa7b-4a9b-9536-7c5f5efe4d83",
                                                "sense_id": "8475d8aa-ed1e-38d7-914a-b3eb931cd3c3",
                                                "text": "Her active living was suspended, but underneath, in the darkness, something was coming to pass. If only she could break through the last integuments!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4179b96-7e58-4910-b4f3-936d6c752ee3",
                        "source_entry_id": "fb19c591-83b2-3a45-9f4b-09f08934b0d2",
                        "source_sense_id": "a633348f-98d1-3d8d-b2df-43e4ba86bd80",
                        "source_sense_description": "Biologie, Medizin: Gesamtheit der äußeren Haut",
                        "target_lang_word": "tégument",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tégument",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "450de327-2b7b-36ed-be5e-c7213ba2c1a5",
                                        "entry_id": "2e8d3507-9628-3e0e-b0af-7d3fdeaa96c1",
                                        "glosses": [
                                            "Tissu organique qui recouvre le corps des animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d143c6bc-5405-4316-8213-4ee0633e9fba",
                                                "sense_id": "450de327-2b7b-36ed-be5e-c7213ba2c1a5",
                                                "text": "Que l'on considère l'homme, les animaux quadrupèdes, les oiseaux, les cétacées, les poissons, les amphibies, les reptiles; quelle prodigieuse variété dans la figure, dans la proportion de leur corps, dans le nombre et dans la position de leurs membres, dans la substance de leur chair, de leurs os, de leurs téguments !"
                                            },
                                            {
                                                "example_id": "b93e6acd-e04a-4a49-b700-89dd16aaa739",
                                                "sense_id": "450de327-2b7b-36ed-be5e-c7213ba2c1a5",
                                                "text": "Mais ne pouvant penser à la fois à ce que j’étais et à ce que je serais, je pensais avec désespoir à tout ce tégument de caresses, de baisers, de sommeils amis, dont il faudrait bientôt me laisser dépouiller pour jamais."
                                            },
                                            {
                                                "example_id": "06ac431f-d065-4430-8f53-87b98398ee6d",
                                                "sense_id": "450de327-2b7b-36ed-be5e-c7213ba2c1a5",
                                                "text": "Cette larve peut vivre deux jours. Elle doit trouver une limnée (petit gastéropode aquatique) et pénétrer activement à travers son tégument."
                                            },
                                            {
                                                "example_id": "dff7ba26-ce48-4080-bc15-938a9803f6cf",
                                                "sense_id": "450de327-2b7b-36ed-be5e-c7213ba2c1a5",
                                                "text": "Vous me prenez pour un con, a fait encore observer le commanditaire en pâlissant - ce qui renforçait le contraste entre ses lunettes sombres et son tégument blême."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0d0ac90-bd30-3af9-9b5f-e81ceb540dc5",
                                        "entry_id": "2e8d3507-9628-3e0e-b0af-7d3fdeaa96c1",
                                        "glosses": [
                                            "Enveloppe de l’ovule ou de la graine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e90f5b4-ec24-4872-80cf-60ce68d1f57f",
                                                "sense_id": "a0d0ac90-bd30-3af9-9b5f-e81ceb540dc5",
                                                "text": "C’est au niveau du tégument que se réalise une partie des échanges de matières et d’informations entre l’organisme et le milieu qui l’entoure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfade4aa-3c27-4d01-874f-1def058aaad6",
                        "source_entry_id": "fb19c591-83b2-3a45-9f4b-09f08934b0d2",
                        "source_sense_id": "a633348f-98d1-3d8d-b2df-43e4ba86bd80",
