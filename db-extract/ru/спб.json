        "ru-extract.jsonl": [
            {
                "entry_id": "a6d4b2d2-05d0-3abe-9438-e8d1760b7d7a",
                "word": "СПб",
                "pos": "abbrev",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e346d00a-000c-3f82-9224-36289dbd348b",
                        "entry_id": "a6d4b2d2-05d0-3abe-9438-e8d1760b7d7a",
                        "glosses": [
                            "сокр. от Санкт-Петербург"
                        ],
                        "tags": [
                            "abbreviation"
                        ],
                        "examples": [
                            {
                                "example_id": "7b4d8213-3507-4a8b-8465-06a4544b4e21",
                                "sense_id": "e346d00a-000c-3f82-9224-36289dbd348b",
                                "text": "Подумав, мы обратились за помощью к широко известному в СПб, Москве и Лондоне специалисту — филологу Игорю Пильщикову."
                            }
                        ]
                    },
                    {
                        "sense_id": "5097d552-d2a2-3b57-803b-e94cca6a5607",
                        "entry_id": "a6d4b2d2-05d0-3abe-9438-e8d1760b7d7a",
                        "glosses": [
                            "устар. сокр. от санкт-петербургский"
                        ],
                        "tags": [
                            "abbreviation"
                        ],
                        "examples": [
                            {
                                "example_id": "c25cd6e6-bb3d-4cc2-bd56-4803243cc2c2",
                                "sense_id": "5097d552-d2a2-3b57-803b-e94cca6a5607",
                                "text": "Долго думал я, как решить это дело, и наконец положил представить оное на суд родного брата Корсакова, князя М. А. Дундукова-Корсакова, попечителя СПб. учебного округа, председателя Цензурного Комитета, бывшего моего ученика, человека самого благородного и всегда со мной дружелюбного."
                            },
                            {
                                "example_id": "5d9681b1-31e3-47e6-98ca-b8bf29cfb6da",
                                "sense_id": "5097d552-d2a2-3b57-803b-e94cca6a5607",
                                "text": "Ежегодно устраиваемая СПб. кружком любителей спорта велосипедная гонка Гатчина — Петербург состоялась 28 мая."
                            }
                        ]
                    }
                ],
