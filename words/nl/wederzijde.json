                {
                    "sense_id": "7a57f268-a42a-396c-8dfc-87e6da0710ec",
                    "sense_definition": "de andere en deze kant; beide kanten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kanten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er stonden bomen aan <w>wederzijden</w> van de weg.",
                            "target_lang_translations": {
                                "en": "There were trees on <w>both sides</w> of the road."
                            }
                        },
                        {
                            "text": "De rivier stroomde rustig met aan <w>wederzijden</w> groene weiden.",
                            "target_lang_translations": {
                                "en": "The river flowed peacefully with green meadows on <w>either side</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "weerszijde",
                        "beide kanten"
                    ],
                    "common_phrases": [
                        "aan wederzijden van"
                    ],
                    "target_lang_definitions": {
                        "en": "the other and this side; both sides"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "both sides",
                                "target_lang_sense_clarification": "referring to two opposing or adjacent sides"
                            },
                            {
                                "target_lang_word": "either side",
                                "target_lang_sense_clarification": "referring to one side and the other"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b48e85f-636d-3a9c-8563-7d61cb0695ac",
                    "sense_definition": "de andere kant",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kanten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij keek naar de <w>wederzijde</w> van de medaille om het ontwerp te bewonderen.",
                            "target_lang_translations": {
                                "en": "He looked at the <w>reverse side</w> of the medal to admire the design."
                            }
                        },
                        {
                            "text": "Aan de <w>wederzijde</w> van de vallei lag een klein dorpje verscholen.",
                            "target_lang_translations": {
                                "en": "On the <w>other side</w> of the valley, a small village lay hidden."
                            }
                        }
                    ],
                    "synonyms": [
                        "overkant",
                        "tegenzijde"
                    ],
                    "common_phrases": [
                        "aan de wederzijde"
                    ],
                    "target_lang_definitions": {
