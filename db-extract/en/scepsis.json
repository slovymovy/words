                        "examples": [
                            {
                                "example_id": "2cba6933-8c4a-4f55-8d74-aab875452917",
                                "sense_id": "2d73756f-90c1-3537-a774-ec15a328876f",
                                "text": "Among their products were the system of Locke, the scepsis of Hume, the critical philosophy of Kant."
                            },
                            {
                                "example_id": "e156188c-333c-48ec-ba95-9a0139cd1c14",
                                "sense_id": "2d73756f-90c1-3537-a774-ec15a328876f",
                                "text": "On the one side it is seen that the sole basis of philosophy is experience, and on the other that scepsis has shaken the credibility of experience."
                            },
                            {
                                "example_id": "e3466002-2b94-4b53-b2e7-fb5badaa201c",
                                "sense_id": "2d73756f-90c1-3537-a774-ec15a328876f",
                                "text": "Permanent scepsis is, after all, the condition sine qua non of not only philosophy but also of all true social action."
                            },
                            {
                                "example_id": "294abccd-80b6-4f9b-aa20-b964bf4531fc",
                                "sense_id": "2d73756f-90c1-3537-a774-ec15a328876f",
                                "text": "The connection with opīnor ‘to suspect’ is difficult for semantic reasons; EM regard it with scepsis."
                            }
                        ]
                    }
