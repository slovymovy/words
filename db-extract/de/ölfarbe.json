                ],
                "senses": [
                    {
                        "sense_id": "a06476a3-13c5-3a64-94e4-4a8a4b305c91",
                        "entry_id": "f6f0b06b-8fc6-36ff-9702-7ce626c86f75",
                        "glosses": [
                            "ölhaltige Künstlerfarbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eac21bd1-f955-43ac-ac91-75dd5affda9d",
                                "sense_id": "a06476a3-13c5-3a64-94e4-4a8a4b305c91",
                                "text": "„Kunstschaffende waren dazu übergegangen, in westlicher Manier mit Ölfarbe auf Leinwänden zu experimentieren, mit Videokameras zu hantieren, Fotokunst anzufertigen, sich der Möglichkeiten von Performancekunst zu vergewissern oder auch raumgreifende Installationen zu errichten.“"
                            },
                            {
                                "example_id": "821deeea-41dc-49fb-a2be-cd6f77db2e30",
                                "sense_id": "a06476a3-13c5-3a64-94e4-4a8a4b305c91",
                                "text": "„Der Onkel hatte festgestellt, daß sie nichts begreife, und sich in ihrem erschreckten Beisein vor dem Badezimmerspiegel das Gesicht mit Ölfarben bunt angemalt und das Haus verlassen.“"
                            },
                            {
                                "example_id": "8e75162a-6ad3-4a8e-a592-759832429b44",
                                "sense_id": "a06476a3-13c5-3a64-94e4-4a8a4b305c91",
                                "text": "„In zwei Truhen transportierte die 45-Jährige ihre Petticoats, Korsetts und Hüte, aber auch Silber, Porzellan und Ölfarben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a4418003-4f75-3af6-b3df-fc097c46be42",
                        "entry_id": "f6f0b06b-8fc6-36ff-9702-7ce626c86f75",
                        "glosses": [
                            "wasserabweisende Wandfarbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbeb8b6e-e364-4174-b4f2-32124137f8de",
                                "sense_id": "a4418003-4f75-3af6-b3df-fc097c46be42",
                                "text": "„Die oben genannten Kennzeichen sind in gut lesbaren und dauerhaften lateinischen Schriftzeichen anzubringen, wobei insbesondere eine Aufschrift in Ölfarbe als dauerhaft angesehen wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
