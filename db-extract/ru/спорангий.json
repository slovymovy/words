                        "translation_id": "42214da6-7d81-4d6b-b3d8-aece03e4d07e",
                        "source_entry_id": "a777e3ff-5b5e-391e-8803-f5d92717b4d3",
                        "source_sense_id": "fbac3bf6-e0d8-3b97-9ef0-95305a2fd4d6",
                        "target_lang_word": "sporangium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sporangium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e8cd096-1dcb-370f-8b59-fd89cba5e5c1",
                                        "entry_id": "47847c04-9672-3e43-9bfb-81b81864dffd",
                                        "glosses": [
                                            "A case, capsule, or container in which spores are produced by an organism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98576672-91a8-4eae-aeb4-ae47ee6836dc",
                                                "sense_id": "5e8cd096-1dcb-370f-8b59-fd89cba5e5c1",
                                                "text": "Scientific explanations include that exposure to light, lack of moisture or absence of food can cause sporangia to form from the plasmodium. At least one of these three conditions has been present every time I've seen sporangia form."
                                            },
                                            {
                                                "example_id": "7439602d-defe-4097-82d0-8517a3681cfd",
                                                "sense_id": "5e8cd096-1dcb-370f-8b59-fd89cba5e5c1",
                                                "text": "Asexual reproduction by the production of a bud in place of a sporangium is not uncommon."
                                            },
                                            {
                                                "example_id": "db5654ce-45d9-4df0-a70d-60ccc28a5ce5",
                                                "sense_id": "5e8cd096-1dcb-370f-8b59-fd89cba5e5c1",
                                                "text": "The sporangia, however, are much larger: 3–4 mm long 0.7–1.1 mm in diameter versus only 1–1.5 mm long 0.5–0.8 mm in Corynepteris, and are characteristically banana shaped with a pair of elongate annuli."
                                            }
                                        ]
                                    }
                                ]
                            }
