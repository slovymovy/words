                ],
                "senses": [
                    {
                        "sense_id": "27e82948-de2d-33c6-b329-ebccfcd0483b",
                        "entry_id": "9d5a6dc8-efbe-3c58-9fa2-5994f64d1b58",
                        "glosses": [
                            "mogelijk."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "703ebfcd-7dac-4131-aa2e-2aa514a39b25",
                                "sense_id": "27e82948-de2d-33c6-b329-ebccfcd0483b",
                                "text": "Een potentiële aanslag op de verkozen president vóór zijn inauguratie kan aanleiding geven tot constitutionele onduidelijkheden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36a76974-ad42-40db-9e33-d85eac677ab1",
                        "source_entry_id": "9d5a6dc8-efbe-3c58-9fa2-5994f64d1b58",
                        "source_sense_id": "27e82948-de2d-33c6-b329-ebccfcd0483b",
                        "source_sense_description": "mogelijkheid",
                        "target_lang_word": "potential",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "potential",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5befd46b-7270-3062-bbaf-d37efd078a1d",
                                        "entry_id": "d48add54-5e25-3405-9a02-378391696eb5",
                                        "glosses": [
                                            "A currently unrealized ability (with the most common adposition being to)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fafcd46-4805-4fb1-8ec8-f2186b3ea3d1",
                                                "sense_id": "5befd46b-7270-3062-bbaf-d37efd078a1d",
                                                "text": "Even from a young age it was clear that she had the potential to become a great musician."
                                            },
                                            {
                                                "example_id": "b0e259d3-1a82-4d30-811a-20fcc91a5507",
                                                "sense_id": "5befd46b-7270-3062-bbaf-d37efd078a1d",
                                                "text": "Comrades, our own fleet doesn't know our full potential. They will do everything possible to test us, but they will only test their own embarrassment."
                                            },
                                            {
                                                "example_id": "9920fbb4-6baa-42b7-bcc1-2df0e8638eff",
                                                "sense_id": "5befd46b-7270-3062-bbaf-d37efd078a1d",
                                                "text": "With some technical improvement, I could see how the process of imitating my work would soon become fast and streamlined, and the many dark potentials bubbled to the forefront of my mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4612f135-a394-3eed-93b9-6522e86d7d5a",
                                        "entry_id": "d48add54-5e25-3405-9a02-378391696eb5",
                                        "glosses": [
                                            "The gravitational potential: the radial (irrotational, static) component of a gravitational field, also known as the Newtonian potential or the gravitoelectric field."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d02125c2-7053-359d-ba7f-908862922fb9",
                                        "entry_id": "d48add54-5e25-3405-9a02-378391696eb5",
                                        "glosses": [
                                            "The work (energy) required to move a reference particle from a reference location to a specified location in the presence of a force field, for example to bring a unit positive electric charge from an infinite distance to a specified point against an electric field."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e479e22-fc4e-35cb-87fa-77939acd3554",
                                        "entry_id": "d48add54-5e25-3405-9a02-378391696eb5",
                                        "glosses": [
                                            "A verbal construction or form stating something is possible or probable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "potential",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ed3740f-9e7f-330a-90c1-605a306da1ec",
                                        "entry_id": "2c418ca9-d138-3ad9-b9a9-4c18d5baa701",
                                        "glosses": [
                                            "Existing in possibility, not in actuality."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "340e50fa-1606-4d4c-b405-701049ed8136",
                                                "sense_id": "6ed3740f-9e7f-330a-90c1-605a306da1ec",
                                                "text": "The heroic man,—and is not every man, God be thanked, a potential hero?—has to do so, in all times and circumstances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee0672ed-ffaf-310d-bb39-f4cd565416a5",
                                        "entry_id": "2c418ca9-d138-3ad9-b9a9-4c18d5baa701",
                                        "glosses": [
                                            "Being potent; endowed with energy adequate to a result"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fdd45cd-c1b2-489f-a268-88c468e9ba4e",
                                                "sense_id": "ee0672ed-ffaf-310d-bb39-f4cd565416a5",
                                                "text": "And hath, in his effect, a voice potential"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "924ad706-c8fa-391f-a37e-820f2e3d762c",
                                        "entry_id": "2c418ca9-d138-3ad9-b9a9-4c18d5baa701",
                                        "glosses": [
                                            "irrotational"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aa6a019-7590-4fbd-81c0-4c11fd065d89",
                                                "sense_id": "924ad706-c8fa-391f-a37e-820f2e3d762c",
                                                "text": "From Maxwell equations (6.20) it follows that the electric field is potential: E(r) = −gradφ(r)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ec781e7-4b7b-351b-820b-2da4c7aed515",
                                        "entry_id": "2c418ca9-d138-3ad9-b9a9-4c18d5baa701",
                                        "glosses": [
                                            "irrotational (see potential flow on Wikipedia)"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92c6e547-6e4a-4e37-b75d-df6b9d913c0e",
                                                "sense_id": "8ec781e7-4b7b-351b-820b-2da4c7aed515",
                                                "text": "The non-viscous flow of the vacuum should be potential (irrotational)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "350862d3-1425-3109-9359-4048567bb58e",
                                        "entry_id": "2c418ca9-d138-3ad9-b9a9-4c18d5baa701",
                                        "glosses": [
                                            "Referring to a verbal construction of form stating something is possible or probable."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
