                "senses": [
                    {
                        "sense_id": "c4d09bba-390c-3120-bf62-b72fbe4ffd51",
                        "entry_id": "34b06672-b981-371c-b7ee-5cb8e0ad2548",
                        "glosses": [
                            "Faire perdre son caractère lié à Babylone à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52d2f01f-8bdd-4a99-9340-7ef7f2ab73c0",
                                "sense_id": "c4d09bba-390c-3120-bf62-b72fbe4ffd51",
                                "text": "Je crois que le Seigneur va débabyloniser les assemblées qui fonctionnent au travers d’un clergé évangélique ou autre et peuvent très bien se passer de Lui, Jésus Christ, La Tête de Son Église."
                            },
                            {
                                "example_id": "f703beac-af95-4e92-a5c4-d9595f995cdb",
                                "sense_id": "c4d09bba-390c-3120-bf62-b72fbe4ffd51",
                                "text": "Voilà ce que disaient les juifs à Babylone en pensant à la montagne de Sion, voilà comment vous êtes chérie et désirée par tous vos amis de Rome qui ne sera débabylonisée que lorsque vous y viendrez."
                            },
                            {
                                "example_id": "71898c66-2501-4c03-8dbc-7a57a540f1cc",
                                "sense_id": "c4d09bba-390c-3120-bf62-b72fbe4ffd51",
                                "text": "Il faut se débabyloniser !"
                            }
                        ]
                    }
