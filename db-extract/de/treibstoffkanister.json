                "senses": [
                    {
                        "sense_id": "e804926f-0585-3eef-b3ad-c98252e8125f",
                        "entry_id": "2d90aa05-82b6-3c22-b22f-4210073e57c4",
                        "glosses": [
                            "verschließbarer Behälter, meist aus Blech, Plastik, der zum Transport und Aufbewahren von Treibstoff benutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "879c6e16-12da-46ec-ba55-82935338d004",
                                "sense_id": "e804926f-0585-3eef-b3ad-c98252e8125f",
                                "text": "Der Treibstoffkanister wurde gestohlen."
                            },
                            {
                                "example_id": "0383eeea-93f7-4c19-b46c-8c97651c07f1",
                                "sense_id": "e804926f-0585-3eef-b3ad-c98252e8125f",
                                "text": "„An der Reling hat Trinks die letzten roten Treibstoffkanister festgezurrt, die ihn auf Spitzbergen mit Diesel versorgten und darüber hinaus als Sitz, Schreibtisch und Landebahnmarkierung für Hubschrauberbesuche dienten.“"
                            },
                            {
                                "example_id": "56c066ce-d9e0-448e-84a1-e1a097193f34",
                                "sense_id": "e804926f-0585-3eef-b3ad-c98252e8125f",
                                "text": "„Pro Jahr verkauft das Unternehmen allein 2000 Treibstoffkanister und 500 Aluminium Luftlandebleche an Wüstenfahrer.“"
                            },
                            {
                                "example_id": "742a908f-3378-4b67-b6d9-ea985d34c82e",
                                "sense_id": "e804926f-0585-3eef-b3ad-c98252e8125f",
                                "text": "„Demnach hatten Mitarbeiter der Hilfsorganisation der Armee telefonisch die Koordinaten ihrer Schule sowie der Treibstoffkanister durchgegeben, als der Beschuss anfing.“"
                            },
                            {
                                "example_id": "35e6b373-b6c5-40d0-9a86-6572ed178275",
                                "sense_id": "e804926f-0585-3eef-b3ad-c98252e8125f",
                                "text": "„Für einen Absturz verlief die Tragödie erstaunlich langsam: Eine Stunde lang kämpfte die Besatzung um ihr Schiff. Die Marinesoldaten warfen Treibstoffkanister über Bord, um das Gewicht der \"USS Macon\" zu verringern.“"
                            },
                            {
                                "example_id": "45e9fba7-e022-4b86-ba71-dbbc2ff43380",
                                "sense_id": "e804926f-0585-3eef-b3ad-c98252e8125f",
                                "text": "„Das vor einem Bürogebäude des Energieversorgers Con Edison geparkte Auto war einem Angestellten aufgefallen, weil auf dem Rücksitz zwei Treibstoffkanister lagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
