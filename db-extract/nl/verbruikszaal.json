                        "examples": [
                            {
                                "example_id": "b7a0dfa8-9e30-4263-8c32-430d9653844f",
                                "sense_id": "3f02ef10-4490-3502-a97f-6493746e6ac4",
                                "text": "Een paar maanden geleden kocht Vadis Odjidja het Chinees restaurant Mee Ah in Sint-Niklaas. De middenvelder van Club Brugge telde 655.000 euro neer voor de verbruikszaal en de aanpalende villa."
                            },
                            {
                                "example_id": "eadf89fd-2131-486a-8bef-3160c09981b2",
                                "sense_id": "3f02ef10-4490-3502-a97f-6493746e6ac4",
                                "text": "“Naast een werklustige attitude, kijken we naar flexibiliteit, communicatieve vaardigheden en de fysieke capaciteit om bijvoorbeeld vlot in een verbruikszaal te functioneren”, legt Lien Leroy uit."
                            }
                        ]
