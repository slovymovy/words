                                "fr": "Le <w>globe</w> terrestre tourne sur son axe en vingt-quatre heures."
                            }
                        },
                        {
                            "text": "Er wonen miljarden mensen op deze <w>aardbol</w>.",
                            "target_lang_translations": {
                                "fr": "Des milliards de personnes vivent sur ce <w>globe</w>."
                            }
