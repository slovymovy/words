        "fr-extract.jsonl": [
            {
                "entry_id": "68ae523b-695a-30b1-87cd-a089d16f45e9",
                "word": "évidence",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f863b31c-11d2-4a55-a655-1dda8d9c1308",
                        "entry_id": "68ae523b-695a-30b1-87cd-a089d16f45e9",
                        "tags": [
                            "plural"
                        ],
                        "form": "évidences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9ed27cdb-1e63-31db-ad7a-6ff11a80ebea",
                        "entry_id": "68ae523b-695a-30b1-87cd-a089d16f45e9",
                        "glosses": [
                            "Chose immédiatement perceptible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4748a331-b88c-42cd-8880-029c5b92ea87",
                                "sense_id": "9ed27cdb-1e63-31db-ad7a-6ff11a80ebea",
                                "text": "Puis brochant sur le tout vient l’héréticité de Dante démontrée, mais démontrée contre l’évidence."
                            },
                            {
                                "example_id": "1f59a124-882a-445f-b1a1-ce4d73d67457",
                                "sense_id": "9ed27cdb-1e63-31db-ad7a-6ff11a80ebea",
                                "text": "Dieu ne se manifeste pas aux hommes avec toute l'évidence qu'il pourrait faire."
                            },
                            {
                                "example_id": "14524682-c7c1-479c-8ef0-b39b6becee0e",
                                "sense_id": "9ed27cdb-1e63-31db-ad7a-6ff11a80ebea",
                                "text": "[…] c’est l’histoire du petit homme qui se baisse pour passer sous l’Arc de Triomphe : ici l’illogisme est accompagné d’une vanité également risible et rendue pleinement et instantanément sensible par l’évidence, qui nous apparaît immédiate et absolue."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e9ecb6b-c9f5-39b1-997b-0ace377ccfc3",
                        "entry_id": "68ae523b-695a-30b1-87cd-a089d16f45e9",
                        "glosses": [
                            "Chose immédiatement compréhensible."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "63d3a466-76ac-4e3a-9768-6d4da455f16d",
                                "sense_id": "6e9ecb6b-c9f5-39b1-997b-0ace377ccfc3",
                                "text": "Si vous êtes venu uniquement pour expliquer des évidences comme celles-là, vous feriez tout aussi bien de repartir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "952aec85-8057-47dd-84cf-d08640ad0844",
                        "source_entry_id": "68ae523b-695a-30b1-87cd-a089d16f45e9",
                        "target_lang_word": "Selbstverständlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstverständlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58a4610e-7439-3d4e-8804-af616620a3d4",
                                        "entry_id": "30c9fdc0-b3b8-3078-9458-0df2534f3009",
                                        "glosses": [
                                            "etwas, das ohne Zweifel für richtig gehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42656732-3ed7-427c-b336-ba371d1d0903",
                                                "sense_id": "58a4610e-7439-3d4e-8804-af616620a3d4",
                                                "text": "„Für die Menschen aus Duderstadt, Heiligenstadt und Worbis war es gleichwohl eine Selbstverständlichkeit, zum Broterwerb in die Fremde zu ziehen, aber daheim auf dem Eichsfeld die eigenen Wurzeln zu pflegen.“"
                                            },
                                            {
                                                "example_id": "ebeffb34-2473-4aa8-aedf-cf55b3aed155",
                                                "sense_id": "58a4610e-7439-3d4e-8804-af616620a3d4",
                                                "text": "„Ohnehin sei juristische Forschung, wie sie jetzt in Kooperation mit den russischen Strafrechtlern erfolgt […], keine Selbstverständlichkeit, so der Potsdamer Rechtswissenschaftler.“"
                                            },
                                            {
                                                "example_id": "806a7f1a-decb-483a-96dd-9c06499ace6e",
                                                "sense_id": "58a4610e-7439-3d4e-8804-af616620a3d4",
                                                "text": "„Bei einer bestimmten Politikergeneration ist die Korruption eine Selbstverständlichkeit, ein Privileg, ein natürliches Recht.“"
                                            },
                                            {
                                                "example_id": "9727d9d4-502e-4935-971f-47dee644d975",
                                                "sense_id": "58a4610e-7439-3d4e-8804-af616620a3d4",
                                                "text": "„Vor allem aber waren da unsere Familien, die uns klarmachten, dass unser Vorgebirgsstraßenhimmel keine Selbstverständlichkeit war.“"
                                            },
                                            {
                                                "example_id": "21245ad7-2493-487f-a33f-caf3f90353be",
                                                "sense_id": "58a4610e-7439-3d4e-8804-af616620a3d4",
                                                "text": "„Es ist wohl möglich, daß später einmal irgendein besonderer Geist sich findet, der meine anscheinend phantastischen Berichte als nüchterne Selbstverständlichkeiten zu erklären vermag – ein klarer und scharfer Geist, weniger exaltiert als ich, der in den Umständen, die ich mit bebender Scheu enthülle, nichts weiter sieht als die einfache Folge ganz natürlicher Ursachen und Wirkungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c9561bd-6906-49da-bdfc-e453f0dac1c6",
                        "source_entry_id": "68ae523b-695a-30b1-87cd-a089d16f45e9",
                        "target_lang_word": "Evidenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Evidenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27120745-37e3-316b-8c46-f43b42697673",
                                        "entry_id": "d2a27a18-41c2-348a-8507-7f009e6c7c2b",
                                        "glosses": [
                                            "unmittelbar ohne Beweis überzeugende Einsicht"
                                        ],
                                        "tags": [
                                            "Naturwissenschaften"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5644034c-2294-47a2-a78d-43dd1de1a466",
                                                "sense_id": "27120745-37e3-316b-8c46-f43b42697673",
                                                "text": "Die Untersuchungen ergaben eine eindeutige Evidenz für seine Schuld."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4f8894f9-fc46-3728-804a-d6bb10c935a2",
                                        "entry_id": "d2a27a18-41c2-348a-8507-7f009e6c7c2b",
                                        "glosses": [
                                            "klares, handliches Verzeichnis"
                                        ],
                                        "tags": [
                                            "Amtssprache",
                                            "Kaufmannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51b2abd8-cd84-4151-a597-399db8c1fee4",
                                                "sense_id": "4f8894f9-fc46-3728-804a-d6bb10c935a2",
                                                "text": "„Der Rektor bzw. die Rektorin hat hinsichtlich der zum Studium an der Pädagogischen Hochschule zugelassenen Studierenden eine Evidenz zu führen, die neben der Matrikelnummer als bildungseinrichtungsspezifisches Personenkennzeichen die gemäß dem Bildungsdokumentationsgesetz, BGBl. I Nr. 12/2002, zu erfassenden Daten zu enthalten hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3d3a2279-cc9e-38d2-851a-dfe3f99f13b9",
                                        "entry_id": "d2a27a18-41c2-348a-8507-7f009e6c7c2b",
                                        "glosses": [
                                            "empirisch erbrachter Nachweis der Wirksamkeit einer Maßnahme oder Behandlung in Prävention, Diagnostik, Therapie, Rehabilitation. Durch Anschauung oder Untersuchung feststellbarer Beweis beziehungsweise Gesamtheit an Beweisen"
                                        ],
                                        "tags": [
                                            "Pflege",
                                            "Gesundheitswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81622c73-f27e-4f68-8dd6-6549c31b48eb",
                                                "sense_id": "3d3a2279-cc9e-38d2-851a-dfe3f99f13b9",
                                                "text": "Bisher gibt es keine Evidenz für die Wirkung von Ginkgopräparaten gegen Tinnitus."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "186a1afa-1433-42cd-82a6-8b00e1520a71",
