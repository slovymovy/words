        "fr-extract.jsonl": [
            {
                "entry_id": "adbdb78a-ab76-3233-ac56-bf06d13407bb",
                "word": "hyperlien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c3ddd7e7-a234-4f23-a393-0639993f93d5",
                        "entry_id": "adbdb78a-ab76-3233-ac56-bf06d13407bb",
                        "tags": [
                            "plural"
                        ],
                        "form": "hyperliens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1567a1bf-191d-3eb8-b137-fb311fa6192e",
                        "entry_id": "adbdb78a-ab76-3233-ac56-bf06d13407bb",
                        "glosses": [
                            "Référence dans un système hypertexte permettant de passer automatiquement d'un document consulté à un document lié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b63292e7-1b56-4992-8541-bae4c035926a",
                                "sense_id": "1567a1bf-191d-3eb8-b137-fb311fa6192e",
                                "text": "L'activation de l'élément source d'un hyperlien permet de passer automatiquement à sa destination."
                            },
                            {
                                "example_id": "e96fc51c-4dc6-4ba5-88d4-93f507dde93a",
                                "sense_id": "1567a1bf-191d-3eb8-b137-fb311fa6192e",
                                "text": "Les éditeurs imaginent de nouveaux modes de lecture plus interactifs, avec un foisonnement d’hyperliens, voire des connexions à Facebook, ce qui permettrait de communiquer avec un lecteur qui lit le même livre que vous."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2795870f-0796-4687-9bb8-8f48f0ef6371",
                        "source_entry_id": "adbdb78a-ab76-3233-ac56-bf06d13407bb",
                        "source_sense_id": "1567a1bf-191d-3eb8-b137-fb311fa6192e",
                        "target_lang_word": "Hyperlink",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hyperlink",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa011e90-5afc-3446-8360-f74f15110fae",
                                        "entry_id": "3717f298-825f-32a4-99ce-6bc08fb98df7",
                                        "glosses": [
                                            "Querverweis in Hypertexten (vor allem auf Internetseiten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "072640a3-299c-40dd-ae1a-9adb6c7b3edc",
                                                "sense_id": "fa011e90-5afc-3446-8360-f74f15110fae",
                                                "text": "„Wenn der Hyperlink ausgeführt wird, wird automatisch das darin angegebene Ziel aufgerufen. Im Allgemeinen wird der Begriff auf das World Wide Web bezogen, in dem Hyperlinks ein Kernbestandteil sind. Inhaltlich entspricht das Konzept von Hyperlinks Querverweisen in der gedruckten Literatur, deren Ziel dort allerdings in der Regel manuell aufgesucht werden muss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f83e0035-6525-461a-83cf-6c2d6e938c8a",
                        "source_entry_id": "adbdb78a-ab76-3233-ac56-bf06d13407bb",
                        "source_sense_id": "1567a1bf-191d-3eb8-b137-fb311fa6192e",
                        "target_lang_word": "hyperlink",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperlink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21f804fc-1b04-3ecd-bd02-b84e76553826",
                                        "entry_id": "5a45b3fe-c802-38da-8cac-2b988c577615",
                                        "glosses": [
                                            "Some text or a graphic in an electronic document that can be activated to display another document or trigger an action."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9c7189b-d372-41f7-bbe0-3b3dfab2b220",
                                                "sense_id": "21f804fc-1b04-3ecd-bd02-b84e76553826",
                                                "text": "Click the hyperlink to go to the next page."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ae8bad7-7691-3d83-a33e-a8d906a2144e",
                                        "entry_id": "5a45b3fe-c802-38da-8cac-2b988c577615",
                                        "glosses": [
                                            "The URL or other address that defines a hyperlink's target or function."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c43a2d7-716b-4283-999b-5df882ee69db",
                                                "sense_id": "0ae8bad7-7691-3d83-a33e-a8d906a2144e",
                                                "text": "Copy the hyperlink and paste it into an email."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hyperlink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a65c87ee-490f-35cb-a7a0-aa10ea94b500",
                                        "entry_id": "eaad4ea4-b7ad-3f5d-9ffc-d651b6e1cc21",
                                        "glosses": [
                                            "To point to another document by a hyperlink."
                                        ],
                                        "tags": [
                                            "of a hypertext document"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7423616-2e50-4ada-8ca3-5a25d4f03531",
                                                "sense_id": "a65c87ee-490f-35cb-a7a0-aa10ea94b500",
                                                "text": "Their Web page hyperlinks to your Web site."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e82755d-08ce-3992-977b-d027a0be6ad6",
                                        "entry_id": "eaad4ea4-b7ad-3f5d-9ffc-d651b6e1cc21",
                                        "glosses": [
                                            "To add a hyperlink to a document."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ecebd56-32a4-43a0-aab2-5278e940c43f",
                                                "sense_id": "8e82755d-08ce-3992-977b-d027a0be6ad6",
                                                "text": "One valuable thing a blogger often does is hyperlink to magazine and newspaper stories or other interesting blogs, she says."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20314f20-3b68-3723-9b69-a041c08bb5fb",
                                        "entry_id": "eaad4ea4-b7ad-3f5d-9ffc-d651b6e1cc21",
                                        "glosses": [
                                            "To use a hyperlink to jump to a document."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45edc544-8711-4b34-b6e5-95e8ddd48da6",
                                                "sense_id": "20314f20-3b68-3723-9b69-a041c08bb5fb",
                                                "text": "Indeed, what consumers will see on a Web site is likely to vary depending on the point or Web page at which they access the Web site, how many pages they “hyperlink” through when reviewing the site, and how much of the page containing the disclosure is displayed by consumers' Web browsers without requiring additional scrolling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
