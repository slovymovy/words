                        "source_entry_id": "19ec6f9e-2cce-37f0-a83b-53a22f4c9fd1",
                        "source_sense_description": "type of sand",
                        "target_lang_word": "sables mouvants",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sables mouvants",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ccf5ebef-d06a-33d8-9ae9-d71974fe7264",
                                        "entry_id": "c4c4d6c2-8752-3eea-b190-625fb6f4f7bf",
                                        "glosses": [
                                            "Zones de sol en apparence ferme mais dans lesquelles on s’enlise, parfois dangereusement, lorsqu’on s’y engage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03e5d9a7-cee6-4c19-8b72-5aa0e95b96c3",
                                                "sense_id": "ccf5ebef-d06a-33d8-9ae9-d71974fe7264",
                                                "text": "J’ai failli moi-même être englouti avec mon cheval par les sables mouvants du Tahaddart, entre Tanger et Azila, et j’ai manqué me noyer dans l’embouchure du Tensift."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c02484f9-fd80-36f3-9e77-2c04cc4bcaa3",
                                        "entry_id": "c4c4d6c2-8752-3eea-b190-625fb6f4f7bf",
                                        "glosses": [
                                            "Situation périlleuse où une action mal à propos peut envenimer les choses."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a15486e1-fb21-4ea0-8edc-2a1ee0bcdf05",
                                                "sense_id": "c02484f9-fd80-36f3-9e77-2c04cc4bcaa3",
                                                "text": "C’est ainsi que le gouvernement Legault, comme tous les autres d’ailleurs, se voit forcé d’affronter la tempête sur des sables mouvants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9465761e-0ac8-4170-bd82-8b917d9b1231",
