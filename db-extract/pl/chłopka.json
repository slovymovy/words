                    {
                        "translation_id": "c20b953e-15aa-4512-aebc-386b10cdbe8a",
                        "source_entry_id": "84e1e402-d854-3687-b41e-78dc7636136e",
                        "source_sense_id": "bf5de43c-5a74-3c72-bc8a-5013332c9795",
                        "target_lang_word": "Bäuerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bäuerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebdcb3c8-317a-305c-b88b-63144b6af13f",
                                        "entry_id": "6ce48ac7-1a3d-35e1-b14c-82a14aaa9ef9",
                                        "glosses": [
                                            "weibliche Person, die eine Landwirtschaft betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b1b4de-d1a9-4d37-b90c-c0fefee20e09",
                                                "sense_id": "ebdcb3c8-317a-305c-b88b-63144b6af13f",
                                                "text": "Jeden Herbst fängt die Bäuerin an mit Kartoffellesen."
                                            },
                                            {
                                                "example_id": "615d6959-7c40-49f6-b2a6-faf25472fae8",
                                                "sense_id": "ebdcb3c8-317a-305c-b88b-63144b6af13f",
                                                "text": "„Dagegen mussten 7 Millionen Bäuerinnen und Bauern mit 16,4 Millionen Hektar auskommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aca1b783-d8a6-38d2-aeef-8997f12c692a",
                                        "entry_id": "6ce48ac7-1a3d-35e1-b14c-82a14aaa9ef9",
                                        "glosses": [
                                            "Ehefrau eines Bauern, eines Mannes, der eine Landwirtschaft betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4752216-ea3f-40d7-b82c-eaf569e7720a",
                                                "sense_id": "aca1b783-d8a6-38d2-aeef-8997f12c692a",
                                                "text": "„Er läßt sich der Bäuerin gegenüber auch nie etwas merken, er nicht und kein anderer.“"
                                            },
                                            {
                                                "example_id": "d258f072-5f5d-4fac-bb02-9b1b882fea9f",
                                                "sense_id": "aca1b783-d8a6-38d2-aeef-8997f12c692a",
                                                "text": "„Kurze Zeit später kommt die Bäuerin nach Hause.“"
                                            },
                                            {
                                                "example_id": "2bf1544b-492c-4563-81f7-749b6e2cf6a9",
                                                "sense_id": "aca1b783-d8a6-38d2-aeef-8997f12c692a",
                                                "text": "„Geschäftig trug die Hausfrau, eine hübsche blonde Bäuerin wie aus dem Bilderbuch, Mettwurst, Käse, Brot und Schinken herbei, während ihr Mann die Bierflaschen aufploppen ließ.“"
                                            },
                                            {
                                                "example_id": "e1b39092-ec5a-4ec8-9bc9-66225c4cd8fb",
                                                "sense_id": "aca1b783-d8a6-38d2-aeef-8997f12c692a",
                                                "text": "„Die Bäuerin bringt uns sogar Federbetten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
