                                "target_senses": [
                                    {
                                        "sense_id": "e61420c6-441e-352c-b2ff-e9abbf7e93c0",
                                        "entry_id": "58955f93-b489-3e4b-89e3-53d4eb2dd20e",
                                        "glosses": [
                                            "Professionnelle du bâtiment qui réalise des éléments architecturaux en pierre de taille."
                                        ],
                                        "tags": [
                                            "Taille de pierre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b493a13-5cb7-4fa5-96b9-fc2883e3ebdb",
                                                "sense_id": "e61420c6-441e-352c-b2ff-e9abbf7e93c0",
                                                "text": "C’est une tailleuse de pierre, spécialiste des monuments anciens, qui a restauré les murs du moulin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37667a01-c529-4af8-a9e1-78bc9e1d7fab",
                        "source_entry_id": "671dc710-739e-3380-ac12-0fcb8635c0ed",
                        "source_sense_description": "one who cuts stone",
                        "target_lang_word": "Steinschneider",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steinschneider",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05670607-6d6b-3db7-8fca-404895f48885",
                                        "entry_id": "4a12cc51-990c-3623-be5d-16dc80b0806a",
                                        "glosses": [
                                            "derjenige Wundarzt, der für die Entfernung von Blasensteinen zuständig war"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c46e893-30ea-4e21-88f9-e0997808e48b",
                                                "sense_id": "05670607-6d6b-3db7-8fca-404895f48885",
                                                "text": "„Durch diese Konzilsentscheidung war die […] Abspaltung der Arbeit des Wundarztes von derjenigen des Arztes begründet. Teile der ärztlichen Versorgung wurden so zum Gegenstand handwerklich erlernter und ausgeübter Berufe, und meist übten gelernte Bader die Kunst des Steinschneiders, Starstechers oder Bruchschneiders ausschließlich oder neben ihrem eigentlichen Metier aus.“"
                                            },
                                            {
                                                "example_id": "a0c0e337-0c0d-4ff3-8e1d-f1f041d75c1d",
                                                "sense_id": "05670607-6d6b-3db7-8fca-404895f48885",
                                                "text": "„Eine besondere Stellung zwischen höheren und niederen Ärzten nehmen die Steinschneider ein, diejenigen Heilkundigen, die es verstehen, Blasen-, Nieren- und Gallensteine durch operative Eingriffe zu entfernen.“"
                                            },
                                            {
                                                "example_id": "7e07eb3f-1e9d-4d50-9051-143b71785cbf",
                                                "sense_id": "05670607-6d6b-3db7-8fca-404895f48885",
                                                "text": "Im mittleren Europa sind besonders die Gegenden am Rheine, die Küstenländer der Ost- und Nordsee […] den Urinsteinen häufig unterworfen, und dieses geht soweit, dasz z.B. in Holland die Wundärzte sich auf ihren Schilden gewöhnlich den Titel Steinschneider beilegen, als von einer ihrer vornehmsten Operation.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24eec994-5339-3edb-8602-cd4fde06cdd9",
                                        "entry_id": "4a12cc51-990c-3623-be5d-16dc80b0806a",
                                        "glosses": [
                                            "Facharbeiter, der Edelsteine schneidet"
                                        ],
                                        "tags": [
                                            "Kunsthandwerk"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
