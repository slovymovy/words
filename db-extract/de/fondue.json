                        "entry_id": "c7ef5817-c0c5-3fe7-9263-493e0cd6b781",
                        "glosses": [
                            "Gericht, bei dem Brotstücke in eine Zubereitung auf der Basis von geschmolzenem Käse getaucht werden"
                        ],
                        "tags": [
                            "ursprünglich"
                        ],
                        "examples": [
                            {
                                "example_id": "a8562527-1396-4d40-a374-a2481a3fc30d",
                                "sense_id": "af61a523-a4d2-3e68-8b7e-ebb686844405",
                                "text": "Fondue ist ein typisch schweizerisches Gericht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ed72e2ac-1049-37fd-9a7b-ddfced4fb9d0",
                        "entry_id": "c7ef5817-c0c5-3fe7-9263-493e0cd6b781",
                        "glosses": [
                            "ein Gericht, bei dem mundgerecht Happen in einen Sud, heißes Fett oder eine andere erhitzte Flüssigkeit getaucht werden"
                        ],
                        "tags": [
                            "generell"
                        ],
                        "examples": [
                            {
                                "example_id": "0f6e5b05-bd9a-4f3d-b02f-e157b34eb6be",
                                "sense_id": "ed72e2ac-1049-37fd-9a7b-ddfced4fb9d0",
                                "text": "Zu Silvester essen wir gerne Fondue oder Raclette."
                            },
                            {
                                "example_id": "982078ff-6087-4da7-bedf-e6a42e7d4605",
                                "sense_id": "ed72e2ac-1049-37fd-9a7b-ddfced4fb9d0",
                                "text": "„An Silvester wurde abends das Fondue in Betrieb gesetzt.“"
                            }
