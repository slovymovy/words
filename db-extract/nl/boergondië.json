                                    {
                                        "sense_id": "a2928ea5-e577-370f-87e0-72850426785c",
                                        "entry_id": "2e4d34a8-dfaf-34a3-9f3c-e4f26b1b12ca",
                                        "glosses": [
                                            "Region im Zentrum Frankreichs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ef553ef-296e-4596-ac8b-09f2390e60f4",
                                                "sense_id": "a2928ea5-e577-370f-87e0-72850426785c",
                                                "text": "Die Regionalhauptstadt von Burgund ist Dijon."
                                            },
                                            {
                                                "example_id": "d56f0dff-38d8-49c3-b382-8934f3015889",
                                                "sense_id": "a2928ea5-e577-370f-87e0-72850426785c",
                                                "text": "„Die Ritter Burgunds und Frankreichs ritten einer kleinen Anhöhe entgegen, und die Anführer brachten ihre Pferde am höchsten Punkt zum Stehen.“"
                                            },
                                            {
                                                "example_id": "3c41685a-4d83-44fd-a6f0-f587961cf34e",
                                                "sense_id": "a2928ea5-e577-370f-87e0-72850426785c",
                                                "text": "„Hier, im heutigen Burgund, bahnte sich der entscheidende Kampf zwischen Römern und Galliern an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de5c499e-e483-44d9-bd4b-26721010ecfe",
                        "source_entry_id": "4497355d-7835-3a2f-a40b-41f20cf8afaf",
                        "source_sense_id": "1d2c75ab-1696-3b24-bb46-8b9a458f7826",
                        "source_sense_description": "een van de 26 regio's van Frankrijk",
                        "target_lang_word": "Burgundy",
