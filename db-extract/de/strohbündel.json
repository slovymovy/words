                "senses": [
                    {
                        "sense_id": "7d40a3df-e621-394c-bf05-438efe82ce5b",
                        "entry_id": "f56715b6-8413-3a1d-b1aa-e2b8e5dcbbbf",
                        "glosses": [
                            "Menge zusammengebundener Strohhalme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c4b9fda-d756-4162-a3b2-9dfddc4c5a66",
                                "sense_id": "7d40a3df-e621-394c-bf05-438efe82ce5b",
                                "text": "„Wir hatten keine Betten bekommen und mußten uns mit einigen Strohbündeln begnügen, die längs der Mauer im Hofe aufgeschüttet waren.“"
                            },
                            {
                                "example_id": "f2ab2b20-35c2-469d-a6f9-3576bc7392b0",
                                "sense_id": "7d40a3df-e621-394c-bf05-438efe82ce5b",
                                "text": "„Der Kutscher stand auf und ließ die Peitsche auf die gerade erst mit Strohbündeln abgeriebenen glänzenden Kruppen niedersausen und trieb die Pferde mit einem tatarischen Ruf an.“"
                            },
                            {
                                "example_id": "3b0ededf-e67e-4897-bb9d-0cd2270ee412",
                                "sense_id": "7d40a3df-e621-394c-bf05-438efe82ce5b",
                                "text": "„Und ihre Blicke irrten über den Haufen Bausteine hin, über das ekelhafte Wasser, in dem ein Strohbündel schwamm, über einen Fabrikschornstein, der sich am Horizont erhob; Kloakendünste stiegen empor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
