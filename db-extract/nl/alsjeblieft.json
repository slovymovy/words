                                                "sense_id": "32484e48-3dec-3803-92b6-806a05d7a81c",
                                                "text": "Gibst du mir das Buch bitte wieder."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f14be6ec-6b40-3114-b8cd-52f381360fc7",
