                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epagomenal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "843bdf89-f278-32f5-b4cc-10a15c0d3114",
                                        "entry_id": "0c031c09-b685-3196-9c31-10a6968c0e51",
                                        "glosses": [
                                            "induced, provided"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca1f6385-17bf-43e1-9995-d89e295f3270",
                                                "sense_id": "843bdf89-f278-32f5-b4cc-10a15c0d3114",
                                                "text": "The gods are immortal and therefore they are not born in the human social time of the year; they are born \"outside\" in the larger frame of the epagomenal days."
                                            },
                                            {
                                                "example_id": "8daa86d4-b6bb-4ca4-9119-5925e3c8eb67",
                                                "sense_id": "843bdf89-f278-32f5-b4cc-10a15c0d3114",
                                                "text": "[The Ancient Egyptian calendar had] 12 months each 30 days long followed by five epagomenal days."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
