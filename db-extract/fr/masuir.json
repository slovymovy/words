                ],
                "senses": [
                    {
                        "sense_id": "3066dad9-0b50-39f2-bd39-4f5ed0607dd6",
                        "entry_id": "b6740e6e-553c-3692-be4d-1e2ba9c849a3",
                        "glosses": [
                            "Membre d'une communauté villageoise propriétaire de biens ou de droits d'usage, communaux ou collectifs."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "c78841e9-cd14-4068-b8ce-685abe5d0fac",
                                "sense_id": "3066dad9-0b50-39f2-bd39-4f5ed0607dd6",
                                "text": "Dans nos environs il existe encore des masuirs autre part qu'à Châtelineau, et quoiqu'il n'en portent pas le nom, ainsi les habitants du hameau de Roselies sont propriétaires de bois et de biens dont le reste des habitants de la commune de Presle, de laquelle ils font partie, ne peuvent pas jouir. Ce sont de véritables masuirs."
                            },
                            {
                                "example_id": "b8aad153-e193-48ce-a11e-1cd93e98abbc",
                                "sense_id": "3066dad9-0b50-39f2-bd39-4f5ed0607dd6",
                                "text": "[…] ; mais depuis l'accord avec le seigneur et le chapitre, (c'est l'accord de 1274), les masuirs sont en possession du droit de tailler dans le bois tout ce que bon leur semble, sauf les hêtres et les chênes, et à condition de payer chacun une redevance annuelle d'un setier d'avoine, d'une poule, à la satisfaction des échevins, et d'un denier ou d'un pain de même valeur. Tout masuir que le sergent assermenté du chapitre trouvera coupant ou emportant un chêne ou un hêtre, sera mis à l'amende de sept sous."
                            },
                            {
                                "example_id": "e7196157-0f3c-4dac-95ac-141de30da8b3",
                                "sense_id": "3066dad9-0b50-39f2-bd39-4f5ed0607dd6",
                                "text": "L’affouager ne peut vendre la portion qui lui est échue si ce n'est à des masuirs résidant au dit lieu."
                            }
                        ]
                    }
                ],
