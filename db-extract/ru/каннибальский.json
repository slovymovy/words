                        "cross_references": []
                    },
                    {
                        "translation_id": "ab2b951e-14e7-45f2-9c63-5e5225bfb539",
                        "source_entry_id": "3b5869bf-1c5e-33aa-b348-6ad050cfaf75",
                        "target_lang_word": "kanibalski",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kanibalski",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "9502ce2e-ad11-3bc0-9f39-9f2fb9f7e32f",
                                        "entry_id": "3ef39051-0356-3235-a734-f1e186148e6a",
