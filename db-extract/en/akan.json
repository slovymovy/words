                                    {
                                        "sense_id": "c9f52a0e-3077-308b-8273-c66a66e93fff",
                                        "entry_id": "e564cf09-8a69-3c5b-8644-6dba8cab2d07",
                                        "glosses": [
                                            "in Westafrika gesprochene Gruppe von Sprachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc2d26b6-4ea5-4d96-b5f6-ea234fcc8a2b",
                                                "sense_id": "c9f52a0e-3077-308b-8273-c66a66e93fff",
                                                "text": "„Akan bezeichnet eine recht kleine Sprachfamilie, die zwei Sprachen umfaßt: das Fanti […] und das Twi[.]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a034343c-dac8-3edf-a51b-362b6ea53928",
                                        "entry_id": "e564cf09-8a69-3c5b-8644-6dba8cab2d07",
                                        "glosses": [
                                            "Sprache, die Vertreter dieser Sprachfamilie ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1237f834-2bc7-488e-8574-70524e2a5c7c",
                                                "sense_id": "a034343c-dac8-3edf-a51b-362b6ea53928",
                                                "text": "„Es entwickelten sich multiethnische und multilinguale Freundschaftsnetzwerke, in denen Hausa, Yorùbá, Dagbani, Akan, und Englisch gesprochen wurde.“"
                                            },
                                            {
                                                "example_id": "3b96e3ff-e578-4a5c-848e-f9b699150f77",
                                                "sense_id": "a034343c-dac8-3edf-a51b-362b6ea53928",
                                                "text": "„Akan ist die am weitesten verbreitete gesprochene Sprache, und sein Einflussbereich als Schriftsprache erweitert sich ständig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
