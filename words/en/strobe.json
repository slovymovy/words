{
    "word_family": [
        "stroboscopic",
        "stroboscope"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2a7f5bc2-259a-324e-b73d-31f92fc654af",
                    "sense_definition": "A device that produces regular, rapid flashes of light.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "light_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The photographer used a <w>strobe</w> to capture the dancer in mid-air.",
                            "target_lang_translations": {
                                "it": "Il fotografo ha usato uno <w>stroboscopio</w> per immortalare il ballerino a mezz'aria."
                            }
                        },
                        {
                            "text": "The <w>strobe</w> light flashed rhythmically across the crowded dance floor.",
                            "target_lang_translations": {
                                "it": "La luce <w>stroboscopica</w> lampeggiava ritmicamente sulla pista da ballo affollata."
                            }
                        }
                    ],
                    "synonyms": [
                        "stroboscope"
                    ],
                    "common_phrases": [
                        "strobe light"
                    ],
                    "target_lang_definitions": {
                        "it": "Dispositivo che produce lampi di luce regolari e rapidi."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "stroboscopio",
                                "target_lang_sense_clarification": "termine tecnico per il dispositivo"
                            },
                            {
                                "target_lang_word": "luce stroboscopica",
                                "target_lang_sense_clarification": "riferito all'effetto luminoso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cc85438-9986-3462-bb35-f29129d8c730",
                    "sense_definition": "An electronic signal indicating that data is ready to be processed or read.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical_signal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The processor waits for the memory <w>strobe</w> before reading the data.",
                            "target_lang_translations": {
                                "it": "Il processore attende lo <w>strobe</w> di memoria prima di leggere i dati."
                            }
                        },
                        {
                            "text": "A data <w>strobe</w> ensures that the signal is stable during transmission.",
                            "target_lang_translations": {
                                "it": "Uno <w>strobe</w> di dati assicura che il segnale sia stabile durante la trasmissione."
                            }
                        }
                    ],
                    "common_phrases": [
                        "data strobe"
                    ],
                    "target_lang_definitions": {
                        "it": "Segnale elettronico che indica che i dati sono pronti per essere elaborati o letti."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "strobe",
                                "target_lang_sense_clarification": "termine tecnico usato in informatica"
                            },
                            {
                                "target_lang_word": "segnale di sincronizzazione",
                                "target_lang_sense_clarification": "descrizione funzionale del segnale"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9058b807-0d18-3ed2-adfc-7cd3650b13f9",
                    "sense_definition": "To emit light in rapid, regular flashes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "light_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The emergency lights began to <w>strobe</w> as the alarm sounded.",
                            "target_lang_translations": {
                                "it": "Le luci di emergenza hanno iniziato a <w>lampeggiare</w> quando è suonato l'allarme."
                            }
                        },
                        {
                            "text": "The faulty bulb started to <w>strobe</w> in the dark hallway.",
                            "target_lang_translations": {
                                "it": "La lampadina difettosa ha iniziato a <w>lampeggiare</w> nel corridoio buio."
                            }
                        }
                    ],
                    "synonyms": [
                        "flicker",
                        "flash"
                    ],
                    "target_lang_definitions": {
                        "it": "Emettere luce in lampi rapidi e regolari."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "lampeggiare",
                                "target_lang_sense_clarification": "emettere lampi di luce"
                            },
                            {
                                "target_lang_word": "emettere luce stroboscopica",
                                "target_lang_sense_clarification": "descrizione dell'azione specifica"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}