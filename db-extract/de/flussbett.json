                        "form": "die Flussbetten"
                    },
                    {
                        "form_id": "d130f406-bfd0-47a4-a90f-e94713254bd7",
                        "entry_id": "ff91fd18-54f7-3ce4-95c9-963f749d3a48",
                        "tags": [
                            "accusative",
