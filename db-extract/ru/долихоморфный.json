                "senses": [
                    {
                        "sense_id": "9344eae6-a8ec-32fe-81b2-35b9db2dc429",
                        "entry_id": "57729a26-a1fd-3687-a651-35f033bef29f",
                        "glosses": [
                            "характеризующийся коротким туловищем и длинными конечностями"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2abb60b1-f7ce-4c75-bf20-66e587fb29c8",
                                "sense_id": "9344eae6-a8ec-32fe-81b2-35b9db2dc429",
                                "text": "Разница в длине тела между людьми в основном зависит от длины нижних конечностей. Поэтому долихоморфный тип более характерен для людей высокого роста, брахиморфный — низкого роста."
                            }
                        ]
                    }
