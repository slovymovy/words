                        "glosses": [
                            "ein schrecklicher Tag für eine Person oder eine Gesellschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ad744ba-4038-4f8c-b5a6-f48a319d0f43",
                                "sense_id": "9a9d9ba0-f8c9-3852-ba0e-d5ec48d131af",
                                "text": "„Hier war der 15. Oktober jener Schreckenstag, der selbst die an ähnliche Phänomene gewöhnten Bewohner des flachen Landes in Furcht und namenlose Angst versetzte.“"
                            },
                            {
                                "example_id": "d69e9063-a420-4444-8e79-05caee43c67c",
                                "sense_id": "9a9d9ba0-f8c9-3852-ba0e-d5ec48d131af",
                                "text": "„Während der Schreckenstage hielt er sich verborgen.“"
                            }
                        ],
