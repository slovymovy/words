                                        "entry_id": "a2b04554-6dca-380c-951d-cf0fa069c601",
                                        "glosses": [
                                            "zweites Prophase-Stadium der Meiose I (Reduktionsteilung), in dem die homologen Chromosomen abschnittweise mit der Paarung beginnen"
                                        ],
                                        "tags": [
                                            "Zytologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cce3f5d-d265-446d-8f08-13927a385c5a",
                                                "sense_id": "b207d67b-3c5a-334d-aa9d-c039e7f9c639",
                                                "text": "„Im Zygotän sieht man, dass die Chromosomen paarweise angeordnet sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
