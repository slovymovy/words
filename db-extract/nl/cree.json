                                                "sense_id": "bcc8859c-17b4-32ad-892c-e1c4544d1921",
                                                "text": "„Doch die seit 13.000 Jahren in diesen Wäldern lebenden Cree und Chipewyan fanden hier früher offenbar alles, was sie zum Leben brauchten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
