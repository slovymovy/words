                "senses": [
                    {
                        "sense_id": "35d93185-ab02-3aa1-bbc4-f848ba5cfddb",
                        "entry_id": "421fdf1d-2f01-3f04-8fee-6dcc9fa2fa0a",
                        "glosses": [
