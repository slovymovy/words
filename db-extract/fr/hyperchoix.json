                        "glosses": [
                            "Choix à faire parmi un grand nombre d’options."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f495816-3b1a-49d8-bc24-68b01e746353",
                                "sense_id": "0759a0e5-9317-3f60-a2af-1dff782e4e7b",
                                "text": "Mais ce monde de l’hyperchoix engendre souvent un sentiment au mieux de satisfaction molle, voire d’hyperdéception car la qualité n’est pas toujours au rendez-vous."
                            },
                            {
                                "example_id": "19debc4c-dd16-4672-b36e-4dc6f4d6ed7a",
                                "sense_id": "0759a0e5-9317-3f60-a2af-1dff782e4e7b",
                                "text": "L’auteur revient sur le problème paradoxal clé du marketing : comment maintenir le consommateur en haleine en renouvelant l’offre… mais sans le noyer dans un hyperchoix confusant."
                            }
                        ]
                    },
                    {
                        "sense_id": "8859acb0-1c4e-34f3-8b08-c9e52887aa15",
                        "entry_id": "3e6531f9-1eea-3a74-90fe-e5e1d419bf60",
                        "glosses": [
                            "Choix intense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cba6176d-ee8f-4c2b-a1ef-c9d78e6fa96e",
                                "sense_id": "8859acb0-1c4e-34f3-8b08-c9e52887aa15",
                                "text": "Par ailleurs, la complexité des problèmes place les décideurs dans une logique de l’hyperchoix : il faut trouver un équilibre entre des exigences de régulation et de légitimation souvent antagonistes dans un environnement technique et social incertain."
                            }
                        ]
