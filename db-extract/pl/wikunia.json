                                "example_id": "d892b4f5-25cf-47f2-aef9-f3960decad87",
                                "sense_id": "0d7f0687-769d-32c9-ad28-47a7f8375cab",
                                "text": "„Marynarkę z wełny wikunii kupił za 10 tys. euro jeden z najbogatszych Polaków.“"
                            }
