                "senses": [
                    {
                        "sense_id": "072ddc5f-74c7-3365-8be9-fcc99750d835",
                        "entry_id": "96fbd0b0-f522-36e2-a752-2fc11e20f8ea",
                        "glosses": [
                            "nährstoffreiches Futtermittel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fe6b196-1b27-4d80-91cf-5c53d3fb69c9",
                                "sense_id": "072ddc5f-74c7-3365-8be9-fcc99750d835",
                                "text": "Ihrem Hochleistungsorganismus – eingestellt auf stetigen Nachschub an Kraftfutter – reichten Löwenzahn, Klee und Pfeifengras bei Weitem nicht, um den Betrieb aufrechtzuerhalten."
                            },
                            {
                                "example_id": "c8cd1fc5-280f-4e73-8e63-1827f3b77e9a",
                                "sense_id": "072ddc5f-74c7-3365-8be9-fcc99750d835",
                                "text": "„Die Reichszuckerstelle hatte das Monopol im offiziellen Zuckerhandel, die Reichsfuttermittelstelle organisierte die Versorgung der Viehhalter mit Hafer, Gerste und Kraftfutter aus Küchenabfällen, für die spezielle Sammelwagen durch die Straßen fuhren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
