                "translations": [
                    {
                        "translation_id": "f363e5d6-0d4f-40d5-9cca-2b0084ee1623",
                        "source_entry_id": "8cdd782c-db37-3a50-978e-259e81e49413",
                        "source_sense_id": "73a9cf42-fe98-3821-9313-45562f0867b9",
                        "target_lang_word": "Kalashnikov",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kalashnikov",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62750b6e-2cfb-3f76-a029-40bc377e249c",
                                        "entry_id": "f5031647-e5b9-326e-a134-707bf72b821f",
                                        "glosses": [
                                            "A particular model of Russian assault rifle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91c3e7df-8ebd-4f3a-9ac8-24b21e923ddb",
                                                "sense_id": "62750b6e-2cfb-3f76-a029-40bc377e249c",
                                                "text": "A Cameroonian soldier lies in a trench, the tip of his Kalashnikov rifle pointing toward the Nigerian town of Gambaru, which has been taken over by Boko Haram terrorists."
                                            },
                                            {
                                                "example_id": "bdd2b85d-ee09-44eb-94ee-6c253854c61b",
                                                "sense_id": "62750b6e-2cfb-3f76-a029-40bc377e249c",
                                                "text": "So, we are prepared to bear arms and yesterday we were given Kalashnikovs so we will be able to resist if Russian forces will come to Kyiv."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da0c6168-a1dd-36f1-8974-108c2b996340",
                                        "entry_id": "f5031647-e5b9-326e-a134-707bf72b821f",
                                        "glosses": [
                                            "A transliteration of the Russian surname Кала́шников (Kalášnikov)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce6def9f-da2f-42b1-a08c-a0efff0bb953",
                                                "sense_id": "da0c6168-a1dd-36f1-8974-108c2b996340",
                                                "text": "As if he were assembling a collection of Russian scary stories, the director Dmitrii Kalashnikov makes the bizarre beguiling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f49e3c1-edea-4806-9463-672c78ba4fcd",
                        "source_entry_id": "8cdd782c-db37-3a50-978e-259e81e49413",
                        "source_sense_id": "73a9cf42-fe98-3821-9313-45562f0867b9",
                        "target_lang_word": "kalachnikov",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kalachnikov",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d09617ab-86c7-3f00-a135-b19d5896b383",
                                        "entry_id": "e2b7e0cf-d12f-3fc5-9c87-4dc830a4905d",
                                        "glosses": [
                                            "Fusil d’assaut AK-47."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce7b5134-f0c5-4ad0-9056-0c4f43bc8fe7",
                                                "sense_id": "d09617ab-86c7-3f00-a135-b19d5896b383",
                                                "text": "En Seine-Saint-Denis, c’est le lycée Paul-Éluard qui a dû être ratissé après que la direction a reçu un mail malveillant, signé par un pseudo-terroriste qui prévient avoir placé une bombe dans le bâtiment et annonce qu’il viendra « exterminer tous les kuffars demain avec [sa] kalachnikov »."
                                            },
                                            {
                                                "example_id": "593225c1-5dbc-440b-872a-83ad713cc123",
                                                "sense_id": "d09617ab-86c7-3f00-a135-b19d5896b383",
                                                "text": "Des détonations de kalachnikovs crevèrent le silence d’une nuit sans bombardements."
                                            },
                                            {
                                                "example_id": "b57f3691-1327-43f7-8d62-eb6e9eb87e89",
                                                "sense_id": "d09617ab-86c7-3f00-a135-b19d5896b383",
                                                "text": "Pour les combattants de l’État islamique, point n’est besoin de visa ni de passeport pour passer de la Syrie à l’Irak et vice versa. La kalachnikov suffit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86335cb1-827e-36b0-a6cd-5894fbf67ab4",
                                        "entry_id": "e2b7e0cf-d12f-3fc5-9c87-4dc830a4905d",
                                        "glosses": [
                                            "Tout fusil d’assaut faisant partie de la gamme créée par Mikhaïl Kalachnikov pour l’armée de l’Union soviétique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "570c1304-f232-45ec-97e4-7d3539a4860d",
                        "source_entry_id": "8cdd782c-db37-3a50-978e-259e81e49413",
                        "source_sense_id": "73a9cf42-fe98-3821-9313-45562f0867b9",
                        "target_lang_word": "kalashnikov",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kalashnikov",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96a6fa8a-9492-34f1-b6de-c8514860f2d4",
                                        "entry_id": "e4a5fd44-85b9-3787-9e52-fce957af39e8",
                                        "glosses": [
                                            "Variante orthographique de kalachnikov (arme)."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aec78482-5300-4b11-b729-ea8a0b7a8662",
                                                "sense_id": "96a6fa8a-9492-34f1-b6de-c8514860f2d4",
                                                "text": "Il résista à la tentation de l’enfermer et partit chercher un Colt 45 et une kalashnikov dans la cachette que Martin lui avait indiquée, en lui montrant les lieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2b0aa39-a6dd-4dea-ab1c-165fbb612a14",
                        "source_entry_id": "8cdd782c-db37-3a50-978e-259e81e49413",
                        "source_sense_id": "73a9cf42-fe98-3821-9313-45562f0867b9",
                        "target_lang_word": "калаш",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "калаш",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5e26635e-eb26-3ae9-90ca-9eb55ed71215",
                                        "entry_id": "b9b608c0-d5bc-318a-a19c-92da45607a2b",
                                        "glosses": [
                                            "разг. автомат Калашникова — ручное автоматическое огнестрельное оружие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85a41253-a813-4d5b-ae3f-0141a96bbacc",
                                                "sense_id": "5e26635e-eb26-3ae9-90ca-9eb55ed71215",
                                                "text": "Все эти россказни о том, что во Вьетнаме американцы при первом удобном случае бросали свои винтовки «М-14» и «М-16» и норовили повоевать нашим «калашом», ― сущий бред."
                                            },
                                            {
                                                "example_id": "50327a82-967d-41eb-b96b-e2efe9bff44b",
                                                "sense_id": "5e26635e-eb26-3ae9-90ca-9eb55ed71215",
                                                "text": "Я поднимаю голову и вижу двух мрачных арабских парней, не хватает только «калашей» на груди."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "калаш",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ae5e8f23-07d1-3ed9-83e2-a22f0b678ace",
                                        "entry_id": "cef43eee-ab5c-3507-8782-bc6df03d83fb",
                                        "glosses": [
                                            "этногр. представитель народа Калаши, проживающего на севере Пакистана в горах Гиндукуша"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73d5a613-e6fb-4e59-85a9-2029056066fb",
                                                "sense_id": "ae5e8f23-07d1-3ed9-83e2-a22f0b678ace",
                                                "text": "Это калаши — представители одного из малочисленных народов, проживающих в горах на севере Пакистана. Они возвращаются в своё селение после трудового дня на лесозаготовках в соседней долине."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a671afe-7dc0-38cf-8fbe-ec6b6553914a",
                                        "entry_id": "cef43eee-ab5c-3507-8782-bc6df03d83fb",
                                        "glosses": [
                                            "этногр., истор. то же, что халадж; представитель малочисленного тюркоязычного народа в Иране"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23c1f179-78fd-4757-932e-a854e5f5f723",
                                                "sense_id": "4a671afe-7dc0-38cf-8fbe-ec6b6553914a",
                                                "text": "Тюркский род «калаш» — вероятно, халадж — карлукское племя."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "калаш",
                                "target_lang_code": "ru",
                                "target_senses": [
