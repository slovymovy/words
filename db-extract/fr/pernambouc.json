            {
                "entry_id": "b880b08b-f2c0-30f7-b65c-a2bdd19ca218",
                "word": "Pernambouc",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "448a78f9-a65c-4e47-a957-796799125558",
                        "entry_id": "b880b08b-f2c0-30f7-b65c-a2bdd19ca218",
                        "tags": [],
                        "form": "Pernambuco"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "26647667-13c8-3869-8d73-ba8865c259c7",
                        "entry_id": "b880b08b-f2c0-30f7-b65c-a2bdd19ca218",
                        "glosses": [
                            "État fédéré du Brésil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0f36cb2-3bd5-4116-af2f-fe3e8c92edf2",
                                "sense_id": "26647667-13c8-3869-8d73-ba8865c259c7",
                                "text": "Beaucoup de dévotes les imitèrent, ainsi qu'une brigade de mulheres da capona, ces femmes qui sévissaient dans tout le Nordeste, entre le Pernambouc, le Maranhão et la Bahia, fagotées comme l'as de pique, ou plutôt emmaillotées dans des jupes, des caracos, des peaux de chats ou de chiens, des chandails et des vieilleries."
                            }
                        ]
                    },
                    {
                        "sense_id": "946e5d52-b857-3271-b20b-555e97229e18",
                        "entry_id": "b880b08b-f2c0-30f7-b65c-a2bdd19ca218",
                        "glosses": [
                            "Ancien nom de la ville de Recife."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2c8f999-78e6-4fa5-9077-11df3938e0df",
                                "sense_id": "946e5d52-b857-3271-b20b-555e97229e18",
                                "text": "Atterrissant de nuit à Pernambouc, la Croix du Sud au-dessus de ma tête, entouré d’hommes à peau sombre, je trouvai affichée l’information du bombardement de Barcelone et la nouvelle qu’un ami espagnol, avec qui j’avais passé de bons moments quelques mois auparavant, venait d’être fusillé."
                            },
                            {
                                "example_id": "fa9c2f71-3613-4dd6-83eb-b5adcab81251",
                                "sense_id": "946e5d52-b857-3271-b20b-555e97229e18",
                                "text": "La police de Pernambouc n’aurait plus qu’à se tenir tranquille. Ce n’est pas ce qu’elle décide. Pourquoi ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "571337cd-2880-40bb-9f45-080ff33034e2",
                        "source_entry_id": "b880b08b-f2c0-30f7-b65c-a2bdd19ca218",
                        "target_lang_word": "Pernambuco",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
