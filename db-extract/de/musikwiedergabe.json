                ],
                "senses": [
                    {
                        "sense_id": "5c894bab-0cad-38e7-838c-22007728033b",
                        "entry_id": "abc3cfe3-100c-3cc9-82e6-cf3d80a89be9",
                        "glosses": [
                            "Prozess, bei dem Musik mit Hilfe eines technischen Geräts (beispielsweise eines Lautsprechers, Kopfhörers oder Radios) abgespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ede420bb-d339-409b-9c56-f8e49d51eb61",
                                "sense_id": "5c894bab-0cad-38e7-838c-22007728033b",
                                "text": "„Eine Neuheit für Smartphones der Samsung-Galaxy-Reihe ist die Verwendung von zwei Lautsprechern für die Musikwiedergabe.““"
                            },
                            {
                                "example_id": "bd0421c9-ccd4-4978-8478-4fa79bc48a6b",
                                "sense_id": "5c894bab-0cad-38e7-838c-22007728033b",
                                "text": "„Heute wird von einer guten Audioanlage für Musikwiedergabe erwartet, dass ihre spezifizierten Daten die Hi-Fi-Werte wesentlich übertreffen.“"
                            },
                            {
                                "example_id": "98704a97-aa1c-4ed8-9fac-3b893325169e",
                                "sense_id": "5c894bab-0cad-38e7-838c-22007728033b",
                                "text": "„Doch auch wenn sich heute ganz andere Techniken der Musikwiedergabe durchgesetzt haben – die elegante Form des Grammophons steht bis heute für die Liebe zur Musik und für die Möglichkeit, einmalige künstlerische Erlebnisse endlich festzuhalten.“"
                            },
                            {
                                "example_id": "a22e6fd3-6400-47da-988e-8e7870826d2c",
                                "sense_id": "5c894bab-0cad-38e7-838c-22007728033b",
                                "text": "„Zur Steuerung der Musikwiedergabe ist auf der Außenseite der Kopfhörer ein Touchpad angebracht.“"
                            },
                            {
                                "example_id": "a4fa4500-6d58-486f-8c8d-b32f8745cc8e",
                                "sense_id": "5c894bab-0cad-38e7-838c-22007728033b",
                                "text": "[Kopfhörer:] „Fernbedienung: Im Kabel eingebaut, können damit etwa die Lautstärke, Musikwiedergabe und Anrufe gesteuert werden.“"
                            },
                            {
                                "example_id": "ab2b13de-c5f6-44ca-b8a1-6248d6368891",
                                "sense_id": "5c894bab-0cad-38e7-838c-22007728033b",
                                "text": "„Lautsprecher mit eingebauten Sprachassistenten, sogenannte Smart Speaker, erfreuen sich immer größerer Beliebtheit. Sie können Fragen beantworten, per Sprache die Musikwiedergabe steuern, die App für den Einkauf aktivieren oder einfach nur das Licht im smart home an- und ausschalten.“"
                            },
                            {
                                "example_id": "ff6e37ad-cea9-4e9b-8873-b783938ffd28",
                                "sense_id": "5c894bab-0cad-38e7-838c-22007728033b",
                                "text": "[Akkulaufzeit:] „Nach Angaben von Apple beträgt sie bis zu 17 Stunden bei der Video- sowie bis zu 55 Stunden bei der Musikwiedergabe.“"
                            },
                            {
                                "example_id": "10abfb53-4118-4f83-99f1-d3330553dc37",
                                "sense_id": "5c894bab-0cad-38e7-838c-22007728033b",
                                "text": "„Wenn Facebook oft beim Öffnen die Musikwiedergabe unterbricht, können gezielte Änderungen in den Einstellungen helfen.“"
                            },
                            {
                                "example_id": "cecaa30e-ad9a-4c5c-81f8-ad3ee187509f",
                                "sense_id": "5c894bab-0cad-38e7-838c-22007728033b",
                                "text": "[Plattenspieler:] „Zur Musikwiedergabe wird dieses Signal entzerrt, verstärkt und einem Lautsprechersystem zugeführt.“"
                            },
                            {
                                "example_id": "4312822f-528f-403e-8b1e-e64c1aa88097",
                                "sense_id": "5c894bab-0cad-38e7-838c-22007728033b",
                                "text": "„Die SA-CD ist perfekt und überraschend. Perfekt für jene, denen Mittelmaß in der Musikwiedergabe ein Grauen ist. Überraschend für diejenigen (Audiophilen), die gedacht hätten, Schallplatten seien das Höchste der Gefühle.“"
                            },
                            {
                                "example_id": "4fcd25d0-3ebe-40c7-878c-aece7b56b0e8",
                                "sense_id": "5c894bab-0cad-38e7-838c-22007728033b",
                                "text": "„Ganz entscheidende Faktoren für eine hochwertige Musikwiedergabe sind, neben den HiFi-Komponenten oder den Lautsprechern, die räumlichen Gegebenheiten, unter denen Musik gehört wird […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
