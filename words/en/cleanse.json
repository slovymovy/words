    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a241e38c-b93d-3597-8b7f-abecd5ba76c9",
                    "sense_definition": "To remove dirt or impurities from something to make it clean.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "purification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor used a special solution to <w>cleanse</w> the wound before applying a bandage."
                        },
                        {
                            "text": "You should <w>cleanse</w> your face every night to remove makeup and oil."
                        }
                    ],
                    "synonyms": [
                        "cleansing"
                    ],
                    "common_phrases": [
                        "cleanse the skin",
                        "cleanse the wound"
                    ]
                },
                {
