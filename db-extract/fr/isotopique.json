                "senses": [
                    {
                        "sense_id": "d164a5bb-3fba-3cf2-9bb7-b7255eae6abe",
                        "entry_id": "a3150bf8-eb58-3ec0-90ca-5f38c47ca190",
                        "glosses": [
                            "Relatif aux isotopes."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "915fd7b6-e392-439f-b149-e391c29aa32c",
                                "sense_id": "d164a5bb-3fba-3cf2-9bb7-b7255eae6abe",
                                "text": "Des données isotopiques, en particulier le rapport O¹⁸/O¹⁶, reflètent le volume de glace sur terre, donc les variations du niveau marin et les paléotempératures."
                            },
                            {
                                "example_id": "a01af4a0-f2d7-49a2-811b-934e486b50ba",
                                "sense_id": "d164a5bb-3fba-3cf2-9bb7-b7255eae6abe",
                                "text": "L'équipe menée par Michael Dee et Margot Kuitems, respectivement professeur de chronologie isotopique et archéologue au Centre de recherche isotopique de l'Université néerlandaise de Groningue, a contourné l'obstacle avec une méthode originale."
                            },
                            {
                                "example_id": "668de161-b2ef-4466-bc01-4f9ee629acd5",
                                "sense_id": "d164a5bb-3fba-3cf2-9bb7-b7255eae6abe",
                                "text": "D’autres méthodes permettent de mesurer ou d’estimer la phytodisponibilité des métaux : cultures tests, tests microbiologiques, méthodes isotopiques, extractions chimiques sélectives et modélisation."
                            }
                        ]
                    }
                ],
