                    },
                    {
                        "form_id": "53f0eb2b-747c-4a16-9074-cfd047f5a8a0",
                        "entry_id": "80a9dbfc-c05d-3e35-93ef-9431c8f88173",
                        "tags": [
                            "diminutive",
                            "singular"
                        ],
                        "form": "orakeltje"
                    },
                    {
                        "form_id": "c305ceb1-c99a-4300-b062-8b50dcb9e521",
                        "entry_id": "80a9dbfc-c05d-3e35-93ef-9431c8f88173",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "orakeltjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2963bb88-dcaf-386f-8500-957a261fd001",
                        "entry_id": "80a9dbfc-c05d-3e35-93ef-9431c8f88173",
                        "glosses": [
                            "persoon die geraadpleegd kan worden voor het doen van voorspellingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd2fcfd1-4b06-4da9-9b2e-cd8d5ee8e3dc",
                                "sense_id": "2963bb88-dcaf-386f-8500-957a261fd001",
                                "text": "In Delfi huisde een orakel dat zich bedwelmde met dampen die uit de grond stegen en daarna raadselachtige uitspraken deed."
                            },
                            {
                                "example_id": "fbd8940e-da8a-46c2-8985-86be1c15063d",
                                "sense_id": "2963bb88-dcaf-386f-8500-957a261fd001",
                                "text": "Zijn bijnaam ‘de Redder’ verwierf hij in 305, toen hij de bewoners van Rhodos bijstond in hun conflict met een andere diadochus. De dankbare bevolking noemde hem vanaf dat moment Soter en vereerde Ptolemaeus op aanraden van een Egyptisch orakel als een god."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ca1b56d-77c2-387e-a5d2-8ddcfeac7856",
                        "entry_id": "80a9dbfc-c05d-3e35-93ef-9431c8f88173",
                        "glosses": [
                            "profetische boodschap, vaak geformuleerd in vage bewoordingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbe3ea2b-f91c-4938-a6bb-ec91eefd3c81",
                                "sense_id": "7ca1b56d-77c2-387e-a5d2-8ddcfeac7856",
                                "text": "Sterk verbonden hiermee is het orakel dat Homeros ontving van de Pythia, die hem waarschuwde voor een raadsel."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9dc3d7c-df61-35ea-b013-2ec85ae9ad89",
                        "entry_id": "80a9dbfc-c05d-3e35-93ef-9431c8f88173",
                        "glosses": [
                            "persoon die als vraagbaak dient, iemand die als alwetend wordt beschouwd"
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "dceee328-49d5-40db-832c-596cd2793920",
                                "sense_id": "e9dc3d7c-df61-35ea-b013-2ec85ae9ad89",
                                "text": "Volgens intimi was Danny uit Amsterdam-Zuid de enige die hem de waarheid vertelde. Wilde een Hilversumse of Catalaanse televisie-interviewer Cruijff weleens schaapachtig aangrijzen als hij abracadabra had verkondigd, na thuiskomst kon het orakel in zulke gevallen op een welgemeend ‘nou, daar was dus weer geen touw aan vast te knopen!’ worden onthaald."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6b97598-8934-4068-b909-cbefb173c6d1",
                        "source_entry_id": "80a9dbfc-c05d-3e35-93ef-9431c8f88173",
                        "target_lang_word": "oracle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oracle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a421e5e-a5bd-3f3e-884e-2725aee6f383",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "A shrine dedicated to some prophetic deity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0582bfba-eb29-4c56-8902-9e7faa325cc2",
                                                "sense_id": "8a421e5e-a5bd-3f3e-884e-2725aee6f383",
                                                "text": "The oracles are dumb; / No voice or hideous hum / Runs through the arched roof in words deceiving."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad8a5df5-ac94-3663-a08e-a5869555d405",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "A person such as a priest through whom the deity is supposed to respond with prophecy or advice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd2b8153-92be-3e4c-85b9-61c215f45f98",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "A prophetic response, often enigmatic or allegorical, so given."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd1eb9a4-ddd4-487d-9794-51cd18f27a48",
                                                "sense_id": "bd2b8153-92be-3e4c-85b9-61c215f45f98",
                                                "text": "The several oracles included in this haftarah presumably were uttered at different times to the people in exile, presenting diverse themes and using distinct styles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02318338-5cdd-3e82-952d-eb66c5932505",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "Something said that must come true or cannot be countermanded; an inexorable command or declaration."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38e8ad4b-76f1-46cd-85f1-60d850c71d9b",
                                                "sense_id": "02318338-5cdd-3e82-952d-eb66c5932505",
                                                "text": "Fight all couragiouſly and be you kings,\nI ſpeake it, and my words are oracles."
                                            },
                                            {
                                                "example_id": "dc7f7270-60ff-4bec-96dd-de5fdf657679",
                                                "sense_id": "02318338-5cdd-3e82-952d-eb66c5932505",
                                                "text": "Shee ſtiles her ſelfe their Chiefe, and ſweares ſhee will command; / And, what-ſo-ere ſhee ſaith, for Oracles muſt ſtand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea10ca8b-4fb0-358a-8bb7-e43c8e7f5d24",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "A person considered to be a source of wisdom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "418982dc-d69e-422c-8c5f-56fc724c15af",
                                                "sense_id": "ea10ca8b-4fb0-358a-8bb7-e43c8e7f5d24",
                                                "text": "a literary oracle"
                                            },
                                            {
                                                "example_id": "591c721e-7c2c-4f24-bed8-1c8f15b9c9f9",
                                                "sense_id": "ea10ca8b-4fb0-358a-8bb7-e43c8e7f5d24",
                                                "text": "oracles of mode"
                                            },
                                            {
                                                "example_id": "f7f84de6-fa1e-46af-86ef-59024952af52",
                                                "sense_id": "ea10ca8b-4fb0-358a-8bb7-e43c8e7f5d24",
                                                "text": "The country rectors […] thought him an oracle on points of learning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d6cea83-52ad-3e66-8246-c5d0dd05b76b",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "A wise sentence or decision of great authority."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8e3addb-4efa-30ac-a8e2-8fa1893af18e",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "A fortune-teller."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2e7c1f9-af7c-467f-a723-698f01da4aee",
                                                "sense_id": "f8e3addb-4efa-30ac-a8e2-8fa1893af18e",
                                                "text": "\"Madame de l'Hôpital has been quite la fée bienfaisante\" said Lauzun, who, like others, had been consulting the oracle. \"I am bewildered by my future good fortune. I quite anticipate being married, if it is to bring me all that she predicts.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eefbeb79-aeb2-360d-bbb7-7c20bc7d94f9",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "One who communicates a divine command; an angel; a prophet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "765c0ee3-8dff-4cb2-96f1-141bc11643eb",
                                                "sense_id": "eefbeb79-aeb2-360d-bbb7-7c20bc7d94f9",
                                                "text": "God hath now sent his living oracle / Into the world to teach his final will."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f111fd60-0027-3eec-a488-7459959dc30b",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "The sanctuary, or most holy place in the temple; also, the temple itself."
                                        ],
                                        "tags": [
                                            "Jewish",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd3d8eb5-400c-425e-a0b4-3127f07834de",
                                                "sense_id": "f111fd60-0027-3eec-a488-7459959dc30b",
                                                "text": "And the oracle he prepared in the house within, to set there the ark of the covenant of the Lord."
                                            },
                                            {
                                                "example_id": "7713c32f-9a94-4e67-be23-22fb9ddd8d5a",
                                                "sense_id": "f111fd60-0027-3eec-a488-7459959dc30b",
                                                "text": "Siloa's brook, that flow'd / Fast by the oracle of God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cec5f827-7a64-3275-b836-bda5b2c79111",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "A theoretical entity capable of answering some collection of questions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ea953fb-f35b-454e-aee4-6d924a9d85c5",
                                                "sense_id": "cec5f827-7a64-3275-b836-bda5b2c79111",
                                                "text": "Thus, an oracle machine (which enacts an oracle algorithm) would be like an ordinary Turing machine, except that adjoined to its ordinary computational operations would be another operation: ‘Call in the oracle and ask it whether C_q(n) stops; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "263da348-91d0-3ac2-a15d-f49e86994463",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "A third-party service that provides smart contracts with information from the outside world."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c29e6d4-5e32-4d5e-aa4f-eeaac13df4b7",
                                                "sense_id": "263da348-91d0-3ac2-a15d-f49e86994463",
                                                "text": "For example, an oracle may send temperature data reported by the National Weather Service or report the daily LIBOR rate to a smart contract."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "oracle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "893fb953-c072-3813-b5f2-7fd770d801e9",
                                        "entry_id": "52408674-6c5c-3282-a58c-7a0f5b6aa824",
                                        "glosses": [
                                            "To utter oracles or prophecies."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50736301-6ac3-4b8d-af77-518c824c629b",
                                                "sense_id": "893fb953-c072-3813-b5f2-7fd770d801e9",
                                                "text": "But this thy glory shall be soon retrench'd;\nNo more shalt thou by oracling abuse\nThe Gentiles; henceforth Oracles are ceast"
                                            },
                                            {
                                                "example_id": "0005812f-8b8a-4353-a11b-ab7a9c6a04b1",
                                                "sense_id": "893fb953-c072-3813-b5f2-7fd770d801e9",
                                                "text": "Primarily seen as a publicity vehicle for late-year releases, the awards show and its promoters have lately made pretensions to Oscar oracling: Jamie Foxx won the “breakthrough actor of the year” prize for “Ray” in 2004, after all, and Paul Haggis and his ensemble cast were honored for “Crash” four months before it won best picture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20cfbe58-a1dd-4ca7-86b8-f8f0c194c742",
                        "source_entry_id": "80a9dbfc-c05d-3e35-93ef-9431c8f88173",
                        "target_lang_word": "oráculo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oráculo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e38234d4-f550-3985-8aee-250f231ad27d",
                                        "entry_id": "21f0a196-5073-3e7b-824a-e23ca1163826",
                                        "glosses": [
                                            "Respuesta que da un dios por sí o por medio de sus ministros."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48ba1a20-cf2c-4aea-a86e-ac4cfa51163e",
                                                "sense_id": "e38234d4-f550-3985-8aee-250f231ad27d",
                                                "text": "«Mira en cuántos errores cayeron por no confesar que los sacó el Dios verdadero. Y no cayeron en falsedad menos diabólica los que dijeron (según Josefo refiere) que algunos reyes de Egipto desearon ver a Dios, sobre lo cual, consultados sus oráculos, respondieron que no lo alcanzarían sino excluían primero a todos los leprosos y enfermos, contra los cuales, parece Cristo haber dicho: «Bienaventurados los limpios de corazón, porque verán a Dios». Y estos pensaban que la lepra corporal lo estorbaba»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b054b2a2-8e85-3266-9188-cb9ff5a9f561",
                                        "entry_id": "21f0a196-5073-3e7b-824a-e23ca1163826",
                                        "glosses": [
                                            "Lugar, estatua o simulacro que representaba la deidad cuyas respuestas se pedían."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8a17a25-259f-418b-8cd8-d09800662153",
                                                "sense_id": "b054b2a2-8e85-3266-9188-cb9ff5a9f561",
                                                "text": "«Desde que fueron engolfados, libres de la visión de la injusta tierra samotrichiana, deliberaron dirigir a la isla délfica, en donde era el oráculo de Apolo»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0785cfae-f8e9-3524-b865-e10012000969",
                                        "entry_id": "21f0a196-5073-3e7b-824a-e23ca1163826",
                                        "glosses": [
                                            "Persona a quien todos escuchan con respeto y veneración por su mucha sabiduría y doctrina."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39f554d6-06a8-4f4c-9e5d-23cf09b33d61",
                                                "sense_id": "0785cfae-f8e9-3524-b865-e10012000969",
                                                "text": "«Las campañas están deshabitadas, y por buscar remedio convenible, fueron con buen consejo (sin respuesta) al oráculo y dioles tal respuesta: que era fuerza buscar una doncella, hermosa tanto y más que la pasada, y al desdeñado Proteo ofrecerla, en lugar de la muerte sentenciada»."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "22014cb1-ca36-44b6-b3f5-7f062677916b",
