                "senses": [
                    {
                        "sense_id": "40615224-8f39-387b-9b66-17a14feec19e",
                        "entry_id": "e11b467e-a70d-370d-b990-c09e4ee84bb9",
                        "glosses": [
                            "спец. определение месторасположения чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bca61f4-d767-4113-a46e-3fd3ba91760e",
                                "sense_id": "40615224-8f39-387b-9b66-17a14feec19e",
                                "text": "Локализация неисправности"
                            }
                        ]
                    },
                    {
                        "sense_id": "6fd4eb99-b1af-377e-b615-d013e5c62d73",
                        "entry_id": "e11b467e-a70d-370d-b990-c09e4ee84bb9",
                        "glosses": [
                            "спец., мед., экон. сосредоточение какого-либо явления в одном месте"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feba4723-85b5-4308-9bb0-ed6dc428bc89",
                                "sense_id": "6fd4eb99-b1af-377e-b615-d013e5c62d73",
                                "text": "По локализации различают шейный, загрудинный, частично загрудинный, позадипищеводный зоб и зоб корня языка."
                            },
                            {
                                "example_id": "312bc628-f173-4e60-b034-74e49ed4a4d4",
                                "sense_id": "6fd4eb99-b1af-377e-b615-d013e5c62d73",
                                "text": "Пока что речь идет о крупноузловой сборке, однако в будущем партнеры обещают увеличить локализацию производства."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5592ee1-b7cf-3645-b4d6-8036164abe9a",
                        "entry_id": "e11b467e-a70d-370d-b990-c09e4ee84bb9",
                        "glosses": [
