                "senses": [
                    {
                        "sense_id": "673f52c2-30d3-3204-a535-dcde1e679c42",
                        "entry_id": "9029dd75-8f42-3b03-a14c-bf63430feed7",
                        "glosses": [
                            "beschadiging door ouderdom en langdurig gebruik ook figuurlijk gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6802fe24-5eff-4779-b1be-0d5afa7c8fd5",
                                "sense_id": "673f52c2-30d3-3204-a535-dcde1e679c42",
                                "text": "Erik Bindervoet en Robbert-Jan Henkes hebben voor het voorjaar van 2016 een nieuwe Nederlandse vertaling van Dubliners aangekondigd. De vertaling van Rein Bloem uit 1968 vertoont flink wat slijtplekken en dubieuze weglatingen. De Standaard 13 AUGUSTUS 2015 OM 03:00 UUR"
                            },
                            {
                                "example_id": "eda5c608-f5a1-4d33-a1ff-d2d9869f6ee2",
                                "sense_id": "673f52c2-30d3-3204-a535-dcde1e679c42",
                                "text": "Het verhaal gaat over Ria en Pim Westra. Zij zijn 23 jaar getrouwd en hun relatie vertoont wat slijtplekjes. Kleine irritaties kunnen leiden tot grote meningsverschillen. Dochter Petra kiest vaak de zijde van haar vader. Het dienstmeisje Jossie draagt nou bepaald niet bij om de gemoederen wat te sussen."
                            },
                            {
                                "example_id": "b9318d27-b155-4018-a046-e674cdd8ca13",
                                "sense_id": "673f52c2-30d3-3204-a535-dcde1e679c42",
                                "text": "Om de taferelen zo levendig mogelijk te maken wilde Forrer ook graag perfectie voorkomen. „Er was een slijtplek in een antiek tapijt en ze zeiden: Die kunnen we repareren. Ik heb echt heel lang moeten praten om ze ervan te overtuigen die erin te laten.”"
                            }
                        ]
                    }
