    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e969f958-add1-3c55-9e6b-f2ae7a0d5717",
                    "sense_definition": "To push someone or something roughly or with force.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not <w>shove</w> other passengers while getting on the train.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>толкайте</w> других пассажиров при посадке в поезд.",
                                "zh": "上火车时，请不要<w>推搡</w>其他乘客。",
                                "cs": "Prosím, <w>nestrkejte</w> do ostatních cestujících při nastupování do vlaku."
                            }
                        },
                        {
                            "text": "He got angry and <w>shoved</w> the man against the wall.",
                            "target_lang_translations": {
                                "ru": "Он разозлился и <w>толкнул</w> мужчину к стене.",
                                "zh": "他生气了，把那个男人<w>猛推</w>到墙边。",
                                "cs": "Rozzlobil se a <w>vrazil</w> toho muže ke zdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "push",
                        "thrust",
                        "propel",
                        "ram"
                    ],
                    "antonyms": [
                        "pull",
                        "drag"
                    ],
                    "common_phrases": [
                        "shove around",
                        "shove aside",
                        "shove away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубо или с силой толкать кого-либо или что-либо.",
                        "zh": "粗暴地或用力地推某人或某物。",
                        "cs": "Hrubě nebo silou někoho či něco postrčit nebo odstrčit."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толкать",
                                "target_lang_sense_clarification": "применять физическую силу для перемещения"
                            },
                            {
                                "target_lang_word": "пихать",
                                "target_lang_sense_clarification": "толкать грубо или небрежно"
                            },
                            {
                                "target_lang_word": "толкнуть",
                                "target_lang_sense_clarification": "совершенный вид, однократное действие"
                            }
