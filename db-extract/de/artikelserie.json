                                "example_id": "b329d59c-800a-4e4d-a83a-6844ca76867b",
                                "sense_id": "3030b1ee-ded1-331b-bec9-8e704a28baea",
                                "text": "„In den ältesten Heften gibt es eine Artikelserie, in der Organe des menschlichen Körpers in der ersten Person von sich sprechen: Ich bin Janes Gebärmutter.“"
                            },
                            {
                                "example_id": "8696ec86-5300-47c4-a364-f6649c9a0809",
                                "sense_id": "3030b1ee-ded1-331b-bec9-8e704a28baea",
                                "text": "„Anfang 1966 brachte Ha’aretz eine Artikelserie über das Elend und die Ausbeutung arabischer Arbeiter.“"
                            }
