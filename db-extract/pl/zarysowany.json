                ],
                "senses": [
                    {
                        "sense_id": "e1090f29-135c-3ffd-96d7-91cda5179f67",
                        "entry_id": "9faa1249-c771-32a7-bdac-1ce98990ad63",
                        "glosses": [
                            "mający określony (wyraźny, ostry, łagodny) zarys"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5c49a11-84bf-4671-8ce0-2c477815683f",
                                "sense_id": "e1090f29-135c-3ffd-96d7-91cda5179f67",
                                "text": "Gdzieś z boku takie właśnie, krzywe wierzby dobiegały do ostro zarysowanej krawędzi drugiego lasu, jakby z biegu wpadając w ogromne morze wysokopiennych drzew"
                            },
                            {
                                "example_id": "7f4203d5-5be3-470b-a9d2-82401e0bd195",
                                "sense_id": "e1090f29-135c-3ffd-96d7-91cda5179f67",
                                "text": "Od konsekwentnej pracy zmierzającej do ich realizowania, od konkretnych sukcesów praktycznych, od wypełnienia zarysowanych ram organizacyjnych konkretnymi osiągnięciami artystycznymi zależeć będzie wiele"
                            },
                            {
                                "example_id": "4c8e5bfe-9c8e-4648-85ab-51ee2b815234",
                                "sense_id": "e1090f29-135c-3ffd-96d7-91cda5179f67",
                                "text": "Twarz ptasia z silnie zarysowanymi kośćmi policzkowymi"
                            },
                            {
                                "example_id": "ff9ea34a-6c42-4539-bf37-11db2bf41c1b",
                                "sense_id": "e1090f29-135c-3ffd-96d7-91cda5179f67",
                                "text": "Był duży, silny, barczysty. Miał jasne włosy i szare oczy, mocno zarysowaną szczękę"
                            },
                            {
                                "example_id": "bd65c845-5a66-4a0d-9a66-1404ddd5cf5e",
                                "sense_id": "e1090f29-135c-3ffd-96d7-91cda5179f67",
                                "text": "Nos orli, brwi zarysowane śmiało, wspaniale sklepione czoło i bujne włosy, tworzyły całość piękną i pociągającą"
                            },
                            {
                                "example_id": "a0fdb94f-bc3b-410e-87ae-97242837b9b4",
                                "sense_id": "e1090f29-135c-3ffd-96d7-91cda5179f67",
                                "text": "Zielono-złoty odblask liści nadawał dziwną miękość jéj niewieścim, łagodnie zarysowanym kształtom"
                            },
                            {
                                "example_id": "38ac3306-93a0-4dd1-aade-4b0cad030ebb",
                                "sense_id": "e1090f29-135c-3ffd-96d7-91cda5179f67",
                                "text": "Wysunął naprzód mocno zarysowaną szczękę, patrzył trochę nade mną, kiedy zapalał papierosa, wyczułem w nim pewne napięcie"
                            },
                            {
                                "example_id": "e72db0c9-ba36-4763-b173-0af8ad1e2480",
                                "sense_id": "e1090f29-135c-3ffd-96d7-91cda5179f67",
                                "text": "Spod pięknie zarysowanych brwi czarne oczy patrzyły śmiało, z nutką zadumy czy rozmarzenia, znamionując naturę otwartą, bezpośrednią, nieco marzycielską"
                            },
                            {
                                "example_id": "b3b1e3b0-0ae3-4b8c-8772-960fd05a109c",
                                "sense_id": "e1090f29-135c-3ffd-96d7-91cda5179f67",
                                "text": "Badacze struktur zauważyli bowiem charakterystyczne gwiazdy o ostro zarysowanych kształtach w strukturze mikro badanych przekrojów stopów kobaltu"
                            },
                            {
                                "example_id": "1e9ee7e6-5aee-405f-84e8-585a99c534b0",
                                "sense_id": "e1090f29-135c-3ffd-96d7-91cda5179f67",
                                "text": "Znane są trzy podstawowe odmiany barwne żmii zygzakowatej — srebrna bądź popielata (głównie samce) z ciemnym, wyraźnym zygzakiem ciemniejszym. Samice i młode są z reguły brunatne, brązowe, rdzawe, zygzak jest wtedy zarysowany słabiej. Rzadka jest odmiana czarna, bez zygzaka"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
