                ],
                "senses": [
                    {
                        "sense_id": "52d773c0-7c48-33b3-a024-465fd7b16265",
                        "entry_id": "bcf027f8-5949-3b4a-a398-cf99e1e3accf",
                        "glosses": [
                            "nachrangiger Luftstrom; zusätzliche / nachträgliche Luftbehandlung in einem Gerät, das nicht ursprünglich mit der Lüftung verbunden ist"
                        ],
                        "tags": [
                            "Lüftung"
                        ],
                        "examples": [
                            {
                                "example_id": "e96aee3b-1ef8-40f4-a64f-8d25c02428cf",
                                "sense_id": "52d773c0-7c48-33b3-a024-465fd7b16265",
                                "text": "„Die Sekundärluft strömt quellluftartig durch das Lüftungsgitter in den Raum.“"
                            },
                            {
                                "example_id": "33e1c942-3a55-4929-920e-732a30a86c2e",
                                "sense_id": "52d773c0-7c48-33b3-a024-465fd7b16265",
                                "text": "„Sollte die Primärluft im Winter mit einer niedrigeren Temperatur als die Raumluft zugeführt werden, entsteht ein zusätzlicher Heizbedarf, der von der Sekundärluft neben den Transmissionsverlusten des Gebäudes aufgebracht werden muss.“"
                            },
                            {
                                "example_id": "7c34c2e2-2dae-4629-8b96-94772884533d",
                                "sense_id": "52d773c0-7c48-33b3-a024-465fd7b16265",
                                "text": "„Es gibt auch Öfen, an denen die Sekundärluft nicht geregelt werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6514f691-f642-3abd-b594-aab677d349fe",
                        "entry_id": "bcf027f8-5949-3b4a-a398-cf99e1e3accf",
                        "glosses": [
                            "nachrangiger Luftstrom in einen Verbrennungsraum, der nicht ursächlich mit der Luftzufuhr zu tun hat"
                        ],
                        "tags": [
                            "Heizung"
                        ],
                        "examples": [
                            {
                                "example_id": "2f951ea6-86ef-49d1-96cc-d1ba4e1ff755",
                                "sense_id": "6514f691-f642-3abd-b594-aab677d349fe",
                                "text": "„Aufgrund der Verwirbelung mit Sekundärluft findet hier die Hauptverbrennung statt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
