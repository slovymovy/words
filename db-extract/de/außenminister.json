                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4f75837-5dc7-35d7-a66c-98880937d56b",
                        "entry_id": "a82b0290-b815-3b4d-9f04-1abb5519889d",
                        "glosses": [
                            "Leiter des Außenministeriums, der sich um die Beziehungen seines Landes zu anderen Ländern und internationalen Organisationen kümmern muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce731510-ac9a-443c-9e7f-c74d16e1c334",
                                "sense_id": "c4f75837-5dc7-35d7-a66c-98880937d56b",
                                "text": "Dem Außenminister untersteht das diplomatische Korps."
                            },
                            {
                                "example_id": "2c4793aa-ca16-46eb-8286-7637f3e36fd6",
                                "sense_id": "c4f75837-5dc7-35d7-a66c-98880937d56b",
                                "text": "„Nun gingen der General und der Außenminister zum Kaiser, um ihn zu informieren.“"
                            },
                            {
                                "example_id": "bc33e330-bed0-4d0d-a059-2e47e96b7a1c",
                                "sense_id": "c4f75837-5dc7-35d7-a66c-98880937d56b",
                                "text": "„Die Probleme, die er als Außenminister manchmal an nur einem Wochenende am Bein hatte, die will bei Gott kein normaler Mensch haben.“"
                            },
                            {
                                "example_id": "dab658a9-d2e1-4a5b-8953-797cc6d6dc6b",
                                "sense_id": "c4f75837-5dc7-35d7-a66c-98880937d56b",
                                "text": "„Bei dem Kriegspremier Winston Churchill und seinem Außenminister Anthony Eden hatte er schließlich Erfolg.“"
                            },
                            {
                                "example_id": "b92f355d-8f17-4034-ab08-ff65e006d132",
                                "sense_id": "c4f75837-5dc7-35d7-a66c-98880937d56b",
                                "text": "„Er hatte unseren Außenminister gesehen und Englands Botschafter und den Botschafter Frankreichs, er hatte Hochrufe ausgebracht und mit allen zusammen gesungen, doch dann hatte man unvermutet die Menge angewiesen, in Anbetracht eines eventuellen Luftangriffs so schnell wie möglich auseinanderzugehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
