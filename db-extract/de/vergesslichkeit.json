                ],
                "senses": [
                    {
                        "sense_id": "91f0e78e-fd1a-3d5e-8a15-fec27aa00a51",
                        "entry_id": "36f575fb-6c65-3ea4-87e6-77fd6b5bfd37",
                        "glosses": [
                            "Eigenschaft, Dinge leicht zu vergessen, sich schlecht an sie erinnern zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "666922e8-096e-455c-aac5-91619a9d16c2",
                                "sense_id": "91f0e78e-fd1a-3d5e-8a15-fec27aa00a51",
                                "text": "Durch Deine Vergesslichkeit sind uns schon viele Kunden abgesprungen."
                            },
                            {
                                "example_id": "1463f3d7-2ced-4a0a-a5c2-515ce8724dfa",
                                "sense_id": "91f0e78e-fd1a-3d5e-8a15-fec27aa00a51",
                                "text": "Vergesslichkeit ist nicht immer gleich eine Alzheimer-Demenz."
                            },
                            {
                                "example_id": "167714cf-1136-4d86-8c35-de66a20089f2",
                                "sense_id": "91f0e78e-fd1a-3d5e-8a15-fec27aa00a51",
                                "text": "„Beim Alter spielt die Vergesslichkeit eine große Rolle, die ältere Menschen mehr und mehr heimsucht.“"
                            },
                            {
                                "example_id": "bbe4d51d-f54e-4e34-9913-c224ef871fd7",
                                "sense_id": "91f0e78e-fd1a-3d5e-8a15-fec27aa00a51",
                                "text": "„Unverkennbare Anzeichen des Greisenalters machten sich deutlich bei ihm bemerkbar: plötzliches Einschlafen, Vergesslichkeit für nur kurze Zeit zurückliegende Ereignisse und ein gutes Gedächtnis für längst Vergangenes; und auch die kindliche Eitelkeit gehörte hierher, mit der er die Rolle des Moskauer Oppositionsführers übernommen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
