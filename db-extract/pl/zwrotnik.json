                                        "glosses": [
                                            "Breitenkreis auf der Nord- beziehungsweise auf der Südhalbkugel, über dem die Sonne gerade noch im Zenit stehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f7507f8-560c-44c0-bf78-4affbad2f0bf",
                                                "sense_id": "3af13876-28e8-394e-80bc-3632faedef5e",
                                                "text": "„Einige Tage später überfuhr das Schiff den Wendekreis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aa2b7110-6c33-33f2-9ad8-7b67b71b12fd",
                                        "entry_id": "817cdc8c-5a95-3292-85c9-42760b5598f2",
                                        "glosses": [
                                            "Kreis, der mindestens benötigt wird, um mit einem Kraftwagen bei vollem Lenkeinschlag zu wenden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6698e227-a8f9-41b0-87db-8cec77c988f8",
                                                "sense_id": "aa2b7110-6c33-33f2-9ad8-7b67b71b12fd",
                                                "text": "„Ferner fällt der Wendekreis zumindest beim Prototypen noch extrem groß aus, und das Bremsen ist auch nicht so einfach wie gedacht.“"
                                            },
                                            {
                                                "example_id": "050ac5ff-3f8e-4f25-b756-6410d1c8b0a8",
                                                "sense_id": "aa2b7110-6c33-33f2-9ad8-7b67b71b12fd",
                                                "text": "„Val gelang es, einen etwas besseren Wendekreis zu finden, und vermied es haarscharf, das Auto der Frau in einen Blechhaufen zu verwandeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7f3818d9-3dc0-3912-89ad-b298b0f41c1e",
                                        "entry_id": "817cdc8c-5a95-3292-85c9-42760b5598f2",
                                        "glosses": [
                                            "kreisförmiger Wendeplatz"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15f926e4-44b1-470a-ae60-70c2df7bebca",
                                                "sense_id": "7f3818d9-3dc0-3912-89ad-b298b0f41c1e",
                                                "text": "Dies ist ein Wendekreis für Linienbusse."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
