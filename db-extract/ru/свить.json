                    },
                    {
                        "form_id": "8fdebb33-2791-4461-9a2e-0189589f8a37",
                        "entry_id": "fc7bb7b2-2120-30db-a2ef-ec16d2f705b4",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "сви́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5fc0b559-f76b-3471-85bd-0c0725fcb1dc",
                        "entry_id": "fc7bb7b2-2120-30db-a2ef-ec16d2f705b4",
                        "glosses": [
                            "соединить, скручивая, сплетая нити, пряди и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8eaf12f4-3d22-4292-8dcf-b20208cd3027",
                                "sense_id": "5fc0b559-f76b-3471-85bd-0c0725fcb1dc",
                                "text": "Свить провода."
                            },
                            {
                                "example_id": "f6d695d3-1926-4197-abda-c36e08148957",
                                "sense_id": "5fc0b559-f76b-3471-85bd-0c0725fcb1dc",
                                "text": "Я вырвал клок сена, свил жгутом, слез, втоптал в снег."
                            }
                        ]
                    },
                    {
                        "sense_id": "40ed2d98-2380-3f11-886b-6729892db611",
                        "entry_id": "fc7bb7b2-2120-30db-a2ef-ec16d2f705b4",
                        "glosses": [
                            "изготовить, скручивая, соединяя нити, пряди || сделать, изготовить, сплетая из чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d92df6e3-0a5c-49d0-99fc-65dc77cf2170",
                                "sense_id": "40ed2d98-2380-3f11-886b-6729892db611",
                                "text": "И стал Федька приготовляться к пастьбе: свил себе кнут, смастерил сумку кожаную, пояс с бляхами добыл — стал настоящим пастухом."
                            },
                            {
                                "example_id": "cf0a949b-5da5-47de-81a3-c81cfcdda78e",
                                "sense_id": "40ed2d98-2380-3f11-886b-6729892db611",
                                "text": "Свить паутину."
                            },
                            {
                                "example_id": "210ee35b-a9cf-4c2d-b756-80209e596ba2",
                                "sense_id": "40ed2d98-2380-3f11-886b-6729892db611",
                                "text": "Вася прийти обещался — так вот я себе венок сперва совью; жать-то я ещё успею. Начинаю я рвать васильки, а они у меня промеж пальцев тают да тают, хоть ты что! И не могу я себе венок свить."
                            }
                        ]
                    },
                    {
                        "sense_id": "c984d6b9-684b-3d0d-8204-72a93cdec56b",
                        "entry_id": "fc7bb7b2-2120-30db-a2ef-ec16d2f705b4",
                        "glosses": [
                            "свернуть трубкой, кольцом, клубком"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d337920-0c81-42a9-971a-4a129ee97c31",
                                "sense_id": "c984d6b9-684b-3d0d-8204-72a93cdec56b",
                                "text": "Мгновенно засучил он рукава, схватил блюдо, положил его на колено, ухватился обеими руками за самый край его, и — будто оловянным сделалось толстое серебряное блюдо под его пальцами, будто превратилось в лист пергамента — в трубку свил его Святослав, перегнул ещё трубку в кольцо и подал хану."
                            },
                            {
                                "example_id": "d76a18a8-3682-41a3-935a-41382148e166",
                                "sense_id": "c984d6b9-684b-3d0d-8204-72a93cdec56b",
                                "text": "Кобылица молодая, // Очью бешено сверкая, // Змеем голову свила // И пустилась, как стрела."
                            }
                        ]
                    },
                    {
                        "sense_id": "a661b6d0-9a92-3dd2-994b-b62eb717f2ea",
                        "entry_id": "fc7bb7b2-2120-30db-a2ef-ec16d2f705b4",
                        "glosses": [
                            "спец. снять с чего-либо, развив, размотав что-либо намотанное"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3ffe0a76-c990-354e-aa43-e032355de90f",
                        "entry_id": "fc7bb7b2-2120-30db-a2ef-ec16d2f705b4",
                        "glosses": [
                            "перен. соединить, связать между собой чем-либо общим; переплести"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5c380dd-7d33-4e21-8e3a-91d9f559298c",
                                "sense_id": "3ffe0a76-c990-354e-aa43-e032355de90f",
                                "text": "Свить надежды, сердца, города."
                            }
                        ]
                    },
                    {
                        "sense_id": "aecdcb6a-dfb0-3b1b-926c-4d8b05fd9d73",
                        "entry_id": "fc7bb7b2-2120-30db-a2ef-ec16d2f705b4",
                        "glosses": [
                            "перен. устроить жилище, убежище, пристанище"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b48e397-6cc0-42bd-b68b-36990d75a8fd",
                                "sense_id": "aecdcb6a-dfb0-3b1b-926c-4d8b05fd9d73",
                                "text": "Свить гнездо."
                            },
                            {
                                "example_id": "2e10062e-34b3-4953-8b56-5352f7dd539b",
                                "sense_id": "aecdcb6a-dfb0-3b1b-926c-4d8b05fd9d73",
                                "text": "Он глубоко забрался в глушь, свил, как барсук, себе логово и полночью ходил туда, где лежали два смердящие трупа."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "c7de6312-0ad6-470d-854b-6399aa361e63",
                        "source_entry_id": "fc7bb7b2-2120-30db-a2ef-ec16d2f705b4",
                        "source_sense_ids": [
                            "5fc0b559-f76b-3471-85bd-0c0725fcb1dc"
