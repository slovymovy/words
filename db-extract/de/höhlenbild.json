                ],
                "senses": [
                    {
                        "sense_id": "c2b79b61-fbb9-3dc9-b9cb-7da3c9281a6c",
                        "entry_id": "a751d3a1-45a6-3bad-9224-42a47527d63a",
                        "glosses": [
                            "Bild, das in einer Höhle (meist vor Jahrtausenden) an eine Wand gemalt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af09f892-ab17-4b46-b2a8-cfc080bc13b3",
                                "sense_id": "c2b79b61-fbb9-3dc9-b9cb-7da3c9281a6c",
                                "text": "„In Indonesien haben Forscher das älteste Gemälde der Welt entdeckt: Das Höhlenbild zeigt Menschen bei der Jagd.“"
                            },
                            {
                                "example_id": "c5d62e0b-a280-433c-afb5-70d1b8985aaf",
                                "sense_id": "c2b79b61-fbb9-3dc9-b9cb-7da3c9281a6c",
                                "text": "„Ähnlich wie bei den Funden kleiner Statuetten (Löwenmensch) datiert man die ältesten Höhlenbilder (Chauvet-Höhle) auf rund 30.000 Jahre vor unserer Zeitrechnung.“"
                            },
                            {
                                "example_id": "821d4fe4-6e65-47ba-a899-0b7a2d4890c5",
                                "sense_id": "c2b79b61-fbb9-3dc9-b9cb-7da3c9281a6c",
                                "text": "„Schamanismus, Beutebeschwörung, Jägerstolz oder einfach \"nur\" Kunst? Über die Bedeutung der 17.000 Jahre alten Höhlenbilder von Lascaux rätselt die Forschung noch immer.“"
                            },
                            {
                                "example_id": "a6f04e86-aa51-480d-b1ae-9ec78ec3809a",
                                "sense_id": "c2b79b61-fbb9-3dc9-b9cb-7da3c9281a6c",
                                "text": "„Der deutsche Regisseur Werner Herzog hat eine Drehgenehmigung für die Chauvet-Höhle erhalten und unter schwierigsten Bedingungen eine Doku über die spektakulären Höhlenbilder gedreht.“"
                            },
                            {
                                "example_id": "a9679b23-fce9-44d8-8848-fa97d8931a8a",
                                "sense_id": "c2b79b61-fbb9-3dc9-b9cb-7da3c9281a6c",
                                "text": "[Schlagzeile:] „Steinzeitkunst: Chauvet-Höhlenbilder sind mindestens 20 000 Jahre alt“"
                            },
                            {
                                "example_id": "f098a373-96e2-478a-9345-fc5af8f8311d",
                                "sense_id": "c2b79b61-fbb9-3dc9-b9cb-7da3c9281a6c",
                                "text": "„Dort, in einem der Felshänge, liegt die berühmte Chauvet-Grotte mit Höhlenbildern aus der Steinzeit, die älter und prächtiger sind als alles, was man in Europa kennt.“"
                            },
                            {
                                "example_id": "96f4b2c2-acea-4dd5-b823-7b7d6ebfd5a6",
                                "sense_id": "c2b79b61-fbb9-3dc9-b9cb-7da3c9281a6c",
                                "text": "„Die Eiszeitmenschen lebten hauptsächlich als Großwildjäger. Für die Deutung der Höhlenbilder ist das Wissen über die jeweilige Verbreitung der Tierarten unentbehrlich.“"
                            },
                            {
                                "example_id": "941eab4b-0d84-4a85-957c-1a705ab73804",
                                "sense_id": "c2b79b61-fbb9-3dc9-b9cb-7da3c9281a6c",
                                "text": "„»Obwohl die Höhlenbilder verblüffend modern wirken, wurden sie in der Jüngeren Altsteinzeit auf die Calcitwände gemalt, als jeder Jäger und Sammler war und Homo sapiens neben dem Neandertaler existierte.«“"
                            },
                            {
                                "example_id": "4908e678-da11-46e3-bee1-8609f44893f8",
                                "sense_id": "c2b79b61-fbb9-3dc9-b9cb-7da3c9281a6c",
                                "text": "„Aus gutem Grund galt Europa lange Zeit als Wiege der Eiszeitkunst und des symbolischen Denkens. Doch diese große These ist ins Wanken geraten. Denn Archäologen haben am anderen Ende der Welt, in Südostasien, ebenfalls Höhlenbilder aus den Händen eiszeitlicher Jäger und Sammler gefunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cd832c0-3b4a-4f45-9b7a-7d1d41675af7",
                        "source_entry_id": "a751d3a1-45a6-3bad-9224-42a47527d63a",
                        "source_sense_id": "c2b79b61-fbb9-3dc9-b9cb-7da3c9281a6c",
                        "source_sense_description": "Bild, das in einer Höhle an eine Wand gemalt wurde",
                        "target_lang_word": "cave painting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cave painting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c658c9d5-60e9-30fb-9f03-260cbe86d5a5",
                                        "entry_id": "7087e6b3-e99b-3f4a-bace-8b0e73c2f4f7",
                                        "glosses": [
                                            "The activity of applying pigments to the interior surfaces of caves to create images, especially when carried out in prehistoric times."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8bca3a8-d9ee-40c2-99d7-09755c483bd4",
                                                "sense_id": "c658c9d5-60e9-30fb-9f03-260cbe86d5a5",
                                                "text": "For several decades, now, he [the modern artist] has taken the liberty of learning how to draw and compose by studying and borrowing ideas from the high periods in all art, as far back as prehistoric cave painting."
                                            },
                                            {
                                                "example_id": "dbe9eaa7-84e1-4aaa-a531-1a47d33a0b2a",
                                                "sense_id": "c658c9d5-60e9-30fb-9f03-260cbe86d5a5",
                                                "text": "[C]ave painting appears to have flourished during the last 8–10,000 years of this period and to be concentrated in limestone caves of southwestern Europe (especially southwestern France and north coastal Spain), [...]"
                                            },
                                            {
                                                "example_id": "0580e430-01b1-46c3-8e48-c4e8632ab47f",
                                                "sense_id": "c658c9d5-60e9-30fb-9f03-260cbe86d5a5",
                                                "text": "In another topic on prehistoric man, pupils used 'active learning' methods to construct a 'cave set'; re-enacted cave-painting by homemade candlelight; [...]"
                                            },
                                            {
                                                "example_id": "67759b83-3f8f-47ca-9bb8-5413420e9d80",
                                                "sense_id": "c658c9d5-60e9-30fb-9f03-260cbe86d5a5",
                                                "text": "Art-making may have emerged as early as 1.5 million years ago with the arrival of Homo erectus, our humanlike ancestors. [...] Cave painting and early sketching were ways to enhance thinking, serving as a medium for idea manipulation, enhancement, and storage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "439591e1-7c93-3d12-8b17-4785b8290fde",
                                        "entry_id": "7087e6b3-e99b-3f4a-bace-8b0e73c2f4f7",
                                        "glosses": [
                                            "The paintings resulting from this activity regarded collectively, especially if prehistoric; cave art; (countable) an individual painting of this type."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "184fae2b-33a2-4e90-a4e5-5776d672918f",
                                                "sense_id": "439591e1-7c93-3d12-8b17-4785b8290fde",
                                                "text": "I understand from Paṇḍita Baghavánlál, who lately visited the caves, that the painting and writings in these caves are fast going to decay. Those at Ajaṇṭhá are more durable, whereas the Bagh cave paintings will, it is feared, be entirely obliterated after some years."
                                            },
                                            {
                                                "example_id": "de42bdeb-03dd-498c-93a2-981317827de5",
                                                "sense_id": "439591e1-7c93-3d12-8b17-4785b8290fde",
                                                "text": "No natives of this country could, I think, have drawn the cave-paintings [in Buddhist caves found in Khandesh]."
                                            },
                                            {
                                                "example_id": "6a344181-8053-4e50-bb30-2b97de42fe69",
                                                "sense_id": "439591e1-7c93-3d12-8b17-4785b8290fde",
                                                "text": "Mr. George W. Stow, of Queenstown, South Africa, refers in a letter to the interesting subject of the old cave-paintings by the Bushmen, [...]"
                                            },
                                            {
                                                "example_id": "2efb04ae-7b81-43e0-b98e-056d5b8f50a0",
                                                "sense_id": "439591e1-7c93-3d12-8b17-4785b8290fde",
                                                "text": "Prehistoric pottery, art, cave painting, engraving can be incorporated into the exhibition as an added colourful attraction."
                                            },
                                            {
                                                "example_id": "a9e715f8-c66e-406d-abda-ed998642bf09",
                                                "sense_id": "439591e1-7c93-3d12-8b17-4785b8290fde",
                                                "text": "Although somewhat difficult to date, the earliest direct evidence of human interest in honey occurs in the famous stone-age cave painting from southern Spain, of a man robbing a wild bees' nest."
                                            },
                                            {
                                                "example_id": "bb580a82-78c3-4b39-893e-44729a50fa8b",
                                                "sense_id": "439591e1-7c93-3d12-8b17-4785b8290fde",
                                                "text": "Rooted in precinematic cultural activities such as walking and traveling, on the one hand, and in all forms of visual representation – including cave painting – on the other, the compound term [\"mobilized virtual gaze\"] is meant to describe forms of scopic pleasure that travel \"in an imaginary flânerie through an imaginary elsewhere and an imaginary 'elsewhen'.'\""
                                            },
                                            {
                                                "example_id": "844d6ebc-80b8-4bb0-bf34-de3617a68862",
                                                "sense_id": "439591e1-7c93-3d12-8b17-4785b8290fde",
                                                "text": "The well-known Neolithic cave painting from Morella la Villa in Spain unmistakably shows a battle between two small groups of archers."
                                            },
                                            {
                                                "example_id": "662b9e02-224a-4247-a2e2-c3403de2fc7b",
                                                "sense_id": "439591e1-7c93-3d12-8b17-4785b8290fde",
                                                "text": "By 30,000 years ago, modern humans in Europe were producing stunning cave paintings of ice age animals, and carved human figurines."
                                            },
                                            {
                                                "example_id": "7fd0b614-8274-42a8-a025-09246f1d318c",
                                                "sense_id": "439591e1-7c93-3d12-8b17-4785b8290fde",
                                                "text": "Human beings have been students of animal behavior from their earliest days. [...] Further evidence for this appreciation of animal behavior can be seen in the many cave paintings depicting animals, while not depicting any of the other facets of the painters' lives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
