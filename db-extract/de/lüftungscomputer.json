                "senses": [
                    {
                        "sense_id": "03cae978-52f7-34e6-9629-0c0d767743c5",
                        "entry_id": "5928466b-dc5d-37d5-9ef1-f1c5188154ab",
                        "glosses": [
                            "elektronisches, programmierbares Gerät zur Eingabe, Verarbeitung und Ausgabe von Daten für die Lüftung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "114f7f7a-52fe-475a-92e4-d4a1b63f583b",
                                "sense_id": "03cae978-52f7-34e6-9629-0c0d767743c5",
                                "text": "„Der Lüftungscomputer steuert aufgrund der Temperaturen im Stall die Stellung der Klappen.“"
                            },
                            {
                                "example_id": "c5327d7c-c3b8-4c3f-9a31-a4c7bd86f519",
                                "sense_id": "03cae978-52f7-34e6-9629-0c0d767743c5",
                                "text": "„Der HK4 ist ein universeller Lüftungscomputer, in dem innovatives Denken mit der Erfahrung aus drei Lüftungscomputer-Generationen vereint sind.“"
                            },
                            {
                                "example_id": "e713b257-d1a6-428a-ae34-0e738c79cdcb",
                                "sense_id": "03cae978-52f7-34e6-9629-0c0d767743c5",
                                "text": "„Der Austausch alter Lüftungscomputer ist eine einfache Möglichkeit, die Leistungen in der Schweinehaltung zu verbessern.“"
                            },
                            {
                                "example_id": "e3cfd30c-1f4f-427b-b533-b0c74a3949a7",
                                "sense_id": "03cae978-52f7-34e6-9629-0c0d767743c5",
                                "text": "„Schwerpunkt des Seminars ist es , den Lüftungscomputer Ihrer Wahl besser zu beherrschen und an unterschiedlichen Ansprüchen richtig zu betreiben.“"
                            },
                            {
                                "example_id": "6334704a-ee9f-45bb-9a11-f06040ceba7a",
                                "sense_id": "03cae978-52f7-34e6-9629-0c0d767743c5",
                                "text": "„Der Lüftungscomputer, Ventilatoren und Tränkenippel wurden auf ihre Funktionsfähigkeit überprüft und als einwandfrei beurteilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
