                    {
                        "sense_id": "a5088669-2a05-374a-b9f4-79bb9d8a693d",
                        "entry_id": "0acc40f8-b602-3a50-bb8b-8801022ff4cd",
                        "glosses": [
                            "To approve beforehand, before execution or implementation."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9cc987aa-719d-4952-9f17-25c19183e140",
                                "sense_id": "a5088669-2a05-374a-b9f4-79bb9d8a693d",
                                "text": "Since election boards aren't actually willing to preapprove these forms for software companies, Dean, as a presidential candidate, submits his own forms."
                            },
                            {
                                "example_id": "2bf58931-68c2-4c0c-bc9b-62fbfbc5eaee",
                                "sense_id": "a5088669-2a05-374a-b9f4-79bb9d8a693d",
                                "text": "While you'll probably have her sympathies if your condominium association wants to preapprove your storm door, you'll need to work harder for her support if your boss at the music megastore demands you grow a goatee to help lend the place some indie cred."
                            },
                            {
                                "example_id": "cb0f86e8-6d55-42e5-98f9-a8d54a84708a",
                                "sense_id": "a5088669-2a05-374a-b9f4-79bb9d8a693d",
                                "text": "But that is changing; in the coming months, Mr. Gollinger said, his company will hold an auction in a suburban New York community where lenders will help preapprove bidders for mortgages."
                            },
                            {
                                "example_id": "e777a7ac-0660-4942-a0bd-d40f5dcf8151",
                                "sense_id": "a5088669-2a05-374a-b9f4-79bb9d8a693d",
                                "text": "Some states do not preapprove rates, as New York does, but can take action later if they find an increase was inappropriate."
                            }
                        ]
                    }
