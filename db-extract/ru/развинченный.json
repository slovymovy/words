                                                "sense_id": "cb2c2944-6f4e-3f79-9830-eaa08e44be05",
                                                "text": "Das Trüffelkonfekt kaufe ich immer nur lose."
                                            },
                                            {
                                                "example_id": "0a5d2c7c-3f46-4f3d-93d6-ac1775ec385e",
                                                "sense_id": "cb2c2944-6f4e-3f79-9830-eaa08e44be05",
