                "senses": [
                    {
                        "sense_id": "c319e6e7-ffb5-34f2-8be3-8725b42d95f3",
                        "entry_id": "b856339f-0716-325b-9574-7c4d9b3f41a5",
                        "glosses": [
                            "To participate in geocaching."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d38e67b7-4741-4e91-ad24-457877021001",
                                "sense_id": "c319e6e7-ffb5-34f2-8be3-8725b42d95f3",
                                "text": "Those who have never geocached assume that it must be a really easy game;"
                            },
                            {
                                "example_id": "f916df4d-c9b9-4cda-b99c-5b142e8938ab",
                                "sense_id": "c319e6e7-ffb5-34f2-8be3-8725b42d95f3",
                                "text": "And, in line with the third preference that Kahn observed, nearly all of the places I've geocached have been easy to navigate (and would have been easy even without a GPS)."
                            },
                            {
                                "example_id": "76a04851-c977-46b7-94c8-bf30672af00f",
                                "sense_id": "c319e6e7-ffb5-34f2-8be3-8725b42d95f3",
                                "text": "The team, which has more than 68000 finds between them, geocached across all 50 U.S. states in just 10 days."
                            }
                        ]
                    },
                    {
                        "sense_id": "79ea11ce-5f9b-36a2-adb1-d3814a55e509",
                        "entry_id": "b856339f-0716-325b-9574-7c4d9b3f41a5",
                        "glosses": [
                            "To hide or seek a geocache."
                        ],
