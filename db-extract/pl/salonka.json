                                    {
                                        "sense_id": "c5469ba5-4b36-319d-bb16-733005f41995",
                                        "entry_id": "1b9a5ea7-e938-3435-b665-c020c254d2eb",
                                        "glosses": [
                                            "Voiture de chemin de fer pour train de prestige, organisé comme un salon et offrant une prestation soignée de confort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5263991e-302d-48bc-82e0-a3972f93f7f1",
                                                "sense_id": "c5469ba5-4b36-319d-bb16-733005f41995",
                                                "text": "Voiture-lits, voiture-salon, wagon-restaurant. Le luxe du décor est éblouissant. Boiseries, cristaux, volutes fleuries, lourds rideaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83858b7f-878f-4eb7-b232-3855b2ab1492",
                        "source_entry_id": "9418fb30-faa0-38e6-9259-00df009fc265",
                        "source_sense_id": "d81a497f-14ed-30cc-99e8-b63fdcba0832",
                        "target_lang_word": "wagon-salon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wagon-salon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f5f367e-b465-3d21-b1ef-6fc9411c1e52",
                                        "entry_id": "c27dde98-eb4b-316d-9986-4b96be6c19ad",
                                        "glosses": [
                                            "Voiture de chemin de fer pour train de prestige, organisé comme un salon et offrant une prestation soignée de confort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d6dbf05-cee1-4f87-95b5-89598160f7ee",
                                                "sense_id": "5f5f367e-b465-3d21-b1ef-6fc9411c1e52",
                                                "text": "Cependant les messieurs descendaient de leurs wagons-salons et il y eut comme une accalmie parmi la foule […], soit qu’elle eût perdu le souffle dans le premier cri, soit que les yeux fussent trop occupés pour qu’elle pût faire autre chose que regarder, soit enfin que le respect l’obligeât à se taire."
                                            },
                                            {
                                                "example_id": "69a0ea00-eae1-47f6-a155-605c397373a6",
                                                "sense_id": "5f5f367e-b465-3d21-b1ef-6fc9411c1e52",
                                                "text": "Quelques jours avant le retour à Dresde, elle fit seule le trajet de La Haye à Bruxelles dans le wagon-salon, acajou et tapis turcs, de ces années-là."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
