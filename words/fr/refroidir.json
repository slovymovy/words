                    "sense_definition": "Perdre sa chaleur, devenir froid ou tiède.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Attends un instant avant de boire, la soupe doit encore <w>refroidir</w>."
                        },
                        {
