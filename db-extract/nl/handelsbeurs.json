                        "glosses": [
                            "plaats waar bedrijven handel met elkaar drijven; tentoonstelling waar bedrijven hun producten tonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4b2ddea-cbde-4294-8dc2-510e8a930d8e",
                                "sense_id": "5b2fba44-0517-35a9-b766-9025958ff80b",
                                "text": "De zes jaar durende Griekse recessie is volgend jaar voorbij. Dat voorspelde de Griekse premier Antonis Samaras bij de opening van de jaarlijkse internationale handelsbeurs in de stad Thessaloniki. In 2020 is Griekenland terug op het niveau van voor de crisis, stelt de premier."
                            },
                            {
                                "example_id": "3ebae122-d654-42d8-a40a-419e7516c2ba",
                                "sense_id": "5b2fba44-0517-35a9-b766-9025958ff80b",
                                "text": "De afgelopen vijf jaar is het aantal horecabedrijven afgenomen. Er zijn vooral minder cafés. KHN maakte bij de start van de handelsbeurs Horecava bekend dat het voor de horeca een moeilijke tijd is en blijft."
                            }
                        ]
                    }
