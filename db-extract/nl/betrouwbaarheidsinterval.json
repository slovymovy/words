                        "glosses": [
                            "een statistische intervalschatting voor een parameter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a71e22a9-9547-4002-a91a-97cf154a2b50",
                                "sense_id": "15f141b0-e313-335e-a274-0005b59f9375",
                                "text": "In tegenstelling tot een puntschatting geeft een betrouwbaarheidsinterval een heel interval van betrouwbare waarden (schattingen) van de parameter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd757fc6-1a4e-481c-8b23-5ab747c0cde9",
                        "source_entry_id": "7341315b-9b52-33bb-b82d-4bcce53cd24f",
                        "source_sense_id": "15f141b0-e313-335e-a274-0005b59f9375",
                        "source_sense_description": "een statistische intervalschatting voor een parameter",
                        "target_lang_word": "Konfidenzintervall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konfidenzintervall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47a1b251-292a-398d-9a47-705d45a310f7",
                                        "entry_id": "0c539638-c08b-3559-828c-28c2e2314acd",
                                        "glosses": [
                                            "derjenige Bereich (Intervall) rechnerischer Größen, bei dem man vertrauensvoll davon ausgehen kann, dass er die wirklichen Werte der Realität einschließt"
                                        ],
                                        "tags": [
                                            "Statistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2d16d40-ad0e-4276-886a-11d4029edd42",
                                                "sense_id": "47a1b251-292a-398d-9a47-705d45a310f7",
                                                "text": "„Sollte das erhaltene Konfidenzintervall im Verhältnis zur benötigten Genauigkeit zu groß sein, wird man ein neues Experiment durchführen müssen.“"
                                            },
                                            {
                                                "example_id": "2f496f3d-3c58-4ab0-83f1-705a0262a081",
                                                "sense_id": "47a1b251-292a-398d-9a47-705d45a310f7",
                                                "text": "„Ein häufig verwendetes Konfidenzniveau ist 95 %, sodass in diesem Fall – wenn man das Zufallsexperiment auf identische Art und Weise wiederholt – ein 95 %-Konfidenzintervall in näherungsweise 95 % aller Fälle den unbekannten „wahren“ Parameter überdecken wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
