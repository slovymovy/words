                "senses": [
                    {
                        "sense_id": "12d3d508-ade3-32d3-95ce-75781345ba54",
                        "entry_id": "7eb60895-4a8d-3212-af7b-be1223009299",
                        "glosses": [
                            "unscharfe Bezeichnung für die Juden als Volk, unabhängig von der Religion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7211f4ed-5842-4ea9-90fc-fdd12e37bad0",
                                "sense_id": "12d3d508-ade3-32d3-95ce-75781345ba54",
                                "text": "„‚[…] Denn daß er kommt, ist unzweifelhaft, er hätte sonst abgeschrieben, artiger Mann, der er ist.‘ ‚Ja, das ist er,‘ sagte Etienne, ‚das hat er noch aus dem Semitismus mit 'rüber genommen.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a483f55d-f689-3385-b83c-c679f3207a1c",
                        "entry_id": "7eb60895-4a8d-3212-af7b-be1223009299",
                        "glosses": [
                            "Anleihe an Konstruktions- oder Ausdrucksweisen, wie sie in semitischen Sprachen üblich ist"
                        ],
                        "tags": [
                            "sprachwissenschaftlich"
                        ],
                        "examples": [
                            {
                                "example_id": "907cebdb-2b98-4f7c-940c-f7c35edb30c8",
                                "sense_id": "a483f55d-f689-3385-b83c-c679f3207a1c",
                                "text": "„Und nun erst der Umstand, daß er Wörter für althebräisch ausgab, die, so weit wir jetzt den Semitismus kennen, keinem Dialekt dieses Sprachstammes angehören, verrät doch einen Betrüger auf den ersten Blick!“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
