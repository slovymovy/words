                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08ac2fc0-376d-4733-be95-a0f3da5fae81",
                                "sense_id": "8c7ea27e-513d-31a6-adb3-bd164ba642f7",
                                "text": "Der Paatsch trägt nie die Pullover, die die Paatsch ihm strickt."
                            },
                            {
                                "example_id": "3dc82d1b-e91b-4d8f-b710-be2c5f345213",
                                "sense_id": "8c7ea27e-513d-31a6-adb3-bd164ba642f7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Paatsch kommt, geht der Herr Paatsch.“"
                            },
                            {
                                "example_id": "9fd598f8-885d-4ef0-95ad-7c067de5e427",
                                "sense_id": "8c7ea27e-513d-31a6-adb3-bd164ba642f7",
                                "text": "Paatsch kommt und geht."
                            },
                            {
                                "example_id": "40583599-c613-4a1a-ae03-bceee5e7df0c",
                                "sense_id": "8c7ea27e-513d-31a6-adb3-bd164ba642f7",
                                "text": "Paatschs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "3e764ba7-8223-4e9e-939b-ff858cfb14e3",
                                "sense_id": "8c7ea27e-513d-31a6-adb3-bd164ba642f7",
                                "text": "Frau Paatsch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1bd7a470-7664-4930-983c-3911eff95f08",
                                "sense_id": "8c7ea27e-513d-31a6-adb3-bd164ba642f7",
                                "text": "Herr Paatsch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7daf2c65-3697-4f10-96d1-77fc6c587823",
                                "sense_id": "8c7ea27e-513d-31a6-adb3-bd164ba642f7",
                                "text": "Die Paatschs fliegen heute nach Liverpool."
                            }
                        ],
                        "sense_index_json": "\"1\""
