                        "glosses": [
                            "benaming voor insectensoorten uit de familie Formicidae die als kolonie gezamenlijk op rooftocht gaan en daarbij met hun kaken soms levende wezens doden die vele malen groter zijn dan zijzelf"
                        ],
                        "tags": [
                            "vliesvleugeligen"
                        ],
                        "examples": [
                            {
                                "example_id": "d97b4db2-c718-40a0-9c97-510f34ec6d15",
                                "sense_id": "12df76f4-95f3-335f-8c2e-a7b289477bc9",
                                "text": "De mieren zijn roofmieren. Bijna elke dag gaan de mieren uit roven. Dan zwermen ze uit over de bodem van het bos en overvallen ze insecten en andere dieren."
                            },
                            {
                                "example_id": "e10aa327-f208-4628-98ed-09fd2faa4027",
                                "sense_id": "12df76f4-95f3-335f-8c2e-a7b289477bc9",
                                "text": "Ramon bleef grijnzen, er kroop een roofmier in zijn neus."
                            }
                        ]
                    }
