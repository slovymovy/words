                        ]
                    },
                    {
                        "translation_id": "37693f29-d806-4ce0-a822-ab975eef8778",
                        "source_entry_id": "757e89cd-eabf-3086-88dd-9d0823bc3e34",
                        "target_lang_word": "Epitaph",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Epitaph",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "026c151d-9dea-3be2-a28b-c6e1e1574e43",
                                        "entry_id": "9383fe32-0772-3bc5-b95c-d8db2ccd6426",
                                        "glosses": [
                                            "Grabschrift, Grabinschrift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7636bebe-52c3-4c72-91a8-a3bbe89212af",
                                                "sense_id": "026c151d-9dea-3be2-a28b-c6e1e1574e43",
                                                "text": "Auf dem Grabstein stand ein Epitaph: \"Hier ruht …\"."
                                            },
                                            {
                                                "example_id": "10005b62-6162-4a5e-83ff-60a825e8dfa9",
                                                "sense_id": "026c151d-9dea-3be2-a28b-c6e1e1574e43",
                                                "text": "„Ihn faszinierten die geheimnisvolle Atmosphäre, die seltsamen Epitaphe in hebräischer Sprache, das Gebüsch und der Nebel, der über den Matzewas schwebte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3266221f-b7c9-382e-810a-61c42e4290ac",
                                        "entry_id": "9383fe32-0772-3bc5-b95c-d8db2ccd6426",
                                        "glosses": [
                                            "Gedenktafel für einen Verstorbenen an der Kirchenwand, ohne Verbindung zu einem Grab"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3a929cd-919b-4f49-ab2d-bf759234204a",
                                                "sense_id": "3266221f-b7c9-382e-810a-61c42e4290ac",
                                                "text": "„Viele der barocken Grabsteine stammen noch aus dem alten Kirchhof der Dreikönigskirche; einige der Epitaphe aus der alten Kirche selbst.“"
                                            },
                                            {
                                                "example_id": "c48b52a9-9770-499f-9a51-b64e0f59e707",
                                                "sense_id": "3266221f-b7c9-382e-810a-61c42e4290ac",
                                                "text": "„Es schien mir ein passendes Epitaph für meine Anstrengungen zu sein, wenn ich sie denn irgendwann würde aufgeben müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f49eb2e7-4d81-4f9c-9703-ec9c17188cef",
                        "source_entry_id": "757e89cd-eabf-3086-88dd-9d0823bc3e34",
                        "target_lang_word": "Grabinschrift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grabinschrift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "515bfad7-13fc-3842-a0f3-c21c1e74ba6d",
                                        "entry_id": "0b495d57-9681-3ccf-a92f-d6b3e48cf1bf",
                                        "glosses": [
                                            "Worte und Daten, die auf ein Grabmal geschrieben sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44b6b4b9-ba17-457c-a481-af1f1152db7f",
                                                "sense_id": "515bfad7-13fc-3842-a0f3-c21c1e74ba6d",
                                                "text": "Die Grabinschrift verriet, dass der Verstorbene 99 Jahre alt wurde."
                                            },
                                            {
                                                "example_id": "2280b2ce-72ce-4c99-aa9a-2159db7b7847",
                                                "sense_id": "515bfad7-13fc-3842-a0f3-c21c1e74ba6d",
                                                "text": "„Die Grabinschriften waren meist bis zur Unkenntlichkeit verwittert.“"
                                            },
                                            {
                                                "example_id": "bfc0635c-ce64-4528-9fa0-2c12322668e8",
                                                "sense_id": "515bfad7-13fc-3842-a0f3-c21c1e74ba6d",
                                                "text": "„Die unfreiwillige Komik bei Todesanzeigen und Grabinschriften beruht darauf, daß Tod und Sterben ohnehin Grenzsitutionen, Extremfälle sind, zu denen daher besonders leicht auch komische Kontraste hergestellt werden können.“"
                                            },
                                            {
                                                "example_id": "5d5bba85-cdf7-42a4-8a51-eecb162abcb1",
                                                "sense_id": "515bfad7-13fc-3842-a0f3-c21c1e74ba6d",
                                                "text": "„Er vertiefte sich so in die Arbeit, als sollte es seine Lebensaufgabe sein, die Grabinschrift für seinen Bruder zu verfassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "babea862-f87a-4a8b-8f25-86fc409dc811",
