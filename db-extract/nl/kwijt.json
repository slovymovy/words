                    {
                        "sense_id": "55b12376-a8b7-3e2e-9870-6a2abf5bf00e",
                        "entry_id": "badfbdc1-b73c-3389-bd73-7e5504c56325",
                        "glosses": [
                            "~ + oorzakelijk voorwerp niet meer weten waar iets is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6139e8de-59bc-4ca6-b212-a4d7ebbcc5af",
                                "sense_id": "55b12376-a8b7-3e2e-9870-6a2abf5bf00e",
                                "text": "Hij is zijn horloge kwijt."
                            },
                            {
                                "example_id": "40fd36cf-04b1-49a9-9815-9b46cb3caa34",
                                "sense_id": "55b12376-a8b7-3e2e-9870-6a2abf5bf00e",
                                "text": "'Ze zijn een van hun jongens kwijt."
                            },
                            {
                                "example_id": "a90fe2dc-60a2-4dbd-87b3-52b67098d6e8",
                                "sense_id": "55b12376-a8b7-3e2e-9870-6a2abf5bf00e",
                                "text": "Hoewel de maan helder scheen, raakte ze hem toch kwijt en haar bloed koelde snel af, maar ze vervolgde haar weg, het verroeste hek uit en het zandpad op dat naar het dorp leidde, struikelend over stenen en zichzelf vervloekend omdat ze zo stom was geweest om op hoge hakken naar buiten te gaan."
                            }
                        ]
                    }
                ],
                "translations": [
