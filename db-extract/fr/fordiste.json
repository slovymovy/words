                "senses": [
                    {
                        "sense_id": "1166a09e-d7e4-310a-91f4-9629582660c6",
                        "entry_id": "ed52602f-964f-365e-8e1b-60f11f755faa",
                        "glosses": [
                            "Qui concerne, promeut ou applique les méthodes du fordisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c699de2-0313-4b89-b7b4-387688de3ede",
                                "sense_id": "1166a09e-d7e4-310a-91f4-9629582660c6",
                                "text": "Aujourd’hui, les travailleurs se dresseront contre la rationalisation capitaliste. Ils s’élèveront contre le travail à la chaîne, si abrutissant et si fatigant. Ils indiqueront aux industriels fordistes qu’ils ne sont pas des forçats et qu’ils veulent être considérés comme des ouvriers et non comme des mécaniques."
                            },
                            {
                                "example_id": "d8ed1f16-0225-4314-8829-a628b4f676d8",
                                "sense_id": "1166a09e-d7e4-310a-91f4-9629582660c6",
                                "text": "Le mouvement des relations humaines naît à partir des critiques des modèles fordistes et tayloristes, en particulier parce qu’ils se focalisent sur une organisation purement technique du travail."
                            }
                        ]
                    },
                    {
                        "sense_id": "f92be192-bc4b-33c0-b83f-7f135a3d0032",
                        "entry_id": "ed52602f-964f-365e-8e1b-60f11f755faa",
                        "glosses": [
                            "Spécialisé dans les automobiles de la marque Ford, en parlant notamment d’un mécanicien ou d’un chauffeur."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5e967c9e-f650-4203-9ea7-96043237ece1",
                                "sense_id": "f92be192-bc4b-33c0-b83f-7f135a3d0032",
                                "text": "On dem. bons chauffeurs fordistes pour livraison, 100 av. Victor Hugo, à Vanves."
                            },
                            {
                                "example_id": "5b1a3a63-619b-400a-bac2-b91b25c24018",
                                "sense_id": "f92be192-bc4b-33c0-b83f-7f135a3d0032",
                                "text": "On demande mécaniciens qualifiés fordistes de préférence. Agence centrale, 52 avenue du Prado."
                            }
                        ]
                    }
                ],
