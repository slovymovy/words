                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf9157f6-6b59-4c83-a56d-eb75fd156679",
                                "sense_id": "ebe9ef07-0ea5-3946-a76a-f29f4ade0a29",
                                "text": "De daken dreigen in te storten onder het gewicht van meters sneeuw. Ook veel bomen staan op het punt om om te vallen door de zware sneeuw op de takken. Met pantservoertuigen op rupswielen hebben militairen de bewoners en medewerkers van een astmacentrum geëvacueerd."
                            },
                            {
                                "example_id": "fea675ec-88e2-40ca-aca6-5feda4de38a4",
                                "sense_id": "ebe9ef07-0ea5-3946-a76a-f29f4ade0a29",
                                "text": "Op de bank van Studio Sportwinter vertelt Van der Graaff dat zij op vierjarige leeftijd naar het wintersportland vertrok vanwege het werk van haar vader, die leraar is bij een Nederlands astmacentrum in de schone lucht van de Zwitserse bergen."
                            }
                        ]
                    }
