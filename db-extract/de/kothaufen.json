                "senses": [
                    {
                        "sense_id": "5a93bcfb-3b76-34fe-8a5d-c9256700a6eb",
                        "entry_id": "83dacc67-2ea6-30ad-9a1f-ff791cb50aef",
                        "glosses": [
                            "Haufen aus Exkrementen, Ausscheidungen des Darms"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0d07d14-868c-4ada-bc30-5d44058a03c9",
                                "sense_id": "5a93bcfb-3b76-34fe-8a5d-c9256700a6eb",
                                "text": "„Selbst wenn der Hund vor den Augen des Amtmanns einen Kothaufen fallen lässt und sich der Hundebesitzer dann mit seinem Tier aus dem Staub macht, ist der Ordnungsamtler machtlos.“"
                            },
                            {
                                "example_id": "c38f1096-38eb-4eb0-9407-75a2238e53d8",
                                "sense_id": "5a93bcfb-3b76-34fe-8a5d-c9256700a6eb",
                                "text": "„Er stellte Fallen und Kameras auf und durchsuchte Baumhöhlen, aber bis auf einen Kothaufen fand er zunächst nichts.“"
                            },
                            {
                                "example_id": "84a20aa3-d572-41d8-b1ce-fe6d058dcb5a",
                                "sense_id": "5a93bcfb-3b76-34fe-8a5d-c9256700a6eb",
                                "text": "„Laut dem Schweizer Biologen Daniel Haag-Wackernagel, der an der Universität Basel lehrt, geben Tauben alle halbe Stunde einen Kothaufen ab, unabhängig davon, wo sie sind.“"
                            },
                            {
                                "example_id": "ff341006-cd81-46b7-b8af-25a61d23e2db",
                                "sense_id": "5a93bcfb-3b76-34fe-8a5d-c9256700a6eb",
                                "text": "„Dafür fanden die Archäologinnen und Archäologen mitten in der Feuerstelle einen Kothaufen, vermutlich von einem Menschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
