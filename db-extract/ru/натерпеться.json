                "senses": [
                    {
                        "sense_id": "f24280dc-235d-38bb-bc84-48fbdd98cb9f",
                        "entry_id": "d0cfd271-e30f-3c92-944c-2a1c6519ae2c",
                        "glosses": [
                            "to experience, to suffer a lot"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e5d94a0c-1434-4014-affb-c23436a7c77b",
                                "sense_id": "f24280dc-235d-38bb-bc84-48fbdd98cb9f",
                                "text": "— Да, она́ эксцентри́чная была́… Натерпе́лся я от неё. Быва́ло, оби́дится на что́-нибудь и начнёт не́рвничать… А пото́м что бы́ло?",
                                "translation": "\"Yes, she was eccentric. I suffered enough with her. She would take offence at some trifle and then get nervous. . . . And what happened afterwards?\"",
                                "english": "\"Yes, she was eccentric. I suffered enough with her. She would take offence at some trifle and then get nervous. . . . And what happened afterwards?\""
                            }
                        ]
                    }
                ],
