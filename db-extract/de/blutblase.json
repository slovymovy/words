                        "source_sense_id": "cd553368-e09c-3ec2-86d3-e95935fff17f",
                        "source_sense_description": "Blase, die mit Blut gefüllt ist",
                        "target_lang_word": "bloedblaar",
                        "target_lang_code": "nl",
