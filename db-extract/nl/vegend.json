                "senses": [
                    {
                        "sense_id": "ed01d5f1-2125-3d12-9e20-f98b449d337c",
                        "entry_id": "3b94dfad-66c9-39b0-921f-b44c21b33509",
                        "glosses": [
                            "bezig met vegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4dde34d-87d6-4add-8e5a-1e41283a6b69",
                                "sense_id": "ed01d5f1-2125-3d12-9e20-f98b449d337c",
                                "text": "De vingerafdruksensor van de nieuwe Galaxy Note is net als de S5 en de Galaxy Alpha uitgerust met Synaptics’ Natural ID-technolgie. Dat betekent dat de gebruiker het scherm en de home-knop moet gebruiken om in een vegende beweging naar beneden een vingerafdruk in te voeren."
                            },
                            {
                                "example_id": "731eb339-34ec-44fb-ad11-32cf892740b3",
                                "sense_id": "ed01d5f1-2125-3d12-9e20-f98b449d337c",
                                "text": "’Jan van Mebo-transport? Het is beter dat u rechtsomkeert maakt”, zegt een bebrilde, vegende bewoner van het Brabantse Wernhout dinsdagmiddag op zijn erf, even buiten de bebouwde kom."
                            }
                        ]
                    }
                ],
