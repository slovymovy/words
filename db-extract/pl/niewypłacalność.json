                    {
                        "translation_id": "79fd62e7-dd46-4815-875f-94fe2351bd15",
                        "source_entry_id": "d43247aa-0f9c-3bd4-9606-a5c7d2793adc",
                        "source_sense_id": "981e1b52-0cbd-3cc6-8e4c-59fcc202fc85",
                        "target_lang_word": "несостоятельность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "несостоятельность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "28ce197c-89ef-3b37-bd98-73adb94f7661",
                                        "entry_id": "5ba97970-d1fc-3614-8b9b-40ac87ffb7fc",
                                        "glosses": [
                                            "книжн. бездоказательность, неубедительность, неосновательность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba9938d3-f0ca-4ae0-904a-c68508ef26dc",
                                                "sense_id": "28ce197c-89ef-3b37-bd98-73adb94f7661",
                                                "text": "Так было и со мной. Я понимал всю несостоятельность речей Феди Горошкова, мог доказать нелепость, невероятность или сомнительность каждой его сплетни, видел глупость его соображений, а вместе с тем мне невольно думалось: «А ведь почему-нибудь говорят же? Кто ж его знает, что может быть?»"
                                            },
                                            {
                                                "example_id": "88599e03-30dd-499a-8313-3056918d3baf",
                                                "sense_id": "28ce197c-89ef-3b37-bd98-73adb94f7661",
                                                "text": "Но этот рецидив «естественного порядка» и «естественного права», при всей его научной несостоятельности, пожалуй, даже симпатичен нам."
                                            },
                                            {
                                                "example_id": "57702e41-eb83-4611-bf1c-97e69a747241",
                                                "sense_id": "28ce197c-89ef-3b37-bd98-73adb94f7661",
                                                "text": "Он велел профессору зайти к ним в гости и убедиться в несостоятельности его толкований."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c4844b6-cdb2-34e9-b94e-52398153fcbb",
                                        "entry_id": "5ba97970-d1fc-3614-8b9b-40ac87ffb7fc",
                                        "glosses": [
                                            "юр. невозможность человека исполнить свои долговые обязательства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b963894-70e5-4d8a-85ff-e130b655d15c",
                                                "sense_id": "0c4844b6-cdb2-34e9-b94e-52398153fcbb",
                                                "text": "В громадной печи ярко пылала ржаная солома, только что отслужившая свою предпоследнюю службу в роли подстилки для людей, рассуждавших описанным вечером о барской несостоятельности по счётной части."
                                            },
                                            {
                                                "example_id": "60cb623f-a53c-48b9-9b2e-7d8f9fa29b99",
                                                "sense_id": "0c4844b6-cdb2-34e9-b94e-52398153fcbb",
                                                "text": "Содержатель бань Вноровский, где убит урядник Леонтович, оштрафован генерал-губернатором на три тысячи с заменой в случае несостоятельности трехмесячным тюремным заключением, за непринятие мер к задержанию злодея."
                                            },
                                            {
                                                "example_id": "1410881d-3d14-4628-b813-48e5bc185d80",
                                                "sense_id": "0c4844b6-cdb2-34e9-b94e-52398153fcbb",
                                                "text": "Денег на все выдачи не хватит, и объявят несостоятельность."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
