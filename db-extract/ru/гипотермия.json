                                        "entry_id": "ceeabee9-84bf-3fd2-995b-e1fc7987b6fe",
                                        "glosses": [
                                            "condizione quando la temperatura corporea scende sotto quella normale a causa di prolungata esposizione al freddo"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c717235-6684-4117-92b7-3606cf4381bf",
                        "source_entry_id": "9b59bade-2896-3bc1-abae-2583977acf9a",
