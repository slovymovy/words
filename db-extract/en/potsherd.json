    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fa78713d-270b-3613-bd12-72a1eba630a3",
                "word": "potsherd",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7f245df5-8cb8-4477-a338-c948c50916a1",
                        "entry_id": "fa78713d-270b-3613-bd12-72a1eba630a3",
                        "tags": [
                            "plural"
                        ],
                        "form": "potsherds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8a619bf-5590-3375-9589-f174af3a5d46",
                        "entry_id": "fa78713d-270b-3613-bd12-72a1eba630a3",
                        "glosses": [
                            "A piece of ceramic from pottery, often found on an archaeological site."
                        ],
                        "tags": [
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "11aa0742-1554-45e8-9575-377ad1a75c60",
                                "sense_id": "a8a619bf-5590-3375-9589-f174af3a5d46",
                                "text": "But this madde Amalecke, / Lyke to a Mamelek, / He regardeth lordes / No more than potshordes; […]"
                            },
                            {
                                "example_id": "e84a5f17-0b9b-4050-a61c-3fa1d18ba75e",
                                "sense_id": "a8a619bf-5590-3375-9589-f174af3a5d46",
                                "text": "[W]ho can deny but that the rod of Gods mouth is indeed Virga virtutis, a rod of strength, an iron rod, able to deale with all humane reaſonings, as a hammer with a potſherd, which though to the hand of a man it may feele as hard as a rocke, yet is too brittle to endure the blow of an iron rod?"
                            },
                            {
                                "example_id": "7e084f34-2ec3-4602-a339-bb8d63211b31",
                                "sense_id": "a8a619bf-5590-3375-9589-f174af3a5d46",
                                "text": "Job took a potſherd to ſcrape himself, becauſe his hands were as full of boils as his body: This is the caſe of thy corrupt ſoul: not to be recovered but by Jeſus Chriſ, whoſe ſtrength was dried up like a potſherd, Pſal[ms] xxii. 15."
                            },
                            {
                                "example_id": "0f14030b-e7af-46c2-88d2-3704947a059a",
                                "sense_id": "a8a619bf-5590-3375-9589-f174af3a5d46",
                                "text": "[I]n the case of pottery, it [epigraphy] is usually taken to include graffiti scratched with a sharp point, and even painted inscriptions which are made before firing as part of the design of a vase, but not written documents (ostraka), in which pot-sherds are merely used as a material to write on instead of papyrus."
                            },
                            {
                                "example_id": "8067601e-6e7f-4721-9425-98d9f1705637",
                                "sense_id": "a8a619bf-5590-3375-9589-f174af3a5d46",
                                "text": "Speiser, who made excavations on Vao Island found prehistoric potsherds at a depth of 10 inches, and on the surface of the ground also."
                            },
                            {
                                "example_id": "0c5ed078-68e0-4fa6-9e9d-c57e2db985f7",
                                "sense_id": "a8a619bf-5590-3375-9589-f174af3a5d46",
                                "text": "I have been asked about the single most important artifact that I have seen. It is a single broken piece of pottery no bigger than a couple of inches, but its interpretation makes it one of the most significant artifacts in Jewish history. It is an inscribed potshard (a fragment of pottery) from Masada (in Israel) marked with the name \"ben Yair.\" […] While it remains a single potshard marked in ink, it is a powerful symbol of what motivates archaeologists in the field: a simple object that signifies an entire historical event."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aaaf36bc-7948-405c-96e5-a806a612ac98",
                        "source_entry_id": "fa78713d-270b-3613-bd12-72a1eba630a3",
                        "source_sense_id": "a8a619bf-5590-3375-9589-f174af3a5d46",
                        "source_sense_description": "piece of ceramic from pottery",
                        "target_lang_word": "potscherf",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "potscherf",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ca673496-df16-3088-bf25-5922b920ae5e",
                                        "entry_id": "a9f27e82-2e7f-34b1-bdf8-93d146dc9263",
                                        "glosses": [
                                            "deel van een gebroken pot van aardewerk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a0a0fcb-5468-4d18-a1ce-5b3c4aa6ab06",
                                                "sense_id": "ca673496-df16-3088-bf25-5922b920ae5e",
                                                "text": "Op dit moment is het archeologisch onderzoek bezig aan de zuidkant van de Leugemorsweg. Voor het oog van de camera's haalt Flamman een grote potscherf uit de veiliggestelde bodemvonsten. \"De maat en ronding duidt erop dat dit een forse voorraadpot was\", schetst de archeoloog met zijn handen een maat 'flinke viskom'."
                                            },
                                            {
                                                "example_id": "618943cd-6725-4634-b3a7-9fe0d7e9b13a",
                                                "sense_id": "ca673496-df16-3088-bf25-5922b920ae5e",
                                                "text": "Rond 1850 verordonneerde staatsman Thorbecke dat straten een naam moesten krijgen, vertelt René Dings. „Maar de gemeenten voelden zich nog niet meteen geroepen, dus vernoemden aannemers hun zussen en zoons. Nu zijn er hele componistenbuurten en vogelwijken. Maar er is ook een Vinexlocatie die Middeleeuwen heet, met straatnamen als Vuistbijl of Potscherf. En als je er rechtdoor rijdt, kom je zo in de Romeinse Tijd.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e6d28f9-2b17-469b-8df2-a6ae1ac7e5cb",
                        "source_entry_id": "fa78713d-270b-3613-bd12-72a1eba630a3",
                        "source_sense_id": "a8a619bf-5590-3375-9589-f174af3a5d46",
                        "source_sense_description": "piece of ceramic from pottery",
                        "target_lang_word": "Scherbe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scherbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d15c1bc4-84c1-3055-b997-2bfd9abf4d6c",
                                        "entry_id": "16399cad-0475-3751-8dc0-70b36caf8641",
                                        "glosses": [
                                            "ein größeres Bruchstück von einem Gegenstand, der aus Glas, Ton oder Porzellan ist/war"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2358ecf7-b7bd-4d2c-8051-4012b985d18c",
                                                "sense_id": "d15c1bc4-84c1-3055-b997-2bfd9abf4d6c",
                                                "text": "Der Boden lag voller Scherben."
                                            },
                                            {
                                                "example_id": "164eba08-5b3c-4331-9192-9613aed94eb0",
                                                "sense_id": "d15c1bc4-84c1-3055-b997-2bfd9abf4d6c",
                                                "text": "„Jays Malerei war ein Tanz von Fragmenten zum Rhythmus der Scherben.“"
                                            },
                                            {
                                                "example_id": "873c3924-5c5a-46a7-b87a-0ab8a0c7458a",
                                                "sense_id": "d15c1bc4-84c1-3055-b997-2bfd9abf4d6c",
                                                "text": "„Sie trat vorsichtig über die umhergestreuten Scherben hinweg und setzte sich auf das Bett.“"
                                            },
                                            {
                                                "example_id": "76646185-5bd7-406c-9c93-b3d60f2d5c35",
                                                "sense_id": "d15c1bc4-84c1-3055-b997-2bfd9abf4d6c",
                                                "text": "„Um so mehr wird es Sie – wie auch damals mich – überraschen, daß in dem Sarg Kants eine Scherbe mit einem seltsamen Abdruck gefunden wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1649a127-6286-4b07-8b53-26be4ae40e2a",
                        "source_entry_id": "fa78713d-270b-3613-bd12-72a1eba630a3",
