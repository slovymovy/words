                                        "glosses": [
                                            "One who disclaims, disowns, or renounces."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0770485b-29f9-3221-8b8b-1b51cedd36a3",
                                        "entry_id": "b912e5d5-b7ab-30e9-9797-94dd8df36695",
                                        "glosses": [
                                            "A public disavowal, as of responsibility, pretensions, claims, opinions, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01f7faf2-c9b9-3183-8586-c1601035b0e2",
                                        "entry_id": "b912e5d5-b7ab-30e9-9797-94dd8df36695",
                                        "glosses": [
                                            "A denial, disavowal, or renunciation, as of a title, claim, interest, estate, or trust; relinquishment or waiver of an interest or estate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d037265a-9bbb-4cd8-87d4-22b2e50ad7cf",
                                                "sense_id": "01f7faf2-c9b9-3183-8586-c1601035b0e2",
                                                "text": "Subject to the provisions of this section, any person who, after the commencement of this Act, succeeds to a peerage in the peerage of England, Scotland, Great Britain or the United Kingdom may, by an instrument of disclaimer delivered to the Lord Chancellor within the period prescribed by this Act, disclaim that peerage for his life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3006c57b-6e76-3e72-9ac8-962567870d14",
                                        "entry_id": "b912e5d5-b7ab-30e9-9797-94dd8df36695",
                                        "glosses": [
                                            "A disclosure of an interest, relationship, or the like."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06de2e37-2aff-45fc-927f-9e056589eac2",
                                                "sense_id": "3006c57b-6e76-3e72-9ac8-962567870d14",
                                                "text": "It interviewed, among others, the director of Vasant Valley School, owned by the same family that part-owns Mail Today. No disclaimer was carried stating as much."
                                            },
                                            {
                                                "example_id": "98ee45e5-8897-4ee7-8e07-6d9357a58f52",
                                                "sense_id": "3006c57b-6e76-3e72-9ac8-962567870d14",
                                                "text": "Though the fact that the two men do business together was disclosed on air, a recent op-ed penned by Lako and published on the Hannity show’s website had no such disclaimer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disclaimer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d59fd97-dce9-3cff-b090-da26f31a56bd",
                                        "entry_id": "e32c7d6a-d9a7-363c-980f-feb62b6edb5b",
                                        "glosses": [
                                            "To disclaim or disavow, as by appending a legal disclaimer."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b7a8b20-9a3c-442c-b573-a5cc0ea8b889",
                                                "sense_id": "7d59fd97-dce9-3cff-b090-da26f31a56bd",
                                                "text": "When you can hear your lover say that painful thing straight up, without a lot of disclaimering or softening to make sure that your feelings will be hurt as little as possible, […]"
                                            },
                                            {
                                                "example_id": "cc244ffa-ef6e-47f5-a050-31b5e8dbcfdb",
                                                "sense_id": "7d59fd97-dce9-3cff-b090-da26f31a56bd",
                                                "text": "Now that I have disclaimered myself, I can tell you the story of how one of the guards smoked Salvia divinorum and tripped balls for fifteen minutes […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
