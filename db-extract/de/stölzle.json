                ],
                "senses": [
                    {
                        "sense_id": "c38a4f64-3e4f-36db-8567-d9c921fc9c07",
                        "entry_id": "21b66ce1-b743-36f3-80d4-7df06d1b223f",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5142103-2cac-4926-b708-5eeaa91a2fc0",
                                "sense_id": "c38a4f64-3e4f-36db-8567-d9c921fc9c07",
                                "text": "Frau Stölzle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "63b19077-d055-42a1-ae1f-99007f3d6078",
                                "sense_id": "c38a4f64-3e4f-36db-8567-d9c921fc9c07",
                                "text": "Herr Stölzle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4d4d1dea-14fc-4752-bf35-1a0c24928897",
                                "sense_id": "c38a4f64-3e4f-36db-8567-d9c921fc9c07",
                                "text": "Die Stölzles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "38cf8eeb-05ad-4c89-befa-070e7a139090",
                                "sense_id": "c38a4f64-3e4f-36db-8567-d9c921fc9c07",
                                "text": "Der Stölzle trägt nie die Schals, die die Stölzle ihm strickt."
                            },
                            {
                                "example_id": "e74d8e7a-7946-4484-859e-0daae82ebfc7",
                                "sense_id": "c38a4f64-3e4f-36db-8567-d9c921fc9c07",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stölzle kommt, geht der Herr Stölzle.“"
                            },
                            {
                                "example_id": "575b50c6-9d55-489d-affc-9ffbe089f7b6",
                                "sense_id": "c38a4f64-3e4f-36db-8567-d9c921fc9c07",
                                "text": "Stölzle kommt und geht."
                            },
                            {
                                "example_id": "350dc072-0085-4876-a4b6-a4847f8b6591",
                                "sense_id": "c38a4f64-3e4f-36db-8567-d9c921fc9c07",
                                "text": "Stölzles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
