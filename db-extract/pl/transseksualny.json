                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "398dcf7d-67fd-3485-b469-e2e47c48cbe5",
                                        "entry_id": "8d5f9ac5-b3b7-3de0-9ada-4585b171e0df",
                                        "glosses": [
                                            "eine Geschlechtsidentität habend, die nicht mit dem (ursprünglichen) körperlichen Geschlecht übereinstimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "257d2c58-4afb-4e02-ace4-0e8d7ef7646f",
                                                "sense_id": "398dcf7d-67fd-3485-b469-e2e47c48cbe5",
                                                "text": "„Die Vornamen einer Person sind auf ihren Antrag vom Gericht zu ändern, wenn […] sie sich auf Grund ihrer transsexuellen Prägung nicht mehr dem in ihrem Geburtseintrag angegebenen Geschlecht, sondern dem anderen Geschlecht als zugehörig empfindet und seit mindestens drei Jahren unter dem Zwang steht, ihren Vorstellungen entsprechend zu leben […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
