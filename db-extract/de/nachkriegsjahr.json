                "senses": [
                    {
                        "sense_id": "006df5cd-5386-35e1-b1be-f5d531a91fda",
                        "entry_id": "a1087f6e-f984-34ee-913a-79bb14d116b6",
                        "glosses": [
                            "Jahr nach dem Ende eines Krieges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5657c0b-ec6e-41f8-8cdd-215381c3491a",
                                "sense_id": "006df5cd-5386-35e1-b1be-f5d531a91fda",
                                "text": "„Die Nachkriegsjahre mit ihren heißen Sommern und eiskalten Wintern waren gezeichnet von der Sorge um das tägliche Brot.“"
                            },
                            {
                                "example_id": "13b2ed38-f639-427e-9c7b-43969b742971",
                                "sense_id": "006df5cd-5386-35e1-b1be-f5d531a91fda",
                                "text": "„Besonders im ersten Nachkriegsjahr waren die Bedingungen in den Lagern oft katastrophal.“"
                            },
                            {
                                "example_id": "f89f2305-c46e-420f-ad00-d4c0d8ed7724",
                                "sense_id": "006df5cd-5386-35e1-b1be-f5d531a91fda",
                                "text": "„Dort kam ich selbst Anfang der fünfziger Jahre zur Welt, nachdem meine Eltern in den Nachkriegsjahren noch einmal zwei Söhne verloren hatten, die jeweils kurz nach der Geburt gestorben waren.“"
                            },
                            {
                                "example_id": "4f91be66-849d-4ade-8121-f1425e000784",
                                "sense_id": "006df5cd-5386-35e1-b1be-f5d531a91fda",
                                "text": "„Meine Eltern hatten es in den Nachkriegsjahren nicht leicht miteinander.“"
                            },
                            {
                                "example_id": "86e35bd4-fc54-46ef-8d49-a2413c1f3476",
                                "sense_id": "006df5cd-5386-35e1-b1be-f5d531a91fda",
                                "text": "„In den Nachkriegsjahren erschwerten Preissteigerungen das Alltagsleben, da ihnen keine Lohnerhöhungen entsprachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
