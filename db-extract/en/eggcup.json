                    {
                        "translation_id": "a7a4bfc7-5bef-4b42-a5e9-5e40cb15587f",
                        "source_entry_id": "b9888fec-fe58-3edb-a8bb-6f25b23763a5",
                        "source_sense_id": "65d5b73b-4e35-31d9-8b4a-a7f785990c56",
