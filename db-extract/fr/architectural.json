                        ],
                        "form": "architecturaux"
                    },
                    {
                        "form_id": "59a7bf19-78a2-4884-b4b2-6c6be31e574a",
                        "entry_id": "6ade56b9-4744-3502-b73d-465e2777258c",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "architecturale"
                    },
                    {
                        "form_id": "d626ce83-93d8-49e0-a37e-3efb3f9aaba7",
                        "entry_id": "6ade56b9-4744-3502-b73d-465e2777258c",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "architecturales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0feac190-26a7-38ea-b635-1a5a56e09848",
                        "entry_id": "6ade56b9-4744-3502-b73d-465e2777258c",
                        "glosses": [
                            "Qui a rapport à l’architecture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1d5a4ff-8b2d-4ce0-9540-8def5ae963e4",
                                "sense_id": "0feac190-26a7-38ea-b635-1a5a56e09848",
                                "text": "La perspective des rues se dessinait par des lignes architecturales que pas un char, pas un cheval, pas un esclave ne troublait."
                            },
                            {
                                "example_id": "b0f93c35-6da5-4386-8ecc-9712a5d5690c",
                                "sense_id": "0feac190-26a7-38ea-b635-1a5a56e09848",
                                "text": "Cependant, le caractère vraiment ornemental et architectural des armoiries, qui ne tolérait pas une représentation des objets sous leur forme parfaitement naturelle, se conserva […] jusqu’au milieu du 16ᵉ [siècle]."
                            },
                            {
                                "example_id": "c0919242-eb31-4e0d-b0b0-83f6e8695d32",
                                "sense_id": "0feac190-26a7-38ea-b635-1a5a56e09848",
                                "text": "Toujours selon l’ingénieur de Facebook, les technologies proposées par Apple avaient largement évolué depuis le temps. D’ailleurs, des modifications dans le SDK (Software development kit) d’iOS avaient forcé l’équipe à revoir certaines approches architecturales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e026cf1-c313-45ef-a83a-dee9ebcc1279",
                        "source_entry_id": "6ade56b9-4744-3502-b73d-465e2777258c",
                        "source_sense_id": "0feac190-26a7-38ea-b635-1a5a56e09848",
                        "target_lang_word": "architektonisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "architektonisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25a46aac-4975-34bf-9969-9f84de4a2c68",
                                        "entry_id": "380afd71-6b69-35ca-acec-8f2eee2d1a09",
                                        "glosses": [
                                            "die Architektur oder Architektonik betreffend, was zu ihr gehört oder auf ihr beruht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49c1c861-2ee4-42b0-b9b9-7e1ad29c28c6",
                                                "sense_id": "25a46aac-4975-34bf-9969-9f84de4a2c68",
                                                "text": "„Ringsum erheben sich klassizistische Straßenzüge, stuckselig und mit der architektonischen Großzügigkeit der Jahrhundertwende entworfen.“"
                                            },
                                            {
                                                "example_id": "d8515235-04be-4734-a9b6-b2fbc7a32994",
                                                "sense_id": "25a46aac-4975-34bf-9969-9f84de4a2c68",
                                                "text": "„Die gegenüber einem reinen Zweckbau deutlich höheren Kosten nahm die Stiftungsuniversität für ihre architektonischen Ambitionen in Kauf, zumal auch die öffentliche Hand von dem Großvorhaben angetan war und großzügig Fördermittel bereitstellte: […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89be5d64-1bf6-4821-85a8-e6111bf291e7",
                        "source_entry_id": "6ade56b9-4744-3502-b73d-465e2777258c",
                        "source_sense_id": "0feac190-26a7-38ea-b635-1a5a56e09848",
                        "target_lang_word": "architectural",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "architectural",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "777ef00c-946e-3076-889c-9d26c0d5e0bc",
                                        "entry_id": "420c4c88-aef1-387e-acaf-9ff5c1ff021f",
                                        "glosses": [
                                            "Pertaining to architecture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46ab2f12-a088-410f-96a9-e4d375ed098c",
                                                "sense_id": "777ef00c-946e-3076-889c-9d26c0d5e0bc",
                                                "text": "The original family who had begun to build a palace to rival Nonesuch had died out before they had put up little more than the gateway, so that the actual structure which had come down to posterity retained the secret magic of a promise rather than the overpowering splendour of a great architectural achievement."
                                            },
                                            {
                                                "example_id": "e26e793c-b41b-4a68-90fc-3b5dfa956a75",
                                                "sense_id": "777ef00c-946e-3076-889c-9d26c0d5e0bc",
                                                "text": "Wheelchair users are restricted entry into many structures and public facilities by architectural barriers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "220ae4c5-d56f-3314-b0bd-68da094a9036",
                                        "entry_id": "420c4c88-aef1-387e-acaf-9ff5c1ff021f",
                                        "glosses": [
                                            "Resembling architecture in style; seeming to have been designed (by an architect)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
