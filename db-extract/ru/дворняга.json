                    {
                        "translation_id": "05cfadd4-e656-4446-a697-735cb49275ea",
                        "source_entry_id": "01430fca-73eb-3518-bb24-a270bfba8f2f",
                        "source_sense_id": "dd4b3c42-2118-3f5a-9be9-6f4e8b203177",
                        "target_lang_word": "Köter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Köter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45551c7e-4f4f-347f-8823-b485cc3ca012",
                                        "entry_id": "0a03febd-63f2-346e-ba75-610be040641e",
                                        "glosses": [
                                            "Hund^([1])"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f18338c0-ce0b-42f6-a7fb-2a14f1a4cd82",
                                                "sense_id": "45551c7e-4f4f-347f-8823-b485cc3ca012",
                                                "text": "Jag den blöden Köter da weg!"
                                            },
                                            {
                                                "example_id": "4217059e-2d93-4d14-85a1-64a3b0b6daa1",
                                                "sense_id": "45551c7e-4f4f-347f-8823-b485cc3ca012",
                                                "text": "„Über den Leuchter stolpernd, an den er nicht mehr gedacht, fand er aber doch zuletzt die Klinke, öffnete sie und warf den jungen winselnden Köter mit einem zwar leise gemurmelten, aber desto herzlicher gemeinten Fluch ins Freie.“"
                                            },
                                            {
                                                "example_id": "3f8b759b-61a5-435b-b4b6-7ff9d07d924b",
                                                "sense_id": "45551c7e-4f4f-347f-8823-b485cc3ca012",
                                                "text": "„Sie benahm sich wie der bissigste Köter, den man sich vorstellen kann, und begann sofort, den Kutscher in einem breiten schottischen Dialekt zu beschimpfen.“"
                                            },
                                            {
                                                "example_id": "4961a00c-47eb-4e8e-897f-0d27c7de765f",
                                                "sense_id": "45551c7e-4f4f-347f-8823-b485cc3ca012",
                                                "text": "„Dann schlenderte ich zum Lager hinüber, um meine Nachbarn der Belästigung durch meinen ungezogenen Köter zu entheben.“"
                                            },
                                            {
                                                "example_id": "c93cb26e-00df-4a71-8ced-a756d6fe18d4",
                                                "sense_id": "45551c7e-4f4f-347f-8823-b485cc3ca012",
                                                "text": "„Zu diesem Zeitpunkt hatte ich große Lust, das Kind zu packen und zu schütteln, wären da nicht die beiden Menschen fressenden Köter gewesen, die mir den Weg versperrten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b8ff918-9d72-439e-bdec-dd538190bc54",
                        "source_entry_id": "01430fca-73eb-3518-bb24-a270bfba8f2f",
                        "source_sense_id": "dd4b3c42-2118-3f5a-9be9-6f4e8b203177",
                        "target_lang_word": "Hofhund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hofhund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "335cd060-679c-3759-a118-6b453875955a",
                                        "entry_id": "bb5b2415-de0e-3273-b857-68d6d287348e",
                                        "glosses": [
                                            "Hund, der zwecks Bewachung eines Anwesens außer Haus/auf dem Hof gehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45a1d2ec-e1b8-41d3-87a6-92560a97ca59",
                                                "sense_id": "335cd060-679c-3759-a118-6b453875955a",
                                                "text": "Unser Hofhund ist schon halb taub."
                                            },
                                            {
                                                "example_id": "eb27295e-83e1-4356-ae4a-33b86da9eca0",
                                                "sense_id": "335cd060-679c-3759-a118-6b453875955a",
                                                "text": "„Der Hofhund strich kläffend um Wagen und Pferde herum.“"
                                            },
                                            {
                                                "example_id": "eb39a115-eeb8-4953-8a29-31995217a30b",
                                                "sense_id": "335cd060-679c-3759-a118-6b453875955a",
                                                "text": "„Er nahm die Beine unter die Arme, so schnell er konnte, und der Hofhund verfolgte ihn bellend hinunter zum Fluß, der nordwärts fließt.“"
                                            },
                                            {
                                                "example_id": "7ca1f193-31ff-420d-a969-20a51c025637",
                                                "sense_id": "335cd060-679c-3759-a118-6b453875955a",
                                                "text": "„Die ersten zwei Jahre im Internat hatte man ihn an einem Bettrahmen gekettet, so wie man Hofhunde an Bäume kettete.“"
                                            },
                                            {
                                                "example_id": "6b66d750-d293-4fab-aea2-9fe796ef4be8",
                                                "sense_id": "335cd060-679c-3759-a118-6b453875955a",
                                                "text": "„Die beiden Hofhunde liefen auf sie zu, beschnupperten sie und die Autoreifen und markierten sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
