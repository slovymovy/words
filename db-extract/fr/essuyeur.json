                                        "sense_id": "83b3b319-ce5d-3b5b-b6d2-67395bea0ce3",
                                        "entry_id": "fddda58d-2292-3acb-a30f-4193557fe354",
                                        "glosses": [
                                            "A program or process that erases data."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3650c30c-f686-3673-9b04-68b64bf93d63",
                                        "entry_id": "fddda58d-2292-3acb-a30f-4193557fe354",
                                        "glosses": [
                                            "A junior role in the engine room of a ship, someone who wipes down machinery and generally keeps it clean."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "186c0d21-070e-3969-8bc1-4e2f87efe02e",
                                        "entry_id": "fddda58d-2292-3acb-a30f-4193557fe354",
                                        "glosses": [
                                            "An impertinent young man."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc1b12bb-dec2-450e-89d3-e16cb2037007",
                                                "sense_id": "186c0d21-070e-3969-8bc1-4e2f87efe02e",
                                                "text": "I ask you now, ain't honesty a-written on my feechurs? / I say the wiper should be scorched who'd rob his feller-creatures."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wiper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e48f7c5a-ea03-3007-8e00-7418b665fe97",
                                        "entry_id": "91932104-f955-3514-ba16-c4d01f0ec610",
                                        "glosses": [
                                            "A hybrid fish variety artificially bred from eggs of striped bass (Morone saxatilis) fertilized with white bass (Morone chrysops) sperm, or the opposite combination."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f505903-185f-450c-a51f-684f1bb406ad",
                                                "sense_id": "e48f7c5a-ea03-3007-8e00-7418b665fe97",
                                                "text": "As is the customary method for catching wipers at Keith Sebelius Reservoir, the trio was trolling with crank baits."
                                            },
                                            {
                                                "example_id": "bb1bcbbf-9975-4694-84e3-096d3de9199b",
                                                "sense_id": "e48f7c5a-ea03-3007-8e00-7418b665fe97",
                                                "text": "M. saxatilis X M. chrysops hybrids (wipers) are difficult to distinguish, showing intermediacy from parental types in basihyal tooth formation"
                                            },
                                            {
                                                "example_id": "4fb673f7-7839-45ed-b919-abd217ce7c3d",
                                                "sense_id": "e48f7c5a-ea03-3007-8e00-7418b665fe97",
                                                "text": "With good reason, wipers are among the most stocked hybrid gamefish in the United States. They won’t rival actual stripers for overall size, but wiper find a happy medium between the revered striper and the much smaller, pesky white bass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
