                            }
                        }
                    ],
                    "synonyms": [
                        "excellent",
                        "outstanding",
                        "exceptional",
                        "first-rate",
                        "splendid"
                    ],
                    "antonyms": [
                        "poor",
                        "inferior",
                        "shoddy"
                    ],
                    "common_phrases": [
                        "sterling reputation",
                        "sterling work",
                        "sterling effort",
                        "sterling character"
