                        "sense_id": "a9775620-7cdf-363e-8289-f8a1808164f8",
                        "entry_id": "478be0a2-55fb-398f-947c-3c0429680470",
                        "glosses": [
                            "Activité consistant à récolter l’eau d’érable et à en tirer les produits de l’érable en mars et avril."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "220bab0b-e46e-47e8-90cd-9a8bb8be52a1",
                                "sense_id": "a9775620-7cdf-363e-8289-f8a1808164f8",
                                "text": "J’espère que nos installations seront prêtes pour les sucres."
                            },
                            {
                                "example_id": "975c8eb6-8526-4b5f-b2b6-70a935cf0e81",
                                "sense_id": "a9775620-7cdf-363e-8289-f8a1808164f8",
                                "text": "Les temps des sucres, la période des sucres, la saison des sucres. Aller aux sucres."
                            },
                            {
                                "example_id": "43455596-fdc6-47ba-818c-4c70e443c2b9",
                                "sense_id": "a9775620-7cdf-363e-8289-f8a1808164f8",
                                "text": "La moindre des choses est de dire qu’André Lessard est né dans le sirop. Il voit le jour un 30 mars… en pleine période des sucres."
                            }
                        ]
                    }
                ],
