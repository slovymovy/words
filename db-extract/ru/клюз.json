                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klüse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81b71cd1-41df-392e-a156-9f818e769601",
                                        "entry_id": "65a74d05-f96d-3aab-adf1-07033892f48c",
                                        "glosses": [
                                            "Durchlass/Öffnung in der Schiffswand für die Ankerkette, Taue und dergleichen"
                                        ],
                                        "tags": [
                                            "Schiffsbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b65c1df5-68dc-4ac4-b7c1-3cff3a958356",
                                                "sense_id": "81b71cd1-41df-392e-a156-9f818e769601",
                                                "text": "„Gegen Mitternacht hatten ihn die Ankerketten geweckt, die durch die Klüsen rasselten.“"
                                            },
                                            {
                                                "example_id": "7f2ebabb-9bbc-409f-96ec-e59880e2fe16",
                                                "sense_id": "81b71cd1-41df-392e-a156-9f818e769601",
                                                "text": "„Als es wieder still war, hörte man deutlich, wie Ankerketten in den Klüsen rasselten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b3842ffd-014c-3e57-a5af-e2c2d6b81b37",
                                        "entry_id": "65a74d05-f96d-3aab-adf1-07033892f48c",
                                        "glosses": [
                                            "umgangssprachlich, nur Plural: Augen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43e4fa1a-e35f-4ea6-9f5d-acc33108f11a",
                                                "sense_id": "b3842ffd-014c-3e57-a5af-e2c2d6b81b37",
                                                "text": "Mach endlich deine Klüsen auf!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "540bdf5e-0423-4313-b0b2-272b976e35fd",
                        "source_entry_id": "98b6c9c0-d316-3ccd-a878-1acc2a858170",
                        "source_sense_id": "c2edcb94-3dde-3e7a-82e5-62b4d34d0786",
                        "target_lang_word": "écubier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écubier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aae67084-7fae-38bf-8ec0-f33368ceb746",
                                        "entry_id": "d2372866-0a2b-3fa8-9e17-b269c86bee76",
                                        "glosses": [
                                            "Ouverture pratiquée vers l’avant d’un bâtiment, généralement de chaque côté de l’étrave, destinée à faire passer la chaîne d’ancre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7925772-7e3f-4cf3-a03b-4f901d2b21ab",
                                                "sense_id": "aae67084-7fae-38bf-8ec0-f33368ceb746",
                                                "text": "Gaspard entendit le bruit de la chaîne d’ancre qui se dévidait dans l’écubier."
                                            },
                                            {
                                                "example_id": "e20c3cd1-be7e-49aa-aeca-0833c77bdaf2",
                                                "sense_id": "aae67084-7fae-38bf-8ec0-f33368ceb746",
                                                "text": "La veille de Noël, pendant la nuit, je fus réveillé par un bruit de chaîne frottant contre des écubiers."
                                            },
                                            {
                                                "example_id": "79191e00-6022-4aed-a0a8-f729617d816c",
                                                "sense_id": "aae67084-7fae-38bf-8ec0-f33368ceb746",
                                                "text": "Dès qu’elle quittait ma main, elle avait brusquement un regard de voilier qui pique du nez dans la houle ; des écubiers dardés fixement sur la vague même."
                                            },
                                            {
                                                "example_id": "7192fcd3-8a9f-4e0e-b309-f1b7a622d3f4",
                                                "sense_id": "aae67084-7fae-38bf-8ec0-f33368ceb746",
                                                "text": "Le puits aux chaînes est tout à l’avant : étroit, froid, noir, malodorant, dégouttant d’humidité, sinistrement éclairé par une ampoule électrique encastrée sous un grillage d’acier ; les chaînes des ancres agitées par le roulis grincent, s’entrechoquent — de temps en temps une douche glacée tombe des écubiers —, de l’eau clapote dans le fond ; des choses molles, visqueuses luisent et sentent comme la fange d’un port à marée basse : les entrailles du désespoir !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
