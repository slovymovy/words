{
    "word_family": [
        "reign",
        "sovereign"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0978fd60-0ada-3608-926a-2cdb1dd559a0",
                    "sense_definition": "Currently holding a position of power or authority, especially as a monarch or champion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reigning</w> world champion defended his title in a very difficult match last night.",
                            "target_lang_translations": {
                                "zh": "这位<w>现任</w>世界冠军昨晚在一场非常艰难的比赛中成功卫冕。"
                            }
                        },
                        {
                            "text": "The <w>reigning</w> monarch attended the opening ceremony of the new national library this morning.",
                            "target_lang_translations": {
                                "zh": "这位<w>在位</w>君主今天上午出席了新国家图书馆的开幕仪式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "regnant"
                    ],
                    "common_phrases": [
                        "reigning champion",
                        "reigning monarch"
                    ],
                    "target_lang_definitions": {
                        "zh": "指目前在位或保持冠军头衔的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "在位",
                                "target_lang_sense_clarification": "指君主目前处于统治地位。"
                            },
                            {
                                "target_lang_word": "现任",
                                "target_lang_sense_clarification": "指目前担任某项职务或保持某项头衔。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "439b4f93-7e39-3b71-99e9-8c76140928e3",
                    "sense_definition": "Present participle and gerund of <w>reign</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The queen has been <w>reigning</w> over the country for over fifty years now.",
                            "target_lang_translations": {
                                "zh": "女王<w>统治</w>这个国家已经超过五十年了。"
                            }
                        },
                        {
                            "text": "After <w>reigning</w> for decades, the king decided to step down and let his son rule.",
                            "target_lang_translations": {
                                "zh": "在<w>在位</w>数十年后，国王决定退位，让他的儿子执政。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb reign."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 reign 的现在分词或动名词形式，指统治或当政。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "统治",
                                "target_lang_sense_clarification": "指君主或政府管理国家。"
                            },
                            {
                                "target_lang_word": "在位",
                                "target_lang_sense_clarification": "指君主处于执政状态。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}