                        "translation_id": "daff5186-dc3d-45fc-8957-e0e30e7cf2a6",
                        "source_entry_id": "7b7bdf4d-5c3f-3dab-80a3-88a7ce55bc8e",
                        "source_sense_id": "ca1d36da-3178-3172-a824-644318520de3",
                        "target_lang_word": "right ascension",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "right ascension",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f75cc897-5609-3781-aabd-5b03f817aeb6",
                                        "entry_id": "67b31ece-c076-3e66-a849-9965a4f9e390",
                                        "glosses": [
                                            "The angular distance east of the vernal point (“the solar zenith at the March equinox”); the celestial equivalent of longitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a702f4c5-160f-4826-a928-1ba5df5fb2b0",
                                                "sense_id": "f75cc897-5609-3781-aabd-5b03f817aeb6",
                                                "text": "The sun's right ascension in time is useful to the practical astronomer in regular observatories, who adjusts his clock by sidereal time."
                                            },
                                            {
                                                "example_id": "1255e95d-e0d9-419f-8529-0632b5bf4585",
                                                "sense_id": "f75cc897-5609-3781-aabd-5b03f817aeb6",
                                                "text": "The right ascensions and declinations obtained by the preceding calculations, are the mean values, to which must be applied the corrections for the Nutation and Aberration Tables XLII. XLIII. in cases where great accuracy is required, as is now done in the Nautical Almanac for 24 of the brightest stars for 10 days in the year, and those numbers in the Nautical Almanac are to be preferred."
                                            },
                                            {
                                                "example_id": "c6f2cd07-6c9c-44da-a84c-89d8593e671c",
                                                "sense_id": "f75cc897-5609-3781-aabd-5b03f817aeb6",
                                                "text": "1988, Peter Duffett-Smith, Practical Astronomy with Your Calculator, page 35,\nThe hour-angle, H, and the right ascension, α, are related by the simple formula\nH = LST − α,\nwhere LST is the local sidereal time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
