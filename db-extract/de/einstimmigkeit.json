                ],
                "senses": [
                    {
                        "sense_id": "73aa1ed4-add2-3269-b4f3-ffdefa6b377f",
                        "entry_id": "8d3b9bfe-6a00-375a-bd3c-999cfe0a819f",
                        "glosses": [
                            "Entscheidung bei einer Abstimmung, bei der alle anwesenden Abstimmungsberechtigten für eine Sache und ohne Gegenstimme sind"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "cb671968-884e-4cd9-b590-5a06afe82d9b",
                                "sense_id": "73aa1ed4-add2-3269-b4f3-ffdefa6b377f",
                                "text": "„Weil Entscheidungen der EG auf dem Umweltsektor damals Einstimmigkeit erforderten, definierten damit die ablehnenden Länder die gemeinsame Haltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b9f7550e-3ba0-372e-a4f1-69763357e222",
                        "entry_id": "8d3b9bfe-6a00-375a-bd3c-999cfe0a819f",
                        "glosses": [
                            "Art des Musizierens, bei der nur eine Stimme erklingt"
                        ],
                        "tags": [
                            "meist Singular",
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "d5514359-397c-44d8-b527-95023bd671b8",
                                "sense_id": "b9f7550e-3ba0-372e-a4f1-69763357e222",
                                "text": "„Mit dem Wandel von der Einstimmigkeit des gregorianischen Chorals zur Polyphonie machte die mittelalterliche Musik einen ganz entscheidenden Schritt.“"
                            },
                            {
                                "example_id": "fe79dfad-300b-4cb7-af75-fc6249e2098c",
                                "sense_id": "b9f7550e-3ba0-372e-a4f1-69763357e222",
                                "text": "„Aus der Zeit der Einstimmigkeit ragen die Lieder der Troubadours, Trouvères und Minnesänger heraus, die Vorbild für die ebenfalls einstimmigen Lieder der Meistersinger waren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
