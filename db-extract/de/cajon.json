                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c8ee2d3-895c-4719-9a17-6128882a60d0",
                                "sense_id": "e47833f8-4e63-30d3-8e49-8660d3624a52",
                                "text": "„Claudio Kusnitzoff hat ein anderes Instrument dabei, er spielt seine Cajon.“"
                            },
                            {
                                "example_id": "f137cb12-a879-4bf4-83e9-13565e82744d",
                                "sense_id": "e47833f8-4e63-30d3-8e49-8660d3624a52",
                                "text": "„Statt einer großen Bass Drum hat sie ein Cajon dabei.“"
                            },
                            {
                                "example_id": "270c915a-7d6d-40e2-a059-325ed0ee8a26",
                                "sense_id": "e47833f8-4e63-30d3-8e49-8660d3624a52",
                                "text": "„In seiner Freizeit spielt er Schlagzeug und Cajon und in einer Big Band.“"
                            },
                            {
                                "example_id": "4e56d03d-0ca7-4060-9737-45e6aab593a2",
                                "sense_id": "e47833f8-4e63-30d3-8e49-8660d3624a52",
                                "text": "„Für 20 Euro bekommen die Teilnehmer zwei Stunden Unterricht mit Leihinstrumenten, E-Gitarren etwa oder den Trommelboxen Cajon.“"
                            }
                        ],
