                "senses": [
                    {
                        "sense_id": "8b51336f-4223-3c92-b192-9960696ee32f",
                        "entry_id": "4d0e8f63-4a09-3f43-acbf-5bb38088458e",
                        "glosses": [
                            "Bateau équipé pour la pêche à la morue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bdefcbe-44bc-4f2e-8d54-abed9b1bfba8",
                                "sense_id": "8b51336f-4223-3c92-b192-9960696ee32f",
                                "text": "Un morutier quittant Terre-neuve chargée de morue."
                            },
                            {
                                "example_id": "c9659fda-a970-44f5-8f12-6949a962c07c",
                                "sense_id": "8b51336f-4223-3c92-b192-9960696ee32f",
                                "text": "Une chaloupe ayant à bord cinq naufragés français à bout de forces est arrivée aujourd’hui. Il s’agit de cinq membres du morutier français Notre-Dame-du-Châtelet, du port de Saint-Malo, qui a été torpillé en plein Atlantique le 15 mai."
                            },
                            {
                                "example_id": "256202a3-9896-4b30-8a5f-df06e21d2f5e",
                                "sense_id": "8b51336f-4223-3c92-b192-9960696ee32f",
                                "text": "…; d'autre part, John Cabot qui s'était extasié devant l'extraordinaire profusion des morues sur les Grands Bancs de Terre-Neuve relança les expéditions des morutiers vers les côtes de l'Amérique."
                            }
                        ]
                    },
