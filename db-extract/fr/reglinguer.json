                "senses": [
                    {
                        "sense_id": "c67807ac-39ba-3b0c-8b67-6041c5fe766a",
                        "entry_id": "c1f2a54b-5555-3f39-ade9-4574bd5a79ae",
                        "glosses": [
                            "Remettre d’aplomb (quelque chose qui était déglingué)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0b3d980-fa64-4a7e-a7d4-73ff54982815",
                                "sense_id": "c67807ac-39ba-3b0c-8b67-6041c5fe766a",
                                "text": "C’était pas une petite pause de coudre, remboutir, rafistoler la moche enveloppe, reglinguer ensemble des pièces qui tenaient plus…"
                            },
                            {
                                "example_id": "628c7b08-282d-49c6-b00e-9ff548804be0",
                                "sense_id": "c67807ac-39ba-3b0c-8b67-6041c5fe766a",
                                "text": "Premier atterro un peu dur sur le mou, le train se déglingue, je le reglingue !"
                            },
                            {
                                "example_id": "5f62a3b3-954e-499f-bd18-f711a7c2ecf0",
                                "sense_id": "c67807ac-39ba-3b0c-8b67-6041c5fe766a",
                                "text": "OK: on peut déglinguer un patient symétrique, et heureusement le reglinguer."
                            },
                            {
                                "example_id": "9c686bea-451a-4950-9692-f17377d0bb8d",
                                "sense_id": "c67807ac-39ba-3b0c-8b67-6041c5fe766a",
                                "text": "Des petits trucs rigolos que j'ai eu envie de partager pour reglinguer mon espace perso plutot déprimant, tout compte fait ! (comtpe corrigé en compte)"
                            }
                        ]
                    }
                ],
