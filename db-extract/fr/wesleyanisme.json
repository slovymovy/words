                "senses": [
                    {
                        "sense_id": "cb9d08c5-efb5-3ed3-96ea-1c06dbb8f7d7",
                        "entry_id": "113f2e57-d7a3-3f1d-907e-5587c8a9d516",
                        "glosses": [
                            "Théologie basée sur les enseignements de John Wesley (1703-1791)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c63c89d-46a1-40d9-aa69-8080df3eb1db",
                                "sense_id": "cb9d08c5-efb5-3ed3-96ea-1c06dbb8f7d7",
                                "text": "Selon le wesleyanisme, \"la grâce, ou l'amour de Dieu, qui est à l'origine de notre salut, est libre en tous et gratuite pour tous\" (Sermon : La libre grâce). La grâce qui sauve commence par la grâce prévenante étendue à tous les hommes."
                            },
                            {
                                "example_id": "98296486-cd15-4c8c-8f3d-64ade6812d63",
                                "sense_id": "cb9d08c5-efb5-3ed3-96ea-1c06dbb8f7d7",
                                "text": "La théologie de Wesley a fait retentir une note plus libre, plus souple, plus missionnaire, qui a séduit beaucoup d'âmes, et certainement les progrès du wesleyanisme au Pays de Galles doivent être envisagés comme une réaction contre le calvinisme strict."
                            }
                        ]
                    },
                    {
                        "sense_id": "39147a35-705e-3e88-a7cb-732ec8417fad",
                        "entry_id": "113f2e57-d7a3-3f1d-907e-5587c8a9d516",
                        "glosses": [
                            "Courant du protestantisme basé sur cette théologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0282fea-668a-44f9-97d1-69715a096899",
                                "sense_id": "39147a35-705e-3e88-a7cb-732ec8417fad",
                                "text": "Encore appelé méthodisme, d’après un sobriquet donné de bonne heure à la piété de son inspirateur, John Wesley, le wesleyanisme est issu du piétisme, mais l'a renouvelé."
                            }
                        ]
                    }
