                "senses": [
                    {
                        "sense_id": "41a9b1ea-e5ad-37fa-bf65-2c424c7a8c2b",
                        "entry_id": "08b78185-26c8-391c-9776-693da59aab00",
                        "glosses": [
                            "To break up and smooth soil with a harrow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f464648-ca10-4f23-a843-ed9f01bf875b",
                                "sense_id": "41a9b1ea-e5ad-37fa-bf65-2c424c7a8c2b",
                                "text": "After the field has been meekered it looks like it had been gone over with a garden rake, all clods having been cut or crushed and as level as a floor."
                            },
                            {
                                "example_id": "20cf07c7-a1d2-4084-a09b-1ff5a61ec42b",
                                "sense_id": "41a9b1ea-e5ad-37fa-bf65-2c424c7a8c2b",
                                "text": "I did not think it was necessary for all of you realize that your ground should be plowed, disked, harrowed, and meekered for a good seed bed."
                            },
                            {
                                "example_id": "358ccc48-e4b7-48bb-9155-5a8d73408392",
                                "sense_id": "41a9b1ea-e5ad-37fa-bf65-2c424c7a8c2b",
                                "text": "The area was plowed on May 10, 1977, disked on May 15 and meekered and harrowed on May 23 and 27."
                            }
                        ]
                    }
