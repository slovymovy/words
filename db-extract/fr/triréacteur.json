                    {
                        "sense_id": "f6b11c35-217a-3fd3-8368-0e56454e64f6",
                        "entry_id": "49f7b187-fdda-38ec-986f-bcd0c2564466",
                        "glosses": [
                            "Aéronef propulsé par trois réacteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "061173a1-337d-42c3-9259-bf1c68bf100e",
                                "sense_id": "f6b11c35-217a-3fd3-8368-0e56454e64f6",
                                "text": "Boeing a cessé la production de ses triréacteurs et se limite désormais à un seul quadriréacteur, le 747-800, tout comme Airbus avec l’A380."
                            },
                            {
                                "example_id": "ea141d37-072d-4692-8af1-f87d4678b236",
                                "sense_id": "f6b11c35-217a-3fd3-8368-0e56454e64f6",
                                "text": "Il faut remonter à juin 1972 pour le premier. Le DC-10, le nouveau triréacteur à fuselage large de McDonnell Douglas a alors reçu son certificat de la Federal Aviation Administration (FAA) un an avant."
                            },
                            {
                                "example_id": "4c58194d-7065-4677-969f-2b3fbbb6e0d5",
                                "sense_id": "f6b11c35-217a-3fd3-8368-0e56454e64f6",
                                "text": "Avion haut de gamme de la société Dassault, le Falcon 7X est un triréacteur dont le rayon d’action est de 11 000 km."
                            }
                        ]
                    }
                ],
