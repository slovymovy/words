                        "sense_id": "5cb29331-22cf-3c92-ab9b-236448e42691",
                        "entry_id": "7337ba51-3c07-3a37-b033-48e19e1cf8dd",
                        "glosses": [
                            "das fruchtbare Hinterland der Costa Brava in der katalanischen Provinz Girona in Spanien"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "28fb23a2-f0a1-49de-a352-eef5f2a8ba68",
                                "sense_id": "5cb29331-22cf-3c92-ab9b-236448e42691",
                                "text": "„Die Sardana, die von Ampurien ausging und ganz Katalonien erobert hat, ist mehr als ein Element unserer Folklore. Sie wurde zu unserem Nationaltanz, zu einem wesentlichen Baustein im Leben unseres Volkes. Die Demokratie inspiriert ihre Regeln. Jeder ist willkommen, in jedem Moment.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
