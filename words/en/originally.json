                                "ru": "Это здание <w>первоначально</w> было банком, прежде чем стать отелем.",
                                "zh": "这座建筑<w>起初</w>是一家银行，后来才变成了酒店。"
                            }
                        },
                        {
                            "text": "She is <w>originally</w> from a small town in the south of France.",
                            "target_lang_translations": {
                                "ru": "Она <w>родом</w> из маленького городка на юге Франции.",
                                "zh": "她<w>本来</w>来自法国南部的一个小镇。"
                            }
                        }
                    ],
                    "synonyms": [
                        "initially",
                        "at first",
                        "at the start"
                    ],
                    "antonyms": [
                        "finally",
                        "eventually"
                    ],
                    "common_phrases": [
