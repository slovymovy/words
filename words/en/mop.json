                            "trait_type": "slang",
                            "comment": "UK drill or street slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Огнестрельное оружие, особенно с магазином большой емкости.",
                        "zh": "枪械，尤指装有大容量弹匣的枪；俚语用法。"
                    },
                    "translations": {
