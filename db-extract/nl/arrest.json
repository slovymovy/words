                "translations": [
                    {
                        "translation_id": "0ac14a7a-70fb-48b8-942a-2715024bce73",
                        "source_entry_id": "ba21d545-f81e-3820-b331-44d1de039074",
                        "source_sense_id": "3434d285-f65e-3f46-805d-7bfdb5680b86",
                        "source_sense_description": "Arrest",
                        "target_lang_word": "Arrest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arrest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "672c9c58-5dac-34f6-83d5-c1965822b225",
                                        "entry_id": "f542a290-9a95-3918-ab69-eddf5bd4c9d1",
                                        "glosses": [
                                            "eine Haft von kurzer Dauer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7bb253e-e9dc-4137-9ada-90d299225567",
                                                "sense_id": "672c9c58-5dac-34f6-83d5-c1965822b225",
                                                "text": "„Zwei Soldaten erschienen, und ohne noch einmal das Wort an mich zu richten, befahl er, mich abzuführen und in strengen Arrest zu nehmen.“"
                                            },
                                            {
                                                "example_id": "00f58071-7ce8-41ed-82c4-8250b9d49ceb",
                                                "sense_id": "672c9c58-5dac-34f6-83d5-c1965822b225",
                                                "text": "„Dann trommelte er mit den Fingern ein wenig auf den Tisch und diktierte Benoit fünfzehn und mir zehn Tage Arrest zu.“"
                                            },
                                            {
                                                "example_id": "e8029dda-f215-4e7a-bc1f-a6c49ba169df",
                                                "sense_id": "672c9c58-5dac-34f6-83d5-c1965822b225",
                                                "text": "„Und er nahm sich vor, sie zu suchen, sobald er aus dem Arrest herauskam.“"
                                            },
                                            {
                                                "example_id": "70a3bf72-5b02-4c31-963c-b781c9edc035",
                                                "sense_id": "672c9c58-5dac-34f6-83d5-c1965822b225",
                                                "text": "„Dann befahl er, mich in der Santa Maria genannten Hauptwache außerhalb der Stadt in Arrest zu stecken; doch sollte ich vorher um einen neuen Paß nach Rom schreiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "483183be-e7de-36a1-929e-365b1defbb87",
                                        "entry_id": "f542a290-9a95-3918-ab69-eddf5bd4c9d1",
                                        "glosses": [
                                            "Ort, an dem eine Person während des Arrest festgehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6645c2d2-4cd0-4903-b29f-a84a2551cc74",
                                                "sense_id": "483183be-e7de-36a1-929e-365b1defbb87",
                                                "text": "Der junge Gefreite saß drei Tage in Arrest."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ff08de74-89ed-3d55-a2ec-42c555f43d1d",
                                        "entry_id": "f542a290-9a95-3918-ab69-eddf5bd4c9d1",
                                        "glosses": [
                                            "Beschlagnahmung von Gütern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8ed9c93-7877-4132-8614-074949926204",
                                                "sense_id": "ff08de74-89ed-3d55-a2ec-42c555f43d1d",
                                                "text": "Der Arrest ist in den §§ 916 bis 934 der Zivilprozessordnung (ZPO) geregelt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
