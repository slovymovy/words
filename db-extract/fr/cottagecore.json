                "word": "cottagecore",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "aad19253-d5c4-3808-8c47-f33c9ec1b3ec",
                        "entry_id": "ec0eccaf-b4fc-3102-b272-22ee5106e0f6",
                        "glosses": [
                            "Esthétique romançant la vie rurale et en promouvant un mode de vie traditionnel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3ec892c-623b-4111-90c0-892aed97fd20",
                                "sense_id": "aad19253-d5c4-3808-8c47-f33c9ec1b3ec",
                                "text": "Avant, pour les vacances, on rêvait de longues plages de sable blanc ou de piscines au bleu californien. Désormais, on ne jurerait plus que par le « retour à la ferme ». En tout cas si l’on en croit les réseaux sociaux. Car la star des hashtags post-confinement porte un nom qui peut sembler barbare mais résume tout des obsessions de notre époque : cottagecore."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f38b504-3d42-42b3-b347-11ccc643ccfe",
                        "source_entry_id": "ec0eccaf-b4fc-3102-b272-22ee5106e0f6",
                        "source_sense_id": "aad19253-d5c4-3808-8c47-f33c9ec1b3ec",
                        "target_lang_word": "cottagecore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cottagecore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26487cde-d0b6-35b0-b5fe-cec846336234",
                                        "entry_id": "2c2ce2f9-5682-310e-a670-febd0b386a3c",
                                        "glosses": [
                                            "An aesthetic that celebrates a return to traditional skills and crafts associated with rural living, such as sewing, gardening, foraging, baking, and pottery."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15b77f06-fec6-41ec-be80-c841c8454985",
                                                "sense_id": "26487cde-d0b6-35b0-b5fe-cec846336234",
                                                "text": "If you've ever yearned for an idyllic life in the country, then cottagecore is for you."
                                            },
                                            {
                                                "example_id": "23635584-14ab-4ca0-b288-de8d70f80b3b",
                                                "sense_id": "26487cde-d0b6-35b0-b5fe-cec846336234",
                                                "text": "Underneath the clutter, the twin-size mattress was covered with a patchwork quilt and sheets dotted with tiny pink roses. There was a ruffled mint green bed skirt to match the ruffled gingham valance above the window. It was like standing in the cottagecore Holy Land."
                                            },
                                            {
                                                "example_id": "09743ea8-7f03-4c98-a652-08ca2df13923",
                                                "sense_id": "26487cde-d0b6-35b0-b5fe-cec846336234",
                                                "text": "I weeded and watered all while being nurtured myself. Working for Granny felt more like a cottagecore vacation than it should at times."
                                            },
                                            {
                                                "example_id": "48e797c4-d0ce-4ed7-b686-4ec48ecc2a91",
                                                "sense_id": "26487cde-d0b6-35b0-b5fe-cec846336234",
                                                "text": "Each show spans over 180 minutes, including 40-plus songs from at least nine albums; there are 16 costume changes, pyrotechnics, an optical illusion in which she appears to dive into the stage and swim, and not one but two cottagecore worlds, which feature an abundance of moss."
                                            }
                                        ]
                                    }
                                ]
                            }
