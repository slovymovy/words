                "senses": [
                    {
                        "sense_id": "ecea56e6-438f-3dcc-ad24-89668e87def5",
                        "entry_id": "0fbd0654-ef52-35e7-bb41-e96b20e70e85",
                        "glosses": [
                            "Kellnerin, die sich insbesondere um die Auswahl der Getränke, vor allem um den Wein, kümmert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dc39134-00d8-48e1-959c-2d0487dc44ab",
                                "sense_id": "ecea56e6-438f-3dcc-ad24-89668e87def5",
                                "text": "„Die Weinkarte mit ihren gut 800 Positionen bietet alles, was man sich nur wünschen kann; sie wird ebenso liebenswürdig wie auch leidenschaftlich und fachkundig erläutert von der panamaischen Sommelière Zoraida Dreesbach.“"
                            },
                            {
                                "example_id": "02520273-18db-41c5-a137-9572ae463604",
                                "sense_id": "ecea56e6-438f-3dcc-ad24-89668e87def5",
                                "text": "„Das Ziel des Vereins: weinbegeisterte Frauen, also Winzerinnen, Weinfachfrauen aus Gastronomie und Handel, Sommelièren, PR-Frauen und Fachjournalistinnen aus ganz Deutschland zu motivieren, sich mit dem Thema Wein noch mehr auseinander zu setzen.“"
                            },
                            {
                                "example_id": "0bd1d959-7922-41ea-a3bf-85d4f9c95c08",
                                "sense_id": "ecea56e6-438f-3dcc-ad24-89668e87def5",
                                "text": "„Sie arbeitete zuerst in der Gastronomie, war danach in Australien tätig und absolvierte dann in Deutschland die Ausbildung zur Sommelière.“"
                            },
                            {
                                "example_id": "b2a259bd-9393-4a24-9bfe-6b1aa6b89ae9",
                                "sense_id": "ecea56e6-438f-3dcc-ad24-89668e87def5",
                                "text": "„Und zu seinen Kreationen reicht die erst 28-jährige, aber schon vielfach preisgekrönte Sommelière Birgitta Quendler die besten Tropfen aus dem exklusiv bestückten Weinkeller.“"
                            },
                            {
                                "example_id": "b77ffc43-b773-4feb-9d51-e15b2e5ea031",
                                "sense_id": "ecea56e6-438f-3dcc-ad24-89668e87def5",
                                "text": "„Sie arbeitet dort als Sommelière und gehört als staatlich zertifizierte Olivenöl-Testerin außerdem zu einem zehnköpfigen Komitee der italienischen Handelskammer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
