                                "target_senses": [
                                    {
                                        "sense_id": "7fbaa28f-109a-30e1-858c-8b1b825c453e",
                                        "entry_id": "aa587fe1-f7d4-3a37-a620-684a9ee730cf",
                                        "glosses": [
                                            "A person from Tunisia or of Tunisian descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a7db078-a0cb-4fd6-858a-a32278242112",
                                                "sense_id": "7fbaa28f-109a-30e1-858c-8b1b825c453e",
                                                "text": "WikiLeaks did not cause these uprisings but it certainly informed them. The dispatches revealed details of corruption and kleptocracy that many Tunisians suspected, but could not prove, and would cite as they took to the streets."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Tunisian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba1fd0ec-590f-3fbb-824e-80d404b059b5",
                                        "entry_id": "d98eb87c-1aea-3482-8b04-a4b54c9c1355",
                                        "glosses": [
                                            "Of, from, or pertaining to Tunisia, the Tunisian people or the Tunisian language."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c271899a-0fa8-4520-858b-1a3063ae39ed",
                                                "sense_id": "ba1fd0ec-590f-3fbb-824e-80d404b059b5",
                                                "text": "On a recent afternoon in the Tunisian coastal city of Sfax, as shoppers hurried around a market buying food and drink for that evening’s iftar meal, a small group of men from sub-Saharan Africa gathered near a stall selling phone accessories."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d867090-4508-494c-8b11-5d2ba63432cb",
                        "source_entry_id": "93b7e0ea-aad3-34b2-8e08-1a37c43b040e",
                        "source_sense_id": "12bf665f-7b64-39f1-9f49-d73bf414d669",
