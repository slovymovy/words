                        "entry_id": "851b8b1b-2c18-3473-8f5d-2cbad228e167",
                        "glosses": [
                            "orzeźwiający koktajl wytwarzany z wytrawnego białego wina, cukru, soku owocowego, zmrożonej wody sodowej i lodu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb5e2565-8edb-47b9-920e-dc6fb3f64457",
                                "sense_id": "7bd43d95-5cc9-301d-a803-59a664a2fde5",
                                "text": "Od niepamiętnych czasów na stołach krzeszowian gościł przyrządzany na bazie tego trunku napój, zwany kruszonem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
