                ],
                "senses": [
                    {
                        "sense_id": "6f5cc5eb-ed74-3ec7-9c8f-88264e226dfb",
                        "entry_id": "4e7f77c2-5534-3259-9cb6-74fcef1c86c0",
                        "glosses": [
                            "afwezigheid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db011911-9eb8-43ca-bd15-dfcda4ca70b3",
                                "sense_id": "6f5cc5eb-ed74-3ec7-9c8f-88264e226dfb",
                                "text": "Er zijn vier absenties."
                            }
                        ]
                    },
                    {
                        "sense_id": "0daffce3-dd24-3ee5-8d7a-dd491312fe53",
                        "entry_id": "4e7f77c2-5534-3259-9cb6-74fcef1c86c0",
                        "glosses": [
                            "verstrooidheid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a42090c3-16f5-42c4-9b73-3e0f994f6e03",
                                "sense_id": "0daffce3-dd24-3ee5-8d7a-dd491312fe53",
                                "text": "Die man heeft last van absentie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d844d6ac-0405-482c-86fb-d4dc4a28ea6e",
                        "source_entry_id": "4e7f77c2-5534-3259-9cb6-74fcef1c86c0",
                        "target_lang_word": "Abwesenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abwesenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78175545-c9d9-345e-95c5-835c9af98f8d",
                                        "entry_id": "4d7e74ad-aaff-3677-9a62-79e4feb2e3d2",
                                        "glosses": [
                                            "der Zustand, dass man körperlich nicht zugegen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "418fa321-89b5-4e0b-a299-317e76ba3819",
                                                "sense_id": "78175545-c9d9-345e-95c5-835c9af98f8d",
                                                "text": "Er glänzte mal wieder durch Abwesenheit."
                                            },
                                            {
                                                "example_id": "81668475-9b5b-4ebf-bbb3-44ffbdc86fe6",
                                                "sense_id": "78175545-c9d9-345e-95c5-835c9af98f8d",
                                                "text": "„Denn Kaschmir ist unendlich weich, leicht, schmeichelt der Haut und ist wie eine sanfte Umarmung, weswegen manche Frauen Kaschmirschals bei Abwesenheit des Liebsten auch gerne als Streichelersatz nutzen.“"
                                            },
                                            {
                                                "example_id": "66c393ea-7f30-4065-87ee-76f458d06676",
                                                "sense_id": "78175545-c9d9-345e-95c5-835c9af98f8d",
                                                "text": "„Zunächst, in Abwesenheit ihres altgedienten Vorsitzenden, hatten die Unabhängigen es halsstarrig abgelehnt, Nichtsozialisten in die Regierung aufzunehmen, und sei es auch nur als Fachleute ohne exekutive Befugnisse.“"
                                            },
                                            {
                                                "example_id": "e6e331e7-3f28-44e2-8104-3ed8c0061b0a",
                                                "sense_id": "78175545-c9d9-345e-95c5-835c9af98f8d",
                                                "text": "„Ihm war ein Jahr Abwesenheit gewährt worden.“"
                                            },
                                            {
                                                "example_id": "25761f13-2494-424c-ae58-47053a2e76ee",
                                                "sense_id": "78175545-c9d9-345e-95c5-835c9af98f8d",
                                                "text": "„Glück wurde einmal als Abwesenheit von Unruhe definiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e0748903-e541-37d8-8dd5-d508a2209a66",
                                        "entry_id": "4d7e74ad-aaff-3677-9a62-79e4feb2e3d2",
                                        "glosses": [
                                            "der Zustand, dass man geistig nicht zugegen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcbb6ae6-ad5a-4d78-bb09-3520ac7262da",
                                                "sense_id": "e0748903-e541-37d8-8dd5-d508a2209a66",
                                                "text": "Sein Gesicht drückt völlige Abwesenheit aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8898087-a4af-44b3-bc32-dca245843ba2",
                        "source_entry_id": "4e7f77c2-5534-3259-9cb6-74fcef1c86c0",
                        "target_lang_word": "absence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78b93bd8-9566-3848-9f4e-ed6f44966c22",
                                        "entry_id": "f52f0155-acfa-318c-b968-6400bf3fad90",
                                        "glosses": [
                                            "A state of being away or withdrawn from a place or from companionship"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c2467b2-542c-4c1b-bbca-ffb3fec71da4",
                                                "sense_id": "78b93bd8-9566-3848-9f4e-ed6f44966c22",
                                                "text": "Absence makes the heart grow fonder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75fc6859-7d0e-361d-bc30-4df996614aa8",
                                        "entry_id": "f52f0155-acfa-318c-b968-6400bf3fad90",
                                        "glosses": [
                                            "The period of someone being away."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0709a9bd-4c46-4be1-9310-dbae3400515b",
                                                "sense_id": "75fc6859-7d0e-361d-bc30-4df996614aa8",
                                                "text": "During Jane's absence, Mark will be taking charge."
                                            },
                                            {
                                                "example_id": "72b19c7b-3712-4ec2-9d6c-122bab2dc5b2",
                                                "sense_id": "75fc6859-7d0e-361d-bc30-4df996614aa8",
                                                "text": "Not as in my presence only, but now much more in my absence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a78f6bf-b278-3407-9d7f-4f3a2fb3bb32",
                                        "entry_id": "f52f0155-acfa-318c-b968-6400bf3fad90",
                                        "glosses": [
                                            "Failure to be present where one is expected, wanted, or needed; nonattendance; deficiency."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c51d066-6d46-4c52-8f9b-8c2a6d716846",
                                                "sense_id": "2a78f6bf-b278-3407-9d7f-4f3a2fb3bb32",
                                                "text": "Harry Kane was an absence in that first half. He touched the ball 11 times despite Spurs taking 62% of possession."
                                            },
                                            {
                                                "example_id": "e6aa2d57-9345-4d54-a48d-9fab24a1c7d4",
                                                "sense_id": "2a78f6bf-b278-3407-9d7f-4f3a2fb3bb32",
                                                "text": "Then, in January, a creeping tsunami of train cancellations, triggered by major staff absences as a result of the aggressive transmissibility of Omicron, heaped further misery on rail users."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f5a68cf-8e75-31a7-8ff9-09013e43fe55",
                                        "entry_id": "f52f0155-acfa-318c-b968-6400bf3fad90",
                                        "glosses": [
                                            "Lack; deficiency; non-existence."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1bcd978-420b-414c-a9c5-1328cb41e1d8",
                                                "sense_id": "2f5a68cf-8e75-31a7-8ff9-09013e43fe55",
                                                "text": "He had an absence of enthusiasm."
                                            },
                                            {
                                                "example_id": "a70e4eec-ad8e-4940-82f7-9c4ed6b58161",
                                                "sense_id": "2f5a68cf-8e75-31a7-8ff9-09013e43fe55",
                                                "text": "in the absence of higher and more authoritative sanctions the ordinances of foreign states, the opinions of eminent statesmen, and the writings of distinguished jurists, are regarded as of great consideration on questions not settled by conventional law"
                                            },
                                            {
                                                "example_id": "5972a64b-8ae4-4ccd-a4fd-ea57473a09e3",
                                                "sense_id": "2f5a68cf-8e75-31a7-8ff9-09013e43fe55",
                                                "text": "The narrow streets that twist and turn through the compact heart of Dent are surfaced with cobbles which, in the absence of pavements, spread right across from doorstep to doorstep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02236293-ac4e-3362-8939-7ca3e4f7e31c",
                                        "entry_id": "f52f0155-acfa-318c-b968-6400bf3fad90",
                                        "glosses": [
                                            "Inattention to things present; abstraction (of mind)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01f39e0f-aa27-4bf3-9776-1ec8259f39e1",
                                                "sense_id": "02236293-ac4e-3362-8939-7ca3e4f7e31c",
                                                "text": "absence of mind"
                                            },
                                            {
                                                "example_id": "1129cd9c-46a4-4067-96cc-c1a59f0a1552",
                                                "sense_id": "02236293-ac4e-3362-8939-7ca3e4f7e31c",
                                                "text": "Reflecting on the little absences and distractions of mankind."
                                            },
                                            {
                                                "example_id": "110b615b-d775-497f-907c-0888c04e175d",
                                                "sense_id": "02236293-ac4e-3362-8939-7ca3e4f7e31c",
                                                "text": "To conquer that abstraction which is called absence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "590b3b3b-f2d6-3583-b69f-da40495fb8b2",
                                        "entry_id": "f52f0155-acfa-318c-b968-6400bf3fad90",
                                        "glosses": [
                                            "Temporary loss or disruption of consciousness, with sudden onset and recovery, and common in epilepsy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb0695f1-efa8-3d15-9729-34414f0be6bf",
                                        "entry_id": "f52f0155-acfa-318c-b968-6400bf3fad90",
                                        "glosses": [
                                            "Lack of contact between blades."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9111ca8-4842-4e36-a1a8-89bc72d1e219",
                        "source_entry_id": "4e7f77c2-5534-3259-9cb6-74fcef1c86c0",
                        "target_lang_word": "absence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e27b44fd-2c29-3b0a-947c-529217bc8f20",
                                        "entry_id": "3135aec2-6047-3a17-84c3-b516247c2f17",
                                        "glosses": [
                                            "Inexistence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee7109c5-74a8-4220-8e23-82644bcc3c38",
                                                "sense_id": "e27b44fd-2c29-3b0a-947c-529217bc8f20",
                                                "text": "Ripartites helomorphus se distingue de ses congénères par le chapeau gibbeux et charnu, beaucoup plus épais que la largeur des lamelles, par l’absence de cils marginaux et par ses spores très petites à verrues basses et arrondies."
                                            },
                                            {
                                                "example_id": "83e51f14-1837-40a9-8b53-3ca012b2db5f",
                                                "sense_id": "e27b44fd-2c29-3b0a-947c-529217bc8f20",
                                                "text": "Il est probable qu’aucune preuve de vie ne soit trouvée sur Mars, et la question restera sans réponse (l’absence de preuve n’est pas une preuve d’absence)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f91dd54-0665-3025-af14-49e11ddb43e4",
                                        "entry_id": "3135aec2-6047-3a17-84c3-b516247c2f17",
                                        "glosses": [
                                            "Fait d’être absent, éloignement géographique et temporel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab8424a0-69cd-4de6-a7c7-e177e94c1791",
                                                "sense_id": "3f91dd54-0665-3025-af14-49e11ddb43e4",
                                                "text": "L’absence a des effets singuliers. J’en fis l’épreuve pendant cette première année d’éloignement qui me sépara de M. Dominique, sans qu’aucun souvenir direct parût nous rappeler l’un à l’autre. L’absence unit et désunit, elle rapproche aussi bien qu’elle divise, elle fait se souvenir, elle fait oublier ; elle relâche certains liens très-solides, elle les tend et les éprouve au point de les briser ; il y a des liaisons soi-disant indestructibles dans lesquelles elle fait d’irrémédiables avaries ; elle accumule des mondes d’indifférence sur des promesses de souvenirs éternels."
                                            },
                                            {
                                                "example_id": "282aee16-d4bc-4220-b67b-c3bf89c094f8",
                                                "sense_id": "3f91dd54-0665-3025-af14-49e11ddb43e4",
                                                "text": "Son absence durait un an, deux ans. Et puis, un beau soir, sans que personne de son entourage fût prévenu, il reparaissait soudainement."
                                            },
                                            {
                                                "example_id": "b27b67e8-af1f-4c54-b50d-69255f9a0004",
                                                "sense_id": "3f91dd54-0665-3025-af14-49e11ddb43e4",
                                                "text": "Après deux jours d'absence, nous revenions à Rockall ramenant une nuée de mouettes qui avaient quitté leur îlot pour nous accompagner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80e8acb2-bf32-3daf-82c0-363fca119ca0",
                                        "entry_id": "3135aec2-6047-3a17-84c3-b516247c2f17",
                                        "glosses": [
                                            "Défaut de présence à une réunion, à une assignation, à un appel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb6edec4-ddf1-4c1d-b449-2af85f4b6bdb",
                                                "sense_id": "80e8acb2-bf32-3daf-82c0-363fca119ca0",
                                                "text": "On n’a pas laissé de se divertir en votre absence."
                                            },
                                            {
                                                "example_id": "9845bb46-9553-41d8-8078-38c9e5e82c32",
                                                "sense_id": "80e8acb2-bf32-3daf-82c0-363fca119ca0",
                                                "text": "Il fut ordonné qu’on procéderait tant en présence qu’en absence de l’accusé, ou des parties."
                                            },
                                            {
                                                "example_id": "bc857e0c-1351-45c3-a8a4-8e114ddbc8a1",
                                                "sense_id": "80e8acb2-bf32-3daf-82c0-363fca119ca0",
                                                "text": "On a fait constater son absence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b9a2040-587c-3d11-9ac8-f8ca84de9d53",
                                        "entry_id": "3135aec2-6047-3a17-84c3-b516247c2f17",
                                        "glosses": [
                                            "Situation d’une personne dont on n’a pas reçu de nouvelles depuis une certaine époque et dont la résidence actuelle n’est pas connue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e26db8b-8bd6-4a39-8e73-e4345d0d9d78",
                                                "sense_id": "7b9a2040-587c-3d11-9ac8-f8ca84de9d53",
                                                "text": "Tant que l’absence n’a pas été déclarée par un jugement, elle n’est que présumée."
                                            },
                                            {
                                                "example_id": "cb50fefd-1f76-406a-802c-8889ab59e143",
                                                "sense_id": "7b9a2040-587c-3d11-9ac8-f8ca84de9d53",
                                                "text": "Présomption d’absence."
                                            },
                                            {
                                                "example_id": "b28052e7-ca60-4586-b1d9-3cd4024ff098",
                                                "sense_id": "7b9a2040-587c-3d11-9ac8-f8ca84de9d53",
                                                "text": "Les effets de l’absence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38e5640b-0fcf-3265-a8ef-f4edd73a8ca2",
                                        "entry_id": "3135aec2-6047-3a17-84c3-b516247c2f17",
                                        "glosses": [
                                            "Perte passagère de la mémoire voire arrêt momentané de la conscience. Il s’agit d’une manifestation mineure de l’épilepsie généralisée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22f0295f-dd3e-47e4-a0dd-e61684969b7a",
                                                "sense_id": "38e5640b-0fcf-3265-a8ef-f4edd73a8ca2",
                                                "text": "On dit parfois d’un enfant qui a le regard dans le vide qu’il “rêve”, rêve dont il ne peut décrocher pendant quelques secondes. Il est alerte et attentif sur ce qu’il fait, puis soudainement il arrête ce qu’il fait, semble absent, n’est pas réceptif aux paroles qui lui sont adressées. Puis, au bout de quelques secondes, l’enfant redevient alerte et reprend son activité comme si aucune interruption n’avait eu lieu et aucun souvenir des dernières secondes. Ces différents symptômes sont caractéristiques de l’absence épileptique, appelée aussi “crise de petit mal”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eca4b406-dd1f-3aad-8983-aac9ec391a84",
                                        "entry_id": "3135aec2-6047-3a17-84c3-b516247c2f17",
                                        "glosses": [
                                            "Au sens moral."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6680d37d-ab9e-4768-bc0b-2092becdfe88",
                                                "sense_id": "eca4b406-dd1f-3aad-8983-aac9ec391a84",
                                                "text": "L’intégrité journalistique repose largement sur l’absence de conflits de loyautés, et même sur l’absence d’apparence de tels conflits."
                                            },
                                            {
                                                "example_id": "3efb88ad-17c0-4d4b-b2ae-af7242709ca5",
                                                "sense_id": "eca4b406-dd1f-3aad-8983-aac9ec391a84",
                                                "text": "Il y a dans cet ouvrage une absence totale d’esprit, de goût, de logique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89f82d0f-d8ac-327a-a8d3-f0d3f9576f0a",
                                        "entry_id": "3135aec2-6047-3a17-84c3-b516247c2f17",
                                        "glosses": [
                                            "Distraction, manque d’attention."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9c68462-91fd-407f-8240-09b6d0b33fe5",
                                                "sense_id": "89f82d0f-d8ac-327a-a8d3-f0d3f9576f0a",
                                                "text": "Absence d’esprit,"
                                            },
                                            {
                                                "example_id": "1680b978-fb9c-4a05-aa54-025f5c6ec712",
                                                "sense_id": "89f82d0f-d8ac-327a-a8d3-f0d3f9576f0a",
                                                "text": "Il est sujet à des absences d’esprit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
