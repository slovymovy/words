                ],
                "translations": [
                    {
                        "translation_id": "3892a827-5356-4ad3-82ca-ecfc3c02edce",
                        "source_entry_id": "90130e7b-1da2-3212-a469-a29da8fc6bbb",
                        "source_sense_id": "df48d66b-4dd8-36ea-b877-af5674ddc07c",
                        "target_lang_word": "athletic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "athletic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7f78c32-0e5a-34e4-a0fd-d807e5b24418",
                                        "entry_id": "16738cfb-a027-3af1-89b4-648e4d67ff9e",
                                        "glosses": [
                                            "Having to do with athletes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f1e1167-4db0-4593-84c8-5fb04c538ce2",
                                                "sense_id": "b7f78c32-0e5a-34e4-a0fd-d807e5b24418",
                                                "text": "Are you a member of the American Athletic Association?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3bb406e-52b0-3176-af9a-3bed26676c7c",
                                        "entry_id": "16738cfb-a027-3af1-89b4-648e4d67ff9e",
                                        "glosses": [
                                            "Physically active."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97bfb4bf-82c3-4098-8c90-5c5e124dbced",
                                                "sense_id": "b3bb406e-52b0-3176-af9a-3bed26676c7c",
                                                "text": "Since you're such an athletic person, you may wish to consider joining."
                                            },
                                            {
                                                "example_id": "9029ff5e-f180-4a62-995d-d391d9c92b60",
                                                "sense_id": "b3bb406e-52b0-3176-af9a-3bed26676c7c",
                                                "text": "An athletic kid from New Jersey, Fischer was known as a bold risk taker — they called him “the fallingest man in climbing” — until an old-school cragger taught him the Zen of controlled ascent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7176dde2-6dfd-347a-bf46-85f4c751e057",
                                        "entry_id": "16738cfb-a027-3af1-89b4-648e4d67ff9e",
                                        "glosses": [
                                            "Having a muscular, well developed body, being in shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "301048e2-d060-44b5-8dd1-d1e76d9473a5",
                                                "sense_id": "7176dde2-6dfd-347a-bf46-85f4c751e057",
                                                "text": "You have such an athletic build—you must work out regularly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e99def26-8b0c-38e6-819e-3f750295d228",
                                        "entry_id": "16738cfb-a027-3af1-89b4-648e4d67ff9e",
                                        "glosses": [
                                            "An attribute of a motion or play which requires fine physical ability."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "699db404-1cc2-4400-a0f4-4c760f412afc",
                                                "sense_id": "e99def26-8b0c-38e6-819e-3f750295d228",
                                                "text": "The center fielder made an athletic play to snatch the ball from over the fence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fd46c56-473b-302c-b575-e9e5603a7397",
                                        "entry_id": "16738cfb-a027-3af1-89b4-648e4d67ff9e",
                                        "glosses": [
                                            "Of a level in a Super Mario game: with an emphasis on platforming challenge, often involving precise jumps between floating platforms above a bottomless pit, and having upbeat background music."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afdae765-bfab-4f77-ae96-3e13464e4fbe",
                                                "sense_id": "3fd46c56-473b-302c-b575-e9e5603a7397",
                                                "text": "An athletic course in which Mario must traverse rotating lifts and stretch blocks."
                                            },
                                            {
                                                "example_id": "8516daee-ebca-4a72-be22-c27e276bfa76",
                                                "sense_id": "3fd46c56-473b-302c-b575-e9e5603a7397",
                                                "text": "Mario levels are usually indicated to belong to one of five types (overworld, underground, athletic, castle, underwater)². The type determines the aesthetic style of the level, but also affects the challenges that are posed. For example, athletic levels usually contain platforms that are spaced far apart, as well as moving platforms. They thus require precise and timed jumps to traverse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "athletic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ea8bead-76a7-354a-85c3-8e0cac927b90",
