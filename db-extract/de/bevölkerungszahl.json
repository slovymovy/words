                        ],
                        "form": "die Bevölkerungszahl"
                    },
                    {
                        "form_id": "a687f9c7-1c8d-41ff-8a58-763b5ea0d6fe",
                        "entry_id": "12e7b1bf-f522-35fa-be1a-6ca48cd20d01",
                        "tags": [
                            "accusative",
