                "senses": [
                    {
                        "sense_id": "b2a45516-0f0f-36c7-ba3c-d9e523951e99",
                        "entry_id": "20db75cc-e9d4-342d-9e14-92c380f930d5",
                        "glosses": [
                            "Plante tropicale de la famille des Aracées (Colocasia antiquorum et Colocasia esculenta), dont le rhizome comestible, le taro, fournit une farine riche en amidon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c828b69-3a3e-4b8b-bbbe-5025cb21ee88",
                                "sense_id": "b2a45516-0f0f-36c7-ba3c-d9e523951e99",
                                "text": "Le taro (colocase) est cultivé pour son corme principal (base de la tige) et ses cormes secondaires… L’aire d’origine du taro est probablement le sud-est asiatique, du Myanmar à la Papouasie Nouvelle-Guinée."
                            },
                            {
                                "example_id": "c868d62c-69c6-4134-8038-75ab600f9a04",
                                "sense_id": "b2a45516-0f0f-36c7-ba3c-d9e523951e99",
                                "text": "Dans l’enceinte de chez Nilmani Ray les jeunes feuilles vert sombre des colocases brillaient."
                            },
                            {
                                "example_id": "e40db5ce-31de-42dd-8220-1d19af46d1a1",
                                "sense_id": "b2a45516-0f0f-36c7-ba3c-d9e523951e99",
                                "text": "Mais en s’approchant, elle se rendit compte que ce n’était qu’une feuille de colocase jaunie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c46262fa-f66a-43b7-ab3d-399b43e13ef1",
                        "source_entry_id": "20db75cc-e9d4-342d-9e14-92c380f930d5",
                        "source_sense_id": "b2a45516-0f0f-36c7-ba3c-d9e523951e99",
