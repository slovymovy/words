                    "sense_definition": "iets van de ene plaats naar de andere brengen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je me helpen om deze zware kast naar de andere hoek te <w>verplaatsen</w>?",
                            "target_lang_translations": {
                                "en": "Can you help me <w>move</w> this heavy cabinet to the other corner?"
                            }
                        },
                        {
                            "text": "De afspraak werd naar volgende week <w>verplaatst</w> omdat de directeur ziek was.",
                            "target_lang_translations": {
                                "en": "The appointment was <w>rescheduled</w> for next week because the director was ill."
                            }
                        },
                        {
                            "text": "Als je een hortensia wilt <w>verplaatsen</w>, kun je dat het beste doen in de lente.",
                            "target_lang_translations": {
                                "en": "If you want to <w>relocate</w> a hydrangea, it is best to do so in the spring."
                            }
