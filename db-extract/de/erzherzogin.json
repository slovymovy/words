                        "entry_id": "0034767c-a677-3917-85e3-157c88c4188b",
                        "glosses": [
                            "Adelstitel, der in Österreich seit Mitte des 14. bis Anfang des 20. Jahrhunderts geführt wurde"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "076a0590-6c67-36dc-aeac-c1e2203b125d",
                        "entry_id": "0034767c-a677-3917-85e3-157c88c4188b",
                        "glosses": [
                            "Person, die [1] als Titel führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12e6f4db-c4f6-4a74-86aa-f5b75cd1e33c",
                                "sense_id": "076a0590-6c67-36dc-aeac-c1e2203b125d",
                                "text": "„Eine Erzherzogin wünschte ihn ebenfalls zu sehen.“"
                            },
                            {
                                "example_id": "160f92bc-9eb0-4f9b-aa14-60e2b1627844",
                                "sense_id": "076a0590-6c67-36dc-aeac-c1e2203b125d",
                                "text": "„Mir erschienen alle Erzherzoginnen schön, ausgenommen die erste.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00cbaacb-9219-4695-88b0-bf6b2d3d9e28",
