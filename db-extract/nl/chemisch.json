                                        "sense_id": "641a55cc-d141-3867-9fa3-9d7968f53998",
                                        "entry_id": "5a899dfd-ad95-3022-bc10-3c8ef104fcaa",
                                        "glosses": [
                                            "An artificial chemical compound."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "781c48d0-93b7-4d7d-96a8-5c99f4fefeb6",
                                                "sense_id": "641a55cc-d141-3867-9fa3-9d7968f53998",
                                                "text": "I color my hair with henna, not chemicals."
                                            },
                                            {
                                                "example_id": "5e744748-3fcc-4c41-9c2a-89a5ee439480",
                                                "sense_id": "641a55cc-d141-3867-9fa3-9d7968f53998",
                                                "text": "CSPI says the Trump Administration could take steps to protect consumers from each of these chemicals and support FDA’s broader post-market assessment efforts. It could ensure that FDA sets health-protective limits on heavy metals, like lead, arsenic, and cadmium, in foods consumed by children."
