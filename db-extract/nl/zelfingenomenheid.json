                        "sense_id": "09fb90e6-f49d-304d-9764-de302c7827c6",
                        "entry_id": "cc184293-2834-30fd-992c-9418fc0fef5f",
                        "glosses": [
                            "op een onkritische manier tevreden met jezelf zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8548455b-da3a-4618-8ffd-42f0f0a26817",
                                "sense_id": "09fb90e6-f49d-304d-9764-de302c7827c6",
                                "text": "De parlementaire enquêtecommissie Fyra stuurt aan op een eindrapport dat het al in het hoofd heeft. Uit de verhoren komt een eenzijdig beeld en er hangt een waan van zelfingenomenheid rond de commissie, zegt oud-directeur Thalys Nederland Frits Marckmann donderdag tegen BNR."
                            },
                            {
                                "example_id": "f931897f-1d19-4acf-a477-368d817a55e6",
                                "sense_id": "09fb90e6-f49d-304d-9764-de302c7827c6",
                                "text": "Dat leidt tot zelfingenomenheid en gezapigheid waardoor signalen uit de samenleving worden gemist en niet adequaat wordt bijgestuurd. Alles kabbelt maar voort. Dit geldt voor zowel de bestuurlijke als de ambtelijke top."
                            },
                            {
                                "example_id": "f8ae08d5-585c-4f49-9180-85a8a4fb0a0b",
                                "sense_id": "09fb90e6-f49d-304d-9764-de302c7827c6",
                                "text": "De één vindt het een exhibitionistische vorm van zelfingenomenheid, de ander zet er dagelijks één op Instagram. Selfie. Woord van het jaar in Nederland, België èn Engeland."
                            }
                        ]
                    }
