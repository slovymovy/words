                "senses": [
                    {
                        "sense_id": "0ee64832-dbad-37fd-a037-c2752d639d6d",
                        "entry_id": "768200d4-dfcd-3cc1-ade6-5e67bb430774",
                        "glosses": [
                            "sauer gewordene und durch spezielle Bakterien dickgelegte Milch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e36c3a00-338f-4904-96f0-05976c87308a",
                                "sense_id": "0ee64832-dbad-37fd-a037-c2752d639d6d",
                                "text": "Dickmilch dient als Getränk und insbesondere zur Zubereitung von Speisequark und Sauermilchkäse."
                            },
                            {
                                "example_id": "c5674500-0151-4ea3-b89a-a35a2dcb93a9",
                                "sense_id": "0ee64832-dbad-37fd-a037-c2752d639d6d",
                                "text": "Ganz gleich welche Milchart verwendet wird, dauert es je nach Wetterbedingungen etwa gut einen Tag, bis die Dickmilch ausreichend fest und somit zum Verzehr geeignet ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
