    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f23410d-3885-309e-bdff-2554cef4130e",
                    "sense_definition": "A series of interconnected rings or links usually made of metal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a gold <w>chain</w> around his neck as a piece of jewelry.",
                            "target_lang_translations": {
                                "ru": "Он носил золотую <w>цепочку</w> на шее в качестве украшения."
                            }
                        },
                        {
                            "text": "The heavy anchor is connected to the boat with a long metal <w>chain</w>.",
                            "target_lang_translations": {
                                "ru": "Тяжелый якорь соединен с лодкой длинной металлической <w>цепью</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "rackle"
                    ],
                    "common_phrases": [
                        "gold chain",
                        "metal chain",
                        "anchor chain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ряд соединенных между собой колец или звеньев, обычно сделанных из металла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цепь",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "цепочка",
                                "target_lang_sense_clarification": "тонкая или ювелирная"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bec78b49-1377-369b-95ea-837248d9078c",
                    "sense_definition": "A series of interconnected things or events.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden closure of the factory started a <w>chain</w> of events that affected the whole town.",
                            "target_lang_translations": {
                                "ru": "Внезапное закрытие завода положило начало <w>цепи</w> событий, затронувших весь город."
                            }
                        },
                        {
                            "text": "We hiked across a beautiful <w>chain</w> of mountains during our summer vacation.",
                            "target_lang_translations": {
                                "ru": "Во время летнего отпуска мы совершили поход через красивую горную <w>цепь</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chain of events",
                        "mountain chain",
                        "chain of command"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ряд взаимосвязанных вещей или событий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цепь",
                                "target_lang_sense_clarification": "событий или гор"
                            },
                            {
                                "target_lang_word": "цепочка",
                                "target_lang_sense_clarification": "последовательность"
                            },
                            {
                                "target_lang_word": "ряд",
                                "target_lang_sense_clarification": "последовательность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3514b6ac-f030-3111-b0a1-de40feb6330c",
                    "sense_definition": "A series of stores or businesses with the same brand name.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That <w>chain</w> of restaurants is expanding into our town next month.",
                            "target_lang_translations": {
                                "ru": "Эта <w>сеть</w> ресторанов расширяется и открывается в нашем городе в следующем месяце."
                            }
                        },
                        {
                            "text": "She prefers shopping at a local boutique rather than a large retail <w>chain</w>.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает делать покупки в местном бутике, а не в крупной розничной <w>сети</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "restaurant chain",
                        "retail chain",
                        "hotel chain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сеть магазинов или предприятий под одним брендом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сеть",
                                "target_lang_sense_clarification": "магазинов, ресторанов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d658ef29-94b0-3f13-b432-3e26211af28d",
                    "sense_definition": "That which confines, fetters, or secures; a bond or restriction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He finally felt free from the <w>chains</w> of habit that had held him back for years.",
                            "target_lang_translations": {
                                "ru": "Он наконец почувствовал себя свободным от <w>оков</w> привычки, которые сдерживали его годами."
                            }
                        },
                        {
                            "text": "The prisoners were led away in <w>chains</w> after the trial ended.",
                            "target_lang_translations": {
                                "ru": "После окончания суда заключенных увели в <w>цепях</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "rackle"
                    ],
                    "common_phrases": [
                        "break the chains",
                        "in chains",
                        "chains of habit"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что ограничивает, сковывает или удерживает; узы или ограничения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оковы",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "цепи",
                                "target_lang_sense_clarification": "физические или метафорические"
                            },
                            {
                                "target_lang_word": "кандалы",
                                "target_lang_sense_clarification": "физические оковы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "689c7cf3-53d6-3096-9dbf-8ec15290fa88",
                    "sense_definition": "A sequence of linked house purchases, each of which is dependent on the preceding and succeeding purchase.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "real_estate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sale fell through because someone at the bottom of the <w>chain</w> pulled out.",
                            "target_lang_translations": {
                                "ru": "Сделка сорвалась, потому что кто-то в конце <w>цепочки</w> отказался."
                            }
                        },
                        {
                            "text": "Buying a house without a <w>chain</w> is usually much faster and less stressful.",
                            "target_lang_translations": {
                                "ru": "Покупка дома без <w>цепочки</w> сделок обычно проходит намного быстрее и спокойнее."
                            }
                        }
                    ],
                    "common_phrases": [
                        "property chain",
                        "housing chain",
                        "break the chain"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Последовательность сделок по покупке жилья, где каждая зависит от предыдущей и последующей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цепочка",
                                "target_lang_sense_clarification": "в сделках с недвижимостью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26e5b11f-a12d-3e84-823c-1795d804a83f",
                    "sense_definition": "A number of atoms in a series, which combine to form a molecule.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When examined, the molecular <w>chain</w> included oxygen and hydrogen atoms.",
                            "target_lang_translations": {
                                "ru": "При исследовании выяснилось, что молекулярная <w>цепь</w> включает атомы кислорода и водорода."
                            }
                        },
                        {
                            "text": "The scientist studied the long carbon <w>chain</w> to understand the polymer's properties.",
                            "target_lang_translations": {
                                "ru": "Ученый изучал длинную углеродную <w>цепочку</w>, чтобы понять свойства полимера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "molecular chain",
                        "carbon chain",
                        "side chain"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ряд атомов, соединенных в молекулу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цепь",
                                "target_lang_sense_clarification": "молекулярная"
                            },
                            {
                                "target_lang_word": "цепочка",
                                "target_lang_sense_clarification": "химическая"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7aeaf8f-cb20-3901-8174-b7e55cf7b9e0",
                    "sense_definition": "A unit of length equal to 22 yards, often used in surveying or cricket.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The length of a cricket pitch is exactly one <w>chain</w>.",
                            "target_lang_translations": {
                                "ru": "Длина площадки для крикета составляет ровно один <w>чейн</w>."
                            }
                        },
                        {
                            "text": "The surveyor measured the field and found it was ten <w>chains</w> wide.",
                            "target_lang_translations": {
                                "ru": "Геодезист измерил поле и обнаружил, что его ширина составляет десять <w>чейнов</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "surveying chain",
                        "ten chain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица длины, равная 22 ярдам (около 20 метров), используемая в геодезии или крикете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чейн",
                                "target_lang_sense_clarification": "единица измерения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2a5c033-df61-3e22-afcd-21d97d33b719",
                    "sense_definition": "A totally ordered set, especially a totally ordered subset of a poset.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We first find an approximation of the <w>chain</w> partition in the set.",
                            "target_lang_translations": {
                                "ru": "Сначала мы находим аппроксимацию <w>цепного</w> разбиения в множестве."
                            }
                        },
                        {
                            "text": "In order theory, a <w>chain</w> is a subset where every pair of elements is comparable.",
                            "target_lang_translations": {
                                "ru": "В теории порядка <w>цепь</w> — это подмножество, в котором любая пара элементов сравнима."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chain partition",
                        "linear chain"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Линейно упорядоченное множество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цепь",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a252778a-699e-3cee-8ce4-b9862600beea",
                    "sense_definition": "To fasten or secure something with a chain.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>chain</w> your bicycle to the railings to protect it from being stolen.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>приковать</w> велосипед к перилам, чтобы его не украли."
                            }
                        },
                        {
                            "text": "The gates were <w>chained</w> shut to keep trespassers out of the private property.",
                            "target_lang_translations": {
                                "ru": "Ворота были <w>заперты на цепь</w>, чтобы не пускать посторонних на частную территорию."
                            }
                        }
                    ],
                    "synonyms": [
                        "rackle"
                    ],
                    "antonyms": [
                        "unchain"
                    ],
                    "common_phrases": [
                        "chain up",
                        "chain together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скреплять или закреплять что-либо с помощью цепи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приковывать",
                                "target_lang_sense_clarification": "цепью к чему-либо"
                            },
                            {
                                "target_lang_word": "запирать на цепь",
                                "target_lang_sense_clarification": "ворота, велосипед"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa8751bb-4a88-3913-9af5-7772f7a1e9a6",
                    "sense_definition": "To connect or restrict as if with a chain, often due to dependence or obligation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sometimes I feel like I am <w>chained</w> to this computer all day long.",
                            "target_lang_translations": {
                                "ru": "Иногда мне кажется, что я весь день <w>прикован</w> к этому компьютеру."
                            }
                        },
                        {
                            "text": "She has been <w>chained</w> to her principles since she was a young student.",
                            "target_lang_translations": {
                                "ru": "Она была <w>верна</w> своим принципам (буквально: прикована к ним) еще со студенческих лет."
                            }
                        }
                    ],
                    "antonyms": [
                        "free"
                    ],
                    "common_phrases": [
                        "chained to a desk",
                        "chained to work"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связывать или ограничивать, как цепью, часто из-за зависимости или обязательств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приковывать",
                                "target_lang_sense_clarification": "к работе, к месту"
                            },
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "обязательствами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8fd4888-ba07-3e81-8502-ecd4e4c47117",
                    "sense_definition": "To link multiple items together in a sequence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer decided to <w>chain</w> several commands together to automate the process.",
                            "target_lang_translations": {
                                "ru": "Разработчик решил <w>связать</w> несколько команд вместе, чтобы автоматизировать процесс."
                            }
                        },
                        {
                            "text": "You can <w>chain</w> these plastic clips to make a colorful necklace.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>соединить</w> эти пластиковые зажимы, чтобы сделать разноцветное ожерелье."
                            }
                        }
                    ],
                    "synonyms": [
                        "rackle"
                    ],
                    "common_phrases": [
                        "chain together",
                        "chain commands"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединять несколько элементов в последовательность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "в цепочку"
                            },
                            {
                                "target_lang_word": "объединять",
                                "target_lang_sense_clarification": "последовательно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f497aa10-9d79-30f1-83d2-3f97e23a2481",
                    "sense_definition": "To load and automatically run a program from within another.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The script will <w>chain</w> the next program once the initial setup is complete.",
                            "target_lang_translations": {
                                "ru": "Скрипт <w>запустит</w> следующую программу по цепочке, как только завершится первоначальная настройка."
                            }
                        },
                        {
                            "text": "In older systems, you could <w>chain</w> multiple files to run sequentially.",
                            "target_lang_translations": {
                                "ru": "В старых системах можно было <w>связывать</w> несколько файлов для последовательного запуска."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chain a program",
                        "chain loading"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Загружать и автоматически запускать программу из другой программы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать по цепочке",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0b879144-3b08-33bd-b164-5221456a1727",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is a man named Arthur <w>Chain</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги — человек по имени Артур <w>Чейн</w>."
                            }
                        },
                        {
                            "text": "We are meeting with the <w>Chain</w> family for dinner this evening.",
                            "target_lang_translations": {
                                "ru": "Сегодня вечером мы встречаемся с семьей <w>Чейн</w> за ужином."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Чейн",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
