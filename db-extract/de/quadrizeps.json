                "senses": [
                    {
                        "sense_id": "c50aca93-5a73-33cd-9174-35a098f09649",
                        "entry_id": "2a099221-e718-3034-b972-b240ea10c7e1",
                        "glosses": [
                            "ein zum Oberschenkel gehörender Muskel, der aus vier Muskelköpfen besteht, auf der Vorder-/Oberseite liegt und über das Kniegelenk den Unterschenkel streckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c790cab-9d1a-4909-828e-f5eadad70767",
                                "sense_id": "c50aca93-5a73-33cd-9174-35a098f09649",
                                "text": "Kniebeugen belasten den Quadrizeps."
                            },
                            {
                                "example_id": "aa55bcae-c014-4d0b-8203-3052bf09dd4b",
                                "sense_id": "c50aca93-5a73-33cd-9174-35a098f09649",
                                "text": "Der Quadrizeps ist der Muskel, der bei Sprintern, Radfahrern und Eisschnelläufern eine entscheidende Rolle spielt."
                            },
                            {
                                "example_id": "4e39c5e8-b4d5-4bab-80bf-8ea0cc3e1694",
                                "sense_id": "c50aca93-5a73-33cd-9174-35a098f09649",
                                "text": "Bodybuildern gehe es nicht um die Kraft als solche, sondern nur um das Bild der Kraft, um eine artifizielle, mühevoll gestaltete Körperlandschaft aus Bizeps, Trizeps, Quadrizeps, Delta-, Brust- und Abdomenmuskel."
                            },
                            {
                                "example_id": "d777ab31-1662-4deb-9ab8-43112474aa4d",
                                "sense_id": "c50aca93-5a73-33cd-9174-35a098f09649",
                                "text": "Ex-Zehnkämpfer Jürgen Hingsen: Ich hatte vor gar nicht langer Zeit eine schwere Verletzung am Bein. Im Quadrizeps sind mir drei Muskelstränge gerissen – Spätfolge einer Verletzung, die mich 1988 die Olympischen Spiele in Seoul gekostet haben. …"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
