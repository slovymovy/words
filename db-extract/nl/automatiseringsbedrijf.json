                        "sense_id": "96fb3b46-d951-3ba1-9698-26cb2aabb375",
                        "entry_id": "939d4599-d88c-3db5-b890-da6d6ee69eef",
                        "glosses": [
                            "onderneming die andere bedrijven helpt met het gebruiken van computers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bee32e9-07c4-460b-a22a-c190f6405bd7",
                                "sense_id": "96fb3b46-d951-3ba1-9698-26cb2aabb375",
                                "text": "Bij de parlementaire commissie die ICT-falen bij de overheid onderzocht werd de situatie door een topbestuurder van een automatiseringsbedrijf zo samengevat: „Als de overheid vraagt om een auto zonder stuur, dan waarschuwen we wel. Maar daarna leveren we een auto zonder stuur."
                            },
                            {
                                "example_id": "41847f02-ed76-423f-9dc4-fe9a401a6af2",
                                "sense_id": "96fb3b46-d951-3ba1-9698-26cb2aabb375",
                                "text": "Hoewel automatiseringsbedrijven de afgelopen weken graag vertelden hoe belangrijk zij het belang van de klant vinden, zijn het natuurlijk geen liefdadigheidsinstellingen."
                            },
                            {
                                "example_id": "139e2f9a-dde7-45df-afa4-654bfb84faf6",
                                "sense_id": "96fb3b46-d951-3ba1-9698-26cb2aabb375",
                                "text": "Met de beursgang voegt UCC zich in een rij van nieuw genoteerde automatiseringsbedrijfjes, zoals ICT en CSS."
                            },
                            {
                                "example_id": "f5fc2cb0-3313-4376-a8c4-fb52e881977b",
                                "sense_id": "96fb3b46-d951-3ba1-9698-26cb2aabb375",
                                "text": "AE Kluwer Uitgeversmaatschappij in Deventer heeft een automatiseringsbedrijf opgericht onder de naam IJsselbrein. Deze dochter zal niet alleen werken voor Kluwer. Ook andere bedrijven kunnen op de computer van IJsselbrein hun administratie laten verrichten."
                            }
                        ]
                    }
