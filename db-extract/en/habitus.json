                                "target_senses": [
                                    {
                                        "sense_id": "99284d65-0808-3c98-b33d-cb74f019d475",
                                        "entry_id": "171d1772-3e7b-3a2d-8ced-6a973b98bce2",
                                        "glosses": [
                                            "äußere Erscheinung eines Lebewesens oder einer Gruppe von Lebewesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4769b60a-16cd-4c6e-8fa6-d4b508c2f5de",
                                                "sense_id": "99284d65-0808-3c98-b33d-cb74f019d475",
                                                "text": "Die Kraniche ähneln im Habitus den Schreitvögeln."
                                            },
                                            {
                                                "example_id": "7b4c48fb-af10-44c2-bc5b-d231ca6f9573",
                                                "sense_id": "99284d65-0808-3c98-b33d-cb74f019d475",
                                                "text": "Man kann einen Baum auch im Winter, wenn er keine Blätter hat, an seinem Habitus erkennen."
                                            },
                                            {
                                                "example_id": "07cdf55c-72a9-4d24-bbf5-8e6068185030",
                                                "sense_id": "99284d65-0808-3c98-b33d-cb74f019d475",
                                                "text": "Er ist schon über dreißig, wirkt aber seinem Habitus nach noch wie ein Jugendlicher."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fa1b1f16-5843-32ec-9b59-c85d222c1978",
                                        "entry_id": "171d1772-3e7b-3a2d-8ced-6a973b98bce2",
                                        "glosses": [
                                            "Verhalten eines Lebewesens"
                                        ],
                                        "tags": [
                                            "Soziologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81b5f584-e7fc-4673-8d34-569c6915bbe8",
                                                "sense_id": "fa1b1f16-5843-32ec-9b59-c85d222c1978",
                                                "text": "Er ist schon über dreißig, wirkt aber seinem Habitus nach noch wie ein Jugendlicher."
                                            },
                                            {
                                                "example_id": "0f11b819-6804-462a-aecd-524adecaa235",
                                                "sense_id": "fa1b1f16-5843-32ec-9b59-c85d222c1978",
                                                "text": "„Im vorangegangen Kapitel ist mehrfach der Begriff des Habitus gefallen. So wurde erwähnt, dass die herrschende Klasse sich unter anderem durch einen klassenspezifischen Habitus auszeichnet.“"
                                            },
                                            {
                                                "example_id": "f163f539-5540-4526-9859-8f5a02ccf7d1",
                                                "sense_id": "fa1b1f16-5843-32ec-9b59-c85d222c1978",
                                                "text": "„Thomas Mann, der seine sinnlichen Wünsche mit dem Habitus des bürgerlichen Repräsentanten disziplinierte, ließ sich nur in seinen Tagebüchern gehen.“"
                                            },
                                            {
                                                "example_id": "a8c88c4b-ca2a-41b9-8c6c-7531efd8f32c",
                                                "sense_id": "fa1b1f16-5843-32ec-9b59-c85d222c1978",
                                                "text": "„Aber da sie nun einmal das Ergebnis der bestimmten Bedingungen sind, unter denen die Gattung Mensch lebt, sind sie auch Norm geworden, und jeder sexuelle Habitus, der ihnen nicht entspricht, ist unnormal, welcher Begriff nicht absolut, sondern geschichtlich begründbar ist.“"
                                            },
                                            {
                                                "example_id": "f96831ea-e852-41da-9689-6c667fe53ef2",
                                                "sense_id": "fa1b1f16-5843-32ec-9b59-c85d222c1978",
                                                "text": "„Noch einmal stutzt wenigstens der heutige Leser wegen der tatsächlichen Jugend des Verfassers und seines altklugen Habitus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
