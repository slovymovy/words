                ],
                "senses": [
                    {
                        "sense_id": "18d8d8a7-a714-351e-b7d9-5684901fee5b",
                        "entry_id": "0db915a5-276c-3335-80f2-eceb7bb4e925",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6346c0a-dab5-4364-b258-79d47dc62d10",
                                "sense_id": "18d8d8a7-a714-351e-b7d9-5684901fee5b",
                                "text": "Frau Leiser ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cc254058-a7f0-4804-a4a1-72703902d72c",
                                "sense_id": "18d8d8a7-a714-351e-b7d9-5684901fee5b",
                                "text": "Herr Leiser wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1ab8d31a-d4ef-435f-97ad-c3251914dde8",
                                "sense_id": "18d8d8a7-a714-351e-b7d9-5684901fee5b",
                                "text": "Die Leisers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "b837c64c-4090-4ed8-9cd9-2d0546cb5ca9",
                                "sense_id": "18d8d8a7-a714-351e-b7d9-5684901fee5b",
                                "text": "Der Leiser trägt nie die Schals, die die Leiser ihm strickt."
                            },
                            {
                                "example_id": "58966aee-a990-4636-b360-892fb6034638",
                                "sense_id": "18d8d8a7-a714-351e-b7d9-5684901fee5b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Leiser kommt, geht der Herr Leiser.“"
                            },
                            {
                                "example_id": "800338ca-fad7-4176-95a8-c4269a22dad3",
                                "sense_id": "18d8d8a7-a714-351e-b7d9-5684901fee5b",
                                "text": "Leiser kommt und geht."
                            },
                            {
                                "example_id": "40844bba-54e8-4c00-bb70-067adbe28707",
                                "sense_id": "18d8d8a7-a714-351e-b7d9-5684901fee5b",
                                "text": "Leisers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
