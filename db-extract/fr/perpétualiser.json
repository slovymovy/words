                "senses": [
                    {
                        "sense_id": "55fe60f5-6877-300e-9ccb-c37ad7e70bec",
                        "entry_id": "89bf2f02-74ff-3532-8aaa-11d415b7eb77",
                        "glosses": [
                            "Donner un caractère perpétuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bd2d8e6-22bc-4191-85b8-35cb5fb928b4",
                                "sense_id": "55fe60f5-6877-300e-9ccb-c37ad7e70bec",
                                "text": "Une roue à auge. Une chute d’eau qui tombe de haut sur la roue et l’actionne, un bassin, dans le bas, pour recueillir l’eau. Et, pour perpétualiser le mouvement, — c’est là ou ça cloche, — un siphon prend l’eau dans le bassin et la conduit à la chute d’eau."
                            },
                            {
                                "example_id": "ef1c92e4-501f-4d25-9431-9921e3a79f69",
                                "sense_id": "55fe60f5-6877-300e-9ccb-c37ad7e70bec",
                                "text": "Ensuite si cela fonctionne, les dons et la pub sur le site pourraient perpétualiser le mouvement."
                            },
                            {
                                "example_id": "35936af7-8e87-408f-a550-f0f18d1d835e",
                                "sense_id": "55fe60f5-6877-300e-9ccb-c37ad7e70bec",
                                "text": "Donc, à un certain moment, il faudra \"perpétualiser\" formellement la dette grecque."
                            }
                        ]
                    }
                ],
