                            {
                                "example_id": "b717e1cf-b94e-4949-af22-715c571ae7c6",
                                "sense_id": "186cea2b-a0f3-36f9-976e-1789bd3b8b79",
                                "text": "Diana verongelukte op 31 augustus 1997 in een verkeerstunnel in het centrum van Parijs, toen de auto waarin zij zat met hoge snelheid probeerde te ontkomen aan achtervolgende persfotografen. De prinses was in het gezelschap van de man waarmee ze een relatie had na haar scheiding van de Britse prins Charles. Harry was toen 12 jaar, zijn oudere broer William 15."
                            },
                            {
                                "example_id": "0b952260-84ab-46a0-ab39-26c9448e6caf",
                                "sense_id": "186cea2b-a0f3-36f9-976e-1789bd3b8b79",
                                "text": "Op het programma staan verder een mis van de aartsbisschop van Rio en de opening van de eerste verkeerstunnel van de stad, door president Rousseff en de burgemeester."
                            }
                        ]
