{
    "word_family": [
        "tępy",
        "tępić",
        "stępić",
        "tępawy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8c96695c-0bd3-3999-97f9-4e10b5c75dfc",
                    "sense_definition": "brak inteligencji, powolne myślenie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inteligencja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego <w>tępota</w> doprowadzała wszystkich współpracowników do szału.",
                            "target_lang_translations": {
                                "ru": "Его <w>тупость</w> доводила всех коллег до бешенства."
                            }
                        },
                        {
                            "text": "Nie mogłem znieść tej <w>tępoty</w> w jego oczach podczas rozmowy.",
                            "target_lang_translations": {
                                "ru": "Я не мог выносить эту <w>тупость</w> в его глазах во время разговора."
                            }
                        }
                    ],
                    "synonyms": [
                        "głupota",
                        "ciemnota"
                    ],
                    "antonyms": [
                        "inteligencja",
                        "bystrość"
                    ],
                    "common_phrases": [
                        "rażąca tępota"
                    ],
                    "target_lang_definitions": {
                        "ru": "отсутствие интеллекта, медлительность мышления, глупость"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тупость",
                                "target_lang_sense_clarification": "общее обозначение низкого интеллекта"
                            },
                            {
                                "target_lang_word": "бестолковость",
                                "target_lang_sense_clarification": "отсутствие сообразительности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e706276f-cad8-30ba-9d94-3e837ee8e640",
                    "sense_definition": "cecha przedmiotu, który nie jest ostry",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ostrość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Noża nie dało się użyć ze względu na jego <w>tępotę</w>.",
                            "target_lang_translations": {
                                "ru": "Ножом нельзя было пользоваться из-за его <w>тупости</w>."
                            }
                        },
                        {
                            "text": "Zauważyłem <w>tępotę</w> ostrza podczas krojenia chleba.",
                            "target_lang_translations": {
                                "ru": "Я заметил <w>тупость</w> лезвия, когда резал хлеб."
                            }
                        }
                    ],
                    "antonyms": [
                        "ostrość"
                    ],
                    "common_phrases": [
                        "tępota ostrza"
                    ],
                    "target_lang_definitions": {
                        "ru": "свойство предмета, который не является острым"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тупость",
                                "target_lang_sense_clarification": "состояние лезвия или инструмента"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c3ec7de-759e-315a-b45a-d8e51b01055c",
                    "sense_definition": "brak energii, bierność, apatia",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "energia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego życiowa <w>tępota</w> sprawiała, że nic go nie interesowało.",
                            "target_lang_translations": {
                                "ru": "Его жизненная <w>апатия</w> приводила к тому, что его ничего не интересовало."
                            }
                        },
                        {
                            "text": "Wpadł w dziwną <w>tępotę</w> i przestał reagować na otoczenie.",
                            "target_lang_translations": {
                                "ru": "Он впал в странную <w>апатию</w> и перестал реагировать на окружающих."
                            }
                        }
                    ],
                    "synonyms": [
                        "apatia",
                        "bierność"
                    ],
                    "target_lang_definitions": {
                        "ru": "отсутствие энергии, пассивность, апатия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "апатия",
                                "target_lang_sense_clarification": "состояние безразличия и отсутствия интереса"
                            },
                            {
                                "target_lang_word": "вялость",
                                "target_lang_sense_clarification": "отсутствие жизненной энергии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1efe6a46-c42b-3f83-a7d2-d1d77153b54b",
                    "sense_definition": "osoba mało inteligentna, głupiec",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inteligencja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten <w>tępota</w> znowu nie zrozumiał prostego polecenia.",
                            "target_lang_translations": {
                                "ru": "Этот <w>тупица</w> снова не понял простого распоряжения."
                            }
                        },
                        {
                            "text": "Nie rozmawiaj z nim, to kompletny <w>tępota</w>.",
                            "target_lang_translations": {
                                "ru": "Не разговаривай с ним, он полный <w>тупица</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "głupek",
                        "dureń"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane jako obraźliwe określenie osoby"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "малоинтеллектуальный человек, глупец"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тупица",
                                "target_lang_sense_clarification": "разговорное, пренебрежительное обозначение глупого человека"
                            },
                            {
                                "target_lang_word": "дурак",
                                "target_lang_sense_clarification": "общеупотребительное обозначение глупого человека"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}