                                "target_lang_word": "chytry",
                                "target_lang_sense_clarification": "podstępny, przebiegły"
                            },
                            {
                                "target_lang_word": "cwany",
                                "target_lang_sense_clarification": "wykorzystujący okazje"
                            },
                            {
                                "target_lang_word": "przebiegły",
                                "target_lang_sense_clarification": "podstępny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f1b5482-8623-3e5d-bb7a-82691935b28a",
                    "sense_definition": "Severe, intense, or hard, especially of a physical blow or assault.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "severity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer dealt his opponent a <w>shrewd</w> blow to the jaw, ending the match.",
                            "target_lang_translations": {
                                "pl": "Bokser zadał swojemu przeciwnikowi <w>mocny</w> cios w szczękę, kończąc walkę."
                            }
                        },
                        {
                            "text": "The army suffered a <w>shrewd</w> defeat during the winter campaign.",
                            "target_lang_translations": {
                                "pl": "Armia poniosła <w>dotkliwą</w> klęskę podczas kampanii zimowej."
                            }
                        }
                    ],
                    "synonyms": [
                        "severe",
                        "intense",
                        "hard",
                        "sharp"
                    ],
                    "antonyms": [
                        "mild",
                        "gentle"
                    ],
                    "common_phrases": [
                        "shrewd blow"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English to mean severe or hard"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Silny, gwałtowny lub ciężki, szczególnie w odniesieniu do ciosu fizycznego (przestarzałe)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "mocny",
                                "target_lang_sense_clarification": "o ciosie"
                            },
                            {
                                "target_lang_word": "dotkliwy",
                                "target_lang_sense_clarification": "o porażce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e10ec6d2-6812-361a-b91f-1c85c41a3f43",
                    "sense_definition": "Sharp, piercing, and bitterly cold, especially of wind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "severity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>shrewd</w> wind blew across the desolate moor, chilling them to the bone.",
                            "target_lang_translations": {
                                "pl": "<w>Przenikliwy</w> wiatr wiał nad opuszczonym wrzosowiskiem, mrożąc ich do szpiku kości."
                            }
                        },
                        {
                            "text": "They wrapped their cloaks tightly against the <w>shrewd</w> winter air.",
                            "target_lang_translations": {
                                "pl": "Owinęli się szczelnie płaszczami przed <w>ostrym</w> zimowym powietrzem."
                            }
                        }
                    ],
                    "synonyms": [
                        "piercing",
                        "bitter",
                        "sharp",
                        "biting"
                    ],
                    "antonyms": [
                        "balmy",
                        "warm"
                    ],
                    "common_phrases": [
                        "shrewd wind"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English to describe weather"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Ostry, przenikliwy i lodowaty, szczególnie o wietrze (przestarzałe)."
