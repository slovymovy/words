                        "source_sense_description": "geruhsames Gehen zur abendlichen Erholung",
                        "target_lang_word": "avondwandeling",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avondwandeling",
