                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5a4723f-6f3e-48c2-bbd5-98de4a02011a",
                        "source_entry_id": "cc1b86f1-0c97-37bd-a1f2-b84ccd17e39d",
                        "source_sense_id": "9938dde5-e2f8-3055-a366-5d4738020c66",
                        "target_lang_word": "altnordisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altnordisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "653800ef-50db-3995-99f0-50f42c412713",
                                        "entry_id": "de3655ea-fff4-3930-bc3a-f122784770a4",
                                        "glosses": [
                                            "das Altnordische betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd30aa67-ed37-42e1-ab69-513ed9c13ea4",
                                                "sense_id": "653800ef-50db-3995-99f0-50f42c412713",
                                                "text": "In der Älteren Skandinavistik wird altnordische Philologie gelehrt."
                                            },
                                            {
                                                "example_id": "4df4e8b3-a54f-4b9e-a780-e1f85284ada2",
                                                "sense_id": "653800ef-50db-3995-99f0-50f42c412713",
                                                "text": "Die altnordische Sprache hat heute keine aktiven Sprecher mehr."
                                            },
                                            {
                                                "example_id": "9c7df905-cd52-4382-908a-657df821eb1e",
                                                "sense_id": "653800ef-50db-3995-99f0-50f42c412713",
                                                "text": "„Wenn Snorre von den altnordischen Göttern erzählt, erinnern manche Mythen an indische Mythen, die zwei- oder dreitausend Jahre früher erzählt worden sind.“"
                                            },
                                            {
                                                "example_id": "4d9e2ee9-83c0-4dc5-be67-69de582fa1c6",
                                                "sense_id": "653800ef-50db-3995-99f0-50f42c412713",
                                                "text": "„Eine besondere Aufgabe unseres Wörterbuches sahen wir darin, den für die altnordische Sprache besonders charakteristischen Ausdrucksformen möglichst weiten Raum zu geben; es gehören dazu neben den für bestimmte Wörter typischen Wortverbindungen vor allem die unpersönlichen Ausdrücke und die zahlreichen präpositionalen Fügungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
