                "senses": [
                    {
                        "sense_id": "e94c8739-81f9-3f56-b859-47afdd0a0368",
                        "entry_id": "dea4c12f-9b07-3c4a-9fa0-ddde0ec38cf8",
                        "glosses": [
                            "von Menschen oder Tieren gezogenes Fahrzeug mit geländerartigen Seitenwänden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5b1a190-35b0-4c89-b7ad-2272555b1643",
                                "sense_id": "e94c8739-81f9-3f56-b859-47afdd0a0368",
                                "text": "„Besonderen Spaß machte es, wenn die Strohgarben auf den Leiterwagen gestapelt wurden.“"
                            },
                            {
                                "example_id": "fbc4bbbf-570d-47c7-87ca-823a12efebdf",
                                "sense_id": "e94c8739-81f9-3f56-b859-47afdd0a0368",
                                "text": "„Aus dem Leiterwagen entwickelte sich durch quer darübergelegte Bretter der Zeiselwagen für den lokalen Personentransport (insbesondere im Ausflugsverkehr).“"
                            },
                            {
                                "example_id": "3abcac41-33d4-46ec-ae51-877f7c1eeb9b",
                                "sense_id": "e94c8739-81f9-3f56-b859-47afdd0a0368",
                                "text": "„Ich liege auf der Matratze, mit Kopfkissen und Pelzdecke versorgt, unterm Teppichdach des Leiterwagens.“"
                            },
                            {
                                "example_id": "fe05f648-b6a6-4593-bca2-5cd9f4b28a9c",
                                "sense_id": "e94c8739-81f9-3f56-b859-47afdd0a0368",
                                "text": "„Uns erwartete eine Frau mit kurz geschnittenen Haaren, die meinem Vater jetzt eilig die Koffer und das übrige Gepäck abnahm, das er ihr von oben herunterreichte und es auf einen Leiterwagen hievte, der neben ihr stand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
