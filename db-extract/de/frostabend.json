                "senses": [
                    {
                        "sense_id": "74af0dcc-39ea-3356-9c87-7177dd07a0f2",
                        "entry_id": "fb04770e-00cf-3de6-97aa-19bbbcd070b2",
                        "glosses": [
                            "Abend, an dem Frost herrscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68d43e29-a424-470f-af38-963275976173",
                                "sense_id": "74af0dcc-39ea-3356-9c87-7177dd07a0f2",
                                "text": "„Es war ein klarer Frostabend.“"
                            },
                            {
                                "example_id": "ac07a085-b5e0-4c43-a9fa-93b3c683d09e",
                                "sense_id": "74af0dcc-39ea-3356-9c87-7177dd07a0f2",
                                "text": "„Es ist ein windstiller klarer Frostabend, und die Sterne funkeln am dunkelblauen Himmel.“"
                            },
                            {
                                "example_id": "589205f9-c03c-4097-8769-8723d3f76416",
                                "sense_id": "74af0dcc-39ea-3356-9c87-7177dd07a0f2",
                                "text": "„Es scheint, als ziehe sich Ramsthal vor dem hereinbrechenden Frostabend eine Kuscheldecke über.“"
                            },
                            {
                                "example_id": "358e0fb4-dc9c-40c9-bcee-c103df444a7a",
                                "sense_id": "74af0dcc-39ea-3356-9c87-7177dd07a0f2",
                                "text": "„Nach dem Matschabend in Bottendorf bei der A-Jugend und dem Frostabend in Wetter versprach Jugendwart Rudolf Matter, dass in der nächsten Saison die Endspiele spätestens im September stattfinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
