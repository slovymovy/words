                "senses": [
                    {
                        "sense_id": "0cfb6983-b6f0-34c4-8d1e-da163949daa2",
                        "entry_id": "259cb0bb-1538-3e6d-97d8-363b2b9528ae",
                        "glosses": [
                            "Any species of the hoverfly family Syrphidae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "484d9bc9-5d15-4513-b151-b6de1135a848",
                                "sense_id": "0cfb6983-b6f0-34c4-8d1e-da163949daa2",
                                "text": "2008, Robert L. Bugg, Ramy G. Colfer, William E. Chaney, Hugh A. Smith, James Cannon, Flower Flies (Syrphidae) and Other Biological Control Agents for Aphids in Vegetable Crops, University of California Division of Agriculture an Natural Resources, Publication No. 8285, page 12,\nBecause they are strong fliers and able to hover and inspect foliage for aphids, syrphids may be especially good at locating aphid colonies."
                            },
                            {
                                "example_id": "fc93a13c-46c7-4dca-8cc4-24a8bc9c5b06",
                                "sense_id": "0cfb6983-b6f0-34c4-8d1e-da163949daa2",
                                "text": "A single syrphid larva can consume hundreds of aphids during its development. Syrphid larvae also feed on other soft-bodied insects, such as mealybugs, psyllids, and whiteflies. Adult syrphids, also called flower flies or hover flies, are not predaceous."
                            },
                            {
                                "example_id": "9d409940-265d-4c8c-acc8-ba10eadde2a6",
                                "sense_id": "0cfb6983-b6f0-34c4-8d1e-da163949daa2",
                                "text": "The impact of syrphids has seldom been assessed and their role may be underestimated due to their nocturnal feeding behavior."
                            }
                        ]
                    }
                ],
