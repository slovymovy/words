                        "entry_id": "3da15e80-683b-385e-808e-2bd41145b073",
                        "glosses": [
                            "Someone who takes part in a sport or similar event at weekends."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "349f94cd-d425-4bf8-8efd-0c19bda00889",
                                "sense_id": "35de72c3-acc6-383e-8924-43d8e0a86b39",
                                "text": "There are the regulars who come five or six nights a week; they become bored or impatient with the same sounds night after night. Then there are the weekenders who like the familiar sounds and become quickly impatient with the unfamiliar, newest releases."
                            }
                        ]
                    },
                    {
