                                                "sense_id": "faf2f333-72fa-328e-bf8b-093a9621d183",
                                                "text": "After two days, I am fed up with this nonsense."
                                            },
                                            {
                                                "example_id": "0dbe05c0-c856-44b9-9b81-fbdd39de3d29",
                                                "sense_id": "faf2f333-72fa-328e-bf8b-093a9621d183",
                                                "text": "I am fed up watching football on TV."
                                            },
