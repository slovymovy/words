                        "entry_id": "df08d872-b200-34d4-a673-0d47716dbadc",
                        "glosses": [
                            "Reiter, der die Sportart des Springreitens ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3adaefea-a40c-414e-aa41-f38e3de3ca15",
                                "sense_id": "e88d0a7e-8bba-384f-bd5a-36fbe8e56ad6",
                                "text": "„Als Titelverteidiger in der Gesamt-Wertung des ‚Casino Grand Prix‘ der Springreiter reiste Dieter Köfler zum Auftakt der heurigen Turnierserie nach Linz-Ebelsberg.“"
                            },
                            {
                                "example_id": "c98657b5-6cfd-43aa-9cc6-1e7821007241",
                                "sense_id": "e88d0a7e-8bba-384f-bd5a-36fbe8e56ad6",
                                "text": "„Wie schnell Pferde an den Flanken und am Bauch zu bluten beginnen können, sollten die Springreiter nur zu gut wissen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
