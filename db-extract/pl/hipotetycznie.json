                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3520b1f-6b04-4511-b761-2ea0bfbe637b",
                                                "sense_id": "07b39cbe-aaec-3335-aee7-a6e2eef4fa52",
                                                "text": "Near-synonyms: conceptionally, conceptually"
