                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4784d19a-1866-4bf8-8678-fd1ba3a86e4b",
                                                "sense_id": "8a6b0e55-5fa1-36fe-8e96-3cf58b4161f6",
                                                "text": "[…]one set of 16-inch steel gun forgings[…]"
                                            },
                                            {
                                                "example_id": "e5a04ae6-31df-4176-a52a-1a72bdffb10c",
                                                "sense_id": "8a6b0e55-5fa1-36fe-8e96-3cf58b4161f6",
                                                "text": "Fabrication has been the method used in the construction of many components that would normally be made from steel castings and forgings."
                                            }
