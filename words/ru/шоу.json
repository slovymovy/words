                    "sense_id": "1c9cd5ac-c4de-3d81-9897-fa8186beeb6e",
                    "sense_definition": "Развлекательная телевизионная или радиопрограмма.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждый вечер мы смотрим популярное юмористическое <w>шоу</w>.",
                            "target_lang_translations": {
                                "en": "Every evening we watch a popular comedy <w>show</w>.",
                                "zh": "我们每天晚上都看一档很受欢迎的幽默<w>节目</w>。"
                            }
                        },
                        {
                            "text": "Участники этого реалити-<w>шоу</w> живут на необитаемом острове.",
                            "target_lang_translations": {
                                "en": "The participants of this reality <w>show</w> live on a desert island.",
                                "zh": "这档真人<w>秀</w>的参与者们生活在一座荒岛上。"
                            }
                        }
                    ],
                    "common_phrases": [
