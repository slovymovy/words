                                                "example_id": "5bdf2bfc-9ded-4c2a-ba80-c3c9de1e417c",
                                                "sense_id": "1dfa1d8f-0abb-36e4-b04a-4016f1d013fd",
                                                "text": "Wenn die Frist herum ist, kann man sich nicht mehr anmelden."
