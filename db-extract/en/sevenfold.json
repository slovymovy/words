    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9a8c7ba9-189f-3d86-8562-c942cef290e7",
                "word": "sevenfold",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1da1464a-5a8c-30cc-aa02-937ea0ae2dcb",
                        "entry_id": "9a8c7ba9-189f-3d86-8562-c942cef290e7",
                        "glosses": [
                            "Seven times as much; multiplied by seven."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "43728f00-6ec6-4a87-9bd0-3034bc898b2f",
                                "sense_id": "1da1464a-5a8c-30cc-aa02-937ea0ae2dcb",
                                "text": "“I'm through with all pawn-games,” I laughed. “Come, let us have a game of lansquenet. Either I will take a farewell fall out of you or you will have your sevenfold revenge”."
                            },
                            {
                                "example_id": "5c595a8d-cdb2-4d49-a67b-46a4cfaad98a",
                                "sense_id": "1da1464a-5a8c-30cc-aa02-937ea0ae2dcb",
                                "text": "Long-distance rail travel is increasing despite a similar sevenfold rise in ownership of private transport throughout the country."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0ed85df-37fd-3ff6-a9bb-04c592c2a9ae",
                        "entry_id": "9a8c7ba9-189f-3d86-8562-c942cef290e7",
                        "glosses": [
                            "Having seven parts; composed of seven items."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5766e0de-322d-485a-b828-287573caade1",
                                "sense_id": "a0ed85df-37fd-3ff6-a9bb-04c592c2a9ae",
                                "text": "Come down to the sevenfold gates and harry the foemen away!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fef3f275-9e80-499c-9d5a-55c4e948c680",
                        "source_entry_id": "9a8c7ba9-189f-3d86-8562-c942cef290e7",
                        "source_sense_description": "multiplied by seven (adjective)",
                        "target_lang_word": "zevenvoudig",
