        "fr-extract.jsonl": [
            {
                "entry_id": "c89308e3-b0d5-3aac-a962-78b877665ee9",
                "word": "fibromyalgie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5ed2cf37-12a7-4d92-8aee-e71b2bb36864",
                        "entry_id": "c89308e3-b0d5-3aac-a962-78b877665ee9",
                        "tags": [
                            "plural"
                        ],
                        "form": "fibromyalgies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "963d4c6a-9c49-349c-88e3-59ccfb31fb0b",
                        "entry_id": "c89308e3-b0d5-3aac-a962-78b877665ee9",
                        "glosses": [
                            "Douleurs musculaires, osseuses et articulaires chroniques, associées ou non au syndrome du sommeil non réparateur, et dues souvent à une hypersensibilité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f52dd650-4501-4b45-a82a-81a8dbf3a4b5",
                                "sense_id": "963d4c6a-9c49-349c-88e3-59ccfb31fb0b",
                                "text": "La fibromyalgie ou syndrome fibromyalgique s’inscrit dans un contexte douloureux, et on estime sa prévalence à 1,6% dans la population générale. Cette douleur chronique diffuse est complexe et souvent vécu^([sic]) difficilement faute de diagnostic ou de prise en charge adaptée."
                            },
                            {
                                "example_id": "b1ab9153-3f4c-4674-8a01-1525c99d31a6",
                                "sense_id": "963d4c6a-9c49-349c-88e3-59ccfb31fb0b",
                                "text": "Ainsi, le fait d’avoir été victime de violences sexuelles de l’enfance constitue par exemple un facteur de risque de la fibromyalgie, une maladie provoquant des douleurs musculaires ou articulaires permanentes accompagnées d’autres troubles – du sommeil et de l’humeur notamment."
                            },
                            {
                                "example_id": "e868580f-b66e-4627-8d1c-f684141349d2",
                                "sense_id": "963d4c6a-9c49-349c-88e3-59ccfb31fb0b",
                                "text": "Bref : la fibromyalgie est un véritable casse-tête, autant pour les patients qui en souffrent que pour les médecins qui s’efforcent de la prendre en charge."
                            },
                            {
                                "example_id": "e7161fa2-dfad-482b-9b79-a19c6fbe7d55",
                                "sense_id": "963d4c6a-9c49-349c-88e3-59ccfb31fb0b",
                                "text": "Les café-rencontres sont des occasions de rassemblement pour les personnes atteintes de fibromyalgie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29ef3be7-8118-4767-beda-cc0f7f8506ef",
                        "source_entry_id": "c89308e3-b0d5-3aac-a962-78b877665ee9",
                        "source_sense_id": "963d4c6a-9c49-349c-88e3-59ccfb31fb0b",
                        "source_sense_description": "Douleurs musculaires, osseuses et articulaires chroniques",
                        "target_lang_word": "Fibromyalgie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fibromyalgie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6167821b-c678-3bd3-b58a-cab8736a4716",
                                        "entry_id": "e9753356-09a5-3deb-bf07-e2e58eede6b5",
                                        "glosses": [
                                            "chronische Krankheit, die mit erheblichen Schmerzen am gesamten Bewegungsapparat, vor allem den Muskeln und Sehnen, verbunden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81b5dac3-9c6a-4187-b99d-fa285f3c8cf4",
                                                "sense_id": "6167821b-c678-3bd3-b58a-cab8736a4716",
                                                "text": "„Teilweise scheint dies bei der Fibromyalgie der Fall zu sein, jenem allgemeinen Muskelschmerz („Mir tut alles weh“), der drei Prozent aller Frauen quält.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "097693ca-f6b7-473c-a834-668f1eeafa67",
                        "source_entry_id": "c89308e3-b0d5-3aac-a962-78b877665ee9",
                        "source_sense_id": "963d4c6a-9c49-349c-88e3-59ccfb31fb0b",
                        "source_sense_description": "Douleurs musculaires, osseuses et articulaires chroniques",
                        "target_lang_word": "fibromyalgia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fibromyalgia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bab97208-2644-3e0a-8708-68c846f6a0b6",
                                        "entry_id": "eddf7561-cb61-30ec-8503-de0f19f5efbf",
                                        "glosses": [
                                            "A condition characterized by chronic pain, stiffness, and tenderness of the muscles, tendons, and joints."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4c50893-e053-498e-af01-f883fc0cac2a",
                                                "sense_id": "bab97208-2644-3e0a-8708-68c846f6a0b6",
                                                "text": "They have since used the approach to look at the brains of people with fibromyalgia, a mysterious syndrome that causes pain all over the body. Volunteers with fibromyalgia also had more active glial cells in their brains, although this time in the cerebellar cortex and the medulla – regions that are linked to movement and automatic functions like breathing and digestion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ceac783-a001-4e9f-a858-b52335ccbc7e",
