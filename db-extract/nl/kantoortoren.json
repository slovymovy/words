                        "examples": [
                            {
                                "example_id": "ce181a4e-5b31-493b-b7fa-c5534a945a71",
                                "sense_id": "f5a562a1-a792-37b3-a718-d4048beb5735",
                                "text": "Sinds dat inzicht de metrotunnels van de miljoenensteden is binnengesijpeld en bij elke koffieautomaat, in elke lift, op elke verdieping van de kantoortorens tersluiks binnenstebuiten wordt gekeerd, krijgen de mensen een burn-out."
                            },
                            {
                                "example_id": "7138bf96-9df1-4b13-a1e9-3ddfcdd52b98",
                                "sense_id": "f5a562a1-a792-37b3-a718-d4048beb5735",
                                "text": "Wie het terrein van chipmachinemaker ASML in Veldhoven op rijdt, ontkomt niet aan de hoge kantoortoren die het terrein flankeert. Daarin, op de negentiende verdieping, krijg je als bezoeker een goed beeld van hoe groot het bedrijf nu is, maar ook hoe hard het nog gaat groeien."
                            }
                        ]
                    }
