                        "examples": [
                            {
                                "example_id": "b5e4a932-2220-424e-a799-de3c021bba90",
                                "sense_id": "fd67d22c-ef39-31f9-9054-eb8754f82562",
                                "text": "„Mit Rücksicht auf ihre Verfassung hielt man die Veröffentlichung des Romans zurück, bis er endlich, zwei Jahre nach seinem Abschluss, in einer Erstauflage von zweitausend Exemplaren erschien.“"
                            },
                            {
                                "example_id": "8e78fe04-790d-46d5-8a24-06316c225ac1",
                                "sense_id": "fd67d22c-ef39-31f9-9054-eb8754f82562",
                                "text": "„Ende März waren alle 750 Exemplare der Erstauflage auf normalem Papier verkauft.“"
                            },
                            {
                                "example_id": "f06f5850-1670-4a27-ac6b-3e72f57459a5",
                                "sense_id": "fd67d22c-ef39-31f9-9054-eb8754f82562",
                                "text": "„Das Publikum folgt Letzterem, die Erstauflage beträgt 1000 Stück, eine zweite gibt es nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
