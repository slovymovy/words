                                        "entry_id": "b18a640c-18da-3928-8237-7ae74034abb7",
                                        "glosses": [
                                            "der Vorgang, dass etwas geschändet wird, also etwas, dem Respekt gebührt, beschädigt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d5c77a9-0967-4a10-8159-39928434a788",
                                                "sense_id": "2779da54-e17d-3451-bd5c-29e23d32538c",
                                                "text": "Schändungen jüdischer Friedhöfe nahmen in Frankreich 2019 mit Erstarken des Antisemitismus zu."
                                            }
