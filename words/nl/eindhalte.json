            "pos": "noun",
            "senses": [
                {
                    "sense_id": "386c7026-5ed5-3083-9667-52abb9f7557b",
                    "sense_definition": "De laatste stopplaats van een bus- of tramlijn.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "stopplaats",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De buschauffeur vertelde ons dat we bij de <w>eindhalte</w> moesten uitstappen.",
                            "target_lang_translations": {
                                "en": "The bus driver told us that we had to get off at the <w>last stop</w>."
                            }
                        },
                        {
                            "text": "De tram rijdt helemaal door naar de <w>eindhalte</w> bij het nieuwe ziekenhuis.",
                            "target_lang_translations": {
                                "en": "The tram runs all the way to the <w>terminus</w> near the new hospital."
                            }
                        }
                    ],
                    "synonyms": [
                        "eindpunt",
                        "eindstation",
                        "terminus"
                    ],
                    "common_phrases": [
                        "de laatste eindhalte",
                        "eindhalte van de bus"
                    ],
                    "target_lang_definitions": {
                        "en": "The final stop of a bus or tram line."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "terminus",
                                "target_lang_sense_clarification": "the end point of a transportation line"
                            },
                            {
                                "target_lang_word": "terminal",
                                "target_lang_sense_clarification": "a station where a transport service begins or ends"
                            },
                            {
                                "target_lang_word": "last stop",
                                "target_lang_sense_clarification": "the final stop of a bus, train, or tram"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f83ab27d-d082-34d2-b522-2bee3d689a0d",
                    "sense_definition": "De uiteindelijke bestemming van een reis of traject.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bestemming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange en vermoeiende reis bereikten we eindelijk onze <w>eindhalte</w>.",
                            "target_lang_translations": {
                                "en": "After a long and tiring journey, we finally reached our <w>final destination</w>."
                            }
                        },
                        {
                            "text": "Veel reizigers waren bezorgd dat ze hun geplande <w>eindhalte</w> niet op tijd zouden halen.",
                            "target_lang_translations": {
                                "en": "Many travelers were worried that they would not reach their planned <w>destination</w> on time."
                            }
                        }
                    ],
                    "synonyms": [
                        "eindpunt"
                    ],
                    "common_phrases": [
                        "de geplande eindhalte",
                        "onze eindhalte bereiken"
                    ],
                    "target_lang_definitions": {
                        "en": "The final destination of a journey or route."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ultimate destination",
                                "target_lang_sense_clarification": "the final place one is traveling to"
                            },
                            {
                                "target_lang_word": "final destination",
                                "target_lang_sense_clarification": "the end point of a journey"
                            }
                        ]
                    }
                }
            ]
        }
