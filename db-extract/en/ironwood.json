                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f73be14d-af62-3c09-a634-0debed2da3a3",
                                        "entry_id": "76a098ef-d95f-3cb1-8a32-71b4dd6d6a34",
                                        "glosses": [
