                        "form": "dem Lichtscheine"
                    },
                    {
                        "form_id": "1e8ee2e3-533f-42e7-b1b7-f9b12ca1c420",
                        "entry_id": "6243bae4-9395-3b7b-9c53-b9acc9317b21",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Lichtschein"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e751329a-25af-3f8d-9957-0b70a8472140",
                        "entry_id": "6243bae4-9395-3b7b-9c53-b9acc9317b21",
                        "glosses": [
                            "Schein, der von einer Lichtquelle ausgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0a2be51-5f5c-45a0-985f-3f6085b59716",
                                "sense_id": "e751329a-25af-3f8d-9957-0b70a8472140",
                                "text": "Die Küche wurde vom blassen Lichtschein einer Kerze erhellt."
                            },
                            {
                                "example_id": "fa916b81-c5ad-4c42-bcdb-caba70d2a08a",
                                "sense_id": "e751329a-25af-3f8d-9957-0b70a8472140",
                                "text": "„Vom Schloßberg war nichts zu sehen, Nebel und Finsternis umgaben ihn, auch nicht der schwächste Lichtschein deutete das große Schloß an.“"
                            },
                            {
                                "example_id": "73c6736f-3ca3-4936-b510-121633a3bc4d",
                                "sense_id": "e751329a-25af-3f8d-9957-0b70a8472140",
                                "text": "„Ihre Gesichter sind in das Halbdunkel des Raumes getaucht, aber sie geraten in den Lichtschein des Fensters, als sie den Ankömmlingen ein paar Schritte entgegengehen.“"
                            },
                            {
                                "example_id": "d06131e4-c67d-4f55-80ee-65ae8925eba0",
                                "sense_id": "e751329a-25af-3f8d-9957-0b70a8472140",
                                "text": "„Wir kommen in den Lichtschein des Ladens, und hier zeige ich Karnej auf meiner Uhr, daß wir um fünf fahren werden.“"
                            },
                            {
                                "example_id": "e35254d9-bc37-42c0-bf07-d28503c96043",
                                "sense_id": "e751329a-25af-3f8d-9957-0b70a8472140",
                                "text": "„Durch diesen Lichtschein flogen die feinen Flöckchen des Schneefalls zur Erde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "913969e2-7875-4a90-b7a2-773fad1ac286",
                        "source_entry_id": "6243bae4-9395-3b7b-9c53-b9acc9317b21",
                        "source_sense_id": "e751329a-25af-3f8d-9957-0b70a8472140",
                        "source_sense_description": "Schein, der von einer Lichtquelle ausgeht",
                        "target_lang_word": "gleam of light",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d500d425-460e-4397-a943-c20b004d7477",
                        "source_entry_id": "6243bae4-9395-3b7b-9c53-b9acc9317b21",
                        "source_sense_id": "e751329a-25af-3f8d-9957-0b70a8472140",
                        "source_sense_description": "Schein, der von einer Lichtquelle ausgeht",
                        "target_lang_word": "lueur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "484235eb-b4c3-3696-874e-73ef048dec0d",
                                        "entry_id": "a342d5c3-04ba-3604-a5c5-4106a3036595",
                                        "glosses": [
                                            "Lumière faible ou affaiblie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8a25e47-af07-4e9b-8518-c6a09381df84",
                                                "sense_id": "484235eb-b4c3-3696-874e-73ef048dec0d",
                                                "text": "Au jour tombant, il […] prenait un repas frugal à la clarté de la lune, ou à la lueur des étoiles."
                                            },
                                            {
                                                "example_id": "d3e9d264-6db2-4c3f-aad2-675d867ca0c3",
                                                "sense_id": "484235eb-b4c3-3696-874e-73ef048dec0d",
                                                "text": "Le jour venait. […]. Les pailles, dont les couches épaisses recouvraient entièrement le sol de la cour, se doraient peu à peu d'un jaune pâle sous la lueur grandissante du crépuscule."
                                            },
                                            {
                                                "example_id": "9d88adf1-caf8-4e0a-a35a-011cc1a4a346",
                                                "sense_id": "484235eb-b4c3-3696-874e-73ef048dec0d",
                                                "text": "La veilleuse éclairait Carmen d’une pâle lueur rose."
                                            },
                                            {
                                                "example_id": "05f92d44-43d8-4a6c-839f-aca6d4d925a8",
                                                "sense_id": "484235eb-b4c3-3696-874e-73ef048dec0d",
                                                "text": "C’est impossible, car le train va bientôt stopper à Ghéok-Tepé, puis à Askhabad, d’où il repartira aux premières lueurs du jour."
                                            },
                                            {
                                                "example_id": "a49a90d0-7bd2-4bea-8eef-ec73193f2354",
                                                "sense_id": "484235eb-b4c3-3696-874e-73ef048dec0d",
                                                "text": "Depuis les premières lueurs du jour, en effet, il avait distingué des masses épaisses se dirigeant du sud au nord, en avant du front de ses troupes, et il savait d'autre part, par le dire d'un paysan, que des troupes de toutes armes avaient atteint déjà Francheval et Villers-Cernay."
                                            },
                                            {
                                                "example_id": "bacedb06-259c-45fc-ad00-2f75d6d0e788",
                                                "sense_id": "484235eb-b4c3-3696-874e-73ef048dec0d",
                                                "text": "Seul, sur la place, le débit de tabac flamboyait, projetant dans la nuit une vaste lueur tango dont les reflets moiraient le ciment des trottoirs […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72cac962-0524-3770-8754-557009b1bb75",
                                        "entry_id": "a342d5c3-04ba-3604-a5c5-4106a3036595",
                                        "glosses": [
                                            "Légère apparence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5ac9d38-fa8e-4036-8e2e-d2b8e1c445a9",
                                                "sense_id": "72cac962-0524-3770-8754-557009b1bb75",
                                                "text": "Il y a quelque lueur de raison dans ce qu’il fit."
                                            },
                                            {
                                                "example_id": "1000b680-3a4b-4ce6-a2a9-83ba233f6142",
                                                "sense_id": "72cac962-0524-3770-8754-557009b1bb75",
                                                "text": "Entrevoir quelque lueur de fortune."
                                            },
                                            {
                                                "example_id": "79b80b44-378b-4bcf-8be9-eb47cf4348bd",
                                                "sense_id": "72cac962-0524-3770-8754-557009b1bb75",
                                                "text": "Avoir une lueur d’espérance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6b34f0f-bc84-4edf-8cf7-6aebe40db231",
                        "source_entry_id": "6243bae4-9395-3b7b-9c53-b9acc9317b21",
