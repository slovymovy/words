                ],
                "senses": [
                    {
                        "sense_id": "010b3ec6-5839-37da-acdf-3af7f69a75f6",
                        "entry_id": "4dac5144-8c09-3854-a605-dacebfa3d66d",
                        "glosses": [
                            "Geschoss, das mit einem Revolver verschossen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce6bb108-2b1b-4c76-b37c-1c589c5fea78",
                                "sense_id": "010b3ec6-5839-37da-acdf-3af7f69a75f6",
                                "text": "„Auf ein paar einleitende Sätze folgten erst eine Reihe von im weichen jamaikanischen Akzent vorgebrachten Anschuldigungen und dann eine ganze Menge Revolverkugeln.“"
                            },
                            {
                                "example_id": "b2d4be22-c41e-4247-b7fa-67cec04dbe73",
                                "sense_id": "010b3ec6-5839-37da-acdf-3af7f69a75f6",
                                "text": "„Bei Einbruch der Dunkelheit wankten bezechte Tollhäusler fluchend durch die Straßen und brachten mit Revolverkugeln die Kirchglocken zum Läuten, eine gottlose Katzenmusik, bis schließlich der Priester, ein Kruzifix in den Händen, nach draußen kam und sie mit Bruchstücken einer lateinisch vorgetragenen Psalmodie zur Ordnung rief.“"
                            },
                            {
                                "example_id": "3a95264d-3e0a-48de-94c1-f69d7ac3bbd4",
                                "sense_id": "010b3ec6-5839-37da-acdf-3af7f69a75f6",
                                "text": "„Nun ja, dass ich das Opfer einer Aggression geworden war, konnte man nicht bestreiten. Einer Aggression in Form von Revolverkugeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
