                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e66c13ac-ce32-4c72-8020-beff0e45799d",
                                "sense_id": "3f742808-3fb1-352f-9784-e708e31f3643",
                                "text": "Largely through black-and-white rehearsal stills of Barbagallo, Davis and Kaminsky, shot at The Brick in Brooklyn, it captures what theater feels like — the everyday incantation of it, and how unreachably far away that seems now."
                            },
                            {
                                "example_id": "1f03b983-f3fc-4c0f-a040-2169e934c54b",
                                "sense_id": "3f742808-3fb1-352f-9784-e708e31f3643",
                                "text": "If Freud's reading here — his progress on the \"royal road to ... the unconscious\" — is halted, and he finds himself unable to advance further along the way, this point of blockage is at the same time a point of branching -out or divergence: a point from which, says Freud, the thoughts of the dream discandy and disperse unreachably \"in every direction into the intricate network of our world of thought\" ."
                            }
                        ]
                    }
