                "senses": [
                    {
                        "sense_id": "c33cc10d-d4b3-3b06-a9ee-3275479009c9",
                        "entry_id": "9f179440-d34b-3327-a7a2-f27a38dc0caf",
                        "glosses": [
                            "Menge von Kunststoffen, die sich durch besondere Merkmale auszeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75b1d328-d642-40c8-b17b-7e0840165c47",
                                "sense_id": "c33cc10d-d4b3-3b06-a9ee-3275479009c9",
                                "text": "Wenn es Möhren aus Kunststoff zum Mittag gibt, so ist das eine Kunststoffsorte die den Sinn der Kunststoffkarotte hinterfragen läst."
                            },
                            {
                                "example_id": "aaa981f0-ff79-4008-bd71-8b8d93ec3a50",
                                "sense_id": "c33cc10d-d4b3-3b06-a9ee-3275479009c9",
                                "text": "„Kunststoffe bestehen aus Makromolekülen, die je nach Kunststoffsorte unterschiedlich angeordnet sein können.“"
                            },
                            {
                                "example_id": "26e07b36-f77a-44aa-b9eb-e23941b9b61c",
                                "sense_id": "c33cc10d-d4b3-3b06-a9ee-3275479009c9",
                                "text": "„Mahlanlagen sind in der Lage alle möglichen Kunststoffsorten– und typen einzumahlen.“"
                            },
                            {
                                "example_id": "0476fc50-1766-468d-af67-c5761fbc1b87",
                                "sense_id": "c33cc10d-d4b3-3b06-a9ee-3275479009c9",
                                "text": "„Erhalten Sie einen Überblick über die wichtigsten Kunststoffsorten und deren Eigenschaften.“"
                            },
                            {
                                "example_id": "0b72b099-3a15-47f1-b423-be883299496d",
                                "sense_id": "c33cc10d-d4b3-3b06-a9ee-3275479009c9",
                                "text": "„Am Wertstoffhof kommen weitere Kunststoffsorten wie PET-Flaschen und Styropor dazu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
