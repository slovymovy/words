                "senses": [
                    {
                        "sense_id": "9eee6714-ed6e-3382-bc2d-a7e70e3cf681",
                        "entry_id": "643508e5-4b30-38d4-9e65-c7582e3d8187",
                        "glosses": [
                            "Celle qui prend, qui a coutume de prendre. Se dit des personnes qui usent habituellement de certaines choses."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "0d5642b4-1b5c-4b06-a471-a318b20eb934",
                                "sense_id": "9eee6714-ed6e-3382-bc2d-a7e70e3cf681",
                                "text": "N’ai-je pas eu le guignon de rencontrer la commere Cornu !… — Qui ! la preneuse de lavemens ? — La même ; elle m’a retenue : et c’était pour m’en dire de ce pauvre M. Cascaret !…"
                            },
                            {
                                "example_id": "fb521a42-81ed-4c0a-b68f-1b6aadde760a",
                                "sense_id": "9eee6714-ed6e-3382-bc2d-a7e70e3cf681",
                                "text": "— La vie s’ouvre devant nous, continuait la preneuse d’âmes : à nous les doux propos, aux morts le silence."
                            },
                            {
                                "example_id": "b0ff5441-470c-4521-9ff3-19a04ff85d0d",
                                "sense_id": "9eee6714-ed6e-3382-bc2d-a7e70e3cf681",
                                "text": "Hélépole. Machine de guerre ; littéralement « la preneuse de villes »."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae30c838-d7c2-3126-b5e7-54a833b9732a",
                        "entry_id": "643508e5-4b30-38d4-9e65-c7582e3d8187",
                        "glosses": [
                            "Celle qui prend une maison à loyer ou une terre à ferme."
                        ],
