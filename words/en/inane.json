{
    "word_family": [
        "inanity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fa199aa1-3be5-31ad-ae80-a271febc7e09",
                    "sense_definition": "Lacking sense or meaning, often to the point of boredom or annoyance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "meaningless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The meeting was filled with <w>inane</w> chatter that wasted everyone's time.",
                            "target_lang_translations": {
                                "ru": "Встреча была наполнена <w>бессмысленной</w> болтовней, которая тратила время каждого."
                            }
                        },
                        {
                            "text": "He grew tired of the <w>inane</w> questions asked by the reporters.",
                            "target_lang_translations": {
                                "ru": "Он устал от <w>глупых</w> вопросов, которые задавали репортеры."
                            }
                        }
                    ],
                    "synonyms": [
                        "silly",
                        "fatuous",
                        "vapid"
                    ],
                    "common_phrases": [
                        "inane chatter",
                        "inane questions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный смысла или содержания, часто до такой степени, что это вызывает скуку или раздражение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глупый",
                                "target_lang_sense_clarification": "о действиях или словах, лишенных здравого смысла"
                            },
                            {
                                "target_lang_word": "бессмысленный",
                                "target_lang_sense_clarification": "не имеющий логического содержания"
                            },
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "о разговорах, не несущих никакой ценной информации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72f3cf75-268c-37ba-be08-db5367b8c62a",
                    "sense_definition": "Purposeless or pointless.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "meaningless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project felt entirely <w>inane</w> because it had no clear objective.",
                            "target_lang_translations": {
                                "ru": "Проект казался совершенно <w>бесцельным</w>, потому что у него не было четкой цели."
                            }
                        },
                        {
                            "text": "They spent the afternoon in an <w>inane</w> search for lost keys that were in the car.",
                            "target_lang_translations": {
                                "ru": "Они провели день в <w>бессмысленном</w> поиске потерянных ключей, которые лежали в машине."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий цели или смысла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бесцельный",
                                "target_lang_sense_clarification": "не имеющий конкретной цели или задачи"
                            },
                            {
                                "target_lang_word": "бессмысленный",
                                "target_lang_sense_clarification": "не имеющий оправданной цели или логики"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6430ca51-176b-3627-b3f2-92675ab34bee",
                    "sense_definition": "That which is void or empty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "void",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stars shine brightly in the vast <w>inane</w> of space.",
                            "target_lang_translations": {
                                "ru": "Звезды ярко сияют в необъятной <w>пустоте</w> космоса."
                            }
                        },
                        {
                            "text": "He stared into the dark <w>inane</w> beyond the window.",
                            "target_lang_translations": {
                                "ru": "Он смотрел в темную <w>бездну</w> за окном."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in literary or poetic contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что является пустотой или бездной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустота",
                                "target_lang_sense_clarification": "абстрактное понятие пустого пространства"
                            },
                            {
                                "target_lang_word": "бездна",
                                "target_lang_sense_clarification": "глубокое, безграничное пространство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}