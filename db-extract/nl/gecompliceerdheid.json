                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cb2b5f3-4c1f-41b6-9b03-38fcc2abcc47",
                                                "sense_id": "64b84a23-a623-3aa8-9d80-428ee432bcb2",
                                                "text": "There are many intricacies in the plot of this novel."
                                            },
                                            {
                                                "example_id": "694020fd-fb6d-40d4-9ff7-df62600f5d7e",
                                                "sense_id": "64b84a23-a623-3aa8-9d80-428ee432bcb2",
                                                "text": "With the most patient assiduity he peered into the intricacies of unrevealed structure. No object was too minute, none too large, for his attention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
