        "fr-extract.jsonl": [
            {
                "entry_id": "21fa6264-d5df-3480-aad5-369ace6b59f1",
                "word": "forban",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8349ac47-9ece-447a-b6db-da2aa6898e72",
                        "entry_id": "21fa6264-d5df-3480-aad5-369ace6b59f1",
                        "tags": [
                            "plural"
                        ],
                        "form": "forbans"
                    },
                    {
                        "form_id": "163cc966-d824-4472-bf12-4ad609e1f988",
                        "entry_id": "21fa6264-d5df-3480-aad5-369ace6b59f1",
                        "tags": [
                            "feminine"
                        ],
                        "form": "forbanne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc0d65c9-9b60-30d2-b5dc-1856fbba3a01",
                        "entry_id": "21fa6264-d5df-3480-aad5-369ace6b59f1",
                        "glosses": [
                            "Pirate ou voleur de mer, qui naviguait sans commission d’aucun gouvernement, sans lettre de marque ou de lettre de course."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04bb6f42-6d3e-4ede-bb2f-a943d33d2694",
                                "sense_id": "cc0d65c9-9b60-30d2-b5dc-1856fbba3a01",
                                "text": "Il avait parcouru mers et mondes avec de monstrueux forbans et il n’y avait pas d’acte de pirateries dont il n’avait pas été partie. Il avait tout perdu dans ces pérégrinations, foi, honneur, fierté, et n’avait conservé que les desseins de faire le mal inspiré par les démons de l’enfer."
                            }
                        ]
                    },
                    {
                        "sense_id": "56d64dad-fd68-34f3-a1df-a30447e3cf25",
                        "entry_id": "21fa6264-d5df-3480-aad5-369ace6b59f1",
                        "glosses": [
                            "Se dit de celui qui est capable de tous les méfaits."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "256dff57-5f8c-4c7e-9b9f-bd8f39b10422",
                                "sense_id": "56d64dad-fd68-34f3-a1df-a30447e3cf25",
                                "text": "Que veux-tu faire avec des forbans de cette espèce ? Disqualifié, fichu, méprisé, il n'en continuait pas moins à rançonner ses contemporains."
                            },
                            {
                                "example_id": "c3fd2cce-b8af-4a70-bdb8-125444eb11f2",
                                "sense_id": "56d64dad-fd68-34f3-a1df-a30447e3cf25",
                                "text": "Frank Harris, […], combina un déjeuner au cours duquel Wilde stimula si habilement la vanité du forban à cervelle d'oiseau que celui-ci en vint à s'enorgueillir de son ignominie."
                            },
                            {
                                "example_id": "3d2cdf57-be92-4e61-989f-6710af60392b",
                                "sense_id": "56d64dad-fd68-34f3-a1df-a30447e3cf25",
                                "text": "Pour les autres crimes qu’il a commis avec la complicité de sa famille de forbans, il faut attendre les conclusions des enquêtes en cours sur ses multiples transgressions de lois criminelles, fiscales et électorales."
                            },
                            {
                                "example_id": "14883b8d-3e21-4130-b3b6-aba3623c3e67",
                                "sense_id": "56d64dad-fd68-34f3-a1df-a30447e3cf25",
                                "text": "Je le connais depuis l’affaire Dreyfus !.. il est de pire en pire chaque année !.. chaque mois !.. le plus éhonté forban des mille !.. de toute l’édition !.."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f62d73f6-72ca-42d3-a94d-b2721aa6d080",
                        "source_entry_id": "21fa6264-d5df-3480-aad5-369ace6b59f1",
                        "target_lang_word": "pirate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pirate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "429decd8-b0ac-31ec-86d3-da0cc6c32afa",
                                        "entry_id": "c8362020-9727-3f8a-aa48-d4247d39654a",
                                        "glosses": [
                                            "A criminal who plunders at sea; commonly attacking merchant vessels, though often pillaging port towns."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff123c32-82a9-4c9b-a686-b66770e0518b",
                                                "sense_id": "429decd8-b0ac-31ec-86d3-da0cc6c32afa",
                                                "text": "You should be cautious due to the Somali pirates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "310ece7d-2131-3a54-9224-31aa35785c66",
                                        "entry_id": "c8362020-9727-3f8a-aa48-d4247d39654a",
                                        "glosses": [
                                            "An armed ship or vessel that sails for the purpose of plundering other vessels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "174759a5-062c-4af6-8b41-96eece513547",
                                                "sense_id": "310ece7d-2131-3a54-9224-31aa35785c66",
                                                "text": "The third day out a pirate (Terebinthian by her rig) overhauled us, but when she saw us well armed she stood off after some shooting of arrows on either part—"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29286524-3f06-34ef-9f5b-e133684bbf65",
                                        "entry_id": "c8362020-9727-3f8a-aa48-d4247d39654a",
                                        "glosses": [
                                            "One who breaks intellectual property laws by reproducing protected works without permission."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca181e5c-50a7-49e2-9d64-3a6ba1f53b95",
                                                "sense_id": "29286524-3f06-34ef-9f5b-e133684bbf65",
                                                "text": "And Gnutella, Freenet and other pirate tools will offer plunderings beyond Fanning's fantasies."
                                            },
                                            {
                                                "example_id": "3166d9b1-a774-49a4-845d-8ef6e2e17a84",
                                                "sense_id": "29286524-3f06-34ef-9f5b-e133684bbf65",
                                                "text": "They had watches that said Gucci or Rolex on them even though it was obvious they'd come straight here from some pirate factory in China."
                                            },
                                            {
                                                "example_id": "bd82a58b-6094-4f97-89f4-541dde0fb2ad",
                                                "sense_id": "29286524-3f06-34ef-9f5b-e133684bbf65",
                                                "text": "If we untangle the claim that technology has turned Johnny Teenager into a pirate, what turns out to be fueling it is the idea that if Johnny Teenager were to share his unauthorized copy with two million of his closest friends the effect on a record company would be pretty similar to the effect of some CD factory's creating two million CDs and selling them cheap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85c5a8c5-b77c-32ea-98c3-b3255c2a597e",
                                        "entry_id": "c8362020-9727-3f8a-aa48-d4247d39654a",
                                        "glosses": [
                                            "A bird which practises kleptoparasitism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec235aab-382f-39ec-81df-749e29eccefa",
                                        "entry_id": "c8362020-9727-3f8a-aa48-d4247d39654a",
                                        "glosses": [
                                            "A kind of marble in children's games."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bf7305b-e854-4762-aa43-c9196720947d",
                                                "sense_id": "ec235aab-382f-39ec-81df-749e29eccefa",
                                                "text": "Most of the time it went fine; some of his classmates had so many marbles they could have opened up their own shop in smurfs, pirates, purple aggies and pink panthers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pirate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11fcc649-11f7-3f20-a64c-2f8a93bed26c",
                                        "entry_id": "79f7aa55-01dd-3f41-ae05-b820179d34a2",
                                        "glosses": [
                                            "To appropriate by piracy; to plunder at sea."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc229762-3840-4817-8407-817456d16f53",
                                                "sense_id": "11fcc649-11f7-3f20-a64c-2f8a93bed26c",
                                                "text": "They pirated the tanker and sailed to a port where they could sell the ship and cargo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a371b309-6838-3b7a-95c6-ac28f1a960fc",
                                        "entry_id": "79f7aa55-01dd-3f41-ae05-b820179d34a2",
                                        "glosses": [
                                            "To create and/or sell an unauthorized copy of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98ebf0a4-668e-4c33-a9df-5e99e9858ed9",
                                                "sense_id": "a371b309-6838-3b7a-95c6-ac28f1a960fc",
                                                "text": "If a book is pirated there is a remedy for the author and publisher; if a photograph or an engraving is made of a picture without permission the law protects the painter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ff74686-0bff-3657-9d05-754da8974baa",
                                        "entry_id": "79f7aa55-01dd-3f41-ae05-b820179d34a2",
                                        "glosses": [
                                            "To knowingly obtain an unauthorized copy of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73860e59-cea5-4c7a-b783-4f1dcb6d6a62",
                                                "sense_id": "3ff74686-0bff-3657-9d05-754da8974baa",
                                                "text": "Not willing to pay full price for the computer game, Heidi pirated a copy."
                                            },
                                            {
                                                "example_id": "b79e69df-f913-4998-8cca-8f705b12f2b3",
                                                "sense_id": "3ff74686-0bff-3657-9d05-754da8974baa",
                                                "text": "In the 1970s cable companies began to pirate some of the football games that the networks had contracted to televise."
                                            },
                                            {
                                                "example_id": "a99845af-4735-4e5c-85e0-6f3c77f85025",
                                                "sense_id": "3ff74686-0bff-3657-9d05-754da8974baa",
                                                "text": "College students, with their limited budgets, often pirate software to save their money for buying more important items (like beer)."
                                            },
                                            {
                                                "example_id": "353c1651-0b9f-42fc-8751-a4f7d8d259bc",
                                                "sense_id": "3ff74686-0bff-3657-9d05-754da8974baa",
                                                "text": "Many college students now expect to sample, if not outright pirate, movies, music, software, and TV programs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c172392b-ee8e-3afa-9588-8c6bf44c9e06",
                                        "entry_id": "79f7aa55-01dd-3f41-ae05-b820179d34a2",
                                        "glosses": [
                                            "To engage in piracy."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1262f2d-e4d8-416e-8593-37b5518a9399",
                                                "sense_id": "c172392b-ee8e-3afa-9588-8c6bf44c9e06",
                                                "text": "He pirated in the Atlantic for years before becoming a privateer for the Queen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67786b5f-363d-3d5a-8e33-2c5e64ab4b91",
                                        "entry_id": "79f7aa55-01dd-3f41-ae05-b820179d34a2",
                                        "glosses": [
                                            "To entice an employee to switch from a competing company to one's own."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pirate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "261a1eaf-5397-39fe-aa96-5d0a3372cf55",
