{
    "word_family": [
        "mob",
        "mobster"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "25d89b56-a051-3e5f-b528-d23b960ef1f6",
                    "sense_definition": "simple past and past participle of <w>mob</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous actor was <w>mobbed</w> by fans as soon as he left the building.",
                            "target_lang_translations": {
                                "nl": "De beroemde acteur werd <w>bestormd</w> door fans zodra hij het gebouw verliet."
                            }
                        },
                        {
                            "text": "Reporters <w>mobbed</w> the politician to ask questions about the new law.",
                            "target_lang_translations": {
                                "nl": "Verslaggevers <w>bestormden</w> de politicus om vragen te stellen over de nieuwe wet."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De verleden tijd en voltooid deelwoord van 'mobben', wat betekent dat een grote groep mensen zich om iemand heen verzamelt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bestormd",
                                "target_lang_sense_clarification": "omringd door een enthousiaste of opdringerige menigte"
                            },
                            {
                                "target_lang_word": "omringd",
                                "target_lang_sense_clarification": "door een grote groep mensen omsingeld"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "96526706-7da9-3972-9802-5786c5635d6f",
                    "sense_definition": "Very crowded with people.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "crowded",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The subway station was completely <w>mobbed</w> during the morning rush hour.",
                            "target_lang_translations": {
                                "nl": "Het metrostation was tijdens de ochtendspits volledig <w>overvol</w>."
                            }
                        },
                        {
                            "text": "We could not find a seat because the train was <w>mobbed</w>.",
                            "target_lang_translations": {
                                "nl": "We konden geen zitplaats vinden omdat de trein <w>stampvol</w> zat."
                            }
                        }
                    ],
                    "synonyms": [
                        "packed",
                        "jammed",
                        "crowded"
                    ],
                    "antonyms": [
                        "empty"
                    ],
                    "common_phrases": [
                        "completely mobbed"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Zeer druk bezet met mensen; overvol."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "overvol",
                                "target_lang_sense_clarification": "zo vol dat er nauwelijks ruimte is"
                            },
                            {
                                "target_lang_word": "stampvol",
                                "target_lang_sense_clarification": "zeer druk, informeel"
                            }
                        ]
                    }
                }
            ]
        }
    ]
