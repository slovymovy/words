                    }
                ],
                "senses": [
                    {
                        "sense_id": "bddf712b-faca-3bb8-98b6-ca0d2d12d24f",
                        "entry_id": "d77adb29-9efd-3733-adc7-8bd948864747",
                        "glosses": [
                            "Sein, das rein aus sich besteht, von nichts abhängt und in sich selbst ruht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb77bffb-6883-4a3c-acbf-170b68de93de",
                                "sense_id": "bddf712b-faca-3bb8-98b6-ca0d2d12d24f",
                                "text": "„Das Universum enthalte nichts Absolutes, weil dies nur in Gott sein könne. Demzufolge hat die Welt weder eine Mitte, noch eine äußere Begrenzung, und außer Gott gebe es nichts Ruhendes.“"
                            },
                            {
                                "example_id": "c586e533-842c-44c2-982f-792825a5bbdb",
                                "sense_id": "bddf712b-faca-3bb8-98b6-ca0d2d12d24f",
                                "text": "„Da ferner alles Weltliche vom Absoluten unendlich weit entfernt ist, existiert keine Rangfolge einzelner Weltbereiche und die Erde ist nicht zwangsläufig der niedrigste Weltbereich im Sinne eines wertenden Oben und Unten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fb75121-d72c-44c8-a086-80e6821d28e6",
                        "source_entry_id": "d77adb29-9efd-3733-adc7-8bd948864747",
                        "source_sense_id": "bddf712b-faca-3bb8-98b6-ca0d2d12d24f",
                        "source_sense_description": "Sein, das rein aus sich besteht, von nichts abhängt und in sich selbst ruht",
                        "target_lang_word": "Absolute",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Absolute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f967e64-7983-3f99-823c-04419eb16eae",
                                        "entry_id": "fdc902e6-67fb-38d1-af43-26d4b142b77d",
                                        "glosses": [
                                            "That which is totally unconditioned, unrestricted, pure, perfect, or complete; that which can be thought of without relation to others."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44d1561d-5591-4624-97f5-c0c0ffcbe54a",
                        "source_entry_id": "d77adb29-9efd-3733-adc7-8bd948864747",
                        "source_sense_id": "bddf712b-faca-3bb8-98b6-ca0d2d12d24f",
                        "source_sense_description": "Sein, das rein aus sich besteht, von nichts abhängt und in sich selbst ruht",
                        "target_lang_word": "absolu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absolu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3b129eb-317c-3c67-abf8-13485bd72a78",
                                        "entry_id": "df62443f-7ba4-3c00-b839-b28f03365e24",
                                        "glosses": [
                                            "Complet ; sans restriction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2edb1433-323c-4ca2-b0c5-ba0c61896aec",
                                                "sense_id": "f3b129eb-317c-3c67-abf8-13485bd72a78",
                                                "text": "C’est dire que nos banques devraient cesser de vivre sous l’empire d’un monopole aussi absolu qu’injuste et funeste."
                                            },
                                            {
                                                "example_id": "1ee221b1-db24-4b19-9bb9-6b4d2df76f09",
                                                "sense_id": "f3b129eb-317c-3c67-abf8-13485bd72a78",
                                                "text": "L’emploi de moulures a le grand avantage de permettre la suppression absolue des clous cavaliers ordinairement employés pour fixer les fils."
                                            },
                                            {
                                                "example_id": "feab4371-51e3-45df-aea4-853d82239370",
                                                "sense_id": "f3b129eb-317c-3c67-abf8-13485bd72a78",
                                                "text": "Le droit de justice des seigneurs hauts justiciers était absolu. Il emportait la plénitude de la juridiction civile et criminelle, limitée seulement par les cas royaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb9e7f92-dd98-3579-a5ad-9769dab21d36",
                                        "entry_id": "df62443f-7ba4-3c00-b839-b28f03365e24",
                                        "glosses": [
                                            "Qui a le pouvoir absolu ; qui est souverain, sans contrôle, en parlant d’une autorité, d’un État."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05374115-b5b7-48d9-bcd7-03c64ac5aedf",
                                                "sense_id": "bb9e7f92-dd98-3579-a5ad-9769dab21d36",
                                                "text": "Et même au bled el-makhzen, où le Sultan règne en autocrate absolu, les révoltes contre son autorité ne sont pas rares."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4391147-52c4-364c-a2cb-62e36461074a",
                                        "entry_id": "df62443f-7ba4-3c00-b839-b28f03365e24",
                                        "glosses": [
                                            "Impérieux ; entier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cc10fbd-5280-4ca3-b721-5ceda2463202",
                                                "sense_id": "b4391147-52c4-364c-a2cb-62e36461074a",
                                                "text": "[…] et ils savent combiner, dans leurs discours pompeux, fougueux et nébuleux, l’intransigeance la plus absolue avec l’op­portunisme le plus souple."
                                            },
                                            {
                                                "example_id": "0ed98b43-ce84-433e-b7d1-2026342fb9d7",
                                                "sense_id": "b4391147-52c4-364c-a2cb-62e36461074a",
                                                "text": "Cet homme est absolu dans tout ce qu’il veut."
                                            },
                                            {
                                                "example_id": "2cc7b87f-eb64-48bd-9bbb-4a17137cb593",
                                                "sense_id": "b4391147-52c4-364c-a2cb-62e36461074a",
                                                "text": "Parler d’un ton absolu."
                                            },
                                            {
                                                "example_id": "6433c2cb-901d-4dbf-9c38-2ab222b0112a",
                                                "sense_id": "b4391147-52c4-364c-a2cb-62e36461074a",
                                                "text": "Un caractère absolu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02eab67d-28ff-392c-8512-29b903929846",
                                        "entry_id": "df62443f-7ba4-3c00-b839-b28f03365e24",
                                        "glosses": [
                                            "Total, sans exception."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a6fa15c-26d3-41e6-a998-82b1ae380261",
                                                "sense_id": "02eab67d-28ff-392c-8512-29b903929846",
                                                "text": "Une impossibilité absolue."
                                            },
                                            {
                                                "example_id": "b7f6365b-0ca1-4fc4-babc-fdf46f8a7ffa",
                                                "sense_id": "02eab67d-28ff-392c-8512-29b903929846",
                                                "text": "Il y a peu de vérités absolues."
                                            },
                                            {
                                                "example_id": "9c3f0d9e-c8f4-4dc5-9a7b-f2185de4f8f9",
                                                "sense_id": "02eab67d-28ff-392c-8512-29b903929846",
                                                "text": "C’est le calme absolu."
                                            },
                                            {
                                                "example_id": "788c3d60-2a90-4bdf-a408-8cae5f3707c5",
                                                "sense_id": "02eab67d-28ff-392c-8512-29b903929846",
                                                "text": "« En plaçant le principe de l’autonomie au cœur de son projet politique, la CAQ s’inscrit dans une lignée qui, au cours de l’histoire, a fait de la défense des intérêts vitaux du Québec une priorité absolue. »\n « Absolue » : vous avez bien lu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ab92d2d-d108-328a-b7f3-6f2e500f0647",
                                        "entry_id": "df62443f-7ba4-3c00-b839-b28f03365e24",
                                        "glosses": [
                                            "Pur, en parlant d’un alcool."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c94defb-2447-382f-9969-2a8dd0526796",
                                        "entry_id": "df62443f-7ba4-3c00-b839-b28f03365e24",
                                        "glosses": [
                                            "Qui n’est pas relatif, qui fait sens par lui-même et non par rapport à quelque chose."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8267fd04-a5a5-4ce6-910a-3c6396e33ac6",
                                                "sense_id": "9c94defb-2447-382f-9969-2a8dd0526796",
                                                "text": "Il serait toutefois désirable que le constructeur étalonnât chaque instrument avec un pyrhéliomètre donnant des valeurs absolues."
                                            },
                                            {
                                                "example_id": "bf34d4fa-b7de-4ab6-9bd4-57b1a4a39c2f",
                                                "sense_id": "9c94defb-2447-382f-9969-2a8dd0526796",
                                                "text": "« Homme » est un terme absolu, « père » est un terme relatif."
                                            },
                                            {
                                                "example_id": "43f54be4-421d-4464-97a5-d7fa0a375821",
                                                "sense_id": "9c94defb-2447-382f-9969-2a8dd0526796",
                                                "text": "Le zéro absolu est la température théorique la plus basse pouvant exister ; il vaut environ -273.15 degrés Celsius."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10020192-ba08-3c5f-b489-dfd90785a40f",
                                        "entry_id": "df62443f-7ba4-3c00-b839-b28f03365e24",
                                        "glosses": [
                                            "Dans lequel le complément habituel ou logique est absent, en parlant de l’emploi d’un verbe ou d’un nom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9b5c477-6c3e-464b-9bb1-b2f0ff877341",
                                                "sense_id": "10020192-ba08-3c5f-b489-dfd90785a40f",
                                                "text": "Dans « il mange bien, il boit bien », « mange » et « boit » sont d’un emploi absolu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80e3a3ad-e36e-3772-b5e9-6fb6cbb5ba84",
                                        "entry_id": "df62443f-7ba4-3c00-b839-b28f03365e24",
                                        "glosses": [
                                            "Qui n’est régi par aucun mot exprimé dans la proposition, en parlant d’un ablatif ou d’un génitif."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9aef44cc-9005-3507-a4b8-fa95d0afcd03",
                                        "entry_id": "df62443f-7ba4-3c00-b839-b28f03365e24",
                                        "glosses": [
                                            "Qui est indépendant de tout repère conventionnel."
                                        ],
                                        "tags": [
                                            "Cosmologie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd9cf65f-253c-3615-90cd-b55d4a2d4b21",
                                        "entry_id": "df62443f-7ba4-3c00-b839-b28f03365e24",
                                        "glosses": [
                                            "Groupe ayant pour visée le renouveau du genre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6df2b3d1-de8d-3fed-902e-b585bfa85b4b",
                                        "entry_id": "df62443f-7ba4-3c00-b839-b28f03365e24",
                                        "glosses": [
                                            "Qui a en soi sa raison d’être et qui n’a besoin ni pour être conçu ni pour exister d’aucune autre chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d1639f9-7624-418d-b53c-7cd06fa3523a",
                                                "sense_id": "6df2b3d1-de8d-3fed-902e-b585bfa85b4b",
                                                "text": "L’Être absolu de qui tout dépend, c’est à dire à quoi tout autre être est relatif : Dieu."
                                            },
                                            {
                                                "example_id": "86d50f17-0752-4b21-8c18-cd17ff71fa9d",
                                                "sense_id": "6df2b3d1-de8d-3fed-902e-b585bfa85b4b",
                                                "text": "Autre sens philosophique: est absolu ce qui n’est corrélé à rien d’autre que lui-même pour exister. C’est la thèse de l’archifossile que développe Quentin Meillassoux dans Après la finitude, où il écrit: \"Nous devons saisir comment la pensée peut accéder à un absolu: à un être si bien délié (sens premier d’absolutus), si bien séparé de la pensée, qu’il s’offre à nous comme non-relatif à nous - capable d’exister que nous existions ou non.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "absolu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4afb42f-d985-3c51-8422-3949600fc8fa",
                                        "entry_id": "66b6f3e2-0ee6-3479-8ede-c630219dc5d2",
                                        "glosses": [
                                            "Ce qui existe indépendamment de toute condition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9def6342-ee5f-4048-83a0-e7a4cd529195",
                                                "sense_id": "a4afb42f-d985-3c51-8422-3949600fc8fa",
                                                "text": "L’absolu."
                                            },
                                            {
                                                "example_id": "628d4b66-e921-4454-af1c-1395848804bd",
                                                "sense_id": "a4afb42f-d985-3c51-8422-3949600fc8fa",
                                                "text": "La philosophie de l’absolu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98db3af3-67b5-3bd8-9528-eab278bf44fa",
                                        "entry_id": "66b6f3e2-0ee6-3479-8ede-c630219dc5d2",
                                        "glosses": [
                                            "Substance tirée de la concrète, distillée pour la débarrasser de ses cires végétales, dans le but d’élaborer un parfum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07b524df-6cbb-4594-a253-8df7af5036e6",
                                                "sense_id": "98db3af3-67b5-3bd8-9528-eab278bf44fa",
                                                "text": "Les fleurs récoltées sont versées dans des extracteurs dans lesquels on injecte du solvant. Les fleurs donnent alors toute leur puissance olfactive et, vingt quatre heures après avec l'injection de vapeur, on obtient la concrète, mélange de cire végétale et de produit odorant.[…] Ensuite, l'ensemble est distillé, une opération qui prend environ trois jours, donnant naissance à un absolu."
                                            }
                                        ]
                                    }
