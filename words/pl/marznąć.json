                    "semantic_group_id": "zmiana stanu skupienia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Woda w jeziorze zaczyna <w>marznąć</w>, gdy temperatura spada poniżej zera.",
                            "target_lang_translations": {
                                "en": "The water in the lake begins to <w>freeze</w> when the temperature drops below zero.",
                                "ru": "Вода в озере начинает <w>замерзать</w>, когда температура опускается ниже нуля.",
                                "nl": "Het water in het meer begint te <w>bevriezen</w> wanneer de temperatuur onder nul daalt.",
                                "de": "Das Wasser im See beginnt <w>zuzufrieren</w>, wenn die Temperatur unter null sinkt.",
                                "fr": "L'eau du lac commence à <w>geler</w> lorsque la température descend en dessous de zéro.",
                                "it": "L'acqua del lago comincia a <w>gelare</w> quando la temperatura scende sotto lo zero.",
                                "cs": "Voda v jezeře začíná <w>zamrzat</w>, když teplota klesne pod nulu.",
                                "tr": "Sıcaklık sıfırın altına düştüğünde göldeki su <w>donmaya</w> başlar.",
                                "es": "El agua del lago empieza a <w>congelarse</w> cuando la temperatura baja de cero.",
                                "zh": "当气温降到零度以下时，湖水开始<w>结冰</w>。"
                            }
                        },
                        {
                            "text": "W nocy kałuże na drodze mogą <w>marznąć</w>, co powoduje gołoledź.",
                            "target_lang_translations": {
                                "en": "Puddles on the road can <w>freeze</w> at night, causing black ice.",
                                "ru": "Ночью лужи на дороге могут <w>замерзать</w>, что приводит к гололедице.",
                                "nl": "'s Nachts kunnen plassen op de weg <w>bevriezen</w>, wat ijzel veroorzaakt.",
                                "de": "In der Nacht können die Pfützen auf der Straße <w>gefrieren</w>, was zu Glatteis führt.",
                                "fr": "Pendant la nuit, les flaques sur la route peuvent <w>geler</w>, ce qui provoque du verglas.",
                                "it": "Di notte le pozzanghere sulla strada possono <w>ghiacciare</w>, causando il ghiaccio nero.",
                                "cs": "V noci mohou louže na silnici <w>mrznout</w>, což způsobuje náledí.",
                                "tr": "Gece yoldaki su birikintileri <w>buz tutabilir</w>, bu da gizli buzlanmaya yol açar.",
                                "es": "Por la noche los charcos de la carretera pueden <w>helarse</w>, lo que provoca placas de hielo.",
                                "zh": "夜间路面的积水可能会<w>结冰</w>，从而导致路面结暗冰。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
