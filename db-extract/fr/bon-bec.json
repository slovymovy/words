                        "examples": [
                            {
                                "example_id": "9aec53f8-ec3c-44ac-b3e9-48b695b3ad0f",
                                "sense_id": "f334fc3e-234f-338c-9a4c-9aa17fe60a4f",
                                "text": "Attention, c’est un bon-bec; il ne se laissera pas faire !"
                            },
                            {
                                "example_id": "1f6ace09-7c0f-4627-b32b-aef914da49c7",
                                "sense_id": "f334fc3e-234f-338c-9a4c-9aa17fe60a4f",
                                "text": "MONTPELLIER – Nulle part la vraie Française hardie, caquet bon bec, mais pimpante, à jolie tournure, à démarche alerte et rythmée, n’apparaît mieux qu’ici."
                            },
                            {
                                "example_id": "1acb1541-c1fb-450c-a570-805dde382b51",
                                "sense_id": "f334fc3e-234f-338c-9a4c-9aa17fe60a4f",
                                "text": "Ah ! Monsieur Florestan !\nÀ nous deux maintenant !\nEntre nous, c'est la guerre !\nEt bientôt je l'espère\nJe vous le prouverai tout sec !\nLa petite dinde a bon bec !"
                            },
                            {
                                "example_id": "b17c0fd6-878a-40e4-a01e-433588e4adfc",
                                "sense_id": "f334fc3e-234f-338c-9a4c-9aa17fe60a4f",
                                "text": "Je ris, je ne réponds à madame bon bec. Elle a raison, l’enfant !… Elle a tort de le dire. Mais une femme ne cèle que ce qu’elle ne sait pas."
                            }
                        ]
                    }
