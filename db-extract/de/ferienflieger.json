                ],
                "senses": [
                    {
                        "sense_id": "552e3da7-4758-3b97-8608-1c80e5427a90",
                        "entry_id": "5a3ec6d8-24fe-3fd9-b87a-7a15d6bbce62",
                        "glosses": [
                            "Flugzeug, dessen Ziel ein typisches Urlaubsland ist"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "fab6a374-c036-45b2-ab12-1cdaac1d05f1",
                                "sense_id": "552e3da7-4758-3b97-8608-1c80e5427a90",
                                "text": "„Weil ein tobender Fluggast sich nicht beruhigte, ist ein Ferienflieger auf dem Weg von den Kanaren nach Frankfurt außerplanmäßig in Portugal gelandet.“"
                            },
                            {
                                "example_id": "dd9b5f68-ad46-4672-bd2d-d5af2cc54df2",
                                "sense_id": "552e3da7-4758-3b97-8608-1c80e5427a90",
                                "text": "„Wegen zweier betrunkener Frauen ist ein kanadischer Ferienflieger auf dem Weg nach Kuba in Begleitung von Kampfjets zum Umkehren gezwungen worden.“"
                            },
                            {
                                "example_id": "1f660b64-cd1d-47e7-9c42-ffc6148207e0",
                                "sense_id": "552e3da7-4758-3b97-8608-1c80e5427a90",
                                "text": "„In Düsseldorf konnte ein Ferienflieger der Chartergesellschaft Condor Richtung Marokko nicht starten.“"
                            },
                            {
                                "example_id": "df10ba4d-8a68-4224-9ccb-c2a2e1756891",
                                "sense_id": "552e3da7-4758-3b97-8608-1c80e5427a90",
                                "text": "„Die Regierung in Kairo will eine Woche nach dem Absturz des russischen Ferienfliegers keine offiziellen Ermittlungsergebnisse nennen.“"
                            },
                            {
                                "example_id": "5d76c9d2-d86c-4a0e-b8f6-fa5f9ca3a5b9",
                                "sense_id": "552e3da7-4758-3b97-8608-1c80e5427a90",
                                "text": "„Anfang der 1970er- Jahre gab es mehr als 30 Charterfluggesellschaften und in der Hochsaison startete alle neun Minuten ein Ferienflieger von einem deutschen Flughafen in Richtung Mittelmeer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8f885c35-5141-306f-ba3f-a0271f1ec2ea",
                        "entry_id": "5a3ec6d8-24fe-3fd9-b87a-7a15d6bbce62",
                        "glosses": [
                            "Fluggesellschaft, deren Ziele typische Urlaubsländer sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1435c174-dcd6-477c-95ee-b5bdf2f53691",
                                "sense_id": "8f885c35-5141-306f-ba3f-a0271f1ec2ea",
                                "text": "„Wegen der ungewissen Zukunft der insolventen Air Berlin arbeitet der Ferienflieger TUIfly an einem Sparpaket.“"
                            },
                            {
                                "example_id": "d99c89a2-1e69-4c30-b302-5edb3b4947e3",
                                "sense_id": "8f885c35-5141-306f-ba3f-a0271f1ec2ea",
                                "text": "„Strittig ist, ob die Condor ein Ferienflieger im herkömmlichen Sinne oder eine Low-Cost-Airline ist – zumindest ihre Wettbewerber sind in beiden Segmenten zu finden.“"
                            },
                            {
                                "example_id": "9c978609-6575-4e32-9426-e46e3efc9767",
                                "sense_id": "8f885c35-5141-306f-ba3f-a0271f1ec2ea",
                                "text": "„Die Charterfluggesellschaft Condor [ist ü]ber die Jahre hinweg ist […] zum größten Ferienflieger der Welt herangewachsen und steuert ca. 70 verschiedene Destinationen an.“"
                            },
                            {
                                "example_id": "02bbee9b-9721-440a-8d7a-42107680eb62",
                                "sense_id": "8f885c35-5141-306f-ba3f-a0271f1ec2ea",
                                "text": "„Treffen dürften die Anadolu-Jet-Pläne eher die deutschen (und türkischen) Ferienflieger wie Condor, Air Berlin, TUIfly oder Pegasus, die Verbindungen in die Türkei anbieten und sowieso schon in Teilen des Marktes über Überkapazitäten klagen.“"
                            },
                            {
                                "example_id": "5033cb48-fe29-4ff3-8571-f2e618c5e91f",
                                "sense_id": "8f885c35-5141-306f-ba3f-a0271f1ec2ea",
                                "text": "„In Düsseldorf sollten gar keine Start- und Landerechte mehr bei dem österreichischen Ferienflieger bleiben, in Palma de Mallorca nur einige wenige, erläuterte der Chef des grössten Luftverkehrskonzerns Europas auf Nachfrage.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
