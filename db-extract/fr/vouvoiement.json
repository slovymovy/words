                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4467ad00-1200-44eb-9b6e-18819831b317",
                        "entry_id": "369c7f21-1579-3a59-b122-2c5812eda627",
                        "tags": [
                            "plural"
                        ],
                        "form": "vouvoiements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f21ac455-f986-3ba6-96a5-ffe7021e6535",
                        "entry_id": "369c7f21-1579-3a59-b122-2c5812eda627",
                        "glosses": [
                            "Manière de s’adresser à quelqu’un en marquant du respect, en utilisant le pronom vous au lieu de tu pour le tutoiement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42e3152a-ad19-4a81-b8fd-c92155575489",
                                "sense_id": "f21ac455-f986-3ba6-96a5-ffe7021e6535",
                                "text": "Le patois, comme nous y avons déjà fait allusion dans la morphologie, ne semble pas connaître le vouvoiement."
                            },
                            {
                                "example_id": "a9f954ef-4eb4-479d-b5b4-92ae4d8b3bf2",
                                "sense_id": "f21ac455-f986-3ba6-96a5-ffe7021e6535",
                                "text": "On notera cependant que si les gens qui s’abordent dans les concerts de métal se tutoient spontanément, dans d’autres types de concert rock, le vouvoiement est majoritaire entre personnes inconnues."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddda5ee5-ef94-4b5e-8fe5-019c93db9cf3",
                        "source_entry_id": "369c7f21-1579-3a59-b122-2c5812eda627",
                        "source_sense_id": "f21ac455-f986-3ba6-96a5-ffe7021e6535",
                        "target_lang_word": "Siezen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Siezen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce92912d-54d3-3529-84f3-dda6208176bb",
                                        "entry_id": "6b5e7648-1b73-33e6-b01a-ea83611f79aa",
                                        "glosses": [
                                            "diejenige der Anredeformen, bei der die gemeinte Person mit dem Anredepronomen Sie angesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8142601-11db-44dc-a693-67e845db24fc",
                                                "sense_id": "ce92912d-54d3-3529-84f3-dda6208176bb",
                                                "text": "„Eine erhebliche Rolle spielt dabei neben dem Anredepronomen (du/Sie) und der Verbform eine Gruppe von personenbezeichnenden Substantiven oder Nominalgruppen, die als Anredeformeln verwendbar sind, vor allem Herr/Frau und der Nachname beim Siezen, der Vorname beim Duzen.“"
                                            },
                                            {
                                                "example_id": "20336589-e9d1-4eb9-9aa9-e50752daba16",
                                                "sense_id": "ce92912d-54d3-3529-84f3-dda6208176bb",
                                                "text": "„Nun hat zwar das Duzen und Siezen kleineres Kaliber, aber es gehört doch irgendwie in den erwähnten Zusammenhang.“"
                                            },
                                            {
                                                "example_id": "3dd54c0c-fd5a-419b-b1a7-1a8584429d86",
                                                "sense_id": "ce92912d-54d3-3529-84f3-dda6208176bb",
                                                "text": "„Seit wir Anfang der 1990er Jahre dieses Land verlassen haben, ist das Siezen aus der Mode gekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f0f9e37-dc56-4db8-9603-70a352ae5c82",
                        "source_entry_id": "369c7f21-1579-3a59-b122-2c5812eda627",
                        "source_sense_id": "f21ac455-f986-3ba6-96a5-ffe7021e6535",
                        "target_lang_word": "V use",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "19937b17-8f6b-47e2-9da3-3b1abcbddad0",
                        "source_entry_id": "369c7f21-1579-3a59-b122-2c5812eda627",
                        "source_sense_id": "f21ac455-f986-3ba6-96a5-ffe7021e6535",
