{
    "word_family": [
        "baan",
        "baanbrekend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "404dc0aa-3d48-35d0-b565-8ab79dad7122",
                    "sense_definition": "Een weg vrijmaken of een pad creëren door een hindernis heen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>baande</w> een weg door het hoge gras.",
                            "target_lang_translations": {
                                "it": "Si è <w>aperto un varco</w> attraverso l'erba alta."
                            }
                        },
                        {
                            "text": "De sneeuwschuiver <w>baande</w> een pad voor de auto's.",
                            "target_lang_translations": {
                                "it": "Lo spazzaneve ha <w>aperto un passaggio</w> per le auto."
                            }
                        }
                    ],
                    "synonyms": [
                        "effenen",
                        "vlakmaken"
                    ],
                    "common_phrases": [
                        "een weg banen"
                    ],
                    "target_lang_definitions": {
                        "it": "Liberare un passaggio o creare un sentiero attraverso un ostacolo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "aprire",
                                "target_lang_sense_clarification": "nel senso di creare un varco o una strada"
                            },
                            {
                                "target_lang_word": "spianare",
                                "target_lang_sense_clarification": "nel senso di rendere libero un percorso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35050786-5c21-3369-865b-a16212247a41",
                    "sense_definition": "Zich met moeite of vastberadenheid een doorgang forceren door een menigte of obstakel.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft <w>zich</w> een weg door het oerwoud <w>gebaand</w>.",
                            "target_lang_translations": {
                                "it": "Si è <w>fatto strada</w> attraverso la giungla."
                            }
                        },
                        {
                            "text": "Zij <w>baande</w> <w>zich</w> een weg door de drukke menigte op het station.",
                            "target_lang_translations": {
                                "it": "Si è <w>fatta strada</w> tra la folla affollata alla stazione."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich een weg banen"
                    ],
                    "target_lang_definitions": {
                        "it": "Farsi strada con fatica o determinazione attraverso una folla o un ostacolo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "farsi strada",
                                "target_lang_sense_clarification": "espressione idiomatica per avanzare con difficoltà"
                            },
                            {
                                "target_lang_word": "aprirsi un varco",
                                "target_lang_sense_clarification": "creare un passaggio forzato attraverso qualcosa"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63a0b6d1-2b34-33f0-82ab-f527fd2efff1",
                    "sense_definition": "Meervoud van <w>baan</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "werk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zijn tegenwoordig veel nieuwe <w>banen</w> in de techniek.",
                            "target_lang_translations": {
                                "it": "Oggi ci sono molti nuovi <w>lavori</w> nel settore tecnico."
                            }
                        },
                        {
                            "text": "Veel mensen zoeken naar betere <w>banen</w> met een hoger salaris.",
                            "target_lang_translations": {
                                "it": "Molte persone cercano <w>impieghi</w> migliori con uno stipendio più alto."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Plurale di 'baan' (lavoro, impiego, occupazione)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "lavori",
                                "target_lang_sense_clarification": "riferito a occupazioni professionali"
                            },
                            {
                                "target_lang_word": "impieghi",
                                "target_lang_sense_clarification": "riferito a posizioni lavorative"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}