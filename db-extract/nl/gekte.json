                "senses": [
                    {
                        "sense_id": "66425d2f-3e99-3db8-a21a-7cd64a89d432",
                        "entry_id": "2306ff6e-5034-354d-be0a-e0054a2b8318",
                        "glosses": [
                            "het gek (maar niet totaal gestoord) zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4296e2e-3f51-411a-9169-c4eceff7f139",
                                "sense_id": "66425d2f-3e99-3db8-a21a-7cd64a89d432",
                                "text": "Een milde vorm van gekte."
                            },
                            {
                                "example_id": "c577baee-e2dc-467e-8602-d9c8f13ce547",
                                "sense_id": "66425d2f-3e99-3db8-a21a-7cd64a89d432",
                                "text": "Ik kon mij voorstellen dat haar poëzie compromisloos experimenteel zou zijn, en van een aantrekkelijke eenzelvige gekte, die in feite een getormenteerde en door geen criticus begrepen verschijningsvorm was van passie die woedde als een uitslaande brand."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b518ce5-98bf-38b5-a3cd-99767a037f4f",
                        "entry_id": "2306ff6e-5034-354d-be0a-e0054a2b8318",
                        "glosses": [
                            "overdreven drukte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b72b771-e1b8-44f2-8d2b-842541b6d60e",
                                "sense_id": "6b518ce5-98bf-38b5-a3cd-99767a037f4f",
                                "text": "Toch was mijn hang naar vrijheid te groot geworden en de avond voor mijn vertrek nam ik Barbie, Pogue en Goldie even apart om afscheid te nemen. De volgende ochtend verliet ik in alle vroegte de gekte in Kennedy Meadows."
                            }
                        ]
                    }
                ],
