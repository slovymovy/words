                                        "entry_id": "e66db1d1-bd72-3c75-a297-9573ebabb225",
                                        "glosses": [
                                            "To build (a sentence, an argument, etc.) by arranging words or ideas."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aa1d363-66c7-47eb-b757-790766f4adee",
                                                "sense_id": "5f7d1a3b-8dbc-31f8-a868-b1f0c13595a3",
                                                "text": "A sentence may be constructed with a subject, verb and object."
                                            },
                                            {
                                                "example_id": "ef8dc6e8-0e0d-41c2-88fd-c5108c420e17",
                                                "sense_id": "5f7d1a3b-8dbc-31f8-a868-b1f0c13595a3",
                                                "text": "The Vietnam War films are forms of memory that function to provide collective rememberings, to construct history, and to subsume within them the experience of the veterans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdd142fc-a42c-3b62-aeec-a997428579a4",
                                        "entry_id": "e66db1d1-bd72-3c75-a297-9573ebabb225",
                                        "glosses": [
                                            "To draw (a geometric figure) by following precise specifications and using geometric tools and techniques."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
