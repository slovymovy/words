                "senses": [
                    {
                        "sense_id": "01c8f630-ccb2-3090-bb8c-568946bfa5d6",
                        "entry_id": "e00cd4a7-a9bc-3542-98fa-5cf2d97d0ef9",
                        "glosses": [
                            "Person, die Brunnen gräbt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e809d4f-4000-434f-bfb1-317fe8acd1aa",
                                "sense_id": "01c8f630-ccb2-3090-bb8c-568946bfa5d6",
                                "text": "„Sie verlangte nur zehn Cent, aber das Ziel ihrer heutigen Bemühungen, der kräftige, hasenschartige Rufus Hutchins, Sohn eines alkoholkranken Brunnengräbers namens Elam, machte ein alternatives Angebot.“"
                            },
                            {
                                "example_id": "a239c1d7-b633-440e-8181-d12579d4bb35",
                                "sense_id": "01c8f630-ccb2-3090-bb8c-568946bfa5d6",
                                "text": "„Man war sich einig, dass es an seinem Todestag kalt war. Heute sogar noch kälter. Kälter wie der Arsch von'nem Brunnengräber, sagte einer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
