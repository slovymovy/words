                    {
                        "sense_id": "ba6cd958-40e6-38c4-aeed-ef61385ba439",
                        "entry_id": "1054485e-6469-3815-8567-6a7c25800d43",
                        "glosses": [
                            "Celle qui n’a pas reçu d’initiation à une religion, une science ou tout autre savoir."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "61a63e46-7c65-414b-98fb-099b0fe77110",
                                "sense_id": "ba6cd958-40e6-38c4-aeed-ef61385ba439",
                                "text": "On rappelle donc à la jeune fille ce qui suit : « avoir de bonnes manières et ne plus se conduire comme une non-initiée, ne pas répondre aux gens qui la hèlent sur le chemin, respecter les personnes, […]."
                            },
                            {
                                "example_id": "bc70c315-b039-4bce-9a23-79b0146b02bf",
                                "sense_id": "ba6cd958-40e6-38c4-aeed-ef61385ba439",
                                "text": "Les deux groupes participent ainsi à l'entretien d'une relation de secret dissimulé, entre les initiateurs et les novices d'une part, et les non-initiées d'autre part, relation qui a pour objet l'oiseau Mokumo."
                            }
                        ]
                    }
