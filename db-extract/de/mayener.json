                    {
                        "sense_id": "0fcdeaf1-2ba6-3df5-8446-ffe506f9cf7d",
                        "entry_id": "5c1fc0d2-0192-3900-82f8-912f2561df8d",
                        "glosses": [
                            "zur Stadt Mayen gehörig, auf Mayen bezogen, aus Mayen stammend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea7c2e5-15cd-42ed-b8fa-26b0957417da",
                                "sense_id": "0fcdeaf1-2ba6-3df5-8446-ffe506f9cf7d",
                                "text": "„Im Rahmen der Kennzeichenliberalisierung stimmte der Mayener Stadtrat am 12. Dezember 2012 einstimmig für die Wiedereinführung des Kfz-Kennzeichens MY, was am 18. März 2013 durch den Kreistag bestätigt wurde.“"
                            },
                            {
                                "example_id": "07221ff7-ad23-4bcf-89ee-7510de3695cb",
                                "sense_id": "0fcdeaf1-2ba6-3df5-8446-ffe506f9cf7d",
                                "text": "Dieser Tonkrug besteht aus Mayener Ware."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
