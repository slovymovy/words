                    }
                ],
                "senses": [
                    {
                        "sense_id": "8efd955a-c7c5-3d4c-868f-3b14a32cdeaf",
                        "entry_id": "a9ceffdf-b157-3ae8-a760-bfe9e37815b5",
                        "glosses": [
                            "Petite cuve."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed0ba5aa-6555-4e4e-aae0-4c6437d944b6",
                                "sense_id": "8efd955a-c7c5-3d4c-868f-3b14a32cdeaf",
                                "text": "Le treuil doit être rapproché de l’un des bords du puits, dont l’orifice est disposé de manière à ce que les cuveaux pleins puissent être facilement tirés sur le bord."
                            },
                            {
                                "example_id": "9820d436-cabd-4b2e-9918-02fa691168bd",
                                "sense_id": "8efd955a-c7c5-3d4c-868f-3b14a32cdeaf",
                                "text": "Parfois la mère se dressait, bâillant d’indignation, puis replongeait dans son cuveau et frottait avec tant de colère qu’elle se brûlait la peau des mains."
                            },
                            {
                                "example_id": "5a57cdfd-8626-4a7e-b28c-3ac61d63e285",
                                "sense_id": "8efd955a-c7c5-3d4c-868f-3b14a32cdeaf",
                                "text": "Voilà-t-il pas que les tonneaux manquèrent ; et, faute de récipients, on laissa le raisin en cuve, ou bien en cuveau de lessive, sans seulement le pressurer !"
                            },
                            {
                                "example_id": "d084e107-1bc2-4e74-87f3-c6e3fccd62fd",
                                "sense_id": "8efd955a-c7c5-3d4c-868f-3b14a32cdeaf",
                                "text": "Puis, s’avançant d’un air grave, il prit la grande cuiller de bois, qu’il plongea dans le cuveau, et pendant quelques secondes il examina le mélange avec une attention vraiment psychologique."
                            }
                        ]
                    }
                ],
