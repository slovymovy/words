                                                "sense_id": "127832f3-7693-3f1d-a1d0-2b213e396a66",
                                                "text": "Mit solch einem rauen Umgangston wirst du hier nicht weit kommen."
                                            },
                                            {
                                                "example_id": "6a126340-a6ec-48ad-bb19-c604491a1138",
                                                "sense_id": "127832f3-7693-3f1d-a1d0-2b213e396a66",
                                                "text": "Solch ein Auto ist doch viel zu teuer für dich."
                                            },
                                            {
                                                "example_id": "532e4bec-9957-4eea-82c1-6eaa570018c2",
                                                "sense_id": "127832f3-7693-3f1d-a1d0-2b213e396a66",
                                                "text": "Dass ein solcher Vorschlag auf Gegenwind stoßen wird, hätte man ahnen können."
                                            },
                                            {
                                                "example_id": "8db63ebd-9fc6-4110-bd6b-93fc5130add7",
                                                "sense_id": "127832f3-7693-3f1d-a1d0-2b213e396a66",
                                                "text": "Guck mal hier, solchen Stoff brauche ich für den Windschutz."
                                            },
                                            {
                                                "example_id": "91e8958d-1713-4a34-9ed6-054b64e83381",
                                                "sense_id": "127832f3-7693-3f1d-a1d0-2b213e396a66",
                                                "text": "Solche wie die braucht man gar nicht zu fragen, die sagen eh nicht die Wahrheit."
                                            },
                                            {
                                                "example_id": "25d0b523-9477-4fbb-bcda-5710b7de7d9e",
                                                "sense_id": "127832f3-7693-3f1d-a1d0-2b213e396a66",
                                                "text": "Solchem Flehen muss man nachgeben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9d7f3c6-beaf-3138-a336-451e50951929",
