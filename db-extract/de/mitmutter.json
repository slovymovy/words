                ],
                "senses": [
                    {
                        "sense_id": "bbb3deb2-d9ec-347f-9969-fd89ab043905",
                        "entry_id": "322c5471-9ae2-36b0-9537-8314ff7d3dd7",
                        "glosses": [
                            "(rechtlicher und/oder sozialer) nichtgebärender weiblicher Elternteil eines Kindes neben der (gebärenden) Mutter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3c99196-a35f-485b-b130-dbc729e63e40",
                                "sense_id": "bbb3deb2-d9ec-347f-9969-fd89ab043905",
                                "text": "„Das Kind, das während der Ehe oder innerhalb von dreihundert Tagen nach der Auflösung oder Erklärung der Nichtigkeit der Ehe geboren ist, hat die Ehefrau als Mitmutter.“"
                            },
                            {
                                "example_id": "00e02ce6-5353-4d7b-8aff-214d13df50cc",
                                "sense_id": "bbb3deb2-d9ec-347f-9969-fd89ab043905",
                                "text": "„Das heißt, die Mitmutter muss durch Anerkennung der Mutterschaft ihre Elternrolle erhalten können.“"
                            },
                            {
                                "example_id": "28280485-5215-45a1-9a99-b9ee7ab5dfa2",
                                "sense_id": "bbb3deb2-d9ec-347f-9969-fd89ab043905",
                                "text": "„Mit einer rechtlichen Zuordnung des Kindes zur Mitmutter würden die rechtlichen Beziehungen des Kindes zum biologischen Vater aber automatisch gekappt.“"
                            },
                            {
                                "example_id": "a5d09768-8bfd-4545-849f-803793cc0bf6",
                                "sense_id": "bbb3deb2-d9ec-347f-9969-fd89ab043905",
                                "text": "„Dass das Kind als Folge der Adoption theoretisch Unterhaltsansprüchen auch der Mitmutter ausgesetzt sein kann, ist nicht von entscheidender Bedeutung.“"
                            },
                            {
                                "example_id": "2cfb34d4-b349-4c5c-aacf-98ef07f8a59c",
                                "sense_id": "bbb3deb2-d9ec-347f-9969-fd89ab043905",
                                "text": "„Schutzinteressen können insoweit bei nichtehelichen Kindern bestehen, die keinen Erbrechtsanspruch gegen einen Vater oder eine Mitmutter haben.“"
                            },
                            {
                                "example_id": "a53a3c10-f48c-4345-889c-be59b6befbb2",
                                "sense_id": "bbb3deb2-d9ec-347f-9969-fd89ab043905",
                                "text": "„Innerhalb der EU ist Belgien jedoch der einzige Mitgliedstaat, in dem es für die gleichgeschlechtliche Elternschaft genügt, dass die Frauen miteinander verheiratet sind, damit die Ehefrau als Mitmutter des Kindes gilt; […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1ff998c1-ccef-3a75-9882-322d1738744c",
                        "entry_id": "322c5471-9ae2-36b0-9537-8314ff7d3dd7",
                        "glosses": [
                            "Frau, die selber Mutter ist, aus der Sicht anderer Mütter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f56a3b4f-9650-40c9-bff8-4c7a980a7feb",
                                "sense_id": "1ff998c1-ccef-3a75-9882-322d1738744c",
                                "text": "„Heute springt es mich geradezu aus den Köpfen meiner Mitmütter an, die noch Kleinkinder zu Hause haben.“"
                            },
                            {
                                "example_id": "c5e67176-76df-46a5-9cc5-d5115b8fdf1a",
                                "sense_id": "1ff998c1-ccef-3a75-9882-322d1738744c",
                                "text": "„Nicht jeder hat so eine nette Freundin, die an all ihre Mitmütter denkt und ihnen ein Exemplar in den Briefkasten steckt.“"
                            },
                            {
                                "example_id": "c6273339-2b44-47f1-a5c8-981909fcbefc",
                                "sense_id": "1ff998c1-ccef-3a75-9882-322d1738744c",
                                "text": "„Die kämpfen im Konkurrenzkampf überkandidelter Mitmütter um Anerkennung und müssen sich doch nach 15 Jahren Kindererziehung betroffen anhören, dass die Bewunderung ihrer Kinder längst in Fremdschämen für die peinliche Mutter umgeschlagen ist.“"
                            },
                            {
                                "example_id": "9775c976-f561-4a87-a896-f8ce82f0da5b",
                                "sense_id": "1ff998c1-ccef-3a75-9882-322d1738744c",
                                "text": "„Hier kann die ›Mitmutter‹ behilflich sein, um gesündere, realistischer Maßstäbe für das eigene Muttersein zu entwickeln und das durch Krisen erschütterte Selbstvertrauen wieder zu stärken.“"
                            },
                            {
                                "example_id": "8197a96b-c156-4d71-bda9-c20a50ff5d2c",
                                "sense_id": "1ff998c1-ccef-3a75-9882-322d1738744c",
                                "text": "„Die Hebamme gab sich alle Mühe und zündete ein Räucherstäbchen an; die Mitmütter, deren Familienleben vorgezeichnet schien, hatten die Babys dabei, welche brüllten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
