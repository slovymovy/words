{
    "word_family": [
        "atrocious",
        "atrociously",
        "atrociousness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "faea433b-26d3-3b85-9985-aada8427b1bb",
                    "sense_definition": "An extremely cruel, violent, or wicked act, especially one committed during a war.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cruel_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The international community was shocked by the reports of a wartime <w>atrocity</w> against civilians.",
                            "target_lang_translations": {
                                "ru": "Международное сообщество было потрясено сообщениями о военном <w>зверстве</w> против мирного населения."
                            }
                        },
                        {
                            "text": "The soldiers were ordered to commit an <w>atrocity</w> that they would regret for the rest of their lives.",
                            "target_lang_translations": {
                                "ru": "Солдатам приказали совершить <w>злодеяние</w>, о котором они будут жалеть до конца своих дней."
                            }
                        }
                    ],
                    "synonyms": [
                        "abomination",
                        "brutality"
                    ],
                    "common_phrases": [
                        "commit an atrocity",
                        "wartime atrocity",
                        "mass atrocity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно жестокий, насильственный или нечестивый поступок, особенно совершенный во время войны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зверство",
                                "target_lang_sense_clarification": "крайне жестокий поступок"
                            },
                            {
                                "target_lang_word": "злодеяние",
                                "target_lang_sense_clarification": "тяжкое преступление"
                            },
                            {
                                "target_lang_word": "бесчинство",
                                "target_lang_sense_clarification": "грубое нарушение порядка с применением насилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6d86685-4aa8-35cc-91ff-4cb44ae9adfb",
                    "sense_definition": "The quality or state of being extremely wicked, cruel, or tasteless.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cruel_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheer <w>atrocity</w> of the crime left the judge struggling to find words during the sentencing.",
                            "target_lang_translations": {
                                "ru": "Сама <w>чудовищность</w> преступления заставила судью подбирать слова во время вынесения приговора."
                            }
                        },
                        {
                            "text": "He spoke with such moral <w>atrocity</w> that everyone in the room felt deeply uncomfortable.",
                            "target_lang_translations": {
                                "ru": "Он говорил с такой моральной <w>жестокостью</w>, что все в комнате почувствовали себя крайне неловко."
                            }
                        }
                    ],
                    "synonyms": [
                        "atrociousness",
                        "heinousness",
                        "brutality"
                    ],
                    "common_phrases": [
                        "moral atrocity",
                        "sheer atrocity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество или состояние крайней порочности, жестокости или безвкусицы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жестокость",
                                "target_lang_sense_clarification": "свойство личности или характера"
                            },
                            {
                                "target_lang_word": "чудовищность",
                                "target_lang_sense_clarification": "крайняя степень ужаса или аморальности"
                            },
                            {
                                "target_lang_word": "зверство",
                                "target_lang_sense_clarification": "бесчеловечность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c3cc715-cc6d-338b-8db4-60956ef7a70c",
                    "sense_definition": "An object that is considered to be extremely ugly, unattractive, or of very poor quality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ugly_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new building was a visual <w>atrocity</w> that ruined the historic skyline of the city.",
                            "target_lang_translations": {
                                "ru": "Новое здание было визуальным <w>убожеством</w>, испортившим исторический облик города."
                            }
                        },
                        {
                            "text": "She described the neon pink sofa as a decorative <w>atrocity</w> that had no place in a modern home.",
                            "target_lang_translations": {
                                "ru": "Она назвала неоново-розовый диван декоративным <w>безобразием</w>, которому не место в современном доме."
                            }
                        }
                    ],
                    "synonyms": [
                        "abomination"
                    ],
                    "common_phrases": [
                        "visual atrocity",
                        "fashion atrocity"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to hyperbolically describe something very ugly"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объект, который считается крайне уродливым, непривлекательным или очень низкого качества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убожество",
                                "target_lang_sense_clarification": "нечто крайне неприглядное или жалкое"
                            },
                            {
                                "target_lang_word": "безобразие",
                                "target_lang_sense_clarification": "крайне некрасивая вещь"
                            },
                            {
                                "target_lang_word": "кошмар",
                                "target_lang_sense_clarification": "переносное значение для чего-то ужасного на вид"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}