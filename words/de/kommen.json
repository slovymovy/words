                {
                    "sense_id": "395291aa-278e-37b7-b6ca-c80b4de18d81",
                    "sense_definition": "durch etwas verursacht werden oder auf einem bestimmten Grund beruhen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ursache",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seine starken Rückenschmerzen <w>kommen</w> von der täglichen Arbeit am Schreibtisch."
                        },
                        {
                            "text": "Das <w>kam</w> nur davon, dass du vorher nicht auf meinen Rat gehört hast."
                        }
                    ],
                    "common_phrases": [
                        "von selbst kommen",
                        "das kommt davon"
                    ]
                },
                {
                    "sense_id": "a4057fb1-cb03-3808-b6a5-6847d9081490",
                    "sense_definition": "einen Gedanken fassen, sich an etwas erinnern oder auf eine Idee geraten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gedanke",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich <w>komme</w> im Moment einfach nicht auf den Namen dieser Schauspielerin."
                        },
                        {
                            "text": "Wie <w>kamst</w> du denn plötzlich auf diese völlig verrückte Idee?"
                        }
                    ],
                    "common_phrases": [
                        "auf eine Idee kommen",
                        "auf den Gedanken kommen"
                    ]
                },
                {
                    "sense_id": "35d19895-3ece-3126-9947-8fdc0d07811a",
                    "sense_definition": "etwas erlangen oder in den Besitz von etwas gelangen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "erwerb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durch harte Arbeit und Fleiß <w>kam</w> er schließlich zu viel Geld."
                        },
                        {
                            "text": "Er wollte unbedingt wissen, wie man günstig an diese Bücher <w>kommt</w>."
                        }
                    ],
                    "common_phrases": [
                        "zu Geld kommen",
                        "an die Reihe kommen"
                    ]
