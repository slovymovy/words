                    {
                        "sense_id": "48339859-af9c-3400-99a6-c20e77a1efaa",
                        "entry_id": "d762c46e-340f-3bb4-b101-eeba40d01569",
                        "glosses": [
                            "pogląd głoszący, że w Chrystusie była tylko jedna boska natura, zaś ludzka została wchłonięta przez boską tuż po wcieleniu"
