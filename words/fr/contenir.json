{
    "word_family": [
        "contenance",
        "contenant",
        "contenu",
        "décontenancer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b5f3bfb8-d2de-345c-8b04-c5147ed7bd63",
                    "sense_definition": "Renfermer en soi des éléments, des substances ou des choses.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "renfermer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce flacon de verre <w>contient</w> une huile essentielle rare et très parfumée."
                        },
                        {
                            "text": "Les fruits frais <w>contiennent</w> des vitamines indispensables pour rester en bonne santé."
                        }
                    ],
                    "synonyms": [
                        "renfermer",
                        "comporter",
                        "inclure"
                    ]
                },
                {
                    "sense_id": "8cf5c3d7-2c09-3ce2-83fd-f0be239e8dc0",
                    "sense_definition": "Avoir une capacité ou un espace suffisant pour recevoir une quantité ou un nombre déterminé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "capacite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle salle de spectacle peut <w>contenir</w> jusqu'à deux mille personnes."
                        },
                        {
                            "text": "Le grand réservoir du village <w>contient</w> plusieurs milliers de litres d'eau potable."
                        }
                    ],
                    "synonyms": [
                        "accueillir"
                    ]
                },
                {
                    "sense_id": "f5df0074-c0e4-3915-80b7-b3c760517307",
                    "sense_definition": "Empêcher de progresser, d'avancer ou d'éclater ; réprimer ou maîtriser.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "retenir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les policiers ont réussi à <w>contenir</w> la foule impatiente derrière les barrières métalliques."
                        },
                        {
                            "text": "Malgré ses vifs désaccords, le ministre a su <w>contenir</w> sa colère pendant toute la réunion."
                        }
                    ],
                    "synonyms": [
                        "retenir",
                        "réprimer",
                        "freiner",
                        "endiguer"
                    ],
                    "antonyms": [
                        "déchaîner"
                    ],
                    "common_phrases": [
                        "contenir la foule",
                        "contenir sa colère",
                        "contenir ses émotions"
                    ]
                },
                {
                    "sense_id": "ab75f473-940c-3294-b5a7-b5ad682f7c5a",
                    "sense_definition": "Maîtriser ses émotions ou sa colère, s'empêcher de manifester un sentiment violent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "maitrise_de_soi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face aux provocations répétées de son adversaire, elle a su se <w>contenir</w> avec dignité."
                        },
                        {
                            "text": "L'homme était tellement furieux contre cette décision qu'il avait de la peine à se <w>contenir</w>."
                        }
                    ],
                    "synonyms": [
                        "se maîtriser",
                        "se contrôler",
                        "se dominer"
                    ],
                    "common_phrases": [
                        "savoir se contenir"
                    ]
                }
            ]
        }
    ]
}