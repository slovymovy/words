                                        "examples": [
                                            {
                                                "example_id": "26160578-a972-41fa-a3ad-415c61efcf15",
                                                "sense_id": "68255599-81e6-3a86-9bb1-b30f84429a1f",
                                                "text": "The burnt and bleeding man staggered to his feet, dazed and unbelieving, and asked the startled townspeople who came running whether his fireman and guard were safe. He was kept away from the smouldering crater where his engine had been, and taken to hospital."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d1991ff-681e-3a2d-b95c-edaaf6c62ffc",
                                        "entry_id": "3098d9c5-0e87-3de8-8ef3-a9214ceeb42d",
                                        "glosses": [
                                            "extreme, outright; bloody, blasted."
                                        ],
                                        "tags": [
                                            "UK",
                                            "emphatic",
                                            "intensifier",
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f491ffe-d48e-4d1f-be2b-ddcbb9563495",
                                                "sense_id": "9d1991ff-681e-3a2d-b95c-edaaf6c62ffc",
                                                "text": "You are a bleeding liar. Truth is of no interest to you at all."
                                            },
                                            {
                                                "example_id": "0becc3a6-9d8c-47ba-b896-aa8fc68920ed",
                                                "sense_id": "9d1991ff-681e-3a2d-b95c-edaaf6c62ffc",
                                                "text": "\"You are a bleeding idiot sometimes, but I love you and\", Harry hands him the first gift Severus ever gave him and says, \"One hundred and sixteen.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
