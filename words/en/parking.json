            "senses": [
                {
                    "sense_id": "efe64e4d-f7d6-33ae-9b76-1159c04cfb03",
                    "sense_definition": "The action of stopping a vehicle and leaving it in a place for a period of time.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "parking_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Illegal <w>parking</w> in this zone will result in a heavy fine.",
                            "target_lang_translations": {
                                "ru": "Неправильная <w>парковка</w> в этой зоне повлечет за собой крупный штраф.",
                                "zh": "在此区域违规<w>停车</w>将会导致高额罚款。"
                            }
                        },
                        {
                            "text": "He is not very confident at parallel <w>parking</w> on busy streets.",
                            "target_lang_translations": {
                                "ru": "Он не очень уверенно выполняет параллельную <w>парковку</w> на оживленных улицах.",
                                "zh": "他在繁忙的街道上进行侧方<w>停车</w>时不太自信。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "no parking",
                        "free parking",
                        "valet parking",
                        "street parking",
                        "parking ticket"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по остановке транспортного средства и оставлению его в определенном месте на некоторое время.",
                        "zh": "指将车辆停放在某处一段时间的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
