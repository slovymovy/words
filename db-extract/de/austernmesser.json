                "senses": [
                    {
                        "sense_id": "7301dd12-18b4-3c55-98d3-e995e390580f",
                        "entry_id": "4d278ef9-6643-3d21-aa60-f99b55bea085",
                        "glosses": [
                            "stabiles Messer zum Öffnen von Austern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9031a31-0cd0-4dde-9144-9eb43938d6d3",
                                "sense_id": "7301dd12-18b4-3c55-98d3-e995e390580f",
                                "text": "„Wer kein Austernmesser hat, kann stattdessen ein stabiles Küchenmesser zum Öffnen der Austern verwenden […].“"
                            },
                            {
                                "example_id": "3e09641c-d183-4ad4-8388-f344dd57846b",
                                "sense_id": "7301dd12-18b4-3c55-98d3-e995e390580f",
                                "text": "„Austernmesser sind in Deutschland recht teuer, während sie in Frankreich für nur wenige (teilweise um die zwei) Euro gehandelt werden und nicht selten mit einem Korb Austern mitgeliefert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "073e8a28-2393-4274-9d49-1e9048f0ebe4",
                        "source_entry_id": "4d278ef9-6643-3d21-aa60-f99b55bea085",
                        "source_sense_id": "7301dd12-18b4-3c55-98d3-e995e390580f",
                        "source_sense_description": "stabiles Messer zum Öffnen von Austern",
                        "target_lang_word": "oyster knife",
