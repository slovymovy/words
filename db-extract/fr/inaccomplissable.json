                        "sense_id": "bc0f6fae-cd97-3b64-8118-7ab3786da5a9",
                        "entry_id": "d909d47a-8cb9-3123-a493-686092d8a17b",
                        "glosses": [
                            "Qui est impossible à accomplir."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b90c8076-ae6e-46ac-ae9c-a16abe4ff5dc",
                                "sense_id": "bc0f6fae-cd97-3b64-8118-7ab3786da5a9",
                                "text": "Jamais les calculs personnels n’avaient inspiré une idée plus fausse et plus inaccomplissable sous tous les rapports."
                            },
                            {
                                "example_id": "14da2169-c93b-4546-9892-c7b70081231d",
                                "sense_id": "bc0f6fae-cd97-3b64-8118-7ab3786da5a9",
                                "text": "Mais ce qui m'importe, c'est l'autonomie effective des hommes effectifs, non pas la fiction d'une exigence qui se pose elle-même d'emblée comme à jamais inaccomplissable."
                            },
                            {
                                "example_id": "ff5350c0-be25-4285-b855-4cf34918f15a",
                                "sense_id": "bc0f6fae-cd97-3b64-8118-7ab3786da5a9",
                                "text": "Ce petit animal ne comprenait pas que toute la vie est inaccomplissable, que le temps viendrait (mais pourrait-il venir avant sa mort ?) où derrière ces collines on sentirait seulement la présence d'autres collines, d'autres plaines, ..."
                            }
                        ]
                    }
