                                        "sense_id": "c124f243-8ae5-35dd-ac23-31d232d84a18",
                                        "entry_id": "8ffc8414-89b7-362b-beae-5495642c9365",
                                        "glosses": [
                                            "A person who reads."
                                        ],
                                        "tags": [],
                                        "examples": [
