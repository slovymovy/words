    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7ff0d7ef-0f25-33c5-a204-6efd6feaa090",
                    "sense_definition": "drückt das Fortdauern eines Zustands oder einer Handlung bis zur Gegenwart oder einem Bezugszeitpunkt aus",
