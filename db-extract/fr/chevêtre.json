                                    {
                                        "sense_id": "d6ad8482-8dcf-3138-a2de-5413ecd89b26",
                                        "entry_id": "9eb7b990-09b9-33f7-90bc-28da023ccec5",
                                        "glosses": [
                                            "Large text, like a headline but typically drawn from the article, placed partway through the article to break it up visually."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e1c6b51-0a1d-47ec-9a57-eea7ef153557",
                                                "sense_id": "d6ad8482-8dcf-3138-a2de-5413ecd89b26",
                                                "text": "Other bits of furniture include [...] the crosshead, a short heading between paragraphs that breaks up a long piece."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0baa98e-b7cb-39dd-aa7c-4848155e128d",
                                        "entry_id": "9eb7b990-09b9-33f7-90bc-28da023ccec5",
                                        "glosses": [
                                            "A screw with a cross-shaped indentation for gripping and turning, as opposed to a flathead."
                                        ],
                                        "tags": [],
