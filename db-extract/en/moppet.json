                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "219914aa-f24f-46ba-9dbe-bd0fe524430e",
                                "sense_id": "fab844a1-c3d1-31e8-bf75-81715f58988b",
                                "text": "They are also very sympathetic, especially Caesar’s orangutan advisor, Maurice (Karin Konoval), who takes a shine to a human moppet (Amiah Miller) he finds hiding in the back of a shack, and the poignant Bad Ape (a scene-stealing Steve Zahn), a mangy chimp who was beaten so often in his zoo-animal days that he came to believe what his handlers were shouting was supposed to be his name."
                            }
                        ]
