                ],
                "senses": [
                    {
                        "sense_id": "ba201c1e-b74d-3171-97e8-3f142ae1fecb",
                        "entry_id": "11ca3788-ebdb-3e94-adf4-33fde6d98a43",
                        "glosses": [
                            "жарг., собир., неисч. алкогольные напитки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1646d57e-596f-4b55-a617-2f1aa0ef87c8",
                                "sense_id": "ba201c1e-b74d-3171-97e8-3f142ae1fecb",
                                "text": "Петя и Вася купили бухло в соседнем ларьке."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f61d2f3-9e7a-4578-8bda-acb6aa94b04c",
                        "source_entry_id": "11ca3788-ebdb-3e94-adf4-33fde6d98a43",
                        "source_sense_id": "ba201c1e-b74d-3171-97e8-3f142ae1fecb",
                        "target_lang_word": "bibine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bibine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4d304f2-f767-3829-ac60-99e0b30ef1b1",
                                        "entry_id": "854fe7e8-8b4b-3ab4-90e3-570b2f4d0d3c",
                                        "glosses": [
                                            "Cabaret de bas étage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60838d00-5473-4448-a889-ec89387f3cf8",
                                                "sense_id": "c4d304f2-f767-3829-ac60-99e0b30ef1b1",
                                                "text": "Dans les deux autres, s’ouvraient une remise de voitures à bras et une bibine derrière les barreaux de laquelle apparaissaient des goulots capsulés de litres."
                                            },
                                            {
                                                "example_id": "d9168c96-edf1-426b-a11a-55662c627655",
                                                "sense_id": "c4d304f2-f767-3829-ac60-99e0b30ef1b1",
                                                "text": "Apprenez encore ceci : les cabarets des chiffonniers s’appellent bibines ; les plus célèbres sont la Casserole et l’Abattoir."
                                            },
                                            {
                                                "example_id": "e2cf931e-9474-48c4-b86a-2d8095938b5f",
                                                "sense_id": "c4d304f2-f767-3829-ac60-99e0b30ef1b1",
                                                "text": "— […] j’ai fréquenté la bibine de la rue des Anglais.\n— La bibine ? répéta Scaër.\n— Oui, c’est un cabaret où il n’y a que des ivrognes et des voleurs."
                                            },
                                            {
                                                "example_id": "a4579062-1adb-47d9-a91e-dba01be760f8",
                                                "sense_id": "c4d304f2-f767-3829-ac60-99e0b30ef1b1",
                                                "text": "Je sers d’enseigne à ta bibine ; je joue le rôle d’allumettes, mais je n’ai pas le droit de brûler pour de bon !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7917b30-199a-303a-8c68-034c45029ef9",
                                        "entry_id": "854fe7e8-8b4b-3ab4-90e3-570b2f4d0d3c",
                                        "glosses": [
                                            "Boisson de mauvaise qualité. Mauvaise bière, mauvais vin, piquette."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c37ac81-5da0-4ad7-9e88-ef32709ef365",
                                                "sense_id": "c7917b30-199a-303a-8c68-034c45029ef9",
                                                "text": "Et pour vivre, j’ai besoin de ma bibine."
                                            },
                                            {
                                                "example_id": "0f701956-913f-469a-aa0b-862881d30c63",
                                                "sense_id": "c7917b30-199a-303a-8c68-034c45029ef9",
                                                "text": "Fini de m’envoyer de la bibine ! À partir de désormais, l’ami Billy Joe ne se tapera plus que de l’extra. Le tord-boyaux et compagnie, c’est terminé."
                                            },
                                            {
                                                "example_id": "1dd17aa7-700a-4e4a-8529-fd032f6f8c26",
                                                "sense_id": "c7917b30-199a-303a-8c68-034c45029ef9",
                                                "text": "Elle, les yeux en trou de bite, le cheveu filasse et gras, la face violette, a peut être la cinquantaine, mais les années de bibine comptant double on a vite fait le compte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9af1c55-f3cc-3819-b0e8-b8dd19a07109",
                                        "entry_id": "854fe7e8-8b4b-3ab4-90e3-570b2f4d0d3c",
                                        "glosses": [
                                            "Rien, pas grand-chose, chose de peu de valeur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25d69e92-54d7-4dc1-ac5c-6957129f4f63",
                                                "sense_id": "c9af1c55-f3cc-3819-b0e8-b8dd19a07109",
                                                "text": "Il leur ferait comprendre que s’il y avait quelqu’un de zinzin dans le régiment, c’était bien lui, et que les crises de maspéroclastie bavotante du capitaine Dumouriez, c’était de la bibine à côté de ce qu’il avait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
