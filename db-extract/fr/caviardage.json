                        "sense_id": "e93149c4-e6e8-39f7-9465-bd29ab388f38",
                        "entry_id": "740b16bb-84f0-3064-9897-72dd27bbf253",
                        "glosses": [
                            "Suppression de certains passages d'un texte écrit, lesquels sont considérés comme gênants, compromettants ou immoraux sur ordre d'une censure quelconque."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "43ada0e2-f02c-41ce-b08d-332f68e29707",
                                "sense_id": "e93149c4-e6e8-39f7-9465-bd29ab388f38",
                                "text": "Le caviardage du dossier a induit ce cadre d'entreprise en erreur."
                            },
                            {
                                "example_id": "48f4e2e6-2c1a-4d50-ab13-226c79439675",
                                "sense_id": "e93149c4-e6e8-39f7-9465-bd29ab388f38",
                                "text": "En conférence de presse, la semaine dernière, l'ancien sous-ministre du groupe de travail sur l'Afghanistan, l'ambassadeur David Mulroney, affirmait que « l'évaluation des caviardages et l'analyse des justifications de ces caviardages effectuées par le groupe d'experts-arbitres constituent une réelle validation du travail détaillé et soigné » des fonctionnaires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "109b9d96-cc51-4dda-bc75-3deb963a9135",
                        "source_entry_id": "740b16bb-84f0-3064-9897-72dd27bbf253",
                        "source_sense_id": "e93149c4-e6e8-39f7-9465-bd29ab388f38",
                        "target_lang_word": "censorship",
