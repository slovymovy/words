{
    "word_family": [
        "curve",
        "curvy",
        "curvature",
        "curvaceous"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "31c35d02-3987-35d6-b140-e6c8346c5a04",
                    "sense_definition": "Having a shape that bends or rounds rather than being straight.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The road became very <w>curved</w> as it wound through the steep mountains.",
                            "target_lang_translations": {
                                "ru": "Дорога стала очень <w>извилистой</w>, когда она пошла через крутые горы."
                            }
                        },
                        {
                            "text": "She used a <w>curved</w> blade to carefully cut the fruit into decorative shapes.",
                            "target_lang_translations": {
                                "ru": "Она использовала <w>изогнутое</w> лезвие, чтобы аккуратно нарезать фрукты для украшения."
                            }
                        },
                        {
                            "text": "The architect designed a building with a <w>curved</w> surface to reflect the light.",
                            "target_lang_translations": {
                                "ru": "Архитектор спроектировал здание с <w>изогнутой</w> поверхностью, чтобы отражать свет."
                            }
                        }
                    ],
                    "synonyms": [
                        "bent",
                        "hooked",
                        "rounded",
                        "curvy"
                    ],
                    "antonyms": [
                        "flat",
                        "straight"
                    ],
                    "common_phrases": [
                        "curved line",
                        "curved surface",
                        "curved blade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий форму, которая изгибается или закругляется, а не является прямой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изогнутый",
                                "target_lang_sense_clarification": "имеющий плавный изгиб"
                            },
                            {
                                "target_lang_word": "кривой",
                                "target_lang_sense_clarification": "не прямой"
                            },
                            {
                                "target_lang_word": "закругленный",
                                "target_lang_sense_clarification": "имеющий округлую форму"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "747f29b4-e9a6-39b5-8464-aa8bfc2dff48",
                    "sense_definition": "Past tense and past participle of <w>curve</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ball <w>curved</w> through the air and landed exactly in the goal.",
                            "target_lang_translations": {
                                "ru": "Мяч <w>пролетел по дуге</w> в воздухе и приземлился точно в ворота."
                            }
                        },
                        {
                            "text": "He <w>curved</w> the piece of metal by heating it over a hot flame.",
                            "target_lang_translations": {
                                "ru": "Он <w>согнул</w> кусок металла, нагрев его над сильным пламенем."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола curve (изгибаться, закругляться)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изогнулся",
                                "target_lang_sense_clarification": "о траектории или форме"
                            },
                            {
                                "target_lang_word": "согнул",
                                "target_lang_sense_clarification": "придал изогнутую форму"
                            }
                        ]
                    }
                }
            ]
        }
    ]
