                "senses": [
                    {
                        "sense_id": "0dcab76d-66e0-3619-88e2-d8fe87f0e268",
                        "entry_id": "9c63e141-458e-36ff-a76c-310d5df3d494",
                        "glosses": [
                            "Raconter (des commérages)."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "855951ab-79af-4f02-85fe-d775218b80fb",
                                "sense_id": "0dcab76d-66e0-3619-88e2-d8fe87f0e268",
                                "text": "Elle passe la journée à mémérer."
                            },
                            {
                                "example_id": "5282c6db-647a-40ee-bec1-83174a5caaf3",
                                "sense_id": "0dcab76d-66e0-3619-88e2-d8fe87f0e268",
                                "text": "Je m’asseyais ensuite dans un fauteuil, un verre de thé à la main, et mémérais avec les Nègres dans la salle d’attente : « Ça va la santé, madame Zimbala, votre mari est-il revenu ? »"
                            },
                            {
                                "example_id": "5bea3f48-cac6-4750-98d4-3648dcef67d0",
                                "sense_id": "0dcab76d-66e0-3619-88e2-d8fe87f0e268",
                                "text": "Avec une connexion internet si lente, j’ai l’impression de jaser avec un stroboscope. À force de coupures, on jurerait que ma blonde parle l’ukrainien. Sinon, nous mémérons au téléphone, mais je déteste ça."
                            }
                        ]
                    },
                    {
                        "sense_id": "73051bd9-7947-307b-80f6-2057db58d859",
                        "entry_id": "9c63e141-458e-36ff-a76c-310d5df3d494",
                        "glosses": [
                            "Dénoncer bassement, moucharder."
                        ],
                        "tags": [
                            "familiar",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ceb23ec1-dc6e-41bf-9f06-ed5a1fd12251",
                                "sense_id": "73051bd9-7947-307b-80f6-2057db58d859",
                                "text": "Il est allé tout mémérer au patron."
                            }
                        ]
                    }
