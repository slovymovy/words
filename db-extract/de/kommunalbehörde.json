                "senses": [
                    {
                        "sense_id": "7adc4215-b03c-34a2-80bd-272909e6bde3",
                        "entry_id": "b170620d-6d87-3a8f-aebf-d0fa9219c582",
                        "glosses": [
                            "Behörde in der Trägerschaft einer Kommune"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b98f294-b8b4-495d-9341-48329abbcc48",
                                "sense_id": "7adc4215-b03c-34a2-80bd-272909e6bde3",
                                "text": "„Doch das neue Verfahren der Nahrungszuteilung musste verwaltet werden - die Kommunalbehörden hatten alle Anmeldungen zu kontrollieren, nummerierte Brotbücher sowie Brotkarten zu entwerfen, drucken zu lassen und zu verteilen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74813853-8c2b-4d0d-a89b-1c457dfb63da",
                        "source_entry_id": "b170620d-6d87-3a8f-aebf-d0fa9219c582",
                        "source_sense_id": "7adc4215-b03c-34a2-80bd-272909e6bde3",
                        "source_sense_description": "Behörde in der Trägerschaft einer Kommune",
                        "target_lang_word": "local authority",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "local authority",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c5b122c-8233-3ab7-8ea9-7ed9dc949b4e",
                                        "entry_id": "d9dd7f6d-e719-3f4f-956d-9609f45d556d",
                                        "glosses": [
                                            "An administrative body in local government, such as a city council."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8509c0d-3a87-40c3-8796-902fe9c65d0e",
                                                "sense_id": "6c5b122c-8233-3ab7-8ea9-7ed9dc949b4e",
                                                "text": "Some preliminary legal arrangements were made, but the scheme proceeded no further, as the various local authorities concerned were unwilling to speculate public funds on what was, even at that date, a will o' the wisp."
                                            },
                                            {
                                                "example_id": "f7e1e528-732f-403b-9c31-d15c2b78cba3",
                                                "sense_id": "6c5b122c-8233-3ab7-8ea9-7ed9dc949b4e",
                                                "text": "Controversy has surrounded some of the schemes, which local authorities and commuters have seen as putting money-making before travel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
