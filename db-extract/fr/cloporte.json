                                            {
                                                "example_id": "b9053054-5355-41ff-a8d0-bf4631e9e0ae",
                                                "sense_id": "567fbc8e-ddd0-3de8-bef1-7eb2c5fda2a2",
                                                "text": "В садике-дворике маленькие клёны, заросшая мокрицей и подорожником узкая тропинка вокруг неровного бугра."
                                            },
                                            {
                                                "example_id": "5fd820b5-a377-471c-a013-23594b8358b5",
                                                "sense_id": "567fbc8e-ddd0-3de8-bef1-7eb2c5fda2a2",
                                                "text": "Очень долго (до 15-20 лет) могут сохраняться в почве семена сорняков: лебеды, мари, мокрицы."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "мокрица",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4df257df-be90-330b-8c9d-e30aa9d1ce30",
                                        "entry_id": "4a2c038d-4dd5-3c1e-8146-3e060dd31835",
                                        "glosses": [
                                            "зоол. мелкое наземное ракообразное животное отряда равноногих, живущее в сырых тёплых местах (Oniscidea)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93efd65c-efbb-4275-9ea2-a8b32d5f346f",
                                                "sense_id": "4df257df-be90-330b-8c9d-e30aa9d1ce30",
                                                "text": "― Знаешь, до встречи с тобой я была такая трусиха, правда, я лыжница и плаваю хорошо, у меня первый разряд, но всё равно я трусиха, мышей боюсь, и мокриц, и сороконожек."
                                            },
                                            {
                                                "example_id": "692af3ee-266f-47e5-85bd-ee5719598571",
                                                "sense_id": "4df257df-be90-330b-8c9d-e30aa9d1ce30",
                                                "text": "Зато она очень любила мыть полы и исполняла это занятие так часто и с таким усердием, что в квартире скоро завелась сырость и показались мокрицы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
