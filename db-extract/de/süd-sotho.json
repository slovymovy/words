                        "glosses": [
                            "Sprache, die in Südafrika und in Lesotho gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a7afffa-1013-4361-b9ed-541ac64fa901",
                                "sense_id": "4041de71-0eff-337f-b158-11f8b37b843a",
                                "text": "„Das Süd-Sotho ist mit dem Nord-Sotho nahezu identisch und eng verwandt mit dem Setswana.“"
                            },
                            {
