                    },
                    {
                        "form_id": "029bb2f8-21a1-4859-b3f4-c956471384ed",
                        "entry_id": "2c113594-926c-3832-9790-d2e4d97fa7e2",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "tensioactives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9edbfdf7-468e-3727-a64e-0aaaec5a8bf6",
                        "entry_id": "2c113594-926c-3832-9790-d2e4d97fa7e2",
                        "glosses": [
                            "Se dit d'un agent chimique dont la présence à une interface entre deux fluides entraîne l'abaissement de la tension interfaciale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c97f75b4-9215-4381-99ff-6b46cdf39a64",
                                "sense_id": "9edbfdf7-468e-3727-a64e-0aaaec5a8bf6",
                                "text": "Les molécules tensioactives stabilisent les gouttelettes d'huile dans l'eau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49e9b26b-2eec-4ced-bb59-b77c667a2e3b",
                        "source_entry_id": "2c113594-926c-3832-9790-d2e4d97fa7e2",
                        "source_sense_id": "9edbfdf7-468e-3727-a64e-0aaaec5a8bf6",
                        "target_lang_word": "surfactant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surfactant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94cf5191-5ba8-3422-9ce8-91f0981f282c",
                                        "entry_id": "6c38e680-66f4-3dfe-9dc2-8621c2ad28e8",
                                        "glosses": [
                                            "A surface-active agent, or wetting agent, capable of reducing the surface tension of a liquid; typically organic compounds having a hydrophilic “head” and a hydrophobic “tail”."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eaef187-dcc8-4ffc-a018-96fb605e28a5",
                                                "sense_id": "94cf5191-5ba8-3422-9ce8-91f0981f282c",
                                                "text": "Dr. Khorana added that this is especially true of cleansers that feature surfactants like sodium lauryl sulfate, as this class of ingredients can cause “dryness, irritation and eczema.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7bccd9a-099e-3cd5-8d2e-7dd62d0cf903",
                                        "entry_id": "6c38e680-66f4-3dfe-9dc2-8621c2ad28e8",
                                        "glosses": [
                                            "A lipoprotein in the tissues of the lung that reduces surface tension and permits more efficient gas transport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad077e9-e337-4445-abec-8fa52eacea7a",
                                                "sense_id": "e7bccd9a-099e-3cd5-8d2e-7dd62d0cf903",
                                                "text": "It is conceivable that impairment of surfactant proteins is due to rheological and immunodefensive disorders of testis and epididymis or prostate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "5c49d5c6-611d-3687-af8c-b127079455ea",
                "word": "tensioactif",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3dc49d91-eaeb-4f20-8bf2-ef9a279ba009",
                        "entry_id": "5c49d5c6-611d-3687-af8c-b127079455ea",
                        "tags": [
                            "plural"
                        ],
                        "form": "tensioactifs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dbb5968e-292d-3e97-80e2-fc2ed4f10db2",
                        "entry_id": "5c49d5c6-611d-3687-af8c-b127079455ea",
                        "glosses": [
                            "Composé chimique qui diminue la tension superficielle entre deux surfaces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11c77832-e2eb-4d05-9319-1d5e31dc9c9f",
                                "sense_id": "dbb5968e-292d-3e97-80e2-fc2ed4f10db2",
                                "text": "Des tensioactifs sont utilisés en décontamination et agissent comme de la lessive."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dcb1f16-ba1a-47cb-b540-e02c132daa64",
                        "source_entry_id": "5c49d5c6-611d-3687-af8c-b127079455ea",
                        "source_sense_id": "dbb5968e-292d-3e97-80e2-fc2ed4f10db2",
                        "target_lang_word": "Tensid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tensid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b31c1b93-ac04-3eb2-b250-5d7f3a8f8efd",
                                        "entry_id": "8c6e93cc-4bca-30e7-a2c5-595cf30a3671",
                                        "glosses": [
                                            "Substanzen, die die Oberflächenspannung einer Flüssigkeit oder die Grenzflächenspannung zwischen zwei Phasen herabsetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2fb2a3b-2189-48de-9bb4-55b2636047e1",
                                                "sense_id": "b31c1b93-ac04-3eb2-b250-5d7f3a8f8efd",
                                                "text": "„Die bei der Herstellung entstehenden Salze der Fettsäuren sind die eigentliche Seife und verfügen über eine reinigende Wirkung, da sie die Eigenschaften eines Tensids besitzen.“"
                                            },
                                            {
                                                "example_id": "de3313d2-ba8b-4199-be3a-32a705b4f181",
                                                "sense_id": "b31c1b93-ac04-3eb2-b250-5d7f3a8f8efd",
                                                "text": "„Die häufig auch als Tenside bezeichneten Hilfsstoffe finden eine breite Anwendung in Pharmazie, Lebensmitteltechnologie als Lebensmittelzusatzstoffe, Ölindustrie, im Haushalt (in Reinigungsmitteln und Wasserlacken), in der Kosmetik und zahlreichen großindustriellen Anwendungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
