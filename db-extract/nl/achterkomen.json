                "senses": [
                    {
                        "sense_id": "fd89ba19-3643-3665-949e-9e779d07e942",
                        "entry_id": "aba1fafc-cb25-328d-8451-12c522326c92",
                        "glosses": [
                            "to discover, to realise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b0c64de-bda7-47cf-9186-99bcf8810af4",
                                "sense_id": "fd89ba19-3643-3665-949e-9e779d07e942",
                                "text": "Ik kwam er gisteren achter dat er geen pinguïns zijn op de Noordpool.",
                                "translation": "I discovered that there are no penguins on the North Pole yesterday.",
                                "english": "I discovered that there are no penguins on the North Pole yesterday."
                            },
                            {
                                "example_id": "6ac1ba8f-6a2e-4270-bba7-1d1a2084b585",
                                "sense_id": "fd89ba19-3643-3665-949e-9e779d07e942",
                                "text": "Niemand komt achter ons geheim.",
                                "translation": "Nobody discovers our secret.",
                                "english": "Nobody discovers our secret."
                            }
                        ]
                    }
                ],
