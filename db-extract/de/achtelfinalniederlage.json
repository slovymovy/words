                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc5345bc-8f1f-4f88-a61a-2ad5219c7d24",
                                "sense_id": "f16f39f0-0f5f-39af-9fba-2e6946f6f0a6",
                                "text": "„So entschlossen und kämpferisch war das deutsche Team bei der Achtelfinalniederlage gegen Polen zu selten.“"
                            },
                            {
                                "example_id": "412f72f7-4fe5-44e7-9c68-cbff5f0dbade",
                                "sense_id": "f16f39f0-0f5f-39af-9fba-2e6946f6f0a6",
                                "text": "„Über 15 Jahre prägte Joachim Löw den deutschen Fußball. Doch nach der Achtelfinalniederlage gegen England (0:2) bei der Europameisterschaft 2021 war die Ära des 62-Jährigen beim DFB zu Ende.“"
                            }
                        ],
