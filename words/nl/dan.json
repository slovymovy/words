{
    "word_family": [],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "244f257f-0408-3fd3-8f7c-68534697af23",
                    "sense_definition": "daarna of vervolgens in een reeks gebeurtenissen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eerst moet je je tanden poetsen, <w>dan</w> mag je naar bed.",
                            "target_lang_translations": {
                                "en": "First you must brush your teeth, <w>then</w> you may go to bed.",
                                "ru": "Сначала ты должен почистить зубы, а <w>потом</w> можешь идти спать."
                            }
                        },
                        {
                            "text": "We gaan eerst eten en <w>dan</w> gaan we naar de film.",
                            "target_lang_translations": {
                                "en": "We are going to eat first and <w>then</w> we are going to the movies.",
                                "ru": "Сначала мы поедим, а <w>затем</w> пойдем в кино."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eerst dit dan dat"
                    ],
                    "target_lang_definitions": {
                        "en": "after that or subsequently in a series of events",
                        "ru": "после этого или затем в последовательности событий"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "then",
                                "target_lang_sense_clarification": "next in a sequence"
                            },
                            {
                                "target_lang_word": "afterwards",
                                "target_lang_sense_clarification": "at a later time"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "потом",
                                "target_lang_sense_clarification": "после чего-либо"
                            },
                            {
                                "target_lang_word": "затем",
                                "target_lang_sense_clarification": "вслед за этим"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5b4b997-e239-3420-a5ef-c2d07092de30",
                    "sense_definition": "op dat moment in de toekomst",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_future",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Morgen wordt het beter weer, maar <w>dan</w> moet ik weer naar mijn werk.",
                            "target_lang_translations": {
                                "en": "Tomorrow the weather will be better, but <w>then</w> I have to go back to work.",
                                "ru": "Завтра погода будет лучше, но <w>тогда</w> мне снова нужно будет на работу."
                            }
                        },
                        {
                            "text": "Ik kom volgende week langs en we kunnen <w>dan</w> alles rustig bespreken.",
                            "target_lang_translations": {
                                "en": "I will stop by next week and we can <w>then</w> discuss everything calmly.",
                                "ru": "Я зайду на следующей неделе, и мы сможем <w>тогда</w> всё спокойно обсудить."
                            }
                        }
                    ],
                    "antonyms": [
                        "nu",
                        "toen"
                    ],
                    "common_phrases": [
                        "tegen dan"
                    ],
                    "target_lang_definitions": {
                        "en": "at that moment in the future",
                        "ru": "в тот момент в будущем"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "then",
                                "target_lang_sense_clarification": "at that future time"
                            },
                            {
                                "target_lang_word": "by then",
                                "target_lang_sense_clarification": "at or before that time"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тогда",
                                "target_lang_sense_clarification": "в то время в будущем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1ba4085-33e9-3313-b7f7-287b4f782202",
                    "sense_definition": "in dat geval of onder die omstandigheden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als het niet had geregend, <w>dan</w> was de auto nu nog schoon geweest.",
                            "target_lang_translations": {
                                "en": "If it hadn't rained, <w>then</w> the car would still have been clean now.",
                                "ru": "Если бы не пошел дождь, <w>тогда</w> машина сейчас была бы еще чистой."
                            }
                        },
                        {
                            "text": "Mocht je hulp nodig hebben, <w>dan</w> hoor ik het graag van je.",
                            "target_lang_translations": {
                                "en": "Should you need help, <w>then</w> I would like to hear from you.",
                                "ru": "Если вам понадобится помощь, <w>тогда</w> я буду рад об этом услышать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wat dan nog"
                    ],
                    "target_lang_definitions": {
                        "en": "in that case or under those circumstances",
                        "ru": "в таком случае или при таких обстоятельствах"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "then",
                                "target_lang_sense_clarification": "in that case"
                            },
                            {
                                "target_lang_word": "so",
                                "target_lang_sense_clarification": "consequently"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тогда",
                                "target_lang_sense_clarification": "в таком случае"
                            },
                            {
                                "target_lang_word": "в таком случае",
                                "target_lang_sense_clarification": "при данных условиях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7f9091a-57fe-3415-aa2b-b422f910046a",
                    "sense_definition": "gebruikt om extra nadruk te geven aan een vraag of uitroep",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heeft <w>dan</w> niemand zijn huiswerk gemaakt voor de les van vandaag?",
                            "target_lang_translations": {
                                "en": "Has no one <w>then</w> done their homework for today's class?",
                                "ru": "Неужели <w>же</w> никто не сделал домашнее задание к сегодняшнему уроку?"
                            }
                        },
                        {
                            "text": "Wat is er <w>dan</w> aan de hand met die oude machine?",
                            "target_lang_translations": {
                                "en": "What is the matter <w>then</w> with that old machine?",
                                "ru": "Что <w>же</w> тогда происходит с этой старой машиной?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wat dan"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used for emphasis in speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "used to give extra emphasis to a question or exclamation",
                        "ru": "используется для придания дополнительного акцента вопросу или восклицанию"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "then",
                                "target_lang_sense_clarification": "used for emphasis in questions"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "же",
                                "target_lang_sense_clarification": "усилительная частица"
                            },
                            {
                                "target_lang_word": "тогда",
                                "target_lang_sense_clarification": "в вопросительных предложениях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "6226f060-cea4-32bc-ba30-d12562cc399c",
                    "sense_definition": "gebruikt na een vergrotende trap om een verschil aan te geven",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben een stuk ouder <w>dan</w> jij bent.",
                            "target_lang_translations": {
                                "en": "I am a lot older <w>than</w> you are.",
                                "ru": "Я намного старше, <w>чем</w> ты."
                            }
                        },
                        {
                            "text": "Deze nieuwe auto rijdt veel sneller <w>dan</w> mijn vorige wagen.",
                            "target_lang_translations": {
                                "en": "This new car drives much faster <w>than</w> my previous car.",
                                "ru": "Эта новая машина едет гораздо быстрее, <w>чем</w> мой предыдущий автомобиль."
                            }
                        }
                    ],
                    "antonyms": [
                        "als"
                    ],
                    "common_phrases": [
                        "beter dan",
                        "meer dan",
                        "groter dan"
                    ],
                    "target_lang_definitions": {
                        "en": "used after a comparative to indicate a difference",
                        "ru": "используется после сравнительной степени для указания на различие"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "than",
                                "target_lang_sense_clarification": "introducing a comparison"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "чем",
                                "target_lang_sense_clarification": "при сравнении"
                            },
                            {
                                "target_lang_word": "нежели",
                                "target_lang_sense_clarification": "более формальное сравнение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "88412873-c132-33d8-a060-1c8d56e0a5ff",
                    "sense_definition": "niets anders dan; behalve",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er was niets <w>dan</w> liefde in dat kleine, gezellige huisje.",
                            "target_lang_translations": {
                                "en": "There was nothing <w>but</w> love in that small, cozy house.",
                                "ru": "В этом маленьком уютном домике не было ничего, <w>кроме</w> любви."
                            }
                        },
                        {
                            "text": "Hij spreekt over niets anders <w>dan</w> zijn nieuwe hobby.",
                            "target_lang_translations": {
                                "en": "He speaks of nothing other <w>than</w> his new hobby.",
                                "ru": "Он не говорит ни о чем другом, <w>кроме</w> как о своем новом хобби."
                            }
                        }
                    ],
                    "common_phrases": [
                        "niets dan"
                    ],
                    "target_lang_definitions": {
                        "en": "nothing other than; except",
                        "ru": "ничего другого, кроме; исключая"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "but",
                                "target_lang_sense_clarification": "except for"
                            },
                            {
                                "target_lang_word": "than",
                                "target_lang_sense_clarification": "other than"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "кроме",
                                "target_lang_sense_clarification": "за исключением"
                            },
                            {
                                "target_lang_word": "как",
                                "target_lang_sense_clarification": "в оборотах 'не что иное, как'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b47ce6ac-ab7d-3b83-a075-10d3431e9094",
                    "sense_definition": "een graad van vaardigheid in Japanse vecht- of denksporten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "martial_arts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft onlangs zijn derde <w>dan</w> in karate behaald.",
                            "target_lang_translations": {
                                "en": "He recently achieved his third <w>dan</w> in karate.",
                                "ru": "Он недавно получил свой третий <w>дан</w> по карате."
                            }
                        },
                        {
                            "text": "De grootmeester in het go-spel heeft de hoogste graad van negende <w>dan</w> bereikt.",
                            "target_lang_translations": {
                                "en": "The grandmaster in the game of Go has reached the highest rank of ninth <w>dan</w>.",
                                "ru": "Гроссмейстер в игре го достиг высшей степени — девятого <w>дана</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eerste dan",
                        "zwarte band"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a degree of skill in Japanese martial arts or games like Go",
                        "ru": "степень мастерства в японских боевых искусствах или интеллектуальных играх"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dan",
                                "target_lang_sense_clarification": "rank in martial arts"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дан",
                                "target_lang_sense_clarification": "разряд в боевых искусствах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}