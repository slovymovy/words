                "senses": [
                    {
                        "sense_id": "c7b949ee-c969-3e75-9f49-81a5ab947b8e",
                        "entry_id": "a4577184-a8f1-35d4-aec3-760f8509ec41",
                        "glosses": [
                            "ein Maschinenteil, unter anderem bei Flugzeugen"
                        ],
                        "tags": [
                            "Maschinenbau"
                        ],
                        "examples": [
                            {
                                "example_id": "bf028dc5-a08b-435e-86e8-effc6d124c84",
                                "sense_id": "c7b949ee-c969-3e75-9f49-81a5ab947b8e",
                                "text": "So sind die Torque-Motoren der A-Achse in die Seitenwangen des Maschinenuntergestells vollständig integriert. (Internetbeleg)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8151b5a2-7938-3411-8b4d-03c8e0b81c7d",
                        "entry_id": "a4577184-a8f1-35d4-aec3-760f8509ec41",
                        "glosses": [
                            "eine Achse in einem Kristall"
                        ],
                        "tags": [
                            "Mineralogie"
                        ],
                        "examples": [
                            {
                                "example_id": "e1da8f68-05f7-4d90-9b07-ea615dc86045",
                                "sense_id": "8151b5a2-7938-3411-8b4d-03c8e0b81c7d",
                                "text": "„In der Literatur findet man jedoch auch Strukturbestimmungen, in denen die Gleitkomponente in Richtung der a-Achse liegt.“"
                            },
                            {
                                "example_id": "be749b6a-23db-4661-aad2-cd7cab329e04",
                                "sense_id": "8151b5a2-7938-3411-8b4d-03c8e0b81c7d",
                                "text": "„Die Gitterkonstanten werden also, wie bereits in der Abb. 2.19 eingezeichnet, so dargestellt, dass ausgehend vom Ursprung der Elementarzelle — das ist der Nullpunkt — die a-Achse nach vorne zeigt, die b-Achse nach rechts verläuft und die c-Achse nach oben weist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47c5145f-8cd2-4b54-b95f-2a3c93266c4b",
                        "source_entry_id": "a4577184-a8f1-35d4-aec3-760f8509ec41",
                        "source_sense_id": "c7b949ee-c969-3e75-9f49-81a5ab947b8e",
                        "source_sense_description": "Maschinenbau: ein Maschinenteil, unter anderem bei Flugzeugen",
                        "target_lang_word": "longitudinal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "longitudinal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b369657-498e-3237-8911-53f501bf0daf",
                                        "entry_id": "1746e034-45ff-3084-8132-1f32147e43b3",
                                        "glosses": [
                                            "Relating to length."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6a5a05d-4392-4f0f-9303-3c1da2e3ff3a",
                                                "sense_id": "4b369657-498e-3237-8911-53f501bf0daf",
                                                "text": "The motion about the longitudinal axis of an airplane is called roll."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8e61a1d-e6d7-30d4-b202-fcb7ad4c8352",
                                        "entry_id": "1746e034-45ff-3084-8132-1f32147e43b3",
                                        "glosses": [
                                            "Relating to the geographical longitude."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "651a48b8-3d7f-47c2-8320-9d17abefd743",
                                                "sense_id": "d8e61a1d-e6d7-30d4-b202-fcb7ad4c8352",
                                                "text": "The longitudinal position of a ship refers to its angular distance east or west from the prime meridian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d9cdaec-de22-3ecd-bde7-be9cf8bb59dc",
                                        "entry_id": "1746e034-45ff-3084-8132-1f32147e43b3",
                                        "glosses": [
                                            "Running in the direction of the long axis of a body."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c80904ed-1554-4847-8d0e-50d309c25d2b",
                                                "sense_id": "6d9cdaec-de22-3ecd-bde7-be9cf8bb59dc",
                                                "text": "The units have transverse seats, two and three astride the passageway with single or double longitudinal seats alongside the two entrance vestibules in each car."
                                            },
                                            {
                                                "example_id": "2e594fdd-6c5b-42bb-a7da-c4292fb354a7",
                                                "sense_id": "6d9cdaec-de22-3ecd-bde7-be9cf8bb59dc",
                                                "text": "The third rotation is about the longitudinal axis of the thigh."
                                            },
                                            {
                                                "example_id": "efcbdb0e-bc32-45e1-8a45-f06aa9de645e",
                                                "sense_id": "6d9cdaec-de22-3ecd-bde7-be9cf8bb59dc",
                                                "text": "Unlike the older trains, the new units have walk-through carriages and longitudinal rather than transverse seating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b8f0920-b4fb-3d9b-8a6e-f727caa990bb",
                                        "entry_id": "1746e034-45ff-3084-8132-1f32147e43b3",
                                        "glosses": [
                                            "Forward and/or backward, relative to some defined direction."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13194f02-defc-31a3-9898-bf5077f5897c",
                                        "entry_id": "1746e034-45ff-3084-8132-1f32147e43b3",
                                        "glosses": [
                                            "Sampling data over time rather than merely once."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2b14041-331a-4940-9675-626088fa8fa6",
                                                "sense_id": "13194f02-defc-31a3-9898-bf5077f5897c",
                                                "text": "longitudinal studies"
                                            },
                                            {
                                                "example_id": "ee44a068-dda2-4974-9994-99fd5c9010b9",
                                                "sense_id": "13194f02-defc-31a3-9898-bf5077f5897c",
                                                "text": "Examining national longitudinal data, Mossakowski has found that people who were unemployed for long periods in their teens or early 20s are far more likely to develop a habit of heavy drinking (five or more drinks in one sitting) by the time they approach middle age."
                                            }
                                        ]
                                    }
                                ]
