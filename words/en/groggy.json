{
    "word_family": [
        "grogginess"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a1f594d5-9966-3ed2-b173-774e2a9762e1",
                    "sense_definition": "Feeling weak, unsteady, or confused, often due to lack of sleep, illness, or medication.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medicine made him <w>groggy</w> and irritable.",
                            "target_lang_translations": {
                                "ru": "Лекарство сделало его <w>заторможенным</w> и раздражительным."
                            }
                        },
                        {
                            "text": "I felt very <w>groggy</w> after waking up from such a long nap.",
                            "target_lang_translations": {
                                "ru": "Я чувствовал себя очень <w>одурелым</w> после того, как проснулся от такого долгого сна."
                            }
                        }
                    ],
                    "synonyms": [
                        "dazed",
                        "dizzy",
                        "woozy"
                    ],
                    "antonyms": [
                        "alert",
                        "sharp"
                    ],
                    "common_phrases": [
                        "feeling groggy",
                        "waking up groggy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство слабости, неустойчивости или спутанности сознания, часто из-за недостатка сна, болезни или приема лекарств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заторможенный",
                                "target_lang_sense_clarification": "о состоянии вялости и замедленной реакции"
                            },
                            {
                                "target_lang_word": "одурелый",
                                "target_lang_sense_clarification": "о состоянии сильной сонливости или ошеломленности"
                            },
                            {
                                "target_lang_word": "обалделый",
                                "target_lang_sense_clarification": "разговорный вариант, описывающий состояние растерянности и потери ориентации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54b65311-1d99-3a39-8691-dab07837f657",
                    "sense_definition": "Describing a horse that puts its weight primarily on its heels while trotting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "equine_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trainer noticed the horse was <w>groggy</w> during the morning exercise.",
                            "target_lang_translations": {
                                "ru": "Тренер заметил, что лошадь <w>ставит ноги на пятки</w> во время утренней тренировки."
                            }
                        },
                        {
                            "text": "A <w>groggy</w> horse may require special shoeing to correct its gait.",
                            "target_lang_translations": {
                                "ru": "Лошади, <w>наступающей на пятки</w>, может потребоваться специальная подковка для исправления походки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used primarily in equestrian contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описание лошади, которая при рыси переносит основной вес на пятки."
                    },
