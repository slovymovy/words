                    {
                        "form_id": "e30754b9-98a9-47a5-b46d-7549d580ee76",
                        "entry_id": "5827e394-2a5e-34ec-b572-7fef75407b9d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Schlei"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f43e280a-5e2d-33fa-8693-1270d11f4175",
                        "entry_id": "5827e394-2a5e-34ec-b572-7fef75407b9d",
                        "glosses": [
                            "42 km langer Meeresarm der Ostsee im nördlichen Schleswig-Holstein im Norden Deutschlands, der die beiden schleswigschen Landschaften Angeln und Schwansen trennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "836b3f65-2ec2-43cf-b881-2aa1404add0a",
                                "sense_id": "f43e280a-5e2d-33fa-8693-1270d11f4175",
                                "text": "Die Schlei ist ein tolles Segelrevier für Jollen und Jollenkreuzer."
                            },
                            {
                                "example_id": "dcdcf7cc-fe1e-4a51-bf81-d7e865628feb",
                                "sense_id": "f43e280a-5e2d-33fa-8693-1270d11f4175",
                                "text": "Es gibt keine Brücken über die Schlei. Wer ans andere Ufer will, benutzt die Fähre oder schwimmt."
                            },
                            {
                                "example_id": "5176cf0e-1f6a-4b12-97fc-1d8c61800fce",
                                "sense_id": "f43e280a-5e2d-33fa-8693-1270d11f4175",
                                "text": "Es waren vermutlich friesische Kaufleute, die sich im 8. Jahrhundert an der Schlei niederließen, einem 40 km langen, schiffbaren Seitenarm der Ostsee."
                            },
                            {
                                "example_id": "f54dc77f-9941-43dc-a3f2-1e83bbf43fc0",
                                "sense_id": "f43e280a-5e2d-33fa-8693-1270d11f4175",
                                "text": "Bereits im Mittelalter ließen sich die Wikinger in der Siedlung Haithabu an der Schlei nieder."
                            },
                            {
                                "example_id": "485b7935-2526-411c-b10a-2c47372a8c21",
                                "sense_id": "f43e280a-5e2d-33fa-8693-1270d11f4175",
                                "text": "Arnis (dänisch Arnæs) liegt auf einer kleinen Halbinsel der Schlei im Norden Schleswig-Holsteins und ist mit 273 Einwohnern die kleinste Stadt Deutschlands."
                            },
                            {
                                "example_id": "9deec0ee-254b-49a3-b84f-dcf8369427f3",
                                "sense_id": "f43e280a-5e2d-33fa-8693-1270d11f4175",
                                "text": "Angeln (dänisch Angel) ist eine Landschaft zwischen Schlei, Ostsee und Flensburger Förde, im Nordosten Schleswig-Holsteins."
                            },
                            {
                                "example_id": "70fda994-5bdf-4d03-b70d-4851f64a6b01",
                                "sense_id": "f43e280a-5e2d-33fa-8693-1270d11f4175",
                                "text": "Erst vor wenigen Wochen ist in Schleswig ein Umweltskandal [passiert]: aus einer Kläranlage waren massenweise Kunststoffteilchen in die Schlei gelangt."
                            },
                            {
                                "example_id": "19ca6a68-4c4b-452a-8ce2-a286de60a465",
                                "sense_id": "f43e280a-5e2d-33fa-8693-1270d11f4175",
                                "text": "Millionen von Plastikschnipseln gelangten vermutlich über Monate von einer Biogasanlage über das Klärwerk in die Schlei, einen Seitenarm der Ostsee."
                            },
                            {
                                "example_id": "3de3e5c8-6920-468e-88e9-76255685853e",
                                "sense_id": "f43e280a-5e2d-33fa-8693-1270d11f4175",
                                "text": "[…] plötzlich fand sich das Plastik überall. Im Wasser, an der Uferbereichen und auch auf Äckern. Mehrere Tonnen Plastik sind in die Schlei gelangt. Wie viel genau, weiß bis heute niemand."
                            },
                            {
                                "example_id": "afacfcfa-7b1f-49fa-ad57-ebd71a3322e9",
                                "sense_id": "f43e280a-5e2d-33fa-8693-1270d11f4175",
                                "text": "Ein Haus in der ehemaligen DDR kam für [Jurek Becker] nicht in Frage, ihn zog es in den äußersten Norden, nach Schleswig-Holstein - in ein Haus in Sieseby an der Schlei."
                            },
                            {
                                "example_id": "ac7c6253-68d2-447c-97ba-f61507e8dc3b",
                                "sense_id": "f43e280a-5e2d-33fa-8693-1270d11f4175",
                                "text": "Inga Boltz hat als Hotelfachfrau die Welt gesehen, aber vor Anker gegangen ist sie in ihrer Heimat an der Schlei."
                            },
                            {
                                "example_id": "6f90c770-7c1a-4056-ae1a-60c1e9dc5c85",
                                "sense_id": "f43e280a-5e2d-33fa-8693-1270d11f4175",
                                "text": "Die meisten Oberflächengewässer in Deutschland sind allerhöchstens in einem unbefriedigendem ökologischem Zustand. […] Am schlechtesten schneiden die Flusssysteme von Ems (Niedersachsen) und Schlei/Trave (überwiegend Schleswig-Holstein) ab […]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
