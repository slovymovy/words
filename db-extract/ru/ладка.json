            {
                "entry_id": "d81f1169-4fb3-3cf6-a5ce-4d690d2a5193",
                "word": "Ладка",
                "pos": "noun",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9082e62d-8631-373b-8611-2ee4f5a63d0b",
                        "entry_id": "d81f1169-4fb3-3cf6-a5ce-4d690d2a5193",
                        "glosses": [
                            "предположительно, уменьш.-ласк. к Лада"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb208c1a-06ac-483e-ab91-04bbd4e9a9af",
                                "sense_id": "9082e62d-8631-373b-8611-2ee4f5a63d0b",
                                "text": "Дочка моя, Галя моя, на тебе теперь основная тяжесть. Ладка ― маленькая, бабушка ― старая, как ребенок. На тебе они, на тебе…"
                            }
                        ]
                    },
                    {
                        "sense_id": "d5fac57c-ced3-3034-8936-a408599a83e3",
                        "entry_id": "d81f1169-4fb3-3cf6-a5ce-4d690d2a5193",
                        "glosses": [
                            "предположительно, собачья кличка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f85a6f53-d9ad-49f8-bdce-48fe8489c536",
                                "sense_id": "d5fac57c-ced3-3034-8936-a408599a83e3",
                                "text": "― Ладка, фу! ― отогнала Ленка собаку."
                            }
                        ]
                    }
