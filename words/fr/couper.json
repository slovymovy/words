                        "couper en morceaux"
                    ]
                },
                {
                    "sense_id": "2a09f018-08dc-3ebb-87f6-43b448a74864",
                    "sense_definition": "Interrompre ou faire cesser le passage d'un flux, d'une communication ou la parole de quelqu'un.",
