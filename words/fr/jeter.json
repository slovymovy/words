    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9b8670e1-3542-3393-99c2-638e94cbaca2",
                    "sense_definition": "Lancer un objet avec la main ou par un mouvement brusque.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "lancer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant <w>jette</w> la balle en l'air pour amuser son chien dans le jardin."
                        },
                        {
                            "text": "Ne <w>jetez</w> pas de pierres dans la rivière depuis le pont."
                        }
                    ],
                    "synonyms": [
                        "lancer"
                    ],
                    "common_phrases": [
                        "jeter la balle",
                        "jeter une pierre"
                    ]
                },
                {
                    "sense_id": "8384d1da-30b7-3fab-9978-894ce29b5cee",
                    "sense_definition": "Mettre au rebut, abandonner ou se débarrasser d'une chose inutile.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "eliminer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>jeter</w> ces vieux papiers à la poubelle avant notre départ."
                        },
                        {
                            "text": "Elle a <w>jeté</w> tous les emballages vides après avoir déballé ses courses."
                        }
                    ],
                    "common_phrases": [
                        "jeter à la poubelle"
                    ]
                },
                {
                    "sense_id": "de46ecba-f976-39dc-9c16-727d582634b6",
                    "sense_definition": "Diriger rapidement ou soudainement un regard, une attention ou une émotion.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "diriger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vais <w>jeter</w> un coup d'œil à ton dossier pendant la pause."
                        },
                        {
                            "text": "Son attitude suspecte a <w>jeté</w> le doute parmi tous les enquêteurs."
                        }
                    ],
                    "common_phrases": [
                        "jeter un coup d'œil",
                        "jeter un regard",
                        "jeter le doute"
                    ]
                },
                {
                    "sense_id": "d92e0018-f776-345e-b665-375d91f32fea",
                    "sense_definition": "Se porter ou s'élancer impétueusement vers un lieu ou dans une action.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_brusque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants se <w>jettent</w> à l'eau dès que le soleil commence à chauffer."
                        },
                        {
                            "text": "Il s'est <w>jeté</w> sur le travail pour oublier ses soucis quotidiens."
                        }
                    ],
                    "common_phrases": [
                        "se jeter à l'eau",
                        "se jeter sur"
                    ]
                },
                {
                    "sense_id": "48e0cc31-26db-3313-976c-97a4a54e50dd",
                    "sense_definition": "Déboucher ou se déverser dans un cours d'eau, un lac ou une mer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce fleuve majestueux traverse toute la région puis se <w>jette</w> dans la mer."
                        },
                        {
                            "text": "La rivière se <w>jette</w> dans le lac au pied de la montagne."
                        }
                    ],
                    "common_phrases": [
                        "se jeter dans la mer"
                    ]
                },
                {
                    "sense_id": "2a588065-fa24-31b6-b044-1f080305c156",
                    "sense_definition": "Rompre brusquement une relation amoureuse ou congédier quelqu'un sans ménagement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rupture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après trois années de vie commune, sa compagne l'a soudainement <w>jeté</w>."
                        },
                        {
                            "text": "Il craint qu'elle ne le <w>jette</w> dès qu'elle apprendra la vérité."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                }
            ]
        }
    ]
}