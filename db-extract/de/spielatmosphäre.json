                "senses": [
                    {
                        "sense_id": "19418daa-124c-3bbc-94ee-ea112793106a",
                        "entry_id": "40de99cf-d86f-3645-8ea0-a485c0ba4c06",
                        "glosses": [
                            "Stimmung, emotionale Aufladung während eines Spiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e6855c2-d0f1-4821-bc8d-f59fbffc4e76",
                                "sense_id": "19418daa-124c-3bbc-94ee-ea112793106a",
                                "text": "„Seine Wertschätzung für jedes einzelne Gruppenmitglied, seine Fähigkeit, Sympathie, Unterstützung, Anerkennung und Ermutigung auszudrücken, sind für die Spielatmosphäre und für die Gruppenstimmung unter Umständen wesentlich wichtiger als sein fachliches Wissen.“"
                            },
                            {
                                "example_id": "3a18b12c-2d08-4584-81ec-482f5ac8d63d",
                                "sense_id": "19418daa-124c-3bbc-94ee-ea112793106a",
                                "text": "„In der entspannten Spielatmosphäre können sie es wagen, kreative und auch unübliche Verhaltensweisen zu zeigen, ohne Sanktionen und Repressionen fürchten zu müssen.“"
                            },
                            {
                                "example_id": "7023e53e-36af-4168-a12c-e03f83d9bae8",
                                "sense_id": "19418daa-124c-3bbc-94ee-ea112793106a",
                                "text": "„Das anonyme Geständnis ist ein diskretes Spiel. Es hat als Friedensspiel allerdings nur eine Chance, wenn die Spielatmosphäre von gegenseitigem Vertrauen, von Respekt vor dem anderen und von Wohlwollen getragen ist.“"
                            },
                            {
                                "example_id": "01c09fb1-91c5-4852-965c-236eba7bc9c8",
                                "sense_id": "19418daa-124c-3bbc-94ee-ea112793106a",
                                "text": "„Ich hoffe, dass wir eine richtige Spielatmosphäre haben.“"
                            },
                            {
                                "example_id": "8b2d935e-3b75-44ec-9e44-d41d9a06253b",
                                "sense_id": "19418daa-124c-3bbc-94ee-ea112793106a",
                                "text": "„Die Spielatmosphäre, die mich schützte, zerbrach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
