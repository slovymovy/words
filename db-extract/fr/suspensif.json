                                        "glosses": [
                                            "een afgesproken gebaar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fe3a24f-cc15-466a-aefd-1738e26cfa87",
                                                "sense_id": "b250a30b-ba40-34d9-aa6a-24faed8cb95c",
                                                "text": "Eindelijk kreeg hij het teken om van start te gaan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7394e6b9-c55b-3466-8177-9a20fc42d0d8",
