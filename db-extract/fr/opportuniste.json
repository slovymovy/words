        "fr-extract.jsonl": [
            {
                "entry_id": "da509a5b-06d1-3fd5-818f-17979021bae4",
                "word": "opportuniste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "27dc92f2-3cad-4e5e-9fd7-79fc80179710",
                        "entry_id": "da509a5b-06d1-3fd5-818f-17979021bae4",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "opportunistes"
                    },
                    {
                        "form_id": "d6e3ad0e-c3d7-4f90-a16a-2395dbdd44f1",
                        "entry_id": "da509a5b-06d1-3fd5-818f-17979021bae4",
                        "tags": [],
                        "form": "opportunard"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d56277e-3728-307d-a438-5a2940dbd38a",
                        "entry_id": "da509a5b-06d1-3fd5-818f-17979021bae4",
                        "glosses": [
                            "Se dit d’une personne qui s'adapte aux situations se présentant à lui de sorte à en tirer bénéfice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a10480c-2b65-4fd5-9607-4935a34b3bba",
                                "sense_id": "2d56277e-3728-307d-a438-5a2940dbd38a",
                                "text": "Un comportement opportuniste."
                            },
                            {
                                "example_id": "1b5dc34e-54a1-4c9b-bf8a-2a4cdcfb6b4e",
                                "sense_id": "2d56277e-3728-307d-a438-5a2940dbd38a",
                                "text": "Certains champignons peuvent devenir pathogènes de manière opportuniste, c’est-à-dire profiter d’une occasion favorisant leur prolifération, comme par exemple à la suite d’un traitement prolongé aux antibiotiques à l’issue duquel la flore intestinale bactérienne normale d’un animal est susceptible d’être affaiblie, créant les conditions pour que des champignons, habituellement inoffensifs et jusque là contenus, colonisent le milieu."
                            },
                            {
                                "example_id": "d654b654-e839-4681-bebe-4e1cbb36165a",
                                "sense_id": "2d56277e-3728-307d-a438-5a2940dbd38a",
                                "text": "Je suis pour le communisme,\nJe suis pour le socialisme,\nEt pour le capitalisme,\nParce que je suis opportuniste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ba583f7-9f50-48bd-ad8c-c7eb15ca0b2f",
                        "source_entry_id": "da509a5b-06d1-3fd5-818f-17979021bae4",
                        "source_sense_id": "2d56277e-3728-307d-a438-5a2940dbd38a",
                        "target_lang_word": "opportunistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opportunistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae7c60a1-72aa-3f8f-bd31-64af30b61133",
                                        "entry_id": "11e63ad2-98ef-3a3b-98e7-6a032ff97f5f",
                                        "glosses": [
                                            "Taking advantage of situations that arise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01eb35e5-ed2c-40bb-be06-fcddc8d28124",
                                                "sense_id": "ae7c60a1-72aa-3f8f-bd31-64af30b61133",
                                                "text": "The danger now isn't so much from the AIDS virus itself as from opportunistic infections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7127f96-a31e-3e1b-ae52-36dd27be80bc",
                                        "entry_id": "11e63ad2-98ef-3a3b-98e7-6a032ff97f5f",
                                        "glosses": [
                                            "Taking advantage of situations to advance one's own interests without regard for moral principles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a29ab905-3f04-4317-bf3f-b584c66a1581",
                                                "sense_id": "c7127f96-a31e-3e1b-ae52-36dd27be80bc",
                                                "text": "You can't trust somebody that opportunistic: he'll stab you in the back the first chance he gets."
                                            },
                                            {
                                                "example_id": "b845d842-fddd-448d-993e-8ee9bc7b3f25",
                                                "sense_id": "c7127f96-a31e-3e1b-ae52-36dd27be80bc",
                                                "text": "[…] an opportunistic relative masquerading as his rescuer, […]"
                                            },
                                            {
                                                "example_id": "23a02d66-16c8-49ce-b1ba-09e89a33eb02",
                                                "sense_id": "c7127f96-a31e-3e1b-ae52-36dd27be80bc",
                                                "text": "Now, maybe you see this as sort of an obvious and opportunistic publicity play by a competing social-media service. Maybe it even seems crass to you—a little grave-dancy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ab35e9d-4924-4401-80de-09995b5a34c9",
                        "source_entry_id": "da509a5b-06d1-3fd5-818f-17979021bae4",
                        "source_sense_id": "2d56277e-3728-307d-a438-5a2940dbd38a",
