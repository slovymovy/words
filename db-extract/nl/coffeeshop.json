                    }
                ],
                "senses": [
                    {
                        "sense_id": "898d55cf-8f00-3c2a-90ef-197478e12fd0",
                        "entry_id": "b05253b0-e135-3eca-bff9-9eb285ecbf14",
                        "glosses": [
                            "koffiehuis, café"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "602ce01c-2cac-461e-aad6-5ace1bc525a0",
                                "sense_id": "898d55cf-8f00-3c2a-90ef-197478e12fd0",
                                "text": "Wij volgen Bob voor een oogenblik. Nauwelijks heeft deze de coffee-shop verlaten, of zijn gelaat heeft eene tot dus verre schier ongekende uitdrukking gekregen."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ed456b3-3482-3c70-88db-e4436494a874",
                        "entry_id": "b05253b0-e135-3eca-bff9-9eb285ecbf14",
                        "glosses": [
                            "een gelegenheid waar, naast alcohol en/of koffie ook hasj (illegaal) verkrijgbaar was, een plaats waar (in de loop der jaren) de verkoop van softdrugs oogluikend werd toegestaan danwel gedoogd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb687e2d-3e29-4688-a598-e35cb7e3410d",
                                "sense_id": "8ed456b3-3482-3c70-88db-e4436494a874",
                                "text": "De coffeeshop in het brede deel van de galerij zou een trekpleister geworden zijn van allerhande onaangename figuren, hasj-handelaren en schandknapen. Sommige winkeliers laten zelfs het woord „penoze\" vallen."
                            },
                            {
                                "example_id": "ff0f2f90-0d89-4174-931a-8a7200908ad9",
                                "sense_id": "8ed456b3-3482-3c70-88db-e4436494a874",
                                "text": "Het begrip „coffeeshop\" heeft in anderhalf jaar tijd in Amsterdam weer een dubbele betekenis gekregen. Overal in de stad zie je coffeeshops met een geschilderd marihuanablaadje op het raam. Er wordt weed en hasj verkocht. De laatste tijd wint het gebruik van soft drugs terrein ten koste van het gebruik van alcohol."
                            },
                            {
                                "example_id": "3e3c5b21-7a49-4650-9f9c-cd25ddd3047f",
                                "sense_id": "8ed456b3-3482-3c70-88db-e4436494a874",
                                "text": "De toerist zat de hele dag te blowen in de coffeeshop."
                            },
                            {
                                "example_id": "25e2e0d0-2c39-4d4b-b009-82250064dc5a",
                                "sense_id": "8ed456b3-3482-3c70-88db-e4436494a874",
                                "text": "Voor Yang Lulu hoeft dat helemaal niet. Zij heeft Amsterdam al op haar lijstje staan. Vanwege de musea zeker? „Ja natuurlijk”, antwoordt zij op ironische toon om daar snel aan toe te voegen, „en de coffeeshops, want daar heb ik net op internet veel over gelezen”."
                            }
                        ]
                    }
                ],
