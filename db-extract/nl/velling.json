                            {
                                "example_id": "4d69cf3b-1c2d-40e9-afd0-a6c7c6d99899",
                                "sense_id": "44ba7318-dab3-3a11-9ec0-f76e792180c0",
                                "text": "Na de velling geldt een herplantplicht. Er zullen voornamelijk loofbomen worden geplant op de plaats van de sparren. Het is de bedoeling meet variatie aan te brengen in de beplanting om ervoor te zorgen dat ziekten en boomkevers als de letterzetter in de toekomst minder vat op het bos krijgen."
                            },
                            {
                                "example_id": "ce35343f-854c-4495-b7aa-f728643ffcc9",
                                "sense_id": "44ba7318-dab3-3a11-9ec0-f76e792180c0",
                                "text": "Sinds de stillegging van de velling heeft Kormelink toestemming gekregen om op te ruimen wat is gekapt en is ook een aangezegde dwangsom van 10.000 euro van tafel."
                            }
