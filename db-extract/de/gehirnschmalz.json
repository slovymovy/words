                    {
                        "sense_id": "61e966a7-3f3a-3949-a653-c89c76018714",
                        "entry_id": "206828c4-4099-3ca5-a577-aa7da988df31",
                        "glosses": [
                            "brainwork"
                        ],
                        "tags": [
                            "informal",
