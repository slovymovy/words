                                    },
                                    {
                                        "sense_id": "fa212538-da64-332d-bdd5-0a06ba2f9b11",
                                        "entry_id": "a578ddd3-724b-35d2-9ff4-ccc32cd1af5c",
                                        "glosses": [
                                            "The use of natural or artificial material on personnel, objects, or tactical positions with the aim of confusing, misleading, or evading the enemy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2bfaabc-9652-39cb-aed9-e5493bb85d7f",
                                        "entry_id": "a578ddd3-724b-35d2-9ff4-ccc32cd1af5c",
                                        "glosses": [
                                            "A pattern on clothing consisting of irregularly shaped patches that are either greenish/brownish, brownish/whitish, or bluish/whitish, as used by ground combat forces."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d4c6430-afd7-3f69-9f17-7032d0f23e40",
                                        "entry_id": "a578ddd3-724b-35d2-9ff4-ccc32cd1af5c",
                                        "glosses": [
                                            "The resemblance of an organism to its surroundings for avoiding detection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aff7fa6b-bef1-4466-8c1b-82634be41cfe",
                                                "sense_id": "6d4c6430-afd7-3f69-9f17-7032d0f23e40",
                                                "text": "Earless ghost swift moths become “invisible” to echolocating bats by forming mating clusters close[…]above vegetation and effectively blending into the clutter of echoes that the bat receives from the leaves and stems around them. Many insects probably use this strategy, which is a close analogy to crypsis in the visible world—camouflage and other methods for blending into one’s visual background."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7376784-efa2-3880-ba42-429314bbf87b",
                                        "entry_id": "a578ddd3-724b-35d2-9ff4-ccc32cd1af5c",
                                        "glosses": [
                                            "Clothes made from camouflage fabric, for concealment in combat or hunting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "camouflage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1c8691b-7982-3f92-bfc1-2bfe35897c89",
                                        "entry_id": "a394e5be-d6ce-38e8-a13c-7f24d1b8e1f8",
                                        "glosses": [
                                            "To hide or disguise something by covering it up or changing its appearance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cffc29c-7762-4af0-832b-3d9f1401e664",
                                                "sense_id": "b1c8691b-7982-3f92-bfc1-2bfe35897c89",
                                                "text": "THE CONCISE ENCYCLOPAEDIA OF WORLD RAILWAY LOCOMOTIVES. Edited by P. Ransome-Wallis. Hutchinson. 50s.\nA gaudy jacket, remarkably out of keeping with the contents, camouflages the weightiest and meatiest work on a railway topic since the war."
                                            },
                                            {
                                                "example_id": "956e909c-2381-4f6e-b192-07f176a9ea72",
                                                "sense_id": "b1c8691b-7982-3f92-bfc1-2bfe35897c89",
                                                "text": "Elegant brick and stone buildings, with iron and glass canopies and decorative wooden scalloping and fencing—all evidencing care on the part of the architect to produce a pleasing, well-planned building—were submerged beneath a profusion of ill-conceived additions and camouflaged by vulgar paint schemes; and the original conception was lost."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
