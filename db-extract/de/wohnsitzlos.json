                "senses": [
                    {
                        "sense_id": "e17500de-7146-371c-8ab8-a9d6fb64c5d1",
                        "entry_id": "461d1c07-b0c6-339b-b3e4-a5418e9c6a61",
                        "glosses": [
                            "keinen festen Wohnsitz habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71004ee3-4d3e-4f8e-966c-ec188058c1ce",
                                "sense_id": "e17500de-7146-371c-8ab8-a9d6fb64c5d1",
                                "text": "„Er lebte wochenlang wohnsitzlos auf der Straße, bevor er verdreckt und halb verhungert wieder aufgegriffen wurde.“"
                            },
                            {
                                "example_id": "7ddbbf50-f3f7-4a50-b30c-d16afe8e5425",
                                "sense_id": "e17500de-7146-371c-8ab8-a9d6fb64c5d1",
                                "text": "„Der wohnsitzlose junge Mann war der Polizei als Konsument harter Drogen bekannt.“"
                            },
                            {
                                "example_id": "11d7dcef-fd99-4ba7-8eae-6d3079b28c5f",
                                "sense_id": "e17500de-7146-371c-8ab8-a9d6fb64c5d1",
                                "text": "„Wir mussten uns bei einer Diakonie anmelden, da wir ja wohnsitzlos waren und über keine Postadresse verfügten.“"
                            },
                            {
                                "example_id": "9464c6de-8071-44d7-b815-45d6172acc4d",
                                "sense_id": "e17500de-7146-371c-8ab8-a9d6fb64c5d1",
                                "text": "„Eine 30-jährige Klientin berichtet, sie gerate immer wieder an Partner, die drogenabhängig, wohnsitzlos oder massiv psychiatrisch auffällig seien.“"
                            },
                            {
                                "example_id": "ce1c6046-8b0a-4973-bcf2-eedc32d8d7b2",
                                "sense_id": "e17500de-7146-371c-8ab8-a9d6fb64c5d1",
                                "text": "„Doch die, die hier jetzt hausten, waren in den seltensten Fällen wohnsitzlos und schon gar nicht unvermögend.“"
                            },
                            {
                                "example_id": "57a856f5-c80e-45ea-9bd1-183cf83aba20",
                                "sense_id": "e17500de-7146-371c-8ab8-a9d6fb64c5d1",
                                "text": "„Aber welche halbwegs gescheite junge Frau hätte schon etwas mit diesen stinkenden, wohnsitzlosen und ständig betrunkenen Jungs zu tun haben wollen?“"
                            },
                            {
                                "example_id": "e9e95a16-237c-452d-ac4d-2489c07bc63a",
                                "sense_id": "e17500de-7146-371c-8ab8-a9d6fb64c5d1",
                                "text": "„In den Wintermonaten erlaubte mein Chef einem der wohnsitzlosen Patienten, sich auch außerhalb der Sprechzeiten im Wartezimmer aufzuwärmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
