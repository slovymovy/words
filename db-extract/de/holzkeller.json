                "senses": [
                    {
                        "sense_id": "ddd3b375-8331-3426-be8c-804ca4a1cc71",
                        "entry_id": "88463c87-ad8a-3d99-b883-78f2fd0072f1",
                        "glosses": [
                            "unterirdischer Lagerraum für Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "137e3310-3b7d-449a-8a9d-27e203ed4f2a",
                                "sense_id": "ddd3b375-8331-3426-be8c-804ca4a1cc71",
                                "text": "„Daneben ist der Kohlenkeller, und auf der andern Seite, vom Holzkeller mit Brettern abgeteilt, ist eine Art Bude, wo der Hackklotz steht und das Beil an der Wand hängt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "68492cd6-c083-37a8-82bb-ec9c9e17c87b",
                        "entry_id": "88463c87-ad8a-3d99-b883-78f2fd0072f1",
                        "glosses": [
                            "Keller aus Holz errichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ef475a1-698f-46e3-843f-35125191eeee",
                                "sense_id": "68492cd6-c083-37a8-82bb-ec9c9e17c87b",
                                "text": "„Ein hervorragend erhaltener Holzkeller aus der Zeit um 1180, den Archäologen in Lübeck gefunden haben, wird Teil eines Forschungsprojektes.“"
                            },
                            {
                                "example_id": "d744bff5-40d4-42ba-a7e3-9098638ae452",
                                "sense_id": "68492cd6-c083-37a8-82bb-ec9c9e17c87b",
                                "text": "„Bislang sei die Konservierung von Holzkellern immer wieder gescheitert, da die Hölzer austrocknen und zerfallen, sobald sie aus dem feuchten Boden herausgeholt werden, teilte der Bereich Archäologie der Hansestadt Lübeck am Mittwoch mit.“"
                            },
                            {
                                "example_id": "f4fbe1e8-0d62-4604-936d-dd3772d428db",
                                "sense_id": "68492cd6-c083-37a8-82bb-ec9c9e17c87b",
                                "text": "„Unter der südlichen Fahrbahn, direkt nördlich des Eckgebäudes Markt/Steinstraße wurde ein Holzkeller des 14./15. Jahrhunderts und ein möglicher weiterer Holzkeller des 15./16. Jahrhunderts angeschnitten.“"
                            },
                            {
                                "example_id": "da516013-ff51-4c3e-bbb8-c83ced7a322d",
                                "sense_id": "68492cd6-c083-37a8-82bb-ec9c9e17c87b",
                                "text": "„Im 14. Jahrhundert begann man dann, die Erd- und Holzkeller in den Höfen durch Steinbauten zu ersetzten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
