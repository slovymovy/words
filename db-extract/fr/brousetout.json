                    {
                        "sense_id": "badf4181-6b75-39fa-9cf6-f000cc51d65c",
                        "entry_id": "ee59f4dd-7fbb-3180-9ac7-c149fb6f4a10",
                        "glosses": [
                            "Gilet de laine porté par un homme en Suisse romande, par exemple par un Montagnon."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "528f77e5-d78f-4813-81b2-0eee1f98ad78",
                                "sense_id": "badf4181-6b75-39fa-9cf6-f000cc51d65c",
                                "text": "Un gros homme, gros de partout, la figure mâchurée, les cheveux coupés ras, le corps pris dans un brousetout de laine brune, qui parlait lentement et avec solennité"
                            },
                            {
                                "example_id": "03553ba3-a628-4648-b73f-7c5d5daf2e15",
                                "sense_id": "badf4181-6b75-39fa-9cf6-f000cc51d65c",
                                "text": "Bien avant la mode du chandail, le gilet de laine, le brousetout pour les hommes, et, pour les femmes le mantelet, faisaient partie de l'habillement des «Montagnons» (on dit aussi les «Bréviniers»). — (L'Impartial, 3 février 1945)"
                            }
                        ]
                    }
