                    {
                        "translation_id": "e2b16b66-49ba-4a60-9d2c-f1989c8a9650",
                        "source_entry_id": "2bf8ffac-77cc-3e7f-b52b-53b32731ba4e",
                        "source_sense_id": "0b33b789-a06c-3ec8-8a71-88597a155734",
                        "source_sense_description": "een lap stof die voorgebonden wordt gewoonlijk rond de middel om de kleding te beschermen bij huishoudelijke taken zoals het koken of schoonmaken",
                        "target_lang_word": "фартук",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фартук",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3babda19-715c-3f8e-b549-5662a4486a72",
                                        "entry_id": "312ddb52-1d39-362b-bee9-77036fa295a6",
                                        "glosses": [
                                            "предмет одежды, надеваемый для предохранения передней части платья от загрязнения, а также с защитной целью; передник"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ebd489c-c74b-439d-84de-8ba86ef590c1",
                                                "sense_id": "3babda19-715c-3f8e-b549-5662a4486a72",
                                                "text": "Надевай же свой кожаный фартук, труженик, да становись за свой рабочий станок, в своей темной мастерской!"
                                            },
                                            {
                                                "example_id": "603da194-8da1-49ce-babf-32139452e7cd",
                                                "sense_id": "3babda19-715c-3f8e-b549-5662a4486a72",
                                                "text": "Пекарь, надев толстый фартук-набрюшник и уперев в него длинный лист с сырыми еще пряниками, засовывал лист в печь, и там, на поду, в адском жару, от которого светились железные дверцы, тесто превращалось в пряник."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2161f914-b6c8-3035-ab07-a9fe083dc424",
                                        "entry_id": "312ddb52-1d39-362b-bee9-77036fa295a6",
                                        "glosses": [
                                            "кожаное или холщовое покрывало в коляске, экипаже, служащее для предохранения седока от грязи, пыли и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ebff789-46fa-444e-a4c4-adb8d87550d7",
                                                "sense_id": "2161f914-b6c8-3035-ab07-a9fe083dc424",
                                                "text": "Отстегнул приехавший гость фартук, поднялся с груды подушек в ситцевых чехлах и тихонько вылез из кибитки."
                                            },
                                            {
                                                "example_id": "0ed6b921-3b64-4f29-a8db-fde69af93c44",
                                                "sense_id": "2161f914-b6c8-3035-ab07-a9fe083dc424",
                                                "text": "Чутко и вольно разносятся окрики, радостной песней заливаются колокольчики, и снежная пыль летит прямо в лицо и крепко садится на фартук повозки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "797168d8-db26-354b-82ce-7b6de24faa8d",
                                        "entry_id": "312ddb52-1d39-362b-bee9-77036fa295a6",
                                        "glosses": [
                                            "техн. покрышка, чехол или верхняя, покрывающая часть чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dddcc5e6-b962-4798-8d2f-caf37a3c6563",
                                                "sense_id": "797168d8-db26-354b-82ce-7b6de24faa8d",
                                                "text": "Поезд «Заря севера» уважительно тронулся; почтительно отстранив гостя, одетый, в парадную форму, величавый проводник вагона поднял железный фартук."
                                            },
                                            {
                                                "example_id": "cf38fb83-04f5-499c-8b07-ba12096fc5a4",
                                                "sense_id": "797168d8-db26-354b-82ce-7b6de24faa8d",
                                                "text": "Когда фартук бампера становится слишком уж неопрятным, его приходится менять."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0b04c84-0f95-3758-b4a0-fa353972ae80",
                                        "entry_id": "312ddb52-1d39-362b-bee9-77036fa295a6",
                                        "glosses": [
                                            "нижний щиток оконного наличника"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6718f1a-4235-3d9c-accc-7a34f69b55de",
                                        "entry_id": "312ddb52-1d39-362b-bee9-77036fa295a6",
                                        "glosses": [
                                            "специальная панель, устанавливаемая между кухонными навесными шкафами и столешницей (рабочей поверхностью) на стену, защищающая последнюю от брызг, влаги, пара и т.п., также выполняющая декоративную функцию"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41175d82-788b-4d46-a842-25c1507ea0ea",
                                                "sense_id": "b6718f1a-4235-3d9c-accc-7a34f69b55de",
                                                "text": "На кухне с газовой плитой фартук за варочной панелью делают выше, чем в остальной части гарнитура."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "009c6f18-d0f6-4856-bcd0-59e9a247c854",
                        "source_entry_id": "2bf8ffac-77cc-3e7f-b52b-53b32731ba4e",
                        "source_sense_id": "0b33b789-a06c-3ec8-8a71-88597a155734",
                        "source_sense_description": "een lap stof die voorgebonden wordt gewoonlijk rond de middel om de kleding te beschermen bij huishoudelijke taken zoals het koken of schoonmaken",
                        "target_lang_word": "передник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "передник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "883f0cee-82ef-3a6b-9a2a-3ff020b957a9",
                                        "entry_id": "d05fb0e7-ee17-3032-92dc-36bb5ddcad13",
                                        "glosses": [
                                            "предмет одежды, предназначенный для предохранения передней её части от загрязнения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b438d19-a612-4e13-bdbb-01c1e5399109",
                                                "sense_id": "883f0cee-82ef-3a6b-9a2a-3ff020b957a9",
                                                "text": "Синих кафтанов не перечтёшь; при солнечном освещении вас непременно ослепит яркая пестрота шёлковых платков, ситцевых юбок, синих, красных и жёлтых передников и коротаек, из которых очень много плисовых и даже штофных."
                                            },
                                            {
                                                "example_id": "9a5c839a-c2c4-4fe1-89b2-fd0f523d24da",
                                                "sense_id": "883f0cee-82ef-3a6b-9a2a-3ff020b957a9",
                                                "text": "Обеими руками она бережно поддерживала полосатый передник, из которого выглядывали три крошечные головки с красными шейками и чёрными блестящими глазёнками."
                                            },
                                            {
                                                "example_id": "cacdb6bd-f615-44c3-9842-91e5fc66e569",
                                                "sense_id": "883f0cee-82ef-3a6b-9a2a-3ff020b957a9",
                                                "text": "Полиция приказывает им одежду носить или хоть передники, что ли, но как только городовой ихний за угол, сейчас этот самый индеец снял передник и, смотришь, бежит уже так, в чём мать родила."
                                            },
                                            {
                                                "example_id": "c553f5f8-843b-4628-a953-922ee40c2a24",
                                                "sense_id": "883f0cee-82ef-3a6b-9a2a-3ff020b957a9",
                                                "text": "Миша обыкновенно уже стоял в сером холщёвом переднике у верстака, приготовив потребное для урока."
                                            },
                                            {
                                                "example_id": "467dfe3f-9ace-445a-b86c-27f663fd04c9",
                                                "sense_id": "883f0cee-82ef-3a6b-9a2a-3ff020b957a9",
                                                "text": "Белый передник туго обтягивал её грудь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20f7b0f4-8e60-3c3c-8851-51bd90ab90bd",
                                        "entry_id": "d05fb0e7-ee17-3032-92dc-36bb5ddcad13",
                                        "glosses": [
                                            "техн. доска в токарном станке, на которой размещены приспособления для управления движениями станка"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
