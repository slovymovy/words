                "senses": [
                    {
                        "sense_id": "c7a70627-32f9-3f4e-ac61-0b66a05c5ad6",
                        "entry_id": "8334b73b-14f0-3b9a-9f70-340a39277ced",
                        "glosses": [
                            "een ceremonieel, militair hoofddeksel gemaakt van berenvel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ee3b39d-4b57-4f58-941c-ad85744dea44",
                                "sense_id": "c7a70627-32f9-3f4e-ac61-0b66a05c5ad6",
                                "text": "Berenmuts blijft berenmuts – De leden van de beroemde Britse koninklijke garde hoeven hun hoofddeksels van (Canadees) berenvel niet in te ruilen voor een synthetische variant. Dat heeft het Britse ministerie van Defensie gisteren meegedeeld, aldus de Britse omroep BBC."
                            },
                            {
                                "example_id": "2b5a8a17-3e3e-4013-bcbb-b93634e7e04a",
                                "sense_id": "c7a70627-32f9-3f4e-ac61-0b66a05c5ad6",
                                "text": "Bakhuis, Kroek, Kriekjes en Berghuis hebben inmiddels al meermalen in Ahoy geoefend. En dat zijn urenlange, vermoeiende sessies: lopen, stilstaan, aanwijzingen opvolgen en dat steeds met een trommel van zo’n 7 kilo voor je buik. En morgenavond volgt de generale repetitie, waarbij de muzikanten waarschijnlijk in vol ornaat optreden: in het authentieke ceremoniële grenadiersuniform en met een berenmuts op het hoofd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad965435-6325-4657-9849-8a9c33050707",
                        "source_entry_id": "8334b73b-14f0-3b9a-9f70-340a39277ced",
                        "source_sense_id": "c7a70627-32f9-3f4e-ac61-0b66a05c5ad6",
                        "target_lang_word": "busby",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "busby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bc077ff-d216-304a-8f92-1f9c29966fdc",
                                        "entry_id": "5f0179f7-1445-34dc-8707-6b89a64b3042",
                                        "glosses": [
                                            "A fur hat, usually with a plume in the front, worn by certain members of the military or brass bands."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c9bdeb5-beb8-4a70-9289-9c6d70b683b9",
                                                "sense_id": "6bc077ff-d216-304a-8f92-1f9c29966fdc",
                                                "text": "[…] many Khorassanis wearing huge sheepskin busbies, similar to the head-gear of the Roumanians and Tabreez Turks of Ovahjik and the Perso-Turkish border."
                                            },
                                            {
                                                "example_id": "165353a3-738d-443b-a4fa-970ed0cd664a",
                                                "sense_id": "6bc077ff-d216-304a-8f92-1f9c29966fdc",
                                                "text": "They were a fine lot of fellows, in their pale blue, tight-fitting jackets, jaunty busbys and white riding breeches with the double yellow stripe […]"
                                            },
                                            {
                                                "example_id": "550b6d14-3d81-4244-9c64-5e74513105f9",
                                                "sense_id": "6bc077ff-d216-304a-8f92-1f9c29966fdc",
                                                "text": "His head was shaped like a busby, a high solid arrogant rock, covered with thick moss."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45cb5e76-f1aa-4be8-8fc6-891fd160be57",
                        "source_entry_id": "8334b73b-14f0-3b9a-9f70-340a39277ced",
                        "source_sense_id": "c7a70627-32f9-3f4e-ac61-0b66a05c5ad6",
