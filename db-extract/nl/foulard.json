                        "glosses": [
                            "kleed dat de bekleding van een bank, fauteuil of bed bedekt om die te beschermen of uit het zicht te houden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcc9c94c-2219-4fea-b49f-6cba245c4008",
                                "sense_id": "8e6f5231-860f-3191-aef1-8a519b737078",
                                "text": "Ik heb een ambulance gebeld en ik heb de foulard van de bank gehaald omdat ik haar niet durfde te verplaatsen."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf19eb49-cf10-3d0b-acf8-357f68d6fa37",
                        "entry_id": "fe31204f-94a5-3d35-ba08-0e1fb01e0391",
                        "glosses": [
                            "zwierige, halsdoek gemaakt van zijde of katoen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e63e10a5-6182-4536-bcb4-41b6ebac2ec3",
                                "sense_id": "bf19eb49-cf10-3d0b-acf8-357f68d6fa37",
                                "text": "\"Ik heb geen hoofdpijn\", zei hij, het geurige vocht met zijn zijden foulard afwissende, om op deze wijze zijn gezicht te bedekken."
                            }
                        ]
                    },
                    {
                        "sense_id": "1446ab71-c6f1-36d5-9776-27ec457668a9",
                        "entry_id": "fe31204f-94a5-3d35-ba08-0e1fb01e0391",
                        "glosses": [
                            "licht en soepel weefsel uit zijde (soms gemengd met katoen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "091670aa-668e-480e-80e3-037a36bb72b7",
                                "sense_id": "1446ab71-c6f1-36d5-9776-27ec457668a9",
                                "text": "U zou verwonderd zijn geweest als u gezien had wat een ongeschikte kleren de meisjes droegen. Japonnen van foulard en lakschoenen en vreselijk geklede hoeden hadden sommigen van hen. Om mee over rotsen te klimmen, en door de hei en de bremstruiken te lopen!"
                            }
                        ]
                    }
