                "senses": [
                    {
                        "sense_id": "ae2d72d4-b460-3a72-ae06-4da85601ec28",
                        "entry_id": "fec901a7-8bd6-3e03-bc34-be07d83d9ed5",
                        "glosses": [
                            "город в России (Ставропольский край)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6045c440-385f-4dba-8bdb-9b7d16de3107",
                                "sense_id": "ae2d72d4-b460-3a72-ae06-4da85601ec28",
                                "text": "И через пять дней я непременно буду в Георгиевске"
                            },
                            {
                                "example_id": "24b9a91d-273d-4ace-be7a-933a419ee77f",
                                "sense_id": "ae2d72d4-b460-3a72-ae06-4da85601ec28",
                                "text": "Во все время проезда дождь нас мочил и весенний туман проникал до костей; по этой причине мы не могли видеть Бештау, лежащей верст пятьдесят вправо от Георгиевска, с купой целебных источников, сгруппированных у его подножия."
                            }
                        ]
                    }
