{
    "word_family": [
        "abbreviate",
        "abbreviator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b9a1613-5d50-3bbd-8952-4663616d3b98",
                    "sense_definition": "A shortened form of a word or phrase used to represent the whole.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "shortening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word Dr is a common <w>abbreviation</w> for doctor.",
                            "target_lang_translations": {
                                "zh": "Dr 这个词是 doctor 的一种常见<w>缩写</w>。"
                            }
                        },
                        {
                            "text": "Please use a standard <w>abbreviation</w> when writing your address.",
                            "target_lang_translations": {
                                "zh": "写地址时请使用标准<w>缩写</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contraction"
                    ],
                    "antonyms": [
                        "expansion"
                    ],
                    "common_phrases": [
                        "common abbreviation",
                        "standard abbreviation"
                    ],
                    "target_lang_definitions": {
                        "zh": "词语或短语的缩写形式，用于代表整体。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "缩写",
                                "target_lang_sense_clarification": "指词汇或短语的简写形式。"
                            },
                            {
                                "target_lang_word": "简称",
                                "target_lang_sense_clarification": "指名称的简化形式。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdddfafd-3e0a-379f-91c5-1a257d8f90a3",
                    "sense_definition": "The act or process of making something shorter.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shortening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>abbreviation</w> of long reports helps save time for busy managers.",
                            "target_lang_translations": {
                                "zh": "对长篇报告进行<w>缩减</w>有助于为忙碌的经理们节省时间。"
                            }
                        },
                        {
                            "text": "Constant <w>abbreviation</w> of technical terms can make the text hard to read.",
                            "target_lang_translations": {
                                "zh": "不断地对术语进行<w>精简</w>可能会使文章难以阅读。"
                            }
                        }
                    ],
                    "synonyms": [
                        "condensation",
                        "reduction"
                    ],
                    "antonyms": [
                        "expansion"
                    ],
                    "common_phrases": [
                        "process of abbreviation"
                    ],
                    "target_lang_definitions": {
                        "zh": "使某物变短的行为或过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "缩减",
                                "target_lang_sense_clarification": "指使篇幅或内容变短的过程。"
                            },
                            {
                                "target_lang_word": "精简",
                                "target_lang_sense_clarification": "指去掉冗余部分，使内容更简洁。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7571685c-c065-3d30-abd0-0dd06611967f",
                    "sense_definition": "The result of shortening or reducing something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "shortening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This summary is an <w>abbreviation</w> of the original lengthy document.",
                            "target_lang_translations": {
                                "zh": "这份总结是原长篇文档的<w>摘要</w>。"
                            }
                        },
                        {
                            "text": "The final report was just an <w>abbreviation</w> of the full research findings.",
                            "target_lang_translations": {
                                "zh": "最终报告只是完整研究结果的<w>节略</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "summary",
                        "abstract",
                        "epitome"
                    ],
                    "antonyms": [
                        "amplification"
                    ],
                    "target_lang_definitions": {
                        "zh": "缩短或减少某物后的结果。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摘要",
                                "target_lang_sense_clarification": "指对长篇内容的简要概括。"
                            },
                            {
                                "target_lang_word": "节略",
                                "target_lang_sense_clarification": "指删减后的简略版本。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b9763eb-c36e-371a-9c42-9064d526da6e",
                    "sense_definition": "A short form used as a substitute for a complex idea or whole.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shortening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The term is often used as an <w>abbreviation</w> for a much larger social concept.",
                            "target_lang_translations": {
                                "zh": "这个词常被用作一个更大社会概念的<w>代称</w>。"
                            }
                        },
                        {
                            "text": "Using that phrase as an <w>abbreviation</w> for the entire policy is misleading.",
                            "target_lang_translations": {
                                "zh": "用那个短语作为整个政策的<w>代称</w>具有误导性。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用作复杂概念或整体替代品的简短形式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "代称",
                                "target_lang_sense_clarification": "指用简短词汇代表复杂概念。"
                            },
                            {
                                "target_lang_word": "缩影",
                                "target_lang_sense_clarification": "指能代表整体的简短表达。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}