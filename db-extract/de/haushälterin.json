                            "singular"
                        ],
                        "form": "die Haushälterin"
                    },
                    {
                        "form_id": "58873579-40a7-4568-9917-5a95d6dd75d5",
                        "entry_id": "1ed951b7-cf08-30b9-a986-757cce00f065",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Haushälterinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1136d6e7-0279-376a-80d1-a64b182c6b73",
                        "entry_id": "1ed951b7-cf08-30b9-a986-757cce00f065",
                        "glosses": [
                            "Berufsbezeichnung für Frauen, die anderen Personen den privaten Haushalt führen, die anfallenden Hausarbeiten erledigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44408770-302e-4d58-9a69-91328ca0139f",
                                "sense_id": "1136d6e7-0279-376a-80d1-a64b182c6b73",
                                "text": "Das Gerücht, dass unser Pfarrer seit Jahren ein heimliches Verhältnis mit seiner Haushälterin hat, hält sich hartnäckig."
                            },
                            {
                                "example_id": "50aca24e-a25e-40af-9d3e-5080bb81380c",
                                "sense_id": "1136d6e7-0279-376a-80d1-a64b182c6b73",
                                "text": "„Zwei Frauen teilen die Kellerbehausung mit der Großmutter: ihre Schwester Mirjam und ihre längjährige Haushälterin, Vertraute und Freundin Hannah Brandt.“"
                            },
                            {
                                "example_id": "4a50cf55-f724-44d3-b720-efb2cdf58f98",
                                "sense_id": "1136d6e7-0279-376a-80d1-a64b182c6b73",
                                "text": "„Jeder wusste, dass seine Haushälterin gleich nach der Abendandacht alles mit der Schubkarre ins Pfarramt schaffte.“"
                            },
                            {
                                "example_id": "4a0bbc4f-edde-436d-bc84-2040758ef349",
                                "sense_id": "1136d6e7-0279-376a-80d1-a64b182c6b73",
                                "text": "„Es bestand aus einem Mailänder Haushofmeister namens Carnicelli, einem Ablate, der ihm als Sekretär diente, weil er nicht schreiben konnte, einer alten Frau, die als Haushälterin bezeichnet wurde, einem Koch, seiner grundhäßlichen Frau und acht bis zehn Lakaien.“"
                            },
                            {
                                "example_id": "4b0b219e-02d1-4551-9748-9d6eee3544df",
                                "sense_id": "1136d6e7-0279-376a-80d1-a64b182c6b73",
                                "text": "„Ein mürrischer Farmer, der Kinder hasst, heiratet seine hübsche Haushälterin, Mutter eines sechsjährigen Jungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a6e158a-d405-4250-9d3f-0de2f50883f8",
                        "source_entry_id": "1ed951b7-cf08-30b9-a986-757cce00f065",
                        "source_sense_id": "1136d6e7-0279-376a-80d1-a64b182c6b73",
                        "target_lang_word": "housekeeper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "housekeeper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8aa04d6d-69df-38e6-bda1-a7bc1b4a1d1a",
                                        "entry_id": "31fa9f87-4d57-38f4-862b-da400c810dd7",
                                        "glosses": [
                                            "Someone (traditionally a woman) employed to look after the home, typically by managing domestic servants or superintending household management; also someone with equivalent duties in a hotel, institution etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f97d267c-1205-45e1-9ddd-0c4eb235e3f5",
                                                "sense_id": "8aa04d6d-69df-38e6-bda1-a7bc1b4a1d1a",
                                                "text": "She was their third housekeeper, but after a month or so she also gave up."
                                            },
                                            {
                                                "example_id": "d758d069-de83-419b-97f3-1bbfb8455807",
                                                "sense_id": "8aa04d6d-69df-38e6-bda1-a7bc1b4a1d1a",
                                                "text": "The housekeeper, a very decorative brunette of thirty-five with a pseudo-English accent, greeted him with a mixture of grateful effusion and condescending patronage."
                                            },
                                            {
                                                "example_id": "b5290bc2-d2ec-4bbc-ba92-93dd9e0e4c64",
                                                "sense_id": "8aa04d6d-69df-38e6-bda1-a7bc1b4a1d1a",
                                                "text": "When management of the toney Copley Plaza Hotel ordered housekeepers recently to put down their mops and hand wash the floors, a furor arose among the hotel cleaning staff. Local union representatives and others concerned with issues affecting women workers also rallied in anger to protest the directive, which in essence forced housekeepers to scrub on their hands and knees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd9e989a-2dbd-3cc0-ba97-c25c924b9b1d",
                                        "entry_id": "31fa9f87-4d57-38f4-862b-da400c810dd7",
                                        "glosses": [
                                            "Someone who manages the running of a home, traditionally the female head of the household."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e159c92d-13fb-3709-b753-1e9cf532d57a",
                                        "entry_id": "31fa9f87-4d57-38f4-862b-da400c810dd7",
                                        "glosses": [
                                            "Someone who keeps to their house; someone who rarely ventures away from home; an unadventurous person, a homebody."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d99a1c5-597d-47c1-9461-df01748e8e99",
                                                "sense_id": "e159c92d-13fb-3709-b753-1e9cf532d57a",
                                                "text": "I do assure you he is no house-keeper. I have seen him in desperate conflict with savage men, and even with His Majesty's redcoats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56d6c736-be06-3dec-92ac-f6381b2f59bf",
                                        "entry_id": "31fa9f87-4d57-38f4-862b-da400c810dd7",
                                        "glosses": [
                                            "Someone who owns a house as a place of residence; a householder."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "264b4640-745f-4c0e-9e43-5fdd1b300388",
                                                "sense_id": "56d6c736-be06-3dec-92ac-f6381b2f59bf",
                                                "text": "He was often heard to express his fears of coming upon the parish; and to bless God, that, on account of his having been so long a housekeeper, he was intitled to that provision."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60447347-344e-40e4-b925-dbae2df6d997",
                        "source_entry_id": "1ed951b7-cf08-30b9-a986-757cce00f065",
                        "source_sense_id": "1136d6e7-0279-376a-80d1-a64b182c6b73",
                        "target_lang_word": "gouvernante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gouvernante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d1df326-71bf-32c2-b651-e94d93864670",
                                        "entry_id": "377ccfa2-9a33-3a0f-944a-1bafc36f3f94",
                                        "glosses": [
                                            "Femme à laquelle on confie l’éducation d’un ou de plusieurs enfants."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "note": "Pour une fonction similaire pour un homme, on emploie gouverneur",
                                        "examples": [
                                            {
                                                "example_id": "a62c9627-7a59-44ca-87e1-c4a4a9e8b2da",
                                                "sense_id": "2d1df326-71bf-32c2-b651-e94d93864670",
                                                "text": "[…], et, quoiqu'elle n'eût pas été élevée très religieusement, elle avait demandé a sa gouvernante de la conduire à l'église Saint-Augustin où affluaient, ce jour-là, les pénitentes de distinction."
                                            },
                                            {
                                                "example_id": "464e1ad7-67b5-4309-9e33-f306d96e549d",
                                                "sense_id": "2d1df326-71bf-32c2-b651-e94d93864670",
                                                "text": "Cette odeur de chou, de crevettes et de gingembre grésillant ensemble me reporta seize année en arrière, à l’époque où ma douce gouvernante Nishio-san me concoctait le même régal, que je n’avais jamais plus remangé depuis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f2c6286-16f2-30e0-9f98-604299c9a981",
                                        "entry_id": "377ccfa2-9a33-3a0f-944a-1bafc36f3f94",
                                        "glosses": [
                                            "Femme qui a soin du ménage d’un homme veuf ou célibataire."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33c4ac1f-0b55-45b5-b8c8-af2664a875e9",
                                                "sense_id": "5f2c6286-16f2-30e0-9f98-604299c9a981",
                                                "text": "Ne faites pas fi d’une jeune et jolie servante qui ne recule pas d’horreur à l’idée d’être un jour la vieille gouvernante du poëte, un peu sa mère, un peu sa ménagère, un peu sa raison, un peu sa richesse."
                                            },
                                            {
                                                "example_id": "038b80d2-aa51-46ba-aaeb-c712bed1e6dc",
                                                "sense_id": "5f2c6286-16f2-30e0-9f98-604299c9a981",
                                                "text": "L’abbé Plomb est privé de sa gouvernante qui s’absente, cette après-midi, et il prend son repas, chez nous ; […]."
                                            },
                                            {
                                                "example_id": "637262ac-3d93-47b3-a05c-9740eb8c4f85",
                                                "sense_id": "5f2c6286-16f2-30e0-9f98-604299c9a981",
                                                "text": "[…]: il y a dans la salle une petite sœur de la charité, une Badoise qui parle le français et qui, avant de prendre la cornette, a servi comme gouvernante chez le marquis de C... en Bretagne, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abc6f9ea-3ea0-3515-890b-c761cae3dc8f",
                                        "entry_id": "377ccfa2-9a33-3a0f-944a-1bafc36f3f94",
                                        "glosses": [
                                            "Employée responsable du ménage des chambres et du personnel affecté à ce travail."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Hôtellerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3382b455-8a57-4447-9f5f-8f772fc09353",
                                                "sense_id": "abc6f9ea-3ea0-3515-890b-c761cae3dc8f",
                                                "text": "Gouvernante d’étage ; Gouvernante générale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a53bbf35-6b42-3150-afd0-040f8b5f75f7",
                                        "entry_id": "377ccfa2-9a33-3a0f-944a-1bafc36f3f94",
                                        "glosses": [
                                            "Femme chargée de la direction d’une subdivision administrative de premier niveau, comme une province ou un État, une colonie ou un grand établissement financier."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "note": "Pour une fonction similaire pour un homme, on emploie gouverneur (et, autrefois, parfois gouvernant",
                                        "examples": [
                                            {
                                                "example_id": "c4da0c40-4f9d-4569-965f-ecec2159364d",
                                                "sense_id": "a53bbf35-6b42-3150-afd0-040f8b5f75f7",
                                                "text": "Plusieurs princesses de la maison d’Autriche ont été gouvernantes des Pays-Bas."
                                            },
                                            {
                                                "example_id": "998f785c-cdd6-4acb-987a-9cc788eccb71",
                                                "sense_id": "a53bbf35-6b42-3150-afd0-040f8b5f75f7",
                                                "text": "Dans les deux cas, Isabelle de Lorraine est instituée vicaire générale, lieutenante, rectrice et gouvernante (vicariam generalem, vicegerentem, locumtenentem, rectricem, et gubernatricem)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gouvernante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c397b2a-c086-3ea0-b640-07fe370533e0",
                                        "entry_id": "f839712b-f0ac-3a68-a542-716f8aa36b3d",
                                        "glosses": [
                                            "Féminin singulier de gouvernant."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "892fc3d5-4264-4707-a8e2-766abd1b4130",
                                                "sense_id": "9c397b2a-c086-3ea0-b640-07fe370533e0",
                                                "text": "De là les progrès des beaux-arts dans ce quinzième siècle, où la liberté (entendez toujours la liberté d’alors, la liberté gouvernante et non jouissante) commençait si fort à languir."
                                            },
                                            {
                                                "example_id": "8a19a941-843b-4b62-a851-a5f94ced6487",
                                                "sense_id": "9c397b2a-c086-3ea0-b640-07fe370533e0",
                                                "text": "J’ai eu ici avant-hier en votre honneur un des chefs électoraux de la coterie gouvernante à l’Académie, M. de Lacretelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
