                                "target_senses": [
                                    {
                                        "sense_id": "a26c9fb2-2f2f-3ada-9e74-d631f71779b8",
                                        "entry_id": "ad6dfae2-b7c6-3bd2-82c5-3820f2010ea4",
                                        "glosses": [
                                            "The tip of a toe of an ungulate such as a horse, ox or deer, strengthened by a thick keratin covering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a45656f-aaf5-4181-a3f5-23d1c3631d3b",
                                                "sense_id": "a26c9fb2-2f2f-3ada-9e74-d631f71779b8",
                                                "text": "[…] I ſee\nTh’ Inſulting Tyrant prancing o’er the Field\nStrow’d with Rome’s Citizens, and drench’d in Slaughter,\nHis Horſe’s Hoofs wet with Patrician Blood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6aea929-2b98-318a-8b9a-98cf9284d0b6",
                                        "entry_id": "ad6dfae2-b7c6-3bd2-82c5-3820f2010ea4",
                                        "glosses": [
                                            "The human foot."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96c48244-c6f1-4e29-84c7-3032fa9ef841",
                                                "sense_id": "f6aea929-2b98-318a-8b9a-98cf9284d0b6",
                                                "text": "Get your hooves off me!"
                                            },
                                            {
                                                "example_id": "2f757c96-bf06-4a36-866e-a12223633d79",
                                                "sense_id": "f6aea929-2b98-318a-8b9a-98cf9284d0b6",
                                                "text": "He is a huge man, six feet four on bare hoofs and composed of two hundred and seventy pounds of solid bone and muscle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9cfd01f-2b71-3586-a43b-29845a5a66d4",
                                        "entry_id": "ad6dfae2-b7c6-3bd2-82c5-3820f2010ea4",
                                        "glosses": [
                                            "An ungula."
                                        ],
