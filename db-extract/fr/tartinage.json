                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43828712-f66b-46e1-ba24-0c09e05147c0",
                                                "sense_id": "873ff864-d34a-36d7-8a85-873b0912f51d",
                                                "text": "And so, unfortunately, this great and spreading network of railways, that recently showed such promise as a major instrument in the modern development of China, must be left for the time being in the melting-pot of Armageddon."
                                            },
                                            {
                                                "example_id": "e0cb3c5c-f7b4-42d2-ac93-263132ec6926",
                                                "sense_id": "873ff864-d34a-36d7-8a85-873b0912f51d",
                                                "text": "As towns continue to grow, replanting vegetation has become a form of urban utopia and green roofs are spreading fast. Last year 1m square metres of plant-covered roofing was built in France, as much as in the US, and 10 times more than in Germany, the pioneer in this field."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spreading",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b6777bf-5469-3789-9c2d-d5e34a83e26a",
                                        "entry_id": "01785eaa-863e-3efd-aaee-98584d484a24",
                                        "glosses": [
                                            "The act by which something is spread."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee3bd58f-9da9-4865-ac1c-3c44c5ec0cd5",
                                                "sense_id": "6b6777bf-5469-3789-9c2d-d5e34a83e26a",
                                                "text": "Small numbers [of meadowlarks] remain on farms in the southern counties throughout the winter, usually relying on fresh manure spreadings for food when snow covers the fields."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spreading",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c589549-5d7d-3c93-b0e6-0bff9d4fd88f",
                                        "entry_id": "e23bb84c-7cb4-3bbe-a25f-418e780b443e",
                                        "glosses": [
                                            "The act of spreading (speedreading)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1ac19ef-62de-4479-9cfb-30b5c35223df",
                                                "sense_id": "0c589549-5d7d-3c93-b0e6-0bff9d4fd88f",
                                                "text": "Chief among the strategies exploiting this rule was \"spreading\" (a combination of \"speed\" and \"reading\"), where debaters would rattle off arguments at a blistering pace. Their speeches often exceeded 300 words per minute. (A conversational pace is about 60 per minute.)"
                                            },
                                            {
                                                "example_id": "ef0ce2c4-20ba-4170-8943-1b0263a9c424",
                                                "sense_id": "0c589549-5d7d-3c93-b0e6-0bff9d4fd88f",
                                                "text": "The NSDA currently boasts more than one hundred and fifty thousand student participants (per affiliated team rosters), many of whom compete in Lincoln–Douglas or policy. The activities are distinct in structure—policy is two-on-two—but they operate similarly on the national circuit, and involve spreading and other experimental tactics."
                                            }
                                        ]
                                    }
