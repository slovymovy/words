                        "target_lang_word": "paddle steamer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paddle steamer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e40f5b4e-e942-352f-8c21-6f5f9ff4aacf",
                                        "entry_id": "1146ab3c-d40e-365b-85f9-1f151b49fecd",
                                        "glosses": [
                                            "A steam-powered vessel propelled by one or two paddle wheels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8c1c3b4-7ab9-4fce-832c-c29783173e6e",
                                                "sense_id": "e40f5b4e-e942-352f-8c21-6f5f9ff4aacf",
                                                "text": "In the second volume of his autobiography, he writes of a journey up the Padma by paddle steamer (built, as it happens, on the river outside my window), where the dry season had exposed many sandbanks..."
                                            },
                                            {
                                                "example_id": "8cdfdb06-e09f-4f61-bf9c-2fcf096279d8",
                                                "sense_id": "e40f5b4e-e942-352f-8c21-6f5f9ff4aacf",
                                                "text": "By the 1880s, the pretty harbour village of Lynmouth was enjoying an influx of holidaymakers brought by paddle steamers from the likes of Bristol and Swansea."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
