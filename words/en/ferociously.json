{
    "word_family": [
        "ferocious",
        "ferocity",
        "ferociousness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a20b3212-61df-3ff1-b347-a6617371f9cd",
                    "sense_definition": "In a savage, fiercely aggressive, or violent manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lion defended its young cubs <w>ferociously</w> against the intruding predator.",
                            "target_lang_translations": {
                                "nl": "De leeuw verdedigde haar jonge welpen <w>woest</w> tegen het binnendringende roofdier."
                            }
                        },
                        {
                            "text": "The two teams fought <w>ferociously</w> for control of the ball until the final whistle.",
                            "target_lang_translations": {
                                "nl": "De twee teams streden tot het eindsignaal <w>verwoed</w> om het balbezit."
                            }
                        }
                    ],
                    "synonyms": [
                        "fiercely",
                        "savagely",
                        "viciously"
                    ],
                    "antonyms": [
                        "gently",
                        "peacefully"
                    ],
                    "common_phrases": [
                        "fight ferociously",
                        "bark ferociously",
                        "attack ferociously"
                    ],
                    "target_lang_definitions": {
                        "nl": "Op een woeste, fel agressieve of gewelddadige manier."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "woest",
                                "target_lang_sense_clarification": "wild en agressief"
                            },
                            {
                                "target_lang_word": "verwoed",
                                "target_lang_sense_clarification": "met grote felheid en verbetenheid"
                            },
                            {
                                "target_lang_word": "verbitterd",
                                "target_lang_sense_clarification": "fel en hardvochtig vechtend"
                            },
                            {
                                "target_lang_word": "wild",
                                "target_lang_sense_clarification": "ongebreideld en gewelddadig"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0869d87-d191-322e-847c-9e4c758b7824",
                    "sense_definition": "To an extreme or intense degree; exceedingly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company operates in a <w>ferociously</w> competitive global market.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf opereert in een <w>moordend</w> competitieve wereldwijde markt."
                            }
                        },
                        {
                            "text": "She has remained <w>ferociously</w> independent throughout her long professional career.",
                            "target_lang_translations": {
                                "nl": "Gedurende haar lange professionele carrière is ze <w>fel</w> onafhankelijk gebleven."
                            }
                        }
                    ],
                    "synonyms": [
                        "intensely",
                        "extremely",
                        "fiercely"
                    ],
                    "antonyms": [
                        "mildly",
                        "slightly"
                    ],
                    "common_phrases": [
                        "ferociously competitive",
                        "ferociously independent",
                        "ferociously loyal"
                    ],
                    "target_lang_definitions": {
