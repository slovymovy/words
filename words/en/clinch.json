                {
                    "sense_id": "ec0a787c-6ca0-30bb-96ed-b2e0202ca550",
                    "sense_definition": "A passionate or romantic embrace.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lovers were caught in a passionate <w>clinch</w>.",
