                "senses": [
                    {
                        "sense_id": "5a85d7fc-002b-3b3d-81aa-19eb5d4aa980",
                        "entry_id": "ff031f2a-dcac-3ee2-b038-8cf799d02830",
                        "glosses": [
                            "Stabsoffiziersdienstgrad zwischen dem SS-Hauptsturmführer und dem SS-Obersturmbannführer"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "c959b943-dccc-4b48-abd1-eda459bed0ed",
                                "sense_id": "5a85d7fc-002b-3b3d-81aa-19eb5d4aa980",
                                "text": "„1942 beförderte man ihn dann zum SS-Sturmbannführer (vergleichbar einem Major) und 1942 zum Legationsrat I. Klasse im Persönlichen Stab des Reichsaußenministers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "095b4809-9c79-3485-9210-c1e67f7eef78",
                        "entry_id": "ff031f2a-dcac-3ee2-b038-8cf799d02830",
                        "glosses": [
                            "Offizier im Range eines SS-Sturmbannführers (Anrede: „Sturmbannführer“)"
                        ],
                        "tags": [
                            "Schutzstaffel"
                        ],
                        "examples": [
                            {
                                "example_id": "42d6184e-6ec5-4c4a-81f8-33850752fcc9",
                                "sense_id": "095b4809-9c79-3485-9210-c1e67f7eef78",
                                "text": "„Seit er als SS-Sturmbannführer Kittel in Peter Zadeks legendärer ‚Ghetto‘-Inszenierung 1984 seinen Durchbruch hatte, verkörperte Ulrich Tukur mindestens ein Dutzend Mal Figuren des Dritten Reiches.“"
                            },
                            {
                                "example_id": "8b1a2ed3-34cc-4af6-84bb-1bae23e0aa27",
                                "sense_id": "095b4809-9c79-3485-9210-c1e67f7eef78",
                                "text": "„Er hat dies mit einer nicht rituellen Zeremonie in Marzabotto gemacht, wo die ‚mörderische Ekstase‘ des SS-Sturmbannführers Walter Reder und seines Bataillons getobt hatte.“"
                            },
                            {
                                "example_id": "c3354a21-c327-4359-85ec-9ef672d70345",
                                "sense_id": "095b4809-9c79-3485-9210-c1e67f7eef78",
                                "text": "„Warum sonst hätte er, der SS-Sturmbannführer Bluthund Dienels, seinen Tod in dieser Art inszenieren sollen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
