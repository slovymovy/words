{
    "word_family": [
        "naval"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "84e2ee4c-083a-3141-8854-9bd41255090f",
                    "sense_definition": "A country's entire maritime military force, including ships and personnel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "military_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "People who get seasick easily shouldn't join the <w>navy</w>.",
                            "target_lang_translations": {
                                "ru": "Людям, которых легко укачивает, не стоит идти служить на <w>флот</w>.",
                                "zh": "容易晕船的人不应该加入<w>海军</w>。"
                            }
                        },
                        {
                            "text": "My brother serves as an officer in the <w>navy</w>.",
                            "target_lang_translations": {
                                "ru": "Мой брат служит офицером в <w>военно-морском флоте</w>.",
                                "zh": "我哥哥在<w>海军</w>担任军官。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "join the navy",
                        "in the navy",
                        "merchant navy",
                        "Royal Navy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Военно-морские силы страны, включая корабли и личный состав.",
                        "zh": "一个国家的全部海上军事力量，包括舰船和人员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флот",
                                "target_lang_sense_clarification": "вооруженные силы"
                            },
                            {
                                "target_lang_word": "вое́нно-морско́й фло́т",
                                "target_lang_sense_clarification": "официальное название"
                            },
                            {
                                "target_lang_word": "ВМФ",
                                "target_lang_sense_clarification": "аббревиатура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "海军",
                                "target_lang_sense_clarification": "国家海上武装力量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8efbf5a7-6df6-3298-bbe3-41d0e97ee697",
                    "sense_definition": "A dark blue colour, usually called navy blue.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "color_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The uniform is available in black or <w>navy</w>.",
                            "target_lang_translations": {
                                "ru": "Форма доступна в чёрном или <w>тёмно-синем цвете</w>.",
                                "zh": "制服有黑色或<w>藏青色</w>可选。"
                            }
                        },
                        {
                            "text": "She decided to wear <w>navy</w> to the evening event.",
                            "target_lang_translations": {
                                "ru": "Она решила надеть <w>тёмно-синее</w> на вечернее мероприятие.",
                                "zh": "她决定穿<w>藏青色</w>的衣服参加晚间活动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in navy",
                        "wear navy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тёмно-синий цвет.",
                        "zh": "一种深蓝色，通常称为藏青色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тёмно-си́ний цвет",
                                "target_lang_sense_clarification": "оттенок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "藏青色",
                                "target_lang_sense_clarification": "深蓝色"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3b45e06a-e3ce-3b99-81a0-45926a7b3a43",
                    "sense_definition": "Having the dark blue colour of navy blue.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "color_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a <w>navy</w> jacket to the interview.",
                            "target_lang_translations": {
                                "ru": "Он надел <w>тёмно-синий</w> пиджак на собеседование.",
                                "zh": "他穿着一件<w>藏青色</w>夹克去参加面试。"
                            }
                        },
                        {
                            "text": "The <w>navy</w> curtains blocked out most of the light.",
                            "target_lang_translations": {
                                "ru": "<w>Тёмно-синие</w> шторы не пропускали большую часть света.",
                                "zh": "<w>藏青色</w>的窗帘挡住了大部分光线。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "navy blue",
                        "navy suit",
                        "navy blazer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий тёмно-синий цвет.",
                        "zh": "具有藏青色的颜色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тёмно-си́ний",
                                "target_lang_sense_clarification": "цвет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "藏青色的",
                                "target_lang_sense_clarification": "形容词，指颜色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73446063-eabc-3e45-aee4-fa978160731f",
                    "sense_definition": "Belonging to the navy; typical of the navy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lieutenant Lindquist is <w>navy</w> through and through.",
                            "target_lang_translations": {
                                "ru": "Лейтенант Линдквист — <w>флотский</w> до мозга костей.",
                                "zh": "林德奎斯特中尉骨子里就是个<w>海军</w>人。"
                            }
                        },
                        {
                            "text": "His disciplined attitude was as <w>navy</w> as his uniform.",
                            "target_lang_translations": {
                                "ru": "Его дисциплинированность была такой же <w>флотской</w>, как и его форма.",
                                "zh": "他那纪律严明的态度和他身上的制服一样，都透着<w>海军</w>风范。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "navy through and through"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к военно-морскому флоту; типичный для флота.",
                        "zh": "属于海军的；海军特有的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флотский",
                                "target_lang_sense_clarification": "характерный для флота"
                            },
                            {
                                "target_lang_word": "военно-морской",
                                "target_lang_sense_clarification": "относящийся к ВМФ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "海军的",
                                "target_lang_sense_clarification": "所属关系"
                            },
                            {
                                "target_lang_word": "海军风格的",
                                "target_lang_sense_clarification": "特征描述"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}