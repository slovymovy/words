                                "target_senses": [
                                    {
                                        "sense_id": "47bcec34-1e65-330e-adcc-50bebbda87ff",
                                        "entry_id": "40b4f7e1-ca7b-3d87-8f87-dcfcb48dff20",
                                        "glosses": [
                                            "Habitant ou natif de Lutèce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03551f22-4d67-4da3-88c0-70ea36a44796",
                                                "sense_id": "47bcec34-1e65-330e-adcc-50bebbda87ff",
                                                "text": "Les Lutéciens étoient les habitans de la capitale du païs des Parisiens ; …"
                                            },
                                            {
                                                "example_id": "84b0a23c-09ef-42ee-a7cc-048cbb10c4f4",
                                                "sense_id": "47bcec34-1e65-330e-adcc-50bebbda87ff",
                                                "text": "Les Lutéciens savent les élever avec art, et les garantir du froid et des intempéries de l’air, avec de la paille de froment."
                                            },
                                            {
                                                "example_id": "84a7766d-8565-4d6d-86af-f8003818bdd5",
                                                "sense_id": "47bcec34-1e65-330e-adcc-50bebbda87ff",
                                                "text": "Là vivaient les Sénonais, les Tricasses, les Carnutes, les Lutéciens et les Génabiens …"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
