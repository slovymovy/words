{
    "word_family": [
        "correlation",
        "correlative",
        "correlational",
        "uncorrelated"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5654cca6-ba79-3c97-9b48-f06c67076d9a",
                    "sense_definition": "To have a mutual relationship or connection, in which one thing affects or depends on another.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "relationship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Researchers found that high levels of stress often <w>correlate</w> with poor sleep quality.",
                            "target_lang_translations": {
                                "ru": "Исследователи обнаружили, что высокий уровень стресса часто <w>коррелирует</w> с плохим качеством сна."
                            }
                        },
                        {
                            "text": "The data shows that income levels <w>correlate</w> strongly with educational attainment in this region.",
                            "target_lang_translations": {
                                "ru": "Данные показывают, что уровень доходов сильно <w>соотносится</w> с уровнем образования в этом регионе."
                            }
                        }
                    ],
                    "synonyms": [
                        "correspond",
                        "interrelate",
                        "connect"
                    ],
                    "antonyms": [
                        "differ",
                        "clash"
                    ],
                    "common_phrases": [
                        "correlate strongly with",
                        "directly correlate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находиться во взаимной связи или зависимости, при которой одно влияет на другое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коррелировать",
                                "target_lang_sense_clarification": "быть взаимосвязанным по признакам"
                            },
                            {
                                "target_lang_word": "соотноситься",
                                "target_lang_sense_clarification": "находиться в соотношении или связи"
                            },
                            {
                                "target_lang_word": "взаимосвязан",
                                "target_lang_sense_clarification": "иметь взаимную связь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6396c4f3-c268-3628-a9d9-fa211d2d9925",
                    "sense_definition": "To establish a mutual relationship or connection between two or more things.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "relationship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to <w>correlate</w> these two sets of figures because they were collected differently.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>соотнести</w> эти два набора цифр, так как они были собраны по-разному."
                            }
                        },
                        {
                            "text": "The scientist tried to <w>correlate</w> the findings from the lab with real-world observations.",
                            "target_lang_translations": {
                                "ru": "Ученый пытался <w>сопоставить</w> результаты лабораторных исследований с реальными наблюдениями."
                            }
                        }
                    ],
                    "synonyms": [
                        "associate",
                        "link",
                        "compare"
                    ],
                    "antonyms": [
                        "separate",
                        "disconnect"
                    ],
                    "common_phrases": [
                        "correlate the findings",
                        "attempt to correlate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устанавливать взаимную связь, зависимость или соотношение между двумя или более предметами или явлениями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соотносить",
                                "target_lang_sense_clarification": "устанавливать соотношение или сравнивать"
                            },
                            {
                                "target_lang_word": "сопоставлять",
                                "target_lang_sense_clarification": "сравнивать для установления связи"
                            },
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "устанавливать логическую связь"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48f8ffcf-3e30-377d-b29f-b1ad44f568b7",
                    "sense_definition": "Each of two or more related things which may even be complementary to each other.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "related_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The study identified physical activity as a significant <w>correlate</w> of mental well-being.",
                            "target_lang_translations": {
                                "ru": "Исследование определило физическую активность как значимый <w>коррелят</w> психического благополучия."
                            }
                        },
                        {
                            "text": "Scientists are searching for a biological <w>correlate</w> for this specific behavioral trait.",
                            "target_lang_translations": {
                                "ru": "Ученые ищут биологическое <w>соответствие</w> для этой конкретной поведенческой черты."
                            }
                        }
                    ],
                    "synonyms": [
                        "equivalent",
                        "counterpart",
                        "correlative"
                    ],
                    "common_phrases": [
                        "biological correlate",
                        "statistical correlate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Каждый из двух или более взаимосвязанных или дополняющих друг друга предметов или признаков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коррелят",
                                "target_lang_sense_clarification": "взаимосвязанное понятие или предмет"
                            },
                            {
                                "target_lang_word": "соответствие",
                                "target_lang_sense_clarification": "соотносящийся показатель"
                            },
                            {
                                "target_lang_word": "эквивалент",
                                "target_lang_sense_clarification": "равноценный или соответствующий объект"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}