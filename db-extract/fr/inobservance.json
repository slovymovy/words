                "senses": [
                    {
                        "sense_id": "db0f6108-6e71-30d5-81db-0e26f992476d",
                        "entry_id": "65377f3b-c15b-3b14-ac23-d8478c68342d",
                        "glosses": [
                            "Défaut d’observance ; manque habituel à observer des prescriptions (médicales, morales, religieuses, etc)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a6e77ef-6642-4cc2-840c-09bf92850852",
                                "sense_id": "db0f6108-6e71-30d5-81db-0e26f992476d",
                                "text": "C’est sur l’inobservance de cette loi que sont construits la plupart des effets comiques où l’on met en scène un imbécile, incapable de se soustraire à une pente traîtreusement engageante, la plupart des mots d’esprit où l’auditeur est victime d’une « attrape »."
                            },
                            {
                                "example_id": "a92d3615-298f-418d-8163-b299751d1c05",
                                "sense_id": "db0f6108-6e71-30d5-81db-0e26f992476d",
                                "text": "Dans les pays développés, la moitié des patients atteints de maladie chronique ne se conforme pas à leurs prescriptions médicales. En France, cette inobservance provoquerait, chaque année, 12 morts prématurées et plusieurs milliards d’euros de pertes pour l’Assurance-maladie."
                            }
                        ]
                    }
                ],
