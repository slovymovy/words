                                        "entry_id": "99289362-ae75-344a-a2f4-cc1a1a30ed26",
                                        "glosses": [
                                            "Having much or unlimited potential to develop in a certain way, especially in a desirable fashion."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f82eda3-0389-39ee-a6ff-aa9fe4d4b918",
                                        "entry_id": "99289362-ae75-344a-a2f4-cc1a1a30ed26",
                                        "glosses": [
                                            "Able to develop into more than one mature cell or tissue type, but not all."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3c3d807-ee4b-447e-a8e7-e0493bbbc953",
                                                "sense_id": "3f82eda3-0389-39ee-a6ff-aa9fe4d4b918",
                                                "text": "After injecting the virus into the eye, the pluripotent genes were then switched on by feeding the mouse an antibiotic."
                                            },
                                            {
                                                "example_id": "2f26a479-a48c-4e42-9b3a-7f8c160b9049",
                                                "sense_id": "3f82eda3-0389-39ee-a6ff-aa9fe4d4b918",
                                                "text": "As the embryo grows, ‘pluripotent’ stem cells appear, which are limited in their potency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
