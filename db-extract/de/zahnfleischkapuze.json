                ],
                "senses": [
                    {
                        "sense_id": "668861b6-de67-3acd-995f-332b9a98c4f5",
                        "entry_id": "093847f8-d3cf-3d09-ae54-c2744d6db9fc",
                        "glosses": [
                            "partielle Zahnfleischabdeckung eines Zahnes bei erschwertem Zahndurchbruch"
                        ],
                        "tags": [
                            "Zahnmedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "1c9311b3-da28-4723-83fb-4d8867290532",
                                "sense_id": "668861b6-de67-3acd-995f-332b9a98c4f5",
                                "text": "„Der Zubiß ist durch Einbeißen des Gegenzahnes in die geschwollene Zahnfleischkapuze schmerzhaft gestört.“"
                            },
                            {
                                "example_id": "eaa32de0-89b7-4b3a-8f42-fa7841d213d1",
                                "sense_id": "668861b6-de67-3acd-995f-332b9a98c4f5",
                                "text": "„Die Zahnfleischkapuze ist aufgequollen wie ein kleiner Ballon, auf Druck entlädt sich eine klare Flüssigkeit (kein Pus), die Schmerzen sind heftig, stechend, brennend.“"
                            },
                            {
                                "example_id": "5b432f66-35ea-4e53-8c26-77b25267768a",
                                "sense_id": "668861b6-de67-3acd-995f-332b9a98c4f5",
                                "text": "„Nur ausnahmsweise gelingt ein ausreichender Abfluss durch Einlegen einer Drainage (Gazestreifen) zwischen Zahnkrone und Zahnfleischkapuze.“"
                            },
                            {
                                "example_id": "62ab266d-46ba-4168-9490-071be4704802",
                                "sense_id": "668861b6-de67-3acd-995f-332b9a98c4f5",
                                "text": "„Bei der Dentitio difficilis wird entweder durch medikamentöse Behandlung oder durch Entfernen der Zahnfleischkapuze mit einem Skalpell oder einer Kapuzenstanze (Kappenstanze) versucht, den erschwerten Zahndurchbruch zu lindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
