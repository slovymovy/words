                                        "glosses": [
                                            "Any organic compound having multiple hydroxyl functional groups, such as polyhydric alcohols."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83c3c03f-416d-45c5-9e4b-173441e6f51e",
                                                "sense_id": "62b669ab-55b6-3d73-90fb-139dd3144573",
                                                "text": "a team at the Ames Research Center in California announced that the Murchison rock also contained complex strings of sugars called polyols, which had not been found off the Earth before."
