                ],
                "senses": [
                    {
                        "sense_id": "05785b4b-173a-31bf-9bd4-37510f1922f0",
                        "entry_id": "f0a929a7-ccde-3857-8b04-41da82e61570",
                        "glosses": [
                            "aus Wolle gefertigter Handschuh"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee7539d0-178e-44d4-8dbb-801f9d860fac",
                                "sense_id": "05785b4b-173a-31bf-9bd4-37510f1922f0",
                                "text": "„Dieses Gewicht konnte sich um weitere fünf bis sechs Kilogramm erhöhen, zählte man, so Isabelle Brandauer, das Gewehr mitsamt Riemen hinzu, oder wenn im Winter Wollhandschuhe, Gamaschen, gestrickte Unterhemden und -hosen oder diverses Feldgerät, wie Kochgeschirr, Wassereimer, Spaten oder eine Laterne, noch zusätzlich zu tragen waren.“"
                            },
                            {
                                "example_id": "5d535540-36ac-40b6-9d67-cbbf5caa39cb",
                                "sense_id": "05785b4b-173a-31bf-9bd4-37510f1922f0",
                                "text": "„Brane stapelt also gleich wieder die Skier in den Außenkorb, zieht nach dem letzten Paar seine weißen Wollhandschuhe aus und setzt mit knurrendem Magen die Schneekatze ruckelnd in Bewegung.“"
                            },
                            {
                                "example_id": "a7d04af2-39c3-4490-b867-471b79bbad86",
                                "sense_id": "05785b4b-173a-31bf-9bd4-37510f1922f0",
                                "text": "„Er warf sich auf die Knie, drehte sich und trug zeitweise blinkende Wollhandschuhe, mit denen er das imaginäre Instrument spielte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
