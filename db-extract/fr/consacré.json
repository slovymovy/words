                "senses": [
                    {
                        "sense_id": "e571db9a-5b11-36ec-81ed-0d16e8105477",
                        "entry_id": "b04401bd-1eca-3a21-ad0e-66bf861b2c34",
                        "glosses": [
                            "Qui est exclusivement dédié à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66e2c8c0-03e8-4f2c-971a-164fcf9eecc7",
                                "sense_id": "e571db9a-5b11-36ec-81ed-0d16e8105477",
                                "text": "Au-delà de ce domaine de tension, le nombre d’impulsions recommence à croître, mais cela correspond à des impulsions parasites dont nous étudierons la cause dans le paragraphe suivant, consacré au compteur de Geiger."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffdeeae2-e0bb-3e6f-b19a-16a3c88c81ef",
                        "entry_id": "b04401bd-1eca-3a21-ad0e-66bf861b2c34",
                        "glosses": [
                            "Qualifie un terme ou un mot qui est tellement propre et usité pour signifier une certaine chose, qu’on ne peut pas se servir d’un autre mot sans parler improprement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fa7ae96-5c44-45a4-a458-756dd6483f40",
                                "sense_id": "ffdeeae2-e0bb-3e6f-b19a-16a3c88c81ef",
                                "text": "Quand ils entendaient sept ou huit voix de demoiselles et de jeunes gens déglubant les phrases consacrées par lesquelles les commis répondent aux observations des acheteurs, la journée était belle, il faisait beau !"
                            }
                        ]
                    },
                    {
                        "sense_id": "92dfcdc6-3857-3ec7-9e79-e48702fd2080",
                        "entry_id": "b04401bd-1eca-3a21-ad0e-66bf861b2c34",
                        "glosses": [
                            "Qui a reçu le sacrement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d02ca1ee-6f9f-4020-a485-8db348101e20",
                                "sense_id": "92dfcdc6-3857-3ec7-9e79-e48702fd2080",
                                "text": "Au vu des faits retenus dans l'Ancien Testament pour exclure les paganistes de toute union consacrée, on aurait pu penser que la survenue du catholicisme allait rendre les choses plus simples."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03060cc2-76a0-4b39-abb2-2a95c1f8efba",
                        "source_entry_id": "b04401bd-1eca-3a21-ad0e-66bf861b2c34",
                        "source_sense_description": "Dédié exclusivement",
                        "target_lang_word": "landläufig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "landläufig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7ce56e8-114b-3d1e-bbf7-198403b59918",
                                        "entry_id": "9ed74978-556e-3270-a025-a1572d84cf73",
                                        "glosses": [
                                            "weit verbreitet, üblich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "231f1169-1fc2-4408-bdf6-f51069c6220f",
                                                "sense_id": "b7ce56e8-114b-3d1e-bbf7-198403b59918",
                                                "text": "„Die landläufige Vorstellung von Leben, die gewissermaßen saisonal eingeteilt war in Zeiten des Heranwachsens, des Blühens und Verblühens, ist von der modernen Altersforschung widerlegt.“"
                                            },
                                            {
                                                "example_id": "328c1787-b111-4131-845c-bd508fd4ffc3",
                                                "sense_id": "b7ce56e8-114b-3d1e-bbf7-198403b59918",
                                                "text": "„Wir haben seit dem 11. September weitaus mehr Mitglieder der al-Qaida gefangen genommen, als man landläufig annimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
