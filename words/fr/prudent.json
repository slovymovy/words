                {
                    "sense_id": "62e87c3f-f2af-390e-be09-325fa5564a12",
                    "sense_definition": "Qui agit avec circonspection et prend des précautions pour éviter les dangers ou les erreurs.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut être très <w>prudent</w> quand on conduit sur une route verglacée."
                        },
                        {
                            "text": "Les randonneurs sont restés <w>prudents</w> à l'approche de la falaise escarpée."
                        }
                    ],
                    "synonyms": [
                        "attentif",
                        "circonspect",
                        "précautionneux",
                        "sage"
                    ],
                    "antonyms": [
