                                "target_senses": [
                                    {
                                        "sense_id": "ff233140-2cae-31ce-8ae1-26fc38a99f10",
                                        "entry_id": "13936d7c-dc59-3e70-8560-1a0e8125927a",
                                        "glosses": [
                                            "Violence, or its equivalent, carried out in cyberspace or on the Internet."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c0c597a-d261-4396-a79d-185e42c3cfdb",
                                                "sense_id": "ff233140-2cae-31ce-8ae1-26fc38a99f10",
                                                "text": "...threats of personal violence, actual acts of cyberviolence (spamming those making the assertions)..."
                                            },
                                            {
                                                "example_id": "d49434cd-1912-4a7d-b674-8b7f04da8c4e",
                                                "sense_id": "ff233140-2cae-31ce-8ae1-26fc38a99f10",
                                                "text": "At one end of the spectrum of cyberviolence lies hate speech, which tends to impact upon specific social, political or religious groups."
                                            },
                                            {
                                                "example_id": "e05aa1ac-e7fb-45b1-bdd7-ca0e99298076",
                                                "sense_id": "ff233140-2cae-31ce-8ae1-26fc38a99f10",
                                                "text": "Cybercrime often involves cyberviolence that puts the personal safety of citizens at risk through, for example, the manipulation of the emotions..."
                                            },
                                            {
                                                "example_id": "6091caf2-a255-4192-ab35-f98c742aa1c1",
                                                "sense_id": "ff233140-2cae-31ce-8ae1-26fc38a99f10",
                                                "text": "At the core of rape, domestic violence, pedophilia, cyberviolence, and other interactions, one discovers precisely a way of being that is grounded in domination and reduces others simply to objects."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
