                            {
                                "target_word": "trial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2dd92aa-24d4-30b1-8639-dff5a10f3aef",
                                        "entry_id": "d9766020-a0bc-331e-bfe6-c28bf13b20b2",
                                        "glosses": [
                                            "To carry out a series of tests on (a new product, procedure etc.) before marketing or implementing it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dffd3c18-476c-4207-959d-15004d4f8a32",
                                                "sense_id": "f2dd92aa-24d4-30b1-8639-dff5a10f3aef",
                                                "text": "The warning system was extensively trialed before being fitted to all our vehicles."
                                            },
                                            {
                                                "example_id": "0cae3519-ab4a-4bf8-842d-e8f9bc40b1ed",
                                                "sense_id": "f2dd92aa-24d4-30b1-8639-dff5a10f3aef",
                                                "text": "In the week beginning April 6, the company began trialling the new processes - these include greater spacing, split shifts, additional safety requirements and washing facilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dd84b77-d987-363a-a216-01255c060cb3",
                                        "entry_id": "d9766020-a0bc-331e-bfe6-c28bf13b20b2",
                                        "glosses": [
                                            "To try out (a new player) in a sports team."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56745584-c2f2-436c-b764-4bffa5a6027e",
                                                "sense_id": "9dd84b77-d987-363a-a216-01255c060cb3",
                                                "text": "The team trialled a new young goalkeeper in Saturday's match, with mixed results."
                                            }
                                        ]
                                    }
                                ]
                            },
