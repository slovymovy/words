                    },
                    {
                        "form_id": "c94f028c-7729-4b43-b9d5-35925973b7bb",
                        "entry_id": "af798604-6d46-3d87-8b1a-288e810e3674",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "допо́лнивши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dcc1d3ac-76d3-3f91-a587-cc1a859c95e6",
                        "entry_id": "af798604-6d46-3d87-8b1a-288e810e3674",
                        "glosses": [
                            "сделать более полным, добавив, прибавив что-либо к уже имеющемуся; пополнить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "844fea9b-a4c4-40b5-9c8c-fba1d3eda135",
                                "sense_id": "dcc1d3ac-76d3-3f91-a587-cc1a859c95e6",
                                "text": "Вот я и попыталась крошечными наблюдениями дополнить некоторые известные всем портреты."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b5bd21b-1b79-3252-aab4-95b32312954f",
                        "entry_id": "af798604-6d46-3d87-8b1a-288e810e3674",
                        "glosses": [
                            "сочетаясь с чем-либо, образовать более цельную, полную общность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8effdbd6-1265-4732-98dc-028860b24ab6",
                                "sense_id": "7b5bd21b-1b79-3252-aab4-95b32312954f",
                                "text": "― Не ограничено ли понятие традиционного классического Возрождения в свете вашей концепции возрождения духовного? Не следовало бы их взаимно дополнить?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ef84e60-c47a-4dd3-b529-a2f7915f94eb",
                        "source_entry_id": "af798604-6d46-3d87-8b1a-288e810e3674",
                        "target_lang_word": "add",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "add",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12895f7c-2260-3d49-aa58-869331679283",
                                        "entry_id": "74c7271f-3e08-36b4-bb63-9f50103c482b",
                                        "glosses": [
                                            "To join or unite (e.g. one thing to another, or as several particulars) so as to increase the number, augment the quantity, or enlarge the magnitude, or so as to form into one aggregate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f40cdc1d-1e02-393d-a614-ca1a43f3a480",
                                        "entry_id": "74c7271f-3e08-36b4-bb63-9f50103c482b",
                                        "glosses": [
                                            "To sum up; to put together mentally; to add up."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb17b72f-6ff7-4638-aea7-63c7480d9451",
                                                "sense_id": "f40cdc1d-1e02-393d-a614-ca1a43f3a480",
                                                "text": "to add numbers"
                                            },
                                            {
                                                "example_id": "7ce9916f-4ea3-44e8-a9d8-f7b7ea02c2c5",
                                                "sense_id": "f40cdc1d-1e02-393d-a614-ca1a43f3a480",
                                                "text": "[…]as easily as he can add together the ideas of two days or two years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4298bc13-6a83-3dd4-90cd-d514dff9c05c",
                                        "entry_id": "74c7271f-3e08-36b4-bb63-9f50103c482b",
                                        "glosses": [
                                            "To combine elements of (something) into one quantity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41b661f4-a240-4207-a404-dd6f57b4e9e3",
                                                "sense_id": "4298bc13-6a83-3dd4-90cd-d514dff9c05c",
                                                "text": "to add a column of numbers"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e6e0b05-f22d-395a-b306-127d33cf2117",
                                        "entry_id": "74c7271f-3e08-36b4-bb63-9f50103c482b",
                                        "glosses": [
                                            "To give by way of increased possession (to someone); to bestow (on)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79f347c2-3f37-4ab2-9a43-2aa9a730fd29",
                                                "sense_id": "8e6e0b05-f22d-395a-b306-127d33cf2117",
                                                "text": "The Lord shall add to me another son."
                                            },
                                            {
                                                "example_id": "3977a839-b7d5-49c1-b4e2-94e427dc6b17",
                                                "sense_id": "8e6e0b05-f22d-395a-b306-127d33cf2117",
                                                "text": "Back to thy punishment, False fugitive, and to thy speed add wings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e28510be-db96-3081-9ec3-c6d1069d8126",
                                        "entry_id": "74c7271f-3e08-36b4-bb63-9f50103c482b",
                                        "glosses": [
                                            "To append (e.g. a statement); to say further information."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6da5feab-f251-4617-9f2a-921922a27a92",
                                                "sense_id": "e28510be-db96-3081-9ec3-c6d1069d8126",
                                                "text": "He added that he would willingly consent to the entire abolition of the tax"
                                            },
                                            {
                                                "example_id": "00bc6dc5-2aae-4d3d-b7d1-7ec9dbd8fc79",
                                                "sense_id": "e28510be-db96-3081-9ec3-c6d1069d8126",
                                                "text": "\"Bless your dear heart,\" she said, \"I am sure I can tell you of a way to get back to Kansas.\" Then she added, \"But, if I do, you must give me the Golden Cap.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69ec2c84-248f-3460-8b24-e6f808ed2c33",
                                        "entry_id": "74c7271f-3e08-36b4-bb63-9f50103c482b",
                                        "glosses": [
                                            "To intensify; to augment; to increase."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0980d12-b7ec-494e-9d12-a74b052cab41",
                                                "sense_id": "69ec2c84-248f-3460-8b24-e6f808ed2c33",
                                                "text": "It adds to our anxiety."
                                            },
                                            {
                                                "example_id": "805ada46-f1e6-426e-8b83-8b2531ea31d1",
                                                "sense_id": "69ec2c84-248f-3460-8b24-e6f808ed2c33",
                                                "text": "I will add to your yoke"
                                            },
                                            {
                                                "example_id": "e9819423-d7ae-4600-83c4-6741a279bab5",
                                                "sense_id": "69ec2c84-248f-3460-8b24-e6f808ed2c33",
                                                "text": "Mostly, the microbiome is beneficial.[…]Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism. Dr Yoshimoto and his colleagues would like to add liver cancer to that list."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce8345be-fc38-3d8c-ae92-6e3d4523d148",
                                        "entry_id": "74c7271f-3e08-36b4-bb63-9f50103c482b",
                                        "glosses": [
                                            "To perform the arithmetical operation of addition."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b86cfc6-a514-477e-874e-092c98eda370",
                                                "sense_id": "ce8345be-fc38-3d8c-ae92-6e3d4523d148",
                                                "text": "He adds rapidly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6887ee00-67dd-3078-84ec-ec6a7eb07f5e",
                                        "entry_id": "74c7271f-3e08-36b4-bb63-9f50103c482b",
                                        "glosses": [
                                            "To summon minions or reinforcements."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "434fc3f3-ef3a-475b-bbce-067e0a3aa671",
                                                "sense_id": "6887ee00-67dd-3078-84ec-ec6a7eb07f5e",
                                                "text": "Typically, a hostile mob will add whenever it's within the aggro radius of a player."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec257621-3ba9-3b46-b79a-2b72a3b6367a",
                                        "entry_id": "74c7271f-3e08-36b4-bb63-9f50103c482b",
                                        "glosses": [
                                            "To add someone as a friend."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "add",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "731c35e4-fbb6-3763-aa31-da371e87fe16",
                                        "entry_id": "e5d3e2c7-5f26-329a-83f1-3b24e287eb4a",
                                        "glosses": [
                                            "The addition of a song to a station's playlist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41d0a7bc-7e6c-4460-9571-930224794e08",
                                                "sense_id": "731c35e4-fbb6-3763-aa31-da371e87fe16",
                                                "text": "In a typical week, 10 to 15 songs may be up for consideration as “adds” of new songs for the station's playlist."
                                            },
                                            {
                                                "example_id": "2a0dd1d9-0f35-4e03-afea-c344ae0acca4",
                                                "sense_id": "731c35e4-fbb6-3763-aa31-da371e87fe16",
                                                "text": "Effectiveness of their work is measured by the number of “adds” they receive on the airplay charts of major trades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6fafee4-35c3-30ff-96b7-1a068ebb5ce3",
                                        "entry_id": "e5d3e2c7-5f26-329a-83f1-3b24e287eb4a",
                                        "glosses": [
                                            "An act or instance of adding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9a8d2a3-26c2-41a2-beb4-3dd6489acfdc",
                                                "sense_id": "a6fafee4-35c3-30ff-96b7-1a068ebb5ce3",
                                                "text": "List the number of adds and multiplies for each of the forms (6) , (7), and (8)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f90c8cc3-62e9-3b52-96a5-1189b6d2763a",
                                        "entry_id": "e5d3e2c7-5f26-329a-83f1-3b24e287eb4a",
                                        "glosses": [
                                            "An additional enemy that joins a fight after the primary target."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c94c5d2-1113-4c7f-a210-c3c0003ecd22",
                                                "sense_id": "f90c8cc3-62e9-3b52-96a5-1189b6d2763a",
                                                "text": "When the player has fought the boss for one minute, two adds will arrive from the back and must be dealt with."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c92e154-ceb9-4bdc-b129-86a95967b742",
                        "source_entry_id": "af798604-6d46-3d87-8b1a-288e810e3674",
                        "target_lang_word": "supplement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supplement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a6db4c6-5ac8-3398-87b5-8a7576ef17b5",
                                        "entry_id": "9611b9c8-ea05-315b-bbcd-cddfae69756b",
                                        "glosses": [
                                            "Something added; especially, such an addition added to make up for a deficiency."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fe961f1-a82e-4871-9fc6-2edf09104616",
                                                "sense_id": "2a6db4c6-5ac8-3398-87b5-8a7576ef17b5",
                                                "text": "Near-synonyms: see Thesaurus:adjunct"
                                            },
                                            {
                                                "example_id": "9cd2676d-6e15-4f1d-8e5e-30dab34787c5",
                                                "sense_id": "2a6db4c6-5ac8-3398-87b5-8a7576ef17b5",
                                                "text": "Athletes' use of herbal supplements has skyrocketed in the past two decades. At the top of the list of popular herbs are echinacea and ginseng, whereas garlic, St. John's wort, soybean, ephedra and others are also surging in popularity or have been historically prevalent."
                                            },
                                            {
                                                "example_id": "48ccd9f1-7cf3-431d-9d73-bf4d1363f5a8",
                                                "sense_id": "2a6db4c6-5ac8-3398-87b5-8a7576ef17b5",
                                                "text": "AI models will not completely replace the humans, she said, but will serve as a “supplement” intended to aid in the brand’s representation of various sizes, skin tones and ages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60daae5b-6ca5-31e2-832c-5f0b63836bf3",
                                        "entry_id": "9611b9c8-ea05-315b-bbcd-cddfae69756b",
                                        "glosses": [
                                            "An extension to a document or publication that adds information, corrects errors, or brings up to date."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e031790-2b87-3133-8572-4dfa0844d196",
                                        "entry_id": "9611b9c8-ea05-315b-bbcd-cddfae69756b",
                                        "glosses": [
                                            "An additional section of a newspaper devoted to a specific subject; an additional section of a journal issue, or an additional issue, for a similar purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "197e5b0c-526a-4121-8937-22b6c4268e2b",
                                                "sense_id": "7e031790-2b87-3133-8572-4dfa0844d196",
                                                "text": "the literary supplement"
                                            },
                                            {
                                                "example_id": "75b96754-2bb7-41a1-b645-b4446a47b1f6",
                                                "sense_id": "7e031790-2b87-3133-8572-4dfa0844d196",
                                                "text": "\"Mid-Lent, and the Enemy grins,\" remarked Selwyn as he started for church with Nina and the children. Austin, knee-deep in a dozen Sunday supplements, refused to stir; poor little Eileen was now convalescent from grippe, but still unsteady on her legs; her maid had taken the grippe, and now moaned all day: \"Mon dieu! Mon dieu! Che fais mourir!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6576990c-aaa0-36fb-ad40-53498025410f",
                                        "entry_id": "9611b9c8-ea05-315b-bbcd-cddfae69756b",
                                        "glosses": [
                                            "An angle that, when added to a given angle, makes 180°; a supplementary angle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a33f81d-2947-36ae-8776-1f936a38dfa2",
                                        "entry_id": "9611b9c8-ea05-315b-bbcd-cddfae69756b",
                                        "glosses": [
                                            "A vitamin, herbal extract, or chemical compound ingested to meet dietary deficiencies or enhance muscular development; the dosage form that conveys or embodies it (e.g., tablet, capsule, pill, powder, beverage)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "815d6735-84d8-4b92-ad72-646bfe8beaf6",
                                                "sense_id": "9a33f81d-2947-36ae-8776-1f936a38dfa2",
                                                "text": "Vitamins, minerals, and essential fatty acids must come from either the diet or supplements."
                                            },
                                            {
                                                "example_id": "75da0ce1-24c8-403d-8dff-f1c629f2e99b",
                                                "sense_id": "9a33f81d-2947-36ae-8776-1f936a38dfa2",
                                                "text": "Menstruators are likelier to need an iron supplement than non-menstruators, whose diet alone is usually sufficient."
                                            },
                                            {
                                                "example_id": "c1e2b8e0-b6ce-4f11-966b-97b1d51650a5",
                                                "sense_id": "9a33f81d-2947-36ae-8776-1f936a38dfa2",
                                                "text": "She wasn't getting enough iron, so they prescribed a supplement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f3e3233-a0ad-374f-a141-c10638c4b941",
                                        "entry_id": "9611b9c8-ea05-315b-bbcd-cddfae69756b",
                                        "glosses": [
                                            "A surcharge, additional cost, especially for food in a restaurant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ea20d37-58e4-4913-b3cf-0e464a4322bb",
                                                "sense_id": "5f3e3233-a0ad-374f-a141-c10638c4b941",
                                                "text": "There is a £2 supplement if you choose the steak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d266ba6-bf65-3797-ae58-1782927647ac",
                                        "entry_id": "9611b9c8-ea05-315b-bbcd-cddfae69756b",
                                        "glosses": [
                                            "An adjunct that is nonessential, especially a supplementary relative clause."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "supplement",
