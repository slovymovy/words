                "senses": [
                    {
                        "sense_id": "5472503b-43d4-3b98-a4d0-efa00d628b37",
                        "entry_id": "bd5da119-a6f5-3d5d-8a9e-3964574b77b1",
                        "glosses": [
                            "Jeune soldat appelé sous les drapeaux par la réquisition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e85d6afc-c47d-4d0e-bcfa-be3b67df6517",
                                "sense_id": "5472503b-43d4-3b98-a4d0-efa00d628b37",
                                "text": "Un réquisitionnaire se récria : on se moquait du Peuple, ils n’avaient que leurs bâtons et, à moins qu’on ne les renvoie chez eux, ils voulaient des armes ; ils étaient doute capables de se battre puisqu’on les avait réquisitionnés."
                            },
                            {
                                "example_id": "2dd32ae7-fde3-4988-957d-214da42f7fc4",
                                "sense_id": "5472503b-43d4-3b98-a4d0-efa00d628b37",
                                "text": "La masse est composée de campagnards réquisitionnaires, qui servent la liberté comme les forçats servent sur les galères."
                            },
                            {
                                "example_id": "df07edd3-0aa7-4d1a-949e-5b4f6899b70d",
                                "sense_id": "5472503b-43d4-3b98-a4d0-efa00d628b37",
                                "text": "Comme il avait perdu beaucoup de monde dans plusieurs affaires, on avait bouché les trous, tant bien que mal, avec de jeunes réquisitionnaires. Sans les vétérans qui nous encadraient, nous n’eussions rien valu. Il faut beaucoup de temps pour former un soldat, et l’enthousiasme, à la guerre, ne remplace pas l’expérience."
                            }
                        ]
                    }
                ],
