                        "entry_id": "22a3e418-f76e-3c5e-a98c-739d9476f9ee",
                        "glosses": [
                            "One who earns money."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8b34cf6-c0db-4bd3-9ddb-69330c06403b",
                                "sense_id": "ed1d9686-e602-3c70-8083-22ceb1f24670",
                                "text": "Teachers are not simply wage earners who teach students, but revolutionaries bringing up the future builders of socialism. For this reason, we are working hard to help teachers acquire advanced science and technology and to revolutionize and working-classize them."
                            },
                            {
                                "example_id": "dc759f7a-277d-410d-b2ff-a26f9574db4a",
                                "sense_id": "ed1d9686-e602-3c70-8083-22ceb1f24670",
                                "text": "A remaining downside with potentially big unintended consequences is the legislated proposal doesn’t yet adjust the spouse income test, excluding many couples where one earner loses their job and leading to a perverse and undesirable \"benefit cliff\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ededc58-401f-3a52-875f-0be341a447b1",
                        "entry_id": "22a3e418-f76e-3c5e-a98c-739d9476f9ee",
                        "glosses": [
                            "A profitable product or scheme; something that brings in good money."
                        ],
                        "tags": [
                            "Australia",
                            "British"
                        ],
                        "examples": [
                            {
                                "example_id": "e6364b83-b0b2-4cf7-a6fd-7bbb9068ea75",
                                "sense_id": "3ededc58-401f-3a52-875f-0be341a447b1",
                                "text": "Those Japanese radios were a nice little earner: we sold all of them by lunchtime."
                            }
                        ]
