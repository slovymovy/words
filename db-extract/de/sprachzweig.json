                "senses": [
                    {
                        "sense_id": "bf9a612d-f291-3254-9ea8-e599df591dfa",
                        "entry_id": "19642c6b-b04e-3a80-b03e-2a97c45e59e4",
                        "glosses": [
                            "Teil/Untergruppe einer Sprachfamilie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea0cef11-d8d0-4cc8-a522-00450350be13",
                                "sense_id": "bf9a612d-f291-3254-9ea8-e599df591dfa",
                                "text": "„Es entwickelte sich bis gegen das Ende der Völkerwanderungszeit fast nur im Einklang mit dem westgermanischen Sprachzweig in Mitteleuropa fort.“"
                            },
                            {
                                "example_id": "b2c1222b-e158-4865-9bc3-1cae0bfcd12c",
                                "sense_id": "bf9a612d-f291-3254-9ea8-e599df591dfa",
                                "text": "„In der Frühen Neuzeit nahm die gesamtjiddische Sprachlandschaft in Europa mit ihren beiden Sprachzweigen West- und Ostjiddisch sowie deren Hauptdialekten (von denen die ostjiddischen heute noch gesprochen werden) in Grundzügen ihre bis ins 20. Jahrhundert fortbestehende Gestalt an."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
