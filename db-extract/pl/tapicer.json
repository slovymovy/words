                    {
                        "translation_id": "b419615a-7251-49f1-b289-49e152d4a7f6",
                        "source_entry_id": "cb9d016c-d762-334b-81ec-c4b5f71730ef",
                        "source_sense_id": "81c3d5ec-bb89-377b-b3bd-42c27a4fa1da",
                        "target_lang_word": "stoffeerder",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stoffeerder",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b835b127-db8c-342c-b5cc-8dc8e88518be",
                                        "entry_id": "b8e8ff83-efd1-3660-bbde-9db405dceedb",
                                        "glosses": [
                                            "iemand die meubelen van een stoffen bekleding voorziet"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9abdd099-c4a6-4325-a50b-fc9e8334bdad",
                                                "sense_id": "b835b127-db8c-342c-b5cc-8dc8e88518be",
                                                "text": "De vader van Simon, die stoffeerder en kartonfabriekmedewerker was, overleed toen hij 15 jaar was. Een jaar daarna volgde de fatale brand in het Volendamse café Het Hemeltje."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9a97901-2fe7-36a5-814c-84b56ad96613",
                                        "entry_id": "b8e8ff83-efd1-3660-bbde-9db405dceedb",
                                        "glosses": [
                                            "inrichter van een huis"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5c94b95-328b-4ffb-b602-dd71a91ce331",
                                                "sense_id": "c9a97901-2fe7-36a5-814c-84b56ad96613",
                                                "text": "De trek van het platteland naar de stad blijft doorgaan. De haperende woningmarkt aan de buitenranden van Nederland zorgt ervoor dat lokale makelaars, notarissen, stoffeerders en witgoedzaken hun heil zoeken in de steden."
                                            },
                                            {
                                                "example_id": "9801acb8-bf69-4e6f-bef4-cc7fbe7121a8",
                                                "sense_id": "c9a97901-2fe7-36a5-814c-84b56ad96613",
                                                "text": "Tot mijn grote schrik had de stoffeerder verkeerde gaten geboord, maar daarvan niets gezegd. Bovendien kwamen we er later pas achter dat de gordijnen verkeerd waren opgemeten. Kortom: alles moest mee terug."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f80e5e0e-7e4a-4992-a77d-79db61635af1",
                        "source_entry_id": "cb9d016c-d762-334b-81ec-c4b5f71730ef",
                        "source_sense_id": "81c3d5ec-bb89-377b-b3bd-42c27a4fa1da",
                        "target_lang_word": "Polsterer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polsterer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e308e43-59b7-3cc0-9666-63707929924f",
                                        "entry_id": "b9bf503b-1bf7-3b9d-b272-19db94238cb5",
                                        "glosses": [
                                            "Handwerker, der Möbel mit Polstern versieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "257b002e-c12e-42e6-9b88-3665b40c1433",
                                                "sense_id": "0e308e43-59b7-3cc0-9666-63707929924f",
                                                "text": "„Papa half dem Polsterer beim Beziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23b2d04d-bd55-4b43-91d8-1549f7b2e8c5",
                        "source_entry_id": "cb9d016c-d762-334b-81ec-c4b5f71730ef",
                        "source_sense_id": "81c3d5ec-bb89-377b-b3bd-42c27a4fa1da",
                        "target_lang_word": "Tapezierer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tapezierer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40dc1902-264e-319b-9493-d1e3d91e56a4",
                                        "entry_id": "b279e2fb-101a-335b-a9de-943415490c95",
                                        "glosses": [
                                            "Überzieher von Wänden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80976af3-d9d1-4e79-a177-b959c44a5b42",
                                                "sense_id": "40dc1902-264e-319b-9493-d1e3d91e56a4",
                                                "text": "„Durch die Berufsausbildung im Lehrbetrieb und in der Berufsschule sollen im Lehrberuf Tapezierer/in und Dekorateur/in ausgebildete Lehrlinge befähigt werden, die nachfolgenden Tätigkeiten fachgerecht, selbständig und eigenverantwortlich ausführen zu können: […] 4. Anbringen von Wand- und Deckenbeschichtungsstoffen wie Tapeten, Wandbelägen, Wandbespannungs- und Wandbeschichtungsstoffen durch Spalieren, Verlegen, Verkleben, Ver- und Bespannen, …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05087930-aa6c-3222-a6cc-ed9bf65e9b50",
                                        "entry_id": "b279e2fb-101a-335b-a9de-943415490c95",
                                        "glosses": [
                                            "Überzieher von Polstermöbeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d23c4baa-1622-42d9-99bf-9d165dae796d",
                                                "sense_id": "05087930-aa6c-3222-a6cc-ed9bf65e9b50",
                                                "text": "„Durch die Berufsausbildung im Lehrbetrieb und in der Berufsschule sollen im Lehrberuf Tapezierer/in und Dekorateur/in ausgebildete Lehrlinge befähigt werden, die nachfolgenden Tätigkeiten fachgerecht, selbständig und eigenverantwortlich ausführen zu können: […] 7. Aufbauen von klassischen und modernen Polstermöbeln sowie Reparieren von Polstermöbeln, …“"
                                            },
                                            {
                                                "example_id": "6eba7d37-4f53-4959-b6f2-e67ef3319e98",
                                                "sense_id": "05087930-aa6c-3222-a6cc-ed9bf65e9b50",
                                                "text": "„Anläßlich einer Erhebung der Magistratsabteilung 59 - Marktamtsabteilung für den 4. - 7. Bezirk - vom 28.9.1995 in Wien, S-gasse, konnte festgestellt werden, daß der Berufungsswerber im obzitierten Standort seit 18.12.1991 Gebrauchsgegenstände (hauptsächlich Einrichtungsgegenstände) - überwiegend verwendetes Material: Metall (Ausnahme Sitzfläche der Sitzmöbel - dazu werden Tapezierer beauftragt) - herstellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
