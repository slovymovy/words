                "senses": [
                    {
                        "sense_id": "7a3d657d-5742-3b1f-b687-cb1bd01a751a",
                        "entry_id": "1a92949b-9a60-3f46-8db6-28f4bde92029",
                        "glosses": [
                            "Donner un caractère monastique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e48736c4-3128-4ac3-b7b1-df83ed4a3f42",
                                "sense_id": "7a3d657d-5742-3b1f-b687-cb1bd01a751a",
                                "text": "Le répertoire liturgique va considérablement « monasticiser » le scénario, et les répétitions de chant vont créer un groupe et un esprit très particulier tout au long du film."
                            },
                            {
                                "example_id": "2fb0bd39-af81-4643-8249-d4833207a2c4",
                                "sense_id": "7a3d657d-5742-3b1f-b687-cb1bd01a751a",
                                "text": "Il est vrai que nous avons beaucoup travaillé à spiritualiser ce film et à le « monasticiser »."
                            },
                            {
                                "example_id": "ea33f556-ee00-4f46-ab63-803f73bb7f95",
                                "sense_id": "7a3d657d-5742-3b1f-b687-cb1bd01a751a",
                                "text": "En Occident, S. Martin et S. Augustin déclenchèrent, sur la fin du IVe siècle, une tendance à sacraliser la vie religieuse et à « monasticiser », si l'on peut parler ainsi, la vie des clercs du ministère pastoral."
                            }
                        ]
                    }
