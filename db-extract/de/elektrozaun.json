                        "source_sense_id": "28e3db13-1aff-3fa9-81bb-dd4a58391902",
                        "source_sense_description": "Zaun, mit dem Tiere davon abgehalten werden, ein Grundstück zu verlassen",
                        "target_lang_word": "electric fence",
