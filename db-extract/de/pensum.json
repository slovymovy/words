                    {
                        "translation_id": "d4b0dadb-7f13-4a43-b67c-25fdadaee331",
                        "source_entry_id": "af57cb67-448a-3101-8be5-4f19ef5ae38e",
                        "source_sense_id": "1f2955bf-c505-349a-b610-d008d54f31bc",
                        "source_sense_description": "eine zu erledigende Aufgabe, für die ein gewisser Zeitrahmen vorgegeben ist",
                        "target_lang_word": "tâche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tâche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60a6fe27-f2ea-3e2e-9734-55a6cd4a859c",
                                        "entry_id": "d751fcd5-89f3-37be-8784-de658cc15549",
                                        "glosses": [
                                            "Travail donné à accomplir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "159e56f1-aa95-4568-86cf-04fbd1d5d6f5",
                                                "sense_id": "60a6fe27-f2ea-3e2e-9734-55a6cd4a859c",
                                                "text": "Oui, madame, mais Jasper Hobson n’a jamais reculé devant une tâche à accomplir, si rude qu’elle pût être."
                                            },
                                            {
                                                "example_id": "755fbfd9-93c8-40c0-861e-ecc861f55835",
                                                "sense_id": "60a6fe27-f2ea-3e2e-9734-55a6cd4a859c",
                                                "text": "[…]; les hommes interrompaient alors leur tâche pour l’écouter, jusqu’à ce qu’ils s’aperçussent que le regard de ses yeux bleus était fixe […]."
                                            },
                                            {
                                                "example_id": "eeed3d63-4f6c-4ef8-b57d-3d0d19531ad6",
                                                "sense_id": "60a6fe27-f2ea-3e2e-9734-55a6cd4a859c",
                                                "text": "[…], j’avais près de cent brasses de chaîne et mon ancre à ramener à bord, une tâche énorme pour un homme seul qui me prit près de quatre heures et demie, […]."
                                            },
                                            {
                                                "example_id": "c9b7936c-fc8b-40cb-84bd-1f7a8c979289",
                                                "sense_id": "60a6fe27-f2ea-3e2e-9734-55a6cd4a859c",
                                                "text": "Eh! bien, ne reculant devant aucune tâche si fastidieuse fût-elle, ils pourvoiront, d’eux-mêmes, à la diffusion de ces ouvrages, en s’en faisant les traducteurs."
                                            },
                                            {
                                                "example_id": "3ce47364-0ae9-4c1c-8e08-ae4cdb7c80eb",
                                                "sense_id": "60a6fe27-f2ea-3e2e-9734-55a6cd4a859c",
                                                "text": "Les ouvriers occupés à la fouille et à l’extraction des coquins bruts, travaillent à la tâche ; on les paye à raison de 33 centimes le mètre cube de minerai extrait. Les bons ouvriers gagnent 3 fr 50 par jour."
                                            },
                                            {
                                                "example_id": "f5452cc7-3dc9-406b-84d8-664423ef8203",
                                                "sense_id": "60a6fe27-f2ea-3e2e-9734-55a6cd4a859c",
                                                "text": "On dit bien souvent que les bons développeurs sont feignants. En effet, ils cherchent systématiquement à réaliser toute tâche en déployant le moins d’effort possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e5eb9d3-68f8-3a6e-aab1-140e0c85f22e",
                                        "entry_id": "d751fcd5-89f3-37be-8784-de658cc15549",
                                        "glosses": [
                                            "Processus."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
