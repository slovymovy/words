                                    {
                                        "sense_id": "47ea8766-0b15-3527-93ca-b35730b84d18",
                                        "entry_id": "082eb81e-57ce-3a70-801a-baf5fbfd6065",
                                        "glosses": [
                                            "L’État dans ses rapports avec les citoyens, particulièrement dans le domaine judiciaire."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1efea16-92bb-4b99-9080-3e506cfecba1",
                                                "sense_id": "47ea8766-0b15-3527-93ca-b35730b84d18",
                                                "text": "Note : lorsqu’on parle de la reine en tant que personne, par exemple la reine Élisabeth II, le mot s’écrit avec une minuscule."
                                            },
                                            {
                                                "example_id": "bfe30ca8-4323-4c48-9b08-bba224c00c7b",
                                                "sense_id": "47ea8766-0b15-3527-93ca-b35730b84d18",
                                                "text": "Un plaignant ne peut « retirer » sa plainte. Une fois le processus amorcé, la décision appartient en bout de ligne au Procureur général du Québec qui représente la Reine, seule gardienne de l’ordre public. […] La Reine ne rigole pas avec ceux qui veulent interférer avec l’ordre public."
                                            },
                                            {
                                                "example_id": "2b0812e6-92a0-4a89-b12f-a4df6f63861b",
                                                "sense_id": "47ea8766-0b15-3527-93ca-b35730b84d18",
                                                "text": "La juge Danielle Côté, de la Cour du Québec, en rajoute dans son jugement rendu dans l’affaire « la Reine contre Roch Lanthier » lorsqu’elle invoque les risques pour la santé humaine reconnus aux émissions atmosphériques d’organochlorés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Reine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "071f8161-eb67-3195-ac2c-fcabc5971a75",
                                        "entry_id": "24b1053e-c198-35dd-97eb-c113588941f7",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "899a65c3-cdc0-45c8-9a23-2fa1d1dad427",
                                                "sense_id": "071f8161-eb67-3195-ac2c-fcabc5971a75",
                                                "text": "Oh ! notre petite bellote sera chez elle, répondit Mme Marneffe en sonnant Reine pour faire demander Mme Olivier."
                                            },
                                            {
                                                "example_id": "20a93760-6337-406b-9817-45c477961ab6",
                                                "sense_id": "071f8161-eb67-3195-ac2c-fcabc5971a75",
                                                "text": "– Tu t’appelles Reine. Au début, ton prénom me terrifiait. À présent, je ne supporterais pas que tu te nommes différemment. Reine, c’est tellement toi."
                                            },
                                            {
                                                "example_id": "3026696d-e597-4624-ae2e-b4674852eab7",
                                                "sense_id": "071f8161-eb67-3195-ac2c-fcabc5971a75",
                                                "text": "Reine Malo, animatrice québécoise de radio."
                                            }
                                        ]
                                    }
                                ]
