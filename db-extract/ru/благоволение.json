                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbc157e2-b67a-4b48-b735-9239faf5cd2d",
                        "source_entry_id": "e9124e20-1bbb-396f-ba0d-dba5077ba74e",
                        "target_lang_word": "goodwill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goodwill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf0ed43c-580c-3208-9c50-e8c589adc2f7",
                                        "entry_id": "2312eb3b-647a-30f1-83ee-65bc6d70346f",
                                        "glosses": [
                                            "A favorably disposed attitude toward someone or something."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "222f3f8b-775a-382b-bbca-7b16f053b7be",
                                        "entry_id": "2312eb3b-647a-30f1-83ee-65bc6d70346f",
                                        "glosses": [
                                            "The value of a business entity not directly attributable to its tangible assets and liabilities, deriving from factors such as consumer loyalty to the brand."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3674f9d-c26f-3e8c-beb3-ad5f725a2687",
                                        "entry_id": "2312eb3b-647a-30f1-83ee-65bc6d70346f",
                                        "glosses": [
                                            "A concept used to refer to the ability of an individual or business to exert influence within a community, club, market or another type of group, without having to resort to the use of an asset (such as money or property), either directly or by the creation of a lien."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91b7dd84-1c1e-3d13-8c47-173c5fef3834",
                                        "entry_id": "2312eb3b-647a-30f1-83ee-65bc6d70346f",
                                        "glosses": [
                                            "The willingness of a worker to perform activities not strictly within the scope of the employment contract and not just work to rule."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "790b1a6f-b5f4-4157-8d02-9bb86e3916d4",
                                                "sense_id": "91b7dd84-1c1e-3d13-8c47-173c5fef3834",
                                                "text": "As Denning MR said in Secretary of State for Employment v ASLEF (No. 2) (1972): 'a man is not bound to do more for his employer than his contract requires. He can withdraw his goodwill if he pleases.'"
                                            },
                                            {
                                                "example_id": "87741d44-155d-41b3-8cdc-27755531b530",
                                                "sense_id": "91b7dd84-1c1e-3d13-8c47-173c5fef3834",
                                                "text": "The downside of this cost-saving strategy was that the train service could only be covered by goodwill. Whenever there was a spat between ASLEF and management - regardless of cause - the withdrawal of this goodwill became a stick with which unions could beat management."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4932f2fe-fdcc-30e8-8d6a-d59c00718320",
                                        "entry_id": "2312eb3b-647a-30f1-83ee-65bc6d70346f",
                                        "glosses": [
                                            "A thrift shop."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "also",
                                            "capitalized",
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c70f7334-ba84-4ca4-8dfb-f52836cbc0b0",
                        "source_entry_id": "e9124e20-1bbb-396f-ba0d-dba5077ba74e",
                        "target_lang_word": "grace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fa640ea-ab26-345b-b3c1-e3eeb2be4332",
                                        "entry_id": "b27295a6-4e66-3d88-89a9-a666503c7fc3",
                                        "glosses": [
                                            "Charming, pleasing qualities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "979534c1-f3b1-49a3-bc3f-c8aa30bbb9f8",
                                                "sense_id": "4fa640ea-ab26-345b-b3c1-e3eeb2be4332",
                                                "text": "The Princess brought grace to an otherwise dull and boring party."
                                            },
                                            {
                                                "example_id": "df80bdda-b512-4dc6-aeda-6171549947b4",
                                                "sense_id": "4fa640ea-ab26-345b-b3c1-e3eeb2be4332",
                                                "text": "Study gives strength to the mind; conversation, grace: the first apt to give stiffness, the other suppleness: one gives substance and form to the statue, the other polishes it."
                                            },
                                            {
                                                "example_id": "1721d0d6-9aef-412d-9f5c-be4e1c3f9fd9",
                                                "sense_id": "4fa640ea-ab26-345b-b3c1-e3eeb2be4332",
                                                "text": "I have formerly given the general character of Mr. Addison's style and manner as natural and unaffected, easy and polite, and full of those graces which a flowery imagination diffuses over writing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6eda19b-28b3-34d4-b9c0-b6ac22ab624e",
                                        "entry_id": "b27295a6-4e66-3d88-89a9-a666503c7fc3",
                                        "glosses": [
                                            "A short prayer of thanks before or after a meal."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb83c888-b93b-4fa6-8e26-348a918b5195",
                                                "sense_id": "d6eda19b-28b3-34d4-b9c0-b6ac22ab624e",
                                                "text": "It has become less common to say grace before having dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6a5a171-4c73-3bb2-944e-f306d8fea7a0",
                                        "entry_id": "b27295a6-4e66-3d88-89a9-a666503c7fc3",
                                        "glosses": [
                                            "In the games of patience or solitaire: a special move that is normally against the rules."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0416a02c-7ad0-330c-8856-f6eded2bd9a2",
                                        "entry_id": "b27295a6-4e66-3d88-89a9-a666503c7fc3",
                                        "glosses": [
                                            "A grace note."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f38f7df8-ec11-4d7b-b022-a4a147d52e0b",
                                                "sense_id": "0416a02c-7ad0-330c-8856-f6eded2bd9a2",
                                                "text": "The Trill being the most usual Grace, is usually made in Closes, Cadences, and when on a long Note Exclamation or Passion is expressed, there the Trill is made in the latter part of such Note; but most usually upon binding Notes and such Notes as precede the closing Note."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5a1b05e-d94b-35bf-8b3f-b6248dbbdd5f",
                                        "entry_id": "b27295a6-4e66-3d88-89a9-a666503c7fc3",
                                        "glosses": [
                                            "Elegant movement; elegance of movement; balance or poise."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e31eea90-1728-458b-8d92-d61e63757d65",
                                                "sense_id": "f5a1b05e-d94b-35bf-8b3f-b6248dbbdd5f",
                                                "text": "The dancer moved with grace and strength."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9113e4c5-2b44-34da-b474-4f34c95556f1",
                                        "entry_id": "b27295a6-4e66-3d88-89a9-a666503c7fc3",
                                        "glosses": [
                                            "An allowance of time granted to a debtor during which he or she is free of at least part of his normal obligations towards the creditor."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1fa33e2-89eb-4f9a-bacc-f06c67fee447",
                                                "sense_id": "9113e4c5-2b44-34da-b474-4f34c95556f1",
                                                "text": "The repayment of the loan starts after a three-year grace."
                                            },
                                            {
                                                "example_id": "76978126-c2d3-4f50-b5b7-aed97da925e0",
                                                "sense_id": "9113e4c5-2b44-34da-b474-4f34c95556f1",
                                                "text": "With mounting anger the King denounced the pair, both father and son, and was about to condemn them to death when his strength gave out. Faint and trembling he was unable to walk and the sword fell from his hands as he murmured: 'May the Protector of the Buddhist Faith grant me but seven more days grace of life to be quit of this disloyal couple, father and son'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "057cea0e-70ec-3124-8fa7-bf0f5bd0681f",
                                        "entry_id": "b27295a6-4e66-3d88-89a9-a666503c7fc3",
                                        "glosses": [
                                            "Free and undeserved favour, especially of God; unmerited divine assistance given to humans for their regeneration or sanctification, or for resisting sin."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "786f0a19-986a-4e8a-8928-4b1a226aa59d",
                                                "sense_id": "057cea0e-70ec-3124-8fa7-bf0f5bd0681f",
                                                "text": "But by the grace of God I am what I am: and his grace which was bestowed vpō me, was not in vaine: But I laboured more abundantly then they all, yet not I, but the grace of God which was with me:"
                                            },
                                            {
                                                "example_id": "33b7574f-c6b5-4c27-ba34-a916791d51c4",
                                                "sense_id": "057cea0e-70ec-3124-8fa7-bf0f5bd0681f",
                                                "text": "When she sang in the kirk, folk have told me that they had a foretaste of the musick of the New Jerusalem, and when she came in by the village of Caulds old men stottered to their doors to look at her. Moreover, from her earliest days the bairn had some glimmerings of grace."
                                            }
                                        ]
                                    },
