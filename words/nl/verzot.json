    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c0b353b6-8f63-3d05-8591-1ceb4aa8a658",
                    "sense_definition": "iets heel erg fijn of lekker vinden; een sterke voorkeur hebben voor iets",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "voorkeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn kleine broertje is <w>verzot</w> op chocolade-ijs en wil het elke dag eten.",
                            "target_lang_translations": {
                                "en": "My little brother is <w>fond</w> of chocolate ice cream and wants to eat it every day."
                            }
                        },
                        {
                            "text": "Zij is <w>verzot</w> op klassieke muziek en bezoekt wekelijks een concert.",
                            "target_lang_translations": {
                                "en": "She is <w>crazy</w> about classical music and visits a concert every week."
                            }
                        }
                    ],
                    "synonyms": [
                        "dol",
                        "tuk",
                        "verkikkerd",
                        "gek"
                    ],
                    "common_phrases": [
