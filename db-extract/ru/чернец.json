                                    },
                                    {
                                        "sense_id": "27547dc7-3e7b-3ac9-91eb-4e9f56465cc1",
                                        "entry_id": "057fda98-71de-327a-b80d-21a8ba0e681f",
                                        "glosses": [
                                            "An inkblot."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4cb34d0f-7665-3688-a067-2542550bb3f1",
                                        "entry_id": "057fda98-71de-327a-b80d-21a8ba0e681f",
                                        "glosses": [
                                            "A South American monkey (Pithecia monachus); also applied to other species, as Cebus xanthosternos."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14cba9dd-d3cc-3975-93dd-a1ec8a53eff6",
                                        "entry_id": "057fda98-71de-327a-b80d-21a8ba0e681f",
                                        "glosses": [
                                            "The bullfinch, common bullfinch, European bullfinch, or Eurasian bullfinch (Pyrrhula pyrrhula)."
                                        ],
                                        "tags": [],
