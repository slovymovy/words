{
    "word_family": [
        "большой",
        "большинство",
        "побольше",
        "наибольший"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "559db1b2-862a-3c8f-90eb-692f9633dad5",
                    "sense_definition": "Сравнительная степень наречия <w>много</w>: в более значительном количестве или степени.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quantity_comp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Надо тренироваться <w>больше</w>, чтобы достичь успеха.",
                            "target_lang_translations": {
                                "en": "You need to train <w>more</w> to achieve success.",
                                "zh": "为了取得成功，你需要<w>多</w>加练习。"
                            }
                        },
                        {
                            "text": "Я люблю читать <w>больше</w> всего на свете.",
                            "target_lang_translations": {
                                "en": "I love reading <w>more</w> than anything in the world.",
                                "zh": "我最喜欢读书，<w>多</w>过世上任何事。"
                            }
                        }
                    ],
                    "antonyms": [
                        "меньше"
                    ],
                    "common_phrases": [
                        "больше всего",
                        "как можно больше",
                        "намного больше",
                        "чем больше"
                    ],
                    "target_lang_definitions": {
                        "en": "Comparative degree of the adverb 'much' or 'many': in a greater amount or degree.",
                        "zh": "副词“多”的比较级：在数量或程度上更多。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "more",
                                "target_lang_sense_clarification": "comparative of 'much' or 'many'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更",
                                "target_lang_sense_clarification": "表示程度加深"
                            },
                            {
                                "target_lang_word": "多",
                                "target_lang_sense_clarification": "表示数量增加"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "970ea269-79a2-3082-92fd-971964901647",
                    "sense_definition": "Впредь, в дальнейшем (обычно используется в отрицательных предложениях для указания на прекращение действия).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_negation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я обещаю, что <w>больше</w> не буду опаздывать.",
                            "target_lang_translations": {
                                "en": "I promise that I won't be late <w>anymore</w>.",
                                "zh": "我保证以后不<w>再</w>迟到了。"
                            }
                        },
                        {
                            "text": "Мы решили <w>больше</w> не встречаться.",
                            "target_lang_translations": {
                                "en": "We decided not to meet <w>anymore</w>.",
                                "zh": "我们决定不<w>再</w>见面了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "больше не",
                        "никогда больше"
                    ],
                    "target_lang_definitions": {
                        "en": "From now on, in the future (usually used in negative sentences to indicate that an action has stopped).",
                        "zh": "今后不再（通常用于否定句，表示动作停止）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "anymore",
                                "target_lang_sense_clarification": "used in negative sentences to mean 'any longer'"
                            },
                            {
                                "target_lang_word": "longer",
                                "target_lang_sense_clarification": "used in the phrase 'no longer'"
                            },
                            {
                                "target_lang_word": "again",
                                "target_lang_sense_clarification": "used in negative sentences like 'never again'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "再",
                                "target_lang_sense_clarification": "用于否定句表示不再发生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8b3a0e0-72db-3ff5-a2af-686dec8f968a",
                    "sense_definition": "Кроме, помимо (употребляется для ограничения, часто со словами «ничего», «никто»).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне нужна только тишина и <w>больше</w> ничего.",
                            "target_lang_translations": {
                                "en": "I need only silence and nothing <w>else</w>.",
                                "zh": "我只需要安静，除此之外<w>外</w>无他求。"
                            }
                        },
                        {
                            "text": "В комнате были только мы и <w>больше</w> никого.",
                            "target_lang_translations": {
                                "en": "There was only us in the room and nobody <w>else</w>.",
                                "zh": "房间里只有我们，<w>外</w>无他人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "и больше ничего",
                        "и больше никого"
                    ],
                    "target_lang_definitions": {
                        "en": "Besides, apart from (used for limitation, often with words like 'nothing', 'nobody').",
                        "zh": "除……之外（用于限制，常与“没有”、“什么”等词连用）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "else",
                                "target_lang_sense_clarification": "used with indefinite pronouns like 'nothing' or 'nobody'"
                            },
                            {
                                "target_lang_word": "more",
                                "target_lang_sense_clarification": "additional; used in phrases like 'nothing more'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外",
                                "target_lang_sense_clarification": "表示除此之外没有其他"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6531a29-fe2b-3b64-b399-9a33d71b5630",
                    "sense_definition": "Преимущественно, главным образом.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mostly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она молчала и всё <w>больше</w> слушала других.",
                            "target_lang_translations": {
                                "en": "She kept silent and <w>mostly</w> listened to others.",
                                "zh": "她保持沉默，<w>多</w>是在听别人说。"
                            }
                        },
                        {
                            "text": "Мы гуляли <w>больше</w> по вечерам, когда спадала жара.",
                            "target_lang_translations": {
                                "en": "We walked <w>mostly</w> in the evenings, when the heat subsided.",
                                "zh": "我们<w>多</w>在傍晚暑气消退时散步。"
                            }
                        }
                    ],
                    "synonyms": [
                        "в основном"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Predominantly, mainly, or rather.",
                        "zh": "主要地，多半地。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mostly",
                                "target_lang_sense_clarification": "mainly; for the most part"
                            },
                            {
                                "target_lang_word": "more",
                                "target_lang_sense_clarification": "rather; to a greater extent"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多",
                                "target_lang_sense_clarification": "表示大部分时间或情况"
                            },
                            {
                                "target_lang_word": "主要",
                                "target_lang_sense_clarification": "表示核心或主要部分"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "aaa73497-9bd5-3aee-a0f3-f4d3657ab94b",
                    "sense_definition": "Сравнительная степень прилагательного <w>большой</w>: превосходящий по размеру, величине или объёму.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "size_comp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот новый дом <w>больше</w>, чем наш старый.",
                            "target_lang_translations": {
                                "en": "This new house is <w>bigger</w> than our old one.",
                                "zh": "这栋新房子比我们旧的那栋更<w>大</w>。"
                            }
                        },
                        {
                            "text": "Твоя порция супа <w>больше</w> моей.",
                            "target_lang_translations": {
                                "en": "Your portion of soup is <w>larger</w> than mine.",
                                "zh": "你的那份汤比我的更<w>大</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "меньше"
                    ],
                    "common_phrases": [
                        "становиться больше",
                        "всё больше"
                    ],
                    "target_lang_definitions": {
                        "en": "Comparative degree of the adjective 'big': exceeding in size, magnitude, or volume.",
                        "zh": "形容词“大”的比较级：在尺寸、规模或体积上超过。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bigger",
                                "target_lang_sense_clarification": "comparative of 'big'"
                            },
                            {
                                "target_lang_word": "larger",
                                "target_lang_sense_clarification": "comparative of 'large'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大",
                                "target_lang_sense_clarification": "表示尺寸或规模的比较"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}