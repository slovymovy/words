                                    {
                                        "sense_id": "3e7b9042-9310-3439-8b49-dfef6f04807f",
                                        "entry_id": "d1593957-8ca3-301a-b830-7433e1d0cb96",
                                        "glosses": [
                                            "That expels fire from the mouth and nostrils."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a4cdac1-3566-402f-a2f9-8adfcc062589",
                                                "sense_id": "3e7b9042-9310-3439-8b49-dfef6f04807f",
                                                "text": "a fire-breathing dragon"
                                            },
                                            {
                                                "example_id": "dda4ac24-2c5e-4bf7-aeff-4b0c708e6c1e",
                                                "sense_id": "3e7b9042-9310-3439-8b49-dfef6f04807f",
                                                "text": "Medea for the loue of Iaſon, taught him how to tame the fire breathing braſſ feeted Bulls, and kill the mighty dragon that kept the golden fleece[.]"
                                            },
                                            {
                                                "example_id": "43225c81-feab-476d-95e8-5aaec813f0f1",
                                                "sense_id": "3e7b9042-9310-3439-8b49-dfef6f04807f",
                                                "text": "No man could shake a finger at Beowulf. All the days of his life he had sought the path of right, escaped traps, killed foes, and ruled fairly. Now it was time for him to stand up to the fire-breathing worm."
                                            },
                                            {
                                                "example_id": "e3b4cc78-1538-42a8-9145-9b01ce6dc104",
                                                "sense_id": "3e7b9042-9310-3439-8b49-dfef6f04807f",
                                                "text": "Then the bane of that people, the fire-breathing dragon,\nwas mad to attack for a third time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b29ebb28-9e0b-3b20-b5f2-db99609ec2c9",
                                        "entry_id": "d1593957-8ca3-301a-b830-7433e1d0cb96",
                                        "glosses": [
                                            "That emits or belches forth fire."
                                        ],
                                        "tags": [
                                            "literary",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70933b75-368d-467e-9d7b-7bdb3624d431",
                                                "sense_id": "b29ebb28-9e0b-3b20-b5f2-db99609ec2c9",
                                                "text": "The deadly fire-breathing Cannon roar,\nSending destructive Heralds thro' the Field."
