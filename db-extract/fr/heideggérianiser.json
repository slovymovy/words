                ],
                "senses": [
                    {
                        "sense_id": "7e211f51-c6fb-394e-b751-7b843628d8ac",
                        "entry_id": "bed40d62-45ce-3226-b80e-52446636a76e",
                        "glosses": [
                            "Donner un caractère heideggérien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a07f0a8-f2d4-4f0a-9b37-db39106a0267",
                                "sense_id": "7e211f51-c6fb-394e-b751-7b843628d8ac",
                                "text": "Elle n’est en fait ni l’une ni l’autre —Heidegger ne répond pas à Foucault, Foucault ne questionne pas Heidegger : je n’entends ni foucaldiser l’un ni heideggérianiser l’autre."
                            }
                        ]
                    },
                    {
                        "sense_id": "432fee97-0fa5-3240-a51f-1c4ad500429e",
                        "entry_id": "bed40d62-45ce-3226-b80e-52446636a76e",
                        "glosses": [
                            "Raisonner comme Heidegger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcb1b1ea-52c8-4252-8dcd-d18b56dbc0b1",
                                "sense_id": "432fee97-0fa5-3240-a51f-1c4ad500429e",
                                "text": "Sans doute Glucksmann se garde-t-il d’« heideggérianiser » de manière trop voyante, mais il est clair qu’il cherche un recours du côté d’un vrai penseur qui, lui, a eu l’« honnêteté » de publier ses pensées sur Nietzsche et de ne pas y rester « fixé »."
                            }
                        ]
                    }
                ],
