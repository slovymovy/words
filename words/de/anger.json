    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0f077516-45d1-3963-a327-e2649a1b0120",
                    "sense_definition": "Zentrale, meist grasbewachsene Freifläche eines Dorfes im gemeinsamen Besitz der Dorfbewohner",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gruenflaeche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Abends trafen sich früher alle Nachbarn auf dem <w>Anger</w> vor der Kirche.",
                            "target_lang_translations": {
                                "en": "In the evenings, all the neighbours used to meet on the <w>village green</w> in front of the church."
                            }
                        },
                        {
                            "text": "Oft war der <w>Anger</w> zentral zwischen zwei weiter auseinanderliegenden Häuserreihen angelegt.",
                            "target_lang_translations": {
                                "en": "Often the <w>village green</w> was laid out centrally between two rows of houses set further apart."
                            }
                        }
                    ],
                    "synonyms": [
                        "Brink",
                        "Dorfanger",
                        "Dorfplatz",
                        "Dorfwiese"
                    ],
                    "common_phrases": [
                        "auf dem Anger"
                    ],
                    "target_lang_definitions": {
                        "en": "Central, usually grassy open space in a village held in common ownership by the villagers"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "village green",
                                "target_lang_sense_clarification": "central grassy area in a village"
                            },
                            {
                                "target_lang_word": "common",
                                "target_lang_sense_clarification": "shared communal land in a town or village"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2801349c-e946-3622-9a21-b51c69b4eb89",
                    "sense_definition": "Kleines Stück Grasland oder Wiese",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gruenflaeche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Schafe weideten friedlich auf dem kleinen <w>Anger</w> hinter der Scheune.",
                            "target_lang_translations": {
                                "en": "The sheep grazed peacefully on the small <w>pasture</w> behind the barn."
                            }
                        },
                        {
                            "text": "Ein schmaler Pfad führte mitten über den saftigen <w>Anger</w> zum Bach.",
                            "target_lang_translations": {
                                "en": "A narrow path led right across the lush <w>meadow</w> to the stream."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "landschaftlich"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A small patch of grassland, pasture, or meadow"
                    },
                    "translations": {
