                            {
                                "example_id": "9a41b8ef-7791-4b0e-a3dd-28e78b355a75",
                                "sense_id": "f4ad5d62-6b1a-32da-a18c-b034821c6008",
                                "text": "L’actrice oscarisée était une des nombreuses têtes d’affiche dans le thriller scientifique de Steven Soderbergh sorti en 2011."
                            },
                            {
                                "example_id": "2718088d-6984-4daf-b607-bd46cde4beea",
                                "sense_id": "f4ad5d62-6b1a-32da-a18c-b034821c6008",
                                "text": "Le comédien et metteur en scène Rodolphe Dana a adapté le premier roman — publié en 1982 — de l’écrivain et scénariste (oscarisé), originaire d’ex-Yougoslavie, Steve Tesich (1942-1966)."
                            }
                        ]
                    }
