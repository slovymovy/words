                "senses": [
                    {
                        "sense_id": "61b1466e-f838-333d-b3ef-12bbe6af1c07",
                        "entry_id": "aa21f4be-2fd4-30d0-938a-6411a2c298e9",
                        "glosses": [
                            "Gegenstand mit einem hinreichenden Innenvolumen zum Aufbewahren oder Transportieren von Kühlwasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad74232c-85bd-4c95-a367-0ad1d07eaa7e",
                                "sense_id": "61b1466e-f838-333d-b3ef-12bbe6af1c07",
                                "text": "Der Kühlwasserbehälter war fest verschlossen."
                            },
                            {
                                "example_id": "17246d01-eef0-40fd-9860-e1fdaa2768fe",
                                "sense_id": "61b1466e-f838-333d-b3ef-12bbe6af1c07",
                                "text": "„Von allen Seiten drängen sich die Jungen an den Motor heran und betasten ihn. Einer öffnet die Verschraubung des Kühlwasserbehälters und riecht in den Tank hinein.“"
                            },
                            {
                                "example_id": "c355af84-fd6f-4a3b-99ab-f496d6a1c16f",
                                "sense_id": "61b1466e-f838-333d-b3ef-12bbe6af1c07",
                                "text": "„Ein Knopfdruck auf der Fernbedienung lässt das Aluminium-Gehäuse nach hinten fahren und den Kühlwasserbehälter nach oben klappen - zum Luftablassen oder zum Nachfüllen.“"
                            },
                            {
                                "example_id": "33e4566e-5440-4058-b45b-1dae50556232",
                                "sense_id": "61b1466e-f838-333d-b3ef-12bbe6af1c07",
                                "text": "„Ist der Motor abgekühlt, müssen Wasser und Kühlerflüssigkeit nachgefüllt werden. Doch Vorsicht: Den Kühlwasserbehälter niemals öffnen, solange die darin befindliche Flüssigkeit noch heiß ist.“"
                            },
                            {
                                "example_id": "77c57b00-d5e6-4c8f-858c-94f70fac6c67",
                                "sense_id": "61b1466e-f838-333d-b3ef-12bbe6af1c07",
                                "text": "„Der Schaden schien gering, seine Wirkung war gravierend: Beim A6 Avant 2,5 TDI Quattro eines Münchner Audi-Fahrers leckte der Kühlwasserbehälter.“"
                            },
                            {
                                "example_id": "e4aa53ec-d03a-406e-b656-b41af7d5a6ad",
                                "sense_id": "61b1466e-f838-333d-b3ef-12bbe6af1c07",
                                "text": "„Löcher in Kühlwasserbehältern, Stromausfall und Feuer: 50 Jahre Atomenergie bedeuten laut Greenpeace auch: 50 Jahre Zwischenfälle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
