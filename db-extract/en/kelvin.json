            {
                "entry_id": "602af790-3b58-30fa-a068-9f32dd0f793c",
                "word": "kelvin",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "82fb5335-d425-43c5-84c9-3be86503953c",
                        "entry_id": "602af790-3b58-30fa-a068-9f32dd0f793c",
                        "tags": [
                            "plural"
                        ],
                        "form": "kelvins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a929af10-ddb4-3bc9-9404-70d4c1410fee",
                        "entry_id": "602af790-3b58-30fa-a068-9f32dd0f793c",
                        "glosses": [
                            "In the International System of Units, the base unit of thermodynamic temperature; ¹⁄_(273.16) of the thermodynamic temperature of the triple point of water."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c1dccf8-2e06-4a34-953d-333227c03f00",
                                "sense_id": "a929af10-ddb4-3bc9-9404-70d4c1410fee",
                                "text": "Ice melts above 273.15 kelvins."
                            },
                            {
                                "example_id": "020701ad-ddde-4d35-9271-0368bd73c892",
                                "sense_id": "a929af10-ddb4-3bc9-9404-70d4c1410fee",
                                "text": "Water boils above 373.15 kelvins."
                            }
                        ]
                    },
                    {
                        "sense_id": "67adf99c-6c7d-3e06-99c9-8d7615ba927c",
                        "entry_id": "602af790-3b58-30fa-a068-9f32dd0f793c",
                        "glosses": [
                            "One degree of difference on this scale, as a unit interval."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c09a64b-1b81-4626-ac9a-099af2f6adb4",
                                "sense_id": "67adf99c-6c7d-3e06-99c9-8d7615ba927c",
                                "text": "The dew point here today is only 1 kelvin above what it was yesterday."
                            },
                            {
                                "example_id": "08957f59-5fb7-4edd-a693-9cd4079f7979",
                                "sense_id": "67adf99c-6c7d-3e06-99c9-8d7615ba927c",
                                "text": "The interval between the freezing and boiling points of water is 100 kelvins."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab04200c-d8c1-3072-b05e-68ab564d4dc9",
                        "entry_id": "602af790-3b58-30fa-a068-9f32dd0f793c",
                        "glosses": [
                            "A measurement of color warmth defined by the temperature kelvin at which an incandescent blackbody would emit a given color."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5deb7617-f05f-483c-9d8e-648da48993da",
                        "source_entry_id": "602af790-3b58-30fa-a068-9f32dd0f793c",
                        "source_sense_description": "SI temperature unit",
                        "target_lang_word": "kelvin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kelvin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c348eb6-cbf8-323b-8ade-e700b3afe490",
                                        "entry_id": "3f4fb27a-ffc5-3c11-bad0-184fda19c6a0",
                                        "glosses": [
                                            "Unité de mesure de la température du Système international, dont le symbole est K. Contrairement aux autres unités de température, le symbole du kelvin ne prend pas de « ° »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "129e1429-378c-4a62-ac1d-fbb040e86c0e",
                                                "sense_id": "4c348eb6-cbf8-323b-8ade-e700b3afe490",
                                                "text": "Toutefois, à la différence du degré Celsius, le kelvin est une mesure absolue de la température qui a été introduite grâce au troisième principe de la thermodynamique."
                                            },
                                            {
                                                "example_id": "91301dcd-53f7-4ebe-8c52-f9364550a514",
                                                "sense_id": "4c348eb6-cbf8-323b-8ade-e700b3afe490",
                                                "text": "Ainsi, au lieu de geler à 0 degré Celsius, l’eau gèle à 273 kelvins et bout à 373 kelvins (qui équivalent à 100 degrés Celsius)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58ff6846-0e0d-4e89-858a-9a77a930433b",
                        "source_entry_id": "602af790-3b58-30fa-a068-9f32dd0f793c",
                        "source_sense_description": "SI temperature unit",
                        "target_lang_word": "Kelvin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
