                    }
                },
                {
                    "sense_id": "fa06fa27-c422-36d8-bb92-51c995958148",
                    "sense_definition": "Период времени от рождения до смерти человека или животного",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "lifespan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой дедушка прожил долгую и интересную <жизнь>.",
                            "target_lang_translations": {
                                "en": "My grandfather lived a long and interesting <life>.",
                                "zh": "我爷爷度过了漫长而有趣的一<w>生</w>。"
                            }
                        },
                        {
                            "text": "Я запомню этот момент на всю <жизнь>.",
                            "target_lang_translations": {
                                "en": "I will remember this moment for my whole <life>.",
                                "zh": "我会把这一刻铭记一<w>生</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "дни",
                        "век"
                    ],
                    "antonyms": [
                        "смерть"
                    ],
                    "common_phrases": [
