                                "target_senses": [
                                    {
                                        "sense_id": "fda0b378-f6a0-3690-968f-875e777b1fd5",
                                        "entry_id": "08bb784e-1744-39d3-b9a1-b9b7b196b210",
                                        "glosses": [
                                            "A system of treating diseases with small amounts of substances which, in larger amounts, would produce the observed symptoms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faea31d7-827e-4062-bbb1-80a341cb68ac",
                                                "sense_id": "fda0b378-f6a0-3690-968f-875e777b1fd5",
                                                "text": "I am sure that if doctors (for instance) were first taught how to use some of the other methods of homeopathy effectively, particularly the therapeutics and organ-based methods, they would be much more able to incorporate these into their practices […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "390d33ee-5c90-463b-8276-6d08052c7ee1",
                        "source_entry_id": "0fed0ae5-24b1-395f-a8ec-dbb2b513fa5e",
                        "target_lang_word": "homeopatía",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homeopatía",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "bd6b919e-76b9-30e6-906a-159b491eaac4",
                                        "entry_id": "4ab02723-f028-3a7c-a379-98799f0329ff",
                                        "glosses": [
                                            "Método curativo que aplica, en dosis mínimas, substancias que en cantidad mayor producirían efectos o afecciones semejantes a las que se combaten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc2ed53f-0138-48d1-8845-de16d3885fc0",
                                                "sense_id": "bd6b919e-76b9-30e6-906a-159b491eaac4",
                                                "text": "Capaz que no le hizo gracia al de la farmacia\nCuando dije que yo defiendo a muerte a la eutanasia\nDecía que si todos se morían, se fundía\nY me tiró con un frasco de homeopatía"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbc72622-5d14-40cb-9dc0-d67750bcd824",
                        "source_entry_id": "0fed0ae5-24b1-395f-a8ec-dbb2b513fa5e",
                        "target_lang_word": "omeopatia",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omeopatia",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "c150d0ea-821d-3ad3-bae3-738121ee6652",
                                        "entry_id": "86e63db1-a56b-339b-8710-988cdd99815c",
                                        "glosses": [
                                            "medicina complementare che asserisce che si guarisce dalle malattie fornendo al paziente in piccolissime dosi le medesime sostanze che le producono, cioè che sono il corrispettivo della causa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02415b25-6faf-43fa-85a2-b76705f80d34",
                                                "sense_id": "c150d0ea-821d-3ad3-bae3-738121ee6652",
                                                "text": "omeopatia unicista"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e54809c9-337b-4120-93c9-457ef7d59e66",
                        "source_entry_id": "0fed0ae5-24b1-395f-a8ec-dbb2b513fa5e",
                        "target_lang_word": "Homöopathie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Homöopathie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8f77f5c-ca01-3678-a17d-c96d172d9628",
                                        "entry_id": "925dc7b3-0055-3ebf-a3d8-c1b07bd32ca4",
                                        "glosses": [
                                            "alternative Behandlungsmethode, bei der Substanzen, von denen bekannt ist oder angenommen wird, sie könnten bei gesunden Menschen der Krankheit ähnelnde Symptome hervorrufen, in starker Verdünnung verabreicht werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf00432f-22df-463a-b61b-74a2fbecd6d8",
                                                "sense_id": "d8f77f5c-ca01-3678-a17d-c96d172d9628",
                                                "text": "Die Homöopathie ist eine Behandlungsmethode der Alternativmedizin."
                                            },
                                            {
                                                "example_id": "9e986b38-476e-43e3-abf3-e43c65997f69",
                                                "sense_id": "d8f77f5c-ca01-3678-a17d-c96d172d9628",
                                                "text": "„2005 führte die Universität Bern die wohl umfassendste und seriöseste Untersuchung zum Thema Homöopathie durch und heraus kam: nichts.“"
                                            },
                                            {
                                                "example_id": "9d9882e6-d466-4bdd-a972-6a0c707bddf4",
                                                "sense_id": "d8f77f5c-ca01-3678-a17d-c96d172d9628",
                                                "text": "„Zahlreichen Wissenschaftlern zufolge wirkt die Homöopathie nur im Rahmen des Placebo-Effektes.“"
                                            },
                                            {
                                                "example_id": "da0ba0d7-1648-4d4e-b89a-3f13d1049a59",
                                                "sense_id": "d8f77f5c-ca01-3678-a17d-c96d172d9628",
                                                "text": "„Die Wirkstoffe, die in der Homöopathie eingesetzt werden, sind in hoher Konzentration häufig giftig.“"
                                            },
                                            {
                                                "example_id": "e58d8abb-0581-4a1b-a2e4-28e4306ed610",
                                                "sense_id": "d8f77f5c-ca01-3678-a17d-c96d172d9628",
                                                "text": "„Aus pharmakologischer Sicht ist das Prinzip der Homöopathie nicht haltbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdb774cb-37ed-4e28-859a-fa6f29f6b0a2",
