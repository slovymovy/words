                "senses": [
                    {
                        "sense_id": "53395477-cd7c-3d52-bddf-da99ddf7eb39",
                        "entry_id": "b68813cd-7cc2-3c3a-b150-f51d2a5aa0ef",
                        "glosses": [
                            "Unternehmen, das (neue) Vakzine herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "081ba7c4-c2ba-4b8e-8dfc-0c3ed58e3d09",
                                "sense_id": "53395477-cd7c-3d52-bddf-da99ddf7eb39",
                                "text": "„Das PEI beriet bereits andere Impfstoffproduzenten im Schnellverfahren und verzichtete bei Corona-Fragen generell auf alle Verwaltungsgebühren.“"
                            },
                            {
                                "example_id": "f7403ed7-4d69-498e-9058-bea107e72eb5",
                                "sense_id": "53395477-cd7c-3d52-bddf-da99ddf7eb39",
                                "text": "„Den Cochrane-Experten fiel auf, dass die Ergebnisse der von Impfstoffproduzenten finanzierten Studien häufig manipuliert wurden.“"
                            },
                            {
                                "example_id": "4760fb53-0f5b-4e83-b0f7-d65ee2500ea1",
                                "sense_id": "53395477-cd7c-3d52-bddf-da99ddf7eb39",
                                "text": "„Der Impfstoffproduzent wiederum teilte mit, dass der reguläre Preis für eine Dosis zwischen 15 und 20 Dollar liege.“"
                            },
                            {
                                "example_id": "7aec8c91-c19a-4922-ad45-c02b565a7dcb",
                                "sense_id": "53395477-cd7c-3d52-bddf-da99ddf7eb39",
                                "text": "„Obwohl Indien der weltweit größte Impfstoffproduzent ist, fehlt es an Dosen im Land.“"
                            },
                            {
                                "example_id": "4acbe00b-74be-42b5-86e4-c351591466fe",
                                "sense_id": "53395477-cd7c-3d52-bddf-da99ddf7eb39",
                                "text": "„Doch während der Impfungen kamen Probleme auf: Die Impfstoffproduzenten kündigten an, dass sie den Impfstoff nicht ohne Versicherung abfüllen würden.“"
                            },
                            {
                                "example_id": "54a72b19-afec-4e05-8ddd-407a6549531e",
                                "sense_id": "53395477-cd7c-3d52-bddf-da99ddf7eb39",
                                "text": "„Indien, auch bekannt als ‚Apotheke der Welt‘ ist der größte Impfstoffproduzent der Welt.“"
                            },
                            {
                                "example_id": "0446cbcc-67ec-4b68-8b39-e09f6a2bc5e8",
                                "sense_id": "53395477-cd7c-3d52-bddf-da99ddf7eb39",
                                "text": "„Der größte Impfstoffproduzent der Welt stellt den Corona-Impfstoff von Astra-Zeneca für zahlreiche Entwicklungs- und Schwellenländer her.“"
                            },
                            {
                                "example_id": "6602e81e-9eba-49b6-990c-d99a1c1bf059",
                                "sense_id": "53395477-cd7c-3d52-bddf-da99ddf7eb39",
                                "text": "„Bis 2025 solle als Land der fünftgrößte Impfstoffproduzent weltweit werden, sagte Präsident Moon Jae In am Donnerstag in Seoul.“"
                            },
                            {
                                "example_id": "55172cdc-0c32-4d5b-ae3b-424cea46c197",
                                "sense_id": "53395477-cd7c-3d52-bddf-da99ddf7eb39",
                                "text": "„Der Impfstoffproduzent Biontech/Pfizer hatte vor wenigen Tagen erklärt, die bis Mitte Februar zugesagte Impfstoffmenge wegen herstellungsbedingten Engpässen um 25 Prozent kürzen zu müssen.“"
                            },
                            {
                                "example_id": "a3482aae-fd1e-4a08-b3d8-2b9b24d8c5a6",
                                "sense_id": "53395477-cd7c-3d52-bddf-da99ddf7eb39",
                                "text": "„Das hängt vor allem damit zusammen, dass Indien, der größte Impfstoffproduzent der Welt und wichtigster Lieferant Afrikas mit seiner unter Lizenz produzierten Version des AstraZeneca-Impfstoffs, einen zeitweiligen Exportstopp eingeführt hat, um die eigene Bevölkerung zu impfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
