                "senses": [
                    {
                        "sense_id": "f836f98a-e3a2-3574-ac73-69c736d8ae3f",
                        "entry_id": "be95de0e-c9f4-3bbc-b382-bf6907e83e0c",
                        "glosses": [
                            "Schauspielerin, die überwiegend oder ausschließlich in Filmen mitwirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e55d6f54-1aa5-4d15-8a92-1f56427a75fd",
                                "sense_id": "f836f98a-e3a2-3574-ac73-69c736d8ae3f",
                                "text": "„Die japanische Filmschauspielerin wurde durch ihre Töchterrollen in den Filmen Yasujiro Ozus berühmt“"
                            },
                            {
                                "example_id": "079f3dac-b5cb-4646-a2c6-fd4a915e1a1e",
                                "sense_id": "f836f98a-e3a2-3574-ac73-69c736d8ae3f",
                                "text": "„Mit ihren nackten Schultern, ihrem blauen Kleid und den kurzen, von der Brennschere leicht angesengten Haaren, die sie immerfort zurückwarf, hielt Sophie diesem Grobian die Lippen hin – verlockender und verlogener als nur je eine Filmschauspieerin, die noch mit den geschlossenen Augen der Lust nach der Kamera schielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
