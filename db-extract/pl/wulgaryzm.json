                    },
                    {
                        "translation_id": "82873e9f-c860-43b5-b246-506b93e3f99f",
                        "source_entry_id": "2dee13bc-1a0f-30f9-ab06-a6981ba54cf0",
                        "source_sense_id": "0691392a-2c5e-3a7a-83c6-372d23f7ab6a",
                        "target_lang_word": "Vulgarismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vulgarismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61012a18-1674-3542-9b55-fb06f40b2d13",
                                        "entry_id": "6c64647e-ee9e-371b-b942-42f5cc40e6db",
                                        "glosses": [
                                            "sprachlicher Ausdruck, der als anstößig empfunden wird; Ausdruck der Vulgärsprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7461f03c-1260-4165-9db3-ccc4cd50e3c8",
                                                "sense_id": "61012a18-1674-3542-9b55-fb06f40b2d13",
                                                "text": "„Riesel (1964: 94) nennt als Elemente der ‚nicht-literarischen Lexik: Vulgarismen, Argotismen, Slangwörter, Berufsjargonismen‘.“"
                                            },
                                            {
                                                "example_id": "6ca2bb27-5210-41a7-b930-083130d97215",
                                                "sense_id": "61012a18-1674-3542-9b55-fb06f40b2d13",
                                                "text": "„Da die Stil-Kategorien erst noch festgelegt werden müssen, sind Bezeichnungen wie 'Provinzialismen', 'Archaismen', Vulgarismen und 'Dichterische Formen' subjektiv und direkt abhängig von Herkunft und Einstellung des Beobachters.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ed83de7-272c-49b9-9096-e2590de72b8c",
                        "source_entry_id": "2dee13bc-1a0f-30f9-ab06-a6981ba54cf0",
                        "source_sense_id": "0691392a-2c5e-3a7a-83c6-372d23f7ab6a",
                        "target_lang_word": "вульгаризм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вульгаризм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0d8789cd-dca5-34e1-b522-a51e5cc5ad86",
                                        "entry_id": "d7a3cefc-68f3-3a53-82cc-1709db805fe0",
                                        "glosses": [
                                            "вульгарное слово или выражение, употреблённое в литературном языке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eafd6328-9c48-4fda-9e8e-609d49fcd3f2",
                                                "sense_id": "0d8789cd-dca5-34e1-b522-a51e5cc5ad86",
                                                "text": "Нейтральным его считать точно нельзя, ни при каких условиях, оно будет или вульгаризмом, или оскорблением — особенно если относится к человеку."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54319ebc-ce3f-4b44-8832-995b1d86e006",
                        "source_entry_id": "2dee13bc-1a0f-30f9-ab06-a6981ba54cf0",
                        "source_sense_id": "0691392a-2c5e-3a7a-83c6-372d23f7ab6a",
                        "target_lang_word": "вульгарное",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "49998cef-8ddf-4ac0-ac6f-8522a780bd86",
                        "source_entry_id": "2dee13bc-1a0f-30f9-ab06-a6981ba54cf0",
                        "source_sense_id": "0691392a-2c5e-3a7a-83c6-372d23f7ab6a",
                        "target_lang_word": "слово",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "слово",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a2a6d90f-b92d-349e-a5b5-91a12db3b00b",
                                        "entry_id": "7bce6f6b-8ec9-3874-820e-1f0575234b54",
                                        "glosses": [
                                            "лингв. основная структурно-семантическая единица языка, обозначающая имя объекта, его свойство или поведение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aabb9dfd-2640-4470-bf97-c2ed8279639b",
                                                "sense_id": "a2a6d90f-b92d-349e-a5b5-91a12db3b00b",
                                                "text": "Однако слова́, не столь широко распространённые, сохраняют ударение на основе: «баска́к — баска́ка», «бивуа́к — бивуа́ка», «гайдама́к — гайдама́ка», «бамбу́к — бамбу́ка», «акведу́к — акведу́ка»."
                                            },
                                            {
                                                "example_id": "3a0aff07-449c-4701-9a83-163ebe0ce20c",
                                                "sense_id": "a2a6d90f-b92d-349e-a5b5-91a12db3b00b",
                                                "text": "Если слово, указанное в шаблоне, не найдено в базовом словаре (или нет его необходимой формы), то анализируется его окончание."
                                            },
                                            {
                                                "example_id": "f05376c6-7fa5-448a-bb00-294b7681cd89",
                                                "sense_id": "a2a6d90f-b92d-349e-a5b5-91a12db3b00b",
                                                "text": "Слово «девичник» употребляется в исследуемой местности в двух значениях."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6f85546-9405-3132-a47b-2a127651698e",
                                        "entry_id": "7bce6f6b-8ec9-3874-820e-1f0575234b54",
                                        "glosses": [
                                            "книжн., ед. ч. речь; язык; разговор; дар речи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1167771-0cbe-4bd9-ad49-0226237ab671",
                                                "sense_id": "d6f85546-9405-3132-a47b-2a127651698e",
                                                "text": "Теперь тебе не до стихов, о слово русское, родное!"
                                            },
                                            {
                                                "example_id": "773cb4a9-c144-481c-8888-d0cfb1dcfb5b",
                                                "sense_id": "d6f85546-9405-3132-a47b-2a127651698e",
                                                "text": "В свободном слове есть отрада."
                                            },
                                            {
                                                "example_id": "a7558342-3467-428b-bdf9-6be1131535f0",
                                                "sense_id": "d6f85546-9405-3132-a47b-2a127651698e",
                                                "text": "Культура слова и богатство родного слова стали в последние годы насущной проблемой общества."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "268b1d0e-98e0-353c-bd93-cbe86569d490",
                                        "entry_id": "7bce6f6b-8ec9-3874-820e-1f0575234b54",
                                        "glosses": [
                                            "перен., : высказывание, словесное выражение мысли, чувства и т. п."
                                        ],
                                        "tags": [
                                            "(ед. ч. в том же знач., что и мн. ч.)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8b01aa2-7c58-41f8-a63f-784641f8ce11",
                                                "sense_id": "268b1d0e-98e0-353c-bd93-cbe86569d490",
                                                "text": "— Ну, я вижу, мои слова на вас подействовали."
                                            },
                                            {
                                                "example_id": "4bc9e34c-bf2a-49e4-87ce-b9305e6ac792",
                                                "sense_id": "268b1d0e-98e0-353c-bd93-cbe86569d490",
                                                "text": "[Карташёв] стоял, слушал и презрительно щурился от разного рода громких слов вроде: «Ты мне не сын», «Я не желаю такого сына», — всех тех слов, которые существа вещей изменить не могут и обладают обоюдоострым свойством."
                                            },
                                            {
                                                "example_id": "0d3a6c41-647b-4447-82de-db34a0e8a771",
                                                "sense_id": "268b1d0e-98e0-353c-bd93-cbe86569d490",
                                                "text": "[Акулина Ивановна:] Ты своей беседой меня с отцом не жалуешь, так позволь хоть со слугой-то слово сказать."
                                            },
                                            {
                                                "example_id": "ffa4a990-4c9a-4f9a-b34e-b1881755aaec",
                                                "sense_id": "268b1d0e-98e0-353c-bd93-cbe86569d490",
                                                "text": "Последние слова Потапова, которые он ухватил, были: «Вот этого я уж никак не терплю»."
                                            },
                                            {
                                                "example_id": "086554e3-dfce-4499-a788-dcdb91ca085c",
                                                "sense_id": "268b1d0e-98e0-353c-bd93-cbe86569d490",
                                                "text": "Но его последние слова растворились в грохоте мотора."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89322f2f-8316-35fb-a0d4-6f33c906c3c7",
                                        "entry_id": "7bce6f6b-8ec9-3874-820e-1f0575234b54",
                                        "glosses": [
                                            "ед. ч. высказанное распоряжение, мнение, решение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8738b340-2770-4586-984c-1c6c85d2afb9",
                                                "sense_id": "89322f2f-8316-35fb-a0d4-6f33c906c3c7",
                                                "text": "— Что ж, говори последнее слово: продашь лошадь-то али нет?.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00586985-8efe-3b84-90ba-4d71fefafb7f",
                                        "entry_id": "7bce6f6b-8ec9-3874-820e-1f0575234b54",
                                        "glosses": [
                                            "неодобр. какое-либо заявление, утверждение, обещание и т. д., не подкреплённое делом, деятельностью, поступком"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b63b1694-7b42-46ff-a707-a7b1ed2cf79e",
                                                "sense_id": "00586985-8efe-3b84-90ba-4d71fefafb7f",
                                                "text": "— Словесами одними ничего не сделаешь…"
                                            },
                                            {
                                                "example_id": "ca2bd56c-2d5f-493c-b494-6b5bbdacf1a6",
                                                "sense_id": "00586985-8efe-3b84-90ba-4d71fefafb7f",
                                                "text": "— Я никого так не любила, как тебя. — Слова!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8276d43c-fe6e-3e0f-bf43-258f6531cc13",
                                        "entry_id": "7bce6f6b-8ec9-3874-820e-1f0575234b54",
                                        "glosses": [
                                            "перен., ед. ч. публичное выступление, речь, устное официальное заявление и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f125a66b-d854-4be0-bec5-80c18e0f1b94",
                                                "sense_id": "8276d43c-fe6e-3e0f-bf43-258f6531cc13",
                                                "text": "Пархоменко вернулся в Военный совет. Он собрал специалистов, сказал им краткое напутственное слово."
                                            },
                                            {
                                                "example_id": "0b3c7d1e-0b94-44b9-bb1d-ea5b36cc6fdc",
                                                "sense_id": "8276d43c-fe6e-3e0f-bf43-258f6531cc13",
                                                "text": "Люди горячо жестикулировали, вскакивали с мест, просили сло́ва вне очереди, торопясь высказаться."
                                            },
                                            {
                                                "example_id": "5034fcba-9f44-41f7-bd58-40764ef1999e",
                                                "sense_id": "8276d43c-fe6e-3e0f-bf43-258f6531cc13",
                                                "text": "Однако первое слово дали не ему, а Обтекаемому."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69ca9a7f-3b89-3a6b-bb02-caa22e5137b9",
                                        "entry_id": "7bce6f6b-8ec9-3874-820e-1f0575234b54",
                                        "glosses": [
                                            "перен., ед. ч. то же, что обещание; обязательство сделать, выполнить что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c50d9b02-c93e-4c6d-aec0-42652195b15f",
                                                "sense_id": "69ca9a7f-3b89-3a6b-bb02-caa22e5137b9",
                                                "text": "Я ей дал слово познакомиться с Лиговскими и волочиться за княжной."
                                            },
                                            {
                                                "example_id": "bbc43dd1-854b-4f35-84e8-5b40cdb1b038",
                                                "sense_id": "69ca9a7f-3b89-3a6b-bb02-caa22e5137b9",
                                                "text": "[Ирина] взяла с него слово, что он непременно посетит её."
                                            },
                                            {
                                                "example_id": "67bdbc76-9160-4175-b1f2-177be9e9b9d2",
                                                "sense_id": "69ca9a7f-3b89-3a6b-bb02-caa22e5137b9",
                                                "text": "[Сашу] уговорили остаться, и он дал слово, что уедет первого июля, не раньше."
                                            },
                                            {
                                                "example_id": "906ee0bf-003b-4b64-992a-25664997569e",
                                                "sense_id": "69ca9a7f-3b89-3a6b-bb02-caa22e5137b9",
                                                "text": "Я дала слово Петру Лаврентьевичу не встречаться с вами."
                                            },
                                            {
                                                "example_id": "c642765d-7ca3-47b7-94cc-c3651bc03a2d",
                                                "sense_id": "69ca9a7f-3b89-3a6b-bb02-caa22e5137b9",
                                                "text": "Я обещаю выполнять все твои поручения, я даю слово вытирать ноги у входа и мыть посуду."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20c027de-f0db-31b1-96e0-50f4029a61d3",
                                        "entry_id": "7bce6f6b-8ec9-3874-820e-1f0575234b54",
                                        "glosses": [
                                            "мн. ч. литературный текст, на который написана музыка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b987e1c6-6b15-46d4-9c85-1c850a826d62",
                                                "sense_id": "20c027de-f0db-31b1-96e0-50f4029a61d3",
                                                "text": "— Я написал вчера новый романс; слова тоже мои. Хотите, я вам спою?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c25786be-31fa-3917-9f03-ddf1d47ce15d",
                                        "entry_id": "7bce6f6b-8ec9-3874-820e-1f0575234b54",
                                        "glosses": [
                                            "устар., ед. ч. литературное произведение в форме ораторской речи, проповеди или послания, а также повествование, рассказ вообще"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ca7e3d-a237-487f-be83-8a813989772b",
                                                "sense_id": "c25786be-31fa-3917-9f03-ddf1d47ce15d",
                                                "text": "«Слово о полку Игореве»."
                                            },
                                            {
                                                "example_id": "d67592a2-7914-4119-a7aa-1a4764820970",
                                                "sense_id": "c25786be-31fa-3917-9f03-ddf1d47ce15d",
                                                "text": "«Слово о пользе стекла» М. В. Ломоносова."
                                            },
                                            {
                                                "example_id": "2a1cdd47-6c6c-4bf7-acdf-60800ebb4e09",
                                                "sense_id": "c25786be-31fa-3917-9f03-ddf1d47ce15d",
                                                "text": "[Цензура] запретила печатать что бы то ни было писанное мною, хотя бы то было слово о пользе тайной полиции."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a9d52fc-c2ec-30e4-b442-c3da36a1252a",
                                        "entry_id": "7bce6f6b-8ec9-3874-820e-1f0575234b54",
                                        "glosses": [
                                            "название буквы «С, с» в старославянском алфавите"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e129fdca-1929-4398-8385-f77ba63d30a6",
                                                "sense_id": "7a9d52fc-c2ec-30e4-b442-c3da36a1252a",
                                                "text": "«аз» «буки» «веди» // «глаголь» «добро» «есть» // «живете» «зело», «земля», «и» «иже» «и» «како» «люди» // «мыслете» «наш» «он» «покой» // «рцы» «слово» «твердо» // «ук» «ферт» «хер» // «цы» «червь» «ша» «ер» «ять» «ю»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "544e7380-2304-361a-bb74-96dcc1726759",
                                        "entry_id": "7bce6f6b-8ec9-3874-820e-1f0575234b54",
                                        "glosses": [
                                            "прогр. то же, что машинное слово; два байта или шестнадцать бит"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
