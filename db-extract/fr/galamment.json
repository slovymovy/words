                                        "glosses": [
                                            "ein erotisches Verhältnis betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f88b6ee0-4909-499f-b705-af1c78e678eb",
                                                "sense_id": "1f8d9605-2560-3d64-bc53-9185dc535ee1",
                                                "text": "Er genoss sein galantes Abenteuer."
                                            }
