                                        "sense_id": "7d5bd05f-5e7c-37fa-a73b-a601c78a6e3a",
                                        "entry_id": "b7dd1864-cae6-32f5-b732-46de1574a07e",
                                        "glosses": [
                                            "niewielki, szczelnie zamykany pojemnik z różnych materiałów, służący do przechowywania atramentu lub tuszu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f34fa147-1ed9-457c-b43a-57e1d9c21ad7",
                                                "sense_id": "7d5bd05f-5e7c-37fa-a73b-a601c78a6e3a",
                                                "text": "Co rano woźny szkolny napełniał naczynia atramentem. Ławki z otworami na kałamarze stały w polskich szkołach do końca lat sześćdziesiątych XX wieku"
