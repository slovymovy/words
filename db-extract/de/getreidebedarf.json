                "senses": [
                    {
                        "sense_id": "ba198dec-330b-3dbc-8043-716652daa64d",
                        "entry_id": "36758f42-f862-3975-a540-27239e45f13a",
                        "glosses": [
                            "Bedarf an Getreide"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e27c379-1cd3-4e2e-92e3-476e2fb1c07f",
                                "sense_id": "ba198dec-330b-3dbc-8043-716652daa64d",
                                "text": "„Freilich ereignet es sich, daß Städte wie Athen und Rom auch in ihrem Getreidebedarf auf Zufuhr angewiesen werden.“"
                            },
                            {
                                "example_id": "281a9e70-3eb5-45b9-b26a-71c4b240c71b",
                                "sense_id": "ba198dec-330b-3dbc-8043-716652daa64d",
                                "text": "„Häufig wird das Argument angeführt, steigender Wohlstand erhöhe den Fleischverzehr und damit den Getreidebedarf.“"
                            },
                            {
                                "example_id": "69455b76-906b-4a35-b624-8ff252c0aec6",
                                "sense_id": "ba198dec-330b-3dbc-8043-716652daa64d",
                                "text": "„Damit hätte man den jährlichen Getreidebedarf von ungefähr 150 Menschen decken können.”“"
                            },
                            {
                                "example_id": "ab3bab9f-b7bc-4e8c-bb13-4af5b293b713",
                                "sense_id": "ba198dec-330b-3dbc-8043-716652daa64d",
                                "text": "„Steigt der Getreidebedarf, so müssen auch Böden kultiviert werden, die nicht in unmittelbarer Nachbarschaft des Nachfragepols liegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
