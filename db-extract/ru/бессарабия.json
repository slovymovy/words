                                    {
                                        "sense_id": "4369c434-70ce-3006-9344-c68137aa0d41",
                                        "entry_id": "4c267985-3bf3-3e4d-872e-3a4a03e8adff",
                                        "glosses": [
                                            "historické území ve východní Evropě, nyní součást Moldávie a zčásti Ukrajiny"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a81c490-2fd2-41c4-88f5-b9c0735e19bb",
                                                "sense_id": "4369c434-70ce-3006-9344-c68137aa0d41",
                                                "text": "Pakt Ribbentrop-Molotov, kterým si Stalin s Hitlerem rozdělili sféry vlivu ve východní Evropě, otevřel Moskvě cestu k obsazení východní části Polska, pobaltských republik, východní části Finska a Besarábie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
