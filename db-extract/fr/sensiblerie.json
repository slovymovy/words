        "fr-extract.jsonl": [
            {
                "entry_id": "ce5a4d48-553b-34e5-a01b-083b96c932e0",
                "word": "sensiblerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2fb30a6d-4ebe-44c3-b0d3-61375b27c596",
                        "entry_id": "ce5a4d48-553b-34e5-a01b-083b96c932e0",
                        "tags": [
                            "plural"
                        ],
                        "form": "sensibleries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69c2e5e0-d65d-34a4-89e4-812448602b03",
                        "entry_id": "ce5a4d48-553b-34e5-a01b-083b96c932e0",
                        "glosses": [
                            "Sensibilité fausse et outrée ; affectation de sensibilité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ec5aa16-e34b-4b99-b833-322508d8456f",
                                "sense_id": "69c2e5e0-d65d-34a4-89e4-812448602b03",
                                "text": "Cela ne devrait pas vous nuire : il est prouvé que l’éducation des public-schools développe merveilleusement bien les qualités nécessaires aux grands assassins : méticulosité, flegme et absence totale de sensiblerie…"
                            },
                            {
                                "example_id": "c5fb4eb6-95ac-4031-830a-844636751d71",
                                "sense_id": "69c2e5e0-d65d-34a4-89e4-812448602b03",
                                "text": "Mais le diable a soufflé là-dessus, de son haleine fiévreuse et empestée, et les pires billevesées ont pris leur vol. L'homme a inventé les dieux et il a créé l'amour avec son cortège de sensibleries ridicules ou criminelles."
                            },
                            {
                                "example_id": "17fb858a-4f88-4799-be3a-64cba7601b5f",
                                "sense_id": "69c2e5e0-d65d-34a4-89e4-812448602b03",
                                "text": "Voilà ce qu'il faut réapprendre aux Français, gâtés d'un côté par les prétentions, le snobisme, la fausse élégance, de l'autre par une philosophie pleurnicharde, toute faite d'abandons à une sensibilité assez vile, à une sensiblerie aussi vaine que dévirilisante."
                            },
                            {
                                "example_id": "a4c0eba5-724b-4062-85e7-f6f601f59eae",
                                "sense_id": "69c2e5e0-d65d-34a4-89e4-812448602b03",
                                "text": "Donc, plus de fausse pudeur ni de sensiblerie de mauvais aloi. Plus de sentimentalités stériles, dommageables, le plus souvent exagérées, et dont ne sont même plus dupes les passants — aux coups de chapeaux convenus devant les corbillards."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18e25cb5-a12c-4926-af14-9a02f1ab22a3",
                        "source_entry_id": "ce5a4d48-553b-34e5-a01b-083b96c932e0",
                        "source_sense_id": "69c2e5e0-d65d-34a4-89e4-812448602b03",
                        "target_lang_word": "Gefühlsduselei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gefühlsduselei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c94c581-b991-3305-a04f-7e77f12c700f",
                                        "entry_id": "488f16f2-ded4-3018-baa0-ccc4257231da",
                                        "glosses": [
                                            "übertriebene Hingabe an (zum Beispiel) traurige Gefühle und Handlungen; überzogene Sentimentalität"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69e4b63b-a1bb-43c7-a704-fa533e24e54f",
                                                "sense_id": "9c94c581-b991-3305-a04f-7e77f12c700f",
                                                "text": "Nun hör aber mal auf zu weinen! Ich kann diese Gefühlsduselei nicht ausstehen!"
                                            },
                                            {
                                                "example_id": "40e64aec-cb31-4289-826c-26333617d157",
                                                "sense_id": "9c94c581-b991-3305-a04f-7e77f12c700f",
                                                "text": "Der Film besitzt neben den einzelnen Kampfszenen aber auch ziemlich viele Gefühlsduseleien."
                                            },
                                            {
                                                "example_id": "d68499af-1df7-488e-a86b-c6b78a5eb9c0",
                                                "sense_id": "9c94c581-b991-3305-a04f-7e77f12c700f",
                                                "text": "„Gefühlsduselei hatte meiner Meinung nach bei ihr dieselbe Wirkung, wie wenn Leinen zerrissen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5080e100-f956-431b-a894-8ee1ee034e3c",
                        "source_entry_id": "ce5a4d48-553b-34e5-a01b-083b96c932e0",
                        "source_sense_id": "69c2e5e0-d65d-34a4-89e4-812448602b03",
                        "target_lang_word": "sentimentality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sentimentality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17725b77-4998-3c76-a0a4-308dabc08c70",
                                        "entry_id": "5764e4e1-8027-3b65-ba05-e33561fb5d89",
                                        "glosses": [
                                            "An act or state of being sentimental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435e4ab9-157f-4093-a4fc-b84149583209",
                                                "sense_id": "17725b77-4998-3c76-a0a4-308dabc08c70",
                                                "text": "Things that were implicit and largely unjudged in the book, filtered through layers of stiff-upper-lip irony — Fanny’s self-pity, Linda’s obliviousness — are now foregrounded and, for the most part, rendered banal, with “Beaches”-level platitudes and sentimentality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
