                    ],
                    "common_phrases": [
                        "groene hagen",
                        "hagen snoeien"
                    ],
                    "target_lang_definitions": {
                        "en": "plural form of hedge; rows of bushes or shrubs planted close together"
                    },
                    "translations": {
