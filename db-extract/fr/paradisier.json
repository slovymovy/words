            {
                "entry_id": "fca39fb8-7bc7-3c31-94f5-207132cb06ad",
                "word": "paradisier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ff7160fd-c69f-429d-8d30-d715af70cc59",
                        "entry_id": "fca39fb8-7bc7-3c31-94f5-207132cb06ad",
                        "tags": [
                            "plural"
                        ],
                        "form": "paradisiers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55b4f324-66f6-345a-95c7-1fcbb0959376",
                        "entry_id": "fca39fb8-7bc7-3c31-94f5-207132cb06ad",
                        "glosses": [
                            "Oiseau de la famille des Paradisaeidae, famille de passereaux originaire d’Océanie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8623d439-0594-4fbe-b76c-d7e529e08887",
                                "sense_id": "55b4f324-66f6-345a-95c7-1fcbb0959376",
                                "text": "C’était là, entre un paradisier multicolore et une colombe bleue, que trônait la Vierge Noire."
                            },
                            {
                                "example_id": "abf432d8-7251-4d9d-b461-8029e65e790a",
                                "sense_id": "55b4f324-66f6-345a-95c7-1fcbb0959376",
                                "text": "Les oiseaux d'autres provenances qui sont séchés au four ou à la fumée, comme par exemple les paradisiers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "779a974a-e424-4007-bbbe-5121435ab989",
                        "source_entry_id": "fca39fb8-7bc7-3c31-94f5-207132cb06ad",
                        "source_sense_id": "55b4f324-66f6-345a-95c7-1fcbb0959376",
                        "target_lang_word": "Paradiesvogel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paradiesvogel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08192687-98a5-35b6-99e0-c582257f19b5",
                                        "entry_id": "d9f3f888-e3f3-3c1e-8dff-c4aec9dd4637",
                                        "glosses": [
                                            "eine auffallende, seltsame Person"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b6e6531-3fd4-41fc-8b4e-2288c1a48e01",
                                                "sense_id": "08192687-98a5-35b6-99e0-c582257f19b5",
                                                "text": "Er ist ein Lebemann, ein unangepasster Paradiesvogel und auch sonst kein Kind von Traurigkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0e782158-3eed-3776-92b6-73dd4e041430",
                                        "entry_id": "d9f3f888-e3f3-3c1e-8dff-c4aec9dd4637",
                                        "glosses": [
                                            "ein Sternbild des Südhimmels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89c93d17-7c6c-4d08-ace5-14328df808ac",
                                                "sense_id": "0e782158-3eed-3776-92b6-73dd4e041430",
                                                "text": "Der Paradiesvogel ist ein unscheinbares Sternbild in der Nähe des südlichen Himmelspols. Nur zwei seiner Sterne sind heller als die 4. Größenklasse. Das Sternbild soll einen tropischen Vogel darstellen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "95ab2add-d0e1-329a-99c7-b2c56da043c8",
                                        "entry_id": "d9f3f888-e3f3-3c1e-8dff-c4aec9dd4637",
                                        "glosses": [
                                            "ein Singvogel, der in Australien und vor allem Neuguinea lebt; ein Vertreter aus der Familie der Paradiesvögel (Paradiseidae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38433c41-0896-4a78-8885-9f03cb2db4e8",
                                                "sense_id": "95ab2add-d0e1-329a-99c7-b2c56da043c8",
                                                "text": "Auch das Wappen Papua-Neuguineas zeigt einen Paradiesvogel."
                                            },
                                            {
                                                "example_id": "cff19a34-68f7-4975-abe8-a920bbd6128d",
                                                "sense_id": "95ab2add-d0e1-329a-99c7-b2c56da043c8",
                                                "text": "„Auf ihr waren Pflanzen und Tiere abgebildet, Vögel, wie ich auf den zweiten Blick erkannte, bunte Paradiesvögel und Dschungelpflanzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e54e0a49-7193-4d3f-9b81-4ca4bddff3ea",
                        "source_entry_id": "fca39fb8-7bc7-3c31-94f5-207132cb06ad",
