{
    "word_family": [
        "curdle",
        "curdy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "58a2f0c9-f352-37d9-beb9-5fabed55f06b",
                    "sense_definition": "The coagulated part of milk formed when it sours or is treated with enzymes, used to make cheese.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dairy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cheesemaker separated the solid <w>curd</w> from the remaining liquid whey.",
                            "target_lang_translations": {
                                "pl": "Serowar oddzielił stały <w>skrzep</w> od pozostałej płynnej serwatki."
                            }
                        },
                        {
                            "text": "Fresh cheese <w>curds</w> are a traditional ingredient in French Canadian poutine.",
                            "target_lang_translations": {
                                "pl": "Świeże <w>kawałki skrzepu serowego</w> są tradycyjnym składnikiem francusko-kanadyjskiego poutine."
                            }
                        }
                    ],
                    "antonyms": [
                        "whey"
                    ],
                    "common_phrases": [
                        "curds and whey",
                        "cheese curds",
                        "bean curd",
                        "lemon curd"
                    ],
                    "target_lang_definitions": {
                        "pl": "Skrzepnięta część mleka powstająca podczas jego kwaśnienia lub pod wpływem enzymów, używana do produkcji sera; skrzep, twaróg."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "skrzep",
                                "target_lang_sense_clarification": "skrzepnięte mleko przy produkcji sera"
                            },
                            {
                                "target_lang_word": "twaróg",
                                "target_lang_sense_clarification": "grudki sera twarogowego"
                            },
                            {
                                "target_lang_word": "zsiadłe mleko",
                                "target_lang_sense_clarification": "skrzepłe, kwaśne mleko"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ec3bc05-ccec-3b77-9efc-d2cfad4182ec",
                    "sense_definition": "A traditional South Asian yogurt-like dairy product; dahi.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dairy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She served spicy curry alongside a bowl of fresh <w>curd</w> and rice.",
                            "target_lang_translations": {
                                "pl": "Podała pikantne curry z miską świeżego <w>jogurtu dahi</w> i ryżem."
                            }
                        },
                        {
                            "text": "Mixing cool <w>curd</w> with vegetables creates a soothing side dish.",
                            "target_lang_translations": {
                                "pl": "Wymieszanie chłodnego <w>jogurtu</w> z warzywami tworzy łagodzący dodatek do dania."
                            }
                        }
                    ],
                    "synonyms": [
                        "dahi"
                    ],
                    "common_phrases": [
                        "curd rice"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily South Asia"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Tradycyjny południowoazjatycki produkt mleczny przypominający jogurt; dahi."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dahi",
                                "target_lang_sense_clarification": "azjatycki jogurt tradycyjny"
                            },
                            {
                                "target_lang_word": "jogurt",
                                "target_lang_sense_clarification": "jogurt tradycyjny w kuchni indyjskiej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63f33e7f-e5d9-33ce-9952-d51e8f23966a",
                    "sense_definition": "Any coagulated, thickened mass formed in a liquid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dairy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Adding the chemical reagent caused a thick <w>curd</w> to form at the surface.",
                            "target_lang_translations": {
                                "pl": "Dodanie odczynnika chemicznego spowodowało powstanie grubego <w>koagulatu</w> na powierzchni."
                            }
                        },
                        {
                            "text": "The chemist filtered the insoluble <w>curds</w> out of the reaction solution.",
                            "target_lang_translations": {
                                "pl": "Chemik odfiltrował nierozpuszczalny <w>osad</w> z roztworu reakcyjnego."
                            }
                        }
                    ],
                    "synonyms": [
                        "coagulum"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dowolna ścięta, zagęszczona masa powstała w cieczy; koagulat, kłaczek lub osad."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "skrzep",
                                "target_lang_sense_clarification": "ścięta masa w płynie"
                            },
                            {
                                "target_lang_word": "koagulat",
                                "target_lang_sense_clarification": "substancja powstała w procesie koagulacji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f030f7e0-c4c6-3e73-a24a-ca85431d396b",
                    "sense_definition": "The dense, edible flowering head of plants such as cauliflower or broccoli.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Harvest the cauliflower while the white <w>curd</w> is still tight and firm.",
                            "target_lang_translations": {
                                "pl": "Zbieraj kalafior, dopóki biała <w>róża</w> jest jeszcze zwarta i twarda."
                            }
                        },
                        {
                            "text": "Excessive heat can cause the vegetable's <w>curd</w> to become loose and discolored.",
                            "target_lang_translations": {
                                "pl": "Nadmierne ciepło może sprawić, że <w>róża</w> warzywa stanie się luźna i odbarwiona."
                            }
                        }
                    ],
                    "synonyms": [
                        "head"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "agricultural context"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zbita, jadalna część kwiatostanu roślin takich jak kalafior lub brokuł; róża."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "róża",
                                "target_lang_sense_clarification": "jadalna główka kalafiora lub brokułu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "229ead06-2e66-3b64-9953-3cebb972694f",
                    "sense_definition": "To form into curd; to coagulate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "coagulate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When acid was added to the warm milk, it quickly began to <w>curd</w>.",
                            "target_lang_translations": {
                                "pl": "Kiedy do ciepłego mleka dodano kwas, szybko zaczęło się <w>ścinać</w>."
                            }
                        },
                        {
                            "text": "The mixture <w>curds</w> if you cook it at too high a temperature.",
                            "target_lang_translations": {
                                "pl": "Mieszanina <w>warzy się</w>, jeśli gotuje się ją w zbyt wysokiej temperaturze."
                            }
                        }
                    ],
                    "synonyms": [
                        "curdle",
                        "coagulate"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zsiadać się, ścinać się lub koagulować."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ścinać się",
                                "target_lang_sense_clarification": "o płynie, np. mleku"
                            },
                            {
                                "target_lang_word": "zsiadać się",
                                "target_lang_sense_clarification": "o mleku"
                            },
                            {
                                "target_lang_word": "koagulować",
                                "target_lang_sense_clarification": "przechodzić w stan skrzepu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d1cab60-5d8b-3d47-b2f2-e8187aa2c1c5",
                    "sense_definition": "To cause a liquid to coagulate, congeal, or thicken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "coagulate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A few drops of lemon juice will easily <w>curd</w> the warm cream.",
                            "target_lang_translations": {
                                "pl": "Kilka kropel soku z cytryny z łatwością <w>zetnie</w> ciepłą śmietankę."
                            }
                        },
                        {
                            "text": "The sudden horrifying screech was enough to <w>curd</w> anyone's blood.",
                            "target_lang_translations": {
                                "pl": "Nagły, przerażający pisk wystarczył, by <w>zmrozić</w> każdemu krew w żyłach."
                            }
                        }
                    ],
                    "synonyms": [
                        "curdle"
                    ],
                    "common_phrases": [
                        "curd blood"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often replaced by curdle"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Powodować ścinanie się, gęstnienie lub koagulację płynu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ścinać",
                                "target_lang_sense_clarification": "powodować koagulację płynu"
                            },
                            {
                                "target_lang_word": "warzyć",
                                "target_lang_sense_clarification": "powodować ścinanie się mleka"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "38e9ed58-1ee1-371d-867c-1ce98ca792fb",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Curd</w> published an influential research paper on ancient philosophy.",
                            "target_lang_translations": {
                                "pl": "Profesor <w>Curd</w> opublikował wpływowy artykuł naukowy na temat filozofii starożytnej."
                            }
                        },
                        {
                            "text": "The local library was named in honor of the philanthropist Arthur <w>Curd</w>.",
                            "target_lang_translations": {
                                "pl": "Miejscową bibliotekę nazwano na cześć filantropa Arthura <w>Curda</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nazwisko."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Curd",
                                "target_lang_sense_clarification": "nazwisko"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}