                                        "examples": [
                                            {
                                                "example_id": "dff36d5e-0167-42e0-bbae-8856152a2da9",
                                                "sense_id": "e9ef6d00-4c43-3bb0-97ad-9acba6a7e79f",
                                                "text": "La désobéissance est le défaut principal de cet enfant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7f56225-6815-3e28-b158-915fefb0c9f9",
                                        "entry_id": "70bfe010-f7d0-3838-8598-1bda8ddf853e",
                                        "glosses": [
                                            "Acte par lequel on désobéit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e47ccc6-19e9-4c71-862a-92a4663cc76b",
                                                "sense_id": "a7f56225-6815-3e28-b158-915fefb0c9f9",
                                                "text": "C’est pour une seule désobéissance qu’il a été puni."
                                            },
                                            {
                                                "example_id": "6bd777a0-38d3-479c-aeaa-55d7597b4f03",
                                                "sense_id": "a7f56225-6815-3e28-b158-915fefb0c9f9",
                                                "text": "Les désobéissances de cet enfant lui attirent de fréquentes punitions."
                                            },
                                            {
                                                "example_id": "c3eb79a2-a1ec-49f3-bb1c-7cfa88845d99",
                                                "sense_id": "a7f56225-6815-3e28-b158-915fefb0c9f9",
                                                "text": "Le péché est une désobéissance à la loi de Dieu."
                                            }
                                        ]
                                    }
                                ]
                            }
