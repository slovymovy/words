                "senses": [
                    {
                        "sense_id": "b1d9a6f6-a10f-3e64-8594-9f56210016b5",
                        "entry_id": "112aa44a-cd27-31d8-8a39-114e56e0828c",
                        "glosses": [
                            "устар. заманивать, зазывать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a97e5a6-3f27-41e4-862c-a66ddf082bad",
                                "sense_id": "b1d9a6f6-a10f-3e64-8594-9f56210016b5",
                                "text": "Спуску никому не было: дворян и богатых купцов он залучал насильно к себе в гости, поил, кормил по целым суткам, а там бог весть что с ними было;.."
                            },
                            {
                                "example_id": "255a9f58-6a2c-4270-8395-f0ad11cea82f",
                                "sense_id": "b1d9a6f6-a10f-3e64-8594-9f56210016b5",
                                "text": "❬…❭и жил я таковым страшилищем и пугалом ровно тридцать лет, и залучал я в мой дворец заколдованный одиннадцать девиц красных, а ты была двенадцатая."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa1088d7-921f-44c4-b613-1d4c35646f96",
                        "source_entry_id": "112aa44a-cd27-31d8-8a39-114e56e0828c",
                        "source_sense_id": "b1d9a6f6-a10f-3e64-8594-9f56210016b5",
                        "target_lang_word": "entice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e644758c-c4f5-3e8d-9654-db721320e0f9",
                                        "entry_id": "6903c238-8237-3e83-81f1-126a321be2e8",
                                        "glosses": [
                                            "To lure; to attract by arousing desire or hope."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c0e87f5-7cc3-4809-853d-5915ab25574a",
                                                "sense_id": "e644758c-c4f5-3e8d-9654-db721320e0f9",
                                                "text": "I enticed the little bear into the trap with a pot of honey."
                                            },
                                            {
                                                "example_id": "8b37e2a2-13fa-4f64-b729-6fa1221567d4",
                                                "sense_id": "e644758c-c4f5-3e8d-9654-db721320e0f9",
                                                "text": "Blackboard sketches, geological maps, diagrams of molecular structure, astronomical photographs, MRI images, the many varieties of statistical charts and graphs: These pictorial devices are indispensable tools for presenting evidence, for explaining a theory, for telling a story. And, on top of all that, they are ornaments; they entice and intrigue and sometimes delight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac43fc8d-dd8f-4aa1-b639-d530094e6353",
                        "source_entry_id": "112aa44a-cd27-31d8-8a39-114e56e0828c",
                        "source_sense_id": "b1d9a6f6-a10f-3e64-8594-9f56210016b5",
                        "target_lang_word": "lure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "030f42eb-a859-3c3a-88b9-8c8e9370f4fc",
                                        "entry_id": "abd2b03c-a306-3299-81e0-9efcc5bb58e3",
                                        "glosses": [
                                            "Something that tempts or attracts, especially one with a promise of reward or pleasure."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aaf7629-17f7-458f-9fc3-7c1e733f8dd6",
                                                "sense_id": "030f42eb-a859-3c3a-88b9-8c8e9370f4fc",
                                                "text": "How many have with a smile made small account\nOf Beauty and her lures"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66bd009f-f8fe-31f7-81d7-f4d61fb5a65b",
                                        "entry_id": "abd2b03c-a306-3299-81e0-9efcc5bb58e3",
                                        "glosses": [
                                            "An artificial bait attached to a fishing line to attract fish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a97b51a0-6582-36c8-a918-fa43b593306a",
                                        "entry_id": "abd2b03c-a306-3299-81e0-9efcc5bb58e3",
                                        "glosses": [
                                            "A bunch of feathers attached to a line, used in falconry to recall the hawk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ebcf22c-2569-432d-a585-4a811a71f2f0",
                                                "sense_id": "a97b51a0-6582-36c8-a918-fa43b593306a",
                                                "text": "My Faulcon now is ſharpe and paſſing emptie, / And til ſhe ſtoope ſhe muſt not be full gorg'd, / For then ſhe never lookes upon her lure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a4ee769-9595-3c95-b1ce-92733cd48f58",
                                        "entry_id": "abd2b03c-a306-3299-81e0-9efcc5bb58e3",
                                        "glosses": [
                                            "A velvet smoothing brush."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45c15d89-56f2-3230-abe2-ec9b1ed543bc",
                                        "entry_id": "60dbcd39-38f0-3123-baae-8f4fd7583f85",
                                        "glosses": [
                                            "To attract by temptation, appeal, or guile."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea61239d-c684-491b-a184-4812bb520835",
                                                "sense_id": "45c15d89-56f2-3230-abe2-ec9b1ed543bc",
                                                "text": "It had been sixteen years since the BBC’s Grace Wyndham Goldie wrote her internal memo about luring him back to make sociological/scientific TV programmes. Now a second note had circulated, from the science department, proposing that he should present the Corporation’s next educative megaseries."
                                            },
                                            {
                                                "example_id": "667b9043-c425-4a89-b608-db8878f040c7",
                                                "sense_id": "45c15d89-56f2-3230-abe2-ec9b1ed543bc",
                                                "text": "Professor is what you become after teaching for twenty to thirty years. Research Professor is what you then want to become, so you can finally stop worrying about students and do the research that lured you into academia in the first place!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43cd0476-6712-327f-956f-5ee1b3fc67db",
                                        "entry_id": "60dbcd39-38f0-3123-baae-8f4fd7583f85",
                                        "glosses": [
                                            "To attract fish with a lure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53620031-fbf0-31f8-8bfa-3298710f0f2f",
                                        "entry_id": "60dbcd39-38f0-3123-baae-8f4fd7583f85",
                                        "glosses": [
                                            "To recall a hawk with a lure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
