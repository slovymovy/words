                                "sense_id": "d8454621-9353-3c37-b12d-c140f136c7de",
                                "text": "Blätter einer Blütenhülle sind ein Sonderfall von Hochblättern."
                            },
                            {
                                "example_id": "0aaab2aa-2103-45ae-950b-b2364d6dfb9a",
                                "sense_id": "d8454621-9353-3c37-b12d-c140f136c7de",
                                "text": "Das Schneeglöckchen bohrt sich mit dem Hochblatt durch den Boden."
                            }
                        ],
