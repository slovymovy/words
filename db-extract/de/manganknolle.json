                        "entry_id": "39cb59b8-0594-3d3c-bb50-d87227e33922",
                        "glosses": [
                            "nodule polymétallique, concrétion minérale formée de cercles concentriques d’hydroxydes de fer et de manganèse autour d’un noyau reposant sur le lit océanique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ccf59f8-0ba6-4cb7-83e3-95eda5935b3b",
                                "sense_id": "df221dcf-e4ab-3f10-b892-a739c8f1e9d9",
                                "text": "Besonders bekannt sind Manganknollen, die hier massenhaft wachsen und wie Kartoffeln auf dem schlammigen Meeresboden liegen."
                            }
                        ]
                    }
