                        "entry_id": "bb411ac2-5ba3-364c-8c89-464d7f011889",
                        "glosses": [
                            "Able to be forded."
                        ],
                        "tags": [
                            "of a body of water"
                        ],
                        "examples": [
                            {
                                "example_id": "1e957dd8-eeb7-4ed2-ac9c-9d1583788515",
                                "sense_id": "fa6bc22e-45ce-36b3-b230-867a0a6aa5ff",
                                "text": "There, if you are in luck, you will find the tide out and the place fordable dryshod for a man on a horse."
                            },
                            {
                                "example_id": "3be4baa4-1b22-4bb7-9197-8f0067ce4471",
                                "sense_id": "fa6bc22e-45ce-36b3-b230-867a0a6aa5ff",
                                "text": "However, there were a number of fordable spots in the vicinity."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f43ee81f-2f5a-4480-9f81-3b481f9932e0",
