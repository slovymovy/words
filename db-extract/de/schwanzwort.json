                ],
                "senses": [
                    {
                        "sense_id": "baf83439-661c-3a3b-8f45-8a6c4d27f3c5",
                        "entry_id": "41d08952-b204-3cca-be62-f2b19e9efe5d",
                        "glosses": [
                            "Kurzwort, das durch Kürzung eines längeren Wortes entstanden ist und bei dem eine oder mehr Endsilbe(n) des gekürzten Wortes erhalten blieb(en)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3dd42ca-7ab7-491c-ad65-37dd94cf624a",
                                "sense_id": "baf83439-661c-3a3b-8f45-8a6c4d27f3c5",
                                "text": "\"Cello\" (für \"Violoncello\"), \"Bus\" (für \"Autobus\") sind Schwanzwörter im Deutschen."
                            },
                            {
                                "example_id": "cfea7411-f213-4198-ad32-dd5eddceedf6",
                                "sense_id": "baf83439-661c-3a3b-8f45-8a6c4d27f3c5",
                                "text": "„Unisegmentale Kurzwörter sind Anfangs- oder Endsegmente (auch als Kopf- oder Schwanzwörter, initiale oder finale Segmente bezeichnet) der Vollformen.“"
                            },
                            {
                                "example_id": "f889f2cb-0693-40c6-9a8e-5716206acbbc",
                                "sense_id": "baf83439-661c-3a3b-8f45-8a6c4d27f3c5",
                                "text": "„Kopf- und Schwanzwörter sind Wörter aus jeweils ersten oder letzten Teilen von Wörtern oder Wortgruppen.“"
                            },
                            {
                                "example_id": "e33ad18a-08df-4fb2-baa3-befc663b3af1",
                                "sense_id": "baf83439-661c-3a3b-8f45-8a6c4d27f3c5",
                                "text": "„In größerem Umfang aufgenommen sind gekürzte Wörter, sogenannte Kopfwörter, bei denen nur der Anfang geblieben und der Schluß weggelassen ist (…), und Schwanzwörter (bei denen der Schluß geblieben und der Anfang weggelassen ist…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
