                                "target_senses": [
                                    {
                                        "sense_id": "a7da5409-a852-3dd9-aeac-467cbabbe8e9",
                                        "entry_id": "f34f24c5-1fc5-3ea9-86b6-a54ed47c3533",
                                        "glosses": [
                                            "Désir d'humanité, qui fait de nous des humains, élaboré de génération en génération dont la transmission ne sera jamais complète (\\\"On est jamais trop humain …\\\")."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c186ca97-d257-45d9-b24e-6f872b35ef54",
                                                "sense_id": "a7da5409-a852-3dd9-aeac-467cbabbe8e9",
                                                "text": "L’humain n’est donc pas seulement le produit de l’humanisation, il est aussi son fondement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
