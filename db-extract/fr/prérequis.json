        "de-extract.jsonl": [
            {
                "entry_id": "5c58fe76-6ede-3624-848a-e2a56f00da53",
                "word": "prérequis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "62d2f9e6-2823-35f6-858e-8a192811779a",
                        "entry_id": "5c58fe76-6ede-3624-848a-e2a56f00da53",
                        "glosses": [
                            "Vorbedingung, Voraussetzung"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63b8dc8a-09fc-4591-91e2-d84c9c3e8432",
                        "source_entry_id": "5c58fe76-6ede-3624-848a-e2a56f00da53",
                        "source_sense_id": "62d2f9e6-2823-35f6-858e-8a192811779a",
                        "source_sense_description": "Vorbedingung, Voraussetzung",
                        "target_lang_word": "Vorbedingung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorbedingung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97d6b2dd-5760-3e23-ae2c-53de9e81c731",
                                        "entry_id": "5931cee1-60d0-3782-b34e-a9cd8b4b82e5",
                                        "glosses": [
                                            "Bedingung, die erfüllt sein muss, bevor eine Handlung gesetzt wird oder ein Ereignis eintreten kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50ca21bb-dec4-4550-a0d8-b22f3dfed68f",
                                                "sense_id": "97d6b2dd-5760-3e23-ae2c-53de9e81c731",
                                                "text": "Die Vereinigung müsse zunächst ihren Forderungskatalog fallen lassen und dann ohne Vorbedingungen in neue Verhandlungen gehen."
                                            },
                                            {
                                                "example_id": "0f291400-6cd6-408a-9fff-95428cb917a3",
                                                "sense_id": "97d6b2dd-5760-3e23-ae2c-53de9e81c731",
                                                "text": "Da die Türkei sich weigere, die Vereinbarungen ohne Vorbedingungen in angemessener Zeit zu ratifizieren, werde der Prozess im armenischen Parlament ausgesetzt, betonten jetzt Vertreter der Regierungskoalition."
                                            },
                                            {
                                                "example_id": "505b12e7-5930-4b45-a310-5deca0a47aaf",
                                                "sense_id": "97d6b2dd-5760-3e23-ae2c-53de9e81c731",
                                                "text": "Höchstleistungen beim Datenlesen und der Computeranalyse sind die Vorbedingungen für Erfolge der Tumordetektive."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4754da55-fa3a-39bb-837d-6e1919f119f6",
                                        "entry_id": "5931cee1-60d0-3782-b34e-a9cd8b4b82e5",
                                        "glosses": [
                                            "Voraussetzung, die gegeben sein muss, damit die Ausführung einer Funktion ein definiertes Ergebnis erbringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eee724cc-3fbe-4a33-8dee-7da510f406f6",
                                                "sense_id": "4754da55-fa3a-39bb-837d-6e1919f119f6",
                                                "text": "Vorbedingungen sind in der objektorientierten Softwareentwicklung ein wesentlicher Bestandteil des „Design by Contract“."
                                            },
                                            {
                                                "example_id": "da5c8ef3-5ce8-47d4-9b89-e5995d5f5a73",
                                                "sense_id": "4754da55-fa3a-39bb-837d-6e1919f119f6",
                                                "text": "Die Vorbedingung des Use Case gibt an, welche Bedingungen das System vor Beginn eines Use-Case-Ablaufs garantiert."
                                            },
                                            {
                                                "example_id": "307c3f2a-3cbe-463b-8563-37c35b29db80",
                                                "sense_id": "4754da55-fa3a-39bb-837d-6e1919f119f6",
                                                "text": "Generell zeigt eine Vorbedingung an, dass bereits ein anderer Use Case abgelaufen ist, der sie eingerichtet hat."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63e22158-edff-4c1b-af96-15d2a0a8046a",
                        "source_entry_id": "5c58fe76-6ede-3624-848a-e2a56f00da53",
                        "source_sense_id": "62d2f9e6-2823-35f6-858e-8a192811779a",
                        "source_sense_description": "Vorbedingung, Voraussetzung",
                        "target_lang_word": "Voraussetzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Voraussetzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d969607-bb67-304f-a87e-76e03258beb2",
                                        "entry_id": "f0233abf-8356-3106-81b3-1d6ef9a35dc5",
                                        "glosses": [
                                            "eine Bedingung, die im Vorfeld erfüllt sein muss; etwas was benötigt wird, bevor etwas anderes eintreten kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c373d14-b272-41ef-909e-070a17d6f2ac",
                                                "sense_id": "1d969607-bb67-304f-a87e-76e03258beb2",
                                                "text": "Wir unterschreiben den Vertrag unter der Voraussetzung, dass Sie die Preise um 5 % senken."
                                            },
                                            {
                                                "example_id": "70f9c1f5-3fcf-43ed-931d-836430893aa5",
                                                "sense_id": "1d969607-bb67-304f-a87e-76e03258beb2",
                                                "text": "Sie erfüllen nicht die nötigen Voraussetzungen um in diesem Beruf zu arbeiten."
                                            },
                                            {
                                                "example_id": "62a844f3-bae1-40c6-9b30-dac432cddf90",
                                                "sense_id": "1d969607-bb67-304f-a87e-76e03258beb2",
                                                "text": "Steuersenkungen schaffen die nötige Voraussetzung für ein weiteres Wirtschaftswachstum."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d230fc72-eef1-36f2-a783-10fe5cb336ec",
                                        "entry_id": "f0233abf-8356-3106-81b3-1d6ef9a35dc5",
                                        "glosses": [
                                            "eine Annahme, die einer Überlegung vorangestellt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9722c6c7-26bf-4475-996b-f63262f2c1e3",
                                                "sense_id": "d230fc72-eef1-36f2-a783-10fe5cb336ec",
                                                "text": "Das stimmt nicht, denn ihre Argumentation geht von falschen Voraussetzungen aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
