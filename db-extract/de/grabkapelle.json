                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac3af13e-872f-47ab-ac00-85012eba5eba",
                                "sense_id": "348787e2-d654-3503-85d7-c655eef09571",
                                "text": "In der Grabkapelle gedenken wir unserer verstorbenen Vorfahren."
                            },
                            {
                                "example_id": "c5fd6b43-0bcf-4f7b-8f91-11428becbffe",
                                "sense_id": "348787e2-d654-3503-85d7-c655eef09571",
                                "text": "„In warmen Nächten roch das Haus jetzt wie eine Grabkapelle oder ein Klostergarten.“"
                            },
                            {
                                "example_id": "3ed85241-0204-47b5-9896-ddb9098dd3f3",
                                "sense_id": "348787e2-d654-3503-85d7-c655eef09571",
                                "text": "„Es wurde in einen Zinnsarg umgebettet, mit Urkunden versehen und in einer neugotischen Grabkapelle an derselben Stelle erneut bestattet.“"
                            }
                        ],
