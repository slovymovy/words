                "senses": [
                    {
                        "sense_id": "12685cbe-3fe8-3cad-b51e-bcf93e535e1d",
                        "entry_id": "36673d24-1204-3024-a5e6-d7336add9608",
                        "glosses": [
                            "to see (many times, frequently); iterative of ви́деть (vídetʹ)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1a94b436-e803-33c7-8cd8-d65936a83bb5",
                        "entry_id": "36673d24-1204-3024-a5e6-d7336add9608",
                        "glosses": [
                            "to be seen (in the negative sentence, usually in the infinitive)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2ad1a49-4002-48e7-b6e9-4ff28c9f845e",
                                "sense_id": "1a94b436-e803-33c7-8cd8-d65936a83bb5",
                                "text": "Не вида́ть тебе́ тепе́рь зарпла́ты, как свои́х уше́й!",
                                "translation": "You won't see your wages now like you won't see your (own) ears.",
                                "english": "You won't see your wages now like you won't see your (own) ears."
                            }
                        ]
                    }
                ],
