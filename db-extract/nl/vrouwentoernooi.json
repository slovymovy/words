                "senses": [
                    {
                        "sense_id": "3d249c5e-124d-3569-b4dd-00c3c08ba873",
                        "entry_id": "326f8a5f-453b-3a62-a593-98138a160cb7",
                        "glosses": [
                            "serie wedstrijden met vrouwelijke deelnemers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbfea986-3381-4ae2-ad1a-6345cdcb7993",
                                "sense_id": "3d249c5e-124d-3569-b4dd-00c3c08ba873",
                                "text": "Sportmarketeer Klomp wijst op de achterstand die de vrouwen nu nog hebben. \"Het eerste WK bij de mannen was in 1930, het eerste vrouwentoernooi in 1991, de vrouwen hebben dus een inhaalslag te maken en daar zijn ze mee bezig. De komende eindrondes bij de vrouwen kunnen dezelfde status krijgen als die van de mannen, met grote acties vooraf. We moeten vooral oog hebben voor de goede ontwikkelingen.\""
                            },
                            {
                                "example_id": "7aa9efcb-a414-4147-8205-95a446baef1b",
                                "sense_id": "3d249c5e-124d-3569-b4dd-00c3c08ba873",
                                "text": "De Nederlandse deelnemers aan het vrouwentoernooi, Aileen de Graaf en Noa-Lynn van Leuven, werden allebei in de eerste ronde uitgeschakeld. De Graaf verloor van Mikuru Suzuki, Van Leuven moest haar meerdere erkennen in Beau Greaves."
                            },
                            {
                                "example_id": "aa16029e-d1b9-4de6-9b5f-8f2a8eb99adb",
                                "sense_id": "3d249c5e-124d-3569-b4dd-00c3c08ba873",
                                "text": "Arantxa Rus, die zich vrijdag kwalificeerde voor het hoofdtoernooi, werd in de eerste ronde van het vrouwentoernooi gekoppeld aan Julia Grabher. De Oostenrijkse staat 74ste op de wereldranglijst, zo'n veertig plaatsen hoger dan Rus."
                            }
                        ]
                    }
