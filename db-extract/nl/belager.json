                        "target_lang_word": "Verfolger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verfolger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5976062e-50c4-35eb-ac55-980838941c73",
                                        "entry_id": "c13d866f-992b-37dc-8549-de7a02821c10",
                                        "glosses": [
                                            "jemand, der jemanden oder etwas verfolgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aae332f-23e0-4027-8030-45cc4db23bd4",
                                                "sense_id": "5976062e-50c4-35eb-ac55-980838941c73",
                                                "text": "Er konnte seine Verfolger nicht sehen, aber ihre Schritte im Gebüsch hören."
                                            },
                                            {
                                                "example_id": "5629a120-3147-4b46-9732-dd580c0b81b8",
                                                "sense_id": "5976062e-50c4-35eb-ac55-980838941c73",
                                                "text": "„Aber so rasch entging er dem Verfolger nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e36c490a-5154-32a5-864e-c1c55d2318ec",
                                        "entry_id": "c13d866f-992b-37dc-8549-de7a02821c10",
                                        "glosses": [
                                            "um die gleiche Position kämpfender Konkurrent, der unter beziehungsweise hinter einem liegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0b757dd-75ed-42d1-9dce-5e457cac2810",
                                                "sense_id": "e36c490a-5154-32a5-864e-c1c55d2318ec",
                                                "text": "Der FC Bayern hatte schon sehr früh alle Verfolger abgeschüttelt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "34e36539-9e20-352a-9fd1-dda458b542e2",
                                        "entry_id": "c13d866f-992b-37dc-8549-de7a02821c10",
                                        "glosses": [
                                            "eine Art von Scheinwerfer"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b58e84ba-dbef-47f8-943e-844415574900",
                        "source_entry_id": "d98440a9-cccb-32e8-b140-b501388566fc",
                        "source_sense_id": "b7e039cf-7ace-3a05-b491-4defb6949eb0",
                        "source_sense_description": "iemand die iemand anders lastig valt",
                        "target_lang_word": "Angreifer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angreifer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43960e4b-e9de-3660-9e50-dadb81de60ed",
                                        "entry_id": "d722e852-bcb3-3d73-9ec9-ea5859639b6f",
                                        "glosses": [
                                            "jemand, der angreift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60bfd5d5-0548-4d0c-964f-974a87efb644",
                                                "sense_id": "43960e4b-e9de-3660-9e50-dadb81de60ed",
                                                "text": "Die Angreifer waren maskiert und flohen in Richtung Stadtmitte."
                                            },
                                            {
                                                "example_id": "02109703-b848-4405-aea8-d12eebd610d0",
                                                "sense_id": "43960e4b-e9de-3660-9e50-dadb81de60ed",
                                                "text": "„Die persönlichen Gegenstände waren es, die den Archäologen schließlich die entscheidenden Hinweise auf die Herkunft der Angreifer gaben.“"
                                            },
                                            {
                                                "example_id": "7db82960-8678-486c-98de-9b5873832824",
                                                "sense_id": "43960e4b-e9de-3660-9e50-dadb81de60ed",
                                                "text": "„Silvers zufriedenes Brummen sagte mir, daß mein Angreifer tot war.“"
                                            },
                                            {
                                                "example_id": "4b4ee592-6c52-4fdd-bfc0-2ad636000787",
                                                "sense_id": "43960e4b-e9de-3660-9e50-dadb81de60ed",
                                                "text": "„Die Jerusalemer Mauer fiel 1967, als Israel die arabischen Angreifer hinter den Jordan trieb und Ostjerusalem eroberte.“"
                                            },
                                            {
                                                "example_id": "9850ada2-31e6-43ee-b9c7-ceaeee6ec631",
                                                "sense_id": "43960e4b-e9de-3660-9e50-dadb81de60ed",
                                                "text": "„Sie hielten die Angreifer auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "053fb913-67c1-49c0-b17c-51d92b6d3df7",
                        "source_entry_id": "d98440a9-cccb-32e8-b140-b501388566fc",
                        "source_sense_id": "b7e039cf-7ace-3a05-b491-4defb6949eb0",
                        "source_sense_description": "iemand die iemand anders lastig valt",
                        "target_lang_word": "Stalker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stalker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff022642-03db-3ad1-b3df-d301e7129ca4",
                                        "entry_id": "77683116-3755-3edb-9097-9d8b99f1c5e1",
                                        "glosses": [
                                            "jemand, der eine andere Person unaufhörlich verfolgt, bedrängt oder bedroht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c8711ec-e659-4fd5-941b-0dd8959b8a80",
                                                "sense_id": "ff022642-03db-3ad1-b3df-d301e7129ca4",
                                                "text": "Das Verhalten des Stalkers schlägt dann in Verleumdungen und Beleidigungen um, wenn das Opfer nicht auf das Handeln des Täters reagiert, und kann in jahrelangem Psychoterror münden."
                                            },
                                            {
                                                "example_id": "e3017cf5-376a-47f6-98fb-18c9ab18dfb4",
                                                "sense_id": "ff022642-03db-3ad1-b3df-d301e7129ca4",
                                                "text": "Ein verliebter Stalker will dem Opfer meist nicht schaden, aber dem sadistischen Stalker geht es um die Dominanz über das Opfer."
                                            },
                                            {
                                                "example_id": "0dbf9aac-ec56-4432-92e6-c721a4054122",
                                                "sense_id": "ff022642-03db-3ad1-b3df-d301e7129ca4",
                                                "text": "Stalker ertragen keine Zurückweisung, deshalb handelt es sich bei den meisten auch um verlassene Lebenspartner oder zurückgewiesene Liebhaber, die eine Trennung oder ein Nein nicht akzeptieren können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f1432cb-ed08-4a5d-b5f1-7b5a99896eec",
                        "source_entry_id": "d98440a9-cccb-32e8-b140-b501388566fc",
                        "source_sense_id": "46ddda0b-0869-3b40-b0c3-b7dc8cca4584",
                        "source_sense_description": "tegenstander in de strijd",
                        "target_lang_word": "Feind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48ec8ae4-2031-3678-9c11-2ac191b1ab38",
                                        "entry_id": "a07b0e31-40ae-3a27-a035-59a809634dd1",
                                        "glosses": [
                                            "Person oder Gruppe mit besonders negativer Beziehung zu einer anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "accb7548-bb3d-40d9-bb82-f8eb12214789",
                                                "sense_id": "48ec8ae4-2031-3678-9c11-2ac191b1ab38",
                                                "text": "Er ist mein schlimmster Feind."
                                            },
                                            {
                                                "example_id": "561a81cc-847b-4deb-9c3f-03d4396ca011",
                                                "sense_id": "48ec8ae4-2031-3678-9c11-2ac191b1ab38",
                                                "text": "Der Feind greift an!"
                                            },
                                            {
                                                "example_id": "aac8f2ac-96bf-4057-abfe-112f6b0d75c3",
                                                "sense_id": "48ec8ae4-2031-3678-9c11-2ac191b1ab38",
                                                "text": "„Die Waräger machen zahlreiche Feinde nieder, schlagen die übrigen in die Flucht und nehmen einen Kommandeur gefangen.“"
                                            },
                                            {
                                                "example_id": "72eec332-12fa-447f-b0af-9b0da7027d9a",
                                                "sense_id": "48ec8ae4-2031-3678-9c11-2ac191b1ab38",
                                                "text": "„Alle Schiffe des Feindes hatten kriegstaugliche Schanzkleider und waren robust gebaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c370c7d-6cc0-476b-947a-3d6d694cbdbd",
                        "source_entry_id": "d98440a9-cccb-32e8-b140-b501388566fc",
                        "source_sense_id": "46ddda0b-0869-3b40-b0c3-b7dc8cca4584",
                        "source_sense_description": "tegenstander in de strijd",
                        "target_lang_word": "Gegner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                        "entry_id": "52366874-c34c-3fda-a884-d52c30d728ca",
                                        "glosses": [
                                            "Person oder Institution/Organisation, die gegenteilige Interessen verfolgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb35f0aa-e4e5-4431-9918-8ca4c93090e6",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "Der Gegner von Hannover 96 war diesmal der 1. FC Köln."
                                            },
                                            {
                                                "example_id": "098461f2-d727-4a52-88a3-0c743e197ce9",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "„Entgegen den Beteuerungen der romfreundlichen Autoren, die den 2. Römisch-Karthagischen Krieg als ein Ringen zwischen zwei gleich starken Gegnern darstellen, war die Disproportion zwischen den Beteiligten groß.“"
                                            },
                                            {
                                                "example_id": "3ce54634-dab5-4456-a339-9d263b8523ac",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "„Es ist für viele wahlentscheidend, auf welchen Gegner sich die präferierte Partei einlassen würde.“"
                                            },
                                            {
                                                "example_id": "2d92df93-efc7-46ed-8492-73c6f414ade7",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "„Seine Idee hatte viele Gegner, vor allem unter den Kongressabgeordneten aus dem landwirtschaftlich geprägten Süden.“"
                                            },
                                            {
                                                "example_id": "5f5ba438-bbd4-45f2-a6bd-3b65e08cf604",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "„Wenn der Analytiker sich seiner gewöhnlichen Hilfsquellen beraubt sieht, denkt er sich in den Geist seines Gegners hinein, identifiziert sich mit ihm, und dann gelingt es ihm nicht selten, auf den ersten Blick eine oft verblüffend einfache Methode zu finden, durch die er den andern irreführen oder zu einem unbesonnenen Zug veranlassen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcc42111-5a44-4faa-ba5f-ed9a2f33b45b",
                        "source_entry_id": "d98440a9-cccb-32e8-b140-b501388566fc",
                        "source_sense_id": "46ddda0b-0869-3b40-b0c3-b7dc8cca4584",
                        "source_sense_description": "tegenstander in de strijd",
                        "target_lang_word": "Widersacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Widersacher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5dada62b-c933-345f-832e-99e8a94ca336",
                                        "entry_id": "3ace7206-685d-3c91-83c2-57b980726b39",
                                        "glosses": [
                                            "Person, die engagiert gegen die Interessen einer anderen Person arbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4613b1bf-2f27-4019-9c98-bc81a4fb65d3",
                                                "sense_id": "5dada62b-c933-345f-832e-99e8a94ca336",
                                                "text": "„Sie kämpften 424 mit in Nordafrika für den römischen Usurpator Johannes gegen dessen Widersacher, den Feldherrn Bonifatius; …“"
                                            },
                                            {
                                                "example_id": "a63953bc-020a-4392-8080-66adc4a209cd",
                                                "sense_id": "5dada62b-c933-345f-832e-99e8a94ca336",
                                                "text": "„Für das Treffen haben sich die beiden Widersacher jeweils die Gefolgschaft angesehener Bauern gesichert.“"
                                            },
                                            {
                                                "example_id": "ae9b0fab-ede4-40b3-aefe-d45849aea786",
                                                "sense_id": "5dada62b-c933-345f-832e-99e8a94ca336",
                                                "text": "„Selbst die Kanzlerin hatte ja lange Zeit Gabriel als ihren potentiellen Widersacher im Wahlkampf gesehen.“"
                                            },
                                            {
                                                "example_id": "c342b4b2-70d2-4a26-a1f5-a4d9abc66605",
                                                "sense_id": "5dada62b-c933-345f-832e-99e8a94ca336",
                                                "text": "„Gerade auch diese »Volksaufklärung« wurde ihm als revolutionärer Akt von seinen Widersachern sehr übelgenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "859bf59a-9532-4504-8c78-444e14aa3f3b",
                        "source_entry_id": "d98440a9-cccb-32e8-b140-b501388566fc",
                        "source_sense_id": "46ddda0b-0869-3b40-b0c3-b7dc8cca4584",
                        "source_sense_description": "tegenstander in de strijd",
                        "target_lang_word": "Gegenspieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegenspieler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba9bb9af-cf4b-3902-b693-1273ce952526",
                                        "entry_id": "651a63f0-2935-3358-a68e-edff2295c74e",
                                        "glosses": [
                                            "Person, gegen die man in einem Spiel antritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfa4d958-d6aa-4fd4-b1b2-69294dacbace",
                                                "sense_id": "ba9bb9af-cf4b-3902-b693-1273ce952526",
                                                "text": "Die Gegenspieler haben uns keinen Punkt geschenkt."
                                            },
                                            {
                                                "example_id": "8b42a160-eab8-4ff2-ad20-77cb901779de",
                                                "sense_id": "ba9bb9af-cf4b-3902-b693-1273ce952526",
                                                "text": "„Für den ehrlichen Spieler, den es nach Ansicht des Vetalapantschavinsati eigentlich nicht gibt, ist der Zufall ein haßgeliebter Gegenspieler. Schlimmer für ihn ist der betrügerische Gegenspieler.“"
                                            },
                                            {
                                                "example_id": "22c8f04f-040a-40dd-aa8c-b54f1d6080bb",
                                                "sense_id": "ba9bb9af-cf4b-3902-b693-1273ce952526",
                                                "text": "„Die Fälle, in denen dem Hauptspieler mehrere Gegenspieler gegenüberstehen, die sich ihrerseits wieder von der restlichen Spielgruppe absetzen, sind selten.“"
                                            },
                                            {
                                                "example_id": "c5408ce9-b9f2-46fc-b4d4-2fd437434636",
                                                "sense_id": "ba9bb9af-cf4b-3902-b693-1273ce952526",
                                                "text": "„Das Spiel kann auch zum Wettkampf werden, wenn der Ball so heftig oder trickreich geschlagen wird, dass die Gegenspieler eine Bodenberührung nicht zu verhindern vermögen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9699862a-8a4a-3c6c-95bd-d370d922a199",
                                        "entry_id": "651a63f0-2935-3358-a68e-edff2295c74e",
                                        "glosses": [
                                            "jemand oder etwas, das dem Tun und Wirken eines anderen entgegenwirkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d036b4ed-6dc3-465a-a585-49cd3ba6f4eb",
                                                "sense_id": "9699862a-8a4a-3c6c-95bd-d370d922a199",
                                                "text": "Der Gegenspieler des Bizeps ist der Trizeps."
                                            },
                                            {
                                                "example_id": "dc700380-a595-4c54-a3ed-36b6a9f2f33a",
                                                "sense_id": "9699862a-8a4a-3c6c-95bd-d370d922a199",
                                                "text": "„Sein einstiger Verbündeter Tschombé wird zum Gegenspieler auf Leben und Tod.“"
                                            },
                                            {
                                                "example_id": "bd44834e-a658-48d5-9767-d636811ad0eb",
                                                "sense_id": "9699862a-8a4a-3c6c-95bd-d370d922a199",
                                                "text": "„Papst Franziskus ist weder liberal noch konservativ und braucht keinen Gegenspieler, weder einen konservativen noch einen progressiven.“"
                                            },
                                            {
                                                "example_id": "96a6726e-47b2-46eb-9f7a-0258f37c14b1",
                                                "sense_id": "9699862a-8a4a-3c6c-95bd-d370d922a199",
                                                "text": "„Auch von der EU-Kommission, im institutionellen Kräfteverhältnis der natürliche Gegenspieler zum Europäischen Rat, gab es scharfe Kritik an Tusk: EU-Innenkommissar Dimitris Avramopoulos, zuständig für die Flüchtlingspolitik, nannte Tusk Einschätzung inakzeptabel und antieuropäisch.“"
                                            },
                                            {
                                                "example_id": "975688c2-3a1d-4bf0-a82b-b516cd8fc034",
                                                "sense_id": "9699862a-8a4a-3c6c-95bd-d370d922a199",
                                                "text": "„Dass Cranach gleichzeitig für Luthers mächtigen Gegenspieler arbeitete, den Kardinal Albrecht von Brandenburg, einen scharfen Verteidiger des Ablasshandels, belebte die Konkurrenz.“"
                                            },
                                            {
                                                "example_id": "438d8875-fbe1-4e13-ab9b-da9afd5ebab1",
                                                "sense_id": "9699862a-8a4a-3c6c-95bd-d370d922a199",
                                                "text": "„Dagegen hatte im Prinzip auch sein Gegenspieler Bal Gangadhar Tilak nichts einzuwenden, der aber strikt dagegen war, dass die Sozialreform durch Gesetze der britisch-indischen Legislative gefördert wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0311db05-76f9-31f5-b8b4-31bf5ff43185",
                                        "entry_id": "651a63f0-2935-3358-a68e-edff2295c74e",
                                        "glosses": [
                                            "Widersacher der Hauptfigur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b20723b-0d4b-4842-ae8c-552190bc0f62",
                                                "sense_id": "0311db05-76f9-31f5-b8b4-31bf5ff43185",
                                                "text": "Einer von Harry Potters bösen Gegenspielern ist Lord Voldemort."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
