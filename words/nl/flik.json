                        {
                            "text": "Waarom <w>flik</w> je dat toch steeds?",
                            "target_lang_translations": {
                                "ru": "Почему ты постоянно это <w>вытворяешь</w>?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "второе лицо единственного числа настоящего времени глагола 'flikken'"
                    },
                    "translations": {
                        "ru": [
