                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed665399-f556-4454-8784-6ac62892f6d2",
                                                "sense_id": "873f52b6-bd5b-33af-8145-9b798bf2c5a8",
                                                "text": "De onneembare vesting kon niet veroverd worden."
                                            },
                                            {
                                                "example_id": "fe770a2a-d68d-4af5-a18b-6eeca05c0d88",
                                                "sense_id": "873f52b6-bd5b-33af-8145-9b798bf2c5a8",
                                                "text": "De onneembare berg kon door Tenzing Norgay en Edmund Hillary toch bedwongen worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc5dbbea-5778-4ee5-89b2-2638327c919b",
