                            {
                                "example_id": "d9184e97-98b3-4cb3-9982-1cf42f973384",
                                "sense_id": "12382f2f-cbc0-3119-bdf6-4eec1f6ed568",
                                "text": "Comme beaucoup de gens incompris, n'avait-il pas souvent voulu se plonger avec orgueil dans le néant pour y perdre les secrets de sa vie!"
                            }
                        ]
                    },
                    {
                        "sense_id": "477f1914-16c3-3a25-9fe1-c279908b4621",
                        "entry_id": "a09180df-65f4-3f00-9a89-6a2171a3c431",
                        "glosses": [
                            "Qualifie les personnes qui se plaignent que leurs qualités, leurs talents ne soient pas appréciés."
