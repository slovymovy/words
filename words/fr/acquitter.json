{
    "word_family": [
        "quitte",
        "acquit",
        "acquittement",
        "acquittable",
        "inacquittable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a09e05fb-9f5c-3271-97cd-3fdf662e6fd4",
                    "sense_definition": "Payer intégralement ce que l'on doit, comme une somme d'argent, une taxe ou une facture.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous devez <w>acquitter</w> cette facture avant la fin du mois."
                        },
                        {
                            "text": "Le voyageur a dû <w>acquitter</w> une taxe supplémentaire à la douane."
                        }
                    ],
                    "synonyms": [
                        "payer",
                        "régler"
                    ],
                    "common_phrases": [
                        "acquitter une facture",
                        "acquitter une dette",
                        "acquitter une taxe"
                    ]
                },
                {
                    "sense_id": "92996c4f-ec39-3dd2-8d60-2de841020cca",
                    "sense_definition": "Déclarer un accusé non coupable et le libérer des poursuites judiciaires.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a décidé d'<w>acquitter</w> le suspect faute de preuves suffisantes."
                        },
                        {
                            "text": "Après plusieurs heures de délibération, les jurés ont choisi d'<w>acquitter</w> l'accusé."
                        }
                    ],
                    "synonyms": [
                        "blanchir",
                        "disculper",
                        "absoudre"
                    ],
                    "antonyms": [
                        "condamner"
                    ],
                    "common_phrases": [
                        "acquitter un accusé"
                    ]
                },
                {
                    "sense_id": "257d0589-bbb8-3f3e-affb-390b5b6873b5",
                    "sense_definition": "Accomplir pleinement un devoir, une tâche ou une obligation morale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "devoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est <w>acquitté</w> de sa tâche avec beaucoup de sérieux et de rigueur."
                        },
                        {
                            "text": "Elle cherche toujours à s'<w>acquitter</w> de ses devoirs le plus rapidement possible."
                        }
                    ],
                    "synonyms": [
                        "accomplir",
                        "remplir",
                        "honorer"
                    ],
                    "common_phrases": [
                        "s'acquitter d'une tâche",
                        "s'acquitter de son devoir"
                    ]
                },
                {
                    "sense_id": "21888f0b-0f44-3193-a2f4-903bf4bde80a",
                    "sense_definition": "Confirmer la réception et la prise en compte d'un message, d'un signal ou d'une alerte.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le serveur doit <w>acquitter</w> chaque message reçu pour assurer la transmission."
                        },
                        {
                            "text": "L'opérateur a immédiatement <w>acquitté</w> l'alarme sonore dans la salle de contrôle."
                        }
                    ],
                    "common_phrases": [
                        "acquitter une alarme",
                        "acquitter un message"
                    ]
                }
            ]
        }
    ]
}