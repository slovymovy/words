                        "entry_id": "6975d0a8-fde7-32d7-ad86-1cd337384e6b",
                        "glosses": [
                            "Personne qui s’oppose à l’emploi de l’énergie nucléaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "493cc233-b21f-4d64-99b2-ace8bce51962",
                                "sense_id": "38eedc20-0051-3314-b475-a8f864009767",
                                "text": "Le renchérissement du pétrole complique la lutte des antinucléaires pour des énergies écologiques."
                            },
                            {
                                "example_id": "b149eb67-0d7e-4ac3-bbf8-3d7b49fafa0d",
                                "sense_id": "38eedc20-0051-3314-b475-a8f864009767",
                                "text": "De quoi creuser tranquillement la plus grande poubelle nucléaire française et y enfouir les 100 000 prochaines années les déchets les plus radioactifs du pays. Mais voilà que des antinucléaires se mettent à repeupler l’endroit."
                            }
                        ]
                    }
