                ],
                "translations": [
                    {
                        "translation_id": "280c2f54-7837-4e79-a2a6-51256ca34ec8",
                        "source_entry_id": "153bb496-c406-369b-9400-8cb296a78b5e",
                        "source_sense_id": "35f060f0-8c8a-3c4c-ab1e-e9394fb877b4",
                        "source_sense_description": "een behuizing voor video- en audiobanden",
                        "target_lang_word": "Kassette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kassette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11bf2103-b727-3ff1-a260-cd06c951f442",
                                        "entry_id": "3dde418e-2587-3e96-8a7e-c5abb0e527b7",
                                        "glosses": [
                                            "ein verschließbares Kästchen zur Aufbewahrung von Geld oder Wertsachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ecfd83e-617d-4c1f-8d08-34c01af0ad48",
                                                "sense_id": "11bf2103-b727-3ff1-a260-cd06c951f442",
                                                "text": "Ich bekam zum 6. Geburtstag eine grüne Kassette mit Schlüssel, um dort meinen Schmuck zu verwahren."
                                            },
                                            {
                                                "example_id": "acdadd68-e7bb-418b-ab81-93412a05815a",
                                                "sense_id": "11bf2103-b727-3ff1-a260-cd06c951f442",
                                                "text": "„Sie erwiderte, das interessiere sie nicht; doch nachdem sie mir die Kassette gebracht hatte, machte sie keine Anstalten fortzugehen.“"
                                            },
                                            {
                                                "example_id": "5f43f202-1952-4661-a5fc-8ddf847909d3",
                                                "sense_id": "11bf2103-b727-3ff1-a260-cd06c951f442",
                                                "text": "„Sein Gesicht verfinsterte sich, als ich ihm die leere Kassette zeigte.“"
                                            },
                                            {
                                                "example_id": "fa31a00a-49b9-43a9-aef5-e88dda3f1625",
                                                "sense_id": "11bf2103-b727-3ff1-a260-cd06c951f442",
                                                "text": "Unsere Kassette für die Pistole ist im Schlafzimmer und mit Zahlenschloss gesichert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d8deca00-1172-3f22-9350-9129cfad0979",
                                        "entry_id": "3dde418e-2587-3e96-8a7e-c5abb0e527b7",
                                        "glosses": [
                                            "eine feste Schutzhülle für Bücher, Schallplatten, CDs usw."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cf22ad5-fb00-4058-b361-e30b123c8daa",
                                                "sense_id": "d8deca00-1172-3f22-9350-9129cfad0979",
                                                "text": "Maja hatte die Kassetten der Musikvideos mit Bildern der Künstler dekoriert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4807cd79-ada4-3188-a86d-fbf4fe4c785c",
                                        "entry_id": "3dde418e-2587-3e96-8a7e-c5abb0e527b7",
                                        "glosses": [
                                            "ein lichtdichter Behälter in einem Fotoapparat oder in einer Fotokamera, in den der Film oder die Fotoplatte eingelegt wird"
                                        ],
                                        "tags": [
                                            "Fotografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a899a6f-78b4-4aeb-8e81-5f39f693e340",
                                                "sense_id": "4807cd79-ada4-3188-a86d-fbf4fe4c785c",
                                                "text": "Die Kassette muss absolut lichtdicht sein, sonst ist das Material darin sofort unbrauchbar."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2a2e6141-5399-35a3-b885-d9ffbd46a92e",
                                        "entry_id": "3dde418e-2587-3e96-8a7e-c5abb0e527b7",
                                        "glosses": [
                                            "ein vertieftes Feld in einer Decke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df41badf-ad26-4710-9d6a-b0c0ded6d16d",
                                                "sense_id": "2a2e6141-5399-35a3-b885-d9ffbd46a92e",
                                                "text": "An der Decke befinden sich wunderschöne Kassetten mit Intarsienarbeiten in der Mitte."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0e926243-a1c5-3e29-8cde-1fa5597f0089",
                                        "entry_id": "3dde418e-2587-3e96-8a7e-c5abb0e527b7",
                                        "glosses": [
                                            "ein Magnetband, das auf zwei kleinen Spulen gerollt und in ein rechteckiges Gehäuse eingebaut ist"
                                        ],
                                        "tags": [
                                            "Unterhaltungselektronik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8e75515-ced4-44ee-bfce-9151b3b74b71",
                                                "sense_id": "0e926243-a1c5-3e29-8cde-1fa5597f0089",
                                                "text": "„Ich habe mir eine Kassette auf häuslicher Mattscheibe angeschaut; in Kinos läuft der Schwarzweißfilm schon lange nicht mehr.“"
                                            },
                                            {
                                                "example_id": "a8680313-4c5f-464a-bf34-34cfab8d7dad",
                                                "sense_id": "0e926243-a1c5-3e29-8cde-1fa5597f0089",
                                                "text": "„Und war die Kassette voll, packten wir sie ein und schickten sie in unser Dorf.“"
                                            },
                                            {
                                                "example_id": "121ae0d7-2671-4fd1-874a-fea5e779056e",
                                                "sense_id": "0e926243-a1c5-3e29-8cde-1fa5597f0089",
                                                "text": "„Eine Zeit lang hatte sie mehrmals am Tag die Kassette eingelegt, es gehört, zurückgespult, es noch einmal gehört, wieder zurückgespult.“"
                                            },
                                            {
                                                "example_id": "22452124-981c-4fae-9e58-841536205a87",
                                                "sense_id": "0e926243-a1c5-3e29-8cde-1fa5597f0089",
                                                "text": "„Ich lege die Kassette ein und dimme das Licht.“"
                                            },
                                            {
                                                "example_id": "dff06e56-3256-44da-b03d-fa390b34d93f",
                                                "sense_id": "0e926243-a1c5-3e29-8cde-1fa5597f0089",
                                                "text": "„Tonbänder und Kassetten gab es damals noch nicht; aber das wäre heute eine Möglichkeit und wird auch ab und zu angewandt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "3d66a61d-8b73-38c5-b6da-a46d1595fdab",
                                        "entry_id": "3dde418e-2587-3e96-8a7e-c5abb0e527b7",
                                        "glosses": [
                                            "sowohl (veraltend) für mechanische Spieluhren und auch (gegenwärtig, 2014) für elektronische Spielkonsolen"
                                        ],
                                        "tags": [
                                            "Unterhaltungstechnik"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "e4508b7a-f214-3223-aecb-559bc8855d7a",
                                        "entry_id": "3dde418e-2587-3e96-8a7e-c5abb0e527b7",
                                        "glosses": [
                                            "ein kleines Waffenlager (selten tragbar meist aber beweglich), für Geschütztürme auf Schiffen oder Kampfpanzern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e77e339-ba5c-4425-8817-7dfa7af486f4",
                                                "sense_id": "e4508b7a-f214-3223-aecb-559bc8855d7a",
                                                "text": "Nur der Oberkommandierende an Bord hat die Schlüssel zu der Kassette, sollte er das Schiff verlassen, muß er sie persönlich dem rangältesten Offizier übergeben."
                                            },
                                            {
                                                "example_id": "2b5937c4-4f7f-4917-88fe-6e365fd195cf",
                                                "sense_id": "e4508b7a-f214-3223-aecb-559bc8855d7a",
                                                "text": "Unsere Kassette für die Pistole ist im Schlafzimmer und mit Zahlenschloss gesichert."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
