                        "sense_id": "88d6713e-f5e6-3b7b-9e09-b0ce3d8f8641",
                        "entry_id": "4a446375-07b8-3734-b8b4-0027f44b99c1",
                        "glosses": [
                            "Espèce de champignons à chapeau à lames, au pied cylindrique sans anneau ni cortine et à spores roses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3afad017-42a2-430b-96a9-bc81d5c5a053",
                                "sense_id": "88d6713e-f5e6-3b7b-9e09-b0ce3d8f8641",
                                "text": "Les entolomes sont comestibles ou toxiques."
                            },
                            {
                                "example_id": "2dc19e1c-1514-44a8-ae38-83d0af70b866",
                                "sense_id": "88d6713e-f5e6-3b7b-9e09-b0ce3d8f8641",
                                "text": "L’entolome livide provoque de nombreuses intoxications."
                            },
                            {
                                "example_id": "5bbc5e1f-5644-4d0d-b978-35ded1d5b67a",
                                "sense_id": "88d6713e-f5e6-3b7b-9e09-b0ce3d8f8641",
                                "text": "Cette teinte est précisément un des caractères qui permettent de distinguer cet entolome des autres entolomes et des clitopiles, dont la teinte des lames est franchement saumonnée."
                            }
                        ]
                    }
