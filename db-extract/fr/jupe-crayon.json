                "senses": [
                    {
                        "sense_id": "f3d4246b-8873-3966-85f2-de70f70742e3",
                        "entry_id": "6793e973-5a04-3c4b-be09-a6f74fb3a1fa",
                        "glosses": [
                            "Jupe au genou et étroite, galbant le corps, le plus souvent légèrement fendue à l'arrière pour ne pas contraindre le mouvement de marche."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9728c50-14c2-41c4-b177-fca558b1d345",
                        "source_entry_id": "6793e973-5a04-3c4b-be09-a6f74fb3a1fa",
                        "source_sense_id": "f3d4246b-8873-3966-85f2-de70f70742e3",
                        "target_lang_word": "pencil skirt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pencil skirt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1bc936b-282d-3835-b6db-df1de96ac3c2",
                                        "entry_id": "3704214f-0ae5-3dc0-b5a6-611b0787c2b5",
                                        "glosses": [
                                            "A slim skirt (clothing) with a straight and narrow cut, usually approximately knee-length."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c672d08c-fdc8-46b4-8a6a-4371eece4c1a",
                                                "sense_id": "f1bc936b-282d-3835-b6db-df1de96ac3c2",
                                                "text": "Anna decided to wear a black pencil skirt with her blue blouse that day to work."
                                            },
                                            {
                                                "example_id": "86373ed8-dd93-48b2-b7e1-95b765748c53",
                                                "sense_id": "f1bc936b-282d-3835-b6db-df1de96ac3c2",
                                                "text": "And for Italian sportswear giant MaxMara, the cornerstone of the show was a crisp khaki safari jacket shown over a pencil skirt."
                                            },
                                            {
                                                "example_id": "53ff2eae-d4c3-40d5-93a5-62e224af73be",
                                                "sense_id": "f1bc936b-282d-3835-b6db-df1de96ac3c2",
                                                "text": "For a long while I said any girl could get through round one of MasterChef simply by turning up in a pencil skirt and making a fried Nutella sandwich with condensed milk and an expression that says, \"I like older men with no hair\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "405879af-a9e1-49f9-8fea-a7f190a525f5",
                        "source_entry_id": "6793e973-5a04-3c4b-be09-a6f74fb3a1fa",
                        "source_sense_id": "f3d4246b-8873-3966-85f2-de70f70742e3",
                        "target_lang_word": "юбка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "юбка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e9fd7ec3-6fd9-30d4-9602-07d499335adf",
                                        "entry_id": "b473de93-f9e1-3f36-9954-04436f3a7922",
                                        "glosses": [
                                            "женская одежда, облегающая фигуру от талии книзу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aa6da24-54f9-476b-952b-cfa996397c6b",
                                                "sense_id": "e9fd7ec3-6fd9-30d4-9602-07d499335adf",
                                                "text": "Девушка, скажите пожалуйста, — а вы доглаживаете свои юбки?"
                                            },
                                            {
                                                "example_id": "0d3fa5df-7f06-4a90-a767-d35e87b944d0",
                                                "sense_id": "e9fd7ec3-6fd9-30d4-9602-07d499335adf",
                                                "text": ".. [Барыни] косились на жён и дочерей голландских шкиперов, которые в канифасных юбках и в красных кофточках вязали свой чулок, между собою смеясь и разговаривая как будто дома."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5a39c07-4f05-3691-8fa8-fa1fce31dc67",
                                        "entry_id": "b473de93-f9e1-3f36-9954-04436f3a7922",
                                        "glosses": [
                                            "часть женского платья от талии книзу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df7dce33-e73a-47f8-96ec-c2a8b37f902d",
                                                "sense_id": "e5a39c07-4f05-3691-8fa8-fa1fce31dc67",
                                                "text": "Она была в роскошном открытом платье с пышными юбками."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5568192b-25cf-39af-abbf-fc87d1c6693d",
                                        "entry_id": "b473de93-f9e1-3f36-9954-04436f3a7922",
                                        "glosses": [
                                            "разг., пренебр. о женщине как предмете чувственного влечения, ухаживания мужчин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "721001bf-1eef-4d3f-b8ae-4ff3cd3cbe5d",
                                                "sense_id": "5568192b-25cf-39af-abbf-fc87d1c6693d",
                                                "text": "Слушаю я его, а сама думаю: везёт же некоторым, а мой, без надзора, за любой юбкой волочится."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9791270-e9ed-3d67-8510-868c637608a0",
                                        "entry_id": "b473de93-f9e1-3f36-9954-04436f3a7922",
                                        "glosses": [
                                            "боковые стенки какого-либо цилиндрического изделия или их нижняя часть"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa090c2f-b723-3cd3-9a74-6c017bfec7e5",
                                        "entry_id": "b473de93-f9e1-3f36-9954-04436f3a7922",
                                        "glosses": [
                                            "спец. в судах на воздушной подушке — тонкостенный пустотелый купол, затрудняющий истечение воздуха из-под днища"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cd69094-9d71-44d2-b2aa-19f20f41023e",
                                                "sense_id": "fa090c2f-b723-3cd3-9a74-6c017bfec7e5",
                                                "text": "В соплощелевой схеме подушка создаётся потоком воздуха из кольцевого сопла, образованного юбкой и центральной частью с плоским днищем."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95c46aee-4cc9-3c99-b328-f42a197e222f",
                                        "entry_id": "b473de93-f9e1-3f36-9954-04436f3a7922",
                                        "glosses": [
                                            "спорт. часть снаряжения каякера в виде непромокаемой ткани, которая натягивается на его пояс и крепится наружным эллипсисом за посадочное место"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11cf0633-5539-4407-9d0c-d15e06b0493c",
                                                "sense_id": "95c46aee-4cc9-3c99-b328-f42a197e222f",
                                                "text": "Внутреннее покрытие края юбки слоем латекса гарантирует герметичность юбки на кокпите каяка."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
