                                "sense_id": "ae7291a1-a902-3664-becb-cb9cdc6b18a0",
                                "text": "Lessing a déjà fait cauchemardiser dans les chaumières."
                            },
                            {
                                "example_id": "fa32749f-77a3-4d62-997e-3f14fd942938",
                                "sense_id": "ae7291a1-a902-3664-becb-cb9cdc6b18a0",
                                "text": "Bouh, j'ai passé la nuit à cauchemardiser."
                            }
                        ]
                    }
