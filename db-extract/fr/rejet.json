        "fr-extract.jsonl": [
            {
                "entry_id": "9d45c0f2-6fd8-368b-965b-d61f0fb9bf1e",
                "word": "rejet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2833e95e-41ae-4a29-9c76-f0e13f966582",
                        "entry_id": "9d45c0f2-6fd8-368b-965b-d61f0fb9bf1e",
                        "tags": [
                            "plural"
                        ],
                        "form": "rejets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "04e4a6e0-0966-36a7-a60e-8eec631cc563",
                        "entry_id": "9d45c0f2-6fd8-368b-965b-d61f0fb9bf1e",
                        "glosses": [
                            "Action de repousser une chose, de n’en pas vouloir, de ne pas l’admettre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68612f2a-1fa4-4c0c-ae8a-c92e11f24a7a",
                                "sense_id": "04e4a6e0-0966-36a7-a60e-8eec631cc563",
                                "text": "On a ordonné le rejet de cette pièce comme inutile, falsifiée, supposée. — Le rejet d’un pourvoi, d’une demande."
                            },
                            {
                                "example_id": "ec1938d9-aa5d-4ae4-acef-8227d415e1a3",
                                "sense_id": "04e4a6e0-0966-36a7-a60e-8eec631cc563",
                                "text": "Il a voté pour le rejet de la loi proposée. — Il s’est prononcé pour le rejet de la proposition."
                            },
                            {
                                "example_id": "f7047c0b-3ffe-4cd5-89c5-a89f087cafa3",
                                "sense_id": "04e4a6e0-0966-36a7-a60e-8eec631cc563",
                                "text": "Une doctrine claire c’est d’abord le rejet de ce qui créé la confusion, parce que « le plus difficile c’est de voir ce que l’on voit ». C’est le rejet des « bonnes planques », ces lieux de pensée dont les résidents triés sur le volet accèderaient à un niveau logique supérieur, dont l’attirance est irrésistible : la nuance, la complexité, le doute, l’ambivalence des sentiments, la réduction au cas (concernant les victimes), l’irréductibilité à l’acte (concernant les agresseurs), la possibilité de changer, les principes."
                            }
                        ]
                    },
                    {
                        "sense_id": "58a01a53-e9a7-316a-aa73-8f27e02c707f",
                        "entry_id": "9d45c0f2-6fd8-368b-965b-d61f0fb9bf1e",
                        "glosses": [
                            "Renvoi d’une partie d’un compte, qui doit être portée sur un autre chapitre du même compte ou sur un autre compte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96fb1031-d7e0-4215-8053-13bf98b8966c",
                                "sense_id": "58a01a53-e9a7-316a-aa73-8f27e02c707f",
                                "text": "Cet article de dépense ayant paru déplacé, on en a ordonné le rejet sur un autre chapitre de compte."
                            }
                        ]
                    },
                    {
                        "sense_id": "8def6f53-aa53-32f5-992d-236771dc1b30",
                        "entry_id": "9d45c0f2-6fd8-368b-965b-d61f0fb9bf1e",
                        "glosses": [
                            "Nouveau bois, de la nouvelle pousse d’une plante, d’un arbre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d24996d-c3fe-4a0c-a36f-7a1590f60787",
                                "sense_id": "8def6f53-aa53-32f5-992d-236771dc1b30",
                                "text": "Voilà le rejet de cette année."
                            },
                            {
                                "example_id": "94b1d206-f127-413f-99aa-2f2a150dbe80",
                                "sense_id": "8def6f53-aa53-32f5-992d-236771dc1b30",
                                "text": "Ce n’est encore là que le rejet d’une année."
                            }
                        ]
                    },
                    {
                        "sense_id": "12a71ef4-2ba6-3d78-81b1-601e32550d89",
                        "entry_id": "9d45c0f2-6fd8-368b-965b-d61f0fb9bf1e",
                        "glosses": [
                            "Rejeton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0555850-38bd-42c5-b3e8-9de28c7ad16f",
                                "sense_id": "12a71ef4-2ba6-3d78-81b1-601e32550d89",
                                "text": "Quel que soit l’instrument employé, la section doit toujours être faite rez sol, afin que les rejets qui se développent soient bien assis sur la souche, et puissent émettre des racines qui concourreront dans une large mesure à leur nutrition."
                            },
                            {
                                "example_id": "cee2c00f-3b7c-4965-8e9f-53735749fe25",
                                "sense_id": "12a71ef4-2ba6-3d78-81b1-601e32550d89",
                                "text": "Le milieu si calme, cette petite maison endormie à l’ombre de la cathédrale favorisait l’amélioration lente de ce rejet sauvage, arraché on ne savait d’où, replanté dans le sol mystique de l’étroit jardin."
                            }
                        ]
                    },
                    {
                        "sense_id": "08119e51-102e-38bf-b801-6bacd2596240",
                        "entry_id": "9d45c0f2-6fd8-368b-965b-d61f0fb9bf1e",
                        "glosses": [
                            "Ce qui est renvoyé hors de lui par un organisme ou tout système de transformation d'énergie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6389a174-32d7-4d95-a5b9-a095b41e0cf1",
                                "sense_id": "08119e51-102e-38bf-b801-6bacd2596240",
                                "text": "Le rejet du gaz carbonique dans l'atmosphère."
                            }
                        ]
                    },
                    {
                        "sense_id": "0db359b3-bcc3-39d0-a3cb-a404bfd7ac54",
                        "entry_id": "9d45c0f2-6fd8-368b-965b-d61f0fb9bf1e",
                        "glosses": [
                            "Évacuation de détritus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "474124cc-8f1e-4c6d-8f41-5b06debf7c37",
                                "sense_id": "0db359b3-bcc3-39d0-a3cb-a404bfd7ac54",
                                "text": "La purification de l'eau touche deux domaines très différents selon que l'on veuille la consommer ou qu'il s'agisse d'un rejet d’eaux usées dans l'environnement."
                            },
                            {
                                "example_id": "6794115b-9ca5-4141-b9d5-04fe8b800d9d",
                                "sense_id": "0db359b3-bcc3-39d0-a3cb-a404bfd7ac54",
                                "text": "Depuis le 1ᵉʳ janvier 2002, il n'y a plus, en principe, de rejets de plomb par les pots d'échappement car le super plombé a été remplacé par du super au phosphate. Cette évolution a eu des effets incontestables."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd52ea30-286a-3b7b-b20f-9c45d332d0a5",
                        "entry_id": "9d45c0f2-6fd8-368b-965b-d61f0fb9bf1e",
                        "glosses": [
                            "Procédé métrique qui consiste à rejeter au début du vers suivant, afin de le mettre en relief, un mot ou un groupe de mots qui appartiennent, par la construction syntaxique et le sens, au vers précédent."
                        ],
                        "tags": [
                            "Versification"
                        ],
                        "examples": [
                            {
                                "example_id": "d5403721-6437-4ec6-8a09-53279a06c5fc",
                                "sense_id": "dd52ea30-286a-3b7b-b20f-9c45d332d0a5",
                                "text": "Il est pris. - Oh ! quel nom sur ses lèvres muettes\nTressaille ? Quel regret implacable le mord ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "ce1e1b2f-f2db-3d7f-92d6-d5eb1b18ec57",
                        "entry_id": "9d45c0f2-6fd8-368b-965b-d61f0fb9bf1e",
                        "glosses": [
                            "Phénomène de refus d'un tissu ou d'un organe venu d'un autre organisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31ae67a1-16f3-4112-b954-546216480170",
                                "sense_id": "ce1e1b2f-f2db-3d7f-92d6-d5eb1b18ec57",
                                "text": "Le xénoantigène qui chez le porc serait majoritairement responsable du phénomène de rejet chez l'homme est une molécule de nature osidique, le galactose-1,3-galactose, localisé sur la membrane plasmique des cellules endothéliales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c40fe65c-b7cb-4c71-b641-8ce93ae278b2",
                        "source_entry_id": "9d45c0f2-6fd8-368b-965b-d61f0fb9bf1e",
                        "source_sense_description": "action de rejeter, refus",
                        "target_lang_word": "Ablehnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ablehnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4f3cf8d-0c54-3a7d-85f1-273f39429a1c",
                                        "entry_id": "08f2ca63-f90b-3192-8594-018b6b79f9bf",
                                        "glosses": [
                                            "negative Reaktion auf eine Sache oder eine Person; Zurückweisung oder Abneigung gegen etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c5eec56-a877-4f41-af27-2b3657f6e4c2",
                                                "sense_id": "a4f3cf8d-0c54-3a7d-85f1-273f39429a1c",
                                                "text": "Dieser Lärm, den du Musik nennst, stößt bei mir auf Ablehnung."
                                            },
                                            {
                                                "example_id": "c09a0a08-ecbf-4821-b056-dd85700cfe66",
                                                "sense_id": "a4f3cf8d-0c54-3a7d-85f1-273f39429a1c",
                                                "text": "Gegen ihn habe ich eine Ablehnung."
                                            },
                                            {
                                                "example_id": "27446b23-0d47-4158-a273-9d064927be8b",
                                                "sense_id": "a4f3cf8d-0c54-3a7d-85f1-273f39429a1c",
                                                "text": "„Ihre Ablehnung führt zu unserer Ablehnung.“"
                                            },
                                            {
                                                "example_id": "4ea87aa1-dc72-45ca-b5b4-51b1051badc7",
                                                "sense_id": "a4f3cf8d-0c54-3a7d-85f1-273f39429a1c",
                                                "text": "Er vernahm ihre Ablehnung mit Bitterkeit."
                                            },
                                            {
                                                "example_id": "a40d1f9e-1e7c-4b69-8a54-c349e73f5975",
                                                "sense_id": "a4f3cf8d-0c54-3a7d-85f1-273f39429a1c",
                                                "text": "„Kommt es nicht zu einer Einigung, so teilt der Dienstgeber die Ablehnung des Vorschlages der Mitarbeitervertretung schriftlich mit.“"
                                            },
                                            {
                                                "example_id": "4b42ddd4-c7df-4b5d-bde0-f9095f67949d",
                                                "sense_id": "a4f3cf8d-0c54-3a7d-85f1-273f39429a1c",
                                                "text": "„Die Ablehnung hatte sowohl politische als auch kommerzielle Gründe.“"
                                            },
                                            {
                                                "example_id": "30ee4644-998b-4a5e-b994-00c91645d5df",
                                                "sense_id": "a4f3cf8d-0c54-3a7d-85f1-273f39429a1c",
                                                "text": "„Die Ablehnung der EU-Verfassung bei Volksabstimmungen in Frankreich und den Niederlanden zeigte, dass nur eine Minderheit eine weitere Vertiefung der EU bzw. deren Weiterentwicklung von einem Staatenbund hin zu einem Bundesstaat wünschte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
