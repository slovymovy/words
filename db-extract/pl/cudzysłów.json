                                        "glosses": [
                                            "Par de signos de puntuación usados para delimitar un texto citado textualmente o para dar carácter especial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56f83740-8459-46e1-bc8f-33973c74ff31",
                                                "sense_id": "c00f522c-f845-373b-b54d-c992795ff425",
                                                "text": "«El narrador de la novela introduce, entre comillas francesas, fragmentos textuales del escrito de Loyola»."
