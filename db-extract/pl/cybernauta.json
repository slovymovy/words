                "senses": [
                    {
                        "sense_id": "5574c9e7-c037-3597-892b-07fb2e500097",
                        "entry_id": "13abb772-c0b4-3084-822c-ddd315f8dc67",
                        "glosses": [
                            "futurystyczny podróżnik po cyberprzestrzeni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7497469-01d5-48ca-b2e6-d71388ed7986",
                                "sense_id": "5574c9e7-c037-3597-892b-07fb2e500097",
                                "text": "Cybernauta, przymocowany do urządzeń sensorycznych, opuszcza więzienie ciała i wkracza w świat doznań cyfrowych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "487c3677-d38d-4daf-a870-febac76b059a",
                        "source_entry_id": "13abb772-c0b4-3084-822c-ddd315f8dc67",
                        "source_sense_id": "5574c9e7-c037-3597-892b-07fb2e500097",
                        "target_lang_word": "cybernaut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cybernaut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "945aa199-7af1-3a17-abc4-66c64e51cf86",
                                        "entry_id": "380c3536-3125-3664-b8f5-c6028a8de04f",
                                        "glosses": [
                                            "A voyager in cyberspace; a user of the Internet or virtual reality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b03e791-dac8-4b58-a390-b5478524db07",
                                                "sense_id": "945aa199-7af1-3a17-abc4-66c64e51cf86",
                                                "text": "When a cybernaut shifts his gaze or waves her hand, the reality engine weaves the data stream from the cybernaut's sensors together with updated depictions..."
                                            },
                                            {
                                                "example_id": "0de06693-e641-4f67-b8f6-18fc23e8ac4b",
                                                "sense_id": "945aa199-7af1-3a17-abc4-66c64e51cf86",
                                                "text": "The clarity of page presentation does not depend solely on its design, but also on the configuration of the computer of the cybernaut who navigates it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5310e2fd-ae89-46c9-846d-a0bda5775a8e",
                        "source_entry_id": "13abb772-c0b4-3084-822c-ddd315f8dc67",
                        "source_sense_id": "5574c9e7-c037-3597-892b-07fb2e500097",
                        "target_lang_word": "cybernaute",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cybernaute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d32595d3-bd0d-368e-9411-8fc8cd84b249",
                                        "entry_id": "878fd01a-47f4-3099-9373-c46662a360a7",
                                        "glosses": [
                                            "Internaute qui participe activement à la vie sur internet, par exemple en faisant partie d’une communauté, en y développant des relations, en y faisant de l’activisme politique, ou en y gagnant sa vie, etc."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c643275b-18fd-4494-9212-ab421154d191",
                                                "sense_id": "d32595d3-bd0d-368e-9411-8fc8cd84b249",
                                                "text": "Slim Amamou et El Aziz Amami, cybernautes très actifs contre la censure ont été également arrêtés jeudi, selon le journaliste opposant Sofiene Chourabi."
                                            },
                                            {
                                                "example_id": "72960475-d61d-459c-9602-78b757497a65",
                                                "sense_id": "d32595d3-bd0d-368e-9411-8fc8cd84b249",
                                                "text": "Le Wiktionnaire, créé et maintenu par des cybernautes passionnés par les langues et par le partage de la connaissance, est un outil incontournable pour tous les internautes à la recherche du mot juste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
