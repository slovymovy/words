                        "entry_id": "a8986773-bb02-3d0e-9fbf-3debbe475f44",
                        "glosses": [
                            "Sport qui consiste à faire des ascensions dans les Alpes et, par extension, dans n’importe quelles montagnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10a7a887-d75c-4d0d-9803-d939f96be56a",
                                "sense_id": "02280c90-c81d-34c7-bd2d-bc5456304c0c",
                                "text": "L’alpinisme se développe de plus en plus."
                            },
                            {
                                "example_id": "ba635814-1572-41a8-b000-32bd2fc88111",
                                "sense_id": "02280c90-c81d-34c7-bd2d-bc5456304c0c",
                                "text": "La passion, les émotions de l’alpinisme."
                            },
                            {
                                "example_id": "d8e85722-84e8-4c26-b7c4-84fac491cc91",
                                "sense_id": "02280c90-c81d-34c7-bd2d-bc5456304c0c",
                                "text": "Les surprises, les dangers de l’alpinisme."
                            },
                            {
                                "example_id": "8b1ae4a4-4448-4bff-b93d-82ce68b6fdbb",
                                "sense_id": "02280c90-c81d-34c7-bd2d-bc5456304c0c",
                                "text": "Lʼalpinisme nʼest plus maintenant quʼune question dʼargent et dʼorganisation."
                            }
                        ]
                    }
                ],
