{
    "word_family": [
        "surliness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3b453236-79b9-39d2-a7cb-5493d3cbd7fd",
                    "sense_definition": "Irritated, bad-tempered, and unfriendly in behavior.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bad-tempered",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>surly</w> waiter ignored our requests for water throughout the entire meal.",
                            "target_lang_translations": {
                                "nl": "De <w>knorrige</w> ober negeerde onze verzoeken om water gedurende de hele maaltijd."
                            }
                        },
                        {
                            "text": "He gave a <w>surly</w> response when asked to help with the heavy boxes.",
                            "target_lang_translations": {
                                "nl": "Hij gaf een <w>barse</w> reactie toen hem werd gevraagd te helpen met de zware dozen."
                            }
                        }
                    ],
                    "synonyms": [
                        "grumpy",
                        "cranky",
                        "irritable"
                    ],
                    "antonyms": [
                        "friendly",
                        "cheerful"
                    ],
                    "common_phrases": [
                        "surly look",
                        "surly attitude"
                    ],
                    "target_lang_definitions": {
                        "nl": "Geïrriteerd, slecht gehumeurd en onvriendelijk in gedrag."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "knorrig",
                                "target_lang_sense_clarification": "Chagrijnig en ontevreden in gedrag."
                            },
                            {
                                "target_lang_word": "bars",
                                "target_lang_sense_clarification": "Onvriendelijk en nors in de omgang."
                            },
                            {
                                "target_lang_word": "onbeleefd",
                                "target_lang_sense_clarification": "Slecht gemanierd en onvriendelijk."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30a5b0b9-42a4-30c7-9d71-e101bd8dcb42",
                    "sense_definition": "Threatening, menacing, or gloomy in appearance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bad-tempered",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>surly</w> clouds gathered quickly, signaling a violent storm was approaching.",
                            "target_lang_translations": {
                                "nl": "De <w>bedreigende</w> wolken pakten zich snel samen, wat aangaf dat er een hevige storm op komst was."
                            }
                        },
                        {
                            "text": "A <w>surly</w> silence filled the room after the argument ended.",
                            "target_lang_translations": {
                                "nl": "Een <w>mistroostige</w> stilte vulde de kamer nadat de ruzie was beëindigd."
                            }
                        }
                    ],
                    "synonyms": [
                        "menacing",
                        "gloomy",
                        "threatening"
                    ],
                    "common_phrases": [
                        "surly weather",
                        "surly sky"
                    ],
                    "target_lang_definitions": {
                        "nl": "Bedreigend, onheilspellend of somber van uiterlijk."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bedreigend",
                                "target_lang_sense_clarification": "Angstaanjagend of onheilspellend."
                            },
                            {
                                "target_lang_word": "mistroostig",
                                "target_lang_sense_clarification": "Somber en depressief stemmend."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10189674-7852-3dcc-ae88-ab8b4ddce4d7",
                    "sense_definition": "Displaying an arrogant or supercilious attitude.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager maintained a <w>surly</w> air of superiority while addressing the staff.",
                            "target_lang_translations": {
                                "nl": "De manager behield een <w>arrogante</w> uitstraling van superioriteit terwijl hij het personeel toesprak."
                            }
                        },
                        {
                            "text": "His <w>surly</w> dismissal of their concerns showed how little he valued their input.",
                            "target_lang_translations": {
                                "nl": "Zijn <w>bazige</w> afwijzing van hun zorgen liet zien hoe weinig hij hun inbreng waardeerde."
                            }
                        }
                    ],
                    "synonyms": [
                        "arrogant",
                        "haughty"
                    ],
                    "antonyms": [
                        "humble"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een arrogante of hooghartige houding vertonend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "arrogant",
                                "target_lang_sense_clarification": "Verwaand en te veel met zichzelf ingenomen."
                            },
                            {
                                "target_lang_word": "bazig",
                                "target_lang_sense_clarification": "Autoritair en de baas spelend over anderen."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "071bebb8-f5ed-3275-bed6-670bd536e4eb",
                    "sense_definition": "In an arrogant, supercilious, or unfriendly manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He walked <w>surly</w> past his colleagues without acknowledging their greetings.",
                            "target_lang_translations": {
                                "nl": "Hij liep <w>nors</w> langs zijn collega's zonder hun groeten te beantwoorden."
                            }
                        },
                        {
                            "text": "The guard looked <w>surly</w> at the visitors as they entered the restricted area.",
                            "target_lang_translations": {
                                "nl": "De bewaker keek <w>arrogant</w> naar de bezoekers terwijl ze het verboden gebied betraden."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Op een arrogante, hooghartige of onvriendelijke manier."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "arrogant",
                                "target_lang_sense_clarification": "Op een verwaande wijze."
                            },
                            {
                                "target_lang_word": "nors",
                                "target_lang_sense_clarification": "Op een onvriendelijke, afwijzende manier."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}