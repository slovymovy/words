                        "examples": [
                            {
                                "example_id": "6b5f6d1f-b548-4329-8448-809a78e72ab9",
                                "sense_id": "526b1d36-0d73-3ceb-8b3d-d479d5065777",
                                "text": "Zijn gelaat en Zijn houding vertoonden die verrukkelijke ongeduldigheid van de jeugd, en ik besefte dat ik met mijn gebruikelijke omzichtigheid niets opschoot."
                            },
                            {
                                "example_id": "2524706f-e062-4369-a644-8de5a30b31cc",
                                "sense_id": "526b1d36-0d73-3ceb-8b3d-d479d5065777",
                                "text": "Gelijk in de eerste game kreeg Krajicek al twee breekkansen. Door ongeduldigheid benutte ze die nog niet, maar een servicebeurt later was het wel raak. In de volgende ronde staat ze tegenover Anne Kremer, de nummer 169 van de wereld."
                            }
                        ]
