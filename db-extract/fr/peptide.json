                                "target_senses": [
                                    {
                                        "sense_id": "a228211e-eea2-3e34-8776-7e6b9792968e",
                                        "entry_id": "866ddf37-b850-3d5b-81c3-13d41f52cb85",
                                        "glosses": [
                                            "Any of a class of organic compounds consisting of various numbers of amino acids in which the amine of one is reacted with the carboxylic acid of the next to form an amide bond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a43e2712-1490-4b58-87f2-eb01203e9f41",
                                                "sense_id": "a228211e-eea2-3e34-8776-7e6b9792968e",
                                                "text": "When it’s digested, its long amino-acid chains are first broken down into smaller fragments, or peptides. It turns out that many hormones and drugs are also peptides, and a number of casein peptides do affect the body in hormone-like ways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c3d4e64-1f61-38a9-86de-899a9def52d9",
                                        "entry_id": "866ddf37-b850-3d5b-81c3-13d41f52cb85",
                                        "glosses": [
                                            "The peptide bond itself."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac1e4a6e-4a69-3185-91bf-06f8db34637c",
                                        "entry_id": "866ddf37-b850-3d5b-81c3-13d41f52cb85",
                                        "glosses": [
                                            "performance-enhancing drugs, often a synthetic peptide compound"
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02ce07cd-9798-4750-b54e-05ebc35ec948",
                                                "sense_id": "ac1e4a6e-4a69-3185-91bf-06f8db34637c",
                                                "text": "Please be patient with me, I get hundreds of emails a day in regards to anything fitness related including diet, recipes, eating schedules, work out routines, recommending what peptides to take for what and so on."
                                            },
                                            {
                                                "example_id": "a614d262-e3d6-4f53-859e-7b8e0d70691c",
                                                "sense_id": "ac1e4a6e-4a69-3185-91bf-06f8db34637c",
                                                "text": "It truly doesn’t, funny how so many people in this sub keep buying certain peptides for the placebo."
                                            }
                                        ]
                                    }
                                ]
                            }
