                "word": "goyarde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f235c3d5-7115-4c8c-96f7-18e3b1965071",
                        "entry_id": "b9c3d36c-c049-3849-a2dc-2133aac9d391",
                        "tags": [
                            "plural"
                        ],
