                    {
                        "sense_id": "97ada35a-a3ba-3062-9053-03d326635010",
                        "entry_id": "3b567a1d-7e95-38d6-9f88-ae110fa84e76",
                        "glosses": [
                            "gutartige, meist pigmentierter, dunkler Fleck auf der Haut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40dfbc47-c57b-4397-aad9-3916d2876559",
                                "sense_id": "97ada35a-a3ba-3062-9053-03d326635010",
                                "text": "„Der Pigmentnävus ist braun bis schwarz und kann mehr oder weniger groß sein (Schönheitsfleck).“"
                            },
                            {
                                "example_id": "00792ece-fffc-4e4f-b47b-c7b45ee8944c",
                                "sense_id": "97ada35a-a3ba-3062-9053-03d326635010",
                                "text": "„Im zentralen Pigmentnävus findet man eine starke zellulär-entzündliche Reaktion, vor allem aus Lymphozyten, Histiozyten, manchmal auch Plasmazellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
