                "senses": [
                    {
                        "sense_id": "5a2b5130-1420-3c59-8a46-4c766867e857",
                        "entry_id": "5212f71a-802b-3be7-b5d0-8b54a3be69a2",
                        "glosses": [
                            "stuk rundvlees dat men zeer lang op een laag vuur laat staan om gaar te laten worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "243820cf-f345-43ec-8901-c1f5a5d75c75",
                                "sense_id": "5a2b5130-1420-3c59-8a46-4c766867e857",
                                "text": "Het befaamde Adagietto neemt bijna elf minuten in beslag. Zo verandert Mahlers liefdeslied voor Alma bijna in een sudderlapje. Maar het wordt bloedmooi gespeeld, dat wel."
                            },
                            {
                                "example_id": "30cfe72c-2ca1-4bf8-9c6c-9b389af950b2",
                                "sense_id": "5a2b5130-1420-3c59-8a46-4c766867e857",
                                "text": "Voor vanavond ben ik onder de pannen. Ik eet bij mijn nieuwe vriend. Ik voel me in alle opzichten een gezegend mens. Nooit eerder een man gehad die sudderlapjes voor me ging maken!"
                            },
                            {
                                "example_id": "b7b2784d-76fe-4765-a136-618923ad974a",
                                "sense_id": "5a2b5130-1420-3c59-8a46-4c766867e857",
                                "text": "Hij kookt meestal aardappelen met groente en het onvermijdelijke sudderlapje, maar ook Afghaanse kip."
                            }
                        ]
                    }
                ],
