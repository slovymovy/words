                                                "sense_id": "45647bfd-e31f-3481-a405-93b8a8133161",
                                                "text": "Le lavage d’un livre, d’une estampe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1653064d-de9c-3870-b9e1-1f4643f5648b",
                                        "entry_id": "3293552d-c5dc-36ea-bbbd-e999d2a18c38",
                                        "glosses": [
                                            "Nettoyage d’un organe au moyen d’irrigations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a99c0e3c-4b5f-4a9c-8463-5b6df34c1d03",
                                                "sense_id": "1653064d-de9c-3870-b9e1-1f4643f5648b",
                                                "text": "Lavage de l’estomac, de l’intestin, de la vessie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c0f04e7-4501-312a-a0f0-e110c7afbf4c",
                                        "entry_id": "3293552d-c5dc-36ea-bbbd-e999d2a18c38",
                                        "glosses": [
                                            "Opération qui consiste à laver le minerai pour séparer de la partie terreuse et pierreuse la partie propre à être fondue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e61bc691-1874-4f2a-9fef-160aedd23025",
                                                "sense_id": "6c0f04e7-4501-312a-a0f0-e110c7afbf4c",
                                                "text": "Le lavage des métaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfdc667c-ceb4-32a4-ab40-259948c560a3",
                                        "entry_id": "3293552d-c5dc-36ea-bbbd-e999d2a18c38",
