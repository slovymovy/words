                "senses": [
                    {
                        "sense_id": "aa884d79-6e11-3838-b0a5-12f066177972",
                        "entry_id": "dc3c9cb4-bffe-3349-bb29-a1af0c9fe98c",
                        "glosses": [
                            "eine Art der Gattung Feldgänse (Anser) in der Familie der Entenvögel (Anatidae)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc6ad00e-2e26-4e0c-9eb4-1fbc5a77757c",
                                "sense_id": "aa884d79-6e11-3838-b0a5-12f066177972",
                                "text": "„Die Graugans ist heller als die anderen grauen Gänse.“"
                            },
                            {
                                "example_id": "95a08a1c-bc82-4645-bce9-4b9a000869eb",
                                "sense_id": "aa884d79-6e11-3838-b0a5-12f066177972",
                                "text": "„Graugänse zählen zu den häufigsten Wasservögeln und bilden zugleich die zweitgrößte Gänseart in Europa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18b5dda7-eb8c-402a-82df-2c2c51b404e8",
                        "source_entry_id": "dc3c9cb4-bffe-3349-bb29-a1af0c9fe98c",
                        "source_sense_id": "aa884d79-6e11-3838-b0a5-12f066177972",
                        "source_sense_description": "Zoologie, Ornithologie: eine Art der Gattung Feldgänse (Anser) in der Familie der Entenvögel (Anatidae)",
                        "target_lang_word": "greylag goose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greylag goose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "343022f3-609e-331f-abc5-ebc4cac5a5ec",
                                        "entry_id": "9acb8a20-5e3c-3492-8c0e-a44b4fb135c1",
                                        "glosses": [
                                            "Anser anser, a goose that breads in northern Eurasia and winters in semitropical Asia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2abded39-49f6-4c27-8a2e-3198272f218a",
                        "source_entry_id": "dc3c9cb4-bffe-3349-bb29-a1af0c9fe98c",
                        "source_sense_id": "aa884d79-6e11-3838-b0a5-12f066177972",
                        "source_sense_description": "Zoologie, Ornithologie: eine Art der Gattung Feldgänse (Anser) in der Familie der Entenvögel (Anatidae)",
                        "target_lang_word": "oie cendrée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oie cendrée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0aa2e11-4b59-3784-8fdc-5597f80434ae",
                                        "entry_id": "9307948f-3d38-3675-bd82-74e5c3896829",
                                        "glosses": [
                                            "Espèce d’oiseau palmipède de la famille des anatidés, un des ancêtres des oies domestiques, grande, au plumage gris-beige, aux pattes rose chair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0976588d-3c43-4295-8a9c-5795e628cddc",
                                                "sense_id": "c0aa2e11-4b59-3784-8fdc-5597f80434ae",
                                                "text": "De toute vraisemblance, l’oie de Toulouse, en effet, parait descendre de l’oie cendrée (Amer cinereus), qui apparaît encore aujourd’hui dans le nord de l’Europe, et qui niche dans la Grande-Bretagne, en Russie et en Norvège."
                                            },
                                            {
                                                "example_id": "2bb0bc49-ab42-4843-98db-7898b2a7ea7c",
                                                "sense_id": "c0aa2e11-4b59-3784-8fdc-5597f80434ae",
                                                "text": "Enfin, on se souvient que dans Le merveilleux voyage de Nils Holgersson à travers la Suède, les oies cendrées profitent de la proximité d'un nid d'aigle au moment de la nidification."
                                            },
                                            {
                                                "example_id": "aa720fdc-763e-4c46-b44f-03dfcec8b630",
                                                "sense_id": "c0aa2e11-4b59-3784-8fdc-5597f80434ae",
                                                "text": "En hiver, le canard siffleur, le fuligule milouin et l’oie cendrée viennent y faire halte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
