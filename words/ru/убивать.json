{
    "word_family": [
        "убийство",
        "убийца",
        "убийственный",
        "убой",
        "убойный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a0be2d7-3e91-3436-8ab4-59392b948e3f",
                    "sense_definition": "Лишать кого-либо жизни, вызывать смерть.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На войне солдатам часто приходится <убивать> врагов, чтобы защитить свою страну.",
                            "target_lang_translations": {
                                "en": "In war, soldiers often have to <kill> enemies to protect their country.",
                                "de": "Im Krieg müssen Soldaten oft Feinde <w>töten</w>, um ihr Land zu schützen."
                            }
                        },
                        {
                            "text": "Охотник сказал, что не хочет <убивать> редкого зверя ради забавы.",
                            "target_lang_translations": {
                                "en": "The hunter said he didn't want to <kill> a rare beast for fun.",
                                "de": "Der Jäger sagte, er wolle kein seltenes Tier zum Spaß <w>töten</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "умерщвлять",
                        "губить",
                        "лишать жизни"
                    ],
                    "antonyms": [
                        "оживлять",
                        "воскрешать",
                        "рожать"
                    ],
                    "common_phrases": [
                        "убивать людей",
                        "убивать животных",
                        "не убивай"
                    ],
                    "target_lang_definitions": {
                        "en": "To deprive someone of life, to cause death.",
                        "de": "Jemandem das Leben nehmen, den Tod herbeiführen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kill",
                                "target_lang_sense_clarification": "general term"
                            },
                            {
                                "target_lang_word": "murder",
                                "target_lang_sense_clarification": "unlawful killing"
                            },
                            {
                                "target_lang_word": "slay",
                                "target_lang_sense_clarification": "literary or violent"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "töten",
                                "target_lang_sense_clarification": "allgemeiner Begriff"
                            },
                            {
                                "target_lang_word": "umbringen",
                                "target_lang_sense_clarification": "umgangssprachlich"
                            },
                            {
                                "target_lang_word": "ermorden",
                                "target_lang_sense_clarification": "vorsätzlich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56a891ff-b325-32a6-bae5-a666181af259",
                    "sense_definition": "Расходовать или тратить что-либо (обычно время, здоровье или деньги) неразумно и без пользы.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "waste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я стараюсь не <убивать> время на бесполезные споры в интернете.",
                            "target_lang_translations": {
                                "en": "I try not to <kill> time on useless arguments on the internet.",
                                "de": "Ich versuche, meine Zeit nicht mit nutzlosen Diskussionen im Internet <w>totzuschlagen</w>."
                            }
                        },
                        {
                            "text": "Вредные привычки продолжают медленно <убивать> твоё здоровье.",
                            "target_lang_translations": {
                                "en": "Bad habits continue to slowly <destroy> your health.",
                                "de": "Schlechte Angewohnheiten <w>ruinieren</w> weiterhin langsam deine Gesundheit."
                            }
                        }
                    ],
                    "antonyms": [
                        "накапливать",
                        "копить",
                        "запасать"
                    ],
                    "common_phrases": [
                        "убивать время",
                        "убивать годы",
                        "убивать здоровье"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To use up or spend something (usually time, health, or money) unwisely and without benefit.",
                        "de": "Etwas (meist Zeit, Gesundheit oder Geld) unvernünftig und nutzlos verbrauchen oder verschwenden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kill",
                                "target_lang_sense_clarification": "specifically with time"
                            },
                            {
                                "target_lang_word": "waste",
                                "target_lang_sense_clarification": "general use"
                            },
                            {
                                "target_lang_word": "ruin",
                                "target_lang_sense_clarification": "regarding health"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "totschlagen",
                                "target_lang_sense_clarification": "nur auf die Zeit bezogen"
                            },
                            {
                                "target_lang_word": "ruinieren",
                                "target_lang_sense_clarification": "in Bezug auf die Gesundheit"
                            },
                            {
                                "target_lang_word": "verschwenden",
                                "target_lang_sense_clarification": "allgemeine Verschwendung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af2c09db-2478-323f-b392-822293d5d5af",
                    "sense_definition": "Уничтожать, губить или разрушать что-либо (чувства, идеи, природу), прекращать существование чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Человеческая деятельность может <убивать> природу, если не заботиться об экологии.",
                            "target_lang_translations": {
                                "en": "Human activity can <kill> nature if we don't care about the environment.",
                                "de": "Menschliche Aktivitäten können die Natur <w>zerstören</w>, wenn wir uns nicht um die Umwelt kümmern."
                            }
                        },
                        {
                            "text": "Ревность и недоверие способны <убивать> даже самую сильную любовь.",
                            "target_lang_translations": {
                                "en": "Jealousy and mistrust are capable of <killing> even the strongest love.",
                                "de": "Eifersucht und Misstrauen können selbst die stärkste Liebe <w>töten</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "уничтожать",
                        "разрушать",
                        "губить"
                    ],
                    "antonyms": [
                        "созидать",
                        "создавать",
                        "творить",
                        "возрождать",
                        "основывать"
                    ],
                    "common_phrases": [
                        "убивать любовь",
                        "убивать надежду",
                        "убивать природу"
                    ],
                    "target_lang_definitions": {
                        "en": "To destroy, ruin, or demolish something (feelings, ideas, nature), to end the existence of something.",
                        "de": "Etwas vernichten, zerstören oder ruinieren (Gefühle, Ideen, Natur), das Bestehen von etwas beenden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kill",
                                "target_lang_sense_clarification": "metaphorical"
                            },
                            {
                                "target_lang_word": "destroy",
                                "target_lang_sense_clarification": "general destruction"
                            },
                            {
                                "target_lang_word": "ruin",
                                "target_lang_sense_clarification": "to spoil completely"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "töten",
                                "target_lang_sense_clarification": "metaphorisch, z.B. Gefühle"
                            },
                            {
                                "target_lang_word": "zerstören",
                                "target_lang_sense_clarification": "allgemeine Zerstörung"
                            },
                            {
                                "target_lang_word": "vernichten",
                                "target_lang_sense_clarification": "vollständig auslöschen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd0b2c1b-ebd6-3936-9efa-36ef81ba50d4",
                    "sense_definition": "Приводить в отчаяние, сильно расстраивать или угнетать морально.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Твоё полное равнодушие к проблемам семьи просто <убивает> меня.",
                            "target_lang_translations": {
                                "en": "Your complete indifference to the family's problems is simply <killing> me.",
                                "de": "Deine völlige Gleichgültigkeit gegenüber den Problemen der Familie <w>macht</w> mich einfach <w>fertig</w>."
                            }
                        },
                        {
                            "text": "Эта грустная музыка начинает <убивать> моё хорошее настроение.",
                            "target_lang_translations": {
                                "en": "This sad music is starting to <kill> my good mood.",
                                "de": "Diese traurige Musik fängt an, meine gute Laune zu <w>verderben</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "оживлять"
                    ],
                    "common_phrases": [
                        "это меня убивает",
                        "убивать горем",
                        "убивать взглядом"
                    ],
                    "target_lang_definitions": {
                        "en": "To drive to despair, to strongly upset or morally oppress.",
                        "de": "In Verzweiflung stürzen, stark betrüben oder moralisch bedrücken."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kill",
                                "target_lang_sense_clarification": "hyperbolic (e.g., 'it's killing me')"
                            },
                            {
                                "target_lang_word": "devastate",
                                "target_lang_sense_clarification": "emotionally"
                            },
                            {
                                "target_lang_word": "crush",
                                "target_lang_sense_clarification": "to dispirit"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "fertigmachen",
                                "target_lang_sense_clarification": "umgangssprachlich für psychisch belasten"
                            },
                            {
                                "target_lang_word": "umbringen",
                                "target_lang_sense_clarification": "hyperbolisch, z.B. 'das bringt mich um'"
                            },
                            {
                                "target_lang_word": "quälen",
                                "target_lang_sense_clarification": "seelisch belasten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85de71cb-b80d-3da7-b5f3-08f71e8ac4cb",
                    "sense_definition": "Покрывать карту противника более старшей картой или козырем.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cards",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Опытный игрок знает, когда нужно <убивать> карту соперника, а когда лучше пропустить ход.",
                            "target_lang_translations": {
                                "en": "An experienced player knows when to <beat> an opponent's card and when it's better to skip a turn.",
                                "de": "Ein erfahrener Spieler weiß, wann er die Karte des Gegners <w>stechen</w> muss und wann es besser ist, zu passen."
                            }
                        },
                        {
                            "text": "Я стараюсь не <убивать> мелкие карты крупными козырями в начале игры.",
                            "target_lang_translations": {
                                "en": "I try not to <trump> small cards with high trumps at the beginning of the game.",
                                "de": "Ich versuche, niedrige Karten zu Beginn des Spiels nicht mit hohen Trümpfen zu <w>stechen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "убивать козырем",
                        "убивать туза",
                        "убивать даму"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "card games context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To cover an opponent's card with a higher-ranking card or a trump.",
                        "de": "Die Karte des Gegners mit einer höheren Karte oder einem Trumpf stechen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beat",
                                "target_lang_sense_clarification": "card games"
                            },
                            {
                                "target_lang_word": "trump",
                                "target_lang_sense_clarification": "use a trump card"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "stechen",
                                "target_lang_sense_clarification": "beim Kartenspiel"
                            },
                            {
                                "target_lang_word": "schlagen",
                                "target_lang_sense_clarification": "eine Karte übernehmen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "232ae250-f38f-323d-a9f3-13cb40ad172c",
                    "sense_definition": "Уплотнять или утрамбовывать поверхность (землю, щебень) ударами.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "compact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Рабочие начали <убивать> грунт специальным инструментом перед укладкой плитки.",
                            "target_lang_translations": {
                                "en": "The workers started to <compact> the soil with a special tool before laying the tiles.",
                                "de": "Die Arbeiter begannen, den Boden vor dem Verlegen der Fliesen mit einem Spezialwerkzeug <w>festzustampfen</w>."
                            }
                        },
                        {
                            "text": "Чтобы дорога была прочной, нужно тщательно <убивать> каждый слой щебня.",
                            "target_lang_translations": {
                                "en": "To make the road durable, one must carefully <tamp down> every layer of gravel.",
                                "de": "Damit die Straße stabil wird, muss man jede Schicht Schotter sorgfältig <w>verdichten</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "убивать землю",
                        "убивать щебень",
                        "плотно убивать"
                    ],
                    "target_lang_definitions": {
                        "en": "To compact or tamp down a surface (earth, gravel) with blows.",
                        "de": "Eine Oberfläche (Erde, Schotter) durch Schläge verdichten oder feststampfen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "compact",
                                "target_lang_sense_clarification": "soil or ground"
                            },
                            {
                                "target_lang_word": "tamp down",
                                "target_lang_sense_clarification": "construction context"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "feststampfen",
                                "target_lang_sense_clarification": "Erde oder Boden"
                            },
                            {
                                "target_lang_word": "verdichten",
                                "target_lang_sense_clarification": "im Bauwesen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91736c90-052f-3751-9bd4-abc4bc10dbc5",
                    "sense_definition": "Обивать, покрывать или набивать что-либо по всей поверхности (тканью, кожей).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "upholster",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мастер решил <убивать> старую дверь новой кожей для лучшей звукоизоляции.",
                            "target_lang_translations": {
                                "en": "The craftsman decided to <upholster> the old door with new leather for better soundproofing.",
                                "de": "Der Handwerker beschloss, die alte Tür mit neuem Leder zu <w>beziehen</w>, um eine bessere Schalldämmung zu erreichen."
                            }
                        },
                        {
                            "text": "Они собираются <убивать> стены тканью, чтобы создать уют в комнате.",
                            "target_lang_translations": {
                                "en": "They are going to <cover> the walls with fabric to create coziness in the room.",
                                "de": "Sie haben vor, die Wände mit Stoff zu <w>bespannen</w>, um Gemütlichkeit im Zimmer zu schaffen."
                            }
                        }
                    ],
                    "synonyms": [
                        "оббивать"
                    ],
                    "common_phrases": [
                        "убивать дверь",
                        "убивать войлоком"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To upholster, cover, or stuff something over the entire surface (with fabric, leather).",
                        "de": "Etwas auf der gesamten Oberfläche beschlagen, bedecken oder polstern (mit Stoff, Leder)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "upholster",
                                "target_lang_sense_clarification": "furniture or doors"
                            },
                            {
                                "target_lang_word": "pad",
                                "target_lang_sense_clarification": "with soft material"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "polstern",
                                "target_lang_sense_clarification": "Möbel oder Türen"
                            },
                            {
                                "target_lang_word": "beziehen",
                                "target_lang_sense_clarification": "mit Stoff oder Leder bespannen"
                            },
                            {
                                "target_lang_word": "verkleiden",
                                "target_lang_sense_clarification": "eine Oberfläche bedecken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}