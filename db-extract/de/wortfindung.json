                "senses": [
                    {
                        "sense_id": "b3e0430d-831b-3fe1-900b-bf3ba3133628",
                        "entry_id": "46cf8389-b1d5-328c-90e7-23c66f58d1f0",
                        "glosses": [
                            "der Vorgang, den der Sprecher/Schreiber bewältigen muss, um einen Gedanken, den er mitteilen will, mit einem geeigneten Wort zu benennen"
                        ],
                        "tags": [
                            "Psycholinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "22a42bca-b7d0-46a4-a241-e91203b90306",
                                "sense_id": "b3e0430d-831b-3fe1-900b-bf3ba3133628",
                                "text": "„Ein in seiner Ordnung durchschautes mentales Lexikon ist beim Zugriff besser verfügbar, sowohl bei der Worterkennung beim Hören und Lesen wie auch bei der Wortfindung beim Sprechen und Schreiben.“"
                            },
                            {
                                "example_id": "1d57a5f7-7fd4-4450-addb-829968f73629",
                                "sense_id": "b3e0430d-831b-3fe1-900b-bf3ba3133628",
                                "text": "„Die Wortfindung aber ist noch weiter deutlich gestört.“"
                            },
                            {
                                "example_id": "c4659c37-3837-4457-9ec8-26efd1d01593",
                                "sense_id": "b3e0430d-831b-3fe1-900b-bf3ba3133628",
                                "text": "„Bevor wir die aphasiologische Literatur zur Wortfindung darstellen, sollen einige theoretische Punkte klargestellt werden.“"
                            },
                            {
                                "example_id": "441bf21f-9f19-40bf-94b5-1081c09f04fe",
                                "sense_id": "b3e0430d-831b-3fe1-900b-bf3ba3133628",
                                "text": "„Unser Mitteilungsbedürfnis ist groß, aber die Wortfindung oft blockiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
