                ],
                "senses": [
                    {
                        "sense_id": "361c60bd-a08c-392f-a6df-66301dadc956",
                        "entry_id": "ab0492e7-5470-372b-85b8-227486ab0da9",
                        "glosses": [
                            "Abschiedsgruß, bei dem die Finger beziehungsweise die Fingerkuppen so, als küsse man sie, zunächst vor den Mund gehalten werden, um sie dann in Richtung der (geliebten) Person (mehrmals, gegebenenfalls unter gleichzeitigem Behauchen) vom Mund abzuziehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c1d5762-6c21-45b3-ae69-2bdd5f94dea9",
                                "sense_id": "361c60bd-a08c-392f-a6df-66301dadc956",
                                "text": "Sie warf ihm etliche Kusshände zu."
                            },
                            {
                                "example_id": "2f6a0bcc-fed6-48c1-a9ff-7f7a3735c42e",
                                "sense_id": "361c60bd-a08c-392f-a6df-66301dadc956",
                                "text": "Sie sah ihn auf der anderen Seite der Straße und schickte ihm über den Karnevalswagen hinweg eine Kusshand zu."
                            },
                            {
                                "example_id": "37ac9ec7-614a-48a1-8d0b-505ea1f6045d",
                                "sense_id": "361c60bd-a08c-392f-a6df-66301dadc956",
                                "text": "Du sprichst von meinem Ex? Von Peter? Den kannst du mit Kusshand nehmen. Werd glücklich mit dem Idioten!"
                            },
                            {
                                "example_id": "2973935a-1427-4000-894e-5205d2bb3598",
                                "sense_id": "361c60bd-a08c-392f-a6df-66301dadc956",
                                "text": "Du willst den Wagen wirklich verschrotten lassen? Also ich würde ihn mit Kusshand nehmen. Können wir nicht noch einmal darüber reden? Ich bezahle auch noch was für das Teil."
                            },
                            {
                                "example_id": "4a1b1d0d-735b-4458-97fd-3ddffe184a85",
                                "sense_id": "361c60bd-a08c-392f-a6df-66301dadc956",
                                "text": "Ob du es glaubst oder nicht, ich bin die alte Gefriertruhe noch mit Kusshand losgeworden."
                            },
                            {
                                "example_id": "ca22b525-0da8-4e84-a8c3-f3ca25a16395",
                                "sense_id": "361c60bd-a08c-392f-a6df-66301dadc956",
                                "text": "„An diesem Morgen regnete es, und Ólína stand dicht an der Wand des Busbahnhofs, eine Hand auf ihr Herz gelegt, mit der anderen warf sie ihrer Tochter eine Kusshand zu, als der Bus abfuhr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8dca1130-612e-374d-85f4-4b0318ab7d70",
                        "entry_id": "ab0492e7-5470-372b-85b8-227486ab0da9",
                        "glosses": [
                            "Fehlstellung der Hand durch eine vorausgegangene Lähmung des Nervus radialis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34523353-c1b8-4424-ace8-c493a62c38fe",
                                "sense_id": "8dca1130-612e-374d-85f4-4b0318ab7d70",
                                "text": "Bei meinem Opa hatte sich rechts durch seine Lähmung eine Kusshand entwickelt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
