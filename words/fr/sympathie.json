    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c1451387-cda7-3147-a9f0-ee84b49102e5",
                    "sense_definition": "Penchant naturel et spontané qui attire une personne vers une autre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès leur première rencontre, ils ont éprouvé une vive <w>sympathie</w> réciproque."
                        },
                        {
                            "text": "Son sourire chaleureux lui permet d'inspirer de la <w>sympathie</w> auprès de ses collègues."
                        }
                    ],
                    "synonyms": [
                        "affinité",
                        "attirance"
                    ],
                    "antonyms": [
                        "antipathie"
                    ],
                    "common_phrases": [
                        "éprouver de la sympathie",
                        "inspirer de la sympathie"
                    ]
                },
                {
                    "sense_id": "f4228a9d-eceb-31e6-b8b3-16f23ce022f1",
                    "sense_definition": "Capacité à partager les émotions, les peines ou les joies d'une autre personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a témoigné beaucoup de <w>sympathie</w> envers la famille en deuil."
                        },
                        {
                            "text": "Face au malheur de son ami, il a réagi avec sincérité et <w>sympathie</w>."
                        }
                    ],
                    "synonyms": [
                        "compassion",
                        "empathie"
                    ],
                    "common_phrases": [
                        "témoigner sa sympathie"
                    ]
                },
                {
                    "sense_id": "c2f1d12e-d025-35c3-b9ea-af1ccc90060f",
                    "sense_definition": "Bienveillance ou adhésion morale envers des personnes, des idées ou une cause.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adhesion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le candidat cherche à attirer la <w>sympathie</w> des jeunes électeurs."
                        },
                        {
                            "text": "Le professeur ne cachait pas ses <w>sympathies</w> républicaines lors des discussions."
                        }
                    ],
                    "synonyms": [
                        "bienveillance",
                        "faveur"
                    ],
                    "common_phrases": [
                        "attirer la sympathie",
                        "sympathies politiques"
                    ]
                },
                {
                    "sense_id": "18805b62-5d82-3d25-8b90-d2f1951df968",
                    "sense_definition": "Accord, correspondance ou influence mutuelle entre différentes choses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sur les marchés financiers, les cours du soja progressent en <w>sympathie</w> avec ceux du blé."
                        },
                        {
                            "text": "Une secousse économique locale a entraîné la baisse en <w>sympathie</w> d'autres secteurs voisins."
                        }
                    ],
                    "synonyms": [
                        "concordance",
                        "harmonie"
                    ],
                    "common_phrases": [
                        "monter en sympathie",
                        "en sympathie"
                    ]
                },
                {
                    "sense_id": "312c7bb4-ebb1-385a-93b4-4bc4961b208b",
                    "sense_definition": "Phénomène physique où un corps sonore entre en vibration lorsqu'un autre corps émet une fréquence similaire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "acoustique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La corde grave de la harpe vibre par <w>sympathie</w> quand on joue la note correspondante au piano."
                        },
                        {
                            "text": "Cette viole d'amour ancienne possède des cordes de <w>sympathie</w> qui enrichissent sa sonorité."
                        }
                    ],
                    "synonyms": [
                        "résonance"
                    ],
                    "common_phrases": [
                        "vibration par sympathie",
                        "corde de sympathie"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "terme technique en physique et acoustique"
                        }
                    ]
                }
            ]
        }
    ]
