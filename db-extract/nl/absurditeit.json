                        "translation_id": "7e17a561-a39f-4546-8f77-76a985d5c119",
                        "source_entry_id": "3086330f-29a5-3b23-b616-f503f4c71200",
                        "source_sense_id": "e1496ecd-df9e-313f-b30e-3956c3485f66",
