        "nl-extract.jsonl": [
            {
                "entry_id": "d6e32550-cd5f-35ca-a581-3b5a42536896",
                "word": "onverdraagzaamheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "866e9754-ce4f-4a5a-959e-e9ff0472fce6",
                        "entry_id": "d6e32550-cd5f-35ca-a581-3b5a42536896",
                        "tags": [
                            "plural"
                        ],
                        "form": "onverdraagzaamheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "82858927-2b7e-3ceb-a2e9-591aba9bc725",
                        "entry_id": "d6e32550-cd5f-35ca-a581-3b5a42536896",
                        "glosses": [
                            "houding waardoor iemand niet bereid is iets te aanvaarden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7675db03-c61f-46c3-9817-fda7a4f949c0",
                                "sense_id": "82858927-2b7e-3ceb-a2e9-591aba9bc725",
                                "text": "Maar het fanatisme waarmee Amerikaanse activisten hun ideeën over ras en gender uitdragen doet sterk denken aan eerdere vlagen van morele paniek. Het komt telkens op een andere manier terug: puritanisme, quasi-religieuze bevlogenheid, intellectuele onverdraagzaamheid, kortom met het tegenovergestelde van meer vrijheid."
                            },
                            {
                                "example_id": "5d570a56-76e3-4ced-9f6a-afeb79e627cb",
                                "sense_id": "82858927-2b7e-3ceb-a2e9-591aba9bc725",
                                "text": "Een land verenig je niet met één speech. Maar het is op zijn minst een begin als de taal van ontwrichting en onverdraagzaamheid wordt verdreven door het hoopvolle vocabulaire van eenheid en verzoening."
                            },
                            {
                                "example_id": "3f88eaf6-8d5d-4f48-b63a-866e070407a1",
                                "sense_id": "82858927-2b7e-3ceb-a2e9-591aba9bc725",
                                "text": "Volgens de liberaal stapelen de Vlamingen de onverdraagzaamheden op elkaar, of dat nu met de Wooncode is of met een stem voor extreem rechts."
                            }
                        ]
                    },
                    {
                        "sense_id": "97bf3fca-55cf-3696-88e6-ad798062965e",
                        "entry_id": "d6e32550-cd5f-35ca-a581-3b5a42536896",
                        "glosses": [
                            "lichamelijke eigenschap waardoor de stofwisseling bij sommigen ongunstig reageert op specifieke stoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26c5cab8-421b-4aaf-901d-14b86191f212",
                                "sense_id": "97bf3fca-55cf-3696-88e6-ad798062965e",
                                "text": "Informatie over medicatie: vragen over uw geneesmiddel, mogelijke bijwerkingen of onverdraagzaamheid, kan met een korte vraag aan de balie."
                            }
                        ]
                    },
                    {
                        "sense_id": "25809f3d-0e52-3910-96bd-16ba78f51904",
                        "entry_id": "d6e32550-cd5f-35ca-a581-3b5a42536896",
                        "glosses": [
                            "eigenschap waardoor iets niet aanvaardbaar of vol te houden is"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "68e39a12-8c0a-42b7-a89b-ab391974b8fa",
                                "sense_id": "25809f3d-0e52-3910-96bd-16ba78f51904",
                                "text": "⧖ Het houwelick dan, naer den val, wert in het meerendeel der menschen, veroorzaeckt, of beter ghenoodzaeckt, door de onverdraeghzaemheyd van de scherpe prickelen des vleeschs, die haer byzonderlick, in haer meeste kracht openbaren, wanneer de hooghe jaren het lichaem noch niet verswaert hebben, noch de gheestelicke weder-gheboorte de zelve ghenoeghzaem verstomt heeft."
                            }
                        ]
                    }
                ],
