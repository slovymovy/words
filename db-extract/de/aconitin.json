                        "glosses": [
                            "ein sehr giftiges Alkaloid, das natürlich im Blauen Eisenhut vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd3a5f10-45fe-4a9b-8a2b-0c7507719dd0",
                                "sense_id": "3b7a7ff9-a455-3690-af55-671ec48366e7",
                                "text": "„Doch immer mußte das Gift, zum Beispiel das aus der Rinde der Strychnos-Pflanze gewonnene Curare oder das aus dem Blauen Eisenhut destillierte Aconitin, dem Opfer unter die Haut, in Lunge oder Magen bugsiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
