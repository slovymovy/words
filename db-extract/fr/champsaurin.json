                        "glosses": [
                            "Relatif au Champsaur ; originaire du Champsaur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e2ef699-d3cd-4d1e-81aa-2b22d5713505",
                                "sense_id": "0295bf88-a45e-3d8e-98cf-37f45646fe12",
                                "text": "Un agriculteur champsaurin à “L’amour est dans le pré”"
                            },
                            {
                                "example_id": "740e9cd5-2b1e-4d9e-b430-280b65cddab2",
                                "sense_id": "0295bf88-a45e-3d8e-98cf-37f45646fe12",
                                "text": "Le patois peut être considéré comme la forme dialectale caractéristique d’une zone très réduite (exemple du patois champsaurin ou gapençais)."
                            },
                            {
                                "example_id": "0396e8f8-ae4b-41b5-967e-7500ea45ee3e",
                                "sense_id": "0295bf88-a45e-3d8e-98cf-37f45646fe12",
                                "text": "Si d’ici le 19 décembre les chariots parisiens regagnent la boulangerie champsaurine, il sera dispensé de peine."
                            },
                            {
                                "example_id": "9c7a9622-b81f-40dc-ab3b-37fc1646457e",
                                "sense_id": "0295bf88-a45e-3d8e-98cf-37f45646fe12",
                                "text": "L’événement sportif, rassemblant un millier de participants, est le temps fort de l’année, annonçant l’ouverture de la saison d’été champsaurine."
                            }
                        ]
                    }
