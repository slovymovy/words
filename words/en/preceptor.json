                    "frequency": "Middle",
                    "semantic_group_id": "instructor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medical student shadowed her <w>preceptor</w> through the emergency department to observe complex procedures."
                        },
                        {
                            "text": "An experienced nurse acted as a <w>preceptor</w> to help new graduates adjust to hospital routines."
                        }
                    ],
                    "synonyms": [
