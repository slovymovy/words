                ],
                "senses": [
                    {
                        "sense_id": "15bb18a8-b222-3bca-8f8d-8bd203e89143",
                        "entry_id": "45725c2f-5d67-3c87-8408-78bae0f1a5e3",
                        "glosses": [
                            "Donner un caractère beauf à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "178f31b4-b4ae-49d8-aebc-325640eedf76",
                                "sense_id": "15bb18a8-b222-3bca-8f8d-8bd203e89143",
                                "text": "Il a estimé dans 10 Sport que Pierre Ménès avait \"beaufisé l’antenne\"."
                            },
                            {
                                "example_id": "cb09e5e4-eb92-4bdf-be5f-414adb61250e",
                                "sense_id": "15bb18a8-b222-3bca-8f8d-8bd203e89143",
                                "text": "Et je trouve très déplaisante cette manière -bien dans l'esprit de Ribes- de \"beaufiser\" tous ses personnages."
                            },
                            {
                                "example_id": "7a0b9471-b9f0-4d16-b7a9-8112145b6849",
                                "sense_id": "15bb18a8-b222-3bca-8f8d-8bd203e89143",
                                "text": "On aura toujours des classements de merde au niveau des ventes, puisque le profil de l'acheteur a tendance à se \"beaufiser\" (désolé)."
                            },
                            {
                                "example_id": "b1a13ae9-97a3-4b76-8326-cfdc137046ac",
                                "sense_id": "15bb18a8-b222-3bca-8f8d-8bd203e89143",
                                "text": "\"Voilà ce que ça donne la coupe du monde sur TF1, le rugby va se beaufiser\""
                            },
                            {
                                "example_id": "e1fc9ccd-9ad3-4090-bf98-ce2a90a96245",
                                "sense_id": "15bb18a8-b222-3bca-8f8d-8bd203e89143",
                                "text": "Tout porte à croire que tu es en train de te beaufiser !"
                            }
                        ]
                    }
