                                "target_senses": [
                                    {
                                        "sense_id": "8bf359d3-c2dc-322a-b81c-320690842e9e",
                                        "entry_id": "76d9a851-ddb9-3525-9a1c-cd1380cfc369",
                                        "glosses": [
                                            "A set of six."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f785e06b-df4b-40ca-aae7-895ea3497afd",
                                                "sense_id": "8bf359d3-c2dc-322a-b81c-320690842e9e",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. To display them the walls had been tinted a vivid blue which had now faded, but the carpet, which had evidently been stored and recently relaid, retained its original turquoise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57611c9d-5f10-43a1-a305-b3b9c2d2eebf",
                        "source_entry_id": "e0873da4-1f26-3840-aeff-7ee0f65e2c0a",
                        "source_sense_id": "eea2c357-593b-34a8-b499-dd56d3cabaaf",
                        "target_lang_word": "half a dozen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "half a dozen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8573aaf-8a80-3ca6-8071-1c98bbbce3bc",
                                        "entry_id": "6236b856-9523-3e93-b3cb-819fd61dffda",
                                        "glosses": [
                                            "Six (6); often used approximatively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e4e9d63-f2e6-4e35-ace1-68e8221d56fe",
                                                "sense_id": "f8573aaf-8a80-3ca6-8071-1c98bbbce3bc",
                                                "text": "Anstruther laughed good-naturedly. “[…] I shall take out half a dozen intelligent maistries from our Press and get them to give our villagers instruction when they begin work and when they are in the fields.”"
                                            },
                                            {
                                                "example_id": "9ccf0ac3-7b41-4399-85a6-5d0dbd4ab1df",
                                                "sense_id": "f8573aaf-8a80-3ca6-8071-1c98bbbce3bc",
                                                "text": "The good news is that £800 million is allocated to new rolling stock, £200m for stations (including six new ones), and a further £736m to transform the Valley Lines, a network of half-a-dozen services that run up the valleys from Cardiff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a98f17d-781d-393d-ad98-58d81b5e4764",
                                        "entry_id": "6236b856-9523-3e93-b3cb-819fd61dffda",
                                        "glosses": [
                                            "six"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
