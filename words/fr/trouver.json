                        "trouver une idée"
                    ]
                },
                {
                    "sense_id": "d0519270-2393-351c-8d06-3bce6dfde5b4",
                    "sense_definition": "Être situé ou placé dans un endroit précis.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La boulangerie se <w>trouve</w> juste en face du cinéma de quartier."
                        },
                        {
                            "text": "Plusieurs petits villages se <w>trouvent</w> le long de cette belle rivière."
                        }
                    ],
                    "common_phrases": [
                        "se trouver en face",
                        "se trouver près de"
                    ]
                },
                {
                    "sense_id": "9b94627c-283a-3d16-96a6-019baf9a4d4c",
                    "sense_definition": "Arriver ou s'avérer par hasard ou par coïncidence.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "coincidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il se <w>trouve</w> que nous prenons exactement le même train ce soir."
                        },
                        {
                            "text": "Comme il se <w>trouvait</w> qu'il était libre, il a accepté de nous accompagner."
