    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fe7cfac2-9927-3452-9469-e29ddc8d5e8a",
                "word": "Clara",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7cbbc244-b7b5-3259-bf0f-02749c58e51e",
                        "entry_id": "fe7cfac2-9927-3452-9469-e29ddc8d5e8a",
                        "glosses": [
                            "A female given name from Latin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c13b491-6522-4e7a-ab51-7c1990a83737",
                                "sense_id": "7cbbc244-b7b5-3259-bf0f-02749c58e51e",
                                "text": "But the fashion spreads deeper and wider; the village is infected and the village green; Amelias and Claras sweep your rooms and cook your dinners, gentle Sophias milk your cows, and if you ask a pretty smiling girl at a cottage door to tell you her name, the rosy lips lisp out Caroline."
                            },
                            {
                                "example_id": "cb44efc4-1553-4529-8925-92d8926746e8",
                                "sense_id": "7cbbc244-b7b5-3259-bf0f-02749c58e51e",
                                "text": "My mother called me Clara. And everybody else called me Clara until I was fourteen years old. Then I got sick of it. Clara! Sounds like breaking glass. Did you ever stop to think of that, Frank? Say it fast and hit the C."
                            }
                        ]
                    },
                    {
                        "sense_id": "3557af6a-b947-3a58-82f4-9f37c54f653e",
                        "entry_id": "fe7cfac2-9927-3452-9469-e29ddc8d5e8a",
                        "glosses": [
                            "A town in Pyrénées-Orientales department, France; named Clara-Villerach since 2017."
                        ],
                        "tags": [],
                        "examples": []
