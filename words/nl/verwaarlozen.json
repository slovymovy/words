                        },
                        {
                            "text": "Het verschil tussen de twee resultaten is zo klein dat we het kunnen <w>verwaarlozen</w>.",
                            "target_lang_translations": {
                                "en": "The difference between the two results is so small that we can <w>ignore</w> it."
