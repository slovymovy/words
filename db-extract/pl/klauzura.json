                    {
                        "translation_id": "a6c352b4-26c3-4baa-ae32-12faaac415f7",
                        "source_entry_id": "f2041b79-ba95-375f-8125-1e3b2b86d3df",
                        "source_sense_id": "6061e2d2-a5c7-3c41-a68f-162f027c3f43",
                        "target_lang_word": "clausura",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clausura",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "3277c326-418e-3523-94b4-6ef3283c26f5",
                                        "entry_id": "0a987e25-39ef-350e-8970-63975a12ceff",
