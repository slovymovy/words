                                "target_senses": [
                                    {
                                        "sense_id": "378ab5db-1a41-3260-9027-1e328aa78cbc",
                                        "entry_id": "c9bf51cb-fa7f-3934-9ab8-7431c8cb929f",
                                        "glosses": [
                                            "Qui peut être crevé."
                                        ],
                                        "tags": [
                                            "literally",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acba2338-45a8-431c-b03c-fa0f02750836",
                                                "sense_id": "378ab5db-1a41-3260-9027-1e328aa78cbc",
                                                "text": "Le plus pratique, le plus solide, le plus léger, le plus difficilement crevable, le plus facilement réparable, le moins cher."
                                            },
                                            {
                                                "example_id": "b5ef5a40-bd00-4636-92da-961731fb10d5",
                                                "sense_id": "378ab5db-1a41-3260-9027-1e328aa78cbc",
                                                "text": "Vu d’ici, ta bulle me paraît éminemment crevable."
                                            },
                                            {
                                                "example_id": "02a08e3d-67a7-4e04-ab70-dedf6be87e91",
                                                "sense_id": "378ab5db-1a41-3260-9027-1e328aa78cbc",
                                                "text": "Coquille creuse, bulle irisée mais crevable au moindre toucher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18240de6-c24b-3804-a346-dcf8ead1ef45",
                                        "entry_id": "c9bf51cb-fa7f-3934-9ab8-7431c8cb929f",
                                        "glosses": [
                                            "Dont la mort est possible."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d88ec38-381e-4599-9743-5c046b749a20",
                                                "sense_id": "18240de6-c24b-3804-a346-dcf8ead1ef45",
                                                "text": "L’interne arrivait, remmaillotait l’homme… Pas crevable c’est tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "debee6f4-3bea-3455-b4da-1a53681c189e",
                                        "entry_id": "c9bf51cb-fa7f-3934-9ab8-7431c8cb929f",
                                        "glosses": [
                                            "Qui peut se fatiguer, s’épuiser."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57efc171-891b-4bf8-87c9-f37033c30140",
                                                "sense_id": "debee6f4-3bea-3455-b4da-1a53681c189e",
                                                "text": "- Ouais, mais après deux semaines, j’aurais pus d’colonne.\n- Voyons, toi, t’es pas crevable."
                                            },
                                            {
                                                "example_id": "d097c427-8063-4205-a603-8fd8ba5573b1",
                                                "sense_id": "debee6f4-3bea-3455-b4da-1a53681c189e",
                                                "text": "Mais l'homme, comme le vélo, est un crevable : je suis crevé, j’ai crevé, j’en p(n)eux plus; sur mon vieux clou, je crève d’envie de vivre, comme l’increvable Bibendum !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
