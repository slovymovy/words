                    {
                        "sense_id": "cf18a042-578d-3ac0-a679-dd9105be1e02",
                        "entry_id": "7d237b87-8e89-34f4-8c95-3c19d66ddf82",
                        "glosses": [
                            "Ensemble des ARN (molécules servant de matrice pour la synthèse des protéines) issu de l’expression d’une partie du génome d’un tissu cellulaire ou d’un type de cellule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bc5be5b-c3db-4279-a422-8d572bee3947",
                                "sense_id": "cf18a042-578d-3ac0-a679-dd9105be1e02",
                                "text": "Ce terme d’origine anglo-saxonne a été proposé en 1998 par analogie avec les termes génome, protéome et transcriptome."
                            },
                            {
                                "example_id": "111f6774-3dcc-4d21-a68f-03f569a861ca",
                                "sense_id": "cf18a042-578d-3ac0-a679-dd9105be1e02",
                                "text": "[…] le transcriptome et les modifications épigénétiques diffèrent dans ces lignées cellulaires, malgré un traitement avec des facteurs de croissance identiques."
                            }
                        ]
                    }
                ],
                "translations": [
