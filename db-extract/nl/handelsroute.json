                        "sense_id": "7bb25965-0eb3-36a5-a71b-dfe23f14de62",
                        "entry_id": "31f52201-39b3-32ef-8507-6643fc115eab",
                        "glosses": [
                            "een door handelaren gebruikte verbinding over land of water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df469982-5177-46de-81e4-3ff102890f1e",
                                "sense_id": "7bb25965-0eb3-36a5-a71b-dfe23f14de62",
                                "text": "Na een ruzie over een kapotgeslagen kompas met de kapitein van een zeilschip had hij aangemonsterd op de Blásut, die afgetuigd in Vástervik lag, maar weer in de vaart genomen zou worden op zijn vaste handelsroute tussen Gávle en Kopenhagen."
                            },
                            {
                                "example_id": "8f558455-ab76-41c1-b1a9-810334d1f40e",
                                "sense_id": "7bb25965-0eb3-36a5-a71b-dfe23f14de62",
                                "text": "De Ambassador Bridge ligt op een belangrijke handelsroute tussen Ontario en Michigan. De blokkade leidt onder meer tot problemen bij de aanvoer van onderdelen in de auto-industrie."
                            }
                        ]
                    }
