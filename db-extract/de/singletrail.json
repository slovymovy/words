                "senses": [
                    {
                        "sense_id": "3bbd16f4-95a4-3339-8126-c2fe2301e714",
                        "entry_id": "bb084eff-ba8c-37db-a6bb-c45cef2e25d5",
                        "glosses": [
                            "schmaler Trampelpfad, der ein Nebeneinanderfahren oder Nebeneinanderlaufen nicht ermöglicht"
                        ],
                        "tags": [
                            "Scheinanglizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "99157513-874e-4d20-a4c0-aec53a00ebd5",
                                "sense_id": "3bbd16f4-95a4-3339-8126-c2fe2301e714",
                                "text": "Gemeinderat Sulzburg vertagt die Entscheidung über ein Teilstück eines Singletrails für Mountainbiker auf eigener Gemarkung."
                            },
                            {
                                "example_id": "7d0770ca-e320-41fe-86cc-f41f94825998",
                                "sense_id": "3bbd16f4-95a4-3339-8126-c2fe2301e714",
                                "text": "Singletrails erfreuen sich immer größerer Beliebtheit bei Mountainbikern."
                            },
                            {
                                "example_id": "ef42fccd-2bb3-43c6-806d-e30ab9a4b9b0",
                                "sense_id": "3bbd16f4-95a4-3339-8126-c2fe2301e714",
                                "text": "Der Verein müsse eingebunden werden und sicher gestellt sein, dass er auch beim Kompromiss eines Singletrails anstatt einer Trainingsstrecke, Verantwortung übernehme."
                            },
                            {
                                "example_id": "c62f35dd-c0e0-4404-958d-23de3bc5b926",
                                "sense_id": "3bbd16f4-95a4-3339-8126-c2fe2301e714",
                                "text": "Ein wenig Nervenkitzel gehört mit Sicherheit dazu, wenn man sich die Singletrails hinunter stürzt."
                            },
                            {
                                "example_id": "5086eb19-d1e5-4336-bb50-11cedfd8f1b2",
                                "sense_id": "3bbd16f4-95a4-3339-8126-c2fe2301e714",
                                "text": "Mit einer Streckenlänge von 7,1 Kilometer ist der Fleckalm Trail einer der längsten Singletrails des Landes."
                            },
                            {
                                "example_id": "96158b85-4487-4fb3-8fb6-6cf159dc6fc5",
                                "sense_id": "3bbd16f4-95a4-3339-8126-c2fe2301e714",
                                "text": "Die Singletrail-Skala definiert die Schwierigkeit eines Singletrails."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
