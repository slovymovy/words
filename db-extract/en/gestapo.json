                "senses": [
                    {
                        "sense_id": "0fc95c3d-72ab-32f7-a19f-c98dd2d4e1e4",
                        "entry_id": "0eab6197-5afb-37e0-850b-9e977f034aee",
                        "glosses": [
                            "The secret police of Nazi Germany."
                        ],
                        "tags": [
                            "Nazism",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "55ce5bf9-a549-477d-ad8b-8bf7e05f1bdd",
                                "sense_id": "0fc95c3d-72ab-32f7-a19f-c98dd2d4e1e4",
                                "text": "Fortunately this was Spain and not Germany. The Spanish secret police had some of the spirit of the Gestapo, but not much of its competence."
                            }
                        ]
                    },
                    {
                        "sense_id": "0948d925-3fcc-3b7c-b542-aa32b9a95284",
                        "entry_id": "0eab6197-5afb-37e0-850b-9e977f034aee",
                        "glosses": [
                            "Any militant oppressive force or group."
                        ],
                        "tags": [
                            "broadly",
                            "derogatory",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "2721929d-8c71-48ef-aef1-d75ead487a76",
                                "sense_id": "0948d925-3fcc-3b7c-b542-aa32b9a95284",
                                "text": "Men were frog-marched by the feminist Gestapo into accepting an alien 'politically correct' agenda."
                            },
                            {
                                "example_id": "55800c24-83b5-451b-9510-9834da311cba",
                                "sense_id": "0948d925-3fcc-3b7c-b542-aa32b9a95284",
                                "text": "One of those injured by the immigration Gestapo spoke to WSWS reporter Kimie Saito, his head wrapped in white bandages stained with blood."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ae6b7c0-dce5-4937-94a0-bd50e3339182",
                        "source_entry_id": "0eab6197-5afb-37e0-850b-9e977f034aee",
                        "source_sense_description": "the secret police of Nazi Germany",
                        "target_lang_word": "Gestapo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gestapo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed3b5be8-33c7-347c-a759-5b14f6ac528e",
                                        "entry_id": "c63c7bcf-a22f-3ecb-98fc-c9cba8e43b65",
                                        "glosses": [
                                            "Polizeibehörde zur Zeit des Nationalsozialismus, deren Aufgabenbereich besonders die Aufdeckung von politischen Straftaten und die Verfolgung von Regimegegnern umfasste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1e9e060-cdf6-4197-b732-dc7b2b817ad3",
                                                "sense_id": "ed3b5be8-33c7-347c-a759-5b14f6ac528e",
                                                "text": "„Mohr hatte schon die Freilassung Sophie Scholls angeordnet, da fand die Gestapo in der Wohnung ihres Bruders erdrückende Beweise.“"
                                            },
                                            {
                                                "example_id": "d0834653-4722-46c6-9231-ec67f859de46",
                                                "sense_id": "ed3b5be8-33c7-347c-a759-5b14f6ac528e",
                                                "text": "„Kapitan Klos sollte dem Publikum die intellektuelle Überlegenheit eines polnischen Spions über die deutsche SS oder die Gestapo zeigen, was bei Zuschauern unter zwölf auch gelang.“"
                                            },
                                            {
                                                "example_id": "c9b5ecc6-f252-497d-a5ef-d36ab70a0df8",
                                                "sense_id": "ed3b5be8-33c7-347c-a759-5b14f6ac528e",
                                                "text": "„In Berlin gab es damals in dieser Hinsicht, trotz Gestapo, noch alles, was das Herz begehrte.“"
                                            },
                                            {
                                                "example_id": "c8af4dac-5627-4d0f-8476-3100b7170e45",
                                                "sense_id": "ed3b5be8-33c7-347c-a759-5b14f6ac528e",
                                                "text": "„Man konnte nicht vorsichtig genug sein in diesen Zeiten, wo jeder der Spion des andern war, die Gestapo ihre Hand über alle hielt, das KZ Sachsenhausen immer größer wurde und das Fallbeil in der Plötze alle Tage Arbeit hatte.“"
                                            },
                                            {
                                                "example_id": "b13c83e6-f66a-46c7-8b81-ca41f9d69627",
                                                "sense_id": "ed3b5be8-33c7-347c-a759-5b14f6ac528e",
                                                "text": "„Zwei Jahre wird die Familie von der Gestapo drangsaliert, 1943 schließlich der Vater verhaftet.“"
                                            },
                                            {
                                                "example_id": "d4a02d18-ac8c-4b42-8264-94644d401854",
                                                "sense_id": "ed3b5be8-33c7-347c-a759-5b14f6ac528e",
                                                "text": "[Dietrich Bonhoeffer:] „Zurück in Deutschland, leitete er von 1935 an das Predigerseminar der oppositionellen Bekennenden Kirche im pommerschen Finkenwalde, bis es 1937 von der Geheimen Staatspolizei (Gestapo) geschlossen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
