                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Phraseologie"
                    },
                    {
                        "form_id": "82dd4796-bfdf-442d-913b-664a22d30b9f",
                        "entry_id": "31f7068b-1494-33be-bb83-338dd3537ecf",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Phraseologien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e9096df6-7f82-36d3-9fd9-2ab5ff6e94e8",
                        "entry_id": "31f7068b-1494-33be-bb83-338dd3537ecf",
                        "glosses": [
                            "ohne Plural: Teildisziplin der Linguistik, die sich mit den Phraseologismen, den Redewendungen, befasst."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6832415-6865-4a9e-b820-3818bf24c091",
                                "sense_id": "e9096df6-7f82-36d3-9fd9-2ab5ff6e94e8",
                                "text": "Die Phraseologie befasst sich mit den festen Wortverbindungen."
                            },
                            {
                                "example_id": "2e5ea86b-198e-407a-b54b-2b1ab5480060",
                                "sense_id": "e9096df6-7f82-36d3-9fd9-2ab5ff6e94e8",
                                "text": "„Da jedoch die Einheiten des phraseologischen Bestandes die Merkmale der Reproduzierbarkeit, Lexikalität, Idiomatizität und Stabilität in unterschiedlichem Grade besitzen, der außerordentlich heterogene Bestand nach unterschiedlichen Kriterien geordnet werden kann, sind ebenfalls in der sowjetischen Linguistik Bestrebungen entstanden, die Phraseologismusforschung, die Phraseologie, als neue linguistische Disziplin zu betrachten…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fad97adb-d999-385a-9f2d-a2834af0f29e",
                        "entry_id": "31f7068b-1494-33be-bb83-338dd3537ecf",
                        "glosses": [
                            "Gesamtheit der Phraseologismen einer Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92bf1c9c-f64a-406a-be6a-a3d85544dfcb",
                                "sense_id": "fad97adb-d999-385a-9f2d-a2834af0f29e",
                                "text": "„Zum Sprachsystem gehören aber nicht nur grammatische und lexikalische Einheiten, sondern auch solche der Phraseologie, d. h. die Wortverbindungen oder Redewendungen, die dem Sprecher zur Verfügung stehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f5106384-ab43-3586-9260-8a09f6dc9ee7",
                        "entry_id": "31f7068b-1494-33be-bb83-338dd3537ecf",
                        "glosses": [
                            "Sammlung von Phraseologismen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4d57d9f-8326-46c4-ad6b-e32ff3802e25",
                                "sense_id": "f5106384-ab43-3586-9260-8a09f6dc9ee7",
                                "text": "Der Phraseologismus \"Jemanden in die Pfanne hauen\" gehört in eine Phraseologie des Deutschen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a534d895-353c-4b54-b557-13132b7df42a",
                        "source_entry_id": "31f7068b-1494-33be-bb83-338dd3537ecf",
                        "source_sense_id": "e9096df6-7f82-36d3-9fd9-2ab5ff6e94e8",
                        "target_lang_word": "phraseology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phraseology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10c75d38-0402-37fd-a681-e0aee67a52a1",
                                        "entry_id": "19608c0e-93c2-30a4-837b-34fa40a6a8bd",
                                        "glosses": [
                                            "Study of set or fixed expressions."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1574c467-9315-3430-b706-67f4a0735e10",
                                        "entry_id": "19608c0e-93c2-30a4-837b-34fa40a6a8bd",
                                        "glosses": [
                                            "The style in which words and phrases are used in writing or speech."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bf2e738-da27-450b-a7aa-ba2be9b24464",
                                                "sense_id": "1574c467-9315-3430-b706-67f4a0735e10",
                                                "text": "I was riding through the forest, when suddenly (pray correct my phraseology if too worldly—you know I am not well read in these epics of the heart) I saw a knight and his lady traversing one of the glades; the golden sunshine fell athwart the green leaves, and showed their white steeds and whiter plumes, while the air around grew musical with their gentle words and laughter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c85458b-cd99-3159-8a1e-2aa41c059cfd",
                                        "entry_id": "19608c0e-93c2-30a4-837b-34fa40a6a8bd",
                                        "glosses": [
                                            "A group of specialized words and expressions used by a particular group."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "024ce262-63bb-4ca9-8ffe-078c128e67d2",
                                                "sense_id": "7c85458b-cd99-3159-8a1e-2aa41c059cfd",
                                                "text": "Fortunately, two servants she had brought with her, were devotedly attached to their mistress; and the others only entering her apartments at rare intervals, did not understand her mystic allusions; and she now, more than ever, affected to veil her meaning under the mysterious phraseology so much adopted by the Jacobites."
                                            },
                                            {
                                                "example_id": "7cae9367-80ee-4878-858f-a0981e7a7a1c",
                                                "sense_id": "7c85458b-cd99-3159-8a1e-2aa41c059cfd",
                                                "text": "Railway grouping had caused some peculiarly Scottish phraseology to disappear, though the note \"Stops on timous notice to the guard\" survived until comparatively recently."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30186e8d-c8e4-3375-8503-03754d112f78",
                                        "entry_id": "19608c0e-93c2-30a4-837b-34fa40a6a8bd",
                                        "glosses": [
                                            "A collection of phrases; a phrasebook."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06f68adc-f001-4926-a8be-934752076d94",
                        "source_entry_id": "31f7068b-1494-33be-bb83-338dd3537ecf",
                        "source_sense_id": "e9096df6-7f82-36d3-9fd9-2ab5ff6e94e8",
                        "target_lang_word": "phraséologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phraséologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f602081a-9798-38ff-9fae-a67ad701c63f",
                                        "entry_id": "040a3b6c-b2ae-3fb0-90ea-49ac633f5e5a",
                                        "glosses": [
                                            "Construction de phrases particulière à une langue, ou propre à un écrivain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0daf0bec-a125-4f32-8f3f-e817fc70103b",
                                                "sense_id": "f602081a-9798-38ff-9fae-a67ad701c63f",
                                                "text": "Certainement il n’y a pas de langue aussi riche dans la phraséologie variée que les exercices champêtres exigent, ou qui fournisse autant de moyens au forestier expérimenté pour exprimer son art joyeux."
                                            },
                                            {
                                                "example_id": "72285d5b-bf44-4427-a7b2-6548ea3058d1",
                                                "sense_id": "f602081a-9798-38ff-9fae-a67ad701c63f",
                                                "text": "L'anglais, le français, l'italien ont une certaine communauté de phraséologie technique, scientifique et philosophique, et fréquemment, pour un Anglais ayant une connaissance spéciale de son sujet, il est plus facile de lire et d'apprécier un subtil ouvrage technique écrit en français que de pénétrer le sens précis des ouvrages populaires de la même langue."
                                            },
                                            {
                                                "example_id": "4d23f061-1777-4308-a15f-c3dba0ac5c4a",
                                                "sense_id": "f602081a-9798-38ff-9fae-a67ad701c63f",
                                                "text": "Il se souvint tout à coup d'une vieille chronique où il avait […] accumulé des bataillons d'imprécations pétaradantes […], imitant et plagiant même, en ces débordements insensés, la phraséologie vitupérante et l’inouïssime du dénommé Léon Bloy, magicien de l'Expression, brasseur de bran, tritureur de matière fécale et orfèvre du sublime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89e85f2e-7fa4-3f23-b6e8-63b0effbca9e",
                                        "entry_id": "040a3b6c-b2ae-3fb0-90ea-49ac633f5e5a",
                                        "glosses": [
                                            "Discours creux, vide de sens."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57a2adf0-e783-445c-a987-29a81c639da7",
                                                "sense_id": "89e85f2e-7fa4-3f23-b6e8-63b0effbca9e",
                                                "text": "— Ce que c’est que de ne pas s’entendre et de se promener dans une phraséologie vague, au lieu de marcher droit au but."
                                            },
                                            {
                                                "example_id": "a17c91ed-6c22-4799-ad1a-67399c06e0ed",
                                                "sense_id": "89e85f2e-7fa4-3f23-b6e8-63b0effbca9e",
                                                "text": "Mon livre ne vaut rien ; le style en est torturé, la conception enfantine : une déclamation violente, une phraséologie absurde y remplacent l’idée."
                                            },
                                            {
                                                "example_id": "2927bf56-d395-4ede-9bbc-0c008c17f02a",
                                                "sense_id": "89e85f2e-7fa4-3f23-b6e8-63b0effbca9e",
                                                "text": "Sa prose hébraïque était simple, claire, précise, sans cette phraséologie creuse et ampoulée qui était de mode en ce temps."
                                            },
                                            {
                                                "example_id": "f6aa9eee-c083-458f-8414-b428c11f2f76",
                                                "sense_id": "89e85f2e-7fa4-3f23-b6e8-63b0effbca9e",
                                                "text": "Un style dans lequel se trouvent les mots de Dieu, de vertu, de liberté, est puissant : il plaît aux hommes, les rassure et les console ; combien il est supérieur à ces phrases affectées, tristement empruntées des locutions païennes et fatalistes à la turque : il fut, ils ont été, la fatalité les entraîne ! phraséologie stérile, toujours vaine, alors même qu'elle est appuyée sur les plus grandes actions."
                                            },
                                            {
                                                "example_id": "c22c0a71-0173-4445-9ecd-4901fe5da4eb",
                                                "sense_id": "89e85f2e-7fa4-3f23-b6e8-63b0effbca9e",
                                                "text": "D'évidence, cette phraséologie électorale ressortissait à sa plus pauvre veine ; le « fier archer » s'efforçant aux plates promesses d'un aspirant à la Chambre endosserait-il la livrée du batteur d’estrade ?"
                                            },
                                            {
                                                "example_id": "27c1f84e-878e-4f8c-a5f7-e19a09af48f0",
                                                "sense_id": "89e85f2e-7fa4-3f23-b6e8-63b0effbca9e",
                                                "text": "Cette « catastrophe » est décrite par Jacque Bouveresse comme « celle du triomphe de la phraséologie creuse, qui permet de nier ou de transformer à volonté la réalité […] à la disparition de toute espèce de contenu et de réflexion au profit de la banalité et de l’automatisme »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4afeeaf-a8fa-4c2b-8120-76f6d3238f66",
                        "source_entry_id": "31f7068b-1494-33be-bb83-338dd3537ecf",
                        "source_sense_id": "e9096df6-7f82-36d3-9fd9-2ab5ff6e94e8",
                        "target_lang_word": "фразеология",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фразеология",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "96b25ccc-9f81-3cc0-adfc-562ec5dc0329",
                                        "entry_id": "3c94a981-84c5-3452-ad99-3ffc050152a1",
                                        "glosses": [
                                            "лингв., ед. ч. раздел лексикологии, изучающий устойчивые сочетания слов (фразеологические единицы), то же, что идиоматика"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "695060cc-a749-3a68-ae5c-647b11ae1b50",
                                        "entry_id": "3c94a981-84c5-3452-ad99-3ffc050152a1",
                                        "glosses": [
                                            "лингв., филол. совокупность фразеологизмов и идиом, свойственных какому-либо языку, уровню языка, автору, литературному памятнику"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b6398f2-3a16-4f19-b4dc-50ce58e18eb1",
                                                "sense_id": "695060cc-a749-3a68-ae5c-647b11ae1b50",
                                                "text": "Фразеология русского литературного языка."
                                            },
                                            {
                                                "example_id": "6548e48a-41a7-4b6c-9374-43cbf346b85a",
                                                "sense_id": "695060cc-a749-3a68-ae5c-647b11ae1b50",
                                                "text": "Французская фразеология."
                                            },
                                            {
                                                "example_id": "0b355dab-5af3-4822-9b93-18dd81ebbdec",
                                                "sense_id": "695060cc-a749-3a68-ae5c-647b11ae1b50",
                                                "text": "Поэтическая фразеология Пушкина."
                                            },
                                            {
                                                "example_id": "61686c86-5495-45c4-98c0-046105c3f470",
                                                "sense_id": "695060cc-a749-3a68-ae5c-647b11ae1b50",
                                                "text": "Лексика и фразеология псковских летописей, отличаясь такою же чуждостью литературной изысканности, ещё более новгородских простодушна и просторечива, привязана к местному областному словарю, близка к местному фольклору в своей любви к пословице, к складному выражению."
                                            },
                                            {
                                                "example_id": "176db902-78cc-479d-8f6b-c7d39e1f567b",
                                                "sense_id": "695060cc-a749-3a68-ae5c-647b11ae1b50",
                                                "text": "Этнокультуроведческая лексика и фразеология, отражающая жизнь, быт, искусство, обряды, обычаи и традиции русского народа."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5a0faf1-7817-36aa-bb1a-57d187e08ba9",
                                        "entry_id": "3c94a981-84c5-3452-ad99-3ffc050152a1",
                                        "glosses": [
                                            "лингв., филол. и книжн. совокупность приёмов словесного выражения, свойственных кому-либо, какому-либо времени, направлению, общественному слою и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd0cbd5d-9e04-488c-a7d9-b6308ace4712",
                                                "sense_id": "d5a0faf1-7817-36aa-bb1a-57d187e08ba9",
                                                "text": "Фразеология карамзинистов."
                                            },
                                            {
                                                "example_id": "da001ebc-0b82-4d2e-9778-bef49b29f76a",
                                                "sense_id": "d5a0faf1-7817-36aa-bb1a-57d187e08ba9",
                                                "text": "— Я, брат, — промолвил он, — завтра должен ехать; сегодня мы, уж ты извини меня, ляжем поздно. Мне хочется непременно узнать, что ты, какие твои мнения, убежденья, чем ты стал, чему жизнь тебя научила? (Михалевич придерживался ещё фразеологии тридцатых годов.)"
                                            },
                                            {
                                                "example_id": "9f552d1a-93c1-4f2b-abca-72169f803aad",
                                                "sense_id": "d5a0faf1-7817-36aa-bb1a-57d187e08ba9",
                                                "text": "Из официальной фразеологии «православие, самодержавие и народность» исчезло реальное содержание, фразеология эта стала неискренней и лживой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05bf8d85-1ecb-3673-a0e7-469bf982ad78",
                                        "entry_id": "3c94a981-84c5-3452-ad99-3ffc050152a1",
                                        "glosses": [
                                            "перен., книжн. и разг., неодобр. красивые и напыщенные выражения, фразы, скрывающие бедность или лживость содержания; набор слов, фразёрство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "604a31f3-db20-4cc5-b3fb-8866ae9bc7be",
                                                "sense_id": "05bf8d85-1ecb-3673-a0e7-469bf982ad78",
                                                "text": "Тогда [во время Карамзина] был век фразеологии, гнались за словами и мысли подбирали к словам только для смысла."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
