                    }
                ],
                "senses": [
                    {
                        "sense_id": "7dedcb37-cb4d-3cc7-a35b-383c5464c57f",
                        "entry_id": "dc103c28-62d5-3a8a-84f0-d799b2fd1822",
                        "glosses": [
                            "Leumund, (guter) Ruf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b041524b-5c22-40e9-911c-128a283482bd",
                                "sense_id": "7dedcb37-cb4d-3cc7-a35b-383c5464c57f",
                                "text": "Das Renommee mancher Führungskräfte in der Wirtschaft hat unter der Steueraffäre gelitten."
                            },
                            {
                                "example_id": "6a822990-aa75-4987-a114-b00d5137df89",
                                "sense_id": "7dedcb37-cb4d-3cc7-a35b-383c5464c57f",
                                "text": "Der Professor genießt in Wissenschaftskreisen ein ausgezeichnetes Renommee."
                            },
                            {
                                "example_id": "399b8021-7de1-4d1c-853d-acfac136a3e0",
                                "sense_id": "7dedcb37-cb4d-3cc7-a35b-383c5464c57f",
                                "text": "Ich glaube kaum, dass sie in diese Insidersache verwickelt ist, damit würde sie doch ihr hervorragendes Renommee aufs Spiel setzen, und das tut sie sicher nicht."
                            },
                            {
                                "example_id": "313c366b-d8d6-4099-b8ae-b22063410f23",
                                "sense_id": "7dedcb37-cb4d-3cc7-a35b-383c5464c57f",
                                "text": "„Der berufliche Erfolg und das rasch sich internationalisierende Renommee seines Vaters habe weitere Schulwechsel nach sich gezogen.“"
                            },
                            {
                                "example_id": "6fc9b57e-bf56-4b80-b0a5-ac26f9b9cc2e",
                                "sense_id": "7dedcb37-cb4d-3cc7-a35b-383c5464c57f",
                                "text": "„Kulmbacher Bier, wofür das Rathaus ein Renommee hatte, wurde bestellt, und Cécile war entzückt, als der Wirt die schäumenden und frisch beschlagenen Seidel brachte.“"
                            },
                            {
                                "example_id": "61ee7dbf-0f66-44bd-b607-7a8284142378",
                                "sense_id": "7dedcb37-cb4d-3cc7-a35b-383c5464c57f",
                                "text": "„So brachte er sein poetisches Renommee und die Tatsache, dass der Erlös aus seinen Büchern zu gering zum Leben und zu viel zum Sterben war, immer wieder in ein finanzielles Gleichgewicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0530554c-3c6e-4641-9afa-f6d25fe1bca4",
                        "source_entry_id": "dc103c28-62d5-3a8a-84f0-d799b2fd1822",
                        "source_sense_id": "7dedcb37-cb4d-3cc7-a35b-383c5464c57f",
                        "source_sense_description": "Leumund, (guter) Ruf",
                        "target_lang_word": "reputation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reputation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfa70ec3-89a5-3958-ada3-4b3b1c6ec046",
                                        "entry_id": "677ba6cc-1d8a-37e7-87dd-a6752e847ae7",
                                        "glosses": [
                                            "What somebody or something is known for."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d30c9bc7-e4b7-4d66-bcdb-f4b79d6e9f40",
                                                "sense_id": "dfa70ec3-89a5-3958-ada3-4b3b1c6ec046",
                                                "text": "And Balaam (or as the trueth of the hebrewe hath Bileam) doth signifie the people of no reputation\n or the vayne people or they that are not counted for people."
                                            },
                                            {
                                                "example_id": "37799a24-5d7b-408f-8f43-6da3c8600868",
                                                "sense_id": "dfa70ec3-89a5-3958-ada3-4b3b1c6ec046",
                                                "text": "Sometimes a man makes a reputation, deserved or otherwise, by a single action."
                                            },
                                            {
                                                "example_id": "b7e4e278-c361-4fc8-870b-7a14d2fc5bb0",
                                                "sense_id": "dfa70ec3-89a5-3958-ada3-4b3b1c6ec046",
                                                "text": "The reputations of our universities and our research base are already under threat because of the fallout from the EU referendum result, which is making the UK an unfriendlier place for overseas scholars and students, as well as cutting off access to an important stream of research funding and to a vibrant and well-developed ecosystem for collaborative work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
