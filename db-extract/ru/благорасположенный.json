                                        "entry_id": "fdf9d769-a7b8-3bd3-94a8-4c5c9bab3022",
                                        "glosses": [
                                            "In a favourable manner."
                                        ],
                                        "tags": [
                                            "British",
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d13ac57a-e445-4467-a5ab-1f2b93af4a7f",
                                                "sense_id": "e97c40b6-b0dc-3692-a793-d0b8fe743c5b",
                                                "text": "She looked favourably on people who gave freely their assistance."
                                            }
                                        ]
