                        "form": "rifs"
                    },
                    {
                        "form_id": "52e13404-63b1-4e83-a06c-4c3e5f79fb94",
                        "entry_id": "1179ed1b-ce31-3314-84e8-6c7151568cac",
                        "tags": [],
                        "form": "riffe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05093646-7767-3744-b65b-2221d86eb64b",
                        "entry_id": "1179ed1b-ce31-3314-84e8-6c7151568cac",
                        "glosses": [
                            "Feu."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e90811ee-be88-40b3-b067-139c20582cc4",
                                "sense_id": "05093646-7767-3744-b65b-2221d86eb64b",
                                "text": "[Ahmed] mit le rif sous un tas de bûches [dans la cheminée]."
                            }
                        ]
                    },
                    {
                        "sense_id": "4709ceb9-4738-36e8-8913-113e04c280fa",
                        "entry_id": "1179ed1b-ce31-3314-84e8-6c7151568cac",
                        "glosses": [
                            "Ligne de feu, front, combat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d5aec06-e207-4008-a52c-3258fbaa11c5",
                                "sense_id": "4709ceb9-4738-36e8-8913-113e04c280fa",
                                "text": "Monter, revenir au rif."
                            },
                            {
                                "example_id": "87eaf97b-6307-4ace-a3d8-16b119eac799",
                                "sense_id": "4709ceb9-4738-36e8-8913-113e04c280fa",
                                "text": "Ça semble dur de revenir au rif quand on s’est déjà fait amocher une fois."
                            },
                            {
                                "example_id": "e73f4054-5267-4284-88b4-e376936d26b5",
                                "sense_id": "4709ceb9-4738-36e8-8913-113e04c280fa",
                                "text": "Pour aller au jus à ma place il ferait toute une histoire, mais pour me chercher dans les barbelés en plein rif, ça ne ferait pas un pli. Un pote, quoi."
                            }
                        ]
                    },
                    {
                        "sense_id": "92a2b8c7-f5cd-372a-bf7f-dc0c7bc8daf6",
                        "entry_id": "1179ed1b-ce31-3314-84e8-6c7151568cac",
                        "glosses": [
                            "Bagarre, rififi."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "d1fdc187-3281-40ec-983d-fd67d9db9eab",
                                "sense_id": "92a2b8c7-f5cd-372a-bf7f-dc0c7bc8daf6",
                                "text": "Chercher du rif."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bfa7295-4b3a-3b42-aa02-0cb84da5b12d",
                        "entry_id": "1179ed1b-ce31-3314-84e8-6c7151568cac",
                        "glosses": [
                            "Forme masculine du mot \\\"Rive\\\", utilisée par les Rifains, venant du mot berbère \\\"Rif (ⵔⵉⴼ)\\\" ou \\\"Arif (ⴰⵔⵉⴼ)\\\", qui signifie justement \\\"la rive, la côte\\\". Le mot \\\"Rifain\\\" peut donc aussi se dire \\\"Rivain\\\"."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e4b48e1b-be0f-3323-89ec-8dfe17b152a6",
                        "entry_id": "1179ed1b-ce31-3314-84e8-6c7151568cac",
                        "glosses": [
                            "Colère."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "09d2dbb9-b79e-4c08-8297-d89c49dcc04e",
                                "sense_id": "e4b48e1b-be0f-3323-89ec-8dfe17b152a6",
                                "text": "Le rif qui me bouscule me rend téméraire, je sors de mon buisson et je me propulse là où j’ai vu bouger l’ombre."
                            },
                            {
                                "example_id": "5d7b8e82-c863-4e40-836e-4412a995fbf7",
                                "sense_id": "e4b48e1b-be0f-3323-89ec-8dfe17b152a6",
                                "text": "Elle met Paulette en rif, cette insistance."
                            }
                        ]
                    }
                ],
