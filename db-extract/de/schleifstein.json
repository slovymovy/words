                                            "To grumble."
                                        ],
                                        "tags": [
                                            "Southern-US",
                                            "UK",
                                            "US",
                                            "dialectal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56586bba-86c0-4c3e-8518-d2dde70c80e9",
                                                "sense_id": "02d5636e-a22a-3d63-8407-51bea4d301b2",
                                                "text": "Such tunges ſhuld be torne out by the harde rootes,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e0b0992-a907-38d6-94dc-f7ea7c3e6002",
                                        "entry_id": "f972db26-4c4b-37c3-a011-1d0e5d1ef6a9",
                                        "glosses": [
                                            "To pine, lament, or long."
                                        ],
                                        "tags": [
                                            "Southern-US",
                                            "UK",
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ab8de34-2c2f-4336-817d-7f88d90e0075",
                                                "sense_id": "6e0b0992-a907-38d6-94dc-f7ea7c3e6002",
                                                "text": "He lies pitying himself, honing and moaning to himself"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c87c145-2e0c-349c-b193-b0f2398b42bc",
                                        "entry_id": "7f114534-0be2-3cf5-9042-5f252a6d36d4",
                                        "glosses": [
                                            "Synonym of alas Used to express sorrow, or grief"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13c71cba-f6e7-4a48-8e24-4515560ead93",
                                                "sense_id": "3c87c145-2e0c-349c-b193-b0f2398b42bc",
                                                "text": "Oh, hone! oh, hone! miserable wretch that I am! Do ye mak confession for me, Sir, and I'll say 't after you, as weel as I dow. Oh, hone! oh, hone!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b50d71db-6840-4cee-964b-774dfa39e2c5",
                        "source_entry_id": "459cfd23-35ae-3597-9593-f56462fcf507",
                        "source_sense_id": "d0edef03-00a4-3a7d-a1e5-fff71f6bde9b",
                        "source_sense_description": "Werkzeug zum Schleifen oder Schärfen von Gegenständen",
                        "target_lang_word": "aiguisoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aiguisoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9c72d8d-8d98-38b5-af4f-5b5cc80b5494",
                                        "entry_id": "40b6fb63-8c58-3620-b50a-67b15a67ca2a",
                                        "glosses": [
                                            "Instrument servant à aiguiser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22cd790a-51a7-4c09-a2a9-4a6a90a3b33e",
                                                "sense_id": "f9c72d8d-8d98-38b5-af4f-5b5cc80b5494",
                                                "text": "Le vent le flagelle, siffle à ses oreilles avec la stridence du couteau sur l’aiguisoir."
                                            },
                                            {
                                                "example_id": "c2f8e470-c075-42a2-8c6a-544dc41ddf71",
                                                "sense_id": "f9c72d8d-8d98-38b5-af4f-5b5cc80b5494",
                                                "text": "Selon les traces de travail visibles, les objets polis se présentaient probablement sous une forme rectangulaire, la lame d'un ciseau droit par exemple. Dans ce cas, le tranchant du ciseau devait encore être affûté à l'aide d'un aiguisoir."
                                            },
                                            {
                                                "example_id": "0407aa59-38d5-48e6-8ed2-14b041862656",
                                                "sense_id": "f9c72d8d-8d98-38b5-af4f-5b5cc80b5494",
                                                "text": "Le temps de courir à la ferme, et de mettre en sûreté ses outils, sa faux, son aiguisoir, d'éponger son torse trempé de sueur, de changer de chemise et de boire un grand coup d'eau fraîche, il était près de six heures lorsqu'il arriva tout essoufflé […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db2e0576-bd11-3ac1-985d-aa672aa8335c",
                                        "entry_id": "40b6fb63-8c58-3620-b50a-67b15a67ca2a",
                                        "glosses": [
                                            "Taille-crayon."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f619e954-d5c3-4336-9f04-6e2eadf395c5",
                                                "sense_id": "db2e0576-bd11-3ac1-985d-aa672aa8335c",
                                                "text": "Aiguisoir à crayon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
