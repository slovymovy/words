                "senses": [
                    {
                        "sense_id": "c982310d-6e81-360f-8e51-14f59461ff7b",
                        "entry_id": "e8d837c6-fbd7-3425-a4bd-15ee15a177af",
                        "glosses": [
                            "Vésicule du vestibule membraneux de l’oreille interne, logée dans la fossette ronde vestibulaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b28e4233-7630-45c2-a345-69414d98b3f1",
                                "sense_id": "c982310d-6e81-360f-8e51-14f59461ff7b",
                                "text": "Le saccule communique avec l’autre vésicule (utricule) et contient une maccule qui est tapissée d’otoconie. Les deux macules permettent de percevoir les accélérations linéaires de la tête"
                            }
                        ]
                    },
                    {
                        "sense_id": "32ac6ea2-b32c-37f8-a6e6-1d9f7a071c32",
                        "entry_id": "e8d837c6-fbd7-3425-a4bd-15ee15a177af",
                        "glosses": [
                            "Cavité ou citerne aplatie d'un dictyosome de l’appareil de Golgi. De diamètre allant de 1 à 3 µm, ils sont empilés les uns sur les autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aec184ff-9d8b-4698-acab-edc09d3e11f5",
                                "sense_id": "32ac6ea2-b32c-37f8-a6e6-1d9f7a071c32",
                                "text": "Les saccules sont incurvés et présentent une polarité fonctionnelle entre la face trans (concave vers l'extérieur) et la face cis (convexe vers l'intérieur cellulaire) qui en expédie."
                            }
                        ]
                    }
