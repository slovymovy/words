                        "glosses": [
                            "Variante orthographique, parfois rencontrée, de débudgétariser (sortir du budget)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14b975fa-82c4-4270-927c-13ba2e7dc671",
                                "sense_id": "6606d831-9ffa-3d5d-8fc3-12419ce690c6",
                                "text": "Leur mode de financement est exceptionnel, dans certains cas, il revient à instaurer une parafiscalité, dans d’autres cas, à dé-budgétariser les bénéfices de la privatisation, à l’insu de tout contrôle gouvernemental ou ministériel (Hibou et Tozy, 2002)."
                            },
                            {
                                "example_id": "3d0f3ecc-b69e-4cca-aab4-aa06bfcc04fd",
                                "sense_id": "6606d831-9ffa-3d5d-8fc3-12419ce690c6",
                                "text": "Cette décision du Palais revenait à dé-budgétariser les bénéfices de la privatisation."
                            }
                        ]
                    }
