                    "sense_definition": "To give official permission or legal power to someone to do something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager will <w>authorize</w> the payment once all the receipts are submitted.",
                            "target_lang_translations": {
