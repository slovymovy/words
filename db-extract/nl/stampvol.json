                                    {
                                        "sense_id": "31830fef-a5a8-39b6-94c2-20740e74fd3d",
                                        "entry_id": "d24d7970-990a-32d6-8ed4-10c11bb478ad",
                                        "glosses": [
                                            "Abounding, amply provided."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fbd845d-c443-4adc-9202-404a5a902380",
                                                "sense_id": "31830fef-a5a8-39b6-94c2-20740e74fd3d",
                                                "text": "A kitchen replete with all the ultimate appliances."
                                            },
                                            {
                                                "example_id": "64a3bf4c-ad9b-44fc-a442-56051aaf606c",
                                                "sense_id": "31830fef-a5a8-39b6-94c2-20740e74fd3d",
                                                "text": "A peacock reign'd, whose glorious sway\nHis subjects with delight obey:\nHis tail was beauteous to behold,\nReplete with goodly eyes and gold."
                                            },
                                            {
                                                "example_id": "f4b7c9b7-0973-47e4-aae9-40613fae29ee",
                                                "sense_id": "31830fef-a5a8-39b6-94c2-20740e74fd3d",
                                                "text": "I am less unhappy than the rest, because I have a mind replete with images."
                                            },
                                            {
                                                "example_id": "22ac2137-ed6a-4933-8db1-7b84039414fc",
                                                "sense_id": "31830fef-a5a8-39b6-94c2-20740e74fd3d",
                                                "text": "\"Salisbury Cathedral, my dear Jonas, . . . is an edifice replete with venerable associations.\""
                                            },
                                            {
                                                "example_id": "1ab12981-0233-434f-88f5-92bc835f7cf8",
                                                "sense_id": "31830fef-a5a8-39b6-94c2-20740e74fd3d",
                                                "text": "History is replete with instances of great men ruled by their barbers."
                                            },
                                            {
                                                "example_id": "faafa7ac-f5a2-4655-b35f-6fb4264ac4f2",
                                                "sense_id": "31830fef-a5a8-39b6-94c2-20740e74fd3d",
                                                "text": "Liberal activists promised a well-funded summertime blitz, replete with home-state rallies and million-dollar ad campaigns, to try to ramp up pressure on a handful of Senate Democrats opposed to changing the rules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27df1a6f-4bdb-31e6-8778-977f8f7f5f96",
                                        "entry_id": "d24d7970-990a-32d6-8ed4-10c11bb478ad",
                                        "glosses": [
                                            "Gorged, filled to near the point of bursting, especially with food or drink."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5d76251-7185-482e-b3df-24e63ca18921",
                                                "sense_id": "27df1a6f-4bdb-31e6-8778-977f8f7f5f96",
                                                "text": "And what an afternoon! To lie, after this feast, on their bellies in the grass, replete like animals […]"
                                            },
                                            {
                                                "example_id": "70c361dc-030b-4ca3-8f6c-8f465d948142",
                                                "sense_id": "27df1a6f-4bdb-31e6-8778-977f8f7f5f96",
                                                "text": "In the evening, replete with deer meat, resting on his elbow and smoking his after-supper cigarette, he said[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee018c86-54ea-3c86-b804-bddb1395fec7",
                                        "entry_id": "d24d7970-990a-32d6-8ed4-10c11bb478ad",
                                        "glosses": [
                                            "Isomorphism-closed: Inheriting all the isomorphisms of C. Formally: such that for any isomorphism f in C, if f 's source is in S, then f and f 's target is also in S."
                                        ],
                                        "tags": [
                                            "of a subcategory S of C"
                                        ],
                                        "examples": []
                                    }
                                ]
