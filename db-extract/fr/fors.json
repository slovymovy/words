                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d9f2e44-33ac-3a91-9914-f27fe3898bce",
                        "entry_id": "94493d14-4eaa-345a-ac9f-a481113f577f",
                        "glosses": [
                            "Pluriel de for."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e9ea49a6-57be-452c-bbf7-b90f940c31e3",
                                "sense_id": "5d9f2e44-33ac-3a91-9914-f27fe3898bce",
                                "text": "Pourtant, dans nos fors intérieurs, la propension au doute et à la division sape notre unité."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3bdffa2f-9270-336e-ae68-7af2e6639cb3",
                "word": "fors",
                "pos": "prep",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b1349522-dc91-323a-8083-739478adb96c",
                        "entry_id": "3bdffa2f-9270-336e-ae68-7af2e6639cb3",
                        "glosses": [
                            "Excepté, hormis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa189118-6733-4873-b2d8-b614603fd96a",
                                "sense_id": "b1349522-dc91-323a-8083-739478adb96c",
                                "text": "Et de tout, fors de vous, hélas !"
                            },
                            {
                                "example_id": "45ed7897-b04f-4774-be07-31156172cd4a",
                                "sense_id": "b1349522-dc91-323a-8083-739478adb96c",
                                "text": "— Cela est, en effet, on ne peut plus fâcheux, répliqua le Pédant, mais il y a remède à tout, fors à la mort, comme dit le proverbe."
                            },
                            {
                                "example_id": "3714f742-829f-4e83-985f-93c58d87cb84",
                                "sense_id": "b1349522-dc91-323a-8083-739478adb96c",
                                "text": "Je commence à découvrir que j’ai sauvé ma peau. Tout est perdu fors la peau."
                            },
                            {
                                "example_id": "8edd8fe4-d501-45cd-8b78-a62dd25af553",
                                "sense_id": "b1349522-dc91-323a-8083-739478adb96c",
                                "text": "Les êtres du château, à l’évidence, avaient paré à toute éventualité fors Qu'un-Œil."
                            },
                            {
                                "example_id": "5573b854-6098-414e-a232-40679ed8ad72",
                                "sense_id": "b1349522-dc91-323a-8083-739478adb96c",
                                "text": "Rien n’a changé, fors le bouc émissaire."
                            },
                            {
                                "example_id": "8aaff5b4-7d22-4125-8e27-c2d9b16e8fd1",
                                "sense_id": "b1349522-dc91-323a-8083-739478adb96c",
                                "text": "– « Tout est perdu fors l’honneur », comme disait je ne sais plus trop quel trou du cul… se marra van der Merwe. Non, plus sérieusement, on va peut-être encore leur coller une ou deux raclées, mais après ? Si nos propres chefs signent vraiment un traité de paix avec eux, nos vies ne vaudront pas plus que celles de bandits de grands chemins…"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
