                        "glosses": [
                            "Celle qui a découvert une chose en question."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63e069dc-6593-4021-b283-f0ff043309e5",
                                "sense_id": "27d14f70-9b44-3ef5-b2da-f5b2206b9a01",
                                "text": "Pas facile d’être une femme de science dans un univers d’hommes : ce biopic suit la découvreuse de la radioactivité de 1904 à 1911, de son prix Nobel de physique, remporté avec son mari, qui mourut peu après, à la campagne de presse haineuse qui révéla sa liaison avec Paul Langevin et manqua lui faire rater un second Nobel — de chimie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "563cf9ab-a14c-4981-888e-e48b170a00b3",
                        "source_entry_id": "091e251e-1e6f-3210-aa2f-7bba60087f6a",
                        "source_sense_id": "27d14f70-9b44-3ef5-b2da-f5b2206b9a01",
