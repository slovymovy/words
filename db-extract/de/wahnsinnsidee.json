                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1f44058-8b93-4855-9b84-3561805c2512",
                                "sense_id": "341a0f33-7c0a-3e03-8572-d3d05e3a442d",
                                "text": "„Ich spüre manchmal so einen kleinen Wahnsinn in mir aufkommen, für andere unverständlich, für mich sauschön, und deswegen sind mir auch Wahnsinnsideen nicht fremd.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f1ce87a-6ec9-4da1-8444-53123450f858",
                        "source_entry_id": "cdcf33aa-2a61-3aaa-ba2c-34550891a33b",
                        "source_sense_id": "341a0f33-7c0a-3e03-8572-d3d05e3a442d",
                        "source_sense_description": "ganz ausgefallene, als verrückt erscheinende Idee",
                        "target_lang_word": "idée folle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idée folle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "966026c0-a091-3efe-89ff-1f759c9dd38a",
                                        "entry_id": "01a0390c-0674-3d3a-af2a-444ed3cca3ed",
                                        "glosses": [
                                            "Idée qui semble de prime abord, saugrenue & sans avenir."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20c2bfba-3a71-4853-8644-e01bef54c423",
                                                "sense_id": "966026c0-a091-3efe-89ff-1f759c9dd38a",
                                                "text": "— Quel est donc ce grand secret dont tu me parles dans ta lettre ?\n— Une idée folle, répondit Anatole, en feignant un ton dégagé, une idée folle que j'ai déjà complètement oubliée."
                                            },
                                            {
                                                "example_id": "39da6888-d55c-4808-9454-620bed65f5c7",
                                                "sense_id": "966026c0-a091-3efe-89ff-1f759c9dd38a",
                                                "text": "Dire qu'il y a des années que je caresse cette chimère, que je vis avec cette idée folle : mon journal à moi […]. Je l'ai réalisé, ce rêve impossible, je le tiens, l'oiseau bleu, entre mes doigts. Le Justicier. C'est un journal de finance."
                                            },
                                            {
                                                "example_id": "cb891db3-c295-4b83-9c89-c3027305f072",
                                                "sense_id": "966026c0-a091-3efe-89ff-1f759c9dd38a",
                                                "text": "Je t'évoquais une idée folle qui réglerait au moins quatre-vingts pour cent des problèmes de drogue, de prostitution, de violences : Cette idée folle de limiter les possibilités de règlements en espèces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
