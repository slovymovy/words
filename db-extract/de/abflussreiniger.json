                "senses": [
                    {
                        "sense_id": "fcf52cae-dda5-3d66-8b46-bf2f5eb31c27",
                        "entry_id": "803df578-cb95-3268-9e65-efe32c5b9ebf",
                        "glosses": [
                            "Substanz oder Gerät zum Reinigen von Abflüssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fce3fe29-3f80-41a5-894a-45399a2d615e",
                                "sense_id": "fcf52cae-dda5-3d66-8b46-bf2f5eb31c27",
                                "text": "„Den gerichtsmedizinischen Akten zufolge trank Cynthia Moor Abflussreiniger und starb an Blutungen der Speiseröhre und Erstickung; das war drei Monate, nachdem ihr Kind ohne erkennbare äußere Ursache gestorben war.“"
                            },
                            {
                                "example_id": "4b7fa1ce-2b44-43da-a62c-559918f72d41",
                                "sense_id": "fcf52cae-dda5-3d66-8b46-bf2f5eb31c27",
                                "text": "„In dem Moment traf ihn eine Flasche Abflussreiniger auf die Brust.“"
                            },
                            {
                                "example_id": "fb32b49e-33cd-462f-9a99-7a1704df0182",
                                "sense_id": "fcf52cae-dda5-3d66-8b46-bf2f5eb31c27",
                                "text": "„Natürlich wollte mein Dad ihm Begriffe wie Disziplin und Konsequenz nahebringen, aber ein Junge, der zweifellos mit Elektroschocks und Waterboarding gefoltert wurde und dem man flüssigen Abflussreiniger in die Adern gespritzt hatte, wird sich nicht so leicht durch die Androhung einer Tracht Prügel oder eines einstündigen Stubenarrests einschüchtern lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
