                "translations": [
                    {
                        "translation_id": "156a1bd2-4f2f-42fb-8c11-69439c54047e",
                        "source_entry_id": "e7a51471-a1ac-3cc8-bfce-8e6e1c313530",
                        "source_sense_id": "5a195394-a0e0-30fb-8a2b-4ca4c3b6314b",
                        "target_lang_word": "tombeau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tombeau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "803b7a87-c514-3876-8b64-ab09c3713a08",
                                        "entry_id": "72749387-5a60-3d82-b7e2-e1d06a10cc97",
                                        "glosses": [
                                            "Sépulcre, monument élevé à la mémoire d’un (ou plusieurs) mort(s) à l’endroit de l’enterrement."
                                        ],
                                        "tags": [
                                            "Funéraire"
                                        ],
                                        "note": "Les marbriers et professionnels des activités funéraires distinguent un tombeau, monument au-dessus du sol, d’un caveau, également destiné à recevoir le(s) corps, mais qui est creusé dans le sol et peut être couvert par une pierre tombale affleurant le sol naturel",
                                        "examples": [
                                            {
                                                "example_id": "2bf1266a-ca75-4982-82c6-8625de5cf2c8",
                                                "sense_id": "803b7a87-c514-3876-8b64-ab09c3713a08",
                                                "text": "Cette chapelle renferme le tombeau de l’évêque Radulphe, dont l’inscription donne la date de 1266, comme étant celle de la mort du prélat."
                                            },
                                            {
                                                "example_id": "54d20540-6905-4232-be18-62c0a2d60f95",
                                                "sense_id": "803b7a87-c514-3876-8b64-ab09c3713a08",
                                                "text": "L’archéologie et l’anthropologie locales sont coutumières, on le sait, d’une grande sérénité dans l’affirmation. Ledit Poignant ne s’en est pas tenu là : à une portée de fusil du tombeau de Merlin, l’« archidruide », il a retrouvé le tombeau de « son épouse » Viviane !"
                                            },
                                            {
                                                "example_id": "dd60ae38-009b-4e82-af12-0b799bc5af6b",
                                                "sense_id": "803b7a87-c514-3876-8b64-ab09c3713a08",
                                                "text": "Tous les millions que je possède je les ai mis dans un grand coffre, sous le tombeau de Charlemagne, à Aix-la-Chapelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84add793-e7dd-364a-aff7-1c225b59d2e3",
                                        "entry_id": "72749387-5a60-3d82-b7e2-e1d06a10cc97",
                                        "glosses": [
                                            "Personne à qui l’on peut confier un secret en toute sûreté, sans crainte qu’elle le trahisse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ace3b4ae-f1ab-403e-b1fb-636ae7419441",
                                                "sense_id": "84add793-e7dd-364a-aff7-1c225b59d2e3",
                                                "text": "C’est le tombeau des secrets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efe75538-f936-31a6-8a45-eed685c80612",
                                        "entry_id": "72749387-5a60-3d82-b7e2-e1d06a10cc97",
                                        "glosses": [
                                            "La mort."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "014ad0c2-6b23-432c-a062-b430b78ed517",
                                                "sense_id": "efe75538-f936-31a6-8a45-eed685c80612",
                                                "text": "Chaque moment de notre vie nous approche du tombeau."
                                            },
                                            {
                                                "example_id": "98184679-45c3-4166-96e6-99ae633b07ad",
                                                "sense_id": "efe75538-f936-31a6-8a45-eed685c80612",
                                                "text": "Je vous serai fidèle jusqu’au tombeau."
                                            },
                                            {
                                                "example_id": "9ab156ce-099d-4e35-9e04-542a684e6d2f",
                                                "sense_id": "efe75538-f936-31a6-8a45-eed685c80612",
                                                "text": "La nuit du tombeau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5da8c9a8-6443-348d-b7c7-36402e379440",
                                        "entry_id": "72749387-5a60-3d82-b7e2-e1d06a10cc97",
                                        "glosses": [
                                            "Fin, destruction."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "319dc279-52e7-4324-9b50-60c85b9c9ef8",
                                                "sense_id": "5da8c9a8-6443-348d-b7c7-36402e379440",
                                                "text": "L’anarchie est le tombeau de la liberté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57b9a54d-f358-3961-9b62-325d5bd54735",
                                        "entry_id": "72749387-5a60-3d82-b7e2-e1d06a10cc97",
                                        "glosses": [
                                            "Oraison funèbre ou recueil d’oraisons funèbres."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99ccce00-3bd2-3cb1-b343-f280f7117cc8",
                                        "entry_id": "72749387-5a60-3d82-b7e2-e1d06a10cc97",
                                        "glosses": [
                                            "Ensemble de pièces en l’honneur d’un compositeur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
