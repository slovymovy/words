                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aerolith",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6df94b4a-47a2-30cf-911e-b752a7b90aef",
                                        "entry_id": "afbd83ac-3d52-342b-a15e-ffa93d8a4612",
                                        "glosses": [
                                            "A meteorite."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c7294ad-c1ba-4d3f-bdcf-eadc548cae0b",
                                                "sense_id": "6df94b4a-47a2-30cf-911e-b752a7b90aef",
                                                "text": "And what about the great aerolith at Paphos which they are supposed to have worshipped under the name of Bahomet?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9001239-2c06-4db0-9503-36ac291a5708",
                        "source_entry_id": "1cb82e7f-b1cb-3f5a-8397-613ddac80f42",
                        "source_sense_id": "5af10e65-40c0-38c5-a2e6-64cbc8c1120b",
                        "target_lang_word": "aerolite",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aerolite",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "865a8651-6e2d-3e06-991c-7ad40f7086b5",
                                        "entry_id": "94cb49a8-1dd3-3832-9388-b6341f0e11a3",
                                        "glosses": [
                                            "tipo di meteorite, pietroso e ricco di silicati"
                                        ],
                                        "tags": [
                                            "geofisica"
                                        ],
