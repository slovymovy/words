                "senses": [
                    {
                        "sense_id": "696dd56f-5bde-36d3-83fe-3e046267018c",
                        "entry_id": "8741474e-f099-3b2e-b373-d786ee32d9d6",
                        "glosses": [
                            "absichtlich herbeigeführte Verwirrung, um andere zu verunsichern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "134148d3-e389-4a1a-afa6-61e585bfde42",
                                "sense_id": "696dd56f-5bde-36d3-83fe-3e046267018c",
                                "text": "Pastor Terry Jones aus Florida hat seine geplante Koranverbrennung in ein absonderliches Verwirrspiel verwandelt."
                            },
                            {
                                "example_id": "135bd34b-e275-4a76-a368-7d2fbcff7b97",
                                "sense_id": "696dd56f-5bde-36d3-83fe-3e046267018c",
                                "text": "Ein pragmatisch praktischer Umgang mit winterlichen Niederschlagserscheinungen wäre ohnehin oft ökologisch wie ökonomisch sinnvoller als das bürokratische Verwirrspiel."
                            },
                            {
                                "example_id": "fd0da01f-1967-4f01-b8c1-26e966e615c9",
                                "sense_id": "696dd56f-5bde-36d3-83fe-3e046267018c",
                                "text": "Frühere Fälle von inhaftierten Ausländern zeigen, dass Undurchsichtigkeit und Verwirrspiele zwischen den verschiedenen Institutionen der Islamischen Republik Iran bei derartigen Manövern Methode haben."
                            },
                            {
                                "example_id": "e6876ea1-f433-45b4-84c0-ffa781245aaa",
                                "sense_id": "696dd56f-5bde-36d3-83fe-3e046267018c",
                                "text": "Ein Verwirrspiel gab es am Wochenende um Wagners erste Predigt nach der Bischofs-Ernennung in Windischgarsten."
                            },
                            {
                                "example_id": "ce79b7a8-c7b0-43df-9fc4-5e77cce56230",
                                "sense_id": "696dd56f-5bde-36d3-83fe-3e046267018c",
                                "text": "Der Fall Kaspar Hauser: Er sorgte für das größte Verwirrspiel der neueren Geschichte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3215517f-8704-408a-9943-8aba2274ba85",
                        "source_entry_id": "8741474e-f099-3b2e-b373-d786ee32d9d6",
                        "source_sense_id": "696dd56f-5bde-36d3-83fe-3e046267018c",
                        "source_sense_description": "absichtlich herbeigeführte Verwirrung, um andere zu verunsichern",
                        "target_lang_word": "confusion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confusion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94912499-d8eb-37d4-92db-28b8ed9aa089",
                                        "entry_id": "9b26ad93-2d89-307d-b58e-d7cbaea2a4b9",
                                        "glosses": [
                                            "A lack of clarity or order."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43b0b830-9702-44dd-a122-710952795b10",
                                                "sense_id": "94912499-d8eb-37d4-92db-28b8ed9aa089",
                                                "text": "But much of the federal workforce is located outside the nation’s capital, and Trump’s offer was met with confusion and skepticism in many of those offices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08c81f51-1586-3637-8d16-22cd7bbcd9a0",
                                        "entry_id": "9b26ad93-2d89-307d-b58e-d7cbaea2a4b9",
                                        "glosses": [
                                            "The state of being confused; misunderstanding."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9e4e5ac-78c3-4a0b-b5aa-a4e000d88d29",
                                                "sense_id": "08c81f51-1586-3637-8d16-22cd7bbcd9a0",
                                                "text": "Forgive these wild and wandering cries,\n⁠Confusions of a wasted youth;\n⁠Forgive them where they fail in truth,\nAnd in thy wisdom make me wise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fec1f16-64f1-394e-b0e8-c11c299e7633",
                                        "entry_id": "9b26ad93-2d89-307d-b58e-d7cbaea2a4b9",
                                        "glosses": [
                                            "The act of mistaking one thing for another or conflating distinct things."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ae9326d-5123-41ed-a443-53c1e696963d",
                                                "sense_id": "1fec1f16-64f1-394e-b0e8-c11c299e7633",
                                                "text": "The confusion of sexual orientation and gender identity leads to discrimination and stereotyping."
                                            },
                                            {
                                                "example_id": "f1a2f613-e72d-41a9-8136-66478a205fb7",
                                                "sense_id": "1fec1f16-64f1-394e-b0e8-c11c299e7633",
                                                "text": "Now (exc. in Nautical language, see b) it is only dialectal or an illiterate substitute for lie, its identity of form with the past tense of the latter no doubt accounting largely for the confusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6054115f-a3e7-3da4-8908-85c327edd99a",
                                        "entry_id": "9b26ad93-2d89-307d-b58e-d7cbaea2a4b9",
                                        "glosses": [
                                            "Lack of understanding due to dementia."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c6e0121-b58a-3072-8ad8-d9df3fae314a",
                                        "entry_id": "9b26ad93-2d89-307d-b58e-d7cbaea2a4b9",
                                        "glosses": [
                                            "A state of shame or embarrassment."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46c8f823-153c-4a6e-8b6c-6a8a32804b62",
                                                "sense_id": "1c6e0121-b58a-3072-8ad8-d9df3fae314a",
                                                "text": "Lady Bellaston fixed her eyes on Sophia whilst she spoke these words. To which that poor young lady, having her face overspread with blushes and confusion, answered, in a stammering voice […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f68a422-182b-346e-b143-3df1b4bead8f",
                                        "entry_id": "9b26ad93-2d89-307d-b58e-d7cbaea2a4b9",
                                        "glosses": [
                                            "A group of wildebeest."
                                        ],
                                        "tags": [
                                            "collective",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0c4ed34-37fe-44b9-b7c6-6029ec32b4f9",
                                                "sense_id": "0f68a422-182b-346e-b143-3df1b4bead8f",
                                                "text": "A group of wildebeest is called a confusion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cef98ec9-66ab-4793-b8d6-a168828fd86a",
