                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dealer laid out a <w>rainbow</w>, making a flush impossible on the turn.",
                            "target_lang_translations": {
                                "ru": "Дилер выложил <w>радугу</w>, сделав флеш невозможным на тёрне.",
