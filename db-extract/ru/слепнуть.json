                        "examples": [
                            {
                                "example_id": "1b503a01-c1ef-4ac1-b796-ee9f15c57db0",
                                "sense_id": "4cc7a7fe-e3c1-3475-9ed5-822e5ac6f24a",
                                "text": "Мне запретили надевать тёмные очки, а ты сидел в поло \"Лакост\" и плевал на то, что я слепла."
                            }
                        ]
                    },
                    {
