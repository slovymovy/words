                "senses": [
                    {
                        "sense_id": "f52df328-48a2-384c-9009-6cf495324544",
                        "entry_id": "a354f6f4-951c-390d-8b0d-c47f2d605d58",
                        "glosses": [
                            "Anteil an elastischen Materialien in einem Stoff, Gewebe oder in einer Ware"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0feb2044-1ec4-4e04-846d-7d91ad4b7960",
                                "sense_id": "f52df328-48a2-384c-9009-6cf495324544",
                                "text": "„Sommerliche 9/10-Jeans aus supersoftem Baumwoll-Mix Knit-Denim mit hohem Stretchanteil.“"
                            },
                            {
                                "example_id": "51431783-a835-4051-8d7c-0eacf1489d36",
                                "sense_id": "f52df328-48a2-384c-9009-6cf495324544",
                                "text": "„Der hohe Stretchanteil schenkt Ihnen ein hohes Maß an Bewegungsfreiheit und Tragekomfort.“"
                            },
                            {
                                "example_id": "a507e955-95b0-48be-8c44-7c72c974c827",
                                "sense_id": "f52df328-48a2-384c-9009-6cf495324544",
                                "text": "„Ausgefallene Used-Jeans mit Five-Pocket-Style aus angenehmen Baumwolldenim mit Stretchanteil - AT14405.“"
                            },
                            {
                                "example_id": "9aa9de25-1851-4d2d-ae18-e2f22eda69ec",
                                "sense_id": "f52df328-48a2-384c-9009-6cf495324544",
                                "text": "„Rücken und Ärmel aus softem Single-Jersey mit Stretchanteil garantieren ein komfortables Tragegefühl.“"
                            },
                            {
                                "example_id": "af8291f0-4eeb-447e-967e-8af65faf199e",
                                "sense_id": "f52df328-48a2-384c-9009-6cf495324544",
                                "text": "„Schönes Shirt aus weich fließender Jerseyqualität mit komfortablem Stretchanteil und raffiniertem Allover-Print. Artikeldetails“"
                            },
                            {
                                "example_id": "f287fde0-996a-46e7-b86f-b6b4f3d0754d",
                                "sense_id": "f52df328-48a2-384c-9009-6cf495324544",
                                "text": "„Kofferband mit hohem Stretchanteil für maximalen Tragekomfort und perfekten Sitz“"
                            },
                            {
                                "example_id": "179db62e-f762-4a9d-a43f-160d3cf727e7",
                                "sense_id": "f52df328-48a2-384c-9009-6cf495324544",
                                "text": "„Unverzichtbares Rollkragen-Shirt aus weich fließender Viskose-Jerseyqualität mit komfortablem Stretchanteil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
