                ],
                "senses": [
                    {
                        "sense_id": "62c82691-e64b-33aa-88fe-9a8767fc9997",
                        "entry_id": "33307372-70cc-3734-a61f-02358ac1a66c",
                        "glosses": [
                            "sehr gut passende Lösung für ein Problem/für einen Erfolg/um ein Ziel zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec4bc5d7-36cb-430b-b8a2-779858802922",
                                "sense_id": "62c82691-e64b-33aa-88fe-9a8767fc9997",
                                "text": "„Es gibt kein Patentrezept zum Verfassen von Werbesprüchen.“"
                            },
                            {
                                "example_id": "40142251-5f50-4a99-9f26-b9581988cd5c",
                                "sense_id": "62c82691-e64b-33aa-88fe-9a8767fc9997",
                                "text": "„Es gibt kein Patentrezept, nur persönliche Lernprozesse, Erfolge und Misserfolge.“"
                            },
                            {
                                "example_id": "f4adb43e-4a89-40fc-8168-cf9a3d34aa22",
                                "sense_id": "62c82691-e64b-33aa-88fe-9a8767fc9997",
                                "text": "„»Ich wünschte, es gäbe ein Patentrezept.«“"
                            },
                            {
                                "example_id": "37424cb5-5107-447d-93c0-7d348a40927c",
                                "sense_id": "62c82691-e64b-33aa-88fe-9a8767fc9997",
                                "text": "[Schlagzeile:] „Patentrezepte gegen die AfD“"
                            },
                            {
                                "example_id": "c17e4eb2-51b5-417b-8de4-e01fc49e3176",
                                "sense_id": "62c82691-e64b-33aa-88fe-9a8767fc9997",
                                "text": "Es gibt keine Patentrezepte gegen Korruption."
                            },
                            {
                                "example_id": "315241bd-fe73-4115-b5db-de81c24e4769",
                                "sense_id": "62c82691-e64b-33aa-88fe-9a8767fc9997",
                                "text": "Das Patentrezept für einen erfolgreichen Film wurde noch nicht erfunden."
                            },
                            {
                                "example_id": "ed6242cd-c9ae-4e9e-8ce1-275a1057c7b8",
                                "sense_id": "62c82691-e64b-33aa-88fe-9a8767fc9997",
                                "text": "„Patentrezepte gegen den Schluckauf gibt es keine, aber ganz viele Hausmittel, die einen Versuch wert sind.“"
                            },
                            {
                                "example_id": "ac386d06-3ea8-49a1-91b3-5bb3ceda89b4",
                                "sense_id": "62c82691-e64b-33aa-88fe-9a8767fc9997",
                                "text": "„Die meisten Zeitungsmacher fahnden noch immer nach dem Patentrezept, wie sich im Internet mit Geschichten Geld verdienen lässt.“"
                            },
                            {
                                "example_id": "9296566e-9f3a-4e4c-80f0-3017289eefd9",
                                "sense_id": "62c82691-e64b-33aa-88fe-9a8767fc9997",
                                "text": "„Seit der Finanzkrise vor rund 15 Jahren haben die Notenbanken dieser Welt ein Patentrezept, die Wirtschaft am Laufen zu halten: Sie machen das Geld so billig wie es nur geht.“"
                            },
                            {
                                "example_id": "50fb1cd0-079a-4f65-b288-97e1c8a911ce",
                                "sense_id": "62c82691-e64b-33aa-88fe-9a8767fc9997",
                                "text": "„Ein Patentrezept für gesunde Füße gibt es nicht. Viele Studien beweisen allerdings, dass Bewegungsmangel und zu enge Schuhe die natürliche Fußentwicklung behindern.“"
                            },
                            {
                                "example_id": "0cbc6c8f-c2c8-489a-936d-0ac0f8f0f1f6",
                                "sense_id": "62c82691-e64b-33aa-88fe-9a8767fc9997",
                                "text": "„»Es gibt kein Patentrezept zur Lösung des Klimaproblems, aber die Ursache ist klar: die fossilen Brennstoffe«, betont Nikki Reich, Direktorin des Energie- und Klimaprogramms am Zentrum für Internationales Umweltrecht (CIEL) in Washington D.C..“"
                            },
                            {
                                "example_id": "628a7852-7743-4b8c-8957-1d192aa5efd0",
                                "sense_id": "62c82691-e64b-33aa-88fe-9a8767fc9997",
                                "text": "„Ein allgemeingültiges Patentrezept, um Menschen vor Umweltgefahren in Sicherheit zu bringen, gibt es nicht. Zu unterschiedlich sind die möglichen Wetterextreme, zu verschieden die persönlichen Umstände, die berücksichtigt werden müssen.“"
                            },
                            {
                                "example_id": "addad618-d470-4855-8c40-beeecf033e2b",
                                "sense_id": "62c82691-e64b-33aa-88fe-9a8767fc9997",
                                "text": "„Chapmans Patentrezept [Anmerkung: für eine Giftspritze für zum Tode Verurteilte] wurde in Oklahoma zum Gesetz. Texas kupferte es umgehend ab und weitere 35 Bundesstaaten schlossen sich an.“"
                            },
                            {
                                "example_id": "00ba3745-58fb-4674-b432-7e2ce59c932c",
                                "sense_id": "62c82691-e64b-33aa-88fe-9a8767fc9997",
                                "text": "„Ob Hitzewelle oder normaler Sommer, das ist uns in Bayern wurscht. Wir haben da ein einmaliges Patentrezept. Erst in den Gebirgssee und von außen abkühlen und dann in den Biergarten um von innen abzukühlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
