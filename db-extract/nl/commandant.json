                "senses": [
                    {
                        "sense_id": "af70ac4c-11d0-3512-b8bf-d3659e3da428",
                        "entry_id": "3cec1207-c5a7-3692-bf45-c646248ec514",
                        "glosses": [
                            "iemand die commandeert (het commando heeft over een leger of vloot)"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "38b30aba-43a4-460f-b174-3b208a5388fd",
                                "sense_id": "af70ac4c-11d0-3512-b8bf-d3659e3da428",
                                "text": "De commandant gaf het sein om de aanval te beginnen."
                            },
                            {
                                "example_id": "e8949fcf-f025-4494-8d9b-2727fe801bae",
                                "sense_id": "af70ac4c-11d0-3512-b8bf-d3659e3da428",
                                "text": "Omdat ze een vrij klassiek beeld had van de oorlog was ze er snel van overtuigd dat Albert 'met zijn intelligentie' na korte tijd zou uitblinken, promotie zou maken en ze zag hem al in de voorste linie in de aanval gaan. Ze stelde zich voor dat hij een heldendaad verrichtte, meteen officier werd, kapitein, commandant of meer nog, generaal, die dingen gebeuren tijdens de oorlog."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8525f1e-e2ba-391f-adef-5ace36f16c7b",
                        "entry_id": "3cec1207-c5a7-3692-bf45-c646248ec514",
                        "glosses": [
                            "iemand die de leider is van een groep politieagenten of brandweerlieden"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "05b88f0f-74d2-4c42-99d8-b9286b49fb15",
                                "sense_id": "a8525f1e-e2ba-391f-adef-5ace36f16c7b",
                                "text": "De commandant gaf het sein brand meester!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
