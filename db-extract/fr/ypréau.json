                "senses": [
                    {
                        "sense_id": "121c65ea-9517-3728-96f3-a00c11cd8f54",
                        "entry_id": "e9f82652-2b48-3bb6-befd-9e3a12b6d75a",
                        "glosses": [
                            "ou régional Nom vernaculaire du peuplier blanc ou du peuplier gris de l’Oise ou peuplier grisard (Populus ×canescens)."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1862cc27-6481-4281-95e9-27ff3fc56ce4",
                                "sense_id": "121c65ea-9517-3728-96f3-a00c11cd8f54",
                                "text": "Les beaux ifs langoureux, et l’ypréau qui s’attriste\nOmbrageaient les verts nids d’amour."
                            },
                            {
                                "example_id": "dfb8eb26-2ba6-4617-97fe-508b9a2fa090",
                                "sense_id": "121c65ea-9517-3728-96f3-a00c11cd8f54",
                                "text": "La grosse chaleur tombe, dit-il, les bêtes recommencent à bouger. Vous voyez la sittelle bleue, là-bas sur l’ypréau ? En tout cas, elle, elle nous a vus, vous et moi. Elle nous admet. Regardez-là virevolter, tête en bas, pour sa joie et pour la nôtre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "403abe55-8444-4f16-95fe-2e26a34f3e9e",
                        "source_entry_id": "e9f82652-2b48-3bb6-befd-9e3a12b6d75a",
                        "source_sense_id": "121c65ea-9517-3728-96f3-a00c11cd8f54",
                        "target_lang_word": "Silberpappel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Silberpappel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb8a1b91-265e-3227-bc5f-2c66aa47761c",
                                        "entry_id": "fcf65995-0781-334a-8a2d-bb1ed2d14803",
                                        "glosses": [
                                            "Art der Pappel (Populus alba) mit unterseits weißlichen bis schneeweißen, filzigen Blättern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bc7ede5-a3cb-495c-9f16-0770788ae033",
                                                "sense_id": "cb8a1b91-265e-3227-bc5f-2c66aa47761c",
                                                "text": "Silberpappeln haben silbrig glänzende Blätter."
                                            },
                                            {
                                                "example_id": "e84d52a6-5bf2-4dde-92cb-7488d02648d6",
                                                "sense_id": "cb8a1b91-265e-3227-bc5f-2c66aa47761c",
                                                "text": "„Lene hatte ſich in Botho’s Arm gehängt und ſchritt mit ihm auf das Ende des Gartens zu, wo, zwiſchen zwei Silberpappeln, eine Bank ſtand.“"
                                            },
                                            {
                                                "example_id": "c046c0b2-048d-40a3-853c-4c39e03776ce",
                                                "sense_id": "cb8a1b91-265e-3227-bc5f-2c66aa47761c",
                                                "text": "„Die nämliche Zerlegung und Zusammensetzung der Silben – eine wahre Silbenchemie – dient uns im Wachen zu mannigfachen Scherzen. ‚Wie gewinnt man auf die billigste Art Silber? Man begibt sich in eine Allee, in der Silberpappeln stehen, gebietet Schweigen, dann hört das ‚Pappeln‘ (Schwätzen) auf, und das Silber wird frei.‘“"
                                            },
                                            {
                                                "example_id": "2a86ebd2-4e2e-45b2-8c63-5f5fc4eb08fc",
                                                "sense_id": "cb8a1b91-265e-3227-bc5f-2c66aa47761c",
                                                "text": "„Unter einer Silberpappel, am Rande des mittlerweile verlassenen Stadions, steht ein Mann mit einem Taschentuch in der Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4902c68e-99bf-4091-8ccc-6413edd0bc87",
                        "source_entry_id": "e9f82652-2b48-3bb6-befd-9e3a12b6d75a",
