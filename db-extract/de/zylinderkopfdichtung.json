                        "entry_id": "9d51c30f-24d6-334c-8ab4-b38d206044fd",
                        "glosses": [
                            "Dichtung in einem Verbrennungsmotor oder Hubkolbenverdichter, die zwischen Kurbelgehäuse und Zylinderkopf eingebaut ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0606690-71fd-493f-bbdc-c38147bd1937",
                                "sense_id": "e7eb1c99-3a5f-3735-aa8e-866a60ed49f3",
                                "text": "Besondere Vorsicht ist geboten, wenn die Diagnose auf einen Defekt der Zylinderkopfdichtung lautet."
                            }
