                                "example_id": "0ac8f088-c187-42be-b434-734e84d38737",
                                "sense_id": "7ad120b5-467c-3897-8b88-f233612bef04",
                                "text": "Am Wochenende sind wir zum Wandern in die Vogesen gefahren."
                            },
                            {
