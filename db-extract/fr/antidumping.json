                                        "entry_id": "246e4285-686c-311a-808e-225b1e7e1468",
                                        "glosses": [
                                            "Intended to combat or prevent dumping, the sale of goods below cost for anticompetitive purposes"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a66c9ceb-a6dc-48c2-85a8-8af35f8b77eb",
                                                "sense_id": "77c898bd-da5c-3410-bedd-604a6defe5c5",
                                                "text": "Instead, it relied on antidumping actions to combat what it said were unfair Chinese trade practices."
                                            }
