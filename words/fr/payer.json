    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1dcd08f-cee0-3644-a4bd-f87ba78e2209",
                    "sense_definition": "Donner de l'argent en contrepartie d'un bien acheté, d'un service rendu ou d'un travail effectué.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous pouvez <w>payer</w> par carte bancaire ou en espèces à la caisse du magasin."
                        },
                        {
                            "text": "Mon entreprise me <w>paie</w> à la fin de chaque mois par virement."
                        }
                    ],
                    "synonyms": [
                        "banquer",
                        "casquer",
                        "raquer"
                    ],
                    "common_phrases": [
                        "payer par carte",
                        "payer en espèces",
                        "payer la facture"
                    ]
                },
                {
                    "sense_id": "00d7c8a6-32b8-3c28-88b4-8952997496dd",
                    "sense_definition": "Offrir généreusement une consommation, un repas ou une sortie à quelqu'un en prenant en charge les frais.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour fêter ma promotion, je vous <w>paie</w> un verre au café d'en face."
                        },
                        {
                            "text": "Ce soir, c'est mon tour de <w>payer</w> le restaurant à tout le monde."
                        }
                    ],
                    "common_phrases": [
                        "payer un verre",
                        "payer une tournée",
                        "payer le restaurant"
                    ]
                },
                {
                    "sense_id": "2ad18d82-f1c1-3498-9b38-98ba7c43aafc",
                    "sense_definition": "Produire un résultat avantageux, se révéler fructueux ou rentable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout ce travail acharné a fini par <w>payer</w> lors des examens finaux."
                        },
                        {
                            "text": "La patience <w>paie</w> toujours lorsqu'on entreprend un projet ambitieux."
                        }
                    ],
                    "common_phrases": [
                        "finir par payer",
                        "efforts qui paient"
                    ]
                },
                {
                    "sense_id": "f7e50df3-c8e6-3911-af3a-0f64ffbf4e16",
                    "sense_definition": "Subir les conséquences fâcheuses d'une mauvaise action ou d'une faute commise.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il devra <w>payer</w> pour ses erreurs devant le tribunal dès demain matin."
                        },
                        {
                            "text": "Si tu continues à mentir ainsi, tu vas le <w>payer</w> très cher un jour."
                        }
                    ],
                    "common_phrases": [
                        "payer pour ses erreurs",
                        "payer le prix fort"
                    ]
                },
                {
                    "sense_id": "6eef5a80-b2d8-3f15-a2e0-d885901c1efb",
                    "sense_definition": "Acquérir ou obtenir quelque chose au prix d'un sacrifice douloureux ou d'une perte grave.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le courageux soldat a <w>payé</w> de sa vie la défense de la liberté de son pays."
                        },
                        {
                            "text": "Pour réussir ce projet difficile, elle a dû <w>payer</w> de sa personne sans compter ses heures."
                        }
                    ],
                    "common_phrases": [
                        "payer de sa vie",
                        "payer de sa personne"
                    ]
                }
            ]
        }
    ]
