                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66bc9da5-1e6e-4508-9108-de855640902d",
                                "sense_id": "358d1145-ad7e-30bf-8d8b-3d27ae72da7b",
                                "text": "Nederland is een kaasland. We eten ruim 17 kilo kaas per jaar, maar dit betekent nog niet dat we veel weten over kaas. Een enquête in opdracht van een groot kaasmerk laat zien dat we de benaming 'kaaskop' weinig eer aandoen."
                            },
                            {
                                "example_id": "28dbce98-8077-49b0-8a30-aa443f779283",
                                "sense_id": "358d1145-ad7e-30bf-8d8b-3d27ae72da7b",
                                "text": "Nederland is een kaasland. We worden natuurlijk niet voor niets kaaskoppen genoemd. Om meer te weten te komen over dit hartige hapje, is een bezoekje aan Gouda een aanrader."
                            }
                        ]
                    }
