                        "source_sense_id": "a86364ed-6052-3006-803c-f32dceeaa102",
                        "target_lang_word": "Teilnehmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teilnehmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a825dc0-dfc7-36cc-9370-684355ae05b6",
                                        "entry_id": "2b1bd2ea-f4b8-36b6-83c0-44926828db5b",
                                        "glosses": [
                                            "Person oder Gruppe, die an einem Ereignis oder einer Veranstaltung beteiligt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3788fea1-d632-4e8c-a502-58b73cb883f6",
                                                "sense_id": "4a825dc0-dfc7-36cc-9370-684355ae05b6",
                                                "text": "Als Teilnehmer kommen alle in Frage, die das erste Semester mit Erfolg bestanden haben."
                                            },
                                            {
                                                "example_id": "21b1c2eb-24a2-41ca-9690-44bae2c75c98",
                                                "sense_id": "4a825dc0-dfc7-36cc-9370-684355ae05b6",
                                                "text": "Die Teilnehmer an der Tagung müssen einen Tagungsbeitrag leisten."
                                            },
                                            {
                                                "example_id": "dde23dcc-2219-4e82-9e0a-b671289b2724",
                                                "sense_id": "4a825dc0-dfc7-36cc-9370-684355ae05b6",
                                                "text": "„Alle zwölf Teilnehmer wussten von mindestens einem Fall von Gewalt in der Familie.“"
                                            },
                                            {
                                                "example_id": "184f3343-0c63-47d2-8e55-220e9181605e",
                                                "sense_id": "4a825dc0-dfc7-36cc-9370-684355ae05b6",
                                                "text": "„Die Teilnehmer setzten sich aus Männern und Matronen der älteren Behördenschaft zusammen, die mehr oder weniger maßgebliche Funktionen als Büroreferenten, Sachbearbeiter, Protokollführer und dergleichen ausübten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "898f1224-ed41-3af2-8707-135c52e980af",
                                        "entry_id": "2b1bd2ea-f4b8-36b6-83c0-44926828db5b",
                                        "glosses": [
                                            "Oberbegriff für Anstifter und Gehilfen"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e17fdf5-fa02-4461-86b7-a0bb4c5a39cf",
                                                "sense_id": "898f1224-ed41-3af2-8707-135c52e980af",
                                                "text": "Teilnehmer erfüllen den Tatbestand des in Frage stehenden Delikts im Gegensatz zum Täter nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
