{
    "word_family": [
        "slammer",
        "slammed",
        "slamming",
        "slambook",
        "grand slam"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8cba6163-1ef8-3023-a5ca-f62a2a73f2f3",
                    "sense_definition": "To shut with sudden force so as to produce a shock and noise.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "forceful_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not <w>slam</w> the door when you leave the house.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>хлопайте</w> дверью, когда выходите из дома."
                            }
                        },
                        {
                            "text": "The wind was so strong that it caused the window to <w>slam</w> shut.",
                            "target_lang_translations": {
                                "ru": "Ветер был таким сильным, что окно <w>захлопнулось</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bang"
                    ],
                    "common_phrases": [
                        "slam shut",
                        "slam the door"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закрывать что-либо с резкой силой, производя удар и шум."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлопать",
                                "target_lang_sense_clarification": "дверью, окном"
                            },
                            {
                                "target_lang_word": "захлопывать",
                                "target_lang_sense_clarification": "с силой закрывать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9816dd5a-0236-3a76-bd26-5caba5dc5885",
                    "sense_definition": "To put in or on a particular place with force and loud noise.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "forceful_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was so angry that he <w>slammed</w> his books down on the table.",
                            "target_lang_translations": {
                                "ru": "Он был так зол, что с силой <w>швырнул</w> книги на стол."
                            }
                        },
                        {
                            "text": "The officer was criticized for <w>slamming</w> the suspect against the wall.",
                            "target_lang_translations": {
                                "ru": "Офицера раскритиковали за то, что он с силой <w>прижал</w> подозреваемого к стене."
                            }
                        }
                    ],
                    "synonyms": [
                        "bang",
                        "bash"
                    ],
                    "common_phrases": [
                        "slam down",
                        "slam against"
                    ],
                    "target_lang_definitions": {
                        "ru": "Класть или бросать что-либо в определенное место с силой и громким шумом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "швырять",
                                "target_lang_sense_clarification": "бросать с силой"
                            },
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "с грохотом"
                            },
                            {
                                "target_lang_word": "прикладывать",
                                "target_lang_sense_clarification": "с силой к поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8c05013-3331-3be8-8723-7fcf3db8614d",
                    "sense_definition": "To strike against something suddenly and heavily.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car lost control and <w>slammed</w> into a stationary vehicle.",
                            "target_lang_translations": {
                                "ru": "Водитель потерял управление, и машина <w>врезалась</w> в стоящий автомобиль."
                            }
                        },
                        {
                            "text": "Huge waves <w>slammed</w> into the bank during the storm.",
                            "target_lang_translations": {
                                "ru": "Огромные волны с силой <w>бились</w> о берег во время шторма."
                            }
                        }
                    ],
                    "synonyms": [
                        "crash",
                        "smash"
                    ],
                    "common_phrases": [
                        "slam into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Врезаться во что-либо внезапно и с большой силой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "врезаться",
                                "target_lang_sense_clarification": "на большой скорости"
                            },
                            {
                                "target_lang_word": "влететь",
                                "target_lang_sense_clarification": "столкнуться с силой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61d48f20-905f-3bbe-9cd1-be5c037a0c9a",
                    "sense_definition": "To speak badly of or to criticize someone or something forcefully.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Movie critics <w>slammed</w> the new film for being violent and meaningless.",
                            "target_lang_translations": {
                                "ru": "Кинокритики <w>разнесли</w> новый фильм за жестокость и бессмысленность."
                            }
                        },
                        {
                            "text": "The opposition party <w>slammed</w> the government's new economic policy.",
                            "target_lang_translations": {
                                "ru": "Оппозиционная партия резко <w>раскритиковала</w> новую экономическую политику правительства."
                            }
                        }
                    ],
                    "synonyms": [
                        "criticize",
                        "blast",
                        "bash",
                        "lambaste",
                        "savage"
                    ],
                    "antonyms": [
                        "support",
                        "back"
                    ],
                    "common_phrases": [
                        "publicly slam"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in journalism and informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко критиковать или плохо отзываться о ком-либо или чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разносить",
                                "target_lang_sense_clarification": "подвергать уничтожающей критике"
                            },
                            {
                                "target_lang_word": "критиковать",
                                "target_lang_sense_clarification": "жестко"
                            },
                            {
                                "target_lang_word": "громить",
                                "target_lang_sense_clarification": "в прессе или речи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7708a48f-b83a-37db-a392-1a02085674cb",
                    "sense_definition": "To defeat or overcome an opponent decisively in a match or competition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local football team <w>slammed</w> their rivals with a six-zero victory.",
                            "target_lang_translations": {
                                "ru": "Местная футбольная команда <w>разгромила</w> своих соперников со счетом 6:0."
                            }
                        },
                        {
                            "text": "They managed to <w>slam</w> the defending champions in the final round.",
                            "target_lang_translations": {
                                "ru": "Им удалось <w>одолеть</w> действующих чемпионов в финальном раунде."
                            }
                        }
                    ],
                    "synonyms": [
                        "crush",
                        "trounce"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in sports headlines"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Решительно победить или одолеть противника в матче или соревновании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгромить",
                                "target_lang_sense_clarification": "одержать крупную победу"
                            },
                            {
                                "target_lang_word": "разделать",
                                "target_lang_sense_clarification": "легко победить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "369d2a35-b63b-380e-9085-0648fd9da004",
                    "sense_definition": "To occupy and busy someone with a very high workload.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "workload",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry I cannot help you right now, I am completely <w>slammed</w> with work.",
                            "target_lang_translations": {
                                "ru": "Извини, я не могу помочь тебе прямо сейчас, я полностью <w>завален</w> работой."
                            }
                        },
                        {
                            "text": "The tax season always <w>slams</w> the accounting department every year.",
                            "target_lang_translations": {
                                "ru": "Налоговый сезон каждый год <w>заваливает</w> бухгалтерию работой."
                            }
                        }
                    ],
                    "synonyms": [
                        "overwhelm",
                        "swamp"
                    ],
                    "common_phrases": [
                        "get slammed",
                        "completely slammed"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in business and office environments"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Загружать кого-либо очень большим объемом работы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заваливать",
                                "target_lang_sense_clarification": "работой или делами"
                            },
                            {
                                "target_lang_word": "загружать",
                                "target_lang_sense_clarification": "сверх меры"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "814a1cff-a763-34a2-92e0-0f86e2463be4",
                    "sense_definition": "The shock and noise produced by violently closing a door or other object.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud <w>slam</w> of the front door woke up the entire family.",
                            "target_lang_translations": {
                                "ru": "Громкий <w>хлопок</w> входной двери разбудил всю семью."
                            }
                        },
                        {
                            "text": "She left the room in a hurry, followed by a heavy <w>slam</w>.",
                            "target_lang_translations": {
                                "ru": "Она в спешке вышла из комнаты, после чего раздался тяжелый <w>стук</w> захлопнувшейся двери."
                            }
                        }
                    ],
                    "synonyms": [
                        "bang",
                        "thud"
                    ],
                    "common_phrases": [
                        "loud slam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удар и шум, возникающие при резком закрытии двери или другого предмета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлопанье",
                                "target_lang_sense_clarification": "звук закрывающейся двери"
                            },
                            {
                                "target_lang_word": "хлопок",
                                "target_lang_sense_clarification": "резкий звук"
                            },
                            {
                                "target_lang_word": "грохот",
                                "target_lang_sense_clarification": "громкий звук удара"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17250e80-4e5c-3ead-b7e4-54c6377aac74",
                    "sense_definition": "An insult or a forceful piece of criticism.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not mean this as a <w>slam</w>, but you can be very impatient.",
                            "target_lang_translations": {
                                "ru": "Я не хочу тебя <w>оскорбить</w>, но ты бываешь очень нетерпеливым."
                            }
                        },
                        {
                            "text": "His comment about her work was a direct <w>slam</w> at her professional skills.",
                            "target_lang_translations": {
                                "ru": "Его комментарий о её работе был прямым <w>выпадом</w> в адрес её профессиональных навыков."
                            }
                        }
                    ],
                    "synonyms": [
                        "insult",
                        "dig",
                        "slur"
                    ],
                    "common_phrases": [
                        "take a slam"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оскорбление или резкое критическое замечание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оскорбление",
                                "target_lang_sense_clarification": "унижение достоинства"
                            },
                            {
                                "target_lang_word": "выпад",
                                "target_lang_sense_clarification": "враждебное замечание"
                            },
                            {
                                "target_lang_word": "нападка",
                                "target_lang_sense_clarification": "критика"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95e783e4-fc27-37dc-bcdd-a23c4f790990",
                    "sense_definition": "Winning all or most of the major events in a sports season or a specific bid in card games.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tennis player won eight grand <w>slam</w> titles during his career.",
                            "target_lang_translations": {
                                "ru": "Теннисист выиграл восемь титулов Большого <w>шлема</w> за свою карьеру."
                            }
                        },
                        {
                            "text": "They were hoping for a grand <w>slam</w> by winning every race this year.",
                            "target_lang_translations": {
                                "ru": "Они надеялись на «большой <w>шлем</w>», выиграв все гонки в этом году."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grand slam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Победа во всех или большинстве крупных соревнований сезона или специфическая ставка в карточных играх."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлем",
                                "target_lang_sense_clarification": "в спорте или картах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}