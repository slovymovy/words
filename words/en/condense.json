                    "frequency": "Middle",
                    "semantic_group_id": "reduce_volume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author had to <w>condense</w> the long novel into a short story."
                        },
                        {
                            "text": "You can <w>condense</w> the sauce by boiling it for several minutes."
                        }
                    ],
                    "synonyms": [
