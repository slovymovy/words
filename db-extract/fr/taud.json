                "forms": [
                    {
                        "form_id": "32f1f26b-9e07-40f2-8153-62696e9183b1",
                        "entry_id": "edccff7d-8d30-39d5-8173-afcc949f507a",
                        "tags": [
                            "plural"
                        ],
                        "form": "tauds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "da11e737-4568-3240-a095-bb15820f4632",
                        "entry_id": "edccff7d-8d30-39d5-8173-afcc949f507a",
                        "glosses": [
                            "Toile goudronnée servant d’abri sur un bateau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6618058f-0ea7-4b3c-bef7-813bda3c793f",
                                "sense_id": "da11e737-4568-3240-a095-bb15820f4632",
                                "text": "Vêtu d’un costume de cotonnade bleu, le vieux Malais, planté sur ses pieds sombres et osseux, sous le taud de la passerelle, se croisa les mains dans le dos et, d’innombrables rides se dessinant au coin de ses yeux, regarda fixement devant lui."
                            },
                            {
                                "example_id": "b2365622-cff0-4fa3-a8c7-d47e209222b4",
                                "sense_id": "da11e737-4568-3240-a095-bb15820f4632",
                                "text": "Quelques coups de pédale encore et le commissaire vit, à l’arrière de la péniche, une table dressée sous le taud protégeant la barre. La toile cirée était à carreaux bleus et blancs."
                            }
                        ]
                    },
                    {
                        "sense_id": "33e20545-4530-35c6-9c45-aa0dab22adf0",
                        "entry_id": "edccff7d-8d30-39d5-8173-afcc949f507a",
                        "glosses": [
                            "Toile de protection servant à envelopper les voiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a70a0534-d944-4f81-9036-ba0ecae4ac7e",
                                "sense_id": "33e20545-4530-35c6-9c45-aa0dab22adf0",
                                "text": "Des yachts et des petits canots vêtus de leurs tauds d’hivernage dansaient doucement au mouillage, dans le mitant du chenal et on apercevait, sur la berge opposée, quelques vieilles carcasses à bout d’océan qui terminaient leur carrière dans la vase noire, sous les branches nues des chênes têtards."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e232d7a-3333-44b7-8ba6-750ad5ff76ad",
                        "source_entry_id": "edccff7d-8d30-39d5-8173-afcc949f507a",
                        "source_sense_description": "Abri",
                        "target_lang_word": "awning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "awning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a1dc2ac-7388-33e9-bf88-00439a2508f9",
                                        "entry_id": "ced1fd10-9b4e-3607-90e6-1eaef00e69a2",
                                        "glosses": [
                                            "A rooflike cover, usually of canvas, extended over or before any place as a shelter from the sun, rain, or wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa9708e5-bb47-4179-8f38-41c0e97e11fd",
                                                "sense_id": "6a1dc2ac-7388-33e9-bf88-00439a2508f9",
                                                "text": "At Nairobi the mail waits an hour-and-a-half. The station has three long platforms, mostly covered in awnings, the island connected with the main platform (which is used by the mails in both directions) by a subway."
                                            },
                                            {
                                                "example_id": "d0aab8df-3b3e-427e-a169-c537ec9a2b16",
                                                "sense_id": "6a1dc2ac-7388-33e9-bf88-00439a2508f9",
                                                "text": "But instead, the distinctive ironwork and glass platform awnings have been carefully refurbished, while making them compatible with the overhead wiring. Kettering's island Platform 2/3 is especially noteworthy. Although it dates from 1879, when the station was enlarged to four platforms, the same original (1857) patterns for the delicate cast-ironwork seem to have been used - […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58216624-a3c0-3c82-9531-763016bc8457",
                                        "entry_id": "ced1fd10-9b4e-3607-90e6-1eaef00e69a2",
                                        "glosses": [
                                            "That part of the poop deck which is continued forward beyond the bulkhead of the cabin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60b3fd82-7322-4660-8f9f-ae367777a6b4",
