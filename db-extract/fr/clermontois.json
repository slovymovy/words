                        "glosses": [
                            "Relatif à Clermont-Ferrand, commune du Puy-de-Dôme, en France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "276c3b7e-e161-401c-9383-24ef027541d0",
                                "sense_id": "044049a3-c548-3b93-9618-a3c3883f7fcc",
                                "text": "Vous m’avez affirmé, sévères dénonciateurs, que les usines clermontoises étaient le centre d’un système d’aspiration qui attirait à lui toutes les forces humaines."
                            },
                            {
                                "example_id": "f22c49c0-2ec5-4963-9717-0b4939068a3d",
                                "sense_id": "044049a3-c548-3b93-9618-a3c3883f7fcc",
                                "text": "En effet, le 2 octobre 2006, le Translohr clermontois déguide sur le viaduc Saint-Jacques lors de la marche à blanc."
                            },
                            {
                                "example_id": "1e882f6a-c7f0-41e1-ae98-0029f63e7619",
                                "sense_id": "044049a3-c548-3b93-9618-a3c3883f7fcc",
                                "text": "Après la condamnation, mardi, de Mohamed Haouas à un an de prison pour violences conjugales, le président clermontois a annoncé que le pilier ne rejoindrait pas son club la saison prochaine."
                            }
                        ]
