                        "glosses": [
                            "roślina z gatunku poinsecja (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11d8ac8e-ab74-419a-8895-aeb5809e5877",
                                "sense_id": "bb63f8a0-6cc7-372d-9963-777bc32b2f3d",
                                "text": "Nadchodzi czas kupowania poinsecji, zwanej popularnie gwiazdą betlejemską"
                            }
                        ],
