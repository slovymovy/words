                        "zh": [
                            {
                                "target_lang_word": "响起",
                                "target_lang_sense_clarification": "指发出响亮的铃声或敲击声"
                            },
                            {
                                "target_lang_word": "敲",
                                "target_lang_sense_clarification": "指敲出叮当声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ed43d57-5ea2-3cf5-9069-1f234f684375",
                    "sense_definition": "To strike, throw, or knock something down violently.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry warrior <w>danged</w> his shield upon the ground.",
                            "target_lang_translations": {
                                "ru": "Рассерженный воин <w>швырнул</w> свой щит на землю.",
                                "zh": "愤怒的武士把盾牌猛地<w>砸</w>在地上。"
                            }
