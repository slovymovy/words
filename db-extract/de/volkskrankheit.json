                "senses": [
                    {
                        "sense_id": "b679e6b8-b820-3511-af1d-1dd79db313a9",
                        "entry_id": "f87d9134-de0a-3d93-af9e-b010a0f60c4e",
                        "glosses": [
                            "nicht infektiöse Krankheit, von der sehr viele Menschen der Bevölkerung betroffen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f76f8df-0a1f-4382-a186-ebe764c50574",
                                "sense_id": "b679e6b8-b820-3511-af1d-1dd79db313a9",
                                "text": "Krankheitsbilder, wie Bluthochdruck, Diabetes und Depressionen, werden oft als Volkskrankheiten betitelt."
                            },
                            {
                                "example_id": "dce383f5-bff5-4ee3-af9e-60320f6414e3",
                                "sense_id": "b679e6b8-b820-3511-af1d-1dd79db313a9",
                                "text": "„Bis sich die Augen über die wahre Natur der Volkskrankheit endgültig öffneten, vergingen, wie wir heute wissen, noch dreizehn lange Jahre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
