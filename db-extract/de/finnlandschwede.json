                "senses": [
                    {
                        "sense_id": "5822afd7-73a3-3859-bab4-2a3e53d037a5",
                        "entry_id": "a4156ac3-9f21-3958-b929-05e1963cc252",
                        "glosses": [
                            "Person, die zur schwedischsprachigen Minderheit der Bevölkerung Finnlands zählt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f2aed74-fe02-41df-8b13-715bb24f0029",
                                "sense_id": "5822afd7-73a3-3859-bab4-2a3e53d037a5",
                                "text": "„Sámi und Åländer haben eine eigene Fahne (und zusätzliche eigene Flaggentage), die Finnlandschweden haben inzwischen auch eine eigene, allerdings »nichtoffizielle« Flagge.“"
                            },
                            {
                                "example_id": "99260037-b8be-4cfb-a8ec-0d19d8093236",
                                "sense_id": "5822afd7-73a3-3859-bab4-2a3e53d037a5",
                                "text": "„Hinzuzuzählen sind die schwedische Bevölkerung auf den zu Finnland gehörenden Åland-Inseln sowie die Finnlandschweden (schwed. finländare) in Finnland, deren Hauptsiedlungsgebiete sich im wesentlichen entlang der westlichen und südlichen Küstenstriche Finnlands sowie in der Hauptstadt Helsinki (schwed. Helsingsfors) befinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
