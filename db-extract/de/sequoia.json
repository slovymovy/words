                        "entry_id": "421cf2a6-90cc-3f37-ae4c-a6bece32fa29",
                        "glosses": [
                            "sehr hoher Nadelbaum mit weitem Stammdurchmesser, der sehr alt werden kann und im Westen Nordamerikas heimisch ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d1aa947-26b6-4a3d-b287-eee11646e9a7",
                                "sense_id": "d60764a3-b4fa-3add-9a25-d7b09a544f3d",
                                "text": "„So groß ist der Einfluß, den Sequoias auf den menschlichen Geist haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
