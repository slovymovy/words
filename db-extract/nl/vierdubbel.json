                        "examples": [
                            {
                                "example_id": "125f8d29-ff9c-4d65-81b9-73abe8c94e29",
                                "sense_id": "9761122a-3fc9-3b19-94d9-0372d5b3efde",
                                "text": "Het vierdubbele van 2 is 8, het vierdubbele van 6 is 24, het vierdubbele van 4 is 16, het is eigenlijk altijd het getal maal 4."
                            },
                            {
                                "example_id": "5f086298-5928-4902-bd48-5cd948051547",
                                "sense_id": "9761122a-3fc9-3b19-94d9-0372d5b3efde",
                                "text": "Van F. virginiana en F. chiloensis was al bekend dat hun vierdubbele genoom in elk geval het erfelijk materiaal van twee wilde soorten bevatte: de wilde bosaardbei (F. vesca, die op het hele noordelijk halfrond voorkomt) en F. iinumae (uit Japan). Het vermoeden was dat er nog twee vooroudersoorten moesten zijn."
                            },
                            {
                                "example_id": "39618b45-cb57-43c5-b4d8-32758696515d",
                                "sense_id": "9761122a-3fc9-3b19-94d9-0372d5b3efde",
                                "text": "Leg de vierdubbel opgevouwen theedoek onder in de pan en zet er de wijnfles op."
                            }
