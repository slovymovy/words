                    },
                    {
                        "form_id": "700d64fd-3a31-4dc2-8b68-cd37324fcaad",
                        "entry_id": "97ed0e61-a883-36d0-9b5f-6abf07fbe825",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "apollinienne"
                    },
                    {
                        "form_id": "82f8ac6c-c68b-47d2-84e3-53667ded1b15",
                        "entry_id": "97ed0e61-a883-36d0-9b5f-6abf07fbe825",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "apolliniennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7bbd96cf-1a1c-391d-821c-d1c73068bcd3",
                        "entry_id": "97ed0e61-a883-36d0-9b5f-6abf07fbe825",
                        "glosses": [
                            "Relatif à Apollon, le dieu du soleil et des arts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa3883f9-44e3-41ab-90dd-a3d1550d6e29",
                                "sense_id": "7bbd96cf-1a1c-391d-821c-d1c73068bcd3",
                                "text": "Le mythe apollinien."
                            }
                        ]
                    },
                    {
                        "sense_id": "081b66cb-0546-3435-bb16-aff411db4379",
                        "entry_id": "97ed0e61-a883-36d0-9b5f-6abf07fbe825",
                        "glosses": [
                            "Qui vise la perfection, l’esthétisme, la beauté pure."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "7e4f2e2b-1b48-45d8-9e46-2cc1c8fee0ba",
                                "sense_id": "081b66cb-0546-3435-bb16-aff411db4379",
                                "text": "Le jeu d’ego consiste à se trouver génial en concordance avec les idéaux apolliniens de l’olympisme moderne."
                            },
                            {
                                "example_id": "a0e79ba7-0107-4a96-a575-091769d03da1",
                                "sense_id": "081b66cb-0546-3435-bb16-aff411db4379",
                                "text": "Il inscrivait la traduction parmi les sciences du langage en la bannissant, sans doute malgré lui, des temples apolliniens de l’esthétique."
                            },
                            {
                                "example_id": "4f902b99-2d6d-42e9-b573-a24a84f7d454",
                                "sense_id": "081b66cb-0546-3435-bb16-aff411db4379",
                                "text": "Mais Martha Argerich aime les « mauvaises herbes », préfère les dionysiaques débraillés aux impeccables apolliniens."
                            },
                            {
                                "example_id": "4bbf5ab4-1e2d-4855-b882-879208a93178",
                                "sense_id": "081b66cb-0546-3435-bb16-aff411db4379",
                                "text": "La plupart de ces musiciens m’ont d’autant plus passionné qu’une majorité d’entre eux ont eu des existences difficiles, parfois tragiques, loin des vies apolliniennes de la majorité des grands musiciens classiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5d86ccc-0b24-47d4-a47e-4bf79d14fba3",
                        "source_entry_id": "97ed0e61-a883-36d0-9b5f-6abf07fbe825",
                        "target_lang_word": "Apollonian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apollonian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c74d5e9f-aab7-3eac-8ead-8128de1260c6",
                                        "entry_id": "bc3772aa-228f-35e0-8164-c8b4df4910b2",
                                        "glosses": [
                                            "Of or relating to the ancient Olympian Greek God Apollo."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd3cf54f-53bb-4092-9d44-8e7b131fd7e4",
                                                "sense_id": "c74d5e9f-aab7-3eac-8ead-8128de1260c6",
                                                "text": "You have your lovers - dusky beaus / Not made of the poetic stuff / That sports an Apollonian nose, / And wears a sleek Byronic cuff."
                                            },
                                            {
                                                "example_id": "eb6037da-582c-4c53-aa0f-cb692e199b4c",
                                                "sense_id": "c74d5e9f-aab7-3eac-8ead-8128de1260c6",
                                                "text": "The forces of nature is a major theme embodied in the two main goddess characters. The \"northern woman\" is Appollonian ^([sic]) in her nature — cold, reserved, quiet, identified with the moon; the \"southern woman\" is Dionysian — passionate, a sun goddess."
                                            },
                                            {
                                                "example_id": "43adf409-9bc2-41ab-9dc1-e417338ba32c",
                                                "sense_id": "c74d5e9f-aab7-3eac-8ead-8128de1260c6",
                                                "text": "Marty and I often discussed the choice we all have in controlling our cognition. We referred to harnessing this power as \"the Apollonian state\", after Apollo, the Greek god of the sun and light and truth. In the Apollonian state you could use reason to move away from despairing beliefs―it's never going to change, it's all my fault, there must be something wrong with me―and towards more empowered thinking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b65a2b4-5f1c-349a-a046-dfe2c478609e",
                                        "entry_id": "bc3772aa-228f-35e0-8164-c8b4df4910b2",
                                        "glosses": [
                                            "Of or relating to the Ancient Greek mathematician Apollonius of Perga."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec62e492-bed4-3af1-bfc2-e3fc3161df4e",
                                        "entry_id": "bc3772aa-228f-35e0-8164-c8b4df4910b2",
                                        "glosses": [
                                            "Pertaining to Apollonia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "811a93f6-6852-4f30-824b-70a07397287b",
                                                "sense_id": "ec62e492-bed4-3af1-bfc2-e3fc3161df4e",
                                                "text": "They speak Aowin [Anyi] but their blood is Apollonian blood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36ca9c6e-7487-36da-b4cd-2f6ec81fd172",
                                        "entry_id": "bc3772aa-228f-35e0-8164-c8b4df4910b2",
                                        "glosses": [
                                            "Alternative form of apollonian."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e62befe3-e10e-3d00-92bf-11360faf4a98",
                                        "entry_id": "bc3772aa-228f-35e0-8164-c8b4df4910b2",
                                        "glosses": [
                                            "The physical property of material that can resume its shape after being stretched or deformed; elasticity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Apollonian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2da24ed7-5e23-35c8-b38e-fa75f3e7bd42",
                                        "entry_id": "1c16e773-e98d-33f0-9e6e-5b8e03c0a9f0",
                                        "glosses": [
                                            "One who is apollonian."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff9c2266-af93-33da-b6ea-c83ef476a9e0",
                                        "entry_id": "1c16e773-e98d-33f0-9e6e-5b8e03c0a9f0",
                                        "glosses": [
                                            "One who follows/worships Apollo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f063771-f744-4757-9aca-271807066cbe",
                                                "sense_id": "ff9c2266-af93-33da-b6ea-c83ef476a9e0",
                                                "text": "By contrast, Apollonians value reason more than feeling."
                                            },
                                            {
                                                "example_id": "6a1f67c1-97a2-4896-a0ee-a81c8285776b",
                                                "sense_id": "ff9c2266-af93-33da-b6ea-c83ef476a9e0",
                                                "text": "Apollonians and Dionysians are usually the same people: now sober and serene, now drunk and frenzied."
                                            },
                                            {
                                                "example_id": "dfdb0cc9-4421-4a84-a807-d271f37c6f66",
                                                "sense_id": "ff9c2266-af93-33da-b6ea-c83ef476a9e0",
                                                "text": "Those of us who were Apollonians had thus a chance to organize a programme. The Dionysians knew what was going to happen to them, but, of course, did not know yet how to cope with it."
                                            },
                                            {
                                                "example_id": "2849ea45-90b4-4aa4-9dd1-2309b577bc5f",
                                                "sense_id": "ff9c2266-af93-33da-b6ea-c83ef476a9e0",
                                                "text": "Apollonians are creative artists, but while all Apollonians love the arts, there are both creative and business types of Apollonians."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fcab7bb-0a5c-30ae-8349-e25b1bfd10dd",
                                        "entry_id": "1c16e773-e98d-33f0-9e6e-5b8e03c0a9f0",
                                        "glosses": [
                                            "A native of Apollonia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "360423e6-a23b-4802-991a-fdc7e27dfebd",
                                                "sense_id": "4fcab7bb-0a5c-30ae-8349-e25b1bfd10dd",
                                                "text": "But the Apollonians being soon informed of the thing, caused him to appear without delay before the court of justice; and sentenced him to lose his eyes, for sleeping when he ought to have watched."
                                            },
                                            {
                                                "example_id": "816dc7c7-6840-42ca-afcc-4088edeefb1f",
                                                "sense_id": "4fcab7bb-0a5c-30ae-8349-e25b1bfd10dd",
                                                "text": "Another clause in the rules of conduct drawn up for defeated Appolonia virtually transferred jurisdiction to Maclean: by it, he invited 'every Appolonian who may be oppressed or injured wither [i.e. whether] by Quacoe Accah [Kwaku Akkah, the King] or any other chief ... to make his complaint to the governor of Cape Coast"
                                            },
                                            {
                                                "example_id": "5006179a-0509-4d61-8c09-bdff2c25c96b",
                                                "sense_id": "4fcab7bb-0a5c-30ae-8349-e25b1bfd10dd",
                                                "text": "McIlvaine and colleagues (2014) examined a cemetery at the Greek colony of Apollonia, Albania to assess to what degree interbreeding may have occurred between indigenous Illyrians and colonial Apollonians."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52f72e77-fed4-3a4b-b902-c1b09938a083",
                                        "entry_id": "1c16e773-e98d-33f0-9e6e-5b8e03c0a9f0",
                                        "glosses": [
                                            "A native of the planet Apollo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e16818-0411-42e1-9c7f-4d074da5c1d6",
                                                "sense_id": "52f72e77-fed4-3a4b-b902-c1b09938a083",
                                                "text": "At first, when the Apollonians converged on her, Mary Theresa thought she had made a major mistake by going to the battle."
                                            },
                                            {
                                                "example_id": "21ad75f3-e252-4c35-8034-c1ab727beb9e",
                                                "sense_id": "52f72e77-fed4-3a4b-b902-c1b09938a083",
                                                "text": "The last person who tried this kind of appeal was actually the new vessel -- an Apollonian, one I knew briefly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
