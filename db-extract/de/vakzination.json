                    },
                    {
                        "sense_id": "92917eff-0d7b-3968-8399-fdbfb61968b1",
                        "entry_id": "1e6e2bcb-c1c0-3b26-9a8b-ec0927181bcf",
                        "glosses": [
                            "1796 von Edward Jenner eingeführte Methode der Schutzimpfung zur Prävention von Pocken"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [],
