                            "comparative"
                        ],
                        "form": "суррога́тнее"
                    },
                    {
                        "form_id": "b3161456-2178-4669-987d-539262d65b44",
                        "entry_id": "140ee334-7806-394d-a50a-0b42100f1434",
                        "tags": [
