                ],
                "senses": [
                    {
                        "sense_id": "d96822d0-50ca-3883-8fcb-3417dba4f944",
                        "entry_id": "02373597-bf67-3001-aea5-15229fac63b0",
                        "glosses": [
                            "An act or instance of something being edited."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37b79df7-b54d-4dac-96b3-ab4c079646fd",
                                "sense_id": "d96822d0-50ca-3883-8fcb-3417dba4f944",
                                "text": "To her, I credit three complete editings, numerous arguments and discussions over an extended period of time, and the incalculable benefit of her great knowledge and love of the English language."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65788a6d-0787-4038-8ece-57b199f19745",
                        "source_entry_id": "02373597-bf67-3001-aea5-15229fac63b0",
                        "source_sense_id": "d96822d0-50ca-3883-8fcb-3417dba4f944",
                        "source_sense_description": "an act or instance of something being edited",
                        "target_lang_word": "rédaction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rédaction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e60b87b8-efdb-37a2-989b-eac6e6899030",
                                        "entry_id": "9707d3e1-320a-3152-8fcb-4f4cb0f34ef4",
                                        "glosses": [
                                            "Action de rédiger ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54a10fea-7bb2-447b-83db-df987637959e",
                                                "sense_id": "e60b87b8-efdb-37a2-989b-eac6e6899030",
                                                "text": "En 1555, Anne de Pisseleu, duchesse d'Étampes, comparut à la rédaction de la coutume de Sens pour sa châtellenie de Bransles."
                                            },
                                            {
                                                "example_id": "14cb6140-9394-46da-8414-8f3c35e1176f",
                                                "sense_id": "e60b87b8-efdb-37a2-989b-eac6e6899030",
                                                "text": "La rédaction d’un acte, d’un traité, d’un arrêt, d’une loi."
                                            },
                                            {
                                                "example_id": "3660f48b-5bb1-4da2-b6e5-70cb4c94eb79",
                                                "sense_id": "e60b87b8-efdb-37a2-989b-eac6e6899030",
                                                "text": "Il fut chargé de la rédaction du projet de loi."
                                            },
                                            {
                                                "example_id": "e91b82c6-2ca9-4937-a201-24210e27d6a2",
                                                "sense_id": "e60b87b8-efdb-37a2-989b-eac6e6899030",
                                                "text": "La rédaction d’un journal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64fd82ba-e8ce-3961-86ac-c3af477fe37a",
                                        "entry_id": "9707d3e1-320a-3152-8fcb-4f4cb0f34ef4",
                                        "glosses": [
                                            "Exercice scolaire par lequel on enseigne aux enfants à rédiger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0283e747-152f-4156-8a89-0e64edd32a8b",
                                                "sense_id": "64fd82ba-e8ce-3961-86ac-c3af477fe37a",
                                                "text": "Faire une rédaction d’histoire."
                                            },
                                            {
                                                "example_id": "e5d642f2-c73c-4b2d-b871-5e371088de1d",
                                                "sense_id": "64fd82ba-e8ce-3961-86ac-c3af477fe37a",
                                                "text": "4 octobre 1940 – Mon pauvre chéri, dit papa, nous l’avons stérilisée en la laissant aller à la Sorbonne. Rappelle-toi, elle faisait des rédactions charmantes quand elle était enfant. Elle a perdu ses dons ; c’est une conséquence de l’enseignement aujourd’hui."
                                            },
                                            {
                                                "example_id": "c413d52f-d814-4b98-88f8-c80bf24901dd",
                                                "sense_id": "64fd82ba-e8ce-3961-86ac-c3af477fe37a",
                                                "text": "« Vous raconterez votre premier chagrin. ‘Mon premier chagrin’ sera le titre de votre prochain devoir de français. »\n– N’est-ce pas plutôt rédaction qu’on disait à l’école communale ?\n– Peut-être… en tout cas, cette rédaction-là ou ce devoir de français ressort parmi les autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4473bbb-393e-3ff8-9ded-e374179f6f45",
                                        "entry_id": "9707d3e1-320a-3152-8fcb-4f4cb0f34ef4",
                                        "glosses": [
                                            "Ensemble des rédacteurs d’un journal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da908cc9-5fe0-41e8-93ea-39ec6f70da56",
                                                "sense_id": "f4473bbb-393e-3ff8-9ded-e374179f6f45",
                                                "text": "Note de la rédaction."
                                            },
                                            {
                                                "example_id": "ab043ac1-f4b7-4362-adc9-2d834f67f01f",
                                                "sense_id": "f4473bbb-393e-3ff8-9ded-e374179f6f45",
                                                "text": "Toute la rédaction assistait à cette cérémonie."
                                            },
                                            {
                                                "example_id": "b82cf9f1-fcf4-4bc7-b1e2-efaf86e4765d",
                                                "sense_id": "f4473bbb-393e-3ff8-9ded-e374179f6f45",
                                                "text": "Le secrétaire de la rédaction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9db3ae4d-835c-350b-9073-d799f19dce73",
                                        "entry_id": "9707d3e1-320a-3152-8fcb-4f4cb0f34ef4",
                                        "glosses": [
                                            "Locaux des rédacteurs d’un journal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34da4850-132b-4605-bb87-ca1f0174d9ec",
                                                "sense_id": "9db3ae4d-835c-350b-9073-d799f19dce73",
                                                "text": "Se rendre à la rédaction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1890282a-1976-453c-9ac8-29c1e496da2a",
                        "source_entry_id": "02373597-bf67-3001-aea5-15229fac63b0",
                        "source_sense_id": "d96822d0-50ca-3883-8fcb-3417dba4f944",
                        "source_sense_description": "an act or instance of something being edited",
