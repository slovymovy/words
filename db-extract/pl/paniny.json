                "senses": [
                    {
                        "sense_id": "40d2b346-da4e-3189-afc6-8b4528c6690b",
                        "entry_id": "cec7e7b8-7e0a-3b8a-a600-03f4457cdf42",
                        "glosses": [
                            "your, yours, lady's (of or pertaining to a woman who one refers to as Pani)"
                        ],
                        "tags": [
                            "dated",
                            "informal",
                            "not-comparable",
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "4b36c0de-5784-4ec9-a569-d2ddfddf5af8",
                                "sense_id": "40d2b346-da4e-3189-afc6-8b4528c6690b",
                                "text": "Wszystko zrobiłam po paninemu, wieszałam na drucie czerwone szmaty, ale zeszłej jesieni zabrały z pastwiska trzy owce, pieski jeszcze chyba się trochę bojały wilków.[…]",
                                "translation": "I did everything your way, hung red rags on the wire, but last autumn they took three sheep from the pasture, the dogs were still a little afraid of wolves, I think. […]",
                                "english": "I did everything your way, hung red rags on the wire, but last autumn they took three sheep from the pasture, the dogs were still a little afraid of wolves, I think. […]"
                            }
                        ]
                    }
