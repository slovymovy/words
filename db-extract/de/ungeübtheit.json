                "senses": [
                    {
                        "sense_id": "2062b82c-2d2b-3e6b-8119-6bd5a4d890a6",
                        "entry_id": "a6ceb4b8-6435-351f-ac41-1a6f3c4ab0cb",
                        "glosses": [
                            "Unmöglichkeit geübt zu handeln, wegen des Fehlens dafür geforderter Erfahrung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31aa6275-2cb4-48a9-8bbf-341162282993",
                                "sense_id": "2062b82c-2d2b-3e6b-8119-6bd5a4d890a6",
                                "text": "„Das Quintett hat aus verschiedenen Gründen einen erhöhten Betreuungsbedarf; sei es bei der Verrichtung alltäglicher Dinge oder wegen Ungeübtheit und Mangels an bisherigen Wohnerfahrungen.“"
                            },
                            {
                                "example_id": "d2336c17-ac03-437c-b281-4760ca4ddbf0",
                                "sense_id": "2062b82c-2d2b-3e6b-8119-6bd5a4d890a6",
                                "text": "„Er leitete eine Vollbremsung ein, kam wohl aus Ungeübtheit zu Fall und krachte in die hintere rechte Seite des Pkw, an dem ein Schaden in fünfstelliger Höhe zu verzeichnen war.“"
                            }
                        ],
