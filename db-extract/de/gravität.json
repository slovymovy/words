                ],
                "senses": [
                    {
                        "sense_id": "dd41cd5a-75ef-3cab-9570-df12e3ead9a9",
                        "entry_id": "f5d8052a-e32e-3e03-a681-21d6e361a5f0",
                        "glosses": [
                            "feierliche Würde; Gemessenheit im Gehaben"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "feced83f-0743-4583-b9fa-bf7be9c7ca1e",
                                "sense_id": "dd41cd5a-75ef-3cab-9570-df12e3ead9a9",
                                "text": "„Der Lebensernst, die pathetische Gravität des Lebens, ist gewiß ein hoher sittlicher Wert.“"
                            },
                            {
                                "example_id": "260812a6-8eec-4794-9b6e-2c7066690d76",
                                "sense_id": "dd41cd5a-75ef-3cab-9570-df12e3ead9a9",
                                "text": "„Der Hintergrund war, dass Uz sich über die Gravität und Langweiligkeit Bodmers (vornehmlich im »Noah«) lustig gemacht hatte, über die missglückten Versuche, durch stilitische Schaumschlägereien Milton nachzuahmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2aad577e-92d4-4949-8a86-2061b0d9bbdd",
                        "source_entry_id": "f5d8052a-e32e-3e03-a681-21d6e361a5f0",
                        "source_sense_id": "dd41cd5a-75ef-3cab-9570-df12e3ead9a9",
                        "source_sense_description": "bildungssprachlich, auch spöttisch: feierliche Würde; Gemessenheit im Gehaben",
                        "target_lang_word": "dignity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dignity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39dbc146-e63b-3015-9882-ba49de1dc384",
                                        "entry_id": "b9fb2943-8a55-362c-8e44-6f98969cf480",
                                        "glosses": [
                                            "The state of being dignified or worthy of esteem: elevation of mind or character."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43602237-e4b7-43e4-9189-c0464ac51707",
                                                "sense_id": "39dbc146-e63b-3015-9882-ba49de1dc384",
                                                "text": "He uttered this ... with great majesty, or, as he called it, dignity."
                                            },
                                            {
                                                "example_id": "79ed87e0-b8d1-4b7f-9b09-757de098847e",
                                                "sense_id": "39dbc146-e63b-3015-9882-ba49de1dc384",
                                                "text": "Every individual shall have the right to the respect of the dignity inherent in a human being."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ca91e28-f90e-3b89-a579-2297a0e548e3",
                                        "entry_id": "b9fb2943-8a55-362c-8e44-6f98969cf480",
                                        "glosses": [
                                            "Decorum, formality, stateliness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c30af991-6f77-4ae3-b0c7-947112cf1dbb",
                                                "sense_id": "8ca91e28-f90e-3b89-a579-2297a0e548e3",
                                                "text": "The reception room was sacred to the dead wife. Her shiny portrait hung upon the wall - similar, doubtless, in all respects to the one which would be pasted on her tombstone. A little piece of black drapery had been tacked above the frame to lend a dignity to woe. But two of the tacks had fallen out, and the effect was now rakish, as that of a drunkard's bonnet."
                                            },
                                            {
                                                "example_id": "caace545-815e-457e-bbc0-1df8fb3e898f",
                                                "sense_id": "8ca91e28-f90e-3b89-a579-2297a0e548e3",
                                                "text": "Official DIGNITY tends to increase in inverse ratio to the importance of the country in which the office is held."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fc22a13-9cc9-3e42-b66b-7b32be4fd729",
                                        "entry_id": "b9fb2943-8a55-362c-8e44-6f98969cf480",
                                        "glosses": [
                                            "High office, rank, or station."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e2376d6-e7f1-46d4-96da-d4bf0291922f",
                                                "sense_id": "7fc22a13-9cc9-3e42-b66b-7b32be4fd729",
                                                "text": "Note the preſumption of this Scythian ſlaue:\nI tel thee villaine, thoſe that lead my horſe\nHaue to their names tytles of dignitie,\nAnd dar’ſt thou bluntly cal me Baiazeth?"
                                            },
                                            {
                                                "example_id": "63d6c589-3af0-4a49-80f7-8a95399bd593",
                                                "sense_id": "7fc22a13-9cc9-3e42-b66b-7b32be4fd729",
                                                "text": "And the king said, What honour and dignity hath been done to Mordecai for this?"
                                            },
                                            {
                                                "example_id": "136e95ca-dca4-4a2b-989f-61b816332d10",
                                                "sense_id": "7fc22a13-9cc9-3e42-b66b-7b32be4fd729",
                                                "text": "He ... distributed the civil and military dignities among his favourites and followers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3cf60dd-b469-35c7-934d-2df491cb5a2e",
                                        "entry_id": "b9fb2943-8a55-362c-8e44-6f98969cf480",
                                        "glosses": [
                                            "One holding high rank; a dignitary."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "082f1929-662d-4f3c-bb88-9cad61c79789",
                                                "sense_id": "c3cf60dd-b469-35c7-934d-2df491cb5a2e",
                                                "text": "These filthy dreamers […] speak evil of dignities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "978cd10a-729c-3488-9014-ec37f601606e",
                                        "entry_id": "b9fb2943-8a55-362c-8e44-6f98969cf480",
                                        "glosses": [
                                            "Fundamental principle; axiom; maxim."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc6cb311-23c5-4fcf-947c-6d88229d7ccc",
                                                "sense_id": "978cd10a-729c-3488-9014-ec37f601606e",
                                                "text": "Sciences concluding from dignities, and principles known by themselves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "624ebff2-9b0c-4700-a827-f71dbd73b865",
                        "source_entry_id": "f5d8052a-e32e-3e03-a681-21d6e361a5f0",
                        "source_sense_id": "dd41cd5a-75ef-3cab-9570-df12e3ead9a9",
                        "source_sense_description": "bildungssprachlich, auch spöttisch: feierliche Würde; Gemessenheit im Gehaben",
                        "target_lang_word": "gravity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gravity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6e66ecf-09b5-33dd-a70c-6941d285cf61",
                                        "entry_id": "c538aa0f-0805-37d7-bcf2-49641dae804f",
                                        "glosses": [
                                            "The state or condition of having weight; weight; heaviness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be48cb88-3755-3467-a3b7-cafe52080ad5",
                                        "entry_id": "c538aa0f-0805-37d7-bcf2-49641dae804f",
                                        "glosses": [
                                            "The state or condition of being grave; seriousness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9584840-e92a-4c65-8ffb-719d3d26369b",
                                                "sense_id": "be48cb88-3755-3467-a3b7-cafe52080ad5",
                                                "text": "I hope you appreciate the gravity of the situation."
                                            },
                                            {
                                                "example_id": "069f3b74-f2b0-43b6-903a-e1271d5b7602",
                                                "sense_id": "be48cb88-3755-3467-a3b7-cafe52080ad5",
                                                "text": "The gravity of the situation which confronts the world today necessitates my appearance before a joint session of the Congress. The foreign policy and the national security of this country are involved."
                                            },
                                            {
                                                "example_id": "77a93064-6195-4579-bb64-fbd646056bf5",
                                                "sense_id": "be48cb88-3755-3467-a3b7-cafe52080ad5",
                                                "text": "Since I believe that abortion is absolutely wrong I must choose the course that minimizes the support of it. The gravity of this issue is so great that I must consider my job expendable."
                                            },
                                            {
                                                "example_id": "18712427-86cf-4abe-a522-342faf511b1c",
                                                "sense_id": "be48cb88-3755-3467-a3b7-cafe52080ad5",
                                                "text": "Could the month's poor performance in these two sectors reveal the true gravity of the labor market's woes?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "378a588f-5d7d-34a6-82ce-ca99ee874c53",
                                        "entry_id": "c538aa0f-0805-37d7-bcf2-49641dae804f",
                                        "glosses": [
                                            "The lowness of a note."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44f0169c-45d6-36be-ae85-dc9185bb2303",
                                        "entry_id": "c538aa0f-0805-37d7-bcf2-49641dae804f",
                                        "glosses": [
                                            "The phenomenon that, on earth, objects have weight; the similar phenomenon on other celestial bodies such as the moon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c27ee313-e23a-4ee4-885e-063702781772",
                                                "sense_id": "44f0169c-45d6-36be-ae85-dc9185bb2303",
                                                "text": "Do you know that gravity is pulling at you, tugging at you, trying to drag you down, from the moment you awake in the morning till you tumble into bed at night?"
                                            },
                                            {
                                                "example_id": "cdedc32d-6c66-42a2-b67f-ece638607986",
                                                "sense_id": "44f0169c-45d6-36be-ae85-dc9185bb2303",
                                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]: perhaps out of a desire to escape the gravity of this world or to get a preview of the next[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bc4066e-9859-34ee-9e9d-5f243562e615",
                                        "entry_id": "c538aa0f-0805-37d7-bcf2-49641dae804f",
                                        "glosses": [
                                            "Gravitation, the universal force exercised by two bodies on each other by virtue of their masses."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "724a1956-1507-3fbe-b43e-257f4a49db44",
                                        "entry_id": "c538aa0f-0805-37d7-bcf2-49641dae804f",
                                        "glosses": [
                                            "A law or laws of gravitation: any theory which attempts to account for the phenomena of weight and/or the mutual attraction of massive objects (Aristotelian gravity, Newtonian gravity)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c046236b-132d-4e5a-8c51-7ed5f4b1816e",
                                                "sense_id": "724a1956-1507-3fbe-b43e-257f4a49db44",
                                                "text": "Some of the most beautiful and thus appealing physical theories, including quantum electrodynamics and quantum gravity, have been dogged for decades by infinities that erupt when theorists try to prod their calculations into new domains. Getting rid of these nagging infinities has probably occupied far more effort than was spent in originating the theories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbaba594-dddb-3eb7-9b90-f4945053ba9c",
                                        "entry_id": "c538aa0f-0805-37d7-bcf2-49641dae804f",
                                        "glosses": [
                                            "Specific gravity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19e05b49-7c5a-4729-a10f-9d059da9a51e",
