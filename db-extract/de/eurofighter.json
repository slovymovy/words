                                "example_id": "9b206063-8f12-45b6-9d98-52a8325fbe8d",
                                "sense_id": "fedb5631-5bfe-3c05-92d0-8265fcacd3a7",
                                "text": "„EADS hat im vergangenen Jahrzehnt 15 Eurofighter-Kampfflugzeuge für 1,6 Milliarden Euro nach Österreich verkauft.“"
                            },
                            {
                                "example_id": "c83d8ab2-d5f3-4ac5-9ce0-6950f9a77275",
                                "sense_id": "fedb5631-5bfe-3c05-92d0-8265fcacd3a7",
                                "text": "„Beim Kauf der Eurofighter durch Österreich sollen Schmiergelder geflossen sein.“"
                            }
