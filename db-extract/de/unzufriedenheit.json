                "senses": [
                    {
                        "sense_id": "af9be810-643f-3906-815d-b387d74f6a71",
                        "entry_id": "79b52eb1-14aa-31bf-be82-c12206d49361",
                        "glosses": [
                            "Zustand, in dem man mit dem Gegebenen, den Verhältnissen und Bedingungen, dem Vorhandenen und Erreichten nicht einverstanden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "056056a3-a70d-4c6e-9540-78ce6271e9ee",
                                "sense_id": "af9be810-643f-3906-815d-b387d74f6a71",
                                "text": "„Der Deutsche hat an und für sich eine starke Neigung zur Unzufriedenheit.“"
                            },
                            {
                                "example_id": "741401fc-677f-40dd-9625-44df921aeaa9",
                                "sense_id": "af9be810-643f-3906-815d-b387d74f6a71",
                                "text": "„Er spürt die verbreitete Unzufriedenheit über das Kolonialregime.“"
                            },
                            {
                                "example_id": "a30fc500-ce52-468c-b28f-ceb0e9d95115",
                                "sense_id": "af9be810-643f-3906-815d-b387d74f6a71",
                                "text": "„Die große Unzufriedenheit mit dem politischen und wirtschaftlichen System der DDR zeigte sich auch in der hohen Zahl von Flüchtlingen.“"
                            },
                            {
                                "example_id": "b1ead403-0069-49c2-a432-73c35cc837c2",
                                "sense_id": "af9be810-643f-3906-815d-b387d74f6a71",
                                "text": "„Wir möchten unsere Ratlosigkeit und unsere Unzufriedenheit mit dem politischen Geschäft demonstrieren, in dem sich offenbar der Starrköpfigste und Unbeweglichste durchsetzt“, hieß es im Aufruf zu dem Protestmarsch, der im Brüsseler EU-Viertel endete."
                            },
                            {
                                "example_id": "50dd21ac-a02c-44ec-96c4-e3c77481dc02",
                                "sense_id": "af9be810-643f-3906-815d-b387d74f6a71",
                                "text": "„Wer nicht zufrieden sein will, muss seine Unzufriedenheit ertragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
