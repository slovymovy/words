                        "source_sense_id": "3ad9c449-63c4-3c50-a342-2a9375d7fdf4",
                        "source_sense_description": "nicht konstantes Verhalten, wenig zuverlässiges Verhalten",
                        "target_lang_word": "inconstance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconstance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3205956c-cafe-331f-8421-269f44d75f7f",
                                        "entry_id": "af4aa8fc-0c11-3c7b-ae17-1e7f2e654fbc",
                                        "glosses": [
                                            "Facilité à changer d’opinion, de résolution, de passion, de conduite, de sentiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd613a2f-9d35-44cb-9e33-d5d8d74e22f7",
                                                "sense_id": "3205956c-cafe-331f-8421-269f44d75f7f",
                                                "text": "Les voilà qui m'entourent ; les voilà qui me contemplent ; les voilà qui me disent en leurs provocations : « Jeune dieu d'Amour, enseigne aux nymphes bocagères la mollesse et le désir, l’inconstance et la passion , le sourire et le sérieux. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4a1e970-ec7b-3fbd-bf55-8922eafb2551",
                                        "entry_id": "af4aa8fc-0c11-3c7b-ae17-1e7f2e654fbc",
                                        "glosses": [
                                            "Faculté, capacité à changer, en parlant des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c5b7961-12be-422f-92dc-af08e9e07fe4",
                                                "sense_id": "c4a1e970-ec7b-3fbd-bf55-8922eafb2551",
                                                "text": "L’inconstance du temps, des saisons."
                                            },
                                            {
                                                "example_id": "44ca7ce4-bed4-4b60-a856-40a10de8cde2",
                                                "sense_id": "c4a1e970-ec7b-3fbd-bf55-8922eafb2551",
                                                "text": "L’inconstance des vents, de la mer."
                                            },
                                            {
                                                "example_id": "516bc9a3-2e33-4182-9e00-01cd0dffee4a",
                                                "sense_id": "c4a1e970-ec7b-3fbd-bf55-8922eafb2551",
                                                "text": "L’inconstance de la fortune."
                                            },
                                            {
                                                "example_id": "698b92af-883c-444b-bd48-474917ad074d",
                                                "sense_id": "c4a1e970-ec7b-3fbd-bf55-8922eafb2551",
                                                "text": "L’inconstance des choses humaines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cabcd6bb-d98e-453e-8e3c-66b85d8f4c66",
                        "source_entry_id": "4b076c37-f48a-345d-a972-71c99f2706cf",
                        "source_sense_id": "3ad9c449-63c4-3c50-a342-2a9375d7fdf4",
                        "source_sense_description": "nicht konstantes Verhalten, wenig zuverlässiges Verhalten",
                        "target_lang_word": "versatilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "versatilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fd14379-fb37-3139-be29-59606e85516e",
                                        "entry_id": "2fd786c1-29a9-3956-8cf9-6164dcfebac1",
                                        "glosses": [
                                            "Caractère de ce qui est versatile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3fe1f19-03e6-429a-8cb6-0fd728b38e63",
                                                "sense_id": "2fd14379-fb37-3139-be29-59606e85516e",
                                                "text": "D’après les membres de sa famille, son humeur peut être sombre et changeante, bien que, d’après eux, son caractère ait beaucoup perdu de sa versatilité ces dernières années."
                                            },
                                            {
                                                "example_id": "f155fd26-4ff4-4225-9726-a63d312352d1",
                                                "sense_id": "2fd14379-fb37-3139-be29-59606e85516e",
                                                "text": "L’efficacité de la CAQ tient peut-être à sa versatilité. (Dans son sens français : « Qui change souvent et aisément de parti, d’opinion. »)"
                                            },
                                            {
                                                "example_id": "7eb85f16-8288-4035-8c7e-de91d904b7a8",
                                                "sense_id": "2fd14379-fb37-3139-be29-59606e85516e",
                                                "text": "Une grande versatilité d’esprit, de sentiments."
                                            },
                                            {
                                                "example_id": "a46ac064-7532-4057-99ec-7f17725a3f96",
                                                "sense_id": "2fd14379-fb37-3139-be29-59606e85516e",
                                                "text": "Il a beaucoup de versatilité dans le caractère, dans ses opinions."
                                            },
                                            {
                                                "example_id": "adba5cb0-f764-4bc3-89f4-d4c7236374ff",
                                                "sense_id": "2fd14379-fb37-3139-be29-59606e85516e",
                                                "text": "Tendant à briser les idées reçues sur la sexualité gay, cette étude montre que si les relations érotiques entre hommes restent dominées par une polarité de genre arrimée à la division des rôles sexuels – les hommes « réceptifs » étant socialement codés comme féminins, les « actifs » comme masculins -, la « versatilité » est désormais la situation la plus courante chez les hommes qui aiment les hommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65785f76-707b-3484-a1f1-704594b3af85",
                                        "entry_id": "2fd786c1-29a9-3956-8cf9-6164dcfebac1",
                                        "glosses": [
                                            "Exprime l’affinité d’un terminal, mobile ou fixe, vis-à-vis des différents réseaux auxquels on peut le connecter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
