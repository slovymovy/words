        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c8ca7987-4eb1-31ae-b363-5ac7a3b7cbec",
                "word": "intifada",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "69383527-5429-4c76-afb0-debef8f2b2f2",
                        "entry_id": "c8ca7987-4eb1-31ae-b363-5ac7a3b7cbec",
                        "tags": [
                            "plural"
                        ],
                        "form": "intifadas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "34fbe08b-a318-3311-9484-bfd354fa26bb",
                        "entry_id": "c8ca7987-4eb1-31ae-b363-5ac7a3b7cbec",
                        "glosses": [
                            "An insurrection; a usually violent attempt to take control of a government."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2b2bbcde-a0fc-3f04-a7bf-9cd29e0bdccd",
                        "entry_id": "c8ca7987-4eb1-31ae-b363-5ac7a3b7cbec",
                        "glosses": [
                            "An uprising, resistant struggle, or rebellious protest."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7230e8de-4547-35f6-ac17-f2d004464383",
                        "entry_id": "c8ca7987-4eb1-31ae-b363-5ac7a3b7cbec",
                        "glosses": [
                            "An uprising, resistant struggle, or rebellious protest.",
                            "The Palestinian uprisings against Israel."
                        ],
                        "tags": [
                            "capitalized",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "08f320e2-a8a6-4a8b-b2b4-378a998d10e4",
                                "sense_id": "7230e8de-4547-35f6-ac17-f2d004464383",
                                "text": "Indeed, violence broke out in the occupied territories in mid-May 2000 as Palestinians observed the anniversary of the 1948 nakba—these disturbances paled in comparison to the second intifada, which erupted in the autumn."
                            },
                            {
                                "example_id": "99e455cf-7fb7-40ff-ad05-47db1535925e",
                                "sense_id": "7230e8de-4547-35f6-ac17-f2d004464383",
                                "text": "But unlike the Intifadas that began in 1987 and 2000, when Israel had someone to call to try to turn it off, there is no Palestinian on the other end of the phone this time […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c04697ce-4926-461c-ace8-7b13280f974f",
                        "source_entry_id": "c8ca7987-4eb1-31ae-b363-5ac7a3b7cbec",
                        "source_sense_description": "intifada",
                        "target_lang_word": "intifáda",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intifáda",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "c7be531a-10e0-30fb-bdef-c8fc8f7f8d20",
                                        "entry_id": "5e509a0b-f729-3e58-8f59-69fdc7c1dac3",
                                        "glosses": [
                                            "ozbrojený boj (povstání) Palestinců proti Izraeli na okupovaných územích"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032aebc9-eb8b-4009-883f-d3ff2ab7cd68",
                                                "sense_id": "c7be531a-10e0-30fb-bdef-c8fc8f7f8d20",
                                                "text": "Léto bude pro Izrael zřejmě velmi horké, může hrozit jak jednostranné vyhlášení nezávislosti, tak třetí intifáda. Tentokrát však mají Palestinci „pořešené“ mezinárodní mínění dopředu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3596ed93-ad22-4bb6-b34a-9f81d8607dee",
                        "source_entry_id": "c8ca7987-4eb1-31ae-b363-5ac7a3b7cbec",
                        "source_sense_description": "intifada",
                        "target_lang_word": "intifada",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intifada",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd5c6d69-324b-301f-a02e-73d5b269c870",
                                        "entry_id": "d3df9bc0-d882-3d31-8093-57e9bd84dafe",
                                        "glosses": [
                                            "Révolte contre un régime oppresseur ou un ennemi étranger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bad36979-ec49-43e6-a36b-f4f3cf2df760",
                                                "sense_id": "fd5c6d69-324b-301f-a02e-73d5b269c870",
                                                "text": "Chaque élite communautaire reprit effectivement ses troupes en main, même si des contestations demeurent, à l’instar des intifadas sanglantes opposant des tendances chrétiennes, ou de la surenchère permanente des hezbollahis face à Amal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47763e3f-165c-350f-8f17-9f98e571db72",
                                        "entry_id": "d3df9bc0-d882-3d31-8093-57e9bd84dafe",
                                        "glosses": [
                                            "Fort mouvement d’opposition populaire contre l’armée israélienne présente dans les territoires occupés et dans certaines zones dévolues à l’Autorité palestinienne (bande de Gaza, Cisjordanie)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "237648b3-556d-43e0-84ea-20f454ca1f16",
                        "source_entry_id": "c8ca7987-4eb1-31ae-b363-5ac7a3b7cbec",
                        "source_sense_description": "intifada",
                        "target_lang_word": "Intifada",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Intifada",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fba7d6fd-7ace-3819-a7b4-21e30d552e79",
                                        "entry_id": "515b4338-b3c0-3b4c-ae93-77091999828d",
                                        "glosses": [
                                            "in den von Israel besetzten palästinensischen Gebieten (Westjordanland, Gazastreifen) aufgekommene gewaltsame Widerstandsbewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d60ca0c2-3ce9-42e8-aa5f-cebabfcbd3fd",
                                                "sense_id": "fba7d6fd-7ace-3819-a7b4-21e30d552e79",
                                                "text": "„Die Jahre gingen ins Land und mit ihnen die Intifada.“"
                                            },
                                            {
                                                "example_id": "ab22d860-7894-4d09-b564-6b9b14a7fb0c",
                                                "sense_id": "fba7d6fd-7ace-3819-a7b4-21e30d552e79",
                                                "text": "„Der Volksaufstand, der seit Ende September 2000 die Palästinensergebiete erfasst hat, machte der Welt von Anfang an seine symbolischen Bezüge deutlich: In den Medien, in der Öffentlichkeit, firmierte er bald unter dem Namen ‚Al-Aksa-Intifada‘. Die Bezeichnung taugt jedoch nicht als Schlüssel zum Verständnis der Ereignisse: Sie mag einen trügerischen Déjà-vu-Effekt hervorrufen, aber zwischen dem aktuellen Aufstand und der ersten Intifada von 1987 bis 1993 gibt es keine eindeutige Kontinuität.“"
                                            },
                                            {
                                                "example_id": "99055691-a9bd-470c-bbc0-355bd242f66c",
                                                "sense_id": "fba7d6fd-7ace-3819-a7b4-21e30d552e79",
                                                "text": "„Gerade während den Intifadas – Phasen hoher Konfliktintensität – scheinen sich weder die israelische Armee noch die palästinensischen Terrororganisationen in ihrem Teufelskreis aus Vergeltungsmaßnahmen voneinander trennen zu können und dem Konflikt damit die Möglichkeit der Teilbarkeit zu bieten.“"
                                            },
                                            {
                                                "example_id": "8760465c-7c99-4670-9aa6-63c6d70c6798",
                                                "sense_id": "fba7d6fd-7ace-3819-a7b4-21e30d552e79",
                                                "text": "„Seit den beiden Intifadas (‚Erhebungen, Abschüttelungen‘) im Westjordanland und im Gazastreifen und nur zum sehr geringen Teil unter den arabischen Israelis in den Jahren 1987-1993 und 2000-2005 ist die internationale, aber auch die israelische und arabische sowie palästinensische Bereitschaft gewachsen, aus dem Westjordanland und dem Gazastreifen einen Staat Palästina zu bilden.“"
                                            },
                                            {
                                                "example_id": "9ccfad2a-ba83-490f-9dd1-3f88e0e5ce0f",
                                                "sense_id": "fba7d6fd-7ace-3819-a7b4-21e30d552e79",
                                                "text": "„Nur wenige Israelis kannten vor Beginn der Intifadas den Verlauf der grünen Linie, die bis 1967 die Grenze zum Westjordanland markierte.“"
                                            },
                                            {
                                                "example_id": "5518cf18-8283-4bea-a263-8a57383e4ff8",
                                                "sense_id": "fba7d6fd-7ace-3819-a7b4-21e30d552e79",
                                                "text": "„Abbas unterstrich, dass das palästinensische Volk keine neue Intifada plane, sondern sich für den Weg des Friedens entschieden habe.“"
                                            },
                                            {
                                                "example_id": "4135c25d-f5b0-4b13-9025-1398190594c2",
                                                "sense_id": "fba7d6fd-7ace-3819-a7b4-21e30d552e79",
                                                "text": "„Nach den beiden Intifadas 1987-1993 und 2000-2005 erfolgte 2006 der Zweite Libanonkrieg.“"
                                            },
                                            {
                                                "example_id": "99549be3-c770-4e10-8cac-59ef219212d7",
                                                "sense_id": "fba7d6fd-7ace-3819-a7b4-21e30d552e79",
                                                "text": "„Die iranische Revolution, die Ermordung Sadats, Khomeinis Fatwa gegen den Schriftsteller Salman Rushdie 1989, der irakische Einmarsch in Kuwait, die Taliban, zwei palästinensische Intifadas und natürlich der 11. September 2001, diese und andere emotional bewegenden Entwicklungen und Ereignisse haben das wetsliche Bild vom Islam nachhaltig geprägt.“"
                                            },
                                            {
                                                "example_id": "4e741471-9761-4c4e-a95b-e851551e5600",
                                                "sense_id": "fba7d6fd-7ace-3819-a7b4-21e30d552e79",
                                                "text": "„Die Lage im Westjordanland schaukelt sich derzeit wieder auf und die Frage stellt sich, ob bei einer weiteren Zuspitzung gar wieder eine – die dritte – Intifada droht.[…]Die Erste Intifada, die etwa von 1987 bis 1993 andauerte, ging als »Krieg der Steine« in die Geschichte ein. Nach einer etwa siebenjährigen Pause, in welcher sich die Hoffnungen auf die vielversprechenden Oslo-Abkommen zerschlugen, war die Zweite Intifada ab 2000 bis etwa 2005 von den perfiden Selbstmordanschlägen geprägt.“"
                                            },
                                            {
                                                "example_id": "3d7358bb-6b00-4b23-9e75-da72b322cff5",
                                                "sense_id": "fba7d6fd-7ace-3819-a7b4-21e30d552e79",
                                                "text": "„Es mehren sich auch die Warnungen vor einem dritten Palästinenseraufstand (Intifada) im Westjordanland, obwohl Abbas betont hat, er werde nie den gewaltsamen Widerstand gegen Israel unterstützen.“"
                                            },
                                            {
                                                "example_id": "c747a05b-0375-4966-bfe6-54219ed809fe",
                                                "sense_id": "fba7d6fd-7ace-3819-a7b4-21e30d552e79",
                                                "text": "„Israels Minister für Heimatschutz, der ehemalige Chef des Inlandsgeheimdiensts Avi Dichter, rechnet mit einer Eskalation der Gewalt: Es drohe der Ausbruch einer neuen Intifada in den von Israel besetzten palästinensischen Gebieten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
