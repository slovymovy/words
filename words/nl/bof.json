                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bof</w> je met je nieuwe baan?",
                            "target_lang_translations": {
                                "fr": "<w>As-tu de la chance</w> avec ton nouveau travail ?"
                            }
                        },
                        {
                            "text": "Jij <w>bof</w> je toch wel met zo'n vakantie.",
                            "target_lang_translations": {
                                "fr": "Tu <w>as vraiment de la chance</w> avec de telles vacances."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Deuxième personne du singulier du verbe 'boffen' (avoir de la chance)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "avoir de la chance",
                                "target_lang_sense_clarification": "Expression verbale pour exprimer la bonne fortune."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52387e56-a12b-3c7b-a31e-3db790cd4172",
                    "sense_definition": "gebiedende wijs van <w>boffen</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "geluk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bof</w> maar lekker met je prijs.",
                            "target_lang_translations": {
                                "fr": "<w>Profite bien de ta chance</w> avec ton prix."
                            }
                        },
                        {
                            "text": "<w>Bof</w> toch eens een keer met die loterij.",
                            "target_lang_translations": {
                                "fr": "<w>Aie enfin un peu de chance</w> à cette loterie."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Impératif du verbe 'boffen' (avoir de la chance)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "avoir de la chance",
                                "target_lang_sense_clarification": "Expression verbale pour exprimer la bonne fortune."
                            }
                        ]
                    }
                }
            ]
        }
