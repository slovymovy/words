                                "example_id": "f15fa0b9-09a6-4774-aeba-40a783b0dfb4",
                                "sense_id": "98304ad5-3df0-3c56-99f5-040d7dd5b677",
                                "text": "Każdy, kto choć raz jechał hitlerówką Wrocław-Gliwice, pamięta te betonowe płyty."
                            },
                            {
                                "example_id": "e69323ed-f82a-42c3-baa2-287a44f44fde",
                                "sense_id": "98304ad5-3df0-3c56-99f5-040d7dd5b677",
                                "text": "Przynajmniej hitlerówka do Szczecina dalej dobrze się trzyma. Nie to, co nasze drogi sypiące się po roku od remontu"
                            }
                        ],
