                                "example_id": "d5d8778d-f810-4b53-bbe2-e32f643c38ba",
                                "sense_id": "89be99bf-bd79-3f5c-9acc-0c71955d4553",
                                "text": "Une philosophie est aliénatrice si elle exclut que d’autres activités soient nécessaires pour, de concert avec la philosophie, connaître le monde."
                            },
                            {
                                "example_id": "dcba9a43-cac5-4e28-9bc7-6eb716211591",
                                "sense_id": "89be99bf-bd79-3f5c-9acc-0c71955d4553",
                                "text": "Cette analyse rend Rousseau proche de Marx et de sa vision aliénatrice de la propriété privée qui empêcherait la réalisation du bonheur humain."
                            }
                        ]
                    }
