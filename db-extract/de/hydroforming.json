                        "sense_id": "7e7c8a06-e8a9-3d89-9e51-51790dfa5733",
                        "entry_id": "a3c00312-9124-3134-8ba2-1d05d4997a2b",
                        "glosses": [
                            "das Umformen von Metall (Blechen und Rohren) im geschlossenen Formwerkzeug mittels Innendruck, der durch eine Flüssigkeit (normalerweise eine Wasseremulsion) bei Raumtemperatur auf das zu formende Metall ausgeübt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb17f11d-34f6-4616-8624-6e187bc0bbe6",
                                "sense_id": "7e7c8a06-e8a9-3d89-9e51-51790dfa5733",
                                "text": "„Hydroforming ist ein Verfahren, bei dem eine hydraulische Flüssigkeit verwendet wird, die unter hohen Druck gesetzt wird und dadurch die Bearbeitung von Blech und von Rohren ermöglicht, die in ein eigens dafür angefertigtes Werkzeug eingefügt werden.“"
                            }
                        ],
