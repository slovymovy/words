                "senses": [
                    {
                        "sense_id": "41fe8e1f-bc88-3bc2-aee4-bf065141a907",
                        "entry_id": "3f40b79c-abf6-367c-b8d1-4fc0771fb012",
                        "glosses": [
                            "Personnes, en nombre indéterminé."
                        ],
                        "tags": [
                            "Variations diaéthiques"
                        ],
                        "examples": [
                            {
                                "example_id": "f5b3d820-635a-47ef-ad4d-cd9f58181446",
                                "sense_id": "41fe8e1f-bc88-3bc2-aee4-bf065141a907",
                                "text": "Tout d’abord, se rencontrer autour d’une idée d’occupation en devenir et constater qui est là procure de vives émotions. En arrivant à une réunion plutôt secrète à laquelle des militantex ont été conviéx par contact de contact, iels découvrent des copaines des dernières occup’ ou de nouvelles têtes ; des membres d’associations et des personnes qui s’engagent localement ou des milieux militants habituel. Dans tous les cas, cela fait du bien de rencontrer ou de revoir ces gentex qui tirent à la même corde que soi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a92ba20-4550-4436-8206-9df1e56aa2fb",
                        "source_entry_id": "3f40b79c-abf6-367c-b8d1-4fc0771fb012",
                        "source_sense_id": "41fe8e1f-bc88-3bc2-aee4-bf065141a907",
                        "target_lang_word": "people",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "people",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae0b9eac-6384-38be-b064-2e513593c1c5",
                                        "entry_id": "71afe437-e0ae-3240-9754-4c76927589b4",
                                        "glosses": [
                                            "plural of person: a body of persons considered generally or collectively; a group of two or more persons."
                                        ],
                                        "tags": [
                                            "countable",
                                            "form-of",
                                            "plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56d1ab54-08ca-4417-9d03-ca241e17d006",
                                                "sense_id": "ae0b9eac-6384-38be-b064-2e513593c1c5",
                                                "text": "There were so many people at the restaurant last night."
                                            },
                                            {
                                                "example_id": "36e3a59a-bf03-482c-960c-72c445bfdc10",
                                                "sense_id": "ae0b9eac-6384-38be-b064-2e513593c1c5",
                                                "text": "These six people are waiting for the bus."
                                            },
                                            {
                                                "example_id": "0b480c41-2355-4c48-8070-9a8a0ecad4aa",
                                                "sense_id": "ae0b9eac-6384-38be-b064-2e513593c1c5",
                                                "text": "Under dictatorship, people suffered and died."
                                            },
                                            {
                                                "example_id": "2d846888-3539-497b-bda1-776039ab9c76",
                                                "sense_id": "ae0b9eac-6384-38be-b064-2e513593c1c5",
                                                "text": "XXII people was in this parrish drownd."
                                            },
                                            {
                                                "example_id": "1a249f79-6b5b-4337-97e9-0f0497876e00",
                                                "sense_id": "ae0b9eac-6384-38be-b064-2e513593c1c5",
                                                "text": "\"What a charming amusement for young people this is, Mr. Darcy! There is nothing like dancing after all. I consider it as one of the first refinements of polished society.\""
                                            },
                                            {
                                                "example_id": "71881909-eb7a-4646-a696-aee2e26b1900",
                                                "sense_id": "ae0b9eac-6384-38be-b064-2e513593c1c5",
                                                "text": "There were many wooden chairs for the bulk of his visitors, and two wicker armchairs with red cloth cushions for superior people. From the packing-cases had emerged some Indian clubs,[…], and all these articles[…]made a scattered and untidy decoration that Mrs. Clough assiduously dusted and greatly cherished."
                                            },
                                            {
                                                "example_id": "61169f8e-d9aa-45f8-a4a8-b6c775d62de9",
                                                "sense_id": "ae0b9eac-6384-38be-b064-2e513593c1c5",
                                                "text": "“[…] the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. You know. The kind that have mottoes like\n Here's rattling good luck and roaring good cheer, / With lashings of food and great hogsheads of beer.[…]”"
                                            },
                                            {
                                                "example_id": "103c77eb-a774-47a8-8fdd-2709f711f3ff",
                                                "sense_id": "ae0b9eac-6384-38be-b064-2e513593c1c5",
                                                "text": "But poverty’s scourge is fiercest below $1.25 (the average of the 15 poorest countries’ own poverty lines, measured in 2005 dollars and adjusted for differences in purchasing power): people below that level live lives that are poor, nasty, brutish and short."
                                            },
                                            {
                                                "example_id": "196a0939-9f53-4180-8cf4-8b5a1647ad91",
                                                "sense_id": "ae0b9eac-6384-38be-b064-2e513593c1c5",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about[…], or offering services that let you[…]\"share the things you love with the world\" and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            },
                                            {
                                                "example_id": "28504c21-fd5f-47f6-9dc1-57d1df6fa555",
                                                "sense_id": "ae0b9eac-6384-38be-b064-2e513593c1c5",
                                                "text": "Mostly, the microbiome is beneficial. It helps with digestion and enables people to extract a lot more calories from their food than would otherwise be possible. Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb9e3ec8-78eb-3f45-b281-9c8a2f160441",
                                        "entry_id": "71afe437-e0ae-3240-9754-4c76927589b4",
                                        "glosses": [
                                            "Persons forming or belonging to a particular group, such as a nation, class, ethnic group, country, family, etc."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1d8b688-eebb-4697-9413-bca3b87d89ff",
                                                "sense_id": "bb9e3ec8-78eb-3f45-b281-9c8a2f160441",
                                                "text": "`So, oh Holly. This people was an old people before the Egyptians were.'"
                                            },
                                            {
                                                "example_id": "985a2ead-c9c3-4b68-8868-6bfdc1aabb33",
                                                "sense_id": "bb9e3ec8-78eb-3f45-b281-9c8a2f160441",
                                                "text": "a people apart"
                                            },
                                            {
                                                "example_id": "4bbe20b6-e0c1-4785-a078-5d885b798fc1",
                                                "sense_id": "bb9e3ec8-78eb-3f45-b281-9c8a2f160441",
                                                "text": "an industrious people"
                                            },
                                            {
                                                "example_id": "9a561a68-ff2a-4b0e-b3a4-a0ff84c0fed7",
                                                "sense_id": "bb9e3ec8-78eb-3f45-b281-9c8a2f160441",
                                                "text": "the indigenous peoples of Europe"
                                            },
                                            {
                                                "example_id": "49082b8d-0561-426e-b692-ed2927727393",
                                                "sense_id": "bb9e3ec8-78eb-3f45-b281-9c8a2f160441",
                                                "text": "the native peoples of Borneo"
                                            },
                                            {
                                                "example_id": "3b222ad1-b356-4348-9795-003219da99d8",
                                                "sense_id": "bb9e3ec8-78eb-3f45-b281-9c8a2f160441",
                                                "text": "The team auctioned off the right to name the new species to publicize the find and raise awareness and funds for the indigenous Lahu people of northern Thailand, a group that Sippawat is part of."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2c5e0aa-e978-3479-a040-f618d0cdba01",
                                        "entry_id": "71afe437-e0ae-3240-9754-4c76927589b4",
                                        "glosses": [
                                            "A group of persons regarded as being servants, followers, companions or subjects of a ruler or leader."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d36aad31-e4cc-493c-91f7-fdd3902c7710",
                                                "sense_id": "a2c5e0aa-e978-3479-a040-f618d0cdba01",
                                                "text": "Moses said, \"Let my people go.\""
                                            },
                                            {
                                                "example_id": "9b8bc0cc-1329-4cb6-9706-e2ee4a58ceaf",
                                                "sense_id": "a2c5e0aa-e978-3479-a040-f618d0cdba01",
                                                "text": "his people were weary"
                                            },
                                            {
                                                "example_id": "7195a937-e93c-4559-8ebb-ca00a029b9dd",
                                                "sense_id": "a2c5e0aa-e978-3479-a040-f618d0cdba01",
                                                "text": "And Dauid reigned ouer all Iſrael, and Dauid executed iudgement and iuſtice vnto all his people."
                                            },
                                            {
                                                "example_id": "acbd5fb9-6410-47a3-acb5-464125c28afb",
                                                "sense_id": "a2c5e0aa-e978-3479-a040-f618d0cdba01",
                                                "text": "The ox knows its owner, and the ass its master's crib; but Israel does not know, my people does not understand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73e1f4ab-755b-36e2-ab85-b5173e79bc5a",
                                        "entry_id": "71afe437-e0ae-3240-9754-4c76927589b4",
                                        "glosses": [
                                            "One's colleagues or employees."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "144b6d8a-081a-40a9-a2cc-5b0784f1e6db",
                                                "sense_id": "73e1f4ab-755b-36e2-ab85-b5173e79bc5a",
                                                "text": "I'll have my people call your people."
                                            },
                                            {
                                                "example_id": "abf83d0d-26be-4b71-97fe-b696428b7c12",
                                                "sense_id": "73e1f4ab-755b-36e2-ab85-b5173e79bc5a",
                                                "text": "I have my people working on it."
                                            },
                                            {
                                                "example_id": "fd6c65dd-7fca-491e-bbaf-8aa732302b6f",
                                                "sense_id": "73e1f4ab-755b-36e2-ab85-b5173e79bc5a",
                                                "text": "Kennedy looked down at Flood's desk and thought about the possibilities. \"Can you locate him?\"\n\"I already have my people checking on all three. So far I've only been able to confirm the whereabouts of the Jordanian officer.\""
                                            },
                                            {
                                                "example_id": "3903a3a6-9e76-40f0-89f3-ae12b6c7e3d6",
                                                "sense_id": "73e1f4ab-755b-36e2-ab85-b5173e79bc5a",
                                                "text": "Can I have one of my people get back to your people, Mr. President?\" She tried to slam the phone back into the base and failed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e6dad22-d256-3aa3-8021-50720af4f6a7",
                                        "entry_id": "71afe437-e0ae-3240-9754-4c76927589b4",
                                        "glosses": [
                                            "A person's ancestors, relatives or family."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66ba89e3-6005-49fe-b297-feda7946a1d6",
                                                "sense_id": "3e6dad22-d256-3aa3-8021-50720af4f6a7",
                                                "text": "My people lived through the Black Plague and the Thirty Years War."
                                            },
                                            {
                                                "example_id": "9c4c10d1-0b6b-4b2a-a0bf-d7a6ea33d1db",
                                                "sense_id": "3e6dad22-d256-3aa3-8021-50720af4f6a7",
                                                "text": "His people live out west."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a70b2574-39bf-3424-b531-d36345f59ea3",
                                        "entry_id": "71afe437-e0ae-3240-9754-4c76927589b4",
                                        "glosses": [
                                            "The mass of a community as distinguished from a special class (elite); the commonalty; the populace; the vulgar; the common crowd; the citizens."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11b8a3af-5ab4-4660-b741-07840fdbfca0",
                                                "sense_id": "a70b2574-39bf-3424-b531-d36345f59ea3",
                                                "text": "The people have successfully stood up against tyranny and totalitarianism."
                                            },
                                            {
                                                "example_id": "875abbb8-e515-435d-aae0-8a14ffa5a7d5",
                                                "sense_id": "a70b2574-39bf-3424-b531-d36345f59ea3",
                                                "text": "The election is over and the people have spoken."
                                            },
                                            {
                                                "example_id": "b8e2ffb2-bf7e-4d34-8a23-df0e8609440b",
                                                "sense_id": "a70b2574-39bf-3424-b531-d36345f59ea3",
                                                "text": "The people won't tolerate so much corruption any more!"
                                            },
                                            {
                                                "example_id": "f74c129f-a7be-4cc9-99e2-b2a7e74efffd",
                                                "sense_id": "a70b2574-39bf-3424-b531-d36345f59ea3",
                                                "text": "The people have spoken, the bastards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e913105d-dfa9-3d5b-b913-a123124ca83c",
                                        "entry_id": "71afe437-e0ae-3240-9754-4c76927589b4",
                                        "glosses": [
                                            "People in general, humans, by extension sentient beings real or fictional."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2a76a54-a1d1-43c8-be5a-d30d2240a10c",
                                                "sense_id": "e913105d-dfa9-3d5b-b913-a123124ca83c",
                                                "text": "People don't like it when you tweak their noses."
                                            },
                                            {
                                                "example_id": "825b4abc-8c75-4d9a-8dfd-49d7e8cc11fc",
                                                "sense_id": "e913105d-dfa9-3d5b-b913-a123124ca83c",
                                                "text": "Teachers are people too."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "people",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bbb850a-ff23-329e-8cfe-70e1eaceac3f",
                                        "entry_id": "e9937a90-12ff-3f26-90c1-33e6bc1c8760",
                                        "glosses": [
                                            "To stock with people or inhabitants; to fill as with people; to populate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "749d4673-20f9-4692-998b-dc643a06d88a",
                                                "sense_id": "2bbb850a-ff23-329e-8cfe-70e1eaceac3f",
                                                "text": "He would not be alone, who all things can; / But peopled Heav'n with Angels, Earth with Man."
                                            },
                                            {
                                                "example_id": "0df73a4c-4f39-4d99-84aa-f7c22071da09",
                                                "sense_id": "2bbb850a-ff23-329e-8cfe-70e1eaceac3f",
                                                "text": "Scenes, long since forgotten, had been peopling his solitude with one still cherished image paramount over all; one young fair face, whose sweet eyes seemed to look upon him reproachfully:..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eba7d6dd-3a0e-301e-adc4-bf5e1a4316c8",
                                        "entry_id": "e9937a90-12ff-3f26-90c1-33e6bc1c8760",
                                        "glosses": [
                                            "To become populous or populated."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9dce8d4d-c984-3325-80e5-2cdd83c0b13f",
                                        "entry_id": "e9937a90-12ff-3f26-90c1-33e6bc1c8760",
                                        "glosses": [
                                            "To inhabit; to occupy; to populate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b60d96d8-2193-43ab-b147-1fd4c8a2ac99",
                                                "sense_id": "9dce8d4d-c984-3325-80e5-2cdd83c0b13f",
                                                "text": "[…] / As thick and numberless / As the gay motes that people the Sun Beams, / […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d8245bf-a877-3d24-be0c-8da5d9603079",
                                        "entry_id": "e9937a90-12ff-3f26-90c1-33e6bc1c8760",
                                        "glosses": [
                                            "To interact with people; to socialize."
                                        ],
                                        "tags": [
                                            "informal",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0122f75-f9d7-4d8b-b4b7-0917cf3d9d53",
                                                "sense_id": "6d8245bf-a877-3d24-be0c-8da5d9603079",
                                                "text": "I don't people well.” “Not peopling well is a crap excuse,” I retorted, and started to step around him, but a sudden thought occurred to me."
                                            },
                                            {
                                                "example_id": "e70af370-1324-4568-ba80-39507c4fc820",
                                                "sense_id": "6d8245bf-a877-3d24-be0c-8da5d9603079",
                                                "text": "My head tilted as Calvin said, \"Don't worry about him. He just doesn't people well.\nThe fuck? I people. Sometimes. With people I know."
                                            },
                                            {
                                                "example_id": "0fb2c320-940f-487f-8a9b-ede049f05077",
                                                "sense_id": "6d8245bf-a877-3d24-be0c-8da5d9603079",
                                                "text": "I don't people well.” He laughed at that. “You do okay,” he assured her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
