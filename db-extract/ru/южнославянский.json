                ],
                "senses": [
                    {
                        "sense_id": "e46c12db-0395-3ad7-bded-bfb26721c143",
                        "entry_id": "e45e4f47-c6b7-3d77-8d2d-293194ae842e",
                        "glosses": [
                            "относящийся к южным славянам"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "adea4d7e-824a-3bcf-aff3-1f6c6ae9c5e4",
                        "entry_id": "e45e4f47-c6b7-3d77-8d2d-293194ae842e",
                        "glosses": [
                            "относящийся к языкам южных славян"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64b3a9d1-a158-4b06-b3f4-9bd686687b7c",
                        "source_entry_id": "e45e4f47-c6b7-3d77-8d2d-293194ae842e",
                        "target_lang_word": "südslawisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "südslawisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5080de5b-7ec8-3398-b8c2-8da1606ba7de",
                                        "entry_id": "bbb494ca-7205-3f2b-ac97-e1f13113621e",
                                        "glosses": [
                                            "die Südslawen oder die südslawischen Sprachen betreffend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7c4334b-1906-4899-ad3c-33c45ffa038a",
                                                "sense_id": "5080de5b-7ec8-3398-b8c2-8da1606ba7de",
                                                "text": "„Heißt es im Vertrag, die Sprache des Balkanstaates sei ‚Mazedonisch‘, wird direkt im Anschluss erklärt, es handele sich dabei um eine südslawische Sprache.“"
                                            },
                                            {
                                                "example_id": "3264c5ed-4bf1-4fd0-8486-01a33c895708",
                                                "sense_id": "5080de5b-7ec8-3398-b8c2-8da1606ba7de",
                                                "text": "„Unter Tito wurde das von 1918 bis 1941 bestehende südslawische Königreich das ‚alte Jugoslawien‘ genannt.“"
                                            },
                                            {
                                                "example_id": "60ed2106-ab56-4a3c-bbf7-962631dd635a",
                                                "sense_id": "5080de5b-7ec8-3398-b8c2-8da1606ba7de",
                                                "text": "„In Laibach hat vor einigen Wochen ein südslawischer Kongreß stattgefunden, auf dem polnische Vertreter aus Galizien erschienen, sich mit den südslawischen Wünschen solidarisch erklärten und überschwenglich gefeiert wurden.“"
                                            },
                                            {
                                                "example_id": "f238a3ce-d0e1-4eb6-80eb-3ed4bd4ed7f9",
                                                "sense_id": "5080de5b-7ec8-3398-b8c2-8da1606ba7de",
                                                "text": "„Für einen bosnischen Serben wie Princip war es selbstverständlich, dass die Hauptstadt eines südslawischen Staates Belgrad sein und das serbische Element darin dominieren müsse; so kam es auch.“"
                                            },
                                            {
