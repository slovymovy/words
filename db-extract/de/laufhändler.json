                ],
                "senses": [
                    {
                        "sense_id": "582c98ad-85d4-3903-ac0e-880399701f28",
                        "entry_id": "c1656fd7-39af-37e8-971b-2827f19348de",
                        "glosses": [
                            "Fachhändler (Sporthändler) im Bereich Laufsport; Person oder Firma, die sich auf den Verkauf von Laufsportartikeln spezialisiert hat"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "c0687d88-a6d9-4c0e-9a3b-890e41e8fbbb",
                                "sense_id": "582c98ad-85d4-3903-ac0e-880399701f28",
                                "text": "„Mein Laufhändler erklärte mir, dass die CEP Produkte besser sind als Falke, da CEP eine verstärkte Kompression im unteren Bereich der Unterschenkel aufweist.“"
                            },
                            {
                                "example_id": "6f1c4079-bef8-4082-8e71-5c50e49e798f",
                                "sense_id": "582c98ad-85d4-3903-ac0e-880399701f28",
                                "text": "„Ich bin diesem Schuhmodell treu geblieben, seitdem mir mein Laufhändler den Nimbus 11 erstmalig empfohlen hat.“"
                            },
                            {
                                "example_id": "68675447-0e00-4e59-81cc-7348aa4a9121",
                                "sense_id": "582c98ad-85d4-3903-ac0e-880399701f28",
                                "text": "„Ich suchte den Laufhändler meines Vertrauens auf und ließ mich beraten.“"
                            },
                            {
                                "example_id": "d3be871b-21fc-4440-8cfb-75066cdbfc67",
                                "sense_id": "582c98ad-85d4-3903-ac0e-880399701f28",
                                "text": "„Die Neueröffnung in Bonn ist für die Verbundgruppe das Pilotprojekt, um die besten Laufhändler Europas unter dem Dach ‚ABSOLUTE‘ zu bündeln.“"
                            },
                            {
                                "example_id": "9fae7998-c9b9-4689-b498-1e808251f595",
                                "sense_id": "582c98ad-85d4-3903-ac0e-880399701f28",
                                "text": "„Wie die vergangenen Monate tatsächlich aussahen und was die Händler über ihre nahe Zukunft denken, hat ISPO.com bei den Laufhändlern, in den Outdoorläden, in den Radgeschäften und bei den Boardshops erfragt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
