                ],
                "senses": [
                    {
                        "sense_id": "e0206379-6011-3ed3-a66c-c7f54cead30f",
                        "entry_id": "04910e59-8bce-39f7-be22-04031d13cd7d",
                        "glosses": [
                            "Petit du renard et de la renarde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c13cb87-904c-4627-aad8-59f3d1167b83",
                                "sense_id": "e0206379-6011-3ed3-a66c-c7f54cead30f",
                                "text": "Deux renardeaux s’affrontent sur l’herbe, sous une sublime lumière de fin de journée."
                            },
                            {
                                "example_id": "2dee2dbe-a310-45b5-8b5a-fcf8ec7cef3b",
                                "sense_id": "e0206379-6011-3ed3-a66c-c7f54cead30f",
                                "text": "Un petit ampède s’amuse d’un renardeau en venant se poser sur son museau."
                            },
                            {
                                "example_id": "ff277bd8-5f39-4076-9e2e-c31c8f881787",
                                "sense_id": "e0206379-6011-3ed3-a66c-c7f54cead30f",
                                "text": "Un renardeau photographié en avril 2019."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e2a56d7-4638-4b03-bd9c-fd78d3029de2",
                        "source_entry_id": "04910e59-8bce-39f7-be22-04031d13cd7d",
                        "source_sense_id": "e0206379-6011-3ed3-a66c-c7f54cead30f",
                        "source_sense_description": "Petit du renard",
                        "target_lang_word": "Fuchswelpe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fuchswelpe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d55b3899-dd07-3134-9434-f590389cf5ed",
                                        "entry_id": "c63b31f4-1b6d-3338-aa65-f803a1cc6537",
                                        "glosses": [
                                            "Jungtier eines Fuchses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36a53fb6-2464-4700-b741-d66c8b4fe6d7",
                                                "sense_id": "d55b3899-dd07-3134-9434-f590389cf5ed",
                                                "text": "„Voraussetzung dafür ist, daß diese Ammen Junge haben, die etwa im Alter der Fuchswelpen sind.“"
                                            },
                                            {
                                                "example_id": "08f4e1fc-5267-407d-aee7-1109821e5f6d",
                                                "sense_id": "d55b3899-dd07-3134-9434-f590389cf5ed",
                                                "text": "„In der Natur wird es wohl anders sein, da der Fuchswelpe dort den scharfen Ruch des Fuchsbaues mitbekommt.“"
                                            },
                                            {
                                                "example_id": "5d6d2831-a6e6-4994-a539-80bf7ea8cffa",
                                                "sense_id": "d55b3899-dd07-3134-9434-f590389cf5ed",
                                                "text": "„Sie sind kleiner als die Fuchswelpen und wiegen zwischen 60 und 85 g, Rumpflänge 11–13 cm, Schwanz 4,2–6 cm, […]“"
                                            },
                                            {
                                                "example_id": "e3c34e4d-f381-4072-8722-c1cb4c31340a",
                                                "sense_id": "d55b3899-dd07-3134-9434-f590389cf5ed",
                                                "text": "„Vieles deutet darauf hin, daß die Fuchswelpen sensibler sind als die Nerzwelpen, […]“"
                                            },
                                            {
                                                "example_id": "3f6878b2-ae14-41c8-8258-ff2025caf6b8",
                                                "sense_id": "d55b3899-dd07-3134-9434-f590389cf5ed",
                                                "text": "„Mit solchen Begriffen kann ich ohne Zusatzhypothese den Kommunikationsvorgang beschreiben, bei dem das Quärren von Fuchswelpen die Fähe nach dem Hören der Laute veranlaßt, sich ihnen zu nähern, um ein Verhalten auszuführen, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e464c863-455c-4d5c-9eed-567bb27f542c",
                        "source_entry_id": "04910e59-8bce-39f7-be22-04031d13cd7d",
                        "source_sense_id": "e0206379-6011-3ed3-a66c-c7f54cead30f",
                        "source_sense_description": "Petit du renard",
                        "target_lang_word": "fox cub",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
