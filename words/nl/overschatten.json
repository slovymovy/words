                },
                {
                    "sense_id": "f477b104-648e-378f-9eec-f08b982ddc4e",
                    "sense_definition": "meervoud verleden tijd van <w>overschatten</w>",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij <w>overschatten</w> vorig jaar de kosten van het project aanzienlijk.",
                            "target_lang_translations": {
                                "en": "We significantly <w>overestimated</w> the costs of the project last year."
                            }
