                "senses": [
                    {
                        "sense_id": "a24e7f9d-6180-3c87-8a2c-371456b0c2dd",
                        "entry_id": "567ee454-0816-38c4-9e6e-11a5b03ccb21",
                        "glosses": [
                            "A vegetable."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "c4418a48-be7d-4b01-ba05-80b5e8793099",
                                "sense_id": "a24e7f9d-6180-3c87-8a2c-371456b0c2dd",
                                "text": "There was lots of rice, at least 20 different \"veggies\" and all kinds of soups."
                            },
                            {
                                "example_id": "19352c4b-c7bb-4604-942b-0e51436a919a",
                                "sense_id": "a24e7f9d-6180-3c87-8a2c-371456b0c2dd",
                                "text": "and eight small dishes of 'veggies,' as we have taught our children lovingly to term that important item of food known as vegetables."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4613065-cda9-3960-9637-1cde9aa7e43c",
                        "entry_id": "567ee454-0816-38c4-9e6e-11a5b03ccb21",
                        "glosses": [
                            "A vegetarian."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "325935d9-0cc5-471a-8501-467411de3930",
                                "sense_id": "b4613065-cda9-3960-9637-1cde9aa7e43c",
                                "text": "Vegetarian/vegan meals at most colleges are only pretty average. They have a long way to go to provide nutritionally adequate and tasty food for veggies."
                            }
                        ]
                    }
                ],
