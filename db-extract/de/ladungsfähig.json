                "senses": [
                    {
                        "sense_id": "8139244c-17f3-36a6-9a14-a448747b6d62",
                        "entry_id": "04452d6e-ea66-3cdd-a256-e7105eca4d8c",
                        "glosses": [
                            "so geartet, dass damit ein Zugang zu einer Person gewährleistet/möglich ist, dass eine Zustellung eines Dokumentes erfolgen kann"
                        ],
                        "tags": [
                            "Rechtssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "260645cf-78d9-4ed3-9e57-eeedfedc1f64",
                                "sense_id": "8139244c-17f3-36a6-9a14-a448747b6d62",
                                "text": "Wir sind noch dabei, eine ladungsfähige Adresse zu ermitteln."
                            },
                            {
                                "example_id": "b36f90f0-f514-484e-b713-f78514ff6e8a",
                                "sense_id": "8139244c-17f3-36a6-9a14-a448747b6d62",
                                "text": "Die ladungsfähige Anschrift ist in der Regel und in der juristischen Praxis der nachgewiesene Wohnsitz einer Person."
                            },
                            {
                                "example_id": "04009390-598f-41f4-9760-d3bdcb87d9c4",
                                "sense_id": "8139244c-17f3-36a6-9a14-a448747b6d62",
                                "text": "„Die Angabe der ladungsfähigen Adresse ist daher eine zwingende Voraussetzung für die ordnungsgemäße Erhebung einer Klage vor den ordentlichen Gerichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
