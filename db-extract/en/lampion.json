                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc3e4385-1909-4d23-b366-72e2a5dd51d0",
                                                "sense_id": "6f1504a4-0ac5-3039-86ea-3616aee4d9bd",
                                                "text": "W sieni słabo oświetlonej olejnym kagankiem ktoś zastąpił mi drogę."
                                            }
                                        ],
