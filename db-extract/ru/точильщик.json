                                        "tags": [
                                            "Northern-US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67285971-5236-443a-9da1-c5e130eaafe6",
                                                "sense_id": "aea2a839-04b5-3eab-8a4b-35e82a4526b7",
                                                "text": "I am going to the deli to get a grinder for lunch."
                                            },
                                            {
                                                "example_id": "dcab9245-2853-4054-b6bb-3cc940d2a29e",
                                                "sense_id": "aea2a839-04b5-3eab-8a4b-35e82a4526b7",
                                                "text": "It was reported that the recipes for the secret sauce and grinder sandwiches were proprietary, known only to the current president of the corporation and the former owner of the restaurant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57bacc05-1f3a-3f4c-9380-028c4f43ceff",
                                        "entry_id": "812b4e80-8463-3809-80f5-ad81e069140b",
                                        "glosses": [
                                            "A submarine sandwich, a sandwich made on a long, cylindrical roll.",
                                            "In particular, a submarine sandwich (hoagie) that is toasted or baked and typically does not contain lettuce."
                                        ],
                                        "tags": [
                                            "Northern-US",
                                            "Pennsylvania"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d3ec93a-5137-31f4-a5a3-3ca7aa72301f",
                                        "entry_id": "812b4e80-8463-3809-80f5-ad81e069140b",
                                        "glosses": [
                                            "A kitchen gadget for processing coffee, herbs etc. into small or powdered pieces."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c31a281e-e285-31b2-914d-5d88a8163010",
                                        "entry_id": "812b4e80-8463-3809-80f5-ad81e069140b",
                                        "glosses": [
                                            "The restless flycatcher (Myiagra inquieta) of Australia, which makes a noise like a scissors grinder."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27f615cf-75c4-3084-a73e-e11e68e29f16",
                                        "entry_id": "812b4e80-8463-3809-80f5-ad81e069140b",
                                        "glosses": [
                                            "A fan or performer of grindcore music."
