                ],
                "senses": [
                    {
                        "sense_id": "d48ad107-e10b-3e89-9ba6-2b5d1a25179f",
                        "entry_id": "9bceac07-bb92-340b-a340-db9012e875e6",
                        "glosses": [
                            "Person, die einen Marathonlauf gewonnen hat"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "86855ceb-52fb-4c75-b375-720171cdf201",
                                "sense_id": "d48ad107-e10b-3e89-9ba6-2b5d1a25179f",
                                "text": "„Mir fällt es nur ein wenig schwer, nach rechts auf den orangefarbenen Teppich zu laufen, ganz kurz bevor der Marathonsieger auch ankommt.“"
                            },
                            {
                                "example_id": "97acb3f6-977f-4a01-96c4-2770f8de7793",
                                "sense_id": "d48ad107-e10b-3e89-9ba6-2b5d1a25179f",
                                "text": "„Der letztjährige Marathonsieger Linus Bolzern bietet eine Paddellektion und einen Trainingsplan bis zum Marathon vom 16. September an – im Wert von 500 Franken.“"
                            },
                            {
                                "example_id": "b685c30f-298b-4cf8-8c65-bcacf009cb2f",
                                "sense_id": "d48ad107-e10b-3e89-9ba6-2b5d1a25179f",
                                "text": "„Ganz gleich, ob Hobby-Jogger oder Marathonsieger – du hast das passende Präsent für Läufer gewiss bereits gefunden.“"
                            },
                            {
                                "example_id": "64c9188f-d2eb-42e0-8e45-d010782edd59",
                                "sense_id": "d48ad107-e10b-3e89-9ba6-2b5d1a25179f",
                                "text": "„Tatsächlich war der Marathonsieger Fabian Fiedler selbst Polizist und gehörte zu einer ganzen Hundertschaft von Polizist*innen [sic] aus allen Bundesländern die eingesetzt waren, um sich im Marathon um die Polizeimeisterehre zu messen.“"
                            },
                            {
                                "example_id": "fb14250f-8179-43d0-9594-00bfa71bc223",
                                "sense_id": "d48ad107-e10b-3e89-9ba6-2b5d1a25179f",
                                "text": "„Der Trainer des späteren Marathonsiegers lief allein an der Spitze und war deshalb mit seiner Zielzeit von 01:05:34 h mehr als zufrieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
