                "senses": [
                    {
                        "sense_id": "8872b737-7385-35b1-bf02-1184c3922c32",
                        "entry_id": "139ea0be-6910-3ce7-b7e5-ad2c15c017fb",
                        "glosses": [
                            "Wahrnehmung, Verständnis der Wirklichkeit, von wahren Gegebenheiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d8e0f97-189b-434b-ba65-c75195ec586b",
                                "sense_id": "8872b737-7385-35b1-bf02-1184c3922c32",
                                "text": "„Vision gelingt nur durch die auf Realitätssinn beruhende Synthese von Offenheit und Spontaneität.“"
                            },
                            {
                                "example_id": "6e80407b-4553-4dfb-9281-6ca7a0ea4608",
                                "sense_id": "8872b737-7385-35b1-bf02-1184c3922c32",
                                "text": "„Durch Vertrauen in meine Wahrnehmung stärke ich meinen Realitätssinn.“"
                            },
                            {
                                "example_id": "76e242b3-cced-432b-8275-bac29d360d24",
                                "sense_id": "8872b737-7385-35b1-bf02-1184c3922c32",
                                "text": "„Eine gesunde Portion Realitätssinn hilft zu merken, welcher Weg oder welches Vorgehen für geeignet oder nicht geeignet ist.“"
                            },
                            {
                                "example_id": "ab185960-eb7f-469d-968d-569008339e1d",
                                "sense_id": "8872b737-7385-35b1-bf02-1184c3922c32",
                                "text": "„Eher ist es ein visionärer Realitätssinn, der Kraft seines spielerischen Wesens mögliche Konfigurationen sieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
