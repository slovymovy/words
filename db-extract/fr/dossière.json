                        "glosses": [
                            "Partie d’une cuirasse protégeant le dos."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4a92db87-6f0b-49e6-9e5e-997c49f92b00",
                                "sense_id": "5a91b2e3-203a-39ca-8eca-b30370044c7c",
                                "text": "Plastron et dossière d’une cuirasse milanaise, ornés de bandes gravées, de la fin du XVᵉ siècle."
                            }
                        ]
                    },
                    {
                        "sense_id": "eba06da0-2c47-30a6-9393-0121fdc63595",
                        "entry_id": "27ab14df-5a9f-30d4-9b9e-69bb6c426e2e",
                        "glosses": [
                            "Pièce du harnais du cheval se plaçant sur le dos et supportant les brancards."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caa559d6-aaca-49ea-99d8-15542a440666",
                                "sense_id": "eba06da0-2c47-30a6-9393-0121fdc63595",
                                "text": "C’est une selle forte, mais étroite, destinée à supporter la dossière ; elle a pour base un arçon ou fût formé de deux pièces de bois concaves et placées sur deux forts panneaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "707e7043-beda-39dd-ac9a-ad2a76627af6",
                        "entry_id": "27ab14df-5a9f-30d4-9b9e-69bb6c426e2e",
                        "glosses": [
                            "Partie supérieure de la carapace (d'une tortue...)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be86c0ee-b376-447d-bcaf-331a3245c333",
                                "sense_id": "707e7043-beda-39dd-ac9a-ad2a76627af6",
                                "text": "Les lésions de la dossière sont pourtant relativement fréquentes chez les chéloniens."
                            }
                        ]
                    }
