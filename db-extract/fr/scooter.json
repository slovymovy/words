                                        "entry_id": "cce1edba-b52d-3514-8b48-7359d2b52950",
                                        "glosses": [
                                            "zweirädriges, einspuriges Fahrzeug mit Antriebsmotor und Karosserie, das ein Bodenblech als Trittbrett besitzt"
                                        ],
                                        "tags": [],
