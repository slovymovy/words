                                "target_senses": [
                                    {
                                        "sense_id": "8fc60378-0c08-3ed3-a559-807537c2b560",
                                        "entry_id": "78566bd0-1e54-3fd9-9743-4f5f7987cba1",
                                        "glosses": [
                                            "不肯定，不確定"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d286e3bd-2962-4479-bff7-8e4b13ce45cc",
                                                "sense_id": "8fc60378-0c08-3ed3-a559-807537c2b560",
                                                "text": "別等我吃晚飯，我不一定會回家。"
                                            },
                                            {
                                                "example_id": "17931512-bb2b-4b2c-b950-35cc396c4597",
                                                "sense_id": "8fc60378-0c08-3ed3-a559-807537c2b560",
                                                "text": "别等我吃晚饭，我不一定会回家。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2e05e5d-ca08-498c-be5d-9644ede9c9cb",
                        "source_entry_id": "d55fe581-ded7-39d3-875f-4babbc5178f3",
                        "source_sense_id": "ef28354a-f9f9-36d8-b725-b2d586d004a0",
                        "target_lang_word": "необязательно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "необязательно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a721a709-b762-3ce4-b0ff-76f157574f1e",
                                        "entry_id": "92420d00-a1b2-3546-adb9-87e9e64f0b4c",
                                        "glosses": [
                                            "наречие к необязательный; не будучи обязательным; не непременно"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "290f55fe-d09c-43b4-a87d-e4243b85f262",
                                                "sense_id": "a721a709-b762-3ce4-b0ff-76f157574f1e",
                                                "text": "Взглянул он на этот «всечеловеческий тип» всесторонне, приводя цитаты из разных критиков, и забрел в такие дебри, что председатель должен был остановить его замечанием, что «знание иностранной литературы для присяжных необязательно»."
                                            },
                                            {
                                                "example_id": "18445c5c-284a-442e-90bf-041a20786287",
                                                "sense_id": "a721a709-b762-3ce4-b0ff-76f157574f1e",
                                                "text": "Газеты привозятся не каждый день, да ведь и читать их необязательно."
                                            },
                                            {
                                                "example_id": "a1fbf990-0f1b-4015-bfc7-19e1eb73b6a2",
                                                "sense_id": "a721a709-b762-3ce4-b0ff-76f157574f1e",
                                                "text": "Но нам и необязательно ехать прямо в Европу."
                                            },
                                            {
                                                "example_id": "b661dc21-2120-4547-a553-1e826091d502",
                                                "sense_id": "a721a709-b762-3ce4-b0ff-76f157574f1e",
                                                "text": "Жить стало необязательно, раз ни в ком из живущих не было по отношению к Симону смертельной необходимости."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d403067-12da-3b10-a9ce-ab0f741e61e4",
                                        "entry_id": "92420d00-a1b2-3546-adb9-87e9e64f0b4c",
                                        "glosses": [
                                            "предик. оценочная характеристика чьего-либо поведения, чьих-либо действий, поступков как не являющихся безусловными, непременными для исполнения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "800a4b8e-62ba-46fa-9c71-dd9dcb411db0",
                                                "sense_id": "3d403067-12da-3b10-a9ce-ab0f741e61e4",
                                                "text": "Елена несколько секунд пристально, с улыбкой в глазах рассматривала Самгина, затем скорчила рожицу в комически печальную гримасу и, вздохнув, спросила: — Будем говорить о Толстом? — Это — необязательно, — сказал Самгин."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
