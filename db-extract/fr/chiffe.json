                "forms": [
                    {
                        "form_id": "69d082ae-bf36-4c02-90d9-875f9d046443",
                        "entry_id": "f45a2b43-4a6d-3a0a-975c-78fe6d451bc7",
                        "tags": [
                            "plural"
                        ],
                        "form": "chiffes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f947ec4-7613-3ead-b4e9-9c6b9338f7de",
                        "entry_id": "f45a2b43-4a6d-3a0a-975c-78fe6d451bc7",
                        "glosses": [
                            "Mauvaise étoffe, loque."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "9ba7b00e-aa31-465f-b887-d43ebb73903b",
                                "sense_id": "4f947ec4-7613-3ead-b4e9-9c6b9338f7de",
                                "text": "Ce n’est que de la chiffe bonne pour le papier."
                            },
                            {
                                "example_id": "08867c4c-f121-4ded-a46c-094e389d7a1c",
                                "sense_id": "4f947ec4-7613-3ead-b4e9-9c6b9338f7de",
                                "text": "Que le visage du vieillard fût réduit à des os sur lesquels pendait une peau flétrie et plissée comme une chiffe – il y était préparé."
                            }
                        ]
                    },
                    {
                        "sense_id": "022c9068-0678-39f9-be0b-a7b18c3c0045",
                        "entry_id": "f45a2b43-4a6d-3a0a-975c-78fe6d451bc7",
                        "glosses": [
                            "Personne de caractère faible, sans énergie."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0ce0e1f5-c0d3-4dd8-884b-1fb76bb262e4",
                                "sense_id": "022c9068-0678-39f9-be0b-a7b18c3c0045",
                                "text": "Elle s’affaissa sur les genoux, à bout de forces, glissa ainsi qu’une chiffe dans la neige, dont les flocons, silencieusement, l’ensevelirent."
                            },
                            {
                                "example_id": "df28046a-4419-47d3-99aa-ca8824f36e79",
                                "sense_id": "022c9068-0678-39f9-be0b-a7b18c3c0045",
                                "text": "Elle restait là où elle était, immobile, inconsolable et comme une chiffe aux mains des bonnes femmes qui s'efforçaient de la réconforter."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a190217-a84d-3b58-9ec6-de6337b45e30",
                        "entry_id": "f45a2b43-4a6d-3a0a-975c-78fe6d451bc7",
                        "glosses": [
                            "Nom local de la vandoise."
                        ],
                        "tags": [
                            "Lorraine"
                        ],
                        "examples": [
                            {
                                "example_id": "3148aed7-eb73-4f36-b62b-ebedddf1413e",
                                "sense_id": "4a190217-a84d-3b58-9ec6-de6337b45e30",
                                "text": "La rivière s’étalait parfois sur de longues grèves plates où le soleil ruisselait, se prenait dans un frémissement innombrable de petites vagues ; des bandes de chiffes et de chevaines sortis des grands fonds venaient frayer là, dans ces eaux tièdes."
                            }
                        ]
                    },
                    {
                        "sense_id": "c140afc7-38ce-3bcb-9fec-7a53baff22b9",
                        "entry_id": "f45a2b43-4a6d-3a0a-975c-78fe6d451bc7",
                        "glosses": [
                            "Langue."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    }
                ],
