                ],
                "senses": [
                    {
                        "sense_id": "43d55238-54e5-390a-8e5c-f676a510638f",
                        "entry_id": "774391a3-659d-3f5b-a43b-0d084c989e9e",
                        "glosses": [
                            "Geruch, der von einem Parfüm stammt (oder daran erinnert)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5fc260e-7b64-451e-82fc-fab88fe0506d",
                                "sense_id": "43d55238-54e5-390a-8e5c-f676a510638f",
                                "text": "„Kurz darauf konnten die beiden aufgrund des intensiven Parfümgeruchs auch den Gepäckdieb ausfindig machen, der wenig später im Bonner Hauptbahnhof von Beamten der Bundespolizei in Empfang genommen wurde.“"
                            },
                            {
                                "example_id": "e3db7d52-279d-4ccd-b71f-1a358b3eae4e",
                                "sense_id": "43d55238-54e5-390a-8e5c-f676a510638f",
                                "text": "„Ein Nachbarladen, erklärt Angela Munkert, Pressesprecherin der Stadt Düsseldorf, habe sich über habe sich über den Parfümgeruch beschwert.“"
                            },
                            {
                                "example_id": "1d9962bf-a0a0-4385-967d-94a44caa09aa",
                                "sense_id": "43d55238-54e5-390a-8e5c-f676a510638f",
                                "text": "„Frischer Brötchenduft, betörender Parfümgeruch oder angenehme Frühlingsluft: In vielen Läden riecht es gut.“"
                            },
                            {
                                "example_id": "c3a36883-c976-4f4a-a429-f0ce03d665fb",
                                "sense_id": "43d55238-54e5-390a-8e5c-f676a510638f",
                                "text": "„Auch aufdringlichen Parfümgeruch in Zimmern oder an Menschen selbst vermeide man; starker Parfümgeruch bietet Anlaß zu unliebsamen Rückschlüssen, daß man solche künstliche Mittel nötig hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
