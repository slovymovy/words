                "senses": [
                    {
                        "sense_id": "605523fb-c9b5-31d9-aff2-8e2a1d73fc16",
                        "entry_id": "2bf32a42-70a7-3ddf-b4e0-533ab1a4593a",
                        "glosses": [
                            "(mit Öl oder anderen, verwandten Stoffen) getränktes, wasserdichtes Papier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeb74b0f-a3be-4d72-9ac8-58354e5ed570",
                                "sense_id": "605523fb-c9b5-31d9-aff2-8e2a1d73fc16",
                                "text": "„Mit heftigen Bewegungen schlug er die Mappe ins Ölpapier, öffnete eine Schublade des Schreibtisches und ließ die Blätter verschwinden.“"
                            },
                            {
                                "example_id": "2c18c2b8-db29-4cc7-afbe-9a05086d3665",
                                "sense_id": "605523fb-c9b5-31d9-aff2-8e2a1d73fc16",
                                "text": "„Es gab auch grüne Blechkisten in allen Größen, schwere hölzerne Wagenheber, Klappspaten und verrostete Werkzeuge, teilweise noch in Kisten liegend und mit Ölpapier eingewickelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
