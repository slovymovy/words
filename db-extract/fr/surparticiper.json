                "senses": [
                    {
                        "sense_id": "8b505f53-c9df-3369-ac52-8472032d7539",
                        "entry_id": "22821329-2f61-350d-9019-1d7f70642d65",
                        "glosses": [
                            "Participer plus que la normale, ou plus qu’à l’habitude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aabf7b97-e802-4c60-92a9-2d0e22fd6f2f",
                                "sense_id": "8b505f53-c9df-3369-ac52-8472032d7539",
                                "text": "Acceptons l'artistage qui prend les foules, en travail raison et temps à surparticiper au monde en action mouvement pour tous."
                            },
                            {
                                "example_id": "5e506f5e-38c3-47fa-b1a7-aa61e90c7455",
                                "sense_id": "8b505f53-c9df-3369-ac52-8472032d7539",
                                "text": "C’est à cause de la non participation des malhonnêtes que les honnêtes sont obligés de surparticiper."
                            },
                            {
                                "example_id": "56dd873b-db90-4a60-84d9-c42795cd3880",
                                "sense_id": "8b505f53-c9df-3369-ac52-8472032d7539",
                                "text": "Surparticiper à l’effort de guerre ?"
                            }
                        ]
                    }
