                                                "sense_id": "cf7caf0f-e142-367e-9a29-c5be11a42054",
                                                "text": "Точно в восемь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c35c34e9-dbc8-3ded-aec5-7cd04829edf0",
                                        "entry_id": "fedb014a-c65d-393a-a888-74ca81de1bac",
                                        "glosses": [
