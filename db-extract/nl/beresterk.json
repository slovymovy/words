                ],
                "senses": [
                    {
                        "sense_id": "34614a43-e9f3-3a14-b98a-c1bd1cd18422",
                        "entry_id": "fbf9b653-6a99-3e57-b29e-e8378f5a5ca3",
                        "glosses": [
                            "veel kracht bezittend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d0c244a-5f62-477f-b0d0-c3eaf6b38a45",
                                "sense_id": "34614a43-e9f3-3a14-b98a-c1bd1cd18422",
                                "text": "Fieret dus en mijn zus en nog een paar anderen hebben op een nacht die twee zwanen uit de hofvijver getild. Daar moet je heel handig voor zijn, zwanen uit een vijver tillen, en beresterk. En geloof me of niet, terwijl ik toch wel weet dat je me niet gelooft, Fieret was handig en sterk."
                            },
                            {
                                "example_id": "537bb33c-d1f9-4150-9413-7fe9087cf439",
                                "sense_id": "34614a43-e9f3-3a14-b98a-c1bd1cd18422",
                                "text": "Nog niet zo lang geleden maakte ik in het buitenland kennis met een commissaris van politie die ook al de loftrompet stak over het body builden. Hij was maar een klein manneke maar hij was beresterk."
                            }
                        ]
                    },
                    {
                        "sense_id": "09327bbc-8a21-3b5d-8de3-6f7898bf9903",
                        "entry_id": "fbf9b653-6a99-3e57-b29e-e8378f5a5ca3",
                        "glosses": [
                            "erg goed, van hoge kwaliteit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb23dd43-0ed0-424d-8a31-3837a716aada",
                                "sense_id": "09327bbc-8a21-3b5d-8de3-6f7898bf9903",
                                "text": "Trouwens de reclamewereld maakt nog dagelijks gebruik van technieken die uit de propagandafilms komen, het was gewoon beresterk."
                            },
                            {
                                "example_id": "9ae8b2d6-e9e3-4424-9523-d963b4e50be9",
                                "sense_id": "09327bbc-8a21-3b5d-8de3-6f7898bf9903",
                                "text": "Dit Feijenoord was weer beresterk, dit Feijenoord was twee klassen beter dan de slappe, ongeorganiseerde formatie die vorige week tegen FC Twente met veel pijn en moeite een dreigende nederlaag had kunnen afwenden."
                            }
                        ]
                    }
