            "senses": [
                {
                    "sense_id": "4dd0726b-515c-3fc7-b7ca-3fb16b7dec52",
                    "sense_definition": "De inwoners van Frankrijk.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inhabitants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>Fransen</w> staan bekend om hun uitstekende keuken en wijnen.",
                            "target_lang_translations": {
                                "en": "The <w>French</w> are known for their excellent cuisine and wines.",
                                "ru": "<w>Французы</w> известны своей превосходной кухней и винами.",
                                "pl": "<w>Francuzi</w> są znani ze swojej doskonałej kuchni i win.",
                                "de": "Die <w>Franzosen</w> sind für ihre exzellente Küche und ihre Weine bekannt.",
                                "fr": "Les <w>Français</w> sont connus pour leur excellente cuisine et leurs vins.",
                                "it": "I <w>francesi</w> sono noti per la loro eccellente cucina e i loro vini.",
                                "cs": "<w>Francouzi</w> jsou známí svou vynikající kuchyní a víny.",
                                "tr": "<w>Fransızlar</w>, mükemmel mutfakları ve şaraplarıyla tanınırlar.",
                                "es": "Los <w>franceses</w> son conocidos por su excelente cocina y sus vinos.",
                                "zh": "<w>法国人</w>以其卓越的烹饪和葡萄酒而闻名。"
                            }
                        },
                        {
                            "text": "Veel <w>Fransen</w> brengen hun zomervakantie door in het zuiden van hun eigen land.",
                            "target_lang_translations": {
                                "en": "Many <w>French people</w> spend their summer holidays in the south of their own country.",
                                "ru": "Многие <w>французы</w> проводят летний отпуск на юге своей страны.",
                                "pl": "Wielu <w>Francuzów</w> spędza wakacje na południu swojego kraju.",
                                "de": "Viele <w>Franzosen</w> verbringen ihren Sommerurlaub im Süden ihres eigenen Landes.",
                                "fr": "Beaucoup de <w>Français</w> passent leurs vacances d'été dans le sud de leur propre pays.",
                                "it": "Molti <w>francesi</w> trascorrono le vacanze estive nel sud del loro paese.",
                                "cs": "Mnoho <w>Francouzů</w> tráví letní dovolenou na jihu své vlastní země.",
                                "tr": "Birçok <w>Fransız</w>, yaz tatillerini kendi ülkelerinin güneyinde geçirir.",
                                "es": "Muchos <w>franceses</w> pasan sus vacaciones de verano en el sur de su propio país.",
                                "zh": "许多<w>法国人</w>在自己国家的南部度过暑假。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "de Fransen",
                        "veel Fransen"
                    ],
