                        "entry_id": "2e5f1f35-d53e-30cc-b5aa-640b28a832a5",
                        "glosses": [
                            "Ce qui neutralise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c5d23d7-358d-4cfc-8da7-fa2ac9abb433",
                                "sense_id": "12c9a36e-1de0-377b-99d5-25521969fd8f",
                                "text": "Il fallait un neutralisateur de l’oxyde, et ce neutralisateur était le borax."
                            },
                            {
                                "example_id": "90f209ee-c1d5-4781-b67c-670ae52d9d35",
                                "sense_id": "12c9a36e-1de0-377b-99d5-25521969fd8f",
                                "text": "Les méthodes modernes de tannage sont donc étudiées en vue d’ajouter des neutralisateurs aux solutions ferriques, afin d’annuler l’action des ions H sur la peau pendant le tannage et sur le cuir pendant le magasinage."
                            }
                        ]
                    }
