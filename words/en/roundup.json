{
    "word_family": [
        "round-up",
        "round"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af80ec2d-ae0c-3c8c-a9c1-c8c7309c9bcb",
                    "sense_definition": "A summary or collection of news items or facts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "summary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every morning the station broadcasts a quick news <w>roundup</w> of current events.",
                            "target_lang_translations": {
                                "ru": "Каждое утро радиостанция передаёт краткую <w>сводку</w> текущих событий."
                            }
                        },
                        {
                            "text": "The presenter gave a brief <w>roundup</w> of the top sporting achievements.",
                            "target_lang_translations": {
                                "ru": "Ведущий представил краткий <w>обзор</w> главных спортивных достижений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "news roundup",
                        "weekly roundup",
                        "daily roundup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткая сводка, обзор или подборка новостей или фактов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обзор",
                                "target_lang_sense_clarification": "новостей, событий"
                            },
                            {
                                "target_lang_word": "сводка",
                                "target_lang_sense_clarification": "краткая подборка новостей"
                            },
                            {
                                "target_lang_word": "дайджест",
                                "target_lang_sense_clarification": "краткое изложение материалов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f4796d9-ac6d-3bad-a70c-5db852fc2f25",
                    "sense_definition": "The gathering together of cattle, livestock, or other animals.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ranchers worked all morning during the annual cattle <w>roundup</w> across the plains.",
                            "target_lang_translations": {
                                "ru": "Ранчеро трудились всё утро во время ежегодного <w>сгона скота</w> по равнинам."
                            }
                        },
                        {
                            "text": "The autumn <w>roundup</w> took three days because the herd was scattered.",
                            "target_lang_translations": {
                                "ru": "Осенний <w>сгон</w> занял три дня, так как стадо разбрелось."
                            }
                        }
                    ],
                    "synonyms": [
                        "muster"
                    ],
                    "common_phrases": [
                        "cattle roundup",
                        "annual roundup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сгон, сбор в одно место скота или других животных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгон",
                                "target_lang_sense_clarification": "сбор скота"
                            },
                            {
                                "target_lang_word": "загон",
                                "target_lang_sense_clarification": "загон скота"
                            },
                            {
                                "target_lang_word": "сбор скота",
                                "target_lang_sense_clarification": "процесс собирания скота"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af8d7a10-8ce0-32dd-8099-3bd337022b5d",
                    "sense_definition": "The gathering or arresting of suspects or criminals by police.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "detention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden police <w>roundup</w> of local gang members took place early at dawn.",
                            "target_lang_translations": {
                                "ru": "Ранним утром на рассвете полиция провела внезапную <w>облаву</w> на членов местной банды."
                            }
                        },
                        {
                            "text": "Dozens were arrested in a coordinated <w>roundup</w> across multiple cities.",
                            "target_lang_translations": {
                                "ru": "Десятки людей были арестованы в ходе скоординированной <w>облавы</w> в нескольких городах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "police roundup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Массовое задержание или облава полиции на подозреваемых или преступников."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облава",
                                "target_lang_sense_clarification": "полицейская операция"
                            },
                            {
                                "target_lang_word": "массовое задержание",
                                "target_lang_sense_clarification": "арест группы лиц"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e50d84b-ca82-334b-a7bf-7081fed7d70a",
                    "sense_definition": "The forcible gathering together or detention of a group of people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "detention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The regime carried out a massive <w>roundup</w> of political dissidents overnight.",
                            "target_lang_translations": {
                                "ru": "За одну ночь режим провёл масштабную <w>облаву</w> на политических диссидентов."
                            }
                        },
                        {
                            "text": "Survivors described the terrifying <w>roundup</w> of civilians by the occupying army.",
                            "target_lang_translations": {
                                "ru": "Выжившие описывали ужасающий <w>сгон</w> мирных жителей оккупационными войсками."
                            }
                        }
                    ],
                    "common_phrases": [
                        "massive roundup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Насильственный сбор, облава или интернирование группы людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облава",
                                "target_lang_sense_clarification": "насильственный сбор людей"
                            },
                            {
                                "target_lang_word": "сгон",
                                "target_lang_sense_clarification": "насильственное перемещение населения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4642838-3bb0-36dd-a46d-9ef62adab19a",
                    "sense_definition": "The completion or concluding of an arrangement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee reached the final <w>roundup</w> of their complex negotiations.",
                            "target_lang_translations": {
                                "ru": "Комитет подошёл к окончательному <w>подведению итогов</w> своих сложных переговоров."
                            }
                        },
                        {
                            "text": "We are preparing the <w>roundup</w> of details before closing the sale.",
                            "target_lang_translations": {
                                "ru": "Мы готовим окончательное <w>согласование</w> деталей перед закрытием сделки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Завершение, подведение итогов или сведение воедино соглашения или деталей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подведение итогов",
                                "target_lang_sense_clarification": "завершение процесса"
                            },
                            {
                                "target_lang_word": "завершение",
                                "target_lang_sense_clarification": "финальный этап"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f89cfe04-3e05-306c-a8d4-e3e7c6dd7cc3",
                    "sense_definition": "An upward curvature or convexity, as in the deck of a vessel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shipbuilder carefully inspected the deck's gentle <w>roundup</w> to shed water.",
                            "target_lang_translations": {
                                "ru": "Судостроитель внимательно осмотрел пологую <w>погибь</w> палубы для стока воды."
                            }
                        },
                        {
                            "text": "Proper <w>roundup</w> on the wooden hull ensures superior structural strength.",
                            "target_lang_translations": {
                                "ru": "Правильный <w>выгиб</w> деревянного корпуса обеспечивает превосходную структурную прочность."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выгиб вверх, поперечная выпуклость (например, палубы судна для стока воды)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погибь",
                                "target_lang_sense_clarification": "выпуклость палубы судна"
                            },
                            {
                                "target_lang_word": "выгиб",
                                "target_lang_sense_clarification": "кривизна"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "79ed8891-9ee6-3d14-8095-53253828f75b",
                    "sense_definition": "A city, the county seat of Musselshell County, Montana, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through <w>Roundup</w> while traveling across central Montana.",
                            "target_lang_translations": {
                                "ru": "Они проехали через <w>Раундап</w>, путешествуя по центральной Монтане."
                            }
                        },
                        {
                            "text": "The small town of <w>Roundup</w> serves as the county seat.",
                            "target_lang_translations": {
                                "ru": "Небольшой город <w>Раундап</w> является административным центром округа."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город, административный центр округа Масселшелл в штате Монтана, США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Раундап",
                                "target_lang_sense_clarification": "город в США"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}