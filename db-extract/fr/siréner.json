                "senses": [
                    {
                        "sense_id": "16b949a8-61ab-3616-ad28-49987fff20fe",
                        "entry_id": "8a71cc3c-e671-3421-a28e-de6b3d3cb808",
                        "glosses": [
                            "Faire entendre un bruit de sirène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2b6f075-3bc3-4912-8df0-ff4e406d711e",
                                "sense_id": "16b949a8-61ab-3616-ad28-49987fff20fe",
                                "text": "Juste comme je l’avais prévu un remorqueur a siréné."
                            },
                            {
                                "example_id": "0aa2b3ac-1c3b-463f-918f-331e03fc8b0e",
                                "sense_id": "16b949a8-61ab-3616-ad28-49987fff20fe",
                                "text": "Puis, elle se précipita vers son lavabo : dans le silence de l’appartement, les conduites d’eau se mirent à siréner."
                            },
                            {
                                "example_id": "bc740f5a-cc73-4df9-92a6-44e54b737ac0",
                                "sense_id": "16b949a8-61ab-3616-ad28-49987fff20fe",
                                "text": "J’ai eu beau klaxonner, siréner, personne n’a voulu me laisser passer."
                            }
                        ]
                    }
