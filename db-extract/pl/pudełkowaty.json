                "senses": [
                    {
                        "sense_id": "fb51fd95-6cdd-365f-8495-90e37ffd3fa5",
                        "entry_id": "cc1124ee-9772-32be-b1e2-3e567232dedf",
                        "glosses": [
                            "podobny do pudełka, kształtem przypominający pudełko"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fe42997-bbb5-4715-abed-9492f31a7ed1",
                                "sense_id": "fb51fd95-6cdd-365f-8495-90e37ffd3fa5",
                                "text": "Fantazja architektów nie ma granic, skończył się czas brzydkich, pudełkowatych, budowanych pod sztancę piętrówek z płaskim dachem, gdyż na inne domy, za komuny, nie dawano pozwoleń"
                            },
                            {
                                "example_id": "6c82b73c-344b-4e06-8691-0c5ad35362e4",
                                "sense_id": "fb51fd95-6cdd-365f-8495-90e37ffd3fa5",
                                "text": "Nie widziałem dotąd takiej broni – długa lufa pokryta dziurkowaną blachą, sterczący u dołu pudełkowaty, krótki magazynek, niezwyczajny kształt kolby, zamka i muszki…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
