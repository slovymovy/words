                ],
                "senses": [
                    {
                        "sense_id": "71402560-49c8-3f1e-917d-a631b1520523",
                        "entry_id": "8396278c-986e-338c-b6b3-da305be2f323",
                        "glosses": [
                            "относиться к кому-либо, чему-либо с презрением, высокомерно, без уважения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a18226c-1abf-491a-a400-3b8df926274d",
                                "sense_id": "71402560-49c8-3f1e-917d-a631b1520523",
                                "text": "Не должен артист пренебрегать маленькими ролями, если они художественно интересны."
                            },
                            {
                                "example_id": "a0dbb5c9-b2df-4520-a62e-2598210f5ee1",
                                "sense_id": "71402560-49c8-3f1e-917d-a631b1520523",
                                "text": "Женщины им пренебрегали, политическая карьера сияла другим."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a272d43-14f2-360a-8c55-38b52453a505",
                        "entry_id": "8396278c-986e-338c-b6b3-da305be2f323",
                        "glosses": [
                            "оставлять что-либо без внимания как незначащее, несущественное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d01a0fe-af9f-48e5-8b35-13c2f774b474",
                                "sense_id": "7a272d43-14f2-360a-8c55-38b52453a505",
                                "text": "Поэтому вопросами стоек нельзя пренебрегать, им надо уделять не менее важное значение, чем ударам ногами и руками."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ae93b2a-9085-4ce6-98e4-cc4e45b5eadb",
                        "source_entry_id": "8396278c-986e-338c-b6b3-da305be2f323",
                        "target_lang_word": "neglect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neglect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eef0f0ab-b8d9-342b-a658-02eafca6c3b6",
                                        "entry_id": "9de53191-581b-362f-b2f2-455eb2936788",
                                        "glosses": [
                                            "To fail to care for or attend to something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06a5a0be-ff33-49ed-82e9-782c71696a9e",
                                                "sense_id": "eef0f0ab-b8d9-342b-a658-02eafca6c3b6",
                                                "text": "to neglect duty or business;  to neglect to pay debts"
                                            },
                                            {
                                                "example_id": "4714ef76-43a7-4917-8b9e-f98f3c3cfe8a",
                                                "sense_id": "eef0f0ab-b8d9-342b-a658-02eafca6c3b6",
                                                "text": "I hope\n My absence doth neglect no great designs."
                                            },
                                            {
                                                "example_id": "3573f8ae-9458-41cd-ad48-d0c7d50a9acf",
                                                "sense_id": "eef0f0ab-b8d9-342b-a658-02eafca6c3b6",
                                                "text": "This, my long sufferance and my day of grace,\n Those who neglect and scorn, shall never taste."
                                            },
                                            {
                                                "example_id": "dad02e2f-efab-4d82-a321-af4a7b3392b9",
                                                "sense_id": "eef0f0ab-b8d9-342b-a658-02eafca6c3b6",
                                                "text": "One of the hidden glories of Victorian engineering is proper drains.[…]But out of sight is out of mind. And that, together with the inherent yuckiness of the subject, means that many old sewers have been neglected and are in dire need of repair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e195d216-26f9-3f8d-ab6f-eabafcd201c3",
                                        "entry_id": "9de53191-581b-362f-b2f2-455eb2936788",
                                        "glosses": [
                                            "To omit to notice; to forbear to treat with attention or respect; to slight."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a34b57e-ee8f-47de-9f48-55f989fcc2af",
                                                "sense_id": "e195d216-26f9-3f8d-ab6f-eabafcd201c3",
                                                "text": "to neglect strangers"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caabf15c-01d3-3f6d-beb4-27ddf585cbaa",
                                        "entry_id": "9de53191-581b-362f-b2f2-455eb2936788",
                                        "glosses": [
                                            "To fail to do or carry out something due to oversight or carelessness."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcaaea1c-58b5-493a-ae30-8b26c75a31bb",
                                                "sense_id": "caabf15c-01d3-3f6d-beb4-27ddf585cbaa",
                                                "text": "A friend of mine who runs an intellectual magazine was grousing about his movie critic, complaining that though the fellow had liked The Godfather (page 58), he had neglected to label it clearly as a masterpiece."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3686bace-4f37-3aba-8c2c-481e868808e1",
                                        "entry_id": "9de53191-581b-362f-b2f2-455eb2936788",
                                        "glosses": [
                                            "To ignore for the sake of simplifying calculations without significantly affecting accuracy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8944114-2196-44bf-97e5-0cb720233810",
                                                "sense_id": "3686bace-4f37-3aba-8c2c-481e868808e1",
                                                "text": "We can neglect this term, as it approaches zero in the limit anyway."
                                            },
                                            {
                                                "example_id": "64b8d441-f619-4330-8114-b922418ff89f",
                                                "sense_id": "3686bace-4f37-3aba-8c2c-481e868808e1",
                                                "text": "This problem says to neglect air resistance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neglect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f301e6f-1370-3420-9b23-25669d959ef4",
                                        "entry_id": "db16befb-b3fc-33a1-92f3-02ea5b77e88d",
                                        "glosses": [
                                            "The act of neglecting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d466f8a0-10a7-3fc8-8082-2220c703f876",
                                        "entry_id": "db16befb-b3fc-33a1-92f3-02ea5b77e88d",
                                        "glosses": [
                                            "The state of being neglected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36c45e62-787d-3424-a3d4-b2feed8ed0bf",
                                        "entry_id": "db16befb-b3fc-33a1-92f3-02ea5b77e88d",
                                        "glosses": [
                                            "Habitual lack of care."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b0d95ef-0cb3-4ebc-90fb-676d1a63df67",
                                                "sense_id": "36c45e62-787d-3424-a3d4-b2feed8ed0bf",
                                                "text": "Fifteen participants argued that the neglect of discourse on relationships had major implications for the ability of adolescents to acquire courtship skills and maintain relationships. This neglect means that the students acquire knowledge and skills through the media and by observing and imitating others in their immediate environment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3cf0d3b3-19af-4590-98b2-bb55a6654c4e",
                        "source_entry_id": "8396278c-986e-338c-b6b3-da305be2f323",
                        "target_lang_word": "disregard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disregard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19d5bb92-d55c-3d29-a11c-2997630ea639",
                                        "entry_id": "f5cd46da-40bc-35fb-95b9-91ae8f8c80d4",
                                        "glosses": [
                                            "The act or state of deliberately not paying attention or caring about something."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaff5b61-7bd2-42c4-ad8b-f3a0d64cdff2",
                                                "sense_id": "19d5bb92-d55c-3d29-a11c-2997630ea639",
                                                "text": "The government's disregard for the needs of disabled people is outrageous."
                                            },
                                            {
                                                "example_id": "fabb29c1-ba73-44a3-b881-eca6db1d19b0",
                                                "sense_id": "19d5bb92-d55c-3d29-a11c-2997630ea639",
                                                "text": "The guard was paying no attention whatever to the running of his train, in total disregard of rules, and, as the recently-published report of a Ministry of Transport Inspecting Officer of Railways shows, there were other disquieting features in the case, such as ignorance on the part of responsible men of rules and appendix instructions and a lax attitude to regulations of which they professed to be aware, combined with failure to look at staff notice boards."
                                            },
                                            {
                                                "example_id": "d76329fc-c002-4fd4-bf2e-e832ae029ed4",
                                                "sense_id": "19d5bb92-d55c-3d29-a11c-2997630ea639",
                                                "text": "The Trump administration’s disregard for due process has been a pattern in the legal disputes over his immigration policies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disregard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "817c27ef-0c0a-3c79-8f6d-78bc473680ab",
                                        "entry_id": "8d114ba8-1936-3570-a93e-13a18d343a82",
                                        "glosses": [
                                            "To ignore; to pay no attention to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e80a459d-bc88-4a28-bb98-5b6efefe6a57",
                                                "sense_id": "817c27ef-0c0a-3c79-8f6d-78bc473680ab",
                                                "text": "If you break the law, they will send you a letter. You disregard that they will send someone with a suit to your house. If you disregard Suit-Boy, you will be sent a subpoena. You disregard that they will send men with guns and dogs to your house."
                                            },
                                            {
                                                "example_id": "43d2e7b8-328e-4ce2-a502-1ee4d513be3a",
                                                "sense_id": "817c27ef-0c0a-3c79-8f6d-78bc473680ab",
                                                "text": "Half of the mock jurors that were told he had insurance were told to disregard that information. Mock jurors who were instructed to disregard the information awarded the defendant more money than participants who did not know the defendant had insurance, or knew that he had insurance but were not told to disregard this information."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
