                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze wijk wonen veel <w>Letten</w> die in de haven werken.",
                            "target_lang_translations": {
                                "en": "Many <w>Latvians</w> who work in the harbor live in this neighborhood.",
                                "ru": "В этом районе живет много <w>латышей</w>, которые работают в порту."
