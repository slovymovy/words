                        ]
                    },
                    {
                        "translation_id": "b4812c6d-2f16-4b18-abab-dad195b82ed2",
                        "source_entry_id": "216d9120-8e9c-30a6-a997-21ed92732d24",
                        "source_sense_id": "a452cbea-ebb8-3506-a2f1-e7bfb2bdd4df",
                        "target_lang_word": "aeroplano",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aeroplano",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "29c5c95f-7193-3660-94ac-54cc1a1f09d7",
                                        "entry_id": "f6a633a1-0cf9-3040-b8a9-b1c2102811f4",
                                        "glosses": [
                                            "Medio de transporte aéreo más pesado que el aire, provisto de alas y un cuerpo de carga capaz de volar, propulsado siempre por uno o más motores. Los aeroplanos incluyen a los monoplanos, biplanos y triplanos."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5afd1d7-2a8a-4d7d-8007-f8790ba8c270",
                        "source_entry_id": "216d9120-8e9c-30a6-a997-21ed92732d24",
                        "source_sense_id": "a452cbea-ebb8-3506-a2f1-e7bfb2bdd4df",
                        "target_lang_word": "Aeroplan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aeroplan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66d40744-49ae-3639-aedf-eb0a99d05df5",
                                        "entry_id": "0fee4e9d-55c0-3105-ae69-6b4bd979b8a0",
                                        "glosses": [
                                            "Flugzeug"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c836c578-5e1a-43bb-815d-dc08fe19c151",
                                                "sense_id": "66d40744-49ae-3639-aedf-eb0a99d05df5",
                                                "text": "„Fabian hatte mit einem Male die Vorstellung, er fliege dort oben im Aeroplan und sehe auf sich hinunter, auf den jungen Mann in der Joachimstaler Straße, im Gewimmel der Menge, im Lichtkreis der Laternen und Schaufenster, im Straßengewirr der fiebrig entzündeten Nacht.“"
                                            },
                                            {
                                                "example_id": "bb650fe7-af8a-44a9-8924-b25ba442ebf0",
                                                "sense_id": "66d40744-49ae-3639-aedf-eb0a99d05df5",
                                                "text": "„Über der Stadt kreisen Aeroplane und werfen Flugzettel herab.“"
                                            },
                                            {
                                                "example_id": "d4338162-4da1-4863-8252-62bc4ad33a90",
                                                "sense_id": "66d40744-49ae-3639-aedf-eb0a99d05df5",
                                                "text": "„Die Aeroplane, französische und solche mit dem Eisernen Kreuz, hängen als winziges Kinderspielzeug auf Drähten, sie, die wir riesenhaft über den Kolonnen schwirren sahen.“"
                                            },
                                            {
                                                "example_id": "91861c67-4a28-4128-b881-ef15bb616106",
                                                "sense_id": "66d40744-49ae-3639-aedf-eb0a99d05df5",
                                                "text": "„Aber das war ja auch wirklich welterschütternd und sprengte alle Rahmen vorstellbarer Situationen, wenn beim ›Prinz-Heinrich-Flug‹ im Jahr 1912, an dem sich alle Piloten des Reichs beteiligten und der von Ort zu Ort über ganz Deutschland ging, mehr als hundert Aeroplane, gebrechliche, feindrahtige Gestelle, Euler-Doppeldecker und Eindecker-Tauben, in langen Abständen auf dem ›Großen Sand‹ zwischenlandeten, und man saß mit der Uhr in der Hand neben Goedeckers Morse-Apparat und stoppte mit: wer ist wo aufgestiegen, wer ist wo abgestürzt, wer ist noch in der Luft!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "727c27db-531b-499b-8a19-615953ba69bf",
                        "source_entry_id": "216d9120-8e9c-30a6-a997-21ed92732d24",
                        "source_sense_id": "a452cbea-ebb8-3506-a2f1-e7bfb2bdd4df",
