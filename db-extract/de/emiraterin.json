                "senses": [
                    {
                        "sense_id": "49750403-6e9b-3492-93e8-ef7dc546a76e",
                        "entry_id": "8fb6ec9f-3683-3404-b497-fed4a2d77229",
                        "glosses": [
                            "einheimische Einwohnerin oder Staatsangehörige der Vereinigten Arabischen Emirate"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3900074b-fa60-41c9-91a9-608e618c584f",
                                "sense_id": "49750403-6e9b-3492-93e8-ef7dc546a76e",
                                "text": "„Sie sollte einer reichen Emiraterin Trainingsstunden in Capoeira geben, dem brasilianischen Kampftanz.“"
                            },
                            {
                                "example_id": "12c008eb-079f-4a67-a9a0-3ad31b76fc48",
                                "sense_id": "49750403-6e9b-3492-93e8-ef7dc546a76e",
                                "text": "„Dennoch waren auch einige Emiraterinnen hier.“"
                            },
                            {
                                "example_id": "9b104b18-594c-4696-9a05-b0a5080cf07e",
                                "sense_id": "49750403-6e9b-3492-93e8-ef7dc546a76e",
                                "text": "„Unweigerlich ignorieren er und seine Freunde angelegentlich eine nahebei sitzende Gruppe reservierter junger Emiraterinnen, die ihre hübschen Gesichter nicht verschleiert haben und deren von Kopf bis Fuß reichendes Schwarz mit roten oder elektrisch blauen Besätzen aufgelockert ist.“"
                            },
                            {
                                "example_id": "ad4b65f9-0800-4025-8b16-6c54a04fb1b2",
                                "sense_id": "49750403-6e9b-3492-93e8-ef7dc546a76e",
                                "text": "„Im Februar 2009 dann die Sensation: Großmufti Ahmed al-Haddad, Vorsitzender des Ministeriums für Islamische Angelegenheiten im Emirat Dubai, erließ eine Fatwa, nach der auch Frauen als Muftis wirken dürfen. Drei Emiraterinnen durchlaufen gegenwärtig die zweijährige Ausbildung.“"
                            },
                            {
                                "example_id": "e92df374-bab6-4584-94f7-85ce1190991e",
                                "sense_id": "49750403-6e9b-3492-93e8-ef7dc546a76e",
                                "text": "„Vor drei Jahren zum Beispiel wurde eine 18-jährige Emiraterin, die sechs Männer wegen Gruppenvergewaltigung angezeigt hatte, zu drei Jahren Haft verurteilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
