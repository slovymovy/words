                        "glosses": [
                            "A sweet delicacy; a confection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6a4f043-f929-4a75-868d-515f794e3a10",
                                "sense_id": "0f10e2d7-3446-339b-93a2-f2e357047f48",
                                "text": "At the principal stations there are also separate Hindu and Mohemmedan refreshment rooms, and some mail trains have compartments reserved for Indian tea and sweetmeat vendors."
                            }
                        ]
                    },
                    {
                        "sense_id": "824a5a16-bdb9-3705-af8e-de94a01ba655",
                        "entry_id": "aa2eed24-f6f1-3f44-90cd-e0bf35e97421",
                        "glosses": [
                            "Sweetheart; darling."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "26baefa8-6200-4062-a59a-660f92596291",
                                "sense_id": "824a5a16-bdb9-3705-af8e-de94a01ba655",
                                "text": "“Hey, sweetmeat, where you been?” Farrengalli hollered."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
