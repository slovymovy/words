                                "example_id": "73620cfd-d693-4d99-9770-9327a2b40e6a",
                                "sense_id": "58ef8234-69bc-3fe9-9b58-f5536a36f767",
                                "text": "„1786 war er auf eines der Gefängnisschiffe verlegt worden, zuerst auf der Themse, später in Portsmouth.“"
                            },
                            {
                                "example_id": "2705e84d-da7d-4720-813c-b66eede96b4f",
                                "sense_id": "58ef8234-69bc-3fe9-9b58-f5536a36f767",
                                "text": "„Wir blieben zwei bis drei Wochen in Montreal und wurden dann nach Quebec geschickt, wo man uns an Bord von Gefängnisschiffen brachte.“"
                            }
