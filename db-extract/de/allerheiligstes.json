                    {
                        "translation_id": "cf94f669-b0ab-40a7-b6c5-b663b76bdade",
                        "source_entry_id": "770a6e53-35e8-3550-9d2d-b0302ae27f41",
                        "source_sense_id": "e620a86a-8a3a-3396-930c-f990b0ac031a",
                        "source_sense_description": "orthodoxen Kirchen: der Raum, in dem der Priester am Altar die Mysterien feiert",
                        "target_lang_word": "sanctum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sanctum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8236a9b3-2e3a-32f7-a3f7-fba39e02984d",
                                        "entry_id": "19e5f9f2-6af1-3b2c-a0c1-c80be17bcb88",
                                        "glosses": [
                                            "A place set apart, as with a sanctum sanctorum; a sacred or private place; a private retreat or workroom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10006fb3-8365-41f9-9fa8-c223902e8617",
                                                "sense_id": "8236a9b3-2e3a-32f7-a3f7-fba39e02984d",
                                                "text": "As he descended the stairs, two persons passed him, so remarkably dissimilar in their persons, dress, and carriage, that he could not forbear to look earnestly at them, as forming a criterion of the mixed character of company admissible in such places, and which was to him (with his preconceived notions of the inviolability of the female sanctum) an insuperable objection to such scenes of general resort."
                                            },
                                            {
                                                "example_id": "a888b746-2d00-4a11-a7f0-8bed9764224f",
                                                "sense_id": "8236a9b3-2e3a-32f7-a3f7-fba39e02984d",
                                                "text": "For myself, I had no need to make any change; I should not be called upon to quit my sanctum of the schoolroom; for a sanctum it was now become to me, – \"a very pleasant refuge in time of trouble.\""
                                            },
                                            {
                                                "example_id": "d8b46bec-99a8-4614-af06-8075fb72dbd0",
                                                "sense_id": "8236a9b3-2e3a-32f7-a3f7-fba39e02984d",
                                                "text": "A diary, after all, is a sanctum for self-confession."
                                            },
                                            {
                                                "example_id": "c4dd9364-07c6-4df0-b6b1-17b78754c5c5",
                                                "sense_id": "8236a9b3-2e3a-32f7-a3f7-fba39e02984d",
                                                "text": "His colleagues quailed when, in 1986, he first sat on the court as a brash 50-year-old whose experience had been mostly as a combative government lawyer: a justice who, in that sanctum of columns and deep judicial silence, was suddenly firing questions like grapeshot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eda29f9c-8ab6-4d05-b015-ae32b984c0e5",
                        "source_entry_id": "770a6e53-35e8-3550-9d2d-b0302ae27f41",
                        "source_sense_id": "e620a86a-8a3a-3396-930c-f990b0ac031a",
                        "source_sense_description": "orthodoxen Kirchen: der Raum, in dem der Priester am Altar die Mysterien feiert",
                        "target_lang_word": "sanctuary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sanctuary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40df216e-31b2-3520-b0c6-f7305644a299",
                                        "entry_id": "e589cb8f-8cee-3f58-9300-717af9d8c610",
                                        "glosses": [
                                            "A place of safety, refuge, or protection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca3ca2c1-fbb2-4770-a1c0-e9a9db4c85b1",
                                                "sense_id": "40df216e-31b2-3520-b0c6-f7305644a299",
                                                "text": "My car is a sanctuary, where none can disturb me except for people who cut me off."
                                            },
                                            {
                                                "example_id": "3d61d001-c9ee-4dcd-bb6d-be12370270a8",
                                                "sense_id": "40df216e-31b2-3520-b0c6-f7305644a299",
                                                "text": "She saw him, even as she had last gazed upon him, pale, cold, and awful; but still he was there. The coffin was to her like a shrine; all that she held most dear and most precious was within its dark and silent sanctuary."
                                            },
                                            {
                                                "example_id": "9ad6d4c9-7b01-450e-95af-b7ba9b47c6ef",
                                                "sense_id": "40df216e-31b2-3520-b0c6-f7305644a299",
                                                "text": "‘I understand that the district was considered a sort of sanctuary,’ the Chief was saying. ‘An Alsatia like the ancient one behind the Strand, or the Saffron Hill before the First World War.[…]’"
                                            },
                                            {
                                                "example_id": "bf30e63b-7247-4a58-865b-cbc272f50f2b",
                                                "sense_id": "40df216e-31b2-3520-b0c6-f7305644a299",
                                                "text": "In January, federal agents indicted 16 sanctuary leaders from Texas and Arizona on charges of helping to harbor illegal immigrants from Central America."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "428eab59-917c-3c51-894d-50b4cc06f47e",
                                        "entry_id": "e589cb8f-8cee-3f58-9300-717af9d8c610",
                                        "glosses": [
                                            "An area set aside for protection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d9defc0-7b6c-4991-8ee2-52f53be57f67",
                                                "sense_id": "428eab59-917c-3c51-894d-50b4cc06f47e",
                                                "text": "The bird sanctuary has strict restrictions on visitors so the birds aren't disturbed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "661767ec-9dab-3e56-a71c-e667319de03f",
                                        "entry_id": "e589cb8f-8cee-3f58-9300-717af9d8c610",
                                        "glosses": [
                                            "A state of being protected, asylum."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd96ac0e-ccdb-4418-a377-4ed709e7e00a",
                                                "sense_id": "661767ec-9dab-3e56-a71c-e667319de03f",
                                                "text": "The government granted sanctuary to the defector, protecting him from his former government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a93d8258-452a-36b5-ac3b-4df14233491e",
                                        "entry_id": "e589cb8f-8cee-3f58-9300-717af9d8c610",
                                        "glosses": [
                                            "The consecrated (or sacred) area of a church or temple around its tabernacle or altar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
