                                        "sense_id": "cd71a6cc-6240-36b6-9a93-8b7a70ccaeae",
                                        "entry_id": "b3767160-62b9-3f11-80b7-f0dfb45c009f",
                                        "glosses": [
                                            "A tactic used to draw attention away from the real threat or action."
                                        ],
