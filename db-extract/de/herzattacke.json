                "senses": [
                    {
                        "sense_id": "f692ad60-1e46-339f-b8f7-7e11440679e7",
                        "entry_id": "c030ddf0-db6d-3d69-8f54-eba3c3c34356",
                        "glosses": [
                            "Herzinfarkt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c2e49bda-ad44-4cdc-afb7-ebe862c43227",
                                "sense_id": "f692ad60-1e46-339f-b8f7-7e11440679e7",
                                "text": "Wenn sie weiterhin so viel Fastfood essen, bekommen sie in 5 Jahren ihre erste Herzattacke."
                            },
                            {
                                "example_id": "58792a90-d7cc-45c2-a734-bc943128c843",
                                "sense_id": "f692ad60-1e46-339f-b8f7-7e11440679e7",
                                "text": "Karl Müller ist erst 50 Jahre als und hatte schon zwei Herzattacken."
                            },
                            {
                                "example_id": "1700b304-1bd0-4d38-8101-dfce099f5bc2",
                                "sense_id": "f692ad60-1e46-339f-b8f7-7e11440679e7",
                                "text": "„Denikin ließ sich in den USA nieder, wo er 1947 an einer Herzattacke starb, nachdem er seine fünfbändigen Memoiren abgeschlossen hatte.“"
                            },
                            {
                                "example_id": "446d0fc7-5c1d-4557-b8fd-7bc5f598835c",
                                "sense_id": "f692ad60-1e46-339f-b8f7-7e11440679e7",
                                "text": "„Ernsthafter geschah dies erst, als in den späteren Jahren schwere Herzattacken seine Todesfurcht verstärkten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "241989ec-346a-4100-a729-175262dbbf47",
