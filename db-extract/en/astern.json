    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "54cd60c9-7cd4-38b3-9b02-8391eed4820e",
                "word": "astern",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "369c30bb-1cb1-3a52-9586-a8501ea3373b",
                        "entry_id": "54cd60c9-7cd4-38b3-9b02-8391eed4820e",
                        "glosses": [
                            "Behind a vessel; having a bearing of 180 degrees from ahead."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9eb41a59-2a40-45cd-99bb-ed1953c676cd",
                                "sense_id": "369c30bb-1cb1-3a52-9586-a8501ea3373b",
                                "text": "If one ship is following another, the first is astern of the second."
                            },
                            {
                                "example_id": "35488fd9-84e7-4e32-b964-708843bc197b",
                                "sense_id": "369c30bb-1cb1-3a52-9586-a8501ea3373b",
                                "text": "When we first espied the Dutch fleet sailing towards us, our whole blue squadron was astern much farther from us, so that Prince Rupert thought it absolutely necessary to slacken sail that they might have time to join us."
                            },
                            {
                                "example_id": "a16d5774-cfe9-49ca-9b38-39c84f501215",
                                "sense_id": "369c30bb-1cb1-3a52-9586-a8501ea3373b",
                                "text": "Every yachtsman knows that if the ballast of a ship be too afore or too astern."
                            },
                            {
                                "example_id": "33fa8880-2d01-40c9-9b56-12586058d3b3",
                                "sense_id": "369c30bb-1cb1-3a52-9586-a8501ea3373b",
                                "text": "The chief engineer's evidence of the S.S. Lennox was the best given; but, as will be seen, he asserted that from the orders he received the Lennox's course was more astern than ahead."
                            },
                            {
                                "example_id": "ea778abc-9d27-445f-8a81-e5f1c1ca5617",
                                "sense_id": "369c30bb-1cb1-3a52-9586-a8501ea3373b",
                                "text": "but when near Cape Palmas the wind will perhaps be more astern"
                            },
                            {
                                "example_id": "7ccfdd85-a60b-4167-89c8-3835f3ea9f8b",
                                "sense_id": "369c30bb-1cb1-3a52-9586-a8501ea3373b",
                                "text": "The galley fire was lighted; coffee was boiled; the sun shone brightly, and the ship astern was coming up fast."
                            },
                            {
                                "example_id": "e53a5b5d-8fbb-4fc0-8c9a-7a220724a127",
                                "sense_id": "369c30bb-1cb1-3a52-9586-a8501ea3373b",
                                "text": "The steamer was more than ahead of us, just on our quarter as we say, and the light was more astern."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7da1bf70-53c0-4a7b-80e4-eb1f64225bff",
                        "source_entry_id": "54cd60c9-7cd4-38b3-9b02-8391eed4820e",
                        "source_sense_id": "369c30bb-1cb1-3a52-9586-a8501ea3373b",
