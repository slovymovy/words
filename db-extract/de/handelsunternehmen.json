                        "examples": [
                            {
                                "example_id": "9db6499d-59d1-46cc-ad87-4adaed2f80e0",
                                "sense_id": "d5d29ed0-2e51-3052-bef8-9bdd65a3c0d2",
                                "text": "„Denn Edeka habe wegen seines dichten Filialnetzes langfristig mehr Anreize zur Schließung von Filialen als irgendein anderes Handelsunternehmen.“"
                            },
                            {
                                "example_id": "ca8b63b5-efbc-4a85-9ecc-a575bb45733e",
                                "sense_id": "d5d29ed0-2e51-3052-bef8-9bdd65a3c0d2",
                                "text": "„Diese Vorgehensweise gewährleistet, dass beispielsweise Handelsunternehmen oder Banken möglichen Stornierungen oder Kündigungen rechtzeitig präventiv entgegenwirken können und so eventuelle Umsatzverluste vermeiden, bevor sie entstehen.“"
                            }
                        ],
