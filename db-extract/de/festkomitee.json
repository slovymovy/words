                    {
                        "sense_id": "0c74b9bb-4008-3f84-8ffb-9c3f5f13e3f5",
                        "entry_id": "ac9282ca-8eba-3dab-a652-196448a89d0e",
                        "glosses": [
                            "Gruppe von Personen, die mit der Organisation eines Festes betraut ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96988cf7-b112-4509-9e5d-6008a5c43fef",
                                "sense_id": "0c74b9bb-4008-3f84-8ffb-9c3f5f13e3f5",
                                "text": "„Die ersten Absprachen wurden übrigens in den Knuttstuben (Strickstuben) zwischen den beteiligten Hausfrauen getroffen, aus deren Reihen sich später das Festkomitee rekrutierte, das jedem - vom Koch über die Backfrau bis zum Musikus - seine Aufgaben zuwies.“"
                            },
                            {
                                "example_id": "a924222c-1df4-402d-ac7d-a411bccf7503",
                                "sense_id": "0c74b9bb-4008-3f84-8ffb-9c3f5f13e3f5",
                                "text": "„Das Festkomitee hat ihnen Tanz-, Kamera- und Gesangsunterricht verordnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
