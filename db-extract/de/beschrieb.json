                        ],
                        "examples": [
                            {
                                "example_id": "526f76de-2b53-4320-a1dd-5b83344c60bf",
                                "sense_id": "41472ec9-dda0-3b31-8d5d-38f3fe2a3012",
                                "text": "„Wer sich nach einem Auffahrunfall beim Beschrieb seiner Beschwerden an die Anleitungen des Schleudertrauma-Verbandes hielt, konnte sich zu oft eine Rente erschwindeln.“"
                            },
                            {
                                "example_id": "5503e1f9-fc6a-48b4-b3d4-8bf53da496c8",
                                "sense_id": "41472ec9-dda0-3b31-8d5d-38f3fe2a3012",
                                "text": "„Schicken Sie uns Ihre Bilder mit einem kurzen Beschrieb, wo und wann Sie das Foto geschossen haben – eine Auswahl wird morgen im BLICK veröffentlicht!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
