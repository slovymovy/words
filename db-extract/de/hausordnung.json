                "senses": [
                    {
                        "sense_id": "543c7819-5f43-3b9a-a2f5-50fb861c0015",
                        "entry_id": "423f7c5a-5740-3e2b-a1e2-71ecb6b7069d",
                        "glosses": [
                            "Règlement intérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94270910-20a1-4952-8193-a13d4b6cd259",
                                "sense_id": "543c7819-5f43-3b9a-a2f5-50fb861c0015",
                                "text": "Wir müssen die Hausordnung gut sichtbar aushängen, damit niemand sagen kann, er kenne sie nicht.",
                                "translation": "Il nous faut afficher le règlement intérieur de manière bien visible afin que personne ne puisse dire qu'il ne le connaît pas."
                            },
                            {
                                "example_id": "00f2adf2-6c0c-40bb-97d6-ec7943a4a913",
                                "sense_id": "543c7819-5f43-3b9a-a2f5-50fb861c0015",
                                "text": "In der Regie zieht die Producerin sich über die Hausordnung wie die Gesetzgebung hinwegsetzend an ihrer Elektro-Zigarette.",
                                "translation": "En régie, la réalisatrice tire sur sa cigarette électronique au mépris du règlement intérieur comme de la législation."
                            }
                        ]
                    }
                ],
