                        "sense_id": "d18d6f0c-2d00-3bf7-8798-e0fbdf213295",
                        "entry_id": "34767e7a-7106-335b-a360-0c4bac1ee641",
                        "glosses": [
                            "betrekking hebbend op de munt- en penningkunde, de numismatiek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29d73238-a1ed-4989-b496-a08027f6b737",
                                "sense_id": "d18d6f0c-2d00-3bf7-8798-e0fbdf213295",
                                "text": "Later was de penning te zien in het GeldMuseum en nu maakt de penning onderdeel uit van de Nationale Numismatische Collectie die De Nederlandsche Bank beheert."
                            },
                            {
                                "example_id": "ac9b978a-9c43-4c2b-a3e6-aa1bb8f47280",
                                "sense_id": "d18d6f0c-2d00-3bf7-8798-e0fbdf213295",
                                "text": "Het Geldmuseum ging in mei 2007 open. Het ontstond uit een fusie van het Koninklijk Penningkabinet, het Muntmuseum en de numismatische collectie van de Nederlandsche Bank. De komende twee maanden wordt het museum ontmanteld. De collectie wordt tijdelijk opgeslagen."
                            }
                        ]
                    }
                ],
