                        "entry_id": "165ada73-6e60-36d2-9307-4063ba78b7d0",
                        "glosses": [
                            "Qui pousse des sarments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10d04fee-f411-427c-9b96-2309c95daa05",
                                "sense_id": "18e1b43c-fe04-3834-acaa-663f2621f291",
                                "text": "La vigne est un arbrisseau sarmenteux qui présente un très-grand nombre de variétés."
                            }
                        ]
                    },
                    {
                        "sense_id": "575f8cfe-4898-3cd9-b996-e8672e16680a",
                        "entry_id": "165ada73-6e60-36d2-9307-4063ba78b7d0",
                        "glosses": [
                            "Dont la tige est longue, flexible et grimpante comme le sarment, en parlant d’une plante."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "cf480743-3306-4d98-987a-8b6e4f1e8364",
                                "sense_id": "575f8cfe-4898-3cd9-b996-e8672e16680a",
                                "text": "Rosier sarmenteux."
                            },
                            {
                                "example_id": "aac5aec9-fa22-4be8-8401-9c64e7f38fa2",
                                "sense_id": "575f8cfe-4898-3cd9-b996-e8672e16680a",
                                "text": "Plante sarmenteuse."
                            },
                            {
                                "example_id": "059444da-0cee-4d56-a0e0-2d5016313cc7",
                                "sense_id": "575f8cfe-4898-3cd9-b996-e8672e16680a",
                                "text": "Elle est caractérisée par des variétés à rameaux très vigoureux, presque sarmenteux, très forts, armés d’aiguillons gros, souvent crochus, par un feuillage très ample, enfin par des fleurs énormes, le plus souvent rose vif, rouge vineux ou rouge."
                            }
                        ]
                    }
