                "senses": [
                    {
                        "sense_id": "96a5f613-8095-3e30-9cc6-433876baa26d",
                        "entry_id": "4618976c-4041-33fb-a92e-6cba7eb51bb4",
                        "glosses": [
                            "Variante de étréper."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "6a5ec214-3e00-4b46-bfa0-43e2fa2fd692",
                                "sense_id": "96a5f613-8095-3e30-9cc6-433876baa26d",
                                "text": "Les véritables « terres de bruyère » s’extraient en étrépant des landes de bruyère ou de callune.\nPropositions de restauration :\n- arracher les peupliers…, avec les problèmes d’incompréhension des propriétaires,\n- étreper pour enlever la couverture de graminées et se rapprocher de la nappe phréatique,\n- permettre la recolonisation par les végétaux, sous suivi scientifique."
                            },
                            {
                                "example_id": "04f0c101-4eb0-4734-bc81-d58b9d509392",
                                "sense_id": "96a5f613-8095-3e30-9cc6-433876baa26d",
                                "text": "Les actions prévues :\n- Décaper et étreper pour permettre la recolonisation par la tourbe"
                            },
                            {
                                "example_id": "bdc63426-9edf-441f-8a5e-0d5fec289153",
                                "sense_id": "96a5f613-8095-3e30-9cc6-433876baa26d",
                                "text": "Installer des clôtures pour la gestion du pâturage, faucher et/ou étreper des zones à molinie, couper des arbustes."
                            }
                        ]
                    }
