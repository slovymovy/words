                        "sense_id": "d0e97535-c480-3087-bcf1-c51f752c966a",
                        "entry_id": "72452935-e62e-3aae-97ac-7fe7b65f7938",
                        "glosses": [
                            "Qui utilise les sensations pour se défendre et maintenir un sentiment de continuité d’existence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0d4b392-4f9c-4898-9c78-24cca47fa268",
                                "sense_id": "d0e97535-c480-3087-bcf1-c51f752c966a",
                                "text": "Tustin décrit parmi ces manœuvres autistiques des agrippements proprioceptifs autosensuels parmi lesquels nous rangerions l’acte compulsif de boire."
                            },
                            {
                                "example_id": "f232c482-674e-4846-b968-ee2ac01977b3",
                                "sense_id": "d0e97535-c480-3087-bcf1-c51f752c966a",
                                "text": "L’observation clinique révèle facilement ces manœuvres autistiques et autosensuelles que nous venons de décrire."
                            },
                            {
                                "example_id": "9ba715b1-02fd-470a-93b6-1e1d5182fb8c",
                                "sense_id": "d0e97535-c480-3087-bcf1-c51f752c966a",
                                "text": "Les travaux des psychosomaticiens sur les procédés autocalmants (Fain (1981), Smadja (1993), Szwec (1993)) analysent cette même composante de rythmicité autosensuelle de survie et rejoignent les formulations de B. Rosenberg pour montrer leur impasse mortifère."
                            }
                        ]
                    }
