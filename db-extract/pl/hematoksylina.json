                "senses": [
                    {
                        "sense_id": "266b27cc-a46b-3f73-a255-57b6c6240287",
                        "entry_id": "7a17be8d-5239-38dc-8c97-689e688e90a9",
                        "glosses": [
                            "związek organiczny o wzorze C₁₆H₁₄O₆ mający niebieski kolor, używany do barwienia niektórych struktur komórkowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "128d22e6-c139-4ea0-9426-b4b8c6c9c10e",
                                "sense_id": "266b27cc-a46b-3f73-a255-57b6c6240287",
                                "text": "Na preparatach zabarwionych hematoksyliną i eozyną melanocyty mają postać jasnych komórek o lekko zasadochłonnej cytoplazmie, z ciemno wybarwionym jądrem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09bbc317-f2c8-467f-9327-03b1cefa2009",
                        "source_entry_id": "7a17be8d-5239-38dc-8c97-689e688e90a9",
                        "source_sense_id": "266b27cc-a46b-3f73-a255-57b6c6240287",
                        "target_lang_word": "hematoxylin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hematoxylin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e9a2e3b-f41a-31d2-b4eb-f0c42333c653",
                                        "entry_id": "bba782bd-0b94-3135-8313-f8e56c71f3b7",
                                        "glosses": [
                                            "A phenolic compound having the chemical formula C₁₆H₁₄O₆, used (most often in conjunction with eosin) to make dye for staining tissue samples; extracted from the heart of bloodwood trees (Haematoxylum campechianum)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b95aacbd-9fc7-4292-9501-3dde739413fb",
                                                "sense_id": "0e9a2e3b-f41a-31d2-b4eb-f0c42333c653",
                                                "text": "Histology sections were cut at 5–6 µm on a rotary microtome, mounted on glass slides, and stained with Harris’s haematoxylin and eosin in a Stainomatic specimen stainer."
                                            },
                                            {
                                                "example_id": "00d2add3-17fd-4cb8-b449-15ca35d50663",
                                                "sense_id": "0e9a2e3b-f41a-31d2-b4eb-f0c42333c653",
                                                "text": "The stains used were hematoxylin and eosin (H&E), Masson's trichrome, and Verhoeff's stain. Sections stained with hematoxylin and eosin have nuclei that were stained blue, cartilage and calcium deposits stained dark blue, cytoplasm and other constituents stained shades of red, and blood stained bright red."
                                            },
                                            {
                                                "example_id": "9d09ecc7-3f58-4e2e-ae1f-9fd9c58e1667",
                                                "sense_id": "0e9a2e3b-f41a-31d2-b4eb-f0c42333c653",
                                                "text": "For overall morphology, sections were stained with hematoxylin and eosin (H&E) to measure mean fiber area."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
