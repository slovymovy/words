                "forms": [
                    {
                        "form_id": "aae07426-56cc-4e64-823b-a7814cae5fcd",
                        "entry_id": "bcc4dbdd-d858-3ae8-bf24-419a7ceb3b7b",
                        "tags": [
                            "plural"
                        ],
                        "form": "marnières"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "062ef690-9c32-3d55-9621-f804cf0d1af5",
                        "entry_id": "bcc4dbdd-d858-3ae8-bf24-419a7ceb3b7b",
                        "glosses": [
                            "Carrière d’où l’on tire de la marne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7897ee0-3fd5-4c07-b188-1cb4fdd2823c",
                                "sense_id": "062ef690-9c32-3d55-9621-f804cf0d1af5",
                                "text": "Il y a des marnières semblables au signal de la Haute-Tuerie. A la Férée, plusieurs marnières, une sur le chemin des Héneaux, trois entre les Héneaux et la ferme Margot (commune de Liart)."
                            },
                            {
                                "example_id": "dd6805fe-449d-4465-a444-12be435d53d9",
                                "sense_id": "062ef690-9c32-3d55-9621-f804cf0d1af5",
                                "text": "J’avais, partout, des points de repère qui guidaient mon esprit ; un dos de paysan, penché sur la glèbe, une masure au détour d’un chemin, un pli de terrain, un chien, une marnière, une trogne de charme ; tout m’y était familier, sinon cher."
                            },
                            {
                                "example_id": "fa74b1db-13d9-4b4a-a881-cd584ccd7a02",
                                "sense_id": "062ef690-9c32-3d55-9621-f804cf0d1af5",
                                "text": "Avec un autre journalier, il travaillait dans une marnière, à une trentaine de mètres de profondeur, quand la terre leur tomba sur la tête."
                            },
                            {
                                "example_id": "da85fcf9-6a50-44f1-9b0e-c3c8210600c6",
                                "sense_id": "062ef690-9c32-3d55-9621-f804cf0d1af5",
                                "text": "[…] en Normandie, des milliers de marnières ont été creusées afin d’en extraire la craie (marne) utilisée pour amender les champs. Les premières extractions remontent à l’époque gallo-romaine, mais cette pratique a connu son apogée au XIXème siècle."
                            }
                        ]
                    },
                    {
                        "sense_id": "698b3502-ae70-34bd-9b1d-ab0a0f75afef",
                        "entry_id": "bcc4dbdd-d858-3ae8-bf24-419a7ceb3b7b",
                        "glosses": [
                            "Cavité non rebouchée après l’abandon d’une carrière de marne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a87f180e-764d-4a65-9345-9567bf4fa058",
                                "sense_id": "698b3502-ae70-34bd-9b1d-ab0a0f75afef",
                                "text": "Tomber dans une marnière."
                            },
                            {
                                "example_id": "429abd06-9989-4a66-bee6-66959fcf8bf3",
                                "sense_id": "698b3502-ae70-34bd-9b1d-ab0a0f75afef",
                                "text": "Aujourd’hui, les marnières sont abandonnées, et, comme toutes les cavités souterraines, elles finissent par s’effondrer."
                            }
                        ]
                    }
                ],
