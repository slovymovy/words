                    },
                    {
                        "sense_id": "fb63c1a7-75eb-3e5a-9296-22bc625206dd",
                        "entry_id": "ca463553-3ece-3fde-9f74-4edfeab5bd5c",
                        "glosses": [
                            "полит. : назначенный представитель главы государства или правительства для управления некоторой территорией, обычно в колониальном контексте"
                        ],
                        "tags": [
                            "в странах британского Содружества"
                        ],
