                        "entry_id": "bf91013b-0e81-3543-a864-a41336e3a7e2",
                        "glosses": [
                            "Währung im Deutschen Reich ab 1871"
                        ],
                        "tags": [
                            "inoffiziell"
                        ],
                        "examples": [
                            {
                                "example_id": "1b735b96-d608-497e-a53b-35f602342deb",
                                "sense_id": "62f32190-4bd0-3107-8faa-e97d4adea6a1",
                                "text": "„Im deutschen Sprachraum kannte man den Gulden nach der Einführung der Goldmark im Jahre 1871 in Österreich-Ungarn noch bis 1900.“"
                            },
                            {
                                "example_id": "666cd84d-0dbd-497d-b2f9-1a8c64c69b31",
                                "sense_id": "62f32190-4bd0-3107-8faa-e97d4adea6a1",
                                "text": "„Weinend und ohne verabschiedet zu werden, fuhr der vernichtete Druso nach Messina zurück, was den selbstlosen Gatten des liebestollen Frauenzimmers immerhin an die achtzigtausend Goldmark gekostet hatte.“"
                            }
                        ],
