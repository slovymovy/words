                ],
                "senses": [
                    {
                        "sense_id": "4f0f4ff6-1aee-3e31-bbbd-808485f52b69",
                        "entry_id": "e3a9a1a7-a677-3c17-82d9-d5aab507b978",
                        "glosses": [
                            "Person, die bei einer Wahl für die Sozialdemokratische Partei Österreichs (SPÖ) gestimmt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a839c13d-753a-4b39-8126-52aa58374ba1",
                                "sense_id": "4f0f4ff6-1aee-3e31-bbbd-808485f52b69",
                                "text": "„Die SPÖ hat mal wieder die sozialdemokratischen Themen aus den Augen verloren. Bis auf ein Beschäftigungsprogramm für ältere Langzeitarbeitslose findet sich nämlich nicht viel zu den aktuellen Problemen, die vermeintliche SPÖ-Wähler umtreiben. Kein Wort zur wachsenden Ungleichheit, zu den Reallohnverlusten und dem ewigen Sparkurs.“"
                            },
                            {
                                "example_id": "92ac71fc-5817-4be8-813b-1349f126b367",
                                "sense_id": "4f0f4ff6-1aee-3e31-bbbd-808485f52b69",
                                "text": "„Für SPÖ-Wähler sind Arbeitsplätze das wichtigste Thema, für ÖVP- und Grün-Wähler sind Bildungsthemen das große Anliegen.“"
                            },
                            {
                                "example_id": "342bcf2a-f641-476e-b009-a7a4875d9087",
                                "sense_id": "4f0f4ff6-1aee-3e31-bbbd-808485f52b69",
                                "text": "„Viele Arbeiter, eigentlich SPÖ-Wähler, haben ihre Stimme diesmal der FPÖ gegeben […].“"
                            },
                            {
                                "example_id": "3e45aace-7bd9-40ab-ad17-aba991207788",
                                "sense_id": "4f0f4ff6-1aee-3e31-bbbd-808485f52b69",
                                "text": "„Für sich gewinnen konnte die FPÖ jeweils lediglich 1.000 Stimmen von ehemaligen SPÖ-Wählern und Wählern sonstiger Parteien.“"
                            },
                            {
                                "example_id": "0dc99bd2-ae3d-4681-980d-c6f6492fe8bb",
                                "sense_id": "4f0f4ff6-1aee-3e31-bbbd-808485f52b69",
                                "text": "„14 Prozent der SPÖ-Wähler und gar 16 Prozent der ÖVP-Wähler von 2005 wählten diesmal die FPÖ.“"
                            },
                            {
                                "example_id": "3e98f248-8b19-4bcd-9d60-35b1da9ab0ae",
                                "sense_id": "4f0f4ff6-1aee-3e31-bbbd-808485f52b69",
                                "text": "„Die SPÖ verlor 193.000 Stimmen an die Grünen, was 14 Prozent aller SPÖ-Wähler von 2017 entspricht.“"
                            },
                            {
                                "example_id": "a173b924-73bb-4fc0-9e3f-c7b27f6f5b73",
                                "sense_id": "4f0f4ff6-1aee-3e31-bbbd-808485f52b69",
                                "text": "[Landtags- und Gemeinderatswahl in Wien 2020:] „Unter den SPÖ-Wählern war Spitzenkandidat und Bürgermeister Michael Ludwig mit 9 Prozent nur das fünftstärkste Motiv hinter \"Gute Arbeit geleistet\" (46 Prozent), \"Stammwähler/in\" (21 Prozent), \"Sozialpolitik\" (15 Prozent) und \"Wahlprogramm\" (10 Prozent).“"
                            },
                            {
                                "example_id": "0abc45af-575e-4235-bb5f-6d04282b6eff",
                                "sense_id": "4f0f4ff6-1aee-3e31-bbbd-808485f52b69",
                                "text": "[Landtags- und Gemeinderatswahl in Wien 2020:] „Widmen wir uns den Motiven der Wähler der einzelnen Parteien. Für 21 Prozent der SPÖ-Wähler war Bürgermeister Michael Ludwig das Hauptmotiv für ihre Entscheidung.“"
                            },
                            {
                                "example_id": "970270db-049a-4aff-9249-fb666d9c9d97",
                                "sense_id": "4f0f4ff6-1aee-3e31-bbbd-808485f52b69",
                                "text": "[Landtags- und Gemeinderatswahl in Wien 2020:] „Aus Sicht der SPÖ-Wähler habe vor allem die Stadtpolitik und die Person des Bürgermeisters eine zentrale Rolle gespielt.“"
                            },
                            {
                                "example_id": "4945ac3b-96f7-403c-a766-f321a7d65e0c",
                                "sense_id": "4f0f4ff6-1aee-3e31-bbbd-808485f52b69",
                                "text": "„SPÖ-Chef Gusenbauer hatte sich bei der Stimmabgabe zuversichtlich gezeigt: »Wir sind seit 1999 stärker geworden. Die SPÖ-Wähler können sich darauf verlassen, dass wir uns an unser Programm halten werden,« sagte er.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
