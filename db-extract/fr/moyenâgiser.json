                "senses": [
                    {
                        "sense_id": "92c78b1b-ff1d-3766-813a-25d1b6f6f2e3",
                        "entry_id": "6db99cf9-3474-350f-997b-5b0a65df3b86",
                        "glosses": [
                            "Donner un caractère moyenâgeux à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20be9dfd-d851-4b0b-982d-30b5f70dc0a2",
                                "sense_id": "92c78b1b-ff1d-3766-813a-25d1b6f6f2e3",
                                "text": "En réalité, cette maison à encorbellement a été « moyenâgisée » mais elle ne date absolument pas du Moyen-Âge mais sans doute du XIXe siècle."
                            },
                            {
                                "example_id": "ca3326cd-b49d-483c-8040-36ef0b45dbf7",
                                "sense_id": "92c78b1b-ff1d-3766-813a-25d1b6f6f2e3",
                                "text": "Prague se « moyenâgise », avec son pont de pierre, ses statues et ses bars à la mode tenus par des Américains."
                            },
                            {
                                "example_id": "245de9b4-5ecb-44b7-be0a-252f7e26799f",
                                "sense_id": "92c78b1b-ff1d-3766-813a-25d1b6f6f2e3",
                                "text": "Il faudrait voir si la règle est Nationale. Mais vu que notre pays se \"Moyenâgise\", tout en l'espérant, j'en doute."
                            }
                        ]
                    }
