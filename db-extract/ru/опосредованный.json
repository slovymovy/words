                        "entry_id": "d18a3b47-8049-3324-a11d-34e6ddfe9586",
                        "glosses": [
                            "страд. прич. прош. вр. от опосредовать"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
