{
    "word_family": [
        "locate",
        "location",
        "locatable",
        "locative",
        "dislocate",
        "relocate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c64e031f-00ba-36dd-b675-707009d43b4e",
                    "sense_definition": "A person or a device, such as a software tool, used to find the position of something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "finding_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I found the opening times for my local branch using the website's store <w>locator</w>.",
                            "target_lang_translations": {
                                "ru": "Я нашел часы работы местного отделения, используя <w>поисковик</w> магазинов на сайте."
                            }
                        },
                        {
                            "text": "The technician used a digital <w>locator</w> to find the underground water pipes.",
                            "target_lang_translations": {
                                "ru": "Техник использовал цифровой <w>локатор</w>, чтобы найти подземные водопроводные трубы."
                            }
                        }
                    ],
                    "synonyms": [
                        "finder",
                        "tracker"
                    ],
                    "common_phrases": [
                        "store locator",
                        "digital locator",
                        "signal locator"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или устройство (например, программный инструмент), используемое для определения местоположения чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "локатор",
                                "target_lang_sense_clarification": "техническое устройство или программа"
                            },
                            {
                                "target_lang_word": "поисковик",
                                "target_lang_sense_clarification": "инструмент для поиска объектов"
                            },
                            {
                                "target_lang_word": "определитель",
                                "target_lang_sense_clarification": "устройство для нахождения координат"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e166bc1b-020b-3cd3-b289-a482471123d3",
                    "sense_definition": "A unique alphanumeric code assigned to a specific travel booking or reservation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "travel_codes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please provide your record <w>locator</w> so I can access your flight details.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, укажите ваш <w>код бронирования</w>, чтобы я мог получить доступ к данным вашего рейса."
                            }
                        },
                        {
                            "text": "You can find the six-digit booking <w>locator</w> at the top of your confirmation email.",
                            "target_lang_translations": {
                                "ru": "Вы можете найти шестизначный <w>локатор</w> бронирования в верхней части письма с подтверждением."
                            }
                        }
                    ],
                    "synonyms": [
                        "confirmation number",
                        "booking reference"
                    ],
                    "common_phrases": [
                        "record locator",
                        "booking locator"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in travel industry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уникальный буквенно-цифровой код, присвоенный конкретному бронированию поездки или резервированию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "код бронирования",
                                "target_lang_sense_clarification": "идентификатор в системе бронирования"
                            },
                            {
                                "target_lang_word": "локатор",
                                "target_lang_sense_clarification": "профессиональный термин в туризме"
                            },
                            {
                                "target_lang_word": "номер брони",
                                "target_lang_sense_clarification": "ссылка на запись о бронировании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "070df4f3-8bc3-330b-acbe-5dae6e9c359f",
                    "sense_definition": "A person who identifies and claims a specific area of land or a mining site.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "land_claims",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gold <w>locator</w> marked the boundaries of his claim with wooden stakes.",
                            "target_lang_translations": {
                                "ru": "Золотоискатель-<w>заявитель</w> отметил границы своего участка деревянными кольями."
                            }
                        },
                        {
                            "text": "Under the old laws, a <w>locator</w> had to register the land within thirty days.",
                            "target_lang_translations": {
                                "ru": "Согласно старым законам, <w>лицо, заявившее права на участок</w>, должно было зарегистрировать землю в течение тридцати дней."
                            }
                        }
                    ],
                    "synonyms": [
                        "claimant"
                    ],
                    "common_phrases": [
                        "mining locator",
                        "land locator"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal and historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, которое идентифицирует и заявляет права на определенный участок земли или месторождение полезных ископаемых."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заявитель",
                                "target_lang_sense_clarification": "лицо, заявляющее права на участок"
                            },
                            {
                                "target_lang_word": "отводчик",
                                "target_lang_sense_clarification": "лицо, производящее отвод земли или участка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}