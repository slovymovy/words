                "senses": [
                    {
                        "sense_id": "e395b0c7-6aa3-3e3f-a7e5-325157f924aa",
                        "entry_id": "7976777f-8709-358b-b0c0-bbf7ed2a6336",
                        "glosses": [
                            "микробиол. то же, что бактериофаг; вирус, избирательно поражающий бактериальные клетки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba645b56-6314-4fd9-83ff-cd7c0eddba29",
                                "sense_id": "e395b0c7-6aa3-3e3f-a7e5-325157f924aa",
                                "text": "В отдельных редких случаях даже близкорасположенные (+) и (―) дают нежизнеспособный фаг."
                            },
                            {
                                "example_id": "55b90552-20c6-4c3c-b8e8-60757cfef314",
                                "sense_id": "e395b0c7-6aa3-3e3f-a7e5-325157f924aa",
                                "text": "Кто видел, как фаг впрыскивает себя в тифозную бактерию?"
                            }
                        ]
                    }
                ],
