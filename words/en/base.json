                                "target_lang_word": "üs",
                                "target_lang_sense_clarification": "askeri tesis"
                            },
                            {
                                "target_lang_word": "karargâh",
                                "target_lang_sense_clarification": "askeri yönetim merkezi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "基地",
                                "target_lang_sense_clarification": "军事基地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b612527b-e1fa-3e34-bcf7-d2a90587c386",
                    "sense_definition": "The place where decisions for an organization are made; headquarters.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "location_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's European <w>base</w> is located in Frankfurt.",
                            "target_lang_translations": {
                                "ru": "Европейская <w>штаб-квартира</w> компании находится во Франкфурте.",
                                "tr": "Şirketin Avrupa <w>merkezi</w> Frankfurt'ta yer almaktadır.",
                                "zh": "该公司的欧洲<w>总部</w>位于法兰克福。"
                            }
                        },
                        {
                            "text": "They used the hotel as a <w>base</w> for their travels around the region.",
                            "target_lang_translations": {
                                "ru": "Они использовали отель как <w>базу</w> для путешествий по региону.",
                                "tr": "Otel bölgedeki gezileri için bir <w>üs</w> olarak kullandılar.",
                                "zh": "他们把酒店当作在该地区旅行的<w>基地</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "home base",
                        "base of operations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место принятия решений организации; штаб-квартира.",
                        "tr": "Bir kuruluş için kararların alındığı yer; genel merkez veya faaliyet merkezi.",
                        "zh": "组织进行决策的地方；总部或运营中心。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "база",
                                "target_lang_sense_clarification": "центр операций"
                            },
                            {
                                "target_lang_word": "штаб-квартира",
                                "target_lang_sense_clarification": "главный офис"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "merkez",
                                "target_lang_sense_clarification": "genel merkez, yönetim yeri"
                            },
                            {
                                "target_lang_word": "üs",
                                "target_lang_sense_clarification": "faaliyetlerin yürütüldüğü ana nokta"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总部",
                                "target_lang_sense_clarification": "决策中心"
                            },
                            {
                                "target_lang_word": "基地",
                                "target_lang_sense_clarification": "活动中心"
                            }
                        ]
                    }
