                                "sense_id": "716e1ee7-8342-35b3-b4a4-a4444df0e6f2",
                                "text": "- Hast du Spaß gehabt? -Jein.",
                                "translation": "- Tu t’es amusé ? - Mouais."
                            },
                            {
                                "example_id": "040f9bf0-7341-4f8c-b9b1-bd48cf4116d7",
                                "sense_id": "716e1ee7-8342-35b3-b4a4-a4444df0e6f2",
                                "text": "- Gefällt dir das Geschenk? - Jein.",
                                "translation": "- Est-ce que le cadeau te plait ? - Mouais."
                            }
                        ]
                    }
