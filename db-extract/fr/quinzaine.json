        "fr-extract.jsonl": [
            {
                "entry_id": "7a175dac-995e-3f58-934f-f6073b284575",
                "word": "quinzaine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "25fb25cb-e026-4413-b207-8a89d4f1fc82",
                        "entry_id": "7a175dac-995e-3f58-934f-f6073b284575",
                        "tags": [
                            "plural"
                        ],
                        "form": "quinzaines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7791faa-11ff-3dd7-a1c4-b6df312c289c",
                        "entry_id": "7a175dac-995e-3f58-934f-f6073b284575",
                        "glosses": [
                            "Réunion de choses de même nature, au nombre de quinze ou à peu près."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81b7b23c-ad4f-4473-b462-fd77063367af",
                                "sense_id": "c7791faa-11ff-3dd7-a1c4-b6df312c289c",
                                "text": "On nous a, en effet, envoyé pour la détermination une liane caoutchoutifère congolaise pouvant atteindre une quinzaine de mètres de hauteur et dont les tiges, privées de vrilles, sont volubiles."
                            },
                            {
                                "example_id": "135b47fc-5cbf-40e9-9f25-f4c90791c276",
                                "sense_id": "c7791faa-11ff-3dd7-a1c4-b6df312c289c",
                                "text": "On cueillait depuis une quinzaine de jours, au long des routes vicinales, aux orées des « longs champs », autour des villages, sur des lieues et des lieues de terroir, par toutes les vallées."
                            },
                            {
                                "example_id": "554e6ee9-c7ab-49f7-aba6-ef91a9847548",
                                "sense_id": "c7791faa-11ff-3dd7-a1c4-b6df312c289c",
                                "text": "Voici une quinzaine de mois, il cherchait des cèpes, devers les Bois du Roy, loin du hameau, au long de la frontière."
                            },
                            {
                                "example_id": "592c658f-dbdc-41d7-9c2b-010656153e48",
                                "sense_id": "c7791faa-11ff-3dd7-a1c4-b6df312c289c",
                                "text": "Il œuvre dans le domaine du plein air (randonnée pédestre, escalade, vélo, ski de fond, etc.) depuis une quinzaine d'années et a été recherchiste pour l'émission de télévision Oxygène (1992-1993)."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd31f4cb-dc25-3985-92a3-9a59773ea0ab",
                        "entry_id": "7a175dac-995e-3f58-934f-f6073b284575",
                        "glosses": [
                            "Quinze jours ; deux semaines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "939e2451-1e28-4401-b447-2c5d7cdcdf44",
                                "sense_id": "bd31f4cb-dc25-3985-92a3-9a59773ea0ab",
                                "text": "L’exploitation ne devrait avoir lieu que quand la sève est stationnaire, c’est-à-dire depuis la première quinzaine d’octobre jusqu’au 1ᵉʳ janvier. Les bois coupés dans cette période sont d’une plus longue durée lorsqu’ils sont mis en œuvre ; […]."
                            },
                            {
                                "example_id": "08cd5aab-9803-4065-9149-7803e1672d1e",
                                "sense_id": "bd31f4cb-dc25-3985-92a3-9a59773ea0ab",
                                "text": "La moisson de l’orge a lieu aux premiers jours de mai, celle du blé dans la seconde quinzaine de ce mois, celle du maïs au commencement de juin, et celle des légumineuses un peu plus tard."
                            },
                            {
                                "example_id": "3270b5f8-eaad-4d09-aebc-60814fba5e4a",
                                "sense_id": "bd31f4cb-dc25-3985-92a3-9a59773ea0ab",
                                "text": "– Pas des tas de mangeaille solide, – observa-t-il, – mais bah ! il y en aura bien pour une quinzaine, et on ne sait pas ce qui peut arriver en quinze jours."
                            },
                            {
                                "example_id": "267c6792-c678-4b21-911f-7e04460b5798",
                                "sense_id": "bd31f4cb-dc25-3985-92a3-9a59773ea0ab",
                                "text": "Quand Erna était revenue de Berlin dans la petite ville après son entrevue avec le docteur Meyer-Fehr, elle était bien persuadée qu’elle allait mourir dans la quinzaine. Elle y mettait un entêtement de femme et voulait à toute force se faire enterrer ici."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd2a565a-b35a-47c5-a8b6-658be6b31cfd",
                        "source_entry_id": "7a175dac-995e-3f58-934f-f6073b284575",
                        "target_lang_word": "fortnight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fortnight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a15cc0b-4df7-3d7c-b992-372d26858d07",
                                        "entry_id": "837c4668-ed09-35d1-9e84-6b07430eda71",
                                        "glosses": [
                                            "A period of 2 weeks."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f37dede5-7b47-45a2-a9a2-4d4467227855",
                                                "sense_id": "5a15cc0b-4df7-3d7c-b992-372d26858d07",
                                                "text": "Holonyms: month < year < gigasecond < century < kiloannum, kiloyear, millennium < terasecond < mega-annum, megayear < petasecond < giga-annum, gigayear < exasecond < zettasecond < yottasecond < ronnasecond < quettasecond"
                                            },
                                            {
                                                "example_id": "fb210f32-6b11-4b43-9586-bd5f7e968e38",
                                                "sense_id": "5a15cc0b-4df7-3d7c-b992-372d26858d07",
                                                "text": "Meronyms: quectosecond < rontosecond < yoctosecond < zeptosecond < attosecond < femtosecond < picosecond < nanosecond < microsecond < millisecond < centisecond < decisecond < second < decasecond < minute < hectosecond < kilosecond < hour < day < week < megasecond"
                                            },
                                            {
                                                "example_id": "6b570589-4ee8-4399-a39d-cfe7b7890748",
                                                "sense_id": "5a15cc0b-4df7-3d7c-b992-372d26858d07",
                                                "text": "Near-synonym: halfmonth"
                                            },
                                            {
                                                "example_id": "ae38c626-1df8-4cc3-aa92-d72e66a43aa6",
                                                "sense_id": "5a15cc0b-4df7-3d7c-b992-372d26858d07",
                                                "text": "On being kicked the girl fell desperately in love with Henri, and for a fortnight they lived together and spent a thousand francs of Henri's money."
                                            },
                                            {
                                                "example_id": "aa88d7d4-378b-4d82-a00b-e8336b3e4cdd",
                                                "sense_id": "5a15cc0b-4df7-3d7c-b992-372d26858d07",
                                                "text": "The “lame duck” Johnson Administration, in its final fortnight in office, grappled last week with a diplomatic hot potato in the form of the latest Soviet proposal for a “just and lasting” Middle East peace settlement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
