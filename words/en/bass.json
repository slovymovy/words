                                "target_lang_word": "басовый",
                                "target_lang_sense_clarification": "прилагательное"
                            },
                            {
                                "target_lang_word": "низкий",
                                "target_lang_sense_clarification": "о звуке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "低音的",
                                "target_lang_sense_clarification": "形容词"
                            },
                            {
