        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1d992736-ed96-396c-a830-67efaa10f35f",
                    "sense_definition": "A small piece which breaks off from baked food such as cake, biscuit or bread.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "small_piece",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The birds gathered on the patio to eat the <w>crumbs</w> of bread.",
                            "target_lang_translations": {
                                "cs": "Ptáci se shromáždili na terase, aby sezobali <w>drobky</w> chleba."
                            }
                        },
                        {
                            "text": "She brushed the <w>crumbs</w> off the table after finishing her breakfast.",
                            "target_lang_translations": {
                                "cs": "Po snídani smetla ze stolu <w>drobky</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fragment",
                        "morsel"
                    ],
                    "common_phrases": [
                        "bread crumbs"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malý kousek, který se odlomí z pečeného jídla, jako je koláč, sušenka nebo chléb."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "drobek",
                                "target_lang_sense_clarification": "malý úlomek potravy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5806f372-5d63-3792-be9b-b2e15fd3c158",
                    "sense_definition": "A small piece of any other solid substance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "small_piece",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eraser left tiny <w>crumbs</w> of rubber all over the paper.",
                            "target_lang_translations": {
                                "cs": "Guma zanechala na papíře drobné <w>drobečky</w> gumy."
                            }
                        },
                        {
                            "text": "He carefully cleaned the <w>crumbs</w> of dried paint from the desk.",
                            "target_lang_translations": {
                                "cs": "Pečlivě očistil ze stolu <w>drobečky</w> zaschlé barvy."
                            }
                        }
                    ],
                    "synonyms": [
                        "particle",
                        "speck"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malý kousek jakékoli jiné pevné látky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "drobeček",
                                "target_lang_sense_clarification": "malý úlomek nebo částečka"
                            },
                            {
                                "target_lang_word": "úlomek",
                                "target_lang_sense_clarification": "malý kousek pevné látky"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0cb24fa-f7ed-3734-a842-16488bef6106",
                    "sense_definition": "A very small amount of something abstract.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He found a <w>crumb</w> of hope in the difficult situation.",
                            "target_lang_translations": {
                                "cs": "V té těžké situaci našel <w>trochu</w> naděje."
                            }
                        },
                        {
                            "text": "There was not a <w>crumb</w> of evidence to support his claim.",
                            "target_lang_translations": {
                                "cs": "Nebyl ani <w>náznak</w> důkazu, který by podpořil jeho tvrzení."
                            }
                        }
                    ],
                    "synonyms": [
                        "trace",
                        "iota"
                    ],
                    "common_phrases": [
                        "crumb of comfort"
                    ],
                    "target_lang_definitions": {
                        "cs": "Velmi malé množství něčeho abstraktního."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "trocha",
                                "target_lang_sense_clarification": "malé množství (figurativně)"
                            },
                            {
                                "target_lang_word": "náznak",
                                "target_lang_sense_clarification": "velmi malé množství nebo stopa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78b65da8-27bb-3a1f-84a7-920340e7bea2",
                    "sense_definition": "The soft internal portion of bread, surrounded by crust.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some people prefer the soft <w>crumb</w> of the bread over the crunchy crust.",
                            "target_lang_translations": {
                                "cs": "Někteří lidé dávají přednost měkké <w>střídce</w> chleba před křupavou kůrkou."
                            }
                        },
                        {
                            "text": "The baker checked the <w>crumb</w> of the loaf to ensure it was baked perfectly.",
                            "target_lang_translations": {
                                "cs": "Pekař zkontroloval <w>střídku</w> bochníku, aby se ujistil, že je dokonale upečený."
                            }
                        }
                    ],
                    "antonyms": [
                        "crust"
                    ],
                    "target_lang_definitions": {
                        "cs": "Měkká vnitřní část chleba obklopená kůrkou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "střídka",
                                "target_lang_sense_clarification": "vnitřní měkká část pečiva"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ccf757e-dcb0-3563-ab16-3a87b46ed613",
                    "sense_definition": "A worthless or insignificant person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is such a <w>crumb</w> for treating his friends that way.",
                            "target_lang_translations": {
                                "cs": "Je to taková <w>nula</w>, že se ke svým přátelům chová takovým způsobem."
                            }
                        },
                        {
                            "text": "Don't listen to that <w>crumb</w>; he doesn't know what he is talking about.",
                            "target_lang_translations": {
                                "cs": "Neposlouchej tu <w>nulu</w>; neví, o čem mluví."
                            }
                        }
                    ],
                    "synonyms": [
                        "nobody",
                        "loser"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and derogatory."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Bezcenný nebo bezvýznamný člověk."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nula",
                                "target_lang_sense_clarification": "bezvýznamný člověk (pejorativně)"
                            },
                            {
                                "target_lang_word": "chudák",
                                "target_lang_sense_clarification": "člověk, kterým opovrhujeme"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04dabf14-26d6-3a5b-84a8-3135330061ed",
                    "sense_definition": "To break something into small pieces with the fingers.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>crumb</w> the bread before adding it to the soup.",
                            "target_lang_translations": {
                                "cs": "Před přidáním do polévky bys měl chléb <w>rozdrobit</w>."
                            }
                        },
                        {
                            "text": "She began to <w>crumb</w> the dry cake into the bowl for the recipe.",
                            "target_lang_translations": {
                                "cs": "Začala <w>drolit</w> suchý koláč do mísy podle receptu."
                            }
                        }
                    ],
                    "synonyms": [
                        "crumble"
                    ],
                    "target_lang_definitions": {
                        "cs": "Rozdrobit něco prsty na malé kousky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozdrobit",
                                "target_lang_sense_clarification": "rozlámat na malé kousky"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84329f9e-d063-3004-87e5-d768ab11cc82",
                    "sense_definition": "To cover food with breadcrumbs before cooking.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is best to <w>crumb</w> the chicken fillets before frying them.",
                            "target_lang_translations": {
                                "cs": "Kuřecí řízky je nejlepší před smažením <w>obalit ve strouhance</w>."
                            }
                        },
                        {
                            "text": "Make sure to <w>crumb</w> the fish evenly for a crispy texture.",
                            "target_lang_translations": {
                                "cs": "Ujisti se, že rybu <w>obalíš ve strouhance</w> rovnoměrně, aby byla křupavá."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Obalit jídlo ve strouhance před tepelnou úpravou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "obalit ve strouhance",
                                "target_lang_sense_clarification": "příprava jídla před smažením"
                            }
                        ]
                    }
                }
            ]
        }
    ]
