                "senses": [
                    {
                        "sense_id": "834194c6-9ac9-3844-9f0b-8dd94db9d836",
                        "entry_id": "8a60197d-47ee-3074-9632-f2517f97449f",
                        "glosses": [
                            "Qui se situe autour de la langue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "051cbecf-3577-4745-84f1-f25028971f14",
                                "sense_id": "834194c6-9ac9-3844-9f0b-8dd94db9d836",
                                "text": "On observe à leur pourtour de la rougeur, de la tuméfaction ; les glandes salivaires et périlinguales sécrètent une grande quantité de liquide qui afflue sans cesse dans la bouche et est souvent lancé, par jet, quand on explore la cavité buccale."
                            },
                            {
                                "example_id": "916072c0-98b8-40d1-a9bc-acccf7b4b277",
                                "sense_id": "834194c6-9ac9-3844-9f0b-8dd94db9d836",
                                "text": "L’examen endobuccal montre la différence entre le bourret périlingual dur, qui bloque la langue, et les collections circonscrites, fluctuantes, du plancher par ostéophlegmons de la lame interne du maxillaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "33490fd9-cc33-3f79-be89-ca853db3d213",
                        "entry_id": "8a60197d-47ee-3074-9632-f2517f97449f",
                        "glosses": [
                            "Qui apparaît au moment de l’apprentissage du langage. Ce terme s’utilise essentiellement à propos de la surdité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1119e9d9-fb6a-4099-ac0c-ff4656e454a7",
                                "sense_id": "33490fd9-cc33-3f79-be89-ca853db3d213",
                                "text": "… une surdité est dite congénitale si elle survient avant la naissance, prélinguale si elle survient avant l'âge de 2 ans, périlinguale si elle survient entre 2 et 5 ans et postlinguale si elle survient après l’âge de 6 ans."
                            },
                            {
                                "example_id": "d44eef67-796c-4e1f-b9e7-72ee1604f240",
                                "sense_id": "33490fd9-cc33-3f79-be89-ca853db3d213",
                                "text": "Les conséquences d’une surdité pré- ou périlinguale sur le développement du langage oral sont majeures, quel que soit le type et quel que soit le degré de cette surdité …."
                            }
                        ]
                    }
