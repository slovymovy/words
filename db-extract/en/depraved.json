                                            {
                                                "example_id": "905185c1-cb2c-4949-b874-b7f6f7a29db4",
                                                "sense_id": "bf2620ed-fa13-341e-b6bc-d4589ec62578",
                                                "text": "En hebben hun goden in het vuur geworpen; want zij waren geen goden, maar het werk van mensenhanden, hout en steen; daarom hebben zij die verdorven."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "verdorven",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b3708dba-04da-3b04-b2ee-9410393b2c96",
                                        "entry_id": "f4973b0e-30d3-36f8-86e8-80835c0d7c82",
                                        "glosses": [
                                            "helemaal rot, door en door slecht (in morele zin)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32d074f8-b384-4e52-a02a-645035d98741",
                                                "sense_id": "b3708dba-04da-3b04-b2ee-9410393b2c96",
                                                "text": "Waar we niets mee opschieten om het geweld te begrijpen zijn filosofische en theologische beschouwingen over zoiets als ‘de menselijke natuur’. Die zou verdorven en slecht zijn, ‘de mens’ zou een kwaadaardig en zondig wezen zijn."
                                            },
                                            {
                                                "example_id": "37df466c-249f-4302-b67f-3fd89ef410f7",
                                                "sense_id": "b3708dba-04da-3b04-b2ee-9410393b2c96",
                                                "text": "Over Snapchat heeft Merel geen goed woord over. “Het is gewoon een verdorven medium. Dat je daar anonieme accounts kunt aanmaken, zorgt ervoor dat kinderen elkaar de vreselijkste dingen kunnen aandoen terwijl ze hun werkelijke identiteit schuilhouden.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9becd1fe-27b2-4045-80eb-6bfad675a602",
                        "source_entry_id": "97b9b613-83ba-318f-822c-8f5252358f15",
                        "source_sense_description": "extremely wrong in a moral sense",
                        "target_lang_word": "dépravé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépravé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3fc55716-cabc-3def-aad7-abd2fd9ccc69",
                                        "entry_id": "b86f6d0d-9200-3b78-bc1b-7c4d84872640",
                                        "glosses": [
                                            "Qui vit dans la dépravation, dans la débauche, dans le vice."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ad68fca-3190-4920-a157-1a236263a662",
                                                "sense_id": "3fc55716-cabc-3def-aad7-abd2fd9ccc69",
                                                "text": "Elle n’était pas dépravée ; sa passion, au contraire, se montrait robuste et saine, et, dans ses embrassements, elle avait la noblesse terrible, l’héroïsme rugissant des grands fauves."
                                            },
                                            {
                                                "example_id": "f803fbd0-6dab-4918-bf7e-359434a708b0",
                                                "sense_id": "3fc55716-cabc-3def-aad7-abd2fd9ccc69",
                                                "text": "Dans le nombre de ces Parisiens accusés d’être si spirituels, il s’en trouve qui se croient infiniment mieux en uniforme que dans leurs habits ordinaires, et qui supposent chez les femmes des goûts assez dépravés pour imaginer qu’elles seront favorablement impressionnées à l’aspect d’un bonnet à poil et par le harnais militaire."
                                            },
                                            {
                                                "example_id": "fb938e1c-1b99-4e76-bf0d-45fcd16419c1",
                                                "sense_id": "3fc55716-cabc-3def-aad7-abd2fd9ccc69",
                                                "text": "Carel me parla d'une querelle entre eux, Rembrandt me traitant de prostituée, de soiffarde dépravée, alors Carel l'a frappé. Il l'a frappé... Pour moi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dépravé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2af6391b-9f83-34f3-a0cc-4cae1560992d",
                                        "entry_id": "c131b573-d632-3e82-ae9f-0f28024640c4",
                                        "glosses": [
                                            "Participe passé masculin singulier de dépraver."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36f9cea0-c1c7-4469-b36e-b55d94726dbc",
                                                "sense_id": "2af6391b-9f83-34f3-a0cc-4cae1560992d",
                                                "text": "Moins surveillé par David à Angoulême, soit que plus âgé il inspirât plus de confiance à son mentor, soit que l’imprimeur comptât sur l’influence de la province, Cérizet était devenu, mais à l’insu de son tuteur, le don Juan en casquette de trois ou quatre petites ouvrières, et s’était dépravé complètement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
