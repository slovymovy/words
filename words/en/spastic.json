{
    "word_family": [
        "spastically",
        "spasticity",
        "spasm"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "049e543e-be19-3cd5-9379-44c73df8857e",
                    "sense_definition": "Relating to, characterized by, or affected by involuntary muscle spasms.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient experienced severe <w>spastic</w> contractions in her legs after the injury.",
                            "target_lang_translations": {
                                "zh": "受伤后，该患者腿部出现了严重的<w>痉挛性</w>收缩。"
                            }
                        },
                        {
                            "text": "Medication was prescribed to relieve the painful <w>spastic</w> episodes.",
                            "target_lang_translations": {
                                "zh": "医生开了药以缓解令人痛苦的<w>痉挛</w>发作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spasmodic"
                    ],
                    "common_phrases": [
                        "spastic colon",
                        "spastic contractions"
                    ],
                    "target_lang_definitions": {
                        "zh": "与不自主的肌肉痉挛相关的、由其引起的或受其影响的；痉挛性的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "痉挛性的",
                                "target_lang_sense_clarification": "指肌肉不自主抽搐或收缩"
                            },
                            {
                                "target_lang_word": "痉挛的",
                                "target_lang_sense_clarification": "指肌肉发生抽搐或抽筋"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "961077bf-35c2-3dee-a0c1-2689a47a7974",
                    "sense_definition": "Relating to or affected by cerebral palsy or spastic paralysis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Physical therapy helps improve mobility for individuals with <w>spastic</w> diplegia.",
                            "target_lang_translations": {
                                "zh": "物理治疗有助于改善<w>痉挛性</w>双瘫患者的活动能力。"
                            }
                        },
                        {
                            "text": "The clinic provides specialized treatment for <w>spastic</w> cerebral palsy.",
                            "target_lang_translations": {
                                "zh": "该诊所为<w>痉挛型</w>脑性瘫痪提供专业治疗。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spastic diplegia",
                        "spastic cerebral palsy"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "now often considered offensive outside of technical medical terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "与脑瘫或痉挛性瘫痪有关的；患痉挛性瘫痪的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "痉挛型",
                                "target_lang_sense_clarification": "医学上指脑瘫或瘫痪的痉挛类型"
                            },
                            {
                                "target_lang_word": "痉挛性",
                                "target_lang_sense_clarification": "指伴有肌张力增高的瘫痪或病症"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cffcfa37-4aed-36a2-9553-df2c9873b47a",
                    "sense_definition": "Exhibiting frantic, hyperactive, or erratic behavior.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavioral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The excited puppy ran in circles with sudden <w>spastic</w> bursts of energy.",
                            "target_lang_translations": {
                                "zh": "兴奋的小狗突然像<w>发狂似的</w>精力爆发，一圈圈乱跑。"
                            }
                        },
                        {
                            "text": "He made erratic, <w>spastic</w> gestures while trying to explain his wild idea.",
                            "target_lang_translations": {
                                "zh": "他在试图解释自己疯狂的想法时，做出了不稳定而<w>狂乱的</w>手势。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hyperactive",
                        "erratic",
                        "frenetic"
                    ],
                    "antonyms": [
                        "calm"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage, chiefly North American, sometimes considered offensive"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "疯狂的、多动的或举止失常不稳定的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "狂乱的",
                                "target_lang_sense_clarification": "指情绪或动作极度狂躁、不受控制"
                            },
                            {
                                "target_lang_word": "发狂似的",
                                "target_lang_sense_clarification": "指动作极度躁动、反常"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55ba924b-fdad-3354-835a-c291f73e5018",
                    "sense_definition": "Clumsy, awkward, or incompetent.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pejorative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He dropped every pass and felt completely <w>spastic</w> during the match.",
                            "target_lang_translations": {
                                "zh": "他在比赛中漏掉了每一次传球，觉得自己完全是<w>笨手笨脚的</w>。"
                            }
                        },
                        {
                            "text": "Her clumsy movements looked entirely <w>spastic</w> on the dance floor.",
                            "target_lang_translations": {
                                "zh": "她在舞池里笨拙的动作看起来完全是<w>不协调的</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clumsy",
                        "uncoordinated",
                        "awkward"
                    ],
                    "antonyms": [
                        "graceful",
                        "coordinated"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "highly offensive pejorative, especially in British and Commonwealth English"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "笨拙的、动作不协调的或无能的（常具冒犯性）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "笨拙的",
                                "target_lang_sense_clarification": "指肢体不协调、动作笨手笨脚"
                            },
                            {
                                "target_lang_word": "笨手笨脚的",
                                "target_lang_sense_clarification": "口语，指动作极不协调"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e9dc48e8-2e64-368b-883a-9fbb1779f2b9",
                    "sense_definition": "A person affected by spastic paralysis or cerebral palsy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical charity originally raised funds to assist adult <w>spastics</w>.",
                            "target_lang_translations": {
                                "zh": "该历史慈善机构最初筹集资金是为了帮助成年<w>痉挛瘫患者</w>。"
                            }
                        },
                        {
                            "text": "Referring to an affected patient as a <w>spastic</w> is now avoided in medicine.",
                            "target_lang_translations": {
                                "zh": "在医学界，现在避免将患病的人称为<w>痉挛瘫患者</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "now widely considered offensive"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "痉挛性瘫痪或脑瘫患者（旧称，现多具冒犯性）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "痉挛瘫患者",
                                "target_lang_sense_clarification": "医学旧称，指痉挛性麻痹患者"
                            },
                            {
                                "target_lang_word": "脑瘫患者",
                                "target_lang_sense_clarification": "患有痉挛性脑瘫的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75da430c-a16f-36ae-9208-79fafaad4563",
                    "sense_definition": "An incompetent, clumsy, or foolish person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pejorative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cruel bully shouted at the boy, calling him a clumsy <w>spastic</w>.",
                            "target_lang_translations": {
                                "zh": "那个残酷的恶霸冲着男孩大吼，骂他是个笨拙的<w>笨蛋</w>。"
                            }
                        },
                        {
                            "text": "He tripped over his own boots and cursed himself as a <w>spastic</w>.",
                            "target_lang_translations": {
                                "zh": "他被自己的靴子绊倒了，暗骂自己是个<w>窝囊废</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "highly offensive slur, particularly in the UK and Ireland"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "无能、笨拙或愚蠢的人（极具侮辱性的冒犯词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "笨蛋",
                                "target_lang_sense_clarification": "侮辱性称呼手脚笨拙或无能的人"
                            },
                            {
                                "target_lang_word": "窝囊废",
                                "target_lang_sense_clarification": "蔑称无用或愚蠢的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}