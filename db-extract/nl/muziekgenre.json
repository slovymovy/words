                "senses": [
                    {
                        "sense_id": "baca1554-322b-3f00-90e2-e2b8fe44dfb5",
                        "entry_id": "b538eadf-a105-3a33-805a-19c6cbfc6edb",
                        "glosses": [
                            "een bepaald muziekstijl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5aac2fcd-0089-4241-bfb5-c524f565ef1f",
                                "sense_id": "baca1554-322b-3f00-90e2-e2b8fe44dfb5",
                                "text": "Muziekjournalist Atze de Vrieze zegt dat Bennington met de band het muziekgenre nu metal groot heeft gemaakt."
                            },
                            {
                                "example_id": "ef4700e9-157e-4e3f-a39b-8789c2ddc274",
                                "sense_id": "baca1554-322b-3f00-90e2-e2b8fe44dfb5",
                                "text": "60.000 doden vielen er al in de Mexicaanse drugsoorlog. Vanaf vanavond draait er een documentaire over op IDFA: Narco Cultura. Over het rauwe geweld in Mexico en over narcocorridos, het muziekgenre dat het geweld en de drugs verheerlijkt. Razend populair, in Mexico, maar ook in de VS."
                            },
                            {
                                "example_id": "15988f51-22fb-4b87-9c79-8ca3f6975f90",
                                "sense_id": "baca1554-322b-3f00-90e2-e2b8fe44dfb5",
                                "text": "De 43-jarige Rivera, een in Californië geboren dochter van Mexicaanse immigranten, had de bijnaam 'La Diva de la Banda'. In dat muziekgenre wordt een solist begeleid door een mariachi, een Mexicaans (straat)orkest."
                            }
                        ]
                    }
