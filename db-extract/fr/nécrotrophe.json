                "senses": [
                    {
                        "sense_id": "3edf7290-08e2-3f2f-baf7-a1c849103ae5",
                        "entry_id": "e8072a0f-bb3d-396f-aa1d-74ecc548a595",
                        "glosses": [
                            "Organisme vivant qui croît sur les végétaux en saprophyte, en détruisant les cellules vivantes de la plante hôte."
                        ],
                        "tags": [
                            "Agronomie"
                        ],
                        "examples": [
                            {
                                "example_id": "19e2bd58-2a38-4b2c-811b-1f404b94e384",
                                "sense_id": "3edf7290-08e2-3f2f-baf7-a1c849103ae5",
                                "text": "Un éliciteur provoquant le « suicide » des cellules qu’il atteint, compromettant le succès de l’infection par un parasite biotrophe pourrait être au contraire une arme redoutable si par hasard un nécrotrophe, parasite de faiblesse sur tissus sénescents en était doté."
                            },
                            {
                                "example_id": "970c865b-90d0-4c67-80dd-c08bba36c788",
                                "sense_id": "3edf7290-08e2-3f2f-baf7-a1c849103ae5",
                                "text": "Il se comporte comme un nécrotrophe, tuant d’abord les cellules avant de s’en nourrir."
                            },
                            {
                                "example_id": "2a607b59-f73b-41a7-99c6-291b6a5b5e17",
                                "sense_id": "3edf7290-08e2-3f2f-baf7-a1c849103ae5",
                                "text": "D’autres champignons, les nécrotrophes, sont des saprophytes facultatifs. Ils peuvent se développer en tant que parasite sur les hôtes, puis continuer à vivre, croître et se multiplier sur les tissus morts de l’hôte après sa mort."
                            }
                        ]
                    }
