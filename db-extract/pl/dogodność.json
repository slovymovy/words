                    {
                        "translation_id": "92ec508c-5cb1-48c2-9d1e-dc266b0f7888",
                        "source_entry_id": "21f4cfb2-d87f-32af-b3f9-91a4ad8efd65",
                        "source_sense_id": "dab38fc8-10aa-30eb-8b6b-a612fcc41153",
                        "target_lang_word": "Annehmlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Annehmlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ac08c54-38cb-369f-a394-418ea754e413",
                                        "entry_id": "f6bc1c88-2c94-3d7d-957d-0d58eeb96db2",
                                        "glosses": [
                                            "ein Vorteil oder Zufriedenheit bringender Umstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd6f1362-ad43-44dc-a5a3-088a9f3987d5",
                                                "sense_id": "8ac08c54-38cb-369f-a394-418ea754e413",
                                                "text": "Auf die Annehmlichkeiten des Internets wollen sehr viele Menschen nicht mehr verzichten."
                                            },
                                            {
                                                "example_id": "fbf3eab9-dd24-4a76-a814-490a65f1b5ab",
                                                "sense_id": "8ac08c54-38cb-369f-a394-418ea754e413",
                                                "text": "„So lässt sich das Bild einer pulsierenden Metropole rekonstruieren, die ihren Bewohnern alle Annehmlichkeiten, aber auch alle Probleme städtischen Lebens bot.“"
                                            },
                                            {
                                                "example_id": "f80160c7-0e23-4f5f-954a-2a7886731a9c",
                                                "sense_id": "8ac08c54-38cb-369f-a394-418ea754e413",
                                                "text": "„Aus den kargen Andeutungen des Patrons, die er sich schwerfällig genug abringen ließ, erfuhr Robert, daß er derzeit der einzige Hausgast sei, was ihm die Annehmlichkeit biete, sich ungestört bewegen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8f4ff5a-0144-4323-a25c-4211d8528133",
                        "source_entry_id": "21f4cfb2-d87f-32af-b3f9-91a4ad8efd65",
                        "source_sense_id": "dab38fc8-10aa-30eb-8b6b-a612fcc41153",
                        "target_lang_word": "Bequemlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bequemlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22c7101c-bd3f-31c2-a67d-4af1947348c1",
                                        "entry_id": "691318b6-aa18-30ec-ab69-fa0ee7e3dc4a",
                                        "glosses": [
                                            "das Vorhandensein angenehmer Gefühle aufgrund der Anwesenheit bestimmter Gegenstände, Geräte und Einrichtungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0794bed5-1c31-4012-8909-288665eb5538",
                                                "sense_id": "22c7101c-bd3f-31c2-a67d-4af1947348c1",
                                                "text": "„Er lebte die Tage seiner Kindheit vergnügt und froh, und umgeben von allem Glanz und Bequemlichkeit der Erde.“"
                                            },
                                            {
                                                "example_id": "33d2832e-b3c0-4cf5-a3f4-df4512eec64c",
                                                "sense_id": "22c7101c-bd3f-31c2-a67d-4af1947348c1",
                                                "text": "„Persönlich bin ich ein großer Fan von Komfort und Bequemlichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "629a99e1-ef8f-32ba-bc37-e8e2b0e7db0d",
                                        "entry_id": "691318b6-aa18-30ec-ab69-fa0ee7e3dc4a",
                                        "glosses": [
                                            "fehlende Motivation, irgendetwas zu tun"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0f0fb3d-7ff0-4f1b-9f2c-e313b985575e",
                                                "sense_id": "629a99e1-ef8f-32ba-bc37-e8e2b0e7db0d",
                                                "text": "„[…] daß Mütter ihre Kinder nicht selbst stillen, hat auch hier gegen frühere Zeiten sehr überhand genommen, deren Ursache mehr in gesuchter Bequemlichkeit und Gemächlichkeit, als in dem von vielen vorgeschützten Unvermögen, oder einer vermeintlichen, selten wirklichen Schwäche gegründet ist; […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63488b0e-23d1-4808-8047-33f9528f4882",
                        "source_entry_id": "21f4cfb2-d87f-32af-b3f9-91a4ad8efd65",
                        "source_sense_id": "f5dc7b1f-508d-3b06-9bd6-82c219735a71",
                        "target_lang_word": "Vorteil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorteil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77a455f3-4997-3629-8d28-01e4f14a4c23",
                                        "entry_id": "097f40d3-2f9e-35c0-be3e-8150e6b18df7",
                                        "glosses": [
                                            "positiver Aspekt oder Effekt einer Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83889fff-4d37-4478-a1cd-ecdbc8bb9c87",
                                                "sense_id": "77a455f3-4997-3629-8d28-01e4f14a4c23",
                                                "text": "Es wäre von Vorteil, wenn man die Sache anders angehen würde."
                                            },
                                            {
                                                "example_id": "fa66e8cc-3f04-40ab-befc-96fca88595c6",
                                                "sense_id": "77a455f3-4997-3629-8d28-01e4f14a4c23",
                                                "text": "Die Vorteile dieser Entwicklung liegen auf der Hand, doch die entscheidenden Nachteile sollten nicht vergessen werden."
                                            },
                                            {
                                                "example_id": "9837f736-2bc2-47c6-83e0-5d67b287bdbe",
                                                "sense_id": "77a455f3-4997-3629-8d28-01e4f14a4c23",
                                                "text": "„Plötzlich realisierte ich, dass mein Status als Ausländer zum ersten Mal von Vorteil sein könnte.“"
                                            },
                                            {
                                                "example_id": "4e014558-f9f6-4ace-b5fc-b1b8d16c3cc7",
                                                "sense_id": "77a455f3-4997-3629-8d28-01e4f14a4c23",
                                                "text": "„Und manche verklärten sogar die Nachteile der Deutschen in Vorteile.“"
                                            },
                                            {
                                                "example_id": "4e0a2931-fb19-4da8-8f04-3c72dfe0a5cc",
                                                "sense_id": "77a455f3-4997-3629-8d28-01e4f14a4c23",
                                                "text": "„Es komme immer wieder vor, meinte er, daß sich der eine oder andere aus der Stadt an den Archivar zu wenden bemühe, der eine Sonderstellung einnehme, um einen Vorteil für seine Lage zu gewinnen.“"
                                            },
                                            {
                                                "example_id": "0dc79e8d-d272-4ae6-9c4d-ce34617fbdc4",
                                                "sense_id": "77a455f3-4997-3629-8d28-01e4f14a4c23",
                                                "text": "„Sie hatten anscheinend einfach mehr Vorteile als Nachteile voneinander.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0c1b7630-b1dc-3854-893e-0022586645a8",
                                        "entry_id": "097f40d3-2f9e-35c0-be3e-8150e6b18df7",
                                        "glosses": [
                                            "im Mannschaftssport eine bestimmte Situation zugunsten einer beteiligten Mannschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69a5150a-2bf1-4eb3-aa8b-282ecaab746c",
                                                "sense_id": "0c1b7630-b1dc-3854-893e-0022586645a8",
                                                "text": "Jetzt ist die gegnerische Mannschaft klar im Vorteil."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96ed3613-b02e-3625-98b3-d40225dfd8cb",
                                        "entry_id": "097f40d3-2f9e-35c0-be3e-8150e6b18df7",
                                        "glosses": [
                                            "Spielstand nach einem Punkt, der nach einem Einstand (40:40) erzielt wurde"
                                        ],
                                        "tags": [
                                            "Tennis"
                                        ],
                                        "examples": [
