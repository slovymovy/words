                                "target_senses": [
                                    {
                                        "sense_id": "c3a9c1d0-57cb-31ae-9e54-4342c86927fa",
                                        "entry_id": "67fef891-6de4-39d6-90cc-20a2e57ba59a",
                                        "glosses": [
                                            "Mât placé à l’avant du navire, plus ou moins obliquement, sous un angle qui va jusqu'à 20 et 25° à bord d’un grand navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0067341e-c94b-4768-8983-c2c26eac0532",
                                                "sense_id": "c3a9c1d0-57cb-31ae-9e54-4342c86927fa",
                                                "text": "Seulement à l’avant, sur la proue, penché sur le mât de beaupré, dormait ou rêvait une figure noire."
                                            },
                                            {
                                                "example_id": "452f26a2-15ea-4f6b-8b05-f127e278bb9a",
                                                "sense_id": "c3a9c1d0-57cb-31ae-9e54-4342c86927fa",
                                                "text": "Un nouveau beaupré, en pin d’Orégon lui aussi, remplace celui qui fut brisé dans un ouragan."
                                            },
                                            {
                                                "example_id": "01711988-a9d5-43f1-a8d1-fb3c4d04f1d4",
                                                "sense_id": "c3a9c1d0-57cb-31ae-9e54-4342c86927fa",
                                                "text": "Le vieil homme et le fiancé ont attaché la voile au beaupré, et le vent violent qui vient de la passe fait basculer la pirogue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
