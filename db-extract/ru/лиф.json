                                                "example_id": "f64460cf-9fac-4512-9655-ba77109652dd",
                                                "sense_id": "3ab17e5d-22dd-3c41-840f-ab246d453afe",
                                                "text": "There he stood, very quietly overlooking some sailmakers who were mending a top-sail in the waist."
                                            }
                                        ]
                                    },
