                            {
                                "example_id": "16f648a4-9c5b-409b-9ea1-a30cb4afbe27",
                                "sense_id": "f2c98a62-af03-332b-83ef-e2adb6af465b",
                                "text": "Jonathan genießt sein Frühstücksei, indem er immer kleine Häppchen mit seinem Eierlöffel aus der Eierschale kratzt."
