                "senses": [
                    {
                        "sense_id": "d4fe1ae4-725e-3f3d-91a0-56593aa68a85",
                        "entry_id": "c65ac270-510c-3b94-8a16-cec8aa856f2e",
                        "glosses": [
                            "заложить, заделать наглухо каменной кладкой, глиной и т. п. (отверстие, проём и т. п.)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f5efb1fd-291a-31a3-89fd-7cc87db29e3b",
                        "entry_id": "c65ac270-510c-3b94-8a16-cec8aa856f2e",
                        "glosses": [
                            "заключить кого-либо; скрыть что-либо в помещении, в тайнике, наглухо заделанном каменной кладкой"
                        ],
                        "tags": [],
