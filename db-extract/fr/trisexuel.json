                                        "sense_id": "bfbed693-b832-3f7c-87dd-70b7fc6c44e3",
                                        "entry_id": "84b5760d-b28f-346b-8987-d86a5f0e715f",
                                        "glosses": [
                                            "Having, or pertaining to a system which involves, three sexes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "759f0597-2d46-4791-b4f2-9f5f83907831",
                                                "sense_id": "bfbed693-b832-3f7c-87dd-70b7fc6c44e3",
                                                "text": "Whether three sexes could exist in this contexture, or whether a trisexual organism would be quite different from the organisms we know, it is impossible to say."
                                            },
                                            {
                                                "example_id": "97c11a5b-ee72-4bcf-a1f8-25930ae28bcc",
                                                "sense_id": "bfbed693-b832-3f7c-87dd-70b7fc6c44e3",
                                                "text": "Trimates and Three Autos\nThe Trimates are a trisexual race from the planet Tiberon. Each union consists of a Polar, who always tells the truth, a Polee, who makes only false statements, and a Nexus, who makes statements that are […]"
                                            },
                                            {
                                                "example_id": "6df5ec0c-530e-4dd3-91ab-86009e341c36",
                                                "sense_id": "bfbed693-b832-3f7c-87dd-70b7fc6c44e3",
                                                "text": "Earth, a bisexual planet, represents its childhood, Herschel (trisexual), its [the soul's] adolescence, Saturn (trisexual), its maturity, and Jupiter (bisexual), its old age. Eventually the orchestrated symphony leads to the metempsychosis of planets."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
