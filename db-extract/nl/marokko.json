                    {
                        "translation_id": "8046f58b-aaa1-4b5c-85fe-21a8854dc63d",
                        "source_entry_id": "0b729723-b5c3-3910-90f7-82bf02befb58",
                        "source_sense_id": "5b0dc874-fc9b-3c43-8bfe-f89c80d77214",
