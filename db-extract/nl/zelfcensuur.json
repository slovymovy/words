                        "examples": [
                            {
                                "example_id": "14ce1d14-9457-4006-bea2-749bb284b928",
                                "sense_id": "bab3b181-2fd8-3298-8d68-7a63ed6cf4e9",
                                "text": "Een groep kritische studenten is de drijvende kracht achter het referendumverzoek over de Wet op de Inlichtingen- en Veiligheidsdiensten (Wiv). Ze vrezen dat grootschalig afluisteren door de overheid leidt tot zelfcensuur."
                            },
                            {
                                "example_id": "1c90f041-320f-44a2-8c7f-cdb4e1b7a3b7",
                                "sense_id": "bab3b181-2fd8-3298-8d68-7a63ed6cf4e9",
                                "text": ",,Het is belangrijk dat mensen weten dat de mogelijkheid bestaat dat mensen afgeluisterd worden’’, aldus Tijn de Vos. ,,Dat kan tot zelfcensuur leiden en dat ondermijnt onze democratische rechtstaat."
                            },
                            {
                                "example_id": "e243547f-be40-49fc-a7f8-b6a38df070a7",
                                "sense_id": "bab3b181-2fd8-3298-8d68-7a63ed6cf4e9",
                                "text": "We doen sinds de moord op Theo van Gogh al te vaak aan zelfcensuur."
                            }
                        ]
                    }
