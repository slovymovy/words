                        "examples": [
                            {
                                "example_id": "6171fddc-978f-4fae-a8b6-7e59b1c8d898",
                                "sense_id": "95d8f9f6-2e5d-3963-a14f-3c048695331d",
                                "text": "„Kleine gespaltene Hufe klapperten über den Beton, ein Tandemgespann, die Ziegen zogen in selbstfabriziertem Geschirr einen aus Brennholz und alten Schildern zurechtgezimmerten Karren, obenauf eine zerschlissene Plane, gehörnte Ziegenschädel und Bibelsprüche, das Fuhrwerk rasselte auf elliptischen Rädern dahin wie ein putziges Spielzeugwägelchen.“"
                            }
                        ],
