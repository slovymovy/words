                "senses": [
                    {
                        "sense_id": "7109e80c-b5cc-39b0-ac70-9a512bf77296",
                        "entry_id": "03836a8a-6336-336c-afe1-a74933bdf0c1",
                        "glosses": [
                            "das Dauerkipplüften; zeitlich, sehr ausgedehnter Luftaustausch für einen Raum durch ein gekipptes Fenster oder eine gekippte Terrassentür"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a00a1892-2378-480f-acff-a2ee82a12ea6",
                                "sense_id": "7109e80c-b5cc-39b0-ac70-9a512bf77296",
                                "text": "„In der kühlen Jahreszeit sollte auf Dauerkipplüftung verzichtet werden.“"
                            },
                            {
                                "example_id": "cf1bbdf7-a1dc-4ed6-8685-7c770e70ec62",
                                "sense_id": "7109e80c-b5cc-39b0-ac70-9a512bf77296",
                                "text": "„So wurde in verschiedenen Studien zum Lüftungsverhalten von Bewohnern festgestellt, dass in Schlafzimmern, Bädern und Küchen nach wie vor die wärmeverlustreiche Dauerkipplüftung vorherrscht.“"
                            },
                            {
                                "example_id": "003886be-a165-4e02-911a-842857220b80",
                                "sense_id": "7109e80c-b5cc-39b0-ac70-9a512bf77296",
                                "text": "„Keine Dauerkipplüftung in der kälteren Jahreszeit.“"
                            },
                            {
                                "example_id": "15a73ace-1568-4771-b40e-1332f3ef851a",
                                "sense_id": "7109e80c-b5cc-39b0-ac70-9a512bf77296",
                                "text": "„Von der Dauerkipplüftung ist abzuraten.“"
                            },
                            {
                                "example_id": "67a34b48-fa69-40ee-a589-17602aea5e39",
                                "sense_id": "7109e80c-b5cc-39b0-ac70-9a512bf77296",
                                "text": "„Ebenso entsteht durch Dauerkipplüftung in Nassräumen wie Bädern und Duschen, besonders an renovierten Außenfassaden, ein sog. Smoggingeffekt, d.h. ein dunkler Putzbelag aus Algen über dem Fenstersturz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
