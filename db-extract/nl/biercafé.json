                                "example_id": "474f66b9-bdb9-4b00-b0e1-55d3d74ec572",
                                "sense_id": "745850e0-7e18-329f-b049-fe4fbce0e276",
                                "text": "'Hous'n de Pepernoten Editie' wordt morgenavond vanaf 22.30 uur in de zaal achter het biercafé De Geus aan de Oude Markt gehouden."
                            },
                            {
                                "example_id": "a9557461-ec3c-4528-81bd-49409aa3f833",
                                "sense_id": "745850e0-7e18-329f-b049-fe4fbce0e276",
                                "text": "Biercafé ’t Pleintje aan het Burgemeester Jansenplein heeft een flinke sprong gemaakt in de landelijke café top 100. Het café steeg met stip naar plaats 17 op de ranglijst. Die wordt jaarlijks opgesteld door horecavakblad Misset Horeca."
                            },
                            {
                                "example_id": "fa3d8675-02ed-40e0-a482-85c9d8b977ef",
                                "sense_id": "745850e0-7e18-329f-b049-fe4fbce0e276",
                                "text": "Deze Ierse wil in tegenstelling tot de Parisiennes wél afspreken, in een biercafé zelfs."
                            }
                        ]
                    }
