                "senses": [
                    {
                        "sense_id": "bf224a5e-cbcf-3bc3-9f6f-4ca9e09223a1",
                        "entry_id": "56bdf68d-d290-34e8-8f0e-a46bfa3ed6b5",
                        "glosses": [
                            "Kaufladen in den USA für den alltäglichen Bedarf mit Imbiss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e15d0f70-023c-4487-800e-fd0cb6d1e292",
                                "sense_id": "bf224a5e-cbcf-3bc3-9f6f-4ca9e09223a1",
                                "text": "„Er verdient vierzig Dollar in der Woche, und an Wochenenden hilft er die Sodafontäne im Drugstore an der Ecke [zu] bedienen.“"
                            },
                            {
                                "example_id": "0c6f951a-6433-439a-99f7-50941b39824a",
                                "sense_id": "bf224a5e-cbcf-3bc3-9f6f-4ca9e09223a1",
                                "text": "„Um ein Uhr hielt sie nach einem Drugstore Ausschau.“"
                            },
                            {
                                "example_id": "3517161d-be46-417e-aedd-f78383a61e59",
                                "sense_id": "bf224a5e-cbcf-3bc3-9f6f-4ca9e09223a1",
                                "text": "„Er hatte die Drugstores in allen Städtchen auf zwanzig Meilen in der Runde abgegrast.“"
                            },
                            {
                                "example_id": "d3229d14-bf08-4b68-8560-546a69d74829",
                                "sense_id": "bf224a5e-cbcf-3bc3-9f6f-4ca9e09223a1",
                                "text": "„Ich hatte die billigste Mahlzeit im Drugstore an der Ecke gegessen, – zwei Wiener Würstchen und zwei Brötchen.“"
                            },
                            {
                                "example_id": "85380502-6d96-4e59-886b-68c7c026b277",
                                "sense_id": "bf224a5e-cbcf-3bc3-9f6f-4ca9e09223a1",
                                "text": "„Auf dem Nachtschränkchen stand eine Papiertüte mit Sachen, die er in einem Drugstore in der Stadt gekauft hatte, und er nahm sie und humpelte damit ins Bad.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
