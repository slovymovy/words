                        "examples": [
                            {
                                "example_id": "2ab6551e-fcdd-4857-be71-98568b2275cd",
                                "sense_id": "9b6f013a-c245-3d5b-a691-ee4fe084afd0",
                                "text": "Клюворыл, или средний плавун, — морское млекопитающее, живущее во всех океанах кроме Северного Ледовитого. Считается страдающим от сетей и восприимчивым к шумам видом."
                            }
                        ]
