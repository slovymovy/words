                                "example_id": "e729fd6f-d3ae-4428-a532-47871689019a",
                                "sense_id": "421d1ca3-484a-323e-b6c4-58e35e673084",
                                "text": "De voogdij aan iemand opdragen.",
                                "translation": "Confier la tutelle à quelqu’un."
