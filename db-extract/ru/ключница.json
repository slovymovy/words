                "senses": [
                    {
                        "sense_id": "0528afe5-0f77-3650-90ac-e98ab15716b1",
                        "entry_id": "e15da598-1939-3f5b-9172-a921e94d8d31",
                        "glosses": [
                            "female equivalent of клю́чник (kljúčnik): female housekeeper"
                        ],
                        "tags": [
                            "feminine",
                            "form-of",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "535b870c-967e-4a5b-b221-80ff3e563f80",
                                "sense_id": "0528afe5-0f77-3650-90ac-e98ab15716b1",
                                "text": "По висе́вшим у ней за по́ясом ключа́м и по тому́, что она́ брани́ла мужика́ дово́льно поносными слова́ми, Чи́чиков заключи́л, что э́то, ве́рно, клю́чница.",
                                "translation": "From the fact that there were keys hanging from her belt, and that she scolded the peasant in rather abusive language, Tchitchikov concluded that this was probably the housekeeper.",
                                "english": "From the fact that there were keys hanging from her belt, and that she scolded the peasant in rather abusive language, Tchitchikov concluded that this was probably the housekeeper."
                            }
                        ]
                    }
                ],
                "translations": [],
