                            {
                                "target_word": "Bordeaux",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53f0f548-345f-3b57-a9b5-2b193822ea2b",
                                        "entry_id": "a32d31b9-476d-3ae0-9f9d-18bc15c538e3",
                                        "glosses": [
                                            "A wine coming from that area."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c29d3c2-1709-46d3-8309-91e6ae9abec7",
                                                "sense_id": "53f0f548-345f-3b57-a9b5-2b193822ea2b",
                                                "text": "We had a nice bottle of Bordeaux last night."
                                            },
                                            {
                                                "example_id": "2e32d35d-aa24-4168-aa2a-5638829ed71c",
                                                "sense_id": "53f0f548-345f-3b57-a9b5-2b193822ea2b",
                                                "text": "Some fine Bordeauxes and Cabernets actually grow smoother as they sit, and are better served seven or eight years old."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "077098ab-f5d8-3a4e-859e-751ac87dac16",
                                        "entry_id": "a32d31b9-476d-3ae0-9f9d-18bc15c538e3",
                                        "glosses": [
                                            "Ellipsis of Bordeaux mixture."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfa2c342-a117-45d1-b81c-ce3ad925d986",
                                                "sense_id": "077098ab-f5d8-3a4e-859e-751ac87dac16",
                                                "text": "The patent Bordeauxs which are on the market have not been shown to be any less liable to produce injury than the home-made mixtures, amd many of them have proven quite inefficient in controlling diseases."
                                            },
                                            {
                                                "example_id": "224064ca-cda7-47cf-ad3a-996630faaee9",
                                                "sense_id": "077098ab-f5d8-3a4e-859e-751ac87dac16",
                                                "text": "Contrary to the views of many of the backers of Pickering Bordeaux, we have found a three to one Bordeaux just as good a fungicide as a Bordeaux in which only just enough lime is used to throw down all of the copper as a precipitate."
                                            },
                                            {
                                                "example_id": "c2430e20-1f08-49ff-98ff-2cde01b9b501",
                                                "sense_id": "077098ab-f5d8-3a4e-859e-751ac87dac16",
                                                "text": "The two Bordeauxs used differed only in the percentage of lime which they contained."
                                            },
                                            {
                                                "example_id": "49580574-530d-47c4-9019-0eaf545c618f",
                                                "sense_id": "077098ab-f5d8-3a4e-859e-751ac87dac16",
                                                "text": "Avoid overhead irrigation After harvest and before fall rains, prune out and destroy old wood and apply a Bordeaux or a fixed copper fungicide. Spray again in spring when new laterals are leafing out[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e4328ea-b87a-408d-98a6-d2cca9708681",
                        "source_entry_id": "cc16c223-7c74-338c-a429-c394915c291e",
                        "source_sense_id": "4f3c0619-816c-3b38-854d-e0c15d3c2c61",
                        "target_lang_word": "Bordeaux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bordeaux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39fe6efc-9912-3f69-b2f3-f38ba7eeb988",
                                        "entry_id": "3fc65daf-a875-3c45-938b-13d054eb42bf",
                                        "glosses": [
                                            "Commune, ville et chef-lieu de département français, situé dans le département de la Gironde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a90ad89-f1cf-4d8e-8754-cbd3855137ea",
                                                "sense_id": "39fe6efc-9912-3f69-b2f3-f38ba7eeb988",
                                                "text": "Voyez-vous, cela n’est ni dans son tempérament, ni dans son caractère, ni dans son éducation, ni dans son monde. Nous sommes à Bordeaux, cher ami ; nous sommes à Bordeaux.\n— Et l’heure de Bordeaux retarde sur celle de Paris."
                                            },
                                            {
                                                "example_id": "894787b4-bc0e-42c5-b6ae-07e93a179796",
                                                "sense_id": "39fe6efc-9912-3f69-b2f3-f38ba7eeb988",
                                                "text": "Cet automne que nous fûmes à Venise, mon amie Nane et moi, nous étions partis de Bordeaux. C’est ainsi, mais par mer, qu’il faudrait toujours quitter la France ; et les regrets qu’on emporte de ce beau royaume seraient moins vifs, si on ne lui disait adieu qu’à travers cette cité de vin et de morues, couchée sur les bords noirs d’un port sans navires.\nCar ces matins ne sont plus où se voyaient de riches armateurs, en pantalon de nankin, sur le damier des quais. Cependant on débarque le sucre et le précieux café que les noirs du Petit Goave ont enveloppé de pagne ; et une belle dame à la taille haute regarde languissamment sous son ombrelle à franges, en rêvant peut-être aux aides de camp de M. le duc d’Angoulême."
                                            },
                                            {
                                                "example_id": "659ea31d-4415-465f-be75-193dcd063082",
                                                "sense_id": "39fe6efc-9912-3f69-b2f3-f38ba7eeb988",
                                                "text": "En rentrant dans le giron de la nation française, Bordeaux, naguère capitale continentale du royaume d'Angleterre, subissait un dommage considérable : elle perdait le bénéfice de son commerce avec les Iles Britanniques."
                                            },
                                            {
                                                "example_id": "34bc1a78-660b-41d5-8e01-4290d902f45e",
                                                "sense_id": "39fe6efc-9912-3f69-b2f3-f38ba7eeb988",
                                                "text": "Il faisait triste et noir. Enfin, un halo, des lumières dispersées et c’est Bordeaux, BORDEAUX, sa platitude, son ennui, sa pluie, ses quais déserts, ses grues efflanquées, ses lampadaires et personne, vu l’heure avancée, pour accueillir les voyageurs, sauf un groupe de trois qui s’étaient mis à l’abri du vent et de la pluie sous la porte entrouverte d’un hangar, au coin duquel stationnait un taxi."
                                            },
                                            {
                                                "example_id": "2910c093-83a2-47e1-894a-2f8930a25e37",
                                                "sense_id": "39fe6efc-9912-3f69-b2f3-f38ba7eeb988",
                                                "text": "Vous connaissez la foire de Bordeaux, sur les Quinconces, en octobre et en mars ?\n— Eh ! Bé, si vous croyez qu’on nous mène à la foire, nous autres, séminaristes !\n— C’est un endroit unique, d’une poésie merveilleuse.\n— Quoi ? La foire de Bordeaux ?"
                                            },
                                            {
                                                "example_id": "b4fe34c6-26e9-4b4e-91d7-37284dd914bd",
                                                "sense_id": "39fe6efc-9912-3f69-b2f3-f38ba7eeb988",
                                                "text": "Le crépuscule magnifiait Bordeaux, peut-être parce que, capitale du vin, la ville attendait d'être fardée de pourpre pour révéler sa beauté."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Bordeaux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81b9e9a5-2e86-32a9-88bd-6683498cb08c",
                                        "entry_id": "c56d93c4-4c95-3179-b585-bbbd1a27b89e",
                                        "glosses": [
                                            "Variante de bordeaux."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4d9009a-4aef-48de-87f2-a82f2e13f006",
                                                "sense_id": "81b9e9a5-2e86-32a9-88bd-6683498cb08c",
                                                "text": "On nous donna, au prix du Bordeaux, une bouteille de vin du cru avec lequel un Parisien n'aurait pas voulu assaisonner une salade."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
