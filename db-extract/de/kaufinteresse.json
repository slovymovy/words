                                "example_id": "08e069f6-23d0-4f71-ad78-6eca80882723",
                                "sense_id": "1954c128-9263-336a-b814-0c08364d18e5",
                                "text": "„Zum Zweck der Verwertung der Liegenschaft habe die Beklagte zunächst erhoben, ob grundsätzlich Kaufinteresse der Mieter und Bewohner bestehe.“"
                            },
                            {
                                "example_id": "b65c00c4-dd8a-4479-8c9e-32cb228818d4",
                                "sense_id": "1954c128-9263-336a-b814-0c08364d18e5",
                                "text": "„Das Kaufinteresse des Staates ließ die Landpreise steigen, was es der Regierung erst recht unmöglich machte, die Flächen zu erwerben.“"
                            }
