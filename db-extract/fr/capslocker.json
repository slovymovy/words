                                "example_id": "f03fd9ed-e16e-4426-a0d7-962ff53835c8",
                                "sense_id": "48cefe57-0831-3896-8960-a5efc7445df7",
                                "text": "Pourquoi ce besoin de capslocker (oui, je fais du néologisme) ?"
                            },
                            {
                                "example_id": "eabd6b51-ec53-4485-a77f-93d78de2a7fe",
                                "sense_id": "48cefe57-0831-3896-8960-a5efc7445df7",
                                "text": "J'ai pris l'habitude de capslocker dans ces cas là et c'est un grand soulagement (selon les cas je n'ai pas ou n'utilise pas de pavé numérique)."
                            },
                            {
                                "example_id": "f3cb05ef-47fc-43b4-bbbb-51d94ccc64eb",
                                "sense_id": "48cefe57-0831-3896-8960-a5efc7445df7",
                                "text": "Bordel, on peut pas capslocker ?"
