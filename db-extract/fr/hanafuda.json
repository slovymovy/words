                "senses": [
                    {
                        "sense_id": "2103ac71-6eae-3ca0-9606-5f563cd6b8f8",
                        "entry_id": "1588f296-7335-3664-9ecf-a91139afe1fd",
                        "glosses": [
                            "Jeu de cartes traditionnel japonais utilisant 48 cartes. De nombreux jeux utilisent ces cartes que ce soit au Japon, en Corée ou à Hawaï."
                        ],
                        "tags": [
                            "Cartes à jouer"
                        ],
                        "examples": [
                            {
                                "example_id": "9acaadef-13a5-4c5d-8171-41cfa9555985",
                                "sense_id": "2103ac71-6eae-3ca0-9606-5f563cd6b8f8",
                                "text": "Le premier ricana : « Hé, hé, hé. Des cartes de hanafuda pardi ! »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cefa816-9136-41e9-8748-1de4ffe42adb",
                        "source_entry_id": "1588f296-7335-3664-9ecf-a91139afe1fd",
                        "source_sense_id": "2103ac71-6eae-3ca0-9606-5f563cd6b8f8",
                        "target_lang_word": "Hanafuda",
