                                        "examples": [
                                            {
                                                "example_id": "ae7dca52-e43d-4601-a1f3-356402abf6d2",
                                                "sense_id": "34d2ba57-e5f2-387a-be3a-b67ca037fe89",
                                                "text": "\"Have you the pictures still?\" I asked.\n\"Yes; I am keeping them till my daughter is of marriageable age, and then I shall sell them. They will be her dot.\""
                                            },
                                            {
                                                "example_id": "0fd2d40b-0a70-400a-b3d9-a922f7ce9b59",
                                                "sense_id": "34d2ba57-e5f2-387a-be3a-b67ca037fe89",
                                                "text": "As a bride, Madame de Talleyrand had brought a small dot of fifteen thousand francs to the family fund."
                                            }
