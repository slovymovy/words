                                        "entry_id": "72079d56-3449-3f48-b9ef-d342818c308e",
                                        "glosses": [
                                            "An area which is considered particularly low or lower than surrounding areas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d28b2ad2-f5ea-41da-868e-9af9bac1dce5",
                                                "sense_id": "1f8fa0b2-0c5a-38af-96da-eea7e5c2f64b",
                                                "text": "The lowland region was prone to flooding during the rainy season."
                                            }
                                        ]
