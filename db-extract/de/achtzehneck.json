                "senses": [
                    {
                        "sense_id": "f162ba77-fd15-3520-acee-bac5b03dd687",
                        "entry_id": "82c75173-7d63-32c0-ac1f-abbfa3c30825",
                        "glosses": [
                            "geometrische Figur mit achtzehn Ecken"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "bc20a76d-4288-41e5-b9c5-58c3ce52240f",
                                "sense_id": "f162ba77-fd15-3520-acee-bac5b03dd687",
                                "text": "Das regelmäßige Achtzehneck ist kein konstruierbares Polygon."
                            },
                            {
                                "example_id": "13a10125-f239-4e68-a837-c4d5c1878800",
                                "sense_id": "f162ba77-fd15-3520-acee-bac5b03dd687",
                                "text": "„Das Görgesdiagramm ist daher ein regelmäfsiges Achtzehneck.“"
                            },
                            {
                                "example_id": "a6c09a12-5baf-4121-a422-2bbb193d54ad",
                                "sense_id": "f162ba77-fd15-3520-acee-bac5b03dd687",
                                "text": "„Da 20 Grad (gleich 360 Grad durch 18) auch der Mittelpunktswinkel einer Seite des regelmässigen Achtzehnecks in seinem Umkreis ist, bedeutet das gleichzeitig, dass man das reguläre Achtzehneck und folglich auch das reguläre Neuneck nicht mit Zirkel und Lineal konstruieren kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0aa4068f-c243-471e-b75c-6d959d660564",
                        "source_entry_id": "82c75173-7d63-32c0-ac1f-abbfa3c30825",
                        "source_sense_id": "f162ba77-fd15-3520-acee-bac5b03dd687",
                        "source_sense_description": "Mathematik, Geometrie: geometrische Figur mit achtzehn Ecken",
                        "target_lang_word": "octadecagon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "octadecagon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64fd346c-bf22-3023-bd08-758beab617fe",
                                        "entry_id": "db3db0b3-657c-34b4-a202-60e70c29f25c",
                                        "glosses": [
                                            "A polygon with 18 sides and 18 vertices."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b303f698-0509-4fdd-9f48-8d3e103a3db9",
                                                "sense_id": "64fd346c-bf22-3023-bd08-758beab617fe",
                                                "text": "A regular octadecagon cannot be constructed using a compass and straightedge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c27caac-61a8-42ef-b6e7-7063a1ed5fab",
                        "source_entry_id": "82c75173-7d63-32c0-ac1f-abbfa3c30825",
                        "source_sense_id": "f162ba77-fd15-3520-acee-bac5b03dd687",
                        "source_sense_description": "Mathematik, Geometrie: geometrische Figur mit achtzehn Ecken",
                        "target_lang_word": "восемнадцатиугольник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "восемнадцатиугольник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4b2ab6c7-cdc4-3c10-aba3-b7f8c4de9740",
                                        "entry_id": "48b238e9-30b4-3c18-b755-5db9f985a592",
                                        "glosses": [
                                            "геометр. многоугольник с восемнадцатью сторонами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b4daf35-19bc-4e3b-b1dc-2e8c6aee4d94",
                                                "sense_id": "4b2ab6c7-cdc4-3c10-aba3-b7f8c4de9740",
                                                "text": "Посредине двора, но ближе к северной стене ― место для прогулок, асфальтированное и обнесённое сквозным зелёным забором в сажень высоты, представляющим собою правильный восемнадцатиугольник, периметр которого равен 120 шагам, а, значит, диаметр ― около сорока шагов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
