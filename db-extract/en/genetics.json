                                "target_senses": [
                                    {
                                        "sense_id": "b4f7ee71-d738-34f3-be99-4bedc7fb8ff1",
                                        "entry_id": "2fdc6f6c-559b-3da0-9eef-2e6f8ab0d3a0",
                                        "glosses": [
                                            "de wetenschap van alles wat de werking van genen betreft, in het bijzonder erfelijke overdracht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abb900bd-31a2-4c55-bded-a6c26e289f82",
                                                "sense_id": "b4f7ee71-d738-34f3-be99-4bedc7fb8ff1",
                                                "text": "Dankzij de wetenschappelijke vooruitgang binnen de genetica is de laatste decennia onze kennis van erfelijk overdraagbare ziekten snel toegenomen."
                                            },
                                            {
                                                "example_id": "4021a211-b729-40a9-b7e5-cb39b99e1716",
                                                "sense_id": "b4f7ee71-d738-34f3-be99-4bedc7fb8ff1",
                                                "text": "Zo controversieel als toen waren de onderzoeksvoorstellen van de criminoloog inmiddels al niet meer. Inmiddels is er veel kennis opgedaan op het gebied van genetica en neurowetenschap, onder meer op het gebied van mogelijke erfelijke factoren als het gaat over crimineel gedrag."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70d49254-f9df-48a9-a66f-95717913980e",
                        "source_entry_id": "cb62c238-0ed0-3ffa-aa36-2c1d7c533577",
                        "source_sense_description": "branch of biology",
                        "target_lang_word": "erfelijkheidsleer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erfelijkheidsleer",
