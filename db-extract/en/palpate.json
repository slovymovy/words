                        "target_lang_word": "abtasten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abtasten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "203056ed-57a8-381a-8043-c05efc588ebf",
                                        "entry_id": "9ac145ad-29e1-3cfc-bd03-1e7be512ee6e",
                                        "glosses": [
                                            "etwas oder jemanden tastend untersuchen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a86626e2-4dc9-40c1-8be7-1e136eb3ce6d",
                                                "sense_id": "203056ed-57a8-381a-8043-c05efc588ebf",
                                                "text": "Es war normal, dass jeder nach Waffen abgetastet wurde, jedoch in sachlich distanzierter Abfertigung."
                                            },
                                            {
                                                "example_id": "711018c9-343b-425e-b29c-5ede9b6fde04",
                                                "sense_id": "203056ed-57a8-381a-8043-c05efc588ebf",
                                                "text": "Und sie darf dich im Rahmen einer Identitätsfestellung zur Eigensicherung nach gefährlichen Gegenständen und Waffen abtasten."
                                            },
                                            {
                                                "example_id": "0e5696bc-0f68-4a58-8fd4-5eec25bd4100",
                                                "sense_id": "203056ed-57a8-381a-8043-c05efc588ebf",
                                                "text": "Der Bereich um die Brustwarze fühlt sich etwas härter an. Auch das können Sie besser einordnen, wenn Sie die Brust regelmäßig abtasten und mit ihr vertraut sind."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6118b109-f7aa-3229-a4f0-7e8323704994",
                                        "entry_id": "9ac145ad-29e1-3cfc-bd03-1e7be512ee6e",
                                        "glosses": [
                                            "mithilfe von Strahlen untersuchen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c549027-f92e-45ce-a7e5-2240a0d5b3bc",
                                                "sense_id": "6118b109-f7aa-3229-a4f0-7e8323704994",
                                                "text": "Da der Fokus des Lasers sehr viel kleiner als der Berührbereich der Nadel sei und überdies eher der obere Teil der Flanke abgetastet würde, sei eine höhere Wiedergabequalität möglich."
                                            },
                                            {
                                                "example_id": "2188c9a6-afa3-4f9a-ac96-4b68c81eccfb",
                                                "sense_id": "6118b109-f7aa-3229-a4f0-7e8323704994",
                                                "text": "Der Körper wird rund um seine Achse mit Röntgenstrahlen abgetastet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b56ae94b-5bb1-3ef4-b458-3a1e9ee71890",
                                        "entry_id": "9ac145ad-29e1-3cfc-bd03-1e7be512ee6e",
                                        "glosses": [
                                            "eine Oberfläche absuchen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c933445c-deb6-4b06-ba14-de5c70ae148e",
                                                "sense_id": "b56ae94b-5bb1-3ef4-b458-3a1e9ee71890",
                                                "text": "Anders als bei den alten Vinylplatten, bei denen noch mit einer Nadel die Spurrillen abgetastet wurden, werden die Daten auf CDs kontaktfrei mit einem Laserstrahl ausgelesen."
                                            },
                                            {
                                                "example_id": "26ebfa1f-d500-40d8-a2d5-6aa00907a187",
                                                "sense_id": "b56ae94b-5bb1-3ef4-b458-3a1e9ee71890",
                                                "text": "Bei einem Scanner handelt es sich rein technisch gesehen um ein Gerät, mit dem es möglich ist, Objekte systematisch abzutasten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "46304c6a-310c-3b58-88e7-ae576e489838",
                                        "entry_id": "9ac145ad-29e1-3cfc-bd03-1e7be512ee6e",
                                        "glosses": [
                                            "eine Situation, einen Gegner überprüfen und einschätzen"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b21bff8-f07b-4cef-af84-9aaa96c41bec",
                                                "sense_id": "46304c6a-310c-3b58-88e7-ae576e489838",
                                                "text": "Den Forschern zufolge deuten die Ergebnisse auf einen unbewussten Mechanismus hin, der uns zunächst einen potentiellen Gegner abtasten und den Grad der Bedrohung abschätzen lässt."
                                            },
                                            {
                                                "example_id": "38eed0f7-a386-45d9-a279-3540a9c570f4",
                                                "sense_id": "46304c6a-310c-3b58-88e7-ae576e489838",
                                                "text": "Beide Mannschaften spielten konzentriert und tasteten sich gegenseitig ab, ohne zwingend zu werden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
