                                        "sense_id": "8115397f-6622-3372-abd2-47c5f4b5e71b",
                                        "entry_id": "3949ad62-8b08-30e7-9d75-e19f65525403",
                                        "glosses": [
                                            "The sum of everything that exists in the cosmos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f321e10c-a6fd-466c-a593-57596d65e054",
                                                "sense_id": "8115397f-6622-3372-abd2-47c5f4b5e71b",
                                                "text": "Do you think that the universe was created by a life force or a deity?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03f2265a-6d93-372a-997e-876af146f6ad",
                                        "entry_id": "3949ad62-8b08-30e7-9d75-e19f65525403",
                                        "glosses": [
                                            "The sum of everything that exists in the cosmos.",
                                            "An entity similar to our universe; one component of a larger entity known as the multiverse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d576a0f-a398-36e2-8714-e44676309276",
                                        "entry_id": "3949ad62-8b08-30e7-9d75-e19f65525403",
                                        "glosses": [
                                            "Everything under consideration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdf55022-eb73-4116-b639-3ee49f4e19d7",
                                                "sense_id": "0d576a0f-a398-36e2-8714-e44676309276",
                                                "text": "In all this universe of possibilities, there is only one feasible option."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56c29aec-03d9-3ac0-a0ca-aaae40db3b45",
                                        "entry_id": "3949ad62-8b08-30e7-9d75-e19f65525403",
                                        "glosses": [
                                            "Everything under consideration.",
                                            "The set of all things considered."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8596a3b1-8322-33a1-aca6-69f77520f61c",
                                        "entry_id": "3949ad62-8b08-30e7-9d75-e19f65525403",
                                        "glosses": [
                                            "Everything under consideration.",
                                            "The set of all admissible observations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cfca674-f308-435f-95a5-26872ae8fe1f",
                                                "sense_id": "8596a3b1-8322-33a1-aca6-69f77520f61c",
                                                "text": "In general content-related evidence demonstrates the degree to which the sample of items, tasks or questions on a test is representative of some defined universe or domain of content."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08827080-719c-3278-ad81-fec5aa830dd6",
                                        "entry_id": "3949ad62-8b08-30e7-9d75-e19f65525403",
                                        "glosses": [
                                            "Everything under consideration.",
                                            "A sample taken from the population."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3829421-f6c0-38ff-af9c-055ef8e0a39c",
                                        "entry_id": "3949ad62-8b08-30e7-9d75-e19f65525403",
                                        "glosses": [
                                            "An imaginary collection of worlds; the general imaginary world within which a work of fiction takes place, broader than its immediate setting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f47737ff-1678-4b64-9d12-26cbf8365532",
                                                "sense_id": "b3829421-f6c0-38ff-af9c-055ef8e0a39c",
                                                "text": "The universe in this comic book series is richly imagined."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d32a713-bc11-363a-b0b5-d9b4f831b2cb",
                                        "entry_id": "3949ad62-8b08-30e7-9d75-e19f65525403",
                                        "glosses": [
                                            "An imaginary collection of worlds; the general imaginary world within which a work of fiction takes place, broader than its immediate setting.",
                                            "A collection of stories with characters and settings that typically share a continuity but are less interrelated than those of sequels or prequels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f48bad17-56a8-46ad-a618-896e933863f6",
                                                "sense_id": "2d32a713-bc11-363a-b0b5-d9b4f831b2cb",
                                                "text": "Annabelle Comes Home (the 7th and most recent movie in the Conjuring universe, and the 3rd to focus on Annabelle) is a direct sequel to both previous Annabelle movies, which occurred before the events of The Conjuring – but take place after the events of the 2013 franchise-starter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b57db59-1774-38dd-9a89-16d73b642072",
                                        "entry_id": "3949ad62-8b08-30e7-9d75-e19f65525403",
                                        "glosses": [
                                            "A whole world, in the sense of perspective or social setting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8374806c-c242-4d18-9258-122c57b9989c",
                                                "sense_id": "5b57db59-1774-38dd-9a89-16d73b642072",
                                                "text": "That didn’t just rock my world, it rocked my universe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cea7ca4-fbfb-3dba-b85e-0b87bbd179f6",
                                        "entry_id": "3949ad62-8b08-30e7-9d75-e19f65525403",
                                        "glosses": [
                                            "A deity who is equivalent to the sum of everything that exists in the cosmos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d871af0b-a7d7-4587-829d-850fa15cb1f6",
                                                "sense_id": "2cea7ca4-fbfb-3dba-b85e-0b87bbd179f6",
                                                "text": "The universe wants you to succeed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90d3ef1d-9c46-3947-be0c-11d17fef3f54",
                                        "entry_id": "3949ad62-8b08-30e7-9d75-e19f65525403",
                                        "glosses": [
                                            "The Earth, the sphere of the world."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e59e58fb-df65-4e07-8b3f-b3b3698f24a2",
                                                "sense_id": "90d3ef1d-9c46-3947-be0c-11d17fef3f54",
                                                "text": "Under our new World may alſo be compriſed thoſe vaſt Southern Coaſts and Streights of Magelan, firſt lighted on by Ferdinandus Magelanus in the year 1520, in his Circumnavigation of the Univerſe ; which forty five years after Sir Francis Drake, and next Sir Thomas Bendiſh, Engliſhmen, made a furhter inſpection into ; and in the Year 1600 Oliver van Noord a Hollander paſt, but of later years a Spaniard, Fedinand de Quier, out-ſhot them all by a more ample Diſcovery then all the former."
                                            }
                                        ]
                                    }
