                    {
                        "sense_id": "5f24bce5-f483-3797-9c9e-7af33f627343",
                        "entry_id": "a323ff1e-3805-3c6a-8ef1-bdb67b171d19",
                        "glosses": [
                            "Auteur postérieur à la pensée de Sigmund Freud et qui la fait évoluer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "161f59df-4b6e-41a0-b2de-1beaf83c13ce",
                                "sense_id": "5f24bce5-f483-3797-9c9e-7af33f627343",
                                "text": "Pour Lacan, l’orientation des postfreudiens, en promouvant une visée adaptative du moi à la réalité, s’est construite sur l'oubli de la découverte de Freud."
                            },
                            {
                                "example_id": "ed8abe82-79c3-455f-a984-72fcf6f33745",
                                "sense_id": "5f24bce5-f483-3797-9c9e-7af33f627343",
                                "text": "Après les postfreudiens et les postkleiniens, le troisième groupe d’auteurs, moins homogène, est celui des relationnels britanniques, dont Bollas fait partie et dans une certaine mesure aussi Kohut."
                            }
                        ]
                    }
