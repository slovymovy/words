                            "Abend im Oktober"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73bbc0bb-2433-41b6-b49c-655b24a362b5",
                                "sense_id": "83d411ff-e94d-30a2-999b-24ce58a178f7",
                                "text": "Evelin kam an einem Oktoberabend."
                            },
                            {
                                "example_id": "ee6d07d4-7009-4b64-946e-7cc2573ec045",
                                "sense_id": "83d411ff-e94d-30a2-999b-24ce58a178f7",
                                "text": "„Die Oktoberabende kommen mir unanständig warm vor.“"
                            },
                            {
                                "example_id": "98ee5dec-5056-406d-8727-e7f461101a9c",
                                "sense_id": "83d411ff-e94d-30a2-999b-24ce58a178f7",
                                "text": "„Um diese Zeit, an einem tristen Oktoberabend, erschien eine kleine, verschreckte Frau in Thomas Lievens Villa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
