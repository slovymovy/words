{
    "word_family": [
        "sandalwood"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b82b58ad-73e2-3a47-b8a2-b04a648245ec",
                    "sense_definition": "A type of open shoe made up of straps or bands holding a sole to the foot",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "footwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to wear a <w>sandal</w> on each foot because the weather was very hot.",
                            "target_lang_translations": {
                                "ru": "Она решила надеть по <w>сандалии</w> на каждую ногу, потому что погода была очень жаркой."
                            }
                        },
                        {
                            "text": "He walked along the beach and got some sand inside his <w>sandal</w>.",
                            "target_lang_translations": {
                                "ru": "Он гулял по пляжу, и в его <w>сандалию</w> попал песок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leather sandal",
                        "pair of sandals",
                        "beach sandal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип открытой обуви, состоящей из подошвы и ремешков, удерживающих её на ноге"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сандалия",
                                "target_lang_sense_clarification": "общий термин для открытой обуви"
                            },
                            {
                                "target_lang_word": "босоножка",
                                "target_lang_sense_clarification": "женская летняя обувь"
                            },
                            {
                                "target_lang_word": "сандалета",
                                "target_lang_sense_clarification": "легкая летняя туфля"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0192d219-b088-3d35-8029-31168a5d8557",
                    "sense_definition": "A fragrant wood from certain trees, often used for carving or incense; <w>sandalwood</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique box was crafted from fine <w>sandal</w> and emitted a pleasant aroma.",
                            "target_lang_translations": {
                                "ru": "Старинная шкатулка была сделана из отборного <w>сандала</w> и источала приятный аромат."
                            }
                        },
                        {
                            "text": "She bought a fan made of <w>sandal</w> during her travels in the East.",
                            "target_lang_translations": {
                                "ru": "Во время своих путешествий по Востоку она купила веер из <w>сандалового дерева</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fan of sandal"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often referred to as sandalwood in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ароматная древесина некоторых деревьев, часто используемая для резьбы или благовоний; сандаловое дерево"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сандал",
                                "target_lang_sense_clarification": "древесина или дерево"
                            },
                            {
                                "target_lang_word": "сандаловое дерево",
                                "target_lang_sense_clarification": "название растения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9d29d4e-da09-328a-a942-88e64ad9ad23",
                    "sense_definition": "A long narrow boat used on the Barbary coast",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vessel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traditional <w>sandal</w> glided smoothly across the coastal waters of North Africa.",
                            "target_lang_translations": {
                                "ru": "Традиционный <w>сандал</w> плавно скользил по прибрежным водам Северной Африки."
                            }
                        },
                        {
                            "text": "Historians studied the unique design of the <w>sandal</w> used by local sailors.",
                            "target_lang_translations": {
                                "ru": "Историки изучали уникальную конструкцию <w>сандала</w>, который использовали местные моряки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Barbary coast"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная узкая лодка, использовавшаяся на Варварском берегу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сандал",
                                "target_lang_sense_clarification": "тип небольшого судна"
                            }
                        ]
                    }
                }
            ]
        },
