                "translations": [
                    {
                        "translation_id": "67f65329-fcb1-4ee3-b8c9-20fe7df5f512",
                        "source_entry_id": "51cc0564-43b2-3127-85b0-71d2c9d7a535",
                        "source_sense_id": "205967c7-747f-3899-9f77-c4132a2cd29b",
                        "source_sense_description": "een bord waarop een (adellijk) wapen is geschilderd en dat gedecoreerd is met sieraden",
                        "target_lang_word": "Wappen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wappen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e1a3120-8e35-3a6d-90d2-53300f57d084",
                                        "entry_id": "6f97e9fb-cb02-3285-91af-0427fea6007a",
                                        "glosses": [
                                            "Symbol eines Adelsgeschlechts, einer Stadt, Gebietskörperschaft oder eines Staates, bestehend aus einem Schild und gegebenenfalls weiterem Zubehör"
                                        ],
                                        "tags": [
                                            "Heraldik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28cf1b14-2a54-4c9b-8a5e-2d17817056c7",
                                                "sense_id": "7e1a3120-8e35-3a6d-90d2-53300f57d084",
                                                "text": "Das Wappen von Deutschland zeigt in Gold einen rotbewehrten schwarzen Adler."
                                            },
                                            {
                                                "example_id": "65eafbdb-a4ef-48dd-b7da-9e72573730b6",
                                                "sense_id": "7e1a3120-8e35-3a6d-90d2-53300f57d084",
                                                "text": "„Auch die Wappen von Pommern, Schlesien und Ostpreußen waren dort abgebildet.“"
                                            },
                                            {
                                                "example_id": "322294cb-d44c-4c17-9ff3-8f43e3b7d0e6",
                                                "sense_id": "7e1a3120-8e35-3a6d-90d2-53300f57d084",
                                                "text": "„Damals hätte man längst das Wappen der Stadt Hamburg für den Zeitungskopf führen dürfen.“"
                                            },
                                            {
                                                "example_id": "e4a9fddc-44f4-4ae5-9890-d3249a3f762b",
                                                "sense_id": "7e1a3120-8e35-3a6d-90d2-53300f57d084",
                                                "text": "„Die kleine Bank mit den zwei Kissen war fortgeräumt, und statt ihrer stand eine Chaiselongue da, darauf die Kranke ruhte, den Oberkörper mit einem Schal, die Füße mit einer Reisedecke zugedeckt, in die das Wappen der St. Arnauds oder vielleicht auch das der Woronesch von Zacha eingestickt war.“"
                                            },
                                            {
                                                "example_id": "dcbcfe72-9349-43b2-b202-bbe61916ab98",
                                                "sense_id": "7e1a3120-8e35-3a6d-90d2-53300f57d084",
                                                "text": "„Zu seinen Vorfahren zählte auch der Hauptmann Paul von Leubnitz, der für seine Dienste im Jahre 1600 nobilitiert worden war und ein Wappen führen durfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7e2ad637-9c87-3fff-9c92-29638c593821",
                                        "entry_id": "6f97e9fb-cb02-3285-91af-0427fea6007a",
                                        "glosses": [
                                            "Kriegswappen, welches die Zugehörigkeit von Wehrmännern und Fahrzeugen zu einer bestimmten Streitmacht oder einem bestimmten Teil einer Streitmacht sichtbar anzeigt"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ea85d77-ffba-4f5d-b624-a387e9043125",
                                                "sense_id": "7e2ad637-9c87-3fff-9c92-29638c593821",
                                                "text": "Das Eiserne Kreuz, welches die Bundeswehr führt, ist ein Wappen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
