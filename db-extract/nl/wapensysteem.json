                "senses": [
                    {
                        "sense_id": "b5f832e8-f137-3e92-92d1-f4a92dcaa0ac",
                        "entry_id": "90181b65-ef51-3e60-8fa1-04c22c4c7b9a",
                        "glosses": [
                            "groep apparaten die samen een gevechtsfunctie hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ea4201a-97ec-479f-bb0c-3d15e670f1e4",
                                "sense_id": "b5f832e8-f137-3e92-92d1-f4a92dcaa0ac",
                                "text": "Toch gaat de verlenging niet zonder slag of stoot. Na het rapport van de Onderzoeksraad voor Veiligheid over het dodelijke mortierongeval in het Noord-Malinese Kidal staan de veiligheidsprocedures op scherp. Munitievoorraden en wapensystemen werden gecontroleerd. Waar twijfel over was, werd vernietigd of buiten gebruik gesteld. Het Togolese veldhospitaal in Kidal werd door eigen medisch deskundigen gecheckt en verbeterd. Voor de ambulance-helikopters, die de VN inhuurt, dwong Nederland ruimere beschikbaarheid en snellere procedures af."
                            },
                            {
                                "example_id": "a1749615-3150-4334-94f9-141bfe18cc5b",
                                "sense_id": "b5f832e8-f137-3e92-92d1-f4a92dcaa0ac",
                                "text": "De voorgenomen levering van de geavanceerde wapensystemen, die ballistische raketten op grote hoogte onschadelijk kunnen maken, „ondersteunt het buitenlandse beleid en de nationale veiligheidsdoelstellingen van de VS door de veiligheid van een bevriende natie te verbeteren”, aldus de toelichting."
                            }
                        ]
                    }
                ],
