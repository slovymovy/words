                    "frequency": "Low",
                    "semantic_group_id": "echec",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré une promotion coûteuse, sa nouvelle comédie a rapidement <w>chuté</w> au box-office."
