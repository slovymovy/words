{
    "word_family": [
        "wrinkly",
        "unwrinkled",
        "wrinkled"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ad087dd5-0fb7-3950-9f20-0d559317ea9f",
                    "sense_definition": "A line or crease in the skin, especially when caused by age or fatigue.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "crease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spending time out in the sun may cause you to develop <w>wrinkles</w> sooner.",
                            "target_lang_translations": {
                                "ru": "Пребывание на солнце может привести к тому, что <w>морщины</w> появятся у вас раньше.",
                                "zh": "长时间在阳光下暴晒可能会让你更快长出<w>皱纹</w>。"
                            }
                        },
                        {
                            "text": "She noticed a new <w>wrinkle</w> around her eyes when she looked in the mirror.",
                            "target_lang_translations": {
                                "ru": "Посмотрев в зеркало, она заметила новую <w>морщинку</w> вокруг глаз.",
                                "zh": "她照镜子时发现眼角多了一道<w>皱纹</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "line",
                        "crease",
                        "furrow"
                    ],
                    "common_phrases": [
                        "deep wrinkle",
                        "facial wrinkle",
                        "develop wrinkles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Линия или складка на коже, особенно вызванная возрастом или усталостью.",
                        "zh": "皮肤上的线条或褶皱，通常由年龄或疲劳引起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морщина",
                                "target_lang_sense_clarification": "складка на коже лица или тела"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "皱纹",
                                "target_lang_sense_clarification": "皮肤上的褶皱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cc6495b-f2b0-3a03-8397-7aef0bf1b238",
                    "sense_definition": "A small furrow, ridge or crease in an otherwise smooth surface, such as fabric or paper.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "crease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to iron my shirt because it has a large <w>wrinkle</w> on the sleeve.",
                            "target_lang_translations": {
                                "ru": "Мне нужно погладить рубашку, потому что на рукаве большая <w>складка</w>.",
                                "zh": "我得熨一下衬衫，因为袖子上有一道很大的<w>褶皱</w>。"
                            }
                        },
                        {
                            "text": "He tried to smooth out every <w>wrinkle</w> in the tablecloth before the guests arrived.",
                            "target_lang_translations": {
                                "ru": "Он старался разгладить каждую <w>морщинку</w> на скатерти до прихода гостей.",
                                "zh": "客人们到来之前，他努力把桌布上的每一处<w>褶皱</w>都抚平。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crease",
                        "fold",
                        "pucker"
                    ],
                    "common_phrases": [
                        "iron out wrinkles",
                        "smooth a wrinkle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая бороздка или складка на гладкой поверхности, такой как ткань или бумага.",
                        "zh": "平滑表面（如织物或纸张）上的小沟纹、脊或褶皱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "складка",
                                "target_lang_sense_clarification": "неровность на ткани или бумаге"
                            },
                            {
                                "target_lang_word": "залом",
                                "target_lang_sense_clarification": "резкая складка на бумаге или одежде"
                            },
                            {
                                "target_lang_word": "морщина",
                                "target_lang_sense_clarification": "неровность на поверхности скатерти или ткани"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "褶皱",
                                "target_lang_sense_clarification": "布料或纸张上的折痕"
                            },
                            {
                                "target_lang_word": "折痕",
                                "target_lang_sense_clarification": "物体表面留下的痕迹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fa451c3-c070-30e4-9c9c-b96babf7752a",
                    "sense_definition": "A fault, imperfection or bug especially in a new system or product.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "problem",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Three months later, we're still discovering new <w>wrinkles</w> in the software.",
                            "target_lang_translations": {
                                "ru": "Спустя три месяца мы все еще обнаруживаем новые <w>недоработки</w> в программном обеспечении.",
                                "zh": "三个月过去了，我们仍然在软件中发现新的<w>瑕疵</w>。"
                            }
                        },
                        {
                            "text": "The team needs to iron out the <w>wrinkles</w> in the plan before the launch.",
                            "target_lang_translations": {
                                "ru": "Команде нужно устранить все <w>шероховатости</w> в плане перед запуском.",
                                "zh": "团队需要在发布前解决计划中的<w>小毛病</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "glitch",
                        "hitch",
                        "snag",
                        "kink"
                    ],
                    "common_phrases": [
                        "iron out wrinkles"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the context of problem solving"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Недостаток, несовершенство или ошибка, особенно в новой системе или продукте.",
                        "zh": "系统或产品中的缺陷、瑕疵或小问题。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недоработка",
                                "target_lang_sense_clarification": "небольшой изъян в плане или системе"
                            },
                            {
                                "target_lang_word": "шероховатость",
                                "target_lang_sense_clarification": "мелкая недоделка или баг"
                            },
                            {
                                "target_lang_word": "заминка",
                                "target_lang_sense_clarification": "небольшое препятствие или задержка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瑕疵",
                                "target_lang_sense_clarification": "计划或系统中的小问题"
                            },
                            {
                                "target_lang_word": "小毛病",
                                "target_lang_sense_clarification": "系统中的小故障"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29c65062-7b5e-36a2-ae4e-ebec2915d103",
                    "sense_definition": "A clever innovation or a novel twist on something existing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "innovation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef added a new <w>wrinkle</w> to the traditional recipe by using exotic spices.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар добавил новую <w>изюминку</w> в традиционный рецепт, использовав экзотические специи.",
                                "zh": "厨师通过使用异国香料，为传统食谱增添了新的<w>新意</w>。"
                            }
                        },
                        {
                            "text": "This latest model includes a clever <w>wrinkle</w> that makes it much easier to use.",
                            "target_lang_translations": {
                                "ru": "В этой последней модели есть одна умная <w>фишка</w>, которая значительно упрощает использование.",
                                "zh": "这款最新型号包含一个巧妙的<w>巧思</w>，使其使用起来方便多了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "twist",
                        "innovation",
                        "variation"
                    ],
                    "common_phrases": [
                        "new wrinkle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умное новшество или необычный поворот в чем-то уже существующем.",
                        "zh": "对现有事物的巧妙创新或新颖的改动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изюминка",
                                "target_lang_sense_clarification": "необычная деталь, новшество"
                            },
                            {
                                "target_lang_word": "фишка",
                                "target_lang_sense_clarification": "разг., интересная особенность"
                            },
                            {
                                "target_lang_word": "нюанс",
                                "target_lang_sense_clarification": "тонкое различие или дополнение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新意",
                                "target_lang_sense_clarification": "巧妙的创新点"
                            },
                            {
                                "target_lang_word": "巧思",
                                "target_lang_sense_clarification": "巧妙的构思"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "86ead98e-76b7-3698-a55f-c2706168fecd",
                    "sense_definition": "To make wrinkles in; to cause a surface to have creases.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "creasing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>wrinkle</w> your dress before we arrive at the party.",
                            "target_lang_translations": {
                                "ru": "Будь осторожна, не <w>помни</w> платье до того, как мы придем на вечеринку.",
                                "zh": "小心别在到达派对前把你的裙子<w>弄皱</w>了。"
                            }
                        },
                        {
                            "text": "If you pack your clothes too tightly, you will <w>wrinkle</w> them.",
                            "target_lang_translations": {
                                "ru": "Если вы упакуете одежду слишком плотно, вы её <w>изомнете</w>.",
                                "zh": "如果你把衣服塞得太紧，就会把它们<w>揉皱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crease",
                        "crumple",
                        "rumple"
                    ],
                    "antonyms": [
                        "smooth",
                        "iron"
                    ],
                    "common_phrases": [
                        "wrinkle clothes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать складки; приводить к появлению неровностей на поверхности.",
                        "zh": "使表面产生褶皱或折痕。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мять",
                                "target_lang_sense_clarification": "делать одежду или бумагу негладкой"
                            },
                            {
                                "target_lang_word": "сминать",
                                "target_lang_sense_clarification": "изменять форму, делая неровным"
                            },
                            {
                                "target_lang_word": "измять",
                                "target_lang_sense_clarification": "сильно помять поверхность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弄皱",
                                "target_lang_sense_clarification": "使物体表面产生褶皱"
                            },
                            {
                                "target_lang_word": "揉皱",
                                "target_lang_sense_clarification": "用力使物体产生折痕"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd7c1cd6-4208-3935-ad93-aaf322277526",
                    "sense_definition": "To pucker or become uneven or irregular in surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "creasing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An hour in the tub will cause your fingers to <w>wrinkle</w>.",
                            "target_lang_translations": {
                                "ru": "Через час в ванне ваши пальцы <w>сморщатся</w>.",
                                "zh": "在浴缸里泡一个小时，你的手指就会<w>起皱</w>。"
                            }
                        },
                        {
                            "text": "The paper began to <w>wrinkle</w> as it absorbed the spilled water.",
                            "target_lang_translations": {
                                "ru": "Бумага начала <w>коробиться</w>, впитывая пролитую воду.",
                                "zh": "纸张在吸收了洒出的水后开始<w>皱缩</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pucker",
                        "shrivel"
                    ],
                    "common_phrases": [
                        "wrinkle up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собираться в складки или становиться неровным на поверхности.",
                        "zh": "表面收缩、起皱或变得不平整。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морщиться",
                                "target_lang_sense_clarification": "о коже или поверхности воды"
                            },
                            {
                                "target_lang_word": "сморщиться",
                                "target_lang_sense_clarification": "съежиться, покрыться складками"
                            },
                            {
                                "target_lang_word": "пузыриться",
                                "target_lang_sense_clarification": "ложиться неровно (о бумаге или обоях)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "起皱",
                                "target_lang_sense_clarification": "表面变得不平整"
                            },
                            {
                                "target_lang_word": "皱缩",
                                "target_lang_sense_clarification": "因水分流失或受压而收缩"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e91d3f2-f5da-3fd6-bb57-13a37d84de91",
                    "sense_definition": "To develop wrinkles on the skin as a result of aging.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The skin is the substance that <w>wrinkles</w> and shows age over time.",
                            "target_lang_translations": {
                                "ru": "Кожа — это ткань, которая со временем <w>покрывается морщинами</w> и выдает возраст.",
                                "zh": "皮肤是随着时间推移会<w>长皱纹</w>并显露年龄的组织。"
                            }
                        },
                        {
                            "text": "He noticed that his forehead started to <w>wrinkle</w> more as he got older.",
                            "target_lang_translations": {
                                "ru": "Он заметил, что с возрастом его лоб стал сильнее <w>морщиться</w>.",
                                "zh": "他注意到随着年龄增长，他的额头开始更容易<w>长皱纹</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "skin wrinkles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрываться морщинами в результате старения.",
                        "zh": "因衰老而导致皮肤出现皱纹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покрываться морщинами",
                                "target_lang_sense_clarification": "о коже человека"
                            },
                            {
                                "target_lang_word": "стареть",
                                "target_lang_sense_clarification": "в контексте изменения кожи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "长皱纹",
                                "target_lang_sense_clarification": "皮肤因衰老而产生褶皱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae06f1ff-f67e-33fd-b678-bb3f0ec8f4a8",
                    "sense_definition": "To show contempt or disapproval by contracting the nose or face; to sneer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She would <w>wrinkle</w> her nose at any suggestion she didn't like.",
                            "target_lang_translations": {
                                "ru": "Она <w>морщила</w> нос при любом предложении, которое ей не нравилось.",
                                "zh": "对于任何她不喜欢的建议，她都会<w>皱鼻子</w>。"
                            }
                        },
                        {
                            "text": "There is some weakness in your brother you <w>wrinkle</w> at.",
                            "target_lang_translations": {
                                "ru": "В твоем брате есть какая-то слабость, от которой ты <w>воротишь нос</w>.",
                                "zh": "你哥哥身上有些弱点让你感到不屑而<w>皱鼻子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sneer",
                        "scoff"
                    ],
                    "common_phrases": [
                        "wrinkle at"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English in this sense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать презрение или неодобрение, морща нос или лицо; насмехаться.",
                        "zh": "通过收缩鼻子或面部来表达轻蔑或不赞同。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морщиться",
                                "target_lang_sense_clarification": "выражать недовольство лицом"
                            },
                            {
                                "target_lang_word": "воротить нос",
                                "target_lang_sense_clarification": "идиома, выражать пренебрежение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "皱鼻子",
                                "target_lang_sense_clarification": "表示不满或厌恶"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "421bcd01-be1b-3047-96f0-3556978040a6",
                    "sense_definition": "An English surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local directory listed a family with the name <w>Wrinkle</w>.",
                            "target_lang_translations": {
                                "ru": "В местном справочнике значилась семья по фамилии <w>Ринкл</w>.",
                                "zh": "当地名录里列出了一户姓<w>林克尔</w>的人家。"
                            }
                        },
                        {
                            "text": "Professor <w>Wrinkle</w> published a paper on historical linguistics.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Ринкл</w> опубликовал статью по исторической лингвистике.",
                                "zh": "<w>林克尔</w>教授发表了一篇关于历史语言学的论文。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия.",
                        "zh": "一个英语姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ринкл",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "林克尔",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}