                                "target_senses": [
                                    {
                                        "sense_id": "d3927503-da94-38be-bcc9-4b9f957f5ac3",
                                        "entry_id": "e7b46116-1556-30bc-b9d6-dd6ee571475e",
                                        "glosses": [
                                            "stenen of kunststof beeld van een kabouter dat in de tuin wordt geplaatst, vooral ter versiering"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29ce6ed2-c430-4dd2-94ec-47d0575c9e02",
                                                "sense_id": "d3927503-da94-38be-bcc9-4b9f957f5ac3",
                                                "text": "Het begon met de tuinkabouters en ganzen die hij opmerkte in voortuinen in zijn woonplaats Eemdijk. Fotograaf Daniel Koning (1940) bedacht iets te doen met de manier waarop Nederlanders hun woningen personaliseren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db4d894b-e642-3103-8c82-02111116c2c1",
                                        "entry_id": "e7b46116-1556-30bc-b9d6-dd6ee571475e",
                                        "glosses": [
                                            "wereldvreemde idealist"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dfab3a2-1223-4aa1-b692-f31c50103cdc",
                                                "sense_id": "db4d894b-e642-3103-8c82-02111116c2c1",
                                                "text": "Tuinkabouter Bram van Ojik trekt de stekker eruit en geeft het snoertje door aan Jesse \"Snotneus\" Klaver."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
