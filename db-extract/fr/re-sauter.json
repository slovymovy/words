                "senses": [
                    {
                        "sense_id": "1c118e13-07cb-3114-9a27-32492a08c31f",
                        "entry_id": "f9e9df4b-2679-38b2-9d43-bb90988d8c95",
                        "glosses": [
                            "Variante orthographique de resauter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25a9fe82-d150-4dcf-8618-84c379b286ef",
                                "sense_id": "1c118e13-07cb-3114-9a27-32492a08c31f",
                                "text": "Et s’il m’en reste de la honte, elle ne se traduit que par un surcroît de volonté de faire tout de suite quelque chose, de bien, tel le cavalier démonté re-saute rageusement en selle."
                            },
                            {
                                "example_id": "3326539f-3502-4dff-9f74-bdda1a9a11be",
                                "sense_id": "1c118e13-07cb-3114-9a27-32492a08c31f",
                                "text": "Non pas re-sauter à la même place, comme si rien ne s'était passé, mais re-sauter un petit peu à côté pour continuer d'avancer..."
                            }
                        ]
                    }
