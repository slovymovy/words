                "senses": [
                    {
                        "sense_id": "48bb8ab8-136e-3430-b410-cd51842ccbd2",
                        "entry_id": "cafba6cf-2586-3ed2-b790-713a8c225a72",
                        "glosses": [
                            "Genre de cétacés à dents des eaux froides, au melon proéminent, ne comprenant que deux espèces, l’une boréale et l’autre australe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfecbe74-124c-429f-b05f-edf54c914930",
                                "sense_id": "48bb8ab8-136e-3430-b410-cd51842ccbd2",
                                "text": "La population est estimée à environ 40 000 hypérodons dans l’Atlantique nord-est (dont environ 6 000 individus dans les hautes latitudes)."
                            },
                            {
                                "example_id": "b75c67bb-e013-4da0-b542-6f6709c8043b",
                                "sense_id": "48bb8ab8-136e-3430-b410-cd51842ccbd2",
                                "text": "Nous aurons même été accueillis la veille en approchant par plusieurs visites de cétacés : rorquals communs, dauphins et même subrepticement un hypérodon boréal (qui n’est pas une licorne arc-en-ciel)."
                            },
                            {
                                "example_id": "d9df9147-72d2-4126-b3e9-5fa3cfd38677",
                                "sense_id": "48bb8ab8-136e-3430-b410-cd51842ccbd2",
                                "text": "Le spécimen de Londres appartenait à l’espèce hypérodon arctique (Hyperoodon ampullatus)."
                            }
                        ]
                    }
                ],
