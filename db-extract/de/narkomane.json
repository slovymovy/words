                                                "sense_id": "7fbbfdca-ee5c-3b00-810e-d928683faeb2",
                                                "text": "That part of mankind that addict their minds to speculations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01e2e569-6e1e-367b-9464-6131c97b5f41",
