                        "cross_references": [
                            {
                                "target_word": "wandering",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98d61a83-9d89-34c2-8bf9-cd7216ffb20c",
                                        "entry_id": "dcb11466-3c41-3ddf-ae02-a850c4ab8e90",
                                        "glosses": [
                                            "Which wanders; travelling from place to place."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b74e7ce-7f72-4454-9d81-0eda4da4a6c3",
                                                "sense_id": "98d61a83-9d89-34c2-8bf9-cd7216ffb20c",
                                                "text": "This was the time when Venerable Master Hsing Yun first arrived in Taiwan as a wandering monk and was refused lodgings. He was nearly reduced to begging on the street. Fortunately, the old Venerable Miaoguo of Yuanguang Temple in Chungli took him in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6cdfd23-cc73-341f-9e03-3d3952d0571a",
                                        "entry_id": "dcb11466-3c41-3ddf-ae02-a850c4ab8e90",
                                        "glosses": [
                                            "Abnormally capable of moving in certain directions."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "861bd054-e2a7-4875-9d52-fa6a099dfd0f",
                                                "sense_id": "d6cdfd23-cc73-341f-9e03-3d3952d0571a",
                                                "text": "a wandering kidney; a wandering liver"
                                            }
                                        ]
                                    }
