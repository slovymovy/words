    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4dbe556-eb5d-319f-87b1-b81ec35ff1e2",
                    "sense_definition": "Rendre un lieu, un équipement ou un système informatique plus sûr et protégé contre tout danger ou intrusion.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police a rapidement bouclé le quartier pour <w>sécuriser</w> la zone après l'accident."
                        },
                        {
                            "text": "Il est indispensable d'utiliser un mot de passe complexe pour <w>sécuriser</w> votre compte en ligne."
                        }
                    ],
                    "common_phrases": [
                        "sécuriser le périmètre",
                        "sécuriser les accès",
                        "sécuriser un paiement"
                    ]
                },
                {
                    "sense_id": "92808df3-e17f-36b7-becd-b23bfeff3458",
                    "sense_definition": "Rassurer quelqu'un, lui donner un sentiment de tranquillité et de confiance face à ses craintes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La présence bienveillante de l'enseignante parvient toujours à <w>sécuriser</w> les enfants intimidés."
                        },
                        {
                            "text": "Ses explications calmes ont permis de me <w>sécuriser</w> avant cette intervention chirurgicale délicate."
                        }
                    ],
                    "synonyms": [
                        "rassurer"
                    ],
                    "common_phrases": [
                        "sécuriser un enfant",
                        "sécuriser les esprits"
                    ]
                },
                {
                    "sense_id": "e8ed7d67-3e33-3301-9cf7-fa59648f2ed5",
                    "sense_definition": "Garantir la stabilité d'une situation ou préserver un acquis face aux incertitudes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau contrat va permettre de <w>sécuriser</w> les finances de notre entreprise pour l'année à venir."
                        },
                        {
                            "text": "Le gouvernement a proposé des mesures afin de <w>sécuriser</w> l'emploi des jeunes diplômés."
                        }
                    ],
                    "common_phrases": [
