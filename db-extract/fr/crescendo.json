            {
                "entry_id": "eafa6aac-0f26-36f6-a819-5369857a324c",
                "word": "crescendo",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e283649f-4c42-46d9-b3a9-f8803125cf93",
                        "entry_id": "eafa6aac-0f26-36f6-a819-5369857a324c",
                        "tags": [
                            "plural"
                        ],
                        "form": "crescendos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a398a3d5-885a-333f-be86-70a035b0bdf8",
                        "entry_id": "eafa6aac-0f26-36f6-a819-5369857a324c",
                        "glosses": [
                            "Renforcement, enflement par degrés les sons de la voix ou des instruments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a25332c5-6b53-43a7-b1a2-455cd8f92cf1",
                                "sense_id": "a398a3d5-885a-333f-be86-70a035b0bdf8",
                                "text": "La chanson est construite en un grand crescendo. JPJ joue l’intro avec un trio de flûtes à bec (ténor, alto et soprano) accompagné par une simple guitare acoustique. Puis une première guitare électrique intervient, ainsi que des notes basses au clavier."
                            }
                        ]
                    },
                    {
                        "sense_id": "77f28989-a2a4-3e82-95a7-5f637e83f0d8",
                        "entry_id": "eafa6aac-0f26-36f6-a819-5369857a324c",
                        "glosses": [
                            "Augmentation progressive."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e379cf4d-0838-4cc1-8b39-9503d9eddc48",
                                "sense_id": "77f28989-a2a4-3e82-95a7-5f637e83f0d8",
                                "text": "[…] puis tout à coup, ne sais comment, vous voyez calomnie se dresser, siffler, s’enfler, grandir à vue d’œil. Elle s’élance, étend son vol, tourbillonne, enveloppe, arrache, entraîne, éclate et tonne, et devient, grâce au Ciel, un cri général, un crescendo public, un chorus universel de haine et de proscription. Qui diable y résisterait ?"
                            },
                            {
                                "example_id": "846914c6-6d70-4e5d-90aa-e68101630dfc",
                                "sense_id": "77f28989-a2a4-3e82-95a7-5f637e83f0d8",
                                "text": "Cette page de l’histoire est un long crescendo de batailles."
                            },
                            {
                                "example_id": "41801fc6-21cc-419a-8bcd-1cfe6281b6fb",
                                "sense_id": "77f28989-a2a4-3e82-95a7-5f637e83f0d8",
                                "text": "Il y avait des accalmies subites dans le tir de la D.C.A., suivies de brusques crescendos."
                            },
                            {
                                "example_id": "24364ddf-be33-4f88-9ead-5594a27daae6",
                                "sense_id": "77f28989-a2a4-3e82-95a7-5f637e83f0d8",
                                "text": "Par la crainte et la contrainte, il tente aussi de secouer la minorité de récalcitrants pour qu’elle suive enfin les consignes sanitaires.\n Lundi, le crescendo montait de deux crans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbfa5bcc-8ee5-4b2e-b9e9-1ccdd9c20b54",
                        "source_entry_id": "eafa6aac-0f26-36f6-a819-5369857a324c",
                        "target_lang_word": "Crescendo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Crescendo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b145315b-4599-334f-9e46-e52eb74a5c61",
                                        "entry_id": "33032605-5675-3637-a220-4a3b71eac2ff",
                                        "glosses": [
                                            "langsamer Anstieg der Tonstärke"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26ff800c-5a00-446f-a04a-3c4b5f0de158",
                                                "sense_id": "b145315b-4599-334f-9e46-e52eb74a5c61",
                                                "text": "Das Stück begann mit einem Crescendo."
                                            },
                                            {
                                                "example_id": "38148da7-26bb-40a0-8e97-8ae49d4fec44",
                                                "sense_id": "b145315b-4599-334f-9e46-e52eb74a5c61",
                                                "text": "„Schließlich mündete sie in einem furiosen Crescendo.“"
                                            },
                                            {
                                                "example_id": "ffc40a36-9086-4899-a14f-92d9bfac656f",
                                                "sense_id": "b145315b-4599-334f-9e46-e52eb74a5c61",
                                                "text": "„In höllischem Crescendo legte die Air Force im Frühjahr Japans Städte eine nach der anderen in Schutt und Asche.“"
                                            },
                                            {
                                                "example_id": "479e995f-fcd4-4a45-856f-6468951a3a82",
                                                "sense_id": "b145315b-4599-334f-9e46-e52eb74a5c61",
                                                "text": "„Die Musik holt zu einem kräftigen Crescendo aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
