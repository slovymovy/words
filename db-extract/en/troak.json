                                        "sense_id": "51246d79-0472-3054-b878-13e588eef207",
                                        "entry_id": "0b273fda-da95-338f-991d-ee39dd9a8891",
                                        "glosses": [
                                            "Réaliser, sur une aiguille à coudre, l'opération de la troque."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
