                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grillage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc5d3aff-9429-3ce8-8ce8-5400200b92bd",
                                        "entry_id": "0fa66f25-3dee-324b-88d6-4b1783592df3",
                                        "glosses": [
                                            "Treillis de fils de fer ou de plastique à mailles plus ou moins grandes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a8b726c-53e4-4467-a19d-c97196a48af8",
                                                "sense_id": "fc5d3aff-9429-3ce8-8ce8-5400200b92bd",
                                                "text": "Un tamis est constitué d’un cadre et d’un grillage dont la grandeur des mailles détermine la grosseur des éléments qui peuvent ou non le traverser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5956908b-4248-39f0-aa75-893ab37cf4e8",
                                        "entry_id": "0fa66f25-3dee-324b-88d6-4b1783592df3",
                                        "glosses": [
                                            "Treillis métallique, à mailles plus ou moins grandes, installé devant une ouverture de bâtiment, d’un meuble et destiné à interdire le passage des personnes et des animaux tout en permettant le passage de l’air et du son."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ba571ec-354a-41df-a227-7e42e9f2fd0c",
                                                "sense_id": "5956908b-4248-39f0-aa75-893ab37cf4e8",
                                                "text": "En passant devant la mairie, je vis qu’il y avait du monde arrêté près du petit grillage aux affiches."
                                            },
                                            {
                                                "example_id": "13151a81-62d1-4d0b-b876-b9c9c38c8848",
                                                "sense_id": "5956908b-4248-39f0-aa75-893ab37cf4e8",
                                                "text": "Il n’y avait plus entre nous que des barrières matérielles, la présence de son maître, et le grillage de fer de ses fenêtres."
                                            },
                                            {
                                                "example_id": "2ecdc6e8-359d-4e49-aa5b-b0dce5bff2be",
                                                "sense_id": "5956908b-4248-39f0-aa75-893ab37cf4e8",
                                                "text": "Le grillage d’une bibliothèque, d’un confessionnal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88c7345f-2ad8-3b74-9ada-0705d9758b5a",
                                        "entry_id": "0fa66f25-3dee-324b-88d6-4b1783592df3",
                                        "glosses": [
                                            "Clôture en treillis de fil de fer, plus rarement de plastique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37fe3359-ac7e-4e68-8bf9-320be47f3673",
                                                "sense_id": "88c7345f-2ad8-3b74-9ada-0705d9758b5a",
                                                "text": "Le grillage que nous avons installé au poulailler empêche les poules de s’échapper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6f43654-56a4-33fd-819e-c8e280731b36",
                                        "entry_id": "0fa66f25-3dee-324b-88d6-4b1783592df3",
                                        "glosses": [
                                            "Clôture à claire-voie réalisée avec des barres de fer."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09dbb0e8-e192-4c54-a37a-bcb3797a7f21",
                                                "sense_id": "f6f43654-56a4-33fd-819e-c8e280731b36",
                                                "text": "Fermer le soupirail d’une cave avec un grillage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "024ddc3a-8944-38e7-a1f2-6494288571e4",
                                        "entry_id": "0fa66f25-3dee-324b-88d6-4b1783592df3",
                                        "glosses": [
                                            "Treillage bouchant un étang pour y retenir le poisson."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "166b0d4a-3901-3acf-94d5-44a51193ce39",
                                        "entry_id": "0fa66f25-3dee-324b-88d6-4b1783592df3",
                                        "glosses": [
                                            "Assemblage de pièces de charpente croisées destinées à soutenir des fondations dans un terrain humide ou meuble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "322e97bb-d956-44c0-b128-7d9edb665c20",
                                                "sense_id": "166b0d4a-3901-3acf-94d5-44a51193ce39",
                                                "text": "Réaliser un grillage sur pilotis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61e3ddc3-59cb-3240-b06a-088e2ab74b43",
                                        "entry_id": "0fa66f25-3dee-324b-88d6-4b1783592df3",
                                        "glosses": [
                                            "Technique de chasse, de braconnage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb7f6482-d322-49ac-88c5-bcc7061fc411",
                                                "sense_id": "61e3ddc3-59cb-3240-b06a-088e2ab74b43",
                                                "text": "Chasser au grillage."
                                            },
                                            {
                                                "example_id": "21264956-2f7a-477b-999f-fa814966f68b",
                                                "sense_id": "61e3ddc3-59cb-3240-b06a-088e2ab74b43",
                                                "text": "Et si la lune, brillant dans la nuit avancée, venait toucher la porte vitrée du jardin, qui est-ce qui l'empêcherait de se lever doucement du lit, de siffler Aïcha et de partir avec elle au grillage ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grillage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f21e8a5-368e-3cf6-b4f0-7dfa71889fe0",
                                        "entry_id": "0cbe7a9b-c275-3558-bb7c-9e4fa12eb3c2",
                                        "glosses": [
                                            "Action de griller ou de torréfier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c758019-e61e-4a9d-a65f-d87e43d8257c",
                                                "sense_id": "2f21e8a5-368e-3cf6-b4f0-7dfa71889fe0",
                                                "text": "Ces fragments, qui portent le nom de cossettes, sont torréfiés dans de grands brûloirs à café, […]. On ajoute quelquefois, après le grillage, un peu de beurre pour lustrer les cossettes et leur donner l'aspect du café brûlé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "114e9488-60bb-3946-9c47-17ff9c1170ee",
                                        "entry_id": "0cbe7a9b-c275-3558-bb7c-9e4fa12eb3c2",
                                        "glosses": [
                                            "Action de griller les tissus comme la laine et le coton en particulier, afin de leur donner un apprêt en enlevant les petites fibres superficielles qui forment un duvet, c'est une opération indispensable avant l'impression."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e94ebbb-ec5d-3cd9-8752-99f5b9c2ac35",
                                        "entry_id": "0cbe7a9b-c275-3558-bb7c-9e4fa12eb3c2",
                                        "glosses": [
                                            "Lieu où s’effectuent les opérations de grillage des tissus."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "163dbdc1-ba41-32d7-ba81-b9cf77d9a0b7",
                                        "entry_id": "0cbe7a9b-c275-3558-bb7c-9e4fa12eb3c2",
                                        "glosses": [
                                            "Opération consistant à chauffer au rouge un minerai en présence d'oxygène, soit pour le rendre plus friable, soit pour dissocier certaines substances combinées avec lui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69c4e8c3-0ca2-4362-a929-e0cfe21f0738",
                                                "sense_id": "163dbdc1-ba41-32d7-ba81-b9cf77d9a0b7",
                                                "text": "On peut obtenir le mercure par grillage du sulfure de mercure."
                                            }
                                        ]
                                    }
                                ]
