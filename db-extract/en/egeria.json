            {
                "entry_id": "f327230b-e9a0-360e-9b53-264bfb35f988",
                "word": "Egeria",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d6d0a85-5abf-3500-8b40-4f35647a49a0",
                        "entry_id": "f327230b-e9a0-360e-9b53-264bfb35f988",
                        "glosses": [
                            "A patroness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a93b4241-77b8-4de9-9ce8-09ef30978135",
                                "sense_id": "7d6d0a85-5abf-3500-8b40-4f35647a49a0",
                                "text": "And she was being disrespectful and patronising to Lady Macmaster, Egeria to innumerable Scottish Men of Letters!"
                            },
                            {
                                "example_id": "80ae2997-798b-47d5-b26a-62fcb1816cfc",
                                "sense_id": "7d6d0a85-5abf-3500-8b40-4f35647a49a0",
                                "text": "Talleyrand informed Madame de Staël of the expected visit, and she, who had already pictured herself as the Egeria of the young genius upon whom the eyes of France were fastened, was waiting in the anteroom on the following morning."
                            },
                            {
                                "example_id": "4c516d2f-e2bf-444a-8247-2184c5ee097d",
                                "sense_id": "7d6d0a85-5abf-3500-8b40-4f35647a49a0",
                                "text": "Ada, separated from her husband, was regarded as the Egeria of a mainly homosexual coterie that included Robbie Ross, Reggie Turner, Max Beerbohm and Lord Alfred Douglas."
                            }
                        ]
                    }
                ],
