{
    "word_family": [
        "pat"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "34a25d28-90b5-3cec-bfff-08d9fdba9598",
                    "sense_definition": "A soft repeated sound, such as rain falling or feet walking on a hard surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could hear the soft <w>patter</w> of rain against the windowpane all night.",
                            "target_lang_translations": {
                                "cs": "Celou noc jsem slyšel jemný <w>klapot</w> deště na okenní tabulku."
                            }
                        },
                        {
                            "text": "The <w>patter</w> of tiny feet in the hallway woke me up early this morning.",
                            "target_lang_translations": {
                                "cs": "<w>Klapot</w> drobných nožek na chodbě mě dnes brzy ráno probudil."
                            }
                        }
                    ],
                    "synonyms": [
                        "tapping",
                        "drumming"
                    ],
                    "common_phrases": [
                        "patter of rain",
                        "patter of feet"
                    ],
                    "target_lang_definitions": {
                        "cs": "Jemný opakovaný zvuk, například když padá déšť nebo kráčejí nohy po tvrdém povrchu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "klapot",
                                "target_lang_sense_clarification": "jemný opakovaný zvuk, typicky deště"
                            },
                            {
                                "target_lang_word": "ťukání",
                                "target_lang_sense_clarification": "slabé opakované ťukavé zvuky"
                            },
                            {
                                "target_lang_word": "bubnování",
                                "target_lang_sense_clarification": "tlumený rytmický zvuk dopadání"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7408ecd-f79c-3f30-9145-844ab7b6b1dc",
                    "sense_definition": "Glib and rapid speech, often used by performers or salespeople.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian kept the audience laughing with his quick-witted <w>patter</w> between jokes.",
                            "target_lang_translations": {
                                "cs": "Komik udržoval publikum v smíchu svými pohotovými <w>řečičkami</w> mezi vtipy."
                            }
                        },
                        {
                            "text": "The auctioneer used a fast <w>patter</w> to keep the bidding process moving along quickly.",
                            "target_lang_translations": {
                                "cs": "Dražitel používal rychlé <w>odříkávané řeči</w>, aby dražba svižně pokračovala."
                            }
                        }
                    ],
                    "synonyms": [
                        "chatter",
                        "banter"
                    ],
                    "common_phrases": [
                        "sales patter"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pohotová a rychlá mluva, často používaná umělci nebo obchodníky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "řečičky",
                                "target_lang_sense_clarification": "pohotové, rychlé a trochu naučené mluvení, zvlášť u komiků nebo obchodníků"
                            },
                            {
                                "target_lang_word": "prodejní řeči",
                                "target_lang_sense_clarification": "naučené přesvědčovací řeči obchodníka"
                            },
                            {
                                "target_lang_word": "žvanění",
                                "target_lang_sense_clarification": "rychlé a povrchní mluvení; spíše hovorové až hanlivé"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96931557-1ea7-33ab-9626-0ae9af01572e",
                    "sense_definition": "A person who pats someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child was a frequent head <w>patter</w> whenever he saw his favorite dog.",
                            "target_lang_translations": {
                                "cs": "Kdykoli dítě vidělo svého oblíbeného psa, často ho <w>poplácávalo</w> po hlavě."
                            }
                        },
                        {
                            "text": "She was known as a gentle <w>patter</w> of the horses at the local stable.",
                            "target_lang_translations": {
                                "cs": "V místní stáji byla známá jako člověk, který koně jemně <w>poplácává</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Člověk, který někoho nebo něco poplácává."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "poplácávat",
                                "target_lang_sense_clarification": "opisem: ten, kdo někoho nebo něco poplácává"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e672109-ef8a-38fc-97e1-70721b94f71a",
                    "sense_definition": "To make a series of soft, light, repeated sounds.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy rain began to <w>patter</w> against the roof of the old wooden cabin.",
                            "target_lang_translations": {
                                "cs": "Silný déšť začal <w>bubnovat</w> na střechu staré dřevěné chaty."
                            }
                        },
                        {
                            "text": "Small stones started to <w>patter</w> down the side of the steep mountain cliff.",
                            "target_lang_translations": {
                                "cs": "Po strmé horské stěně začaly <w>ťukat</w> malé kamínky."
                            }
                        }
                    ],
                    "synonyms": [
                        "tap",
                        "drum"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávat řadu jemných, lehkých a opakovaných zvuků."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ťukat",
                                "target_lang_sense_clarification": "vydávat jemné opakované ťukavé zvuky"
                            },
                            {
                                "target_lang_word": "bubnovat",
                                "target_lang_sense_clarification": "znít tlumeně a rytmicky, zvlášť o dešti"
                            },
                            {
                                "target_lang_word": "klapat",
                                "target_lang_sense_clarification": "vydávat lehký klepavý zvuk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c0e2ba9-7111-3df6-abab-c362b394b8cd",
                    "sense_definition": "To speak in a glib and rapid manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salesman continued to <w>patter</w> on about the features of the car without stopping.",
                            "target_lang_translations": {
                                "cs": "Prodavač bez přestání dál <w>chrlil naučené řeči</w> o vlastnostech auta."
                            }
                        },
                        {
                            "text": "He likes to <w>patter</w> about his achievements whenever he meets new people at parties.",
                            "target_lang_translations": {
                                "cs": "Kdykoli na večírcích potká nové lidi, rád <w>mele</w> o svých úspěších."
                            }
                        }
                    ],
                    "synonyms": [
                        "chatter",
                        "babble"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mluvit pohotově a rychle, často až příliš uhlazeným nebo naučeným způsobem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chrlit řeči",
                                "target_lang_sense_clarification": "mluvit rychle, uhlazeně a poněkud naučeně"
                            },
                            {
                                "target_lang_word": "žvanit",
                                "target_lang_sense_clarification": "mluvit příliš rychle a povrchně; hovorově"
                            },
                            {
                                "target_lang_word": "mlít",
                                "target_lang_sense_clarification": "dlouze a lehce otravně mluvit; hovorově"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d61f008-4e8b-3a3c-aa20-0ef679abaaf4",
                    "sense_definition": "To sprinkle or splash liquid lightly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef would <w>patter</w> a little water over the dough to keep it moist.",
                            "target_lang_translations": {
                                "cs": "Kuchař na těsto lehce <w>pokropil</w> trochu vody, aby zůstalo vlhké."
                            }
                        },
                        {
                            "text": "She began to <w>patter</w> the paint onto the canvas to create a textured effect.",
                            "target_lang_translations": {
                                "cs": "Začala <w>stříkat</w> barvu na plátno, aby vytvořila texturovaný efekt."
                            }
                        }
                    ],
                    "synonyms": [
                        "sprinkle",
                        "splash"
                    ],
                    "target_lang_definitions": {
                        "cs": "Lehce kropit nebo cákat tekutinu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pokropit",
                                "target_lang_sense_clarification": "lehce pokrýt tekutinou malými kapkami"
                            },
                            {
                                "target_lang_word": "postříkat",
                                "target_lang_sense_clarification": "lehce postříkat tekutinou"
                            },
                            {
                                "target_lang_word": "nakapat",
                                "target_lang_sense_clarification": "nechat v malých kapkách dopadat na povrch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66a3f6ee-4f61-31bb-8d35-f128406bcd50",
                    "sense_definition": "To repeat something hurriedly or in a muttered way.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nervous student started to <w>patter</w> through his speech without looking at the audience.",
                            "target_lang_translations": {
                                "cs": "Nervózní student začal svůj projev <w>odříkávat</w> bez pohledu na publikum."
                            }
                        },
                        {
                            "text": "He would <w>patter</w> his excuses quickly before leaving the room in a hurry.",
                            "target_lang_translations": {
                                "cs": "Než spěšně odešel z místnosti, rychle <w>vychrlil</w> své výmluvy."
                            }
                        }
                    ],
                    "synonyms": [
                        "mutter",
                        "mumble"
                    ],
                    "target_lang_definitions": {
                        "cs": "Něco rychle opakovat nebo pronášet spěšně či polohlasem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "odříkávat",
                                "target_lang_sense_clarification": "rychle a trochu mechanicky něco pronášet"
                            },
                            {
                                "target_lang_word": "vychrlit",
                                "target_lang_sense_clarification": "říkat něco rychle a proudem"
                            },
                            {
                                "target_lang_word": "mumlat",
                                "target_lang_sense_clarification": "říkat něco potichu a nezřetelně"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69d09027-067b-3f4a-90f2-1f5fb2b8f36f",
                    "sense_definition": "To recite a prayer, specifically the Lord's Prayer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pray",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monks would <w>patter</w> their morning prayers in the quiet chapel.",
                            "target_lang_translations": {
                                "cs": "Mniši v tiché kapli <w>odříkávali</w> své ranní modlitby."
                            }
                        },
                        {
                            "text": "She would <w>patter</w> the ancient words every evening before going to sleep.",
                            "target_lang_translations": {
                                "cs": "Každý večer před spaním <w>odříkávala</w> starobylá slova."
                            }
                        }
                    ],
                    "synonyms": [
                        "pray"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in a religious or historical context."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Odříkávat modlitbu, konkrétně modlitbu Páně."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "odříkávat modlitbu",
                                "target_lang_sense_clarification": "archaicky: odříkávat modlitbu, zvlášť Otčenáš"
                            },
                            {
                                "target_lang_word": "recitovat modlitbu",
                                "target_lang_sense_clarification": "archaicky: modlit se předepsanými slovy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38489a97-0868-373d-a839-e363912b6f92",
                    "sense_definition": "To engage in the act of praying.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pray",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They gathered in the sanctuary to <w>patter</w> for peace and guidance.",
                            "target_lang_translations": {
                                "cs": "Shromáždili se ve svatyni, aby se <w>modlili</w> za mír a vedení."
                            }
                        },
                        {
                            "text": "It was his custom to <w>patter</w> silently whenever he felt overwhelmed by life.",
                            "target_lang_translations": {
                                "cs": "Měl ve zvyku se tiše <w>modlit</w>, kdykoli ho život přemáhal."
                            }
                        }
                    ],
                    "synonyms": [
                        "pray"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to a traditional or old-fashioned way of praying."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Modlit se; účastnit se modlitby."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "modlit se",
                                "target_lang_sense_clarification": "archaicky: věnovat se modlitbě"
                            },
                            {
                                "target_lang_word": "konat modlitbu",
                                "target_lang_sense_clarification": "archaicky, knižně: pronášet modlitby"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}