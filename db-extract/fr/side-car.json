                                                "sense_id": "69c87549-4c8e-3a9d-8bdd-3fabccaa8124",
                                                "text": "Faux 19th-century bartenders in sleeve garters and baroque facial hair ply their trade in pre-Prohibition bars. Women wearing cloche hats order sidecars at speakeasies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "905b2daa-101d-334c-8aa5-e319e4ac7fcf",
                                        "entry_id": "f08f610a-ca9a-3c0d-a3cf-0e2576b4ab91",
                                        "glosses": [
                                            "A software component that runs in a separate process from the rest of the software, to provide isolation and encapsulation."
                                        ],
                                        "tags": [],
