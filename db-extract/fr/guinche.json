                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "db0c1415-8fc5-43f1-8d7e-b2496707c4ed",
                                "sense_id": "c2e9f6e5-b7d0-3aa0-b1c8-697a00c67907",
                                "text": "Je suis sauvage, j’aime pas la foule, j’aime pas la rigolade en commun, je suis trop coincé dans mes timidités pour me risquer à danser. Si la guinche est le seul vrai moyen pour se faire une fille, ça va être coton, la vie !"
                            }
                        ]
                    }
                ],
