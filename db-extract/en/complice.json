                        "examples": [
                            {
                                "example_id": "85add564-f90e-4bbc-a2c1-95f0ab528b98",
                                "sense_id": "ed072f7c-1d22-385a-acc3-204c56d2fa55",
                                "text": "The lives of all your loving complices / Lean on your health; the which, if you give o’er / To stormy passion, must perforce decay."
                            },
                            {
                                "example_id": "ada1dd98-1bdc-4843-b559-f85dcc7e0a85",
                                "sense_id": "ed072f7c-1d22-385a-acc3-204c56d2fa55",
                                "text": "VVell, the VVeſt-Saxon King vvas quickly overcome, and all his Complices either killed, or conquered, and yet King Edvvine demurred to embrace Chriſtianity."
                            },
                            {
                                "example_id": "b0f71f1a-3c5a-45dc-a8cc-b9eb891b4fe9",
                                "sense_id": "ed072f7c-1d22-385a-acc3-204c56d2fa55",
                                "text": "Our Saviour was accused that he would Destroy the Temple. The first Martyr Steven was stoned as a Complice."
                            },
                            {
                                "example_id": "c03379dc-fcaa-42a8-9c51-5397c5f53675",
                                "sense_id": "ed072f7c-1d22-385a-acc3-204c56d2fa55",
                                "text": "[A] bill confirming the attainder of Somerset and his complices was also rejected by the commons, tho’ it had passed the upper house."
                            }
                        ]
                    }
