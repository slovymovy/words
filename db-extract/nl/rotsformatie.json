                        "examples": [
                            {
                                "example_id": "5cf1e75a-9abb-4b94-abe5-6a9f39fbe431",
                                "sense_id": "9258a915-4423-320b-9c49-6ef0ed6acb09",
                                "text": "Noorse activisten willen dat een penisvormige rotsformatie in het zuiden van Noorwegen wordt hersteld. Joggers ontdekten gisteren dat de rotsformatie ernstig is beschadigd. De actie om de rots te herstellen lijkt succesvol: er is nu al bijna 10.000 euro ingezameld."
                            },
                            {
                                "example_id": "97c21e77-07e3-4ccd-bd49-c93fb309309a",
                                "sense_id": "9258a915-4423-320b-9c49-6ef0ed6acb09",
                                "text": "Na een klim van bijna 800 meter kwam de rover aan in het terrein met de rimpelingen in de bodem, in een gebied dat de Marker Band Vallei genoemd, naar een opvallende donkere rotsformatie, de marker band (markeringsband)."
                            },
                            {
                                "example_id": "bcc8c7ce-4ca8-49e7-b293-b8620988be59",
                                "sense_id": "9258a915-4423-320b-9c49-6ef0ed6acb09",
                                "text": "De monsters zijn afkomstig uit afzettingen van een rotsformatie in het noordelijkste puntje van Groenland. Ze werden al in 2006 afgenomen uit een ondiepe fjord, maar de technologie was toen nog niet ver genoeg om ze te kunnen analyseren."
                            }
                        ]
                    }
