                        "source_entry_id": "0c324b9b-5678-3374-b07b-45380c12796b",
                        "source_sense_description": "такой, в котором не проявился чей-либо талант; сделанный бездарно",
                        "target_lang_word": "vapid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vapid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c88b471a-9bb2-3848-b6ca-bf0e7d11af1a",
                                        "entry_id": "5579fe39-ac23-36eb-b90c-95759fb6c4f5",
                                        "glosses": [
                                            "Offering nothing that is stimulating or challenging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bec09e4-d18e-4e9e-ad18-994f8179ef0f",
                                                "sense_id": "c88b471a-9bb2-3848-b6ca-bf0e7d11af1a",
                                                "text": "In Koons' best-known works—a life-sized poly-chromed wood replica of Michael Jackson and his pet chimp Bubbles; vapid fin de siècle readymades such as a trio of basketballs floating in a fishtank […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3e7e7aa-74e0-39ce-af50-b3b1b8a64187",
                                        "entry_id": "5579fe39-ac23-36eb-b90c-95759fb6c4f5",
                                        "glosses": [
                                            "Lifeless, dull, or banal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eff7415f-4f4d-4a31-a1ac-031e60fc1e46",
                                                "sense_id": "e3e7e7aa-74e0-39ce-af50-b3b1b8a64187",
                                                "text": "Then there was a little more trite conversation between Mr. Arabin and Mr. Harding; trite, and hard, and vapid, and senseless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f585ae87-0764-302f-b18e-305dc2fd8cc6",
                                        "entry_id": "5579fe39-ac23-36eb-b90c-95759fb6c4f5",
                                        "glosses": [
                                            "Tasteless, bland, or insipid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea0e2db3-2173-4769-880d-47fed3dd2c98",
                        "source_entry_id": "0c324b9b-5678-3374-b07b-45380c12796b",
                        "source_sense_description": "такой, в котором не проявился чей-либо талант; сделанный бездарно",
                        "target_lang_word": "feeble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feeble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e571a880-ffd0-3138-9efb-1490a9ea3c0c",
                                        "entry_id": "9ac31ab2-f796-3751-9e05-af340e69df9f",
                                        "glosses": [
                                            "Deficient in physical strength."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccb12503-4974-48e5-95cd-16f47b96825c",
                                                "sense_id": "e571a880-ffd0-3138-9efb-1490a9ea3c0c",
                                                "text": "Though she appeared old and feeble, she could still throw a ball."
                                            },
                                            {
                                                "example_id": "c962de89-294c-45da-97f0-d604f0696e8a",
                                                "sense_id": "e571a880-ffd0-3138-9efb-1490a9ea3c0c",
                                                "text": "Pent up in Utica he vainly forms\nA poor Epitome of Roman Greatneſs,\nAnd, cover’d with Numidian Guards, directs\nA feeble Army, and an empty Senate,\nRemnants of mighty Battels fought in vain."
                                            },
                                            {
                                                "example_id": "19b992b1-b348-4f7f-bc55-b20dcf4ff068",
                                                "sense_id": "e571a880-ffd0-3138-9efb-1490a9ea3c0c",
                                                "text": "You've had your time\nGonna walk that line\nLike a living travesty,\nEndlessly bound to your sins\nI'll hunt you down in time\nYou're just a feeble swine\nHow can I compromise\nWhen all you do is deny"
                                            },
                                            {
                                                "example_id": "5c515a4f-b4f8-4dca-8feb-0692899e003c",
                                                "sense_id": "e571a880-ffd0-3138-9efb-1490a9ea3c0c",
                                                "text": "France were transformed from the feeble, divided unit that had squeaked past Wales in the semi-final, their half-backs finding the corners with beautifully judged kicks from hand, the forwards making yards with every drive and a reorganised Kiwi line-out beginning to malfunction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d931d768-1026-350c-80d7-017e8561131d",
                                        "entry_id": "9ac31ab2-f796-3751-9e05-af340e69df9f",
                                        "glosses": [
                                            "Lacking force, vigor, or effectiveness in action or expression; faint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a08cdd9f-3ebe-4be3-9c6b-bc79b4df3b87",
                                                "sense_id": "d931d768-1026-350c-80d7-017e8561131d",
                                                "text": "That was a feeble excuse for an example."
                                            }
                                        ]
                                    }
                                ]
                            },
