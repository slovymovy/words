        "fr-extract.jsonl": [
            {
                "entry_id": "9baeb42c-dad6-3053-a052-495e1af06783",
                "word": "boxon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9f81b0cf-b4d4-4e15-92c7-20eb68e026a6",
                        "entry_id": "9baeb42c-dad6-3053-a052-495e1af06783",
                        "tags": [
                            "plural"
                        ],
                        "form": "boxons"
                    },
                    {
                        "form_id": "16ec2533-f197-4237-9e50-f818888c0956",
                        "entry_id": "9baeb42c-dad6-3053-a052-495e1af06783",
                        "tags": [],
                        "form": "bocson"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "149c30d8-7a28-364f-b4e8-9510deae7c3b",
                        "entry_id": "9baeb42c-dad6-3053-a052-495e1af06783",
                        "glosses": [
                            "Établissement où se pratique la prostitution, maison close."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "bbc3fa2e-8f78-42e5-b972-7fa9606b6dc6",
                                "sense_id": "149c30d8-7a28-364f-b4e8-9510deae7c3b",
                                "text": "Ils [ces athlètes] venaient surtout eux, au boxon, pour la rigolade. Souvent ils se battaient pour finir, énormément."
                            },
                            {
                                "example_id": "2e6c942a-2d7a-4d88-9e79-ef1b4eaf742d",
                                "sense_id": "149c30d8-7a28-364f-b4e8-9510deae7c3b",
                                "text": "— T’as jamais été au boxon, j’suis sûr, même pour boire un coup ?"
                            },
                            {
                                "example_id": "06c5e411-c300-48e0-962a-266b2e71101f",
                                "sense_id": "149c30d8-7a28-364f-b4e8-9510deae7c3b",
                                "text": "Tu vas quitter ta bonne mère\nPour t’en aller dans un boxon.\nJe ne te retiens pas, ma chère,\nSi c’est là ta vocation."
                            },
                            {
                                "example_id": "75e27ce8-5551-4678-b136-cbd377125716",
                                "sense_id": "149c30d8-7a28-364f-b4e8-9510deae7c3b",
                                "text": "– Pas tout à fait au boxon, mon père, au club… Disons qu’il s’agit d’un club, normalement réservé aux officiers, mais où ils acceptent une ou deux dames en soirée, à condition qu’elles ne soient pas trop farouches… En tout cas, c’est pas un endroit pour un curé…"
                            }
                        ]
                    },
                    {
                        "sense_id": "562e7a1e-372b-3ce7-96b5-0e817d333654",
                        "entry_id": "9baeb42c-dad6-3053-a052-495e1af06783",
                        "glosses": [
                            "Situation chaotique, grand désordre, bordel, pagaille."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7b9744be-5502-4696-8362-06ab9ee36f16",
                                "sense_id": "562e7a1e-372b-3ce7-96b5-0e817d333654",
                                "text": "On a beaucoup entendu parler du conseil de guerre, surtout en 17, quand Pétain est revenu mettre un peu d’ordre dans le boxon."
                            },
                            {
                                "example_id": "105475e7-232b-49bb-bb82-cb9cae0b84d2",
                                "sense_id": "562e7a1e-372b-3ce7-96b5-0e817d333654",
                                "text": "Pour une fois que c'est vraiment le boxon, qu'on n'a plus de flics dans les pattes, qu'on peut profiter de la liberté, la vraie, tu veux qu'on crève."
                            },
                            {
                                "example_id": "cfb59461-7cfd-4443-9a26-18b5ffd57d1e",
                                "sense_id": "562e7a1e-372b-3ce7-96b5-0e817d333654",
                                "text": "Y a tellement de boxon dans ta chambre qu’on ne retrouve plus rien."
                            },
                            {
                                "example_id": "3bd9b3bd-f9d6-45ce-b69f-08950221440d",
                                "sense_id": "562e7a1e-372b-3ce7-96b5-0e817d333654",
                                "text": "Bruxelles était une étuve, un dépotoir, un boxon grandiose."
                            }
                        ]
                    }
                ],
