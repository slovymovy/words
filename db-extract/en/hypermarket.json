                        "glosses": [
                            "A shop combining elements of a department store and a supermarket."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ae38b44-651c-4bd3-8b7c-7eac472c8ec4",
                                "sense_id": "994ca482-f971-3bab-8578-c8a731f07e2e",
                                "text": "Cherry Jones as Nan Pierce (2023), 42:37 from the start, in Succession, season 2, episode 8: “I got a taste for hypermarché vin ordinaire when I was 19 years old and I have never been able to shake it.”"
                            }
                        ]
