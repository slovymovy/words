                "senses": [
                    {
                        "sense_id": "975998e4-9eda-3c38-950d-5fe421f4d8de",
                        "entry_id": "2e8d0da2-7246-3848-af9a-4a81696b2065",
                        "glosses": [
                            "erneute Durchführung einer durchgeführten Überprüfung (Probe), aber dieses Mal mit einer entgegengesetzten Fragestellung, um sich so das Ergebnis von zwei Seiten her bestätigen zu lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbc029b9-597b-44c3-94e1-84cf658734a5",
                                "sense_id": "975998e4-9eda-3c38-950d-5fe421f4d8de",
                                "text": "„Beide markierten die infrage kommenden Angebote mit einem Stift und tauschten danach zur Gegenprobe die Zeitschriften gegeneinander aus.“"
                            },
                            {
                                "example_id": "49e7b057-ea6a-4a6e-ba7a-e5eb31528ea0",
                                "sense_id": "975998e4-9eda-3c38-950d-5fe421f4d8de",
                                "text": "„Nun zur Gegenprobe, die unseren Beweisgang endgültig absichern kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "18ededae-d22e-3bfa-8bfc-4894b2a09f5c",
                        "entry_id": "2e8d0da2-7246-3848-af9a-4a81696b2065",
                        "glosses": [
                            "zweites Durchzählen der Stimmen, diesmal für die andere Position"
                        ],
                        "tags": [
                            "Abstimmung per Handzeichen"
                        ],
                        "examples": [
                            {
                                "example_id": "1954d930-92c9-4e10-a752-f93659cc0ce7",
                                "sense_id": "18ededae-d22e-3bfa-8bfc-4894b2a09f5c",
                                "text": "7 dafür. Machen wir die Gegenprobe: Wer ist dagegen? 3 dagegen. Das passt, wir sind ja 10. Keine Enthaltungen."
                            }
                        ],
