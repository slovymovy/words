                        "sense_id": "340ca4fa-75a8-3e4e-b594-f52b9957a11a",
                        "entry_id": "9e9844eb-4189-3b4c-9d7c-dab036f4b169",
                        "glosses": [
                            "To surpass in telling tales of nights one has experienced."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5d5a0cd4-f92d-4682-bb2a-0f54614f56f9",
                                "sense_id": "340ca4fa-75a8-3e4e-b594-f52b9957a11a",
                                "text": "I would outnight you, did nobody come:\nBut hark, I hear the footing of a man."
                            },
                            {
                                "example_id": "969ae509-6268-41f3-b1d4-59d5f8dd5db2",
                                "sense_id": "340ca4fa-75a8-3e4e-b594-f52b9957a11a",
                                "text": "The Peinti could outnight the heartiest of London's \"Bright Young People.\""
                            },
                            {
                                "example_id": "491c6cb4-07c7-4cd9-ab22-5c90733d5403",
                                "sense_id": "340ca4fa-75a8-3e4e-b594-f52b9957a11a",
                                "text": "\"In such a night–\" she laid the book aside,\nShe could outnight the poet by thinking back.\nIn such a night she came here as a bride."
                            }
                        ]
                    }
                ],
