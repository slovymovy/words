                        ],
                        "form": "die Stimmbänder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "be5d81a7-9b34-3428-be78-744924e5d85d",
                        "entry_id": "09ecac93-e7bd-33fa-a882-72370b01910d",
                        "glosses": [
                            "paarweise angeordnetes elastisches Band im Kehlkopf, das maßgeblich für die Erzeugung der Schallwellen beim Sprechen und Singen zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55347325-9e5d-4d0e-a1c9-a2ccb58e9c93",
                                "sense_id": "be5d81a7-9b34-3428-be78-744924e5d85d",
                                "text": "Im Winter habe ich meine Stimme ganz verloren, als eine Erkältung mir auf die Stimmbänder schlug."
                            },
                            {
                                "example_id": "823d7d70-a4b4-4c69-a56a-4e64854ae66a",
                                "sense_id": "be5d81a7-9b34-3428-be78-744924e5d85d",
                                "text": "Der Musikmediziner Wolfgang Angerstei: „[…] Ich sehe, medizinisch betrachtet, das Problem also weniger bei der zunehmenden Lautstärke, sondern darin, dass der Kammerton A immer höher gestimmt wird und dadurch die Stimmbänder und Stimmlippen viel zu sehr beansprucht werden.“"
                            },
                            {
                                "example_id": "ad71eea6-c13d-4251-aa94-c00eef898207",
                                "sense_id": "be5d81a7-9b34-3428-be78-744924e5d85d",
                                "text": "Das Sprechen fällt schwer, wenn jemand entzündete Stimmbänder hat."
                            },
                            {
                                "example_id": "e94641df-940a-4ab5-9eee-067efff544d8",
                                "sense_id": "be5d81a7-9b34-3428-be78-744924e5d85d",
                                "text": "Ob Probleme beim Spracherwerb, Schwierigkeiten bei der Artikulation oder überanstrengte Stimmbänder – in einer Praxis für Atem-, Sprech- und Stimmtherapie wird professionelle Hilfe angeboten – und zunehmend angenommen."
                            },
                            {
                                "example_id": "773ddf20-2a20-4311-be75-7a70e231a460",
                                "sense_id": "be5d81a7-9b34-3428-be78-744924e5d85d",
                                "text": "„Die Krankheit hat auf die Stimmbänder übergegriffen, und Klabund kann ihren Worten nur mit Kopfnicken und Kopfschütteln folgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8356f3a-d966-4f0f-9718-3d84ff99adb8",
                        "source_entry_id": "09ecac93-e7bd-33fa-a882-72370b01910d",
                        "source_sense_id": "be5d81a7-9b34-3428-be78-744924e5d85d",
                        "target_lang_word": "vocal cord",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vocal cord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d813464-86b8-3fe1-906b-cb2e4c08a41f",
                                        "entry_id": "7867edd8-bc37-3f0c-916c-2bcc70c6a2d4",
                                        "glosses": [
                                            "Either of two pairs of folds of mucous membrane stretched horizontally across the human larynx whose vibrations help to produce the voice."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a997657b-1e43-4cae-92c9-1bbac43e9851",
                        "source_entry_id": "09ecac93-e7bd-33fa-a882-72370b01910d",
                        "source_sense_id": "be5d81a7-9b34-3428-be78-744924e5d85d",
                        "target_lang_word": "corde vocale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corde vocale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ac5b984-6590-37df-96bd-01f7e5622caa",
                                        "entry_id": "ac744812-2521-32c4-b49f-3bda7b6b56fa",
                                        "glosses": [
                                            "Organe de la voix, replis des membranes muqueuses du larynx dont la vibration produit les sons vocaux : cri, langage, chant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "233643fc-38bf-472b-aaf7-a1bda58533f7",
                                                "sense_id": "9ac5b984-6590-37df-96bd-01f7e5622caa",
                                                "text": "Les cordes vocales sont tendues de l’angle rentrant du cartilage thyroïde à l’apophyse vocal des cartilages aryténoïdes."
                                            },
                                            {
                                                "example_id": "5e3afe88-83ad-4be6-af31-c836fb649540",
                                                "sense_id": "9ac5b984-6590-37df-96bd-01f7e5622caa",
                                                "text": "Appelée aussi le coup de fouet laryngien, c’est la fameuse voix cassée, qui se traduit par un hématome sur une corde vocale dû à l’éclatement d’un vaisseau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
