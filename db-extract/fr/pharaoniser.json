                "senses": [
                    {
                        "sense_id": "343bc6b6-9cb9-3cb2-be75-25eb474d2d22",
                        "entry_id": "4cef85f1-ea97-306d-870a-f9f04b897608",
                        "glosses": [
                            "Donner un caractère pharaonique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1089e98e-1156-4a1c-b2c9-825ee7d3ef53",
                                "sense_id": "343bc6b6-9cb9-3cb2-be75-25eb474d2d22",
                                "text": "C’est la faillite de la vertu parce qu’on a fini par la médiocriser, la pharaoniser."
                            },
                            {
                                "example_id": "53a95176-5fab-4178-875f-83cb73849119",
                                "sense_id": "343bc6b6-9cb9-3cb2-be75-25eb474d2d22",
                                "text": "Notre “héros” ainsi carapace et réconforté se mit désormais à se “pharaoniser” donc à rivaliser puis à suppléer Dieu."
                            },
                            {
                                "example_id": "56fc37e7-0ecc-4f3e-addc-ab88235b3809",
                                "sense_id": "343bc6b6-9cb9-3cb2-be75-25eb474d2d22",
                                "text": "La Côte d'Ivoire tout entière peut même déménager en Egypte à défaut de se pharaoniser, un fort n'est pas un faible."
                            }
                        ]
                    }
