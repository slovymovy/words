                ],
                "senses": [
                    {
                        "sense_id": "4e731c3d-62b1-3099-a858-3278218df4ee",
                        "entry_id": "78001697-4a88-35c5-941f-ff4d3d03f3bf",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0657c669-81e0-4fbf-963c-19b7495b563d",
                                "sense_id": "4e731c3d-62b1-3099-a858-3278218df4ee",
                                "text": "Frau Boas ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "90d500db-fc4a-4959-9f8e-a1317c3b82e9",
                                "sense_id": "4e731c3d-62b1-3099-a858-3278218df4ee",
                                "text": "Herr Boas wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c1c1ec09-a3a7-4db4-91b2-5724397ed1cd",
                                "sense_id": "4e731c3d-62b1-3099-a858-3278218df4ee",
                                "text": "Die Boasens fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "d30fa1c9-411e-472b-bd7b-f3bb961344d4",
                                "sense_id": "4e731c3d-62b1-3099-a858-3278218df4ee",
                                "text": "Der Boas trägt nie die Pullover, die die Boas ihm strickt."
                            },
                            {
                                "example_id": "3f09f15b-6eae-470f-9148-0fe27159d174",
                                "sense_id": "4e731c3d-62b1-3099-a858-3278218df4ee",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Boas kommt, geht der Herr Boas.“"
                            },
                            {
                                "example_id": "dd7ec757-a42b-4803-83ee-22b4047ce65f",
                                "sense_id": "4e731c3d-62b1-3099-a858-3278218df4ee",
                                "text": "Boas kommt und geht."
                            },
                            {
                                "example_id": "9d7ae020-000c-4eb8-9c66-2abc011b61a7",
                                "sense_id": "4e731c3d-62b1-3099-a858-3278218df4ee",
                                "text": "Boas’ kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
