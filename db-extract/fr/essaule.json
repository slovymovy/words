                        ],
                        "examples": [
                            {
                                "example_id": "bade2338-16d3-4ac1-83ec-73a841e0b120",
                                "sense_id": "0386440c-feb2-335d-9b64-d1f47bfc61c7",
                                "text": "La construction médiévale employait beaucoup de bois ou \"merrien à maisonner\" : du gros merrien, des solives, des chevrons et des lattes pour les charpentes, désigné aussi sous le nom de \"merrien a ligne\", des gouttières ainsi que de l’essaule pour la couverture."
                            },
                            {
