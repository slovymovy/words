                        "sense_id": "edf72f88-d4e2-351f-997e-a86c0bb47047",
                        "entry_id": "8d25280b-7604-3e2a-a291-dcac8a90c805",
                        "glosses": [
                            "plaat aan de onderkant van een apparaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19655502-1648-498c-a567-561fbf4e43ff",
                                "sense_id": "edf72f88-d4e2-351f-997e-a86c0bb47047",
                                "text": "Vijftig meter verderop heeft monteur Daniel Abert een zogenoemd exoskelet aangetrokken. Het is een soort rugzakje met beugels op de bovenarmen. Een ingenieus systeem ondersteunt de armen waardoor boven je hoofd werken veel lichter wordt. Heel fijn, vertelt de monteur, bij het aanbrengen van bodemplaten onder een auto."
                            },
                            {
                                "example_id": "829d3a8d-760b-49c4-9ead-e306aa43eb36",
                                "sense_id": "edf72f88-d4e2-351f-997e-a86c0bb47047",
                                "text": "De hogesnelheidstreinen werden in januari al na een maand uit de dienstregeling genomen, nadat een bodemplaat van een van de Fyra's was gevallen. Ook kampten de treinstellen met storingen waardoor ze vaak stil kwamen te staan of helemaal uitvielen."
                            }
                        ]
                    }
