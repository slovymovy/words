                "senses": [
                    {
                        "sense_id": "60a3730c-fba2-3d14-8f12-ff55ccb1ab1b",
                        "entry_id": "c8546f2c-1ca2-335f-bb51-32cc7d901d4f",
                        "glosses": [
                            "door levenservaring wijs, ervaren geworden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1da68218-b922-4c84-84ea-c1e6968afcbd",
                                "sense_id": "60a3730c-fba2-3d14-8f12-ff55ccb1ab1b",
                                "text": "Toen ik Acke daar neerplantte, verklaarde ik wereldwijs dat ik al die oude films al duizenden keren had gezien toen ik klein was."
                            },
                            {
                                "example_id": "0cfbf4e5-d02b-4a2c-b5fa-9e7bc3816944",
                                "sense_id": "60a3730c-fba2-3d14-8f12-ff55ccb1ab1b",
                                "text": "Oom Carl Lauritz gedroeg zich als de nogal nonchalante wereldwijze gastheer die hij was en bood de nieuw gearriveerden champagne aan, ook deze keer in de kunstzinnig ingewikkelde glazen waar je bijna onmogelijk uit kon drinken zonder te morsen."
                            }
                        ]
                    }
