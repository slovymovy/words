                "forms": [
                    {
                        "form_id": "b949eb7f-eb4e-4273-808b-686604c68574",
                        "entry_id": "6a75e078-25ef-3b6e-bb9a-db3f81def288",
                        "tags": [
                            "plural"
                        ],
                        "form": "effeuillements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "864084f6-8df0-35ea-b83d-29675973f65a",
                        "entry_id": "6a75e078-25ef-3b6e-bb9a-db3f81def288",
                        "glosses": [
                            "État des arbres dépouillés de leur feuillage ou qui s’en dépouillent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b30d5550-cfa8-408d-8e7a-67b558337b8d",
                                "sense_id": "864084f6-8df0-35ea-b83d-29675973f65a",
                                "text": "Dans cette même région, venait d’éclore une peuplade éphémère de toutes petites phalènes noires et roses (du même rose que les amourettes) qui dormaient posées partout sur les longues tiges des herbes, et qui s’envolaient comme un effeuillement de pétales de fleurs, dès qu’on agitait ces foins."
                            },
                            {
                                "example_id": "2bfc0c8d-f218-495c-a1f8-2f337d368211",
                                "sense_id": "864084f6-8df0-35ea-b83d-29675973f65a",
                                "text": "La campagne apparaissait meurtrie sous l’effeuillement prématuré des haies et des arbres."
                            },
                            {
                                "example_id": "5da0d7e6-4055-4984-ab72-48bd9f9e8dd4",
                                "sense_id": "864084f6-8df0-35ea-b83d-29675973f65a",
                                "text": "Le vent dans l’effeuillement des arbres, la lueur du ciel entre les nuées, les pluies des plaines et l’amnésie des morts."
                            }
                        ]
                    },
                    {
                        "sense_id": "91963f6d-131a-3294-a5f7-b36559ed765d",
                        "entry_id": "6a75e078-25ef-3b6e-bb9a-db3f81def288",
                        "glosses": [
                            "Disparition progressive."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f6fbd47b-0df9-4bf9-b87a-0f769f09cf44",
                                "sense_id": "91963f6d-131a-3294-a5f7-b36559ed765d",
                                "text": "Tout cela me faisait mal, affreusement, me donnait la conception de la fin languissante des existences et des choses, de l’immense effeuillement de tout…"
                            }
                        ]
                    }
                ],
