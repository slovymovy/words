                                "target_senses": [
                                    {
                                        "sense_id": "ea550aec-60bc-3232-9b2f-4a594dddac76",
                                        "entry_id": "12858cae-3ef1-3473-b7de-703a944e4a17",
                                        "glosses": [
                                            "A region where war is ongoing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d172a5a4-3eb7-4c98-97c0-422d0097b8e3",
                                                "sense_id": "ea550aec-60bc-3232-9b2f-4a594dddac76",
                                                "text": "He also thought nothing of laying down a railway in a war zone. For example, he was one of those behind the Grand Crimean Central Railway, built during the Crimean War [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79052172-88b0-35bb-ac52-588b4d87edcf",
