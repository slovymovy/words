                "senses": [
                    {
                        "sense_id": "c6dc3897-55f1-3e15-8f76-e23ca6c69f8c",
                        "entry_id": "68391cef-d17c-3195-9652-2c5348af48be",
                        "glosses": [
                            "Zustand, sich nicht entscheiden, entschließen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33276271-119c-4079-96de-2c2c81c65d28",
                                "sense_id": "c6dc3897-55f1-3e15-8f76-e23ca6c69f8c",
                                "text": "„Eigene Unentschiedenheit spürt sie als Kribbeln in der Kopfhaut und als die Einbildung, sie habe Grannen im Haar.“"
                            },
                            {
                                "example_id": "0f28a716-fa0b-4d4b-bf32-ef88090b0c16",
                                "sense_id": "c6dc3897-55f1-3e15-8f76-e23ca6c69f8c",
                                "text": "„Eine Unentschiedenheit in den höchsten Lebensfragen, ein Zweifel an den tiefsten Wahrheiten der Religion hat sich sehr vieler Menschen bemächtigt.“"
                            },
                            {
                                "example_id": "323b664d-7741-4fe2-9464-19a2f1c873c3",
                                "sense_id": "c6dc3897-55f1-3e15-8f76-e23ca6c69f8c",
                                "text": "„Die Gewissheit ist das Zeugniss der Wahrheit; die Ungewissheit, der Zweifel, ist die Unentschiedenheit über die Wahrheit und Wirklichkeit des Erkannten.“"
                            },
                            {
                                "example_id": "0a5b163f-6a27-427d-bb41-d1637ceb6661",
                                "sense_id": "c6dc3897-55f1-3e15-8f76-e23ca6c69f8c",
                                "text": "„Die innere Unentschiedenheit stellt sich äusserlich dar als ein Schweben zwischen Himmel und Hölle als ein Ausgeschlossensein aus beiden Orten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
