                        ],
                        "examples": [
                            {
                                "example_id": "ea75bbad-de75-4bf2-9652-4426413f8725",
                                "sense_id": "10c595c2-8d94-38ac-90fa-59e4d2c32fc6",
                                "text": "En proche périphérie du lilliputien village de pêcheurs de la Isleta del Moro, en plus de proposer des hébergements ruraux très plaisants, un petit peu de restauration sympatoche sur sa terrasse et des ateliers intéressants […]"
                            },
                            {
                                "example_id": "5956b975-b2d5-4ae6-b34d-db89f5ba9dc2",
                                "sense_id": "10c595c2-8d94-38ac-90fa-59e4d2c32fc6",
                                "text": "O.K., elle ne respire pas l'intelligence, et son sex-appeal laisse peut-être à désirer. Mais une brave fille sympatoche comme ça, qui ne vous contredit pas et ne vous coûte pas bonbon en sacs Vuitton, ça ne vous dit pas ?"
                            }
                        ]
                    }
