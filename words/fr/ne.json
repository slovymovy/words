            "senses": [
                {
                    "sense_id": "6a0685fc-0826-3124-ad64-3a8b2a54aca8",
                    "sense_definition": "Premier élément de la négation placé avant le verbe, généralement complété par un second mot négatif tel que « pas », « plus », « jamais » ou « rien ».",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "negation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>ne</w> veux pas sortir ce soir parce qu'il fait trop froid."
                        },
                        {
                            "text": "Il <w>n'</w>a jamais voyagé seul en dehors de son pays d'origine."
                        }
                    ],
                    "common_phrases": [
                        "ne pas",
                        "ne plus",
                        "ne jamais",
                        "ne rien"
                    ]
                },
                {
                    "sense_id": "f4622db8-1d9e-349d-bcd1-b28933c10e24",
                    "sense_definition": "Exprime seul la négation dans la langue soutenue, particulièrement avec des verbes comme cesser, oser, pouvoir ou savoir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "negation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent <w>ne</w> cesse de souffler avec force sur la falaise."
                        },
                        {
                            "text": "Je <w>ne</w> saurais vous répondre avec certitude sur ce sujet complexe."
                        }
                    ],
                    "common_phrases": [
                        "ne cesser de",
                        "ne savoir que faire"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre soutenu ou littéraire"
                        }
                    ]
                },
                {
                    "sense_id": "82deec80-8867-33c8-8774-1fdc26ab4e99",
                    "sense_definition": "Particule explétive employée sans valeur négative dans certaines subordonnées, notamment après des verbes de crainte, des comparatifs ou des conjonctions de temps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "expletif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dépêchons-nous de rentrer avant que la pluie <w>ne</w> se mette à tomber."
                        },
                        {
                            "text": "Le problème était bien plus grave que nous <w>ne</w> le pensions."
                        }
                    ],
                    "common_phrases": [
                        "avant que ne",
                        "de peur que ne"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "langue soignée ou soutenue"
                        }
                    ]
                }
            ]
        },
