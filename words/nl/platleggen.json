                    "frequency": "Low",
                    "semantic_group_id": "buiten werking stellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overheid heeft besloten om de verouderde mijnen in deze regio definitief <w>plat</w> te <w>leggen</w>.",
                            "target_lang_translations": {
                                "en": "The government has decided to <w>close down</w> the outdated mines in this region for good.",
                                "ru": "Правительство решило окончательно <w>закрыть</w> устаревшие шахты в этом регионе."
                            }
                        },
                        {
                            "text": "Het plan is om de illegale handel volledig <w>plat</w> te <w>leggen</w> door strengere controles.",
                            "target_lang_translations": {
                                "en": "The plan is to completely <w>dismantle</w> the illegal trade through stricter controls.",
                                "ru": "План состоит в том, чтобы полностью <w>ликвидировать</w> нелегальную торговлю с помощью более строгого контроля."
                            }
                        }
                    ],
                    "common_phrases": [
