                    {
                        "form_id": "506e6bfe-bbc1-49d8-b903-b97e791fbfa8",
                        "entry_id": "b457a58b-0c78-357f-9740-f6df98513d03",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "чи́рьях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4c8bee7-4ae5-39ad-baf3-e45ade353c72",
                        "entry_id": "b457a58b-0c78-357f-9740-f6df98513d03",
                        "glosses": [
                            "разг. гнойный нарыв, фурункул"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fff88a79-1c69-49a2-945f-fba91e8f02fb",
                                "sense_id": "c4c8bee7-4ae5-39ad-baf3-e45ade353c72",
                                "text": "Но содрогнись на беснующегося, вострепещи, взирая на имеющего в мозгу чирей!"
                            },
                            {
                                "example_id": "e639da3f-a4c3-4072-9a20-783d1a0ed84d",
                                "sense_id": "c4c8bee7-4ae5-39ad-baf3-e45ade353c72",
                                "text": "На мне грязное, рваное бельё, я давно не был в бане, на теле моём чирьи от неопрятности."
                            },
                            {
                                "example_id": "71e979f0-8130-476a-9266-dcc38220166b",
                                "sense_id": "c4c8bee7-4ae5-39ad-baf3-e45ade353c72",
                                "text": "Насытив дровами «буржуйку», измотанные, все в чирьях, фронтовики, засыпали, возможно, перед самым последним днём своей копеечной жизни."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f1decb6-adf2-4f51-8c23-722a1dac49e9",
                        "source_entry_id": "b457a58b-0c78-357f-9740-f6df98513d03",
                        "source_sense_id": "c4c8bee7-4ae5-39ad-baf3-e45ade353c72",
                        "target_lang_word": "boil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2bdd84a-304d-3e14-9cfd-ab7f37531ee1",
                                        "entry_id": "7e540ef4-611e-30bb-8d86-9fa508c3552a",
                                        "glosses": [
                                            "A localized accumulation of pus in the skin, resulting from infection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "boil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f148189-dd2a-37e5-b22d-a9508328cc03",
                                        "entry_id": "e851f7a8-8897-3888-9368-a82f9b5932be",
                                        "glosses": [
                                            "The point at which fluid begins to change to a vapour; the boiling point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c4c012a-fa51-4abb-8b16-f95065bafc90",
                                                "sense_id": "7f148189-dd2a-37e5-b22d-a9508328cc03",
                                                "text": "Add the noodles when the water comes to the boil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "142bd8b3-5de4-36a3-8179-3fcff9e5d76c",
                                        "entry_id": "e851f7a8-8897-3888-9368-a82f9b5932be",
                                        "glosses": [
                                            "An instance of boiling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9496d526-1c40-44b0-91f1-cc251c9d1d4a",
                                                "sense_id": "142bd8b3-5de4-36a3-8179-3fcff9e5d76c",
                                                "text": "Surface water will do, but give it a good boil before drinking it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "992828c0-a69a-3d19-95e5-f4e3eacff728",
                                        "entry_id": "e851f7a8-8897-3888-9368-a82f9b5932be",
                                        "glosses": [
                                            "A dish of boiled food, especially seafood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb031eff-0ee3-4092-a826-413b55b154e9",
                                                "sense_id": "992828c0-a69a-3d19-95e5-f4e3eacff728",
                                                "text": "a down-home boil with plenty of crab"
                                            },
                                            {
                                                "example_id": "c334c6f7-c21a-46c5-bd13-70524c0b9c32",
                                                "sense_id": "992828c0-a69a-3d19-95e5-f4e3eacff728",
                                                "text": "This is Brad's classic shrimp boil—a recipe he makes for every tailgate party. Brad demands, “Don't use utensils!” INGREDIENTS: Two 6-ounce boxes Old Bay crab/shrimp boil seasoning[…]"
                                            },
                                            {
                                                "example_id": "0efcbb8d-3750-4458-b3c4-bc3e242e4136",
                                                "sense_id": "992828c0-a69a-3d19-95e5-f4e3eacff728",
                                                "text": "CRAWFISH BOIL EN GELÉE (TERRINE OF CRAWFISH) […] For a typical Louisiana shrimp boil, use the recipe for Crawfish Boil (page 28), substituting shrimp for the crawfish […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcd86c88-aea7-3ab6-97c0-6d6c9e02bd71",
                                        "entry_id": "e851f7a8-8897-3888-9368-a82f9b5932be",
                                        "glosses": [
                                            "A social event at which people gather to boil and eat food, especially seafood. (Compare a bake or clambake.)"
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abcf165d-b3b7-4e33-8d96-407521e6f172",
                                                "sense_id": "fcd86c88-aea7-3ab6-97c0-6d6c9e02bd71",
                                                "text": "a down-home boil at the town hall"
                                            },
                                            {
                                                "example_id": "b49e5cc7-50e9-4c89-8fab-86a0796fbd73",
                                                "sense_id": "fcd86c88-aea7-3ab6-97c0-6d6c9e02bd71",
                                                "text": "Men and boys also learn to cook at the public and semipublic food events at which men are the primary cooks. These include crawfish and seafood boils, family boucheries, and community festivals. For example, at one crab boil I attended, a grandfather and his eight-year-old grandson cooked the second batch of crabs […]. The advent of crawfish farming has expanded the availability of live crawfish beyond the old seasonal limits just described, but few Cajuns in St. Martin Parish have crawfish boils, or eat crawfish in any form, out of season."
                                            },
                                            {
                                                "example_id": "1bca9728-a31f-4f69-b19f-cf6779f4d56f",
                                                "sense_id": "fcd86c88-aea7-3ab6-97c0-6d6c9e02bd71",
                                                "text": "The whole live crawfish typically are consumed at home and at crawfish boils and other social events where the crawfish is boiled[…]"
                                            },
                                            {
                                                "example_id": "b33ed4f8-7e18-4284-960e-982cc151d54a",
                                                "sense_id": "fcd86c88-aea7-3ab6-97c0-6d6c9e02bd71",
                                                "text": "I met him and his wife, Diane, at a shrimp boil I'd been invited to by another ex-trawler named Lindel."
                                            },
                                            {
                                                "example_id": "2f11c4cf-3ec1-4304-96e9-46f089470f9d",
                                                "sense_id": "fcd86c88-aea7-3ab6-97c0-6d6c9e02bd71",
                                                "text": "I also felt the desire to be in a more intimate, familiar setting where we could choose whether or not to talk about our memories of 2005; I ended up spending the evening at a shrimp boil hosted by good friends."
                                            },
                                            {
                                                "example_id": "7db51129-21f7-4f81-8c1b-61d995f5381f",
                                                "sense_id": "fcd86c88-aea7-3ab6-97c0-6d6c9e02bd71",
                                                "text": "When Mondale had run for president two summers before, for some reason he opened his campaign in Beaufort, at a shrimp boil in our new waterfront park."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ce21734-d7f1-3e66-af90-b201f453df56",
                                        "entry_id": "e851f7a8-8897-3888-9368-a82f9b5932be",
                                        "glosses": [
                                            "The collective noun for a group of hawks."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6690d58d-47c7-3003-b864-32d24f89a236",
                                        "entry_id": "e851f7a8-8897-3888-9368-a82f9b5932be",
                                        "glosses": [
                                            "A bubbling."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fffe65a-9e71-4337-af04-3e963aaf37f8",
                                                "sense_id": "6690d58d-47c7-3003-b864-32d24f89a236",
                                                "text": "He swam to the place where Mary disappeared but there was neither boil nor gurgle on the water, nor even a bell of departing breath, to mark the place where his beloved had sunk."
                                            },
                                            {
                                                "example_id": "6f535dfa-9486-46e6-b82a-c15074b2ea30",
                                                "sense_id": "6690d58d-47c7-3003-b864-32d24f89a236",
                                                "text": "The sea round them clouded and darkened, and then frizzed up in showers of tiny silver fish, and over a space of five or six acres the cod began to leap like trout in May; while behind the cod three or four broad gray-backs broke the water into boils."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01b15c26-b95e-3cbd-9ec3-c20a9cca3724",
                                        "entry_id": "337644a8-0f21-3217-b729-30c9781d5a4d",
                                        "glosses": [
                                            "To heat to the point where it begins to turn into a gas."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b847d708-65bd-4624-a522-21b0ada4d279",
                                                "sense_id": "01b15c26-b95e-3cbd-9ec3-c20a9cca3724",
                                                "text": "Boil some water in a pan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3651a3f-17a1-34dc-8796-aca030af73c0",
                                        "entry_id": "337644a8-0f21-3217-b729-30c9781d5a4d",
                                        "glosses": [
                                            "To cook in boiling water."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7afff45b-fe92-42e7-8118-57b15bdb34b4",
                                                "sense_id": "a3651a3f-17a1-34dc-8796-aca030af73c0",
                                                "text": "Boil the eggs for three minutes."
                                            },
                                            {
                                                "example_id": "32d4ed7e-8594-4274-999a-afa43fe12c81",
                                                "sense_id": "a3651a3f-17a1-34dc-8796-aca030af73c0",
                                                "text": "Is the rice boiling yet?"
                                            },
                                            {
                                                "example_id": "0512c68a-a690-4c50-992e-3696c878fc1e",
                                                "sense_id": "a3651a3f-17a1-34dc-8796-aca030af73c0",
                                                "text": "Toad, that vnder cold ſtone, / Dayes and Nights ha's thirty one: / Sweltred Venom ſleeping got, / Boyle thou firſt i'th'charmed pot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b244977-81ea-3c2e-91b5-ebd99bd32bf4",
                                        "entry_id": "337644a8-0f21-3217-b729-30c9781d5a4d",
                                        "glosses": [
                                            "To begin to turn into a gas, seethe."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9f251bb-dcad-42d7-915a-ed92c9d39cb6",
                                                "sense_id": "1b244977-81ea-3c2e-91b5-ebd99bd32bf4",
                                                "text": "Pure water boils at 100 degrees Celsius."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f09c986-394e-3bbc-9983-b5fa22cd875a",
                                        "entry_id": "337644a8-0f21-3217-b729-30c9781d5a4d",
                                        "glosses": [
                                            "To bring to a boil, to heat so as to cause the contents to boil."
                                        ],
                                        "tags": [
                                            "UK",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e555a96-9a35-49f9-b4ac-9dc513877477",
                                                "sense_id": "2f09c986-394e-3bbc-9983-b5fa22cd875a",
                                                "text": "'I'll boil the kettle,' he said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "686e50fb-444b-3d07-8608-0054abd2f94e",
                                        "entry_id": "337644a8-0f21-3217-b729-30c9781d5a4d",
                                        "glosses": [
                                            "To be uncomfortably hot."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98c32459-a55e-4ac6-8b0c-472317561a05",
                                                "sense_id": "686e50fb-444b-3d07-8608-0054abd2f94e",
                                                "text": "It’s boiling outside!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23d751f4-8311-3be5-8e7b-45f848b34145",
                                        "entry_id": "337644a8-0f21-3217-b729-30c9781d5a4d",
                                        "glosses": [
                                            "To feel uncomfortably hot."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5a7fbc2-072f-4e31-92e9-29b1cc2c0f40",
                                                "sense_id": "23d751f4-8311-3be5-8e7b-45f848b34145",
                                                "text": "I’m boiling in here – could you open the window?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21da6394-5ceb-30bf-8a57-c59d2956c497",
                                        "entry_id": "337644a8-0f21-3217-b729-30c9781d5a4d",
                                        "glosses": [
                                            "To form, or separate, by boiling or evaporation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f2c0ea4-9247-4ddd-bc8c-3946dbff413c",
                                                "sense_id": "21da6394-5ceb-30bf-8a57-c59d2956c497",
                                                "text": "to boil sugar or salt"
                                            },
                                            {
                                                "example_id": "cb156655-b3b6-47ed-8f9d-65d9ad5462b3",
                                                "sense_id": "21da6394-5ceb-30bf-8a57-c59d2956c497",
                                                "text": "Another leader in the packaged product business was the Procter & Gamble Company, formed in Cincinnati in 1837 by William Procter, who molded candles, and his brother-in-law, James Gamble, who boiled soap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "654cbbaf-9234-34d4-b6b1-3a8a36a4c6e8",
                                        "entry_id": "337644a8-0f21-3217-b729-30c9781d5a4d",
                                        "glosses": [
                                            "To steep or soak in warm water."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43303ca2-4ce7-4434-9124-592d5db7d4ae",
                                                "sense_id": "654cbbaf-9234-34d4-b6b1-3a8a36a4c6e8",
                                                "text": "To try whether seeds be old or new, the sense cannot inform; but if you boil them in water, the new seeds will sprout sooner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bce51892-da13-33ee-bcd6-524e1e1a231a",
                                        "entry_id": "337644a8-0f21-3217-b729-30c9781d5a4d",
                                        "glosses": [
                                            "To be agitated like boiling water; to bubble; to effervesce."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8175235-302e-4bac-b507-12eca64e7a14",
                                                "sense_id": "bce51892-da13-33ee-bcd6-524e1e1a231a",
                                                "text": "the boiling waves of the sea"
                                            },
                                            {
                                                "example_id": "7b47939c-5dec-4fca-8c31-7d2eb3a91c28",
                                                "sense_id": "bce51892-da13-33ee-bcd6-524e1e1a231a",
                                                "text": "He maketh the deep to boil like a pot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbe047c8-bade-3843-8c7c-c443e7355443",
                                        "entry_id": "337644a8-0f21-3217-b729-30c9781d5a4d",
                                        "glosses": [
                                            "To be moved or excited with passion; to be hot or fervid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "213cffdf-4747-4db4-9fe3-519fc8e00afd",
                                                "sense_id": "bbe047c8-bade-3843-8c7c-c443e7355443",
                                                "text": "His blood boils with anger."
                                            },
                                            {
                                                "example_id": "0a51b4c5-057f-44a5-b834-424fd9713502",
                                                "sense_id": "bbe047c8-bade-3843-8c7c-c443e7355443",
                                                "text": "Then boyld my breſt with flame and burning wrath, / To reuenge my town vnto ſuch ruine brought."
                                            },
                                            {
                                                "example_id": "6b7a2184-8cbf-4746-85ef-a234c1bbd7b4",
                                                "sense_id": "bbe047c8-bade-3843-8c7c-c443e7355443",
                                                "text": "The city boiled with money. Rents and property values had never been higher, and in the garment industry it was widely held that fashion had never been so fashionable. New restaurants opened every hour."
                                            }
                                        ]
                                    }
                                ]
                            }
