                        "glosses": [
                            "Qualifie les monstres produits par la réunion de deux sujets presque complets, qui ont un ombilic commun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ef38a25-916a-4f8f-822f-ca1b025fe090",
                                "sense_id": "2c8f5c75-aa05-3eaf-93bd-ba381da5cecf",
                                "text": "Voici maintenant les conditions que nous observons chez les monstres monomphaliens, pour un plus ou moins grand nombre d’organes médians, toujours appartenant à la région antérieure."
                            }
                        ]
                    }
