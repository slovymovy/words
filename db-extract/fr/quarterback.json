                                        "entry_id": "548af22c-d877-39de-9322-32e5e184e979",
                                        "glosses": [
                                            "An offensive back whose primary job is to pass the ball in a play."
                                        ],
                                        "tags": [
                                            "Canadian"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90193ba7-e218-4386-bcd8-b427275e88a0",
                                                "sense_id": "71b93072-7b8a-3a69-a899-a9334fe1c1a0",
                                                "text": "Standing 6-foot-6, 237 pounds, Herbert’s size and arm strength are consistent with a prototypical N.F.L. quarterback, and he led the Ducks to a Pac-12 championship and a victory at the Rose Bowl in January with not much talent at receiver."
                                            },
                                            {
                                                "example_id": "616260b1-c924-4313-920d-1de29ab3e331",
                                                "sense_id": "71b93072-7b8a-3a69-a899-a9334fe1c1a0",
                                                "text": "Houston Texans head coach DeMeco Ryans defended Azeez Al-Shaair after the linebacker was ejected from Sunday’s game for throwing a late hit on Jacksonville Jaguars quarterback Trevor Lawrence. […] “A lot of the quarterbacks in this day and age, they try to take advantage of the rule where they slide late, and they try to get an extra yard. And now you’re a defender, a lot of onus is on the defender, right?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3acb6d6b-a454-3df3-9a96-4354ece18271",
                                        "entry_id": "548af22c-d877-39de-9322-32e5e184e979",
                                        "glosses": [
                                            "An offensive back who receives the snap (hike) and then blocks the defense from crossing the line of scrimmage; a blocking back."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
