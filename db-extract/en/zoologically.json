                                        "examples": [
                                            {
                                                "example_id": "c6e5246c-1998-4056-bc38-5cb33154a242",
                                                "sense_id": "c9e617c0-8cbf-364e-804d-cf67e15aec90",
                                                "text": "Qu'est-ce que l'âge du renne? géologiquement, c'est le quaternaire ; zoologiquement, c'est l'absence d'animaux domestiqués et l'association au renne d'animaux ou éteints ou émigrés ; archéologiquement, c'est la période de la pierre taillée"
                                            },
                                            {
                                                "example_id": "43d9f0b0-3a47-4794-a65f-80426338986f",
                                                "sense_id": "c9e617c0-8cbf-364e-804d-cf67e15aec90",
                                                "text": "Tout compte fait — et surtout pour faire cesser toute plaisanterie qui a trop longtemps duré — nos voisins n'étaient, zoologiquement parlant, ni un loup, ni un canard."
                                            }
                                        ]
                                    }
                                ]
                            }
