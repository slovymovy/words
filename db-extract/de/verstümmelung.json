                        "form": "die Verstümmelung"
                    },
                    {
                        "form_id": "85b92fef-e07e-4bc0-bc95-c55e3ab57858",
                        "entry_id": "2f97a0ce-9c25-3c22-a4e5-f1f990e90604",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Verstümmelungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c413476-e95a-3331-b9f6-e34e8f1000fa",
                        "entry_id": "2f97a0ce-9c25-3c22-a4e5-f1f990e90604",
                        "glosses": [
                            "Akt, bei dem etwas ganz wesentlich in seinem Umfang reduziert wird und dadurch an Funktionalität verliert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aac46dd-30af-4ae0-ab96-3908d58f2409",
                                "sense_id": "9c413476-e95a-3331-b9f6-e34e8f1000fa",
                                "text": "„In der Geschichte der Menschheit finden sich seit jeher Beispiele für rituelle oder kulturell bedingte Verstümmelungen des Körpers.“"
                            },
                            {
                                "example_id": "3d4ec22e-3354-4de4-afd0-4f2e8541721a",
                                "sense_id": "9c413476-e95a-3331-b9f6-e34e8f1000fa",
                                "text": "„Wer Sterilisation als Verstümmelung sieht, wird sie wenigstens noch bei geistig Behinderten, die seinem Einfluß ausgeliefert sind, nicht zulassen wollen.“"
                            },
                            {
                                "example_id": "e94abb07-7a1a-4671-89b8-422ce851b275",
                                "sense_id": "9c413476-e95a-3331-b9f6-e34e8f1000fa",
                                "text": "„Mr. Pemberton fuhr fort, dass alle drei Männer beim Umdrehen der Leiche bemerkt hätten, dass gewisse Verstümmelungen vorgenommen worden waren, es jedoch keinen Hinweis auf übermäßige Blutung gegeben habe.“"
                            },
                            {
                                "example_id": "bb744578-b7c6-431d-9dda-06b1541fab9b",
                                "sense_id": "9c413476-e95a-3331-b9f6-e34e8f1000fa",
                                "text": "„Man kann sich ein Bild davon machen im Dokumentarfilm ‚Die Reise nach Metropolis‘ von Artem Demenok, der den Weg von der Verstümmelung des Films 1927 bis zur neuen Restaurierung verfolgt, mit Hanns Zischler als Erzähler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3103917e-cb8e-3ee8-bdf0-0cd83e03855e",
                        "entry_id": "2f97a0ce-9c25-3c22-a4e5-f1f990e90604",
                        "glosses": [
                            "Ergebnis des Aktes einer radikalen Beschneidung oder Reduzierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f92050d5-7951-4c1b-bfc7-8ed9cc3238b3",
                                "sense_id": "3103917e-cb8e-3ee8-bdf0-0cd83e03855e",
                                "text": "„Briamunde nimmt ihm den Helm ab und sieht die Verstümmelung, sieht ihren Gemahl wie einen Ochsen bluten.“"
                            },
                            {
                                "example_id": "356ddd57-d230-43cd-ab06-d388902ae880",
                                "sense_id": "3103917e-cb8e-3ee8-bdf0-0cd83e03855e",
                                "text": "„Eine sofort durchgeführte Untersuchung der Leichen durch Wehrmachtsärzte in Belgrad ergab aber, daß keine Verstümmelungen an den Leichen der Wehrmachtssoldaten festzustellen waren.“"
                            },
                            {
                                "example_id": "4b3406de-e050-4a5c-8691-3b9e2c8f05c8",
                                "sense_id": "3103917e-cb8e-3ee8-bdf0-0cd83e03855e",
                                "text": "„In Bahrs Anthologie erscheint Wielands Text aufgrund dieser Verstümmelungen beinahe wie ein ungebrochen ernsthafter Versuch, die Frage, was Aufklärung sei, zu beantworten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b48b4403-f465-476a-9abc-6c8a584aebf1",
                        "source_entry_id": "2f97a0ce-9c25-3c22-a4e5-f1f990e90604",
                        "source_sense_id": "9c413476-e95a-3331-b9f6-e34e8f1000fa",
