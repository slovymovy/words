                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6d545027-c0bf-446b-a0c3-5e4727c757b6",
                        "entry_id": "acb0964d-7c9e-3aad-b225-b4340cfaba2c",
                        "tags": [
                            "plural"
                        ],
                        "form": "prospectuses"
                    },
                    {
                        "form_id": "b01a0b12-973b-4383-9b74-4f14291644fe",
                        "entry_id": "acb0964d-7c9e-3aad-b225-b4340cfaba2c",
                        "tags": [
                            "plural"
                        ],
                        "form": "prospectus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "42727c74-c8de-349d-a183-fbb79e05f5a9",
                        "entry_id": "acb0964d-7c9e-3aad-b225-b4340cfaba2c",
                        "glosses": [
                            "A document, distributed to prospective members, investors, buyers, or participants, which describes an institution (such as a university), a publication, or a business and what it has to offer."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7fd9371e-f905-3b49-966a-9f49757d695e",
                        "entry_id": "acb0964d-7c9e-3aad-b225-b4340cfaba2c",
                        "glosses": [
                            "A document which describes a proposed endeavor (venture, undertaking), such as a literary work (which one proposes to write)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7a6dce3a-3b11-3c83-b025-dd9735d58848",
                        "entry_id": "acb0964d-7c9e-3aad-b225-b4340cfaba2c",
                        "glosses": [
                            "A booklet or other document giving details of a share offer for the benefit of investors."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce880f27-7dba-4840-bcef-f21e55be1f3a",
                                "sense_id": "7a6dce3a-3b11-3c83-b025-dd9735d58848",
                                "text": "The Manchester, Buxton, Matlock & Midlands Junction Railway, which was the title of this project, issued its prospectus on May 30, 1845, and announced that \"this Company is formed to complete the communication by Railway between Lancashire and the East Districts. [...]\". The capital to be raised was £800,000."
                            },
                            {
                                "example_id": "4a4461a8-cdc9-4020-aa6a-5f80a49e3aa8",
                                "sense_id": "7a6dce3a-3b11-3c83-b025-dd9735d58848",
                                "text": "Just in case, Oatly’s prospectus gives it the option of listing in Hong Kong if the foreign ownership becomes a problem in the United States."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b51d7aec-eb7d-4dd4-b03e-e6ccd216ba7d",
                        "source_entry_id": "acb0964d-7c9e-3aad-b225-b4340cfaba2c",
                        "source_sense_description": "document which describes an institution, publication or business",
                        "target_lang_word": "prospectus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prospectus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "edb5eb26-64df-3fbc-83a9-576a8cc03217",
                                        "entry_id": "a85c463c-095c-3162-bce4-927a6fc279fd",
                                        "glosses": [
                                            "Programme qui se publie avant qu’un ouvrage paraisse, dans lequel on donne une idée de cet ouvrage, son format, son caractère, le nombre des volumes et des conditions de la souscription."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bc53dde-71c6-4c08-abe3-d123fbb13566",
                                                "sense_id": "edb5eb26-64df-3fbc-83a9-576a8cc03217",
                                                "text": "Le moment venu on redistribua prospectus sur prospectus, cartes-annonces sur cartes-annonces; Paris s'emplit à nouveau de la nouvelle de l'apparition du roman à sensation et lorsque la publication en commença on tira à cent mille exemplaires un numéro gratuit que l'on sema dans la France entière."
                                            },
                                            {
                                                "example_id": "793005ef-4f28-4eed-9210-064db9c67ccb",
                                                "sense_id": "edb5eb26-64df-3fbc-83a9-576a8cc03217",
                                                "text": "Le prospectus sur « la première livraison de l'Encyclopédie par ordre de matières » paru en 1782 annonce que la souscription « ouverte jusqu'à la fin Avril 1783 » s'élève maintenant à « 751 livres » ([…])."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2c4736d-379c-3800-a7d6-bc164ffd5a6d",
                                        "entry_id": "a85c463c-095c-3162-bce4-927a6fc279fd",
                                        "glosses": [
                                            "Publicité, imprimé ou brochure, destiné à une promotion grand public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f758f197-3be9-4fee-8a21-21699abb8d9a",
                                                "sense_id": "f2c4736d-379c-3800-a7d6-bc164ffd5a6d",
                                                "text": "Vauvinet était mis, comme les jeunes gens qui se livrent aux affaires, avec une recherche excessive qui, pour beaucoup d’entre eux est une espèce de prospectus."
                                            },
                                            {
                                                "example_id": "06165fe3-e475-4dc2-a616-a4b9ca564672",
                                                "sense_id": "f2c4736d-379c-3800-a7d6-bc164ffd5a6d",
                                                "text": "Andoche connaît le Prospectus, il entre dans les idées du marchand, il n’est pas fier, il limousinera notre prospectus gratis."
                                            },
                                            {
                                                "example_id": "a2d6c8b4-498d-47aa-b682-1be10e03883e",
                                                "sense_id": "f2c4736d-379c-3800-a7d6-bc164ffd5a6d",
                                                "text": "Milee est l'un des deux distributeurs français de prospectus avec La Poste. Sa mise en liquidation judiciaire et les 10.000 emplois concernés traduisent la fin d'une époque. C'était l'époque où Carrefour et Leclerc pouvaient, pour leurs grandes opérations promotionnelles, Noël, Pâques, la fête des mères, éditer et distribuer jusqu'à 25 millions de prospectus. Il y en avait un dans toutes les boîtes aux lettres de France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bb6d9bc-e486-3f1a-8c11-b1d92142270a",
                                        "entry_id": "a85c463c-095c-3162-bce4-927a6fc279fd",
                                        "glosses": [
                                            "Annonce de publicité quelconque, tract, dépliant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04a0602b-2aaa-47b1-aa6d-e549cbb43f00",
                                                "sense_id": "3bb6d9bc-e486-3f1a-8c11-b1d92142270a",
                                                "text": "Petit \"prospectus\" élevé au rang d'œuvre d'art, le flyer est un des moyens de diffusion de l'information parmi les plus efficaces et les plus branchés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a28a79b5-9b30-3805-99b7-90d2ee50e814",
                                        "entry_id": "a85c463c-095c-3162-bce4-927a6fc279fd",
                                        "glosses": [
                                            "Document préparé par une entreprise en lien avec l'offre ou l'émission de titres financiers, contenant des informations au sujet des titres et de leur émetteur, et destiné à des investisseurs potentiels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3527fd6-9b2b-4e35-bb7a-b41d256592a1",
                                                "sense_id": "a28a79b5-9b30-3805-99b7-90d2ee50e814",
                                                "text": "Le club reconnaît lui-même dans un prospectus boursier mardi 7 août être \"dépendant de la popularité et de la performance de son équipe\" et de sa \"capacité à retenir des employés clés, y compris les joueurs\", un facteur de risque important pour les actionnaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61cf591c-68a8-4d9a-9529-48ddc5e9596e",
                        "source_entry_id": "acb0964d-7c9e-3aad-b225-b4340cfaba2c",
                        "source_sense_description": "document which describes an institution, publication or business",
                        "target_lang_word": "Prospekt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prospekt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78b1513f-c1b8-38d3-a1d4-d3939e66213d",
                                        "entry_id": "1ecfa87d-a1ff-33f3-b11b-b6922e41f2fc",
                                        "glosses": [
                                            "Zettel bis kleinere Zeitschrift, die als Werbung in der Wirtschaft dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e92170fe-ffe9-4d66-925e-3b4914a4d22a",
                                                "sense_id": "78b1513f-c1b8-38d3-a1d4-d3939e66213d",
                                                "text": "Um Kunden zu gewinnen, versenden die Kaufhäuser mehrmals im Monat ihre Prospekte mit verschiedenen Angeboten und Preisen an die Bevölkerung."
                                            },
                                            {
                                                "example_id": "38bbc527-8947-4947-99b9-d64b8ef595d4",
                                                "sense_id": "78b1513f-c1b8-38d3-a1d4-d3939e66213d",
                                                "text": "„Von der Baumesse hatten Mama und Papa mehrere Pfund Prospekte mitgebracht.“"
                                            },
                                            {
                                                "example_id": "63f94cce-5207-4332-925a-9a18305f6965",
                                                "sense_id": "78b1513f-c1b8-38d3-a1d4-d3939e66213d",
                                                "text": "„Alles musste sie sich mühsam aus den Katalogen und Prospekten zusammenlesen.“"
                                            },
                                            {
                                                "example_id": "2e16c42d-dee7-4289-a16f-e5f740751aa1",
                                                "sense_id": "78b1513f-c1b8-38d3-a1d4-d3939e66213d",
                                                "text": "„Bevor Robert am Nachmittag aufgebrochen war, hatte er sich erkundigt, ob es im Gasthaus nicht einen Stadtplan oder einen Prospekt über die Sehenswürdigkeiten gebe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "08ee2dfd-d5ab-32d8-9a30-8678bacdd405",
                                        "entry_id": "1ecfa87d-a1ff-33f3-b11b-b6922e41f2fc",
                                        "glosses": [
                                            "Darstellung von (Teilen von) Ortsansichten in oft perspektivisch übertriebener (verkürzter) Weise"
                                        ],
                                        "tags": [
                                            "Malerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ddbde05-cf35-47d5-a464-7c7da8b744e4",
                                                "sense_id": "08ee2dfd-d5ab-32d8-9a30-8678bacdd405",
                                                "text": "Bei einem gezeichneten Prospekt ist die Ansicht des Bildes übertrieben dargestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4555ca25-beba-32a8-96b5-19bfeeb84252",
                                        "entry_id": "1ecfa87d-a1ff-33f3-b11b-b6922e41f2fc",
                                        "glosses": [
                                            "perspektivisch gemalter Hintergrund der Bühne"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "961a4baf-98f8-48d0-89c8-a7d7a332d590",
                                                "sense_id": "4555ca25-beba-32a8-96b5-19bfeeb84252",
                                                "text": "Das Prospekt wird auf die Bühne herabgelassen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ecc4b483-0736-362f-a6a7-acdce6cbeb56",
                                        "entry_id": "1ecfa87d-a1ff-33f3-b11b-b6922e41f2fc",
                                        "glosses": [
                                            "Hauptstraße in russischen Städten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30eed094-d707-4eaa-b1d2-f2db4f9dbae7",
                                                "sense_id": "ecc4b483-0736-362f-a6a7-acdce6cbeb56",
                                                "text": "Der Moskowskij Prospekt ist leicht zu finden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "506ddfbb-dbc1-31fd-9f4c-e4fe1e16658c",
                                        "entry_id": "1ecfa87d-a1ff-33f3-b11b-b6922e41f2fc",
                                        "glosses": [
                                            "äußere Erscheinung einer Pfeifenorgel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d3dabe3-dbcc-43ef-9aa0-b75cec955f90",
                                                "sense_id": "506ddfbb-dbc1-31fd-9f4c-e4fe1e16658c",
                                                "text": "Die Orgel ist mit einem Gehäuse umgeben, dessen vordere Seite der Prospekt genannt wird."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "2e38071a-23b3-3f02-98b3-08e0e87b5fba",
                                        "entry_id": "1ecfa87d-a1ff-33f3-b11b-b6922e41f2fc",
                                        "glosses": [
                                            "schriftliche Informationen über Aktien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15542640-23a9-4799-bb43-c6f5a7d1a13d",
                                                "sense_id": "2e38071a-23b3-3f02-98b3-08e0e87b5fba",
                                                "text": "Der Prospekt enthält Angaben über die mit den zu emittierenden Wertpapieren verbundenen Rechte und Pflichten."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2c53458-a42c-444a-ad74-8492d48271de",
                        "source_entry_id": "acb0964d-7c9e-3aad-b225-b4340cfaba2c",
