                    {
                        "translation_id": "c62ca0fb-d801-491a-b8ef-9e98d92feadb",
                        "source_entry_id": "bb66e52b-3d0a-3ca8-8d99-19a6b3db01b6",
                        "source_sense_id": "a95d8952-9b4f-366a-a4bc-01f2b921d558",
