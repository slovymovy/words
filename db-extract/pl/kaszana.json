                        "examples": [
                            {
                                "example_id": "6c7f98e7-9860-4b75-b581-dbd2f7bc69dc",
                                "sense_id": "e9010cb2-af23-3418-b57c-c00b5518535b",
                                "text": "Naje się kaszany i śpi, spaślak jeden!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "60d54a2c-0d72-351f-a715-66256d7db464",
                        "entry_id": "f90df3a1-3458-3ad9-999c-b3d89cd96428",
                        "glosses": [
                            "zawstydzająca, żenująca lub kłopotliwa sytuacja"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "6a7f4158-409d-4302-8c79-ff1b7b7a3e4a",
                                "sense_id": "60d54a2c-0d72-351f-a715-66256d7db464",
                                "text": "Po kaszanie u trenera, czekało ich jeszcze spotkanie z prezesem."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "c91bead1-1b8a-3503-b1a2-1ecac77ebc41",
                        "entry_id": "f90df3a1-3458-3ad9-999c-b3d89cd96428",
