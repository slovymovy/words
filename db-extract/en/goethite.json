                    {
                        "sense_id": "ba013c05-877f-36ba-99c9-0445fa00bdf4",
                        "entry_id": "09c93b62-cac9-377e-b6cb-959b633a2ce9",
                        "glosses": [
                            "An iron oxyhydroxide that is the main constituent of rust and in mineral form is an ore."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "06a03457-b773-48b4-8504-7fe2f138a207",
                                "sense_id": "ba013c05-877f-36ba-99c9-0445fa00bdf4",
                                "text": "Recent work has shown that the teeth of limpets approximate to an almost ideal model natural composite material where high aspect ratio mineral nanofibres of goethite reinforce a protein matrix."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80c7ca80-54a4-4bbe-b240-7975b6d3500e",
                        "source_entry_id": "09c93b62-cac9-377e-b6cb-959b633a2ce9",
                        "source_sense_id": "ba013c05-877f-36ba-99c9-0445fa00bdf4",
                        "source_sense_description": "an iron oxyhydroxide that is the main constituent of rust",
                        "target_lang_word": "goethite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goethite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8d47da9-db5c-3098-a813-f903dcef9aa1",
                                        "entry_id": "1fc557ce-c30a-3476-b988-c71d59e56f11",
                                        "glosses": [
                                            "Espèce minérale, forme d’oxyhydroxyde de fer trivalent, polymorphe α du composé FeO(OH)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef3b96e6-0bce-488e-856e-af9209578688",
                                                "sense_id": "d8d47da9-db5c-3098-a813-f903dcef9aa1",
                                                "text": "[Les sols rouges et bruns fersiallitiques] sont riches en gœthite ou en crypto-hématite et des complexes fer-silice y ont été souvent décrits (Reifenberg, Hénin, Nalovic et Trichet)."
                                            },
                                            {
                                                "example_id": "cfba293e-76e5-48ea-8247-198a2430ba95",
                                                "sense_id": "d8d47da9-db5c-3098-a813-f903dcef9aa1",
                                                "text": "La goethite est l’oxyhydroxyde de fer (FeOOH) de couleur jaune, et l’hématite, l’oxyde ferrique (Fe₂O₃) de couleur rouge."
                                            },
                                            {
                                                "example_id": "0505f6a6-495c-4851-8178-587bc72887ea",
                                                "sense_id": "d8d47da9-db5c-3098-a813-f903dcef9aa1",
                                                "text": "Cette hypothèse est confirmée par l’utilisation comme broyeur du petit nucléus en quartzite du kit Tk2, utilisé d’abord pour écraser de la goethite jaune, taillé ensuite et employé enfin pour moudre du pigment rouge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
