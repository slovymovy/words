        "nl-extract.jsonl": [
            {
                "entry_id": "37fb4d9d-e4d0-365d-af07-7fd4ab70ac95",
                "word": "verdelgen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ecaee362-3bfe-3cfa-9e02-27904ec6cfd2",
                        "entry_id": "37fb4d9d-e4d0-365d-af07-7fd4ab70ac95",
                        "glosses": [
                            "iets opruimen wat schadelijk is, definitief vernietigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a712d565-8394-47b4-a4cf-a3565751dcd8",
                                "sense_id": "ecaee362-3bfe-3cfa-9e02-27904ec6cfd2",
                                "text": "Gemeenten moeten nu borstelen, branden, stomen of heet water gebruiken om het ongewenste groen te verdelgen. Maar deze milieuvriendelijke methodes werken niet zo goed als gif. Om de straten toch op het gewenste kwaliteitsniveau te krijgen, moeten gemeenten nu vaker de wijken in om het onkruid te verwijderen."
                            },
                            {
                                "example_id": "7f530f00-94e5-48b5-8442-f9c563b7d37c",
                                "sense_id": "ecaee362-3bfe-3cfa-9e02-27904ec6cfd2",
                                "text": "Wat dit op ware gebeurtenissen gebaseerde verhaal zo complex maakt, is de grenzeloze haat die Edwards jegens Indianen koestert. In een van de kenmerkendste scènes schiet hij een dode Comanche door de ogen, zodat deze volgens zijn eigen geloof het hiernamaals niet kan vinden. Edwards'racisme gaat dus zo ver, dat hij de geloofsopvattingen van zijn vijanden heeft verinnerlijkt om hen als het ware van binnenuit te kunnen verdelgen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec3a9141-ccf5-4cf7-bb31-25d1e63c9e8f",
                        "source_entry_id": "37fb4d9d-e4d0-365d-af07-7fd4ab70ac95",
                        "source_sense_id": "ecaee362-3bfe-3cfa-9e02-27904ec6cfd2",
                        "target_lang_word": "exterminate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exterminate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97016bb2-b287-3dde-8a17-d1c077fb4574",
                                        "entry_id": "5286f345-7a5d-3c9e-803f-7456cfd4f332",
                                        "glosses": [
                                            "To kill or otherwise permanently eliminate all of (a population of pests or undesirables), usually intentionally."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2625938c-e626-454d-af53-be0c37547913",
                                                "sense_id": "97016bb2-b287-3dde-8a17-d1c077fb4574",
                                                "text": "We'll use poison to exterminate the rats."
                                            },
                                            {
                                                "example_id": "cc481a49-1e5a-408f-a5be-34f939fa5d53",
                                                "sense_id": "97016bb2-b287-3dde-8a17-d1c077fb4574",
                                                "text": "The geth are a humanoid race of networked A.I.s. They were created by the quarians 300 years ago as tools of labor and war. When the geth showed signs of self-evolution, the quarians attempted to exterminate them. The geth won the resulting war. This example has led to legal, systematic repression of artificial intelligences in galactic society."
                                            },
                                            {
                                                "example_id": "5404a2e8-dfc5-46ae-bf9f-f4122a7b18f8",
                                                "sense_id": "97016bb2-b287-3dde-8a17-d1c077fb4574",
                                                "text": "Somewhat unsurprisingly, unleashing the most powerful navy on the planet with carte blanche to exterminate slavers on sight saw a dramatic and sudden collapse in slaver numbers in the late 1840s and early 1850s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06beeef4-f9eb-3e51-aff7-f56dc0323718",
                                        "entry_id": "5286f345-7a5d-3c9e-803f-7456cfd4f332",
                                        "glosses": [
                                            "To bring a definite end to; to finish completely."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a56180f-86e1-4af8-96e5-28624da8792d",
                                                "sense_id": "06beeef4-f9eb-3e51-aff7-f56dc0323718",
                                                "text": "The public school failed to exterminate truancy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a519435-85a7-4144-be94-01176bafbb4e",
                        "source_entry_id": "37fb4d9d-e4d0-365d-af07-7fd4ab70ac95",
                        "source_sense_id": "ecaee362-3bfe-3cfa-9e02-27904ec6cfd2",
                        "target_lang_word": "eradicate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eradicate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53516bd7-7834-340c-8191-73115aa939e4",
                                        "entry_id": "8d4c16a1-0e98-3417-9d97-3fe31679d3fd",
                                        "glosses": [
                                            "eradicated"
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "participle"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "eradicate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "084ae4af-0eb3-3256-bdf8-cc6ac9c1beb1",
                                        "entry_id": "86210b89-5357-3ef9-99e4-b258f395f2c7",
                                        "glosses": [
                                            "To pull up by the roots."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a419110d-441f-3c00-a7e9-ab04163f9b73",
                                        "entry_id": "86210b89-5357-3ef9-99e4-b258f395f2c7",
                                        "glosses": [
                                            "To destroy completely; to reduce to nothing radically; to put an end to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a06d4f97-62c2-4bbc-881d-4b84683be441",
                                                "sense_id": "a419110d-441f-3c00-a7e9-ab04163f9b73",
                                                "text": "Near-synonyms: delete, erase"
                                            },
                                            {
                                                "example_id": "a46332a5-752f-407a-86fc-b15f9fafa2fe",
                                                "sense_id": "a419110d-441f-3c00-a7e9-ab04163f9b73",
                                                "text": "Smallpox was globally eradicated in 1980."
                                            },
                                            {
                                                "example_id": "f99cd8b3-cf22-456b-aaab-64083929beb3",
                                                "sense_id": "a419110d-441f-3c00-a7e9-ab04163f9b73",
                                                "text": "I would like to know if there are any true moralists who would like to correspond with someone who just instinctively feels there's something wrong somewhere in this unbenevolent world and wants to save it by culminating love and eradicating the captive emotions of the self (Ego)."
                                            },
                                            {
                                                "example_id": "ba953df2-2957-4fb1-be4f-0ea79ba5c828",
                                                "sense_id": "a419110d-441f-3c00-a7e9-ab04163f9b73",
                                                "text": "Thus far, virtually every cinematic attempt to convey the outrages of South African life under apartheid has been diminished by its own good intentions and by a grim sameness that eradicates any element of surprise."
                                            },
                                            {
                                                "example_id": "905b42b4-ce81-4895-a96f-e04c237a1172",
                                                "sense_id": "a419110d-441f-3c00-a7e9-ab04163f9b73",
                                                "text": "She put a banner for the One Campaign, an effort to eradicate poverty in the third world led by U2's singer Bono, on her LJ […]"
                                            },
                                            {
                                                "example_id": "e1c944a2-0e3d-4a2f-992a-904dc4022a1b",
                                                "sense_id": "a419110d-441f-3c00-a7e9-ab04163f9b73",
                                                "text": "The germinal matrix in this area is then eradicated either by surgical or chemical matrixectomy using phenol or NaOH."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9faf474b-a9ba-460b-9088-2c69e2db74ad",
                        "source_entry_id": "37fb4d9d-e4d0-365d-af07-7fd4ab70ac95",
                        "source_sense_id": "ecaee362-3bfe-3cfa-9e02-27904ec6cfd2",
                        "target_lang_word": "destroy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "destroy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11682e8e-54f7-39a3-849c-deb37327b5f0",
                                        "entry_id": "55d702e5-08e8-3640-aad8-64eb95e7f73b",
                                        "glosses": [
                                            "To damage beyond use or repair; to damage (something) to the point that it effectively ceases to exist."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf534c52-bd7e-4eae-a279-9f3942dfdfc8",
                                                "sense_id": "11682e8e-54f7-39a3-849c-deb37327b5f0",
                                                "text": "The earthquake destroyed several apartment complexes."
                                            },
                                            {
                                                "example_id": "d49c4566-94ec-40cc-b430-2fa2217ecd2e",
                                                "sense_id": "11682e8e-54f7-39a3-849c-deb37327b5f0",
                                                "text": "Hooligans destroy unprovoked."
                                            },
                                            {
                                                "example_id": "b469e8ce-8cf9-4c37-ad85-9283a6097a62",
                                                "sense_id": "11682e8e-54f7-39a3-849c-deb37327b5f0",
                                                "text": "Iesus answered, and said vnto them, Destroy this temple, and in three dayes I will raise it vp."
                                            },
                                            {
                                                "example_id": "bbc3fe26-6f41-4a53-b961-9fef49394976",
                                                "sense_id": "11682e8e-54f7-39a3-849c-deb37327b5f0",
                                                "text": "Repeated use of this type of [water] on plants results in deflocculation[] of the soil. Good quality soil consists of loose aggregates which provide natural aeration and ease of root run. Sodium accumulation in soil destroys this natural flocculation and causes the soil to pack."
                                            },
                                            {
                                                "example_id": "a185a03e-d028-4226-b204-d84f3490359e",
                                                "sense_id": "11682e8e-54f7-39a3-849c-deb37327b5f0",
                                                "text": "Krav is a martial art of last resort that assumes no quarter and focuses purely on disarming, disabling and, if necessary, destroying your opponent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c53bda3d-6fed-3cd7-8ccc-d4d7b7cb67f3",
                                        "entry_id": "55d702e5-08e8-3640-aad8-64eb95e7f73b",
                                        "glosses": [
                                            "To neutralize, undo a property or condition."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fac048d-4d53-4536-b72b-b4edd2d68ab0",
                                                "sense_id": "c53bda3d-6fed-3cd7-8ccc-d4d7b7cb67f3",
                                                "text": "Smoking destroys the natural subtlety of the palate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8815f8ad-5c94-3c31-865e-8cc0503ec879",
                                        "entry_id": "55d702e5-08e8-3640-aad8-64eb95e7f73b",
                                        "glosses": [
                                            "To put down or euthanize."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f4821b7-d991-4ddc-b897-244cf0505e80",
                                                "sense_id": "8815f8ad-5c94-3c31-865e-8cc0503ec879",
                                                "text": "Destroying a rabid dog is required by law."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd8c3700-797e-3462-a1e2-7acb1c5229ca",
                                        "entry_id": "55d702e5-08e8-3640-aad8-64eb95e7f73b",
                                        "glosses": [
                                            "To severely disrupt the well-being of (a person); ruin."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "624c950d-40c7-4b34-8bd0-3fa3ababd0fd",
                                                "sense_id": "fd8c3700-797e-3462-a1e2-7acb1c5229ca",
                                                "text": "Her divorce destroyed her; she had a nervous breakdown and was severely depressed for more than a year."
                                            },
                                            {
                                                "example_id": "1814fa40-a0fe-43fd-8c7c-43670bebef9e",
                                                "sense_id": "fd8c3700-797e-3462-a1e2-7acb1c5229ca",
                                                "text": "Other girls in the foster home are eager to destroy her and get her kicked out of the place. It's a tough situation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8c7ff6b-5438-3c26-ad1c-f14864ebbd08",
                                        "entry_id": "55d702e5-08e8-3640-aad8-64eb95e7f73b",
                                        "glosses": [
                                            "To utterly defeat; to crush."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30848340-aba9-4cc3-905f-807dec45cf6a",
                                                "sense_id": "a8c7ff6b-5438-3c26-ad1c-f14864ebbd08",
                                                "text": "Remember when Germany destroyed Brazil 7–1 in the World Cup?"
                                            },
                                            {
                                                "example_id": "a4fb73e0-a0db-453a-b6c2-b37bf1d482b6",
                                                "sense_id": "a8c7ff6b-5438-3c26-ad1c-f14864ebbd08",
                                                "text": "Growing up, [Kevin] Durant told me, he was a sore loser. That all changed one day when he was 11, after he got destroyed by his father in a game of one on one in the driveway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44726c59-282b-3db9-9ac4-4494f825a888",
                                        "entry_id": "55d702e5-08e8-3640-aad8-64eb95e7f73b",
                                        "glosses": [
                                            "To remove data."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66f7d371-cc86-4ee3-891a-6e52f1b4c3a0",
                                                "sense_id": "44726c59-282b-3db9-9ac4-4494f825a888",
                                                "text": "The memory leak happened because we forgot to destroy the temporary lists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49527099-ecc5-3044-b86a-1e6448626c7a",
                                        "entry_id": "55d702e5-08e8-3640-aad8-64eb95e7f73b",
                                        "glosses": [
                                            "To exhaust completely and thus recreate or build up."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5514705-7029-49c6-b8f3-2b285606d59c",
                                                "sense_id": "49527099-ecc5-3044-b86a-1e6448626c7a",
                                                "text": "This exercise is going to destroy all parts of your shoulders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e77f7262-549a-3e20-b138-a2d93222a24a",
                                        "entry_id": "55d702e5-08e8-3640-aad8-64eb95e7f73b",
                                        "glosses": [
                                            "To penetrate sexually in an aggressive way."
                                        ],
