                        "glosses": [
                            "Of, pertaining to, or produced by a mantle, especially the mantle of mollusks."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5ff7b573-d55f-4c03-b582-92d10a370235",
                                "sense_id": "f7530bf6-299e-37f2-b73b-eeca2cd292e4",
                                "text": "the pallial line, or impression, which marks the attachment of the mantle on the inner surface of a bivalve shell"
                            },
                            {
                                "example_id": "822c0603-564a-4fae-838e-be5e9a5ece15",
                                "sense_id": "f7530bf6-299e-37f2-b73b-eeca2cd292e4",
                                "text": "The oldest points are close to the outcrop of the pallial myostracum (9 )."
                            },
                            {
                                "example_id": "5a851da4-e776-4600-85c8-4ed4e19413a9",
                                "sense_id": "f7530bf6-299e-37f2-b73b-eeca2cd292e4",
                                "text": "Along a line nearly corresponding with the horny band which proceeds from the insertions of the shell-muscles and encircles the mantle below, the pallial wall is produced inwards and forwards into a membranous fold or ligament, which I will call the pallio-visceral ligament; and this pallio-visceral ligament becoming attached to various viscera, divides the great fifth chamber into an anterior inferior, and a posterior superior portion, which communicate freely with one another."
                            }
                        ]
