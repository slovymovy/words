                        "glosses": [
                            "разг. отбить что-либо ногой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fb7e336-650a-4441-94fe-317c76a56d1c",
                                "sense_id": "f558aa98-526c-3b88-a066-c04db7a46128",
                                "text": "Егор отфутболил гранату ногой."
                            }
                        ]
                    },
                    {
                        "sense_id": "552c678f-4278-3067-a93a-39e827add68b",
                        "entry_id": "e8c6a017-5496-3596-94c6-4b9dc6a16a6d",
                        "glosses": [
                            "разг. перен. неодобр. направить человека или документ в другую инстанцию, выдать дежурную отписку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57457397-f832-431c-85ab-9667a053ab5a",
                                "sense_id": "552c678f-4278-3067-a93a-39e827add68b",
                                "text": "Отфутболить жалобу."
                            },
                            {
                                "example_id": "29c50463-aaec-4a61-aff4-f296756c7e63",
                                "sense_id": "552c678f-4278-3067-a93a-39e827add68b",
                                "text": "Легче отфутболить одного из тысячи, чем решать проблему."
                            },
                            {
                                "example_id": "9a1f2743-4a14-4426-b414-64987a3bb923",
                                "sense_id": "552c678f-4278-3067-a93a-39e827add68b",
                                "text": "Потом дело пытались отфутболить в прокуратуру, в отдел несовершеннолетних, куда-то ещё, пока оно не вернулось к дознавателю того же отделения милиции в виде пухлой папочки."
                            }
                        ]
                    }
