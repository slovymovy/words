{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3bda1818-d1d6-3afe-89f7-045348e5ad8f",
                    "sense_definition": "To travel with a person or vehicle to protect, guard, or show them the way.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "protection_guarding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officers <escorted> the ambulance through the heavy city traffic.",
                            "target_lang_translations": {
                                "ru": "Полицейские <w>сопровождали</w> машину скорой помощи через плотный городской поток.",
                                "zh": "警察<w>护送</w>救护车穿过了拥堵的市区交通。"
                            }
                        },
                        {
                            "text": "A security guard <escorted> the guests to the main conference room.",
                            "target_lang_translations": {
                                "ru": "Охранник <w>проводил</w> гостей в главный конференц-зал.",
                                "zh": "保安<w>陪同</w>客人们前往主会议室。"
                            }
                        }
                    ],
                    "synonyms": [
                        "accompany",
                        "attend",
                        "see"
                    ],
                    "common_phrases": [
                        "escort someone to safety",
                        "escort to the door",
                        "police escort"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сопровождать человека или транспортное средство для охраны или указания пути.",
                        "zh": "为了保护、看守或指引方向而与某人或车辆同行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сопровожда́ть",
                                "target_lang_sense_clarification": "следовать вместе с кем-то"
                            },
                            {
                                "target_lang_word": "эскорти́ровать",
                                "target_lang_sense_clarification": "официально или торжественно сопровождать"
                            },
                            {
                                "target_lang_word": "охраня́ть",
                                "target_lang_sense_clarification": "обеспечивать безопасность в пути"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陪同",
                                "target_lang_sense_clarification": "跟随某人一起前往某处"
                            },
                            {
                                "target_lang_word": "护送",
                                "target_lang_sense_clarification": "为了保护而跟随"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18d5e54e-38d3-34a4-9edd-0eb22fd0abff",
                    "sense_definition": "To take someone somewhere, often forcefully or to ensure they leave a place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "compulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry customer was <escorted> out of the building by security staff.",
                            "target_lang_translations": {
                                "ru": "Служба безопасности <w>вывела</w> разгневанного клиента из здания.",
                                "zh": "愤怒的顾客被安保人员<w>带离</w>了大楼。"
                            }
                        },
                        {
                            "text": "If you continue to shout, you will be <escorted> off the premises immediately.",
                            "target_lang_translations": {
                                "ru": "Если вы продолжите кричать, вас немедленно <w>выпроводят</w> с территории.",
                                "zh": "如果你继续大喊大叫，你会被立即<w>驱逐</w>出场。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "escort out",
                        "escort off the premises"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выводить кого-либо откуда-либо, часто принудительно или под надзором.",
                        "zh": "带某人去某处，通常是强制性的或为了确保其离开。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпрова́живать",
                                "target_lang_sense_clarification": "заставлять уйти"
                            },
                            {
                                "target_lang_word": "выводи́ть",
                                "target_lang_sense_clarification": "помогать или заставлять выйти"
                            },
                            {
                                "target_lang_word": "сопровожда́ть",
                                "target_lang_sense_clarification": "формально: вести к выходу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "带离",
                                "target_lang_sense_clarification": "强制某人离开某地"
                            },
                            {
                                "target_lang_word": "驱逐",
                                "target_lang_sense_clarification": "强迫某人离开"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "490097ee-adc3-3727-83c9-17bc5dc27e78",
                    "sense_definition": "To go with someone to a social event as a partner or companion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_accompaniment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He offered to <escort> her to the annual charity ball.",
                            "target_lang_translations": {
                                "ru": "Он предложил <w>сопроводить</w> её на ежегодный благотворительный бал.",
                                "zh": "他主动提出<w>陪同</w>她参加年度慈善舞会。"
                            }
                        },
                        {
                            "text": "She was <escorted> by her brother because her husband could not attend.",
                            "target_lang_translations": {
                                "ru": "Её <w>сопровождал</w> брат, так как её муж не смог присутствовать.",
                                "zh": "因为丈夫无法出席，她由哥哥<w>陪同</w>前往。"
                            }
                        }
                    ],
                    "synonyms": [
                        "accompany",
                        "squire"
                    ],
                    "common_phrases": [
                        "escort a lady",
                        "escort to the ball"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти с кем-либо на общественное мероприятие в качестве спутника.",
                        "zh": "作为伴侣或同伴陪同某人参加社交活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сопровожда́ть",
                                "target_lang_sense_clarification": "быть спутником на мероприятии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陪同",
                                "target_lang_sense_clarification": "作为舞伴或同伴出席活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba2e8d03-cdf7-3dd9-be05-b54720c4992c",
                    "sense_definition": "To work as a person hired for companionship or sexual services.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sex_industry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The documentary explored the lives of women who <escort> for a living.",
                            "target_lang_translations": {
                                "ru": "Документальный фильм исследовал жизни женщин, которые <w>работают в эскорте</w>.",
                                "zh": "这部纪录片探讨了那些以<w>陪侍</w>为生的女性的生活。"
                            }
                        },
                        {
                            "text": "She decided to stop <escorting> and return to university.",
                            "target_lang_translations": {
                                "ru": "Она решила перестать <w>заниматься эскортом</w> и вернуться в университет.",
                                "zh": "她决定停止<w>陪侍</w>工作，重返大学。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать в сфере платного сопровождения и интимных услуг.",
                        "zh": "从事提供陪伴及性服务的职业。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рабо́тать в эско́рте",
                                "target_lang_sense_clarification": "заниматься эскорт-услугами"
                            },
                            {
                                "target_lang_word": "ока́зывать эско́рт-услу́ги",
                                "target_lang_sense_clarification": "предоставлять услуги сопровождения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "从事陪侍服务",
                                "target_lang_sense_clarification": "提供有偿陪伴服务"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c63322cb-21ec-3f9e-97b2-d01a3fb17ac9",
                    "sense_definition": "A person, group of people, or vehicles that travel with someone to protect or guard them.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "protection_guarding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president traveled in a limousine with a heavy police <escort>.",
                            "target_lang_translations": {
                                "ru": "Президент ехал в лимузине с усиленным полицейским <w>эскортом</w>.",
                                "zh": "总统乘坐豪华轿车出行，有严密的警察<w>护卫</w>。"
                            }
                        },
                        {
                            "text": "The supply ships needed an armed <escort> to cross the dangerous waters.",
                            "target_lang_translations": {
                                "ru": "Кораблям снабжения требовалось вооруженное <w>сопровождение</w>, чтобы пересечь опасные воды.",
                                "zh": "补给船需要武装<w>护送</w>才能穿过危险海域。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "police escort",
                        "armed escort",
                        "military escort",
                        "under escort"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, группа людей или транспорт, сопровождающие кого-либо для охраны или почестей.",
                        "zh": "为保护或护卫而与某人同行的人、群体或车辆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сопровожде́ние",
                                "target_lang_sense_clarification": "процесс или группа сопровождающих"
                            },
                            {
                                "target_lang_word": "эско́рт",
                                "target_lang_sense_clarification": "почетная или военная охрана"
                            },
                            {
                                "target_lang_word": "охра́на",
                                "target_lang_sense_clarification": "защита"
                            },
                            {
                                "target_lang_word": "конво́й",
                                "target_lang_sense_clarification": "вооруженное сопровождение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "护送",
                                "target_lang_sense_clarification": "保护性的随行"
                            },
                            {
                                "target_lang_word": "护卫",
                                "target_lang_sense_clarification": "负责安全保护的队伍"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a9bf3d7-56b8-3b9d-8f1f-9ea122881c4d",
                    "sense_definition": "A person hired to provide companionship and often sexual services.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sex_industry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newspaper published an investigation into a high-end <escort> agency.",
                            "target_lang_translations": {
                                "ru": "Газета опубликовала расследование о деятельности элитного агентства <w>эскорт-услуг</w>.",
                                "zh": "报纸刊登了一篇关于一家高端<w>陪侍</w>中介的调查报道。"
                            }
                        },
                        {
                            "text": "He was arrested for running an illegal <escort> service in the city center.",
                            "target_lang_translations": {
                                "ru": "Его арестовали за организацию нелегальной службы <w>эскорта</w> в центре города.",
                                "zh": "他因在市中心经营非法<w>陪侍</w>服务而被捕。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "escort agency",
                        "escort service"
                    ],
                    "target_lang_definitions": {
                        "ru": "Услуги платного сопровождения или человек, их оказывающий.",
                        "zh": "提供有偿陪伴及性服务的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эско́рт",
                                "target_lang_sense_clarification": "сфера услуг сопровождения"
                            },
                            {
                                "target_lang_word": "эско́рт-услу́ги",
                                "target_lang_sense_clarification": "платное сопровождение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陪侍人员",
                                "target_lang_sense_clarification": "提供有偿陪伴的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9ceeeff-3715-3cfc-afe3-bd868c23d3d3",
                    "sense_definition": "A person who accompanies another person to a social event.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_accompaniment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She needed an <escort> for the wedding, so she asked her best friend.",
                            "target_lang_translations": {
                                "ru": "Ей нужен был <w>спутник</w> на свадьбу, поэтому она попросила своего лучшего друга.",
                                "zh": "她需要一位<w>男伴</w>参加婚礼，于是她邀请了她最好的朋友。"
                            }
                        },
                        {
                            "text": "He acted as her <escort> for the evening and drove her home afterwards.",
                            "target_lang_translations": {
                                "ru": "Он был её <w>спутником</w> весь вечер и отвез её домой после.",
                                "zh": "他当晚担任她的<w>男伴</w>，并在活动结束后开车送她回家。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, сопровождающий другого на общественном мероприятии.",
                        "zh": "陪同他人参加社交活动的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спу́тник",
                                "target_lang_sense_clarification": "партнер на мероприятии (мужчина)"
                            },
                            {
                                "target_lang_word": "спу́тница",
                                "target_lang_sense_clarification": "партнер на мероприятии (женщина)"
                            },
                            {
                                "target_lang_word": "сопровожда́ющий",
                                "target_lang_sense_clarification": "тот, кто сопровождает"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "男伴",
                                "target_lang_sense_clarification": "女性的男性陪同者"
                            },
                            {
                                "target_lang_word": "女伴",
                                "target_lang_sense_clarification": "男性的女性陪同者"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}