                    }
                ],
                "translations": [
                    {
                        "translation_id": "baaaadd7-ddcb-4857-baf4-f92060e33634",
                        "source_entry_id": "f92b47e7-96f8-38f1-adc6-6d0c5066608b",
                        "source_sense_id": "60ad6fa9-95e7-3b18-9c48-9a4fac005885",
                        "target_lang_word": "incertitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incertitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a77f546-e46a-3a47-ab4d-785f8cffa3b3",
                                        "entry_id": "9ca8d2de-3017-3588-bf36-1c553555a8e0",
                                        "glosses": [
                                            "État d’une personne irrésolue sur ce qu’elle doit faire, ou incertaine de ce qui doit arriver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "133fba18-976d-4d1b-ad18-71a0aff1a198",
                                                "sense_id": "1a77f546-e46a-3a47-ab4d-785f8cffa3b3",
                                                "text": "C'est cet état général d’incertitude intellectuelle qui permet chez beaucoup la persistance d’attitudes doctrinales périmées, irréalistes, sans que l'on puisse faire de leurs égarements des symptômes psycho-pathologiques. […]. Mais on ne doit pas oublier que l’indéfinition des structures sociales crée chez beaucoup un état de trouble psychique."
                                            },
                                            {
                                                "example_id": "b8f593d6-c44d-40af-9f42-62bb9b544e88",
                                                "sense_id": "1a77f546-e46a-3a47-ab4d-785f8cffa3b3",
                                                "text": "Il est dans l’incertitude du parti qu’il doit prendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                        "entry_id": "9ca8d2de-3017-3588-bf36-1c553555a8e0",
                                        "glosses": [
                                            "Ce qui est susceptible de doute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a268b8e3-eda4-4f4f-a534-9633e151d506",
                                                "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                                "text": "Le lecteur lui-même sera tenu dans l’incertitude, sachant de moins en moins au fur et à mesure qu’il avance dans le texte, si les événements qu'on lui rapporte sont réels ou illusoires."
                                            },
                                            {
                                                "example_id": "9dd6ed14-1c09-4be2-b94a-d738d723d283",
                                                "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                                "text": "L’incertitude des jugements humains."
                                            },
                                            {
                                                "example_id": "b9cee70b-3205-4384-9068-79a9fb205edf",
                                                "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                                "text": "L’incertitude des doctrines philosophiques."
                                            },
                                            {
                                                "example_id": "e4aa5316-4c31-4dcc-b352-884668cfae53",
                                                "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                                "text": "Il y a beaucoup d’incertitude dans la médecine, dans l’histoire."
                                            },
                                            {
                                                "example_id": "ff0d6b05-04aa-45c9-b9fc-bb0f8534cd1c",
                                                "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                                "text": "L’incertitude du temps, l’état incertain du temps."
                                            },
                                            {
                                                "example_id": "b5b0ab12-26cd-4b65-a2ff-fa408f731f11",
                                                "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                                "text": "Un mémoire que je publierai prochainement ne laissera plus, je l’espère, aucune incertitude dans l’esprit de tous les archéologues de bonne foi."
                                            },
                                            {
                                                "example_id": "7387495e-d211-4525-86f1-c88ad0c0dd0a",
                                                "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                                "text": "Quant à l’incertitude, il y trouvait son compte également car l’incertitude est la face cachée du bonheur. Être sûr de l’amour de l’autre, c’est déjà le perdre."
                                            },
                                            {
                                                "example_id": "c7b75d4c-98dd-4ae4-81e7-a98b6aac5032",
                                                "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                                "text": "Ce rejet des deux leaders démocrates jette à nouveau une dose d’incertitude sur l’adoption d’un plan de relance supplémentaire avant l’investiture du démocrate Joe Biden le 20 janvier, au moment même où la résurgence de la pandémie de Covid-19 incite les États à restreindre l’activité économique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20295416-9f52-321c-a465-8e8c678a0a6d",
                                        "entry_id": "9ca8d2de-3017-3588-bf36-1c553555a8e0",
                                        "glosses": [
                                            "Ce qui n’est pas d’une nature bien arrêtée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87790598-4b0e-467f-b6e9-ddc00359c0f8",
                                                "sense_id": "20295416-9f52-321c-a465-8e8c678a0a6d",
                                                "text": "L’incertitude de son caractère."
                                            },
                                            {
                                                "example_id": "4da15d8d-2f7e-4925-be41-07eaf88f581b",
                                                "sense_id": "20295416-9f52-321c-a465-8e8c678a0a6d",
                                                "text": "L’incertitude habituelle de ses opinions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccaf656e-7015-3d22-b285-65ed0ed7773c",
                                        "entry_id": "9ca8d2de-3017-3588-bf36-1c553555a8e0",
                                        "glosses": [
                                            "Erreur attendue dans une mesure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae01bbfb-3399-4afe-a658-3d9bc04550ef",
                                                "sense_id": "ccaf656e-7015-3d22-b285-65ed0ed7773c",
                                                "text": "L'incertitude déterminée pour le système de mesure dans le cadre de la combinaison de niveaux choisie englobe l'incertitude spécifiée pour les instruments de mesure employés, l'incertitude d'étalonnage et toute autre incertitude liée au mode d'utilisation des instruments de mesure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ba24efa-b92a-314b-b1a4-bdc66fc3f08d",
                                        "entry_id": "9ca8d2de-3017-3588-bf36-1c553555a8e0",
                                        "glosses": [
                                            "Qualité exprimant la valeur moyenne, ou la valeur maximale, de l’erreur inhérente à la mise en œuvre d’un processus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6524ef59-cb24-499e-891c-f6909915c1b0",
                        "source_entry_id": "f92b47e7-96f8-38f1-adc6-6d0c5066608b",
                        "source_sense_id": "60ad6fa9-95e7-3b18-9c48-9a4fac005885",
                        "target_lang_word": "doute",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                        "entry_id": "a25740fa-9f10-3e6c-94ac-d23d9d194de9",
                                        "glosses": [
                                            "Incertitude sur l’existence ou la vérité d’une chose, sur l'exactitude ou la fausseté d’une idée, d’une affirmation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "376fda9c-1447-4fa8-be11-faad9e8f5d9c",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Gommez vos derniers doutes."
                                            },
                                            {
                                                "example_id": "05bb6666-7abb-4783-8d57-f3b076b164ee",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Les évaluations de propriétés la passionnaient. Nul doute que cette domination sur une grande étendue de forêt l'ait séduite."
                                            },
                                            {
                                                "example_id": "56bbe4a1-2001-4f6c-be40-58363fe91c7b",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Dans la connaissance des choses humaines, notre esprit ne doit jamais se rendre esclave en s'assujettissant aux fantaisies d'autruy. Il faut étendre la liberté de son jugement, et ne rien mettre dans sa tête par aucune autorité purement humaine. Quand on nous propose la diversité des opinions, il faut choisir s'il y a lieu ; sinon, il faut demeurer dans le doute."
                                            },
                                            {
                                                "example_id": "fc7bac8e-d7b8-4b67-8c1b-7d525913c314",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Mais lorsque Aimery mit pied à terre sur le trottoir de la gare, il lui resta encore un peu de doute, c'est à dire une espérance."
                                            },
                                            {
                                                "example_id": "b7b7074e-4501-462a-9ed8-41d3f51ece73",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "L'enfant devient adulte, entre autres, par l'apprentissage du doute."
                                            },
                                            {
                                                "example_id": "571a8333-b78f-48cc-9242-70f7534a24b6",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Personne ne répondit. Le doute flottait dans tous les esprits."
                                            },
                                            {
                                                "example_id": "7b96df9a-0474-4eda-9128-e62ebb4cd584",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "N’avoir aucun doute."
                                            },
                                            {
                                                "example_id": "dc3b9fa7-46df-4a39-b738-bf617fa62b48",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Lever un doute."
                                            },
                                            {
                                                "example_id": "23a6eb7b-c93e-4eff-92b6-ea953e520d1a",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Éclaircir un doute."
                                            },
                                            {
                                                "example_id": "70968b01-754e-4cc2-98e8-da7d3840988d",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Proposer ses doutes."
                                            },
                                            {
                                                "example_id": "ee4809a2-5a47-4dd1-9abf-9b0c3608d9a0",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Laisser un doute."
                                            },
                                            {
                                                "example_id": "83897f71-0c20-4e82-af70-4336ca1931e1",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Tirer, ôter, délivrer quelqu’un d’un doute."
                                            },
                                            {
                                                "example_id": "12686406-4910-4370-886a-f814cb34d963",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Nul doute, point de doute que cela ne soit."
                                            },
                                            {
                                                "example_id": "be97fb56-934f-4994-ba54-9fe3296ac77f",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Ce cas de conscience me laisse encore quelque doute."
                                            },
                                            {
                                                "example_id": "874721a5-a9df-407e-a921-70a3d4020978",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Maladie du doute, Maladie mentale caractérisée par la difficulté, parfois invincible, d’asseoir son esprit dans une certitude."
                                            },
                                            {
                                                "example_id": "f71ac496-ea90-4eec-9bfd-a9eae25f7483",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Mettre une chose en doute, la révoquer en doute, En contester la certitude."
                                            },
                                            {
                                                "example_id": "cf3fe4d3-9f57-4dea-8177-44c17d3f3b0f",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Ne faire aucun doute d’une chose, L’admettre comme certaine."
                                            },
                                            {
                                                "example_id": "14313ed5-47ad-4a97-91e0-c9bdf8e16500",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Hors de doute, Certain, hors de toute contestation."
                                            },
                                            {
                                                "example_id": "d8c6531f-1a96-45fc-b4e4-c883cba708cc",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Cela est hors de doute."
                                            },
                                            {
                                                "example_id": "5523227d-b2c9-44be-a241-e53d79cf9464",
                                                "sense_id": "eaf075e0-4f9c-3000-8d44-fad004ed28e5",
                                                "text": "Dans le doute, abstiens-toi, Quand on doute si une action est bonne ou mauvaise, utile ou nuisible, il ne faut pas agir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7659951c-a559-347d-8602-bb83c877f350",
                                        "entry_id": "a25740fa-9f10-3e6c-94ac-d23d9d194de9",
                                        "glosses": [
                                            "Méthode par laquelle l’esprit, suspendant son jugement, ne reçoit pour vrai que ce qu’il connaît évidemment être tel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3fb650d-300f-46c4-8394-13222173366e",
                                                "sense_id": "7659951c-a559-347d-8602-bb83c877f350",
                                                "text": "Le commencement de la philosophie pour Descartes, c’est le doute ; cela seul est toute sa méthode. C'est la proclamation du droit au libre examen. L'avenir de la philosophie est attaché à ce principe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b8e3a8e-560d-3032-be3a-ce860eb3fdce",
                                        "entry_id": "a25740fa-9f10-3e6c-94ac-d23d9d194de9",
                                        "glosses": [
                                            "État d’esprit de celui qui doute des vérités de la religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a56b7311-bfbf-4ef3-8d0e-7e11c32f38e8",
                                                "sense_id": "9b8e3a8e-560d-3032-be3a-ce860eb3fdce",
                                                "text": "Vivre dans le doute."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "doute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f698866-9203-3214-bfc9-30d7014c010b",
                                        "entry_id": "0da9983b-a275-3b61-8825-68c34f40d589",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de douter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c89ea42-0d6d-4407-a8f0-c59d81687b87",
                                                "sense_id": "2f698866-9203-3214-bfc9-30d7014c010b",
                                                "text": "Parfois, quand je suis seule, j’ai tendance à m’autoflageller, parce que je doute et je crains de ne pas y arriver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a702ff1a-5857-3d18-acf8-d55b395cfeea",
                                        "entry_id": "0da9983b-a275-3b61-8825-68c34f40d589",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de douter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfc85437-7d96-4202-9ada-4d3d1ed65052",
                                                "sense_id": "a702ff1a-5857-3d18-acf8-d55b395cfeea",
                                                "text": "Toutes boutiques à rue, largement ouvertes; le patient regarde le public qui circule, et ne se doute évidemment pas de la figure drôle qu’il fait quand on l’ensavonne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca581a43-3fbe-3f73-8dfd-21148259a767",
                                        "entry_id": "0da9983b-a275-3b61-8825-68c34f40d589",
