                    "frequency": "Middle",
                    "semantic_group_id": "physical_tightness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I felt my body <w>tense</w> up when I heard the loud crash.",
                            "target_lang_translations": {
                                "ru": "Я почувствовал, как моё тело <w>напряглось</w>, когда услышал громкий грохот.",
