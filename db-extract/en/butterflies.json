            {
                "entry_id": "2d09c35d-1c1b-335e-9981-449e3888f356",
                "word": "butterflies",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "28760fbd-9af3-396f-8df0-323537353652",
                        "entry_id": "2d09c35d-1c1b-335e-9981-449e3888f356",
                        "glosses": [
                            "Ellipsis of butterflies in one's stomach."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "ellipsis",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "d5aadb04-015a-4d3e-bd45-080d4c125adc",
                                "sense_id": "28760fbd-9af3-396f-8df0-323537353652",
                                "text": "And I wish that I could be with you tonight / 'Cause you give me butterflies"
                            },
                            {
                                "example_id": "7495956f-78e9-40ab-ba27-140dea80130d",
                                "sense_id": "28760fbd-9af3-396f-8df0-323537353652",
                                "text": "I was apprehensive, feeling butterflies, pissed, the sun cracking the flags."
                            },
                            {
                                "example_id": "4edbefbb-36d6-4b41-a167-2e9f676554c2",
                                "sense_id": "28760fbd-9af3-396f-8df0-323537353652",
                                "text": "Trying to ignore his butterflies, he looks down at his watch just about every minute to make sure he has the right time."
                            },
                            {
                                "example_id": "a70660d5-2e8e-4b2f-950e-e10edfbe7a5c",
                                "sense_id": "28760fbd-9af3-396f-8df0-323537353652",
                                "text": "I should be over all the butterflies / But I'm into you"
                            },
                            {
                                "example_id": "5402522b-6cb3-46fb-a659-af1dc365421e",
                                "sense_id": "28760fbd-9af3-396f-8df0-323537353652",
                                "text": "I'm getting butterflies, like what the hell? / When I'm still feeling right all by myself"
                            },
                            {
                                "example_id": "09584474-6715-4a9f-9088-f9b08900e179",
                                "sense_id": "28760fbd-9af3-396f-8df0-323537353652",
                                "text": "Attraction depends on several factors, including mystery and spontaneity—especially early on in the relationship. It’s what keeps those butterflies and the desire for more connection alive."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
