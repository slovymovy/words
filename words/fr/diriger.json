            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e9e33abe-0723-3456-b652-3ad905c7e3ac",
                    "sense_definition": "Administrer, commander une entreprise, une organisation ou un groupe de personnes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "commandement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle va <w>diriger</w> cette nouvelle équipe dès le mois prochain."
                        },
                        {
                            "text": "Ce patron exemplaire sait <w>diriger</w> une entreprise avec beaucoup de bienveillance."
                        }
                    ],
                    "synonyms": [
                        "administrer",
                        "commander",
                        "gérer",
                        "mener"
                    ],
                    "antonyms": [
                        "obéir",
                        "subir"
                    ],
                    "common_phrases": [
                        "diriger une entreprise",
                        "diriger une équipe"
                    ]
                },
                {
                    "sense_id": "78712bdd-4735-3546-bbf9-e461d8f5178e",
                    "sense_definition": "Aller dans une direction donnée, s'acheminer vers un endroit.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après le spectacle, les spectateurs commencent à se <w>diriger</w> vers la sortie."
                        },
                        {
                            "text": "Le voyageur fatigué se <w>dirige</w> vers l'hôtel le plus proche."
                        }
                    ],
                    "synonyms": [
                        "aller",
                        "s'acheminer"
                    ],
                    "antonyms": [
                        "s'éloigner"
                    ],
                    "common_phrases": [
                        "se diriger vers",
                        "se diriger vers la sortie"
                    ]
                },
                {
                    "sense_id": "5684b887-f9fe-34b8-9c10-ff51355a2ed0",
                    "sense_definition": "Guider la trajectoire d'un véhicule ou d'une embarcation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le capitaine parvient à <w>diriger</w> le navire à travers la violente tempête."
                        },
                        {
                            "text": "Il apprend patiemment à <w>diriger</w> un bateau sur cette rivière agitée."
                        }
                    ],
                    "synonyms": [
                        "conduire",
                        "manœuvrer",
                        "piloter"
                    ],
                    "common_phrases": [
                        "diriger un bateau",
                        "diriger un véhicule"
                    ]
                },
                {
                    "sense_id": "498a1e3c-4e8a-39f3-ac9a-c2c2d71f766e",
                    "sense_definition": "S'orienter, trouver son chemin dans un espace.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sans carte ni boussole, il est très difficile de se <w>diriger</w> dans cette forêt."
                        },
                        {
                            "text": "Grâce aux étoiles, les marins d'autrefois réussissaient à se <w>diriger</w> en pleine mer."
                        }
                    ],
                    "synonyms": [
                        "se repérer",
                        "s'orienter"
                    ],
                    "antonyms": [
                        "s'égarer",
                        "se perdre"
                    ],
                    "common_phrases": [
                        "se diriger facilement",
                        "se diriger dans le noir"
                    ]
                },
                {
                    "sense_id": "e71e7b67-bbee-3b35-82b7-3a724121b25c",
                    "sense_definition": "Tourner ou orienter un objet, son regard ou son attention vers quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orateur demande au public de <w>diriger</w> son attention vers l'écran géant."
                        },
                        {
                            "text": "Elle décide de <w>diriger</w> son regard vers la fenêtre pour admirer le paysage."
                        }
                    ],
                    "synonyms": [
                        "braquer",
                        "orienter",
                        "pointer"
                    ],
                    "antonyms": [
                        "détourner"
                    ],
                    "common_phrases": [
                        "diriger son attention",
                        "diriger son regard"
                    ]
                },
                {
                    "sense_id": "be34f571-0984-3222-8e10-f019adcaabf7",
                    "sense_definition": "Superviser l'organisation et le bon déroulement d'une action ou d'un projet.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "commandement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce professeur renommé continue de <w>diriger</w> les recherches scientifiques du laboratoire."
                        },
                        {
                            "text": "L'ingénieure en chef est chargée de <w>diriger</w> le chantier de construction."
                        }
                    ],
                    "synonyms": [
                        "coordonner",
                        "superviser"
                    ],
                    "common_phrases": [
                        "diriger des recherches",
                        "diriger les opérations"
                    ]
                },
                {
                    "sense_id": "690fe8e9-459a-369a-9b5a-8666547cf555",
                    "sense_definition": "Conseiller ou guider quelqu'un sur le plan intellectuel, moral ou spirituel.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "commandement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tuteur s'efforce de <w>diriger</w> l'étudiant avec méthode dans la rédaction de sa thèse."
                        },
                        {
                            "text": "Dans ce roman ancien, le prêtre cherchait à <w>diriger</w> la conscience de ses paroissiens."
                        }
                    ],
                    "synonyms": [
                        "conseiller",
                        "guider",
                        "orienter"
                    ],
                    "antonyms": [
                        "égarer"
                    ],
                    "common_phrases": [
                        "diriger la conscience",
                        "diriger un élève"
                    ]
                }
            ]
        }
    ]
