                "senses": [
                    {
                        "sense_id": "13f0d115-88f0-3cb7-a74b-7570d169645c",
                        "entry_id": "d62bf000-4dff-3e9f-b054-9b9ddfb5e381",
                        "glosses": [
                            "To go wrong; to stray."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "dd7ac8f3-786a-457f-b645-e2a27cf96861",
                                "sense_id": "13f0d115-88f0-3cb7-a74b-7570d169645c",
                                "text": "It sitteth not in no maner wyse / A thefe for theft to syt in iudgement, / A lecherous man a lechour to chastise, / Nor he that hath al his lyfe spent / In waste & riote forfeted and miswent."
                            },
                            {
                                "example_id": "9f67a8b6-7b00-43c9-ac0b-d07fe023f2eb",
                                "sense_id": "13f0d115-88f0-3cb7-a74b-7570d169645c",
                                "text": "I now forsake the former tyme I spent. / And sorie am, for that I was miswent."
                            },
                            {
                                "example_id": "affef244-4e10-484c-831d-d2c904cadaad",
                                "sense_id": "13f0d115-88f0-3cb7-a74b-7570d169645c",
                                "text": "But things miscounselled must needs miswend."
                            }
                        ]
                    }
                ],
