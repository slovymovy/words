{
    "word_family": [
        "offre",
        "offrande",
        "offreur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc458799-2ea1-3ca3-8e63-e8c28d554524",
                    "sense_definition": "Donner quelque chose à quelqu'un en cadeau ou par politesse.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "donner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour son anniversaire, nous allons lui <w>offrir</w> un joli cadeau."
                        },
                        {
                            "text": "Mon collègue a voulu m'<w>offrir</w> un café après la longue réunion."
                        }
                    ],
                    "synonyms": [
                        "donner"
                    ],
                    "common_phrases": [
                        "offrir un cadeau",
                        "offrir un verre",
                        "offrir des fleurs"
                    ]
                },
                {
                    "sense_id": "0976ef4f-6e07-3561-8c8f-4676d0ff0076",
                    "sense_definition": "Proposer à quelqu'un de faire ou de lui procurer quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "proposer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a gentiment décidé d'<w>offrir</w> son aide pour porter nos lourdes valises."
                        },
                        {
                            "text": "Le directeur nous <w>offre</w> la possibilité de participer à ce nouveau projet."
                        }
                    ],
                    "synonyms": [
                        "proposer"
                    ],
                    "antonyms": [
                        "demander"
                    ],
                    "common_phrases": [
                        "offrir son aide",
                        "offrir ses services"
                    ]
                },
                {
                    "sense_id": "7b2b5c6b-48cc-3594-9f63-f1dd157e0a43",
                    "sense_definition": "Présenter, procurer ou mettre à disposition un avantage, une vue ou une opportunité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "procurer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La terrasse de notre hôtel <w>offre</w> un panorama exceptionnel sur la baie."
                        },
                        {
                            "text": "Cette formation spécialisée <w>offre</w> des débouchés professionnels variés à tous les étudiants."
                        }
                    ],
                    "synonyms": [
                        "fournir",
                        "procurer",
                        "présenter"
                    ],
                    "common_phrases": [
                        "offrir une vue",
                        "offrir des possibilités",
                        "offrir des garanties"
                    ]
                },
                {
                    "sense_id": "89337a04-0611-383a-94e7-3f85ef3982fc",
                    "sense_definition": "S'accorder le plaisir d'acheter ou de vivre quelque chose d'agréable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "se_payer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des mois d'efforts intenses, ils ont choisi de s'<w>offrir</w> des vacances reposantes."
                        },
                        {
                            "text": "Pour célébrer sa promotion, Paul s'est <w>offert</w> une montre de collection magnifique."
                        }
                    ],
                    "synonyms": [
                        "s'accorder",
                        "s'octroyer"
                    ],
                    "common_phrases": [
                        "s'offrir un voyage",
                        "s'offrir un luxe"
                    ]
                },
                {
                    "sense_id": "b1df3388-1946-3d39-9e77-10d7ba5eb63f",
                    "sense_definition": "Faire un don, un sacrifice ou une prière en hommage à une divinité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans l'Antiquité, les prêtres venaient <w>offrir</w> des sacrifices aux divinités du temple."
                        },
                        {
                            "text": "Les fidèles venaient <w>offrir</w> des prières ferventes pour demander la protection divine."
                        }
                    ],
                    "synonyms": [
                        "sacrifier",
                        "vouer"
                    ],
                    "common_phrases": [
                        "offrir des sacrifices"
                    ]
                }
            ]
        }
    ]
}