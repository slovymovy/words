                        "glosses": [
                            "Influencer en utilisant la publicité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9625b225-e069-4fff-aefa-b64934b69c0b",
                                "sense_id": "d96126d0-e74c-3a8c-84d6-8cc8576b8bd3",
                                "text": "Marcus ne la jugeait pas. Lui aussi s’était fait empuber."
                            },
                            {
                                "example_id": "d3b10923-5a07-4763-8841-25e93b33cc22",
                                "sense_id": "d96126d0-e74c-3a8c-84d6-8cc8576b8bd3",
                                "text": "Et voilà que mon blog se fait empuber par le blog de Sarkozy, mais avec une publicité contextuelle des plus étranges."
                            },
                            {
                                "example_id": "5fe79928-6f74-4b95-b18a-ff7691acfe4a",
                                "sense_id": "d96126d0-e74c-3a8c-84d6-8cc8576b8bd3",
                                "text": "Parce que c'est un média de masse qui permet d'empuber efficacement les cibles (c-à-d : usagers manipulés par la publicité)."
                            },
                            {
                                "example_id": "2bd3ba09-da69-4cc9-9b49-e247319d5a51",
                                "sense_id": "d96126d0-e74c-3a8c-84d6-8cc8576b8bd3",
                                "text": "On va te polluer, on va t'empuber (bis)."
                            }
                        ]
                    }
