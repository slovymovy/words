                "translations": [
                    {
                        "translation_id": "9a3231e7-081e-4840-be92-dbaee2013981",
                        "source_entry_id": "009e0bf4-7a1f-32a9-a92e-fa7dd7ba9c22",
                        "source_sense_id": "99a062a0-b124-3b27-b54b-751c3273f928",
                        "target_lang_word": "ресурс",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ресурс",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "92a8ed62-60c1-33a8-9974-59dd65c5982e",
                                        "entry_id": "6ae7275b-a881-3014-b3be-f627ae067bf7",
                                        "glosses": [
                                            "запас, источник чего-либо, используемый при необходимости"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e3ab3bf-068f-4b25-a782-7c89150698d8",
                                                "sense_id": "92a8ed62-60c1-33a8-9974-59dd65c5982e",
                                                "text": "Истощение ресурсов пресной воды — одна из самых острых проблем на сегодняшний день."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c95c2e69-05a8-3f98-9970-bb0ac0afd3c9",
                                        "entry_id": "6ae7275b-a881-3014-b3be-f627ae067bf7",
                                        "glosses": [
                                            "средство, возможность для осуществления чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5588084b-dd4b-4353-95d4-238bd313d132",
                                                "sense_id": "c95c2e69-05a8-3f98-9970-bb0ac0afd3c9",
                                                "text": "Для своевременного выполнения первичной обработки материалов переписи населения в ГМЦ Госкомстата России были задействованы все возможные для этого ресурсы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c0f3062-ce4c-3518-8797-f52ed3cb85c7",
                                        "entry_id": "6ae7275b-a881-3014-b3be-f627ae067bf7",
                                        "glosses": [
                                            "техн. возможная продолжительность эксплуатации машины, указываемая в её техническом паспорте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fca400db-8e75-45a6-a2b0-336d76640915",
                                                "sense_id": "1c0f3062-ce4c-3518-8797-f52ed3cb85c7",
                                                "text": "И оператору нужны данные о производительности агрегатов, об их ресурсе, о себестоимости продукции — о сложных показателях, зависящих от многих факторов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff87753d-bb1f-3e2e-a750-675a6a61dea6",
                                        "entry_id": "6ae7275b-a881-3014-b3be-f627ae067bf7",
                                        "glosses": [
                                            "интернет. журн. веб-сайт или веб-сервис, являющийся источником информации или услуг"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cd8b13e-92b2-405b-ac93-e76b9cafc3ab",
                                                "sense_id": "ff87753d-bb1f-3e2e-a750-675a6a61dea6",
                                                "text": "«„Википедия“ у нас в поисковой выдаче отмечается как ресурс, который нарушает требования Роскомнадзора. Наша главная задача — иметь собственный портал. Мы его создаём — портал „Знания“. ❬…❭ Дальше мы будем просить, чтобы именно российский ресурс был приоритизирован в поисковой выдаче, чтобы он всегда был выше „Википедии“», — отметил глава Минцифры."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
