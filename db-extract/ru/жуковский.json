                        "examples": [
                            {
                                "example_id": "7cdfee85-5598-4147-baf3-2257cf399ecc",
                                "sense_id": "1ceaae68-a230-347e-848e-82dc38549083",
                                "text": "Николай Жуковский.",
                                "translation": "Nikolaï Joukovski."
                            },
                            {
                                "example_id": "25f99846-fda6-4834-b4ac-ded0a5cc9542",
                                "sense_id": "1ceaae68-a230-347e-848e-82dc38549083",
                                "text": "«Я был масон кишиневской ложи, т. е. той, за которую уничтожили в России все ложи», — писал А. С. Пушкин В. А. Жуковскому в 1826 г.",
                                "translation": "« J'étais maçon de la loge de Chisinau, c'est-à-dire celle pour laquelle toutes les loges de Russie ont été dissoutes », écrivait Pouchkine à Vassili Joukovski, en 1826."
                            }
                        ]
                    }
