                ],
                "senses": [
                    {
                        "sense_id": "83ecf9d3-c783-3ff1-8f13-be9ab6d29ec0",
                        "entry_id": "fc27027f-b2ad-3ca2-afbd-8bb93efe57de",
                        "glosses": [
                            "Ministère (jusqu’au concile Vatican II : ordre mineur) dans l’Église consistant à servir à l’autel le prêtre et le diacre lors des célébrations liturgiques"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e04150c-9608-4e66-9024-ac9241999ec0",
                                "sense_id": "83ecf9d3-c783-3ff1-8f13-be9ab6d29ec0",
                                "text": "Selon la Tradition, le lectorat et l'acolytat faisaient partie des ordres mineurs qui donnaient accès aux ordres majeurs."
                            },
                            {
                                "example_id": "cd6c2c57-38f6-4110-ad3b-bb863b43a46c",
                                "sense_id": "83ecf9d3-c783-3ff1-8f13-be9ab6d29ec0",
                                "text": "Par le motu proprio Spiritus Domini du 20 jan. 2021, le pape François a supprimé la clause de réservation aux hommes des ministères institués du lectorat et de l’acolytat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abbb30ed-4001-4136-be4b-12b5e35a194a",
                        "source_entry_id": "fc27027f-b2ad-3ca2-afbd-8bb93efe57de",
                        "source_sense_id": "83ecf9d3-c783-3ff1-8f13-be9ab6d29ec0",
                        "target_lang_word": "Akolythat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akolythat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf11f998-aad3-3bd5-8cc5-830198988dc9",
                                        "entry_id": "73ae812b-e596-319d-be6f-54916596d1b0",
                                        "glosses": [
                                            "assistierender liturgischer Dienst bei der Eucharistiefeier (Dienstamt des Akolythen)"
                                        ],
                                        "tags": [
                                            "katholische",
                                            "Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "728916a0-b03a-44f6-abfa-ece851a292c3",
                                                "sense_id": "cf11f998-aad3-3bd5-8cc5-830198988dc9",
                                                "text": "„1972 wird der entsprechende Weihegrad aufgehoben, der Akolythat aber (ähnlich wie beim Lektorat) als liturgischer Dienst beibehalten.“"
                                            },
                                            {
                                                "example_id": "b8185459-38ca-481c-a837-86eb8a6ac8ce",
                                                "sense_id": "cf11f998-aad3-3bd5-8cc5-830198988dc9",
                                                "text": "„Das ist nur eine, freilich besonders akzentuierte Stellungnahme unter vielen anderen, und es ist fraglich, ob man auf Dauer den Akolythat und den Lektorat in der von ›Ministeria quaedam‹ vorgesehenen Form aufrecht erhalten kann und soll.“"
                                            },
                                            {
                                                "example_id": "ad3db453-c4fb-42ba-ae40-0e1d8416007b",
                                                "sense_id": "cf11f998-aad3-3bd5-8cc5-830198988dc9",
                                                "text": "„Im CIC von 1917 waren das Lektorat und das Akolythat niedere Weihestufen und standen deshalb nur Männern offen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
