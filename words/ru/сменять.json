    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef6210ae-a227-32da-8885-35139d0b62eb",
                    "sense_definition": "заменять один предмет или объект другим",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "replacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пришло время <w>сменять</w> старую квартиру на новую в другом районе города.",
                            "target_lang_translations": {
                                "pl": "Przyszedł czas, aby <w>wymienić</w> stare mieszkanie na nowe w innej dzielnicy miasta."
                            }
                        },
                        {
                            "text": "Нам нужно <w>сменять</w> перегоревшие лампочки в коридоре на новые.",
                            "target_lang_translations": {
                                "pl": "Musimy <w>wymienić</w> przepalone żarówki na korytarzu na nowe."
                            }
                        }
                    ],
                    "synonyms": [
                        "заменять",
                        "обменивать"
                    ],
                    "common_phrases": [
                        "сменять квартиру",
                        "сменять лампочку"
                    ],
                    "target_lang_definitions": {
                        "pl": "zastępować jedną rzecz lub obiekt innym, wymieniać coś na coś innego"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wymieniać",
                                "target_lang_sense_clarification": "zastępowanie jednej rzeczy drugą"
                            },
                            {
                                "target_lang_word": "zamieniać",
                                "target_lang_sense_clarification": "zastępowanie czegoś czymś innym"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ebdab52-3a40-39a1-9f59-5b572f89a883",
                    "sense_definition": "приходить на место кого-либо или чего-либо, чередоваться",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "replacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Солнечные дни часто <w>сменяют</w> пасмурные в это время года.",
                            "target_lang_translations": {
                                "pl": "Słoneczne dni często <w>zmieniają</w> pochmurne o tej porze roku."
                            }
                        },
                        {
                            "text": "Новая смена рабочих должна <w>сменять</w> уставших коллег на посту.",
                            "target_lang_translations": {
                                "pl": "Nowa zmiana pracowników powinna <w>zastąpić</w> zmęczonych kolegów na stanowisku."
                            }
                        }
                    ],
                    "synonyms": [
                        "чередоваться",
                        "замещать",
                        "заменять"
                    ],
                    "common_phrases": [
                        "сменять друг друга"
                    ],
                    "target_lang_definitions": {
                        "pl": "zajmować czyjeś miejsce, następować po kimś lub czymś, zmieniać się nawzajem"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zmieniać",
                                "target_lang_sense_clarification": "zastępowanie kogoś w pracy lub następstwo w czasie"
                            },
                            {
                                "target_lang_word": "zastępować",
                                "target_lang_sense_clarification": "przejmowanie czyichś obowiązków lub miejsca"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}