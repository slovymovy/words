                "forms": [],
                "senses": [
                    {
                        "sense_id": "bdf1e50e-7e1f-350b-81a0-91bb73eeebdd",
                        "entry_id": "7c716123-74f8-322b-80b3-959bd38a6add",
                        "glosses": [
                            "punkt podziału, przerwa intonacyjna, która dzieli wers na dwa w przybliżeniu równe człony"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4af8cfe3-df40-3dee-acf1-1d2904ea7c57",
                        "entry_id": "7c716123-74f8-322b-80b3-959bd38a6add",
                        "glosses": [
                            "nadbudówka w środkowej części statku"
                        ],
                        "tags": [],
