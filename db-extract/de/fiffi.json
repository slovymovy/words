                        "examples": [
                            {
                                "example_id": "0cc5d126-e0f6-44aa-aa00-c710137022b1",
                                "sense_id": "e3ae3cd7-57ac-32fd-a80d-10ef648ad462",
                                "text": "Ein Mann kommt vorbei, an der Leine ein kleiner Fiffi."
                            },
                            {
                                "example_id": "d59be8d4-dab8-45d7-ba45-839123ada890",
                                "sense_id": "e3ae3cd7-57ac-32fd-a80d-10ef648ad462",
                                "text": "Das Problem bei beidem: Mein innerer Schweinehund, der kein „kleiner Fiffi“ ist, sondern stark an meine 35-kg-Dogge erinnert, vor der selbst große Männer wie Michael oder Felix Angst haben."
                            },
                            {
                                "example_id": "ae24fcf7-621a-4c1d-a86b-24f5678af597",
                                "sense_id": "e3ae3cd7-57ac-32fd-a80d-10ef648ad462",
                                "text": "Wer mit seinem Fiffi ohne Leine Gassi gehen will, muss meist an den Stadtrand ausweichen."
                            }
                        ]
                    }
