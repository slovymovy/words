                ],
                "senses": [
                    {
                        "sense_id": "e8744fe5-e7d6-3586-9c1a-99ae71c8b87d",
                        "entry_id": "e7647e5f-dc0e-3aa6-aeb8-223cf2a7b734",
                        "glosses": [
                            "grundsätzliche Einstellung zu wesentlichen Aspekten des Geschehens, des Lebens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9744185f-cddd-46c6-9098-8098240bd38e",
                                "sense_id": "e8744fe5-e7d6-3586-9c1a-99ae71c8b87d",
                                "text": "„Genau diese Geisteshaltung erwies sich in der Form des Nationalsozialismus als tödlich und führte die Deutschen in die Katastrophe des totalen Krieges und der totalen Niederlage.“"
                            },
                            {
                                "example_id": "afa51ef9-81d0-409c-bc3c-bb09a23ec06c",
                                "sense_id": "e8744fe5-e7d6-3586-9c1a-99ae71c8b87d",
                                "text": "„Aber diese Geisteshaltung steckt genauso hinter Genfeldzerstörungen, Hausbesetzungen, Molotow-Cocktails und jahrzehntelanger Fernsehfolter durch »Das Wort zum Sonntag«.“"
                            },
                            {
                                "example_id": "975fb8ec-cf43-41e1-857d-c0c2a94da6d7",
                                "sense_id": "e8744fe5-e7d6-3586-9c1a-99ae71c8b87d",
                                "text": "„Die deutsche Geisteshaltung hatte schon immer eine Tendenz dazu, in dieser Hinsicht labil, chiliastisch, verworren und chaotisch zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
