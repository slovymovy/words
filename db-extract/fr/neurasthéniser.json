                "senses": [
                    {
                        "sense_id": "75079b91-14f1-320a-ab8f-e2946260f5db",
                        "entry_id": "bc03bdd3-e9e6-3604-a435-336970f7feb6",
                        "glosses": [
                            "Rendre neurasthénique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98e6e164-2eb4-4fff-a316-8208bccc89e1",
                                "sense_id": "75079b91-14f1-320a-ab8f-e2946260f5db",
                                "text": "Ça me neurasthénise."
                            },
                            {
                                "example_id": "45c4a335-2a88-45e0-9870-e568af09556b",
                                "sense_id": "75079b91-14f1-320a-ab8f-e2946260f5db",
                                "text": "Il chagrine. Il lymphatise. Il neurasthénise. Il léthargise."
                            },
                            {
                                "example_id": "795fd6f9-b171-4c6f-9a07-0ed2c5ca670e",
                                "sense_id": "75079b91-14f1-320a-ab8f-e2946260f5db",
                                "text": "Sinon le PtiGro va continuer à (nous) neurasthéniser avec sa bande de potes dépressifs plus ou moins anonymes du conseil des sinistres, à vouloir faire la guerre au monde entier de Tombouctou à Moscou via Bangui et Bagdad pour se passer les nerfs, à raconter des méchancetés sur tout le monde en grinçant des dents, à fumer des trucs bizarres à force de ne fréquenter que le demi-monde."
                            }
                        ]
                    }
