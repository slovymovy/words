                                        "glosses": [
                                            "aleatorietà di una variabile oppure la particolare variabilità di quei processi, detti appunto processi stocastici, il cui sviluppo nel tempo è governato da leggi probabilistiche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4387003b-5220-496c-8a12-86c946fe6033",
                                                "sense_id": "537aadf1-e76e-315d-af60-1ffabd97c1ac",
                                                "text": "se P(A|B)=P(A) [probabilità di A dato B = probabilità di A] allora A è stocasticamente indipendente da B"
