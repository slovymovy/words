    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7cde4539-9bf7-3fdb-aaf3-29a604a58c2f",
                "word": "reinsurance",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dee60268-ffcd-410f-a854-4ba53fe07ba1",
                        "entry_id": "7cde4539-9bf7-3fdb-aaf3-29a604a58c2f",
                        "tags": [
                            "plural"
                        ],
                        "form": "reinsurances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0713e32c-724f-3441-9907-4edd3d9c05c2",
                        "entry_id": "7cde4539-9bf7-3fdb-aaf3-29a604a58c2f",
                        "glosses": [
                            "Insurance purchased by insurance companies that spreads the risk associated with selling insurance around so the danger of one large monetary loss is minimized."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9738198e-80d0-47af-8de6-e732b50998fa",
                                "sense_id": "0713e32c-724f-3441-9907-4edd3d9c05c2",
                                "text": "Catastrophe modeling firm AIR Worldwide (AIR) today announced that Sompo International, a global specialty provider of property and casualty insurance and reinsurance, is leveraging AIR's casualty analytics platform, Arium, to better understand and quantify its liability and loss potential across multiple commercial liability lines of business."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d839da0e-6ee0-447e-b8cc-05dd487f96a0",
                        "source_entry_id": "7cde4539-9bf7-3fdb-aaf3-29a604a58c2f",
                        "source_sense_id": "0713e32c-724f-3441-9907-4edd3d9c05c2",
                        "source_sense_description": "insurance purchased by insurance companies",
                        "target_lang_word": "herverzekering",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herverzekering",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b7a9feb0-19b6-36b6-9c3e-32d85b1867b3",
                                        "entry_id": "3b9c5be2-8a5c-3605-91ed-74e430ad7d13",
                                        "glosses": [
                                            "het risico van een verzekering die door een andere verzekeringsmaatschappij wordt overgenomen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d19a6107-e47d-4a36-84f0-d9a73d6621ef",
                                                "sense_id": "b7a9feb0-19b6-36b6-9c3e-32d85b1867b3",
                                                "text": "Honderdduizenden zzp'ers maakten gebruik van de Tijdelijke Overbruggingsregeling Ondernemers (TOZO). Leveringen aan winkeliers en horeca-ondernemers bleven in stand door de herverzekering van leverancierskredieten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dceeb32-0835-359f-9479-dad3d05df0cf",
                                        "entry_id": "3b9c5be2-8a5c-3605-91ed-74e430ad7d13",
                                        "glosses": [
                                            "het afsluiten van een extra verzekering"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bacbc72a-b32c-4b6c-b080-a60fd5212d83",
                                                "sense_id": "6dceeb32-0835-359f-9479-dad3d05df0cf",
                                                "text": "Serry was in 1992 de eerste Nederlandse ambassadeur in Kiev, nadat in 1991 de Sovjet Unie uit elkaar was gevallen en Oekraïne onafhankelijk was geworden. \"Dit kan genoeg zijn voor Poetin. Dat is wat in de komende dagen zal blijken. Dan doet hij eigenlijk hetzelfde als wat hij heeft gedaan in Georgië en ook in Moldavië, waar je ook van die republieken hebt die door Rusland worden gesteund. En daarmee neemt hij misschien een soort herverzekering dat Oekraïne geen lid kan worden van de NAVO, omdat de NAVO dat meestal niet doet als er territoriale geschillen zijn. Maar het scenario dat het hierbij niet blijft en de oorlog begint in de Donbas is ook zeer wel denkbaar.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a160d2b5-8948-48e5-9cbf-12dbea82bffc",
                        "source_entry_id": "7cde4539-9bf7-3fdb-aaf3-29a604a58c2f",
                        "source_sense_id": "0713e32c-724f-3441-9907-4edd3d9c05c2",
                        "source_sense_description": "insurance purchased by insurance companies",
                        "target_lang_word": "réassurance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réassurance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96a797ef-db17-3725-84ac-465552abddae",
                                        "entry_id": "fa9e49d9-8658-361d-8dc9-3673c0ae0736",
                                        "glosses": [
                                            "Contre-assurance ; assurance par laquelle l’assureur se prémunit lui-même contre les risques dont il est chargé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b17d5155-7166-4193-b11d-a071a6671fd6",
                                                "sense_id": "96a797ef-db17-3725-84ac-465552abddae",
                                                "text": "L'américain AIG, très présent en Asie, chiffre ainsi à 700 millions de dollars les indemnités qu'il pourrait être amené à verser aux assurés. Sans compter sa participation à un pool de réassurance japonais du risque sismique."
                                            },
                                            {
                                                "example_id": "84beeec8-1262-4a0b-9cab-5be287cc518c",
                                                "sense_id": "96a797ef-db17-3725-84ac-465552abddae",
                                                "text": "La « réassurance » est le métier de puissantes sociétés financières qui, en assurant les compagnies d’assurance, leur permettent de se refinancer en cas de gros pépin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58a2e857-f664-3cad-bb7e-53d6d90f0df6",
                                        "entry_id": "fa9e49d9-8658-361d-8dc9-3673c0ae0736",
                                        "glosses": [
                                            "Action de rassurer, de conforter quelqu'un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49a2c58a-3e76-4a10-bd95-4bd5c2d3e592",
                                                "sense_id": "58a2e857-f664-3cad-bb7e-53d6d90f0df6",
                                                "text": "Simone, habituée de ces consultations, reconnaît qu'elles deviennent lieu de parole, d'humanité et de réassurance."
                                            },
                                            {
                                                "example_id": "6b6c24dc-1395-4599-a31a-9567d4ffa1c9",
                                                "sense_id": "58a2e857-f664-3cad-bb7e-53d6d90f0df6",
                                                "text": "« Il y a une forme d'impatience, diagnostique un conseiller du chef de l'État. Les gens n'attendent pas des choses extraordinaires, mais une très grande rapidité et une efficacité. Ils sont en attente de réassurance de l'État, d'action de l'exécutif. » — (Le Monde, 30 août 2012)"
                                            },
                                            {
                                                "example_id": "b992963e-0b14-4a33-a3e1-8ddb58716212",
                                                "sense_id": "58a2e857-f664-3cad-bb7e-53d6d90f0df6",
                                                "text": "Il est enfin souvent difficile à cet autre, émotif et très amoureux, d'éviter une émotion qui empêche l'érection lors des premières relations. Avec l'habitude et la réassurance de la partenaire, la confiance revient vite et la sexualité est en général mieux assumée par la suite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff5007ee-0c45-497e-8a6e-93ac03473077",
                        "source_entry_id": "7cde4539-9bf7-3fdb-aaf3-29a604a58c2f",
                        "source_sense_id": "0713e32c-724f-3441-9907-4edd3d9c05c2",
                        "source_sense_description": "insurance purchased by insurance companies",
                        "target_lang_word": "Rückversicherung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rückversicherung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c8489b2-1d40-3bcf-8b54-dd339ea70353",
                                        "entry_id": "0fff59ae-2c83-3923-85d5-38328efd506f",
                                        "glosses": [
                                            "Vereinbarung, die der Absicherung von Risiken dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb5b69af-5021-44e9-8f94-0fd2a5bc8b30",
                                                "sense_id": "1c8489b2-1d40-3bcf-8b54-dd339ea70353",
                                                "text": "„Rückversicherungen tragen dadurch, dass sie die Last des Risikos auf mehrere Versicherer verteilen, zur größeren Stetigkeit und Sicherheit des Geschäfts bei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc7eb4b4-97f5-39c0-9ab3-90ef30a83a87",
                                        "entry_id": "0fff59ae-2c83-3923-85d5-38328efd506f",
                                        "glosses": [
                                            "Unternehmen (Versicherung), das andere Versicherungen (Erstversicherungen) gegen deren Risiken absichert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c7c6cca-10c7-4aa6-8286-cfee10a17494",
                                                "sense_id": "bc7eb4b4-97f5-39c0-9ab3-90ef30a83a87",
                                                "text": "Die Münchener Rück ist eine der größten Rückversicherungen der Welt."
                                            },
                                            {
                                                "example_id": "a1d772dd-0c5e-4071-9d3b-b880bb3223c2",
                                                "sense_id": "bc7eb4b4-97f5-39c0-9ab3-90ef30a83a87",
                                                "text": "„Insgesamt starben 2004 nach Angaben der Rückversicherung mindestens 15.000 Menschen durch Wirbelstürme, Erdbeben und andere Naturkatastrophen, ohne dass dabei bereits die Folgen der Tsunamis in Südasien berücksichtigt waren.“"
                                            },
                                            {
                                                "example_id": "034954a2-70bc-4a9a-b155-6aa50cc174ab",
                                                "sense_id": "bc7eb4b4-97f5-39c0-9ab3-90ef30a83a87",
                                                "text": "„Gibt eine Rückversicherung Teile ihrer übernommenen Risiken an andere Versicherer weiter, spricht man von Weiterrückversicherung (Retrozession bzw. Retrozessionaren).“"
                                            },
                                            {
                                                "example_id": "21159a3b-66c7-4960-b10a-851b8d44c3f3",
                                                "sense_id": "bc7eb4b4-97f5-39c0-9ab3-90ef30a83a87",
                                                "text": "„Die Rückversicherung Munich Re erwartet nach den schweren Überschwemmungen in Thailand Kosten von etwa 500 Mio. Euro.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
