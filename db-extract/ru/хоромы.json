                "senses": [
                    {
                        "sense_id": "a097f9de-2f4e-354f-b0c2-f00d38f4e89c",
                        "entry_id": "1dbbec2b-a3be-39ae-89d5-cb67e105b81c",
                        "glosses": [
                            "a large wooden house in traditional Russian architecture, especially if composed of separate heated sections connected by unheated walkways and halls"
                        ],
                        "tags": [
                            "historical",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "3626d820-6d07-48f7-acc8-3c1a78b9dcbb",
                                "sense_id": "a097f9de-2f4e-354f-b0c2-f00d38f4e89c",
                                "text": "Выраже́ние лица́ его́ соверше́нно измени́лось. Так изменя́ется зда́ние по́сле пожа́ра. Ещё́ стоя́т хоро́мы, но украше́ния упа́ли, мра́чные о́кна глядя́т злове́щим взо́ром, и в пусты́х поко́ях посели́лось недо́брое.",
                                "translation": "Aleksey Konstantinovich Tolstoy",
                                "english": "Aleksey Konstantinovich Tolstoy"
                            }
                        ]
                    },
                    {
                        "sense_id": "0fa6827e-0b14-333a-b200-0ac14c508bd4",
                        "entry_id": "1dbbec2b-a3be-39ae-89d5-cb67e105b81c",
                        "glosses": [
                            "mansion, palace"
                        ],
                        "tags": [
                            "dated",
                            "figuratively",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "0be3ec62-0451-4046-a404-95b4926faf0f",
                                "sense_id": "0fa6827e-0b14-333a-b200-0ac14c508bd4",
                                "text": "ца́рские хоро́мы",
                                "translation": "royal residence/palace",
                                "english": "royal residence/palace"
                            },
                            {
                                "example_id": "664357c5-9e1e-4e2c-8006-e01f816353c8",
                                "sense_id": "0fa6827e-0b14-333a-b200-0ac14c508bd4",
                                "text": "у них не кварти́ра, а хоро́мы",
                                "translation": "their flat/apartment is a real palace",
                                "english": "their flat/apartment is a real palace"
                            }
                        ]
