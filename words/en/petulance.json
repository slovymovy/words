{
    "word_family": [
        "petulant",
        "petulantly",
        "petulancy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "df425096-93ee-332e-9c5c-21146bef2633",
                    "sense_definition": "The quality of being childishly sulky, bad-tempered, or impatient.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bad_temper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He reacted with surprising <w>petulance</w> when his request for more time was denied.",
                            "target_lang_translations": {
                                "de": "Er reagierte mit überraschender <w>Gereiztheit</w>, als seine Bitte um mehr Zeit abgelehnt wurde."
                            }
                        },
                        {
                            "text": "Tired of her child's constant <w>petulance</w>, she decided to end the shopping trip early.",
                            "target_lang_translations": {
                                "de": "Müde von der ständigen <w>Trotzigkeit</w> ihres Kindes beschloss sie, den Einkaufsbummel vorzeitig zu beenden."
                            }
                        }
                    ],
                    "synonyms": [
                        "moodiness",
                        "tetchiness"
                    ],
                    "antonyms": [
                        "patience",
                        "good humor"
                    ],
                    "common_phrases": [
                        "display of petulance",
                        "fit of petulance",
                        "childish petulance"
                    ],
                    "target_lang_definitions": {
                        "de": "Die Eigenschaft, kindisch schmollend, schlecht gelaunt oder ungeduldig zu sein."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gereiztheit",
                                "target_lang_sense_clarification": "Zustand ungeduldiger oder nervöser Verstimmung"
                            },
                            {
                                "target_lang_word": "Launenhaftigkeit",
                                "target_lang_sense_clarification": "Neigung zu sprunghafter und schlechter Laune"
                            },
                            {
                                "target_lang_word": "Trotzigkeit",
                                "target_lang_sense_clarification": "kindisches Schmollen oder Widerspenstigkeit"
                            },
                            {
                                "target_lang_word": "Quengeligkeitsgefühl",
                                "target_lang_sense_clarification": "kindliche Unruhe oder Unzufriedenheit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a51e95ff-6942-38ea-8925-24cf125ad491",
                    "sense_definition": "The quality or state of being rude, insolent, or disrespectful.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insolence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager refused to tolerate such outright <w>petulance</w> from a member of the staff.",
                            "target_lang_translations": {
                                "de": "Der Vorgesetzte weigerte sich, eine derart unverhohlene <w>Unverschämtheit</w> von einem Mitarbeiter zu dulden."
                            }
                        },
                        {
                            "text": "His aristocratic pride often manifested as contemptuous <w>petulance</w> toward those he deemed inferior.",
                            "target_lang_translations": {
                                "de": "Sein aristokratischer Stolz äußerte sich oft als herablassende <w>Anmaßung</w> gegenüber denjenigen, die er für minderwertig hielt."
                            }
                        }
                    ],
                    "antonyms": [
                        "politeness",
                        "respectfulness"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sense of insolence or impertinence is largely historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Die Eigenschaft oder Haltung, unverschämt, anmaßend oder respektlos zu sein (oft veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Anmaßung",
                                "target_lang_sense_clarification": "freches oder respektloses Auftreten"
                            },
                            {
                                "target_lang_word": "Unverschämtheit",
                                "target_lang_sense_clarification": "dreistes oder rüpelhaftes Benehmen"
                            },
                            {
                                "target_lang_word": "Frechheit",
                                "target_lang_sense_clarification": "respektloses Verhalten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcf07f82-4a5d-399e-9988-37834b2acfd5",
                    "sense_definition": "An insolent or childishly irritable remark or action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insolence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He apologized sincerely for the sudden <w>petulance</w> that had escaped his lips during the argument.",
                            "target_lang_translations": {
                                "de": "Er entschuldigte sich aufrichtig für die plötzliche <w>Entgleisung</w>, die ihm während des Streits herausgerutscht war."
                            }
                        },
                        {
                            "text": "Such petty <w>petulances</w> will only serve to alienate your remaining supporters.",
                            "target_lang_translations": {
                                "de": "Solche kleinlichen <w>Frechheiten</w> werden deine verbliebenen Unterstützer nur vor den Kopf stoßen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "countable usage denoting a specific insolent remark or act"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine respektlose, unverschämte oder kindisch gereizte Äußerung oder Handlung (zählbare Verwendung)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Unverschämtheit",
                                "target_lang_sense_clarification": "eine einzelne dreiste Bemerkung oder Tat"
                            },
                            {
                                "target_lang_word": "Entgleisung",
                                "target_lang_sense_clarification": "eine gereizte oder taktlose Bemerkung"
                            },
                            {
                                "target_lang_word": "Frechheit",
                                "target_lang_sense_clarification": "eine unverschämte Äußerung oder Tat"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}