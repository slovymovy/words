                "senses": [
                    {
                        "sense_id": "fa70bc05-2821-3fe5-916a-6d98022774d7",
                        "entry_id": "1a232204-9911-32f1-b1e5-3e6d0e5055e0",
                        "glosses": [
                            "Summe der momentanen Umstände im Bezug auf die Lüftung, die bestimmend auf eventuelles Handeln einwirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5191aa6-12bf-4877-b8ce-1a984e2677c5",
                                "sense_id": "fa70bc05-2821-3fe5-916a-6d98022774d7",
                                "text": "„In jedem Fall beeinflussen kann man die Lüftungssituation, womit wir beim Punkt „Raumluft positiv beeinflussen\" wären: Um Energie zu sparen, machen dichte Fenster natürlich Sinn, und laut Tappler sei dies auch von der Bauordnung so vorgeschrieben.“"
                            },
                            {
                                "example_id": "45ebb6af-acab-4dbb-9d05-29b80869b3e7",
                                "sense_id": "fa70bc05-2821-3fe5-916a-6d98022774d7",
                                "text": "„Gemeinsam mit der Schulleitung werde intensiv an einer Verbesserung der Lüftungssituation gearbeitet, um Schülern, Lehrern und Verwaltung wieder ein optimales Arbeitsklima und Lernumfeld zur Verfügung stellen zu können.“"
                            },
                            {
                                "example_id": "5dff29b3-77ba-431a-9e7c-abffd8bf1764",
                                "sense_id": "fa70bc05-2821-3fe5-916a-6d98022774d7",
                                "text": "„ Im Zuge einer umfangreichen Modernisierung, wenn z.B. sowohl Fenster ausgetauscht als auch Fassaden gedämmt werden, muss die Lüftungssituation überprüft und gegebenenfalls angepasst werden.“"
                            },
                            {
                                "example_id": "0f4a60ef-deda-4dec-b772-ce2dae4e9c62",
                                "sense_id": "fa70bc05-2821-3fe5-916a-6d98022774d7",
                                "text": "„Diese Belastungen sind in erheblichem Maße abhängig von den raumklimatischen Bedingungen, der Lüftungssituation und der Gestaltung und Nutzung des Innenraumes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "af6b86b8-35cf-36ac-b299-aecf9bf0238f",
                        "entry_id": "1a232204-9911-32f1-b1e5-3e6d0e5055e0",
                        "glosses": [
                            "Summe der momentanen Umstände im Bezug auf die Luftqualität in einem Raum, die bestimmend auf eventuelles Handeln einwirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f45ac82e-f8b1-462c-894c-f3b73d4f123d",
                                "sense_id": "af6b86b8-35cf-36ac-b299-aecf9bf0238f",
                                "text": "„Dies liefert ein gutes Bild über die Lüftungssituation im gemessenen Zeitinterwall.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
