{
    "word_family": [
        "сторона",
        "посторонний",
        "сторонник",
        "отстранить",
        "устранить",
        "пространство"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4045036f-a310-3b33-bc21-41d491b9557e",
                    "sense_definition": "Не имеющий прямого отношения к делу, чужой, посторонний",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "alien_unrelated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы стараемся не привлекать к нашему семейному проекту <w>сторонних</w> людей.",
                            "target_lang_translations": {
                                "de": "Wir versuchen, keine <w>außenstehenden</w> Personen an unserem Familienprojekt zu beteiligen."
                            }
                        },
                        {
                            "text": "Решение принималось быстро и без какого-либо вмешательства со стороны <w>сторонних</w> лиц.",
                            "target_lang_translations": {
                                "de": "Die Entscheidung wurde schnell und ohne jegliche Einmischung durch <w>Dritte</w> getroffen."
                            }
                        }
                    ],
                    "synonyms": [
                        "посторонний",
                        "чужой"
                    ],
                    "antonyms": [
                        "свой",
                        "родной"
                    ],
                    "common_phrases": [
                        "сторонний наблюдатель",
                        "сторонние лица",
                        "сторонний взгляд",
                        "стороннее вмешательство"
                    ],
                    "target_lang_definitions": {
                        "de": "Nicht direkt an einer Angelegenheit beteiligt; fremd, außenstehend"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "außenstehend",
                                "target_lang_sense_clarification": "nicht zur Gruppe oder Sache gehörend"
                            },
                            {
                                "target_lang_word": "fremd",
                                "target_lang_sense_clarification": "nicht dazugehörig, unbeteiligt"
                            },
                            {
                                "target_lang_word": "Dritte",
                                "target_lang_sense_clarification": "dritte Personen, Außenstehende"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "057be7af-cc19-38a3-9f64-bf9a547eb6db",
                    "sense_definition": "Принадлежащий третьей стороне или независимому разработчику, поставщику",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alien_unrelated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для безопасности системы не рекомендуется устанавливать программы от <w>сторонних</w> разработчиков.",
                            "target_lang_translations": {
                                "de": "Aus Sicherheitsgründen wird davon abgeraten, Software von <w>Drittanbietern</w> zu installieren."
                            }
                        },
                        {
                            "text": "Компания решила передать обслуживание серверов <w>сторонней</w> организации.",
                            "target_lang_translations": {
                                "de": "Das Unternehmen beschloss, die Serverwartung an ein <w>externes</w> Unternehmen zu übertragen."
                            }
                        }
                    ],
                    "antonyms": [
                        "собственный",
                        "внутренний"
                    ],
                    "common_phrases": [
                        "сторонний разработчик",
                        "сторонняя организация",
                        "сторонние сервисы",
                        "стороннее приложение"
                    ],
                    "target_lang_definitions": {
                        "de": "Von einem externen Anbieter oder Drittanbieter stammend"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Dritt-",
                                "target_lang_sense_clarification": "z. B. Drittanbieter, Drittpartei"
                            },
                            {
                                "target_lang_word": "extern",
                                "target_lang_sense_clarification": "von außen kommend, nicht intern"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "888bc1fa-32dd-3abc-85a7-7c6313c773a8",
                    "sense_definition": "Расположенный в стороне; боковой",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Они незаметно свернули на глухую <w>стороннюю</w> тропинку в лесу.",
                            "target_lang_translations": {
                                "de": "Sie bogen unbemerkt auf einen einsamen <w>Seitentrail</w> im Wald ab."
                            }
                        },
                        {
                            "text": "Путник надеялся найти приют в <w>сторонней</w> деревушке вдали от тракта.",
                            "target_lang_translations": {
                                "de": "Der Reisende hoffte, in einem <w>abgelegenen</w> Dörfchen fernab der Hauptstraße Unterschlupf zu finden."
                            }
                        }
                    ],
                    "synonyms": [
                        "боковой"
                    ],
                    "antonyms": [
                        "центральный"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Abseits gelegen oder seitlich befindlich (veraltet)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "abgelegen",
                                "target_lang_sense_clarification": "abseits vom Hauptweg liegend"
                            },
                            {
                                "target_lang_word": "seitlich",
                                "target_lang_sense_clarification": "an der Seite liegend"
                            },
                            {
                                "target_lang_word": "Seiten-",
                                "target_lang_sense_clarification": "abzweigend, Neben-"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}