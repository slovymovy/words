                        "sense_id": "c9dc747d-8961-3a9a-94ab-e2a8b8cd2991",
                        "entry_id": "fe2f10a8-29b5-31ff-9469-d89ceda3a514",
                        "glosses": [
                            "A premature adult form of an insect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b72d3119-ec8f-4e1a-b962-73384d783a33",
                                "sense_id": "c9dc747d-8961-3a9a-94ab-e2a8b8cd2991",
                                "text": "An adultoid is a mature alate that remains in the colony, sheds its wings and becomes a functional reproductive."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a24c19d-235c-3bee-afef-605d80e582c7",
                        "entry_id": "fe2f10a8-29b5-31ff-9469-d89ceda3a514",
                        "glosses": [
                            "An adolescent who engages in activities that symbolize adult status."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8c95f88-eed3-4aa2-8500-c97377739074",
                                "sense_id": "5a24c19d-235c-3bee-afef-605d80e582c7",
                                "text": "Greenberger and Steinberg coined the term “adultoid” to describe adolescents who engage in activities, often “risky” activities, that symbolize adult status (e.g., smoking, drinking, staying out late, having sex)."
                            },
                            {
                                "example_id": "cbcd4ec3-10c1-4c91-a59f-e0a68ef78111",
                                "sense_id": "5a24c19d-235c-3bee-afef-605d80e582c7",
                                "text": "This link between an older subjective age and engagement in problem behaviors supports the existence of adultoid or pseudomature adolescents who have been described in theoretical literature, but until recently, remained unidentified empirically."
                            },
                            {
                                "example_id": "e742849c-c270-4f7b-9e12-64e2245fe583",
                                "sense_id": "5a24c19d-235c-3bee-afef-605d80e582c7",
                                "text": "Personal conversations I had with teachers/counsellors in different high schools responsible for overseeing RAP certainly indicated that, at least initially, students' confidence about their newly discovered sense of maturity was closer to pseudomaturity or adultoid behaviour."
                            }
                        ]
                    }
