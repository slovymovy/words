                ],
                "senses": [
                    {
                        "sense_id": "0255eb67-1903-36db-a67d-a8e9a3c7ad8f",
                        "entry_id": "205b2502-5714-3119-92db-a8fb89326a77",
                        "glosses": [
                            "heftig pijnlijk ontroerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dce2bcf-fc2f-4865-9053-d4b4b0f28bc5",
                                "sense_id": "0255eb67-1903-36db-a67d-a8e9a3c7ad8f",
                                "text": "Op het station van Igelboda zagen we het vreselijke nieuws op het aanplakbiljet van Aftonbladet, slechts twee woorden maar met grote zwarte letters: STALIN DOOD Diep geschokt slopen we de eerste wagon in toen de trein kwam."
                            },
                            {
                                "example_id": "78c0f8ab-f047-4eb0-a421-9ffe18214480",
                                "sense_id": "0255eb67-1903-36db-a67d-a8e9a3c7ad8f",
                                "text": "Snowden werkt nu voor het ict-consultantsbureau Booz Allen, een bedrijf met 24.000 medewerkers dat de Amerikaanse overheid als klant heeft. De werkgever zegt dat Snowden minder dan drie maanden in dienst is, en lid is van een team dat werkt op Hawaïi. Booz Allen zegt alle medewerking te zullen geven aan het onderzoek in deze zaak en stelt geschokt te zijn dat \"dit individu beweert dat hij geheime informatie heeft gelekt\"."
                            }
                        ]
                    }
