                "senses": [
                    {
                        "sense_id": "76b3a83f-51cd-314b-b371-ab10691cbab3",
                        "entry_id": "e2b1d8f2-1b45-3b14-89d1-290362b429cb",
                        "glosses": [
                            "Petit landau dont la capote est faite d'un seul soufflet mobile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb4f4b94-c61f-4899-94da-e149e5ef81b8",
                                "sense_id": "76b3a83f-51cd-314b-b371-ab10691cbab3",
                                "text": "Le landaulet correspond à un landau-coupé : les deux places et la capote avant ont été supprimées."
                            }
                        ]
                    },
                    {
                        "sense_id": "210f4e58-6be1-30a5-8b2e-ac7b321d9d72",
                        "entry_id": "e2b1d8f2-1b45-3b14-89d1-290362b429cb",
                        "glosses": [
                            "Automobile formée d'un compartiment à l'air libre, réservé au conducteur, et d'un coupé, muni d'une capote mobile, réservé aux voyageurs."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2373a71c-115e-4526-a3a8-9b04b35694f2",
                                "sense_id": "210f4e58-6be1-30a5-8b2e-ac7b321d9d72",
                                "text": "Trépignant d’impatience au fond d’un landaulet dont il avait fait abaisser la capote […], le capitaine Brocq s’était lancé à la poursuite plus ou moins hypothétique du taxi-automobile 249-B Z."
                            },
                            {
                                "example_id": "1dfa92a1-af55-4ff4-97ec-bd567db9e923",
                                "sense_id": "210f4e58-6be1-30a5-8b2e-ac7b321d9d72",
                                "text": "Un landaulet de louage, qui faisait autant de bruit qu’une batteuse, nous emmena tous trois."
                            },
                            {
                                "example_id": "f9d6bb0d-b204-4e06-a482-2b7eac0e36b3",
                                "sense_id": "210f4e58-6be1-30a5-8b2e-ac7b321d9d72",
                                "text": "Son landaulet fut accueilli avec émerveillement par la population, d’autant que son chauffeur était de Tabriz, l’un des rares Persans à conduire un tel véhicule."
                            }
                        ]
                    },
                    {
                        "sense_id": "74709467-cbaf-3764-8383-8f580a984c3b",
                        "entry_id": "e2b1d8f2-1b45-3b14-89d1-290362b429cb",
                        "glosses": [
                            "Automobile moderne dont la partie arrière se découvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b5247ba-f87f-425c-a02f-e7cbb2b0f337",
                                "sense_id": "74709467-cbaf-3764-8383-8f580a984c3b",
                                "text": "Peugeot a dédié pour la présidence de la République un modèle dérivé^((de la Peugeot 607)) : la Paladine, conçue et carrossée en landaulet par Heuliez."
                            }
                        ]
                    }
