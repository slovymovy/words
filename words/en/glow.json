{
    "word_family": [
        "glowing",
        "glowingly",
        "afterglow",
        "glowworm"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "88e25c1b-bd0a-39ba-849d-01ef5f92bbbf",
                    "sense_definition": "To produce a steady light, often because of heat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "light_emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coals in the fireplace continued to <w>glow</w> all night.",
                            "target_lang_translations": {
                                "ru": "Угли в камине продолжали <w>тлеть</w> всю ночь.",
                                "zh": "壁炉里的煤炭整晚都在<w>发光</w>。"
                            }
                        },
                        {
                            "text": "Fireflies <w>glow</w> in the dark forest.",
                            "target_lang_translations": {
                                "ru": "Светлячки <w>светятся</w> в темном лесу.",
                                "zh": "萤火虫在黑暗的森林中<w>闪烁</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shine",
                        "radiate",
                        "beam",
                        "gleam"
                    ],
                    "antonyms": [
                        "darken"
                    ],
                    "common_phrases": [
                        "glow in the dark",
                        "glow softly",
                        "glow red"
                    ],
                    "target_lang_definitions": {
                        "ru": "Излучать ровный свет, часто вследствие нагревания.",
                        "zh": "发出稳定的光，通常是因为受热。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светиться",
                                "target_lang_sense_clarification": "излучать свет"
                            },
                            {
                                "target_lang_word": "тлеть",
                                "target_lang_sense_clarification": "гореть без пламени (об углях)"
                            },
                            {
                                "target_lang_word": "сиять",
                                "target_lang_sense_clarification": "ярко светить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发光",
                                "target_lang_sense_clarification": "发出光亮"
                            },
                            {
                                "target_lang_word": "微光",
                                "target_lang_sense_clarification": "发出微弱的光"
                            },
                            {
                                "target_lang_word": "闪烁",
                                "target_lang_sense_clarification": "光线忽明忽暗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "becf9471-0f66-3ec0-a7be-96fbb0286f56",
                    "sense_definition": "To look pink or red and healthy, or to feel hot from exercise or emotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her cheeks <w>glowed</w> after the long walk in the snow.",
                            "target_lang_translations": {
                                "ru": "Её щеки <w>горели</w> после долгой прогулки по снегу.",
                                "zh": "在雪地里长途跋涉后，她的脸颊<w>泛红</w>了。"
                            }
                        },
                        {
                            "text": "The children <w>glowed</w> with health.",
                            "target_lang_translations": {
                                "ru": "Дети <w>сияли</w> здоровьем.",
                                "zh": "孩子们看起来非常<w>红润</w>健康。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flush",
                        "blush",
                        "redden"
                    ],
                    "antonyms": [
                        "pale"
                    ],
                    "common_phrases": [
                        "glow with health",
                        "glow red"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выглядеть розовым или красным и здоровым, или чувствовать жар от упражнений или эмоций.",
                        "zh": "因运动或情绪而显得面色红润健康，或感到发热。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гореть",
                                "target_lang_sense_clarification": "быть красным от прилива крови"
                            },
                            {
                                "target_lang_word": "пылать",
                                "target_lang_sense_clarification": "сильно краснеть, испытывать жар"
                            },
                            {
                                "target_lang_word": "сиять",
                                "target_lang_sense_clarification": "выглядеть здоровым и счастливым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泛红",
                                "target_lang_sense_clarification": "皮肤因充血而变红"
                            },
                            {
                                "target_lang_word": "红润",
                                "target_lang_sense_clarification": "形容气色好"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "512ef536-d429-31ce-9037-361d7cc97726",
                    "sense_definition": "To show strong positive emotion, such as happiness or pride.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>glowed</w> with pride when his son won the race.",
                            "target_lang_translations": {
                                "ru": "Он <w>сиял</w> от гордости, когда его сын выиграл гонку.",
                                "zh": "当儿子赢得比赛时，他脸上<w>洋溢</w>着自豪。"
                            }
                        },
                        {
                            "text": "She was <w>glowing</w> with happiness on her wedding day.",
                            "target_lang_translations": {
                                "ru": "Она <w>светилась</w> от счастья в день своей свадьбы.",
                                "zh": "婚礼当天，她脸上<w>洋溢</w>着幸福。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beam",
                        "radiate"
                    ],
                    "common_phrases": [
                        "glow with pride",
                        "glow with happiness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявлять сильные положительные эмоции, такие как счастье или гордость.",
                        "zh": "表现出强烈的积极情绪，如幸福或自豪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сиять",
                                "target_lang_sense_clarification": "выражать радость или счастье"
                            },
                            {
                                "target_lang_word": "светиться",
                                "target_lang_sense_clarification": "излучать счастье"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "洋溢",
                                "target_lang_sense_clarification": "充满某种情绪"
                            },
                            {
                                "target_lang_word": "喜形于色",
                                "target_lang_sense_clarification": "因高兴而流露在脸上"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7843b11-23e1-3f80-be3a-3a0d105a09e5",
                    "sense_definition": "To appear suspicious or fake in an online community, implying one is an undercover agent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "People thought his posts <w>glowed</w> because he asked too many personal questions.",
                            "target_lang_translations": {
                                "ru": "Люди думали, что он <w>палится</w> в своих постах, потому что задавал слишком много личных вопросов.",
                                "zh": "人们觉得他的帖子很<w>可疑</w>，因为他问了太多私人问题。"
                            }
                        },
                        {
                            "text": "That new user really <w>glows</w>.",
                            "target_lang_translations": {
                                "ru": "Этот новый пользователь реально <w>светится</w>.",
                                "zh": "那个新用户真的<w>露马脚</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выглядеть подозрительным или ненастоящим в интернет-сообществе (сленг).",
                        "zh": "在网络社区中显得可疑或虚假，暗示某人是卧底特工（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светиться",
                                "target_lang_sense_clarification": "привлекать нежелательное внимание, выдавать себя"
                            },
                            {
                                "target_lang_word": "палиться",
                                "target_lang_sense_clarification": "выдавать свою причастность (сленг)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "露马脚",
                                "target_lang_sense_clarification": "无意中暴露真实身份"
                            },
                            {
                                "target_lang_word": "可疑",
                                "target_lang_sense_clarification": "行为举止让人怀疑"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2cc962f8-aab1-36a7-91b5-b2681ad73e5e",
                    "sense_definition": "A steady, soft light produced by something hot or luminous.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "light_emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city lights cast an orange <w>glow</w> on the clouds.",
                            "target_lang_translations": {
                                "ru": "Огни города отбрасывали оранжевое <w>зарево</w> на облака.",
                                "zh": "城市灯光在云层上投射出一片橙色的<w>微光</w>。"
                            }
                        },
                        {
                            "text": "We sat by the warm <w>glow</w> of the fire.",
                            "target_lang_translations": {
                                "ru": "Мы сидели у теплого <w>свечения</w> огня.",
                                "zh": "我们坐在火堆温暖的<w>光辉</w>旁。"
                            }
                        }
                    ],
                    "synonyms": [
                        "radiance",
                        "shine",
                        "gleam",
                        "luminosity",
                        "light"
                    ],
                    "antonyms": [
                        "darkness",
                        "gloom"
                    ],
                    "common_phrases": [
                        "warm glow",
                        "soft glow",
                        "orange glow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ровный мягкий свет, излучаемый чем-то горячим или светящимся.",
                        "zh": "由炽热或发光物体产生的稳定、柔和的光。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свечение",
                                "target_lang_sense_clarification": "излучение света"
                            },
                            {
                                "target_lang_word": "зарево",
                                "target_lang_sense_clarification": "отсвет огней или пожара"
                            },
                            {
                                "target_lang_word": "сияние",
                                "target_lang_sense_clarification": "яркий свет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "光辉",
                                "target_lang_sense_clarification": "明亮的光"
                            },
                            {
                                "target_lang_word": "余晖",
                                "target_lang_sense_clarification": "光亮留下的痕迹"
                            },
                            {
                                "target_lang_word": "微光",
                                "target_lang_sense_clarification": "柔和的光线"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f46f03df-e020-371c-97a2-a7bef3493cfc",
                    "sense_definition": "A reddish color on the skin indicating health, exercise, or emotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Exercise gives your skin a healthy <w>glow</w>.",
                            "target_lang_translations": {
                                "ru": "Упражнения придают коже здоровое <w>сияние</w>.",
                                "zh": "锻炼能让你的皮肤呈现健康的<w>红润</w>。"
                            }
                        },
                        {
                            "text": "There was a rosy <w>glow</w> on her cheeks.",
                            "target_lang_translations": {
                                "ru": "На её щеках был розовый <w>румянец</w>.",
                                "zh": "她的脸颊上泛着玫瑰色的<w>红润</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flush",
                        "bloom",
                        "radiance"
                    ],
                    "antonyms": [
                        "pallor"
                    ],
                    "common_phrases": [
                        "healthy glow",
                        "rosy glow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Красноватый цвет кожи, указывающий на здоровье, физические упражнения или эмоции.",
                        "zh": "皮肤上显示健康、运动或情绪的红润色泽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "румянец",
                                "target_lang_sense_clarification": "краска на щеках"
                            },
                            {
                                "target_lang_word": "сияние",
                                "target_lang_sense_clarification": "здоровый вид кожи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "红润",
                                "target_lang_sense_clarification": "健康的肤色"
                            },
                            {
                                "target_lang_word": "气色",
                                "target_lang_sense_clarification": "面部呈现的健康状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37b97d2e-c4d7-3642-aacd-cfe33c100829",
                    "sense_definition": "A strong feeling of warmth, pleasure, or satisfaction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a <w>glow</w> of satisfaction after helping the stranger.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала <w>прилив</w> удовлетворения, помогши незнакомцу.",
                                "zh": "帮助了那位陌生人后，她感到内心涌起一阵<w>满足感</w>。"
                            }
                        },
                        {
                            "text": "The wine created a pleasant inner <w>glow</w>.",
                            "target_lang_translations": {
                                "ru": "Вино создало приятное внутреннее <w>тепло</w>.",
                                "zh": "葡萄酒带来了一种愉悦的内心<w>暖意</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "warmth",
                        "pleasure"
                    ],
                    "common_phrases": [
                        "glow of pride",
                        "inner glow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное чувство внутреннего тепла, удовольствия или удовлетворения.",
                        "zh": "一种强烈的温暖、愉悦或满足感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тепло",
                                "target_lang_sense_clarification": "приятное чувство"
                            },
                            {
                                "target_lang_word": "прилив",
                                "target_lang_sense_clarification": "внезапное чувство (радости, тепла)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暖意",
                                "target_lang_sense_clarification": "内心的温暖感觉"
                            },
                            {
                                "target_lang_word": "满足感",
                                "target_lang_sense_clarification": "心理上的愉悦"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}