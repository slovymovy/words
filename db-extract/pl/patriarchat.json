                "translations": [
                    {
                        "translation_id": "34980c0a-bd37-49c2-a8eb-365958cfccc5",
                        "source_entry_id": "252f0f26-bc74-3976-8c5c-ae3c042d1354",
                        "source_sense_id": "db2f64ae-0e6c-39de-8c28-d873ca2c3b95",
                        "target_lang_word": "patriarchate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patriarchate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "deaa70b2-33cf-326b-ab83-0d2552943eb0",
                                        "entry_id": "9922156d-1862-3250-90d4-5cfedd3afe51",
                                        "glosses": [
                                            "A patriarchal system or community."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7210500c-678e-4454-876c-1efb331c67bf",
                                                "sense_id": "deaa70b2-33cf-326b-ab83-0d2552943eb0",
                                                "text": "The rise of the patriarchate saw the overpowering of the female goddess by the male god. The moon-god gave place to the sun-god. The tables were turned with a vengeance. Not only was the male granted a share in the phenomenon of generation; he was given the main share."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29d45bdf-57d3-30a0-a14d-db7a7af904ed",
                                        "entry_id": "9922156d-1862-3250-90d4-5cfedd3afe51",
                                        "glosses": [
                                            "The term of office of a Christian patriarch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04f091e9-b812-49c4-8f24-4b4b406cee95",
                                                "sense_id": "29d45bdf-57d3-30a0-a14d-db7a7af904ed",
                                                "text": "The patriarchate of Pope John Paul II as Patriarch of the West was more than 25 years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2c4bc76-3969-329c-a969-a0e788134e7a",
                                        "entry_id": "9922156d-1862-3250-90d4-5cfedd3afe51",
                                        "glosses": [
                                            "The office or ecclesial jurisdiction of such a patriarch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ae31391-b5c5-4fde-9be7-001f81b8137a",
                                                "sense_id": "e2c4bc76-3969-329c-a969-a0e788134e7a",
                                                "text": "The Patriarchate of Constantinople has primacy over the whole of the Orthodox world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5d1df1b-cbd4-340c-835d-691063bfb1e5",
                                        "entry_id": "9922156d-1862-3250-90d4-5cfedd3afe51",
                                        "glosses": [
                                            "The office-space occupied by a patriarch and his staff."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acd125fd-50fe-4fb2-8eae-b0a5048d9090",
                                                "sense_id": "a5d1df1b-cbd4-340c-835d-691063bfb1e5",
                                                "text": "The Latin patriarchate in Jerusalem is, by modern standards, a very cramped space."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f7f0d11-6fb3-4bae-9169-f939ac37460e",
                        "source_entry_id": "252f0f26-bc74-3976-8c5c-ae3c042d1354",
                        "source_sense_id": "db2f64ae-0e6c-39de-8c28-d873ca2c3b95",
                        "target_lang_word": "patriarcat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patriarcat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0dbed1e1-8c04-3694-bb71-33c23c322012",
                                        "entry_id": "14e27c9f-39db-3a08-affb-a4c5b9a32843",
                                        "glosses": [
                                            "Dignité de patriarche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34513510-8cac-4cc0-8190-1214b9d9c0b1",
                                                "sense_id": "0dbed1e1-8c04-3694-bb71-33c23c322012",
                                                "text": "Il fut élevé au patriarcat de Constantinople."
                                            },
                                            {
                                                "example_id": "ccc55f47-5ead-400e-aef7-739ecc173d0b",
                                                "sense_id": "0dbed1e1-8c04-3694-bb71-33c23c322012",
                                                "text": "Dans les églises grecques ou orientales non catholiques, le patriarcat est la dignité suprême."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23eb59a6-dc4c-3906-a938-d9e421ce7caf",
                                        "entry_id": "14e27c9f-39db-3a08-affb-a4c5b9a32843",
                                        "glosses": [
                                            "Étendue de territoire soumise à la juridiction d’un patriarche."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f450f219-fab1-3d9d-94b4-336f167e8006",
                                        "entry_id": "14e27c9f-39db-3a08-affb-a4c5b9a32843",
                                        "glosses": [
                                            "Temps pendant lequel un patriarche a occupé son siège."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49931cbb-1b57-4420-9adb-e50b548d5ea8",
                                                "sense_id": "f450f219-fab1-3d9d-94b4-336f167e8006",
                                                "text": "Durant son patriarcat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05fd06e2-b67f-3ad3-ae91-54198d171591",
                                        "entry_id": "14e27c9f-39db-3a08-affb-a4c5b9a32843",
                                        "glosses": [
                                            "Système social fondé sur la domination des hommes sur les femmes, qui organise les rapports de pouvoir dans les sphères familiale, économique, juridique, culturelle et symbolique."
                                        ],
                                        "tags": [
                                            "Études féministes",
                                            "Sciences sociales"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9dc983d-2bdd-4469-a367-ff5896c1908f",
                                                "sense_id": "05fd06e2-b67f-3ad3-ae91-54198d171591",
                                                "text": "Un visiteur, passant même très rapidement sur cette planète, ne pourrait pas manquer de se rendre compte, au vu de ce document épars, que l’Angleterre est sous la coupe d'un patriarcat."
                                            },
                                            {
                                                "example_id": "72af64a5-631e-4949-8b0c-27cf76b54143",
                                                "sense_id": "05fd06e2-b67f-3ad3-ae91-54198d171591",
                                                "text": "Aujourd’hui, ce pays réinvente encore, étonnamment, la révolution dans le monde dit « arabe » : après le soulèvement populaire, c’est le soulèvement contre le patriarcat, le statut des femmes éternellement mineur, le sort féodal fait à la moitié de la Tunisie."
                                            },
                                            {
                                                "example_id": "31440c3c-eb90-406d-a97f-c7814979c669",
                                                "sense_id": "05fd06e2-b67f-3ad3-ae91-54198d171591",
                                                "text": "En fait, adhérer à une éthique du care qui dévoile une « nature » ou une « pensée féminine » portée vers la maternité et ses valeurs construit un idéal du soin et de l’éducation qui fait abstraction des relations de pouvoir, du patriarcat au moment où il réaffirme une différence des sexes avec ses principaux stéréotypes."
                                            },
                                            {
                                                "example_id": "f36d147b-d8c6-4172-8ea0-229e5ab9a9ef",
                                                "sense_id": "05fd06e2-b67f-3ad3-ae91-54198d171591",
                                                "text": "Jouissant d’une popularité grandissante, celle-ci rejoint les rangs du MLF et s’implique directement ou indirectement dans les manifestations et les coups médiatiques, s’opposant au patriarcat et à l’exploitation domestique des femmes, depuis la perturbation des états généraux du magazine Elle jusqu’au « Manifeste des 343 »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9b52ed0-5056-4493-83ae-ba9d3ef55701",
                        "source_entry_id": "252f0f26-bc74-3976-8c5c-ae3c042d1354",
                        "source_sense_id": "db2f64ae-0e6c-39de-8c28-d873ca2c3b95",
                        "target_lang_word": "Patriarchat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Patriarchat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f51ee266-413c-3bc9-b2b5-f239d448d498",
                                        "entry_id": "6f2f7157-94b9-3123-bf28-40579ae391a5",
                                        "glosses": [
                                            "Gesellschaftsform, bei der die Männer die Vorherrschaft haben"
                                        ],
                                        "tags": [
                                            "Geschlecht n"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc945157-28f9-4750-a366-046133e65ca4",
                                                "sense_id": "f51ee266-413c-3bc9-b2b5-f239d448d498",
                                                "text": "Das Patriarchat ist auch heute noch eine sehr verbreitete Gesellschaftsstruktur."
                                            },
                                            {
                                                "example_id": "3f2a6f8c-80ed-4678-8608-4a07b3056c2d",
                                                "sense_id": "f51ee266-413c-3bc9-b2b5-f239d448d498",
                                                "text": "„Mit ihr ist das fahrlässige Weib in das fahrende Patriarchat der Herren eingebrochen und kreuzt mit seiner angestammten Rechthaberei und Hysterie die männliche Fahrbahn.“"
                                            },
                                            {
                                                "example_id": "60546641-d971-4a27-816c-6812fee6f502",
                                                "sense_id": "f51ee266-413c-3bc9-b2b5-f239d448d498",
                                                "text": "„Mit mir setzte sich Amalia hin und erklärte mir, dass wir in einem Patriarchat lebten und dass die Regeln für Männer und Frauen daher unfairerweise verschieden und vor allem stark zum Nachteil der Frauen, aber auch zum Nachteil vieler Männer beschaffen seien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4794f57c-af25-32ba-af68-ce92405ce7e9",
                                        "entry_id": "6f2f7157-94b9-3123-bf28-40579ae391a5",
                                        "glosses": [
                                            "Amtsbereich eines kirchlichen Patriarchen"
                                        ],
                                        "tags": [
                                            "neuter"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
