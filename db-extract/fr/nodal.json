                "senses": [
                    {
                        "sense_id": "25b6aac3-ecdf-31d4-9a9a-51c234ad673a",
                        "entry_id": "af9ffdbe-3ded-3911-bd5a-ee50065052d6",
                        "glosses": [
                            "Relatif au nœud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52f912b9-69d9-49fc-841a-fd120c94bb7f",
                                "sense_id": "25b6aac3-ecdf-31d4-9a9a-51c234ad673a",
                                "text": "1° Cigarettes en tuyaux de paille. Soit un beau tuyau de paille de blé ; on le coupe transversalement à angle droit à deux ou trois centimètres de l'articulation nodale du côté de son moindre diamètre […]."
                            },
                            {
                                "example_id": "7e55f34f-cc89-4cdc-9b22-4a5cd57e732d",
                                "sense_id": "25b6aac3-ecdf-31d4-9a9a-51c234ad673a",
                                "text": "Analyse nodale des circuits."
                            }
                        ]
                    },
                    {
                        "sense_id": "8120de4c-e557-3e1c-9685-e49d9489b5f4",
                        "entry_id": "af9ffdbe-3ded-3911-bd5a-ee50065052d6",
                        "glosses": [
                            "Qui représente l’élément principal d’un sujet, le point central."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8b37cdbe-27c6-4ad3-8bd4-f4b5f4f720e7",
                                "sense_id": "8120de4c-e557-3e1c-9685-e49d9489b5f4",
                                "text": "Jouer un rôle nodal ; représenter la valeur nodale ; être le point nodal du problème,…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea3149fc-7fdd-4902-89eb-53b23ae34d9f",
                        "source_entry_id": "af9ffdbe-3ded-3911-bd5a-ee50065052d6",
                        "target_lang_word": "nodal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nodal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4d4319e-5bd6-3a66-b7b4-3529ad7ef31c",
                                        "entry_id": "7fd893fe-e4cd-3194-ba41-597410040600",
                                        "glosses": [
                                            "Of the nature of, or relating to, a node."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcd0eb25-040f-44cf-a510-95866671c279",
                                                "sense_id": "a4d4319e-5bd6-3a66-b7b4-3529ad7ef31c",
                                                "text": "If the sexual component [in a prosecutorial case] cannot be construed, it must be constructed. It is the nodal point of the prosecutor's comprehension. Up to that point, everything […] may perplex or disturb. But once the sexuality has been imputed, everything that seemed normal can now be made abnormal and perverse."
                                            },
                                            {
                                                "example_id": "72749e19-85a6-4cf9-965d-0820f011f572",
                                                "sense_id": "a4d4319e-5bd6-3a66-b7b4-3529ad7ef31c",
                                                "text": "Chapter 4 is nodal to the book, not simply because it stands at its very middle. It engages with Kaiserkritik but also it connects the previous chapter’s discussion of working method and sources to what follows in Chapter 5, where Zonaras’ interest in Roman antiquity is discussed in greater detail."
                                            },
                                            {
                                                "example_id": "17b5a5a5-05e4-4748-9b1f-3c2f193c8fde",
                                                "sense_id": "a4d4319e-5bd6-3a66-b7b4-3529ad7ef31c",
                                                "text": "Freightliner has advocated the long-planned development of Ripple Lane as a nodal yard. Its redevelopment, to accommodate roads up to 700 metres long, was listed in the London Freight Strategy of 2022 but hasn't gone beyond the drawing board."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db989a64-d41c-37c1-af2d-bb5f2ee2c526",
                                        "entry_id": "7fd893fe-e4cd-3194-ba41-597410040600",
                                        "glosses": [
                                            "Of or relating to the nodus."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
