                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e16014ee-cef5-4655-950e-702a80a664e3",
                                "sense_id": "69768271-8c01-3dc0-8a2a-e0ab0f87bfa3",
                                "text": "„Don Corleone verscheuchte die Eindringlinge aus seinen Gedanken und ging seinen beiden Söhnen voraus zur Hochzeitstafel.“"
                            },
                            {
                                "example_id": "4d274471-3c5b-4e6f-8263-391a18082361",
                                "sense_id": "69768271-8c01-3dc0-8a2a-e0ab0f87bfa3",
                                "text": "„Ich saß ganz weit hinten an der Hochzeitstafel, sah schlecht und fragte mich, woher die scharzen Flecken auf den Fotos von Claras achtem Geburtstag stammten.“"
                            }
                        ],
