        "fr-extract.jsonl": [
            {
                "entry_id": "6fb6e218-3837-3321-b339-164b5d43c072",
                "word": "ès",
                "pos": "prep",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dfef8499-4511-35c2-a3a4-1c57122f9534",
                        "entry_id": "6fb6e218-3837-3321-b339-164b5d43c072",
                        "glosses": [
                            "En matière de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bfd176e-8a72-43e9-9bb3-5ecce0aa54e0",
                                "sense_id": "dfef8499-4511-35c2-a3a4-1c57122f9534",
                                "text": "Entré comme pion à vingt ans dans une institution quelconque, afin de pouvoir pousser ses études jusqu'à la licence ès lettres d'abord, et jusqu'au doctorat ensuite, […]."
                            },
                            {
                                "example_id": "80aa8f0e-30e9-4a10-aeec-9fc4fbbda29f",
                                "sense_id": "dfef8499-4511-35c2-a3a4-1c57122f9534",
                                "text": "Ici, une vitrine protégeant des vieilles monnaies. Là, un tiroir plein d’instruments en silex. […] C’était assurément un étudiant ès divers."
                            },
                            {
                                "example_id": "4528e8b7-faa0-4c74-935f-c45d254abaf1",
                                "sense_id": "dfef8499-4511-35c2-a3a4-1c57122f9534",
                                "text": "— À quarante ans, après une carrière de call-girl ès Sado appréciée des amateurs pour ses séances de mère fouettarde, elle avait monté sa petite et néanmoins prospère entreprise."
                            }
                        ]
                    },
                    {
                        "sense_id": "174526f9-3a78-3361-baee-0daf64cb7826",
                        "entry_id": "6fb6e218-3837-3321-b339-164b5d43c072",
                        "glosses": [
                            "ou Dans les; en les, aux (il s'agit originellement de la contraction de en et de les)."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "54022b6c-8a31-429b-875d-2199a59643a8",
                                "sense_id": "174526f9-3a78-3361-baee-0daf64cb7826",
                                "text": "Je veux mourir ès amoureux combats,\nSoûlant l’amour, qu’au sang je porte enclose,\nToute une nuit au milieu de tes bras."
                            },
                            {
                                "example_id": "dd1eedaf-8c41-42de-863e-c5a1939c8b1b",
                                "sense_id": "174526f9-3a78-3361-baee-0daf64cb7826",
                                "text": "Seulement, par un entêtement qui gâte sa belle action, cet homme ne voulut jamais m'apprendre à siffler avant que je lui eusse versé ès mains quelques pistoles que je pris dans votre bourse."
                            },
                            {
                                "example_id": "d18620fa-f899-496e-a434-3efcf5b849e5",
                                "sense_id": "174526f9-3a78-3361-baee-0daf64cb7826",
                                "text": "L’obligation fut ensuite imposée de le porter « en la ville de Nancy et non autre part, ès mains du receveur général de Lorraine »."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
