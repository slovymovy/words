            "senses": [
                {
                    "sense_id": "01a502bb-0362-33f9-9466-9599b5cb9598",
                    "sense_definition": "Having a tendency to talk too proudly about one's own achievements or possessions.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "boastful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>braggy</w> and bombastic to the point of trash talking fellow performers.",
                            "target_lang_translations": {
                                "zh": "他表现得非常<w>爱吹牛</w>且夸夸其谈，甚至到了贬低其他表演者的地步。"
                            }
                        },
                        {
                            "text": "Nobody likes a <w>braggy</w> person who constantly talks about their expensive new car.",
                            "target_lang_translations": {
                                "zh": "没人喜欢那种总是谈论自己昂贵新车的<w>爱炫耀</w>的人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "boastful",
                        "cocky",
                        "arrogant"
                    ],
                    "antonyms": [
                        "humble",
                        "modest"
                    ],
                    "common_phrases": [
                        "braggy attitude",
                        "braggy behavior"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指人喜欢夸耀自己的成就或财物，爱吹牛的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "爱吹牛的",
                                "target_lang_sense_clarification": "形容人喜欢夸大其词，口语中常用。"
                            },
                            {
                                "target_lang_word": "自大的",
                                "target_lang_sense_clarification": "形容人过于自信，表现出傲慢的态度。"
                            },
                            {
                                "target_lang_word": "爱炫耀的",
                                "target_lang_sense_clarification": "形容人喜欢向别人展示自己的优越感。"
                            }
                        ]
                    }
                }
            ]
