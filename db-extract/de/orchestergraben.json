                "senses": [
                    {
                        "sense_id": "97c1dc83-eb51-379a-b66f-9b2f1fbcedcf",
                        "entry_id": "ae94f026-bca2-39f2-a053-6ae022ca82d4",
                        "glosses": [
                            "in Opernhäusern die Vertiefung zwischen Bühne und Zuschauerraum, in dem das Orchester spielt und der Dirigent steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71524f31-920b-44b5-b1ab-0d0de492f39c",
                                "sense_id": "97c1dc83-eb51-379a-b66f-9b2f1fbcedcf",
                                "text": "Der Schauspieler stürzte in den Orchestergraben."
                            },
                            {
                                "example_id": "0043aaaf-074c-467f-a16b-d5b5b3ed4b2a",
                                "sense_id": "97c1dc83-eb51-379a-b66f-9b2f1fbcedcf",
                                "text": "„Ein Musiker aus dem Orchestergraben erhob sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5efc06f2-02fd-4680-8c09-cedfd6097cf2",
                        "source_entry_id": "ae94f026-bca2-39f2-a053-6ae022ca82d4",
                        "source_sense_id": "97c1dc83-eb51-379a-b66f-9b2f1fbcedcf",
                        "target_lang_word": "orchestra pit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orchestra pit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dbfe284-a35a-3c23-8814-3d4336dbaee0",
                                        "entry_id": "6802920c-f076-310e-9093-69fb8cbfaf0d",
                                        "glosses": [
                                            "A sunken area in front of a stage in which musicians, largely hidden from view, play music to accompany stage performances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3683c9c6-068b-44b4-be70-4730b332a75b",
                                                "sense_id": "4dbfe284-a35a-3c23-8814-3d4336dbaee0",
                                                "text": "On the stage of the Gotham gloom reigned. . . . Johnson Miller was pacing the gangway between the orchestra pit and the first row of the orchestra chairs."
                                            },
                                            {
                                                "example_id": "f2cd7fcd-602c-45cf-b8e3-75f027b59b23",
                                                "sense_id": "4dbfe284-a35a-3c23-8814-3d4336dbaee0",
                                                "text": "Thirty-four years ago a gaunt young Russian with a crew haircut took over the job as chief conductor in the orchestra pit of Moscow's Imperial Grand Theatre."
                                            },
                                            {
                                                "example_id": "c2dd8900-2476-49ba-b4eb-0e18141c9a87",
                                                "sense_id": "4dbfe284-a35a-3c23-8814-3d4336dbaee0",
                                                "text": "An audience member at the Metropolitan Opera sprinkled a powdery substance — what the police said may have been the ashes of his mentor — into the orchestra pit during an intermission of a performance on Saturday, setting off a police investigation and the cancellation of the rest of that opera."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1a1fec0-96eb-469c-b3ad-2d364ee7afaf",
                        "source_entry_id": "ae94f026-bca2-39f2-a053-6ae022ca82d4",
                        "source_sense_id": "97c1dc83-eb51-379a-b66f-9b2f1fbcedcf",
                        "target_lang_word": "orchestra",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orchestra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1a63443-7e73-34b9-ada0-1f87825d7459",
                                        "entry_id": "68b17749-6122-3139-a32b-9695df96aca3",
                                        "glosses": [
                                            "A large group of musicians who play together on various instruments, usually including some from strings, woodwind, brass and/or percussion; the instruments played by such a group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca1032d0-9bff-430f-b952-8d114ab019d8",
                                                "sense_id": "d1a63443-7e73-34b9-ada0-1f87825d7459",
                                                "text": "The orchestra plays music for the dancers to dance to in the 19th century-styled dance hall."
                                            },
                                            {
                                                "example_id": "f4c7ca65-beb0-4760-a32a-510092abd0c8",
                                                "sense_id": "d1a63443-7e73-34b9-ada0-1f87825d7459",
                                                "text": "It requires quite an orchestra to get a train to start; the guard blows his horn, the stationmaster rings a large bell, and the engine whistles."
                                            },
                                            {
                                                "example_id": "4051374e-2a0f-4f12-95e9-c8582908eb70",
                                                "sense_id": "d1a63443-7e73-34b9-ada0-1f87825d7459",
                                                "text": "Musicians play their instruments. I play the orchestra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cea793eb-df4b-3de2-b395-69392c3fa594",
                                        "entry_id": "68b17749-6122-3139-a32b-9695df96aca3",
                                        "glosses": [
                                            "A semicircular space in front of the stage used by the chorus in Ancient Greek and Hellenistic theatres."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa6e6ee2-786c-3605-8103-12bc9aff463a",
                                        "entry_id": "68b17749-6122-3139-a32b-9695df96aca3",
                                        "glosses": [
                                            "The area in a theatre or concert hall where the musicians sit, immediately in front of and below the stage, sometimes (also) used by other performers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
