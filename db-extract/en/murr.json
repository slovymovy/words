                    {
                        "sense_id": "054bc951-f7ab-396a-83d9-38ace2339cec",
                        "entry_id": "83b5c978-aa80-36fd-b34e-95d420aa407b",
                        "glosses": [
                            "A purr (produced by any animal)."
                        ],
                        "tags": [
                            "colloquial",
                            "onomatopoeic",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c0cbbc42-22d2-4e50-82cb-749dc8aaaf5c",
                                "sense_id": "054bc951-f7ab-396a-83d9-38ace2339cec",
                                "text": "Raion let out a contented murr, […]"
                            },
                            {
                                "example_id": "4f6af80d-89b3-447b-b722-c1ad22241f39",
                                "sense_id": "054bc951-f7ab-396a-83d9-38ace2339cec",
                                "text": "Cathy rroww'ed like a cat in heat as her tom mated her, her breasts pressed deeply into the mattress, orgasming with a contented murr as the tom fertilized her […]"
                            },
                            {
                                "example_id": "5224c9f0-41d9-4a24-b2e0-9be6e24557d7",
                                "sense_id": "054bc951-f7ab-396a-83d9-38ace2339cec",
                                "text": "The hyena let out a soft murr as the fox's paw gently rubbing in small circles across his forehead and down his neck. The gentle scratching felt good, so the hyena leaned into the paw."
                            }
                        ]
                    }
                ],
