{
    "word_family": [
        "arrearage"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee39f98f-b01e-3852-93ed-14f12b84b83f",
                    "sense_definition": "Money that is owed and should have been paid earlier; an unpaid overdue debt (frequently used in the plural).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "debt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family received an eviction warning after falling into <w>arrears</w> with their rent payments.",
                            "target_lang_translations": {
                                "nl": "Het gezin ontving een uitzettingsbevel nadat het een <w>achterstand</w> had opgelopen met de huurbetalingen."
                            }
                        },
                        {
                            "text": "He managed to settle his tax <w>arrear</w> before any further legal penalties were imposed.",
                            "target_lang_translations": {
                                "nl": "Hij slaagde erin zijn <w>belastingachterstand</w> te voldoen voordat er verdere wettelijke boetes werden opgelegd."
                            }
                        }
                    ],
                    "synonyms": [
                        "debt",
                        "overdue payment",
                        "deficiency"
                    ],
                    "common_phrases": [
                        "in arrears",
                        "fall into arrears",
                        "rent arrears"
                    ],
                    "target_lang_definitions": {
                        "nl": "Geld dat verschuldigd is en al betaald had moeten zijn; een achterstallige betaling of schuld (vaak in het meervoud gebruikt)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "achterstallige betaling",
                                "target_lang_sense_clarification": "onbetaald gebleven schuld"
                            },
                            {
                                "target_lang_word": "betalingsachterstand",
                                "target_lang_sense_clarification": "achterstand in het betalen"
                            },
                            {
                                "target_lang_word": "achterstand",
                                "target_lang_sense_clarification": "financieel tekort of vertraging"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28c8c5a6-2955-3c8c-8453-1f5917a2205e",
                    "sense_definition": "An accumulation of unfinished work, correspondence, or obligations that has fallen behind schedule.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After returning from a long holiday, she spent the entire week dealing with an <w>arrear</w> of administrative work.",
                            "target_lang_translations": {
                                "nl": "Na terugkomst van een lange vakantie was ze de hele week bezig met het wegwerken van een <w>achterstand</w> aan administratief werk."
                            }
                        },
                        {
                            "text": "The office staff worked overtime to clear off the vast <w>arrears</w> of customer complaints.",
                            "target_lang_translations": {
                                "nl": "Het kantoorpersoneel werkte over om de enorme <w>berg</w> aan klachten van klanten weg te werken."
                            }
                        }
                    ],
                    "synonyms": [
                        "backlog"
                    ],
                    "common_phrases": [
                        "arrears of work"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een opstapeling van onafgemaakt werk, correspondentie of verplichtingen die achterloopt op schema."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "achterstand",
                                "target_lang_sense_clarification": "onvoltooid werk of opgelopen vertraging"
                            },
                            {
                                "target_lang_word": "werkachterstand",
                                "target_lang_sense_clarification": "stapel nog te verrichten werkzaamheden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26abc5ed-31b1-3d64-be6e-f0e61738792e",
                    "sense_definition": "Something that is situated in the rear or remains behind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers guarding the <w>arrear</w> ensured that no supply wagons were lost during the retreat.",
                            "target_lang_translations": {
                                "nl": "De soldaten die de <w>achterhoede</w> bewaakten, zorgden ervoor dat er tijdens de terugtocht geen bevoorradingswagens verloren gingen."
                            }
                        },
                        {
                            "text": "He glanced toward the <w>arrear</w> to check whether his companions were still following.",
                            "target_lang_translations": {
                                "nl": "Hij keek naar de <w>achterkant</w> om te controleren of zijn metgezellen nog steeds volgden."
                            }
                        }
                    ],
                    "synonyms": [
                        "rear",
                        "back"
                    ],
                    "antonyms": [
                        "front",
                        "fore"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "no longer in common modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets wat zich aan de achterzijde bevindt of achterblijft."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "achterhoede",
                                "target_lang_sense_clarification": "militaire achterkant of wat achterblijft"
                            },
                            {
                                "target_lang_word": "achterzijde",
                                "target_lang_sense_clarification": "de achterkant"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "dacd5da6-d87e-3fce-a47a-4925c19d0627",
                    "sense_definition": "Behind schedule; unpaid or overdue.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "debt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The landlord warned that if the monthly installment was <w>arrear</w>, penalties would immediately follow.",
                            "target_lang_translations": {
                                "nl": "De verhuurder waarschuwde dat er onmiddellijk boetes zouden volgen als de maandelijkse termijn <w>achterstallig</w> was."
                            }
                        },
                        {
                            "text": "Because the interest on the mortgage became <w>arrear</w>, the bank sent an official notice.",
                            "target_lang_translations": {
                                "nl": "Omdat de rente op de hypotheek <w>achterstallig</w> raakte, stuurde de bank een officiële aanmaning."
                            }
                        }
                    ],
                    "synonyms": [
                        "overdue",
                        "late",
                        "behindhand"
                    ],
                    "antonyms": [
                        "punctual",
                        "early"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly superseded by the prepositional phrase 'in arrears'"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Achterlopend op schema; onbetaald of achterstallig."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "achterstallig",
                                "target_lang_sense_clarification": "te laat betaald of voldaan"
                            },
                            {
                                "target_lang_word": "achterop",
                                "target_lang_sense_clarification": "in achterstand zijnd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "caacf59b-3fd8-3a29-b6de-5d0323c6e0a8",
                    "sense_definition": "Toward the rear; in a backward direction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She marched steadily forward along the mountain trail without ever glancing <w>arrear</w>.",
                            "target_lang_translations": {
                                "nl": "Ze marcheerde gestaag voorwaarts over het bergpad zonder ooit <w>naar achteren</w> te kijken."
                            }
                        },
                        {
                            "text": "The knight took three paces <w>arrear</w> to parry the sudden blow.",
                            "target_lang_translations": {
                                "nl": "De ridder zette drie passen <w>achterwaarts</w> om de plotselinge slag af te weren."
                            }
                        }
                    ],
                    "synonyms": [
                        "backwards",
                        "rearward"
                    ],
                    "antonyms": [
                        "forward",
                        "ahead"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "no longer used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Naar de achterkant; in achterwaartse richting."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "achterwaarts",
                                "target_lang_sense_clarification": "naar achteren gericht"
                            },
                            {
                                "target_lang_word": "naar achteren",
                                "target_lang_sense_clarification": "in de richting van de achterkant"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}