                                        "glosses": [
                                            "Plus petite province du Canada (symbole postal PE), baignée par le golfe du Saint-Laurent, dont le territoire se résume à celui de l’île du Prince-Édouard. Sa capitale est Charlottetown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "381416c3-681c-4924-bf5e-1c2d0674d83e",
                                                "sense_id": "c144ed21-7721-3d12-b8e2-f68977aff3a9",
                                                "text": "Des policiers ont répondu à un appel inusité à l’Île-du-Prince-Édouard dimanche. Un énorme phoque a bloqué la route 12 près de Birch Hill pendant plus de 90 minutes."
                                            },
                                            {
                                                "example_id": "fce5c74a-f9c4-4e73-ba46-8f86360bb09e",
                                                "sense_id": "c144ed21-7721-3d12-b8e2-f68977aff3a9",
                                                "text": "Anne… la maison aux pignons verts est l’œuvre littéraire la plus connue de l’Île-du-Prince-Édouard."
                                            },
                                            {
                                                "example_id": "0c9b069b-a1ed-4484-94d1-bc152cdbe1ad",
                                                "sense_id": "c144ed21-7721-3d12-b8e2-f68977aff3a9",
                                                "text": "Le pont de la Confédération relie l’Île-du-Prince-Édouard au reste du Canada."
                                            },
                                            {
                                                "example_id": "9731bb92-234a-4b31-965a-299ae124492e",
                                                "sense_id": "c144ed21-7721-3d12-b8e2-f68977aff3a9",
                                                "text": "J’habite à l’Île-du-Prince-Édouard."
                                            }
