                            "target_lang_translations": {
                                "en": "The doctor advised them to <w>slow down</w> their daily work pace.",
                                "ru": "Врач посоветовал ему <w>умерить</w> ежедневный темп работы.",
                                "nl": "De arts raadde hem aan zijn dagelijkse werktempo te <w>matigen</w>.",
                                "de": "Der Arzt riet ihm, sein tägliches Arbeitstempo zu <w>verlangsamen</w>.",
                                "pl": "Lekarz zalecił mu <w>umiarkować</w> swoje codzienne tempo pracy.",
                                "it": "Il medico gli ha consigliato di <w>rallentare</w> il ritmo di lavoro quotidiano.",
                                "cs": "Lékař mu doporučil, aby <w>zmírnil</w> tempo své každodenní práce.",
                                "tr": "Doktor ona günlük çalışma temposunu <w>yavaşlatmasını</w> tavsiye etti.",
                                "es": "El médico le recomendó <w>moderar</w> su ritmo de trabajo diario.",
                                "zh": "医生建议他<w>放缓</w>每天的工作节奏。"
                            }
