                "word": "luddite",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a8e56e8b-bc5a-4029-b8b0-51e5338cee9b",
                        "entry_id": "f4b9469a-45a9-33e4-929b-84c38a1d2666",
