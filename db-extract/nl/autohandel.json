                        "examples": [
                            {
                                "example_id": "bb3e7e5d-1669-43b9-ab22-6d8f358b54dc",
                                "sense_id": "e69dbd00-bf35-38e9-b433-c15b8f9e112e",
                                "text": "De bedrijfsleider van een autohandel in Borne betuigt spijt dat hij met een aantal medewerkers een borrel heeft gedronken. De politie kwam gisteravond langs op de melding van een feest - dat is nu verboden. Volgens de bedrijfsleider was het geen feest."
                            }
