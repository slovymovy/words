    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "edfed2d2-22b7-3b6f-95fc-854cf15c7987",
                    "sense_definition": "A common food made from flour, water, and usually yeast, mixed together and baked.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We made sandwiches with the <w>bread</w> we bought from the bakery this morning.",
                            "target_lang_translations": {
                                "ru": "Мы сделали бутерброды из <w>хлеба</w>, который купили сегодня утром в пекарне."
                            }
                        },
                        {
                            "text": "Would you like a <w>slice</w> of <w>bread</w> with your soup?",
                            "target_lang_translations": {
                                "ru": "Хотите <w>ломтик</w> <w>хлеба</w> к супу?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slice of bread",
                        "loaf of bread",
                        "white bread",
                        "wholemeal bread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обычный продукт питания, приготовленный из муки, воды и обычно дрожжей, смешанных и выпеченных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлеб",
                                "target_lang_sense_clarification": "пищевой продукт"
                            },
                            {
                                "target_lang_word": "булка",
                                "target_lang_sense_clarification": "белый хлеб"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fab237f7-6b01-3b7a-9daf-33721bf7fd91",
                    "sense_definition": "A specific type or variety of baked dough made from cereals.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bakery sells many different <w>breads</w> from all over the world.",
                            "target_lang_translations": {
                                "ru": "В пекарне продается много разных видов <w>хлеба</w> со всего мира."
                            }
                        },
                        {
                            "text": "Some <w>breads</w> are harder and drier than others depending on the flour used.",
                            "target_lang_translations": {
                                "ru": "Некоторые сорта <w>хлеба</w> тверже и суше других в зависимости от используемой муки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "artisanal breads",
                        "leavened breads"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный вид или сорт выпеченного теста из злаков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлеб",
                                "target_lang_sense_clarification": "сорт или изделие"
                            },
                            {
                                "target_lang_word": "хлебобулочные изделия",
                                "target_lang_sense_clarification": "различные виды выпечки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ab58170-116e-39e7-b401-231fb066fcbf",
                    "sense_definition": "Food or sustenance in general; the basic necessities of life.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sustenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He works hard every day just to earn his <w>daily</w> <w>bread</w> and support his family.",
                            "target_lang_translations": {
                                "ru": "Он тяжело работает каждый день только для того, чтобы заработать на <w>хлеб</w> <w>насущный</w> и прокормить семью."
                            }
                        },
                        {
                            "text": "In many cultures, <w>bread</w> is considered the staff of life.",
                            "target_lang_translations": {
                                "ru": "Во многих культурах <w>хлеб</w> считается основой жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "sustenance",
                        "livelihood",
                        "staff of life"
                    ],
                    "common_phrases": [
                        "daily bread",
                        "earn one's bread"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used figuratively"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пища или пропитание в целом; основные жизненные потребности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлеб",
                                "target_lang_sense_clarification": "средства к существованию"
                            },
                            {
                                "target_lang_word": "пропитание",
                                "target_lang_sense_clarification": "еда и нужды"
                            },
                            {
                                "target_lang_word": "хлеб насущный",
                                "target_lang_sense_clarification": "устойчивое выражение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9434976d-e538-30a4-8238-78973d641214",
                    "sense_definition": "A slang term for money.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to find a job soon because I am running out of <w>bread</w>.",
                            "target_lang_translations": {
                                "ru": "Мне нужно поскорее найти работу, потому что у меня заканчиваются <w>бабки</w>."
                            }
                        },
                        {
                            "text": "He spent all his <w>bread</w> on a new car and now he is broke.",
                            "target_lang_translations": {
                                "ru": "Он спустил всё <w>бабло</w> на новую машину и теперь на мели."
                            }
                        }
                    ],
                    "synonyms": [
                        "money",
                        "dough",
                        "moola",
                        "dosh",
                        "cash"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое обозначение денег."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бабки",
                                "target_lang_sense_clarification": "жаргон"
                            },
                            {
                                "target_lang_word": "бабло",
                                "target_lang_sense_clarification": "грубый сленг"
                            },
                            {
                                "target_lang_word": "капуста",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2f695e0d-ca45-3323-8b17-e1719ace5c82",
                    "sense_definition": "To cover a piece of food with breadcrumbs before cooking it.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>bread</w> the chicken before frying it to make it crunchy.",
                            "target_lang_translations": {
                                "ru": "Вам стоит <w>запанировать</w> курицу перед жаркой, чтобы она была хрустящей."
                            }
                        },
                        {
                            "text": "The chef decided to <w>bread</w> the fish fillets for the evening special.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар решил <w>обвалять</w> рыбное филе в сухарях для вечернего спецпредложения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bread the chicken",
                        "breaded fish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать кусок пищи панировочными сухарями перед приготовлением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "панировать",
                                "target_lang_sense_clarification": "обваливать в сухарях"
                            },
                            {
                                "target_lang_word": "обваливать",
                                "target_lang_sense_clarification": "в крошке или муке"
                            }
                        ]
                    }
                }
            ]
        }
    ]
