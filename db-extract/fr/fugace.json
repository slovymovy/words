                                            {
                                                "example_id": "0c6345a2-aabd-47b6-a182-fc83ac8a7485",
                                                "sense_id": "0da77296-e71f-32f7-94ea-143352436f2d",
                                                "text": "Pokémon was weer een van die kortstondige hypes."
                                            },
                                            {
                                                "example_id": "d21c7ae4-bdd2-4853-b343-e6ffd8b2adf0",
                                                "sense_id": "0da77296-e71f-32f7-94ea-143352436f2d",
                                                "text": "We hadden maar een kortstondig oponthoud bij de Merwedebrug."
                                            },
                                            {
                                                "example_id": "50d6e311-2ead-4eac-bcde-fa70aaa1545e",
                                                "sense_id": "0da77296-e71f-32f7-94ea-143352436f2d",
                                                "text": "De euro was dinsdagochtend voor het eerst in ongeveer twintig jaar evenveel waard als de dollar. De Europese eenheidsmunt daalde kortstondig tot exact 1,0000 dollar en bereikte daarmee het zogeheten pariteitsniveau, waarbij 1 euro precies evenveel waard is als 1 dollar. De laatste keer dat de euro dat niveau bereikte, was eind 2002."
                                            },
                                            {
                                                "example_id": "8698c7b1-0a13-4504-8333-0d24d3bc3e00",
                                                "sense_id": "0da77296-e71f-32f7-94ea-143352436f2d",
                                                "text": "In 2024 rapporteerden onderzoekers van de STAR Collaboration bij de Relativistic Heavy Ion Collider (RHIC) van Brookhaven National Laboratory in New York over het kortstondig creëren van een toen ongekend zware antimateriekern, genaamd antihyperwaterstof-4."
                                            }
