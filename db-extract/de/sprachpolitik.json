                ],
                "senses": [
                    {
                        "sense_id": "4d000616-ed3a-394f-867d-7517bf88efb8",
                        "entry_id": "fd4fe5b2-0752-3682-b5fb-8e2170e22f2d",
                        "glosses": [
                            "Beeinflussung einer Sprache beziehungsweise ihres Gebrauchs mit dem Ziel, das Bewusstsein der Sprecher dieser Sprache in eine gewünschte Richtung zu lenken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "000f0a54-1833-4d13-8dd3-fab4c7029ef9",
                                "sense_id": "4d000616-ed3a-394f-867d-7517bf88efb8",
                                "text": "Sprachpolitik ist besonders in Konfliktzeiten ein Mittel der Auseinandersetzung."
                            },
                            {
                                "example_id": "25e613c5-6a1d-4fbf-8102-3c2acfe9ff8e",
                                "sense_id": "4d000616-ed3a-394f-867d-7517bf88efb8",
                                "text": "Metzler Lexikon Sprache nennt als literarisches Beispiel für Sprachpolitik George Orwells Newspeak im Roman 1984."
                            },
                            {
                                "example_id": "f835e8f4-df5e-477d-bb50-13b2267008c4",
                                "sense_id": "4d000616-ed3a-394f-867d-7517bf88efb8",
                                "text": "Der Euphemismus \"Kollateralschaden\" ist ein Beispiel der jüngsten Vergangenheit für Sprachpolitik."
                            },
                            {
                                "example_id": "65159f57-2956-43c6-b2d7-04158b1cd59b",
                                "sense_id": "4d000616-ed3a-394f-867d-7517bf88efb8",
                                "text": "„Der Aufschwung, den die Sprachpolitik seit Inkrafttreten der Loi Toubon zu nehmen scheint, darf nicht darüber hinwegtäuschen, daß sich an dem ihr zugrunde liegenden Prinzip nichts Entscheidendes geändert hat.“"
                            },
                            {
                                "example_id": "06060e64-5eeb-4263-a32a-32f875ff787b",
                                "sense_id": "4d000616-ed3a-394f-867d-7517bf88efb8",
                                "text": "„Obwohl die Unterscheidung zwischen ‚Sprache‘ und ‚Varietät einer Sprache‘ schwierig ist…, muß (…) grundsätzlich unterschieden werden zwischen Sprachenpolitik als »exoglossischem/interethnischem« Prozeß (zwischen zwei Sprachen/ Volksgruppen) und Sprachpolitik als »endoglossischem/intraethnischem« Prozeß innerhalb einer Sprache/Volksgruppe…Einen beides umfassenden weiteren Begriff Sprachpolitik postuliert Utz Maas (…) im Rahmen einer »politischen Sprachwissenschaft«…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "67adab67-733a-320a-bf62-7a119542ad75",
                        "entry_id": "fd4fe5b2-0752-3682-b5fb-8e2170e22f2d",
                        "glosses": [
                            "Der Ausdruck Sprachpolitik wird z.T. auch im Sinne von Sprachenpolitik verwendet, also als eine auf mehr als eine Sprache gerichtete Politik."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e670cdae-c711-4cc5-af7a-337bc32d1404",
                                "sense_id": "67adab67-733a-320a-bf62-7a119542ad75",
                                "text": "„Obwohl die Unterscheidung zwischen ‚Sprache‘ und ‚Varietät einer Sprache‘ schwierig ist…, muß (…) grundsätzlich unterschieden werden zwischen Sprachenpolitik als »exoglossischem/interethnischem« Prozeß (zwischen zwei Sprachen/ Volksgruppen) und Sprachpolitik als »endoglossischem/intraethnischem« Prozeß innerhalb einer Sprache/Volksgruppe…Einen beides umfassenden weiteren Begriff Sprachpolitik postuliert Utz Maas (…) im Rahmen einer »politischen Sprachwissenschaft«…“"
                            },
                            {
                                "example_id": "1c7e2748-076f-40d5-a0e7-d8fc53dff08d",
                                "sense_id": "67adab67-733a-320a-bf62-7a119542ad75",
                                "text": "„Hier steht die westeuropäische Sprachpolitik vor kaum zu lösenden Problemen; ein großer Fortschritt wäre erzielt, wenn die europäischen Staaten sich auf eine gemeinsame Zweitsprache einigen könnten.“"
                            },
                            {
                                "example_id": "65ea3ba1-9972-46b2-b233-bd038de4e3d1",
                                "sense_id": "67adab67-733a-320a-bf62-7a119542ad75",
                                "text": "„Dies erlaubte der Regierung bis zur Machtergreifung des autoritären Ulmanis-Regimes (1934) eine ausgesprochen minderheitenfreundliche Sprach- und Kulturpolitik.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
