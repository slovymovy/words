                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "68b466ed-a6e2-4c5a-80f3-a7794caf5332",
                                "sense_id": "89a25815-979f-33b8-a93e-a066e795faae",
                                "text": "These all agree with typical Thysananthus in habit, rooting flagella, lingulate leaves, repeatedly and closely innovant inflorescence, and trigonous perianths; and only differ in the entire underleaves and perianths."
                            },
                            {
                                "example_id": "b1f504c1-7515-4d32-b73d-290ca08f2bc1",
                                "sense_id": "89a25815-979f-33b8-a93e-a066e795faae",
                                "text": "Secondary less rigid, paler brown, ascending, simple or dichotomous, innovant in older plants."
                            },
                            {
                                "example_id": "32241a3c-0665-41a0-aceb-414a375df3dc",
                                "sense_id": "89a25815-979f-33b8-a93e-a066e795faae",
                                "text": "Stems irregularly pinnate, alternate, 2 to 3 cells wide, innovant branch arising from base of perianth, sometimes long and again innovant, rarely two innovant branches."
                            }
                        ]
