                                "target_lang_sense_clarification": "исторический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿兹特克的",
                                "target_lang_sense_clarification": "指代古代文明"
                            }
                        ]
                    }
                },
                {
