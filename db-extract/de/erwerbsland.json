                ],
                "senses": [
                    {
                        "sense_id": "b697d35d-5acf-3f17-8abe-b9bcf06e5924",
                        "entry_id": "840f6a26-4676-31bb-a44c-a1a5e93cc9dc",
                        "glosses": [
                            "Staat, in dem der Kauf einer Ware erfolgt (oft in Zusammenhang mit der Erhebung von Steuern gebraucht); Staat, in dem ein Schulabschluss/Hochschulabschluss erworben wird; Staat, in dem man einer Erwerbsarbeit nachgeht"
                        ],
                        "tags": [
                            "auch",
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "834b65da-bcca-4256-81cd-11892bee303d",
                                "sense_id": "b697d35d-5acf-3f17-8abe-b9bcf06e5924",
                                "text": "„Grundsätzlich wird die Mehrwertsteuer im Erwerbsland, d. h. beim Kauf der Ware, fällig.“"
                            },
                            {
                                "example_id": "4f358087-97df-4125-8bf2-d12ab87612e8",
                                "sense_id": "b697d35d-5acf-3f17-8abe-b9bcf06e5924",
                                "text": "„Gegenstände, die private Reisende aus EU-Mitgliedstaaten in anderen Mitgliedstaaten erwerben, unterliegen ausschließlich der Umsatzsteuer (und gegebenenfalls der Verbrauchsteuer) im Erwerbsland.“"
                            },
                            {
                                "example_id": "3dbef391-5813-4c49-98d8-35a1b06ca425",
                                "sense_id": "b697d35d-5acf-3f17-8abe-b9bcf06e5924",
                                "text": "„Der Erwerb von Waren aus anderen Mitgliedstaaten der Gemeinschaft zu privaten Zwecken unterliegt ausschließlich der Umsatzbesteuerung im Erwerbsland, Ausnahme: neue Fahrzeuge (sogen. EU- oder Re-Import-Fahrzeuge).“"
                            },
                            {
                                "example_id": "984b600d-db47-4d06-9c70-c0ac4fc4b9bc",
                                "sense_id": "b697d35d-5acf-3f17-8abe-b9bcf06e5924",
                                "text": "„Somit ist gewährleistet, dass neue Fahrzeuge immer im Erwerbsland erfasst und im Ursprungsland immer befreit sind.“"
                            },
                            {
                                "example_id": "4920834e-306d-4d63-aa2a-373a3f3cd9ad",
                                "sense_id": "b697d35d-5acf-3f17-8abe-b9bcf06e5924",
                                "text": "[Die Identifikationsnummern von Unternehmen] „sollen die umsatzsteuerliche Erfassung des innergemeinschaftlichen Erwerbs in dem jeweiligen Erwerbsland sichern.“"
                            },
                            {
                                "example_id": "dad4481f-7f94-42cc-9a00-4e46f3c62201",
                                "sense_id": "b697d35d-5acf-3f17-8abe-b9bcf06e5924",
                                "text": "„Enthält der Kaufpreis zB einen Mehrwertsteuerbetrag, so wird dieser Betrag nicht in die Berechnungsbasis einbezogen, wenn Sie nachweisen können, dass die Waren im Erwerbsland von der Mehrwertsteuer befreit worden sind oder befreit werden und diese Befreiung Ihnen als Käufer zugute kommt.“"
                            },
                            {
                                "example_id": "e679b8cd-61a3-4377-b7bc-57c4f67a4661",
                                "sense_id": "b697d35d-5acf-3f17-8abe-b9bcf06e5924",
                                "text": "„Vergleichbarkeit liegt vor, wenn eine mindestens dreijährige Regelstudienzeit an einer im Erwerbsland staatlich anerkannten Universität vorliegt.“"
                            },
                            {
                                "example_id": "1ca2b0ec-4758-4c14-a1ae-816b5169069a",
                                "sense_id": "b697d35d-5acf-3f17-8abe-b9bcf06e5924",
                                "text": "„Die hochschulspezifische Unterscheidung zwischen der Staatsangehörigkeit einerseits und dem Erwerbsland der Hochschulzugangsberechtigung (HZB) andererseits belegt die Studierenden aus Migranten-Familien – und damit eine nennenswerte Zahl der Studierenden insgesamt – sowohl mit einem Etikett der Zugehörigkeit (HZB) als auch mit einem der Nichtzugehörigkeit (Staatsbürgerschaft) zur Mehrheitsgruppe.“"
                            },
                            {
                                "example_id": "c0b9b013-edab-4d5f-b9ed-ee8f7bb04c09",
                                "sense_id": "b697d35d-5acf-3f17-8abe-b9bcf06e5924",
                                "text": "„Was geschah am 25. Januar 1940 – In einer Stellungnahme des Schweizer Bundesrats zum Emigrantenproblem im Lande wird darauf hingewiesen, dass die Schweiz kein Erwerbsland für Einwanderer sein könne, sondern nur eine Durchgangsstation für die Weiterreise nach Übersee.“"
                            },
                            {
                                "example_id": "8676b0a5-3bbd-48ff-b1bb-5b638591515a",
                                "sense_id": "b697d35d-5acf-3f17-8abe-b9bcf06e5924",
                                "text": "„Auch Ablauf und Stil des Migrationsaktes können beträchtlich variieren: Je nachdem, ob die Migration als etwas Endgültiges (nach einer Flucht) oder als etwas Widerrufliches (als vorübergehendes Erwerbsland) erlebt wird, oder ob legal oder illegal in ein Land migriert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
