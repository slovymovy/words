                        "examples": [
                            {
                                "example_id": "0b0f0151-322c-4c61-b98e-d4885de1ad95",
                                "sense_id": "9aa5f865-f3d1-31fe-b3e6-9ad8d94a0f6c",
                                "text": "In het appartement aan de Arnhemse Valckenierstraat woont Hardi N. Donderdag aan het eind van de middag viel de politie hier met groot machtsvertoon binnen. Volgens buurtbewoners stormden uit zeker 8 of 9 geblindeerde busjes zwaarbewapende mannen om Hardi in te rekenen."
                            },
                            {
                                "example_id": "28a93083-8044-4c70-be24-4d6739ccf4e1",
                                "sense_id": "9aa5f865-f3d1-31fe-b3e6-9ad8d94a0f6c",
                                "text": "Wat is zich precies heeft afgespeeld in de Lepelaarstraat is vooralsnog onduidelijk. De politie doet er geen mededelingen over. De straat is afgezet en het huis is met geblindeerde hekken volledig aan het zicht onttrokken."
                            }
                        ]
                    }
