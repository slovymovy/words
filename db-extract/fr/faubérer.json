                "senses": [
                    {
                        "sense_id": "163c651a-d722-37b7-bd30-eb5e118e9056",
                        "entry_id": "c61816bd-feb6-3b1e-a08f-98649d44d143",
                        "glosses": [
                            "Passer le fauber (la serpillère), la wassingue sur une surface."
                        ],
                        "tags": [
                            "Mali",
                            "Sénégal"
                        ],
                        "examples": [
                            {
                                "example_id": "a479cca6-abba-4f1b-9595-3aa0ce401f55",
                                "sense_id": "163c651a-d722-37b7-bd30-eb5e118e9056",
                                "text": "À Port-Étienne où il ne pleuvait que tous les trois ans si ce n’était sept, il faudra, avant de jouer le matin, balayer et « faubérer » le court de tennis trempé de l’embrun nocturne de l’Océan."
                            },
                            {
                                "example_id": "4b46203f-88a0-4002-a685-ca73ddd91b6a",
                                "sense_id": "163c651a-d722-37b7-bd30-eb5e118e9056",
                                "text": "Dans l’exercice de l’éditorial du jour, et à l’occasion de la fête internationale de la liberté de presse 2018, vais-je faubérer le salon sans vous ?"
                            },
                            {
                                "example_id": "afefcaaa-56e0-4305-915f-ed13d4701da3",
                                "sense_id": "163c651a-d722-37b7-bd30-eb5e118e9056",
                                "text": "Spontanément, quelqu’un s’auto-désigne pour balayer et faubérer."
                            }
                        ]
                    }
                ],
