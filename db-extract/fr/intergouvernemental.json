                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a04cbd87-b669-37e7-b008-47bd535955ef",
                        "entry_id": "73141b00-73f9-3552-8d85-21cec90723f6",
                        "glosses": [
                            "Qui concerne plusieurs gouvernements, qui relève de plusieurs gouvernements.",
                            "Qui se fait, se négocie entre plusieurs gouvernements."
                        ],
                        "tags": [
                            "Droit international public",
                            "En parlant d’un accord"
                        ],
                        "examples": [
                            {
                                "example_id": "36468fd1-71c5-472c-a990-f65bc984aef0",
                                "sense_id": "a04cbd87-b669-37e7-b008-47bd535955ef",
                                "text": "Pas moins de sept accords intergouvernementaux ou industriels doivent y être paraphés par les autorités ou les entreprises françaises (Areva, EDF) et italiennes (Enel, Ansaldo Nucleare), en matière de sûreté, de gestion des déchets, de formation ou d'échanges techniques."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6dc2371-3d56-32fd-b272-4c6af453e126",
                        "entry_id": "73141b00-73f9-3552-8d85-21cec90723f6",
                        "glosses": [
                            "Qui concerne plusieurs gouvernements, qui relève de plusieurs gouvernements.",
                            "Qui est composé de plusieurs États souverains."
                        ],
                        "tags": [
                            "Droit international public",
                            "En parlant d’une organisation"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "506e2992-24ca-3775-9e15-e0928f087925",
                        "entry_id": "73141b00-73f9-3552-8d85-21cec90723f6",
                        "glosses": [
                            "Qui concerne plusieurs gouvernements, qui relève de plusieurs gouvernements.",
                            "Qui réunit les représentants de plusieurs États souverains."
                        ],
                        "tags": [
                            "Droit international public",
                            "En parlant d’une conférence"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5846ee85-e794-4c0b-901e-62ab5773739f",
                        "source_entry_id": "73141b00-73f9-3552-8d85-21cec90723f6",
                        "source_sense_description": "entre gouvernements",
                        "target_lang_word": "zwischenstaatlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zwischenstaatlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1de20f52-1832-3729-b84b-c805af29cb14",
                                        "entry_id": "7bff9893-92b4-39fa-bb79-5cee9b00125b",
                                        "glosses": [
                                            "zwischen verschiedenen Staaten/Ländern (geschehend); über die staatlichen Grenzen hinaus geltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "881423a4-6693-4feb-acb2-033e1593d866",
                                                "sense_id": "1de20f52-1832-3729-b84b-c805af29cb14",
                                                "text": "„Und die Frage ist, wie ein solches Recht zwischenstaatlich gedacht und umgesetzt werden kann.“"
                                            },
                                            {
                                                "example_id": "f8d97873-b152-4c05-b1be-8d6ee96f534c",
                                                "sense_id": "1de20f52-1832-3729-b84b-c805af29cb14",
                                                "text": "„Konflikte können diesem zufolge interethnisch, innerstaatlich, zwischenstaatlich oder international sein.“"
                                            },
                                            {
                                                "example_id": "55864a94-2115-4005-a895-5731b5689726",
                                                "sense_id": "1de20f52-1832-3729-b84b-c805af29cb14",
                                                "text": "„Wegen der Einbeziehung des Einzelmenschen ist es als ein Menschheitsrecht aufzufassen, zu dem das zwischenstaatliche Recht gehört, es aber nicht allein ausmacht.“"
                                            },
                                            {
                                                "example_id": "88ec8966-7136-49dc-b167-0e06e7033f91",
                                                "sense_id": "1de20f52-1832-3729-b84b-c805af29cb14",
                                                "text": "„Da zwischenstaatlich vereinbartes Recht dem inneren Recht des Vertragsstaats vorgeht, gilt dieses nur, soweit jenes das ausdrücklich zuläßt.“"
                                            },
                                            {
                                                "example_id": "cb4ee450-29db-4c1a-833a-cf46bf85f38d",
                                                "sense_id": "1de20f52-1832-3729-b84b-c805af29cb14",
                                                "text": "„Ein mittlerer Effekt anhand von kontextuellen Aggregationen, so lässt sich festhalten, kann diese zwischenstaatliche Varianz kaum erfassen.“"
                                            },
                                            {
                                                "example_id": "2f18a74d-2d72-4127-929e-15e2131a126c",
                                                "sense_id": "1de20f52-1832-3729-b84b-c805af29cb14",
                                                "text": "„Er umfasst nicht nur den gesamten Warenverkehr, sondern erstreckt sich auch auf Teilprodukte, die nur Bestandteil eines anderen Produkts sind, das zwischenstaatlich gehandelt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
