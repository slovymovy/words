                "translations": [
                    {
                        "translation_id": "0f2b7310-262d-4190-a73d-cb4a659ec254",
                        "source_entry_id": "4dc263d7-1fcb-321e-a638-867cd2873ea5",
                        "source_sense_description": "state or quality of being spiteful",
                        "target_lang_word": "Gehässigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gehässigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71431d0d-c6a8-384c-bf9c-fe07cb993208",
                                        "entry_id": "0f7dd23e-f97c-31e2-8a67-1dc168ccb1b4",
                                        "glosses": [
                                            "boshaftes Verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6189cd43-f2f7-41a6-b4cb-b1a52c6ed774",
                                                "sense_id": "71431d0d-c6a8-384c-bf9c-fe07cb993208",
                                                "text": "Sein durch und durch schlechtes Verhalten war an Gehässigkeit nicht mehr zu überbieten."
                                            },
                                            {
                                                "example_id": "b2682ee1-2a03-469b-8ff9-7f1532ea3320",
                                                "sense_id": "71431d0d-c6a8-384c-bf9c-fe07cb993208",
                                                "text": "„Auch diejenigen, die ihre Weisheit gern von sich gaben und ihre Gefühle gern aussprachen und die Lage Russlands tiefgründig erörterten, brachten in alles, was sie sagten, unwillkürlich einen Zug von Heuchelei und Lüge oder von unfruchtbarer Kritikasterei und Gehässigkeit gegen irgendwelche anderen Menschen, denen sie die Schuld an Dingen beimassen, an denen niemand schuld sein konnte.“"
                                            },
                                            {
                                                "example_id": "e33d054c-a0a4-4a69-9eeb-26f6775f1a6d",
                                                "sense_id": "71431d0d-c6a8-384c-bf9c-fe07cb993208",
                                                "text": "„Ich hörte, wie ein junger Abate mit lauter Stimme eine wahre oder erfundene Begebenheit erzählte, die unmittelbar, doch ohne Gehässigkeit, die Rechtsprechung des Heiligen Vaters angriff.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0502f816-6ceb-429c-94ab-351e66fa28b7",
                        "source_entry_id": "4dc263d7-1fcb-321e-a638-867cd2873ea5",
                        "source_sense_description": "state or quality of being spiteful",
                        "target_lang_word": "Boshaftigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Boshaftigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d6a4eb41-9637-3541-88e7-02534f26ef60",
                                        "entry_id": "e0d97ed9-44b5-3831-bff1-6ff53ca7c382",
                                        "glosses": [
                                            "Eigenschaft, boshaft zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a24f2e78-c21a-4013-83f0-763cd6639b99",
                                                "sense_id": "d6a4eb41-9637-3541-88e7-02534f26ef60",
                                                "text": "„Doch diese deutschen Boshaftigkeiten waren ganz und gar nicht auf die leichte Schulter zu nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de0b5ac7-8632-40a2-925c-4507db2d6523",
                        "source_entry_id": "4dc263d7-1fcb-321e-a638-867cd2873ea5",
                        "source_sense_description": "state or quality of being spiteful",
                        "target_lang_word": "Bosheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bosheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "911c3941-db7e-3320-9bf9-8efd5e751472",
                                        "entry_id": "4348ccad-a0a3-31fd-bd52-b715c7f34fd8",
                                        "glosses": [
                                            "böse, schlechte Gesinnung"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dd20881-7bc2-40e8-93c5-4d62b024e8a3",
                                                "sense_id": "911c3941-db7e-3320-9bf9-8efd5e751472",
                                                "text": "Er war ein Mensch voller Bosheit, viele sind ihm aus dem Weg gegangen."
                                            },
                                            {
                                                "example_id": "650cdccc-152a-48ce-8387-6d687c4e6f08",
                                                "sense_id": "911c3941-db7e-3320-9bf9-8efd5e751472",
                                                "text": "„Sloan antwortete, dass Bosheit zweifellos eine wirkungsvolle Kraft sei.“"
                                            },
                                            {
                                                "example_id": "d681fd81-1410-41d1-91e9-570908b43c18",
                                                "sense_id": "911c3941-db7e-3320-9bf9-8efd5e751472",
                                                "text": "„Selbst Menschen, die ihm früher mit Bosheit und unverhohlener Feindseligkeit begegnet waren, zeigten sich jetzt zärtlich und liebevoll.“"
                                            },
                                            {
                                                "example_id": "4210692c-e154-4651-a85b-7176409d1d1a",
                                                "sense_id": "911c3941-db7e-3320-9bf9-8efd5e751472",
                                                "text": "„Die Dummheit einer Dienerin ist viel gefährlicher als ihre Bosheit und belastet den Herrn weit mehr, denn eine Bösartige kann man mit Recht bestrafen, eine Dumme aber nicht; man kann sie nur fortschicken und sich damit abfinden.“"
                                            },
                                            {
                                                "example_id": "689184f2-ebe6-44de-a219-2a3771372e61",
                                                "sense_id": "911c3941-db7e-3320-9bf9-8efd5e751472",
                                                "text": "„Es war nicht Roheit oder Bosheit gewesen, die dem jungen Seemann die unbesonnene Frage auf die Zunge gebracht hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "267309af-ad33-3ee2-9c1c-0c11df17dc11",
                                        "entry_id": "4348ccad-a0a3-31fd-bd52-b715c7f34fd8",
                                        "glosses": [
                                            "boshafte Tat; böser Scherz; boshafte Aussage; abfällige, stichelnde, verletzende Bemerkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39f28e61-6c52-40e3-81c4-d59848f327d9",
                                                "sense_id": "267309af-ad33-3ee2-9c1c-0c11df17dc11",
                                                "text": "Das war eine Bosheit von ihr, mich so vor der Versammlung bloßzustellen."
                                            },
                                            {
                                                "example_id": "4bde873f-ab78-42aa-ad70-496f3c0e1f96",
                                                "sense_id": "267309af-ad33-3ee2-9c1c-0c11df17dc11",
                                                "text": "Immer, wenn keiner von den Anderen es hören konnte, warf er ihr Bosheiten zu, um sie zu ärgern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
