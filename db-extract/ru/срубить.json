                                        "examples": [
                                            {
                                                "example_id": "16c73348-8f8e-413d-a479-74e05d4e49c7",
                                                "sense_id": "04ffe9d1-daa6-3c13-9c57-b81c40f63a8c",
                                                "text": "We need to cut the cocaine down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43b66673-b9ac-3e08-9b8b-fa47ab809722",
                                        "entry_id": "9fa7fd89-814b-3228-9813-4f27f8b6a1de",
                                        "glosses": [
                                            "To bring down by cutting."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0070f7b8-f654-4e0c-8e1f-ea1d2dcf3ff1",
                                                "sense_id": "43b66673-b9ac-3e08-9b8b-fa47ab809722",
                                                "text": "They want to cut down several trees to make room for the parking lot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d6102e-f093-37c8-9c7b-bd2e11234206",
                                        "entry_id": "9fa7fd89-814b-3228-9813-4f27f8b6a1de",
                                        "glosses": [
                                            "To insult, to belittle."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8141918-9348-3144-beef-26bf2eb3e980",
                                        "entry_id": "9fa7fd89-814b-3228-9813-4f27f8b6a1de",
                                        "glosses": [
                                            "To reduce the amount of something."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c030932b-cd4e-42f7-bb8c-6405def19d7a",
                                                "sense_id": "e8141918-9348-3144-beef-26bf2eb3e980",
                                                "text": "He wants to cut down on extra steps."
                                            },
                                            {
                                                "example_id": "8fd24708-9e06-4e3f-99dd-c066b09f65d4",
                                                "sense_id": "e8141918-9348-3144-beef-26bf2eb3e980",
                                                "text": "Please don't put the candy jar right next to my desk. I'm trying to cut down on sugar."
                                            },
                                            {
                                                "example_id": "8fd8bb6b-ce6b-4260-87f5-262778026abe",
                                                "sense_id": "e8141918-9348-3144-beef-26bf2eb3e980",
                                                "text": "By wholesale omission of connections and by the use of a microscopic scale of photographic reproduction which makes some of the most important tables difficult to read, the size has been cut down from last winter's 580 to 520 pages only."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3b6145a-4f9e-3202-af81-ade954912848",
                                        "entry_id": "9fa7fd89-814b-3228-9813-4f27f8b6a1de",
                                        "glosses": [
                                            "To slay, often in great numbers."
                                        ],
                                        "tags": [
                                            "dated",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15617069-ce75-495c-869a-725adba31792",
                                                "sense_id": "d3b6145a-4f9e-3202-af81-ade954912848",
                                                "text": "I will cut you down where you stand."
                                            }
                                        ]
