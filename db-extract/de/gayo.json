                "senses": [
                    {
                        "sense_id": "056011c4-1a61-3e7c-acf7-87d62243a1ff",
                        "entry_id": "1ad99fbe-5de5-3e34-94fc-bbc89e3acf53",
                        "glosses": [
                            "die malayo-polynesische Sprache des gleichnamigen Volks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "429f9b2a-2677-49ff-b09c-24a3ad748c85",
                                "sense_id": "056011c4-1a61-3e7c-acf7-87d62243a1ff",
                                "text": "Wie heißt das auf Gayo?"
                            },
                            {
                                "example_id": "01df5cd5-5105-4edb-802d-8ec931f566ec",
                                "sense_id": "056011c4-1a61-3e7c-acf7-87d62243a1ff",
                                "text": "Das Gayo ist nur entfernt mit anderen Sprachen verwandt."
                            },
                            {
                                "example_id": "03880754-fab9-4fc0-a7a0-385aee5c85a0",
                                "sense_id": "056011c4-1a61-3e7c-acf7-87d62243a1ff",
                                "text": "„Einige Sprachen haben beide Formen n und ni nebeneinandern, so das Gayo.“"
                            },
                            {
                                "example_id": "8c772fbe-9900-443a-a2bf-cd322e5a342f",
                                "sense_id": "056011c4-1a61-3e7c-acf7-87d62243a1ff",
                                "text": "„[…] wie z. B. Batak und Gayo – sowie die Sprachen östlich von Kalimantan und Java weisen ein nur entferntes Verwandtschaftsverhältnis zur Bahasa Indonesia auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
