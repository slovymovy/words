                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cc01a1d-6674-3bef-956c-aae065155c71",
