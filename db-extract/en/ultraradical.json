                        "glosses": [
                            "Extremely radical, especially in politics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "873962e3-9234-4a98-9273-ef1f6500df46",
                                "sense_id": "bde51e36-2825-3b09-9a22-de4831326f35",
                                "text": "An ultraradical Wahhabi fringe group was headed by Ayub Omarov (aka Ayub Astrakhansky), a Dagestani Avar from the Tsumadinskii raion. He resided in Astrakhan, and organized his ultraradical group among the Dagestani diaspora in that area."
                            },
                            {
                                "example_id": "cfa17d04-9789-4090-bc88-4b395258f5a5",
                                "sense_id": "bde51e36-2825-3b09-9a22-de4831326f35",
                                "text": "The Bolsheviks (the name derives from the Russian for big, or majority) were the ultra-radical faction of the Russian Social Democratic Labor Party and the direct ancestor of the Communist Party of the Soviet Union."
                            }
                        ]
                    }
