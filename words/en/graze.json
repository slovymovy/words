{
    "word_family": [
        "grazer",
        "grazing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c65c395-8687-3056-9413-ef6fc583584d",
                    "sense_definition": "The act of animals feeding on grass in a pasture.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_feeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cows were out for their daily <w>graze</w> in the green field.",
                            "target_lang_translations": {
                                "cs": "Krávy byly venku na své každodenní <w>pastvě</w> na zelené louce."
                            }
                        },
                        {
                            "text": "The herd returned from their <w>graze</w> as the sun began to set.",
                            "target_lang_translations": {
                                "cs": "Stádo se vrátilo z <w>pastvy</w>, když slunce začalo zapadat."
                            }
                        }
                    ],
                    "common_phrases": [
                        "daily graze"
                    ],
                    "target_lang_definitions": {
                        "cs": "Činnost zvířat, která se pasou na trávě na pastvině."
                    },
                    "translations": {
                        "cs": []
                    }
                },
                {
                    "sense_id": "9d322826-1cda-3afe-9282-5f46c199a97a",
                    "sense_definition": "A minor skin injury caused by rubbing against a rough surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He fell on the pavement and got a painful <w>graze</w> on his knee.",
                            "target_lang_translations": {
                                "cs": "Upadl na chodník a udřel si bolestivý <w>škrábanec</w> na koleni."
                            }
                        },
                        {
                            "text": "The doctor cleaned the <w>graze</w> and put a bandage on it.",
                            "target_lang_translations": {
                                "cs": "Doktor <w>odřeninu</w> vyčistil a přelepil ji náplastí."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nasty graze"
                    ],
                    "target_lang_definitions": {
                        "cs": "Drobné poranění kůže způsobené třením o drsný povrch."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "škrábanec",
                                "target_lang_sense_clarification": "povrchové poranění kůže"
                            },
                            {
                                "target_lang_word": "odřenina",
                                "target_lang_sense_clarification": "poranění vzniklé odřením o povrch"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "62a1707b-60da-344d-9398-03c220b86237",
                    "sense_definition": "To eat grass or other plants while in a field.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal_feeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheep <w>graze</w> peacefully in the meadow all day long.",
                            "target_lang_translations": {
                                "cs": "Ovce se celý den pokojně <w>pasou</w> na louce."
                            }
                        },
                        {
                            "text": "We watched the horses <w>graze</w> near the fence.",
                            "target_lang_translations": {
                                "cs": "Sledovali jsme koně, jak se <w>pasou</w> u plotu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cattle graze"
                    ],
                    "target_lang_definitions": {
                        "cs": "Jíst trávu nebo jiné rostliny na poli."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pást se",
                                "target_lang_sense_clarification": "zvířata přijímající potravu na pastvě"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44e72170-eed4-3495-8f38-b0a78b805bf0",
                    "sense_definition": "To touch or rub against something lightly while moving past it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car <w>grazed</w> the wall as it turned the corner.",
                            "target_lang_translations": {
                                "cs": "Auto při zatáčení v rohu <w>škrtlo</w> o zeď."
                            }
                        },
                        {
                            "text": "The bullet <w>grazed</w> his shoulder but did not cause a serious wound.",
                            "target_lang_translations": {
                                "cs": "Kulka ho <w>škrábla</w> do ramene, ale nezpůsobila vážné zranění."
                            }
                        }
                    ],
                    "common_phrases": [
                        "barely graze"
                    ],
                    "target_lang_definitions": {
                        "cs": "Lehce se dotknout nebo otřít o něco při pohybu kolem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "škrtnout",
                                "target_lang_sense_clarification": "lehký kontakt při pohybu"
                            },
                            {
                                "target_lang_word": "zavadit",
                                "target_lang_sense_clarification": "lehký náraz nebo kontakt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d3b34dc-9f0f-39c8-9f81-e22a10434903",
                    "sense_definition": "To cause a minor skin injury by rubbing against a rough surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tripped and managed to <w>graze</w> my elbow on the concrete.",
                            "target_lang_translations": {
                                "cs": "Zakopl jsem a podařilo se mi <w>odřít</w> si loket o beton."
                            }
                        },
                        {
                            "text": "Be careful not to <w>graze</w> your skin on the sharp rocks.",
                            "target_lang_translations": {
                                "cs": "Dávej pozor, ať si <w>neodřeš</w> kůži o ostré kameny."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit drobné poranění kůže třením o drsný povrch."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "odřít si",
                                "target_lang_sense_clarification": "způsobit si odřeninu"
                            },
                            {
                                "target_lang_word": "škrábnout si",
                                "target_lang_sense_clarification": "způsobit si drobné poranění"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca63d329-3ee0-3b84-8cd9-c12a00ca644f",
                    "sense_definition": "To eat small amounts of food frequently throughout the day instead of having full meals.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "human_eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some people prefer to <w>graze</w> on healthy snacks rather than eating three large meals.",
                            "target_lang_translations": {
                                "cs": "Někteří lidé raději průběžně <w>uzobávají</w> zdravé svačinky, než aby jedli tři velká jídla."
                            }
                        },
                        {
                            "text": "It is easy to <w>graze</w> on junk food when you are busy working at your desk.",
                            "target_lang_translations": {
                                "cs": "Je snadné <w>zobat</w> nezdravé jídlo, když jsi zaneprázdněn prací u stolu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "graze throughout the day"
                    ],
                    "target_lang_definitions": {
                        "cs": "Jíst malé množství jídla často během dne místo velkých jídel."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "uzobávat",
                                "target_lang_sense_clarification": "jíst po malých kouscích průběžně"
                            },
                            {
                                "target_lang_word": "zobat",
                                "target_lang_sense_clarification": "neformální výraz pro časté pojídání drobností"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}