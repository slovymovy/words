{
    "word_family": [
        "quirky",
        "quirkiness",
        "quirkily"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "61a79917-94e8-3297-bebf-46b8bc99594c",
                    "sense_definition": "A peculiar behavioral habit or an unusual feature of a person or thing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "idiosyncrasy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old car steers cleanly, but the gearshift has a few <w>quirks</w> that you need to get used to.",
                            "target_lang_translations": {
                                "ru": "Старая машина управляется хорошо, но у переключения передач есть свои <w>особенности</w>, к которым нужно привыкнуть."
                            }
                        },
                        {
                            "text": "Everyone has a personality <w>quirk</w> that makes them unique and interesting to others.",
                            "target_lang_translations": {
                                "ru": "У каждого есть своя <w>причуда</w> в характере, которая делает его уникальным и интересным для окружающих."
                            }
                        }
                    ],
                    "synonyms": [
                        "idiosyncrasy",
                        "eccentricity",
                        "peculiarity",
                        "mannerism"
                    ],
                    "antonyms": [
                        "normality",
                        "regularity"
                    ],
                    "common_phrases": [
                        "personality quirk",
                        "little quirk",
                        "quirk of fate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Своеобразная привычка в поведении или необычная черта человека или предмета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причуда",
                                "target_lang_sense_clarification": "странное чудачество или каприз"
                            },
                            {
                                "target_lang_word": "особенность",
                                "target_lang_sense_clarification": "отличительная черта"
                            },
                            {
                                "target_lang_word": "пунктик",
                                "target_lang_sense_clarification": "небольшая странность в поведении"
                            },
                            {
                                "target_lang_word": "тараканы в голове",
                                "target_lang_sense_clarification": "идиома о странностях человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67eac2f1-780c-37dc-a930-559c083e1ea2",
                    "sense_definition": "A clever or witty evasion, quibble, or verbal trick.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "evasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer used a clever <w>quirk</w> of language to avoid answering the direct question.",
                            "target_lang_translations": {
                                "ru": "Адвокат использовал хитрую языковую <w>уловку</w>, чтобы избежать прямого ответа на вопрос."
                            }
                        },
                        {
                            "text": "He was known for his <w>quirks</w> of wit that often confused his opponents during the debate.",
                            "target_lang_translations": {
                                "ru": "Он был известен своими остроумными <w>выпадами</w>, которые часто сбивали с толку его оппонентов во время дебатов."
                            }
                        }
                    ],
                    "synonyms": [
                        "quibble",
                        "subterfuge",
                        "evasion"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "used in the sense of a verbal subterfuge"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Умная или остроумная уловка, двусмысленность или словесный трюк."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уловка",
                                "target_lang_sense_clarification": "хитрость в словах"
                            },
                            {
                                "target_lang_word": "изворот",
                                "target_lang_sense_clarification": "попытка уклониться от прямого ответа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53f5400c-a534-38b5-a471-e7a1a72c99cb",
                    "sense_definition": "An acute angle or groove dividing a molding in architecture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect specified a deep <w>quirk</w> between the molding and the soffit for better shadow definition.",
                            "target_lang_translations": {
                                "ru": "Архитектор указал глубокую <w>канавку</w> между карнизом и софитом для более четкой тени."
                            }
                        },
                        {
                            "text": "A narrow <w>quirk</w> runs lengthwise along the upper part of the decorative wooden frame.",
                            "target_lang_translations": {
                                "ru": "Узкий <w>желобок</w> проходит вдоль верхней части декоративной деревянной рамы."
                            }
                        }
                    ],
                    "synonyms": [
                        "groove",
                        "channel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Острый угол или желобок, разделяющий элементы лепнины в архитектуре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канавка",
                                "target_lang_sense_clarification": "узкий желобок в архитектуре"
                            },
                            {
                                "target_lang_word": "выемка",
                                "target_lang_sense_clarification": "углубление в профиле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "50be1377-da11-31a2-892a-9a2bd695fab6",
                    "sense_definition": "To move or twist a part of the face with a sudden, often playful or wry, jerk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "facial_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>quirked</w> an eyebrow in surprise when he heard the unexpected news.",
                            "target_lang_translations": {
                                "ru": "Он удивленно <w>вскинул</w> бровь, услышав неожиданную новость."
                            }
                        },
                        {
                            "text": "The corners of her mouth <w>quirked</w> into a small smile as she watched the children play.",
                            "target_lang_translations": {
                                "ru": "Уголки ее рта <w>дрогнули</w> в легкой улыбке, пока она наблюдала за игрой детей."
                            }
                        }
                    ],
                    "synonyms": [
                        "twitch",
                        "jerk"
                    ],
                    "common_phrases": [
                        "quirk an eyebrow",
                        "mouth quirked"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигать или дергать частью лица, часто игриво или иронично."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дернуть",
                                "target_lang_sense_clarification": "резко пошевелить бровью или губой"
                            },
                            {
                                "target_lang_word": "искривиться",
                                "target_lang_sense_clarification": "о губах в усмешке"
                            },
                            {
                                "target_lang_word": "вскинуть",
                                "target_lang_sense_clarification": "о брови"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a0541b5-0c81-35db-9ef0-0986981c80f4",
                    "sense_definition": "To alter or change something in a unique, unusual, or distorted way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "alteration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the dream, familiar faces were <w>quirked</w> by the strange logic of his subconscious mind.",
                            "target_lang_translations": {
                                "ru": "Во сне знакомые лица были <w>искажены</w> странной логикой его подсознания."
                            }
                        },
                        {
                            "text": "The artist <w>quirked</w> the perspective of the landscape to create a sense of unease.",
                            "target_lang_translations": {
                                "ru": "Художник <w>изменил</w> перспективу пейзажа, чтобы создать чувство беспокойства."
                            }
                        }
                    ],
                    "synonyms": [
                        "distort",
                        "twist",
                        "warp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять или искажать что-либо необычным или причудливым образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искажать",
                                "target_lang_sense_clarification": "менять форму или вид"
                            },
                            {
                                "target_lang_word": "коверкать",
                                "target_lang_sense_clarification": "необычно изменять"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e151b22d-2055-3d3a-8370-1c4c461b8261",
                    "sense_definition": "To use verbal tricks, quibbles, or evasive language.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "evasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician spent the entire interview <w>quirking</w> and dodging the reporter's difficult questions.",
                            "target_lang_translations": {
                                "ru": "Политик провел все интервью, <w>увиливая</w> и уклоняясь от сложных вопросов репортера."
                            }
                        },
                        {
                            "text": "Stop <w>quirking</w> with words and give me a straight answer for once.",
                            "target_lang_translations": {
                                "ru": "Хватит <w>мудрить</w> со словами, дай мне наконец прямой ответ."
                            }
                        }
                    ],
                    "synonyms": [
                        "quibble",
                        "equivocate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "referring to verbal quibbling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать словесные уловки, двусмысленности или уклончивые выражения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увиливать",
                                "target_lang_sense_clarification": "уклоняться от прямого ответа"
                            },
                            {
                                "target_lang_word": "мудрить",
                                "target_lang_sense_clarification": "использовать сложные уловки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "22f1c5c7-6c69-35b6-be23-dfb4f396a494",
                    "sense_definition": "An English surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Assemblymember Bill <w>Quirk</w> has introduced a new bill to address the issue of power outages.",
                            "target_lang_translations": {
                                "ru": "Член ассамблеи Билл <w>Квирк</w> представил новый законопроект для решения проблемы перебоев в подаче электроэнергии."
                            }
                        },
                        {
                            "text": "The <w>Quirk</w> family has lived in this neighborhood for over three generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Квирк</w> живет в этом районе уже более трех поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "common in English-speaking regions"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Квирк",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}