                        "examples": [
                            {
                                "example_id": "5e3fb529-0546-4cf1-8d64-da5d0d9edb8b",
                                "sense_id": "16a83c9d-b16d-34c9-ab92-69496f09dd5a",
                                "text": "Le bangue n’est autre chose que le chanvre, dont les feuilles fumées ont une faculté enivrante."
                            },
                            {
                                "example_id": "f36d3ab9-1238-458a-ad37-3b609ef4a2cf",
                                "sense_id": "16a83c9d-b16d-34c9-ab92-69496f09dd5a",
                                "text": "Certains d’entre eux, en raison de leur pouvoir stupéfiant ou de leur toxicité, comme l’opium, le chanvre et ses nombreuses variétés (kief, bangue, marijuana, tabac congo, bagha) n’offrent évidemment aucun intérêt pour le médecin désirant traiter par des succédanés la toxicomanie tabagique."
                            }
                        ]
