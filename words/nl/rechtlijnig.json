{
    "word_family": [
        "rechtlijnigheid",
        "lijn",
        "recht"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e4f54ad0-4927-3976-9793-1fd73ea46cca",
                    "sense_definition": "In een rechte lijn verlopend, zonder bochten of afwijkingen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meetkundig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De laserstraal volgt een <w>rechtlijnig</w> pad door de donkere kamer.",
                            "target_lang_translations": {
                                "es": "El rayo láser sigue una trayectoria <w>rectilínea</w> a través de la habitación oscura."
                            }
                        },
                        {
                            "text": "De architect ontwierp een gebouw met een strak en <w>rechtlijnig</w> ontwerp.",
                            "target_lang_translations": {
                                "es": "El arquitecto diseñó un edificio con un diseño sobrio y <w>rectilíneo</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rechtlijnig pad",
                        "rechtlijnige beweging"
                    ],
                    "target_lang_definitions": {
                        "es": "Que se desarrolla en línea recta, sin curvas ni desviaciones."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "rectilíneo",
                                "target_lang_sense_clarification": "en línea recta"
                            },
                            {
                                "target_lang_word": "recto",
                                "target_lang_sense_clarification": "sin curvas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e6e8d48-3f53-3138-be6e-bddf4013aae8",
                    "sense_definition": "Zonder bochten of uitzonderingen; vasthoudend aan vaste principes of regels.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trump en zijn team beseffen als geen ander dat <w>rechtlijnige</w>, coherente politieke communicatie bij de kiezer steeds minder tot de verbeelding spreekt.",
                            "target_lang_translations": {
                                "es": "Trump y su equipo se dan cuenta mejor que nadie de que una comunicación política <w>directa</w> y coherente atrae cada vez menos la imaginación del votante."
                            }
                        },
                        {
                            "text": "Zijn <w>rechtlijnige</w> manier van denken laat helaas weinig ruimte voor compromissen.",
                            "target_lang_translations": {
                                "es": "Su forma de pensar tan <w>lineal</w> lamentablemente deja poco espacio para los compromisos."
                            }
                        }
                    ],
                    "synonyms": [
                        "dogmatisch",
                        "rigide",
                        "star"
                    ],
                    "common_phrases": [
                        "rechtlijnige manier",
                        "rechtlijnig denken"
                    ],
                    "target_lang_definitions": {
                        "es": "Sin rodeos ni excepciones; que se adhiere firmemente a principios o reglas fijas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "recto",
                                "target_lang_sense_clarification": "íntegro y directo"
                            },
                            {
                                "target_lang_word": "coherente",
                                "target_lang_sense_clarification": "consecuente con sus principios"
                            },
                            {
                                "target_lang_word": "lineal",
                                "target_lang_sense_clarification": "sin desviaciones en el pensamiento"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2be46af8-5eae-3141-bdd4-235a09db171a",
                    "sense_definition": "Stijf, onbuigzaam en niet bereid om zich aan te passen aan nieuwe situaties.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directeur hanteert een <w>rechtlijnig</w> beleid waar absoluut niet van mag worden afgeweken.",
                            "target_lang_translations": {
                                "es": "El director aplica una política <w>rígida</w> de la que absolutamente no se puede desviar."
                            }
                        },
                        {
                            "text": "Door zijn <w>rechtlijnige</w> houding verloor hij snel de steun van zijn collega's.",
                            "target_lang_translations": {
                                "es": "Debido a su actitud <w>intransigente</w>, rápidamente perdió el apoyo de sus colegas."
                            }
                        }
                    ],
                    "synonyms": [
                        "rigide",
                        "star"
                    ],
                    "common_phrases": [
                        "rechtlijnig beleid",
                        "rechtlijnige houding"
                    ],
                    "target_lang_definitions": {
                        "es": "Rígido, inflexible y poco dispuesto a adaptarse a nuevas situaciones."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "rígido",
                                "target_lang_sense_clarification": "inflexible en el comportamiento o normas"
                            },
                            {
                                "target_lang_word": "intransigente",
                                "target_lang_sense_clarification": "que no cede"
                            },
                            {
                                "target_lang_word": "cuadriculado",
                                "target_lang_sense_clarification": "de mentalidad muy cerrada"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}