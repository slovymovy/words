                "senses": [
                    {
                        "sense_id": "b55b4741-c7dc-39c7-81e7-b0532a6abecb",
                        "entry_id": "7017d63d-45ce-30a6-85e0-741a3757ffa6",
                        "glosses": [
                            "A native or inhabitant of Metz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "012a65f7-5bf0-463a-8fd7-8b9fffd2b131",
                                "sense_id": "b55b4741-c7dc-39c7-81e7-b0532a6abecb",
                                "text": "But the Messines were undaunted and thirsted for revenge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7757b25-2eb1-455c-a8a0-a08e8956649d",
