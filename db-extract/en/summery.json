                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0437d29-6264-47f2-827d-b6feaee84b4a",
                                                "sense_id": "d7723ca9-e443-3f05-b0bc-b0728c317e8e",
                                                "text": "„Schon jetzt kann Nottrodt sagen, dass der September 2011 einer der sommerlichsten seit langem war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
