                "senses": [
                    {
                        "sense_id": "63afd959-9967-37dc-befb-a90d391a6cb8",
                        "entry_id": "19bf292e-053f-37c5-ac9a-11cf6dba6d12",
                        "glosses": [
                            "Bezugnahme auf ein und dasselbe Gemeinte durch verschiedene sprachliche Ausdrücke im gleichen Zusammenhang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cb652fb-ed0a-496f-a252-ac8ef567b85b",
                                "sense_id": "63afd959-9967-37dc-befb-a90d391a6cb8",
                                "text": "In der Satzfolge: \"Ich kenne Hans schon lange. Er ist ein begeisterter Schachspieler\" liegt eine Referenzidentität bei den Ausdrücken \"Hans\" und \"er\" vor; d.h. zwei verschiedene Ausdrücke beziehen sich in diesem Fall auf ein und dieselbe Person."
                            },
                            {
                                "example_id": "a4fbb707-b8d3-45e9-8d8d-f40b05e8d41c",
                                "sense_id": "63afd959-9967-37dc-befb-a90d391a6cb8",
                                "text": "Der Begriff Referenzidentität spielt in der Textlinguistik eine Rolle, wenn es darum geht, die Zusammenhänge (Kohärenzen) zwischen den Ausdrücken eines Textes herauszuarbeiten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
