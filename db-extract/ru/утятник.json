                "translations": [
                    {
                        "translation_id": "144851db-7087-4fde-8565-3e868ae12ee6",
                        "source_entry_id": "2b631a05-3dca-3d97-b5bc-31c99405a23f",
                        "source_sense_id": "ad49feae-7fcc-3db2-8c40-73b07305df1e",
                        "target_lang_word": "duck",
