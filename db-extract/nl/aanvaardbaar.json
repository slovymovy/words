                "senses": [
                    {
                        "sense_id": "83234abf-000e-3f6d-8a93-37e8299004d5",
                        "entry_id": "f9fcc0d8-78c7-321b-8608-140893c47195",
                        "glosses": [
                            "te aanvaarden, acceptabel, gepast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f6a0067-5175-4267-ac42-fc655c4ffcf4",
                                "sense_id": "83234abf-000e-3f6d-8a93-37e8299004d5",
                                "text": "Hij heeft ons een aanvaardbaar voorstel gedaan."
                            },
                            {
                                "example_id": "23df9cf7-f091-406b-9178-658fa95900bb",
                                "sense_id": "83234abf-000e-3f6d-8a93-37e8299004d5",
                                "text": "De kwaliteit van de maaltijd in dit restaurant was aanvaardbaar, maar dus niet echt goed."
                            },
                            {
                                "example_id": "801a26c8-690a-48b3-b18b-d373ce5927ef",
                                "sense_id": "83234abf-000e-3f6d-8a93-37e8299004d5",
                                "text": "Ze bracht haar gejaagde pas terug tot een aanvaardbaar tempo in een ziekenhuis en nam zichzelf voor om niet in de valkuilen van Dorien te tuimelen."
                            },
                            {
                                "example_id": "9c79ad08-7b3d-4c8d-8d53-3eeee288935f",
                                "sense_id": "83234abf-000e-3f6d-8a93-37e8299004d5",
                                "text": "Bovendien hadden zij ook deze keer zonder aanvaardbare reden de oorlog verklaard."
                            },
                            {
                                "example_id": "ceb8769d-f497-4fff-8ad3-9e488cb5e662",
                                "sense_id": "83234abf-000e-3f6d-8a93-37e8299004d5",
                                "text": "Binnen die opvatting lijkt het onvoorstelbaar dat seks soms lijnrecht staat tegenover alles wat we als fatsoenlijk, prettig en gezellig ervaren, dat seks het verlangen in ons kan opwekken om te geselen, te vernederen, te beledigen, afgeranseld te worden en dingen te zeggen en te doen die strijdig zijn met een aanvaardbaar zelfbeeld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "052abf67-0974-4510-8098-db558d9ed6a3",
                        "source_entry_id": "f9fcc0d8-78c7-321b-8608-140893c47195",
                        "source_sense_id": "83234abf-000e-3f6d-8a93-37e8299004d5",
                        "source_sense_description": "te aanvaarden",
                        "target_lang_word": "annehmbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "annehmbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f20b3ea6-5fa9-3c01-9c61-8a7a7c3dc5eb",
                                        "entry_id": "ad727a45-b1b6-3be7-b072-286e6ddf1c8d",
                                        "glosses": [
                                            "so, dass man es annehmen oder akzeptieren kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e55c23fa-86c3-4be2-a606-c30dba9de92c",
                                                "sense_id": "f20b3ea6-5fa9-3c01-9c61-8a7a7c3dc5eb",
                                                "text": "Noch im vorigen Jahre, kurz vor den Gasteiner Verhandlungen, habe ich den Königlich bayerischen Minister Freiherrn von der Pfordten gebeten, ob er nicht seine Vermittelung dahin eintreten lassen wolle, dass zur Verhütung eines Konfliktes, der ganz Deutschland ergreifen konnte, Unterhandlungen geführt wurden, durch welche der Prinz von Augustenburg bewogen werde, einen für Preußen annehmbaren Frieden mit Sr. Majestät zu machen, wobei ich erklärte, dass ich dem Prinzen zu diesem Behufe an dem Königlichen Hofe eine günstige Aufnahme vermitteln wurde, wenn der Prinz sich dorthin begeben wolle."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "092e6d4f-7137-46a6-b693-edd2607a4195",
