                {
                    "sense_id": "d8ef045e-9196-3f6f-9e4c-8fbdf28eb17e",
                    "sense_definition": "to insert a shoot from one plant into another so that they grow together",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer decided to <w>graft</w> a branch from a pear tree onto the hardy rootstock.",
                            "target_lang_translations": {
