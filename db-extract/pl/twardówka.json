                    {
                        "translation_id": "c40e82e4-6b96-451d-a972-be3d1a097b53",
                        "source_entry_id": "671b55c2-549c-3e2f-9180-e3b0b957ae46",
                        "source_sense_id": "0f7be096-7cad-3070-bd86-29f9571b2bb5",
                        "target_lang_word": "sclera",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sclera",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "390f4410-d999-3afb-969b-a0122dc4b55f",
                                        "entry_id": "31b7f8cc-6451-3c5c-9eb3-5c5b42ec9adc",
                                        "glosses": [
                                            "The white of the eye; the tough outer coat of the eye that covers the eyeball except for the cornea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baabfeb4-4e80-4978-af39-751fe3d67408",
                                                "sense_id": "390f4410-d999-3afb-969b-a0122dc4b55f",
                                                "text": "She'd been back a week and it was clear that college-level track was kicking her ass, the sclera in her normally wide manga-eyes were shot through with blood vessels."
                                            },
                                            {
                                                "example_id": "ac0f1607-d42d-4165-a9ea-7a4abbb5847e",
                                                "sense_id": "390f4410-d999-3afb-969b-a0122dc4b55f",
                                                "text": "Such pressures explain why humans are peculiar in having our rather small irises set against a white background—the sclera—in our eyes. Anyone watching us can infer where we are looking or whom we are looking at."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af830f3a-cbaf-4522-905c-70a50f317508",
                        "source_entry_id": "671b55c2-549c-3e2f-9180-e3b0b957ae46",
                        "source_sense_id": "0f7be096-7cad-3070-bd86-29f9571b2bb5",
