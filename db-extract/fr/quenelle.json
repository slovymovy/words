                    {
                        "translation_id": "82a08249-d933-4c87-a69a-55bb89dacc29",
                        "source_entry_id": "b18a8228-874a-34cb-87fc-b7ee815c03c0",
                        "source_sense_id": "138514de-24a7-3419-9aa2-61d91fe78f5e",
