                        "glosses": [
                            "Avec un air penaud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff6c0cc1-7930-4787-b8d1-c1c8a6ff1c57",
                                "sense_id": "671a399e-ea6b-331a-97d8-6a534da95edf",
                                "text": "Les quatre amis perdent contenance... De répresseurs ils devenaient coupables ; de juges ils devenaient accusés... Ils chuchotaient entre eux, baissaient l’oreille, et s’avouaient penaudement qu’un éclat de cet sorte ne pouvait que tourner à leur honte..."
                            },
                            {
                                "example_id": "e3c6c2a2-496b-4213-9e41-63254b2297d1",
                                "sense_id": "671a399e-ea6b-331a-97d8-6a534da95edf",
                                "text": "Lentement, tristement, penaudement, Jumet saisit son instrument et gagna le milieu de la cour."
                            },
                            {
                                "example_id": "1917fea9-94fb-4ff9-86c9-348036f2464d",
                                "sense_id": "671a399e-ea6b-331a-97d8-6a534da95edf",
                                "text": "Vous avez peut-être senti cela dans votre temps, et vous reveniez penaudement vers la ville où l’on vous décore de la suggestive apostrophe : Décadent ! (quelque chose entre bookmaker et toqué)."
                            }
                        ]
                    }
                ],
