        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "017a7f9c-2879-3fb7-83aa-9a5b3a1e1fb7",
                "word": "Draco",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "611eb140-e8a2-3c5f-8a5b-eb6252ca50b8",
                        "entry_id": "017a7f9c-2879-3fb7-83aa-9a5b3a1e1fb7",
                        "glosses": [
                            "A circumpolar constellation of the northern sky, said to resemble a dragon. It features a line of stars (including Thuban) that winds between Ursa Major and Ursa Minor."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5b66bd7a-f799-31d5-81a1-0782633d6431",
                        "entry_id": "017a7f9c-2879-3fb7-83aa-9a5b3a1e1fb7",
                        "glosses": [
                            "An Athenian lawgiver, known for the severity of his laws."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86ea07fc-bdbb-40d4-9dfa-efc22beb6b1a",
                                "sense_id": "5b66bd7a-f799-31d5-81a1-0782633d6431",
                                "text": "The statesman Draco, faced with public complacency in the face of a crisis in crime, devised a simple method of maintaining order: kill all offenders."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4b3d1ab-5c9b-3306-b239-45f0f85ebf00",
                        "entry_id": "017a7f9c-2879-3fb7-83aa-9a5b3a1e1fb7",
                        "glosses": [
                            "One of Actaeon's hounds."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8cebce40-395a-3f4c-a798-4b7d76bd948e",
                        "entry_id": "017a7f9c-2879-3fb7-83aa-9a5b3a1e1fb7",
                        "glosses": [
                            "A male given name from Ancient Greek or Latin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3aeb28f-640e-4cf5-9337-2ab026232be0",
                                "sense_id": "8cebce40-395a-3f4c-a798-4b7d76bd948e",
                                "text": "Last November’s Latin Grammy Awards ceremony seemed to be the culmination of a heartwarming comeback for the Puerto Rican singer-songwriter-guitarist-producer Robi Draco Rosa."
                            },
                            {
                                "example_id": "fe78252e-706c-42b4-959c-c759aed3ee63",
                                "sense_id": "8cebce40-395a-3f4c-a798-4b7d76bd948e",
                                "text": "Midway through a video interview with Tom Felton about his best-selling memoir, “Beyond the Wand,” the actor who played Draco Malfoy in the “Harry Potter” movies removes the blue-gray baseball cap he’d been wearing backward and begins to tousle his hair."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da66b8b6-828a-445e-803a-e6cbd75f43e4",
                        "source_entry_id": "017a7f9c-2879-3fb7-83aa-9a5b3a1e1fb7",
