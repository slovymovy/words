                            },
                            {
                                "target_word": "psychiatric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c368f41a-a53a-38ea-8e83-d48f5668feb0",
                                        "entry_id": "fb4194e6-c5ca-3f93-8922-e780c13758dc",
                                        "glosses": [
                                            "A person who has a psychiatric disorder."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9182112a-a3a2-4862-9a56-5cd24099692b",
                                                "sense_id": "c368f41a-a53a-38ea-8e83-d48f5668feb0",
                                                "text": "They are the tuberculars, the psychiatrics, and the older men suffering from chronic conditions. All of those men are totally disabled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
