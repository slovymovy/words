                    "frequency": "Middle",
                    "semantic_group_id": "charakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wie kann man nur so <w>hohl</w> sein und auf einen so offensichtlichen Betrug hereinfallen?"
