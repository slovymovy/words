                        "sense_id": "3d928c4c-13ea-3a07-9f71-e171d5bb72c0",
                        "entry_id": "1e053835-3e77-38d0-a0fb-6a7f675f94a2",
                        "glosses": [
                            "Responding to or acting to counteract something when it happens (rather than beforehand)."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "96075e69-6cdd-4141-ac4d-bb48194ecb3d",
                                "sense_id": "3d928c4c-13ea-3a07-9f71-e171d5bb72c0",
                                "text": "Mike Malone recalls how the shaving of his fiancée's head was more of an “emptive” strike, since her hair was already on its way out."
                            },
                            {
                                "example_id": "cedb096d-b2c5-4321-9fae-740382a4ee9f",
                                "sense_id": "3d928c4c-13ea-3a07-9f71-e171d5bb72c0",
                                "text": "Emptive priority: The service to non-priority customer is stopped as soon as a priority customer arrives."
                            },
                            {
                                "example_id": "9953c17f-b1b5-421f-ba18-d19fe19310be",
                                "sense_id": "3d928c4c-13ea-3a07-9f71-e171d5bb72c0",
                                "text": "This situation can be dealt with either in an emptive or pre-emptive fashion. In an emptive system the new entry waits for the other to be completed before beginning. In a pre-emptive system the queue can stop the current entry half way through its execution to start the new one."
                            }
                        ]
                    }
