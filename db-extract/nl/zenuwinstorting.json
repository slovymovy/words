                "senses": [
                    {
                        "sense_id": "c1aa1a25-62d1-3967-b945-6b0b779104fb",
                        "entry_id": "bca8a70a-4531-343d-88ff-a93f0f03c6f5",
                        "glosses": [
                            "een informele benaming voor een aantal acute psychische symptomen die optreden bij mensen die eerder geen klachten hadden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd242111-eb11-4549-bddc-5bdb276e4d2d",
                                "sense_id": "c1aa1a25-62d1-3967-b945-6b0b779104fb",
                                "text": "In Our little sister van de Japanse arthouse-lieveling Hirokazu Kore-eda besluiten haar drie volwassen zussen Suzu uit te nodigen om bij hen te komen wonen in het kuststadje Kamakura. Daar delen zij al sinds hun vaders vertrek en hun moeders zenuwinstorting een huishouden in het huis van hun overleden grootmoeder."
                            },
                            {
                                "example_id": "7b43ee32-1cf9-4e3f-80f8-b0a6c6df3f10",
                                "sense_id": "c1aa1a25-62d1-3967-b945-6b0b779104fb",
                                "text": "De breuk zou uiteindelijk wel twee jaar lang duren; de kindster was vastbesloten niet meer met haar moeder en stiefvader te praten. Het leidde bij moeder Maria tot een zenuwinstorting."
                            }
                        ]
                    }
                ],
