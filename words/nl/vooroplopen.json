{
    "word_family": [
        "voorloper",
        "vooropgelopen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a134c2f0-50c8-32ae-9893-b5ebaeba9eed",
                    "sense_definition": "Als voorste persoon of groep lopen of wandelen.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_voorop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de wandeling door het donkere bos wilde de gids graag <w>vooroplopen</w>.",
                            "target_lang_translations": {
                                "en": "During the walk through the dark forest, the guide wanted to <w>lead the way</w>."
                            }
                        },
                        {
                            "text": "Als we samen naar de stad wandelen, moet de hond altijd <w>vooroplopen</w>.",
                            "target_lang_translations": {
                                "en": "When we walk to the city together, the dog always has to <w>walk in front</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vooraanlopen",
                        "voorlopen"
                    ],
                    "antonyms": [
                        "achteraanlopen"
                    ],
                    "common_phrases": [
                        "in de rij vooroplopen"
                    ],
                    "target_lang_definitions": {
                        "en": "To walk or march at the front of a group."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lead the way",
                                "target_lang_sense_clarification": "physically walking in front"
                            },
                            {
                                "target_lang_word": "walk in front",
                                "target_lang_sense_clarification": "physically walking ahead of others"
                            },
                            {
                                "target_lang_word": "walk ahead",
                                "target_lang_sense_clarification": "physically walking in front"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ef4bbad-54c6-3b9c-93bc-c32a5d5970e5",
                    "sense_definition": "Op anderen vooruit zijn, bijvoorbeeld op het gebied van innovatie, technologie of ontwikkeling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk_voorop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat doen we door samen te werken met partijen die in hun vak <w>vooroplopen</w>.",
                            "target_lang_translations": {
                                "en": "We do that by collaborating with parties that <w>are at the forefront</w> of their field."
                            }
                        },
                        {
                            "text": "Ons bedrijf wil altijd <w>vooroplopen</w> met de nieuwste technologische ontwikkelingen.",
                            "target_lang_translations": {
                                "en": "Our company always wants to <w>lead the way</w> with the latest technological developments."
                            }
                        }
                    ],
                    "synonyms": [
                        "vooruitlopen",
                        "toonaangevend zijn",
                        "vooraanstaand zijn"
                    ],
                    "antonyms": [
                        "achterlopen",
                        "achterblijven"
                    ],
                    "common_phrases": [
                        "in de markt vooroplopen"
                    ],
                    "target_lang_definitions": {
                        "en": "To be ahead of others, especially in innovation, technology, or development."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be at the forefront",
                                "target_lang_sense_clarification": "leading in a field or industry"
                            },
                            {
                                "target_lang_word": "lead the way",
                                "target_lang_sense_clarification": "being ahead in development or innovation"
                            },
                            {
                                "target_lang_word": "be ahead",
                                "target_lang_sense_clarification": "being more advanced than others"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}