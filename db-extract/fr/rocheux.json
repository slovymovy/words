                "senses": [
                    {
                        "sense_id": "3c9ecbd7-0dcd-3d19-b82a-b206da277c26",
                        "entry_id": "33d1c53c-e267-3a4f-acaa-ce3e9944935e",
                        "glosses": [
                            "Qui est couvert de rochers ; qui est formé de rochers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d490cc9-5290-415c-965f-4e8fe784d00d",
                                "sense_id": "3c9ecbd7-0dcd-3d19-b82a-b206da277c26",
                                "text": "L’oued En-Nedja coule à nos pieds dans un ravin verdoyant et se perd dans un paysage rocheux au Sud-Ouest."
                            },
                            {
                                "example_id": "fa23b087-ea60-49a9-aa70-19cf81ba48c4",
                                "sense_id": "3c9ecbd7-0dcd-3d19-b82a-b206da277c26",
                                "text": "C’étaient de hautes falaises rocheuses, des cascades et de larges fleuves bouillonnants et désolés, des bouquets d’arbres et des fourrés de plus en plus rabougris."
                            },
                            {
                                "example_id": "343ce220-4e3a-4cf8-bab1-d340cc8b534a",
                                "sense_id": "3c9ecbd7-0dcd-3d19-b82a-b206da277c26",
                                "text": "Les espèces plus haut citées se retrouvent encore sur des aires réduites qui, sans être rocheuses, présentent une très faible couverture de terre végétale formant autant de petites unités topographiquement et floristiquement bien définies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "638f6f09-b55c-4945-b690-0a7cdd99cc0e",
                        "source_entry_id": "33d1c53c-e267-3a4f-acaa-ce3e9944935e",
                        "source_sense_id": "3c9ecbd7-0dcd-3d19-b82a-b206da277c26",
                        "target_lang_word": "steinig",
