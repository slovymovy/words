{
    "word_family": [
        "daggering"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "adf5e110-1576-3f31-8eca-bfa51fd6cb0c",
                    "sense_definition": "A stabbing weapon, similar to a sword but with a short, double-edged blade.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The assassin concealed a sharp <w>dagger</w> beneath his heavy winter cloak.",
                            "target_lang_translations": {
                                "de": "Der Attentäter verbarg einen scharfen <w>Dolch</w> unter seinem schweren Wintermantel."
                            }
                        },
                        {
                            "text": "He drew a silver-hilted <w>dagger</w> to defend himself in the dark alley.",
                            "target_lang_translations": {
                                "de": "Er zog einen <w>Dolch</w> mit silbernem Griff, um sich in der dunklen Gasse zu verteidigen."
                            }
                        }
                    ],
                    "synonyms": [
                        "dirk",
                        "knife"
                    ],
                    "common_phrases": [
                        "silver-hilted dagger",
                        "concealed dagger"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Stichwaffe, ähnlich einem Schwert, aber mit einer kurzen, zweischneidigen Klinge."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Dolch",
                                "target_lang_sense_clarification": "zweischneidige Stichwaffe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fd59921-5ef8-3a27-a3ca-8c1e7cbfd1fd",
                    "sense_definition": "A point scored near the end of a game to secure a victory for the scorer's team.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His last-minute three-point <w>dagger</w> sealed the victory and silenced the home crowd.",
                            "target_lang_translations": {
                                "de": "Sein Drei-Punkte-<w>Todesstoß</w> in letzter Minute besiegelte den Sieg und brachte das Heimpublikum zum Schweigen."
                            }
                        },
                        {
                            "text": "The late goal was a complete <w>dagger</w> to the opposing team's hopes of qualifying.",
                            "target_lang_translations": {
                                "de": "Das späte Tor war der absolute <w>Sargnagel</w> für die Qualifikationshoffnungen der gegnerischen Mannschaft."
                            }
                        }
                    ],
                    "common_phrases": [
                        "three-point dagger"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used primarily in sports contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Treffer kurz vor Spielende, der den Sieg für die Mannschaft des Torschützen sichert."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Todesstoß",
                                "target_lang_sense_clarification": "entscheidender Treffer kurz vor Schluss"
                            },
                            {
                                "target_lang_word": "Sargnagel",
                                "target_lang_sense_clarification": "metaphorisch für den entscheidenden Punkt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27d8dfaa-9cf2-3191-9522-83b51bd095d0",
                    "sense_definition": "The typographical mark †.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "typography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor placed a small <w>dagger</w> next to the footnote to indicate a secondary reference.",
                            "target_lang_translations": {
                                "de": "Der Redakteur setzte ein kleines <w>Kreuz</w> neben die Fußnote, um auf einen Sekundärverweis hinzuweisen."
                            }
                        },
                        {
                            "text": "In older texts, the <w>dagger</w> symbol was frequently used to mark the date of death.",
                            "target_lang_translations": {
                                "de": "In älteren Texten wurde das <w>Dolchzeichen</w> häufig verwendet, um das Todesdatum zu markieren."
                            }
                        }
                    ],
                    "synonyms": [
                        "obelisk",
                        "obelus"
                    ],
                    "common_phrases": [
                        "dagger sign"
                    ],
                    "target_lang_definitions": {
                        "de": "Das typografische Zeichen †."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kreuz",
                                "target_lang_sense_clarification": "typografisches Zeichen †"
                            },
                            {
                                "target_lang_word": "Dolchzeichen",
                                "target_lang_sense_clarification": "typografisches Symbol †"
                            },
                            {
                                "target_lang_word": "Obelisk",
                                "target_lang_sense_clarification": "seltene Bezeichnung für das Kreuzzeichen †"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd63d467-bc3c-3c45-9254-c50052c347fb",
                    "sense_definition": "A timber placed diagonally in a ship's frame.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shipbuilding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shipwright secured the diagonal <w>dagger</w> to stabilize the wooden frame.",
                            "target_lang_translations": {
                                "de": "Der Schiffszimmermann sicherte das diagonale <w>Scherholz</w>, um den Holzrahmen zu stabilisieren."
                            }
                        },
                        {
                            "text": "Each heavy <w>dagger</w> was carefully fitted to keep the poppets together during construction.",
                            "target_lang_translations": {
                                "de": "Jede schwere <w>Diagonalstrebe</w> wurde sorgfältig eingepasst, um die Schlittenbalken während des Baus zusammenzuhalten."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Technical shipbuilding terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein diagonal im Rahmen eines Schiffes platziertes Holz."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Scherholz",
                                "target_lang_sense_clarification": "diagonales Holz im Schiffbau"
                            },
                            {
                                "target_lang_word": "Diagonalstrebe",
                                "target_lang_sense_clarification": "Stützstrebe im Schiffbau"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "676065ab-2617-35a2-ab61-842578ceb733",
                    "sense_definition": "A player, supporter or other person connected with Dagenham & Redbridge Football Club.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "football_club_nickname",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a lifelong <w>Dagger</w>, he never missed a home match at Victoria Road.",
                            "target_lang_translations": {
                                "de": "Als lebenslanger <w>Dagger</w> verpasste er kein Heimspiel an der Victoria Road."
                            }
                        },
                        {
                            "text": "The loyal <w>Daggers</w> traveled across the country to support their team in the cup final.",
                            "target_lang_translations": {
                                "de": "Die treuen <w>Daggers</w> reisten durch das ganze Land, um ihr Team im Pokalfinale zu unterstützen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Football slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Spieler, Unterstützer oder eine andere Person, die mit dem Dagenham & Redbridge Football Club in Verbindung steht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Dagger",
                                "target_lang_sense_clarification": "Spitzname für Spieler/Fans von Dagenham & Redbridge"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a0d884f-b98f-349b-89ba-0c4ade1fb9de",
                    "sense_definition": "To pierce with a dagger; to stab.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain attempted to <w>dagger</w> the hero from behind, but his plot was foiled.",
                            "target_lang_translations": {
                                "de": "Der Bösewicht versuchte, den Helden von hinten zu <w>erdolchen</w>, doch sein Plan wurde vereitelt."
                            }
                        },
                        {
                            "text": "In the dramatic final scene, the character is brutally <w>daggered</w> on stage.",
                            "target_lang_translations": {
                                "de": "In der dramatischen Schlussszene wird die Figur auf der Bühne brutal <w>niedergestochen</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Mit einem Dolch erstechen oder verletzen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "erdolchen",
                                "target_lang_sense_clarification": "mit einem Dolch erstechen"
                            },
                            {
                                "target_lang_word": "niederstechen",
                                "target_lang_sense_clarification": "mit einer Klinge verletzen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfff65c6-fbb4-3b17-b05c-a4f47c39c642",
                    "sense_definition": "To perform the daggering dance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd cheered as the dancers began to <w>dagger</w> to the intense dancehall beat.",
                            "target_lang_translations": {
                                "de": "Die Menge jubelte, als die Tänzer begannen, zum intensiven Dancehall-Beat zu <w>daggern</w>."
                            }
                        },
                        {
                            "text": "Some venues have banned patrons who attempt to <w>dagger</w> on the dance floor.",
                            "target_lang_translations": {
                                "de": "Einige Veranstaltungsorte haben Gästen Hausverbot erteilt, die versuchen, auf der Tanzfläche zu <w>daggern</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Associated with Jamaican dancehall culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Den Daggering-Tanz ausführen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "daggering tanzen",
                                "target_lang_sense_clarification": "den jamaikanischen Tanzstil ausführen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}