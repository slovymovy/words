                                "target_senses": [
                                    {
                                        "sense_id": "ef0fede7-d153-3694-a5e8-16b59ed51346",
                                        "entry_id": "71946c6e-0dee-352d-9fec-9d0a57fe1901",
                                        "glosses": [
                                            "The buying and selling of goods and services on a market."
                                        ],
                                        "tags": [
