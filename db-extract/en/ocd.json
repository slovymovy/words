                        "entry_id": "1e4a886b-144a-39c0-919f-7762cd3a135c",
                        "glosses": [
                            "Exhibiting an obsessive tendency."
                        ],
                        "tags": [
                            "figuratively",
                            "offensive",
                            "sometimes"
                        ],
                        "examples": [
                            {
                                "example_id": "2dd9c131-b1ee-4d5c-b9d5-bdec0e81d1d5",
                                "sense_id": "4f07a535-8f44-34e1-aff0-7d5a2663daea",
                                "text": "Three years and you still have your ex's things? Lizzy, I knew you were uptight and OCD, and often humorless."
                            },
                            {
                                "example_id": "4c34c93f-d8b2-4297-a7db-56482ced761b",
                                "sense_id": "4f07a535-8f44-34e1-aff0-7d5a2663daea",
                                "text": "So I wanted to get us some simple takeout but of course, I started obsessing over what you'd be in the mood for. Hence, we have the OCD buffet of sushi, steak, and pasta."
                            }
                        ]
                    }
