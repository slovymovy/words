                ],
                "senses": [
                    {
                        "sense_id": "1e0b8f75-439d-3e6e-bea9-e282a28126b7",
                        "entry_id": "9e1d787c-52f1-3e39-aa2f-74862d898dd9",
                        "glosses": [
                            "лицо, выбранное кем-либо, предпочтенное другим, кому отдается преимущество среди других, кто удостаивается большего внимания, чем другие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73761d27-04a7-49b0-badb-b9a536b07116",
                                "sense_id": "1e0b8f75-439d-3e6e-bea9-e282a28126b7",
                                "text": "Борис был не наследственный вотчинник Московского государства, а народный избранник, начинал особый ряд царей с новым государственным значением."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfcb8302-ec0b-321f-9b96-921d60f05efb",
                        "entry_id": "9e1d787c-52f1-3e39-aa2f-74862d898dd9",
                        "glosses": [
                            "тот, на кого пал выбор быть супругом, возлюбленным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d39ddc5-04b2-4fc6-8ad1-07f17a9ebb10",
                                "sense_id": "dfcb8302-ec0b-321f-9b96-921d60f05efb",
                                "text": "И вот уехала она // С избранником своим."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a97c0dd-2235-36b8-9717-25a13ee8c084",
                        "entry_id": "9e1d787c-52f1-3e39-aa2f-74862d898dd9",
                        "glosses": [
                            "поэт. любимец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ee76952-fd75-4871-8dd0-06845a60fa47",
                                "sense_id": "7a97c0dd-2235-36b8-9717-25a13ee8c084",
                                "text": "Избранник судьбы."
                            }
                        ]
                    },
                    {
                        "sense_id": "318bb19d-33c3-3f97-a86c-56b99ffb04b2",
                        "entry_id": "9e1d787c-52f1-3e39-aa2f-74862d898dd9",
                        "glosses": [
                            "высок. человек, от природы наделённый чем-то недостижимым для других, выделяющийся среди других своим талантом, умом и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0b79363-9924-43b1-9987-01d1ed0e3a08",
                                "sense_id": "318bb19d-33c3-3f97-a86c-56b99ffb04b2",
                                "text": "Нет, я не Байрон, я другой, // Еще неведомый избранник."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5646c0b2-1189-4f6d-9179-8acd6eda6edd",
                        "source_entry_id": "9e1d787c-52f1-3e39-aa2f-74862d898dd9",
                        "target_lang_word": "Auserwählte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auserwählte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ac514bf-2c8b-3d91-8ce8-a03b91b6a9c0",
                                        "entry_id": "32381f66-fed2-3349-a241-68f45200934f",
                                        "glosses": [
                                            "eine Frau, die auserkoren, auserwählt wurde, etwas Bestimmtes zu vollbringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef78490c-84ed-4e5d-b414-f88ec98776ab",
                                                "sense_id": "1ac514bf-2c8b-3d91-8ce8-a03b91b6a9c0",
                                                "text": "Du bist nicht irgendein Mensch. Du bist die Auserwählte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3446d276-5f36-3ab4-b7e7-add5a22457cd",
                                        "entry_id": "32381f66-fed2-3349-a241-68f45200934f",
                                        "glosses": [
                                            "eine Frau, die von einem Mann als feste Freundin beziehungsweise Ehefrau auserwählt wurde"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62f0d8f3-fada-4c64-8f8c-9b2614a926c1",
                                                "sense_id": "3446d276-5f36-3ab4-b7e7-add5a22457cd",
                                                "text": "Du hast jetzt also eine Freundin? Und, wer ist die Auserwählte?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
