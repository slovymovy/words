        "ru-extract.jsonl": [
            {
                "entry_id": "4330a2be-5063-347e-8e86-2c972c79908f",
                "word": "współwyznawca",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8f97fec4-2a46-3948-aa4a-63ccc66fbc92",
                        "entry_id": "4330a2be-5063-347e-8e86-2c972c79908f",
                        "glosses": [
                            "единоверец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38605938-66db-43b6-a723-730ecee24b2d",
                                "sense_id": "8f97fec4-2a46-3948-aa4a-63ccc66fbc92",
                                "text": "Współwyznawcy odczepiali się od niego byłejakim datkiem, dziesiątką, dwudziestoma groszami…",
                                "translation": "Единоверцы отделывались от него жалкими подачками, пятью, десятью копейками…"
                            }
                        ]
                    },
                    {
                        "sense_id": "9f914c38-475f-3d23-b447-7f286ae53be4",
                        "entry_id": "4330a2be-5063-347e-8e86-2c972c79908f",
                        "glosses": [
                            "единомышленник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9885189b-b5c2-4e96-bd7c-0f277aa68d1f",
                                "sense_id": "9f914c38-475f-3d23-b447-7f286ae53be4",
                                "text": "Kolosalny zakres wiedzy, odsłaniający się na kartach «Historji cywilizacji Anglji», miał przedewszystkiem ten skutek, że znaglił Borowicza i jego współwyznawców do pracy, do rzetelnego cenienia czasu na wagę złota.",
                                "translation": "Колоссальный объем знаний, открывавшийся на страницах «Истории цивилизации в Англии», прежде всего побудил Боровича и его единомышленников к труду, к тому, что они стали на вес золота ценить время."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
