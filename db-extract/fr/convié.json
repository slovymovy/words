                        "sense_id": "e0872874-67b5-340f-9b1a-d8edcc526120",
                        "entry_id": "c3aaa67a-bf7e-346a-b055-17b9e30d4929",
                        "glosses": [
                            "Très souvent employé comme nom avec le sens d’invité à un repas de cérémonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb9233f3-96be-4fad-9326-f9fd6deb4e21",
                                "sense_id": "e0872874-67b5-340f-9b1a-d8edcc526120",
                                "text": "Il a bien reçu, bien traité les conviés."
                            },
                            {
                                "example_id": "73026f0c-5b61-49e9-8372-5f0683132428",
                                "sense_id": "e0872874-67b5-340f-9b1a-d8edcc526120",
                                "text": "Il n’était pas des conviés, du nombre des conviés."
                            },
                            {
                                "example_id": "2cd5f25c-0c78-4aa1-920b-f1822c56a9af",
                                "sense_id": "e0872874-67b5-340f-9b1a-d8edcc526120",
                                "text": "Les conviés arrivèrent de bonne heure dans des voitures, carrioles à un cheval, chars à bancs à deux roues, vieux cabriolets sans capote."
                            }
                        ]
                    }
                ],
