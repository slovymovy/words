                        "examples": [
                            {
                                "example_id": "7a3a65a7-2c25-4369-a3bf-ba5a39084c95",
                                "sense_id": "d2d92864-574a-3aa9-8140-2283a0a27204",
                                "text": "This is how the luckless feel / how the calloos [translating allit] think— / like hard snow under a ridge / like water in a deep well."
                            },
                            {
                                "example_id": "5b435826-03f8-4a0a-bcd8-2b983117da22",
                                "sense_id": "d2d92864-574a-3aa9-8140-2283a0a27204",
                                "text": "The Scots called it the ‘wild calloo’ from the unearthly call it had which seemed almost to bewitch fisher-folk hunting for herring in calm autumn nights off the Scottish Isles."
                            }
                        ]
                    }
