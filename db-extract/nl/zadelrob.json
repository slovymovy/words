                        "entry_id": "9f71e36b-7860-35f4-a190-7c128d50a17a",
                        "glosses": [
                            "bepaald soort zoogdier, Pagophilus groenlandicus, een voornamelijk in de Noordelijke IJszee, rond de Noordpool levende zeehond"
                        ],
