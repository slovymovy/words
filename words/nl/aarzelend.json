{
    "word_family": [
        "aarzelen",
        "aarzeling"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "73fb6b0e-a63e-372b-9f79-74bbb5f951fd",
                    "sense_definition": "met twijfel en onzekerheid, niet meteen durven handelen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij bleef even <w>aarzelend</w> bij de auto staan voordat hij instapte.",
                            "target_lang_translations": {
                                "en": "He stood by the car <w>hesitantly</w> for a moment before getting in."
                            }
                        },
                        {
                            "text": "Na een <w>aarzelend</w> begin van de wedstrijd nam het team de leiding.",
                            "target_lang_translations": {
                                "en": "After a <w>tentative</w> start to the match, the team took the lead."
                            }
                        }
                    ],
                    "synonyms": [
                        "weifelachtig",
                        "onzeker",
                        "terughoudend",
                        "schoorvoetend",
                        "besluiteloos"
                    ],
                    "antonyms": [
                        "gretig",
                        "krachtdadig"
                    ],
                    "common_phrases": [
                        "een aarzelend begin",
                        "aarzelend antwoorden"
                    ],
                    "target_lang_definitions": {
                        "en": "with doubt and uncertainty, not daring to act immediately"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hesitant",
                                "target_lang_sense_clarification": "showing doubt or reluctance"
                            },
                            {
                                "target_lang_word": "tentative",
                                "target_lang_sense_clarification": "done without confidence; hesitant"
                            },
                            {
                                "target_lang_word": "indecisive",
                                "target_lang_sense_clarification": "not able to make decisions quickly"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7e28a5b0-8958-354b-a2d4-7ccbaef0772d",
                    "sense_definition": "onvoltooid deelwoord van <w>aarzelen</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
