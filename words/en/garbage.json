    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f3bbf285-e5d6-3b27-8ede-5ebfbb335c29",
                    "sense_definition": "Waste material of any kind, such as food waste or discarded objects.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "waste_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please take out the <w>garbage</w> before you go to sleep.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, вынеси <w>мусор</w> перед сном.",
                                "tr": "Lütfen uyumadan önce <w>çöpü</w> dışarı çıkar.",
                                "zh": "睡觉前请把<w>垃圾</w>倒掉。"
                            }
                        },
                        {
                            "text": "The <w>garbage</w> truck comes to our street every Tuesday morning.",
                            "target_lang_translations": {
                                "ru": "<w>Мусоровоз</w> приезжает на нашу улицу каждый вторник утром.",
                                "tr": "<w>Çöp</w> kamyonu her salı sabahı sokağımıza geliyor.",
                                "zh": "<w>垃圾</w>车每周二早上都会来我们这条街。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trash",
                        "rubbish",
                        "waste",
                        "refuse",
                        "junk"
                    ],
                    "antonyms": [
                        "treasure",
                        "asset",
                        "resource"
                    ],
                    "common_phrases": [
                        "garbage truck",
                        "garbage can",
                        "take out the garbage",
                        "garbage bag",
                        "household garbage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отходы любого вида, такие как пищевые отходы или выброшенные предметы.",
                        "tr": "Yiyecek atıkları veya atılmış eşyalar gibi her türlü atık madde.",
                        "zh": "各种废弃物，如厨余垃圾或丢弃的物品。"
                    },
                    "translations": {
