                "senses": [
                    {
                        "sense_id": "790669f7-a1b2-3a1f-b7c9-ed7f5e1b1761",
                        "entry_id": "c1ad4908-3e0f-32d8-a72e-9533f1306b22",
                        "glosses": [
                            "город во Франции, юго западный пригород Парижа, на реке Сена"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "720f402f-311e-4981-974c-f0aecee8bb83",
                                "sense_id": "790669f7-a1b2-3a1f-b7c9-ed7f5e1b1761",
                                "text": "Ещё десять лет назад эталоном метра был платино-иридиевый стержень, хранящийся в Севре близ Парижа."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ad0aee2-f18c-4027-94c9-ade58f25fe77",
                        "source_entry_id": "c1ad4908-3e0f-32d8-a72e-9533f1306b22",
                        "source_sense_id": "790669f7-a1b2-3a1f-b7c9-ed7f5e1b1761",
                        "target_lang_word": "Sèvres",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sèvres",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6a42cfa-7d5e-356f-a0f4-59d12a291b9e",
                                        "entry_id": "479cb4b7-4cf6-3f29-a176-fb154c08df78",
                                        "glosses": [
                                            "A town in France on the outskirts of Paris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf93d9a3-9bab-45a4-b9e0-75b6a90a67cd",
                                                "sense_id": "a6a42cfa-7d5e-356f-a0f4-59d12a291b9e",
                                                "text": "[…]but at Sèvres and other places for shaping of courtly clay, the charmingest things were done,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d4c1c62-c26a-3e80-be3b-5589fb7ca0f9",
                                        "entry_id": "479cb4b7-4cf6-3f29-a176-fb154c08df78",
                                        "glosses": [
                                            "A type of expensive porcelain traditionally made there."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2888e5f6-2b5d-4533-82eb-8b6c3248b941",
                                                "sense_id": "7d4c1c62-c26a-3e80-be3b-5589fb7ca0f9",
                                                "text": "[…]let them tell me candidly which is nearest truth, the gold of Turner, or the mourning and murky olive browns and verdigris greens in which Claude, with the industry and intelligence of a Sevres china painter, drags the laborious bramble leaves over his childish foreground."
                                            },
                                            {
                                                "example_id": "7994f59c-b574-4a2d-8803-b1867d554f2a",
                                                "sense_id": "7d4c1c62-c26a-3e80-be3b-5589fb7ca0f9",
                                                "text": "Finally his bell sounded, and Victor came in softly with a cup of tea, and a pile of letters, on a small tray of old Sèvres china, and drew back the olive-satin curtains, with their shimmering blue lining, that hung in front of the three tall windows."
                                            },
                                            {
                                                "example_id": "b79f5677-f233-49ca-9db0-f87059edf9df",
                                                "sense_id": "7d4c1c62-c26a-3e80-be3b-5589fb7ca0f9",
                                                "text": "There was a bartop radio in the corner and a Sèvres china tea set on a copper tray beside a samovar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
