                ],
                "senses": [
                    {
                        "sense_id": "2becd0e5-7749-3906-bc2e-f03741fcfd0a",
                        "entry_id": "107277de-d45b-32ce-a0b6-38839cdbe2b9",
                        "glosses": [
                            "Faire perdre son caractère diploïde à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e0c7505-c11a-4803-bd3d-ef57b1e166d7",
                                "sense_id": "2becd0e5-7749-3906-bc2e-f03741fcfd0a",
                                "text": "On sait que les conidies uninucléées sont susceptibles de dédiploïdiser le mycélium ; elles nous offraient donc un moyen détourné pour obtenir des mycéliums primaires."
                            },
                            {
                                "example_id": "9df39204-19a3-45d4-838b-509770216736",
                                "sense_id": "2becd0e5-7749-3906-bc2e-f03741fcfd0a",
                                "text": "La vie anaérobie a-t-elle provoqué un vieillissement accéléré de la culture dédiploïdisée ?"
                            },
                            {
                                "example_id": "0a6e1724-777f-40bc-85b8-f73cada9052a",
                                "sense_id": "2becd0e5-7749-3906-bc2e-f03741fcfd0a",
                                "text": "Les hyphes ainsi dédiploïdisées diffèrent cependant d’hyphes primaires par le fait que leurs articles ne sont généralement pas cénocytiques et, comme l’a montré Quintanilia, par la présence de boucles au niveau des cloisons, boucles il est vrai imparfaites, c’est-à-dire dont le sommet ne vient jamais s’ouvrir dans l’article sous-jacent, mais néanmoins très marquées (Fig 5)."
                            }
                        ]
                    }
                ],
