                "senses": [
                    {
                        "sense_id": "e0986184-ff2b-3cf1-b122-1c679fc1b81f",
                        "entry_id": "af871e4d-fe8f-38e0-8a12-6ebd23119569",
                        "glosses": [
                            "Abweichung von Gerechtigkeit und Rechtschaffenheit"
                        ],
                        "tags": [],
