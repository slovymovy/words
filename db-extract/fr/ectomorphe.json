                                            {
                                                "example_id": "fba35cae-c559-4d4c-b92f-0a9484ebcb21",
                                                "sense_id": "fb028fca-3e8b-3c54-abda-cfd4d88e3a4e",
                                                "text": "Also there was a woman I hadn't met, a chain-smoking French ectomorph whose job it was to make sense of records of public spending in the Ministry of Finance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51ee346f-05a4-357b-9425-b172fb8133f0",
                                        "entry_id": "146ef3a5-1bab-3582-95b7-17936d7cc94a",
                                        "glosses": [
                                            "Theoretical body type in which a person has a high metabolism. Such a person can easily maintain a low fat physique, but does not add muscle or body weight easily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce48cdf2-e011-493e-b657-904b97933aa7",
                                                "sense_id": "51ee346f-05a4-357b-9425-b172fb8133f0",
                                                "text": "The ectomorph body type is characterized by narrow shoulders and hips and a lean build. Its naturally fast metabolism makes it easy for ectomorphs to lose or maintain body fat levels but more difficult to build muscle."
                                            }
                                        ]
                                    }
                                ]
