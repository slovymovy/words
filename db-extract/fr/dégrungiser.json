                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67ad1b78-bed0-49e1-8e28-b8372b7f416b",
                                "sense_id": "f135934a-55ed-38de-bf27-4eac85d2f92e",
                                "text": "La chanson illustre bien le souhait de Vedder et sa bande de se « dégrungiser » laissant clairement entrevoir son influence stoogienne et l’évacuation des gimmicks vocaux qui ont fait beaucoup, en leur temps, la marque Pearl jam."
                            },
                            {
                                "example_id": "8b7daa11-2937-47d4-8142-020f20187a01",
                                "sense_id": "f135934a-55ed-38de-bf27-4eac85d2f92e",
                                "text": "Maintenant que je suis dégrungisée disons, je vais pouvoir mettre un peu d'ordre, quitte à dépoussiérrer certains souvenirs."
                            }
                        ]
                    }
