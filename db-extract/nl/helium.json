                                        "glosses": [
                                            "elemento chimico gassoso, facente parte del gruppo dei gas nobili, avente numero atomico 2, peso atomico 4,0026 e simbolo chimico He. È un gas incolore e inodore"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4187c50d-1445-4663-a8f7-a14e55c41ed8",
                                                "sense_id": "06534288-ecde-3284-8fbf-579d678df319",
                                                "text": "l'atomo di elio ha due protoni nel nucleo e due elettroni al di fuori di esso"
