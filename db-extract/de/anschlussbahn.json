                "senses": [
                    {
                        "sense_id": "e88ebf29-28f7-3cf1-a3c1-43018b8e14ea",
                        "entry_id": "67fd6314-967c-348c-9f69-a2b064f20ed6",
                        "glosses": [
                            "mit dem öffentlichen Schienennetz verbundene, nicht öffentliche Eisenbahn, die ein Unternehmen für eigene Zwecke (meist nur für den Gütertransport) betreibt"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "611e81c0-8198-47f2-9cc1-d5eb195e3420",
                                "sense_id": "e88ebf29-28f7-3cf1-a3c1-43018b8e14ea",
                                "text": "„Ein Bahn-Unfall bei Verschubarbeiten hat Montag früh in Marchtrenk im Bezirk Wels-Land drei Schwerverletzte gefordert. Sie wurden beim Entgleisen von zwei Güterwaggons auf einer Anschlussbahn zu einem Gewerbegebiet eingeklemmt beziehungsweise kamen sie unter dem Zug zu liegen.“"
                            },
                            {
                                "example_id": "dd2dbee2-5bf6-425a-a98c-eeeaa063df31",
                                "sense_id": "e88ebf29-28f7-3cf1-a3c1-43018b8e14ea",
                                "text": "„In der malerischen Region Traisen-Gölsental befindet sich eine der längsten Anschlussbahnen Österreichs.“"
                            },
                            {
                                "example_id": "8308d26b-fc1a-4d83-92be-d9173ae339c6",
                                "sense_id": "e88ebf29-28f7-3cf1-a3c1-43018b8e14ea",
                                "text": "„Nach jahrelangem Kampf behält Firma Urbas die Anschlussbahn zu ihrem Betriebsgelände in Ruden.“"
                            },
                            {
                                "example_id": "c854f75f-ce91-4222-b7e9-51f49981f8ff",
                                "sense_id": "e88ebf29-28f7-3cf1-a3c1-43018b8e14ea",
                                "text": "„Durch eine Anschlussbahn erschließt sich einem Unternehmen der direkte Zugang an das öffentliche Schienennetz und damit eine effiziente Schienengüterverkehrsabwicklung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
