                                        "entry_id": "ffd2931b-8952-3842-92e6-eb608bcab255",
                                        "glosses": [
                                            "Clothing."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
