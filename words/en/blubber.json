{
    "word_family": [
        "blub",
        "blubberer",
        "blubbery"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12d045fa-a5cf-31aa-9ba8-a8d5d9266c6d",
                    "sense_definition": "A thick layer of fat beneath the skin of whales, seals, and other marine mammals, providing insulation and energy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fat_tissue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick layer of <w>blubber</w> protects arctic seals from freezing temperatures.",
                            "target_lang_translations": {
                                "es": "La gruesa capa de <w>grasa</w> protege a las focas árticas de las gélidas temperaturas."
                            }
                        },
                        {
                            "text": "Whalers traditionally hunted large sea creatures to extract oil from their <w>blubber</w>.",
                            "target_lang_translations": {
                                "es": "Los balleneros tradicionalmente cazaban grandes criaturas marinas para extraer aceite de su <w>grasa</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "whale blubber",
                        "layer of blubber"
                    ],
                    "target_lang_definitions": {
                        "es": "Capa gruesa de grasa subcutánea en ballenas, focas y otros mamíferos marinos, que les proporciona aislamiento térmico y energía."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "grasa de ballena",
                                "target_lang_sense_clarification": "grasa subcutánea de mamíferos marinos"
                            },
                            {
                                "target_lang_word": "grasa",
                                "target_lang_sense_clarification": "tejido adiposo de animales marinos"
                            },
                            {
                                "target_lang_word": "tocino de ballena",
                                "target_lang_sense_clarification": "capa grasa de cetáceos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a9a716e-faed-3ebd-aaa0-597af3d1ac98",
                    "sense_definition": "Excessive human body fat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fat_tissue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent months working out at the gym to burn off all the extra <w>blubber</w>.",
                            "target_lang_translations": {
                                "es": "Pasó meses entrenando en el gimnasio para quemar todos los <w>michelines</w> sobrantes."
                            }
                        },
                        {
                            "text": "She joked about carrying too much <w>blubber</w> around her waist after the holidays.",
                            "target_lang_translations": {
                                "es": "Bromeó sobre tener demasiada <w>grasa</w> alrededor de la cintura después de las fiestas."
                            }
                        }
                    ],
                    "common_phrases": [
                        "excess blubber"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal and often mildly derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Exceso de grasa corporal en las personas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "michelín",
                                "target_lang_sense_clarification": "pliegue de grasa corporal, coloquial"
                            },
                            {
                                "target_lang_word": "lonja",
                                "target_lang_sense_clarification": "rollo de grasa corporal"
                            },
                            {
                                "target_lang_word": "grasa",
                                "target_lang_sense_clarification": "exceso de tejido graso"
                            },
                            {
                                "target_lang_word": "gordura",
                                "target_lang_sense_clarification": "grasa excesiva en el cuerpo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bc9b01c-7187-3485-aa43-806c60472c7d",
                    "sense_definition": "A person who weeps or cries noisily and excessively.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weeping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am an emotional <w>blubber</w> who starts weeping whenever a sad movie begins.",
                            "target_lang_translations": {
                                "es": "Soy un <w>llorón</w> sentimental que se pone a llorar en cuanto empieza una película triste."
                            }
                        },
                        {
                            "text": "His friends teased him gently for being such a <w>blubber</w> during farewell speeches.",
                            "target_lang_translations": {
                                "es": "Sus amigos se burlaron cariñosamente de él por ser tan <w>llorica</w> durante los discursos de despedida."
                            }
                        }
                    ],
                    "synonyms": [
                        "sobber"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Persona que llora de forma ruidosa, descontrolada o excesiva."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "llorón",
                                "target_lang_sense_clarification": "persona propensa a llorar con facilidad"
                            },
                            {
                                "target_lang_word": "llorica",
                                "target_lang_sense_clarification": "persona que llora por todo, coloquial"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af366e63-3e64-30f2-b34d-4c170609ba5a",
                    "sense_definition": "A jellyfish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Old sailors along the coast frequently referred to any drifting jellyfish as a <w>blubber</w>.",
                            "target_lang_translations": {
                                "es": "Los viejos marineros de la costa solían llamar <w>medusa</w> a cualquier aguamala a la deriva."
                            }
                        },
                        {
                            "text": "The surface of the bay was covered with hundreds of translucent <w>blubbers</w>.",
                            "target_lang_translations": {
                                "es": "La superficie de la bahía estaba cubierta por cientos de <w>medusas</w> translúcidas."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional or nautical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Medusa o aguamala."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "medusa",
                                "target_lang_sense_clarification": "animal marino gelatinoso"
                            },
                            {
                                "target_lang_word": "aguamala",
                                "target_lang_sense_clarification": "medusa"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "185004d2-0874-3d72-83e4-d3c309d6fd36",
                    "sense_definition": "To weep or cry loudly and uncontrollably, especially while making sobbing sounds.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weep_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The upset toddler began to <w>blubber</w> loudly when his toy was taken away.",
                            "target_lang_translations": {
                                "es": "El pequeño enfadado empezó a <w>berrear</w> con fuerza cuando le quitaron el juguete."
                            }
                        },
                        {
                            "text": "She sat on the edge of the bed and continued to <w>blubber</w> like a child.",
                            "target_lang_translations": {
                                "es": "Se sentó en el borde de la cama y siguió <w>lloriqueando</w> como una niña."
                            }
                        }
                    ],
                    "synonyms": [
                        "cry",
                        "wail",
                        "weep"
                    ],
                    "common_phrases": [
                        "blubber like a baby"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often slightly disparaging"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Llorar ruidosamente y sin control, emitiendo sollozos audibles."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "berrear",
                                "target_lang_sense_clarification": "llorar ruidosamente"
                            },
                            {
                                "target_lang_word": "lloriquear",
                                "target_lang_sense_clarification": "llorar con quejas o sollozos"
                            },
                            {
                                "target_lang_word": "deshacerse en llanto",
                                "target_lang_sense_clarification": "llorar de forma desconsolada"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b51e077f-aaf1-3212-aa09-1fbb140695fd",
                    "sense_definition": "To say or utter words indistinctly while crying and sobbing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weep_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Between gasps of air, the frightened boy managed to <w>blubber</w> out an apology.",
                            "target_lang_translations": {
                                "es": "Entre jadeos, el asustado niño logró <w>balbucear entre sollozos</w> una disculpa."
                            }
                        },
                        {
                            "text": "He tried to explain the mistake, but he could only <w>blubber</w> incoherent excuses.",
                            "target_lang_translations": {
                                "es": "Intentó explicar el error, pero solo pudo <w>balbucear entre lágrimas</w> excusas incoherentes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blubber out an apology"
                    ],
                    "target_lang_definitions": {
                        "es": "Decir o pronunciar palabras de manera entrecortada o incomprensible mientras se llora."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "balbucear entre sollozos",
                                "target_lang_sense_clarification": "decir algo llorando"
                            },
                            {
                                "target_lang_word": "decir entre lágrimas",
                                "target_lang_sense_clarification": "hablar entrecortadamente al llorar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6a53515-7c49-3bc1-8bb4-c73e4f186be9",
                    "sense_definition": "To make one's face wet, swollen, or disfigured with continuous weeping.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weep_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grief seemed to <w>blubber</w> her cheeks with endless streams of bitter tears.",
                            "target_lang_translations": {
                                "es": "El dolor parecía <w>empapar e hinchar</w> sus mejillas con interminables torrentes de amargas lágrimas."
                            }
                        },
                        {
                            "text": "Hours of sorrow served only to <w>blubber</w> his eyes until he could scarcely see.",
                            "target_lang_translations": {
                                "es": "Las horas de dolor solo sirvieron para <w>hinchar</w> sus ojos de tanto llorar hasta que apenas podía ver."
                            }
                        }
                    ],
                    "synonyms": [
                        "beweep"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "transitive sense with tears or face as object"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Hinchar o empapar el rostro por efecto del llanto prolongado."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "hinchar de tanto llorar",
                                "target_lang_sense_clarification": "dejar el rostro o los ojos hinchados por el llanto"
                            },
                            {
                                "target_lang_word": "desfigurar por el llanto",
                                "target_lang_sense_clarification": "afectar los rasgos faciales a causa de las lágrimas"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "937344bb-75a2-32ba-971b-850a14e0af4d",
                    "sense_definition": "Swollen or protruding, especially in reference to lips.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old portrait showed a man with prominent features and distinctive <w>blubber</w> lips.",
                            "target_lang_translations": {
                                "es": "El viejo retrato mostraba a un hombre de rasgos prominentes y unos labios distintivamente <w>belfos</w>."
                            }
                        },
                        {
                            "text": "After the bee sting, his lower lip remained puffy and <w>blubber</w> for days.",
                            "target_lang_translations": {
                                "es": "Tras la picadura de abeja, su labio inferior permaneció entumecido e <w>hinchado</w> durante días."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blubber lips"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily found in historical literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Hinchado o abultado, especialmente dicho de los labios."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "hinchado",
                                "target_lang_sense_clarification": "abultado o engrosado"
                            },
                            {
                                "target_lang_word": "belfo",
                                "target_lang_sense_clarification": "labio grueso y colgante"
                            },
                            {
                                "target_lang_word": "abultado",
                                "target_lang_sense_clarification": "protuberante"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}