                ],
                "senses": [
                    {
                        "sense_id": "aa2faf9f-25c1-3be9-8c9d-3a1b398de6e1",
                        "entry_id": "69f3f649-5ecd-3418-823d-1ddee5f24350",
                        "glosses": [
                            "verhaal dat uit het verleden is overgeleverd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1dc19e9-04a9-41b9-bafe-d1b3c739c15d",
                                "sense_id": "aa2faf9f-25c1-3be9-8c9d-3a1b398de6e1",
                                "text": "Zo, althans, zegt de legende over Grote Pier."
                            }
                        ]
                    },
                    {
                        "sense_id": "2799cba5-0f38-337b-b4ed-183d21ceeffa",
                        "entry_id": "69f3f649-5ecd-3418-823d-1ddee5f24350",
                        "glosses": [
                            "tot de verbeelding sprekende beschrijving van een gebeurtenis uit het verleden die gangbaar is, maar waarvan de juistheid in twijfel wordt getrokken"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d8b85f7c-cda1-4a03-bbb3-8d3d5a5b7ff3",
                                "sense_id": "2799cba5-0f38-337b-b4ed-183d21ceeffa",
                                "text": "Volgens de legende heeft hij zijn zakenimperium eigenhandig opgebouwd, maar in werkelijkheid is het vooral een erfenis van zijn vader."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f27e3af-35f2-3810-b7ac-e83a42749484",
                        "entry_id": "69f3f649-5ecd-3418-823d-1ddee5f24350",
                        "glosses": [
                            "persoon over wiens daden veel wordt gesproken"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "950dd097-ea54-4cbb-8e17-e243fff2e58f",
                                "sense_id": "1f27e3af-35f2-3810-b7ac-e83a42749484",
                                "text": "Door zijn jarenlange succes met eenvoudige middelen werd hij een legende onder goochelaars."
                            },
                            {
                                "example_id": "04e8d0bd-2206-4bda-9f37-477b3492b2b8",
                                "sense_id": "1f27e3af-35f2-3810-b7ac-e83a42749484",
                                "text": "'Wij willen een mooie geschiedenis voortzetten', zegt Patrick Henriroux van sterrenrestaurant La Pyramide in Vienne. Zijn zaak werd in 1923 geopend door Fernand Point, een culinaire legende die Paul Bocuse en andere topkoks opleidde."
                            },
                            {
                                "example_id": "70c5b2cb-5566-4a61-8da2-a70e01287b86",
                                "sense_id": "1f27e3af-35f2-3810-b7ac-e83a42749484",
                                "text": "‘The Cascades will whip your ass,’ aldus de beroemde, 79 jarige thru-hike legende Billy Goat, die al meer dan acht keer de PCT had gelopen en het grootste gedeelte van de afgelopen 30 jaar in de wildernis had doorgebracht."
                            }
                        ]
                    },
                    {
                        "sense_id": "a863b2ab-fe69-3cf9-bf42-3d5d596f3560",
                        "entry_id": "69f3f649-5ecd-3418-823d-1ddee5f24350",
                        "glosses": [
                            "tekst die op de voorkant of achterkant van een munt langs de buitenrand staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4877243e-7ae6-4384-b178-866133e62c27",
                                "sense_id": "a863b2ab-fe69-3cf9-bf42-3d5d596f3560",
                                "text": "De legende moet niet worden verward met het randschrift dat op de zijkant van een munt staat."
                            }
                        ]
                    }
                ],
