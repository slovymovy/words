                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ba35638-1109-44a6-b944-9b27d2ad17f4",
                                                "sense_id": "ae300b2b-ec7d-3927-ab09-8881e1f154da",
                                                "text": "Während meines Praktikums habe ich acht Stunden am Tag Gewebeproben mikroskopiert."
                                            },
                                            {
                                                "example_id": "576a1a4e-f16c-4781-9461-2188128421e2",
                                                "sense_id": "ae300b2b-ec7d-3927-ab09-8881e1f154da",
                                                "text": "„Bei einer zweiten Untersuchung machte Walter einen Bluttest und ließ ihren Stuhl mikroskopieren.“"
                                            }
                                        ],
