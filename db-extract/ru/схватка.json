                "senses": [
                    {
                        "sense_id": "2173b5ec-206b-369e-b669-893c01617d39",
                        "entry_id": "6790c44a-9409-3154-911e-f6e516064720",
                        "glosses": [
                            "střetnutí, bitka, boj, šarvátka, potyčka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe4b7828-4d9e-4bd4-a281-f75d3c50a846",
                                "sense_id": "2173b5ec-206b-369e-b669-893c01617d39",
                                "text": "В случае победы в этом матче наших футболистов им предстоит схватка с куда более сильным соперником.",
                                "translation": "V případě vítězství v tomto zápase čeká naše fotbalisty střetnutí s daleko silnějším soupeřem."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b88746a-4678-3b56-bede-7d3d0ee89f04",
                        "entry_id": "6790c44a-9409-3154-911e-f6e516064720",
                        "glosses": [
                            "(většinou množné číslo) stahy, kontrakce"
                        ],
                        "tags": [
                            "při porodu"
                        ],
                        "examples": [
                            {
                                "example_id": "3571f5ea-2400-417e-ad61-2709d36cc81a",
                                "sense_id": "3b88746a-4678-3b56-bede-7d3d0ee89f04",
                                "text": "Там наверху есть одна леди, она рождает ребеночка. — Правда? Пибоди оглянулась на Луизу. — Прямо сейчас? — У нее начались схватки..",
                                "translation": "\"Tam nahoře je paní, rodí děťátko.\"- \"Opravdu?\" ohlédla se Peabodyová na Luisu, \"zrovna teď?\" - \"Začaly jí kontrakce...\""
                            }
                        ]
                    }
                ],
