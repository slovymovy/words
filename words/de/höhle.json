                            "text": "Der Braunbär zieht sich für den langen Winterschlaf in seine sichere <w>Höhle</w> zurück."
                        },
                        {
                            "text": "Füchse können tief unter der Erde eine verzweigte <w>Höhle</w> graben."
                        }
                    ],
                    "synonyms": [
                        "Bau",
                        "Unterschlupf"
                    ],
                    "common_phrases": [
