                ],
                "senses": [
                    {
                        "sense_id": "d310751f-c4ac-3c33-a2e1-61cb7cb5645e",
                        "entry_id": "e7d30870-fdcd-3c21-80e4-4f7f3f1a5d04",
                        "glosses": [
                            "lasterhafter Ort, Stätte sündiger Ausschweifungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abd48e68-a1a7-42da-b772-18a8c3220486",
                                "sense_id": "d310751f-c4ac-3c33-a2e1-61cb7cb5645e",
                                "text": "„Die Stadtregierung um Tourismus-Stadträtin Francisca Benassar will den Sündenpfuhl Ballermann künftig in ein viel luxuriöseres Ambiente tauchen – und Gäste anziehen, die ihre Euros nicht nur in Alkoholika eintauschen.“"
                            },
                            {
                                "example_id": "185b39a7-efe8-475c-8f25-5a60e6a48c0d",
                                "sense_id": "d310751f-c4ac-3c33-a2e1-61cb7cb5645e",
                                "text": "„Die Kirche stand in einem Viertel namens Hell’s Kitchen. Östlich davon befand sich der Times Square, der in den späten achtziger Jahren ein regelrechter Sündenpfuhl war: überall Pornoschuppen, in allen Straßen Prostituierte, an jeder Ecke Dealer.“"
                            },
                            {
                                "example_id": "0e81e719-470b-4574-8f80-381f6bbdb5b0",
                                "sense_id": "d310751f-c4ac-3c33-a2e1-61cb7cb5645e",
                                "text": "„Von außen kann man unmöglich erkennen, was sich dort abspielt, aber auf die einheimische Bevölkerung der Umgebung muss die sogenannte Internationale Zone von Tanger wie ein Sündenpfuhl, ein modernes Sodom, gewirkt haben – eine Manifestation von Allahs Zorn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
