        "nl-extract.jsonl": [
            {
                "entry_id": "de3265dd-4aab-3151-acae-970259a0e165",
                "word": "stimulus",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "d8dc1fd5-bb32-4f42-b5b9-1e16c9798210",
                        "entry_id": "de3265dd-4aab-3151-acae-970259a0e165",
                        "tags": [
                            "plural"
                        ],
                        "form": "stimuli"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61acaf3d-eca0-3891-9b0a-0fadc2111719",
                        "entry_id": "de3265dd-4aab-3151-acae-970259a0e165",
                        "glosses": [
                            "een verandering in de uitwendige of inwendige omgeving waarop een organisme reageert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85de35fd-21ee-4423-bbf1-2ce0a923942d",
                                "sense_id": "61acaf3d-eca0-3891-9b0a-0fadc2111719",
                                "text": "Het is altijd een strijd, vooral rond het moment dat het doek klaar lijkt. Er is geen externe stimulus die zegt: Peter, het doek is klaar. Ik moet daar zelf over beslissen. En dat beleef ik vrij intens. Het is stressen, maar na het besluit is het klaar. Het is zo intens omdat je beseft: hoe mooier het doek wordt, hoe groter de kans het toch nog fout te doen.”"
                            },
                            {
                                "example_id": "a464407b-b7a8-45d8-acd5-0fcd3eecc27d",
                                "sense_id": "61acaf3d-eca0-3891-9b0a-0fadc2111719",
                                "text": "De besluitvorming bij muizen was vrij simpel. Als de het sapje - de beloning - voldoende groot was, en de onaangename stimulus - de wind in hun snoet - was klein, kozen ze zonder aarzelen voor de beloning. Die was de kleine en korte hinder wel waard. De positieve beloning won van de negatieve gevolgen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4ec0f44-785c-43c7-8756-8234beea1366",
                        "source_entry_id": "de3265dd-4aab-3151-acae-970259a0e165",
                        "source_sense_id": "61acaf3d-eca0-3891-9b0a-0fadc2111719",
                        "target_lang_word": "sensation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sensation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "494db0d5-6fad-3bc3-b6f3-80c7d80142d3",
                                        "entry_id": "1acdc14f-dee5-3332-8572-16eb097bde18",
                                        "glosses": [
                                            "A physical feeling or perception from something that comes into contact with the body; something sensed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10389a04-75fd-4ced-9035-d664041097b2",
                                                "sense_id": "494db0d5-6fad-3bc3-b6f3-80c7d80142d3",
                                                "text": "Captain Edward Carlisle, soldier as he was, martinet as he was, felt a curious sensation of helplessness seize upon him as he met her steady gaze, her alluring smile; he could not tell what this prisoner might do."
                                            },
                                            {
                                                "example_id": "7c9be127-58f0-49ea-9154-2986e832d061",
                                                "sense_id": "494db0d5-6fad-3bc3-b6f3-80c7d80142d3",
                                                "text": "Confining ourselves, for the moment, to sensations, we find that there are different degrees of publicity attaching to different sorts of sensations. If you feel a toothache when the other people in the room do not, you are in no way surprised; but if you hear a clap of thunder when they do not, you begin to be alarmed as to your mental condition."
                                            },
                                            {
                                                "example_id": "dedd57cf-65f8-4b9c-aad2-ac54f6f4c739",
                                                "sense_id": "494db0d5-6fad-3bc3-b6f3-80c7d80142d3",
                                                "text": "Water and electricity might not mix, but water and battery-powered fun sure do. Whether you are using a vibe alone or with a partner, in the tub or in the shower, the sensation of intense vibration feels especially nice underwater. Although waterproof vibrators can resemble anything from a lipstick to a kitty cat, most have one of four basic designs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c23ab46-db04-3b7b-9bfd-deece3bc3904",
                                        "entry_id": "1acdc14f-dee5-3332-8572-16eb097bde18",
                                        "glosses": [
                                            "Excitation of sensory organs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91af2e7d-86a9-4329-96bd-d8806660e650",
                                                "sense_id": "9c23ab46-db04-3b7b-9bfd-deece3bc3904",
                                                "text": "Coordinate term: perception"
                                            },
                                            {
                                                "example_id": "c7e2b87f-a9ec-4870-99ef-69bd228abd7c",
                                                "sense_id": "9c23ab46-db04-3b7b-9bfd-deece3bc3904",
                                                "text": "In the dead state all is apparently without motion. No agent within indicates design, intelligence, or foresight: there is no respiration; […] no sensation; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "374c88cf-2b98-3cd4-9f94-facd534a4255",
                                        "entry_id": "1acdc14f-dee5-3332-8572-16eb097bde18",
                                        "glosses": [
                                            "A widespread reaction of interest or excitement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9db66ded-e9e3-4c3a-b580-9e840770ce63",
                                                "sense_id": "374c88cf-2b98-3cd4-9f94-facd534a4255",
                                                "text": "“Two or three months more went by; the public were eagerly awaiting the arrival of this semi-exotic claimant to an English peerage, and sensations, surpassing those of the Tichbourne case, were looked forward to with palpitating interest. […]”"
                                            },
                                            {
                                                "example_id": "e8982a4d-2cea-42ab-b6ef-c41d01615adb",
                                                "sense_id": "374c88cf-2b98-3cd4-9f94-facd534a4255",
                                                "text": "Young Derby's odd genius developed remarkably, and in his eighteenth year his collected nightmare-lyrics made a real sensation when issued under the title Azathoth and Other Horrors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "573d0ae7-8330-3eed-a184-0c532f782340",
                                        "entry_id": "1acdc14f-dee5-3332-8572-16eb097bde18",
                                        "glosses": [
                                            "A remarkable person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "figuratively",
                                            "uncommon",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db75fd82-a91b-4619-9574-e0faf603725c",
                                                "sense_id": "573d0ae7-8330-3eed-a184-0c532f782340",
                                                "text": "You truly are a sensation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9216cf9a-5cde-3379-ad17-e6e728a8c389",
                                        "entry_id": "1acdc14f-dee5-3332-8572-16eb097bde18",
                                        "glosses": [
                                            "A small serving of gin or sherry."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7db7dbb-bf7f-4361-96ec-bfb12cc8090d",
                                                "sense_id": "9216cf9a-5cde-3379-ad17-e6e728a8c389",
                                                "text": "A Sensation . . . . Half-a-glass of sherry."
                                            },
                                            {
                                                "example_id": "c71284af-97ba-44c3-8eff-80d8b9f7c093",
                                                "sense_id": "9216cf9a-5cde-3379-ad17-e6e728a8c389",
                                                "text": "When men go into a 'sluicery' for a 'sensation,' a 'drain,' or a 'common sewer,' they call the glass of gin they seek, in allusion to the juniper, a 'nipper,' or, more briefly, a 'nip,' occasionally a 'bite,' and not unfrequently it turns out a 'flogger.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "565599ee-65eb-4f42-b637-08c6e066335e",
                        "source_entry_id": "de3265dd-4aab-3151-acae-970259a0e165",
                        "source_sense_id": "61acaf3d-eca0-3891-9b0a-0fadc2111719",
                        "target_lang_word": "sensory stimulus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5e87b9cd-10b9-4aa4-9275-f2466eff177a",
                        "source_entry_id": "de3265dd-4aab-3151-acae-970259a0e165",
                        "source_sense_id": "61acaf3d-eca0-3891-9b0a-0fadc2111719",
                        "target_lang_word": "excitation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67410905-0938-3de7-bf65-adf17a2fedc6",
                                        "entry_id": "90173339-811c-344d-b6c1-1a5517652f5f",
                                        "glosses": [
                                            "The act of exciting or putting in motion; the act of rousing up or awakening."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31b55be7-01ad-4e94-8e39-8c33cdc31bce",
                                                "sense_id": "67410905-0938-3de7-bf65-adf17a2fedc6",
                                                "text": "Generator excitation is obtained by a combination of the separately-excited and self-excited fields, and the output is controlled by a resistance in the separate field circuit adjusted by the load regulator under the control of the engine governor."
                                            },
                                            {
                                                "example_id": "9c530a0c-874e-4898-a825-ba8c3dca4835",
                                                "sense_id": "67410905-0938-3de7-bf65-adf17a2fedc6",
                                                "text": "Wheelslip automatically causes the main generator field excitation to be reduced; the load regulator is forced back to minimum excitation and, if operating in one of the two stages of traction motor field divert, causes reversion to full field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23b155b5-0dda-3a27-b060-bc3be0e7f708",
                                        "entry_id": "90173339-811c-344d-b6c1-1a5517652f5f",
                                        "glosses": [
                                            "The act of producing excitement (stimulation); also, the excitement produced."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ffbb3a1-b831-4068-bab2-29a8ebaff0ae",
                                                "sense_id": "23b155b5-0dda-3a27-b060-bc3be0e7f708",
                                                "text": "Baiae: An ancient Roman pleasure resort [...]. It was the focal point of all kinds fo erotic experiments, unbridled debauchery, amorous intrigues and excitations, sexual encounters and aberrations."
                                            },
                                            {
                                                "example_id": "c352e121-5ac0-4f92-8c7d-22be807ca3b9",
                                                "sense_id": "23b155b5-0dda-3a27-b060-bc3be0e7f708",
                                                "text": "I'm pickin' up good vibrations / She's giving me the excitations."
                                            },
                                            {
                                                "example_id": "85ea7e11-9fa1-476f-9fa2-43268af24465",
                                                "sense_id": "23b155b5-0dda-3a27-b060-bc3be0e7f708",
                                                "text": "The erotics of composition are essential to the process, some prereflective excitation and orientation, some sense that your own little verse-craft can dock safe and sound at the big quay of language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a003819-b22e-3285-9684-a3f308d08bdf",
                                        "entry_id": "90173339-811c-344d-b6c1-1a5517652f5f",
                                        "glosses": [
                                            "The activity produced in an organ, tissue, or part, such as a nerve cell, as a result of stimulation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3dbd18c0-b028-347c-aaef-b40cea738f2d",
                                        "entry_id": "90173339-811c-344d-b6c1-1a5517652f5f",
                                        "glosses": [
                                            "A transition of a nucleus, atom or molecule to an excited state by the absorption of a quantum of energy; the opposite of relaxation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ceb265c4-7dad-478d-a758-029fc76715fc",
                        "source_entry_id": "de3265dd-4aab-3151-acae-970259a0e165",
                        "source_sense_id": "61acaf3d-eca0-3891-9b0a-0fadc2111719",
                        "target_lang_word": "stimulus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stimulus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                        "entry_id": "15979d7b-48ef-31f3-97ca-c3c32a1348a1",
                                        "glosses": [
                                            "An external phenomenon that has an influence on a system, by triggering or modifying an internal phenomenon; for example, a spur or incentive that drives a person to take action or change behaviour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1673c75e-91ac-4454-824f-7fc119abce87",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "an economic stimulus"
                                            },
                                            {
                                                "example_id": "d5c0027f-fc3b-4f67-9864-2013335786f1",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "From the beginning of the show to the end, vanity is the sole stimulus and reward of action—vanity, that never looks beyond the present."
                                            },
                                            {
                                                "example_id": "d64d9582-1846-4e54-aa5e-dab35f68a905",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "Democrats, meanwhile, point out that Republicans seem to have made a conscious decision, beginning with the stimulus, to oppose anything the president put forward, dooming any chance of renewed cooperation between the parties."
                                            },
                                            {
                                                "example_id": "6b812202-831b-45d8-b904-b384f02a7332",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "respond to a stimulus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5427ca45-0fe6-3428-913f-9503dc3012ae",
                                        "entry_id": "15979d7b-48ef-31f3-97ca-c3c32a1348a1",
                                        "glosses": [
                                            "Something external that elicits or influences a physiological or psychological activity or response, or that affects any of the sensory apparatuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7eb9862-11e9-433b-8433-c72738f4fe1d",
                                                "sense_id": "5427ca45-0fe6-3428-913f-9503dc3012ae",
                                                "text": "Even light nonpainful stimuli can provoke or exacerbate spontaneous pain; this is not limited to tactile, thermal, or vibratory stimuli, because auditory, visual, olfactory, and visceral stimuli also may be problematic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2a781a5-e371-3aa2-a6f8-0436bc1927ff",
                                        "entry_id": "15979d7b-48ef-31f3-97ca-c3c32a1348a1",
                                        "glosses": [
                                            "A stinging part on the body of a plant or insect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "747203e2-52c2-446e-a3bb-9339dd948f48",
                                                "sense_id": "b2a781a5-e371-3aa2-a6f8-0436bc1927ff",
                                                "text": "Many plants, like many animals, are furnished with arms for their protection; these are either aculei, prickles […]; or stimuli, stings, as in the nettles, which are armed with a venomous fluid for the annoyance of naked animals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
