                ],
                "senses": [
                    {
                        "sense_id": "cb07e9a5-b957-3dca-b893-2d0175949d0b",
                        "entry_id": "8c35a57f-e46c-30ed-989d-ecd616384530",
                        "glosses": [
                            "Qui revient, qui réapparaît, qui est répétitif ou répété."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5785c9b-a904-4a82-a20d-078df10b6bb0",
                                "sense_id": "cb07e9a5-b957-3dca-b893-2d0175949d0b",
                                "text": "L'intérêt de cette étude tient à sa démonstration claire de l'efficacité de la TCC en traitement de continuation dans la prévention des rechutes de la dépression récurrente avec au moins trois épisodes de dépression."
                            },
                            {
                                "example_id": "e0c7672f-297b-43e8-af3d-b16dd69404c5",
                                "sense_id": "cb07e9a5-b957-3dca-b893-2d0175949d0b",
                                "text": "Reconnaissons que l’infidélité plurielle, systématique, récurrente et assidue, est plus facilement revendiquée par les hommes, en particulier par ceux qui prônent le papillonnage érotico-relationnel, et qu'elle reste assez mal perçue chez les femmes, à qui l'on prête moins facilement le droit à de nombreuses aventures sans lendemain."
                            },
                            {
                                "example_id": "f9b7fd89-66d7-4416-9980-938defc099a3",
                                "sense_id": "cb07e9a5-b957-3dca-b893-2d0175949d0b",
                                "text": "Cette affaire soulève une autre question, celle de la pénurie récurrente de médicaments sur le marché libanais."
                            },
                            {
                                "example_id": "75e13a8c-33ee-4049-812f-cdeb56a8ab74",
                                "sense_id": "cb07e9a5-b957-3dca-b893-2d0175949d0b",
                                "text": "Sherlock Holmes est un héros récurrent dans les œuvres d'Arthur Conan Doyle."
                            },
                            {
                                "example_id": "a2cceebb-bc05-4930-b0ec-ca3d11ae3ead",
                                "sense_id": "cb07e9a5-b957-3dca-b893-2d0175949d0b",
                                "text": "Fièvre récurrente, celle qui se manifeste par des accès séparés par une période de rémission."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbeaaf55-8c3f-3a24-bd75-c557fa8786ac",
                        "entry_id": "8c35a57f-e46c-30ed-989d-ecd616384530",
                        "glosses": [
                            "Qui revient, qui remonte vers son origine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "658eef52-9a2a-4aa0-be2d-e547d6c5f830",
                                "sense_id": "cbeaaf55-8c3f-3a24-bd75-c557fa8786ac",
                                "text": "Nerfs récurrents, nerfs inférieurs du larynx."
                            },
                            {
                                "example_id": "b69bcfb0-a393-410b-9f28-4bc9b6f08f45",
                                "sense_id": "cbeaaf55-8c3f-3a24-bd75-c557fa8786ac",
                                "text": "Artères récurrentes, certaines artères de l’avant-bras et de la jambe."
                            },
                            {
                                "example_id": "df37afed-4419-403d-91dc-5fe2074c7a9e",
                                "sense_id": "cbeaaf55-8c3f-3a24-bd75-c557fa8786ac",
                                "text": "Sensibilité récurrente, Sensibilité observée sur les racines antérieures des nerfs rachidiens."
                            }
                        ]
                    },
                    {
                        "sense_id": "99d73435-b90f-37aa-9b95-839f012d36f1",
                        "entry_id": "8c35a57f-e46c-30ed-989d-ecd616384530",
                        "glosses": [
                            "Se dit d’une suite ou d'une série dont chaque terme s’exprime à partir du terme qui le précède."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4e02acc-9838-4549-ab78-1c374fd70210",
                                "sense_id": "99d73435-b90f-37aa-9b95-839f012d36f1",
                                "text": "Série ou suite récurrente, Série dans laquelle chaque terme est donné par une même fonction d’un certain nombre de termes précédents."
                            }
                        ]
                    }
                ],
