                "senses": [
                    {
                        "sense_id": "b2a56d42-47a2-3dd5-b521-1e810e67a72d",
                        "entry_id": "df16465e-f8c7-3a30-a9d3-573e4d9a5dd2",
                        "glosses": [
                            "Redonner un caractère pictural à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "942d63a5-2680-423c-8614-8831ff6e9842",
                                "sense_id": "b2a56d42-47a2-3dd5-b521-1e810e67a72d",
                                "text": "Le second, dans un mouvement inverse s’efforce de re-picturaliser notre alphabet en exaspérant sa dimension expressive."
                            },
                            {
                                "example_id": "cc092ac1-f4d8-400f-8f6a-36ad0a781d98",
                                "sense_id": "b2a56d42-47a2-3dd5-b521-1e810e67a72d",
                                "text": "Sauf qu’ici, beaucoup plus qu’ailleurs, Lavier met à profit les défauts mêmes de la technique qu’il utilise pour re-picturaliser la photographie, en un jeu complexe d’aller-et-retour, au sein d’une seule œuvre, entre l’illusionnisme et la vérité en peinture."
                            }
                        ]
                    }
