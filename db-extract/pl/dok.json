                                "text": "Przy wchodzeniu do doku uszkodzono śrubę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "229a02d9-38fc-3ad7-9c76-525e14858421",
                        "entry_id": "f759fb8a-6366-3f56-b0fb-6819ef8305df",
