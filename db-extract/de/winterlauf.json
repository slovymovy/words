                ],
                "senses": [
                    {
                        "sense_id": "ffc58891-8492-30b4-be9f-12aa7eca8118",
                        "entry_id": "40e4d416-2249-318b-9416-452cb823c44a",
                        "glosses": [
                            "Laufen im Winter"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "1ae881eb-bf60-42b7-be80-3117e854b6b5",
                                "sense_id": "ffc58891-8492-30b4-be9f-12aa7eca8118",
                                "text": "„Wenn Sie ein paar sinnvolle Tipps beachten, wird der Winterlauf zu Wellness für Körper und Seele.“"
                            },
                            {
                                "example_id": "d514f69e-bab6-4c01-a814-3ff10babb2ac",
                                "sense_id": "ffc58891-8492-30b4-be9f-12aa7eca8118",
                                "text": "„Die ersten acht Kilometerchen gehen deutlich kräftiger in die Beine als die Strecke vom Winterlauf am gleichen Ort, aber dann kommt doch ein Hauch von Citylauf-Feeling auf.“"
                            },
                            {
                                "example_id": "5f85de5c-e3d1-4217-ae3d-0c266fb62724",
                                "sense_id": "ffc58891-8492-30b4-be9f-12aa7eca8118",
                                "text": "„Die Rab Talus Tights ist klar meine bevorzugte Hose für Winterläufe und eine echte Kaufempfehlung.“"
                            },
                            {
                                "example_id": "40a12a2a-fc8f-46b8-a47c-d79eddb0f6f1",
                                "sense_id": "ffc58891-8492-30b4-be9f-12aa7eca8118",
                                "text": "„Kontrollieren Sie nach einem Winterlauf die Pfoten ganz genau und schmieren Sie, falls nötig, die Ballen anschließend mit fetthaltiger Salbe ein, etwa mit Vaseline (hierzu befragen Sie am besten Ihren Tierarzt).“"
                            },
                            {
                                "example_id": "7b96426a-7118-4393-b775-be6a980fbc3a",
                                "sense_id": "ffc58891-8492-30b4-be9f-12aa7eca8118",
                                "text": "„Eine Laufhose kann den entscheidenden Unterschied ausmachen, wenn es darum geht, sich bei kalten Winterläufen wohl zu fühlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "913db7c5-58ab-34d9-b0b0-79e997a47e87",
                        "entry_id": "40e4d416-2249-318b-9416-452cb823c44a",
                        "glosses": [
                            "Laufveranstaltung, die im Winter stattfindet"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "9d8310a2-c182-48bd-9382-fd357eaf5ffb",
                                "sense_id": "913db7c5-58ab-34d9-b0b0-79e997a47e87",
                                "text": "„Auch beim diesjährigen Winterlauf war die Alemannia wieder mit zahlreichen Teilnehmern vertreten.“"
                            },
                            {
                                "example_id": "1889a312-f855-4d3e-a008-3dc78c50ac72",
                                "sense_id": "913db7c5-58ab-34d9-b0b0-79e997a47e87",
                                "text": "„Beim 27. Ippinghäuser Winterlauf sprangen in der Klasse U12 auf der schweren Strecke über 4,2 Km ein vierter und fünfter Platz für Timon Paar und Louis Hofmann heraus. 21:40 und 22:17 Minuten wurden für die zufriedenen Jungs gestoppt.“"
                            },
                            {
                                "example_id": "ab49e381-e84f-4746-bcd8-1d5a6a63ba07",
                                "sense_id": "913db7c5-58ab-34d9-b0b0-79e997a47e87",
                                "text": "„Der traditionelle 10km-Lauf am vierten Adventssonntag in Rheinzabern, der den Start der Winterlaufserie markierte, war in diesem Jahr ein sehr würdiger Winterlauf.“"
                            },
                            {
                                "example_id": "88b7862e-0c0e-4c95-a6d7-cdf83bd978fe",
                                "sense_id": "913db7c5-58ab-34d9-b0b0-79e997a47e87",
                                "text": "„Am Sonntag, 13.11.2022 findet von 10:00 – 11:30 Uhr an der Saaler Mühle ein Winterlauf Special statt.“"
                            },
                            {
                                "example_id": "9fce2d2c-9162-4930-9841-fe4a99d43b32",
                                "sense_id": "913db7c5-58ab-34d9-b0b0-79e997a47e87",
                                "text": "„Für Menschen mit Flucht- und Migrationsbiografie ist die Teilnahme am Winterlauf kostenlos.“"
                            },
                            {
                                "example_id": "6fa466aa-843a-4912-bea3-cce62fc56d79",
                                "sense_id": "913db7c5-58ab-34d9-b0b0-79e997a47e87",
                                "text": "„Die Schule veranstaltete im Stadion in Eupen regelmäßig Leichtathletikmeetings, ich nahm meist an den Mittelstrecken- und Langläufen teil und konnte auch bei den Winterläufen vordere Plätze erobern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
