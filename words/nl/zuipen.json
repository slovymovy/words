                            },
                            {
                                "target_lang_word": "eat up",
                                "target_lang_sense_clarification": "to use a lot of fuel or resources"
                            },
                            {
                                "target_lang_word": "burn through",
                                "target_lang_sense_clarification": "to consume fuel very quickly"
                            }
                        ]
