                "senses": [
                    {
                        "sense_id": "8650b33a-4c9f-398a-8246-60a86fff0716",
                        "entry_id": "c934975b-a7cb-3e1d-9c20-0100db09ffbb",
                        "glosses": [
                            "Auszeichnung in Form einer Waffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8f87a6e-2200-437d-b5f9-56520fe5d436",
                                "sense_id": "8650b33a-4c9f-398a-8246-60a86fff0716",
                                "text": "„Früher bestand diese Sitte des Tragens der Ehrenwaffe auch in andern Theilen der Schweiz und nicht bloß für die Volksversammlungen, sondern auch für Kirchgänge, Hochzeiten und Gerichtsverhandlungen ….“"
                            },
                            {
                                "example_id": "1b1cb6be-a0b9-40da-80b6-339cbd07aaa7",
                                "sense_id": "8650b33a-4c9f-398a-8246-60a86fff0716",
                                "text": "„Mit dem Eintritt des Alters der politischen Mündigkeit wurde auch das Recht, die Ehrenwaffe zu tragen, existent ….“"
                            },
                            {
                                "example_id": "aa2c9059-e3e5-494e-aa0a-5bce5fc33d17",
                                "sense_id": "8650b33a-4c9f-398a-8246-60a86fff0716",
                                "text": "„Die Politischen Leiter tragen die vom Führer verliehene Ehrenwaffe, die Pistole (Kal. 765 mm Walther PPK).“"
                            },
                            {
                                "example_id": "1aa14cca-cd3f-4951-b3ba-0cd5ef64a73e",
                                "sense_id": "8650b33a-4c9f-398a-8246-60a86fff0716",
                                "text": "„Bei der an Stauffenberg verliehenen Ehrenwaffe handelt es sich um eine aufwendige Ausführung des 1922 eingeführten Offizier-Einheitssäbels.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
