    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55b67a0c-ada7-3cb7-988c-44129dfa9ef9",
                    "sense_definition": "Sentiment de compassion et de sympathie inspiré par les souffrances ou le malheur d'autrui.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "compassion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En voyant ce petit chien abandonné sous la pluie, elle a ressenti une immense <w>pitié</w>."
                        },
                        {
                            "text": "Cet homme sans <w>pitié</w> refuse d'aider les personnes les plus démunies de son quartier."
                        }
                    ],
                    "common_phrases": [
                        "avoir pitié de",
                        "faire pitié",
                        "sans pitié"
                    ]
                },
                {
                    "sense_id": "e31c174f-46a0-393b-90ce-18313cbfc385",
                    "sense_definition": "Disposition à pardonner ou à faire grâce envers un vaincu ou une personne coupable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clemence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé s'est agenouillé devant le tribunal pour demander <w>pitié</w> aux juges."
                        },
                        {
                            "text": "Le chevalier a fait preuve de <w>pitié</w> envers son adversaire désarmé et vaincu."
                        }
                    ],
                    "synonyms": [
                        "merci",
                        "miséricorde"
                    ],
                    "common_phrases": [
                        "demander pitié",
                        "implorer la pitié"
                    ]
                },
                {
                    "sense_id": "e6a1bda7-4a51-3cee-96cc-c6076764be59",
                    "sense_definition": "Sentiment mêlé de dédain ou de condescendance devant la médiocrité ou la faiblesse de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mepris",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec son arrogance habituelle, il regarde en <w>pitié</w> tous ceux qui n'ont pas réussi."
                        },
                        {
                            "text": "Sa tentative maladroite pour justifier son mensonge ne suscitait plus qu'une <w>pitié</w> méprisante."
                        }
                    ],
                    "common_phrases": [
                        "regarder en pitié"
                    ]
                },
                {
                    "sense_id": "eff5b30f-2118-37f6-aeb6-5355f3fef7bc",
                    "sense_definition": "État déplorable, détresse extrême ou spectacle désolant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "detresse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les historiens racontent la grande <w>pitié</w> du royaume ravagé par la famine et les épidémies."
                        },
                        {
                            "text": "C'était une véritable <w>pitié</w> de voir cette magnifique maison tomber lentement en ruine."
                        }
                    ],
                    "common_phrases": [
                        "grande pitié"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Employé surtout dans des tournures littéraires ou anciennes."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "cb24a229-d301-385c-8956-179f7ceea952",
                    "sense_definition": "Cri ou exclamation de supplication pour demander grâce ou implorer de ne pas faire de mal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "supplication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arrêtez de frapper cet innocent, <w>pitié</w>, il n'a rien fait de mal !"
                        },
                        {
                            "text": "<w>Pitié</w>, ne me laissez pas tout seul dans cette pièce sombre et angoissante !"
                        }
                    ],
                    "common_phrases": [
                        "par pitié"
                    ]
                }
            ]
        }
    ]
