                "senses": [
                    {
                        "sense_id": "847b8a01-407b-37e1-99be-07f71d8c6971",
                        "entry_id": "3ae2e84f-99b8-3f57-97f8-c73497e44ab2",
                        "glosses": [
                            "ein- oder zweiachsiges Fuhrwerk mit Karosserie oder beweglichem Verdeck; (ursprünglich) durch Nutztiere wie Pferde oder Ochsen gezogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbafef75-c67a-4367-98c1-71da11bac6bf",
                                "sense_id": "847b8a01-407b-37e1-99be-07f71d8c6971",
                                "text": "„Aber während er sich so tröstete, zogen auch wieder andere Bilder herauf, und er sah sich in einem Kutschwagen bei den prinzlichen Herrschaften vorfahren, um ihnen Victoire von Carayon als seine Braut vorzustellen.“"
                            },
                            {
                                "example_id": "967c75bc-1109-4af3-bd80-a5b4655a6f1b",
                                "sense_id": "847b8a01-407b-37e1-99be-07f71d8c6971",
                                "text": "„Es war das erstemal, daß Jón Hreggvidsson in des Assessors Kutschwagen fuhr, ohne vorn neben dem Kutscher sitzen zu müssen.“"
                            },
                            {
                                "example_id": "a8627308-51a6-478a-b117-8dca73920356",
                                "sense_id": "847b8a01-407b-37e1-99be-07f71d8c6971",
                                "text": "„Die beiden ritten rasch zum Hof zurück, um noch einen sechssitzigen Kutschwagen für die Alten und Kranken zu organisieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a55b827-c69a-498f-bae3-457ac9f1dd09",
                        "source_entry_id": "3ae2e84f-99b8-3f57-97f8-c73497e44ab2",
                        "source_sense_id": "847b8a01-407b-37e1-99be-07f71d8c6971",
                        "source_sense_description": "Kutsche",
                        "target_lang_word": "coche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "daf0f7da-20e8-3840-af81-7016a86a86f7",
                                        "entry_id": "d5d0316f-578e-34e1-9823-3eb79f39f1d6",
                                        "glosses": [
                                            "Ancien chariot couvert dont le corps n’était pas suspendu et dans lequel on voyageait."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e79c221-d12b-42c6-8c85-f6ff1652cc3e",
                                                "sense_id": "daf0f7da-20e8-3840-af81-7016a86a86f7",
                                                "text": "Je suis certaine qu’ils arrivent par le coche de Misère du pays de Sans-Souci."
                                            },
                                            {
                                                "example_id": "c678414f-7ac8-42b6-88ac-d0867c658362",
                                                "sense_id": "daf0f7da-20e8-3840-af81-7016a86a86f7",
                                                "text": "Deux autres voyageurs se trouvant logés à la même enseigne que moi, nous allons trouver un loueur de voitures qui se charge de nous transporter à notre destination pour la somme de 13 pesetas; et, quelques minutes plus tard, nous sommes confortablement installés dans un léger véhicule attelé de deux bons chevaux qui ne tardent pas à rattraper et à dépasser le coche public."
                                            },
                                            {
                                                "example_id": "315f8e47-f2e4-47f3-a89c-0b9556d29d68",
                                                "sense_id": "daf0f7da-20e8-3840-af81-7016a86a86f7",
                                                "text": "En 1763, le coche part de Paris, rue Pavée, les lundi, mercredi et vendredi, un départ fixé dès potron-minet à l'heure où les coqs chantent (quatre heures)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "415cc34b-f68e-3827-b0de-6ababa0fc579",
                                        "entry_id": "62403fe8-49a8-3faf-8b48-5b1a06ba81db",
                                        "glosses": [
                                            "Sorte de grand bateau qui servait autrefois pour le transport des voyageurs et des marchandises."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d732735d-a8ce-3c1a-81cd-d1b824893ec0",
                                        "entry_id": "62403fe8-49a8-3faf-8b48-5b1a06ba81db",
                                        "glosses": [
                                            "Coche de plaisance."
                                        ],
                                        "tags": [
                                            "Transport fluvial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "coche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31c6a624-06e4-30fd-83bb-7a49283bc600",
                                        "entry_id": "981eca36-1db0-3385-bfe2-d5cda6644d75",
                                        "glosses": [
                                            "Entaille, marque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9610afa6-a126-46b4-971a-28110cffe636",
                                                "sense_id": "31c6a624-06e4-30fd-83bb-7a49283bc600",
                                                "text": "Chacun d’eux faisait d’abord une coche profonde dans le bois, frappant patiemment au même endroit pendant quelques secondes, puis la hache remonta brusquement, attaquant le tronc obliquement un pied plus haut et faisant voler à chaque coup un copeau épais comme la main et taillé dans le sens de la fibre."
                                            },
                                            {
                                                "example_id": "6205a6ec-18fc-4939-b872-fa18e7cdd2a9",
                                                "sense_id": "31c6a624-06e4-30fd-83bb-7a49283bc600",
                                                "text": "Devons-nous restreindre nos activités une coche de plus parce que le système de santé est fragile ?"
                                            },
                                            {
                                                "example_id": "7832c800-ac86-43d6-998b-bfef37c45b5b",
                                                "sense_id": "31c6a624-06e4-30fd-83bb-7a49283bc600",
                                                "text": "Les coches sur les troncs marquent les arbres à abattre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90ec6e4b-d25e-33fd-a9b1-d1b63cea11b3",
                                        "entry_id": "981eca36-1db0-3385-bfe2-d5cda6644d75",
                                        "glosses": [
                                            "Marque, souvent ✓ ou ✗, servant à indiquer qu’un élément est sélectionné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "853e50a2-161b-431e-b0f9-6c2ccc00ae3b",
                                                "sense_id": "90ec6e4b-d25e-33fd-a9b1-d1b63cea11b3",
                                                "text": "Placez une coche en regard de chaque barre d’outils que vous voulez afficher. Supprimez la coche en regard de chaque barre d’outils que vous voulez masquer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d4f5919-baae-30e0-a6ed-b3abd830afc8",
                                        "entry_id": "c8eb3e14-ed1c-3de3-8dc7-c296b9e0137d",
                                        "glosses": [
                                            "Truie, femelle du cochon."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9c4161d-cfb1-410c-8e5e-ffdb9c6c8cdc",
                                                "sense_id": "6d4f5919-baae-30e0-a6ed-b3abd830afc8",
                                                "text": "Vous avez sûrement, sans le savoir, mangé de la viande de coche, autrement dit de la truie de réforme. — (« Truies : Le porc de l’angoisse », Malbouffe, le dico, Les Dossiers du Canard enchaîné nᵒ 147, avril 2018, page 81)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2954b54c-72a2-3254-980d-d23228ae7951",
                                        "entry_id": "c8eb3e14-ed1c-3de3-8dc7-c296b9e0137d",
                                        "glosses": [
                                            "Truie destinée à la reproduction."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7944923-fe3e-4624-8ec6-835ac3fde85a",
                                                "sense_id": "2954b54c-72a2-3254-980d-d23228ae7951",
                                                "text": "C’est dans les élevages industriels qu’inexorablement tout se met en train. Le cas des coches — les truies destinées à la seule reproduction — est particulièrement poignant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b717b05-94d0-378e-9494-0288b2dc2716",
                                        "entry_id": "c8eb3e14-ed1c-3de3-8dc7-c296b9e0137d",
                                        "glosses": [
                                            "Terme injurieux employé à l’endroit d’une femme jugée sale, répugnante."
                                        ],
                                        "tags": [
                                            "offensive"
                                        ],
