                    {
                        "sense_id": "cf5735c2-3e4e-31f9-bedf-b3b1facf6cca",
                        "entry_id": "225c4013-8432-33df-967e-2c7e41a4cd4a",
                        "glosses": [
                            "vrouw die behoort tot de Sinti of Roma"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a98e951c-7712-442a-ae88-fa8d0d5d5f03",
                                "sense_id": "cf5735c2-3e4e-31f9-bedf-b3b1facf6cca",
                                "text": "Diezelfde zo zeer waardig reagerende Appolonia wordt echter door de dorpsgemeenschap gemeden omdat zij gezien haar zwarte haren en onduidelijke herkomst wel eens een zigeunerin zou kunnen zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "f36fdc3f-74b6-3179-a313-954c335d853b",
                        "entry_id": "225c4013-8432-33df-967e-2c7e41a4cd4a",
                        "glosses": [
                            "vrouw die ervoor kiest een zwervend bestaan te leiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5577e37a-19f8-4e8b-a3d2-ddbccfae423f",
                                "sense_id": "f36fdc3f-74b6-3179-a313-954c335d853b",
                                "text": "In haar hang naar vervoering bracht zij haar leven grotendeels in voertuigen door, want als een rusteloze zigeunerin hield zij het nergens langer dan enkele weken uit."
                            }
                        ]
                    }
