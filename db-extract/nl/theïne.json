                        "examples": [
                            {
                                "example_id": "fb6071bf-3cd3-4974-a3ba-b97af83daf13",
                                "sense_id": "59b28cc0-9746-3eea-8f63-730163f93cec",
                                "text": "Om te overleven is het evolutionair gezien namelijk belangrijk om voeding binnen te krijgen waar energierijke voedingsstoffen in zitten zoals koolhydraten, calorieën, maar ook cafeïne, theïne, suikers en theobromine."
                            },
                            {
                                "example_id": "fcd1654a-6ba9-4fb1-9cb5-50f27d6acf66",
                                "sense_id": "59b28cc0-9746-3eea-8f63-730163f93cec",
                                "text": "“Iedereen denkt altijd dat theïne en cafeïne verschillende stoffen zijn, maar dat is dus precies hetzelfde.” vertelt Roy. “Het geeft allebei een klein beetje een oppeppend effect. Het enige verschil is dat er in koffie een iets hoger percentage aan cafeïne zit dan in thee. Maar bij een middagdip kun je dus net zo goed kiezen voor een kopje thee.”"
                            }
                        ]
                    }
